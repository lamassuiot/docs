41533":60084,"_41535":60087,"_41537":60090,"_41539":60093,"_41541":60096,"_41543":60099,"_41546":60102,"_41548":60105,"_41550":60108,"_41552":60111,"_41554":60114,"_41556":60117,"_41558":60120,"_41560":60123,"_41562":60126,"_41564":60129,"_41567":60132,"_41569":60135,"_41571":60138,"_41573":60141,"_41575":60144,"_41577":60147,"_41579":60150,"_41581":60153,"_41583":60156,"_41585":60159,"_41587":60162,"_41589":60165,"_41591":60168,"_41593":60171,"_41595":60174,"_41597":60177,"_41599":60180,"_41601":60183,"_41603":60186,"_41605":60189,"_41607":60192,"_41609":60195,"_41611":60198,"_41613":60201,"_41615":60204,"_41617":60207,"_41619":60210,"_41621":60213,"_41623":60216,"_41625":60219,"_41627":60222,"_41630":60225,"_41632":60228,"_41634":60231,"_41636":60234,"_41638":60237,"_41640":60240,"_41642":60243,"_41644":60246,"_41646":60249,"_41648":60252,"_41650":60255,"_41652":60258,"_41654":60261,"_41656":60264,"_41658":60267,"_41660":60270,"_41662":60273,"_41664":60276,"_41666":60279,"_41668":60282,"_41671":60285,"_41673":60288,"_41675":60291,"_41677":60294,"_41679":60297,"_41681":60300,"_41683":60303,"_41685":60306,"_41687":60309,"_41689":60312,"_41691":60315,"_41693":60318,"_41695":60321,"_41697":60324,"_41699":60327,"_41701":60330,"_41703":60333,"_41705":60336,"_41707":60339,"_41709":60342,"_41711":60345,"_41713":60348,"_41715":60351,"_41717":60354,"_41719":60357,"_41721":60360,"_41724":60363,"_41726":60366,"_41728":60369,"_41730":60372},{"_3585":15,"_31232":15,"_5":15204,"_3053":50908,"_31590":50909,"_21602":50913,"_28348":15},"Deploy from AWS Marketplace",[50910,50911,50912],"Docs","Deployment","Other models",[],{"_3585":16,"_31232":15,"_21602":50915,"_5":14833,"_28348":15,"_3053":50916},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3585":17,"_31232":15,"_5":31587,"_21602":50918,"_28348":50919,"_3053":50920},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3585":18,"_31232":15,"_5":31587,"_21602":50922,"_28348":50923,"_3053":50924},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3585":19,"_31232":15,"_5":31587,"_21602":50926,"_28348":50927,"_3053":50928},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3585":20,"_31232":15,"_5":31587,"_21602":50930,"_28348":50931,"_3053":50932},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3585":21,"_31232":15,"_5":31587,"_21602":50934,"_28348":50935,"_3053":50936},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3585":22,"_31232":15,"_5":31587,"_21602":50938,"_28348":50939,"_3053":50940},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3585":23,"_31232":15,"_5":31587,"_21602":50942,"_28348":50943,"_3053":50944},[],"/docs/pr-preview/pr-61/deployment/aws-marketplace#next-step","Next step",{"_3585":24,"_31232":15,"_21602":50946,"_5":14833,"_28348":15,"_3053":50947},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3585":25,"_31232":15,"_21602":50949,"_5":14833,"_28348":50919,"_3053":50950},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3585":26,"_31232":15,"_21602":50952,"_5":14833,"_28348":50919,"_3053":50953},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3585":27,"_31232":15,"_21602":50955,"_5":14833,"_28348":50919,"_3053":50956},[],"A security group allowing the necessary endpoints.",{"_3585":28,"_31232":15,"_21602":50958,"_5":14833,"_28348":50923,"_3053":50959},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3585":29,"_31232":15,"_21602":50961,"_5":14833,"_28348":50923,"_3053":50962},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3585":30,"_31232":15,"_21602":50964,"_5":14833,"_28348":50923,"_3053":50965},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3585":31,"_31232":15,"_21602":50967,"_5":14833,"_28348":50927,"_3053":50968},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3585":32,"_31232":15,"_21602":50970,"_5":14833,"_28348":50931,"_3053":50971},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3585":33,"_31232":15,"_21602":50973,"_5":14833,"_28348":50935,"_3053":50974},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3585":34,"_31232":15,"_21602":50976,"_5":14833,"_28348":50939,"_3053":50977},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3585":35,"_31232":15,"_21602":50979,"_5":14833,"_28348":50943,"_3053":50980},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3585":36,"_31232":36,"_5":15204,"_3053":50982,"_31590":50983,"_21602":50984,"_28348":36},"Deploy Lamassu",[50910,50911],[],{"_3585":37,"_31232":36,"_21602":50986,"_5":14833,"_28348":36,"_3053":50987},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3585":38,"_31232":36,"_5":31587,"_21602":50989,"_28348":50990,"_3053":50991},[],"/docs/pr-preview/pr-61/deployment/overview#choose-a-model","Choose a model",{"_3585":39,"_31232":36,"_5":31587,"_21602":50993,"_28348":50994,"_3053":50995},[],"/docs/pr-preview/pr-61/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3585":40,"_31232":36,"_5":31587,"_21602":50997,"_28348":50998,"_3053":50999},[],"/docs/pr-preview/pr-61/deployment/overview#after-deployment","After deployment",{"_3585":41,"_31232":36,"_21602":51001,"_5":14833,"_28348":36,"_3053":51002},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3585":42,"_31232":36,"_21602":51004,"_5":14833,"_28348":50990,"_3053":51005},[],"Model",{"_3585":43,"_31232":36,"_21602":51007,"_5":14833,"_28348":50990,"_3053":51008},[],"Recommended for",{"_3585":44,"_31232":36,"_21602":51010,"_5":14833,"_28348":50990,"_3053":51011},[],"Who operates the infrastructure",{"_3585":45,"_31232":36,"_21602":51013,"_5":14833,"_28348":50990,"_3053":51014},[],"Starting point",{"_3585":46,"_31232":36,"_21602":51016,"_5":14833,"_28348":50990,"_3053":51017},[],"Kubernetes self-managed",{"_3585":47,"_31232":36,"_21602":51019,"_5":14833,"_28348":50990,"_3053":51020},[],"Production, regulated environments and custom deployments",{"_3585":48,"_31232":36,"_21602":51022,"_5":14833,"_28348":50990,"_3053":51023},[],"Your team",{"_3585":49,"_31232":36,"_21602":51025,"_5":14833,"_28348":50990,"_3053":51026},[],"Helm or Fastlane",{"_3585":50,"_31232":36,"_21602":51028,"_5":14833,"_28348":50990,"_3053":51029},[],"AWS Marketplace",{"_3585":51,"_31232":36,"_21602":51031,"_5":14833,"_28348":50990,"_3053":51032},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3585":52,"_31232":36,"_21602":51034,"_5":14833,"_28348":50990,"_3053":51023},[],{"_3585":53,"_31232":36,"_21602":51036,"_5":14833,"_28348":50990,"_3053":51037},[],"Preconfigured image on EC2",{"_3585":54,"_31232":36,"_21602":51039,"_5":14833,"_28348":50990,"_3053":51040},[],"SaaS",{"_3585":55,"_31232":36,"_21602":51042,"_5":14833,"_28348":50990,"_3053":51043},[],"Teams that want to use the platform without operating it",{"_3585":56,"_31232":36,"_21602":51045,"_5":14833,"_28348":50990,"_3053":51046},[],"Lamassu",{"_3585":57,"_31232":36,"_21602":51048,"_5":14833,"_28348":50990,"_3053":51049},[],"Managed subscription",{"_3585":58,"_31232":36,"_21602":51051,"_5":14833,"_28348":50990,"_3053":51052},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3585":59,"_31232":36,"_21602":51054,"_5":14833,"_28348":50990,"_3053":51055},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3585":60,"_31232":36,"_21602":51057,"_5":14833,"_28348":50990,"_3053":51058},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3585":61,"_31232":36,"_21602":51060,"_5":14833,"_28348":50994,"_3053":51061},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3585":62,"_31232":36,"_21602":51063,"_5":14833,"_28348":50998,"_3053":51064},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3585":63,"_31232":63,"_5":15204,"_3053":51066,"_31590":51067,"_21602":51068,"_28348":63},"Use Lamassu as SaaS",[50910,50911,50912],[],{"_3585":64,"_31232":63,"_21602":51070,"_5":14833,"_28348":63,"_3053":51071},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3585":65,"_31232":63,"_5":31587,"_21602":51073,"_28348":51074,"_3053":51075},[],"/docs/pr-preview/pr-61/deployment/saas#what-the-service-manages","What the service manages",{"_3585":66,"_31232":63,"_5":31587,"_21602":51077,"_28348":51078,"_3053":51079},[],"/docs/pr-preview/pr-61/deployment/saas#plans","Plans",{"_3585":67,"_31232":63,"_5":31587,"_21602":51081,"_28348":51082,"_3053":51083},[],"/docs/pr-preview/pr-61/deployment/saas#request-access","Request access",{"_3585":68,"_31232":63,"_21602":51085,"_5":14833,"_28348":63,"_3053":51086},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3585":69,"_31232":63,"_21602":51088,"_5":14833,"_28348":51074,"_3053":51089},[],"Platform availability and maintenance.",{"_3585":70,"_31232":63,"_21602":51091,"_5":14833,"_28348":51074,"_3053":51092},[],"Automatic backups.",{"_3585":71,"_31232":63,"_21602":51094,"_5":14833,"_28348":51074,"_3053":51095},[],"Version upgrades.",{"_3585":72,"_31232":63,"_21602":51097,"_5":14833,"_28348":51074,"_3053":51098},[],"Technical support and SLA according to your plan.",{"_3585":73,"_31232":63,"_21602":51100,"_5":14833,"_28348":51078,"_3053":51101},[],"Plan",{"_3585":74,"_31232":63,"_21602":51103,"_5":14833,"_28348":51078,"_3053":51104},[],"Devices",{"_3585":75,"_31232":63,"_21602":51106,"_5":14833,"_28348":51078,"_3053":51107},[],"Support",{"_3585":76,"_31232":63,"_21602":51109,"_5":14833,"_28348":51078,"_3053":51110},[],"SLA",{"_3585":77,"_31232":63,"_21602":51112,"_5":14833,"_28348":51078,"_3053":51113},[],"Starter",{"_3585":78,"_31232":63,"_21602":51115,"_5":14833,"_28348":51078,"_3053":51116},[],"Up to 1,000",{"_3585":79,"_31232":63,"_21602":51118,"_5":14833,"_28348":51078,"_3053":51119},[],"Email",{"_3585":80,"_31232":63,"_21602":51121,"_5":14833,"_28348":51078,"_3053":51122},[],"99.5 %",{"_3585":81,"_31232":63,"_21602":51124,"_5":14833,"_28348":51078,"_3053":51125},[],"Professional",{"_3585":82,"_31232":63,"_21602":51127,"_5":14833,"_28348":51078,"_3053":51128},[],"Up to 10,000",{"_3585":83,"_31232":63,"_21602":51130,"_5":14833,"_28348":51078,"_3053":51131},[],"Email and chat",{"_3585":84,"_31232":63,"_21602":51133,"_5":14833,"_28348":51078,"_3053":51134},[],"99.9 %",{"_3585":85,"_31232":63,"_21602":51136,"_5":14833,"_28348":51078,"_3053":51137},[],"Enterprise",{"_3585":86,"_31232":63,"_21602":51139,"_5":14833,"_28348":51078,"_3053":51140},[],"Unlimited",{"_3585":87,"_31232":63,"_21602":51142,"_5":14833,"_28348":51078,"_3053":51143},[],"Dedicated",{"_3585":88,"_31232":63,"_21602":51145,"_5":14833,"_28348":51078,"_3053":51146},[],"99.99 %",{"_3585":89,"_31232":63,"_21602":51148,"_5":14833,"_28348":51082,"_3053":51149},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3585":90,"_31232":63,"_21602":51151,"_5":14833,"_28348":51082,"_3053":51152},[],"When you receive your instance's credentials, continue with Get started.",{"_3585":91,"_31232":91,"_5":15204,"_3053":51154,"_31590":51155,"_21602":51156,"_28348":91},"Fastlane",[50910,50911,51017],[],{"_3585":92,"_31232":91,"_21602":51158,"_5":14833,"_28348":91,"_3053":51159},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3585":93,"_31232":91,"_5":31587,"_21602":51161,"_28348":51162,"_3053":51163},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3585":94,"_31232":91,"_5":31587,"_21602":51165,"_28348":51166,"_3053":51167},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3585":95,"_31232":91,"_5":31587,"_21602":51169,"_28348":51170,"_3053":50920},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#before-you-begin",{"_3585":96,"_31232":91,"_5":31587,"_21602":51172,"_28348":51173,"_3053":51174},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3585":97,"_31232":91,"_5":31587,"_21602":51176,"_28348":51177,"_3053":51178},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3585":98,"_31232":91,"_5":31587,"_21602":51180,"_28348":51181,"_3053":51182},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3585":99,"_31232":91,"_5":31587,"_21602":51184,"_28348":51185,"_3053":51186},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3585":100,"_31232":91,"_5":31587,"_21602":51188,"_28348":51189,"_3053":51190},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3585":101,"_31232":91,"_5":31587,"_21602":51192,"_28348":51193,"_3053":51194},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3585":102,"_31232":91,"_5":31587,"_21602":51196,"_28348":51197,"_3053":51198},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3585":103,"_31232":91,"_5":31587,"_21602":51200,"_28348":51201,"_3053":51202},[],"/docs/pr-preview/pr-61/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3585":104,"_31232":91,"_21602":51204,"_5":14833,"_28348":51162,"_3053":51205},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3585":105,"_31232":91,"_21602":51207,"_5":14833,"_28348":51162,"_3053":51208},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3585":106,"_31232":91,"_21602":51210,"_5":14833,"_28348":51166,"_3053":51211},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3585":107,"_31232":91,"_21602":51213,"_5":14833,"_28348":51166,"_3053":51214},[],"Fastlane installs or configures",{"_3585":108,"_31232":91,"_21602":51216,"_5":14833,"_28348":51166,"_3053":51217},[],"You still provide",{"_3585":109,"_31232":91,"_21602":51219,"_5":14833,"_28348":51166,"_3053":51220},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3585":110,"_31232":91,"_21602":51222,"_5":14833,"_28348":51166,"_3053":51223},[],"The Kubernetes cluster, nodes and persistent storage",{"_3585":111,"_31232":91,"_21602":51225,"_5":14833,"_28348":51166,"_3053":51226},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3585":112,"_31232":91,"_21602":51228,"_5":14833,"_28348":51166,"_3053":51229},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3585":113,"_31232":91,"_21602":51231,"_5":14833,"_28348":51166,"_3053":51232},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3585":114,"_31232":91,"_21602":51234,"_5":14833,"_28348":51166,"_3053":51235},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3585":115,"_31232":91,"_21602":51237,"_5":14833,"_28348":51166,"_3053":51238},[],"Optional observability and lab HSM components",{"_3585":116,"_31232":91,"_21602":51240,"_5":14833,"_28348":51166,"_3053":51241},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3585":117,"_31232":91,"_21602":51243,"_5":14833,"_28348":51166,"_3053":51244},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3585":118,"_31232":91,"_21602":51246,"_5":14833,"_28348":51170,"_3053":51247},[],"You need:",{"_3585":119,"_31232":91,"_21602":51249,"_5":14833,"_28348":51170,"_3053":51250},[],"an existing Kubernetes cluster",{"_3585":120,"_31232":91,"_21602":51252,"_5":14833,"_28348":51170,"_3053":51253},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3585":121,"_31232":91,"_21602":51255,"_5":14833,"_28348":51170,"_3053":51256},[],"`yq`",{"_3585":122,"_31232":91,"_21602":51258,"_5":14833,"_28348":51170,"_3053":24464},[],{"_3585":123,"_31232":91,"_21602":51260,"_5":14833,"_28348":51170,"_3053":51261},[],"`jq` only when using `--sample-data` or `--development`",{"_3585":124,"_31232":91,"_21602":51263,"_5":14833,"_28348":51170,"_3053":51264},[],"`ssh-keygen` only when using `--with-hsm`",{"_3585":125,"_31232":91,"_21602":51266,"_5":14833,"_28348":51170,"_3053":51267},[],"free external ports 80 and 443 on a single-node K3s host",{"_3585":126,"_31232":91,"_21602":51269,"_5":14833,"_28348":51170,"_3053":51270},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3585":127,"_31232":91,"_21602":51272,"_5":14833,"_28348":51170,"_3053":51273},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3585":128,"_31232":91,"_21602":51275,"_5":14833,"_28348":51173,"_3053":51276},[],"Run the script from a clone of the Helm repository:",{"_3585":129,"_31232":91,"_21602":51278,"_5":14833,"_28348":51173,"_3053":51279},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3585":130,"_31232":91,"_21602":51281,"_5":14833,"_28348":51177,"_3053":51282},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3585":131,"_31232":91,"_21602":51284,"_5":14833,"_28348":51177,"_3053":51285},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3585":132,"_31232":91,"_21602":51287,"_5":14833,"_28348":51177,"_3053":51288},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3585":133,"_31232":91,"_21602":51290,"_5":14833,"_28348":51177,"_3053":51291},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3585":134,"_31232":91,"_21602":51293,"_5":14833,"_28348":51181,"_3053":51294},[],"Option",{"_3585":135,"_31232":91,"_21602":51296,"_5":14833,"_28348":51181,"_3053":51297},[],"Default",{"_3585":136,"_31232":91,"_21602":51299,"_5":14833,"_28348":51181,"_3053":51300},[],"Purpose",{"_3585":137,"_31232":91,"_21602":51302,"_5":14833,"_28348":51181,"_3053":51303},[],"`-h`, `--help`",{"_3585":138,"_31232":91,"_21602":51305,"_5":14833,"_28348":51181,"_3053":51306},[],"—",{"_3585":139,"_31232":91,"_21602":51308,"_5":14833,"_28348":51181,"_3053":51309},[],"Show help",{"_3585":140,"_31232":91,"_21602":51311,"_5":14833,"_28348":51181,"_3053":51312},[],"`-c`, `--context`",{"_3585":141,"_31232":91,"_21602":51314,"_5":14833,"_28348":51181,"_3053":51315},[],"current context",{"_3585":142,"_31232":91,"_21602":51317,"_5":14833,"_28348":51181,"_3053":51318},[],"Select the kubeconfig context for kubectl and Helm",{"_3585":143,"_31232":91,"_21602":51320,"_5":14833,"_28348":51181,"_3053":51321},[],"`-n`, `--non-interactive`",{"_3585":144,"_31232":91,"_21602":51323,"_5":14833,"_28348":51181,"_3053":6814},[],{"_3585":145,"_31232":91,"_21602":51325,"_5":14833,"_28348":51181,"_3053":51326},[],"Skip prompts and generate dependency credentials",{"_3585":146,"_31232":91,"_21602":51328,"_5":14833,"_28348":51181,"_3053":51329},[],"`-ns`, `--namespace`",{"_3585":147,"_31232":91,"_21602":51331,"_5":14833,"_28348":51181,"_3053":51332},[],"`lamassu-dev`",{"_3585":148,"_31232":91,"_21602":51334,"_5":14833,"_28348":51181,"_3053":51335},[],"Namespace for the installation",{"_3585":149,"_31232":91,"_21602":51337,"_5":14833,"_28348":51181,"_3053":51338},[],"`-d`, `--domain`",{"_3585":150,"_31232":91,"_21602":51340,"_5":14833,"_28348":51181,"_3053":51341},[],"`dev.lamassu.io`",{"_3585":151,"_31232":91,"_21602":51343,"_5":14833,"_28348":51181,"_3053":51344},[],"Domain used by the UI, OIDC and certificate",{"_3585":152,"_31232":91,"_21602":51346,"_5":14833,"_28348":51181,"_3053":51347},[],"`-v`, `--version`",{"_3585":153,"_31232":91,"_21602":51349,"_5":14833,"_28348":51181,"_3053":15574},[],{"_3585":154,"_31232":91,"_21602":51351,"_5":14833,"_28348":51181,"_3053":51352},[],"Lamassu chart version",{"_3585":155,"_31232":91,"_21602":51354,"_5":14833,"_28348":51181,"_3053":51355},[],"`--https-port`",{"_3585":156,"_31232":91,"_21602":51357,"_5":14833,"_28348":51181,"_3053":51358},[],"`443`",{"_3585":157,"_31232":91,"_21602":51360,"_5":14833,"_28348":51181,"_3053":51361},[],"Gateway HTTPS listener port",{"_3585":158,"_31232":91,"_21602":51363,"_5":14833,"_28348":51181,"_3053":51364},[],"`--http-port`",{"_3585":159,"_31232":91,"_21602":51366,"_5":14833,"_28348":51181,"_3053":51367},[],"`80`",{"_3585":160,"_31232":91,"_21602":51369,"_5":14833,"_28348":51181,"_3053":51370},[],"Gateway HTTP listener port",{"_3585":161,"_31232":91,"_21602":51372,"_5":14833,"_28348":51181,"_3053":51373},[],"`--tls-crt`",{"_3585":162,"_31232":91,"_21602":51375,"_5":14833,"_28348":51181,"_3053":51306},[],{"_3585":163,"_31232":91,"_21602":51377,"_5":14833,"_28348":51181,"_3053":51378},[],"PEM certificate for downstream TLS",{"_3585":164,"_31232":91,"_21602":51380,"_5":14833,"_28348":51181,"_3053":51381},[],"`--tls-key`",{"_3585":165,"_31232":91,"_21602":51383,"_5":14833,"_28348":51181,"_3053":51306},[],{"_3585":166,"_31232":91,"_21602":51385,"_5":14833,"_28348":51181,"_3053":51386},[],"PEM private key for downstream TLS",{"_3585":167,"_31232":91,"_21602":51388,"_5":14833,"_28348":51181,"_3053":51389},[],"`-l`, `--local-chart-path`",{"_3585":168,"_31232":91,"_21602":51391,"_5":14833,"_28348":51181,"_3053":51392},[],"repository chart",{"_3585":169,"_31232":91,"_21602":51394,"_5":14833,"_28348":51181,"_3053":51395},[],"Use an unpacked local Lamassu chart",{"_3585":170,"_31232":91,"_21602":51397,"_5":14833,"_28348":51181,"_3053":51398},[],"`-ip`, `--gateway-ip`",{"_3585":171,"_31232":91,"_21602":51400,"_5":14833,"_28348":51181,"_3053":9066},[],{"_3585":172,"_31232":91,"_21602":51402,"_5":14833,"_28348":51181,"_3053":51403},[],"Override the address written to `gateway.addresses`",{"_3585":173,"_31232":91,"_21602":51405,"_5":14833,"_28348":51181,"_3053":51406},[],"`--otel`",{"_3585":174,"_31232":91,"_21602":51408,"_5":14833,"_28348":51181,"_3053":6814},[],{"_3585":175,"_31232":91,"_21602":51410,"_5":14833,"_28348":51181,"_3053":51411},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3585":176,"_31232":91,"_21602":51413,"_5":14833,"_28348":51181,"_3053":51414},[],"`--development`",{"_3585":177,"_31232":91,"_21602":51416,"_5":14833,"_28348":51181,"_3053":6814},[],{"_3585":178,"_31232":91,"_21602":51418,"_5":14833,"_28348":51181,"_3053":51419},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3585":179,"_31232":91,"_21602":51421,"_5":14833,"_28348":51181,"_3053":51422},[],"`--sample-data`",{"_3585":180,"_31232":91,"_21602":51424,"_5":14833,"_28348":51181,"_3053":6814},[],{"_3585":181,"_31232":91,"_21602":51426,"_5":14833,"_28348":51181,"_3053":51427},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3585":182,"_31232":91,"_21602":51429,"_5":14833,"_28348":51181,"_3053":51430},[],"`--with-hsm`",{"_3585":183,"_31232":91,"_21602":51432,"_5":14833,"_28348":51181,"_3053":6814},[],{"_3585":184,"_31232":91,"_21602":51434,"_5":14833,"_28348":51181,"_3053":51435},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3585":185,"_31232":91,"_21602":51437,"_5":14833,"_28348":51181,"_3053":51438},[],"`--softhsm-chart-path`",{"_3585":186,"_31232":91,"_21602":51440,"_5":14833,"_28348":51181,"_3053":51441},[],"`./charts/softhsm`",{"_3585":187,"_31232":91,"_21602":51443,"_5":14833,"_28348":51181,"_3053":51444},[],"Use a different local SoftHSM chart",{"_3585":188,"_31232":91,"_21602":51446,"_5":14833,"_28348":51181,"_3053":51447},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3585":189,"_31232":91,"_21602":51449,"_5":14833,"_28348":51185,"_3053":51450},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3585":190,"_31232":91,"_21602":51452,"_5":14833,"_28348":51185,"_3053":51453},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3585":191,"_31232":91,"_21602":51455,"_5":14833,"_28348":51185,"_3053":51456},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3585":192,"_31232":91,"_21602":51458,"_5":14833,"_28348":51185,"_3053":51459},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3585":193,"_31232":91,"_21602":51461,"_5":14833,"_28348":51185,"_3053":51462},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3585":194,"_31232":91,"_21602":51464,"_5":14833,"_28348":51185,"_3053":51465},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3585":195,"_31232":91,"_21602":51467,"_5":14833,"_28348":51189,"_3053":51468},[],"Fastlane:",{"_3585":196,"_31232":91,"_21602":51470,"_5":14833,"_28348":51189,"_3053":51471},[],"validates local tools and the selected cluster",{"_3585":197,"_31232":91,"_21602":51473,"_5":14833,"_28348":51189,"_3053":51474},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3585":198,"_31232":91,"_21602":51476,"_5":14833,"_28348":51189,"_3053":51477},[],"creates the namespace",{"_3585":199,"_31232":91,"_21602":51479,"_5":14833,"_28348":51189,"_3053":51480},[],"installs PostgreSQL and creates the required databases",{"_3585":200,"_31232":91,"_21602":51482,"_5":14833,"_28348":51189,"_3053":51483},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3585":201,"_31232":91,"_21602":51485,"_5":14833,"_28348":51189,"_3053":51486},[],"installs RabbitMQ",{"_3585":202,"_31232":91,"_21602":51488,"_5":14833,"_28348":51189,"_3053":51489},[],"optionally installs observability and lab HSM components",{"_3585":203,"_31232":91,"_21602":51491,"_5":14833,"_28348":51189,"_3053":51492},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3585":204,"_31232":91,"_21602":51494,"_5":14833,"_28348":51189,"_3053":51495},[],"optionally loads sample data",{"_3585":205,"_31232":91,"_21602":51497,"_5":14833,"_28348":51189,"_3053":51498},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3585":206,"_31232":91,"_21602":51500,"_5":14833,"_28348":51193,"_3053":51501},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3585":207,"_31232":91,"_21602":51503,"_5":14833,"_28348":51193,"_3053":51504},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3585":208,"_31232":91,"_21602":51506,"_5":14833,"_28348":51197,"_3053":51507},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3585":209,"_31232":91,"_21602":51509,"_5":14833,"_28348":51197,"_3053":51510},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3585":210,"_31232":91,"_21602":51512,"_5":14833,"_28348":51197,"_3053":51513},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3585":211,"_31232":91,"_21602":51515,"_5":14833,"_28348":51201,"_3053":51516},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3585":212,"_31232":212,"_5":15204,"_3053":51518,"_31590":51519,"_21602":51520,"_28348":212},"Install with Helm",[50910,50911,51017],[],{"_3585":213,"_31232":212,"_21602":51522,"_5":14833,"_28348":212,"_3053":51523},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3585":214,"_31232":212,"_5":31587,"_21602":51525,"_28348":51526,"_3053":51527},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3585":215,"_31232":212,"_5":31587,"_21602":51529,"_28348":51530,"_3053":50920},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#before-you-begin",{"_3585":216,"_31232":212,"_5":31587,"_21602":51532,"_28348":51533,"_3053":51534},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3585":217,"_31232":212,"_5":31587,"_21602":51536,"_28348":51537,"_3053":51538},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3585":218,"_31232":212,"_5":31587,"_21602":51540,"_28348":51541,"_3053":51542},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3585":219,"_31232":212,"_5":31587,"_21602":51544,"_28348":51545,"_3053":51546},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3585":220,"_31232":212,"_5":31587,"_21602":51548,"_28348":51549,"_3053":51550},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3585":221,"_31232":212,"_5":31587,"_21602":51552,"_28348":51553,"_3053":51554},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3585":222,"_31232":212,"_5":31587,"_21602":51556,"_28348":51557,"_3053":51558},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3585":223,"_31232":212,"_5":31587,"_21602":51560,"_28348":51561,"_3053":51562},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3585":224,"_31232":212,"_5":31587,"_21602":51564,"_28348":51565,"_3053":51566},[],"/docs/pr-preview/pr-61/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3585":225,"_31232":212,"_21602":51568,"_5":14833,"_28348":51526,"_3053":51569},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3585":226,"_31232":212,"_21602":51571,"_5":14833,"_28348":51530,"_3053":51572},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3585":227,"_31232":212,"_21602":51574,"_5":14833,"_28348":51530,"_3053":51575},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3585":228,"_31232":212,"_21602":51577,"_5":14833,"_28348":51530,"_3053":51578},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3585":229,"_31232":212,"_21602":51580,"_5":14833,"_28348":51530,"_3053":51581},[],"a reachable RabbitMQ broker and credentials",{"_3585":230,"_31232":212,"_21602":51583,"_5":14833,"_28348":51530,"_3053":51584},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3585":231,"_31232":212,"_21602":51586,"_5":14833,"_28348":51530,"_3053":51587},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3585":232,"_31232":212,"_21602":51589,"_5":14833,"_28348":51530,"_3053":51590},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3585":233,"_31232":212,"_21602":51592,"_5":14833,"_28348":51530,"_3053":51593},[],"a StorageClass and an external traffic design",{"_3585":234,"_31232":212,"_21602":51595,"_5":14833,"_28348":51530,"_3053":51596},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3585":235,"_31232":212,"_21602":51598,"_5":14833,"_28348":51530,"_3053":51599},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3585":236,"_31232":212,"_21602":51601,"_5":14833,"_28348":51530,"_3053":51602},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3585":237,"_31232":212,"_21602":51604,"_5":14833,"_28348":51533,"_3053":51605},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3585":238,"_31232":212,"_21602":51607,"_5":14833,"_28348":51533,"_3053":51608},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3585":239,"_31232":212,"_21602":51610,"_5":14833,"_28348":51533,"_3053":51611},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3585":240,"_31232":212,"_21602":51613,"_5":14833,"_28348":51537,"_3053":51614},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3585":241,"_31232":212,"_21602":51616,"_5":14833,"_28348":51537,"_3053":51617},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3585":242,"_31232":212,"_21602":51619,"_5":14833,"_28348":51537,"_3053":51620},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3585":243,"_31232":212,"_21602":51622,"_5":14833,"_28348":51537,"_3053":51623},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3585":244,"_31232":212,"_21602":51625,"_5":14833,"_28348":51541,"_3053":51626},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3585":245,"_31232":212,"_21602":51628,"_5":14833,"_28348":51545,"_3053":51629},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3585":246,"_31232":212,"_21602":51631,"_5":14833,"_28348":51545,"_3053":51632},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3585":247,"_31232":212,"_21602":51634,"_5":14833,"_28348":51545,"_3053":51635},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3585":248,"_31232":212,"_21602":51637,"_5":14833,"_28348":51545,"_3053":51638},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3585":249,"_31232":212,"_21602":51640,"_5":14833,"_28348":51545,"_3053":51641},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3585":250,"_31232":212,"_21602":51643,"_5":14833,"_28348":51545,"_3053":51644},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3585":251,"_31232":212,"_21602":51646,"_5":14833,"_28348":51545,"_3053":51647},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3585":252,"_31232":212,"_21602":51649,"_5":14833,"_28348":51549,"_3053":51650},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3585":253,"_31232":212,"_21602":51652,"_5":14833,"_28348":51549,"_3053":51653},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3585":254,"_31232":212,"_21602":51655,"_5":14833,"_28348":51549,"_3053":51656},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3585":255,"_31232":212,"_21602":51658,"_5":14833,"_28348":51549,"_3053":51659},[],"See Access control for the principal and policy model.",{"_3585":256,"_31232":212,"_21602":51661,"_5":14833,"_28348":51553,"_3053":51662},[],"To install a local checkout instead:",{"_3585":257,"_31232":212,"_21602":51664,"_5":14833,"_28348":51557,"_3053":51665},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3585":258,"_31232":212,"_21602":51667,"_5":14833,"_28348":51557,"_3053":51668},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3585":259,"_31232":212,"_21602":51670,"_5":14833,"_28348":51561,"_3053":51671},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3585":260,"_31232":212,"_21602":51673,"_5":14833,"_28348":51561,"_3053":51674},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3585":261,"_31232":212,"_21602":51676,"_5":14833,"_28348":51561,"_3053":51677},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3585":262,"_31232":212,"_21602":51679,"_5":14833,"_28348":51561,"_3053":51680},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3585":263,"_31232":212,"_21602":51682,"_5":14833,"_28348":51561,"_3053":51683},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3585":264,"_31232":212,"_21602":51685,"_5":14833,"_28348":51565,"_3053":51686},[],"Before going live, review:",{"_3585":265,"_31232":212,"_21602":51688,"_5":14833,"_28348":51565,"_3053":51689},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3585":266,"_31232":212,"_21602":51691,"_5":14833,"_28348":51565,"_3053":51692},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3585":267,"_31232":212,"_21602":51694,"_5":14833,"_28348":51565,"_3053":51695},[],"shared VA storage before increasing VA replicas",{"_3585":268,"_31232":212,"_21602":51697,"_5":14833,"_28348":51565,"_3053":51698},[],"managed OIDC roles and removal of evaluation credentials",{"_3585":269,"_31232":212,"_21602":51700,"_5":14833,"_28348":51565,"_3053":51701},[],"a trusted TLS issuer or externally managed certificate",{"_3585":270,"_31232":212,"_21602":51703,"_5":14833,"_28348":51565,"_3053":51704},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3585":271,"_31232":212,"_21602":51706,"_5":14833,"_28348":51565,"_3053":51707},[],"SMTP, observability and alert delivery",{"_3585":272,"_31232":212,"_21602":51709,"_5":14833,"_28348":51565,"_3053":51710},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3585":273,"_31232":212,"_21602":51712,"_5":14833,"_28348":51565,"_3053":51713},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3585":274,"_31232":274,"_5":15204,"_3053":51715,"_31590":51716,"_21602":51717,"_28348":274},"Expose the Gateway",[50910,50911,51017],[],{"_3585":275,"_31232":274,"_21602":51719,"_5":14833,"_28348":274,"_3053":51720},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3585":276,"_31232":274,"_5":31587,"_21602":51722,"_28348":51723,"_3053":51724},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3585":277,"_31232":274,"_5":31587,"_21602":51726,"_28348":51727,"_3053":51728},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3585":278,"_31232":274,"_5":31587,"_21602":51730,"_28348":51731,"_3053":51732},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3585":279,"_31232":274,"_5":31587,"_21602":51734,"_28348":51735,"_3053":51736},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#k3s","K3s",{"_3585":280,"_31232":274,"_5":31587,"_21602":51738,"_28348":51739,"_3053":51740},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3585":281,"_31232":274,"_5":31587,"_21602":51742,"_28348":51743,"_3053":51744},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3585":282,"_31232":274,"_5":31587,"_21602":51746,"_28348":51747,"_3053":51748},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3585":283,"_31232":274,"_5":31587,"_21602":51750,"_28348":51751,"_3053":51752},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3585":284,"_31232":274,"_5":31587,"_21602":51754,"_28348":51755,"_3053":51756},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3585":285,"_31232":274,"_5":31587,"_21602":51758,"_28348":51759,"_3053":51760},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3585":286,"_31232":274,"_5":31587,"_21602":51762,"_28348":51763,"_3053":51764},[],"/docs/pr-preview/pr-61/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3585":287,"_31232":274,"_21602":51766,"_5":14833,"_28348":51723,"_3053":51767},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3585":288,"_31232":274,"_21602":51769,"_5":14833,"_28348":51723,"_3053":51770},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3585":289,"_31232":274,"_21602":51772,"_5":14833,"_28348":51727,"_3053":51773},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3585":290,"_31232":274,"_21602":51775,"_5":14833,"_28348":51727,"_3053":51776},[],"Set it only when:",{"_3585":291,"_31232":274,"_21602":51778,"_5":14833,"_28348":51727,"_3053":51779},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3585":292,"_31232":274,"_21602":51781,"_5":14833,"_28348":51727,"_3053":51782},[],"that address is allocated to this Gateway",{"_3585":293,"_31232":274,"_21602":51784,"_5":14833,"_28348":51727,"_3053":51785},[],"the surrounding network already routes traffic for it to the cluster",{"_3585":294,"_31232":274,"_21602":51787,"_5":14833,"_28348":51727,"_3053":51788},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3585":295,"_31232":274,"_21602":51790,"_5":14833,"_28348":51727,"_3053":51791},[],"Keep these two settings separate:",{"_3585":296,"_31232":274,"_21602":51793,"_5":14833,"_28348":51727,"_3053":51794},[],"`gateway.addresses` requests an address for the Gateway.",{"_3585":297,"_31232":274,"_21602":51796,"_5":14833,"_28348":51727,"_3053":51797},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3585":298,"_31232":274,"_21602":51799,"_5":14833,"_28348":51727,"_3053":51800},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3585":299,"_31232":274,"_21602":51802,"_5":14833,"_28348":51731,"_3053":51803},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3585":300,"_31232":274,"_21602":51805,"_5":14833,"_28348":51731,"_3053":51806},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3585":301,"_31232":274,"_21602":51808,"_5":14833,"_28348":51735,"_3053":51809},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3585":302,"_31232":274,"_21602":51811,"_5":14833,"_28348":51735,"_3053":51812},[],"For the recommended design:",{"_3585":303,"_31232":274,"_21602":51814,"_5":14833,"_28348":51735,"_3053":51815},[],"Use only one externally exposed Lamassu Gateway.",{"_3585":304,"_31232":274,"_21602":51817,"_5":14833,"_28348":51735,"_3053":51818},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3585":305,"_31232":274,"_21602":51820,"_5":14833,"_28348":51735,"_3053":51821},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3585":306,"_31232":274,"_21602":51823,"_5":14833,"_28348":51735,"_3053":51824},[],"Point DNS at the VM's reachable address.",{"_3585":307,"_31232":274,"_21602":51826,"_5":14833,"_28348":51735,"_3053":51827},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3585":308,"_31232":274,"_21602":51829,"_5":14833,"_28348":51739,"_3053":51830},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3585":309,"_31232":274,"_21602":51832,"_5":14833,"_28348":51743,"_3053":51833},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3585":310,"_31232":274,"_21602":51835,"_5":14833,"_28348":51743,"_3053":51836},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3585":311,"_31232":274,"_21602":51838,"_5":14833,"_28348":51747,"_3053":51839},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3585":312,"_31232":274,"_21602":51841,"_5":14833,"_28348":51747,"_3053":51842},[],"Requirement",{"_3585":313,"_31232":274,"_21602":51844,"_5":14833,"_28348":51747,"_3053":51845},[],"Recommended design",{"_3585":314,"_31232":274,"_21602":51847,"_5":14833,"_28348":51747,"_3053":51848},[],"Consequence",{"_3585":315,"_31232":274,"_21602":51850,"_5":14833,"_28348":51747,"_3053":51851},[],"Several Lamassu URLs or services",{"_3585":316,"_31232":274,"_21602":51853,"_5":14833,"_28348":51747,"_3053":51854},[],"One Gateway with multiple routes",{"_3585":317,"_31232":274,"_21602":51856,"_5":14833,"_28348":51747,"_3053":51857},[],"One IP and one proxy fleet; this is the chart default",{"_3585":318,"_31232":274,"_21602":51859,"_5":14833,"_28348":51747,"_3053":51860},[],"Independent Gateways and separate external IPs",{"_3585":319,"_31232":274,"_21602":51862,"_5":14833,"_28348":51747,"_3053":51863},[],"One VIP per Gateway",{"_3585":320,"_31232":274,"_21602":51865,"_5":14833,"_28348":51747,"_3053":51866},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3585":321,"_31232":274,"_21602":51868,"_5":14833,"_28348":51747,"_3053":51869},[],"Independent Gateways on one node and one IP",{"_3585":322,"_31232":274,"_21602":51871,"_5":14833,"_28348":51747,"_3053":51872},[],"Use different external ports",{"_3585":323,"_31232":274,"_21602":51874,"_5":14833,"_28348":51747,"_3053":51875},[],"Clients must include non-standard ports",{"_3585":324,"_31232":274,"_21602":51877,"_5":14833,"_28348":51747,"_3053":51878},[],"Separate TLS/mTLS termination behind one IP",{"_3585":325,"_31232":274,"_21602":51880,"_5":14833,"_28348":51747,"_3053":51881},[],"Front-door SNI routing to internal Gateways",{"_3585":326,"_31232":274,"_21602":51883,"_5":14833,"_28348":51747,"_3053":51884},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3585":327,"_31232":274,"_21602":51886,"_5":14833,"_28348":51747,"_3053":51887},[],"Separate Gateway resources but shared proxy infrastructure",{"_3585":328,"_31232":274,"_21602":51889,"_5":14833,"_28348":51747,"_3053":51890},[],"Envoy merged-Gateway mode",{"_3585":329,"_31232":274,"_21602":51892,"_5":14833,"_28348":51747,"_3053":51893},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3585":330,"_31232":274,"_21602":51895,"_5":14833,"_28348":51747,"_3053":51896},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3585":331,"_31232":274,"_21602":51898,"_5":14833,"_28348":51747,"_3053":51899},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3585":332,"_31232":274,"_21602":51901,"_5":14833,"_28348":51747,"_3053":51902},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3585":333,"_31232":274,"_21602":51904,"_5":14833,"_28348":51747,"_3053":51905},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3585":334,"_31232":274,"_21602":51907,"_5":14833,"_28348":51751,"_3053":51908},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3585":335,"_31232":274,"_21602":51910,"_5":14833,"_28348":51755,"_3053":51911},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3585":336,"_31232":274,"_21602":51913,"_5":14833,"_28348":51755,"_3053":51914},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3585":337,"_31232":274,"_21602":51916,"_5":14833,"_28348":51755,"_3053":51917},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3585":338,"_31232":274,"_21602":51919,"_5":14833,"_28348":51755,"_3053":51920},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3585":339,"_31232":274,"_21602":51922,"_5":14833,"_28348":51755,"_3053":51923},[],"If none of those are possible, use different external ports or change the external network design.",{"_3585":340,"_31232":274,"_21602":51925,"_5":14833,"_28348":51759,"_3053":51926},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3585":341,"_31232":274,"_21602":51928,"_5":14833,"_28348":51759,"_3053":51929},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3585":342,"_31232":274,"_21602":51931,"_5":14833,"_28348":51763,"_3053":51932},[],"Check, in order:",{"_3585":343,"_31232":274,"_21602":51934,"_5":14833,"_28348":51763,"_3053":51935},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3585":344,"_31232":274,"_21602":51937,"_5":14833,"_28348":51763,"_3053":51938},[],"Its status contains the expected address.",{"_3585":345,"_31232":274,"_21602":51940,"_5":14833,"_28348":51763,"_3053":51941},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3585":346,"_31232":274,"_21602":51943,"_5":14833,"_28348":51763,"_3053":51944},[],"Port 443 reaches that address from the client network.",{"_3585":347,"_31232":274,"_21602":51946,"_5":14833,"_28348":51763,"_3053":51947},[],"DNS resolves to the externally reachable endpoint.",{"_3585":348,"_31232":274,"_21602":51949,"_5":14833,"_28348":51763,"_3053":51950},[],"The certificate contains the DNS name or IP used by the client.",{"_3585":349,"_31232":274,"_21602":51952,"_5":14833,"_28348":51763,"_3053":51953},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3585":350,"_31232":350,"_5":15204,"_3053":51017,"_31590":51955,"_21602":51956,"_28348":350},[50910,50911,51017],[],{"_3585":351,"_31232":350,"_21602":51958,"_5":14833,"_28348":350,"_3053":51959},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3585":352,"_31232":350,"_5":31587,"_21602":51961,"_28348":51962,"_3053":51963},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3585":353,"_31232":350,"_5":31587,"_21602":51965,"_28348":51966,"_3053":51967},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3585":354,"_31232":350,"_5":31587,"_21602":51969,"_28348":51970,"_3053":51971},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3585":355,"_31232":350,"_5":31587,"_21602":51973,"_28348":51974,"_3053":51975},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3585":356,"_31232":350,"_5":31587,"_21602":51977,"_28348":51978,"_3053":51979},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3585":357,"_31232":350,"_5":31587,"_21602":51981,"_28348":51982,"_3053":51983},[],"/docs/pr-preview/pr-61/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3585":358,"_31232":350,"_21602":51985,"_5":14833,"_28348":51962,"_3053":51986},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3585":359,"_31232":350,"_21602":51988,"_5":14833,"_28348":51966,"_3053":51989},[],"Workflow",{"_3585":360,"_31232":350,"_21602":51991,"_5":14833,"_28348":51966,"_3053":51992},[],"Use it for",{"_3585":361,"_31232":350,"_21602":51994,"_5":14833,"_28348":51966,"_3053":51995},[],"What it installs",{"_3585":362,"_31232":350,"_21602":51997,"_5":14833,"_28348":51966,"_3053":51998},[],"Helm",{"_3585":363,"_31232":350,"_21602":52000,"_5":14833,"_28348":51966,"_3053":52001},[],"Production and controlled environments",{"_3585":364,"_31232":350,"_21602":52003,"_5":14833,"_28348":51966,"_3053":52004},[],"Lamassu services and Gateway API resources",{"_3585":365,"_31232":350,"_21602":52006,"_5":14833,"_28348":51966,"_3053":51154},[],{"_3585":366,"_31232":350,"_21602":52008,"_5":14833,"_28348":51966,"_3053":52009},[],"Evaluation, demos, CI and small lab clusters",{"_3585":367,"_31232":350,"_21602":52011,"_5":14833,"_28348":51966,"_3053":52012},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3585":368,"_31232":350,"_21602":52014,"_5":14833,"_28348":51970,"_3053":52015},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3585":369,"_31232":350,"_21602":52017,"_5":14833,"_28348":51970,"_3053":52018},[],"Area",{"_3585":370,"_31232":350,"_21602":52020,"_5":14833,"_28348":51970,"_3053":52021},[],"The Lamassu chart provides",{"_3585":371,"_31232":350,"_21602":52023,"_5":14833,"_28348":51970,"_3053":52024},[],"You provide",{"_3585":372,"_31232":350,"_21602":52026,"_5":14833,"_28348":51970,"_3053":52027},[],"Lamassu applications",{"_3585":373,"_31232":350,"_21602":52029,"_5":14833,"_28348":51970,"_3053":52030},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3585":374,"_31232":350,"_21602":52032,"_5":14833,"_28348":51970,"_3053":52033},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3585":375,"_31232":350,"_21602":52035,"_5":14833,"_28348":51970,"_3053":52036},[],"PostgreSQL data",{"_3585":376,"_31232":350,"_21602":52038,"_5":14833,"_28348":51970,"_3053":52039},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3585":377,"_31232":350,"_21602":52041,"_5":14833,"_28348":51970,"_3053":52042},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3585":378,"_31232":350,"_21602":52044,"_5":14833,"_28348":51970,"_3053":52045},[],"Messaging",{"_3585":379,"_31232":350,"_21602":52047,"_5":14833,"_28348":51970,"_3053":52048},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3585":380,"_31232":350,"_21602":52050,"_5":14833,"_28348":51970,"_3053":52051},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3585":381,"_31232":350,"_21602":52053,"_5":14833,"_28348":51970,"_3053":52054},[],"Identity",{"_3585":382,"_31232":350,"_21602":52056,"_5":14833,"_28348":51970,"_3053":52057},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3585":383,"_31232":350,"_21602":52059,"_5":14833,"_28348":51970,"_3053":52060},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3585":384,"_31232":350,"_21602":52062,"_5":14833,"_28348":51970,"_3053":52063},[],"External routing",{"_3585":385,"_31232":350,"_21602":52065,"_5":14833,"_28348":51970,"_3053":52066},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3585":386,"_31232":350,"_21602":52068,"_5":14833,"_28348":51970,"_3053":52069},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3585":387,"_31232":350,"_21602":52071,"_5":14833,"_28348":51970,"_3053":52072},[],"TLS",{"_3585":388,"_31232":350,"_21602":52074,"_5":14833,"_28348":51970,"_3053":52075},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3585":389,"_31232":350,"_21602":52077,"_5":14833,"_28348":51970,"_3053":52078},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3585":390,"_31232":350,"_21602":52080,"_5":14833,"_28348":51970,"_3053":52081},[],"Persistent application data",{"_3585":391,"_31232":350,"_21602":52083,"_5":14833,"_28348":51970,"_3053":52084},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3585":392,"_31232":350,"_21602":52086,"_5":14833,"_28348":51970,"_3053":52087},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3585":393,"_31232":350,"_21602":52089,"_5":14833,"_28348":51970,"_3053":52090},[],"Optional integrations",{"_3585":394,"_31232":350,"_21602":52092,"_5":14833,"_28348":51970,"_3053":52093},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3585":395,"_31232":350,"_21602":52095,"_5":14833,"_28348":51970,"_3053":52096},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3585":396,"_31232":350,"_21602":52098,"_5":14833,"_28348":51970,"_3053":52099},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3585":397,"_31232":350,"_21602":52101,"_5":14833,"_28348":51970,"_3053":52102},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3585":398,"_31232":350,"_21602":52104,"_5":14833,"_28348":51974,"_3053":52105},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3585":399,"_31232":350,"_21602":52107,"_5":14833,"_28348":51974,"_3053":52108},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3585":400,"_31232":350,"_21602":52110,"_5":14833,"_28348":51978,"_3053":52111},[],"Kubernetes 1.24 or newer",{"_3585":401,"_31232":350,"_21602":52113,"_5":14833,"_28348":51978,"_3053":52114},[],"Helm 3.2 or newer",{"_3585":402,"_31232":350,"_21602":52116,"_5":14833,"_28348":51978,"_3053":52117},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3585":403,"_31232":350,"_21602":52119,"_5":14833,"_28348":51978,"_3053":52120},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3585":404,"_31232":350,"_21602":52122,"_5":14833,"_28348":51978,"_3053":52123},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3585":405,"_31232":350,"_21602":52125,"_5":14833,"_28348":51978,"_3053":52126},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3585":406,"_31232":350,"_21602":52128,"_5":14833,"_28348":51978,"_3053":52129},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3585":407,"_31232":350,"_21602":52131,"_5":14833,"_28348":51982,"_3053":52132},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3585":408,"_31232":350,"_21602":52134,"_5":14833,"_28348":51982,"_3053":52135},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3585":409,"_31232":350,"_21602":52137,"_5":14833,"_28348":51982,"_3053":52138},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3585":410,"_31232":350,"_21602":52140,"_5":14833,"_28348":51982,"_3053":52141},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3585":411,"_31232":411,"_5":15204,"_3053":52143,"_31590":52144,"_21602":52146,"_28348":411},"Deployment troubleshooting",[50910,50911,52145],"Operations",[],{"_3585":412,"_31232":411,"_21602":52148,"_5":14833,"_28348":411,"_3053":52149},[],"Diagnose access, service health and infrastructure dependencies.",{"_3585":413,"_31232":411,"_5":31587,"_21602":52151,"_28348":52152,"_3053":52153},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3585":414,"_31232":411,"_5":31587,"_21602":52155,"_28348":52156,"_3053":52157},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3585":415,"_31232":411,"_5":31587,"_21602":52159,"_28348":52160,"_3053":52161},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3585":416,"_31232":411,"_5":31587,"_21602":52163,"_28348":52164,"_3053":52165},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3585":417,"_31232":411,"_5":31587,"_21602":52167,"_28348":52168,"_3053":52169},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3585":418,"_31232":411,"_5":31587,"_21602":52171,"_28348":52172,"_3053":52173},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3585":419,"_31232":411,"_5":31587,"_21602":52175,"_28348":52176,"_3053":52177},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3585":420,"_31232":411,"_5":31587,"_21602":52179,"_28348":52180,"_3053":52181},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3585":421,"_31232":411,"_5":31587,"_21602":52183,"_28348":52184,"_3053":52185},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3585":422,"_31232":411,"_5":31587,"_21602":52187,"_28348":52188,"_3053":52189},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3585":423,"_31232":411,"_5":31587,"_21602":52191,"_28348":52192,"_3053":52193},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3585":424,"_31232":411,"_5":31587,"_21602":52195,"_28348":52196,"_3053":52197},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3585":425,"_31232":411,"_5":31587,"_21602":52199,"_28348":52200,"_3053":52201},[],"/docs/pr-preview/pr-61/deployment/troubleshooting#observability","Observability",{"_3585":426,"_31232":411,"_21602":52203,"_5":14833,"_28348":411,"_3053":52204},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3585":427,"_31232":411,"_21602":52206,"_5":14833,"_28348":52156,"_3053":52207},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3585":428,"_31232":411,"_21602":52209,"_5":14833,"_28348":52160,"_3053":52210},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3585":429,"_31232":411,"_21602":52212,"_5":14833,"_28348":52164,"_3053":52213},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3585":430,"_31232":411,"_21602":52215,"_5":14833,"_28348":52168,"_3053":52216},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3585":431,"_31232":411,"_21602":52218,"_5":14833,"_28348":52172,"_3053":52219},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3585":432,"_31232":411,"_21602":52221,"_5":14833,"_28348":52176,"_3053":52222},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3585":433,"_31232":411,"_21602":52224,"_5":14833,"_28348":52176,"_3053":52225},[],"Also run the chart's connectivity test:",{"_3585":434,"_31232":411,"_21602":52227,"_5":14833,"_28348":52176,"_3053":52228},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3585":435,"_31232":411,"_21602":52230,"_5":14833,"_28348":52176,"_3053":52231},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3585":436,"_31232":411,"_21602":52233,"_5":14833,"_28348":52180,"_3053":52234},[],"If you receive a 401:",{"_3585":437,"_31232":411,"_21602":52236,"_5":14833,"_28348":52180,"_3053":52237},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3585":438,"_31232":411,"_21602":52239,"_5":14833,"_28348":52180,"_3053":52240},[],"verify issuer, audience and expiration of the token;",{"_3585":439,"_31232":411,"_21602":52242,"_5":14833,"_28348":52180,"_3053":52243},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3585":440,"_31232":411,"_21602":52245,"_5":14833,"_28348":52180,"_3053":52246},[],"check that the provider's public and internal routes point to the same realm.",{"_3585":441,"_31232":411,"_21602":52248,"_5":14833,"_28348":52180,"_3053":52249},[],"If login succeeds but the APIs return 403:",{"_3585":442,"_31232":411,"_21602":52251,"_5":14833,"_28348":52180,"_3053":52252},[],"inspect the token's real claims;",{"_3585":443,"_31232":411,"_21602":52254,"_5":14833,"_28348":52180,"_3053":52255},[],"confirm they match an active principal;",{"_3585":444,"_31232":411,"_21602":52257,"_5":14833,"_28348":52180,"_3053":52258},[],"review the policies granted to that principal;",{"_3585":445,"_31232":411,"_21602":52260,"_5":14833,"_28348":52180,"_3053":52261},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3585":446,"_31232":411,"_21602":52263,"_5":14833,"_28348":52180,"_3053":52264},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3585":447,"_31232":411,"_21602":52266,"_5":14833,"_28348":52184,"_3053":52267},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3585":448,"_31232":411,"_21602":52269,"_5":14833,"_28348":52184,"_3053":52270},[],"Locate the authz pod and Service.",{"_3585":449,"_31232":411,"_21602":52272,"_5":14833,"_28348":52184,"_3053":52273},[],"Check /health, logs and its database connection.",{"_3585":450,"_31232":411,"_21602":52275,"_5":14833,"_28348":52184,"_3053":52276},[],"Verify the DNS and port configured in externalAuthorization.",{"_3585":451,"_31232":411,"_21602":52278,"_5":14833,"_28348":52184,"_3053":52279},[],"Check the check route is /v1/ext\\_authz/check.",{"_3585":452,"_31232":411,"_21602":52281,"_5":14833,"_28348":52184,"_3053":52282},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3585":453,"_31232":411,"_21602":52284,"_5":14833,"_28348":52188,"_3053":52285},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3585":454,"_31232":411,"_21602":52287,"_5":14833,"_28348":52192,"_3053":52288},[],"Review kubectl describe pod first. Common causes are:",{"_3585":455,"_31232":411,"_21602":52290,"_5":14833,"_28348":52192,"_3053":52291},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3585":456,"_31232":411,"_21602":52293,"_5":14833,"_28348":52192,"_3053":52294},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3585":457,"_31232":411,"_21602":52296,"_5":14833,"_28348":52192,"_3053":52297},[],"unbound persistent volume;",{"_3585":458,"_31232":411,"_21602":52299,"_5":14833,"_28348":52192,"_3053":52300},[],"inaccessible image or incorrect pull policy;",{"_3585":459,"_31232":411,"_21602":52302,"_5":14833,"_28348":52192,"_3053":52303},[],"invalid cryptographic engine configuration;",{"_3585":460,"_31232":411,"_21602":52305,"_5":14833,"_28348":52192,"_3053":52306},[],"CPU or memory limits set too low;",{"_3585":461,"_31232":411,"_21602":52308,"_5":14833,"_28348":52192,"_3053":52309},[],"an incomplete prior migration.",{"_3585":462,"_31232":411,"_21602":52311,"_5":14833,"_28348":52192,"_3053":52312},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3585":463,"_31232":411,"_21602":52314,"_5":14833,"_28348":52192,"_3053":52315},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3585":464,"_31232":411,"_21602":52317,"_5":14833,"_28348":52192,"_3053":52318},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3585":465,"_31232":411,"_21602":52320,"_5":14833,"_28348":52196,"_3053":52321},[],"Domain and audit events depend on the bus publisher:",{"_3585":466,"_31232":411,"_21602":52323,"_5":14833,"_28348":52196,"_3053":52324},[],"verify it is enabled in the emitting service;",{"_3585":467,"_31232":411,"_21602":52326,"_5":14833,"_28348":52196,"_3053":52327},[],"check AMQP connectivity and credentials;",{"_3585":468,"_31232":411,"_21602":52329,"_5":14833,"_28348":52196,"_3053":52330},[],"review exchange, routing key, queues and consumers;",{"_3585":469,"_31232":411,"_21602":52332,"_5":14833,"_28348":52196,"_3053":52333},[],"inspect dead-letter queues;",{"_3585":470,"_31232":411,"_21602":52335,"_5":14833,"_28348":52196,"_3053":52336},[],"alert on orphan durable queues and backlog growth.",{"_3585":471,"_31232":411,"_21602":52338,"_5":14833,"_28348":52196,"_3053":52339},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3585":472,"_31232":411,"_21602":52341,"_5":14833,"_28348":52196,"_3053":52342},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3585":473,"_31232":411,"_21602":52344,"_5":14833,"_28348":52196,"_3053":52345},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3585":474,"_31232":411,"_21602":52347,"_5":14833,"_28348":52196,"_3053":52348},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3585":475,"_31232":411,"_21602":52350,"_5":14833,"_28348":52196,"_3053":52351},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3585":476,"_31232":411,"_21602":52353,"_5":14833,"_28348":52196,"_3053":52354},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3585":477,"_31232":411,"_21602":52356,"_5":14833,"_28348":52196,"_3053":52357},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3585":478,"_31232":411,"_21602":52359,"_5":14833,"_28348":52200,"_3053":52360},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3585":479,"_31232":411,"_21602":52362,"_5":14833,"_28348":52200,"_3053":52363},[],"Before closing an incident, record:",{"_3585":480,"_31232":411,"_21602":52365,"_5":14833,"_28348":52200,"_3053":52366},[],"the confirmed cause;",{"_3585":481,"_31232":411,"_21602":52368,"_5":14833,"_28348":52200,"_3053":52369},[],"the time scope and affected resources;",{"_3585":482,"_31232":411,"_21602":52371,"_5":14833,"_28348":52200,"_3053":52372},[],"the commands or queries used;",{"_3585":483,"_31232":411,"_21602":52374,"_5":14833,"_28348":52200,"_3053":52375},[],"the applied change and how to revert it;",{"_3585":484,"_31232":411,"_21602":52377,"_5":14833,"_28348":52200,"_3053":52378},[],"validation from a consumer;",{"_3585":485,"_31232":411,"_21602":52380,"_5":14833,"_28348":52200,"_3053":52381},[],"the preventive action and its owner.",{"_3585":486,"_31232":486,"_5":15204,"_3053":52383,"_31590":52384,"_21602":52387,"_28348":486},"Access control",[50910,52385,52386],"Platform","Administration",[],{"_3585":487,"_31232":486,"_21602":52389,"_5":14833,"_28348":486,"_3053":52390},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3585":488,"_31232":486,"_5":31587,"_21602":52392,"_28348":52393,"_3053":52394},[],"/docs/pr-preview/pr-61/platform/administration/access-control#essential-concepts","Essential concepts",{"_3585":489,"_31232":486,"_5":31587,"_21602":52396,"_28348":52397,"_3053":52398},[],"/docs/pr-preview/pr-61/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3585":490,"_31232":486,"_5":31587,"_21602":52400,"_28348":52401,"_3053":52402},[],"/docs/pr-preview/pr-61/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3585":491,"_31232":486,"_5":31587,"_21602":52404,"_28348":52405,"_3053":52406},[],"/docs/pr-preview/pr-61/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3585":492,"_31232":486,"_5":31587,"_21602":52408,"_28348":52409,"_3053":52410},[],"/docs/pr-preview/pr-61/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3585":493,"_31232":486,"_5":31587,"_21602":52412,"_28348":52413,"_3053":52414},[],"/docs/pr-preview/pr-61/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3585":494,"_31232":486,"_5":31587,"_21602":52416,"_28348":52417,"_3053":52418},[],"/docs/pr-preview/pr-61/platform/administration/access-control#oidc-principals","OIDC principals",{"_3585":495,"_31232":486,"_5":31587,"_21602":52420,"_28348":52421,"_3053":52422},[],"/docs/pr-preview/pr-61/platform/administration/access-control#x509-principals","X.509 principals",{"_3585":496,"_31232":486,"_5":31587,"_21602":52424,"_28348":52425,"_3053":52426},[],"/docs/pr-preview/pr-61/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3585":497,"_31232":486,"_5":31587,"_21602":52428,"_28348":52429,"_3053":52430},[],"/docs/pr-preview/pr-61/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3585":498,"_31232":486,"_5":31587,"_21602":52432,"_28348":52433,"_3053":52434},[],"/docs/pr-preview/pr-61/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3585":499,"_31232":486,"_5":31587,"_21602":52436,"_28348":52437,"_3053":52438},[],"/docs/pr-preview/pr-61/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3585":500,"_31232":486,"_5":31587,"_21602":52440,"_28348":52441,"_3053":52442},[],"/docs/pr-preview/pr-61/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3585":501,"_31232":486,"_5":31587,"_21602":52444,"_28348":52445,"_3053":52446},[],"/docs/pr-preview/pr-61/platform/administration/access-control#http-rules","HTTP rules",{"_3585":502,"_31232":486,"_5":31587,"_21602":52448,"_28348":52449,"_3053":52450},[],"/docs/pr-preview/pr-61/platform/administration/access-control#included-policies","Included policies",{"_3585":503,"_31232":486,"_5":31587,"_21602":52452,"_28348":52453,"_3053":51550},[],"/docs/pr-preview/pr-61/platform/administration/access-control#provision-the-first-administrator",{"_3585":504,"_31232":486,"_5":31587,"_21602":52455,"_28348":52456,"_3053":52457},[],"/docs/pr-preview/pr-61/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3585":505,"_31232":486,"_5":31587,"_21602":52459,"_28348":52460,"_3053":52461},[],"/docs/pr-preview/pr-61/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3585":506,"_31232":486,"_5":31587,"_21602":52463,"_28348":52464,"_3053":52465},[],"/docs/pr-preview/pr-61/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3585":507,"_31232":486,"_5":31587,"_21602":52467,"_28348":52468,"_3053":52469},[],"/docs/pr-preview/pr-61/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3585":508,"_31232":486,"_5":31587,"_21602":52471,"_28348":52472,"_3053":52473},[],"/docs/pr-preview/pr-61/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3585":509,"_31232":486,"_5":31587,"_21602":52475,"_28348":52476,"_3053":52477},[],"/docs/pr-preview/pr-61/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3585":510,"_31232":486,"_5":31587,"_21602":52479,"_28348":52480,"_3053":52481},[],"/docs/pr-preview/pr-61/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3585":511,"_31232":486,"_5":31587,"_21602":52483,"_28348":52484,"_3053":52485},[],"/docs/pr-preview/pr-61/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3585":512,"_31232":486,"_5":31587,"_21602":52487,"_28348":52488,"_3053":52489},[],"/docs/pr-preview/pr-61/platform/administration/access-control#operational-checklist","Operational checklist",{"_3585":513,"_31232":486,"_5":31587,"_21602":52491,"_28348":52492,"_3053":52493},[],"/docs/pr-preview/pr-61/platform/administration/access-control#diagnostics","Diagnostics",{"_3585":514,"_31232":486,"_5":31587,"_21602":52495,"_28348":52496,"_3053":52497},[],"/docs/pr-preview/pr-61/platform/administration/access-control#the-response-is-401","The response is 401",{"_3585":515,"_31232":486,"_5":31587,"_21602":52499,"_28348":52500,"_3053":52501},[],"/docs/pr-preview/pr-61/platform/administration/access-control#the-response-is-403","The response is 403",{"_3585":516,"_31232":486,"_5":31587,"_21602":52503,"_28348":52504,"_3053":52505},[],"/docs/pr-preview/pr-61/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3585":517,"_31232":486,"_5":31587,"_21602":52507,"_28348":52508,"_3053":52509},[],"/docs/pr-preview/pr-61/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3585":518,"_31232":486,"_5":31587,"_21602":52511,"_28348":52512,"_3053":52513},[],"/docs/pr-preview/pr-61/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3585":519,"_31232":486,"_21602":52515,"_5":14833,"_28348":486,"_3053":52516},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3585":520,"_31232":486,"_21602":52518,"_5":14833,"_28348":486,"_3053":52519},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3585":521,"_31232":486,"_21602":52521,"_5":14833,"_28348":486,"_3053":52522},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3585":522,"_31232":486,"_21602":52524,"_5":14833,"_28348":52393,"_3053":52525},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3585":523,"_31232":486,"_21602":52527,"_5":14833,"_28348":52393,"_3053":52528},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3585":524,"_31232":486,"_21602":52530,"_5":14833,"_28348":52393,"_3053":52531},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3585":525,"_31232":486,"_21602":52533,"_5":14833,"_28348":52393,"_3053":52534},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3585":526,"_31232":486,"_21602":52536,"_5":14833,"_28348":52393,"_3053":52537},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3585":527,"_31232":486,"_21602":52539,"_5":14833,"_28348":52393,"_3053":52540},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3585":528,"_31232":486,"_21602":52542,"_5":14833,"_28348":52397,"_3053":52543},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3585":529,"_31232":486,"_21602":52545,"_5":14833,"_28348":52397,"_3053":52546},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3585":530,"_31232":486,"_21602":52548,"_5":14833,"_28348":52401,"_3053":52549},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3585":531,"_31232":486,"_21602":52551,"_5":14833,"_28348":52401,"_3053":52552},[],"The decision is made **before forwarding the request to the service**:",{"_3585":532,"_31232":486,"_21602":52554,"_5":14833,"_28348":52401,"_3053":52555},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3585":533,"_31232":486,"_21602":52557,"_5":14833,"_28348":52401,"_3053":52558},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3585":534,"_31232":486,"_21602":52560,"_5":14833,"_28348":52401,"_3053":52561},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3585":535,"_31232":486,"_21602":52563,"_5":14833,"_28348":52401,"_3053":52564},[],"It separately loads the policies granted to each principal.",{"_3585":536,"_31232":486,"_21602":52566,"_5":14833,"_28348":52401,"_3053":52567},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3585":537,"_31232":486,"_21602":52569,"_5":14833,"_28348":52401,"_3053":52570},[],"`authz` looks for an HTTP rule granting that action.",{"_3585":538,"_31232":486,"_21602":52572,"_5":14833,"_28348":52401,"_3053":52573},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3585":539,"_31232":486,"_21602":52575,"_5":14833,"_28348":52401,"_3053":52576},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3585":540,"_31232":486,"_21602":52578,"_5":14833,"_28348":52401,"_3053":52579},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3585":541,"_31232":486,"_21602":52581,"_5":14833,"_28348":52401,"_3053":52582},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3585":542,"_31232":486,"_21602":52584,"_5":14833,"_28348":52405,"_3053":52585},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3585":543,"_31232":486,"_21602":52587,"_5":14833,"_28348":52405,"_3053":52588},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3585":544,"_31232":486,"_21602":52590,"_5":14833,"_28348":52405,"_3053":52591},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3585":545,"_31232":486,"_21602":52593,"_5":14833,"_28348":52405,"_3053":52594},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3585":546,"_31232":486,"_21602":52596,"_5":14833,"_28348":52405,"_3053":52597},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3585":547,"_31232":486,"_21602":52599,"_5":14833,"_28348":52405,"_3053":52600},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3585":548,"_31232":486,"_21602":52602,"_5":14833,"_28348":52405,"_3053":52603},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3585":549,"_31232":486,"_21602":52605,"_5":14833,"_28348":52405,"_3053":52606},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3585":550,"_31232":486,"_21602":52608,"_5":14833,"_28348":52409,"_3053":52609},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3585":551,"_31232":486,"_21602":52611,"_5":14833,"_28348":52409,"_3053":52612},[],"The decision is made with the domain operation context:",{"_3585":552,"_31232":486,"_21602":52614,"_5":14833,"_28348":52409,"_3053":52615},[],"The middleware extracts the credential and resolves the matching principals.",{"_3585":553,"_31232":486,"_21602":52617,"_5":14833,"_28348":52409,"_3053":52618},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3585":554,"_31232":486,"_21602":52620,"_5":14833,"_28348":52409,"_3053":52621},[],"`authz` gathers the entity rules of the granted policies.",{"_3585":555,"_31232":486,"_21602":52623,"_5":14833,"_28348":52409,"_3053":52624},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3585":556,"_31232":486,"_21602":52626,"_5":14833,"_28348":52409,"_3053":52627},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3585":557,"_31232":486,"_21602":52629,"_5":14833,"_28348":52409,"_3053":52630},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3585":558,"_31232":486,"_21602":52632,"_5":14833,"_28348":52409,"_3053":52633},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3585":559,"_31232":486,"_21602":52635,"_5":14833,"_28348":52409,"_3053":52636},[],"Actions fall into two groups:",{"_3585":560,"_31232":486,"_21602":52638,"_5":14833,"_28348":52409,"_3053":52639},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3585":561,"_31232":486,"_21602":52641,"_5":14833,"_28348":52409,"_3053":52642},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3585":562,"_31232":486,"_21602":52644,"_5":14833,"_28348":52409,"_3053":52645},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3585":563,"_31232":486,"_21602":52647,"_5":14833,"_28348":52413,"_3053":52648},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3585":564,"_31232":486,"_21602":52650,"_5":14833,"_28348":52413,"_3053":52651},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3585":565,"_31232":486,"_21602":52653,"_5":14833,"_28348":52413,"_3053":52654},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3585":566,"_31232":486,"_21602":52656,"_5":14833,"_28348":52417,"_3053":52657},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3585":567,"_31232":486,"_21602":52659,"_5":14833,"_28348":52417,"_3053":52660},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3585":568,"_31232":486,"_21602":52662,"_5":14833,"_28348":52417,"_3053":52663},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3585":569,"_31232":486,"_21602":52665,"_5":14833,"_28348":52417,"_3053":52666},[],"The implemented operators are:",{"_3585":570,"_31232":486,"_21602":52668,"_5":14833,"_28348":52417,"_3053":52669},[],"`equals`, for exact equality;",{"_3585":571,"_31232":486,"_21602":52671,"_5":14833,"_28348":52417,"_3053":52672},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3585":572,"_31232":486,"_21602":52674,"_5":14833,"_28348":52417,"_3053":52675},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3585":573,"_31232":486,"_21602":52677,"_5":14833,"_28348":52417,"_3053":52678},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3585":574,"_31232":486,"_21602":52680,"_5":14833,"_28348":52421,"_3053":52681},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3585":575,"_31232":486,"_21602":52683,"_5":14833,"_28348":52421,"_3053":52684},[],"The available modes are:",{"_3585":576,"_31232":486,"_21602":52686,"_5":14833,"_28348":52421,"_3053":52687},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3585":577,"_31232":486,"_21602":52689,"_5":14833,"_28348":52421,"_3053":52690},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3585":578,"_31232":486,"_21602":52692,"_5":14833,"_28348":52421,"_3053":52693},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3585":579,"_31232":486,"_21602":52695,"_5":14833,"_28348":52421,"_3053":52696},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3585":580,"_31232":486,"_21602":52698,"_5":14833,"_28348":52421,"_3053":52699},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3585":581,"_31232":486,"_21602":52701,"_5":14833,"_28348":52421,"_3053":52702},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3585":582,"_31232":486,"_21602":52704,"_5":14833,"_28348":52425,"_3053":52705},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3585":583,"_31232":486,"_21602":52707,"_5":14833,"_28348":52425,"_3053":52708},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3585":584,"_31232":486,"_21602":52710,"_5":14833,"_28348":52425,"_3053":52711},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3585":585,"_31232":486,"_21602":52713,"_5":14833,"_28348":52425,"_3053":52714},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3585":586,"_31232":486,"_21602":52716,"_5":14833,"_28348":52433,"_3053":52717},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3585":587,"_31232":486,"_21602":52719,"_5":14833,"_28348":52433,"_3053":52720},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3585":588,"_31232":486,"_21602":52722,"_5":14833,"_28348":52437,"_3053":52723},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3585":589,"_31232":486,"_21602":52725,"_5":14833,"_28348":52437,"_3053":52726},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3585":590,"_31232":486,"_21602":52728,"_5":14833,"_28348":52441,"_3053":52729},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3585":591,"_31232":486,"_21602":52731,"_5":14833,"_28348":52441,"_3053":52732},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3585":592,"_31232":486,"_21602":52734,"_5":14833,"_28348":52441,"_3053":52735},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3585":593,"_31232":486,"_21602":52737,"_5":14833,"_28348":52445,"_3053":52738},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3585":594,"_31232":486,"_21602":52740,"_5":14833,"_28348":52445,"_3053":52741},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3585":595,"_31232":486,"_21602":52743,"_5":14833,"_28348":52445,"_3053":52744},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3585":596,"_31232":486,"_21602":52746,"_5":14833,"_28348":52445,"_3053":52747},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3585":597,"_31232":486,"_21602":52749,"_5":14833,"_28348":52445,"_3053":52750},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3585":598,"_31232":486,"_21602":52752,"_5":14833,"_28348":52445,"_3053":52753},[],"Note that:",{"_3585":599,"_31232":486,"_21602":52755,"_5":14833,"_28348":52445,"_3053":52756},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3585":600,"_31232":486,"_21602":52758,"_5":14833,"_28348":52445,"_3053":52759},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3585":601,"_31232":486,"_21602":52761,"_5":14833,"_28348":52445,"_3053":52762},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3585":602,"_31232":486,"_21602":52764,"_5":14833,"_28348":52449,"_3053":52765},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3585":603,"_31232":486,"_21602":52767,"_5":14833,"_28348":52449,"_3053":52768},[],"full and read-only access to certificates and authorities;",{"_3585":604,"_31232":486,"_21602":52770,"_5":14833,"_28348":52449,"_3053":52771},[],"full and read-only access to the KMS;",{"_3585":605,"_31232":486,"_21602":52773,"_5":14833,"_28348":52449,"_3053":52774},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3585":606,"_31232":486,"_21602":52776,"_5":14833,"_28348":52449,"_3053":52777},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3585":607,"_31232":486,"_21602":52779,"_5":14833,"_28348":52449,"_3053":52780},[],"console access;",{"_3585":608,"_31232":486,"_21602":52782,"_5":14833,"_28348":52449,"_3053":52783},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3585":609,"_31232":486,"_21602":52785,"_5":14833,"_28348":52449,"_3053":52786},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3585":610,"_31232":486,"_21602":52788,"_5":14833,"_28348":52449,"_3053":52789},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3585":611,"_31232":486,"_21602":52791,"_5":14833,"_28348":52453,"_3053":52792},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3585":612,"_31232":486,"_21602":52794,"_5":14833,"_28348":52453,"_3053":52795},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3585":613,"_31232":486,"_21602":52797,"_5":14833,"_28348":52453,"_3053":52798},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3585":614,"_31232":486,"_21602":52800,"_5":14833,"_28348":52456,"_3053":52801},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3585":615,"_31232":486,"_21602":52803,"_5":14833,"_28348":52460,"_3053":52804},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3585":616,"_31232":486,"_21602":52806,"_5":14833,"_28348":52460,"_3053":52807},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3585":617,"_31232":486,"_21602":52809,"_5":14833,"_28348":52464,"_3053":52810},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3585":618,"_31232":486,"_21602":52812,"_5":14833,"_28348":52468,"_3053":52813},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3585":619,"_31232":486,"_21602":52815,"_5":14833,"_28348":52472,"_3053":52816},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3585":620,"_31232":486,"_21602":52818,"_5":14833,"_28348":52476,"_3053":52819},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3585":621,"_31232":486,"_21602":52821,"_5":14833,"_28348":52476,"_3053":52822},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3585":622,"_31232":486,"_21602":52824,"_5":14833,"_28348":52480,"_3053":52825},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3585":623,"_31232":486,"_21602":52827,"_5":14833,"_28348":52480,"_3053":52828},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3585":624,"_31232":486,"_21602":52830,"_5":14833,"_28348":52480,"_3053":52831},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3585":625,"_31232":486,"_21602":52833,"_5":14833,"_28348":52480,"_3053":52834},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3585":626,"_31232":486,"_21602":52836,"_5":14833,"_28348":52480,"_3053":52837},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3585":627,"_31232":486,"_21602":52839,"_5":14833,"_28348":52480,"_3053":52840},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3585":628,"_31232":486,"_21602":52842,"_5":14833,"_28348":52480,"_3053":52843},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3585":629,"_31232":486,"_21602":52845,"_5":14833,"_28348":52480,"_3053":52846},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3585":630,"_31232":486,"_21602":52848,"_5":14833,"_28348":52484,"_3053":52849},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3585":631,"_31232":486,"_21602":52851,"_5":14833,"_28348":52484,"_3053":52852},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3585":632,"_31232":486,"_21602":52854,"_5":14833,"_28348":52484,"_3053":52855},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3585":633,"_31232":486,"_21602":52857,"_5":14833,"_28348":52488,"_3053":52858},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3585":634,"_31232":486,"_21602":52860,"_5":14833,"_28348":52488,"_3053":52861},[],"Use groups or stable roles for people and independent identities for automations.",{"_3585":635,"_31232":486,"_21602":52863,"_5":14833,"_28348":52488,"_3053":52864},[],"Keep at least two recovery administrators and test their access periodically.",{"_3585":636,"_31232":486,"_21602":52866,"_5":14833,"_28348":52488,"_3053":52867},[],"Review active principals, their matches and their grants after IdP changes.",{"_3585":637,"_31232":486,"_21602":52869,"_5":14833,"_28348":52488,"_3053":52870},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3585":638,"_31232":486,"_21602":52872,"_5":14833,"_28348":52488,"_3053":52873},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3585":639,"_31232":486,"_21602":52875,"_5":14833,"_28348":52488,"_3053":52876},[],"Always test one allowed and one denied operation for each role.",{"_3585":640,"_31232":486,"_21602":52878,"_5":14833,"_28348":52488,"_3053":52879},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3585":641,"_31232":486,"_21602":52881,"_5":14833,"_28348":52496,"_3053":52882},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3585":642,"_31232":486,"_21602":52884,"_5":14833,"_28348":52500,"_3053":52885},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3585":643,"_31232":486,"_21602":52887,"_5":14833,"_28348":52500,"_3053":52888},[],"that an active principal of the correct type exists;",{"_3585":644,"_31232":486,"_21602":52890,"_5":14833,"_28348":52500,"_3053":52891},[],"that the claim paths and values match the real token exactly;",{"_3585":645,"_31232":486,"_21602":52893,"_5":14833,"_28348":52500,"_3053":52894},[],"that all of the principal's conditions hold;",{"_3585":646,"_31232":486,"_21602":52896,"_5":14833,"_28348":52500,"_3053":52897},[],"that the principal has the expected policy granted;",{"_3585":647,"_31232":486,"_21602":52899,"_5":14833,"_28348":52500,"_3053":52900},[],"that the policy includes the action and the requested resource type or route;",{"_3585":648,"_31232":486,"_21602":52902,"_5":14833,"_28348":52500,"_3053":52903},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3585":649,"_31232":486,"_21602":52905,"_5":14833,"_28348":52500,"_3053":52906},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3585":650,"_31232":486,"_21602":52908,"_5":14833,"_28348":52504,"_3053":52909},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3585":651,"_31232":486,"_21602":52911,"_5":14833,"_28348":52508,"_3053":52912},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3585":652,"_31232":486,"_21602":52914,"_5":14833,"_28348":52512,"_3053":52915},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3585":653,"_31232":486,"_21602":52917,"_5":14833,"_28348":52512,"_3053":52918},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3585":654,"_31232":654,"_5":15204,"_3053":52920,"_31590":52921,"_21602":52922,"_28348":654},"Alerts and subscriptions",[50910,52385,52386],[],{"_3585":655,"_31232":654,"_21602":52924,"_5":14833,"_28348":654,"_3053":52925},[],"Send PKI events to people and external systems.",{"_3585":656,"_31232":654,"_5":31587,"_21602":52927,"_28348":52928,"_3053":52929},[],"/docs/pr-preview/pr-61/platform/administration/alerts#how-it-works","How it works",{"_3585":657,"_31232":654,"_5":31587,"_21602":52931,"_28348":52932,"_3053":52933},[],"/docs/pr-preview/pr-61/platform/administration/alerts#available-channels","Available channels",{"_3585":658,"_31232":654,"_5":31587,"_21602":52935,"_28348":52936,"_3053":52937},[],"/docs/pr-preview/pr-61/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3585":659,"_31232":654,"_5":31587,"_21602":52939,"_28348":52940,"_3053":52941},[],"/docs/pr-preview/pr-61/platform/administration/alerts#choose-the-event","Choose the event",{"_3585":660,"_31232":654,"_5":31587,"_21602":52943,"_28348":52944,"_3053":52945},[],"/docs/pr-preview/pr-61/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3585":661,"_31232":654,"_5":31587,"_21602":52947,"_28348":52948,"_3053":52949},[],"/docs/pr-preview/pr-61/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3585":662,"_31232":654,"_5":31587,"_21602":52951,"_28348":52952,"_3053":52953},[],"/docs/pr-preview/pr-61/platform/administration/alerts#review-and-activate","Review and activate",{"_3585":663,"_31232":654,"_5":31587,"_21602":52955,"_28348":52956,"_3053":52957},[],"/docs/pr-preview/pr-61/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3585":664,"_31232":654,"_5":31587,"_21602":52959,"_28348":52960,"_3053":52961},[],"/docs/pr-preview/pr-61/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3585":665,"_31232":654,"_5":31587,"_21602":52963,"_28348":52964,"_3053":52965},[],"/docs/pr-preview/pr-61/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3585":666,"_31232":654,"_5":31587,"_21602":52967,"_28348":52968,"_3053":52969},[],"/docs/pr-preview/pr-61/platform/administration/alerts#event-families","Event families",{"_3585":667,"_31232":654,"_21602":52971,"_5":14833,"_28348":654,"_3053":52972},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3585":668,"_31232":654,"_21602":52974,"_5":14833,"_28348":52928,"_3053":52975},[],"A service publishes a domain event.",{"_3585":669,"_31232":654,"_21602":52977,"_5":14833,"_28348":52928,"_3053":52978},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3585":670,"_31232":654,"_21602":52980,"_5":14833,"_28348":52928,"_3053":52981},[],"Each subscription's filter decides whether it should be notified.",{"_3585":671,"_31232":654,"_21602":52983,"_5":14833,"_28348":52928,"_3053":52984},[],"Lamassu delivers the event to the configured channel.",{"_3585":672,"_31232":654,"_21602":52986,"_5":14833,"_28348":52928,"_3053":52987},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3585":673,"_31232":654,"_21602":52989,"_5":14833,"_28348":52932,"_3053":52990},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3585":674,"_31232":654,"_21602":52992,"_5":14833,"_28348":52932,"_3053":52993},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3585":675,"_31232":654,"_21602":52995,"_5":14833,"_28348":52932,"_3053":52996},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3585":676,"_31232":654,"_21602":52998,"_5":14833,"_28348":52932,"_3053":52999},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3585":677,"_31232":654,"_21602":53001,"_5":14833,"_28348":52932,"_3053":53002},[],"`apikey_options` requires `header` and `key`.",{"_3585":678,"_31232":654,"_21602":53004,"_5":14833,"_28348":52932,"_3053":53005},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3585":679,"_31232":654,"_21602":53007,"_5":14833,"_28348":52932,"_3053":53008},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3585":680,"_31232":654,"_21602":53010,"_5":14833,"_28348":52932,"_3053":53011},[],"The alerts API reference documents the full `http_client` schema.",{"_3585":681,"_31232":654,"_21602":53013,"_5":14833,"_28348":52940,"_3053":53014},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3585":682,"_31232":654,"_21602":53016,"_5":14833,"_28348":52944,"_3053":53017},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3585":683,"_31232":654,"_21602":53019,"_5":14833,"_28348":52948,"_3053":53020},[],"Add a filter if you don't want to receive every instance of the event.",{"_3585":684,"_31232":654,"_21602":53022,"_5":14833,"_28348":52948,"_3053":53023},[],"**None** notifies all instances of the event.",{"_3585":685,"_31232":654,"_21602":53025,"_5":14833,"_28348":52948,"_3053":53026},[],"**JSON Path** evaluates one or more specific fields.",{"_3585":686,"_31232":654,"_21602":53028,"_5":14833,"_28348":52948,"_3053":53029},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3585":687,"_31232":654,"_21602":53031,"_5":14833,"_28348":52948,"_3053":53032},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3585":688,"_31232":654,"_21602":53034,"_5":14833,"_28348":52948,"_3053":53035},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3585":689,"_31232":654,"_21602":53037,"_5":14833,"_28348":52948,"_3053":53038},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3585":690,"_31232":654,"_21602":53040,"_5":14833,"_28348":52952,"_3053":53041},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3585":691,"_31232":654,"_21602":53043,"_5":14833,"_28348":52956,"_3053":53044},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3585":692,"_31232":654,"_21602":53046,"_5":14833,"_28348":52956,"_3053":53047},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3585":693,"_31232":654,"_21602":53049,"_5":14833,"_28348":52956,"_3053":53050},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3585":694,"_31232":654,"_21602":53052,"_5":14833,"_28348":52956,"_3053":53053},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3585":695,"_31232":654,"_21602":53055,"_5":14833,"_28348":52956,"_3053":53056},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3585":696,"_31232":654,"_21602":53058,"_5":14833,"_28348":52956,"_3053":53059},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3585":697,"_31232":654,"_21602":53061,"_5":14833,"_28348":52956,"_3053":53062},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3585":698,"_31232":654,"_21602":53064,"_5":14833,"_28348":52956,"_3053":53065},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3585":699,"_31232":654,"_21602":53067,"_5":14833,"_28348":52960,"_3053":53068},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3585":700,"_31232":654,"_21602":53070,"_5":14833,"_28348":52960,"_3053":53071},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3585":701,"_31232":654,"_21602":53073,"_5":14833,"_28348":52960,"_3053":53074},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3585":702,"_31232":654,"_21602":53076,"_5":14833,"_28348":52960,"_3053":53077},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3585":703,"_31232":654,"_21602":53079,"_5":14833,"_28348":52960,"_3053":53080},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3585":704,"_31232":654,"_21602":53082,"_5":14833,"_28348":52960,"_3053":53083},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3585":705,"_31232":654,"_21602":53085,"_5":14833,"_28348":52960,"_3053":53086},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3585":706,"_31232":654,"_21602":53088,"_5":14833,"_28348":52960,"_3053":53089},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3585":707,"_31232":654,"_21602":53091,"_5":14833,"_28348":52964,"_3053":53092},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3585":708,"_31232":654,"_21602":53094,"_5":14833,"_28348":52964,"_3053":53095},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3585":709,"_31232":654,"_21602":53097,"_5":14833,"_28348":52968,"_3053":53098},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3585":710,"_31232":654,"_21602":53100,"_5":14833,"_28348":52968,"_3053":53101},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3585":711,"_31232":654,"_21602":53103,"_5":14833,"_28348":52968,"_3053":53104},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3585":712,"_31232":654,"_21602":53106,"_5":14833,"_28348":52968,"_3053":53107},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3585":713,"_31232":654,"_21602":53109,"_5":14833,"_28348":52968,"_3053":53110},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3585":714,"_31232":654,"_21602":53112,"_5":14833,"_28348":52968,"_3053":53113},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3585":715,"_31232":654,"_21602":53115,"_5":14833,"_28348":52968,"_3053":53116},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3585":716,"_31232":654,"_21602":53118,"_5":14833,"_28348":52968,"_3053":53119},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3585":717,"_31232":654,"_21602":53121,"_5":14833,"_28348":52968,"_3053":53122},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3585":718,"_31232":718,"_5":15204,"_3053":53124,"_31590":53125,"_21602":53126,"_28348":718},"Audit logs",[50910,52385,52386],[],{"_3585":719,"_31232":718,"_21602":53128,"_5":14833,"_28348":718,"_3053":53129},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3585":720,"_31232":718,"_5":31587,"_21602":53131,"_28348":53132,"_3053":53133},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3585":721,"_31232":718,"_5":31587,"_21602":53135,"_28348":53136,"_3053":53137},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#coverage","Coverage",{"_3585":722,"_31232":718,"_5":31587,"_21602":53139,"_28348":53140,"_3053":53141},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3585":723,"_31232":718,"_5":31587,"_21602":53143,"_28348":53144,"_3053":53145},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3585":724,"_31232":718,"_5":31587,"_21602":53147,"_28348":53148,"_3053":53149},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3585":725,"_31232":718,"_5":31587,"_21602":53151,"_28348":53152,"_3053":53153},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3585":726,"_31232":718,"_5":31587,"_21602":53155,"_28348":53156,"_3053":53157},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3585":727,"_31232":718,"_5":31587,"_21602":53159,"_28348":53160,"_3053":53161},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3585":728,"_31232":718,"_5":31587,"_21602":53163,"_28348":53164,"_3053":53165},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3585":729,"_31232":718,"_5":31587,"_21602":53167,"_28348":53168,"_3053":53169},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3585":730,"_31232":718,"_5":31587,"_21602":53171,"_28348":53172,"_3053":53173},[],"/docs/pr-preview/pr-61/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3585":731,"_31232":718,"_21602":53175,"_5":14833,"_28348":718,"_3053":53176},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3585":732,"_31232":718,"_21602":53178,"_5":14833,"_28348":53132,"_3053":53179},[],"The audit body includes:",{"_3585":733,"_31232":718,"_21602":53181,"_5":14833,"_28348":53132,"_3053":53182},[],"input: data received by the operation;",{"_3585":734,"_31232":718,"_21602":53184,"_5":14833,"_28348":53132,"_3053":53185},[],"has\\_error: whether the service returned an error;",{"_3585":735,"_31232":718,"_21602":53187,"_5":14833,"_28348":53132,"_3053":53188},[],"output: produced result or error message;",{"_3585":736,"_31232":718,"_21602":53190,"_5":14833,"_28348":53132,"_3053":53191},[],"principals: identifiers of the principals that matched the request.",{"_3585":737,"_31232":718,"_21602":53193,"_5":14833,"_28348":53132,"_3053":53194},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3585":738,"_31232":718,"_21602":53196,"_5":14833,"_28348":53132,"_3053":53197},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3585":739,"_31232":718,"_21602":53199,"_5":14833,"_28348":53136,"_3053":53200},[],"The backend applies auditing to mutations of:",{"_3585":740,"_31232":718,"_21602":53202,"_5":14833,"_28348":53136,"_3053":53203},[],"authorities, certificates and issuance profiles;",{"_3585":741,"_31232":718,"_21602":53205,"_5":14833,"_28348":53136,"_3053":53206},[],"keys and KMS engines;",{"_3585":742,"_31232":718,"_21602":53208,"_5":14833,"_28348":53136,"_3053":53209},[],"devices and identities;",{"_3585":743,"_31232":718,"_21602":53211,"_5":14833,"_28348":53136,"_3053":53212},[],"DMSs and enrollment operations;",{"_3585":744,"_31232":718,"_21602":53214,"_5":14833,"_28348":53136,"_3053":53215},[],"validation functions and CRL;",{"_3585":745,"_31232":718,"_21602":53217,"_5":14833,"_28348":53136,"_3053":53218},[],"principals, policies and authorization grants.",{"_3585":746,"_31232":718,"_21602":53220,"_5":14833,"_28348":53136,"_3053":53221},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3585":747,"_31232":718,"_21602":53223,"_5":14833,"_28348":53140,"_3053":53224},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3585":748,"_31232":718,"_21602":53226,"_5":14833,"_28348":53140,"_3053":53227},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3585":749,"_31232":718,"_21602":53229,"_5":14833,"_28348":53140,"_3053":53230},[],"Design the consumer to:",{"_3585":750,"_31232":718,"_21602":53232,"_5":14833,"_28348":53140,"_3053":53233},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3585":751,"_31232":718,"_21602":53235,"_5":14833,"_28348":53140,"_3053":53236},[],"keep the complete CloudEvent unmodified;",{"_3585":752,"_31232":718,"_21602":53238,"_5":14833,"_28348":53140,"_3053":53239},[],"record the ingestion time and detect duplicates by ID;",{"_3585":753,"_31232":718,"_21602":53241,"_5":14833,"_28348":53140,"_3053":53242},[],"encrypt in transit and at rest;",{"_3585":754,"_31232":718,"_21602":53244,"_5":14833,"_28348":53140,"_3053":53245},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3585":755,"_31232":718,"_21602":53247,"_5":14833,"_28348":53140,"_3053":53248},[],"apply an explicit retention and legal hold policy;",{"_3585":756,"_31232":718,"_21602":53250,"_5":14833,"_28348":53140,"_3053":53251},[],"alert if it stops consuming or the pending queue grows.",{"_3585":757,"_31232":718,"_21602":53253,"_5":14833,"_28348":53144,"_3053":53254},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3585":758,"_31232":718,"_21602":53256,"_5":14833,"_28348":53144,"_3053":53257},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3585":759,"_31232":718,"_21602":53259,"_5":14833,"_28348":53152,"_3053":53260},[],"Start from the reported time and normalize every source to UTC.",{"_3585":760,"_31232":718,"_21602":53262,"_5":14833,"_28348":53156,"_3053":53263},[],"Filter by event type, service source and resource identifier.",{"_3585":761,"_31232":718,"_21602":53265,"_5":14833,"_28348":53160,"_3053":53266},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3585":762,"_31232":718,"_21602":53268,"_5":14833,"_28348":53164,"_3053":53269},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3585":763,"_31232":718,"_21602":53271,"_5":14833,"_28348":53168,"_3053":53272},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3585":764,"_31232":718,"_21602":53274,"_5":14833,"_28348":53172,"_3053":53275},[],"Generate a controlled mutation in a test environment and check that:",{"_3585":765,"_31232":718,"_21602":53277,"_5":14833,"_28348":53172,"_3053":53278},[],"a successful audit event appears;",{"_3585":766,"_31232":718,"_21602":53280,"_5":14833,"_28348":53172,"_3053":53281},[],"the principal matches the identity used;",{"_3585":767,"_31232":718,"_21602":53283,"_5":14833,"_28348":53172,"_3053":53284},[],"the consumer persists it exactly once;",{"_3585":768,"_31232":718,"_21602":53286,"_5":14833,"_28348":53172,"_3053":53287},[],"it can be retrieved by resource, actor and period;",{"_3585":769,"_31232":718,"_21602":53289,"_5":14833,"_28348":53172,"_3053":53290},[],"a consumer outage raises an alert.",{"_3585":770,"_31232":718,"_21602":53292,"_5":14833,"_28348":53172,"_3053":53293},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3585":771,"_31232":771,"_5":15204,"_3053":53295,"_31590":53296,"_21602":53297,"_28348":771},"Platform architecture",[50910,52385],[],{"_3585":772,"_31232":771,"_21602":53299,"_5":14833,"_28348":771,"_3053":53300},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3585":773,"_31232":771,"_5":31587,"_21602":53302,"_28348":53303,"_3053":53304},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#control-plane","Control plane",{"_3585":774,"_31232":771,"_5":31587,"_21602":53306,"_28348":53307,"_3053":53308},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3585":775,"_31232":771,"_5":31587,"_21602":53310,"_28348":53311,"_3053":53312},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3585":776,"_31232":771,"_5":31587,"_21602":53314,"_28348":53315,"_3053":53316},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#status-and-validation","Status and validation",{"_3585":777,"_31232":771,"_5":31587,"_21602":53318,"_28348":53319,"_3053":53320},[],"/docs/pr-preview/pr-61/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3585":778,"_31232":771,"_21602":53322,"_5":14833,"_28348":771,"_3053":53323},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3585":779,"_31232":771,"_21602":53325,"_5":14833,"_28348":771,"_3053":53326},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3585":780,"_31232":771,"_21602":53328,"_5":14833,"_28348":53303,"_3053":53329},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3585":781,"_31232":771,"_21602":53331,"_5":14833,"_28348":53307,"_3053":53332},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3585":782,"_31232":771,"_21602":53334,"_5":14833,"_28348":53311,"_3053":53335},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3585":783,"_31232":771,"_21602":53337,"_5":14833,"_28348":53315,"_3053":53338},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3585":784,"_31232":771,"_21602":53340,"_5":14833,"_28348":53319,"_3053":53341},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3585":785,"_31232":785,"_5":15204,"_3053":53343,"_31590":53344,"_21602":53345,"_28348":785},"How Lamassu works",[50910,52385],[],{"_3585":786,"_31232":785,"_21602":53347,"_5":14833,"_28348":785,"_3053":53348},[],"The mental model of trust, keys, certificates and devices.",{"_3585":787,"_31232":785,"_5":31587,"_21602":53350,"_28348":53351,"_3053":53352},[],"/docs/pr-preview/pr-61/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3585":788,"_31232":785,"_5":31587,"_21602":53354,"_28348":53355,"_3053":53356},[],"/docs/pr-preview/pr-61/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3585":789,"_31232":785,"_21602":53358,"_5":14833,"_28348":785,"_3053":53359},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3585":790,"_31232":785,"_21602":53361,"_5":14833,"_28348":53351,"_3053":53362},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3585":791,"_31232":785,"_21602":53364,"_5":14833,"_28348":53351,"_3053":53365},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3585":792,"_31232":785,"_21602":53367,"_5":14833,"_28348":53351,"_3053":53368},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3585":793,"_31232":785,"_21602":53370,"_5":14833,"_28348":53351,"_3053":53371},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3585":794,"_31232":785,"_21602":53373,"_5":14833,"_28348":53351,"_3053":53374},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3585":795,"_31232":785,"_21602":53376,"_5":14833,"_28348":53355,"_3053":53377},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3585":796,"_31232":785,"_21602":53379,"_5":14833,"_28348":53355,"_3053":53380},[],"A DMS relates that CA to an enrollment policy.",{"_3585":797,"_31232":785,"_21602":53382,"_5":14833,"_28348":53355,"_3053":53383},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3585":798,"_31232":785,"_21602":53385,"_5":14833,"_28348":53355,"_3053":53386},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3585":799,"_31232":785,"_21602":53388,"_5":14833,"_28348":53355,"_3053":53389},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3585":800,"_31232":785,"_21602":53391,"_5":14833,"_28348":53355,"_3053":53392},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3585":801,"_31232":785,"_21602":53394,"_5":14833,"_28348":53355,"_3053":53395},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3585":802,"_31232":802,"_5":15204,"_3053":53397,"_31590":53398,"_21602":53400,"_28348":802},"Devices and identities",[50910,52385,53399,53397],"IoT Fleets",[],{"_3585":803,"_31232":802,"_21602":53402,"_5":14833,"_28348":802,"_3053":53403},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3585":804,"_31232":802,"_5":31587,"_21602":53405,"_28348":53406,"_3053":53407},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#device-states","Device states",{"_3585":805,"_31232":802,"_5":31587,"_21602":53409,"_28348":53410,"_3053":53411},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3585":806,"_31232":802,"_5":31587,"_21602":53413,"_28348":53414,"_3053":53415},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3585":807,"_31232":802,"_5":31587,"_21602":53417,"_28348":53418,"_3053":53419},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3585":808,"_31232":802,"_5":31587,"_21602":53421,"_28348":53422,"_3053":53423},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3585":809,"_31232":802,"_5":31587,"_21602":53425,"_28348":53426,"_3053":53427},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3585":810,"_31232":802,"_5":31587,"_21602":53429,"_28348":53430,"_3053":53431},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3585":811,"_31232":802,"_5":31587,"_21602":53433,"_28348":53434,"_3053":53435},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3585":812,"_31232":802,"_5":31587,"_21602":53437,"_28348":53438,"_3053":53439},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3585":813,"_31232":802,"_5":31587,"_21602":53441,"_28348":53442,"_3053":53443},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3585":814,"_31232":802,"_5":31587,"_21602":53445,"_28348":53446,"_3053":53447},[],"/docs/pr-preview/pr-61/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3585":815,"_31232":802,"_21602":53449,"_5":14833,"_28348":802,"_3053":53450},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3585":816,"_31232":802,"_21602":53452,"_5":14833,"_28348":802,"_3053":53453},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3585":817,"_31232":802,"_21602":53455,"_5":14833,"_28348":53406,"_3053":53456},[],"Operational view",{"_3585":818,"_31232":802,"_21602":53458,"_5":14833,"_28348":53406,"_3053":53459},[],"Meaning",{"_3585":819,"_31232":802,"_21602":53461,"_5":14833,"_28348":53406,"_3053":53462},[],"**No Identity**",{"_3585":820,"_31232":802,"_21602":53464,"_5":14833,"_28348":53406,"_3053":53465},[],"A record exists without an associated identity.",{"_3585":821,"_31232":802,"_21602":53467,"_5":14833,"_28348":53406,"_3053":53468},[],"**Active**",{"_3585":822,"_31232":802,"_21602":53470,"_5":14833,"_28348":53406,"_3053":53471},[],"The slot is active; also check certificate dates, status and usages.",{"_3585":823,"_31232":802,"_21602":53473,"_5":14833,"_28348":53406,"_3053":53474},[],"**Renewal Pending**",{"_3585":824,"_31232":802,"_21602":53476,"_5":14833,"_28348":53406,"_3053":53477},[],"The identity is in the operational renewal window.",{"_3585":825,"_31232":802,"_21602":53479,"_5":14833,"_28348":53406,"_3053":53480},[],"**Expiring Soon**",{"_3585":826,"_31232":802,"_21602":53482,"_5":14833,"_28348":53406,"_3053":53483},[],"Expiration is approaching according to configured thresholds.",{"_3585":827,"_31232":802,"_21602":53485,"_5":14833,"_28348":53406,"_3053":53486},[],"**Expired**",{"_3585":828,"_31232":802,"_21602":53488,"_5":14833,"_28348":53406,"_3053":53489},[],"The identity has expired.",{"_3585":829,"_31232":802,"_21602":53491,"_5":14833,"_28348":53406,"_3053":53492},[],"**Revoked**",{"_3585":830,"_31232":802,"_21602":53494,"_5":14833,"_28348":53406,"_3053":53495},[],"The identity is marked revoked.",{"_3585":831,"_31232":802,"_21602":53497,"_5":14833,"_28348":53406,"_3053":53498},[],"**Decommissioned**",{"_3585":832,"_31232":802,"_21602":53500,"_5":14833,"_28348":53406,"_3053":53501},[],"The record is retired and ordinary updates do not restore operation.",{"_3585":833,"_31232":802,"_21602":53503,"_5":14833,"_28348":53406,"_3053":53504},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3585":834,"_31232":802,"_21602":53506,"_5":14833,"_28348":53410,"_3053":53507},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3585":835,"_31232":802,"_21602":53509,"_5":14833,"_28348":53410,"_3053":53510},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3585":836,"_31232":802,"_21602":53512,"_5":14833,"_28348":53410,"_3053":53513},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3585":837,"_31232":802,"_21602":53515,"_5":14833,"_28348":53410,"_3053":53516},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3585":838,"_31232":802,"_21602":53518,"_5":14833,"_28348":53414,"_3053":53519},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3585":839,"_31232":802,"_21602":53521,"_5":14833,"_28348":53418,"_3053":53522},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3585":840,"_31232":802,"_21602":53524,"_5":14833,"_28348":53422,"_3053":53525},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3585":841,"_31232":802,"_21602":53527,"_5":14833,"_28348":53426,"_3053":53528},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3585":842,"_31232":802,"_21602":53530,"_5":14833,"_28348":53430,"_3053":53531},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3585":843,"_31232":802,"_21602":53533,"_5":14833,"_28348":53430,"_3053":53534},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3585":844,"_31232":802,"_21602":53536,"_5":14833,"_28348":53434,"_3053":53537},[],"From **No Identity**, use **Assign Identity**:",{"_3585":845,"_31232":802,"_21602":53539,"_5":14833,"_28348":53434,"_3053":53540},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3585":846,"_31232":802,"_21602":53542,"_5":14833,"_28348":53434,"_3053":53543},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3585":847,"_31232":802,"_21602":53545,"_5":14833,"_28348":53434,"_3053":53546},[],"Confirm and read the serial, active version and history again.",{"_3585":848,"_31232":802,"_21602":53548,"_5":14833,"_28348":53434,"_3053":53549},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3585":849,"_31232":802,"_21602":53551,"_5":14833,"_28348":53434,"_3053":53552},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3585":850,"_31232":802,"_21602":53554,"_5":14833,"_28348":53438,"_3053":53555},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3585":851,"_31232":802,"_21602":53557,"_5":14833,"_28348":53438,"_3053":53558},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3585":852,"_31232":802,"_21602":53560,"_5":14833,"_28348":53442,"_3053":53561},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3585":853,"_31232":802,"_21602":53563,"_5":14833,"_28348":53442,"_3053":53564},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3585":854,"_31232":802,"_21602":53566,"_5":14833,"_28348":53442,"_3053":53567},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3585":855,"_31232":802,"_21602":53569,"_5":14833,"_28348":53442,"_3053":53570},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3585":856,"_31232":802,"_21602":53572,"_5":14833,"_28348":53446,"_3053":53573},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3585":857,"_31232":802,"_21602":53575,"_5":14833,"_28348":53446,"_3053":53576},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3585":858,"_31232":858,"_5":15204,"_3053":53578,"_31590":53579,"_21602":53581,"_28348":858},"Bootstrap identity and authentication",[50910,52385,53399,53397,53580],"Enrollment with PKI",[],{"_3585":859,"_31232":858,"_21602":53583,"_5":14833,"_28348":858,"_3053":53584},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3585":860,"_31232":858,"_5":31587,"_21602":53586,"_28348":53587,"_3053":53588},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3585":861,"_31232":858,"_5":31587,"_21602":53590,"_28348":53591,"_3053":53592},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3585":862,"_31232":858,"_5":31587,"_21602":53594,"_28348":53595,"_3053":53596},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3585":863,"_31232":858,"_5":31587,"_21602":53598,"_28348":53599,"_3053":53600},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3585":864,"_31232":858,"_5":31587,"_21602":53602,"_28348":53603,"_3053":53604},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3585":865,"_31232":858,"_21602":53606,"_5":14833,"_28348":858,"_3053":53607},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3585":866,"_31232":858,"_21602":53609,"_5":14833,"_28348":53587,"_3053":53610},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3585":867,"_31232":858,"_21602":53612,"_5":14833,"_28348":53587,"_3053":53613},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3585":868,"_31232":858,"_21602":53615,"_5":14833,"_28348":53591,"_3053":53616},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3585":869,"_31232":858,"_21602":53618,"_5":14833,"_28348":53591,"_3053":53619},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3585":870,"_31232":858,"_21602":53621,"_5":14833,"_28348":53591,"_3053":53622},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3585":871,"_31232":858,"_21602":53624,"_5":14833,"_28348":53595,"_3053":53625},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3585":872,"_31232":858,"_21602":53627,"_5":14833,"_28348":53595,"_3053":53628},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3585":873,"_31232":858,"_21602":53630,"_5":14833,"_28348":53599,"_3053":53631},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3585":874,"_31232":858,"_21602":53633,"_5":14833,"_28348":53599,"_3053":53634},[],"Example body:",{"_3585":875,"_31232":858,"_21602":53636,"_5":14833,"_28348":53599,"_3053":53637},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3585":876,"_31232":858,"_21602":53639,"_5":14833,"_28348":53599,"_3053":53640},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3585":877,"_31232":858,"_21602":53642,"_5":14833,"_28348":53599,"_3053":53643},[],"Continuation requires a successful HTTP response and JSON:",{"_3585":878,"_31232":858,"_21602":53645,"_5":14833,"_28348":53599,"_3053":53646},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3585":879,"_31232":858,"_21602":53648,"_5":14833,"_28348":53603,"_3053":53649},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3585":880,"_31232":858,"_21602":53651,"_5":14833,"_28348":53603,"_3053":53652},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3585":881,"_31232":881,"_5":15204,"_3053":53654,"_31590":53655,"_21602":53656,"_28348":881},"Configure and operate the DMS",[50910,52385,53399,53397,53580],[],{"_3585":882,"_31232":881,"_21602":53658,"_5":14833,"_28348":881,"_3053":53659},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3585":883,"_31232":881,"_5":31587,"_21602":53661,"_28348":53662,"_3053":50920},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3585":884,"_31232":881,"_5":31587,"_21602":53664,"_28348":53665,"_3053":53666},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3585":885,"_31232":881,"_5":31587,"_21602":53668,"_28348":53669,"_3053":53670},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3585":886,"_31232":881,"_5":31587,"_21602":53672,"_28348":53673,"_3053":53674},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3585":887,"_31232":881,"_5":31587,"_21602":53676,"_28348":53677,"_3053":53678},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3585":888,"_31232":881,"_5":31587,"_21602":53680,"_28348":53681,"_3053":53682},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3585":889,"_31232":881,"_5":31587,"_21602":53684,"_28348":53685,"_3053":53686},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3585":890,"_31232":881,"_5":31587,"_21602":53688,"_28348":53689,"_3053":53690},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3585":891,"_31232":881,"_5":31587,"_21602":53692,"_28348":53693,"_3053":53694},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3585":892,"_31232":881,"_5":31587,"_21602":53696,"_28348":53697,"_3053":53698},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3585":893,"_31232":881,"_5":31587,"_21602":53700,"_28348":53701,"_3053":53702},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3585":894,"_31232":881,"_5":31587,"_21602":53704,"_28348":53705,"_3053":53706},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3585":895,"_31232":881,"_5":31587,"_21602":53708,"_28348":53709,"_3053":53710},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3585":896,"_31232":881,"_5":31587,"_21602":53712,"_28348":53713,"_3053":53714},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3585":897,"_31232":881,"_5":31587,"_21602":53716,"_28348":53717,"_3053":53718},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3585":898,"_31232":881,"_5":31587,"_21602":53720,"_28348":53721,"_3053":53722},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3585":899,"_31232":881,"_5":31587,"_21602":53724,"_28348":53725,"_3053":53726},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3585":900,"_31232":881,"_5":31587,"_21602":53728,"_28348":53729,"_3053":53730},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3585":901,"_31232":881,"_21602":53732,"_5":14833,"_28348":881,"_3053":53733},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3585":902,"_31232":881,"_21602":53735,"_5":14833,"_28348":53662,"_3053":53736},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3585":903,"_31232":881,"_21602":53738,"_5":14833,"_28348":53662,"_3053":53739},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3585":904,"_31232":881,"_21602":53741,"_5":14833,"_28348":53665,"_3053":53742},[],"Follow the interactive walkthrough to configure a DMS for EST. The example sets **Name** to `DMS Showcase`, which derives the `dms-showcase` identifier used in the EST URLs, and selects two CAs prepared in advance: **DMS Enrollment CA** signs the device identities and **DMS Bootstrap CA** validates the initial credential. The values are for this example; use names and CAs appropriate for your fleet.",{"_3585":905,"_31232":881,"_21602":53744,"_5":14833,"_28348":53669,"_3053":53745},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3585":906,"_31232":881,"_21602":53747,"_5":14833,"_28348":53673,"_3053":53748},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3585":907,"_31232":881,"_21602":53750,"_5":14833,"_28348":53677,"_3053":53751},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3585":908,"_31232":881,"_21602":53753,"_5":14833,"_28348":53681,"_3053":53754},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3585":909,"_31232":881,"_21602":53756,"_5":14833,"_28348":53685,"_3053":53757},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3585":910,"_31232":881,"_21602":53759,"_5":14833,"_28348":53693,"_3053":53760},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3585":911,"_31232":881,"_21602":53762,"_5":14833,"_28348":53693,"_3053":53763},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3585":912,"_31232":881,"_21602":53765,"_5":14833,"_28348":53697,"_3053":53766},[],"`settings.enrollment_settings` field",{"_3585":913,"_31232":881,"_21602":53768,"_5":14833,"_28348":53697,"_3053":53769},[],"Decision",{"_3585":914,"_31232":881,"_21602":53771,"_5":14833,"_28348":53697,"_3053":53772},[],"`protocol`",{"_3585":915,"_31232":881,"_21602":53774,"_5":14833,"_28348":53697,"_3053":53775},[],"`EST_RFC7030` for these operations.",{"_3585":916,"_31232":881,"_21602":53777,"_5":14833,"_28348":53697,"_3053":53778},[],"`enrollment_ca`",{"_3585":917,"_31232":881,"_21602":53780,"_5":14833,"_28348":53697,"_3053":53781},[],"ID of the signing CA.",{"_3585":918,"_31232":881,"_21602":53783,"_5":14833,"_28348":53697,"_3053":53784},[],"`verify_csr_signature`",{"_3585":919,"_31232":881,"_21602":53786,"_5":14833,"_28348":53697,"_3053":53787},[],"Keep `true` to verify CSR key possession.",{"_3585":920,"_31232":881,"_21602":53789,"_5":14833,"_28348":53697,"_3053":53790},[],"`enable_replaceable_enrollment`",{"_3585":921,"_31232":881,"_21602":53792,"_5":14833,"_28348":53697,"_3053":53793},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3585":922,"_31232":881,"_21602":53795,"_5":14833,"_28348":53697,"_3053":53796},[],"`est_rfc7030_settings.auth_mode`",{"_3585":923,"_31232":881,"_21602":53798,"_5":14833,"_28348":53697,"_3053":53799},[],"One of the four authentication modes.",{"_3585":924,"_31232":881,"_21602":53801,"_5":14833,"_28348":53697,"_3053":53802},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3585":925,"_31232":881,"_21602":53804,"_5":14833,"_28348":53701,"_3053":53805},[],"The blocks are independent:",{"_3585":926,"_31232":881,"_21602":53807,"_5":14833,"_28348":53701,"_3053":53808},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3585":927,"_31232":881,"_21602":53810,"_5":14833,"_28348":53701,"_3053":53811},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3585":928,"_31232":881,"_21602":53813,"_5":14833,"_28348":53701,"_3053":53814},[],"`auth_mode`",{"_3585":929,"_31232":881,"_21602":53816,"_5":14833,"_28348":53701,"_3053":53817},[],"Control applied in the configured operation",{"_3585":930,"_31232":881,"_21602":53819,"_5":14833,"_28348":53701,"_3053":53820},[],"`CLIENT_CERTIFICATE`",{"_3585":931,"_31232":881,"_21602":53822,"_5":14833,"_28348":53701,"_3053":53823},[],"Presented certificate validation.",{"_3585":932,"_31232":881,"_21602":53825,"_5":14833,"_28348":53701,"_3053":53826},[],"`EXTERNAL_WEBHOOK`",{"_3585":933,"_31232":881,"_21602":53828,"_5":14833,"_28348":53701,"_3053":53829},[],"Configured webhook authorization.",{"_3585":934,"_31232":881,"_21602":53831,"_5":14833,"_28348":53701,"_3053":53832},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3585":935,"_31232":881,"_21602":53834,"_5":14833,"_28348":53701,"_3053":53835},[],"Certificate validation followed by webhook approval.",{"_3585":936,"_31232":881,"_21602":53837,"_5":14833,"_28348":53701,"_3053":53838},[],"`NO_AUTH`",{"_3585":937,"_31232":881,"_21602":53840,"_5":14833,"_28348":53701,"_3053":53841},[],"No DMS requester authentication.",{"_3585":938,"_31232":881,"_21602":53843,"_5":14833,"_28348":53701,"_3053":53844},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3585":939,"_31232":881,"_21602":53846,"_5":14833,"_28348":53701,"_3053":53847},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3585":940,"_31232":881,"_21602":53849,"_5":14833,"_28348":53701,"_3053":53850},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3585":941,"_31232":881,"_21602":53852,"_5":14833,"_28348":53701,"_3053":53853},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3585":942,"_31232":881,"_21602":53855,"_5":14833,"_28348":53705,"_3053":53856},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3585":943,"_31232":881,"_21602":53858,"_5":14833,"_28348":53705,"_3053":53859},[],"`external_webhook_settings` field",{"_3585":944,"_31232":881,"_21602":53861,"_5":14833,"_28348":53705,"_3053":53769},[],{"_3585":945,"_31232":881,"_21602":53863,"_5":14833,"_28348":53705,"_3053":53864},[],"`url`",{"_3585":946,"_31232":881,"_21602":53866,"_5":14833,"_28348":53705,"_3053":53867},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3585":947,"_31232":881,"_21602":53869,"_5":14833,"_28348":53705,"_3053":53870},[],"`method`",{"_3585":948,"_31232":881,"_21602":53872,"_5":14833,"_28348":53705,"_3053":53873},[],"`POST` or `PUT`; `POST` by default.",{"_3585":949,"_31232":881,"_21602":53875,"_5":14833,"_28348":53705,"_3053":53876},[],"`name`",{"_3585":950,"_31232":881,"_21602":53878,"_5":14833,"_28348":53705,"_3053":53879},[],"Label used in service logs.",{"_3585":951,"_31232":881,"_21602":53881,"_5":14833,"_28348":53705,"_3053":53882},[],"`config.auth_mode`",{"_3585":952,"_31232":881,"_21602":53884,"_5":14833,"_28348":53705,"_3053":53885},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3585":953,"_31232":881,"_21602":53887,"_5":14833,"_28348":53705,"_3053":53888},[],"`config.log_level`",{"_3585":954,"_31232":881,"_21602":53890,"_5":14833,"_28348":53705,"_3053":53891},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3585":955,"_31232":881,"_21602":53893,"_5":14833,"_28348":53705,"_3053":53894},[],"`config.apikey_options`",{"_3585":956,"_31232":881,"_21602":53896,"_5":14833,"_28348":53705,"_3053":53897},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3585":957,"_31232":881,"_21602":53899,"_5":14833,"_28348":53705,"_3053":53900},[],"`config.jwt_options`",{"_3585":958,"_31232":881,"_21602":53902,"_5":14833,"_28348":53705,"_3053":53903},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3585":959,"_31232":881,"_21602":53905,"_5":14833,"_28348":53705,"_3053":53906},[],"`config.mtls_options`",{"_3585":960,"_31232":881,"_21602":53908,"_5":14833,"_28348":53705,"_3053":53909},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3585":961,"_31232":881,"_21602":53911,"_5":14833,"_28348":53705,"_3053":53912},[],"`config.insecure_skip_verify`",{"_3585":962,"_31232":881,"_21602":53914,"_5":14833,"_28348":53705,"_3053":53915},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3585":963,"_31232":881,"_21602":53917,"_5":14833,"_28348":53705,"_3053":53918},[],"`config.call_timeout`",{"_3585":964,"_31232":881,"_21602":53920,"_5":14833,"_28348":53705,"_3053":53921},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3585":965,"_31232":881,"_21602":53923,"_5":14833,"_28348":53705,"_3053":53924},[],"Rules for that configuration:",{"_3585":966,"_31232":881,"_21602":53926,"_5":14833,"_28348":53705,"_3053":53927},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3585":967,"_31232":881,"_21602":53929,"_5":14833,"_28348":53705,"_3053":53930},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3585":968,"_31232":881,"_21602":53932,"_5":14833,"_28348":53705,"_3053":53933},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3585":969,"_31232":881,"_21602":53935,"_5":14833,"_28348":53705,"_3053":53936},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3585":970,"_31232":881,"_21602":53938,"_5":14833,"_28348":53705,"_3053":53939},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3585":971,"_31232":881,"_21602":53941,"_5":14833,"_28348":53705,"_3053":53942},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3585":972,"_31232":881,"_21602":53944,"_5":14833,"_28348":53705,"_3053":53945},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3585":973,"_31232":881,"_21602":53947,"_5":14833,"_28348":53705,"_3053":53948},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3585":974,"_31232":881,"_21602":53950,"_5":14833,"_28348":53705,"_3053":53951},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3585":975,"_31232":881,"_21602":53953,"_5":14833,"_28348":53709,"_3053":53954},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3585":976,"_31232":881,"_21602":53956,"_5":14833,"_28348":53713,"_3053":53957},[],"`settings.reenrollment_settings` field",{"_3585":977,"_31232":881,"_21602":53959,"_5":14833,"_28348":53713,"_3053":51300},[],{"_3585":978,"_31232":881,"_21602":53961,"_5":14833,"_28348":53713,"_3053":53962},[],"`reenrollment_delta`",{"_3585":979,"_31232":881,"_21602":53964,"_5":14833,"_28348":53713,"_3053":53965},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3585":980,"_31232":881,"_21602":53967,"_5":14833,"_28348":53713,"_3053":53968},[],"`preventive_delta`",{"_3585":981,"_31232":881,"_21602":53970,"_5":14833,"_28348":53713,"_3053":53971},[],"Preventive operational monitoring threshold.",{"_3585":982,"_31232":881,"_21602":53973,"_5":14833,"_28348":53713,"_3053":53974},[],"`critical_delta`",{"_3585":983,"_31232":881,"_21602":53976,"_5":14833,"_28348":53713,"_3053":53977},[],"Critical operational monitoring threshold.",{"_3585":984,"_31232":881,"_21602":53979,"_5":14833,"_28348":53713,"_3053":53980},[],"`enable_expired_renewal`",{"_3585":985,"_31232":881,"_21602":53982,"_5":14833,"_28348":53713,"_3053":53983},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3585":986,"_31232":881,"_21602":53985,"_5":14833,"_28348":53713,"_3053":53986},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3585":987,"_31232":881,"_21602":53988,"_5":14833,"_28348":53713,"_3053":53989},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3585":988,"_31232":881,"_21602":53991,"_5":14833,"_28348":53713,"_3053":53992},[],"`revoke_on_reenrollment`",{"_3585":989,"_31232":881,"_21602":53994,"_5":14833,"_28348":53713,"_3053":53995},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3585":990,"_31232":881,"_21602":53997,"_5":14833,"_28348":53713,"_3053":53998},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3585":991,"_31232":881,"_21602":54000,"_5":14833,"_28348":53717,"_3053":54001},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3585":992,"_31232":881,"_21602":54003,"_5":14833,"_28348":53721,"_3053":51294},[],{"_3585":993,"_31232":881,"_21602":54005,"_5":14833,"_28348":53721,"_3053":54006},[],"Published material",{"_3585":994,"_31232":881,"_21602":54008,"_5":14833,"_28348":53721,"_3053":54009},[],"**Include Lamassu System CA**",{"_3585":995,"_31232":881,"_21602":54011,"_5":14833,"_28348":53721,"_3053":54012},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3585":996,"_31232":881,"_21602":54014,"_5":14833,"_28348":53721,"_3053":54015},[],"**Include Enrollment CA**",{"_3585":997,"_31232":881,"_21602":54017,"_5":14833,"_28348":53721,"_3053":54018},[],"Selected issuing CA certificate.",{"_3585":998,"_31232":881,"_21602":54020,"_5":14833,"_28348":53721,"_3053":54021},[],"**Managed CAs**",{"_3585":999,"_31232":881,"_21602":54023,"_5":14833,"_28348":53721,"_3053":54024},[],"Explicitly selected CA certificates.",{"_3585":1000,"_31232":881,"_21602":54026,"_5":14833,"_28348":53721,"_3053":54027},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3585":1001,"_31232":881,"_21602":54029,"_5":14833,"_28348":53725,"_3053":54030},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3585":1002,"_31232":881,"_21602":54032,"_5":14833,"_28348":53725,"_3053":54033},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3585":1003,"_31232":881,"_21602":54035,"_5":14833,"_28348":53725,"_3053":54036},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3585":1004,"_31232":881,"_21602":54038,"_5":14833,"_28348":53729,"_3053":54039},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3585":1005,"_31232":1005,"_5":15204,"_3053":54041,"_31590":54042,"_21602":54043,"_28348":1005},"Integrate the EST client",[50910,52385,53399,53397,53580],[],{"_3585":1006,"_31232":1005,"_21602":54045,"_5":14833,"_28348":1005,"_3053":54046},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3585":1007,"_31232":1005,"_5":31587,"_21602":54048,"_28348":54049,"_3053":50920},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3585":1008,"_31232":1005,"_5":31587,"_21602":54051,"_28348":54052,"_3053":54053},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3585":1009,"_31232":1005,"_5":31587,"_21602":54055,"_28348":54056,"_3053":54057},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3585":1010,"_31232":1005,"_5":31587,"_21602":54059,"_28348":54060,"_3053":54061},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3585":1011,"_31232":1005,"_5":31587,"_21602":54063,"_28348":54064,"_3053":54065},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3585":1012,"_31232":1005,"_5":31587,"_21602":54067,"_28348":54068,"_3053":54069},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3585":1013,"_31232":1005,"_21602":54071,"_5":14833,"_28348":1005,"_3053":54072},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3585":1014,"_31232":1005,"_21602":54074,"_5":14833,"_28348":54049,"_3053":54075},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3585":1015,"_31232":1005,"_21602":54077,"_5":14833,"_28348":54049,"_3053":54078},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3585":1016,"_31232":1005,"_21602":54080,"_5":14833,"_28348":54049,"_3053":54081},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3585":1017,"_31232":1005,"_21602":54083,"_5":14833,"_28348":54052,"_3053":54084},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3585":1018,"_31232":1005,"_21602":54086,"_5":14833,"_28348":54052,"_3053":54087},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3585":1019,"_31232":1005,"_21602":54089,"_5":14833,"_28348":54056,"_3053":54090},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3585":1020,"_31232":1005,"_21602":54092,"_5":14833,"_28348":54056,"_3053":54093},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3585":1021,"_31232":1005,"_21602":54095,"_5":14833,"_28348":54060,"_3053":54096},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3585":1022,"_31232":1005,"_21602":54098,"_5":14833,"_28348":54060,"_3053":54099},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3585":1023,"_31232":1005,"_21602":54101,"_5":14833,"_28348":54064,"_3053":54102},[],"For a root that issues directly:",{"_3585":1024,"_31232":1005,"_21602":54104,"_5":14833,"_28348":54064,"_3053":54105},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3585":1025,"_31232":1005,"_21602":54107,"_5":14833,"_28348":54064,"_3053":54108},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3585":1026,"_31232":1005,"_21602":54110,"_5":14833,"_28348":54068,"_3053":54111},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3585":1027,"_31232":1027,"_5":15204,"_3053":54113,"_31590":54114,"_21602":54115,"_28348":1027},"EST reference",[50910,52385,53399,53397,53580],[],{"_3585":1028,"_31232":1027,"_21602":54117,"_5":14833,"_28348":1027,"_3053":54118},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3585":1029,"_31232":1027,"_5":31587,"_21602":54120,"_28348":54121,"_3053":54122},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3585":1030,"_31232":1027,"_5":31587,"_21602":54124,"_28348":54125,"_3053":23398},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3585":1031,"_31232":1027,"_5":31587,"_21602":54127,"_28348":54128,"_3053":26913},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3585":1032,"_31232":1027,"_5":31587,"_21602":54130,"_28348":54131,"_3053":26920},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3585":1033,"_31232":1027,"_5":31587,"_21602":54133,"_28348":54134,"_3053":26214},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3585":1034,"_31232":1027,"_5":31587,"_21602":54136,"_28348":54137,"_3053":54138},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3585":1035,"_31232":1027,"_5":31587,"_21602":54140,"_28348":54141,"_3053":54142},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3585":1036,"_31232":1027,"_5":31587,"_21602":54144,"_28348":54145,"_3053":54146},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3585":1037,"_31232":1027,"_21602":54148,"_5":14833,"_28348":1027,"_3053":54149},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3585":1038,"_31232":1027,"_21602":54151,"_5":14833,"_28348":54121,"_3053":54152},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3585":1039,"_31232":1027,"_21602":54154,"_5":14833,"_28348":54121,"_3053":54155},[],"Operation",{"_3585":1040,"_31232":1027,"_21602":54157,"_5":14833,"_28348":54121,"_3053":54158},[],"Method",{"_3585":1041,"_31232":1027,"_21602":54160,"_5":14833,"_28348":54121,"_3053":54161},[],"Authentication and condition",{"_3585":1042,"_31232":1027,"_21602":54163,"_5":14833,"_28348":54121,"_3053":54164},[],"`/cacerts`",{"_3585":1043,"_31232":1027,"_21602":54166,"_5":14833,"_28348":54121,"_3053":54167},[],"GET",{"_3585":1044,"_31232":1027,"_21602":54169,"_5":14833,"_28348":54121,"_3053":54170},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3585":1045,"_31232":1027,"_21602":54172,"_5":14833,"_28348":54121,"_3053":54173},[],"`/simpleenroll`",{"_3585":1046,"_31232":1027,"_21602":54175,"_5":14833,"_28348":54121,"_3053":54176},[],"POST",{"_3585":1047,"_31232":1027,"_21602":54178,"_5":14833,"_28348":54121,"_3053":54179},[],"Initial authentication and DMS registration/replacement policy.",{"_3585":1048,"_31232":1027,"_21602":54181,"_5":14833,"_28348":54121,"_3053":54182},[],"`/simplereenroll`",{"_3585":1049,"_31232":1027,"_21602":54184,"_5":14833,"_28348":54121,"_3053":54176},[],{"_3585":1050,"_31232":1027,"_21602":54186,"_5":14833,"_28348":54121,"_3053":54187},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3585":1051,"_31232":1027,"_21602":54189,"_5":14833,"_28348":54121,"_3053":54190},[],"`/serverkeygen`",{"_3585":1052,"_31232":1027,"_21602":54192,"_5":14833,"_28348":54121,"_3053":54176},[],{"_3585":1053,"_31232":1027,"_21602":54194,"_5":14833,"_28348":54121,"_3053":54195},[],"Initial authentication and admission; server generation enabled.",{"_3585":1054,"_31232":1027,"_21602":54197,"_5":14833,"_28348":54121,"_3053":54198},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3585":1055,"_31232":1027,"_21602":54200,"_5":14833,"_28348":54125,"_3053":54201},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3585":1056,"_31232":1027,"_21602":54203,"_5":14833,"_28348":54125,"_3053":54204},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3585":1057,"_31232":1027,"_21602":54206,"_5":14833,"_28348":54128,"_3053":54207},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3585":1058,"_31232":1027,"_21602":54209,"_5":14833,"_28348":54128,"_3053":54210},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3585":1059,"_31232":1027,"_21602":54212,"_5":14833,"_28348":54131,"_3053":54213},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3585":1060,"_31232":1027,"_21602":54215,"_5":14833,"_28348":54131,"_3053":54216},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3585":1061,"_31232":1027,"_21602":54218,"_5":14833,"_28348":54134,"_3053":54219},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3585":1062,"_31232":1027,"_21602":54221,"_5":14833,"_28348":54134,"_3053":54222},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3585":1063,"_31232":1027,"_21602":54224,"_5":14833,"_28348":54137,"_3053":54225},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3585":1064,"_31232":1027,"_21602":54227,"_5":14833,"_28348":54137,"_3053":54228},[],"Part",{"_3585":1065,"_31232":1027,"_21602":54230,"_5":14833,"_28348":54137,"_3053":54231},[],"Content after decoding its Base64",{"_3585":1066,"_31232":1027,"_21602":54233,"_5":14833,"_28348":54137,"_3053":54234},[],"`application/pkcs8`",{"_3585":1067,"_31232":1027,"_21602":54236,"_5":14833,"_28348":54137,"_3053":54237},[],"Unencrypted DER PKCS#8 private key.",{"_3585":1068,"_31232":1027,"_21602":54239,"_5":14833,"_28348":54137,"_3053":54240},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3585":1069,"_31232":1027,"_21602":54242,"_5":14833,"_28348":54137,"_3053":54243},[],"DER PKCS#7 containing the issued certificate.",{"_3585":1070,"_31232":1027,"_21602":54245,"_5":14833,"_28348":54137,"_3053":54246},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3585":1071,"_31232":1027,"_21602":54248,"_5":14833,"_28348":54141,"_3053":54249},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3585":1072,"_31232":1027,"_21602":54251,"_5":14833,"_28348":54141,"_3053":54252},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3585":1073,"_31232":1027,"_21602":54254,"_5":14833,"_28348":54141,"_3053":54255},[],"Convert and check the result:",{"_3585":1074,"_31232":1027,"_21602":54257,"_5":14833,"_28348":54141,"_3053":54258},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3585":1075,"_31232":1027,"_21602":54260,"_5":14833,"_28348":54145,"_3053":54261},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3585":1076,"_31232":1027,"_21602":54263,"_5":14833,"_28348":54145,"_3053":54264},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3585":1077,"_31232":1077,"_5":15204,"_3053":53580,"_31590":54266,"_21602":54267,"_28348":1077},[50910,52385,53399,53397,53580],[],{"_3585":1078,"_31232":1077,"_21602":54269,"_5":14833,"_28348":1077,"_3053":54270},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3585":1079,"_31232":1077,"_5":31587,"_21602":54272,"_28348":54273,"_3053":54274},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3585":1080,"_31232":1077,"_5":31587,"_21602":54276,"_28348":54277,"_3053":54278},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3585":1081,"_31232":1077,"_5":31587,"_21602":54280,"_28348":54281,"_3053":54282},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3585":1082,"_31232":1077,"_5":31587,"_21602":54284,"_28348":54285,"_3053":54286},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3585":1083,"_31232":1077,"_21602":54288,"_5":14833,"_28348":1077,"_3053":54289},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3585":1084,"_31232":1077,"_21602":54291,"_5":14833,"_28348":54273,"_3053":54292},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3585":1085,"_31232":1077,"_21602":54294,"_5":14833,"_28348":54273,"_3053":54295},[],"The integrator installs initial EST server trust and an admission credential.",{"_3585":1086,"_31232":1077,"_21602":54297,"_5":14833,"_28348":54273,"_3053":54298},[],"The client requests an identity for its `Device ID` through EST.",{"_3585":1087,"_31232":1077,"_21602":54300,"_5":14833,"_28348":54273,"_3053":54301},[],"Certificate, device binding and key/certificate installation are checked.",{"_3585":1088,"_31232":1077,"_21602":54303,"_5":14833,"_28348":54273,"_3053":54304},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3585":1089,"_31232":1077,"_21602":54306,"_5":14833,"_28348":54273,"_3053":54307},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3585":1090,"_31232":1077,"_21602":54309,"_5":14833,"_28348":54277,"_3053":54310},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3585":1091,"_31232":1077,"_21602":54312,"_5":14833,"_28348":54277,"_3053":54313},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3585":1092,"_31232":1077,"_21602":54315,"_5":14833,"_28348":54277,"_3053":54316},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3585":1093,"_31232":1077,"_21602":54318,"_5":14833,"_28348":54277,"_3053":54319},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3585":1094,"_31232":1077,"_21602":54321,"_5":14833,"_28348":54281,"_3053":54322},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3585":1095,"_31232":1077,"_21602":54324,"_5":14833,"_28348":54281,"_3053":54325},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3585":1096,"_31232":1077,"_21602":54327,"_5":14833,"_28348":54281,"_3053":54328},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3585":1097,"_31232":1077,"_21602":54330,"_5":14833,"_28348":54281,"_3053":54331},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3585":1098,"_31232":1077,"_21602":54333,"_5":14833,"_28348":54285,"_3053":54334},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3585":1099,"_31232":1077,"_21602":54336,"_5":14833,"_28348":54285,"_3053":54337},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3585":1100,"_31232":1100,"_5":15204,"_3053":54339,"_31590":54340,"_21602":54341,"_28348":1100},"Provisioning strategies",[50910,52385,53399,53397,53580],[],{"_3585":1101,"_31232":1100,"_21602":54343,"_5":14833,"_28348":1100,"_3053":54344},[],"Choose device registration, identity authorization and key generation.",{"_3585":1102,"_31232":1100,"_5":31587,"_21602":54346,"_28348":54347,"_3053":54348},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3585":1103,"_31232":1100,"_5":31587,"_21602":54350,"_28348":54351,"_3053":54352},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3585":1104,"_31232":1100,"_5":31587,"_21602":54354,"_28348":54355,"_3053":54356},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3585":1105,"_31232":1100,"_5":31587,"_21602":54358,"_28348":54359,"_3053":54360},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3585":1106,"_31232":1100,"_5":31587,"_21602":54362,"_28348":54363,"_3053":54364},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3585":1107,"_31232":1100,"_21602":54366,"_5":14833,"_28348":1100,"_3053":54367},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3585":1108,"_31232":1100,"_21602":54369,"_5":14833,"_28348":54347,"_3053":54370},[],"Path",{"_3585":1109,"_31232":1100,"_21602":54372,"_5":14833,"_28348":54347,"_3053":54373},[],"When the device exists",{"_3585":1110,"_31232":1100,"_21602":54375,"_5":14833,"_28348":54347,"_3053":54376},[],"What to check",{"_3585":1111,"_31232":1100,"_21602":54378,"_5":14833,"_28348":54347,"_3053":54379},[],"Manual assignment",{"_3585":1112,"_31232":1100,"_21602":54381,"_5":14833,"_28348":54347,"_3053":54382},[],"An operator creates it before associating a certificate.",{"_3585":1113,"_31232":1100,"_21602":54384,"_5":14833,"_28348":54347,"_3053":54385},[],"ID, owning DMS, certificate CN and bound serial.",{"_3585":1114,"_31232":1100,"_21602":54387,"_5":14833,"_28348":54347,"_3053":54388},[],"EST with `JITP`",{"_3585":1115,"_31232":1100,"_21602":54390,"_5":14833,"_28348":54347,"_3053":54391},[],"Created for an unknown CN during `/simpleenroll`.",{"_3585":1116,"_31232":1100,"_21602":54393,"_5":14833,"_28348":54347,"_3053":54394},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3585":1117,"_31232":1100,"_21602":54396,"_5":14833,"_28348":54347,"_3053":54397},[],"EST with `PRE_REGISTRATION`",{"_3585":1118,"_31232":1100,"_21602":54399,"_5":14833,"_28348":54347,"_3053":54400},[],"Must exist before `/simpleenroll`.",{"_3585":1119,"_31232":1100,"_21602":54402,"_5":14833,"_28348":54347,"_3053":54403},[],"Approved record, same DMS and replacement conditions for your version.",{"_3585":1120,"_31232":1100,"_21602":54405,"_5":14833,"_28348":54347,"_3053":54406},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3585":1121,"_31232":1100,"_21602":54408,"_5":14833,"_28348":54347,"_3053":54409},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3585":1122,"_31232":1100,"_21602":54411,"_5":14833,"_28348":54351,"_3053":54412},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3585":1123,"_31232":1100,"_21602":54414,"_5":14833,"_28348":54351,"_3053":54415},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3585":1124,"_31232":1100,"_21602":54417,"_5":14833,"_28348":54351,"_3053":54418},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3585":1125,"_31232":1100,"_21602":54420,"_5":14833,"_28348":54355,"_3053":54421},[],"Decide initial enrollment and re-enrollment separately:",{"_3585":1126,"_31232":1100,"_21602":54423,"_5":14833,"_28348":54355,"_3053":54424},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3585":1127,"_31232":1100,"_21602":54426,"_5":14833,"_28348":54355,"_3053":54427},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3585":1128,"_31232":1100,"_21602":54429,"_5":14833,"_28348":54355,"_3053":54430},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3585":1129,"_31232":1100,"_21602":54432,"_5":14833,"_28348":54355,"_3053":54433},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3585":1130,"_31232":1100,"_21602":54435,"_5":14833,"_28348":54355,"_3053":54436},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3585":1131,"_31232":1100,"_21602":54438,"_5":14833,"_28348":54359,"_3053":51294},[],{"_3585":1132,"_31232":1100,"_21602":54440,"_5":14833,"_28348":54359,"_3053":54441},[],"Material crossing EST",{"_3585":1133,"_31232":1100,"_21602":54443,"_5":14833,"_28348":54359,"_3053":54444},[],"Device-generated key",{"_3585":1134,"_31232":1100,"_21602":54446,"_5":14833,"_28348":54359,"_3053":54447},[],"Public CSR and certificate; the key stays on the client.",{"_3585":1135,"_31232":1100,"_21602":54449,"_5":14833,"_28348":54359,"_3053":54450},[],"Existing device key",{"_3585":1136,"_31232":1100,"_21602":54452,"_5":14833,"_28348":54359,"_3053":54453},[],"CSR signed with that key and a new certificate.",{"_3585":1137,"_31232":1100,"_21602":54455,"_5":14833,"_28348":54359,"_3053":53718},[],{"_3585":1138,"_31232":1100,"_21602":54457,"_5":14833,"_28348":54359,"_3053":54458},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3585":1139,"_31232":1100,"_21602":54460,"_5":14833,"_28348":54359,"_3053":54461},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3585":1140,"_31232":1100,"_21602":54463,"_5":14833,"_28348":54363,"_3053":54464},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3585":1141,"_31232":1141,"_5":15204,"_3053":54466,"_31590":54467,"_21602":54468,"_28348":1141},"Renewal and recovery",[50910,52385,53399,53397,53580],[],{"_3585":1142,"_31232":1141,"_21602":54470,"_5":14833,"_28348":1141,"_3053":54471},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3585":1143,"_31232":1141,"_5":31587,"_21602":54473,"_28348":54474,"_3053":54475},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3585":1144,"_31232":1141,"_5":31587,"_21602":54477,"_28348":54478,"_3053":54479},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3585":1145,"_31232":1141,"_5":31587,"_21602":54481,"_28348":54482,"_3053":54483},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3585":1146,"_31232":1141,"_5":31587,"_21602":54485,"_28348":54486,"_3053":54487},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3585":1147,"_31232":1141,"_5":31587,"_21602":54489,"_28348":54490,"_3053":54491},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3585":1148,"_31232":1141,"_21602":54493,"_5":14833,"_28348":1141,"_3053":54494},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3585":1149,"_31232":1141,"_21602":54496,"_5":14833,"_28348":54474,"_3053":54497},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3585":1150,"_31232":1141,"_21602":54499,"_5":14833,"_28348":54474,"_3053":54500},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3585":1151,"_31232":1141,"_21602":54502,"_5":14833,"_28348":54474,"_3053":54503},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3585":1152,"_31232":1141,"_21602":54505,"_5":14833,"_28348":54474,"_3053":54506},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3585":1153,"_31232":1141,"_21602":54508,"_5":14833,"_28348":54478,"_3053":54509},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3585":1154,"_31232":1141,"_21602":54511,"_5":14833,"_28348":54478,"_3053":54512},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3585":1155,"_31232":1141,"_21602":54514,"_5":14833,"_28348":54482,"_3053":54515},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3585":1156,"_31232":1141,"_21602":54517,"_5":14833,"_28348":54482,"_3053":54518},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3585":1157,"_31232":1141,"_21602":54520,"_5":14833,"_28348":54482,"_3053":54521},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3585":1158,"_31232":1141,"_21602":54523,"_5":14833,"_28348":54486,"_3053":54524},[],"Situation",{"_3585":1159,"_31232":1141,"_21602":54526,"_5":14833,"_28348":54486,"_3053":54527},[],"Procedure",{"_3585":1160,"_31232":1141,"_21602":54529,"_5":14833,"_28348":54486,"_3053":54530},[],"Valid certificate, outside the window",{"_3585":1161,"_31232":1141,"_21602":54532,"_5":14833,"_28348":54486,"_3053":54533},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3585":1162,"_31232":1141,"_21602":54535,"_5":14833,"_28348":54486,"_3053":54536},[],"Expired certificate, key available",{"_3585":1163,"_31232":1141,"_21602":54538,"_5":14833,"_28348":54486,"_3053":54539},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3585":1164,"_31232":1141,"_21602":54541,"_5":14833,"_28348":54486,"_3053":54542},[],"Renewal through webhook or `NO_AUTH`",{"_3585":1165,"_31232":1141,"_21602":54544,"_5":14833,"_28348":54486,"_3053":54545},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3585":1166,"_31232":1141,"_21602":54547,"_5":14833,"_28348":54486,"_3053":54548},[],"Lost or inaccessible key",{"_3585":1167,"_31232":1141,"_21602":54550,"_5":14833,"_28348":54486,"_3053":54551},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3585":1168,"_31232":1141,"_21602":54553,"_5":14833,"_28348":54486,"_3053":54554},[],"Current identity revoked",{"_3585":1169,"_31232":1141,"_21602":54556,"_5":14833,"_28348":54486,"_3053":54557},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3585":1170,"_31232":1141,"_21602":54559,"_5":14833,"_28348":54486,"_3053":54560},[],"Device without an identity",{"_3585":1171,"_31232":1141,"_21602":54562,"_5":14833,"_28348":54486,"_3053":54563},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3585":1172,"_31232":1141,"_21602":54565,"_5":14833,"_28348":54486,"_3053":54566},[],"Retired device",{"_3585":1173,"_31232":1141,"_21602":54568,"_5":14833,"_28348":54486,"_3053":54569},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3585":1174,"_31232":1141,"_21602":54571,"_5":14833,"_28348":54486,"_3053":54572},[],"Timeout, HTTP 500 or installation failure",{"_3585":1175,"_31232":1141,"_21602":54574,"_5":14833,"_28348":54486,"_3053":54575},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3585":1176,"_31232":1141,"_21602":54577,"_5":14833,"_28348":54490,"_3053":54578},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3585":1177,"_31232":1141,"_21602":54580,"_5":14833,"_28348":54490,"_3053":54581},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3585":1178,"_31232":1178,"_5":15204,"_3053":54583,"_31590":54584,"_21602":54585,"_28348":1178},"Enrollment troubleshooting",[50910,52385,53399,53397,53580],[],{"_3585":1179,"_31232":1178,"_21602":54587,"_5":14833,"_28348":1178,"_3053":54588},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3585":1180,"_31232":1178,"_5":31587,"_21602":54590,"_28348":54591,"_3053":54592},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3585":1181,"_31232":1178,"_5":31587,"_21602":54594,"_28348":54595,"_3053":54596},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3585":1182,"_31232":1178,"_5":31587,"_21602":54598,"_28348":54599,"_3053":54146},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3585":1183,"_31232":1178,"_5":31587,"_21602":54601,"_28348":54602,"_3053":54603},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3585":1184,"_31232":1178,"_21602":54605,"_5":14833,"_28348":1178,"_3053":54606},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3585":1185,"_31232":1178,"_21602":54608,"_5":14833,"_28348":54595,"_3053":54609},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3585":1186,"_31232":1178,"_21602":54611,"_5":14833,"_28348":54595,"_3053":54612},[],"Symptom or message",{"_3585":1187,"_31232":1178,"_21602":54614,"_5":14833,"_28348":54595,"_3053":54376},[],{"_3585":1188,"_31232":1178,"_21602":54616,"_5":14833,"_28348":54595,"_3053":54617},[],"curl rejects TLS, name or issuer",{"_3585":1189,"_31232":1178,"_21602":54619,"_5":14833,"_28348":54595,"_3053":54620},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3585":1190,"_31232":1178,"_21602":54622,"_5":14833,"_28348":54595,"_3053":54623},[],"404 or missing APS",{"_3585":1191,"_31232":1178,"_21602":54625,"_5":14833,"_28348":54595,"_3053":54626},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3585":1192,"_31232":1178,"_21602":54628,"_5":14833,"_28348":54595,"_3053":54629},[],"400, CSR or format error",{"_3585":1193,"_31232":1178,"_21602":54631,"_5":14833,"_28348":54595,"_3053":54632},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3585":1194,"_31232":1178,"_21602":54634,"_5":14833,"_28348":54595,"_3053":54635},[],"Missing credential or invalid certificate",{"_3585":1195,"_31232":1178,"_21602":54637,"_5":14833,"_28348":54595,"_3053":54638},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3585":1196,"_31232":1178,"_21602":54640,"_5":14833,"_28348":54595,"_3053":54641},[],"Webhook denies, times out or responds without authorization",{"_3585":1197,"_31232":1178,"_21602":54643,"_5":14833,"_28348":54595,"_3053":54644},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3585":1198,"_31232":1178,"_21602":54646,"_5":14833,"_28348":54595,"_3053":54647},[],"`unexpected status code: <n>: redirects are not followed`",{"_3585":1199,"_31232":1178,"_21602":54649,"_5":14833,"_28348":54595,"_3053":54650},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3585":1200,"_31232":1178,"_21602":54652,"_5":14833,"_28348":54595,"_3053":54653},[],"`webhook response exceeds 1048576 bytes`",{"_3585":1201,"_31232":1178,"_21602":54655,"_5":14833,"_28348":54595,"_3053":54656},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3585":1202,"_31232":1178,"_21602":54658,"_5":14833,"_28348":54595,"_3053":54659},[],"`webhook config must not reference files`",{"_3585":1203,"_31232":1178,"_21602":54661,"_5":14833,"_28348":54595,"_3053":54662},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3585":1204,"_31232":1178,"_21602":54664,"_5":14833,"_28348":54595,"_3053":54665},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3585":1205,"_31232":1178,"_21602":54667,"_5":14833,"_28348":54595,"_3053":54668},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3585":1206,"_31232":1178,"_21602":54670,"_5":14833,"_28348":54595,"_3053":54671},[],"`webhook mTLS certificate and key are invalid: …`",{"_3585":1207,"_31232":1178,"_21602":54673,"_5":14833,"_28348":54595,"_3053":54674},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3585":1208,"_31232":1178,"_21602":54676,"_5":14833,"_28348":54595,"_3053":54677},[],"400 `struct validation error` creating or updating a DMS",{"_3585":1209,"_31232":1178,"_21602":54679,"_5":14833,"_28348":54595,"_3053":54680},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3585":1210,"_31232":1178,"_21602":54682,"_5":14833,"_28348":54595,"_3053":54683},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3585":1211,"_31232":1178,"_21602":54685,"_5":14833,"_28348":54595,"_3053":54686},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3585":1212,"_31232":1178,"_21602":54688,"_5":14833,"_28348":54595,"_3053":54689},[],"`device not preregistered`",{"_3585":1213,"_31232":1178,"_21602":54691,"_5":14833,"_28348":54595,"_3053":54692},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3585":1214,"_31232":1178,"_21602":54694,"_5":14833,"_28348":54595,"_3053":54695},[],"`forbiddenNewEnrollment`",{"_3585":1215,"_31232":1178,"_21602":54697,"_5":14833,"_28348":54595,"_3053":54698},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3585":1216,"_31232":1178,"_21602":54700,"_5":14833,"_28348":54595,"_3053":54701},[],"Different owning DMS",{"_3585":1217,"_31232":1178,"_21602":54703,"_5":14833,"_28348":54595,"_3053":54704},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3585":1218,"_31232":1178,"_21602":54706,"_5":14833,"_28348":54595,"_3053":54707},[],"`invalid RawSubject bytes`",{"_3585":1219,"_31232":1178,"_21602":54709,"_5":14833,"_28348":54595,"_3053":54710},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3585":1220,"_31232":1178,"_21602":54712,"_5":14833,"_28348":54595,"_3053":54713},[],"`invalid reenroll window`",{"_3585":1221,"_31232":1178,"_21602":54715,"_5":14833,"_28348":54595,"_3053":54716},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3585":1222,"_31232":1178,"_21602":54718,"_5":14833,"_28348":54595,"_3053":54719},[],"Current certificate revoked",{"_3585":1223,"_31232":1178,"_21602":54721,"_5":14833,"_28348":54595,"_3053":54722},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3585":1224,"_31232":1178,"_21602":54724,"_5":14833,"_28348":54595,"_3053":54725},[],"CA, profile or signing error",{"_3585":1225,"_31232":1178,"_21602":54727,"_5":14833,"_28348":54595,"_3053":54728},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3585":1226,"_31232":1178,"_21602":54730,"_5":14833,"_28348":54595,"_3053":54731},[],"HTTP 200 without a device connection",{"_3585":1227,"_31232":1178,"_21602":54733,"_5":14833,"_28348":54595,"_3053":54734},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3585":1228,"_31232":1178,"_21602":54736,"_5":14833,"_28348":54595,"_3053":54737},[],"Timeout or error after issuance",{"_3585":1229,"_31232":1178,"_21602":54739,"_5":14833,"_28348":54595,"_3053":54740},[],"New certificates, current slot and previous identity's state before retrying.",{"_3585":1230,"_31232":1178,"_21602":54742,"_5":14833,"_28348":54599,"_3053":54743},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3585":1231,"_31232":1178,"_21602":54745,"_5":14833,"_28348":54599,"_3053":54746},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3585":1232,"_31232":1178,"_21602":54748,"_5":14833,"_28348":54602,"_3053":54749},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3585":1233,"_31232":1178,"_21602":54751,"_5":14833,"_28348":54602,"_3053":54752},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3585":1234,"_31232":1178,"_21602":54754,"_5":14833,"_28348":54602,"_3053":54755},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3585":1235,"_31232":1178,"_21602":54757,"_5":14833,"_28348":54602,"_3053":54758},[],"Make one request, save headers/body and query the device and certificates.",{"_3585":1236,"_31232":1178,"_21602":54760,"_5":14833,"_28348":54602,"_3053":54761},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3585":1237,"_31232":1178,"_21602":54763,"_5":14833,"_28348":54602,"_3053":54764},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3585":1238,"_31232":1178,"_21602":54766,"_5":14833,"_28348":54602,"_3053":54767},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3585":1239,"_31232":1239,"_5":15204,"_3053":54769,"_31590":54770,"_21602":54771,"_28348":1239},"Trust distribution and updates",[50910,52385,53399,53397,53580],[],{"_3585":1240,"_31232":1239,"_21602":54773,"_5":14833,"_28348":1239,"_3053":54774},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3585":1241,"_31232":1239,"_5":31587,"_21602":54776,"_28348":54777,"_3053":54778},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3585":1242,"_31232":1239,"_5":31587,"_21602":54780,"_28348":54781,"_3053":54782},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3585":1243,"_31232":1239,"_5":31587,"_21602":54784,"_28348":54785,"_3053":54786},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3585":1244,"_31232":1239,"_5":31587,"_21602":54788,"_28348":54789,"_3053":54790},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3585":1245,"_31232":1239,"_5":31587,"_21602":54792,"_28348":54793,"_3053":54794},[],"/docs/pr-preview/pr-61/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3585":1246,"_31232":1239,"_21602":54796,"_5":14833,"_28348":1239,"_3053":54797},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3585":1247,"_31232":1239,"_21602":54799,"_5":14833,"_28348":54777,"_3053":54800},[],"Relationship",{"_3585":1248,"_31232":1239,"_21602":54802,"_5":14833,"_28348":54777,"_3053":54803},[],"Material prepared by its owner",{"_3585":1249,"_31232":1239,"_21602":54805,"_5":14833,"_28348":54777,"_3053":54806},[],"Device → EST server",{"_3585":1250,"_31232":1239,"_21602":54808,"_5":14833,"_28348":54777,"_3053":54809},[],"Previously verified server root, chain or pin and TLS name.",{"_3585":1251,"_31232":1239,"_21602":54811,"_5":14833,"_28348":54777,"_3053":54812},[],"DMS → requester",{"_3585":1252,"_31232":1239,"_21602":54814,"_5":14833,"_28348":54777,"_3053":54815},[],"CAs and rules authorizing initial or renewal credentials.",{"_3585":1253,"_31232":1239,"_21602":54817,"_5":14833,"_28348":54777,"_3053":54818},[],"Consumer → device",{"_3585":1254,"_31232":1239,"_21602":54820,"_5":14833,"_28348":54777,"_3053":54821},[],"Operational identity roots, intermediates, validation and permissions.",{"_3585":1255,"_31232":1239,"_21602":54823,"_5":14833,"_28348":54777,"_3053":54824},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3585":1256,"_31232":1239,"_21602":54826,"_5":14833,"_28348":54781,"_3053":54827},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3585":1257,"_31232":1239,"_21602":54829,"_5":14833,"_28348":54781,"_3053":54830},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3585":1258,"_31232":1239,"_21602":54832,"_5":14833,"_28348":54785,"_3053":54833},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3585":1259,"_31232":1239,"_21602":54835,"_5":14833,"_28348":54785,"_3053":54836},[],"Select policy-approved roots as anchors.",{"_3585":1260,"_31232":1239,"_21602":54838,"_5":14833,"_28348":54785,"_3053":54839},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3585":1261,"_31232":1239,"_21602":54841,"_5":14833,"_28348":54785,"_3053":54842},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3585":1262,"_31232":1239,"_21602":54844,"_5":14833,"_28348":54785,"_3053":54845},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3585":1263,"_31232":1239,"_21602":54847,"_5":14833,"_28348":54785,"_3053":54848},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3585":1264,"_31232":1239,"_21602":54850,"_5":14833,"_28348":54789,"_3053":54851},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3585":1265,"_31232":1239,"_21602":54853,"_5":14833,"_28348":54789,"_3053":54854},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3585":1266,"_31232":1239,"_21602":54856,"_5":14833,"_28348":54789,"_3053":54857},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3585":1267,"_31232":1239,"_21602":54859,"_5":14833,"_28348":54793,"_3053":54860},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3585":1268,"_31232":1268,"_5":15204,"_3053":54862,"_31590":54863,"_21602":54865,"_28348":1268},"AWS IoT Core",[50910,52385,53399,53397,54864],"Integrations",[],{"_3585":1269,"_31232":1268,"_21602":54867,"_5":14833,"_28348":1268,"_3053":54868},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3585":1270,"_31232":1268,"_5":31587,"_21602":54870,"_28348":54871,"_3053":54872},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3585":1271,"_31232":1268,"_5":31587,"_21602":54874,"_28348":54875,"_3053":54876},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3585":1272,"_31232":1268,"_5":31587,"_21602":54878,"_28348":54879,"_3053":54880},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3585":1273,"_31232":1268,"_5":31587,"_21602":54882,"_28348":54883,"_3053":54884},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3585":1274,"_31232":1268,"_5":31587,"_21602":54886,"_28348":54887,"_3053":54888},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3585":1275,"_31232":1268,"_5":31587,"_21602":54890,"_28348":54891,"_3053":54892},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3585":1276,"_31232":1268,"_5":31587,"_21602":54894,"_28348":54895,"_3053":54896},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3585":1277,"_31232":1268,"_5":31587,"_21602":54898,"_28348":54899,"_3053":54900},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3585":1278,"_31232":1268,"_5":31587,"_21602":54902,"_28348":54903,"_3053":54904},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3585":1279,"_31232":1268,"_5":31587,"_21602":54906,"_28348":54907,"_3053":54908},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3585":1280,"_31232":1268,"_5":31587,"_21602":54910,"_28348":54911,"_3053":54912},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3585":1281,"_31232":1268,"_5":31587,"_21602":54914,"_28348":54915,"_3053":54916},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3585":1282,"_31232":1268,"_5":31587,"_21602":54918,"_28348":54919,"_3053":54920},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3585":1283,"_31232":1268,"_5":31587,"_21602":54922,"_28348":54923,"_3053":54924},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3585":1284,"_31232":1268,"_5":31587,"_21602":54926,"_28348":54927,"_3053":54928},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3585":1285,"_31232":1268,"_5":31587,"_21602":54930,"_28348":54931,"_3053":54932},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3585":1286,"_31232":1268,"_5":31587,"_21602":54934,"_28348":54935,"_3053":54936},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3585":1287,"_31232":1268,"_5":31587,"_21602":54938,"_28348":54939,"_3053":54940},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3585":1288,"_31232":1268,"_5":31587,"_21602":54942,"_28348":54943,"_3053":54944},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3585":1289,"_31232":1268,"_5":31587,"_21602":54946,"_28348":54947,"_3053":54948},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3585":1290,"_31232":1268,"_5":31587,"_21602":54950,"_28348":54951,"_3053":54952},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3585":1291,"_31232":1268,"_5":31587,"_21602":54954,"_28348":54955,"_3053":54956},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3585":1292,"_31232":1268,"_5":31587,"_21602":54958,"_28348":54959,"_3053":54960},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3585":1293,"_31232":1268,"_5":31587,"_21602":54962,"_28348":54963,"_3053":54964},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3585":1294,"_31232":1268,"_5":31587,"_21602":54966,"_28348":54967,"_3053":54968},[],"/docs/pr-preview/pr-61/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3585":1295,"_31232":1268,"_21602":54970,"_5":14833,"_28348":1268,"_3053":54971},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3585":1296,"_31232":1268,"_21602":54973,"_5":14833,"_28348":1268,"_3053":54974},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3585":1297,"_31232":1268,"_21602":54976,"_5":14833,"_28348":1268,"_3053":54977},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3585":1298,"_31232":1268,"_21602":54979,"_5":14833,"_28348":54871,"_3053":54980},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3585":1299,"_31232":1268,"_21602":54982,"_5":14833,"_28348":54871,"_3053":54983},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3585":1300,"_31232":1268,"_21602":54985,"_5":14833,"_28348":54871,"_3053":54986},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3585":1301,"_31232":1268,"_21602":54988,"_5":14833,"_28348":54871,"_3053":54989},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3585":1302,"_31232":1268,"_21602":54991,"_5":14833,"_28348":54875,"_3053":54992},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3585":1303,"_31232":1268,"_21602":54994,"_5":14833,"_28348":54879,"_3053":54995},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3585":1304,"_31232":1268,"_21602":54997,"_5":14833,"_28348":54879,"_3053":54998},[],"IAM action",{"_3585":1305,"_31232":1268,"_21602":55000,"_5":14833,"_28348":54879,"_3053":51300},[],{"_3585":1306,"_31232":1268,"_21602":55002,"_5":14833,"_28348":54879,"_3053":55003},[],"`iot:GetRegistrationCode`",{"_3585":1307,"_31232":1268,"_21602":55005,"_5":14833,"_28348":54879,"_3053":55006},[],"Obtain the verification code for CA registration in the Primary Account",{"_3585":1308,"_31232":1268,"_21602":55008,"_5":14833,"_28348":54879,"_3053":55009},[],"`iot:RegisterCACertificate`",{"_3585":1309,"_31232":1268,"_21602":55011,"_5":14833,"_28348":54879,"_3053":55012},[],"Register the CA in AWS IoT",{"_3585":1310,"_31232":1268,"_21602":55014,"_5":14833,"_28348":54879,"_3053":55015},[],"`iot:DescribeCACertificate`",{"_3585":1311,"_31232":1268,"_21602":55017,"_5":14833,"_28348":54879,"_3053":55018},[],"Check the CA registration status",{"_3585":1312,"_31232":1268,"_21602":55020,"_5":14833,"_28348":54879,"_3053":55021},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3585":1313,"_31232":1268,"_21602":55023,"_5":14833,"_28348":54879,"_3053":55024},[],"Create or update Things in IoT Core",{"_3585":1314,"_31232":1268,"_21602":55026,"_5":14833,"_28348":54879,"_3053":55027},[],"`iot:RegisterThing`",{"_3585":1315,"_31232":1268,"_21602":55029,"_5":14833,"_28348":54879,"_3053":55030},[],"Provision Things through a template",{"_3585":1316,"_31232":1268,"_21602":55032,"_5":14833,"_28348":54879,"_3053":55033},[],"`iot:RegisterCertificate`",{"_3585":1317,"_31232":1268,"_21602":55035,"_5":14833,"_28348":54879,"_3053":55036},[],"Register device certificates",{"_3585":1318,"_31232":1268,"_21602":55038,"_5":14833,"_28348":54879,"_3053":55039},[],"`iot:UpdateCertificate`",{"_3585":1319,"_31232":1268,"_21602":55041,"_5":14833,"_28348":54879,"_3053":55042},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3585":1320,"_31232":1268,"_21602":55044,"_5":14833,"_28348":54879,"_3053":55045},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3585":1321,"_31232":1268,"_21602":55047,"_5":14833,"_28348":54879,"_3053":55048},[],"Create and attach IoT policies",{"_3585":1322,"_31232":1268,"_21602":55050,"_5":14833,"_28348":54879,"_3053":55051},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3585":1323,"_31232":1268,"_21602":55053,"_5":14833,"_28348":54879,"_3053":55054},[],"Manage Thing groups",{"_3585":1324,"_31232":1268,"_21602":55056,"_5":14833,"_28348":54879,"_3053":55057},[],"`iot:CreateProvisioningTemplate`",{"_3585":1325,"_31232":1268,"_21602":55059,"_5":14833,"_28348":54879,"_3053":55060},[],"Create JITP templates",{"_3585":1326,"_31232":1268,"_21602":55062,"_5":14833,"_28348":54879,"_3053":55063},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3585":1327,"_31232":1268,"_21602":55065,"_5":14833,"_28348":54879,"_3053":55066},[],"Read and write the Device Shadow",{"_3585":1328,"_31232":1268,"_21602":55068,"_5":14833,"_28348":54879,"_3053":55069},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3585":1329,"_31232":1268,"_21602":55071,"_5":14833,"_28348":54883,"_3053":55072},[],"Parameter",{"_3585":1330,"_31232":1268,"_21602":55074,"_5":14833,"_28348":54883,"_3053":55075},[],"Type",{"_3585":1331,"_31232":1268,"_21602":55077,"_5":14833,"_28348":54883,"_3053":55078},[],"Required",{"_3585":1332,"_31232":1268,"_21602":55080,"_5":14833,"_28348":54883,"_3053":55081},[],"Description",{"_3585":1333,"_31232":1268,"_21602":55083,"_5":14833,"_28348":54883,"_3053":55084},[],"`connector_id`",{"_3585":1334,"_31232":1268,"_21602":55086,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1335,"_31232":1268,"_21602":55088,"_5":14833,"_28348":54883,"_3053":55089},[],"Yes",{"_3585":1336,"_31232":1268,"_21602":55091,"_5":14833,"_28348":54883,"_3053":55092},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3585":1337,"_31232":1268,"_21602":55094,"_5":14833,"_28348":54883,"_3053":55095},[],"`aws_config.region`",{"_3585":1338,"_31232":1268,"_21602":55097,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1339,"_31232":1268,"_21602":55099,"_5":14833,"_28348":54883,"_3053":55089},[],{"_3585":1340,"_31232":1268,"_21602":55101,"_5":14833,"_28348":54883,"_3053":55102},[],"AWS region where the connector operates.",{"_3585":1341,"_31232":1268,"_21602":55104,"_5":14833,"_28348":54883,"_3053":55105},[],"`aws_config.auth_method`",{"_3585":1342,"_31232":1268,"_21602":55107,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1343,"_31232":1268,"_21602":55109,"_5":14833,"_28348":54883,"_3053":55089},[],{"_3585":1344,"_31232":1268,"_21602":55111,"_5":14833,"_28348":54883,"_3053":55112},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3585":1345,"_31232":1268,"_21602":55114,"_5":14833,"_28348":54883,"_3053":55115},[],"`aws_config.access_key_id`",{"_3585":1346,"_31232":1268,"_21602":55117,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1347,"_31232":1268,"_21602":55119,"_5":14833,"_28348":54883,"_3053":55120},[],"Only with `auth_method=static`",{"_3585":1348,"_31232":1268,"_21602":55122,"_5":14833,"_28348":54883,"_3053":55123},[],"AWS access key.",{"_3585":1349,"_31232":1268,"_21602":55125,"_5":14833,"_28348":54883,"_3053":55126},[],"`aws_config.secret_access_key`",{"_3585":1350,"_31232":1268,"_21602":55128,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1351,"_31232":1268,"_21602":55130,"_5":14833,"_28348":54883,"_3053":55120},[],{"_3585":1352,"_31232":1268,"_21602":55132,"_5":14833,"_28348":54883,"_3053":55133},[],"AWS secret key.",{"_3585":1353,"_31232":1268,"_21602":55135,"_5":14833,"_28348":54883,"_3053":55136},[],"`aws_config.session_token`",{"_3585":1354,"_31232":1268,"_21602":55138,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1355,"_31232":1268,"_21602":55140,"_5":14833,"_28348":54883,"_3053":55141},[],"No",{"_3585":1356,"_31232":1268,"_21602":55143,"_5":14833,"_28348":54883,"_3053":55144},[],"Session token (with `auth_method=static`).",{"_3585":1357,"_31232":1268,"_21602":55146,"_5":14833,"_28348":54883,"_3053":55147},[],"`aws_config.role_arn`",{"_3585":1358,"_31232":1268,"_21602":55149,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1359,"_31232":1268,"_21602":55151,"_5":14833,"_28348":54883,"_3053":55152},[],"Only with `auth_method=role`",{"_3585":1360,"_31232":1268,"_21602":55154,"_5":14833,"_28348":54883,"_3053":55155},[],"ARN of the role to assume.",{"_3585":1361,"_31232":1268,"_21602":55157,"_5":14833,"_28348":54883,"_3053":55158},[],"`aws_config.endpoint_url`",{"_3585":1362,"_31232":1268,"_21602":55160,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1363,"_31232":1268,"_21602":55162,"_5":14833,"_28348":54883,"_3053":55141},[],{"_3585":1364,"_31232":1268,"_21602":55164,"_5":14833,"_28348":54883,"_3053":55165},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3585":1365,"_31232":1268,"_21602":55167,"_5":14833,"_28348":54883,"_3053":55168},[],"`subscriber_event_bus`",{"_3585":1366,"_31232":1268,"_21602":55170,"_5":14833,"_28348":54883,"_3053":18202},[],{"_3585":1367,"_31232":1268,"_21602":55172,"_5":14833,"_28348":54883,"_3053":55089},[],{"_3585":1368,"_31232":1268,"_21602":55174,"_5":14833,"_28348":54883,"_3053":55175},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3585":1369,"_31232":1268,"_21602":55177,"_5":14833,"_28348":54883,"_3053":55178},[],"`dms_manager_client`",{"_3585":1370,"_31232":1268,"_21602":55180,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1371,"_31232":1268,"_21602":55182,"_5":14833,"_28348":54883,"_3053":55089},[],{"_3585":1372,"_31232":1268,"_21602":55184,"_5":14833,"_28348":54883,"_3053":55185},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3585":1373,"_31232":1268,"_21602":55187,"_5":14833,"_28348":54883,"_3053":55188},[],"`device_manager_client`",{"_3585":1374,"_31232":1268,"_21602":55190,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1375,"_31232":1268,"_21602":55192,"_5":14833,"_28348":54883,"_3053":55089},[],{"_3585":1376,"_31232":1268,"_21602":55194,"_5":14833,"_28348":54883,"_3053":55195},[],"HTTP URL of Lamassu's Device Manager.",{"_3585":1377,"_31232":1268,"_21602":55197,"_5":14833,"_28348":54883,"_3053":55198},[],"`ca_client`",{"_3585":1378,"_31232":1268,"_21602":55200,"_5":14833,"_28348":54883,"_3053":25854},[],{"_3585":1379,"_31232":1268,"_21602":55202,"_5":14833,"_28348":54883,"_3053":55089},[],{"_3585":1380,"_31232":1268,"_21602":55204,"_5":14833,"_28348":54883,"_3053":55205},[],"HTTP URL of Lamassu's CA service.",{"_3585":1381,"_31232":1268,"_21602":55207,"_5":14833,"_28348":54887,"_3053":55208},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3585":1382,"_31232":1268,"_21602":55210,"_5":14833,"_28348":54887,"_3053":55211},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3585":1383,"_31232":1268,"_21602":55213,"_5":14833,"_28348":54887,"_3053":55214},[],"CloudEvent type",{"_3585":1384,"_31232":1268,"_21602":55216,"_5":14833,"_28348":54887,"_3053":55217},[],"Lamassu resource",{"_3585":1385,"_31232":1268,"_21602":55219,"_5":14833,"_28348":54887,"_3053":55220},[],"AWS Resource",{"_3585":1386,"_31232":1268,"_21602":55222,"_5":14833,"_28348":54887,"_3053":55223},[],"IAM actions",{"_3585":1387,"_31232":1268,"_21602":55225,"_5":14833,"_28348":54887,"_3053":55226},[],"AWS calls and effect",{"_3585":1388,"_31232":1268,"_21602":55228,"_5":14833,"_28348":54887,"_3053":55229},[],"Where in this page",{"_3585":1389,"_31232":1268,"_21602":55231,"_5":14833,"_28348":54887,"_3053":55232},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3585":1390,"_31232":1268,"_21602":55234,"_5":14833,"_28348":54887,"_3053":55235},[],"CA",{"_3585":1391,"_31232":1268,"_21602":55237,"_5":14833,"_28348":54887,"_3053":55238},[],"`IoTCore/CACertificate`",{"_3585":1392,"_31232":1268,"_21602":55240,"_5":14833,"_28348":54887,"_3053":55241},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3585":1393,"_31232":1268,"_21602":55243,"_5":14833,"_28348":54887,"_3053":55244},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3585":1394,"_31232":1268,"_21602":55246,"_5":14833,"_28348":54887,"_3053":54900},[],{"_3585":1395,"_31232":1268,"_21602":55248,"_5":14833,"_28348":54887,"_3053":55249},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3585":1396,"_31232":1268,"_21602":55251,"_5":14833,"_28348":54887,"_3053":55252},[],"DMS",{"_3585":1397,"_31232":1268,"_21602":55254,"_5":14833,"_28348":54887,"_3053":55255},[],"`IoTCore/ProvisioningTemplate`",{"_3585":1398,"_31232":1268,"_21602":55257,"_5":14833,"_28348":54887,"_3053":55258},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3585":1399,"_31232":1268,"_21602":55260,"_5":14833,"_28348":54887,"_3053":55261},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3585":1400,"_31232":1268,"_21602":55263,"_5":14833,"_28348":54887,"_3053":54928},[],{"_3585":1401,"_31232":1268,"_21602":55265,"_5":14833,"_28348":54887,"_3053":55266},[],"`EventBindDeviceIdentityKey`",{"_3585":1402,"_31232":1268,"_21602":55268,"_5":14833,"_28348":54887,"_3053":55269},[],"Device",{"_3585":1403,"_31232":1268,"_21602":55271,"_5":14833,"_28348":54887,"_3053":55272},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3585":1404,"_31232":1268,"_21602":55274,"_5":14833,"_28348":54887,"_3053":55275},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3585":1405,"_31232":1268,"_21602":55277,"_5":14833,"_28348":54887,"_3053":55278},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3585":1406,"_31232":1268,"_21602":55280,"_5":14833,"_28348":54887,"_3053":54936},[],{"_3585":1407,"_31232":1268,"_21602":55282,"_5":14833,"_28348":54887,"_3053":55283},[],"`EventUpdateCertificateStatusKey`",{"_3585":1408,"_31232":1268,"_21602":55285,"_5":14833,"_28348":54887,"_3053":55286},[],"Certificate",{"_3585":1409,"_31232":1268,"_21602":55288,"_5":14833,"_28348":54887,"_3053":55289},[],"`IoTCore/Certificate`",{"_3585":1410,"_31232":1268,"_21602":55291,"_5":14833,"_28348":54887,"_3053":55292},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3585":1411,"_31232":1268,"_21602":55294,"_5":14833,"_28348":54887,"_3053":55295},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3585":1412,"_31232":1268,"_21602":55297,"_5":14833,"_28348":54887,"_3053":54948},[],{"_3585":1413,"_31232":1268,"_21602":55299,"_5":14833,"_28348":54887,"_3053":55300},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3585":1414,"_31232":1268,"_21602":55302,"_5":14833,"_28348":54887,"_3053":55303},[],"Certificate / Device",{"_3585":1415,"_31232":1268,"_21602":55305,"_5":14833,"_28348":54887,"_3053":55306},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3585":1416,"_31232":1268,"_21602":55308,"_5":14833,"_28348":54887,"_3053":51306},[],{"_3585":1417,"_31232":1268,"_21602":55310,"_5":14833,"_28348":54887,"_3053":55311},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3585":1418,"_31232":1268,"_21602":55313,"_5":14833,"_28348":54887,"_3053":54956},[],{"_3585":1419,"_31232":1268,"_21602":55315,"_5":14833,"_28348":54891,"_3053":55316},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3585":1420,"_31232":1268,"_21602":55318,"_5":14833,"_28348":54895,"_3053":55319},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3585":1421,"_31232":1268,"_21602":55321,"_5":14833,"_28348":54895,"_3053":55322},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3585":1422,"_31232":1268,"_21602":55324,"_5":14833,"_28348":54899,"_3053":55325},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3585":1423,"_31232":1268,"_21602":55327,"_5":14833,"_28348":54899,"_3053":55328},[],"Transition",{"_3585":1424,"_31232":1268,"_21602":55330,"_5":14833,"_28348":54899,"_3053":55331},[],"AWS calls",{"_3585":1425,"_31232":1268,"_21602":55333,"_5":14833,"_28348":54899,"_3053":55334},[],"`NotRegistered` → `Requested`",{"_3585":1426,"_31232":1268,"_21602":55336,"_5":14833,"_28348":54899,"_3053":55337},[],"none (metadata write only)",{"_3585":1427,"_31232":1268,"_21602":55339,"_5":14833,"_28348":54899,"_3053":55340},[],"`Requested` → `Registering`",{"_3585":1428,"_31232":1268,"_21602":55342,"_5":14833,"_28348":54899,"_3053":55343},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3585":1429,"_31232":1268,"_21602":55345,"_5":14833,"_28348":54899,"_3053":55346},[],"`Registering` → `Succeeded`",{"_3585":1430,"_31232":1268,"_21602":55348,"_5":14833,"_28348":54899,"_3053":55349},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3585":1431,"_31232":1268,"_21602":55351,"_5":14833,"_28348":54899,"_3053":55352},[],"`Registering` → `Failed`",{"_3585":1432,"_31232":1268,"_21602":55354,"_5":14833,"_28348":54899,"_3053":55355},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3585":1433,"_31232":1268,"_21602":55357,"_5":14833,"_28348":54899,"_3053":55358},[],"`Failed` / `Succeeded` → `Requested`",{"_3585":1434,"_31232":1268,"_21602":55360,"_5":14833,"_28348":54899,"_3053":55361},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3585":1435,"_31232":1268,"_21602":55363,"_5":14833,"_28348":54903,"_3053":55364},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3585":1436,"_31232":1268,"_21602":55366,"_5":14833,"_28348":54903,"_3053":55367},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3585":1437,"_31232":1268,"_21602":55369,"_5":14833,"_28348":54903,"_3053":55370},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3585":1438,"_31232":1268,"_21602":55372,"_5":14833,"_28348":54903,"_3053":55373},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3585":1439,"_31232":1268,"_21602":55375,"_5":14833,"_28348":54903,"_3053":55376},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3585":1440,"_31232":1268,"_21602":55378,"_5":14833,"_28348":54903,"_3053":55379},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3585":1441,"_31232":1268,"_21602":55381,"_5":14833,"_28348":54907,"_3053":55382},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3585":1442,"_31232":1268,"_21602":55384,"_5":14833,"_28348":54911,"_3053":55385},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3585":1443,"_31232":1268,"_21602":55387,"_5":14833,"_28348":54911,"_3053":55388},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3585":1444,"_31232":1268,"_21602":55390,"_5":14833,"_28348":54915,"_3053":55391},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3585":1445,"_31232":1268,"_21602":55393,"_5":14833,"_28348":54919,"_3053":55394},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3585":1446,"_31232":1268,"_21602":55396,"_5":14833,"_28348":54919,"_3053":55397},[],"Creates or updates the IoT policies configured in the DMS.",{"_3585":1447,"_31232":1268,"_21602":55399,"_5":14833,"_28348":54919,"_3053":55400},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3585":1448,"_31232":1268,"_21602":55402,"_5":14833,"_28348":54919,"_3053":55403},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3585":1449,"_31232":1268,"_21602":55405,"_5":14833,"_28348":54919,"_3053":55406},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3585":1450,"_31232":1268,"_21602":55408,"_5":14833,"_28348":54919,"_3053":55409},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3585":1451,"_31232":1268,"_21602":55411,"_5":14833,"_28348":54919,"_3053":55412},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3585":1452,"_31232":1268,"_21602":55414,"_5":14833,"_28348":54923,"_3053":55415},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3585":1453,"_31232":1268,"_21602":55417,"_5":14833,"_28348":54923,"_3053":55418},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3585":1454,"_31232":1268,"_21602":55420,"_5":14833,"_28348":54923,"_3053":55421},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3585":1455,"_31232":1268,"_21602":55423,"_5":14833,"_28348":54923,"_3053":55424},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3585":1456,"_31232":1268,"_21602":55426,"_5":14833,"_28348":54923,"_3053":55427},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3585":1457,"_31232":1268,"_21602":55429,"_5":14833,"_28348":54927,"_3053":55430},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3585":1458,"_31232":1268,"_21602":55432,"_5":14833,"_28348":54927,"_3053":55328},[],{"_3585":1459,"_31232":1268,"_21602":55434,"_5":14833,"_28348":54927,"_3053":55331},[],{"_3585":1460,"_31232":1268,"_21602":55436,"_5":14833,"_28348":54927,"_3053":55437},[],"`Unconfigured` → `None` / `Auto`",{"_3585":1461,"_31232":1268,"_21602":55439,"_5":14833,"_28348":54927,"_3053":55440},[],"none (configuration only)",{"_3585":1462,"_31232":1268,"_21602":55442,"_5":14833,"_28348":54927,"_3053":55443},[],"`None` ↔ `Auto`",{"_3585":1463,"_31232":1268,"_21602":55445,"_5":14833,"_28348":54927,"_3053":55440},[],{"_3585":1464,"_31232":1268,"_21602":55447,"_5":14833,"_28348":54927,"_3053":55448},[],"Any → `Jitp`",{"_3585":1465,"_31232":1268,"_21602":55450,"_5":14833,"_28348":54927,"_3053":55451},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3585":1466,"_31232":1268,"_21602":55453,"_5":14833,"_28348":54927,"_3053":55454},[],"`Jitp` → `None` / `Auto`",{"_3585":1467,"_31232":1268,"_21602":55456,"_5":14833,"_28348":54927,"_3053":55457},[],"none (the template stays in the AWS account)",{"_3585":1468,"_31232":1268,"_21602":55459,"_5":14833,"_28348":54931,"_3053":55460},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3585":1469,"_31232":1268,"_21602":55462,"_5":14833,"_28348":54931,"_3053":55463},[],"The full flow from the device's perspective is:",{"_3585":1470,"_31232":1268,"_21602":55465,"_5":14833,"_28348":54931,"_3053":55466},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3585":1471,"_31232":1268,"_21602":55468,"_5":14833,"_28348":54935,"_3053":55469},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3585":1472,"_31232":1268,"_21602":55471,"_5":14833,"_28348":54935,"_3053":55328},[],{"_3585":1473,"_31232":1268,"_21602":55473,"_5":14833,"_28348":54935,"_3053":55331},[],{"_3585":1474,"_31232":1268,"_21602":55475,"_5":14833,"_28348":54935,"_3053":55476},[],"`Absent` → `Provisioned`",{"_3585":1475,"_31232":1268,"_21602":55478,"_5":14833,"_28348":54935,"_3053":55479},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3585":1476,"_31232":1268,"_21602":55481,"_5":14833,"_28348":54935,"_3053":55482},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3585":1477,"_31232":1268,"_21602":55484,"_5":14833,"_28348":54935,"_3053":55485},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3585":1478,"_31232":1268,"_21602":55487,"_5":14833,"_28348":54935,"_3053":55488},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3585":1479,"_31232":1268,"_21602":55490,"_5":14833,"_28348":54939,"_3053":55491},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3585":1480,"_31232":1268,"_21602":55493,"_5":14833,"_28348":54939,"_3053":55494},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3585":1481,"_31232":1268,"_21602":55496,"_5":14833,"_28348":54939,"_3053":55497},[],"For the JITP flow to work correctly:",{"_3585":1482,"_31232":1268,"_21602":55499,"_5":14833,"_28348":54939,"_3053":55500},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3585":1483,"_31232":1268,"_21602":55502,"_5":14833,"_28348":54939,"_3053":55503},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3585":1484,"_31232":1268,"_21602":55505,"_5":14833,"_28348":54939,"_3053":55506},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3585":1485,"_31232":1268,"_21602":55508,"_5":14833,"_28348":54939,"_3053":55509},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3585":1486,"_31232":1268,"_21602":55511,"_5":14833,"_28348":54943,"_3053":55512},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3585":1487,"_31232":1268,"_21602":55514,"_5":14833,"_28348":54943,"_3053":55515},[],"Status in Lamassu",{"_3585":1488,"_31232":1268,"_21602":55517,"_5":14833,"_28348":54943,"_3053":55518},[],"Revocation reason",{"_3585":1489,"_31232":1268,"_21602":55520,"_5":14833,"_28348":54943,"_3053":55521},[],"Status in AWS IoT Core",{"_3585":1490,"_31232":1268,"_21602":55523,"_5":14833,"_28348":54943,"_3053":55524},[],"`Active`",{"_3585":1491,"_31232":1268,"_21602":55526,"_5":14833,"_28348":54943,"_3053":55527},[],"None",{"_3585":1492,"_31232":1268,"_21602":55529,"_5":14833,"_28348":54943,"_3053":55530},[],"`ACTIVE`",{"_3585":1493,"_31232":1268,"_21602":55532,"_5":14833,"_28348":54943,"_3053":55533},[],"`Revoked`",{"_3585":1494,"_31232":1268,"_21602":55535,"_5":14833,"_28348":54943,"_3053":55536},[],"`certificateHold`",{"_3585":1495,"_31232":1268,"_21602":55538,"_5":14833,"_28348":54943,"_3053":55539},[],"`INACTIVE`",{"_3585":1496,"_31232":1268,"_21602":55541,"_5":14833,"_28348":54943,"_3053":55533},[],{"_3585":1497,"_31232":1268,"_21602":55543,"_5":14833,"_28348":54943,"_3053":55544},[],"Any other reason",{"_3585":1498,"_31232":1268,"_21602":55546,"_5":14833,"_28348":54943,"_3053":55547},[],"`REVOKED`",{"_3585":1499,"_31232":1268,"_21602":55549,"_5":14833,"_28348":54943,"_3053":55550},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3585":1500,"_31232":1268,"_21602":55552,"_5":14833,"_28348":54947,"_3053":55553},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3585":1501,"_31232":1268,"_21602":55555,"_5":14833,"_28348":54947,"_3053":55328},[],{"_3585":1502,"_31232":1268,"_21602":55557,"_5":14833,"_28348":54947,"_3053":55331},[],{"_3585":1503,"_31232":1268,"_21602":55559,"_5":14833,"_28348":54947,"_3053":55560},[],"`NotSynced` → `Active`",{"_3585":1504,"_31232":1268,"_21602":55562,"_5":14833,"_28348":54947,"_3053":55039},[],{"_3585":1505,"_31232":1268,"_21602":55564,"_5":14833,"_28348":54947,"_3053":55565},[],"`Active` → `Inactive`",{"_3585":1506,"_31232":1268,"_21602":55567,"_5":14833,"_28348":54947,"_3053":55568},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3585":1507,"_31232":1268,"_21602":55570,"_5":14833,"_28348":54947,"_3053":55571},[],"`Active` → `Revoked`",{"_3585":1508,"_31232":1268,"_21602":55573,"_5":14833,"_28348":54947,"_3053":55568},[],{"_3585":1509,"_31232":1268,"_21602":55575,"_5":14833,"_28348":54947,"_3053":55576},[],"`Inactive` / `Revoked` → `Active`",{"_3585":1510,"_31232":1268,"_21602":55578,"_5":14833,"_28348":54947,"_3053":55039},[],{"_3585":1511,"_31232":1268,"_21602":55580,"_5":14833,"_28348":54947,"_3053":55581},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3585":1512,"_31232":1268,"_21602":55583,"_5":14833,"_28348":54947,"_3053":55584},[],"none (these states are not synced to AWS)",{"_3585":1513,"_31232":1268,"_21602":55586,"_5":14833,"_28348":54951,"_3053":55587},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3585":1514,"_31232":1268,"_21602":55589,"_5":14833,"_28348":54951,"_3053":55590},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3585":1515,"_31232":1268,"_21602":55592,"_5":14833,"_28348":54951,"_3053":55593},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3585":1516,"_31232":1268,"_21602":55595,"_5":14833,"_28348":54955,"_3053":55596},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3585":1517,"_31232":1268,"_21602":55598,"_5":14833,"_28348":54955,"_3053":55599},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3585":1518,"_31232":1268,"_21602":55601,"_5":14833,"_28348":54959,"_3053":55602},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3585":1519,"_31232":1268,"_21602":55604,"_5":14833,"_28348":54959,"_3053":55605},[],"There are two action types:",{"_3585":1520,"_31232":1268,"_21602":55607,"_5":14833,"_28348":54959,"_3053":55608},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3585":1521,"_31232":1268,"_21602":55610,"_5":14833,"_28348":54959,"_3053":55611},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3585":1522,"_31232":1268,"_21602":55613,"_5":14833,"_28348":54959,"_3053":55614},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3585":1523,"_31232":1268,"_21602":55616,"_5":14833,"_28348":54963,"_3053":55617},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3585":1524,"_31232":1268,"_21602":55619,"_5":14833,"_28348":54963,"_3053":55620},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3585":1525,"_31232":1268,"_21602":55622,"_5":14833,"_28348":54963,"_3053":55623},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3585":1526,"_31232":1268,"_21602":55625,"_5":14833,"_28348":54967,"_3053":55626},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3585":1527,"_31232":1268,"_21602":55628,"_5":14833,"_28348":54967,"_3053":55629},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3585":1528,"_31232":1268,"_21602":55631,"_5":14833,"_28348":54967,"_3053":55632},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3585":1529,"_31232":1268,"_21602":55634,"_5":14833,"_28348":54967,"_3053":55635},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3585":1530,"_31232":1268,"_21602":55637,"_5":14833,"_28348":54967,"_3053":55638},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3585":1531,"_31232":1268,"_21602":55640,"_5":14833,"_28348":54967,"_3053":55641},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3585":1532,"_31232":1268,"_21602":55643,"_5":14833,"_28348":54967,"_3053":55644},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3585":1533,"_31232":1268,"_21602":55646,"_5":14833,"_28348":54967,"_3053":55647},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3585":1534,"_31232":1268,"_21602":55649,"_5":14833,"_28348":54967,"_3053":55650},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3585":1535,"_31232":1268,"_21602":55652,"_5":14833,"_28348":54967,"_3053":55653},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3585":1536,"_31232":1268,"_21602":55655,"_5":14833,"_28348":54967,"_3053":55656},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3585":1537,"_31232":1268,"_21602":55658,"_5":14833,"_28348":54967,"_3053":55659},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3585":1538,"_31232":1268,"_21602":55661,"_5":14833,"_28348":54967,"_3053":55662},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3585":1539,"_31232":1268,"_21602":55664,"_5":14833,"_28348":54967,"_3053":55665},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3585":1540,"_31232":1268,"_21602":55667,"_5":14833,"_28348":54967,"_3053":55668},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3585":1541,"_31232":1268,"_21602":55670,"_5":14833,"_28348":54967,"_3053":55671},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3585":1542,"_31232":1268,"_21602":55673,"_5":14833,"_28348":54967,"_3053":55674},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3585":1543,"_31232":1268,"_21602":55676,"_5":14833,"_28348":54967,"_3053":55677},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3585":1544,"_31232":1268,"_21602":55679,"_5":14833,"_28348":54967,"_3053":55680},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3585":1545,"_31232":1268,"_21602":55682,"_5":14833,"_28348":54967,"_3053":55683},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3585":1546,"_31232":1268,"_21602":55685,"_5":14833,"_28348":54967,"_3053":55686},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3585":1547,"_31232":1268,"_21602":55688,"_5":14833,"_28348":54967,"_3053":55689},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3585":1548,"_31232":1268,"_21602":55691,"_5":14833,"_28348":54967,"_3053":55692},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3585":1549,"_31232":1268,"_21602":55694,"_5":14833,"_28348":54967,"_3053":55695},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3585":1550,"_31232":1550,"_5":15204,"_3053":53399,"_31590":55697,"_21602":55698,"_28348":1550},[50910,52385,53399],[],{"_3585":1551,"_31232":1550,"_21602":55700,"_5":14833,"_28348":1550,"_3053":55701},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3585":1552,"_31232":1550,"_5":31587,"_21602":55703,"_28348":55704,"_3053":55705},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#start-here","Start here",{"_3585":1553,"_31232":1550,"_5":31587,"_21602":55707,"_28348":55708,"_3053":53397},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#devices-and-identities",{"_3585":1554,"_31232":1550,"_5":31587,"_21602":55710,"_28348":55711,"_3053":53580},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#enrollment-with-pki",{"_3585":1555,"_31232":1550,"_5":31587,"_21602":55713,"_28348":55714,"_3053":54864},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#integrations",{"_3585":1556,"_31232":1550,"_5":31587,"_21602":55716,"_28348":55717,"_3053":55718},[],"/docs/pr-preview/pr-61/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3585":1557,"_31232":1550,"_21602":55720,"_5":14833,"_28348":1550,"_3053":55721},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3585":1558,"_31232":1550,"_21602":55723,"_5":14833,"_28348":55704,"_3053":55724},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3585":1559,"_31232":1550,"_21602":55726,"_5":14833,"_28348":55704,"_3053":55727},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3585":1560,"_31232":1550,"_21602":55729,"_5":14833,"_28348":55708,"_3053":55730},[],"Resource",{"_3585":1561,"_31232":1550,"_21602":55732,"_5":14833,"_28348":55708,"_3053":55733},[],"What it represents",{"_3585":1562,"_31232":1550,"_21602":55735,"_5":14833,"_28348":55708,"_3053":55736},[],"**Device**",{"_3585":1563,"_31232":1550,"_21602":55738,"_5":14833,"_28348":55708,"_3053":55739},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3585":1564,"_31232":1550,"_21602":55741,"_5":14833,"_28348":55708,"_3053":55742},[],"**Identity**",{"_3585":1565,"_31232":1550,"_21602":55744,"_5":14833,"_28348":55708,"_3053":55745},[],"The device's association with its certificates: an active version and a history.",{"_3585":1566,"_31232":1550,"_21602":55747,"_5":14833,"_28348":55708,"_3053":55748},[],"**DMS**",{"_3585":1567,"_31232":1550,"_21602":55750,"_5":14833,"_28348":55708,"_3053":55751},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3585":1568,"_31232":1550,"_21602":55753,"_5":14833,"_28348":55708,"_3053":55754},[],"**Fleet**",{"_3585":1569,"_31232":1550,"_21602":55756,"_5":14833,"_28348":55708,"_3053":55757},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3585":1570,"_31232":1550,"_21602":55759,"_5":14833,"_28348":55708,"_3053":55760},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3585":1571,"_31232":1550,"_21602":55762,"_5":14833,"_28348":55708,"_3053":55763},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3585":1572,"_31232":1550,"_21602":55765,"_5":14833,"_28348":55711,"_3053":55766},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3585":1573,"_31232":1550,"_21602":55768,"_5":14833,"_28348":55711,"_3053":55769},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3585":1574,"_31232":1550,"_21602":55771,"_5":14833,"_28348":55711,"_3053":55772},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3585":1575,"_31232":1550,"_21602":55774,"_5":14833,"_28348":55711,"_3053":55775},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3585":1576,"_31232":1550,"_21602":55777,"_5":14833,"_28348":55711,"_3053":55778},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3585":1577,"_31232":1550,"_21602":55780,"_5":14833,"_28348":55711,"_3053":55781},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3585":1578,"_31232":1550,"_21602":55783,"_5":14833,"_28348":55711,"_3053":55784},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3585":1579,"_31232":1550,"_21602":55786,"_5":14833,"_28348":55711,"_3053":55787},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3585":1580,"_31232":1550,"_21602":55789,"_5":14833,"_28348":55714,"_3053":55790},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3585":1581,"_31232":1550,"_21602":55792,"_5":14833,"_28348":55714,"_3053":55793},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3585":1582,"_31232":1550,"_21602":55795,"_5":14833,"_28348":55717,"_3053":55796},[],"Participant",{"_3585":1583,"_31232":1550,"_21602":55798,"_5":14833,"_28348":55717,"_3053":55799},[],"Responsibility",{"_3585":1584,"_31232":1550,"_21602":55801,"_5":14833,"_28348":55717,"_3053":55802},[],"PKI administrator",{"_3585":1585,"_31232":1550,"_21602":55804,"_5":14833,"_28348":55717,"_3053":55805},[],"CA, issuance profile, chain and revocation publication.",{"_3585":1586,"_31232":1550,"_21602":55807,"_5":14833,"_28348":55717,"_3053":55808},[],"Provisioning administrator",{"_3585":1587,"_31232":1550,"_21602":55810,"_5":14833,"_28348":55717,"_3053":55811},[],"DMS, admission, authentication per operation and inventory.",{"_3585":1588,"_31232":1550,"_21602":55813,"_5":14833,"_28348":55717,"_3053":55814},[],"Device integrator",{"_3585":1589,"_31232":1550,"_21602":55816,"_5":14833,"_28348":55717,"_3053":55817},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3585":1590,"_31232":1550,"_21602":55819,"_5":14833,"_28348":55717,"_3053":55820},[],"Consumer integrator",{"_3585":1591,"_31232":1550,"_21602":55822,"_5":14833,"_28348":55717,"_3053":55823},[],"Trusted issuers, validation and device permissions in the destination.",{"_3585":1592,"_31232":1550,"_21602":55825,"_5":14833,"_28348":55717,"_3053":55826},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3585":1593,"_31232":1593,"_5":15204,"_3053":55828,"_31590":55829,"_21602":55831,"_28348":1593},"Enroll and connect your first device",[50910,52385,53399,55830],"Getting started",[],{"_3585":1594,"_31232":1593,"_21602":55833,"_5":14833,"_28348":1593,"_3053":55834},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3585":1595,"_31232":1593,"_5":31587,"_21602":55836,"_28348":55837,"_3053":50920},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3585":1596,"_31232":1593,"_5":31587,"_21602":55839,"_28348":55840,"_3053":55841},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3585":1597,"_31232":1593,"_5":31587,"_21602":55843,"_28348":55844,"_3053":55845},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3585":1598,"_31232":1593,"_5":31587,"_21602":55847,"_28348":55848,"_3053":55849},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3585":1599,"_31232":1593,"_5":31587,"_21602":55851,"_28348":55852,"_3053":55853},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3585":1600,"_31232":1593,"_5":31587,"_21602":55855,"_28348":55856,"_3053":55857},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3585":1601,"_31232":1593,"_5":31587,"_21602":55859,"_28348":55860,"_3053":55861},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3585":1602,"_31232":1593,"_5":31587,"_21602":55863,"_28348":55864,"_3053":55865},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3585":1603,"_31232":1593,"_21602":55867,"_5":14833,"_28348":1593,"_3053":55868},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3585":1604,"_31232":1593,"_21602":55870,"_5":14833,"_28348":55837,"_3053":55871},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3585":1605,"_31232":1593,"_21602":55873,"_5":14833,"_28348":55837,"_3053":55874},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3585":1606,"_31232":1593,"_21602":55876,"_5":14833,"_28348":55837,"_3053":55877},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3585":1607,"_31232":1593,"_21602":55879,"_5":14833,"_28348":55837,"_3053":55880},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3585":1608,"_31232":1593,"_21602":55882,"_5":14833,"_28348":55837,"_3053":55883},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3585":1609,"_31232":1593,"_21602":55885,"_5":14833,"_28348":55840,"_3053":55886},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3585":1610,"_31232":1593,"_21602":55888,"_5":14833,"_28348":55840,"_3053":55889},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3585":1611,"_31232":1593,"_21602":55891,"_5":14833,"_28348":55844,"_3053":55892},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3585":1612,"_31232":1593,"_21602":55894,"_5":14833,"_28348":55844,"_3053":55895},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3585":1613,"_31232":1593,"_21602":55897,"_5":14833,"_28348":55844,"_3053":55898},[],"Setting",{"_3585":1614,"_31232":1593,"_21602":55900,"_5":14833,"_28348":55844,"_3053":55901},[],"Evaluation value",{"_3585":1615,"_31232":1593,"_21602":55903,"_5":14833,"_28348":55844,"_3053":55904},[],"Enrollment CA",{"_3585":1616,"_31232":1593,"_21602":55906,"_5":14833,"_28348":55844,"_3053":55907},[],"Issuing root from `device-root.pem`.",{"_3585":1617,"_31232":1593,"_21602":55909,"_5":14833,"_28348":55844,"_3053":53710},[],{"_3585":1618,"_31232":1593,"_21602":55911,"_5":14833,"_28348":55844,"_3053":55912},[],"The 1-hour leaf profile you just prepared.",{"_3585":1619,"_31232":1593,"_21602":55914,"_5":14833,"_28348":55844,"_3053":55915},[],"Protocol / Registration Mode",{"_3585":1620,"_31232":1593,"_21602":55917,"_5":14833,"_28348":55844,"_3053":55918},[],"`EST_RFC7030` / `JITP`.",{"_3585":1621,"_31232":1593,"_21602":55920,"_5":14833,"_28348":55844,"_3053":55921},[],"Verify CSR Signature",{"_3585":1622,"_31232":1593,"_21602":55923,"_5":14833,"_28348":55844,"_3053":55924},[],"Enabled.",{"_3585":1623,"_31232":1593,"_21602":55926,"_5":14833,"_28348":55844,"_3053":55927},[],"Enable Replaceable Enrollment",{"_3585":1624,"_31232":1593,"_21602":55929,"_5":14833,"_28348":55844,"_3053":55930},[],"Disabled; the ID must be new.",{"_3585":1625,"_31232":1593,"_21602":55932,"_5":14833,"_28348":55844,"_3053":55933},[],"Initial authentication",{"_3585":1626,"_31232":1593,"_21602":55935,"_5":14833,"_28348":55844,"_3053":55936},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3585":1627,"_31232":1593,"_21602":55938,"_5":14833,"_28348":55844,"_3053":55939},[],"Renewal authentication",{"_3585":1628,"_31232":1593,"_21602":55941,"_5":14833,"_28348":55844,"_3053":55942},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3585":1629,"_31232":1593,"_21602":55944,"_5":14833,"_28348":55844,"_3053":55945},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3585":1630,"_31232":1593,"_21602":55947,"_5":14833,"_28348":55844,"_3053":55948},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3585":1631,"_31232":1593,"_21602":55950,"_5":14833,"_28348":55844,"_3053":55951},[],"Re-enrollment Delta",{"_3585":1632,"_31232":1593,"_21602":55953,"_5":14833,"_28348":55844,"_3053":55954},[],"1 hour.",{"_3585":1633,"_31232":1593,"_21602":55956,"_5":14833,"_28348":55844,"_3053":55957},[],"Preventive / Critical Delta",{"_3585":1634,"_31232":1593,"_21602":55959,"_5":14833,"_28348":55844,"_3053":55960},[],"30 minutes / 10 minutes.",{"_3585":1635,"_31232":1593,"_21602":55962,"_5":14833,"_28348":55844,"_3053":55963},[],"Revoke on Re-enrollment",{"_3585":1636,"_31232":1593,"_21602":55965,"_5":14833,"_28348":55844,"_3053":55966},[],"Disabled to test the successor before retiring the previous identity.",{"_3585":1637,"_31232":1593,"_21602":55968,"_5":14833,"_28348":55844,"_3053":53718},[],{"_3585":1638,"_31232":1593,"_21602":55970,"_5":14833,"_28348":55844,"_3053":55971},[],"Disabled; the operational key is generated in the client.",{"_3585":1639,"_31232":1593,"_21602":55973,"_5":14833,"_28348":55844,"_3053":55974},[],"CA Distribution",{"_3585":1640,"_31232":1593,"_21602":55976,"_5":14833,"_28348":55844,"_3053":55977},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3585":1641,"_31232":1593,"_21602":55979,"_5":14833,"_28348":55844,"_3053":55980},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3585":1642,"_31232":1593,"_21602":55982,"_5":14833,"_28348":55848,"_3053":55983},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3585":1643,"_31232":1593,"_21602":55985,"_5":14833,"_28348":55848,"_3053":55986},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3585":1644,"_31232":1593,"_21602":55988,"_5":14833,"_28348":55852,"_3053":55989},[],"The walkthrough shows the whole enrollment from both sides: the Lamassu dashboard on the left, where the DMS is reviewed and the new device is located, and the device terminal on the right, where the key and the CSR are created and the EST request is sent. It runs against a disposable environment with synthetic data, a DMS named `est-showcase` and a device named `sensor-0421`.",{"_3585":1645,"_31232":1593,"_21602":55991,"_5":14833,"_28348":55852,"_3053":55992},[],"The demo DMS has initial authentication disabled and is reached over HTTP, so its `curl` commands carry neither `--cert` nor `--key`. Do not copy that configuration: the commands below use the bootstrap credential and HTTPS, as this quickstart prepared them.",{"_3585":1646,"_31232":1593,"_21602":55994,"_5":14833,"_28348":55852,"_3053":55995},[],"Generate a new key and CSR with the selected identifier:",{"_3585":1647,"_31232":1593,"_21602":55997,"_5":14833,"_28348":55852,"_3053":55998},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3585":1648,"_31232":1593,"_21602":56000,"_5":14833,"_28348":55852,"_3053":56001},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3585":1649,"_31232":1593,"_21602":56003,"_5":14833,"_28348":55856,"_3053":56004},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3585":1650,"_31232":1593,"_21602":56006,"_5":14833,"_28348":55856,"_3053":56007},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3585":1651,"_31232":1593,"_21602":56009,"_5":14833,"_28348":55860,"_3053":56010},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3585":1652,"_31232":1593,"_21602":56012,"_5":14833,"_28348":55860,"_3053":56013},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3585":1653,"_31232":1593,"_21602":56015,"_5":14833,"_28348":55860,"_3053":56016},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3585":1654,"_31232":1593,"_21602":56018,"_5":14833,"_28348":55860,"_3053":56019},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3585":1655,"_31232":1593,"_21602":56021,"_5":14833,"_28348":55860,"_3053":56022},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3585":1656,"_31232":1593,"_21602":56024,"_5":14833,"_28348":55864,"_3053":56025},[],"Check",{"_3585":1657,"_31232":1593,"_21602":56027,"_5":14833,"_28348":55864,"_3053":56028},[],"Expected result",{"_3585":1658,"_31232":1593,"_21602":56030,"_5":14833,"_28348":55864,"_3053":56031},[],"Registration",{"_3585":1659,"_31232":1593,"_21602":56033,"_5":14833,"_28348":55864,"_3053":56034},[],"ID created automatically and correct DMS.",{"_3585":1660,"_31232":1593,"_21602":56036,"_5":14833,"_28348":55864,"_3053":55286},[],{"_3585":1661,"_31232":1593,"_21602":56038,"_5":14833,"_28348":55864,"_3053":56039},[],"CN, profile, serial and key verified.",{"_3585":1662,"_31232":1593,"_21602":56041,"_5":14833,"_28348":55864,"_3053":56042},[],"Inventory",{"_3585":1663,"_31232":1593,"_21602":56044,"_5":14833,"_28348":55864,"_3053":56045},[],"Received serial visible as the current identity and in history.",{"_3585":1664,"_31232":1593,"_21602":56047,"_5":14833,"_28348":55864,"_3053":56048},[],"Consumer",{"_3585":1665,"_31232":1593,"_21602":56050,"_5":14833,"_28348":55864,"_3053":56051},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3585":1666,"_31232":1593,"_21602":56053,"_5":14833,"_28348":55864,"_3053":56054},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3585":1667,"_31232":1593,"_21602":56056,"_5":14833,"_28348":55864,"_3053":56057},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3585":1668,"_31232":1668,"_5":15204,"_3053":53415,"_31590":56059,"_21602":56060,"_28348":1668},[50910,52385,53399,55830],[],{"_3585":1669,"_31232":1668,"_21602":56062,"_5":14833,"_28348":1668,"_3053":56063},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3585":1670,"_31232":1668,"_5":31587,"_21602":56065,"_28348":56066,"_3053":50920},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3585":1671,"_31232":1668,"_5":31587,"_21602":56068,"_28348":56069,"_3053":56070},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3585":1672,"_31232":1668,"_5":31587,"_21602":56072,"_28348":56073,"_3053":56074},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3585":1673,"_31232":1668,"_5":31587,"_21602":56076,"_28348":56077,"_3053":56078},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3585":1674,"_31232":1668,"_5":31587,"_21602":56080,"_28348":56081,"_3053":56082},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3585":1675,"_31232":1668,"_5":31587,"_21602":56084,"_28348":56085,"_3053":56086},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3585":1676,"_31232":1668,"_5":31587,"_21602":56088,"_28348":56089,"_3053":56028},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3585":1677,"_31232":1668,"_5":31587,"_21602":56091,"_28348":56092,"_3053":56093},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3585":1678,"_31232":1668,"_5":31587,"_21602":56095,"_28348":56096,"_3053":56097},[],"/docs/pr-preview/pr-61/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3585":1679,"_31232":1668,"_21602":56099,"_5":14833,"_28348":1668,"_3053":56100},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3585":1680,"_31232":1668,"_21602":56102,"_5":14833,"_28348":1668,"_3053":56103},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3585":1681,"_31232":1668,"_21602":56105,"_5":14833,"_28348":56066,"_3053":56106},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3585":1682,"_31232":1668,"_21602":56108,"_5":14833,"_28348":56066,"_3053":56109},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3585":1683,"_31232":1668,"_21602":56111,"_5":14833,"_28348":56066,"_3053":56112},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3585":1684,"_31232":1668,"_21602":56114,"_5":14833,"_28348":56066,"_3053":56115},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3585":1685,"_31232":1668,"_21602":56117,"_5":14833,"_28348":56069,"_3053":56118},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3585":1686,"_31232":1668,"_21602":56120,"_5":14833,"_28348":56069,"_3053":56121},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3585":1687,"_31232":1668,"_21602":56123,"_5":14833,"_28348":56069,"_3053":56124},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3585":1688,"_31232":1668,"_21602":56126,"_5":14833,"_28348":56069,"_3053":56127},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3585":1689,"_31232":1668,"_21602":56129,"_5":14833,"_28348":56069,"_3053":56130},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3585":1690,"_31232":1668,"_21602":56132,"_5":14833,"_28348":56069,"_3053":56133},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3585":1691,"_31232":1668,"_21602":56135,"_5":14833,"_28348":56069,"_3053":56136},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3585":1692,"_31232":1668,"_21602":56138,"_5":14833,"_28348":56069,"_3053":56139},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3585":1693,"_31232":1668,"_21602":56141,"_5":14833,"_28348":56073,"_3053":56142},[],"Open **Managed Devices** and the registration action. Complete:",{"_3585":1694,"_31232":1668,"_21602":56144,"_5":14833,"_28348":56073,"_3053":56145},[],"**Device ID**: `device-001`.",{"_3585":1695,"_31232":1668,"_21602":56147,"_5":14833,"_28348":56073,"_3053":56148},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3585":1696,"_31232":1668,"_21602":56150,"_5":14833,"_28348":56073,"_3053":56151},[],"**Icon** and **Tags**: optional classification.",{"_3585":1697,"_31232":1668,"_21602":56153,"_5":14833,"_28348":56073,"_3053":56154},[],"Confirm registration.",{"_3585":1698,"_31232":1668,"_21602":56156,"_5":14833,"_28348":56077,"_3053":56157},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3585":1699,"_31232":1668,"_21602":56159,"_5":14833,"_28348":56077,"_3053":56160},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3585":1700,"_31232":1668,"_21602":56162,"_5":14833,"_28348":56081,"_3053":56163},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3585":1701,"_31232":1668,"_21602":56165,"_5":14833,"_28348":56081,"_3053":56166},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3585":1702,"_31232":1668,"_21602":56168,"_5":14833,"_28348":56085,"_3053":56169},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3585":1703,"_31232":1668,"_21602":56171,"_5":14833,"_28348":56085,"_3053":56172},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3585":1704,"_31232":1668,"_21602":56174,"_5":14833,"_28348":56089,"_3053":56025},[],{"_3585":1705,"_31232":1668,"_21602":56176,"_5":14833,"_28348":56089,"_3053":56177},[],"Result",{"_3585":1706,"_31232":1668,"_21602":56179,"_5":14833,"_28348":56089,"_3053":55269},[],{"_3585":1707,"_31232":1668,"_21602":56181,"_5":14833,"_28348":56089,"_3053":56182},[],"`device-001` appears in inventory with the expected DMS.",{"_3585":1708,"_31232":1668,"_21602":56184,"_5":14833,"_28348":56089,"_3053":56185},[],"Current identity",{"_3585":1709,"_31232":1668,"_21602":56187,"_5":14833,"_28348":56089,"_3053":56188},[],"The associated certificate matches the one you verified in PKI.",{"_3585":1710,"_31232":1668,"_21602":56190,"_5":14833,"_28348":56089,"_3053":56191},[],"History",{"_3585":1711,"_31232":1668,"_21602":56193,"_5":14833,"_28348":56089,"_3053":56194},[],"The associated issuance appears with its serial number and dates.",{"_3585":1712,"_31232":1668,"_21602":56196,"_5":14833,"_28348":56089,"_3053":56197},[],"Key and certificate",{"_3585":1713,"_31232":1668,"_21602":56199,"_5":14833,"_28348":56089,"_3053":56200},[],"You have the verified pair ready to install on the device.",{"_3585":1714,"_31232":1668,"_21602":56202,"_5":14833,"_28348":56092,"_3053":56203},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3585":1715,"_31232":1668,"_21602":56205,"_5":14833,"_28348":56092,"_3053":56206},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3585":1716,"_31232":1668,"_21602":56208,"_5":14833,"_28348":56092,"_3053":56209},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3585":1717,"_31232":1668,"_21602":56211,"_5":14833,"_28348":56092,"_3053":56212},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3585":1718,"_31232":1668,"_21602":56214,"_5":14833,"_28348":56096,"_3053":56215},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3585":1719,"_31232":1668,"_21602":56217,"_5":14833,"_28348":56096,"_3053":56218},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3585":1720,"_31232":1668,"_21602":56220,"_5":14833,"_28348":56096,"_3053":56221},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3585":1721,"_31232":1721,"_5":15204,"_3053":56223,"_31590":56224,"_21602":56225,"_28348":1721},"Lamassu IoT Platform",[50910,52385],[],{"_3585":1722,"_31232":1721,"_21602":56227,"_5":14833,"_28348":1721,"_3053":56228},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3585":1723,"_31232":1721,"_5":31587,"_21602":56230,"_28348":56231,"_3053":55705},[],"/docs/pr-preview/pr-61/platform/overview#start-here",{"_3585":1724,"_31232":1721,"_5":31587,"_21602":56233,"_28348":56234,"_3053":56235},[],"/docs/pr-preview/pr-61/platform/overview#choose-your-path","Choose your path",{"_3585":1725,"_31232":1721,"_5":31587,"_21602":56237,"_28348":56238,"_3053":56239},[],"/docs/pr-preview/pr-61/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3585":1726,"_31232":1721,"_5":31587,"_21602":56241,"_28348":56242,"_3053":56243},[],"/docs/pr-preview/pr-61/platform/overview#core-capabilities","Core capabilities",{"_3585":1727,"_31232":1721,"_5":31587,"_21602":56245,"_28348":56246,"_3053":56247},[],"/docs/pr-preview/pr-61/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3585":1728,"_31232":1721,"_5":31587,"_21602":56249,"_28348":56250,"_3053":56251},[],"/docs/pr-preview/pr-61/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3585":1729,"_31232":1721,"_5":31587,"_21602":56253,"_28348":56254,"_3053":56255},[],"/docs/pr-preview/pr-61/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3585":1730,"_31232":1721,"_5":31587,"_21602":56257,"_28348":56258,"_3053":56259},[],"/docs/pr-preview/pr-61/platform/overview#automate-device-identities","Automate device identities",{"_3585":1731,"_31232":1721,"_5":31587,"_21602":56261,"_28348":56262,"_3053":56263},[],"/docs/pr-preview/pr-61/platform/overview#publish-validation-status","Publish validation status",{"_3585":1732,"_31232":1721,"_5":31587,"_21602":56265,"_28348":56266,"_3053":56267},[],"/docs/pr-preview/pr-61/platform/overview#react-to-events","React to events",{"_3585":1733,"_31232":1721,"_5":31587,"_21602":56269,"_28348":56270,"_3053":56271},[],"/docs/pr-preview/pr-61/platform/overview#operational-reference","Operational reference",{"_3585":1734,"_31232":1721,"_21602":56273,"_5":14833,"_28348":1721,"_3053":56274},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3585":1735,"_31232":1721,"_21602":56276,"_5":14833,"_28348":56231,"_3053":56277},[],"Choose the result you need:",{"_3585":1736,"_31232":1721,"_21602":56279,"_5":14833,"_28348":56231,"_3053":56280},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3585":1737,"_31232":1721,"_21602":56282,"_5":14833,"_28348":56231,"_3053":56283},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3585":1738,"_31232":1721,"_21602":56285,"_5":14833,"_28348":56231,"_3053":56286},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3585":1739,"_31232":1721,"_21602":56288,"_5":14833,"_28348":56234,"_3053":56289},[],"Section",{"_3585":1740,"_31232":1721,"_21602":56291,"_5":14833,"_28348":56234,"_3053":56292},[],"What you manage",{"_3585":1741,"_31232":1721,"_21602":56294,"_5":14833,"_28348":56234,"_3053":56295},[],"Entry point",{"_3585":1742,"_31232":1721,"_21602":56297,"_5":14833,"_28348":56234,"_3053":56298},[],"**PKI**",{"_3585":1743,"_31232":1721,"_21602":56300,"_5":14833,"_28348":56234,"_3053":56301},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3585":1744,"_31232":1721,"_21602":56303,"_5":14833,"_28348":56234,"_3053":56304},[],"PKI overview",{"_3585":1745,"_31232":1721,"_21602":56306,"_5":14833,"_28348":56234,"_3053":56307},[],"**IoT Fleets**",{"_3585":1746,"_31232":1721,"_21602":56309,"_5":14833,"_28348":56234,"_3053":56310},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3585":1747,"_31232":1721,"_21602":56312,"_5":14833,"_28348":56234,"_3053":56313},[],"IoT Fleets overview",{"_3585":1748,"_31232":1721,"_21602":56315,"_5":14833,"_28348":56234,"_3053":56316},[],"**Administration**",{"_3585":1749,"_31232":1721,"_21602":56318,"_5":14833,"_28348":56234,"_3053":56319},[],"Operator permissions, audit and event subscriptions.",{"_3585":1750,"_31232":1721,"_21602":56321,"_5":14833,"_28348":56234,"_3053":52383},[],{"_3585":1751,"_31232":1721,"_21602":56323,"_5":14833,"_28348":56234,"_3053":56324},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3585":1752,"_31232":1721,"_21602":56326,"_5":14833,"_28348":56238,"_3053":56327},[],"An identity's journey connects four responsibilities:",{"_3585":1753,"_31232":1721,"_21602":56329,"_5":14833,"_28348":56238,"_3053":56330},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3585":1754,"_31232":1721,"_21602":56332,"_5":14833,"_28348":56238,"_3053":56333},[],"The provisioning administrator configures the DMS and initial trust.",{"_3585":1755,"_31232":1721,"_21602":56335,"_5":14833,"_28348":56238,"_3053":56336},[],"The device client requests a certificate and installs it with the matching key.",{"_3585":1756,"_31232":1721,"_21602":56338,"_5":14833,"_28348":56238,"_3053":56339},[],"The consumer validates the identity and applies its access permissions.",{"_3585":1757,"_31232":1721,"_21602":56341,"_5":14833,"_28348":56238,"_3053":56342},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3585":1758,"_31232":1721,"_21602":56344,"_5":14833,"_28348":56246,"_3053":56345},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3585":1759,"_31232":1721,"_21602":56347,"_5":14833,"_28348":56250,"_3053":56348},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3585":1760,"_31232":1721,"_21602":56350,"_5":14833,"_28348":56254,"_3053":56351},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3585":1761,"_31232":1721,"_21602":56353,"_5":14833,"_28348":56258,"_3053":56354},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3585":1762,"_31232":1721,"_21602":56356,"_5":14833,"_28348":56262,"_3053":56357},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3585":1763,"_31232":1721,"_21602":56359,"_5":14833,"_28348":56266,"_3053":56360},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3585":1764,"_31232":1721,"_21602":56362,"_5":14833,"_28348":56270,"_3053":55799},[],{"_3585":1765,"_31232":1721,"_21602":56364,"_5":14833,"_28348":56270,"_3053":56365},[],"What it prepares or checks",{"_3585":1766,"_31232":1721,"_21602":56367,"_5":14833,"_28348":56270,"_3053":55802},[],{"_3585":1767,"_31232":1721,"_21602":56369,"_5":14833,"_28348":56270,"_3053":56370},[],"Key custody, CA hierarchy, profiles and validation.",{"_3585":1768,"_31232":1721,"_21602":56372,"_5":14833,"_28348":56270,"_3053":56373},[],"Fleet administrator",{"_3585":1769,"_31232":1721,"_21602":56375,"_5":14833,"_28348":56270,"_3053":56376},[],"DMS, device admission, renewal policy and inventory.",{"_3585":1770,"_31232":1721,"_21602":56378,"_5":14833,"_28348":56270,"_3053":55814},[],{"_3585":1771,"_31232":1721,"_21602":56380,"_5":14833,"_28348":56270,"_3053":56381},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3585":1772,"_31232":1721,"_21602":56383,"_5":14833,"_28348":56270,"_3053":55820},[],{"_3585":1773,"_31232":1721,"_21602":56385,"_5":14833,"_28348":56270,"_3053":56386},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3585":1774,"_31232":1721,"_21602":56388,"_5":14833,"_28348":56270,"_3053":56389},[],"Infrastructure operator",{"_3585":1775,"_31232":1721,"_21602":56391,"_5":14833,"_28348":56270,"_3053":56392},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3585":1776,"_31232":1721,"_21602":56394,"_5":14833,"_28348":56270,"_3053":56395},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3585":1777,"_31232":1777,"_5":15204,"_3053":56397,"_31590":56398,"_21602":56401,"_28348":1777},"CA hierarchy and rotation",[50910,52385,56399,56400],"PKI","Keys, authorities and certificates",[],{"_3585":1778,"_31232":1777,"_21602":56403,"_5":14833,"_28348":1777,"_3053":56404},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3585":1779,"_31232":1777,"_5":31587,"_21602":56406,"_28348":56407,"_3053":56408},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3585":1780,"_31232":1777,"_5":31587,"_21602":56410,"_28348":56411,"_3053":56412},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3585":1781,"_31232":1777,"_5":31587,"_21602":56414,"_28348":56415,"_3053":56416},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3585":1782,"_31232":1777,"_5":31587,"_21602":56418,"_28348":56419,"_3053":56420},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3585":1783,"_31232":1777,"_5":31587,"_21602":56422,"_28348":56423,"_3053":56424},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3585":1784,"_31232":1777,"_5":31587,"_21602":56426,"_28348":56427,"_3053":56428},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3585":1785,"_31232":1777,"_5":31587,"_21602":56430,"_28348":56431,"_3053":56432},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3585":1786,"_31232":1777,"_5":31587,"_21602":56434,"_28348":56435,"_3053":56436},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3585":1787,"_31232":1777,"_5":31587,"_21602":56438,"_28348":56439,"_3053":56440},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3585":1788,"_31232":1777,"_5":31587,"_21602":56442,"_28348":56443,"_3053":56444},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3585":1789,"_31232":1777,"_5":31587,"_21602":56446,"_28348":56447,"_3053":56448},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3585":1790,"_31232":1777,"_5":31587,"_21602":56450,"_28348":56451,"_3053":56452},[],"/docs/pr-preview/pr-61/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3585":1791,"_31232":1777,"_21602":56454,"_5":14833,"_28348":1777,"_3053":56455},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3585":1792,"_31232":1777,"_21602":56457,"_5":14833,"_28348":1777,"_3053":56458},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3585":1793,"_31232":1777,"_21602":56460,"_5":14833,"_28348":56407,"_3053":56461},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3585":1794,"_31232":1777,"_21602":56463,"_5":14833,"_28348":56407,"_3053":56464},[],"environment, such as production and preproduction;",{"_3585":1795,"_31232":1777,"_21602":56466,"_5":14833,"_28348":56407,"_3053":56467},[],"owner or operating team;",{"_3585":1796,"_31232":1777,"_21602":56469,"_5":14833,"_28348":56407,"_3053":56470},[],"device family or manufacturing process;",{"_3585":1797,"_31232":1777,"_21602":56472,"_5":14833,"_28348":56407,"_3053":56473},[],"region or regulatory requirement;",{"_3585":1798,"_31232":1777,"_21602":56475,"_5":14833,"_28348":56407,"_3053":56476},[],"cryptographic engine or key policy;",{"_3585":1799,"_31232":1777,"_21602":56478,"_5":14833,"_28348":56407,"_3053":56479},[],"maintenance window and renewal cadence.",{"_3585":1800,"_31232":1777,"_21602":56481,"_5":14833,"_28348":56407,"_3053":56482},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3585":1801,"_31232":1777,"_21602":56484,"_5":14833,"_28348":56407,"_3053":56485},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3585":1802,"_31232":1777,"_21602":56487,"_5":14833,"_28348":56411,"_3053":56488},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3585":1803,"_31232":1777,"_21602":56490,"_5":14833,"_28348":56411,"_3053":56491},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3585":1804,"_31232":1777,"_21602":56493,"_5":14833,"_28348":56411,"_3053":56494},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3585":1805,"_31232":1777,"_21602":56496,"_5":14833,"_28348":56411,"_3053":56497},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3585":1806,"_31232":1777,"_21602":56499,"_5":14833,"_28348":56415,"_3053":56500},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3585":1807,"_31232":1777,"_21602":56502,"_5":14833,"_28348":56415,"_3053":56503},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3585":1808,"_31232":1777,"_21602":56505,"_5":14833,"_28348":56415,"_3053":56506},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3585":1809,"_31232":1777,"_21602":56508,"_5":14833,"_28348":56415,"_3053":56509},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3585":1810,"_31232":1777,"_21602":56511,"_5":14833,"_28348":56423,"_3053":56512},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3585":1811,"_31232":1777,"_21602":56514,"_5":14833,"_28348":56427,"_3053":56515},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3585":1812,"_31232":1777,"_21602":56517,"_5":14833,"_28348":56431,"_3053":56518},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3585":1813,"_31232":1777,"_21602":56520,"_5":14833,"_28348":56435,"_3053":56521},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3585":1814,"_31232":1777,"_21602":56523,"_5":14833,"_28348":56439,"_3053":56524},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3585":1815,"_31232":1777,"_21602":56526,"_5":14833,"_28348":56443,"_3053":56527},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3585":1816,"_31232":1777,"_21602":56529,"_5":14833,"_28348":56447,"_3053":56530},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3585":1817,"_31232":1777,"_21602":56532,"_5":14833,"_28348":56447,"_3053":56533},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3585":1818,"_31232":1777,"_21602":56535,"_5":14833,"_28348":56447,"_3053":56536},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3585":1819,"_31232":1777,"_21602":56538,"_5":14833,"_28348":56447,"_3053":56539},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3585":1820,"_31232":1777,"_21602":56541,"_5":14833,"_28348":56451,"_3053":56542},[],"The new chain ends in an anchor installed by the consumer.",{"_3585":1821,"_31232":1777,"_21602":56544,"_5":14833,"_28348":56451,"_3053":56545},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3585":1822,"_31232":1777,"_21602":56547,"_5":14833,"_28348":56451,"_3053":56548},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3585":1823,"_31232":1777,"_21602":56550,"_5":14833,"_28348":56451,"_3053":56551},[],"Re-enrollment accepts the old identity during the planned period.",{"_3585":1824,"_31232":1777,"_21602":56553,"_5":14833,"_28348":56451,"_3053":56554},[],"OCSP and CRL respond for the authorities that remain active.",{"_3585":1825,"_31232":1777,"_21602":56556,"_5":14833,"_28348":56451,"_3053":56557},[],"No DMS is left accidentally issuing from the old CA.",{"_3585":1826,"_31232":1777,"_21602":56559,"_5":14833,"_28348":56451,"_3053":56560},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3585":1827,"_31232":1827,"_5":15204,"_3053":56562,"_31590":56563,"_21602":56564,"_28348":1827},"Certification authorities",[50910,52385,56399,56400],[],{"_3585":1828,"_31232":1827,"_21602":56566,"_5":14833,"_28348":1827,"_3053":56567},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3585":1829,"_31232":1827,"_5":31587,"_21602":56569,"_28348":56570,"_3053":56571},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3585":1830,"_31232":1827,"_5":31587,"_21602":56573,"_28348":56574,"_3053":56575},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3585":1831,"_31232":1827,"_5":31587,"_21602":56577,"_28348":56578,"_3053":50920},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#before-you-begin",{"_3585":1832,"_31232":1827,"_5":31587,"_21602":56580,"_28348":56581,"_3053":56582},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3585":1833,"_31232":1827,"_5":31587,"_21602":56584,"_28348":56585,"_3053":56586},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3585":1834,"_31232":1827,"_5":31587,"_21602":56588,"_28348":56589,"_3053":56590},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3585":1835,"_31232":1827,"_5":31587,"_21602":56592,"_28348":56593,"_3053":56594},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3585":1836,"_31232":1827,"_5":31587,"_21602":56596,"_28348":56597,"_3053":56598},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3585":1837,"_31232":1827,"_5":31587,"_21602":56600,"_28348":56601,"_3053":56602},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3585":1838,"_31232":1827,"_5":31587,"_21602":56604,"_28348":56605,"_3053":56606},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3585":1839,"_31232":1827,"_5":31587,"_21602":56608,"_28348":56609,"_3053":56610},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3585":1840,"_31232":1827,"_5":31587,"_21602":56612,"_28348":56613,"_3053":56614},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3585":1841,"_31232":1827,"_5":31587,"_21602":56616,"_28348":56617,"_3053":56618},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3585":1842,"_31232":1827,"_5":31587,"_21602":56620,"_28348":56621,"_3053":56622},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3585":1843,"_31232":1827,"_5":31587,"_21602":56624,"_28348":56625,"_3053":56626},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3585":1844,"_31232":1827,"_5":31587,"_21602":56628,"_28348":56629,"_3053":56630},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3585":1845,"_31232":1827,"_5":31587,"_21602":56632,"_28348":56633,"_3053":56634},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3585":1846,"_31232":1827,"_5":31587,"_21602":56636,"_28348":56637,"_3053":56638},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3585":1847,"_31232":1827,"_5":31587,"_21602":56640,"_28348":56641,"_3053":56642},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3585":1848,"_31232":1827,"_5":31587,"_21602":56644,"_28348":56645,"_3053":56646},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3585":1849,"_31232":1827,"_5":31587,"_21602":56648,"_28348":56649,"_3053":56650},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3585":1850,"_31232":1827,"_5":31587,"_21602":56652,"_28348":56653,"_3053":56654},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3585":1851,"_31232":1827,"_5":31587,"_21602":56656,"_28348":56657,"_3053":56658},[],"/docs/pr-preview/pr-61/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3585":1852,"_31232":1827,"_21602":56660,"_5":14833,"_28348":1827,"_3053":56661},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3585":1853,"_31232":1827,"_21602":56663,"_5":14833,"_28348":1827,"_3053":56664},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3585":1854,"_31232":1827,"_21602":56666,"_5":14833,"_28348":1827,"_3053":56667},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3585":1855,"_31232":1827,"_21602":56669,"_5":14833,"_28348":56570,"_3053":56670},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3585":1856,"_31232":1827,"_21602":56672,"_5":14833,"_28348":56570,"_3053":56673},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3585":1857,"_31232":1827,"_21602":56675,"_5":14833,"_28348":56570,"_3053":56676},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3585":1858,"_31232":1827,"_21602":56678,"_5":14833,"_28348":56570,"_3053":56679},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3585":1859,"_31232":1827,"_21602":56681,"_5":14833,"_28348":56570,"_3053":56682},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3585":1860,"_31232":1827,"_21602":56684,"_5":14833,"_28348":56578,"_3053":56685},[],"Decide whether the CA will be a root or an intermediate.",{"_3585":1861,"_31232":1827,"_21602":56687,"_5":14833,"_28348":56578,"_3053":56688},[],"Choose the engine that will keep the key.",{"_3585":1862,"_31232":1827,"_21602":56690,"_5":14833,"_28348":56578,"_3053":56691},[],"Define a validity longer than that of the certificates it will issue.",{"_3585":1863,"_31232":1827,"_21602":56693,"_5":14833,"_28348":56578,"_3053":56694},[],"For an intermediate CA, make sure the parent CA is active.",{"_3585":1864,"_31232":1827,"_21602":56696,"_5":14833,"_28348":56581,"_3053":56697},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3585":1865,"_31232":1827,"_21602":56699,"_5":14833,"_28348":56585,"_3053":56700},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3585":1866,"_31232":1827,"_21602":56702,"_5":14833,"_28348":56585,"_3053":56703},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3585":1867,"_31232":1827,"_21602":56705,"_5":14833,"_28348":56589,"_3053":56706},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3585":1868,"_31232":1827,"_21602":56708,"_5":14833,"_28348":56593,"_3053":56709},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3585":1869,"_31232":1827,"_21602":56711,"_5":14833,"_28348":56593,"_3053":56712},[],"`C`: two-letter ISO 3166-1 country code.",{"_3585":1870,"_31232":1827,"_21602":56714,"_5":14833,"_28348":56593,"_3053":56715},[],"`ST`: state or province.",{"_3585":1871,"_31232":1827,"_21602":56717,"_5":14833,"_28348":56593,"_3053":56718},[],"`L`: locality.",{"_3585":1872,"_31232":1827,"_21602":56720,"_5":14833,"_28348":56593,"_3053":56721},[],"`O`: organization.",{"_3585":1873,"_31232":1827,"_21602":56723,"_5":14833,"_28348":56593,"_3053":56724},[],"`OU`: organizational unit.",{"_3585":1874,"_31232":1827,"_21602":56726,"_5":14833,"_28348":56593,"_3053":56727},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3585":1875,"_31232":1827,"_21602":56729,"_5":14833,"_28348":56597,"_3053":56730},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3585":1876,"_31232":1827,"_21602":56732,"_5":14833,"_28348":56597,"_3053":56733},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3585":1877,"_31232":1827,"_21602":56735,"_5":14833,"_28348":56601,"_3053":56736},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3585":1878,"_31232":1827,"_21602":56738,"_5":14833,"_28348":56601,"_3053":56739},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3585":1879,"_31232":1827,"_21602":56741,"_5":14833,"_28348":56605,"_3053":56742},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3585":1880,"_31232":1827,"_21602":56744,"_5":14833,"_28348":56605,"_3053":56745},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3585":1881,"_31232":1827,"_21602":56747,"_5":14833,"_28348":56609,"_3053":56748},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3585":1882,"_31232":1827,"_21602":56750,"_5":14833,"_28348":56609,"_3053":56751},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3585":1883,"_31232":1827,"_21602":56753,"_5":14833,"_28348":56609,"_3053":56754},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3585":1884,"_31232":1827,"_21602":56756,"_5":14833,"_28348":56613,"_3053":56757},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3585":1885,"_31232":1827,"_21602":56759,"_5":14833,"_28348":56617,"_3053":56760},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3585":1886,"_31232":1827,"_21602":56762,"_5":14833,"_28348":56617,"_3053":56763},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3585":1887,"_31232":1827,"_21602":56765,"_5":14833,"_28348":56621,"_3053":56766},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3585":1888,"_31232":1827,"_21602":56768,"_5":14833,"_28348":56625,"_3053":56769},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3585":1889,"_31232":1827,"_21602":56771,"_5":14833,"_28348":56625,"_3053":56772},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3585":1890,"_31232":1827,"_21602":56774,"_5":14833,"_28348":56629,"_3053":56775},[],"Open a CA from the inventory to review:",{"_3585":1891,"_31232":1827,"_21602":56777,"_5":14833,"_28348":56629,"_3053":56778},[],"Status and validity period.",{"_3585":1892,"_31232":1827,"_21602":56780,"_5":14833,"_28348":56629,"_3053":56781},[],"Certificate and chain in PEM format.",{"_3585":1893,"_31232":1827,"_21602":56783,"_5":14833,"_28348":56629,"_3053":56784},[],"Number of active, expired and revoked certificates.",{"_3585":1894,"_31232":1827,"_21602":56786,"_5":14833,"_28348":56629,"_3053":56787},[],"Certificates issued in **Issued Certificates**.",{"_3585":1895,"_31232":1827,"_21602":56789,"_5":14833,"_28348":56629,"_3053":56790},[],"The CRL linked to the authority.",{"_3585":1896,"_31232":1827,"_21602":56792,"_5":14833,"_28348":56629,"_3053":56793},[],"Metadata and the associated cryptographic engine.",{"_3585":1897,"_31232":1827,"_21602":56795,"_5":14833,"_28348":56629,"_3053":56796},[],"You can filter the inventory by name, status and CA type.",{"_3585":1898,"_31232":1827,"_21602":56798,"_5":14833,"_28348":56633,"_3053":56799},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3585":1899,"_31232":1827,"_21602":56801,"_5":14833,"_28348":56633,"_3053":56802},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3585":1900,"_31232":1827,"_21602":56804,"_5":14833,"_28348":56633,"_3053":56805},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3585":1901,"_31232":1827,"_21602":56807,"_5":14833,"_28348":56633,"_3053":56808},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3585":1902,"_31232":1827,"_21602":56810,"_5":14833,"_28348":56637,"_3053":56811},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3585":1903,"_31232":1827,"_21602":56813,"_5":14833,"_28348":56641,"_3053":56814},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3585":1904,"_31232":1827,"_21602":56816,"_5":14833,"_28348":56645,"_3053":56817},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3585":1905,"_31232":1827,"_21602":56819,"_5":14833,"_28348":56649,"_3053":56820},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3585":1906,"_31232":1827,"_21602":56822,"_5":14833,"_28348":56653,"_3053":56823},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3585":1907,"_31232":1827,"_21602":56825,"_5":14833,"_28348":56657,"_3053":56826},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3585":1908,"_31232":1827,"_21602":56828,"_5":14833,"_28348":56657,"_3053":56829},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3585":1909,"_31232":1827,"_21602":56831,"_5":14833,"_28348":56657,"_3053":56832},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3585":1910,"_31232":1910,"_5":15204,"_3053":56834,"_31590":56835,"_21602":56836,"_28348":1910},"Certificate profiles",[50910,52385,56399,56400],[],{"_3585":1911,"_31232":1910,"_21602":56838,"_5":14833,"_28348":1910,"_3053":56839},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3585":1912,"_31232":1910,"_5":31587,"_21602":56841,"_28348":56842,"_3053":56843},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3585":1913,"_31232":1910,"_5":31587,"_21602":56845,"_28348":56846,"_3053":56847},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#validity","Validity",{"_3585":1914,"_31232":1910,"_5":31587,"_21602":56849,"_28348":56850,"_3053":56851},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3585":1915,"_31232":1910,"_5":31587,"_21602":56853,"_28348":56854,"_3053":56855},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3585":1916,"_31232":1910,"_5":31587,"_21602":56857,"_28348":56858,"_3053":56859},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#subject","Subject",{"_3585":1917,"_31232":1910,"_5":31587,"_21602":56861,"_28348":56862,"_3053":56863},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3585":1918,"_31232":1910,"_5":31587,"_21602":56865,"_28348":56866,"_3053":56867},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3585":1919,"_31232":1910,"_5":31587,"_21602":56869,"_28348":56870,"_3053":56871},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3585":1920,"_31232":1910,"_5":31587,"_21602":56873,"_28348":56874,"_3053":56875},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3585":1921,"_31232":1910,"_5":31587,"_21602":56877,"_28348":56878,"_3053":56879},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3585":1922,"_31232":1910,"_5":31587,"_21602":56881,"_28348":56882,"_3053":56883},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3585":1923,"_31232":1910,"_5":31587,"_21602":56885,"_28348":56886,"_3053":56887},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3585":1924,"_31232":1910,"_5":31587,"_21602":56889,"_28348":56890,"_3053":56891},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3585":1925,"_31232":1910,"_5":31587,"_21602":56893,"_28348":56894,"_3053":56895},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3585":1926,"_31232":1910,"_5":31587,"_21602":56897,"_28348":56898,"_3053":56899},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#design-examples","Design examples",{"_3585":1927,"_31232":1910,"_5":31587,"_21602":56901,"_28348":56902,"_3053":56903},[],"/docs/pr-preview/pr-61/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3585":1928,"_31232":1910,"_21602":56905,"_5":14833,"_28348":1910,"_3053":56906},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3585":1929,"_31232":1910,"_21602":56908,"_5":14833,"_28348":1910,"_3053":56909},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3585":1930,"_31232":1910,"_21602":56911,"_5":14833,"_28348":56846,"_3053":56912},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3585":1931,"_31232":1910,"_21602":56914,"_5":14833,"_28348":56846,"_3053":56915},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3585":1932,"_31232":1910,"_21602":56917,"_5":14833,"_28348":56850,"_3053":56918},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3585":1933,"_31232":1910,"_21602":56920,"_5":14833,"_28348":56854,"_3053":56921},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3585":1934,"_31232":1910,"_21602":56923,"_5":14833,"_28348":56854,"_3053":56924},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3585":1935,"_31232":1910,"_21602":56926,"_5":14833,"_28348":56854,"_3053":56927},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3585":1936,"_31232":1910,"_21602":56929,"_5":14833,"_28348":56858,"_3053":56930},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3585":1937,"_31232":1910,"_21602":56932,"_5":14833,"_28348":56862,"_3053":56933},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3585":1938,"_31232":1910,"_21602":56935,"_5":14833,"_28348":56862,"_3053":56936},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3585":1939,"_31232":1910,"_21602":56938,"_5":14833,"_28348":56866,"_3053":56939},[],"The cryptographic enforcement can:",{"_3585":1940,"_31232":1910,"_21602":56941,"_5":14833,"_28348":56866,"_3053":56942},[],"allow or block RSA keys;",{"_3585":1941,"_31232":1910,"_21602":56944,"_5":14833,"_28348":56866,"_3053":56945},[],"limit the supported RSA sizes;",{"_3585":1942,"_31232":1910,"_21602":56947,"_5":14833,"_28348":56866,"_3053":56948},[],"allow or block ECDSA keys;",{"_3585":1943,"_31232":1910,"_21602":56950,"_5":14833,"_28348":56866,"_3053":56951},[],"limit the supported ECDSA sizes or curves.",{"_3585":1944,"_31232":1910,"_21602":56953,"_5":14833,"_28348":56866,"_3053":56954},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3585":1945,"_31232":1910,"_21602":56956,"_5":14833,"_28348":56870,"_3053":56957},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3585":1946,"_31232":1910,"_21602":56959,"_5":14833,"_28348":56870,"_3053":54155},[],{"_3585":1947,"_31232":1910,"_21602":56961,"_5":14833,"_28348":56870,"_3053":56962},[],"First choice",{"_3585":1948,"_31232":1910,"_21602":56964,"_5":14833,"_28348":56870,"_3053":56965},[],"Second choice",{"_3585":1949,"_31232":1910,"_21602":56967,"_5":14833,"_28348":56870,"_3053":56968},[],"If neither is supplied",{"_3585":1950,"_31232":1910,"_21602":56970,"_5":14833,"_28348":56870,"_3053":56971},[],"Direct signing with a CA",{"_3585":1951,"_31232":1910,"_21602":56973,"_5":14833,"_28348":56870,"_3053":56974},[],"`issuance_profile` embedded in the request",{"_3585":1952,"_31232":1910,"_21602":56976,"_5":14833,"_28348":56870,"_3053":56977},[],"Request `issuance_profile_id`",{"_3585":1953,"_31232":1910,"_21602":56979,"_5":14833,"_28348":56870,"_3053":56980},[],"CA default profile (`profile_id`).",{"_3585":1954,"_31232":1910,"_21602":56982,"_5":14833,"_28348":56870,"_3053":56983},[],"Issuance through a DMS",{"_3585":1955,"_31232":1910,"_21602":56985,"_5":14833,"_28348":56870,"_3053":56986},[],"`settings.issuance_profile_id`",{"_3585":1956,"_31232":1910,"_21602":56988,"_5":14833,"_28348":56870,"_3053":56989},[],"`settings.issuance_profile` embedded in the DMS",{"_3585":1957,"_31232":1910,"_21602":56991,"_5":14833,"_28348":56870,"_3053":56992},[],"Enrollment CA default profile.",{"_3585":1958,"_31232":1910,"_21602":56994,"_5":14833,"_28348":56870,"_3053":56995},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3585":1959,"_31232":1910,"_21602":56997,"_5":14833,"_28348":56870,"_3053":56998},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3585":1960,"_31232":1910,"_21602":57000,"_5":14833,"_28348":56878,"_3053":57001},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3585":1961,"_31232":1910,"_21602":57003,"_5":14833,"_28348":56882,"_3053":57004},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3585":1962,"_31232":1910,"_21602":57006,"_5":14833,"_28348":56886,"_3053":57007},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3585":1963,"_31232":1910,"_21602":57009,"_5":14833,"_28348":56890,"_3053":57010},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3585":1964,"_31232":1910,"_21602":57012,"_5":14833,"_28348":56894,"_3053":57013},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3585":1965,"_31232":1910,"_21602":57015,"_5":14833,"_28348":56894,"_3053":57016},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3585":1966,"_31232":1910,"_21602":57018,"_5":14833,"_28348":56898,"_3053":57019},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3585":1967,"_31232":1910,"_21602":57021,"_5":14833,"_28348":56898,"_3053":57022},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3585":1968,"_31232":1910,"_21602":57024,"_5":14833,"_28348":56898,"_3053":57025},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3585":1969,"_31232":1910,"_21602":57027,"_5":14833,"_28348":56898,"_3053":57028},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3585":1970,"_31232":1910,"_21602":57030,"_5":14833,"_28348":56902,"_3053":57031},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3585":1971,"_31232":1910,"_21602":57033,"_5":14833,"_28348":56902,"_3053":57034},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3585":1972,"_31232":1972,"_5":15204,"_3053":57036,"_31590":57037,"_21602":57039,"_28348":1972},"Certificate validation",[50910,52385,56399,57038],"Validation",[],{"_3585":1973,"_31232":1972,"_21602":57041,"_5":14833,"_28348":1972,"_3053":57042},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3585":1974,"_31232":1972,"_5":31587,"_21602":57044,"_28348":57045,"_3053":57046},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3585":1975,"_31232":1972,"_5":31587,"_21602":57048,"_28348":57049,"_3053":57050},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3585":1976,"_31232":1972,"_5":31587,"_21602":57052,"_28348":57053,"_3053":57054},[],"/docs/pr-preview/pr-61/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3585":1977,"_31232":1972,"_21602":57056,"_5":14833,"_28348":1972,"_3053":57057},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3585":1978,"_31232":1972,"_21602":57059,"_5":14833,"_28348":57045,"_3053":57060},[],"Verify these criteria together:",{"_3585":1979,"_31232":1972,"_21602":57062,"_5":14833,"_28348":57045,"_3053":56025},[],{"_3585":1980,"_31232":1972,"_21602":57064,"_5":14833,"_28348":57045,"_3053":57065},[],"Required result",{"_3585":1981,"_31232":1972,"_21602":57067,"_5":14833,"_28348":57045,"_3053":57068},[],"Chain and signature",{"_3585":1982,"_31232":1972,"_21602":57070,"_5":14833,"_28348":57045,"_3053":57071},[],"Valid chain to a root deliberately installed in the consumer.",{"_3585":1983,"_31232":1972,"_21602":57073,"_5":14833,"_28348":57045,"_3053":57074},[],"Dates",{"_3585":1984,"_31232":1972,"_21602":57076,"_5":14833,"_28348":57045,"_3053":57077},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3585":1985,"_31232":1972,"_21602":57079,"_5":14833,"_28348":57045,"_3053":52054},[],{"_3585":1986,"_31232":1972,"_21602":57081,"_5":14833,"_28348":57045,"_3053":57082},[],"Name, SAN or identifier matches the expected peer.",{"_3585":1987,"_31232":1972,"_21602":57084,"_5":14833,"_28348":57045,"_3053":51300},[],{"_3585":1988,"_31232":1972,"_21602":57086,"_5":14833,"_28348":57045,"_3053":57087},[],"KU, EKU and constraints permit the specific operation.",{"_3585":1989,"_31232":1972,"_21602":57089,"_5":14833,"_28348":57045,"_3053":57090},[],"Revocation",{"_3585":1990,"_31232":1972,"_21602":57092,"_5":14833,"_28348":57045,"_3053":57093},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3585":1991,"_31232":1972,"_21602":57095,"_5":14833,"_28348":57045,"_3053":57096},[],"Authorization",{"_3585":1992,"_31232":1972,"_21602":57098,"_5":14833,"_28348":57045,"_3053":57099},[],"The application permits that identity to perform the action.",{"_3585":1993,"_31232":1972,"_21602":57101,"_5":14833,"_28348":57045,"_3053":57102},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3585":1994,"_31232":1972,"_21602":57104,"_5":14833,"_28348":57049,"_3053":57105},[],"Mechanism",{"_3585":1995,"_31232":1972,"_21602":57107,"_5":14833,"_28348":57049,"_3053":57108},[],"When to use it",{"_3585":1996,"_31232":1972,"_21602":57110,"_5":14833,"_28348":57049,"_3053":57111},[],"What you must maintain",{"_3585":1997,"_31232":1972,"_21602":57113,"_5":14833,"_28348":57049,"_3053":57114},[],"OCSP",{"_3585":1998,"_31232":1972,"_21602":57116,"_5":14833,"_28348":57049,"_3053":57117},[],"Status query for a specific certificate.",{"_3585":1999,"_31232":1972,"_21602":57119,"_5":14833,"_28348":57049,"_3053":57120},[],"Responder access, signature verification and cache/freshness policy.",{"_3585":2000,"_31232":1972,"_21602":57122,"_5":14833,"_28348":57049,"_3053":57123},[],"CRL",{"_3585":2001,"_31232":1972,"_21602":57125,"_5":14833,"_28348":57049,"_3053":57126},[],"Local checks for many certificates or offline operation.",{"_3585":2002,"_31232":1972,"_21602":57128,"_5":14833,"_28348":57049,"_3053":57129},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3585":2003,"_31232":1972,"_21602":57131,"_5":14833,"_28348":57049,"_3053":57132},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3585":2004,"_31232":1972,"_21602":57134,"_5":14833,"_28348":57049,"_3053":57135},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3585":2005,"_31232":1972,"_21602":57137,"_5":14833,"_28348":57053,"_3053":57138},[],"Accept a current, authorized certificate with a known chain.",{"_3585":2006,"_31232":1972,"_21602":57140,"_5":14833,"_28348":57053,"_3053":57141},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3585":2007,"_31232":1972,"_21602":57143,"_5":14833,"_28348":57053,"_3053":57144},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3585":2008,"_31232":1972,"_21602":57146,"_5":14833,"_28348":57053,"_3053":57147},[],"Check that a new connection with that identity is rejected.",{"_3585":2009,"_31232":1972,"_21602":57149,"_5":14833,"_28348":57053,"_3053":57150},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3585":2010,"_31232":1972,"_21602":57152,"_5":14833,"_28348":57053,"_3053":57153},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3585":2011,"_31232":1972,"_21602":57155,"_5":14833,"_28348":57053,"_3053":57156},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3585":2012,"_31232":1972,"_21602":57158,"_5":14833,"_28348":57053,"_3053":57159},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3585":2013,"_31232":1972,"_21602":57161,"_5":14833,"_28348":57053,"_3053":57162},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3585":2014,"_31232":2014,"_5":15204,"_3053":57164,"_31590":57165,"_21602":57166,"_28348":2014},"Certificates",[50910,52385,56399,56400],[],{"_3585":2015,"_31232":2014,"_21602":57168,"_5":14833,"_28348":2014,"_3053":57169},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3585":2016,"_31232":2014,"_5":31587,"_21602":57171,"_28348":57172,"_3053":57173},[],"/docs/pr-preview/pr-61/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3585":2017,"_31232":2014,"_5":31587,"_21602":57175,"_28348":57176,"_3053":57177},[],"/docs/pr-preview/pr-61/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3585":2018,"_31232":2014,"_5":31587,"_21602":57179,"_28348":57180,"_3053":57181},[],"/docs/pr-preview/pr-61/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3585":2019,"_31232":2014,"_5":31587,"_21602":57183,"_28348":57184,"_3053":57185},[],"/docs/pr-preview/pr-61/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3585":2020,"_31232":2014,"_5":31587,"_21602":57187,"_28348":57188,"_3053":57189},[],"/docs/pr-preview/pr-61/platform/pki/certificates#open-the-action","Open the action",{"_3585":2021,"_31232":2014,"_5":31587,"_21602":57191,"_28348":57192,"_3053":57193},[],"/docs/pr-preview/pr-61/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3585":2022,"_31232":2014,"_5":31587,"_21602":57195,"_28348":57196,"_3053":57197},[],"/docs/pr-preview/pr-61/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3585":2023,"_31232":2014,"_5":31587,"_21602":57199,"_28348":57200,"_3053":57201},[],"/docs/pr-preview/pr-61/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3585":2024,"_31232":2014,"_5":31587,"_21602":57203,"_28348":57204,"_3053":57205},[],"/docs/pr-preview/pr-61/platform/pki/certificates#continue","Continue",{"_3585":2025,"_31232":2014,"_21602":57207,"_5":14833,"_28348":2014,"_3053":57208},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3585":2026,"_31232":2014,"_21602":57210,"_5":14833,"_28348":57172,"_3053":57211},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3585":2027,"_31232":2014,"_21602":57213,"_5":14833,"_28348":57172,"_3053":57214},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3585":2028,"_31232":2014,"_21602":57216,"_5":14833,"_28348":57172,"_3053":57217},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3585":2029,"_31232":2014,"_21602":57219,"_5":14833,"_28348":57172,"_3053":57220},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3585":2030,"_31232":2014,"_21602":57222,"_5":14833,"_28348":57172,"_3053":57223},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3585":2031,"_31232":2014,"_21602":57225,"_5":14833,"_28348":57172,"_3053":57226},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3585":2032,"_31232":2014,"_21602":57228,"_5":14833,"_28348":57172,"_3053":57229},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3585":2033,"_31232":2014,"_21602":57231,"_5":14833,"_28348":57176,"_3053":57232},[],"Download the PEM and inspect it:",{"_3585":2034,"_31232":2014,"_21602":57234,"_5":14833,"_28348":57176,"_3053":57235},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3585":2035,"_31232":2014,"_21602":57237,"_5":14833,"_28348":57180,"_3053":57238},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3585":2036,"_31232":2014,"_21602":57240,"_5":14833,"_28348":57180,"_3053":57241},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3585":2037,"_31232":2014,"_21602":57243,"_5":14833,"_28348":57180,"_3053":57244},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3585":2038,"_31232":2014,"_21602":57246,"_5":14833,"_28348":57180,"_3053":57247},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3585":2039,"_31232":2014,"_21602":57249,"_5":14833,"_28348":57180,"_3053":57250},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3585":2040,"_31232":2014,"_21602":57252,"_5":14833,"_28348":57180,"_3053":57253},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3585":2041,"_31232":2014,"_21602":57255,"_5":14833,"_28348":57180,"_3053":57256},[],"For browser key generation, follow Issue your first certificate.",{"_3585":2042,"_31232":2014,"_21602":57258,"_5":14833,"_28348":57184,"_3053":57259},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3585":2043,"_31232":2014,"_21602":57261,"_5":14833,"_28348":57188,"_3053":57262},[],"Locate the correct issuer and serial and select **Revoke Certificate**. A walkthrough is available in Revoke a certificate and check the CRL. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3585":2044,"_31232":2014,"_21602":57264,"_5":14833,"_28348":57192,"_3053":57265},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3585":2045,"_31232":2014,"_21602":57267,"_5":14833,"_28348":57196,"_3053":57268},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3585":2046,"_31232":2014,"_21602":57270,"_5":14833,"_28348":57196,"_3053":57271},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3585":2047,"_31232":2014,"_21602":57273,"_5":14833,"_28348":57196,"_3053":57274},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3585":2048,"_31232":2014,"_21602":57276,"_5":14833,"_28348":57200,"_3053":57277},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3585":2049,"_31232":2014,"_21602":57279,"_5":14833,"_28348":57200,"_3053":57280},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3585":2050,"_31232":2014,"_21602":57282,"_5":14833,"_28348":57200,"_3053":57283},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3585":2051,"_31232":2014,"_21602":57285,"_5":14833,"_28348":57204,"_3053":57286},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3585":2052,"_31232":2014,"_21602":57288,"_5":14833,"_28348":57204,"_3053":57289},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3585":2053,"_31232":2053,"_5":15204,"_3053":57291,"_31590":57292,"_21602":57294,"_28348":2053},"Certificate lifecycle",[50910,52385,56399,57293],"Concepts",[],{"_3585":2054,"_31232":2053,"_21602":57296,"_5":14833,"_28348":2053,"_3053":57297},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3585":2055,"_31232":2053,"_5":31587,"_21602":57299,"_28348":57300,"_3053":57301},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3585":2056,"_31232":2053,"_5":31587,"_21602":57303,"_28348":57304,"_3053":57305},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3585":2057,"_31232":2053,"_5":31587,"_21602":57307,"_28348":57308,"_3053":57309},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3585":2058,"_31232":2053,"_5":31587,"_21602":57311,"_28348":57312,"_3053":57313},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3585":2059,"_31232":2053,"_5":31587,"_21602":57315,"_28348":57316,"_3053":57317},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3585":2060,"_31232":2053,"_5":31587,"_21602":57319,"_28348":57320,"_3053":57321},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3585":2061,"_31232":2053,"_5":31587,"_21602":57323,"_28348":57324,"_3053":57325},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3585":2062,"_31232":2053,"_5":31587,"_21602":57327,"_28348":57328,"_3053":57329},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3585":2063,"_31232":2053,"_5":31587,"_21602":57331,"_28348":57332,"_3053":57333},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3585":2064,"_31232":2053,"_5":31587,"_21602":57335,"_28348":57336,"_3053":57337},[],"/docs/pr-preview/pr-61/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3585":2065,"_31232":2053,"_21602":57339,"_5":14833,"_28348":2053,"_3053":57340},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3585":2066,"_31232":2053,"_21602":57342,"_5":14833,"_28348":57304,"_3053":57343},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3585":2067,"_31232":2053,"_21602":57345,"_5":14833,"_28348":57308,"_3053":57346},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3585":2068,"_31232":2053,"_21602":57348,"_5":14833,"_28348":57312,"_3053":57349},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3585":2069,"_31232":2053,"_21602":57351,"_5":14833,"_28348":57316,"_3053":57352},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3585":2070,"_31232":2053,"_21602":57354,"_5":14833,"_28348":57320,"_3053":57355},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3585":2071,"_31232":2053,"_21602":57357,"_5":14833,"_28348":57324,"_3053":57358},[],"Lamassu persists four X.509 states:",{"_3585":2072,"_31232":2053,"_21602":57360,"_5":14833,"_28348":57324,"_3053":57361},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3585":2073,"_31232":2053,"_21602":57363,"_5":14833,"_28348":57324,"_3053":57364},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3585":2074,"_31232":2053,"_21602":57366,"_5":14833,"_28348":57324,"_3053":57367},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3585":2075,"_31232":2053,"_21602":57369,"_5":14833,"_28348":57324,"_3053":57370},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3585":2076,"_31232":2053,"_21602":57372,"_5":14833,"_28348":57324,"_3053":57373},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3585":2077,"_31232":2053,"_21602":57375,"_5":14833,"_28348":57328,"_3053":57376},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3585":2078,"_31232":2053,"_21602":57378,"_5":14833,"_28348":57328,"_3053":57379},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3585":2079,"_31232":2053,"_21602":57381,"_5":14833,"_28348":57328,"_3053":57382},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3585":2080,"_31232":2053,"_21602":57384,"_5":14833,"_28348":57332,"_3053":57385},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3585":2081,"_31232":2053,"_21602":57387,"_5":14833,"_28348":57332,"_3053":57388},[],"Before confirming:",{"_3585":2082,"_31232":2053,"_21602":57390,"_5":14833,"_28348":57332,"_3053":57391},[],"Identify DMSs, devices and services that trust that chain.",{"_3585":2083,"_31232":2053,"_21602":57393,"_5":14833,"_28348":57332,"_3053":57394},[],"Distribute the new chain of trust.",{"_3585":2084,"_31232":2053,"_21602":57396,"_5":14833,"_28348":57332,"_3053":57397},[],"Reissue the necessary identities.",{"_3585":2085,"_31232":2053,"_21602":57399,"_5":14833,"_28348":57332,"_3053":57400},[],"Check OCSP and CRL from a real consumer.",{"_3585":2086,"_31232":2053,"_21602":57402,"_5":14833,"_28348":57332,"_3053":57403},[],"Revoke the old CA once no legitimate traffic remains.",{"_3585":2087,"_31232":2053,"_21602":57405,"_5":14833,"_28348":57332,"_3053":57406},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3585":2088,"_31232":2053,"_21602":57408,"_5":14833,"_28348":57336,"_3053":57409},[],"Certificates entering the preventive or critical renewal window.",{"_3585":2089,"_31232":2053,"_21602":57411,"_5":14833,"_28348":57336,"_3053":57412},[],"Repeated enrollment or re-enrollment failures.",{"_3585":2090,"_31232":2053,"_21602":57414,"_5":14833,"_28348":57336,"_3053":57415},[],"Status changes and revocation reasons.",{"_3585":2091,"_31232":2053,"_21602":57417,"_5":14833,"_28348":57336,"_3053":57418},[],"OCSP and CRL publication and validity.",{"_3585":2092,"_31232":2053,"_21602":57420,"_5":14833,"_28348":57336,"_3053":57421},[],"Dependencies still presenting a replaced certificate.",{"_3585":2093,"_31232":2053,"_21602":57423,"_5":14833,"_28348":57336,"_3053":57424},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3585":2094,"_31232":2094,"_5":15204,"_3053":57426,"_31590":57427,"_21602":57428,"_28348":2094},"Trust model",[50910,52385,56399,57293],[],{"_3585":2095,"_31232":2094,"_21602":57430,"_5":14833,"_28348":2094,"_3053":57431},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3585":2096,"_31232":2094,"_5":31587,"_21602":57433,"_28348":57434,"_3053":57435},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3585":2097,"_31232":2094,"_5":31587,"_21602":57437,"_28348":57438,"_3053":57439},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3585":2098,"_31232":2094,"_5":31587,"_21602":57441,"_28348":57442,"_3053":57443},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3585":2099,"_31232":2094,"_5":31587,"_21602":57445,"_28348":57446,"_3053":57447},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3585":2100,"_31232":2094,"_5":31587,"_21602":57449,"_28348":57450,"_3053":57451},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3585":2101,"_31232":2094,"_5":31587,"_21602":57453,"_28348":57454,"_3053":57455},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#trust-architectures-and-interoperability","Trust architectures and interoperability",{"_3585":2102,"_31232":2094,"_5":31587,"_21602":57457,"_28348":57458,"_3053":57459},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#single-ca-and-hierarchy","Single CA and hierarchy",{"_3585":2103,"_31232":2094,"_5":31587,"_21602":57461,"_28348":57462,"_3053":57463},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#direct-cross-certification-and-mesh","Direct cross-certification and mesh",{"_3585":2104,"_31232":2094,"_5":31587,"_21602":57465,"_28348":57466,"_3053":57467},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#hybrid-model","Hybrid model",{"_3585":2105,"_31232":2094,"_5":31587,"_21602":57469,"_28348":57470,"_3053":57471},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#unifying-trust-point","Unifying trust point",{"_3585":2106,"_31232":2094,"_5":31587,"_21602":57473,"_28348":57474,"_3053":57475},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#bridge-ca","Bridge CA",{"_3585":2107,"_31232":2094,"_5":31587,"_21602":57477,"_28348":57478,"_3053":57479},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#trust-lists","Trust lists",{"_3585":2108,"_31232":2094,"_5":31587,"_21602":57481,"_28348":57482,"_3053":57483},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#what-lamassu-can-demonstrate","What Lamassu can demonstrate",{"_3585":2109,"_31232":2094,"_5":31587,"_21602":57485,"_28348":57486,"_3053":57487},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3585":2110,"_31232":2094,"_5":31587,"_21602":57489,"_28348":57490,"_3053":57491},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3585":2111,"_31232":2094,"_5":31587,"_21602":57493,"_28348":57494,"_3053":57495},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3585":2112,"_31232":2094,"_5":31587,"_21602":57497,"_28348":57498,"_3053":57499},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3585":2113,"_31232":2094,"_5":31587,"_21602":57501,"_28348":57502,"_3053":57503},[],"/docs/pr-preview/pr-61/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3585":2114,"_31232":2094,"_21602":57505,"_5":14833,"_28348":2094,"_3053":57506},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3585":2115,"_31232":2094,"_21602":57508,"_5":14833,"_28348":57438,"_3053":57509},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3585":2116,"_31232":2094,"_21602":57511,"_5":14833,"_28348":57442,"_3053":57512},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3585":2117,"_31232":2094,"_21602":57514,"_5":14833,"_28348":57446,"_3053":57515},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3585":2118,"_31232":2094,"_21602":57517,"_5":14833,"_28348":57450,"_3053":57518},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3585":2119,"_31232":2094,"_21602":57520,"_5":14833,"_28348":57454,"_3053":57521},[],"RFC 5217 distinguishes a PKI's internal structure from relationships between domains. Below, `A → B` means A signs a CA certificate for B. Validation starts at the relying party's chosen anchor; a signature in one direction does not imply reciprocal trust.",{"_3585":2120,"_31232":2094,"_21602":57523,"_5":14833,"_28348":57454,"_3053":51005},[],{"_3585":2121,"_31232":2094,"_21602":57525,"_5":14833,"_28348":57454,"_3053":57526},[],"Structure",{"_3585":2122,"_31232":2094,"_21602":57528,"_5":14833,"_28348":57454,"_3053":57529},[],"Considerations",{"_3585":2123,"_31232":2094,"_21602":57531,"_5":14833,"_28348":57454,"_3053":57532},[],"Single CA",{"_3585":2124,"_31232":2094,"_21602":57534,"_5":14833,"_28348":57454,"_3053":57535},[],"`CA → identity`.",{"_3585":2125,"_31232":2094,"_21602":57537,"_5":14833,"_28348":57454,"_3053":57538},[],"The root issues identities directly; its compromise affects all of them.",{"_3585":2126,"_31232":2094,"_21602":57540,"_5":14833,"_28348":57454,"_3053":57541},[],"Hierarchical",{"_3585":2127,"_31232":2094,"_21602":57543,"_5":14833,"_28348":57454,"_3053":57544},[],"`Root → intermediate → identity`.",{"_3585":2128,"_31232":2094,"_21602":57546,"_5":14833,"_28348":57454,"_3053":57547},[],"Distribute the root and present intermediates; constrain depth, uses and validity.",{"_3585":2129,"_31232":2094,"_21602":57549,"_5":14833,"_28348":57454,"_3053":57550},[],"Full or partial mesh",{"_3585":2130,"_31232":2094,"_21602":57552,"_5":14833,"_28348":57454,"_3053":57553},[],"Self-signed CAs cross-certify each other; a partial mesh has missing links.",{"_3585":2131,"_31232":2094,"_21602":57555,"_5":14833,"_28348":57454,"_3053":57556},[],"Check each direction and anchor: some domains may be unreachable in a partial mesh.",{"_3585":2132,"_31232":2094,"_21602":57558,"_5":14833,"_28348":57454,"_3053":57559},[],"Hybrid",{"_3585":2133,"_31232":2094,"_21602":57561,"_5":14833,"_28348":57454,"_3053":57562},[],"Combines hierarchies and cross-certification links.",{"_3585":2134,"_31232":2094,"_21602":57564,"_5":14833,"_28348":57454,"_3053":57565},[],"Document alternative paths and constraints; consumers may build or accept different paths.",{"_3585":2135,"_31232":2094,"_21602":57567,"_5":14833,"_28348":57454,"_3053":57471},[],{"_3585":2136,"_31232":2094,"_21602":57569,"_5":14833,"_28348":57454,"_3053":57570},[],"`Unifying CA → PCA-A` and `Unifying CA → PCA-B`.",{"_3585":2137,"_31232":2094,"_21602":57572,"_5":14833,"_28348":57454,"_3053":57573},[],"Cross-domain validation requires trust in the unifying CA and access to cross-certificates. PCAs retain their self-signed certificates.",{"_3585":2138,"_31232":2094,"_21602":57575,"_5":14833,"_28348":57454,"_3053":57576},[],"Direct cross-certification",{"_3585":2139,"_31232":2094,"_21602":57578,"_5":14833,"_28348":57454,"_3053":57579},[],"`PCA-A → PCA-B`; add `PCA-B → PCA-A` for reciprocity.",{"_3585":2140,"_31232":2094,"_21602":57581,"_5":14833,"_28348":57454,"_3053":57582},[],"Each domain keeps its anchor; test both directions and restrict unwanted paths.",{"_3585":2141,"_31232":2094,"_21602":57584,"_5":14833,"_28348":57454,"_3053":57475},[],{"_3585":2142,"_31232":2094,"_21602":57586,"_5":14833,"_28348":57454,"_3053":57587},[],"`PCA-A → Bridge → PCA-B`; add reverse signatures for the opposite path.",{"_3585":2143,"_31232":2094,"_21602":57589,"_5":14833,"_28348":57454,"_3053":57590},[],"The bridge is not a domain anchor and issues end-entity certificates only for its own operation. Agree policies and constraints.",{"_3585":2144,"_31232":2094,"_21602":57592,"_5":14833,"_28348":57454,"_3053":57593},[],"Trust list",{"_3585":2145,"_31232":2094,"_21602":57595,"_5":14833,"_28348":57454,"_3053":57596},[],"The consumer trusts roots A and B, locally or through a trust authority managing the list.",{"_3585":2146,"_31232":2094,"_21602":57598,"_5":14833,"_28348":57454,"_3053":57599},[],"Cross-certification is unnecessary. Distributing certificates does not install trust anchors; control updates and removal.",{"_3585":2147,"_31232":2094,"_21602":57601,"_5":14833,"_28348":57454,"_3053":57602},[],"A PCA is the principal CA designated for relationships between PKIs; an identity is an end-entity certificate. The first four rows describe architectures within a PKI, the next three relationships between domains, and the last a trust model external to those relationships. An ordinary intermediate alone does not demonstrate a unifying CA.",{"_3585":2148,"_31232":2094,"_21602":57604,"_5":14833,"_28348":57454,"_3053":57605},[],"Each diagram below is a short sequence of steps you can play, pause or jump between. A CA is drawn as what it is — a key pair — with one row per certificate issued for that key: a root starts with its self-signed certificate and gains a second row when another CA cross-signs it, same subject and same key under a different issuer. Rows a later step will fill are outlined from the start. Solid arrows indicate certificate issuance; dashed arrows indicate configured trust or distribution, as labeled. The green trace is a validation path: it runs from the identity back to the anchor, opposite to the issuance arrows. An available path is not necessarily accepted by a validator.",{"_3585":2149,"_31232":2094,"_21602":57607,"_5":14833,"_28348":57458,"_3053":57608},[],"A single CA signs identities directly:",{"_3585":2150,"_31232":2094,"_21602":57610,"_5":14833,"_28348":57458,"_3053":57611},[],"A hierarchy separates the root from issuing CAs:",{"_3585":2151,"_31232":2094,"_21602":57613,"_5":14833,"_28348":57458,"_3053":57614},[],"A single-CA PKI uses a self-signed root to issue identities directly. It is easy to understand and useful for an initial test, but concentrates issuance and trust in one key. If that key is compromised, the anchor must be replaced and affected identities renewed.",{"_3585":2152,"_31232":2094,"_21602":57616,"_5":14833,"_28348":57458,"_3053":57617},[],"In a hierarchy, the root signs one or more intermediate CAs that issue identities. This separates, for example, production from testing or devices from services, and allows root usage to be restricted. Each consumer needs to trust the root and have the intermediates available to build the chain. The design must account for permitted depth, uses and expiration at each CA.",{"_3585":2153,"_31232":2094,"_21602":57619,"_5":14833,"_28348":57458,"_3053":57620},[],"In Lamassu, create a root and issue an identity for the first case; for the second, create an intermediate under another root and issue from it. Download the certificates and validate both chains from a consumer, including a test with an incorrect anchor.",{"_3585":2154,"_31232":2094,"_21602":57622,"_5":14833,"_28348":57458,"_3053":57623},[],"The following interactive walkthrough shows both scenarios in the console: the standalone root and the hierarchy, with the public certificates and the downloaded identity certificates.",{"_3585":2155,"_31232":2094,"_21602":57625,"_5":14833,"_28348":57462,"_3053":57626},[],"Bilateral cross-certification: each domain keeps its anchor. Validating B from A uses B’s certificate signed by A; the reverse direction requires the opposite signature.",{"_3585":2156,"_31232":2094,"_21602":57628,"_5":14833,"_28348":57462,"_3053":57629},[],"Example partial mesh: the C → A and C → B signatures are absent; reciprocity must not be assumed.",{"_3585":2157,"_31232":2094,"_21602":57631,"_5":14833,"_28348":57462,"_3053":57632},[],"Cross-certification lets one CA issue a certificate for another CA's public key. A consumer trusting A can then build a path to an identity issued by B using B's certificate signed by A. B's self-signed certificate can remain available for its own consumers. For consumers trusting B to validate identities from A, a signature in the opposite direction and a path accepted by their validator are needed.",{"_3585":2158,"_31232":2094,"_21602":57634,"_5":14833,"_28348":57462,"_3053":57635},[],"A mesh extends this relationship to several CAs: it is full when every CA signs every other CA, and partial when some links are missing. A full mesh offers direct links but increases the number of relationships to manage; a partial mesh reduces links but may leave paths missing or harder to build. A path shown in a graph is not necessarily acceptable to a validator.",{"_3585":2159,"_31232":2094,"_21602":57637,"_5":14833,"_28348":57462,"_3053":57638},[],"To demonstrate this, create roots A, B and C and test certificates. Start with A → B, validate an identity from B using A as the anchor, and check that the opposite direction is not covered until B → A is added. Add links to build a partial mesh and compare available paths. Control the certificates supplied to the validator so alternative paths can be identified.",{"_3585":2160,"_31232":2094,"_21602":57640,"_5":14833,"_28348":57462,"_3053":57641},[],"The following walkthrough shows a partial mesh with A ↔ B, A → C and B → C. The certificates were prepared before recording; the guide describes validations performed outside the console.",{"_3585":2161,"_31232":2094,"_21602":57643,"_5":14833,"_28348":57466,"_3053":57644},[],"Two hierarchies keep their roots and A signs CA B. From anchor A, the chain to identity B includes B’s cross-certificate and intermediate B.",{"_3585":2162,"_31232":2094,"_21602":57646,"_5":14833,"_28348":57466,"_3053":57647},[],"A hybrid PKI combines hierarchies of subordinate CAs with cross-certification. It can arise when two organizations with their own hierarchies need to interoperate without replacing their roots. Each branch retains its structure, but paths between them make certificate distribution, revocation and policy interpretation more complex.",{"_3585":2163,"_31232":2094,"_21602":57649,"_5":14833,"_28348":57466,"_3053":57650},[],"To demonstrate it, create roots A and B, an issuing intermediate under B and an identity issued by it, and add A → B. From anchor A, the consumer needs B's certificate signed by A and B's intermediate to validate the final identity. Also check failure when a link is missing and look for alternative paths.",{"_3585":2164,"_31232":2094,"_21602":57652,"_5":14833,"_28348":57466,"_3053":57653},[],"The following walkthrough starts from those CAs, prepared before recording, and performs the A → B cross-signing with the **Cross Sign** operation. It then compares the authorities table, hierarchy and graph: B appears twice, as a self-signed root and under A, with the same key and a different issuer. Each step's guide describes the validations, which were performed outside the console.",{"_3585":2165,"_31232":2094,"_21602":57655,"_5":14833,"_28348":57466,"_3053":57656},[],"With OpenSSL, using only A as the anchor and B's cross certificate plus the intermediate as auxiliary material, the path `identity → intermediate → B (cross) → A` validates:",{"_3585":2166,"_31232":2094,"_21602":57658,"_5":14833,"_28348":57466,"_3053":57659},[],"Validation fails if the cross certificate is omitted, if the intermediate is missing, or if an unrelated root is used as the anchor. If the validator also trusts B, it may choose the direct path, shorter and not going through A: the cross certificate does not make it unnecessary. The cross certificate has its own expiry (three years in the demo), earlier than root B's and the intermediate's, so the path through A stops validating the intermediate before the direct one does. The demo's certificates contain no certificate policies, name constraints, policy constraints or maximum path length, and this version's **Cross Sign** operation offers no controls for them. The demo therefore does not prove conformance with RFC 5217, only path building with the basic extensions.",{"_3585":2167,"_31232":2094,"_21602":57661,"_5":14833,"_28348":57470,"_3053":57662},[],"Relying parties validating both domains use the unifying CA as their anchor and the PCAs’ cross-certificates.",{"_3585":2168,"_31232":2094,"_21602":57664,"_5":14833,"_28348":57470,"_3053":57665},[],"This model adds a superior CA that unilaterally signs the PCAs of participating domains. Each PCA can keep its self-signed certificate and existing operation; consumers that need cross-domain validation use the unifying CA as their anchor and obtain the required cross-certificates.",{"_3585":2169,"_31232":2094,"_21602":57667,"_5":14833,"_28348":57470,"_3053":57668},[],"The benefit is a common trust point without necessarily rebuilding existing PKIs. In exchange, participants must distribute and govern the new anchor, agree policies and assess the impact of its compromise or replacement. A consumer needing only its own domain can continue to trust its existing PCA.",{"_3585":2170,"_31232":2094,"_21602":57670,"_5":14833,"_28348":57470,"_3053":57671},[],"For the demo, first create two self-signed PCAs, then the links Unifier → PCA-A and Unifier → PCA-B. Issue an identity from each domain and validate both from the unifying anchor; check that the cross-certificates correspond to the same keys as the original PCAs.",{"_3585":2171,"_31232":2094,"_21602":57673,"_5":14833,"_28348":57474,"_3053":57674},[],"Each domain keeps its anchor. Signatures in both directions allow paths A → bridge → B and B → bridge → A.",{"_3585":2172,"_31232":2094,"_21602":57676,"_5":14833,"_28348":57474,"_3053":57677},[],"A bridge CA connects domains that retain their own anchors. To validate an identity from B using A as the anchor, the path can follow A → Bridge → B; the opposite direction requires the corresponding links. The bridge must not become a domain anchor and does not issue end-entity certificates except those required for its own operation.",{"_3585":2173,"_31232":2094,"_21602":57679,"_5":14833,"_28348":57474,"_3053":57680},[],"Centralizing relationships through a bridge can reduce direct agreements, but requires shared governance, documented policies, policy mapping and consistent constraints. It also increases the importance of validators discovering and processing paths and extensions correctly.",{"_3585":2174,"_31232":2094,"_21602":57682,"_5":14833,"_28348":57474,"_3053":57683},[],"For the demo, create two PCAs and a bridge CA, establish the links needed in both directions, and validate an identity from each domain using the other's anchor. Inspect the extensions and document any RFC requirement that the deployed version or validator cannot verify: a connected graph alone does not demonstrate a complete bridge model.",{"_3585":2175,"_31232":2094,"_21602":57685,"_5":14833,"_28348":57478,"_3053":57686},[],"Local list: the relying party configures both roots as anchors, without cross-signatures between them.",{"_3585":2176,"_31232":2094,"_21602":57688,"_5":14833,"_28348":57478,"_3053":57689},[],"Trust authority: an entity maintains a shared list that relying parties use according to their configuration.",{"_3585":2177,"_31232":2094,"_21602":57691,"_5":14833,"_28348":57478,"_3053":57692},[],"A trust list allows a consumer to accept several PKIs by explicitly installing their anchors, without the CAs cross-certifying one another. The list may be managed locally or by a trust authority for multiple consumers. This is a direct approach, although managing additions, removals and updates becomes harder as the number of consumers grows.",{"_3585":2178,"_31232":2094,"_21602":57694,"_5":14833,"_28348":57478,"_3053":57695},[],"For the demo, create two independent roots and an identity under each. Validate both with a list containing both roots, then remove one root and check that the corresponding identity no longer validates. If you distribute certificates through EST `/cacerts`, show the consumer's decision to install them as anchors separately.",{"_3585":2179,"_31232":2094,"_21602":57697,"_5":14833,"_28348":57482,"_3053":57698},[],"You can create roots and intermediates, issue identities and register external CAs as described in Authorities. The dashboard code also includes a cross-signing operation that creates another certificate for the target CA's existing key, signed by the selected CA. Availability depends on the deployed version. In that flow both CAs must be active and have their private keys in the KMS; a certificate-only import is insufficient. Verify the public key and that the cross-certificate subject reproduces the target CA's subject: some imported subjects cannot be reproduced exactly.",{"_3585":2180,"_31232":2094,"_21602":57700,"_5":14833,"_28348":57482,"_3053":57701},[],"The operation can build links for these topologies, but the graph or issuance alone does not prove interoperability or full RFC conformance. Inspect `basicConstraints`, `keyCertSign`, validity, path length, and name and policy constraints. Verify `policyMappings` and `policyConstraints` availability and processing in the deployed version and each validator. Agree policies, assurance levels, publication and revocation across domains.",{"_3585":2181,"_31232":2094,"_21602":57703,"_5":14833,"_28348":57482,"_3053":57704},[],"For each path, download the identity and required CA certificates. Validate from the relying party with its explicit trust anchor and intermediates as auxiliary material; also test the reverse direction and a case that must fail. Repeat with the revocation and policy checks actually enforced by that consumer. See Validation and Trust distribution.",{"_3585":2182,"_31232":2094,"_21602":57706,"_5":14833,"_28348":57486,"_3053":57707},[],"The device proves it can enroll according to the DMS policy.",{"_3585":2183,"_31232":2094,"_21602":57709,"_5":14833,"_28348":57486,"_3053":57710},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3585":2184,"_31232":2094,"_21602":57712,"_5":14833,"_28348":57486,"_3053":57713},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3585":2185,"_31232":2094,"_21602":57715,"_5":14833,"_28348":57486,"_3053":57716},[],"The device installs the certificate and the chain it needs.",{"_3585":2186,"_31232":2094,"_21602":57718,"_5":14833,"_28348":57486,"_3053":57719},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3585":2187,"_31232":2094,"_21602":57721,"_5":14833,"_28348":57486,"_3053":57722},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3585":2188,"_31232":2094,"_21602":57724,"_5":14833,"_28348":57490,"_3053":57725},[],"A DMS relates three sets that are worth designing separately:",{"_3585":2189,"_31232":2094,"_21602":57727,"_5":14833,"_28348":57490,"_3053":57728},[],"**Enrollment CA:** signs the new identities.",{"_3585":2190,"_31232":2094,"_21602":57730,"_5":14833,"_28348":57490,"_3053":57731},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3585":2191,"_31232":2094,"_21602":57733,"_5":14833,"_28348":57490,"_3053":57734},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3585":2192,"_31232":2094,"_21602":57736,"_5":14833,"_28348":57490,"_3053":57737},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3585":2193,"_31232":2094,"_21602":57739,"_5":14833,"_28348":57494,"_3053":57740},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3585":2194,"_31232":2094,"_21602":57742,"_5":14833,"_28348":57494,"_3053":57743},[],"that the current date is between `Not Before` and `Not After`;",{"_3585":2195,"_31232":2094,"_21602":57745,"_5":14833,"_28348":57494,"_3053":57746},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3585":2196,"_31232":2094,"_21602":57748,"_5":14833,"_28348":57494,"_3053":57749},[],"that names, SANs and subject match the expected identity;",{"_3585":2197,"_31232":2094,"_21602":57751,"_5":14833,"_28348":57494,"_3053":57752},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3585":2198,"_31232":2094,"_21602":57754,"_5":14833,"_28348":57494,"_3053":57755},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3585":2199,"_31232":2094,"_21602":57757,"_5":14833,"_28348":57494,"_3053":57758},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3585":2200,"_31232":2094,"_21602":57760,"_5":14833,"_28348":57498,"_3053":57761},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3585":2201,"_31232":2094,"_21602":57763,"_5":14833,"_28348":57502,"_3053":57764},[],"Keep the root out of daily operations, or with very restricted access.",{"_3585":2202,"_31232":2094,"_21602":57766,"_5":14833,"_28348":57502,"_3053":57767},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3585":2203,"_31232":2094,"_21602":57769,"_5":14833,"_28348":57502,"_3053":57770},[],"Assign explicit profiles to every use case.",{"_3585":2204,"_31232":2094,"_21602":57772,"_5":14833,"_28348":57502,"_3053":57773},[],"Distribute the new trust before starting a rotation.",{"_3585":2205,"_31232":2094,"_21602":57775,"_5":14833,"_28348":57502,"_3053":57776},[],"Keep enough overlap to renew a disconnected fleet.",{"_3585":2206,"_31232":2094,"_21602":57778,"_5":14833,"_28348":57502,"_3053":57779},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3585":2207,"_31232":2094,"_21602":57781,"_5":14833,"_28348":57502,"_3053":57782},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3585":2208,"_31232":2208,"_5":15204,"_3053":57784,"_31590":57785,"_21602":57786,"_28348":2208},"Revocation lists (CRL)",[50910,52385,56399,57038],[],{"_3585":2209,"_31232":2208,"_21602":57788,"_5":14833,"_28348":2208,"_3053":57789},[],"Generate and distribute signed lists to validate certificates offline.",{"_3585":2210,"_31232":2208,"_5":31587,"_21602":57791,"_28348":57792,"_3053":57793},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-settings","CRL settings",{"_3585":2211,"_31232":2208,"_5":31587,"_21602":57795,"_28348":57796,"_3053":57797},[],"/docs/pr-preview/pr-61/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3585":2212,"_31232":2208,"_5":31587,"_21602":57799,"_28348":57800,"_3053":57801},[],"/docs/pr-preview/pr-61/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3585":2213,"_31232":2208,"_5":31587,"_21602":57803,"_28348":57804,"_3053":57805},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-contents","CRL contents",{"_3585":2214,"_31232":2208,"_5":31587,"_21602":57807,"_28348":57808,"_3053":57809},[],"/docs/pr-preview/pr-61/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3585":2215,"_31232":2208,"_5":31587,"_21602":57811,"_28348":57812,"_3053":57813},[],"/docs/pr-preview/pr-61/platform/pki/crl#crl-settings-api","CRL settings API",{"_3585":2216,"_31232":2208,"_5":31587,"_21602":57815,"_28348":57816,"_3053":57817},[],"/docs/pr-preview/pr-61/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3585":2217,"_31232":2208,"_5":31587,"_21602":57819,"_28348":57820,"_3053":57821},[],"/docs/pr-preview/pr-61/platform/pki/crl#from-the-interface","From the interface",{"_3585":2218,"_31232":2208,"_5":31587,"_21602":57823,"_28348":57824,"_3053":57825},[],"/docs/pr-preview/pr-61/platform/pki/crl#references","References",{"_3585":2219,"_31232":2208,"_21602":57827,"_5":14833,"_28348":2208,"_3053":57828},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3585":2220,"_31232":2208,"_21602":57830,"_5":14833,"_28348":57792,"_3053":57831},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3585":2221,"_31232":2208,"_21602":57833,"_5":14833,"_28348":57792,"_3053":57834},[],"Field",{"_3585":2222,"_31232":2208,"_21602":57836,"_5":14833,"_28348":57792,"_3053":51300},[],{"_3585":2223,"_31232":2208,"_21602":57838,"_5":14833,"_28348":57792,"_3053":57839},[],"`ca_id`",{"_3585":2224,"_31232":2208,"_21602":57841,"_5":14833,"_28348":57792,"_3053":57842},[],"ID of the CA the settings belong to.",{"_3585":2225,"_31232":2208,"_21602":57844,"_5":14833,"_28348":57792,"_3053":57845},[],"`status`",{"_3585":2226,"_31232":2208,"_21602":57847,"_5":14833,"_28348":57792,"_3053":57848},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3585":2227,"_31232":2208,"_21602":57850,"_5":14833,"_28348":57792,"_3053":57851},[],"`legacy_ski`",{"_3585":2228,"_31232":2208,"_21602":57853,"_5":14833,"_28348":57792,"_3053":57854},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3585":2229,"_31232":2208,"_21602":57856,"_5":14833,"_28348":57792,"_3053":57857},[],"`latest_crl`",{"_3585":2230,"_31232":2208,"_21602":57859,"_5":14833,"_28348":57792,"_3053":57860},[],"Version, validity start and end of the last published list. Read-only.",{"_3585":2231,"_31232":2208,"_21602":57862,"_5":14833,"_28348":57792,"_3053":57863},[],"`crl_options` field",{"_3585":2232,"_31232":2208,"_21602":57865,"_5":14833,"_28348":57792,"_3053":51300},[],{"_3585":2233,"_31232":2208,"_21602":57867,"_5":14833,"_28348":57792,"_3053":57868},[],"Initial value",{"_3585":2234,"_31232":2208,"_21602":57870,"_5":14833,"_28348":57792,"_3053":57871},[],"`validity`",{"_3585":2235,"_31232":2208,"_21602":57873,"_5":14833,"_28348":57792,"_3053":57874},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3585":2236,"_31232":2208,"_21602":57876,"_5":14833,"_28348":57792,"_3053":57877},[],"7 days.",{"_3585":2237,"_31232":2208,"_21602":57879,"_5":14833,"_28348":57792,"_3053":57880},[],"`refresh_interval`",{"_3585":2238,"_31232":2208,"_21602":57882,"_5":14833,"_28348":57792,"_3053":57883},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3585":2239,"_31232":2208,"_21602":57885,"_5":14833,"_28348":57792,"_3053":57886},[],"6 days and 23 hours.",{"_3585":2240,"_31232":2208,"_21602":57888,"_5":14833,"_28348":57792,"_3053":57889},[],"`regenerate_on_revoke`",{"_3585":2241,"_31232":2208,"_21602":57891,"_5":14833,"_28348":57792,"_3053":57892},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3585":2242,"_31232":2208,"_21602":57894,"_5":14833,"_28348":57792,"_3053":57895},[],"`true`.",{"_3585":2243,"_31232":2208,"_21602":57897,"_5":14833,"_28348":57792,"_3053":57898},[],"`signer_serial_number`",{"_3585":2244,"_31232":2208,"_21602":57900,"_5":14833,"_28348":57792,"_3053":57901},[],"Serial number of the existing certificate that signs the CRL.",{"_3585":2245,"_31232":2208,"_21602":57903,"_5":14833,"_28348":57792,"_3053":57904},[],"Serial number of the CA’s current certificate.",{"_3585":2246,"_31232":2208,"_21602":57906,"_5":14833,"_28348":57792,"_3053":57907},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3585":2247,"_31232":2208,"_21602":57909,"_5":14833,"_28348":57792,"_3053":57910},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3585":2248,"_31232":2208,"_21602":57912,"_5":14833,"_28348":57792,"_3053":57913},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3585":2249,"_31232":2208,"_21602":57915,"_5":14833,"_28348":57792,"_3053":57916},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3585":2250,"_31232":2208,"_21602":57918,"_5":14833,"_28348":57792,"_3053":57919},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3585":2251,"_31232":2208,"_21602":57921,"_5":14833,"_28348":57792,"_3053":57922},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3585":2252,"_31232":2208,"_21602":57924,"_5":14833,"_28348":57792,"_3053":57925},[],"Adjust validity and signer before deleting a CA.",{"_3585":2253,"_31232":2208,"_21602":57927,"_5":14833,"_28348":57792,"_3053":57928},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3585":2254,"_31232":2208,"_21602":57930,"_5":14833,"_28348":57792,"_3053":57931},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3585":2255,"_31232":2208,"_21602":57933,"_5":14833,"_28348":57792,"_3053":57934},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3585":2256,"_31232":2208,"_21602":57936,"_5":14833,"_28348":57796,"_3053":57937},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3585":2257,"_31232":2208,"_21602":57939,"_5":14833,"_28348":57796,"_3053":57940},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3585":2258,"_31232":2208,"_21602":57942,"_5":14833,"_28348":57796,"_3053":57943},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3585":2259,"_31232":2208,"_21602":57945,"_5":14833,"_28348":57796,"_3053":57946},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3585":2260,"_31232":2208,"_21602":57948,"_5":14833,"_28348":57800,"_3053":57949},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3585":2261,"_31232":2208,"_21602":57951,"_5":14833,"_28348":57800,"_3053":57952},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3585":2262,"_31232":2208,"_21602":57954,"_5":14833,"_28348":57800,"_3053":57955},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3585":2263,"_31232":2208,"_21602":57957,"_5":14833,"_28348":57800,"_3053":57958},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3585":2264,"_31232":2208,"_21602":57960,"_5":14833,"_28348":57800,"_3053":57961},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3585":2265,"_31232":2208,"_21602":57963,"_5":14833,"_28348":57800,"_3053":57964},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3585":2266,"_31232":2208,"_21602":57966,"_5":14833,"_28348":57800,"_3053":57967},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3585":2267,"_31232":2208,"_21602":57969,"_5":14833,"_28348":57800,"_3053":57970},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3585":2268,"_31232":2208,"_21602":57972,"_5":14833,"_28348":57800,"_3053":57973},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3585":2269,"_31232":2208,"_21602":57975,"_5":14833,"_28348":57804,"_3053":57976},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3585":2270,"_31232":2208,"_21602":57978,"_5":14833,"_28348":57804,"_3053":57979},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3585":2271,"_31232":2208,"_21602":57981,"_5":14833,"_28348":57808,"_3053":57982},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3585":2272,"_31232":2208,"_21602":57984,"_5":14833,"_28348":57808,"_3053":57985},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3585":2273,"_31232":2208,"_21602":57987,"_5":14833,"_28348":57808,"_3053":57988},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3585":2274,"_31232":2208,"_21602":57990,"_5":14833,"_28348":57808,"_3053":57991},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3585":2275,"_31232":2208,"_21602":57993,"_5":14833,"_28348":57808,"_3053":57994},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3585":2276,"_31232":2208,"_21602":57996,"_5":14833,"_28348":57812,"_3053":57997},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3585":2277,"_31232":2208,"_21602":57999,"_5":14833,"_28348":57812,"_3053":54158},[],{"_3585":2278,"_31232":2208,"_21602":58001,"_5":14833,"_28348":57812,"_3053":58002},[],"Relative path",{"_3585":2279,"_31232":2208,"_21602":58004,"_5":14833,"_28348":57812,"_3053":54155},[],{"_3585":2280,"_31232":2208,"_21602":58006,"_5":14833,"_28348":57812,"_3053":58007},[],"`GET`",{"_3585":2281,"_31232":2208,"_21602":58009,"_5":14833,"_28348":57812,"_3053":58010},[],"`/v1/crl-settings`",{"_3585":2282,"_31232":2208,"_21602":58012,"_5":14833,"_28348":57812,"_3053":58013},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3585":2283,"_31232":2208,"_21602":58015,"_5":14833,"_28348":57812,"_3053":58007},[],{"_3585":2284,"_31232":2208,"_21602":58017,"_5":14833,"_28348":57812,"_3053":58018},[],"`/v1/crl-settings/{ca-id}`",{"_3585":2285,"_31232":2208,"_21602":58020,"_5":14833,"_28348":57812,"_3053":58021},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3585":2286,"_31232":2208,"_21602":58023,"_5":14833,"_28348":57812,"_3053":58024},[],"`PUT`",{"_3585":2287,"_31232":2208,"_21602":58026,"_5":14833,"_28348":57812,"_3053":58018},[],{"_3585":2288,"_31232":2208,"_21602":58028,"_5":14833,"_28348":57812,"_3053":58029},[],"Replace the CRL configuration of a CA.",{"_3585":2289,"_31232":2208,"_21602":58031,"_5":14833,"_28348":57812,"_3053":58032},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3585":2290,"_31232":2208,"_21602":58034,"_5":14833,"_28348":57812,"_3053":58035},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3585":2291,"_31232":2208,"_21602":58037,"_5":14833,"_28348":57816,"_3053":58038},[],"Symptom",{"_3585":2292,"_31232":2208,"_21602":58040,"_5":14833,"_28348":57816,"_3053":58041},[],"Cause",{"_3585":2293,"_31232":2208,"_21602":58043,"_5":14833,"_28348":57816,"_3053":58044},[],"Action",{"_3585":2294,"_31232":2208,"_21602":58046,"_5":14833,"_28348":57816,"_3053":58047},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3585":2295,"_31232":2208,"_21602":58049,"_5":14833,"_28348":57816,"_3053":58050},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3585":2296,"_31232":2208,"_21602":58052,"_5":14833,"_28348":57816,"_3053":58053},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3585":2297,"_31232":2208,"_21602":58055,"_5":14833,"_28348":57816,"_3053":58056},[],"`PUT` returns 400.",{"_3585":2298,"_31232":2208,"_21602":58058,"_5":14833,"_28348":57816,"_3053":58059},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3585":2299,"_31232":2208,"_21602":58061,"_5":14833,"_28348":57816,"_3053":58062},[],"Set the serial number of a valid certificate of that CA.",{"_3585":2300,"_31232":2208,"_21602":58064,"_5":14833,"_28348":57816,"_3053":58065},[],"`PUT` returns 404.",{"_3585":2301,"_31232":2208,"_21602":58067,"_5":14833,"_28348":57816,"_3053":58068},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3585":2302,"_31232":2208,"_21602":58070,"_5":14833,"_28348":57816,"_3053":58071},[],"Check the CA ID and the signer serial number.",{"_3585":2303,"_31232":2208,"_21602":58073,"_5":14833,"_28348":57816,"_3053":58074},[],"`PUT` returns 400 from a 3.x client.",{"_3585":2304,"_31232":2208,"_21602":58076,"_5":14833,"_28348":57816,"_3053":58077},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3585":2305,"_31232":2208,"_21602":58079,"_5":14833,"_28348":57816,"_3053":58080},[],"Update the client to send the new field.",{"_3585":2306,"_31232":2208,"_21602":58082,"_5":14833,"_28348":57816,"_3053":58083},[],"The CRL does not change after revoking a certificate.",{"_3585":2307,"_31232":2208,"_21602":58085,"_5":14833,"_28348":57816,"_3053":58086},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3585":2308,"_31232":2208,"_21602":58088,"_5":14833,"_28348":57816,"_3053":58089},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3585":2309,"_31232":2208,"_21602":58091,"_5":14833,"_28348":57816,"_3053":58092},[],"A verifier rejects the CRL because of the issuer.",{"_3585":2310,"_31232":2208,"_21602":58094,"_5":14833,"_28348":57816,"_3053":58095},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3585":2311,"_31232":2208,"_21602":58097,"_5":14833,"_28348":57816,"_3053":58098},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3585":2312,"_31232":2208,"_21602":58100,"_5":14833,"_28348":57820,"_3053":58101},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3585":2313,"_31232":2208,"_21602":58103,"_5":14833,"_28348":57824,"_3053":58104},[],"RFC 5280: X.509 and CRL profile.",{"_3585":2314,"_31232":2208,"_21602":58106,"_5":14833,"_28348":57824,"_3053":58107},[],"OpenSSL: openssl-crl.",{"_3585":2315,"_31232":2208,"_21602":58109,"_5":14833,"_28348":57824,"_3053":58110},[],"OpenSSL: openssl-verify.",{"_3585":2316,"_31232":2208,"_21602":58112,"_5":14833,"_28348":57824,"_3053":58113},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3585":2317,"_31232":2208,"_21602":58115,"_5":14833,"_28348":57824,"_3053":58116},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3585":2318,"_31232":2318,"_5":15204,"_3053":58118,"_31590":58119,"_21602":58120,"_28348":2318},"Keys and cryptographic engines",[50910,52385,56399,56400],[],{"_3585":2319,"_31232":2318,"_21602":58122,"_5":14833,"_28348":2318,"_3053":58123},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3585":2320,"_31232":2318,"_5":31587,"_21602":58125,"_28348":58126,"_3053":58127},[],"/docs/pr-preview/pr-61/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3585":2321,"_31232":2318,"_5":31587,"_21602":58129,"_28348":58130,"_3053":58131},[],"/docs/pr-preview/pr-61/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3585":2322,"_31232":2318,"_5":31587,"_21602":58133,"_28348":58134,"_3053":58135},[],"/docs/pr-preview/pr-61/platform/pki/key-management#file-system","File System",{"_3585":2323,"_31232":2318,"_5":31587,"_21602":58137,"_28348":58138,"_3053":58139},[],"/docs/pr-preview/pr-61/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3585":2324,"_31232":2318,"_5":31587,"_21602":58141,"_28348":58142,"_3053":58143},[],"/docs/pr-preview/pr-61/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3585":2325,"_31232":2318,"_5":31587,"_21602":58145,"_28348":58146,"_3053":58147},[],"/docs/pr-preview/pr-61/platform/pki/key-management#aws-kms","AWS KMS",{"_3585":2326,"_31232":2318,"_5":31587,"_21602":58149,"_28348":58150,"_3053":58151},[],"/docs/pr-preview/pr-61/platform/pki/key-management#pkcs11","PKCS#11",{"_3585":2327,"_31232":2318,"_5":31587,"_21602":58153,"_28348":58154,"_3053":58155},[],"/docs/pr-preview/pr-61/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3585":2328,"_31232":2318,"_5":31587,"_21602":58157,"_28348":58158,"_3053":58159},[],"/docs/pr-preview/pr-61/platform/pki/key-management#key-inventory","Key inventory",{"_3585":2329,"_31232":2318,"_5":31587,"_21602":58161,"_28348":58162,"_3053":58163},[],"/docs/pr-preview/pr-61/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3585":2330,"_31232":2318,"_5":31587,"_21602":58165,"_28348":58166,"_3053":58167},[],"/docs/pr-preview/pr-61/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3585":2331,"_31232":2318,"_5":31587,"_21602":58169,"_28348":58170,"_3053":58171},[],"/docs/pr-preview/pr-61/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3585":2332,"_31232":2318,"_5":31587,"_21602":58173,"_28348":58174,"_3053":58175},[],"/docs/pr-preview/pr-61/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3585":2333,"_31232":2318,"_5":31587,"_21602":58177,"_28348":58178,"_3053":58179},[],"/docs/pr-preview/pr-61/platform/pki/key-management#view-details","View details",{"_3585":2334,"_31232":2318,"_5":31587,"_21602":58181,"_28348":58182,"_3053":58183},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3585":2335,"_31232":2318,"_5":31587,"_21602":58185,"_28348":58186,"_3053":58187},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign","Sign",{"_3585":2336,"_31232":2318,"_5":31587,"_21602":58189,"_28348":58190,"_3053":58191},[],"/docs/pr-preview/pr-61/platform/pki/key-management#verify","Verify",{"_3585":2337,"_31232":2318,"_5":31587,"_21602":58193,"_28348":58194,"_3053":58195},[],"/docs/pr-preview/pr-61/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3585":2338,"_31232":2318,"_5":31587,"_21602":58197,"_28348":58198,"_3053":58199},[],"/docs/pr-preview/pr-61/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3585":2339,"_31232":2318,"_5":31587,"_21602":58201,"_28348":58202,"_3053":58203},[],"/docs/pr-preview/pr-61/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3585":2340,"_31232":2318,"_21602":58205,"_5":14833,"_28348":2318,"_3053":58206},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3585":2341,"_31232":2318,"_21602":58208,"_5":14833,"_28348":2318,"_3053":58209},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3585":2342,"_31232":2318,"_21602":58211,"_5":14833,"_28348":58126,"_3053":58212},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3585":2343,"_31232":2318,"_21602":58214,"_5":14833,"_28348":58126,"_3053":58215},[],"In practice, it lets you:",{"_3585":2344,"_31232":2318,"_21602":58217,"_5":14833,"_28348":58126,"_3053":58218},[],"Generate new key pairs from Lamassu IoT.",{"_3585":2345,"_31232":2318,"_21602":58220,"_5":14833,"_28348":58126,"_3053":58221},[],"Import keys created externally.",{"_3585":2346,"_31232":2318,"_21602":58223,"_5":14833,"_28348":58126,"_3053":58224},[],"Delegate custody and cryptographic operations to external engines.",{"_3585":2347,"_31232":2318,"_21602":58226,"_5":14833,"_28348":58126,"_3053":58227},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3585":2348,"_31232":2318,"_21602":58229,"_5":14833,"_28348":58130,"_3053":58230},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3585":2349,"_31232":2318,"_21602":58232,"_5":14833,"_28348":58130,"_3053":58233},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3585":2350,"_31232":2318,"_21602":58235,"_5":14833,"_28348":58130,"_3053":58236},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3585":2351,"_31232":2318,"_21602":58238,"_5":14833,"_28348":58134,"_3053":58239},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3585":2352,"_31232":2318,"_21602":58241,"_5":14833,"_28348":58138,"_3053":58242},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3585":2353,"_31232":2318,"_21602":58244,"_5":14833,"_28348":58138,"_3053":58245},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3585":2354,"_31232":2318,"_21602":58247,"_5":14833,"_28348":58142,"_3053":58248},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3585":2355,"_31232":2318,"_21602":58250,"_5":14833,"_28348":58146,"_3053":58251},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3585":2356,"_31232":2318,"_21602":58253,"_5":14833,"_28348":58150,"_3053":58254},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3585":2357,"_31232":2318,"_21602":58256,"_5":14833,"_28348":58154,"_3053":58257},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3585":2358,"_31232":2318,"_21602":58259,"_5":14833,"_28348":58154,"_3053":58260},[],"Lamassu shows the enabled engines in the console.",{"_3585":2359,"_31232":2318,"_21602":58262,"_5":14833,"_28348":58154,"_3053":58263},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3585":2360,"_31232":2318,"_21602":58265,"_5":14833,"_28348":58154,"_3053":58266},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3585":2361,"_31232":2318,"_21602":58268,"_5":14833,"_28348":58158,"_3053":58269},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3585":2362,"_31232":2318,"_21602":58271,"_5":14833,"_28348":58158,"_3053":58272},[],"The table includes the following fields:",{"_3585":2363,"_31232":2318,"_21602":58274,"_5":14833,"_28348":58158,"_3053":58275},[],"**Name**: descriptive name of the key.",{"_3585":2364,"_31232":2318,"_21602":58277,"_5":14833,"_28348":58158,"_3053":58278},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3585":2365,"_31232":2318,"_21602":58280,"_5":14833,"_28348":58158,"_3053":58281},[],"**Strength**: visual indicator of cryptographic strength.",{"_3585":2366,"_31232":2318,"_21602":58283,"_5":14833,"_28348":58158,"_3053":58284},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3585":2367,"_31232":2318,"_21602":58286,"_5":14833,"_28348":58158,"_3053":58287},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3585":2368,"_31232":2318,"_21602":58289,"_5":14833,"_28348":58158,"_3053":58290},[],"**Aliases**: alternative names associated with the key.",{"_3585":2369,"_31232":2318,"_21602":58292,"_5":14833,"_28348":58158,"_3053":58293},[],"**Tags**: labels for classification and search.",{"_3585":2370,"_31232":2318,"_21602":58295,"_5":14833,"_28348":58158,"_3053":58296},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3585":2371,"_31232":2318,"_21602":58298,"_5":14833,"_28348":58158,"_3053":58299},[],"From this view you also reach the most common actions:",{"_3585":2372,"_31232":2318,"_21602":58301,"_5":14833,"_28348":58158,"_3053":58302},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3585":2373,"_31232":2318,"_21602":58304,"_5":14833,"_28348":58158,"_3053":58305},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3585":2374,"_31232":2318,"_21602":58307,"_5":14833,"_28348":58158,"_3053":58308},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3585":2375,"_31232":2318,"_21602":58310,"_5":14833,"_28348":58158,"_3053":58311},[],"**Delete Key** to remove the key from the system.",{"_3585":2376,"_31232":2318,"_21602":58313,"_5":14833,"_28348":58162,"_3053":58314},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3585":2377,"_31232":2318,"_21602":58316,"_5":14833,"_28348":58166,"_3053":58317},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3585":2378,"_31232":2318,"_21602":58319,"_5":14833,"_28348":58166,"_3053":58320},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3585":2379,"_31232":2318,"_21602":58322,"_5":14833,"_28348":58166,"_3053":58323},[],"**Key Name**: unique and descriptive name.",{"_3585":2380,"_31232":2318,"_21602":58325,"_5":14833,"_28348":58166,"_3053":58326},[],"**Crypto Engine**: engine that will keep the key.",{"_3585":2381,"_31232":2318,"_21602":58328,"_5":14833,"_28348":58166,"_3053":58329},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3585":2382,"_31232":2318,"_21602":58331,"_5":14833,"_28348":58166,"_3053":58332},[],"**Tags**: metadata to classify the key.",{"_3585":2383,"_31232":2318,"_21602":58334,"_5":14833,"_28348":58166,"_3053":58335},[],"**Metadata**: additional information for advanced uses.",{"_3585":2384,"_31232":2318,"_21602":58337,"_5":14833,"_28348":58170,"_3053":58338},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3585":2385,"_31232":2318,"_21602":58340,"_5":14833,"_28348":58170,"_3053":58341},[],"When you have an exportable private key and the destination engine supports import.",{"_3585":2386,"_31232":2318,"_21602":58343,"_5":14833,"_28348":58170,"_3053":58344},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3585":2387,"_31232":2318,"_21602":58346,"_5":14833,"_28348":58170,"_3053":58347},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3585":2388,"_31232":2318,"_21602":58349,"_5":14833,"_28348":58170,"_3053":58350},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3585":2389,"_31232":2318,"_21602":58352,"_5":14833,"_28348":58170,"_3053":58353},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3585":2390,"_31232":2318,"_21602":58355,"_5":14833,"_28348":58170,"_3053":58356},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3585":2391,"_31232":2318,"_21602":58358,"_5":14833,"_28348":58170,"_3053":58359},[],"**Tags**: labels for organization and search.",{"_3585":2392,"_31232":2318,"_21602":58361,"_5":14833,"_28348":58170,"_3053":58362},[],"**Metadata**: additional optional information.",{"_3585":2393,"_31232":2318,"_21602":58364,"_5":14833,"_28348":58170,"_3053":58365},[],"**Private Key (PEM)**: private key in PEM format.",{"_3585":2394,"_31232":2318,"_21602":58367,"_5":14833,"_28348":58170,"_3053":58368},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3585":2395,"_31232":2318,"_21602":58370,"_5":14833,"_28348":58174,"_3053":58371},[],"Each registered key has a detail view and several operational actions.",{"_3585":2396,"_31232":2318,"_21602":58373,"_5":14833,"_28348":58178,"_3053":58374},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3585":2397,"_31232":2318,"_21602":58376,"_5":14833,"_28348":58178,"_3053":58377},[],"The **Overview** tab shows, among others, these fields:",{"_3585":2398,"_31232":2318,"_21602":58379,"_5":14833,"_28348":58178,"_3053":58380},[],"**Key Name**: descriptive name.",{"_3585":2399,"_31232":2318,"_21602":58382,"_5":14833,"_28348":58178,"_3053":58383},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3585":2400,"_31232":2318,"_21602":58385,"_5":14833,"_28348":58178,"_3053":58386},[],"**Tags**: associated labels.",{"_3585":2401,"_31232":2318,"_21602":58388,"_5":14833,"_28348":58178,"_3053":58389},[],"**Aliases**: alternative names.",{"_3585":2402,"_31232":2318,"_21602":58391,"_5":14833,"_28348":58178,"_3053":58392},[],"**Crypto Engine**: engine where the key resides.",{"_3585":2403,"_31232":2318,"_21602":58394,"_5":14833,"_28348":58178,"_3053":58395},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3585":2404,"_31232":2318,"_21602":58397,"_5":14833,"_28348":58178,"_3053":58398},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3585":2405,"_31232":2318,"_21602":58400,"_5":14833,"_28348":58178,"_3053":58401},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3585":2406,"_31232":2318,"_21602":58403,"_5":14833,"_28348":58182,"_3053":58404},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3585":2407,"_31232":2318,"_21602":58406,"_5":14833,"_28348":58182,"_3053":58407},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3585":2408,"_31232":2318,"_21602":58409,"_5":14833,"_28348":58182,"_3053":58410},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3585":2409,"_31232":2318,"_21602":58412,"_5":14833,"_28348":58186,"_3053":58413},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3585":2410,"_31232":2318,"_21602":58415,"_5":14833,"_28348":58186,"_3053":58416},[],"Main fields:",{"_3585":2411,"_31232":2318,"_21602":58418,"_5":14833,"_28348":58186,"_3053":58419},[],"**Algorithm**: signing algorithm available for the key type.",{"_3585":2412,"_31232":2318,"_21602":58421,"_5":14833,"_28348":58186,"_3053":58422},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3585":2413,"_31232":2318,"_21602":58424,"_5":14833,"_28348":58186,"_3053":58425},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3585":2414,"_31232":2318,"_21602":58427,"_5":14833,"_28348":58186,"_3053":58428},[],"**Message**: content to sign.",{"_3585":2415,"_31232":2318,"_21602":58430,"_5":14833,"_28348":58186,"_3053":58431},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3585":2416,"_31232":2318,"_21602":58433,"_5":14833,"_28348":58190,"_3053":58434},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3585":2417,"_31232":2318,"_21602":58436,"_5":14833,"_28348":58190,"_3053":58416},[],{"_3585":2418,"_31232":2318,"_21602":58438,"_5":14833,"_28348":58190,"_3053":58439},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3585":2419,"_31232":2318,"_21602":58441,"_5":14833,"_28348":58190,"_3053":58442},[],"**Message Type**: `Raw` or `Digest`.",{"_3585":2420,"_31232":2318,"_21602":58444,"_5":14833,"_28348":58190,"_3053":58445},[],"**Payload Encoding**: encoding of the message.",{"_3585":2421,"_31232":2318,"_21602":58447,"_5":14833,"_28348":58190,"_3053":58448},[],"**Message**: original message or hash.",{"_3585":2422,"_31232":2318,"_21602":58450,"_5":14833,"_28348":58190,"_3053":58451},[],"**Signature**: signature to check.",{"_3585":2423,"_31232":2318,"_21602":58453,"_5":14833,"_28348":58190,"_3053":58454},[],"**Result**: indicator of the validation result.",{"_3585":2424,"_31232":2318,"_21602":58456,"_5":14833,"_28348":58194,"_3053":58457},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3585":2425,"_31232":2318,"_21602":58459,"_5":14833,"_28348":58194,"_3053":58460},[],"This flow is useful for:",{"_3585":2426,"_31232":2318,"_21602":58462,"_5":14833,"_28348":58194,"_3053":58463},[],"Requesting certificates from an external CA.",{"_3585":2427,"_31232":2318,"_21602":58465,"_5":14833,"_28348":58194,"_3053":58466},[],"Renewing an identity while keeping the same key.",{"_3585":2428,"_31232":2318,"_21602":58468,"_5":14833,"_28348":58194,"_3053":58469},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3585":2429,"_31232":2318,"_21602":58471,"_5":14833,"_28348":58194,"_3053":58472},[],"**Common Name (CN)**: main name of the identity.",{"_3585":2430,"_31232":2318,"_21602":58474,"_5":14833,"_28348":58194,"_3053":58475},[],"**Organization (O)**: organization or company.",{"_3585":2431,"_31232":2318,"_21602":58477,"_5":14833,"_28348":58194,"_3053":58478},[],"**Organizational Unit (OU)**: department or unit.",{"_3585":2432,"_31232":2318,"_21602":58480,"_5":14833,"_28348":58194,"_3053":58481},[],"**Country (C)**: two-letter country code.",{"_3585":2433,"_31232":2318,"_21602":58483,"_5":14833,"_28348":58194,"_3053":58484},[],"**State / Province (ST)**: state or province.",{"_3585":2434,"_31232":2318,"_21602":58486,"_5":14833,"_28348":58194,"_3053":58487},[],"**Locality (L)**: city or locality.",{"_3585":2435,"_31232":2318,"_21602":58489,"_5":14833,"_28348":58194,"_3053":58490},[],"**Email Address**: contact email.",{"_3585":2436,"_31232":2318,"_21602":58492,"_5":14833,"_28348":58194,"_3053":58493},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3585":2437,"_31232":2318,"_21602":58495,"_5":14833,"_28348":58194,"_3053":58496},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3585":2438,"_31232":2318,"_21602":58498,"_5":14833,"_28348":58198,"_3053":58499},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3585":2439,"_31232":2318,"_21602":58501,"_5":14833,"_28348":58198,"_3053":58502},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3585":2440,"_31232":2318,"_21602":58504,"_5":14833,"_28348":58202,"_3053":58505},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3585":2441,"_31232":2318,"_21602":58507,"_5":14833,"_28348":58202,"_3053":58508},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3585":2442,"_31232":2442,"_5":15204,"_3053":58510,"_31590":58511,"_21602":58512,"_28348":2442},"Online validation with OCSP",[50910,52385,56399,57038],[],{"_3585":2443,"_31232":2442,"_21602":58514,"_5":14833,"_28348":2442,"_3053":58515},[],"Query signed status and verify the responder’s response.",{"_3585":2444,"_31232":2442,"_5":31587,"_21602":58517,"_28348":58518,"_3053":58519},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3585":2445,"_31232":2442,"_5":31587,"_21602":58521,"_28348":58522,"_3053":58523},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3585":2446,"_31232":2442,"_5":31587,"_21602":58525,"_28348":58526,"_3053":58527},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3585":2447,"_31232":2442,"_5":31587,"_21602":58529,"_28348":58530,"_3053":58531},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3585":2448,"_31232":2442,"_5":31587,"_21602":58533,"_28348":58534,"_3053":58535},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3585":2449,"_31232":2442,"_5":31587,"_21602":58537,"_28348":58538,"_3053":57825},[],"/docs/pr-preview/pr-61/platform/pki/ocsp#references",{"_3585":2450,"_31232":2442,"_21602":58540,"_5":14833,"_28348":2442,"_3053":58541},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3585":2451,"_31232":2442,"_21602":58543,"_5":14833,"_28348":58518,"_3053":58544},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3585":2452,"_31232":2442,"_21602":58546,"_5":14833,"_28348":58518,"_3053":58547},[],"Record status",{"_3585":2453,"_31232":2442,"_21602":58549,"_5":14833,"_28348":58518,"_3053":58550},[],"Signed response",{"_3585":2454,"_31232":2442,"_21602":58552,"_5":14833,"_28348":58518,"_3053":55530},[],{"_3585":2455,"_31232":2442,"_21602":58554,"_5":14833,"_28348":58518,"_3053":58555},[],"`Good`.",{"_3585":2456,"_31232":2442,"_21602":58557,"_5":14833,"_28348":58518,"_3053":55547},[],{"_3585":2457,"_31232":2442,"_21602":58559,"_5":14833,"_28348":58518,"_3053":58560},[],"`Revoked`, with revocation reason and timestamp.",{"_3585":2458,"_31232":2442,"_21602":58562,"_5":14833,"_28348":58518,"_3053":58563},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3585":2459,"_31232":2442,"_21602":58565,"_5":14833,"_28348":58518,"_3053":58566},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3585":2460,"_31232":2442,"_21602":58568,"_5":14833,"_28348":58518,"_3053":58569},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3585":2461,"_31232":2442,"_21602":58571,"_5":14833,"_28348":58518,"_3053":58572},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3585":2462,"_31232":2442,"_21602":58574,"_5":14833,"_28348":58518,"_3053":58575},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3585":2463,"_31232":2442,"_21602":58577,"_5":14833,"_28348":58522,"_3053":58578},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3585":2464,"_31232":2442,"_21602":58580,"_5":14833,"_28348":58522,"_3053":58581},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3585":2465,"_31232":2442,"_21602":58583,"_5":14833,"_28348":58526,"_3053":58584},[],"The service accepts:",{"_3585":2466,"_31232":2442,"_21602":58586,"_5":14833,"_28348":58526,"_3053":54158},[],{"_3585":2467,"_31232":2442,"_21602":58588,"_5":14833,"_28348":58526,"_3053":58589},[],"VA service path",{"_3585":2468,"_31232":2442,"_21602":58591,"_5":14833,"_28348":58526,"_3053":58592},[],"Format",{"_3585":2469,"_31232":2442,"_21602":58594,"_5":14833,"_28348":58526,"_3053":58595},[],"`POST`",{"_3585":2470,"_31232":2442,"_21602":58597,"_5":14833,"_28348":58526,"_3053":58598},[],"`/ocsp`",{"_3585":2471,"_31232":2442,"_21602":58600,"_5":14833,"_28348":58526,"_3053":58601},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3585":2472,"_31232":2442,"_21602":58603,"_5":14833,"_28348":58526,"_3053":58007},[],{"_3585":2473,"_31232":2442,"_21602":58605,"_5":14833,"_28348":58526,"_3053":58606},[],"`/ocsp/{ocsp_request}`",{"_3585":2474,"_31232":2442,"_21602":58608,"_5":14833,"_28348":58526,"_3053":58609},[],"DER request encoded using padded URL Base64.",{"_3585":2475,"_31232":2442,"_21602":58611,"_5":14833,"_28348":58526,"_3053":58612},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3585":2476,"_31232":2442,"_21602":58614,"_5":14833,"_28348":58530,"_3053":58615},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3585":2477,"_31232":2442,"_21602":58617,"_5":14833,"_28348":58530,"_3053":58618},[],"Generate the request:",{"_3585":2478,"_31232":2442,"_21602":58620,"_5":14833,"_28348":58530,"_3053":58621},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3585":2479,"_31232":2442,"_21602":58623,"_5":14833,"_28348":58530,"_3053":58624},[],"Replace the example URL with the inspected endpoint:",{"_3585":2480,"_31232":2442,"_21602":58626,"_5":14833,"_28348":58530,"_3053":58627},[],"Verify the returned DER:",{"_3585":2481,"_31232":2442,"_21602":58629,"_5":14833,"_28348":58530,"_3053":58630},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3585":2482,"_31232":2442,"_21602":58632,"_5":14833,"_28348":58534,"_3053":58633},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3585":2483,"_31232":2442,"_21602":58635,"_5":14833,"_28348":58534,"_3053":58636},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3585":2484,"_31232":2442,"_21602":58638,"_5":14833,"_28348":58538,"_3053":58639},[],"RFC 6960: OCSP.",{"_3585":2485,"_31232":2442,"_21602":58641,"_5":14833,"_28348":58538,"_3053":58642},[],"OpenSSL: openssl-ocsp.",{"_3585":2486,"_31232":2442,"_21602":58644,"_5":14833,"_28348":58538,"_3053":58645},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3585":2487,"_31232":2442,"_21602":58647,"_5":14833,"_28348":58538,"_3053":58116},[],{"_3585":2488,"_31232":2488,"_5":15204,"_3053":56399,"_31590":58649,"_21602":58650,"_28348":2488},[50910,52385,56399],[],{"_3585":2489,"_31232":2488,"_21602":58652,"_5":14833,"_28348":2488,"_3053":58653},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3585":2490,"_31232":2488,"_5":31587,"_21602":58655,"_28348":58656,"_3053":55705},[],"/docs/pr-preview/pr-61/platform/pki/overview#start-here",{"_3585":2491,"_31232":2488,"_5":31587,"_21602":58658,"_28348":58659,"_3053":58660},[],"/docs/pr-preview/pr-61/platform/pki/overview#what-you-need","What you need",{"_3585":2492,"_31232":2488,"_5":31587,"_21602":58662,"_28348":58663,"_3053":56243},[],"/docs/pr-preview/pr-61/platform/pki/overview#core-capabilities",{"_3585":2493,"_31232":2488,"_5":31587,"_21602":58665,"_28348":58666,"_3053":56247},[],"/docs/pr-preview/pr-61/platform/pki/overview#build-your-trust-hierarchy",{"_3585":2494,"_31232":2488,"_5":31587,"_21602":58668,"_28348":58669,"_3053":56251},[],"/docs/pr-preview/pr-61/platform/pki/overview#protect-cryptographic-keys",{"_3585":2495,"_31232":2488,"_5":31587,"_21602":58671,"_28348":58672,"_3053":56255},[],"/docs/pr-preview/pr-61/platform/pki/overview#issue-and-control-certificates",{"_3585":2496,"_31232":2488,"_5":31587,"_21602":58674,"_28348":58675,"_3053":56263},[],"/docs/pr-preview/pr-61/platform/pki/overview#publish-validation-status",{"_3585":2497,"_31232":2488,"_5":31587,"_21602":58677,"_28348":58678,"_3053":58679},[],"/docs/pr-preview/pr-61/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3585":2498,"_31232":2488,"_5":31587,"_21602":58681,"_28348":58682,"_3053":57205},[],"/docs/pr-preview/pr-61/platform/pki/overview#continue",{"_3585":2499,"_31232":2488,"_21602":58684,"_5":14833,"_28348":2488,"_3053":58685},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3585":2500,"_31232":2488,"_21602":58687,"_5":14833,"_28348":58656,"_3053":58688},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3585":2501,"_31232":2488,"_21602":58690,"_5":14833,"_28348":58656,"_3053":58691},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3585":2502,"_31232":2488,"_21602":58693,"_5":14833,"_28348":58659,"_3053":58694},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3585":2503,"_31232":2488,"_21602":58696,"_5":14833,"_28348":58659,"_3053":58697},[],"An available cryptographic engine to keep the authority's key.",{"_3585":2504,"_31232":2488,"_21602":58699,"_5":14833,"_28348":58659,"_3053":58700},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3585":2505,"_31232":2488,"_21602":58702,"_5":14833,"_28348":58659,"_3053":58703},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3585":2506,"_31232":2488,"_21602":58705,"_5":14833,"_28348":58659,"_3053":58706},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3585":2507,"_31232":2488,"_21602":58708,"_5":14833,"_28348":58666,"_3053":58709},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3585":2508,"_31232":2488,"_21602":58711,"_5":14833,"_28348":58669,"_3053":58712},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3585":2509,"_31232":2488,"_21602":58714,"_5":14833,"_28348":58672,"_3053":58715},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3585":2510,"_31232":2488,"_21602":58717,"_5":14833,"_28348":58675,"_3053":58718},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3585":2511,"_31232":2488,"_21602":58720,"_5":14833,"_28348":58678,"_3053":58721},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3585":2512,"_31232":2488,"_21602":58723,"_5":14833,"_28348":58678,"_3053":58724},[],"its subject and extensions identify the expected client;",{"_3585":2513,"_31232":2488,"_21602":58726,"_5":14833,"_28348":58678,"_3053":58727},[],"its public key matches the client's private key;",{"_3585":2514,"_31232":2488,"_21602":58729,"_5":14833,"_28348":58678,"_3053":58730},[],"its chain reaches a root trusted by the consumer;",{"_3585":2515,"_31232":2488,"_21602":58732,"_5":14833,"_28348":58678,"_3053":58733},[],"its dates and usages allow the operation;",{"_3585":2516,"_31232":2488,"_21602":58735,"_5":14833,"_28348":58678,"_3053":58736},[],"the consumer applies revocation checks and authorization.",{"_3585":2517,"_31232":2488,"_21602":58738,"_5":14833,"_28348":58678,"_3053":58739},[],"The issuance path includes the first independent checks.",{"_3585":2518,"_31232":2488,"_21602":58741,"_5":14833,"_28348":58682,"_3053":58742},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3585":2519,"_31232":2488,"_21602":58744,"_5":14833,"_28348":58682,"_3053":58745},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3585":2520,"_31232":2488,"_21602":58747,"_5":14833,"_28348":58682,"_3053":58748},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3585":2521,"_31232":2521,"_5":15204,"_3053":58750,"_31590":58751,"_21602":58752,"_28348":2521},"Create your first CA",[50910,52385,56399,55830],[],{"_3585":2522,"_31232":2521,"_21602":58754,"_5":14833,"_28348":2521,"_3053":58755},[],"Create an evaluation root and check its certificate before issuing.",{"_3585":2523,"_31232":2521,"_5":31587,"_21602":58757,"_28348":58758,"_3053":50920},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3585":2524,"_31232":2521,"_5":31587,"_21602":58760,"_28348":58761,"_3053":58762},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#create-the-authority","Create the authority",{"_3585":2525,"_31232":2521,"_5":31587,"_21602":58764,"_28348":58765,"_3053":58766},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3585":2526,"_31232":2521,"_5":31587,"_21602":58768,"_28348":58769,"_3053":56093},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3585":2527,"_31232":2521,"_5":31587,"_21602":58771,"_28348":58772,"_3053":50944},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3585":2528,"_31232":2521,"_21602":58774,"_5":14833,"_28348":2521,"_3053":58775},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3585":2529,"_31232":2521,"_21602":58777,"_5":14833,"_28348":58758,"_3053":58778},[],"Console access and permission to create keys and authorities.",{"_3585":2530,"_31232":2521,"_21602":58780,"_5":14833,"_28348":58758,"_3053":58781},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3585":2531,"_31232":2521,"_21602":58783,"_5":14833,"_28348":58758,"_3053":58784},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3585":2532,"_31232":2521,"_21602":58786,"_5":14833,"_28348":58758,"_3053":58787},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3585":2533,"_31232":2521,"_21602":58789,"_5":14833,"_28348":58761,"_3053":58790},[],"Follow the interactive walkthrough to create a root CA with a new ECDSA P-384 key, an example subject and a client-certificate issuance profile. The availability and lifetime of profiles depend on your environment; choose values appropriate for your CA.",{"_3585":2534,"_31232":2521,"_21602":58792,"_5":14833,"_28348":58761,"_3053":58793},[],"The example sets **CA Name** to `Acme Showcase Root CA`, which becomes the subject Common Name (CN). It also sets the optional subject fields &#x2A;*Country (C)** to `ES` and &#x2A;*Organization (O)** to `Acme`; use values appropriate for your authority.",{"_3585":2535,"_31232":2521,"_21602":58795,"_5":14833,"_28348":58761,"_3053":58796},[],"Open the new CA and select **Certificate PEM**. Download or copy its public certificate to `ca.pem`, including the complete `BEGIN CERTIFICATE` and `END CERTIFICATE` block. The private key remains in the configured engine. To reuse an existing key instead, see the authorities guide.",{"_3585":2536,"_31232":2521,"_21602":58798,"_5":14833,"_28348":58765,"_3053":58799},[],"Run from the directory where you saved `ca.pem`:",{"_3585":2537,"_31232":2521,"_21602":58801,"_5":14833,"_28348":58765,"_3053":58802},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3585":2538,"_31232":2521,"_21602":58804,"_5":14833,"_28348":58765,"_3053":58805},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3585":2539,"_31232":2521,"_21602":58807,"_5":14833,"_28348":58769,"_3053":58808},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3585":2540,"_31232":2521,"_21602":58810,"_5":14833,"_28348":58769,"_3053":58811},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3585":2541,"_31232":2521,"_21602":58813,"_5":14833,"_28348":58769,"_3053":58814},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3585":2542,"_31232":2521,"_21602":58816,"_5":14833,"_28348":58769,"_3053":58817},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3585":2543,"_31232":2521,"_21602":58819,"_5":14833,"_28348":58772,"_3053":58820},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3585":2544,"_31232":2544,"_5":15204,"_3053":58822,"_31590":58823,"_21602":58824,"_28348":2544},"Issue and verify a certificate",[50910,52385,56399,55830],[],{"_3585":2545,"_31232":2544,"_21602":58826,"_5":14833,"_28348":2544,"_3053":58827},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3585":2546,"_31232":2544,"_5":31587,"_21602":58829,"_28348":58830,"_3053":50920},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3585":2547,"_31232":2544,"_5":31587,"_21602":58832,"_28348":58833,"_3053":58834},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3585":2548,"_31232":2544,"_5":31587,"_21602":58836,"_28348":58837,"_3053":58838},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3585":2549,"_31232":2544,"_5":31587,"_21602":58840,"_28348":58841,"_3053":58842},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3585":2550,"_31232":2544,"_5":31587,"_21602":58844,"_28348":58845,"_3053":58846},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3585":2551,"_31232":2544,"_5":31587,"_21602":58848,"_28348":58849,"_3053":58850},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3585":2552,"_31232":2544,"_5":31587,"_21602":58852,"_28348":58853,"_3053":58854},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3585":2553,"_31232":2544,"_5":31587,"_21602":58856,"_28348":58857,"_3053":58858},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3585":2554,"_31232":2544,"_5":31587,"_21602":58860,"_28348":58861,"_3053":58862},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3585":2555,"_31232":2544,"_5":31587,"_21602":58864,"_28348":58865,"_3053":58866},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3585":2556,"_31232":2544,"_5":31587,"_21602":58868,"_28348":58869,"_3053":56093},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3585":2557,"_31232":2544,"_5":31587,"_21602":58871,"_28348":58872,"_3053":50944},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/issue-certificate#next-step",{"_3585":2558,"_31232":2544,"_21602":58874,"_5":14833,"_28348":2544,"_3053":58875},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3585":2559,"_31232":2544,"_21602":58877,"_5":14833,"_28348":58830,"_3053":58878},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3585":2560,"_31232":2544,"_21602":58880,"_5":14833,"_28348":58830,"_3053":58881},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3585":2561,"_31232":2544,"_21602":58883,"_5":14833,"_28348":58830,"_3053":58884},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3585":2562,"_31232":2544,"_21602":58886,"_5":14833,"_28348":58830,"_3053":58887},[],"A client identifier: here we use `device-001`.",{"_3585":2563,"_31232":2544,"_21602":58889,"_5":14833,"_28348":58830,"_3053":58890},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3585":2564,"_31232":2544,"_21602":58892,"_5":14833,"_28348":58833,"_3053":58893},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3585":2565,"_31232":2544,"_21602":58895,"_5":14833,"_28348":58837,"_3053":58896},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3585":2566,"_31232":2544,"_21602":58898,"_5":14833,"_28348":58837,"_3053":58899},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3585":2567,"_31232":2544,"_21602":58901,"_5":14833,"_28348":58841,"_3053":58902},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3585":2568,"_31232":2544,"_21602":58904,"_5":14833,"_28348":58841,"_3053":58905},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3585":2569,"_31232":2544,"_21602":58907,"_5":14833,"_28348":58845,"_3053":58908},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3585":2570,"_31232":2544,"_21602":58910,"_5":14833,"_28348":58845,"_3053":58911},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3585":2571,"_31232":2544,"_21602":58913,"_5":14833,"_28348":58849,"_3053":58914},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3585":2572,"_31232":2544,"_21602":58916,"_5":14833,"_28348":58853,"_3053":58917},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3585":2573,"_31232":2544,"_21602":58919,"_5":14833,"_28348":58857,"_3053":58920},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3585":2574,"_31232":2544,"_21602":58922,"_5":14833,"_28348":58861,"_3053":58923},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3585":2575,"_31232":2544,"_21602":58925,"_5":14833,"_28348":58861,"_3053":58926},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3585":2576,"_31232":2544,"_21602":58928,"_5":14833,"_28348":58861,"_3053":58929},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3585":2577,"_31232":2544,"_21602":58931,"_5":14833,"_28348":58865,"_3053":58932},[],"In Bash, compare the two public-key digests:",{"_3585":2578,"_31232":2544,"_21602":58934,"_5":14833,"_28348":58865,"_3053":58935},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3585":2579,"_31232":2544,"_21602":58937,"_5":14833,"_28348":58865,"_3053":58938},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3585":2580,"_31232":2544,"_21602":58940,"_5":14833,"_28348":58869,"_3053":56177},[],{"_3585":2581,"_31232":2544,"_21602":58942,"_5":14833,"_28348":58869,"_3053":58943},[],"What to review",{"_3585":2582,"_31232":2544,"_21602":58945,"_5":14833,"_28348":58869,"_3053":58946},[],"The CA rejects issuance",{"_3585":2583,"_31232":2544,"_21602":58948,"_5":14833,"_28348":58869,"_3053":58949},[],"Permissions, CA state and key, algorithm and profile.",{"_3585":2584,"_31232":2544,"_21602":58951,"_5":14833,"_28348":58869,"_3053":58952},[],"Different subject or usages",{"_3585":2585,"_31232":2544,"_21602":58954,"_5":14833,"_28348":58869,"_3053":58955},[],"Applied profile and requested values.",{"_3585":2586,"_31232":2544,"_21602":58957,"_5":14833,"_28348":58869,"_3053":58958},[],"Issuer cannot be found",{"_3585":2587,"_31232":2544,"_21602":58960,"_5":14833,"_28348":58869,"_3053":58961},[],"Downloaded CA and required intermediate chain.",{"_3585":2588,"_31232":2544,"_21602":58963,"_5":14833,"_28348":58869,"_3053":58964},[],"Validity fails",{"_3585":2589,"_31232":2544,"_21602":58966,"_5":14833,"_28348":58869,"_3053":58967},[],"Certificate and CA dates, and the computer's clock.",{"_3585":2590,"_31232":2544,"_21602":58969,"_5":14833,"_28348":58869,"_3053":58970},[],"Public-key digests differ",{"_3585":2591,"_31232":2544,"_21602":58972,"_5":14833,"_28348":58869,"_3053":58973},[],"Certificate and key files from the same issuance.",{"_3585":2592,"_31232":2544,"_21602":58975,"_5":14833,"_28348":58869,"_3053":58976},[],"See PKI diagnostics to narrow an issuance failure.",{"_3585":2593,"_31232":2544,"_21602":58978,"_5":14833,"_28348":58872,"_3053":58979},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3585":2594,"_31232":2544,"_21602":58981,"_5":14833,"_28348":58872,"_3053":58982},[],"Manage certificates for inspection, status and revocation.",{"_3585":2595,"_31232":2544,"_21602":58984,"_5":14833,"_28348":58872,"_3053":58985},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3585":2596,"_31232":2544,"_21602":58987,"_5":14833,"_28348":58872,"_3053":58988},[],"Prepare EST for the device to request its next identities.",{"_3585":2597,"_31232":2544,"_21602":58990,"_5":14833,"_28348":58872,"_3053":58991},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3585":2598,"_31232":2598,"_5":15204,"_3053":58993,"_31590":58994,"_21602":58995,"_28348":2598},"PKI getting started",[50910,52385,56399,55830],[],{"_3585":2599,"_31232":2598,"_21602":58997,"_5":14833,"_28348":2598,"_3053":58998},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3585":2600,"_31232":2598,"_5":31587,"_21602":59000,"_28348":59001,"_3053":50920},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#before-you-begin",{"_3585":2601,"_31232":2598,"_5":31587,"_21602":59003,"_28348":59004,"_3053":59005},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3585":2602,"_31232":2598,"_5":31587,"_21602":59007,"_28348":59008,"_3053":56028},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#expected-result",{"_3585":2603,"_31232":2598,"_5":31587,"_21602":59010,"_28348":59011,"_3053":59012},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3585":2604,"_31232":2598,"_21602":59014,"_5":14833,"_28348":2598,"_3053":59015},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3585":2605,"_31232":2598,"_21602":59017,"_5":14833,"_28348":59001,"_3053":59018},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3585":2606,"_31232":2598,"_21602":59020,"_5":14833,"_28348":59001,"_3053":59021},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3585":2607,"_31232":2598,"_21602":59023,"_5":14833,"_28348":59001,"_3053":59024},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3585":2608,"_31232":2598,"_21602":59026,"_5":14833,"_28348":59001,"_3053":59027},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3585":2609,"_31232":2598,"_21602":59029,"_5":14833,"_28348":59001,"_3053":59030},[],"A working directory with restricted access for the downloaded key.",{"_3585":2610,"_31232":2598,"_21602":59032,"_5":14833,"_28348":59004,"_3053":59033},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3585":2611,"_31232":2598,"_21602":59035,"_5":14833,"_28348":59004,"_3053":59036},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3585":2612,"_31232":2598,"_21602":59038,"_5":14833,"_28348":59004,"_3053":59039},[],"<Card title=\"3. Revoke a certificate and check the CRL\" description=\"Revoke device-042 among 100 issued certificates and confirm it appears in the CA's CRL.\" href=\"/docs/platform/pki/quickstarts/revoke-certificate\" />",{"_3585":2613,"_31232":2598,"_21602":59041,"_5":14833,"_28348":59004,"_3053":59042},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3585":2614,"_31232":2598,"_21602":59044,"_5":14833,"_28348":59004,"_3053":59045},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3585":2615,"_31232":2598,"_21602":59047,"_5":14833,"_28348":59008,"_3053":59048},[],"File or resource",{"_3585":2616,"_31232":2598,"_21602":59050,"_5":14833,"_28348":59008,"_3053":56025},[],{"_3585":2617,"_31232":2598,"_21602":59052,"_5":14833,"_28348":59008,"_3053":59053},[],"Active root CA and `ca.pem`",{"_3585":2618,"_31232":2598,"_21602":59055,"_5":14833,"_28348":59008,"_3053":59056},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3585":2619,"_31232":2598,"_21602":59058,"_5":14833,"_28348":59008,"_3053":59059},[],"End-entity certificate and `device.crt`",{"_3585":2620,"_31232":2598,"_21602":59061,"_5":14833,"_28348":59008,"_3053":59062},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3585":2621,"_31232":2598,"_21602":59064,"_5":14833,"_28348":59008,"_3053":59065},[],"Private key `device.key`",{"_3585":2622,"_31232":2598,"_21602":59067,"_5":14833,"_28348":59008,"_3053":59068},[],"Its public key matches the one included in `device.crt`.",{"_3585":2623,"_31232":2598,"_21602":59070,"_5":14833,"_28348":59008,"_3053":59071},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3585":2624,"_31232":2598,"_21602":59073,"_5":14833,"_28348":59011,"_3053":59074},[],"To operate certificates, continue with Certificates and Validation.",{"_3585":2625,"_31232":2598,"_21602":59076,"_5":14833,"_28348":59011,"_3053":59077},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3585":2626,"_31232":2598,"_21602":59079,"_5":14833,"_28348":59011,"_3053":59080},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3585":2627,"_31232":2627,"_5":15204,"_3053":59082,"_31590":59083,"_21602":59084,"_28348":2627},"Revoke a certificate and check the CRL",[50910,52385,56399,55830],[],{"_3585":2628,"_31232":2627,"_21602":59086,"_5":14833,"_28348":2627,"_3053":59087},[],"Revoke a certificate among many issued by a CA and confirm that its CRL lists it.",{"_3585":2629,"_31232":2627,"_5":31587,"_21602":59089,"_28348":59090,"_3053":50920},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#before-you-begin",{"_3585":2630,"_31232":2627,"_5":31587,"_21602":59092,"_28348":59093,"_3053":59094},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#revoke-the-certificate","Revoke the certificate",{"_3585":2631,"_31232":2627,"_5":31587,"_21602":59096,"_28348":59097,"_3053":59098},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#find-the-certificate","Find the certificate",{"_3585":2632,"_31232":2627,"_5":31587,"_21602":59100,"_28348":59101,"_3053":59102},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#revoke-it","Revoke it",{"_3585":2633,"_31232":2627,"_5":31587,"_21602":59104,"_28348":59105,"_3053":59106},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#confirm-and-read-the-status","Confirm and read the status",{"_3585":2634,"_31232":2627,"_5":31587,"_21602":59108,"_28348":59109,"_3053":57177},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#download-the-certificate",{"_3585":2635,"_31232":2627,"_5":31587,"_21602":59111,"_28348":59112,"_3053":59113},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#check-the-crl","Check the CRL",{"_3585":2636,"_31232":2627,"_5":31587,"_21602":59115,"_28348":59116,"_3053":59117},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#verify-with-the-list","Verify with the list",{"_3585":2637,"_31232":2627,"_5":31587,"_21602":59119,"_28348":59120,"_3053":56093},[],"/docs/pr-preview/pr-61/platform/pki/quickstarts/revoke-certificate#if-the-result-fails",{"_3585":2638,"_31232":2627,"_21602":59122,"_5":14833,"_28348":2627,"_3053":59123},[],"You will revoke the certificate of `device-042`, one of the 100 certificates issued by the CA, and then check that the CA's revocation list (CRL) includes it while the other certificates remain valid. The result is a revoked certificate in Lamassu and a downloaded CRL that names its serial number and reason.",{"_3585":2639,"_31232":2627,"_21602":59125,"_5":14833,"_28348":59090,"_3053":59126},[],"A CA with issued certificates and permission to change their status. The example uses `Acme Showcase Root CA` from Create your first CA, with the 100 client certificates `device-001` to `device-100`. A smaller set works the same way.",{"_3585":2640,"_31232":2627,"_21602":59128,"_5":14833,"_28348":59090,"_3053":59129},[],"The CA's public certificate in `ca.pem`, as saved in the first path.",{"_3585":2641,"_31232":2627,"_21602":59131,"_5":14833,"_28348":59090,"_3053":59132},[],"OpenSSL 3.x and `curl` on a computer that can reach the CRL endpoint.",{"_3585":2642,"_31232":2627,"_21602":59134,"_5":14833,"_28348":59090,"_3053":59135},[],"Only `CertificateHold` can be undone later. Any other reason is final, so use an evaluation certificate for this path. Before revoking in production, identify the consumers of the identity and prepare a replacement.",{"_3585":2643,"_31232":2627,"_21602":59137,"_5":14833,"_28348":59093,"_3053":59138},[],"Follow the interactive walkthrough. It opens the issuing CA, filters its **Issued Certificates** by Common Name to find `device-042` among the 100, and revokes it with the reason `KeyCompromise`.",{"_3585":2644,"_31232":2627,"_21602":59140,"_5":14833,"_28348":59093,"_3053":59141},[],"In the console, the steps are:",{"_3585":2645,"_31232":2627,"_21602":59143,"_5":14833,"_28348":59097,"_3053":59144},[],"Open **Certification Authorities**, select the issuing CA and go to **Issued Certificates**. Search by `Common Name` for `device-042`. The CA's own certificate is also listed in this tab; do not confuse the two.",{"_3585":2646,"_31232":2627,"_21602":59146,"_5":14833,"_28348":59101,"_3053":59147},[],"Open the **More actions** menu of the matching row and select **Revoke Certificate**. In the confirmation dialog, choose the **Revocation Reason** that describes the incident. This example uses `KeyCompromise`, because the device key is considered exposed. Use `CertificateHold` only for a reversible suspension.",{"_3585":2647,"_31232":2627,"_21602":59149,"_5":14833,"_28348":59105,"_3053":59150},[],"Select **Confirm Revocation**. The row changes to `REVOKED` and shows the reason and the revocation time. If you need to verify the result later, read the record again rather than trusting the dialog.",{"_3585":2648,"_31232":2627,"_21602":59152,"_5":14833,"_28348":59105,"_3053":59153},[],"Revocation does not delete the certificate or its key, and it does not close sessions that are already established. See Certificates for the reasons and their consequences.",{"_3585":2649,"_31232":2627,"_21602":59155,"_5":14833,"_28348":59109,"_3053":59156},[],"From the same **More actions** menu, select **Download PEM** and save the file as `device-042.crt`. Note its serial number and the CRL distribution point (CDP) it carries:",{"_3585":2650,"_31232":2627,"_21602":59158,"_5":14833,"_28348":59109,"_3053":59159},[],"The URL ends with the ID of the **issuing CA**, not the ID or serial of the certificate. Your serial number differs from the one shown.",{"_3585":2651,"_31232":2627,"_21602":59161,"_5":14833,"_28348":59112,"_3053":59162},[],"Lamassu regenerates the CA's CRL when a certificate is revoked, provided `regenerate_on_revoke` is enabled; it is by default. The endpoint is public and does not require authentication. Replace the URL with the CDP of your certificate and download the list:",{"_3585":2652,"_31232":2627,"_21602":59164,"_5":14833,"_28348":59112,"_3053":59165},[],"Check that the list is signed by your CA, is current and contains the serial number:",{"_3585":2653,"_31232":2627,"_21602":59167,"_5":14833,"_28348":59112,"_3053":59168},[],"Expect `verify OK`, the expected issuer, a `lastUpdate` not earlier than the revocation and an entry for the serial of `device-042` with reason `Key Compromise`; the list also names any other certificate previously revoked by this CA. A CRL with the same number as before the revocation means it has not been regenerated yet.",{"_3585":2654,"_31232":2627,"_21602":59170,"_5":14833,"_28348":59116,"_3053":59171},[],"`openssl verify` can apply the downloaded list to a certificate. The revoked certificate must be rejected and any other certificate from the same CA must still pass. For `device-001`, download its PEM in the same way and save it as `device-001.crt`:",{"_3585":2655,"_31232":2627,"_21602":59173,"_5":14833,"_28348":59116,"_3053":59174},[],"This check uses your local copy of the list: it does not download newer lists or prove that every client has refreshed its copy. For online status, see OCSP.",{"_3585":2656,"_31232":2627,"_21602":59176,"_5":14833,"_28348":59120,"_3053":56177},[],{"_3585":2657,"_31232":2627,"_21602":59178,"_5":14833,"_28348":59120,"_3053":58943},[],{"_3585":2658,"_31232":2627,"_21602":59180,"_5":14833,"_28348":59120,"_3053":59181},[],"**Revoke Certificate** is not available",{"_3585":2659,"_31232":2627,"_21602":59183,"_5":14833,"_28348":59120,"_3053":59184},[],"The certificate is already `REVOKED` for a final reason or is `EXPIRED`.",{"_3585":2660,"_31232":2627,"_21602":59186,"_5":14833,"_28348":59120,"_3053":59187},[],"The CRL download returns 404",{"_3585":2661,"_31232":2627,"_21602":59189,"_5":14833,"_28348":59120,"_3053":59190},[],"The ID in the URL is not the issuing CA's: use the CDP of the certificate.",{"_3585":2662,"_31232":2627,"_21602":59192,"_5":14833,"_28348":59120,"_3053":59193},[],"`verify OK` fails",{"_3585":2663,"_31232":2627,"_21602":59195,"_5":14833,"_28348":59120,"_3053":59196},[],"`ca.pem` is not the certificate of the CA that signed the list.",{"_3585":2664,"_31232":2627,"_21602":59198,"_5":14833,"_28348":59120,"_3053":59199},[],"The serial is not in the list",{"_3585":2665,"_31232":2627,"_21602":59201,"_5":14833,"_28348":59120,"_3053":59202},[],"The list was downloaded before the revocation, or its regeneration failed. See CRL settings errors.",{"_3585":2666,"_31232":2627,"_21602":59204,"_5":14833,"_28348":59120,"_3053":59205},[],"`device-001` is also rejected",{"_3585":2667,"_31232":2627,"_21602":59207,"_5":14833,"_28348":59120,"_3053":59208},[],"The certificate was revoked, or `ca.pem` does not match its issuer.",{"_3585":2668,"_31232":2627,"_21602":59210,"_5":14833,"_28348":59120,"_3053":59211},[],"<Card title=\"Manage certificates\" description=\"Reasons, holds and reactivation.\" href=\"/docs/platform/pki/certificates\" />",{"_3585":2669,"_31232":2627,"_21602":59213,"_5":14833,"_28348":59120,"_3053":59214},[],"<Card title=\"Revocation lists (CRL)\" description=\"Settings, regeneration and publication.\" href=\"/docs/platform/pki/crl\" />",{"_3585":2670,"_31232":2627,"_21602":59216,"_5":14833,"_28348":59120,"_3053":59217},[],"<Card title=\"Validate with OCSP\" description=\"Query the signed status of a certificate.\" href=\"/docs/platform/pki/ocsp\" />",{"_3585":2671,"_31232":2671,"_5":15204,"_3053":59219,"_31590":59220,"_21602":59221,"_28348":2671},"PKI troubleshooting",[50910,52385,56399,54968],[],{"_3585":2672,"_31232":2671,"_21602":59223,"_5":14833,"_28348":2671,"_3053":59224},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3585":2673,"_31232":2671,"_5":31587,"_21602":59226,"_28348":59227,"_3053":59228},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3585":2674,"_31232":2671,"_5":31587,"_21602":59230,"_28348":59231,"_3053":59232},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3585":2675,"_31232":2671,"_5":31587,"_21602":59234,"_28348":59235,"_3053":59236},[],"/docs/pr-preview/pr-61/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3585":2676,"_31232":2671,"_21602":59238,"_5":14833,"_28348":2671,"_3053":59239},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3585":2677,"_31232":2671,"_21602":59241,"_5":14833,"_28348":2671,"_3053":59242},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3585":2678,"_31232":2671,"_21602":59244,"_5":14833,"_28348":59227,"_3053":56025},[],{"_3585":2679,"_31232":2671,"_21602":59246,"_5":14833,"_28348":59227,"_3053":59247},[],"What to inspect",{"_3585":2680,"_31232":2671,"_21602":59249,"_5":14833,"_28348":59227,"_3053":50944},[],{"_3585":2681,"_31232":2671,"_21602":59251,"_5":14833,"_28348":59227,"_3053":55235},[],{"_3585":2682,"_31232":2671,"_21602":59253,"_5":14833,"_28348":59227,"_3053":59254},[],"Exists, is active and has usable dates.",{"_3585":2683,"_31232":2671,"_21602":59256,"_5":14833,"_28348":59227,"_3053":59257},[],"Authorities.",{"_3585":2684,"_31232":2671,"_21602":59259,"_5":14833,"_28348":59227,"_3053":59260},[],"Key",{"_3585":2685,"_31232":2671,"_21602":59262,"_5":14833,"_28348":59227,"_3053":59263},[],"The record has a usable private key and the engine can sign.",{"_3585":2686,"_31232":2671,"_21602":59265,"_5":14833,"_28348":59227,"_3053":59266},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3585":2687,"_31232":2671,"_21602":59268,"_5":14833,"_28348":59227,"_3053":59269},[],"CSR",{"_3585":2688,"_31232":2671,"_21602":59271,"_5":14833,"_28348":59227,"_3053":59272},[],"Correct PEM and verifiable signature.",{"_3585":2689,"_31232":2671,"_21602":59274,"_5":14833,"_28348":59227,"_3053":59275},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3585":2690,"_31232":2671,"_21602":59277,"_5":14833,"_28348":59227,"_3053":59278},[],"Profile",{"_3585":2691,"_31232":2671,"_21602":59280,"_5":14833,"_28348":59227,"_3053":59281},[],"Selected source, existing ID, allowed algorithm and size.",{"_3585":2692,"_31232":2671,"_21602":59283,"_5":14833,"_28348":59227,"_3053":59284},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3585":2693,"_31232":2671,"_21602":59286,"_5":14833,"_28348":59227,"_3053":56177},[],{"_3585":2694,"_31232":2671,"_21602":59288,"_5":14833,"_28348":59227,"_3053":59289},[],"Appropriate subject, SAN, usages and dates.",{"_3585":2695,"_31232":2671,"_21602":59291,"_5":14833,"_28348":59227,"_3053":59292},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3585":2696,"_31232":2671,"_21602":59294,"_5":14833,"_28348":59227,"_3053":59295},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3585":2697,"_31232":2671,"_21602":59297,"_5":14833,"_28348":59227,"_3053":59298},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3585":2698,"_31232":2671,"_21602":59300,"_5":14833,"_28348":59231,"_3053":59301},[],"Check each boundary independently:",{"_3585":2699,"_31232":2671,"_21602":59303,"_5":14833,"_28348":59231,"_3053":59304},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3585":2700,"_31232":2671,"_21602":59306,"_5":14833,"_28348":59231,"_3053":59307},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3585":2701,"_31232":2671,"_21602":59309,"_5":14833,"_28348":59231,"_3053":59310},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3585":2702,"_31232":2671,"_21602":59312,"_5":14833,"_28348":59231,"_3053":59313},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3585":2703,"_31232":2671,"_21602":59315,"_5":14833,"_28348":59231,"_3053":59316},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3585":2704,"_31232":2671,"_21602":59318,"_5":14833,"_28348":59231,"_3053":59319},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3585":2705,"_31232":2671,"_21602":59321,"_5":14833,"_28348":59235,"_3053":59322},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3585":2706,"_31232":2671,"_21602":59324,"_5":14833,"_28348":59235,"_3053":59325},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3585":2707,"_31232":2707,"_5":15204,"_3053":59327,"_31590":59328,"_21602":59329,"_28348":2707},"Security",[50910],[],{"_3585":2708,"_31232":2707,"_21602":59331,"_5":14833,"_28348":2707,"_3053":59332},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3585":2709,"_31232":2707,"_5":31587,"_21602":59334,"_28348":59335,"_3053":59336},[],"/docs/pr-preview/pr-61/security#report-a-vulnerability","Report a vulnerability",{"_3585":2710,"_31232":2707,"_5":31587,"_21602":59338,"_28348":59339,"_3053":59340},[],"/docs/pr-preview/pr-61/security#what-to-include-in-a-report","What to include in a report",{"_3585":2711,"_31232":2707,"_5":31587,"_21602":59342,"_28348":59343,"_3053":59344},[],"/docs/pr-preview/pr-61/security#supported-versions","Supported versions",{"_3585":2712,"_31232":2707,"_5":31587,"_21602":59346,"_28348":59347,"_3053":59348},[],"/docs/pr-preview/pr-61/security#responsible-disclosure","Responsible disclosure",{"_3585":2713,"_31232":2707,"_21602":59350,"_5":14833,"_28348":2707,"_3053":59351},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3585":2714,"_31232":2707,"_21602":59353,"_5":14833,"_28348":59335,"_3053":59354},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3585":2715,"_31232":2707,"_21602":59356,"_5":14833,"_28348":59335,"_3053":59357},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3585":2716,"_31232":2707,"_21602":59359,"_5":14833,"_28348":59335,"_3053":15501},[],{"_3585":2717,"_31232":2707,"_21602":59361,"_5":14833,"_28348":59335,"_3053":15441},[],{"_3585":2718,"_31232":2707,"_21602":59363,"_5":14833,"_28348":59335,"_3053":15488},[],{"_3585":2719,"_31232":2707,"_21602":59365,"_5":14833,"_28348":59335,"_3053":59366},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3585":2720,"_31232":2707,"_21602":59368,"_5":14833,"_28348":59335,"_3053":59369},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3585":2721,"_31232":2707,"_21602":59371,"_5":14833,"_28348":59339,"_3053":59372},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3585":2722,"_31232":2707,"_21602":59374,"_5":14833,"_28348":59339,"_3053":59375},[],"Do not include in the report:",{"_3585":2723,"_31232":2707,"_21602":59377,"_5":14833,"_28348":59339,"_3053":59378},[],"Credentials, tokens, or private keys",{"_3585":2724,"_31232":2707,"_21602":59380,"_5":14833,"_28348":59339,"_3053":59381},[],"Customer data or customer-identifiable information",{"_3585":2725,"_31232":2707,"_21602":59383,"_5":14833,"_28348":59339,"_3053":59384},[],"Confidential architecture or internal infrastructure details",{"_3585":2726,"_31232":2707,"_21602":59386,"_5":14833,"_28348":59343,"_3053":59387},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3585":2727,"_31232":2707,"_21602":59389,"_5":14833,"_28348":59343,"_3053":59390},[],"For upgrade guidance, see Upgrades.",{"_3585":2728,"_31232":2707,"_21602":59392,"_5":14833,"_28348":59347,"_3053":59393},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3585":2729,"_31232":2707,"_21602":59395,"_5":14833,"_28348":59347,"_3053":59396},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3585":2730,"_31232":2707,"_21602":59398,"_5":14833,"_28348":59347,"_3053":59399},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3585":2731,"_31232":2707,"_21602":59401,"_5":14833,"_28348":59347,"_3053":59402},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3585":2732,"_31232":2707,"_21602":59404,"_5":14833,"_28348":59347,"_3053":59405},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3585":2733,"_31232":2733,"_5":15204,"_3053":59407,"_31590":59408,"_21602":59410,"_28348":2733},"3.8.0 to 4.0.0",[50910,59409],"Upgrades",[],{"_3585":2734,"_31232":2733,"_21602":59412,"_5":14833,"_28348":2733,"_3053":59413},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3585":2735,"_31232":2733,"_5":31587,"_21602":59415,"_28348":59416,"_3053":59417},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3585":2736,"_31232":2733,"_5":31587,"_21602":59419,"_28348":59420,"_3053":59421},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3585":2737,"_31232":2733,"_5":31587,"_21602":59423,"_28348":59424,"_3053":59425},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3585":2738,"_31232":2733,"_5":31587,"_21602":59427,"_28348":59428,"_3053":59429},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3585":2739,"_31232":2733,"_5":31587,"_21602":59431,"_28348":59432,"_3053":59433},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3585":2740,"_31232":2733,"_5":31587,"_21602":59435,"_28348":59436,"_3053":59437},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3585":2741,"_31232":2733,"_5":31587,"_21602":59439,"_28348":59440,"_3053":59441},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3585":2742,"_31232":2733,"_5":31587,"_21602":59443,"_28348":59444,"_3053":59445},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3585":2743,"_31232":2733,"_5":31587,"_21602":59447,"_28348":59448,"_3053":59449},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3585":2744,"_31232":2733,"_5":31587,"_21602":59451,"_28348":59452,"_3053":59453},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3585":2745,"_31232":2733,"_5":31587,"_21602":59455,"_28348":59456,"_3053":59457},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3585":2746,"_31232":2733,"_5":31587,"_21602":59459,"_28348":59460,"_3053":59461},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3585":2747,"_31232":2733,"_5":31587,"_21602":59463,"_28348":59464,"_3053":59465},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3585":2748,"_31232":2733,"_5":31587,"_21602":59467,"_28348":59468,"_3053":59469},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3585":2749,"_31232":2733,"_5":31587,"_21602":59471,"_28348":59472,"_3053":59473},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3585":2750,"_31232":2733,"_5":31587,"_21602":59475,"_28348":59476,"_3053":59477},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3585":2751,"_31232":2733,"_5":31587,"_21602":59479,"_28348":59480,"_3053":59481},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3585":2752,"_31232":2733,"_5":31587,"_21602":59483,"_28348":59484,"_3053":59485},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3585":2753,"_31232":2733,"_5":31587,"_21602":59487,"_28348":59488,"_3053":59489},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3585":2754,"_31232":2733,"_5":31587,"_21602":59491,"_28348":59492,"_3053":59493},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3585":2755,"_31232":2733,"_5":31587,"_21602":59495,"_28348":59496,"_3053":59497},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3585":2756,"_31232":2733,"_5":31587,"_21602":59499,"_28348":59500,"_3053":59501},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3585":2757,"_31232":2733,"_5":31587,"_21602":59503,"_28348":59504,"_3053":59505},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3585":2758,"_31232":2733,"_5":31587,"_21602":59507,"_28348":59508,"_3053":59509},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3585":2759,"_31232":2733,"_5":31587,"_21602":59511,"_28348":59512,"_3053":59513},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3585":2760,"_31232":2733,"_5":31587,"_21602":59515,"_28348":59516,"_3053":59517},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3585":2761,"_31232":2733,"_5":31587,"_21602":59519,"_28348":59520,"_3053":59521},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3585":2762,"_31232":2733,"_5":31587,"_21602":59523,"_28348":59524,"_3053":59525},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3585":2763,"_31232":2733,"_5":31587,"_21602":59527,"_28348":59528,"_3053":59529},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3585":2764,"_31232":2733,"_5":31587,"_21602":59531,"_28348":59532,"_3053":59533},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3585":2765,"_31232":2733,"_5":31587,"_21602":59535,"_28348":59536,"_3053":59537},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3585":2766,"_31232":2733,"_5":31587,"_21602":59539,"_28348":59540,"_3053":59541},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3585":2767,"_31232":2733,"_5":31587,"_21602":59543,"_28348":59544,"_3053":59545},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3585":2768,"_31232":2733,"_5":31587,"_21602":59547,"_28348":59548,"_3053":59549},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3585":2769,"_31232":2733,"_5":31587,"_21602":59551,"_28348":59552,"_3053":59553},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3585":2770,"_31232":2733,"_5":31587,"_21602":59555,"_28348":59556,"_3053":59557},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3585":2771,"_31232":2733,"_5":31587,"_21602":59559,"_28348":59560,"_3053":59561},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3585":2772,"_31232":2733,"_5":31587,"_21602":59563,"_28348":59564,"_3053":59565},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3585":2773,"_31232":2733,"_5":31587,"_21602":59567,"_28348":59568,"_3053":59569},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3585":2774,"_31232":2733,"_5":31587,"_21602":59571,"_28348":59572,"_3053":59573},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3585":2775,"_31232":2733,"_5":31587,"_21602":59575,"_28348":59576,"_3053":54968},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3585":2776,"_31232":2733,"_5":31587,"_21602":59578,"_28348":59579,"_3053":59580},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3585":2777,"_31232":2733,"_5":31587,"_21602":59582,"_28348":59583,"_3053":59584},[],"/docs/pr-preview/pr-61/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3585":2778,"_31232":2733,"_21602":59586,"_5":14833,"_28348":2733,"_3053":59587},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3585":2779,"_31232":2733,"_21602":59589,"_5":14833,"_28348":2733,"_3053":59590},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3585":2780,"_31232":2733,"_21602":59592,"_5":14833,"_28348":2733,"_3053":59593},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3585":2781,"_31232":2733,"_21602":59595,"_5":14833,"_28348":2733,"_3053":59596},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3585":2782,"_31232":2733,"_21602":59598,"_5":14833,"_28348":2733,"_3053":59599},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3585":2783,"_31232":2733,"_21602":59601,"_5":14833,"_28348":2733,"_3053":59602},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3585":2784,"_31232":2733,"_21602":59604,"_5":14833,"_28348":2733,"_3053":59605},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3585":2785,"_31232":2733,"_21602":59607,"_5":14833,"_28348":59420,"_3053":59608},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3585":2786,"_31232":2733,"_21602":59610,"_5":14833,"_28348":59420,"_3053":59611},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3585":2787,"_31232":2733,"_21602":59613,"_5":14833,"_28348":59424,"_3053":59614},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3585":2788,"_31232":2733,"_21602":59616,"_5":14833,"_28348":59424,"_3053":59617},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3585":2789,"_31232":2733,"_21602":59619,"_5":14833,"_28348":59428,"_3053":59620},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3585":2790,"_31232":2733,"_21602":59622,"_5":14833,"_28348":59432,"_3053":59623},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3585":2791,"_31232":2733,"_21602":59625,"_5":14833,"_28348":59432,"_3053":59626},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3585":2792,"_31232":2733,"_21602":59628,"_5":14833,"_28348":59432,"_3053":59629},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3585":2793,"_31232":2733,"_21602":59631,"_5":14833,"_28348":59432,"_3053":59632},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3585":2794,"_31232":2733,"_21602":59634,"_5":14833,"_28348":59432,"_3053":59635},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3585":2795,"_31232":2733,"_21602":59637,"_5":14833,"_28348":59436,"_3053":59638},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3585":2796,"_31232":2733,"_21602":59640,"_5":14833,"_28348":59436,"_3053":59641},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3585":2797,"_31232":2733,"_21602":59643,"_5":14833,"_28348":59436,"_3053":59644},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3585":2798,"_31232":2733,"_21602":59646,"_5":14833,"_28348":59436,"_3053":59647},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3585":2799,"_31232":2733,"_21602":59649,"_5":14833,"_28348":59436,"_3053":59650},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3585":2800,"_31232":2733,"_21602":59652,"_5":14833,"_28348":59436,"_3053":59653},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3585":2801,"_31232":2733,"_21602":59655,"_5":14833,"_28348":59440,"_3053":59656},[],"Change",{"_3585":2802,"_31232":2733,"_21602":59658,"_5":14833,"_28348":59440,"_3053":59659},[],"Who is affected",{"_3585":2803,"_31232":2733,"_21602":59661,"_5":14833,"_28348":59440,"_3053":59662},[],"Severity",{"_3585":2804,"_31232":2733,"_21602":59664,"_5":14833,"_28348":59440,"_3053":58044},[],{"_3585":2805,"_31232":2733,"_21602":59666,"_5":14833,"_28348":59440,"_3053":59449},[],{"_3585":2806,"_31232":2733,"_21602":59668,"_5":14833,"_28348":59440,"_3053":59669},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3585":2807,"_31232":2733,"_21602":59671,"_5":14833,"_28348":59440,"_3053":59672},[],"High: KMS and VA start on empty volumes",{"_3585":2808,"_31232":2733,"_21602":59674,"_5":14833,"_28348":59440,"_3053":59675},[],"Copy the data into the new volumes",{"_3585":2809,"_31232":2733,"_21602":59677,"_5":14833,"_28348":59440,"_3053":59453},[],{"_3585":2810,"_31232":2733,"_21602":59679,"_5":14833,"_28348":59440,"_3053":59680},[],"Every Helm release",{"_3585":2811,"_31232":2733,"_21602":59682,"_5":14833,"_28348":59440,"_3053":59683},[],"High: `helm upgrade` fails",{"_3585":2812,"_31232":2733,"_21602":59685,"_5":14833,"_28348":59440,"_3053":59686},[],"Remove or rename legacy keys",{"_3585":2813,"_31232":2733,"_21602":59688,"_5":14833,"_28348":59440,"_3053":59457},[],{"_3585":2814,"_31232":2733,"_21602":59690,"_5":14833,"_28348":59440,"_3053":59691},[],"Every deployment",{"_3585":2815,"_31232":2733,"_21602":59693,"_5":14833,"_28348":59440,"_3053":59694},[],"High: without a bootstrap principal there is no administrator",{"_3585":2816,"_31232":2733,"_21602":59696,"_5":14833,"_28348":59440,"_3053":59697},[],"Configure `services.authz`",{"_3585":2817,"_31232":2733,"_21602":59699,"_5":14833,"_28348":59440,"_3053":59461},[],{"_3585":2818,"_31232":2733,"_21602":59701,"_5":14833,"_28348":59440,"_3053":59680},[],{"_3585":2819,"_31232":2733,"_21602":59703,"_5":14833,"_28348":59440,"_3053":59704},[],"High: `helm upgrade` fails on the old keys",{"_3585":2820,"_31232":2733,"_21602":59706,"_5":14833,"_28348":59440,"_3053":59707},[],"Move JWKS and roles into `services.authz`",{"_3585":2821,"_31232":2733,"_21602":59709,"_5":14833,"_28348":59440,"_3053":59481},[],{"_3585":2822,"_31232":2733,"_21602":59711,"_5":14833,"_28348":59440,"_3053":59712},[],"3.8.0 deployments with per-service databases",{"_3585":2823,"_31232":2733,"_21602":59714,"_5":14833,"_28348":59440,"_3053":59715},[],"High: services find no data, or a migration aborts",{"_3585":2824,"_31232":2733,"_21602":59717,"_5":14833,"_28348":59440,"_3053":59718},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3585":2825,"_31232":2733,"_21602":59720,"_5":14833,"_28348":59440,"_3053":59485},[],{"_3585":2826,"_31232":2733,"_21602":59722,"_5":14833,"_28348":59440,"_3053":59723},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3585":2827,"_31232":2733,"_21602":59725,"_5":14833,"_28348":59440,"_3053":59726},[],"High: the backend no longer starts with them",{"_3585":2828,"_31232":2733,"_21602":59728,"_5":14833,"_28348":59440,"_3053":59729},[],"Move to PostgreSQL before upgrading",{"_3585":2829,"_31232":2733,"_21602":59731,"_5":14833,"_28348":59440,"_3053":59529},[],{"_3585":2830,"_31232":2733,"_21602":59733,"_5":14833,"_28348":59440,"_3053":59734},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3585":2831,"_31232":2733,"_21602":59736,"_5":14833,"_28348":59440,"_3053":59737},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3585":2832,"_31232":2733,"_21602":59739,"_5":14833,"_28348":59440,"_3053":59740},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3585":2833,"_31232":2733,"_21602":59742,"_5":14833,"_28348":59440,"_3053":59743},[],"Webhooks with file references",{"_3585":2834,"_31232":2733,"_21602":59745,"_5":14833,"_28348":59440,"_3053":59746},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3585":2835,"_31232":2733,"_21602":59748,"_5":14833,"_28348":59440,"_3053":59749},[],"High: enrollments calling the webhook fail",{"_3585":2836,"_31232":2733,"_21602":59751,"_5":14833,"_28348":59440,"_3053":59752},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3585":2837,"_31232":2733,"_21602":59754,"_5":14833,"_28348":59440,"_3053":59465},[],{"_3585":2838,"_31232":2733,"_21602":59756,"_5":14833,"_28348":59440,"_3053":59757},[],"Releases with per-service identity overrides or mounted key material",{"_3585":2839,"_31232":2733,"_21602":59759,"_5":14833,"_28348":59440,"_3053":59760},[],"Medium: services cannot read their files",{"_3585":2840,"_31232":2733,"_21602":59762,"_5":14833,"_28348":59440,"_3053":59763},[],"Remove the overrides and fix volume ownership",{"_3585":2841,"_31232":2733,"_21602":59765,"_5":14833,"_28348":59440,"_3053":59469},[],{"_3585":2842,"_31232":2733,"_21602":59767,"_5":14833,"_28348":59440,"_3053":59768},[],"Releases that set `amqp.tls`",{"_3585":2843,"_31232":2733,"_21602":59770,"_5":14833,"_28348":59440,"_3053":59771},[],"Medium: clients connect to the wrong port",{"_3585":2844,"_31232":2733,"_21602":59773,"_5":14833,"_28348":59440,"_3053":59774},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3585":2845,"_31232":2733,"_21602":59776,"_5":14833,"_28348":59440,"_3053":59489},[],{"_3585":2846,"_31232":2733,"_21602":59778,"_5":14833,"_28348":59440,"_3053":59779},[],"Installations whose CA keys predate the KMS",{"_3585":2847,"_31232":2733,"_21602":59781,"_5":14833,"_28348":59440,"_3053":59782},[],"Medium: CA keys stay unmanaged",{"_3585":2848,"_31232":2733,"_21602":59784,"_5":14833,"_28348":59440,"_3053":59785},[],"Run the CA-to-KMS migration",{"_3585":2849,"_31232":2733,"_21602":59787,"_5":14833,"_28348":59440,"_3053":59788},[],"Receiver certificate verification",{"_3585":2850,"_31232":2733,"_21602":59790,"_5":14833,"_28348":59440,"_3053":59791},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3585":2851,"_31232":2733,"_21602":59793,"_5":14833,"_28348":59440,"_3053":59794},[],"Medium: credentials go to an unverified receiver",{"_3585":2852,"_31232":2733,"_21602":59796,"_5":14833,"_28348":59440,"_3053":59797},[],"Set `insecure_skip_verify` to `false`",{"_3585":2853,"_31232":2733,"_21602":59799,"_5":14833,"_28348":59440,"_3053":59505},[],{"_3585":2854,"_31232":2733,"_21602":59801,"_5":14833,"_28348":59440,"_3053":59802},[],"Scripts and consoles that edit DMSs through the API",{"_3585":2855,"_31232":2733,"_21602":59804,"_5":14833,"_28348":59440,"_3053":59805},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3585":2856,"_31232":2733,"_21602":59807,"_5":14833,"_28348":59440,"_3053":59808},[],"Read the DMS before editing and use the new field",{"_3585":2857,"_31232":2733,"_21602":59810,"_5":14833,"_28348":59440,"_3053":59525},[],{"_3585":2858,"_31232":2733,"_21602":59812,"_5":14833,"_28348":59440,"_3053":59813},[],"Clients that create or update CRL settings through the API",{"_3585":2859,"_31232":2733,"_21602":59815,"_5":14833,"_28348":59440,"_3053":59816},[],"Medium: requests with the old field return an error",{"_3585":2860,"_31232":2733,"_21602":59818,"_5":14833,"_28348":59440,"_3053":59819},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3585":2861,"_31232":2733,"_21602":59821,"_5":14833,"_28348":59440,"_3053":59533},[],{"_3585":2862,"_31232":2733,"_21602":59823,"_5":14833,"_28348":59440,"_3053":59824},[],"Alert subscriptions and consumers of the VA events",{"_3585":2863,"_31232":2733,"_21602":59826,"_5":14833,"_28348":59440,"_3053":59827},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3585":2864,"_31232":2733,"_21602":59829,"_5":14833,"_28348":59440,"_3053":59830},[],"Review conditions filtering on the old event payload or subject",{"_3585":2865,"_31232":2733,"_21602":59832,"_5":14833,"_28348":59440,"_3053":59521},[],{"_3585":2866,"_31232":2733,"_21602":59834,"_5":14833,"_28348":59440,"_3053":59835},[],"Consumers that read the device `events` field",{"_3585":2867,"_31232":2733,"_21602":59837,"_5":14833,"_28348":59440,"_3053":59838},[],"Medium: the field disappears",{"_3585":2868,"_31232":2733,"_21602":59840,"_5":14833,"_28348":59440,"_3053":59841},[],"Use the new event endpoints",{"_3585":2869,"_31232":2733,"_21602":59843,"_5":14833,"_28348":59440,"_3053":59541},[],{"_3585":2870,"_31232":2733,"_21602":59845,"_5":14833,"_28348":59440,"_3053":59846},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3585":2871,"_31232":2733,"_21602":59848,"_5":14833,"_28348":59440,"_3053":59849},[],"Medium: the VA migration aborts",{"_3585":2872,"_31232":2733,"_21602":59851,"_5":14833,"_28348":59440,"_3053":59852},[],"Fix the affected roles before upgrading",{"_3585":2873,"_31232":2733,"_21602":59854,"_5":14833,"_28348":59440,"_3053":59473},[],{"_3585":2874,"_31232":2733,"_21602":59856,"_5":14833,"_28348":59440,"_3053":59857},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3585":2875,"_31232":2733,"_21602":59859,"_5":14833,"_28348":59440,"_3053":59860},[],"Low to medium: validation errors or changed defaults",{"_3585":2876,"_31232":2733,"_21602":59862,"_5":14833,"_28348":59440,"_3053":59863},[],"Update the values file",{"_3585":2877,"_31232":2733,"_21602":59865,"_5":14833,"_28348":59440,"_3053":59513},[],{"_3585":2878,"_31232":2733,"_21602":59867,"_5":14833,"_28348":59440,"_3053":59868},[],"Clients that send the DMS ID in the update body",{"_3585":2879,"_31232":2733,"_21602":59870,"_5":14833,"_28348":59440,"_3053":59871},[],"Low: the ID in the URL wins",{"_3585":2880,"_31232":2733,"_21602":59873,"_5":14833,"_28348":59440,"_3053":59874},[],"Send the ID in the URL",{"_3585":2881,"_31232":2733,"_21602":59876,"_5":14833,"_28348":59440,"_3053":59537},[],{"_3585":2882,"_31232":2733,"_21602":59878,"_5":14833,"_28348":59440,"_3053":59879},[],"Clients that send an `id` when creating or importing CAs",{"_3585":2883,"_31232":2733,"_21602":59881,"_5":14833,"_28348":59440,"_3053":59882},[],"Low: the ID in the body is ignored, and the field is removed",{"_3585":2884,"_31232":2733,"_21602":59884,"_5":14833,"_28348":59440,"_3053":59885},[],"Let the backend assign the ID and use the returned one",{"_3585":2885,"_31232":2733,"_21602":59887,"_5":14833,"_28348":59440,"_3053":59517},[],{"_3585":2886,"_31232":2733,"_21602":59889,"_5":14833,"_28348":59440,"_3053":59890},[],"Consumers that match on certificate `type`",{"_3585":2887,"_31232":2733,"_21602":59892,"_5":14833,"_28348":59440,"_3053":59893},[],"Low: two values are renamed",{"_3585":2888,"_31232":2733,"_21602":59895,"_5":14833,"_28348":59440,"_3053":59896},[],"Adapt consumers",{"_3585":2889,"_31232":2733,"_21602":59898,"_5":14833,"_28348":59440,"_3053":59509},[],{"_3585":2890,"_31232":2733,"_21602":59900,"_5":14833,"_28348":59440,"_3053":59901},[],"Any DMS",{"_3585":2891,"_31232":2733,"_21602":59903,"_5":14833,"_28348":59440,"_3053":59904},[],"Low: informational",{"_3585":2892,"_31232":2733,"_21602":59906,"_5":14833,"_28348":59440,"_3053":59907},[],"Read both blocks before editing",{"_3585":2893,"_31232":2733,"_21602":59909,"_5":14833,"_28348":59448,"_3053":59910},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3585":2894,"_31232":2733,"_21602":59912,"_5":14833,"_28348":59448,"_3053":59913},[],"Step 4 of the migration guide copies the data.",{"_3585":2895,"_31232":2733,"_21602":59915,"_5":14833,"_28348":59452,"_3053":59916},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3585":2896,"_31232":2733,"_21602":59918,"_5":14833,"_28348":59456,"_3053":59919},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3585":2897,"_31232":2733,"_21602":59921,"_5":14833,"_28348":59460,"_3053":59922},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3585":2898,"_31232":2733,"_21602":59924,"_5":14833,"_28348":59464,"_3053":59925},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3585":2899,"_31232":2733,"_21602":59927,"_5":14833,"_28348":59464,"_3053":59928},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3585":2900,"_31232":2733,"_21602":59930,"_5":14833,"_28348":59468,"_3053":59931},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3585":2901,"_31232":2733,"_21602":59933,"_5":14833,"_28348":59472,"_3053":59934},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3585":2902,"_31232":2733,"_21602":59936,"_5":14833,"_28348":59472,"_3053":59937},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3585":2903,"_31232":2733,"_21602":59939,"_5":14833,"_28348":59472,"_3053":59940},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3585":2904,"_31232":2733,"_21602":59942,"_5":14833,"_28348":59472,"_3053":59943},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3585":2905,"_31232":2733,"_21602":59945,"_5":14833,"_28348":59472,"_3053":59946},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3585":2906,"_31232":2733,"_21602":59948,"_5":14833,"_28348":59472,"_3053":59949},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3585":2907,"_31232":2733,"_21602":59951,"_5":14833,"_28348":59480,"_3053":59952},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3585":2908,"_31232":2733,"_21602":59954,"_5":14833,"_28348":59480,"_3053":59955},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3585":2909,"_31232":2733,"_21602":59957,"_5":14833,"_28348":59480,"_3053":59958},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3585":2910,"_31232":2733,"_21602":59960,"_5":14833,"_28348":59480,"_3053":59961},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3585":2911,"_31232":2733,"_21602":59963,"_5":14833,"_28348":59480,"_3053":59964},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3585":2912,"_31232":2733,"_21602":59966,"_5":14833,"_28348":59484,"_3053":59967},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3585":2913,"_31232":2733,"_21602":59969,"_5":14833,"_28348":59488,"_3053":59970},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3585":2914,"_31232":2733,"_21602":59972,"_5":14833,"_28348":59488,"_3053":59973},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3585":2915,"_31232":2733,"_21602":59975,"_5":14833,"_28348":59488,"_3053":59976},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3585":2916,"_31232":2733,"_21602":59978,"_5":14833,"_28348":59488,"_3053":59979},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3585":2917,"_31232":2733,"_21602":59981,"_5":14833,"_28348":59488,"_3053":59982},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3585":2918,"_31232":2733,"_21602":59984,"_5":14833,"_28348":59488,"_3053":59985},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3585":2919,"_31232":2733,"_21602":59987,"_5":14833,"_28348":59488,"_3053":59988},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3585":2920,"_31232":2733,"_21602":59990,"_5":14833,"_28348":59488,"_3053":59991},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3585":2921,"_31232":2733,"_21602":59993,"_5":14833,"_28348":59492,"_3053":59994},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3585":2922,"_31232":2733,"_21602":59996,"_5":14833,"_28348":59500,"_3053":59997},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3585":2923,"_31232":2733,"_21602":59999,"_5":14833,"_28348":59500,"_3053":60000},[],"Field in 3.8.0",{"_3585":2924,"_31232":2733,"_21602":60002,"_5":14833,"_28348":59500,"_3053":60003},[],"Field in 4.0.0",{"_3585":2925,"_31232":2733,"_21602":60005,"_5":14833,"_28348":59500,"_3053":60006},[],"`validate_server_cert`",{"_3585":2926,"_31232":2733,"_21602":60008,"_5":14833,"_28348":59500,"_3053":60009},[],"`insecure_skip_verify` (value negated)",{"_3585":2927,"_31232":2733,"_21602":60011,"_5":14833,"_28348":59500,"_3053":60012},[],"`oidc`",{"_3585":2928,"_31232":2733,"_21602":60014,"_5":14833,"_28348":59500,"_3053":60015},[],"`jwt_options`",{"_3585":2929,"_31232":2733,"_21602":60017,"_5":14833,"_28348":59500,"_3053":60018},[],"`apikey`",{"_3585":2930,"_31232":2733,"_21602":60020,"_5":14833,"_28348":59500,"_3053":60021},[],"`apikey_options`",{"_3585":2931,"_31232":2733,"_21602":60023,"_5":14833,"_28348":59500,"_3053":60024},[],"`mtls`",{"_3585":2932,"_31232":2733,"_21602":60026,"_5":14833,"_28348":59500,"_3053":60027},[],"`mtls_options`",{"_3585":2933,"_31232":2733,"_21602":60029,"_5":14833,"_28348":59500,"_3053":60030},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3585":2934,"_31232":2733,"_21602":60032,"_5":14833,"_28348":59500,"_3053":60033},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3585":2935,"_31232":2733,"_21602":60035,"_5":14833,"_28348":59500,"_3053":60036},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3585":2936,"_31232":2733,"_21602":60038,"_5":14833,"_28348":59504,"_3053":60039},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3585":2937,"_31232":2733,"_21602":60041,"_5":14833,"_28348":59504,"_3053":60042},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3585":2938,"_31232":2733,"_21602":60044,"_5":14833,"_28348":59504,"_3053":60045},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3585":2939,"_31232":2733,"_21602":60047,"_5":14833,"_28348":59508,"_3053":60048},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3585":2940,"_31232":2733,"_21602":60050,"_5":14833,"_28348":59512,"_3053":60051},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3585":2941,"_31232":2733,"_21602":60053,"_5":14833,"_28348":59516,"_3053":60054},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3585":2942,"_31232":2733,"_21602":60056,"_5":14833,"_28348":59520,"_3053":60057},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3585":2943,"_31232":2733,"_21602":60059,"_5":14833,"_28348":59520,"_3053":60060},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3585":2944,"_31232":2733,"_21602":60062,"_5":14833,"_28348":59520,"_3053":60063},[],"`POST /v1/devices/:id/events` creates an event.",{"_3585":2945,"_31232":2733,"_21602":60065,"_5":14833,"_28348":59520,"_3053":60066},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3585":2946,"_31232":2733,"_21602":60068,"_5":14833,"_28348":59524,"_3053":60069},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3585":2947,"_31232":2733,"_21602":60071,"_5":14833,"_28348":59528,"_3053":60072},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3585":2948,"_31232":2733,"_21602":60074,"_5":14833,"_28348":59528,"_3053":60075},[],"Route",{"_3585":2949,"_31232":2733,"_21602":60077,"_5":14833,"_28348":59528,"_3053":54155},[],{"_3585":2950,"_31232":2733,"_21602":60079,"_5":14833,"_28348":59528,"_3053":60080},[],"`GET /v1/crl-settings`",{"_3585":2951,"_31232":2733,"_21602":60082,"_5":14833,"_28348":59528,"_3053":60083},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3585":2952,"_31232":2733,"_21602":60085,"_5":14833,"_28348":59528,"_3053":60086},[],"`GET /v1/crl-settings/{ca-id}`",{"_3585":2953,"_31232":2733,"_21602":60088,"_5":14833,"_28348":59528,"_3053":60089},[],"Reads the settings of a CA.",{"_3585":2954,"_31232":2733,"_21602":60091,"_5":14833,"_28348":59528,"_3053":60092},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3585":2955,"_31232":2733,"_21602":60094,"_5":14833,"_28348":59528,"_3053":60095},[],"Replaces `crl_options`.",{"_3585":2956,"_31232":2733,"_21602":60097,"_5":14833,"_28348":59528,"_3053":60098},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3585":2957,"_31232":2733,"_21602":60100,"_5":14833,"_28348":59528,"_3053":60101},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3585":2958,"_31232":2733,"_21602":60103,"_5":14833,"_28348":59528,"_3053":60104},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3585":2959,"_31232":2733,"_21602":60106,"_5":14833,"_28348":59528,"_3053":60107},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3585":2960,"_31232":2733,"_21602":60109,"_5":14833,"_28348":59528,"_3053":60110},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3585":2961,"_31232":2733,"_21602":60112,"_5":14833,"_28348":59528,"_3053":60113},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3585":2962,"_31232":2733,"_21602":60115,"_5":14833,"_28348":59528,"_3053":60116},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3585":2963,"_31232":2733,"_21602":60118,"_5":14833,"_28348":59528,"_3053":60119},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3585":2964,"_31232":2733,"_21602":60121,"_5":14833,"_28348":59528,"_3053":60122},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3585":2965,"_31232":2733,"_21602":60124,"_5":14833,"_28348":59528,"_3053":60125},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3585":2966,"_31232":2733,"_21602":60127,"_5":14833,"_28348":59528,"_3053":60128},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3585":2967,"_31232":2733,"_21602":60130,"_5":14833,"_28348":59532,"_3053":60131},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3585":2968,"_31232":2733,"_21602":60133,"_5":14833,"_28348":59536,"_3053":60134},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3585":2969,"_31232":2733,"_21602":60136,"_5":14833,"_28348":59540,"_3053":60137},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3585":2970,"_31232":2733,"_21602":60139,"_5":14833,"_28348":59544,"_3053":60140},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3585":2971,"_31232":2733,"_21602":60142,"_5":14833,"_28348":59548,"_3053":60143},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3585":2972,"_31232":2733,"_21602":60145,"_5":14833,"_28348":59548,"_3053":60146},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3585":2973,"_31232":2733,"_21602":60148,"_5":14833,"_28348":59548,"_3053":60149},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3585":2974,"_31232":2733,"_21602":60151,"_5":14833,"_28348":59548,"_3053":60152},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3585":2975,"_31232":2733,"_21602":60154,"_5":14833,"_28348":59548,"_3053":60155},[],"Record the names of your local-storage PVCs:",{"_3585":2976,"_31232":2733,"_21602":60157,"_5":14833,"_28348":59548,"_3053":60158},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3585":2977,"_31232":2733,"_21602":60160,"_5":14833,"_28348":59552,"_3053":60161},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3585":2978,"_31232":2733,"_21602":60163,"_5":14833,"_28348":59552,"_3053":60164},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3585":2979,"_31232":2733,"_21602":60166,"_5":14833,"_28348":59552,"_3053":60167},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3585":2980,"_31232":2733,"_21602":60169,"_5":14833,"_28348":59552,"_3053":60170},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3585":2981,"_31232":2733,"_21602":60172,"_5":14833,"_28348":59552,"_3053":60173},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3585":2982,"_31232":2733,"_21602":60175,"_5":14833,"_28348":59556,"_3053":60176},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3585":2983,"_31232":2733,"_21602":60178,"_5":14833,"_28348":59556,"_3053":60179},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3585":2984,"_31232":2733,"_21602":60181,"_5":14833,"_28348":59556,"_3053":60182},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3585":2985,"_31232":2733,"_21602":60184,"_5":14833,"_28348":59556,"_3053":60185},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3585":2986,"_31232":2733,"_21602":60187,"_5":14833,"_28348":59556,"_3053":60188},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3585":2987,"_31232":2733,"_21602":60190,"_5":14833,"_28348":59556,"_3053":60191},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3585":2988,"_31232":2733,"_21602":60193,"_5":14833,"_28348":59556,"_3053":60194},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3585":2989,"_31232":2733,"_21602":60196,"_5":14833,"_28348":59556,"_3053":60197},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3585":2990,"_31232":2733,"_21602":60199,"_5":14833,"_28348":59556,"_3053":60200},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3585":2991,"_31232":2733,"_21602":60202,"_5":14833,"_28348":59556,"_3053":60203},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3585":2992,"_31232":2733,"_21602":60205,"_5":14833,"_28348":59556,"_3053":60206},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3585":2993,"_31232":2733,"_21602":60208,"_5":14833,"_28348":59556,"_3053":60209},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3585":2994,"_31232":2733,"_21602":60211,"_5":14833,"_28348":59560,"_3053":60212},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3585":2995,"_31232":2733,"_21602":60214,"_5":14833,"_28348":59560,"_3053":60215},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3585":2996,"_31232":2733,"_21602":60217,"_5":14833,"_28348":59564,"_3053":60218},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3585":2997,"_31232":2733,"_21602":60220,"_5":14833,"_28348":59564,"_3053":60221},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3585":2998,"_31232":2733,"_21602":60223,"_5":14833,"_28348":59564,"_3053":60224},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3585":2999,"_31232":2733,"_21602":60226,"_5":14833,"_28348":59564,"_3053":60227},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3585":3000,"_31232":2733,"_21602":60229,"_5":14833,"_28348":59564,"_3053":60230},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3585":3001,"_31232":2733,"_21602":60232,"_5":14833,"_28348":59564,"_3053":60233},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3585":3002,"_31232":2733,"_21602":60235,"_5":14833,"_28348":59564,"_3053":60236},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3585":3003,"_31232":2733,"_21602":60238,"_5":14833,"_28348":59564,"_3053":60239},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3585":3004,"_31232":2733,"_21602":60241,"_5":14833,"_28348":59564,"_3053":60242},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3585":3005,"_31232":2733,"_21602":60244,"_5":14833,"_28348":59564,"_3053":60245},[],"**Remove the helper and restore the recorded replica counts:**",{"_3585":3006,"_31232":2733,"_21602":60247,"_5":14833,"_28348":59564,"_3053":60248},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3585":3007,"_31232":2733,"_21602":60250,"_5":14833,"_28348":59568,"_3053":60251},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3585":3008,"_31232":2733,"_21602":60253,"_5":14833,"_28348":59568,"_3053":60254},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3585":3009,"_31232":2733,"_21602":60256,"_5":14833,"_28348":59572,"_3053":60257},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3585":3010,"_31232":2733,"_21602":60259,"_5":14833,"_28348":59572,"_3053":60260},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3585":3011,"_31232":2733,"_21602":60262,"_5":14833,"_28348":59572,"_3053":60263},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3585":3012,"_31232":2733,"_21602":60265,"_5":14833,"_28348":59572,"_3053":60266},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3585":3013,"_31232":2733,"_21602":60268,"_5":14833,"_28348":59572,"_3053":60269},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3585":3014,"_31232":2733,"_21602":60271,"_5":14833,"_28348":59572,"_3053":60272},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3585":3015,"_31232":2733,"_21602":60274,"_5":14833,"_28348":59572,"_3053":60275},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3585":3016,"_31232":2733,"_21602":60277,"_5":14833,"_28348":59572,"_3053":60278},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3585":3017,"_31232":2733,"_21602":60280,"_5":14833,"_28348":59576,"_3053":60281},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3585":3018,"_31232":2733,"_21602":60283,"_5":14833,"_28348":59576,"_3053":60284},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3585":3019,"_31232":2733,"_21602":60286,"_5":14833,"_28348":59576,"_3053":60287},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3585":3020,"_31232":2733,"_21602":60289,"_5":14833,"_28348":59576,"_3053":60290},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3585":3021,"_31232":2733,"_21602":60292,"_5":14833,"_28348":59576,"_3053":60293},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3585":3022,"_31232":2733,"_21602":60295,"_5":14833,"_28348":59576,"_3053":60296},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3585":3023,"_31232":2733,"_21602":60298,"_5":14833,"_28348":59576,"_3053":60299},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3585":3024,"_31232":2733,"_21602":60301,"_5":14833,"_28348":59576,"_3053":60302},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3585":3025,"_31232":2733,"_21602":60304,"_5":14833,"_28348":59576,"_3053":60305},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3585":3026,"_31232":2733,"_21602":60307,"_5":14833,"_28348":59576,"_3053":60308},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3585":3027,"_31232":2733,"_21602":60310,"_5":14833,"_28348":59576,"_3053":60311},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3585":3028,"_31232":2733,"_21602":60313,"_5":14833,"_28348":59579,"_3053":60314},[],"After the upgrade, check in this order:",{"_3585":3029,"_31232":2733,"_21602":60316,"_5":14833,"_28348":59579,"_3053":60317},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3585":3030,"_31232":2733,"_21602":60319,"_5":14833,"_28348":59579,"_3053":60320},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3585":3031,"_31232":2733,"_21602":60322,"_5":14833,"_28348":59579,"_3053":60323},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3585":3032,"_31232":2733,"_21602":60325,"_5":14833,"_28348":59579,"_3053":60326},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3585":3033,"_31232":2733,"_21602":60328,"_5":14833,"_28348":59579,"_3053":60329},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3585":3034,"_31232":2733,"_21602":60331,"_5":14833,"_28348":59579,"_3053":60332},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3585":3035,"_31232":2733,"_21602":60334,"_5":14833,"_28348":59579,"_3053":60335},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3585":3036,"_31232":2733,"_21602":60337,"_5":14833,"_28348":59579,"_3053":60338},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3585":3037,"_31232":2733,"_21602":60340,"_5":14833,"_28348":59579,"_3053":60341},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3585":3038,"_31232":2733,"_21602":60343,"_5":14833,"_28348":59579,"_3053":60344},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3585":3039,"_31232":2733,"_21602":60346,"_5":14833,"_28348":59579,"_3053":60347},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3585":3040,"_31232":2733,"_21602":60349,"_5":14833,"_28348":59579,"_3053":60350},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3585":3041,"_31232":2733,"_21602":60352,"_5":14833,"_28348":59579,"_3053":60353},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3585":3042,"_31232":2733,"_21602":60355,"_5":14833,"_28348":59579,"_3053":60356},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3585":3043,"_31232":2733,"_21602":60358,"_5":14833,"_28348":59579,"_3053":60359},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3585":3044,"_31232":2733,"_21602":60361,"_5":14833,"_28348":59583,"_3053":60362},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3585":3045,"_31232":2733,"_21602":60364,"_5":14833,"_28348":59583,"_3053":60365},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3585":3046,"_31232":2733,"_21602":60367,"_5":14833,"_28348":59583,"_3053":60368},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3585":3047,"_31232":2733,"_21602":60370,"_5":14833,"_28348":59583,"_3053":60371},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3585":3048,"_31232":2733,"_21602":60373,"_5":14833,"_28348":59583,"_3053":60374},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60377":60378,"_60379":60380,"_60381":60382,"_60383":60384,"_18735":3088,"_72534":3088},"language","english","sortableProperties",[3053,31232,5,28348],"sortablePropertiesWithTypes",{"_3053":25854,"_31232":25854,"_5":25854,"_28348":25854},"sorts",{"_3053":60385,"_31232":63423,"_5":66460,"_28348":69497},{"_4816":60386,"_60387":60388,"_5":25854},{"_3679":3374,"_15308":6636,"_15327":7222,"_3666":4619,"_15314":3270,"_20512":5662,"_14939":6262,"_14946":18120,"_30149":7910,"_30571":7785,"_30591":10611,"_30183":4540,"_35670":4884,"_30290":7479,"_30635":7809,"_35677":6200,"_35680":7349,"_35683":7941,"_35686":3541,"_31058":4106,"_35691":28609,"_35693":3375,"_31088":6245,"_15323":6750,"_35697":3466,"_35700":9176,"_35702":6470,"_30619":4913,"_31053":5812,"_31101":10106,"_35707":8463,"_35709":7896,"_35711":5231,"_30307":3153,"_35714":6257,"_35716":3177,"_35718":16308,"_35720":3806,"_35722":4925,"_30224":4939,"_35725":16344,"_3669":6458,"_30218":7907,"_30656":4352,"_35730":6493,"_35732":6216,"_35735":3515,"_30264":7251,"_35739":23782,"_30140":5699,"_35742":17800,"_30188":4923,"_35745":7936,"_35747":3131,"_35750":3797,"_15317":4887,"_35753":6774,"_35755":18530,"_35758":7258,"_35760":4664,"_31291":4089,"_35763":6285,"_35765":8747,"_20515":13637,"_35768":3388,"_35770":4764,"_30161":3486,"_30613":10674,"_35774":9418,"_35776":4550,"_35778":3392,"_31118":16229,"_35781":7870,"_35783":6084,"_35785":7861,"_31212":5176,"_30672":25861,"_35789":11694,"_35791":5758,"_30203":3859,"_35794":3782,"_35796":7525,"_35798":3405,"_31134":4618,"_30284":6892,"_29639":13192,"_35803":3163,"_35805":3789,"_35807":3168,"_30333":6255,"_35811":5982,"_30607":7390,"_35815":25863,"_35817":6825,"_35819":4117,"_35821":5491,"_35823":3124,"_35825":4768,"_30322":6085,"_3682":5321,"_