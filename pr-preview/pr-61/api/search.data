4":125937,"_40486":125940,"_40488":125943,"_40490":125946,"_40493":125949,"_40495":125952,"_40497":125955,"_40499":125958,"_40501":125961,"_40503":125964,"_40505":125967,"_40507":125970,"_40509":125973,"_40511":125976,"_40513":125979,"_40515":125982,"_40517":125985,"_40519":125988,"_40521":125991,"_40523":125994,"_40525":125997,"_40527":126000,"_40529":126003,"_40531":126006,"_40533":126009,"_40535":126012,"_40537":126015,"_40539":126018,"_40541":126021,"_40543":126024,"_40546":126027,"_40548":126030,"_40550":126033},{"_3496":70607,"_30262":70607,"_5":14825,"_2978":117011,"_30620":117012,"_21040":117015,"_27550":70607},"Despliega desde AWS Marketplace",[49507,117013,117014],"Despliegue","Otros modelos",[],{"_3496":70608,"_30262":70607,"_21040":117017,"_5":14474,"_27550":70607,"_2978":117018},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3496":70609,"_30262":70607,"_5":30617,"_21040":117020,"_27550":117021,"_2978":117022},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3496":70610,"_30262":70607,"_5":30617,"_21040":117024,"_27550":117025,"_2978":117026},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3496":70611,"_30262":70607,"_5":30617,"_21040":117028,"_27550":117029,"_2978":117030},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3496":70612,"_30262":70607,"_5":30617,"_21040":117032,"_27550":117033,"_2978":117034},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3496":70613,"_30262":70607,"_5":30617,"_21040":117036,"_27550":117037,"_2978":117038},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3496":70614,"_30262":70607,"_5":30617,"_21040":117040,"_27550":117041,"_2978":117042},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3496":70615,"_30262":70607,"_5":30617,"_21040":117044,"_27550":117045,"_2978":117046},[],"/docs/pr-preview/pr-61/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3496":70616,"_30262":70607,"_21040":117048,"_5":14474,"_27550":70607,"_2978":117049},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3496":70617,"_30262":70607,"_21040":117051,"_5":14474,"_27550":117021,"_2978":117052},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3496":70618,"_30262":70607,"_21040":117054,"_5":14474,"_27550":117021,"_2978":117055},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3496":70619,"_30262":70607,"_21040":117057,"_5":14474,"_27550":117021,"_2978":117058},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3496":70620,"_30262":70607,"_21040":117060,"_5":14474,"_27550":117025,"_2978":117061},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3496":70621,"_30262":70607,"_21040":117063,"_5":14474,"_27550":117025,"_2978":117064},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3496":70622,"_30262":70607,"_21040":117066,"_5":14474,"_27550":117025,"_2978":117067},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3496":70623,"_30262":70607,"_21040":117069,"_5":14474,"_27550":117029,"_2978":117070},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3496":70624,"_30262":70607,"_21040":117072,"_5":14474,"_27550":117033,"_2978":117073},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3496":70625,"_30262":70607,"_21040":117075,"_5":14474,"_27550":117037,"_2978":117076},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3496":70626,"_30262":70607,"_21040":117078,"_5":14474,"_27550":117041,"_2978":117079},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3496":70627,"_30262":70607,"_21040":117081,"_5":14474,"_27550":117045,"_2978":117082},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3496":70628,"_30262":70628,"_5":14825,"_2978":117084,"_30620":117085,"_21040":117086,"_27550":70628},"Despliega Lamassu",[49507,117013],[],{"_3496":70629,"_30262":70628,"_21040":117088,"_5":14474,"_27550":70628,"_2978":117089},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3496":70630,"_30262":70628,"_5":30617,"_21040":117091,"_27550":117092,"_2978":117093},[],"/docs/pr-preview/pr-61/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3496":70631,"_30262":70628,"_5":30617,"_21040":117095,"_27550":117096,"_2978":117097},[],"/docs/pr-preview/pr-61/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3496":70632,"_30262":70628,"_5":30617,"_21040":117099,"_27550":117100,"_2978":117101},[],"/docs/pr-preview/pr-61/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3496":70633,"_30262":70628,"_21040":117103,"_5":14474,"_27550":70628,"_2978":117104},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3496":70634,"_30262":70628,"_21040":117106,"_5":14474,"_27550":117092,"_2978":117107},[],"Modelo",{"_3496":70635,"_30262":70628,"_21040":117109,"_5":14474,"_27550":117092,"_2978":117110},[],"Recomendado para",{"_3496":70636,"_30262":70628,"_21040":117112,"_5":14474,"_27550":117092,"_2978":117113},[],"Quién opera la infraestructura",{"_3496":70637,"_30262":70628,"_21040":117115,"_5":14474,"_27550":117092,"_2978":117116},[],"Punto de partida",{"_3496":70638,"_30262":70628,"_21040":117118,"_5":14474,"_27550":117092,"_2978":49614},[],{"_3496":70639,"_30262":70628,"_21040":117120,"_5":14474,"_27550":117092,"_2978":117121},[],"Producción, entornos regulados y despliegues personalizados",{"_3496":70640,"_30262":70628,"_21040":117123,"_5":14474,"_27550":117092,"_2978":117124},[],"Tu equipo",{"_3496":70641,"_30262":70628,"_21040":117126,"_5":14474,"_27550":117092,"_2978":117127},[],"Helm o Fastlane",{"_3496":70642,"_30262":70628,"_21040":117129,"_5":14474,"_27550":117092,"_2978":49626},[],{"_3496":70643,"_30262":70628,"_21040":117131,"_5":14474,"_27550":117092,"_2978":117132},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3496":70644,"_30262":70628,"_21040":117134,"_5":14474,"_27550":117092,"_2978":117124},[],{"_3496":70645,"_30262":70628,"_21040":117136,"_5":14474,"_27550":117092,"_2978":117137},[],"Imagen preconfigurada en EC2",{"_3496":70646,"_30262":70628,"_21040":117139,"_5":14474,"_27550":117092,"_2978":49637},[],{"_3496":70647,"_30262":70628,"_21040":117141,"_5":14474,"_27550":117092,"_2978":117142},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3496":70648,"_30262":70628,"_21040":117144,"_5":14474,"_27550":117092,"_2978":49643},[],{"_3496":70649,"_30262":70628,"_21040":117146,"_5":14474,"_27550":117092,"_2978":117147},[],"Suscripción gestionada",{"_3496":70650,"_30262":70628,"_21040":117149,"_5":14474,"_27550":117092,"_2978":117150},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3496":70651,"_30262":70628,"_21040":117152,"_5":14474,"_27550":117092,"_2978":117153},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3496":70652,"_30262":70628,"_21040":117155,"_5":14474,"_27550":117092,"_2978":117156},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3496":70653,"_30262":70628,"_21040":117158,"_5":14474,"_27550":117096,"_2978":117159},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3496":70654,"_30262":70628,"_21040":117161,"_5":14474,"_27550":117100,"_2978":117162},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3496":70655,"_30262":70655,"_5":14825,"_2978":117164,"_30620":117165,"_21040":117166,"_27550":70655},"Utiliza Lamassu como SaaS",[49507,117013,117014],[],{"_3496":70656,"_30262":70655,"_21040":117168,"_5":14474,"_27550":70655,"_2978":117169},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3496":70657,"_30262":70655,"_5":30617,"_21040":117171,"_27550":117172,"_2978":117173},[],"/docs/pr-preview/pr-61/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3496":70658,"_30262":70655,"_5":30617,"_21040":117175,"_27550":117176,"_2978":117177},[],"/docs/pr-preview/pr-61/es/deployment/saas#planes","Planes",{"_3496":70659,"_30262":70655,"_5":30617,"_21040":117179,"_27550":117180,"_2978":117181},[],"/docs/pr-preview/pr-61/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3496":70660,"_30262":70655,"_21040":117183,"_5":14474,"_27550":70655,"_2978":117184},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3496":70661,"_30262":70655,"_21040":117186,"_5":14474,"_27550":117172,"_2978":117187},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3496":70662,"_30262":70655,"_21040":117189,"_5":14474,"_27550":117172,"_2978":117190},[],"Copias de seguridad automáticas.",{"_3496":70663,"_30262":70655,"_21040":117192,"_5":14474,"_27550":117172,"_2978":117193},[],"Actualizaciones de versión.",{"_3496":70664,"_30262":70655,"_21040":117195,"_5":14474,"_27550":117172,"_2978":117196},[],"Soporte técnico y SLA según el plan contratado.",{"_3496":70665,"_30262":70655,"_21040":117198,"_5":14474,"_27550":117176,"_2978":49698},[],{"_3496":70666,"_30262":70655,"_21040":117200,"_5":14474,"_27550":117176,"_2978":117201},[],"Dispositivos",{"_3496":70667,"_30262":70655,"_21040":117203,"_5":14474,"_27550":117176,"_2978":117204},[],"Soporte",{"_3496":70668,"_30262":70655,"_21040":117206,"_5":14474,"_27550":117176,"_2978":49707},[],{"_3496":70669,"_30262":70655,"_21040":117208,"_5":14474,"_27550":117176,"_2978":49710},[],{"_3496":70670,"_30262":70655,"_21040":117210,"_5":14474,"_27550":117176,"_2978":117211},[],"Hasta 1.000",{"_3496":70671,"_30262":70655,"_21040":117213,"_5":14474,"_27550":117176,"_2978":49716},[],{"_3496":70672,"_30262":70655,"_21040":117215,"_5":14474,"_27550":117176,"_2978":117216},[],"99,5 %",{"_3496":70673,"_30262":70655,"_21040":117218,"_5":14474,"_27550":117176,"_2978":49722},[],{"_3496":70674,"_30262":70655,"_21040":117220,"_5":14474,"_27550":117176,"_2978":117221},[],"Hasta 10.000",{"_3496":70675,"_30262":70655,"_21040":117223,"_5":14474,"_27550":117176,"_2978":117224},[],"Email y chat",{"_3496":70676,"_30262":70655,"_21040":117226,"_5":14474,"_27550":117176,"_2978":117227},[],"99,9 %",{"_3496":70677,"_30262":70655,"_21040":117229,"_5":14474,"_27550":117176,"_2978":49734},[],{"_3496":70678,"_30262":70655,"_21040":117231,"_5":14474,"_27550":117176,"_2978":117232},[],"Ilimitados",{"_3496":70679,"_30262":70655,"_21040":117234,"_5":14474,"_27550":117176,"_2978":117235},[],"Dedicado",{"_3496":70680,"_30262":70655,"_21040":117237,"_5":14474,"_27550":117176,"_2978":117238},[],"99,99 %",{"_3496":70681,"_30262":70655,"_21040":117240,"_5":14474,"_27550":117180,"_2978":117241},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3496":70682,"_30262":70655,"_21040":117243,"_5":14474,"_27550":117180,"_2978":117244},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3496":70683,"_30262":70683,"_5":14825,"_2978":49751,"_30620":117246,"_21040":117248,"_27550":70683},[49507,117013,117247],"Kubernetes autogestionado",[],{"_3496":70684,"_30262":70683,"_21040":117250,"_5":14474,"_27550":70683,"_2978":117251},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3496":70685,"_30262":70683,"_5":30617,"_21040":117253,"_27550":117254,"_2978":117255},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3496":70686,"_30262":70683,"_5":30617,"_21040":117257,"_27550":117258,"_2978":117259},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3496":70687,"_30262":70683,"_5":30617,"_21040":117261,"_27550":117262,"_2978":117263},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3496":70688,"_30262":70683,"_5":30617,"_21040":117265,"_27550":117266,"_2978":117267},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3496":70689,"_30262":70683,"_5":30617,"_21040":117269,"_27550":117270,"_2978":117271},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3496":70690,"_30262":70683,"_5":30617,"_21040":117273,"_27550":117274,"_2978":117275},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3496":70691,"_30262":70683,"_5":30617,"_21040":117277,"_27550":117278,"_2978":117279},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3496":70692,"_30262":70683,"_5":30617,"_21040":117281,"_27550":117282,"_2978":117283},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3496":70693,"_30262":70683,"_5":30617,"_21040":117285,"_27550":117286,"_2978":117287},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3496":70694,"_30262":70683,"_5":30617,"_21040":117289,"_27550":117290,"_2978":117291},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3496":70695,"_30262":70683,"_5":30617,"_21040":117293,"_27550":117294,"_2978":117295},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3496":70696,"_30262":70683,"_21040":117297,"_5":14474,"_27550":117254,"_2978":117298},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3496":70697,"_30262":70683,"_21040":117300,"_5":14474,"_27550":117254,"_2978":117301},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3496":70698,"_30262":70683,"_21040":117303,"_5":14474,"_27550":117258,"_2978":117304},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3496":70699,"_30262":70683,"_21040":117306,"_5":14474,"_27550":117258,"_2978":117307},[],"Fastlane instala o configura",{"_3496":70700,"_30262":70683,"_21040":117309,"_5":14474,"_27550":117258,"_2978":117310},[],"Tú sigues proporcionando",{"_3496":70701,"_30262":70683,"_21040":117312,"_5":14474,"_27550":117258,"_2978":117313},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3496":70702,"_30262":70683,"_21040":117315,"_5":14474,"_27550":117258,"_2978":117316},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3496":70703,"_30262":70683,"_21040":117318,"_5":14474,"_27550":117258,"_2978":117319},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3496":70704,"_30262":70683,"_21040":117321,"_5":14474,"_27550":117258,"_2978":117322},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3496":70705,"_30262":70683,"_21040":117324,"_5":14474,"_27550":117258,"_2978":117325},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3496":70706,"_30262":70683,"_21040":117327,"_5":14474,"_27550":117258,"_2978":117328},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3496":70707,"_30262":70683,"_21040":117330,"_5":14474,"_27550":117258,"_2978":117331},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3496":70708,"_30262":70683,"_21040":117333,"_5":14474,"_27550":117258,"_2978":117334},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3496":70709,"_30262":70683,"_21040":117336,"_5":14474,"_27550":117258,"_2978":117337},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3496":70710,"_30262":70683,"_21040":117339,"_5":14474,"_27550":117262,"_2978":117340},[],"Necesitas:",{"_3496":70711,"_30262":70683,"_21040":117342,"_5":14474,"_27550":117262,"_2978":117343},[],"un clúster Kubernetes existente",{"_3496":70712,"_30262":70683,"_21040":117345,"_5":14474,"_27550":117262,"_2978":117346},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3496":70713,"_30262":70683,"_21040":117348,"_5":14474,"_27550":117262,"_2978":49853},[],{"_3496":70714,"_30262":70683,"_21040":117350,"_5":14474,"_27550":117262,"_2978":23776},[],{"_3496":70715,"_30262":70683,"_21040":117352,"_5":14474,"_27550":117262,"_2978":117353},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3496":70716,"_30262":70683,"_21040":117355,"_5":14474,"_27550":117262,"_2978":117356},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3496":70717,"_30262":70683,"_21040":117358,"_5":14474,"_27550":117262,"_2978":117359},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3496":70718,"_30262":70683,"_21040":117361,"_5":14474,"_27550":117262,"_2978":117362},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3496":70719,"_30262":70683,"_21040":117364,"_5":14474,"_27550":117262,"_2978":117365},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3496":70720,"_30262":70683,"_21040":117367,"_5":14474,"_27550":117266,"_2978":117368},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3496":70721,"_30262":70683,"_21040":117370,"_5":14474,"_27550":117266,"_2978":117371},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3496":70722,"_30262":70683,"_21040":117373,"_5":14474,"_27550":117270,"_2978":117374},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3496":70723,"_30262":70683,"_21040":117376,"_5":14474,"_27550":117270,"_2978":117377},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3496":70724,"_30262":70683,"_21040":117379,"_5":14474,"_27550":117270,"_2978":117380},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3496":70725,"_30262":70683,"_21040":117382,"_5":14474,"_27550":117270,"_2978":117383},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3496":70726,"_30262":70683,"_21040":117385,"_5":14474,"_27550":117274,"_2978":117386},[],"Opción",{"_3496":70727,"_30262":70683,"_21040":117388,"_5":14474,"_27550":117274,"_2978":117389},[],"Valor predeterminado",{"_3496":70728,"_30262":70683,"_21040":117391,"_5":14474,"_27550":117274,"_2978":117392},[],"Propósito",{"_3496":70729,"_30262":70683,"_21040":117394,"_5":14474,"_27550":117274,"_2978":49900},[],{"_3496":70730,"_30262":70683,"_21040":117396,"_5":14474,"_27550":117274,"_2978":49903},[],{"_3496":70731,"_30262":70683,"_21040":117398,"_5":14474,"_27550":117274,"_2978":117399},[],"Muestra la ayuda",{"_3496":70732,"_30262":70683,"_21040":117401,"_5":14474,"_27550":117274,"_2978":49909},[],{"_3496":70733,"_30262":70683,"_21040":117403,"_5":14474,"_27550":117274,"_2978":117404},[],"contexto actual",{"_3496":70734,"_30262":70683,"_21040":117406,"_5":14474,"_27550":117274,"_2978":117407},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3496":70735,"_30262":70683,"_21040":117409,"_5":14474,"_27550":117274,"_2978":49918},[],{"_3496":70736,"_30262":70683,"_21040":117411,"_5":14474,"_27550":117274,"_2978":6608},[],{"_3496":70737,"_30262":70683,"_21040":117413,"_5":14474,"_27550":117274,"_2978":117414},[],"Omite prompts y genera credenciales para las dependencias",{"_3496":70738,"_30262":70683,"_21040":117416,"_5":14474,"_27550":117274,"_2978":49926},[],{"_3496":70739,"_30262":70683,"_21040":117418,"_5":14474,"_27550":117274,"_2978":49929},[],{"_3496":70740,"_30262":70683,"_21040":117420,"_5":14474,"_27550":117274,"_2978":117421},[],"Namespace de la instalación",{"_3496":70741,"_30262":70683,"_21040":117423,"_5":14474,"_27550":117274,"_2978":49935},[],{"_3496":70742,"_30262":70683,"_21040":117425,"_5":14474,"_27550":117274,"_2978":49938},[],{"_3496":70743,"_30262":70683,"_21040":117427,"_5":14474,"_27550":117274,"_2978":117428},[],"Dominio usado por la UI, OIDC y el certificado",{"_3496":70744,"_30262":70683,"_21040":117430,"_5":14474,"_27550":117274,"_2978":49944},[],{"_3496":70745,"_30262":70683,"_21040":117432,"_5":14474,"_27550":117274,"_2978":15171},[],{"_3496":70746,"_30262":70683,"_21040":117434,"_5":14474,"_27550":117274,"_2978":117435},[],"Versión del chart de Lamassu",{"_3496":70747,"_30262":70683,"_21040":117437,"_5":14474,"_27550":117274,"_2978":49952},[],{"_3496":70748,"_30262":70683,"_21040":117439,"_5":14474,"_27550":117274,"_2978":49955},[],{"_3496":70749,"_30262":70683,"_21040":117441,"_5":14474,"_27550":117274,"_2978":117442},[],"Puerto del listener HTTPS",{"_3496":70750,"_30262":70683,"_21040":117444,"_5":14474,"_27550":117274,"_2978":49961},[],{"_3496":70751,"_30262":70683,"_21040":117446,"_5":14474,"_27550":117274,"_2978":49964},[],{"_3496":70752,"_30262":70683,"_21040":117448,"_5":14474,"_27550":117274,"_2978":117449},[],"Puerto del listener HTTP",{"_3496":70753,"_30262":70683,"_21040":117451,"_5":14474,"_27550":117274,"_2978":49970},[],{"_3496":70754,"_30262":70683,"_21040":117453,"_5":14474,"_27550":117274,"_2978":49903},[],{"_3496":70755,"_30262":70683,"_21040":117455,"_5":14474,"_27550":117274,"_2978":117456},[],"Certificado PEM para TLS downstream",{"_3496":70756,"_30262":70683,"_21040":117458,"_5":14474,"_27550":117274,"_2978":49978},[],{"_3496":70757,"_30262":70683,"_21040":117460,"_5":14474,"_27550":117274,"_2978":49903},[],{"_3496":70758,"_30262":70683,"_21040":117462,"_5":14474,"_27550":117274,"_2978":117463},[],"Clave privada PEM para TLS downstream",{"_3496":70759,"_30262":70683,"_21040":117465,"_5":14474,"_27550":117274,"_2978":49986},[],{"_3496":70760,"_30262":70683,"_21040":117467,"_5":14474,"_27550":117274,"_2978":117468},[],"chart del repositorio",{"_3496":70761,"_30262":70683,"_21040":117470,"_5":14474,"_27550":117274,"_2978":117471},[],"Usa un chart local de Lamassu sin empaquetar",{"_3496":70762,"_30262":70683,"_21040":117473,"_5":14474,"_27550":117274,"_2978":49995},[],{"_3496":70763,"_30262":70683,"_21040":117475,"_5":14474,"_27550":117274,"_2978":117476},[],"detección automática",{"_3496":70764,"_30262":70683,"_21040":117478,"_5":14474,"_27550":117274,"_2978":117479},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3496":70765,"_30262":70683,"_21040":117481,"_5":14474,"_27550":117274,"_2978":50003},[],{"_3496":70766,"_30262":70683,"_21040":117483,"_5":14474,"_27550":117274,"_2978":6608},[],{"_3496":70767,"_30262":70683,"_21040":117485,"_5":14474,"_27550":117274,"_2978":117486},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3496":70768,"_30262":70683,"_21040":117488,"_5":14474,"_27550":117274,"_2978":50011},[],{"_3496":70769,"_30262":70683,"_21040":117490,"_5":14474,"_27550":117274,"_2978":6608},[],{"_3496":70770,"_30262":70683,"_21040":117492,"_5":14474,"_27550":117274,"_2978":117493},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3496":70771,"_30262":70683,"_21040":117495,"_5":14474,"_27550":117274,"_2978":50019},[],{"_3496":70772,"_30262":70683,"_21040":117497,"_5":14474,"_27550":117274,"_2978":6608},[],{"_3496":70773,"_30262":70683,"_21040":117499,"_5":14474,"_27550":117274,"_2978":117500},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3496":70774,"_30262":70683,"_21040":117502,"_5":14474,"_27550":117274,"_2978":50027},[],{"_3496":70775,"_30262":70683,"_21040":117504,"_5":14474,"_27550":117274,"_2978":6608},[],{"_3496":70776,"_30262":70683,"_21040":117506,"_5":14474,"_27550":117274,"_2978":117507},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3496":70777,"_30262":70683,"_21040":117509,"_5":14474,"_27550":117274,"_2978":50035},[],{"_3496":70778,"_30262":70683,"_21040":117511,"_5":14474,"_27550":117274,"_2978":50038},[],{"_3496":70779,"_30262":70683,"_21040":117513,"_5":14474,"_27550":117274,"_2978":117514},[],"Usa otro chart local de SoftHSM",{"_3496":70780,"_30262":70683,"_21040":117516,"_5":14474,"_27550":117274,"_2978":117517},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3496":70781,"_30262":70683,"_21040":117519,"_5":14474,"_27550":117278,"_2978":117520},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3496":70782,"_30262":70683,"_21040":117522,"_5":14474,"_27550":117278,"_2978":117523},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3496":70783,"_30262":70683,"_21040":117525,"_5":14474,"_27550":117278,"_2978":117526},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3496":70784,"_30262":70683,"_21040":117528,"_5":14474,"_27550":117278,"_2978":117529},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3496":70785,"_30262":70683,"_21040":117531,"_5":14474,"_27550":117278,"_2978":117532},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3496":70786,"_30262":70683,"_21040":117534,"_5":14474,"_27550":117278,"_2978":117535},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3496":70787,"_30262":70683,"_21040":117537,"_5":14474,"_27550":117282,"_2978":50065},[],{"_3496":70788,"_30262":70683,"_21040":117539,"_5":14474,"_27550":117282,"_2978":117540},[],"valida las herramientas locales y el clúster seleccionado",{"_3496":70789,"_30262":70683,"_21040":117542,"_5":14474,"_27550":117282,"_2978":117543},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3496":70790,"_30262":70683,"_21040":117545,"_5":14474,"_27550":117282,"_2978":117546},[],"crea el namespace",{"_3496":70791,"_30262":70683,"_21040":117548,"_5":14474,"_27550":117282,"_2978":117549},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3496":70792,"_30262":70683,"_21040":117551,"_5":14474,"_27550":117282,"_2978":117552},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3496":70793,"_30262":70683,"_21040":117554,"_5":14474,"_27550":117282,"_2978":117555},[],"instala RabbitMQ",{"_3496":70794,"_30262":70683,"_21040":117557,"_5":14474,"_27550":117282,"_2978":117558},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3496":70795,"_30262":70683,"_21040":117560,"_5":14474,"_27550":117282,"_2978":117561},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3496":70796,"_30262":70683,"_21040":117563,"_5":14474,"_27550":117282,"_2978":117564},[],"carga datos de ejemplo opcionalmente",{"_3496":70797,"_30262":70683,"_21040":117566,"_5":14474,"_27550":117282,"_2978":117567},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3496":70798,"_30262":70683,"_21040":117569,"_5":14474,"_27550":117286,"_2978":117570},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3496":70799,"_30262":70683,"_21040":117572,"_5":14474,"_27550":117286,"_2978":117573},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3496":70800,"_30262":70683,"_21040":117575,"_5":14474,"_27550":117290,"_2978":117576},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3496":70801,"_30262":70683,"_21040":117578,"_5":14474,"_27550":117290,"_2978":117579},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3496":70802,"_30262":70683,"_21040":117581,"_5":14474,"_27550":117290,"_2978":117582},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3496":70803,"_30262":70683,"_21040":117584,"_5":14474,"_27550":117294,"_2978":117585},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3496":70804,"_30262":70804,"_5":14825,"_2978":117587,"_30620":117588,"_21040":117589,"_27550":70804},"Instala con Helm",[49507,117013,117247],[],{"_3496":70805,"_30262":70804,"_21040":117591,"_5":14474,"_27550":70804,"_2978":117592},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3496":70806,"_30262":70804,"_5":30617,"_21040":117594,"_27550":117595,"_2978":117596},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3496":70807,"_30262":70804,"_5":30617,"_21040":117598,"_27550":117599,"_2978":117263},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3496":70808,"_30262":70804,"_5":30617,"_21040":117601,"_27550":117602,"_2978":117603},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3496":70809,"_30262":70804,"_5":30617,"_21040":117605,"_27550":117606,"_2978":117607},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3496":70810,"_30262":70804,"_5":30617,"_21040":117609,"_27550":117610,"_2978":117611},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3496":70811,"_30262":70804,"_5":30617,"_21040":117613,"_27550":117614,"_2978":117615},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3496":70812,"_30262":70804,"_5":30617,"_21040":117617,"_27550":117618,"_2978":117619},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3496":70813,"_30262":70804,"_5":30617,"_21040":117621,"_27550":117622,"_2978":117623},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3496":70814,"_30262":70804,"_5":30617,"_21040":117625,"_27550":117626,"_2978":117627},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3496":70815,"_30262":70804,"_5":30617,"_21040":117629,"_27550":117630,"_2978":117631},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3496":70816,"_30262":70804,"_5":30617,"_21040":117633,"_27550":117634,"_2978":117635},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3496":70817,"_30262":70804,"_21040":117637,"_5":14474,"_27550":117595,"_2978":117638},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3496":70818,"_30262":70804,"_21040":117640,"_5":14474,"_27550":117599,"_2978":117641},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3496":70819,"_30262":70804,"_21040":117643,"_5":14474,"_27550":117599,"_2978":117644},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3496":70820,"_30262":70804,"_21040":117646,"_5":14474,"_27550":117599,"_2978":117647},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3496":70821,"_30262":70804,"_21040":117649,"_5":14474,"_27550":117599,"_2978":117650},[],"un broker RabbitMQ accesible y sus credenciales",{"_3496":70822,"_30262":70804,"_21040":117652,"_5":14474,"_27550":117599,"_2978":117653},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3496":70823,"_30262":70804,"_21040":117655,"_5":14474,"_27550":117599,"_2978":117656},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3496":70824,"_30262":70804,"_21040":117658,"_5":14474,"_27550":117599,"_2978":117659},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3496":70825,"_30262":70804,"_21040":117661,"_5":14474,"_27550":117599,"_2978":117662},[],"una StorageClass y un diseño de tráfico externo",{"_3496":70826,"_30262":70804,"_21040":117664,"_5":14474,"_27550":117599,"_2978":117665},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3496":70827,"_30262":70804,"_21040":117667,"_5":14474,"_27550":117599,"_2978":117668},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3496":70828,"_30262":70804,"_21040":117670,"_5":14474,"_27550":117599,"_2978":117671},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3496":70829,"_30262":70804,"_21040":117673,"_5":14474,"_27550":117602,"_2978":117674},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3496":70830,"_30262":70804,"_21040":117676,"_5":14474,"_27550":117602,"_2978":117677},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3496":70831,"_30262":70804,"_21040":117679,"_5":14474,"_27550":117602,"_2978":117680},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3496":70832,"_30262":70804,"_21040":117682,"_5":14474,"_27550":117606,"_2978":117683},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3496":70833,"_30262":70804,"_21040":117685,"_5":14474,"_27550":117606,"_2978":117686},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3496":70834,"_30262":70804,"_21040":117688,"_5":14474,"_27550":117606,"_2978":117689},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3496":70835,"_30262":70804,"_21040":117691,"_5":14474,"_27550":117606,"_2978":117692},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3496":70836,"_30262":70804,"_21040":117694,"_5":14474,"_27550":117610,"_2978":117695},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3496":70837,"_30262":70804,"_21040":117697,"_5":14474,"_27550":117614,"_2978":117698},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3496":70838,"_30262":70804,"_21040":117700,"_5":14474,"_27550":117614,"_2978":117701},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3496":70839,"_30262":70804,"_21040":117703,"_5":14474,"_27550":117614,"_2978":117704},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3496":70840,"_30262":70804,"_21040":117706,"_5":14474,"_27550":117614,"_2978":117707},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3496":70841,"_30262":70804,"_21040":117709,"_5":14474,"_27550":117614,"_2978":117710},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3496":70842,"_30262":70804,"_21040":117712,"_5":14474,"_27550":117614,"_2978":117713},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3496":70843,"_30262":70804,"_21040":117715,"_5":14474,"_27550":117614,"_2978":117716},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3496":70844,"_30262":70804,"_21040":117718,"_5":14474,"_27550":117618,"_2978":117719},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3496":70845,"_30262":70804,"_21040":117721,"_5":14474,"_27550":117618,"_2978":117722},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3496":70846,"_30262":70804,"_21040":117724,"_5":14474,"_27550":117618,"_2978":117725},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3496":70847,"_30262":70804,"_21040":117727,"_5":14474,"_27550":117618,"_2978":117728},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3496":70848,"_30262":70804,"_21040":117730,"_5":14474,"_27550":117622,"_2978":117731},[],"Para instalar un checkout local:",{"_3496":70849,"_30262":70804,"_21040":117733,"_5":14474,"_27550":117626,"_2978":117734},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3496":70850,"_30262":70804,"_21040":117736,"_5":14474,"_27550":117626,"_2978":117737},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3496":70851,"_30262":70804,"_21040":117739,"_5":14474,"_27550":117630,"_2978":117740},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3496":70852,"_30262":70804,"_21040":117742,"_5":14474,"_27550":117630,"_2978":117743},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3496":70853,"_30262":70804,"_21040":117745,"_5":14474,"_27550":117630,"_2978":117746},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3496":70854,"_30262":70804,"_21040":117748,"_5":14474,"_27550":117630,"_2978":117749},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3496":70855,"_30262":70804,"_21040":117751,"_5":14474,"_27550":117630,"_2978":117752},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3496":70856,"_30262":70804,"_21040":117754,"_5":14474,"_27550":117634,"_2978":117755},[],"Antes de pasar a producción, revisa:",{"_3496":70857,"_30262":70804,"_21040":117757,"_5":14474,"_27550":117634,"_2978":117758},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3496":70858,"_30262":70804,"_21040":117760,"_5":14474,"_27550":117634,"_2978":117761},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3496":70859,"_30262":70804,"_21040":117763,"_5":14474,"_27550":117634,"_2978":117764},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3496":70860,"_30262":70804,"_21040":117766,"_5":14474,"_27550":117634,"_2978":117767},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3496":70861,"_30262":70804,"_21040":117769,"_5":14474,"_27550":117634,"_2978":117770},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3496":70862,"_30262":70804,"_21040":117772,"_5":14474,"_27550":117634,"_2978":117773},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3496":70863,"_30262":70804,"_21040":117775,"_5":14474,"_27550":117634,"_2978":117776},[],"SMTP, observabilidad y entrega de alertas",{"_3496":70864,"_30262":70804,"_21040":117778,"_5":14474,"_27550":117634,"_2978":117779},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3496":70865,"_30262":70804,"_21040":117781,"_5":14474,"_27550":117634,"_2978":117782},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3496":70866,"_30262":70866,"_5":14825,"_2978":117784,"_30620":117785,"_21040":117786,"_27550":70866},"Expón el Gateway",[49507,117013,117247],[],{"_3496":70867,"_30262":70866,"_21040":117788,"_5":14474,"_27550":70866,"_2978":117789},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3496":70868,"_30262":70866,"_5":30617,"_21040":117791,"_27550":117792,"_2978":117793},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3496":70869,"_30262":70866,"_5":30617,"_21040":117795,"_27550":117796,"_2978":117797},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3496":70870,"_30262":70866,"_5":30617,"_21040":117799,"_27550":117800,"_2978":117801},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3496":70871,"_30262":70866,"_5":30617,"_21040":117803,"_27550":117804,"_2978":50333},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#k3s",{"_3496":70872,"_30262":70866,"_5":30617,"_21040":117806,"_27550":117807,"_2978":117808},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3496":70873,"_30262":70866,"_5":30617,"_21040":117810,"_27550":117811,"_2978":117812},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3496":70874,"_30262":70866,"_5":30617,"_21040":117814,"_27550":117815,"_2978":117816},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3496":70875,"_30262":70866,"_5":30617,"_21040":117818,"_27550":117819,"_2978":117820},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3496":70876,"_30262":70866,"_5":30617,"_21040":117822,"_27550":117823,"_2978":117824},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3496":70877,"_30262":70866,"_5":30617,"_21040":117826,"_27550":117827,"_2978":117828},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3496":70878,"_30262":70866,"_21040":117830,"_5":14474,"_27550":117792,"_2978":117831},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3496":70879,"_30262":70866,"_21040":117833,"_5":14474,"_27550":117792,"_2978":117834},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3496":70880,"_30262":70866,"_21040":117836,"_5":14474,"_27550":117796,"_2978":117837},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3496":70881,"_30262":70866,"_21040":117839,"_5":14474,"_27550":117796,"_2978":117840},[],"Defínelo únicamente cuando:",{"_3496":70882,"_30262":70866,"_21040":117842,"_5":14474,"_27550":117796,"_2978":117843},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3496":70883,"_30262":70866,"_21040":117845,"_5":14474,"_27550":117796,"_2978":117846},[],"esa dirección está asignada a este Gateway",{"_3496":70884,"_30262":70866,"_21040":117848,"_5":14474,"_27550":117796,"_2978":117849},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3496":70885,"_30262":70866,"_21040":117851,"_5":14474,"_27550":117796,"_2978":117852},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3496":70886,"_30262":70866,"_21040":117854,"_5":14474,"_27550":117796,"_2978":117855},[],"No confundas estos valores:",{"_3496":70887,"_30262":70866,"_21040":117857,"_5":14474,"_27550":117796,"_2978":117858},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3496":70888,"_30262":70866,"_21040":117860,"_5":14474,"_27550":117796,"_2978":117861},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3496":70889,"_30262":70866,"_21040":117863,"_5":14474,"_27550":117796,"_2978":117864},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3496":70890,"_30262":70866,"_21040":117866,"_5":14474,"_27550":117800,"_2978":117867},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3496":70891,"_30262":70866,"_21040":117869,"_5":14474,"_27550":117800,"_2978":117870},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3496":70892,"_30262":70866,"_21040":117872,"_5":14474,"_27550":117804,"_2978":117873},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3496":70893,"_30262":70866,"_21040":117875,"_5":14474,"_27550":117804,"_2978":117876},[],"Para el diseño recomendado:",{"_3496":70894,"_30262":70866,"_21040":117878,"_5":14474,"_27550":117804,"_2978":117879},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3496":70895,"_30262":70866,"_21040":117881,"_5":14474,"_27550":117804,"_2978":117882},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3496":70896,"_30262":70866,"_21040":117884,"_5":14474,"_27550":117804,"_2978":117885},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3496":70897,"_30262":70866,"_21040":117887,"_5":14474,"_27550":117804,"_2978":117888},[],"Apunta DNS a la dirección accesible de la VM.",{"_3496":70898,"_30262":70866,"_21040":117890,"_5":14474,"_27550":117804,"_2978":117891},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3496":70899,"_30262":70866,"_21040":117893,"_5":14474,"_27550":117807,"_2978":117894},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3496":70900,"_30262":70866,"_21040":117896,"_5":14474,"_27550":117811,"_2978":117897},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3496":70901,"_30262":70866,"_21040":117899,"_5":14474,"_27550":117811,"_2978":117900},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3496":70902,"_30262":70866,"_21040":117902,"_5":14474,"_27550":117815,"_2978":117903},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3496":70903,"_30262":70866,"_21040":117905,"_5":14474,"_27550":117815,"_2978":117906},[],"Requisito",{"_3496":70904,"_30262":70866,"_21040":117908,"_5":14474,"_27550":117815,"_2978":117909},[],"Diseño recomendado",{"_3496":70905,"_30262":70866,"_21040":117911,"_5":14474,"_27550":117815,"_2978":117912},[],"Consecuencia",{"_3496":70906,"_30262":70866,"_21040":117914,"_5":14474,"_27550":117815,"_2978":117915},[],"Varias URL o servicios de Lamassu",{"_3496":70907,"_30262":70866,"_21040":117917,"_5":14474,"_27550":117815,"_2978":117918},[],"Un Gateway con varias rutas",{"_3496":70908,"_30262":70866,"_21040":117920,"_5":14474,"_27550":117815,"_2978":117921},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3496":70909,"_30262":70866,"_21040":117923,"_5":14474,"_27550":117815,"_2978":117924},[],"Gateways independientes e IP externas distintas",{"_3496":70910,"_30262":70866,"_21040":117926,"_5":14474,"_27550":117815,"_2978":117927},[],"Una VIP por Gateway",{"_3496":70911,"_30262":70866,"_21040":117929,"_5":14474,"_27550":117815,"_2978":117930},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3496":70912,"_30262":70866,"_21040":117932,"_5":14474,"_27550":117815,"_2978":117933},[],"Gateways independientes, un nodo y una IP",{"_3496":70913,"_30262":70866,"_21040":117935,"_5":14474,"_27550":117815,"_2978":117936},[],"Puertos externos diferentes",{"_3496":70914,"_30262":70866,"_21040":117938,"_5":14474,"_27550":117815,"_2978":117939},[],"Los clientes deben indicar puertos no estándar",{"_3496":70915,"_30262":70866,"_21040":117941,"_5":14474,"_27550":117815,"_2978":117942},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3496":70916,"_30262":70866,"_21040":117944,"_5":14474,"_27550":117815,"_2978":117945},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3496":70917,"_30262":70866,"_21040":117947,"_5":14474,"_27550":117815,"_2978":117948},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3496":70918,"_30262":70866,"_21040":117950,"_5":14474,"_27550":117815,"_2978":117951},[],"Recursos Gateway separados pero proxy compartido",{"_3496":70919,"_30262":70866,"_21040":117953,"_5":14474,"_27550":117815,"_2978":117954},[],"Modo merged Gateway de Envoy",{"_3496":70920,"_30262":70866,"_21040":117956,"_5":14474,"_27550":117815,"_2978":117957},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3496":70921,"_30262":70866,"_21040":117959,"_5":14474,"_27550":117815,"_2978":117960},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3496":70922,"_30262":70866,"_21040":117962,"_5":14474,"_27550":117815,"_2978":117963},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3496":70923,"_30262":70866,"_21040":117965,"_5":14474,"_27550":117815,"_2978":117966},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3496":70924,"_30262":70866,"_21040":117968,"_5":14474,"_27550":117815,"_2978":117969},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3496":70925,"_30262":70866,"_21040":117971,"_5":14474,"_27550":117819,"_2978":117972},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3496":70926,"_30262":70866,"_21040":117974,"_5":14474,"_27550":117819,"_2978":117975},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3496":70927,"_30262":70866,"_21040":117977,"_5":14474,"_27550":117819,"_2978":117978},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3496":70928,"_30262":70866,"_21040":117980,"_5":14474,"_27550":117819,"_2978":117981},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3496":70929,"_30262":70866,"_21040":117983,"_5":14474,"_27550":117819,"_2978":117984},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3496":70930,"_30262":70866,"_21040":117986,"_5":14474,"_27550":117823,"_2978":117987},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3496":70931,"_30262":70866,"_21040":117989,"_5":14474,"_27550":117823,"_2978":117990},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3496":70932,"_30262":70866,"_21040":117992,"_5":14474,"_27550":117827,"_2978":117993},[],"Comprueba, en orden:",{"_3496":70933,"_30262":70866,"_21040":117995,"_5":14474,"_27550":117827,"_2978":117996},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3496":70934,"_30262":70866,"_21040":117998,"_5":14474,"_27550":117827,"_2978":117999},[],"Su estado contiene la dirección esperada.",{"_3496":70935,"_30262":70866,"_21040":118001,"_5":14474,"_27550":117827,"_2978":118002},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3496":70936,"_30262":70866,"_21040":118004,"_5":14474,"_27550":117827,"_2978":118005},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3496":70937,"_30262":70866,"_21040":118007,"_5":14474,"_27550":117827,"_2978":118008},[],"DNS resuelve al endpoint accesible externamente.",{"_3496":70938,"_30262":70866,"_21040":118010,"_5":14474,"_27550":117827,"_2978":118011},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3496":70939,"_30262":70866,"_21040":118013,"_5":14474,"_27550":117827,"_2978":118014},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3496":70940,"_30262":70940,"_5":14825,"_2978":49614,"_30620":118016,"_21040":118017,"_27550":70940},[49507,117013,117247],[],{"_3496":70941,"_30262":70940,"_21040":118019,"_5":14474,"_27550":70940,"_2978":118020},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3496":70942,"_30262":70940,"_5":30617,"_21040":118022,"_27550":118023,"_2978":118024},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3496":70943,"_30262":70940,"_5":30617,"_21040":118026,"_27550":118027,"_2978":118028},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3496":70944,"_30262":70940,"_5":30617,"_21040":118030,"_27550":118031,"_2978":118032},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3496":70945,"_30262":70940,"_5":30617,"_21040":118034,"_27550":118035,"_2978":118036},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3496":70946,"_30262":70940,"_5":30617,"_21040":118038,"_27550":118039,"_2978":118040},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3496":70947,"_30262":70940,"_5":30617,"_21040":118042,"_27550":118043,"_2978":118044},[],"/docs/pr-preview/pr-61/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3496":70948,"_30262":70940,"_21040":118046,"_5":14474,"_27550":118023,"_2978":118047},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3496":70949,"_30262":70940,"_21040":118049,"_5":14474,"_27550":118027,"_2978":118050},[],"Flujo",{"_3496":70950,"_30262":70940,"_21040":118052,"_5":14474,"_27550":118027,"_2978":118053},[],"Úsalo para",{"_3496":70951,"_30262":70940,"_21040":118055,"_5":14474,"_27550":118027,"_2978":118056},[],"Qué instala",{"_3496":70952,"_30262":70940,"_21040":118058,"_5":14474,"_27550":118027,"_2978":50588},[],{"_3496":70953,"_30262":70940,"_21040":118060,"_5":14474,"_27550":118027,"_2978":118061},[],"Producción y entornos controlados",{"_3496":70954,"_30262":70940,"_21040":118063,"_5":14474,"_27550":118027,"_2978":118064},[],"Servicios de Lamassu y recursos de Gateway API",{"_3496":70955,"_30262":70940,"_21040":118066,"_5":14474,"_27550":118027,"_2978":49751},[],{"_3496":70956,"_30262":70940,"_21040":118068,"_5":14474,"_27550":118027,"_2978":118069},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3496":70957,"_30262":70940,"_21040":118071,"_5":14474,"_27550":118027,"_2978":118072},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3496":70958,"_30262":70940,"_21040":118074,"_5":14474,"_27550":118031,"_2978":118075},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3496":70959,"_30262":70940,"_21040":118077,"_5":14474,"_27550":118031,"_2978":118078},[],"Área",{"_3496":70960,"_30262":70940,"_21040":118080,"_5":14474,"_27550":118031,"_2978":118081},[],"El chart de Lamassu proporciona",{"_3496":70961,"_30262":70940,"_21040":118083,"_5":14474,"_27550":118031,"_2978":118084},[],"Tú proporcionas",{"_3496":70962,"_30262":70940,"_21040":118086,"_5":14474,"_27550":118031,"_2978":118087},[],"Aplicaciones Lamassu",{"_3496":70963,"_30262":70940,"_21040":118089,"_5":14474,"_27550":118031,"_2978":118090},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3496":70964,"_30262":70940,"_21040":118092,"_5":14474,"_27550":118031,"_2978":118093},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3496":70965,"_30262":70940,"_21040":118095,"_5":14474,"_27550":118031,"_2978":118096},[],"Datos PostgreSQL",{"_3496":70966,"_30262":70940,"_21040":118098,"_5":14474,"_27550":118031,"_2978":118099},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3496":70967,"_30262":70940,"_21040":118101,"_5":14474,"_27550":118031,"_2978":118102},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3496":70968,"_30262":70940,"_21040":118104,"_5":14474,"_27550":118031,"_2978":118105},[],"Mensajería",{"_3496":70969,"_30262":70940,"_21040":118107,"_5":14474,"_27550":118031,"_2978":118108},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3496":70970,"_30262":70940,"_21040":118110,"_5":14474,"_27550":118031,"_2978":118111},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3496":70971,"_30262":70940,"_21040":118113,"_5":14474,"_27550":118031,"_2978":118114},[],"Identidad",{"_3496":70972,"_30262":70940,"_21040":118116,"_5":14474,"_27550":118031,"_2978":118117},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3496":70973,"_30262":70940,"_21040":118119,"_5":14474,"_27550":118031,"_2978":118120},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3496":70974,"_30262":70940,"_21040":118122,"_5":14474,"_27550":118031,"_2978":118123},[],"Enrutamiento externo",{"_3496":70975,"_30262":70940,"_21040":118125,"_5":14474,"_27550":118031,"_2978":118126},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3496":70976,"_30262":70940,"_21040":118128,"_5":14474,"_27550":118031,"_2978":118129},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3496":70977,"_30262":70940,"_21040":118131,"_5":14474,"_27550":118031,"_2978":50662},[],{"_3496":70978,"_30262":70940,"_21040":118133,"_5":14474,"_27550":118031,"_2978":118134},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3496":70979,"_30262":70940,"_21040":118136,"_5":14474,"_27550":118031,"_2978":118137},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3496":70980,"_30262":70940,"_21040":118139,"_5":14474,"_27550":118031,"_2978":118140},[],"Datos persistentes de la aplicación",{"_3496":70981,"_30262":70940,"_21040":118142,"_5":14474,"_27550":118031,"_2978":118143},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3496":70982,"_30262":70940,"_21040":118145,"_5":14474,"_27550":118031,"_2978":118146},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3496":70983,"_30262":70940,"_21040":118148,"_5":14474,"_27550":118031,"_2978":118149},[],"Integraciones opcionales",{"_3496":70984,"_30262":70940,"_21040":118151,"_5":14474,"_27550":118031,"_2978":118152},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3496":70985,"_30262":70940,"_21040":118154,"_5":14474,"_27550":118031,"_2978":118155},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3496":70986,"_30262":70940,"_21040":118157,"_5":14474,"_27550":118031,"_2978":118158},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3496":70987,"_30262":70940,"_21040":118160,"_5":14474,"_27550":118031,"_2978":118161},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3496":70988,"_30262":70940,"_21040":118163,"_5":14474,"_27550":118035,"_2978":118164},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3496":70989,"_30262":70940,"_21040":118166,"_5":14474,"_27550":118035,"_2978":118167},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3496":70990,"_30262":70940,"_21040":118169,"_5":14474,"_27550":118039,"_2978":118170},[],"Kubernetes 1.24 o posterior",{"_3496":70991,"_30262":70940,"_21040":118172,"_5":14474,"_27550":118039,"_2978":118173},[],"Helm 3.2 o posterior",{"_3496":70992,"_30262":70940,"_21040":118175,"_5":14474,"_27550":118039,"_2978":118176},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3496":70993,"_30262":70940,"_21040":118178,"_5":14474,"_27550":118039,"_2978":118179},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3496":70994,"_30262":70940,"_21040":118181,"_5":14474,"_27550":118039,"_2978":118182},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3496":70995,"_30262":70940,"_21040":118184,"_5":14474,"_27550":118039,"_2978":118185},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3496":70996,"_30262":70940,"_21040":118187,"_5":14474,"_27550":118039,"_2978":118188},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3496":70997,"_30262":70940,"_21040":118190,"_5":14474,"_27550":118043,"_2978":118191},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3496":70998,"_30262":70940,"_21040":118193,"_5":14474,"_27550":118043,"_2978":118194},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3496":70999,"_30262":70940,"_21040":118196,"_5":14474,"_27550":118043,"_2978":118197},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3496":71000,"_30262":70940,"_21040":118199,"_5":14474,"_27550":118043,"_2978":118200},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3496":71001,"_30262":71001,"_5":14825,"_2978":118202,"_30620":118203,"_21040":118205,"_27550":71001},"Resolución de problemas de despliegue",[49507,117013,118204],"Operación",[],{"_3496":71002,"_30262":71001,"_21040":118207,"_5":14474,"_27550":71001,"_2978":118208},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3496":71003,"_30262":71001,"_5":30617,"_21040":118210,"_27550":118211,"_2978":118212},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3496":71004,"_30262":71001,"_5":30617,"_21040":118214,"_27550":118215,"_2978":118216},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3496":71005,"_30262":71001,"_5":30617,"_21040":118218,"_27550":118219,"_2978":118220},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3496":71006,"_30262":71001,"_5":30617,"_21040":118222,"_27550":118223,"_2978":118224},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3496":71007,"_30262":71001,"_5":30617,"_21040":118226,"_27550":118227,"_2978":118228},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3496":71008,"_30262":71001,"_5":30617,"_21040":118230,"_27550":118231,"_2978":118232},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3496":71009,"_30262":71001,"_5":30617,"_21040":118234,"_27550":118235,"_2978":118236},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3496":71010,"_30262":71001,"_5":30617,"_21040":118238,"_27550":118239,"_2978":118240},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3496":71011,"_30262":71001,"_5":30617,"_21040":118242,"_27550":118243,"_2978":118244},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3496":71012,"_30262":71001,"_5":30617,"_21040":118246,"_27550":118247,"_2978":118248},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3496":71013,"_30262":71001,"_5":30617,"_21040":118250,"_27550":118251,"_2978":118252},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3496":71014,"_30262":71001,"_5":30617,"_21040":118254,"_27550":118255,"_2978":118256},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3496":71015,"_30262":71001,"_5":30617,"_21040":118258,"_27550":118259,"_2978":118260},[],"/docs/pr-preview/pr-61/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3496":71016,"_30262":71001,"_21040":118262,"_5":14474,"_27550":71001,"_2978":118263},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3496":71017,"_30262":71001,"_21040":118265,"_5":14474,"_27550":118215,"_2978":118266},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3496":71018,"_30262":71001,"_21040":118268,"_5":14474,"_27550":118219,"_2978":118269},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3496":71019,"_30262":71001,"_21040":118271,"_5":14474,"_27550":118223,"_2978":118272},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3496":71020,"_30262":71001,"_21040":118274,"_5":14474,"_27550":118227,"_2978":118275},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3496":71021,"_30262":71001,"_21040":118277,"_5":14474,"_27550":118231,"_2978":118278},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3496":71022,"_30262":71001,"_21040":118280,"_5":14474,"_27550":118235,"_2978":118281},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3496":71023,"_30262":71001,"_21040":118283,"_5":14474,"_27550":118235,"_2978":118284},[],"Ejecuta también la prueba de conectividad del chart:",{"_3496":71024,"_30262":71001,"_21040":118286,"_5":14474,"_27550":118235,"_2978":118287},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3496":71025,"_30262":71001,"_21040":118289,"_5":14474,"_27550":118235,"_2978":118290},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3496":71026,"_30262":71001,"_21040":118292,"_5":14474,"_27550":118239,"_2978":118293},[],"Si recibes un 401:",{"_3496":71027,"_30262":71001,"_21040":118295,"_5":14474,"_27550":118239,"_2978":118296},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3496":71028,"_30262":71001,"_21040":118298,"_5":14474,"_27550":118239,"_2978":118299},[],"verifica emisor, audiencia y expiración del token;",{"_3496":71029,"_30262":71001,"_21040":118301,"_5":14474,"_27550":118239,"_2978":118302},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3496":71030,"_30262":71001,"_21040":118304,"_5":14474,"_27550":118239,"_2978":118305},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3496":71031,"_30262":71001,"_21040":118307,"_5":14474,"_27550":118239,"_2978":118308},[],"Si el login termina pero las APIs devuelven 403:",{"_3496":71032,"_30262":71001,"_21040":118310,"_5":14474,"_27550":118239,"_2978":118311},[],"inspecciona los claims reales del token;",{"_3496":71033,"_30262":71001,"_21040":118313,"_5":14474,"_27550":118239,"_2978":118314},[],"confirma que coinciden con un principal activo;",{"_3496":71034,"_30262":71001,"_21040":118316,"_5":14474,"_27550":118239,"_2978":118317},[],"revisa las políticas concedidas al principal;",{"_3496":71035,"_30262":71001,"_21040":118319,"_5":14474,"_27550":118239,"_2978":118320},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3496":71036,"_30262":71001,"_21040":118322,"_5":14474,"_27550":118239,"_2978":118323},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3496":71037,"_30262":71001,"_21040":118325,"_5":14474,"_27550":118243,"_2978":118326},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3496":71038,"_30262":71001,"_21040":118328,"_5":14474,"_27550":118243,"_2978":118329},[],"Localiza el pod y Service de authz.",{"_3496":71039,"_30262":71001,"_21040":118331,"_5":14474,"_27550":118243,"_2978":118332},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3496":71040,"_30262":71001,"_21040":118334,"_5":14474,"_27550":118243,"_2978":118335},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3496":71041,"_30262":71001,"_21040":118337,"_5":14474,"_27550":118243,"_2978":118338},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3496":71042,"_30262":71001,"_21040":118340,"_5":14474,"_27550":118243,"_2978":118341},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3496":71043,"_30262":71001,"_21040":118343,"_5":14474,"_27550":118247,"_2978":118344},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3496":71044,"_30262":71001,"_21040":118346,"_5":14474,"_27550":118251,"_2978":118347},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3496":71045,"_30262":71001,"_21040":118349,"_5":14474,"_27550":118251,"_2978":118350},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3496":71046,"_30262":71001,"_21040":118352,"_5":14474,"_27550":118251,"_2978":118353},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3496":71047,"_30262":71001,"_21040":118355,"_5":14474,"_27550":118251,"_2978":118356},[],"volumen persistente sin enlazar;",{"_3496":71048,"_30262":71001,"_21040":118358,"_5":14474,"_27550":118251,"_2978":118359},[],"imagen inaccesible o política de pull incorrecta;",{"_3496":71049,"_30262":71001,"_21040":118361,"_5":14474,"_27550":118251,"_2978":118362},[],"configuración inválida del motor criptográfico;",{"_3496":71050,"_30262":71001,"_21040":118364,"_5":14474,"_27550":118251,"_2978":118365},[],"límites de CPU o memoria demasiado bajos;",{"_3496":71051,"_30262":71001,"_21040":118367,"_5":14474,"_27550":118251,"_2978":118368},[],"migración previa incompleta.",{"_3496":71052,"_30262":71001,"_21040":118370,"_5":14474,"_27550":118251,"_2978":118371},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3496":71053,"_30262":71001,"_21040":118373,"_5":14474,"_27550":118251,"_2978":118374},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3496":71054,"_30262":71001,"_21040":118376,"_5":14474,"_27550":118251,"_2978":118377},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3496":71055,"_30262":71001,"_21040":118379,"_5":14474,"_27550":118255,"_2978":118380},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3496":71056,"_30262":71001,"_21040":118382,"_5":14474,"_27550":118255,"_2978":118383},[],"verifica que esté habilitado en el servicio emisor;",{"_3496":71057,"_30262":71001,"_21040":118385,"_5":14474,"_27550":118255,"_2978":118386},[],"comprueba conectividad y credenciales AMQP;",{"_3496":71058,"_30262":71001,"_21040":118388,"_5":14474,"_27550":118255,"_2978":118389},[],"revisa exchange, routing key, colas y consumidores;",{"_3496":71059,"_30262":71001,"_21040":118391,"_5":14474,"_27550":118255,"_2978":118392},[],"inspecciona dead-letter queues;",{"_3496":71060,"_30262":71001,"_21040":118394,"_5":14474,"_27550":118255,"_2978":118395},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3496":71061,"_30262":71001,"_21040":118397,"_5":14474,"_27550":118255,"_2978":118398},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3496":71062,"_30262":71001,"_21040":118400,"_5":14474,"_27550":118255,"_2978":118401},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3496":71063,"_30262":71001,"_21040":118403,"_5":14474,"_27550":118255,"_2978":118404},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3496":71064,"_30262":71001,"_21040":118406,"_5":14474,"_27550":118255,"_2978":118407},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3496":71065,"_30262":71001,"_21040":118409,"_5":14474,"_27550":118255,"_2978":118410},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3496":71066,"_30262":71001,"_21040":118412,"_5":14474,"_27550":118255,"_2978":118413},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3496":71067,"_30262":71001,"_21040":118415,"_5":14474,"_27550":118255,"_2978":118416},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3496":71068,"_30262":71001,"_21040":118418,"_5":14474,"_27550":118259,"_2978":118419},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3496":71069,"_30262":71001,"_21040":118421,"_5":14474,"_27550":118259,"_2978":118422},[],"Antes de cerrar una incidencia, guarda:",{"_3496":71070,"_30262":71001,"_21040":118424,"_5":14474,"_27550":118259,"_2978":118425},[],"causa confirmada;",{"_3496":71071,"_30262":71001,"_21040":118427,"_5":14474,"_27550":118259,"_2978":118428},[],"alcance temporal y recursos afectados;",{"_3496":71072,"_30262":71001,"_21040":118430,"_5":14474,"_27550":118259,"_2978":118431},[],"comandos o consultas utilizados;",{"_3496":71073,"_30262":71001,"_21040":118433,"_5":14474,"_27550":118259,"_2978":118434},[],"cambio aplicado y forma de revertirlo;",{"_3496":71074,"_30262":71001,"_21040":118436,"_5":14474,"_27550":118259,"_2978":118437},[],"validación desde un consumidor;",{"_3496":71075,"_30262":71001,"_21040":118439,"_5":14474,"_27550":118259,"_2978":118440},[],"acción preventiva y propietario.",{"_3496":71076,"_30262":71076,"_5":14825,"_2978":118442,"_30620":118443,"_21040":118446,"_27550":71076},"Control de acceso",[49507,118444,118445],"Plataforma","Administración",[],{"_3496":71077,"_30262":71076,"_21040":118448,"_5":14474,"_27550":71076,"_2978":118449},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3496":71078,"_30262":71076,"_5":30617,"_21040":118451,"_27550":118452,"_2978":118453},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3496":71079,"_30262":71076,"_5":30617,"_21040":118455,"_27550":118456,"_2978":118457},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3496":71080,"_30262":71076,"_5":30617,"_21040":118459,"_27550":118460,"_2978":118461},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3496":71081,"_30262":71076,"_5":30617,"_21040":118463,"_27550":118464,"_2978":118465},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3496":71082,"_30262":71076,"_5":30617,"_21040":118467,"_27550":118468,"_2978":118469},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3496":71083,"_30262":71076,"_5":30617,"_21040":118471,"_27550":118472,"_2978":118473},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3496":71084,"_30262":71076,"_5":30617,"_21040":118475,"_27550":118476,"_2978":118477},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3496":71085,"_30262":71076,"_5":30617,"_21040":118479,"_27550":118480,"_2978":118481},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3496":71086,"_30262":71076,"_5":30617,"_21040":118483,"_27550":118484,"_2978":118485},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3496":71087,"_30262":71076,"_5":30617,"_21040":118487,"_27550":118488,"_2978":118489},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3496":71088,"_30262":71076,"_5":30617,"_21040":118491,"_27550":118492,"_2978":118493},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3496":71089,"_30262":71076,"_5":30617,"_21040":118495,"_27550":118496,"_2978":118497},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3496":71090,"_30262":71076,"_5":30617,"_21040":118499,"_27550":118500,"_2978":118501},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3496":71091,"_30262":71076,"_5":30617,"_21040":118503,"_27550":118504,"_2978":118505},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3496":71092,"_30262":71076,"_5":30617,"_21040":118507,"_27550":118508,"_2978":118509},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3496":71093,"_30262":71076,"_5":30617,"_21040":118511,"_27550":118512,"_2978":117619},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3496":71094,"_30262":71076,"_5":30617,"_21040":118514,"_27550":118515,"_2978":118516},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3496":71095,"_30262":71076,"_5":30617,"_21040":118518,"_27550":118519,"_2978":118520},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3496":71096,"_30262":71076,"_5":30617,"_21040":118522,"_27550":118523,"_2978":118524},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3496":71097,"_30262":71076,"_5":30617,"_21040":118526,"_27550":118527,"_2978":118528},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3496":71098,"_30262":71076,"_5":30617,"_21040":118530,"_27550":118531,"_2978":118532},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3496":71099,"_30262":71076,"_5":30617,"_21040":118534,"_27550":118535,"_2978":118536},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3496":71100,"_30262":71076,"_5":30617,"_21040":118538,"_27550":118539,"_2978":118540},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3496":71101,"_30262":71076,"_5":30617,"_21040":118542,"_27550":118543,"_2978":118544},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3496":71102,"_30262":71076,"_5":30617,"_21040":118546,"_27550":118547,"_2978":118548},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3496":71103,"_30262":71076,"_5":30617,"_21040":118550,"_27550":118551,"_2978":118552},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3496":71104,"_30262":71076,"_5":30617,"_21040":118554,"_27550":118555,"_2978":118556},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3496":71105,"_30262":71076,"_5":30617,"_21040":118558,"_27550":118559,"_2978":118560},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3496":71106,"_30262":71076,"_5":30617,"_21040":118562,"_27550":118563,"_2978":118564},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3496":71107,"_30262":71076,"_5":30617,"_21040":118566,"_27550":118567,"_2978":118568},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3496":71108,"_30262":71076,"_5":30617,"_21040":118570,"_27550":118571,"_2978":118572},[],"/docs/pr-preview/pr-61/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3496":71109,"_30262":71076,"_21040":118574,"_5":14474,"_27550":71076,"_2978":118575},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3496":71110,"_30262":71076,"_21040":118577,"_5":14474,"_27550":71076,"_2978":118578},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3496":71111,"_30262":71076,"_21040":118580,"_5":14474,"_27550":71076,"_2978":118581},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3496":71112,"_30262":71076,"_21040":118583,"_5":14474,"_27550":118452,"_2978":118584},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3496":71113,"_30262":71076,"_21040":118586,"_5":14474,"_27550":118452,"_2978":118587},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3496":71114,"_30262":71076,"_21040":118589,"_5":14474,"_27550":118452,"_2978":118590},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3496":71115,"_30262":71076,"_21040":118592,"_5":14474,"_27550":118452,"_2978":118593},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3496":71116,"_30262":71076,"_21040":118595,"_5":14474,"_27550":118452,"_2978":118596},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3496":71117,"_30262":71076,"_21040":118598,"_5":14474,"_27550":118452,"_2978":118599},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3496":71118,"_30262":71076,"_21040":118601,"_5":14474,"_27550":118456,"_2978":118602},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3496":71119,"_30262":71076,"_21040":118604,"_5":14474,"_27550":118456,"_2978":118605},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3496":71120,"_30262":71076,"_21040":118607,"_5":14474,"_27550":118460,"_2978":118608},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3496":71121,"_30262":71076,"_21040":118610,"_5":14474,"_27550":118460,"_2978":118611},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3496":71122,"_30262":71076,"_21040":118613,"_5":14474,"_27550":118460,"_2978":118614},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3496":71123,"_30262":71076,"_21040":118616,"_5":14474,"_27550":118460,"_2978":118617},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3496":71124,"_30262":71076,"_21040":118619,"_5":14474,"_27550":118460,"_2978":118620},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3496":71125,"_30262":71076,"_21040":118622,"_5":14474,"_27550":118460,"_2978":118623},[],"Carga por separado las políticas concedidas a cada principal.",{"_3496":71126,"_30262":71076,"_21040":118625,"_5":14474,"_27550":118460,"_2978":118626},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3496":71127,"_30262":71076,"_21040":118628,"_5":14474,"_27550":118460,"_2978":118629},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3496":71128,"_30262":71076,"_21040":118631,"_5":14474,"_27550":118460,"_2978":118632},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3496":71129,"_30262":71076,"_21040":118634,"_5":14474,"_27550":118460,"_2978":118635},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3496":71130,"_30262":71076,"_21040":118637,"_5":14474,"_27550":118460,"_2978":118638},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3496":71131,"_30262":71076,"_21040":118640,"_5":14474,"_27550":118460,"_2978":118641},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3496":71132,"_30262":71076,"_21040":118643,"_5":14474,"_27550":118464,"_2978":118644},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3496":71133,"_30262":71076,"_21040":118646,"_5":14474,"_27550":118464,"_2978":118647},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3496":71134,"_30262":71076,"_21040":118649,"_5":14474,"_27550":118464,"_2978":118650},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3496":71135,"_30262":71076,"_21040":118652,"_5":14474,"_27550":118464,"_2978":118653},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3496":71136,"_30262":71076,"_21040":118655,"_5":14474,"_27550":118464,"_2978":118656},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3496":71137,"_30262":71076,"_21040":118658,"_5":14474,"_27550":118464,"_2978":118659},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3496":71138,"_30262":71076,"_21040":118661,"_5":14474,"_27550":118464,"_2978":118662},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3496":71139,"_30262":71076,"_21040":118664,"_5":14474,"_27550":118464,"_2978":118665},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3496":71140,"_30262":71076,"_21040":118667,"_5":14474,"_27550":118468,"_2978":118668},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3496":71141,"_30262":71076,"_21040":118670,"_5":14474,"_27550":118468,"_2978":118671},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3496":71142,"_30262":71076,"_21040":118673,"_5":14474,"_27550":118468,"_2978":118674},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3496":71143,"_30262":71076,"_21040":118676,"_5":14474,"_27550":118468,"_2978":118677},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3496":71144,"_30262":71076,"_21040":118679,"_5":14474,"_27550":118468,"_2978":118680},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3496":71145,"_30262":71076,"_21040":118682,"_5":14474,"_27550":118468,"_2978":118683},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3496":71146,"_30262":71076,"_21040":118685,"_5":14474,"_27550":118468,"_2978":118686},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3496":71147,"_30262":71076,"_21040":118688,"_5":14474,"_27550":118468,"_2978":118689},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3496":71148,"_30262":71076,"_21040":118691,"_5":14474,"_27550":118468,"_2978":118692},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3496":71149,"_30262":71076,"_21040":118694,"_5":14474,"_27550":118468,"_2978":118695},[],"Las acciones se dividen en dos grupos:",{"_3496":71150,"_30262":71076,"_21040":118697,"_5":14474,"_27550":118468,"_2978":118698},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3496":71151,"_30262":71076,"_21040":118700,"_5":14474,"_27550":118468,"_2978":118701},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3496":71152,"_30262":71076,"_21040":118703,"_5":14474,"_27550":118468,"_2978":118704},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3496":71153,"_30262":71076,"_21040":118706,"_5":14474,"_27550":118472,"_2978":118707},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3496":71154,"_30262":71076,"_21040":118709,"_5":14474,"_27550":118472,"_2978":118710},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3496":71155,"_30262":71076,"_21040":118712,"_5":14474,"_27550":118472,"_2978":118713},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3496":71156,"_30262":71076,"_21040":118715,"_5":14474,"_27550":118476,"_2978":118716},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3496":71157,"_30262":71076,"_21040":118718,"_5":14474,"_27550":118476,"_2978":118719},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3496":71158,"_30262":71076,"_21040":118721,"_5":14474,"_27550":118476,"_2978":118722},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3496":71159,"_30262":71076,"_21040":118724,"_5":14474,"_27550":118476,"_2978":118725},[],"Los operadores implementados son:",{"_3496":71160,"_30262":71076,"_21040":118727,"_5":14474,"_27550":118476,"_2978":118728},[],"`equals`, para igualdad exacta;",{"_3496":71161,"_30262":71076,"_21040":118730,"_5":14474,"_27550":118476,"_2978":118731},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3496":71162,"_30262":71076,"_21040":118733,"_5":14474,"_27550":118476,"_2978":118734},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3496":71163,"_30262":71076,"_21040":118736,"_5":14474,"_27550":118476,"_2978":118737},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3496":71164,"_30262":71076,"_21040":118739,"_5":14474,"_27550":118480,"_2978":118740},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3496":71165,"_30262":71076,"_21040":118742,"_5":14474,"_27550":118480,"_2978":118743},[],"Los modos disponibles son:",{"_3496":71166,"_30262":71076,"_21040":118745,"_5":14474,"_27550":118480,"_2978":118746},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3496":71167,"_30262":71076,"_21040":118748,"_5":14474,"_27550":118480,"_2978":118749},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3496":71168,"_30262":71076,"_21040":118751,"_5":14474,"_27550":118480,"_2978":118752},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3496":71169,"_30262":71076,"_21040":118754,"_5":14474,"_27550":118480,"_2978":118755},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3496":71170,"_30262":71076,"_21040":118757,"_5":14474,"_27550":118480,"_2978":118758},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3496":71171,"_30262":71076,"_21040":118760,"_5":14474,"_27550":118480,"_2978":118761},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3496":71172,"_30262":71076,"_21040":118763,"_5":14474,"_27550":118484,"_2978":118764},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3496":71173,"_30262":71076,"_21040":118766,"_5":14474,"_27550":118484,"_2978":118767},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3496":71174,"_30262":71076,"_21040":118769,"_5":14474,"_27550":118484,"_2978":118770},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3496":71175,"_30262":71076,"_21040":118772,"_5":14474,"_27550":118484,"_2978":118773},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3496":71176,"_30262":71076,"_21040":118775,"_5":14474,"_27550":118492,"_2978":118776},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3496":71177,"_30262":71076,"_21040":118778,"_5":14474,"_27550":118492,"_2978":118779},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3496":71178,"_30262":71076,"_21040":118781,"_5":14474,"_27550":118496,"_2978":118782},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3496":71179,"_30262":71076,"_21040":118784,"_5":14474,"_27550":118496,"_2978":118785},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3496":71180,"_30262":71076,"_21040":118787,"_5":14474,"_27550":118500,"_2978":118788},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3496":71181,"_30262":71076,"_21040":118790,"_5":14474,"_27550":118500,"_2978":118791},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3496":71182,"_30262":71076,"_21040":118793,"_5":14474,"_27550":118500,"_2978":118794},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3496":71183,"_30262":71076,"_21040":118796,"_5":14474,"_27550":118504,"_2978":118797},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3496":71184,"_30262":71076,"_21040":118799,"_5":14474,"_27550":118504,"_2978":118800},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3496":71185,"_30262":71076,"_21040":118802,"_5":14474,"_27550":118504,"_2978":118803},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3496":71186,"_30262":71076,"_21040":118805,"_5":14474,"_27550":118504,"_2978":118806},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3496":71187,"_30262":71076,"_21040":118808,"_5":14474,"_27550":118504,"_2978":118809},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3496":71188,"_30262":71076,"_21040":118811,"_5":14474,"_27550":118504,"_2978":118812},[],"Ten en cuenta que:",{"_3496":71189,"_30262":71076,"_21040":118814,"_5":14474,"_27550":118504,"_2978":118815},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3496":71190,"_30262":71076,"_21040":118817,"_5":14474,"_27550":118504,"_2978":118818},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3496":71191,"_30262":71076,"_21040":118820,"_5":14474,"_27550":118504,"_2978":118821},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3496":71192,"_30262":71076,"_21040":118823,"_5":14474,"_27550":118508,"_2978":118824},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3496":71193,"_30262":71076,"_21040":118826,"_5":14474,"_27550":118508,"_2978":118827},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3496":71194,"_30262":71076,"_21040":118829,"_5":14474,"_27550":118508,"_2978":118830},[],"acceso completo y de solo lectura a KMS;",{"_3496":71195,"_30262":71076,"_21040":118832,"_5":14474,"_27550":118508,"_2978":118833},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3496":71196,"_30262":71076,"_21040":118835,"_5":14474,"_27550":118508,"_2978":118836},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3496":71197,"_30262":71076,"_21040":118838,"_5":14474,"_27550":118508,"_2978":118839},[],"acceso a la interfaz;",{"_3496":71198,"_30262":71076,"_21040":118841,"_5":14474,"_27550":118508,"_2978":118842},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3496":71199,"_30262":71076,"_21040":118844,"_5":14474,"_27550":118508,"_2978":118845},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3496":71200,"_30262":71076,"_21040":118847,"_5":14474,"_27550":118508,"_2978":118848},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3496":71201,"_30262":71076,"_21040":118850,"_5":14474,"_27550":118512,"_2978":118851},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3496":71202,"_30262":71076,"_21040":118853,"_5":14474,"_27550":118512,"_2978":118854},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3496":71203,"_30262":71076,"_21040":118856,"_5":14474,"_27550":118512,"_2978":118857},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3496":71204,"_30262":71076,"_21040":118859,"_5":14474,"_27550":118515,"_2978":118860},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3496":71205,"_30262":71076,"_21040":118862,"_5":14474,"_27550":118519,"_2978":118863},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3496":71206,"_30262":71076,"_21040":118865,"_5":14474,"_27550":118519,"_2978":118866},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3496":71207,"_30262":71076,"_21040":118868,"_5":14474,"_27550":118523,"_2978":118869},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3496":71208,"_30262":71076,"_21040":118871,"_5":14474,"_27550":118527,"_2978":118872},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3496":71209,"_30262":71076,"_21040":118874,"_5":14474,"_27550":118531,"_2978":118875},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3496":71210,"_30262":71076,"_21040":118877,"_5":14474,"_27550":118535,"_2978":118878},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3496":71211,"_30262":71076,"_21040":118880,"_5":14474,"_27550":118535,"_2978":118881},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3496":71212,"_30262":71076,"_21040":118883,"_5":14474,"_27550":118539,"_2978":118884},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3496":71213,"_30262":71076,"_21040":118886,"_5":14474,"_27550":118539,"_2978":118887},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3496":71214,"_30262":71076,"_21040":118889,"_5":14474,"_27550":118539,"_2978":118890},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3496":71215,"_30262":71076,"_21040":118892,"_5":14474,"_27550":118539,"_2978":118893},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3496":71216,"_30262":71076,"_21040":118895,"_5":14474,"_27550":118539,"_2978":118896},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3496":71217,"_30262":71076,"_21040":118898,"_5":14474,"_27550":118539,"_2978":118899},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3496":71218,"_30262":71076,"_21040":118901,"_5":14474,"_27550":118539,"_2978":118902},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3496":71219,"_30262":71076,"_21040":118904,"_5":14474,"_27550":118539,"_2978":118905},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3496":71220,"_30262":71076,"_21040":118907,"_5":14474,"_27550":118543,"_2978":118908},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3496":71221,"_30262":71076,"_21040":118910,"_5":14474,"_27550":118543,"_2978":118911},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3496":71222,"_30262":71076,"_21040":118913,"_5":14474,"_27550":118543,"_2978":118914},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3496":71223,"_30262":71076,"_21040":118916,"_5":14474,"_27550":118547,"_2978":118917},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3496":71224,"_30262":71076,"_21040":118919,"_5":14474,"_27550":118547,"_2978":118920},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3496":71225,"_30262":71076,"_21040":118922,"_5":14474,"_27550":118547,"_2978":118923},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3496":71226,"_30262":71076,"_21040":118925,"_5":14474,"_27550":118547,"_2978":118926},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3496":71227,"_30262":71076,"_21040":118928,"_5":14474,"_27550":118547,"_2978":118929},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3496":71228,"_30262":71076,"_21040":118931,"_5":14474,"_27550":118547,"_2978":118932},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3496":71229,"_30262":71076,"_21040":118934,"_5":14474,"_27550":118547,"_2978":118935},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3496":71230,"_30262":71076,"_21040":118937,"_5":14474,"_27550":118547,"_2978":118938},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3496":71231,"_30262":71076,"_21040":118940,"_5":14474,"_27550":118555,"_2978":118941},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3496":71232,"_30262":71076,"_21040":118943,"_5":14474,"_27550":118559,"_2978":118944},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3496":71233,"_30262":71076,"_21040":118946,"_5":14474,"_27550":118559,"_2978":118947},[],"que exista un principal activo del tipo correcto;",{"_3496":71234,"_30262":71076,"_21040":118949,"_5":14474,"_27550":118559,"_2978":118950},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3496":71235,"_30262":71076,"_21040":118952,"_5":14474,"_27550":118559,"_2978":118953},[],"que todas las condiciones del principal se cumplan;",{"_3496":71236,"_30262":71076,"_21040":118955,"_5":14474,"_27550":118559,"_2978":118956},[],"que el principal tenga concedida la política esperada;",{"_3496":71237,"_30262":71076,"_21040":118958,"_5":14474,"_27550":118559,"_2978":118959},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3496":71238,"_30262":71076,"_21040":118961,"_5":14474,"_27550":118559,"_2978":118962},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3496":71239,"_30262":71076,"_21040":118964,"_5":14474,"_27550":118559,"_2978":118965},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3496":71240,"_30262":71076,"_21040":118967,"_5":14474,"_27550":118563,"_2978":118968},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3496":71241,"_30262":71076,"_21040":118970,"_5":14474,"_27550":118567,"_2978":118971},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3496":71242,"_30262":71076,"_21040":118973,"_5":14474,"_27550":118571,"_2978":118974},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3496":71243,"_30262":71076,"_21040":118976,"_5":14474,"_27550":118571,"_2978":118977},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3496":71244,"_30262":71244,"_5":14825,"_2978":118979,"_30620":118980,"_21040":118981,"_27550":71244},"Alertas y suscripciones",[49507,118444,118445],[],{"_3496":71245,"_30262":71244,"_21040":118983,"_5":14474,"_27550":71244,"_2978":118984},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3496":71246,"_30262":71244,"_5":30617,"_21040":118986,"_27550":118987,"_2978":118988},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3496":71247,"_30262":71244,"_5":30617,"_21040":118990,"_27550":118991,"_2978":118992},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3496":71248,"_30262":71244,"_5":30617,"_21040":118994,"_27550":118995,"_2978":118996},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3496":71249,"_30262":71244,"_5":30617,"_21040":118998,"_27550":118999,"_2978":119000},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3496":71250,"_30262":71244,"_5":30617,"_21040":119002,"_27550":119003,"_2978":119004},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3496":71251,"_30262":71244,"_5":30617,"_21040":119006,"_27550":119007,"_2978":119008},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3496":71252,"_30262":71244,"_5":30617,"_21040":119010,"_27550":119011,"_2978":119012},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3496":71253,"_30262":71244,"_5":30617,"_21040":119014,"_27550":119015,"_2978":119016},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3496":71254,"_30262":71244,"_5":30617,"_21040":119018,"_27550":119019,"_2978":119020},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3496":71255,"_30262":71244,"_5":30617,"_21040":119022,"_27550":119023,"_2978":119024},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3496":71256,"_30262":71244,"_5":30617,"_21040":119026,"_27550":119027,"_2978":119028},[],"/docs/pr-preview/pr-61/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3496":71257,"_30262":71244,"_21040":119030,"_5":14474,"_27550":71244,"_2978":119031},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3496":71258,"_30262":71244,"_21040":119033,"_5":14474,"_27550":118987,"_2978":119034},[],"Un servicio publica un evento de dominio.",{"_3496":71259,"_30262":71244,"_21040":119036,"_5":14474,"_27550":118987,"_2978":119037},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3496":71260,"_30262":71244,"_21040":119039,"_5":14474,"_27550":118987,"_2978":119040},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3496":71261,"_30262":71244,"_21040":119042,"_5":14474,"_27550":118987,"_2978":119043},[],"Lamassu entrega el evento al canal configurado.",{"_3496":71262,"_30262":71244,"_21040":119045,"_5":14474,"_27550":118987,"_2978":119046},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3496":71263,"_30262":71244,"_21040":119048,"_5":14474,"_27550":118991,"_2978":119049},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3496":71264,"_30262":71244,"_21040":119051,"_5":14474,"_27550":118991,"_2978":119052},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3496":71265,"_30262":71244,"_21040":119054,"_5":14474,"_27550":118991,"_2978":119055},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3496":71266,"_30262":71244,"_21040":119057,"_5":14474,"_27550":118991,"_2978":119058},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3496":71267,"_30262":71244,"_21040":119060,"_5":14474,"_27550":118991,"_2978":119061},[],"`apikey_options` necesita `header` y `key`.",{"_3496":71268,"_30262":71244,"_21040":119063,"_5":14474,"_27550":118991,"_2978":119064},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3496":71269,"_30262":71244,"_21040":119066,"_5":14474,"_27550":118991,"_2978":119067},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3496":71270,"_30262":71244,"_21040":119069,"_5":14474,"_27550":118991,"_2978":119070},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3496":71271,"_30262":71244,"_21040":119072,"_5":14474,"_27550":118999,"_2978":119073},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3496":71272,"_30262":71244,"_21040":119075,"_5":14474,"_27550":119003,"_2978":119076},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3496":71273,"_30262":71244,"_21040":119078,"_5":14474,"_27550":119007,"_2978":119079},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3496":71274,"_30262":71244,"_21040":119081,"_5":14474,"_27550":119007,"_2978":119082},[],"**None** notifica todas las instancias del evento.",{"_3496":71275,"_30262":71244,"_21040":119084,"_5":14474,"_27550":119007,"_2978":119085},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3496":71276,"_30262":71244,"_21040":119087,"_5":14474,"_27550":119007,"_2978":119088},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3496":71277,"_30262":71244,"_21040":119090,"_5":14474,"_27550":119007,"_2978":119091},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3496":71278,"_30262":71244,"_21040":119093,"_5":14474,"_27550":119007,"_2978":119094},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3496":71279,"_30262":71244,"_21040":119096,"_5":14474,"_27550":119007,"_2978":119097},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3496":71280,"_30262":71244,"_21040":119099,"_5":14474,"_27550":119011,"_2978":119100},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3496":71281,"_30262":71244,"_21040":119102,"_5":14474,"_27550":119015,"_2978":119103},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3496":71282,"_30262":71244,"_21040":119105,"_5":14474,"_27550":119015,"_2978":119106},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3496":71283,"_30262":71244,"_21040":119108,"_5":14474,"_27550":119015,"_2978":119109},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3496":71284,"_30262":71244,"_21040":119111,"_5":14474,"_27550":119015,"_2978":119112},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3496":71285,"_30262":71244,"_21040":119114,"_5":14474,"_27550":119015,"_2978":119115},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3496":71286,"_30262":71244,"_21040":119117,"_5":14474,"_27550":119015,"_2978":119118},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3496":71287,"_30262":71244,"_21040":119120,"_5":14474,"_27550":119015,"_2978":119121},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3496":71288,"_30262":71244,"_21040":119123,"_5":14474,"_27550":119015,"_2978":119124},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3496":71289,"_30262":71244,"_21040":119126,"_5":14474,"_27550":119019,"_2978":119127},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3496":71290,"_30262":71244,"_21040":119129,"_5":14474,"_27550":119019,"_2978":119130},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3496":71291,"_30262":71244,"_21040":119132,"_5":14474,"_27550":119019,"_2978":119133},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3496":71292,"_30262":71244,"_21040":119135,"_5":14474,"_27550":119019,"_2978":119136},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3496":71293,"_30262":71244,"_21040":119138,"_5":14474,"_27550":119019,"_2978":119139},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3496":71294,"_30262":71244,"_21040":119141,"_5":14474,"_27550":119019,"_2978":119142},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3496":71295,"_30262":71244,"_21040":119144,"_5":14474,"_27550":119019,"_2978":119145},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3496":71296,"_30262":71244,"_21040":119147,"_5":14474,"_27550":119019,"_2978":119148},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3496":71297,"_30262":71244,"_21040":119150,"_5":14474,"_27550":119023,"_2978":119151},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3496":71298,"_30262":71244,"_21040":119153,"_5":14474,"_27550":119023,"_2978":119154},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3496":71299,"_30262":71244,"_21040":119156,"_5":14474,"_27550":119027,"_2978":119157},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3496":71300,"_30262":71244,"_21040":119159,"_5":14474,"_27550":119027,"_2978":119160},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3496":71301,"_30262":71244,"_21040":119162,"_5":14474,"_27550":119027,"_2978":119163},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3496":71302,"_30262":71244,"_21040":119165,"_5":14474,"_27550":119027,"_2978":119166},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3496":71303,"_30262":71244,"_21040":119168,"_5":14474,"_27550":119027,"_2978":119169},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3496":71304,"_30262":71244,"_21040":119171,"_5":14474,"_27550":119027,"_2978":119172},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3496":71305,"_30262":71244,"_21040":119174,"_5":14474,"_27550":119027,"_2978":119175},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3496":71306,"_30262":71244,"_21040":119177,"_5":14474,"_27550":119027,"_2978":119178},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3496":71307,"_30262":71244,"_21040":119180,"_5":14474,"_27550":119027,"_2978":119181},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3496":71308,"_30262":71308,"_5":14825,"_2978":119183,"_30620":119184,"_21040":119185,"_27550":71308},"Registros de auditoría",[49507,118444,118445],[],{"_3496":71309,"_30262":71308,"_21040":119187,"_5":14474,"_27550":71308,"_2978":119188},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3496":71310,"_30262":71308,"_5":30617,"_21040":119190,"_27550":119191,"_2978":119192},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3496":71311,"_30262":71308,"_5":30617,"_21040":119194,"_27550":119195,"_2978":119196},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3496":71312,"_30262":71308,"_5":30617,"_21040":119198,"_27550":119199,"_2978":119200},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3496":71313,"_30262":71308,"_5":30617,"_21040":119202,"_27550":119203,"_2978":119204},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3496":71314,"_30262":71308,"_5":30617,"_21040":119206,"_27550":119207,"_2978":119208},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3496":71315,"_30262":71308,"_5":30617,"_21040":119210,"_27550":119211,"_2978":119212},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3496":71316,"_30262":71308,"_5":30617,"_21040":119214,"_27550":119215,"_2978":119216},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3496":71317,"_30262":71308,"_5":30617,"_21040":119218,"_27550":119219,"_2978":119220},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3496":71318,"_30262":71308,"_5":30617,"_21040":119222,"_27550":119223,"_2978":119224},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3496":71319,"_30262":71308,"_5":30617,"_21040":119226,"_27550":119227,"_2978":119228},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3496":71320,"_30262":71308,"_5":30617,"_21040":119230,"_27550":119231,"_2978":119232},[],"/docs/pr-preview/pr-61/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3496":71321,"_30262":71308,"_21040":119234,"_5":14474,"_27550":71308,"_2978":119235},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3496":71322,"_30262":71308,"_21040":119237,"_5":14474,"_27550":119191,"_2978":119238},[],"El cuerpo de auditoría incluye:",{"_3496":71323,"_30262":71308,"_21040":119240,"_5":14474,"_27550":119191,"_2978":119241},[],"input: datos recibidos por la operación;",{"_3496":71324,"_30262":71308,"_21040":119243,"_5":14474,"_27550":119191,"_2978":119244},[],"has\\_error: indica si el servicio devolvió un error;",{"_3496":71325,"_30262":71308,"_21040":119246,"_5":14474,"_27550":119191,"_2978":119247},[],"output: resultado producido o mensaje de error;",{"_3496":71326,"_30262":71308,"_21040":119249,"_5":14474,"_27550":119191,"_2978":119250},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3496":71327,"_30262":71308,"_21040":119252,"_5":14474,"_27550":119191,"_2978":119253},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3496":71328,"_30262":71308,"_21040":119255,"_5":14474,"_27550":119191,"_2978":119256},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3496":71329,"_30262":71308,"_21040":119258,"_5":14474,"_27550":119195,"_2978":119259},[],"El backend aplica auditoría a mutaciones de:",{"_3496":71330,"_30262":71308,"_21040":119261,"_5":14474,"_27550":119195,"_2978":119262},[],"autoridades, certificados y perfiles de emisión;",{"_3496":71331,"_30262":71308,"_21040":119264,"_5":14474,"_27550":119195,"_2978":119265},[],"claves y motores KMS;",{"_3496":71332,"_30262":71308,"_21040":119267,"_5":14474,"_27550":119195,"_2978":119268},[],"dispositivos e identidades;",{"_3496":71333,"_30262":71308,"_21040":119270,"_5":14474,"_27550":119195,"_2978":119271},[],"DMS y operaciones de enrolamiento;",{"_3496":71334,"_30262":71308,"_21040":119273,"_5":14474,"_27550":119195,"_2978":119274},[],"funciones de validación y CRL;",{"_3496":71335,"_30262":71308,"_21040":119276,"_5":14474,"_27550":119195,"_2978":119277},[],"principales, políticas y concesiones de autorización.",{"_3496":71336,"_30262":71308,"_21040":119279,"_5":14474,"_27550":119195,"_2978":119280},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3496":71337,"_30262":71308,"_21040":119282,"_5":14474,"_27550":119199,"_2978":119283},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3496":71338,"_30262":71308,"_21040":119285,"_5":14474,"_27550":119199,"_2978":119286},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3496":71339,"_30262":71308,"_21040":119288,"_5":14474,"_27550":119199,"_2978":119289},[],"Diseña el consumidor para:",{"_3496":71340,"_30262":71308,"_21040":119291,"_5":14474,"_27550":119199,"_2978":119292},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3496":71341,"_30262":71308,"_21040":119294,"_5":14474,"_27550":119199,"_2978":119295},[],"conservar el CloudEvent completo sin modificar;",{"_3496":71342,"_30262":71308,"_21040":119297,"_5":14474,"_27550":119199,"_2978":119298},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3496":71343,"_30262":71308,"_21040":119300,"_5":14474,"_27550":119199,"_2978":119301},[],"cifrar en tránsito y en reposo;",{"_3496":71344,"_30262":71308,"_21040":119303,"_5":14474,"_27550":119199,"_2978":119304},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3496":71345,"_30262":71308,"_21040":119306,"_5":14474,"_27550":119199,"_2978":119307},[],"aplicar una política explícita de retención y legal hold;",{"_3496":71346,"_30262":71308,"_21040":119309,"_5":14474,"_27550":119199,"_2978":119310},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3496":71347,"_30262":71308,"_21040":119312,"_5":14474,"_27550":119203,"_2978":119313},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3496":71348,"_30262":71308,"_21040":119315,"_5":14474,"_27550":119203,"_2978":119316},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3496":71349,"_30262":71308,"_21040":119318,"_5":14474,"_27550":119211,"_2978":119319},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3496":71350,"_30262":71308,"_21040":119321,"_5":14474,"_27550":119215,"_2978":119322},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3496":71351,"_30262":71308,"_21040":119324,"_5":14474,"_27550":119219,"_2978":119325},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3496":71352,"_30262":71308,"_21040":119327,"_5":14474,"_27550":119223,"_2978":119328},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3496":71353,"_30262":71308,"_21040":119330,"_5":14474,"_27550":119227,"_2978":119331},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3496":71354,"_30262":71308,"_21040":119333,"_5":14474,"_27550":119231,"_2978":119334},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3496":71355,"_30262":71308,"_21040":119336,"_5":14474,"_27550":119231,"_2978":119337},[],"aparece un evento de auditoría correcto;",{"_3496":71356,"_30262":71308,"_21040":119339,"_5":14474,"_27550":119231,"_2978":119340},[],"el principal coincide con la identidad utilizada;",{"_3496":71357,"_30262":71308,"_21040":119342,"_5":14474,"_27550":119231,"_2978":119343},[],"el consumidor lo persiste una sola vez;",{"_3496":71358,"_30262":71308,"_21040":119345,"_5":14474,"_27550":119231,"_2978":119346},[],"puede recuperarse por recurso, actor y periodo;",{"_3496":71359,"_30262":71308,"_21040":119348,"_5":14474,"_27550":119231,"_2978":119349},[],"una interrupción del consumidor produce una alerta.",{"_3496":71360,"_30262":71308,"_21040":119351,"_5":14474,"_27550":119231,"_2978":119352},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3496":71361,"_30262":71361,"_5":14825,"_2978":119354,"_30620":119355,"_21040":119356,"_27550":71361},"Arquitectura de la plataforma",[49507,118444],[],{"_3496":71362,"_30262":71361,"_21040":119358,"_5":14474,"_27550":71361,"_2978":119359},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3496":71363,"_30262":71361,"_5":30617,"_21040":119361,"_27550":119362,"_2978":119363},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3496":71364,"_30262":71361,"_5":30617,"_21040":119365,"_27550":119366,"_2978":119367},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3496":71365,"_30262":71361,"_5":30617,"_21040":119369,"_27550":119370,"_2978":119371},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3496":71366,"_30262":71361,"_5":30617,"_21040":119373,"_27550":119374,"_2978":119375},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3496":71367,"_30262":71361,"_5":30617,"_21040":119377,"_27550":119378,"_2978":119379},[],"/docs/pr-preview/pr-61/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3496":71368,"_30262":71361,"_21040":119381,"_5":14474,"_27550":71361,"_2978":119382},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3496":71369,"_30262":71361,"_21040":119384,"_5":14474,"_27550":71361,"_2978":119385},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3496":71370,"_30262":71361,"_21040":119387,"_5":14474,"_27550":119362,"_2978":119388},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3496":71371,"_30262":71361,"_21040":119390,"_5":14474,"_27550":119366,"_2978":119391},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3496":71372,"_30262":71361,"_21040":119393,"_5":14474,"_27550":119370,"_2978":119394},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3496":71373,"_30262":71361,"_21040":119396,"_5":14474,"_27550":119374,"_2978":119397},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3496":71374,"_30262":71361,"_21040":119399,"_5":14474,"_27550":119378,"_2978":119400},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3496":71375,"_30262":71375,"_5":14825,"_2978":119402,"_30620":119403,"_21040":119404,"_27550":71375},"Cómo funciona Lamassu",[49507,118444],[],{"_3496":71376,"_30262":71375,"_21040":119406,"_5":14474,"_27550":71375,"_2978":119407},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3496":71377,"_30262":71375,"_5":30617,"_21040":119409,"_27550":119410,"_2978":119411},[],"/docs/pr-preview/pr-61/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3496":71378,"_30262":71375,"_5":30617,"_21040":119413,"_27550":119414,"_2978":119415},[],"/docs/pr-preview/pr-61/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3496":71379,"_30262":71375,"_21040":119417,"_5":14474,"_27550":71375,"_2978":119418},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3496":71380,"_30262":71375,"_21040":119420,"_5":14474,"_27550":119410,"_2978":119421},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3496":71381,"_30262":71375,"_21040":119423,"_5":14474,"_27550":119410,"_2978":119424},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3496":71382,"_30262":71375,"_21040":119426,"_5":14474,"_27550":119410,"_2978":119427},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3496":71383,"_30262":71375,"_21040":119429,"_5":14474,"_27550":119410,"_2978":119430},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3496":71384,"_30262":71375,"_21040":119432,"_5":14474,"_27550":119410,"_2978":119433},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3496":71385,"_30262":71375,"_21040":119435,"_5":14474,"_27550":119414,"_2978":119436},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3496":71386,"_30262":71375,"_21040":119438,"_5":14474,"_27550":119414,"_2978":119439},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3496":71387,"_30262":71375,"_21040":119441,"_5":14474,"_27550":119414,"_2978":119442},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3496":71388,"_30262":71375,"_21040":119444,"_5":14474,"_27550":119414,"_2978":119445},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3496":71389,"_30262":71375,"_21040":119447,"_5":14474,"_27550":119414,"_2978":119448},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3496":71390,"_30262":71375,"_21040":119450,"_5":14474,"_27550":119414,"_2978":119451},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3496":71391,"_30262":71375,"_21040":119453,"_5":14474,"_27550":119414,"_2978":119454},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3496":71392,"_30262":71392,"_5":14825,"_2978":119456,"_30620":119457,"_21040":119458,"_27550":71392},"Dispositivos e identidades",[49507,118444,51989,119456],[],{"_3496":71393,"_30262":71392,"_21040":119460,"_5":14474,"_27550":71392,"_2978":119461},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3496":71394,"_30262":71392,"_5":30617,"_21040":119463,"_27550":119464,"_2978":119465},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3496":71395,"_30262":71392,"_5":30617,"_21040":119467,"_27550":119468,"_2978":119469},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3496":71396,"_30262":71392,"_5":30617,"_21040":119471,"_27550":119472,"_2978":119473},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3496":71397,"_30262":71392,"_5":30617,"_21040":119475,"_27550":119476,"_2978":119477},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3496":71398,"_30262":71392,"_5":30617,"_21040":119479,"_27550":119480,"_2978":119481},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3496":71399,"_30262":71392,"_5":30617,"_21040":119483,"_27550":119484,"_2978":119485},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3496":71400,"_30262":71392,"_5":30617,"_21040":119487,"_27550":119488,"_2978":119489},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3496":71401,"_30262":71392,"_5":30617,"_21040":119491,"_27550":119492,"_2978":119493},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3496":71402,"_30262":71392,"_5":30617,"_21040":119495,"_27550":119496,"_2978":119497},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3496":71403,"_30262":71392,"_5":30617,"_21040":119499,"_27550":119500,"_2978":119501},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3496":71404,"_30262":71392,"_5":30617,"_21040":119503,"_27550":119504,"_2978":119505},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3496":71405,"_30262":71392,"_21040":119507,"_5":14474,"_27550":71392,"_2978":119508},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3496":71406,"_30262":71392,"_21040":119510,"_5":14474,"_27550":71392,"_2978":119511},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3496":71407,"_30262":71392,"_21040":119513,"_5":14474,"_27550":119464,"_2978":119514},[],"Vista operativa",{"_3496":71408,"_30262":71392,"_21040":119516,"_5":14474,"_27550":119464,"_2978":119517},[],"Interpretación",{"_3496":71409,"_30262":71392,"_21040":119519,"_5":14474,"_27550":119464,"_2978":52052},[],{"_3496":71410,"_30262":71392,"_21040":119521,"_5":14474,"_27550":119464,"_2978":119522},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3496":71411,"_30262":71392,"_21040":119524,"_5":14474,"_27550":119464,"_2978":52058},[],{"_3496":71412,"_30262":71392,"_21040":119526,"_5":14474,"_27550":119464,"_2978":119527},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3496":71413,"_30262":71392,"_21040":119529,"_5":14474,"_27550":119464,"_2978":52064},[],{"_3496":71414,"_30262":71392,"_21040":119531,"_5":14474,"_27550":119464,"_2978":119532},[],"La identidad está en la ventana operativa de renovación.",{"_3496":71415,"_30262":71392,"_21040":119534,"_5":14474,"_27550":119464,"_2978":52070},[],{"_3496":71416,"_30262":71392,"_21040":119536,"_5":14474,"_27550":119464,"_2978":119537},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3496":71417,"_30262":71392,"_21040":119539,"_5":14474,"_27550":119464,"_2978":52076},[],{"_3496":71418,"_30262":71392,"_21040":119541,"_5":14474,"_27550":119464,"_2978":119542},[],"La identidad ha vencido.",{"_3496":71419,"_30262":71392,"_21040":119544,"_5":14474,"_27550":119464,"_2978":52082},[],{"_3496":71420,"_30262":71392,"_21040":119546,"_5":14474,"_27550":119464,"_2978":119547},[],"La identidad está marcada como revocada.",{"_3496":71421,"_30262":71392,"_21040":119549,"_5":14474,"_27550":119464,"_2978":52088},[],{"_3496":71422,"_30262":71392,"_21040":119551,"_5":14474,"_27550":119464,"_2978":119552},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3496":71423,"_30262":71392,"_21040":119554,"_5":14474,"_27550":119464,"_2978":119555},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3496":71424,"_30262":71392,"_21040":119557,"_5":14474,"_27550":119468,"_2978":119558},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3496":71425,"_30262":71392,"_21040":119560,"_5":14474,"_27550":119468,"_2978":119561},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3496":71426,"_30262":71392,"_21040":119563,"_5":14474,"_27550":119468,"_2978":119564},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3496":71427,"_30262":71392,"_21040":119566,"_5":14474,"_27550":119468,"_2978":119567},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3496":71428,"_30262":71392,"_21040":119569,"_5":14474,"_27550":119472,"_2978":119570},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3496":71429,"_30262":71392,"_21040":119572,"_5":14474,"_27550":119476,"_2978":119573},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3496":71430,"_30262":71392,"_21040":119575,"_5":14474,"_27550":119480,"_2978":119576},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3496":71431,"_30262":71392,"_21040":119578,"_5":14474,"_27550":119484,"_2978":119579},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3496":71432,"_30262":71392,"_21040":119581,"_5":14474,"_27550":119488,"_2978":119582},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3496":71433,"_30262":71392,"_21040":119584,"_5":14474,"_27550":119488,"_2978":119585},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3496":71434,"_30262":71392,"_21040":119587,"_5":14474,"_27550":119492,"_2978":119588},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3496":71435,"_30262":71392,"_21040":119590,"_5":14474,"_27550":119492,"_2978":119591},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3496":71436,"_30262":71392,"_21040":119593,"_5":14474,"_27550":119492,"_2978":119594},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3496":71437,"_30262":71392,"_21040":119596,"_5":14474,"_27550":119492,"_2978":119597},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3496":71438,"_30262":71392,"_21040":119599,"_5":14474,"_27550":119492,"_2978":119600},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3496":71439,"_30262":71392,"_21040":119602,"_5":14474,"_27550":119492,"_2978":119603},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3496":71440,"_30262":71392,"_21040":119605,"_5":14474,"_27550":119496,"_2978":119606},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3496":71441,"_30262":71392,"_21040":119608,"_5":14474,"_27550":119496,"_2978":119609},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3496":71442,"_30262":71392,"_21040":119611,"_5":14474,"_27550":119500,"_2978":119612},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3496":71443,"_30262":71392,"_21040":119614,"_5":14474,"_27550":119500,"_2978":119615},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3496":71444,"_30262":71392,"_21040":119617,"_5":14474,"_27550":119500,"_2978":119618},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3496":71445,"_30262":71392,"_21040":119620,"_5":14474,"_27550":119500,"_2978":119621},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3496":71446,"_30262":71392,"_21040":119623,"_5":14474,"_27550":119504,"_2978":119624},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3496":71447,"_30262":71392,"_21040":119626,"_5":14474,"_27550":119504,"_2978":119627},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3496":71448,"_30262":71448,"_5":14825,"_2978":119629,"_30620":119630,"_21040":119632,"_27550":71448},"Identidad inicial y autenticación",[49507,118444,51989,119456,119631],"Enrolamiento con PKI",[],{"_3496":71449,"_30262":71448,"_21040":119634,"_5":14474,"_27550":71448,"_2978":119635},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3496":71450,"_30262":71448,"_5":30617,"_21040":119637,"_27550":119638,"_2978":119639},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3496":71451,"_30262":71448,"_5":30617,"_21040":119641,"_27550":119642,"_2978":119643},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3496":71452,"_30262":71448,"_5":30617,"_21040":119645,"_27550":119646,"_2978":119647},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3496":71453,"_30262":71448,"_5":30617,"_21040":119649,"_27550":119650,"_2978":119651},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3496":71454,"_30262":71448,"_5":30617,"_21040":119653,"_27550":119654,"_2978":119655},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3496":71455,"_30262":71448,"_21040":119657,"_5":14474,"_27550":71448,"_2978":119658},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3496":71456,"_30262":71448,"_21040":119660,"_5":14474,"_27550":119638,"_2978":119661},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3496":71457,"_30262":71448,"_21040":119663,"_5":14474,"_27550":119638,"_2978":119664},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3496":71458,"_30262":71448,"_21040":119666,"_5":14474,"_27550":119642,"_2978":119667},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3496":71459,"_30262":71448,"_21040":119669,"_5":14474,"_27550":119642,"_2978":119670},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3496":71460,"_30262":71448,"_21040":119672,"_5":14474,"_27550":119642,"_2978":119673},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3496":71461,"_30262":71448,"_21040":119675,"_5":14474,"_27550":119646,"_2978":119676},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3496":71462,"_30262":71448,"_21040":119678,"_5":14474,"_27550":119646,"_2978":119679},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3496":71463,"_30262":71448,"_21040":119681,"_5":14474,"_27550":119650,"_2978":119682},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3496":71464,"_30262":71448,"_21040":119684,"_5":14474,"_27550":119650,"_2978":119685},[],"Ejemplo de cuerpo:",{"_3496":71465,"_30262":71448,"_21040":119687,"_5":14474,"_27550":119650,"_2978":119688},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3496":71466,"_30262":71448,"_21040":119690,"_5":14474,"_27550":119650,"_2978":119691},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3496":71467,"_30262":71448,"_21040":119693,"_5":14474,"_27550":119650,"_2978":119694},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3496":71468,"_30262":71448,"_21040":119696,"_5":14474,"_27550":119650,"_2978":119697},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3496":71469,"_30262":71448,"_21040":119699,"_5":14474,"_27550":119654,"_2978":119700},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3496":71470,"_30262":71448,"_21040":119702,"_5":14474,"_27550":119654,"_2978":119703},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3496":71471,"_30262":71471,"_5":14825,"_2978":119705,"_30620":119706,"_21040":119707,"_27550":71471},"Configura y opera el DMS",[49507,118444,51989,119456,119631],[],{"_3496":71472,"_30262":71471,"_21040":119709,"_5":14474,"_27550":71471,"_2978":119710},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3496":71473,"_30262":71471,"_5":30617,"_21040":119712,"_27550":119713,"_2978":117022},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3496":71474,"_30262":71471,"_5":30617,"_21040":119715,"_27550":119716,"_2978":119717},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3496":71475,"_30262":71471,"_5":30617,"_21040":119719,"_27550":119720,"_2978":119721},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3496":71476,"_30262":71471,"_5":30617,"_21040":119723,"_27550":119724,"_2978":119725},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3496":71477,"_30262":71471,"_5":30617,"_21040":119727,"_27550":119728,"_2978":119729},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3496":71478,"_30262":71471,"_5":30617,"_21040":119731,"_27550":119732,"_2978":119733},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3496":71479,"_30262":71471,"_5":30617,"_21040":119735,"_27550":119736,"_2978":119737},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3496":71480,"_30262":71471,"_5":30617,"_21040":119739,"_27550":119740,"_2978":119741},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3496":71481,"_30262":71471,"_5":30617,"_21040":119743,"_27550":119744,"_2978":52284},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3496":71482,"_30262":71471,"_5":30617,"_21040":119746,"_27550":119747,"_2978":52288},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3496":71483,"_30262":71471,"_5":30617,"_21040":119749,"_27550":119750,"_2978":119751},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3496":71484,"_30262":71471,"_5":30617,"_21040":119753,"_27550":119754,"_2978":119755},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3496":71485,"_30262":71471,"_5":30617,"_21040":119757,"_27550":119758,"_2978":119759},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3496":71486,"_30262":71471,"_5":30617,"_21040":119761,"_27550":119762,"_2978":119763},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3496":71487,"_30262":71471,"_5":30617,"_21040":119765,"_27550":119766,"_2978":52308},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3496":71488,"_30262":71471,"_5":30617,"_21040":119768,"_27550":119769,"_2978":119770},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3496":71489,"_30262":71471,"_5":30617,"_21040":119772,"_27550":119773,"_2978":119774},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3496":71490,"_30262":71471,"_5":30617,"_21040":119776,"_27550":119777,"_2978":119778},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3496":71491,"_30262":71471,"_21040":119780,"_5":14474,"_27550":71471,"_2978":119781},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3496":71492,"_30262":71471,"_21040":119783,"_5":14474,"_27550":119713,"_2978":119784},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3496":71493,"_30262":71471,"_21040":119786,"_5":14474,"_27550":119713,"_2978":119787},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3496":71494,"_30262":71471,"_21040":119789,"_5":14474,"_27550":119716,"_2978":119790},[],"Sigue el recorrido interactivo para configurar un DMS para EST. El ejemplo establece **Name** en `DMS Showcase`, de donde se deriva el identificador `dms-showcase` usado en las URLs EST, y selecciona dos CAs preparadas de antemano: **DMS Enrollment CA** firma las identidades de los dispositivos y **DMS Bootstrap CA** valida la credencial inicial. Los valores son de este ejemplo; usa nombres y CAs apropiados para tu flota.",{"_3496":71495,"_30262":71471,"_21040":119792,"_5":14474,"_27550":119720,"_2978":119793},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3496":71496,"_30262":71471,"_21040":119795,"_5":14474,"_27550":119724,"_2978":119796},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3496":71497,"_30262":71471,"_21040":119798,"_5":14474,"_27550":119728,"_2978":119799},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3496":71498,"_30262":71471,"_21040":119801,"_5":14474,"_27550":119732,"_2978":119802},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3496":71499,"_30262":71471,"_21040":119804,"_5":14474,"_27550":119736,"_2978":119805},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3496":71500,"_30262":71471,"_21040":119807,"_5":14474,"_27550":119744,"_2978":119808},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3496":71501,"_30262":71471,"_21040":119810,"_5":14474,"_27550":119744,"_2978":119811},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3496":71502,"_30262":71471,"_21040":119813,"_5":14474,"_27550":119747,"_2978":119814},[],"Campo de `settings.enrollment_settings`",{"_3496":71503,"_30262":71471,"_21040":119816,"_5":14474,"_27550":119747,"_2978":119817},[],"Decisión",{"_3496":71504,"_30262":71471,"_21040":119819,"_5":14474,"_27550":119747,"_2978":52362},[],{"_3496":71505,"_30262":71471,"_21040":119821,"_5":14474,"_27550":119747,"_2978":119822},[],"`EST_RFC7030` para estas operaciones.",{"_3496":71506,"_30262":71471,"_21040":119824,"_5":14474,"_27550":119747,"_2978":52368},[],{"_3496":71507,"_30262":71471,"_21040":119826,"_5":14474,"_27550":119747,"_2978":119827},[],"ID de la CA que firmará.",{"_3496":71508,"_30262":71471,"_21040":119829,"_5":14474,"_27550":119747,"_2978":52374},[],{"_3496":71509,"_30262":71471,"_21040":119831,"_5":14474,"_27550":119747,"_2978":119832},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3496":71510,"_30262":71471,"_21040":119834,"_5":14474,"_27550":119747,"_2978":52380},[],{"_3496":71511,"_30262":71471,"_21040":119836,"_5":14474,"_27550":119747,"_2978":119837},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3496":71512,"_30262":71471,"_21040":119839,"_5":14474,"_27550":119747,"_2978":52386},[],{"_3496":71513,"_30262":71471,"_21040":119841,"_5":14474,"_27550":119747,"_2978":119842},[],"Uno de los cuatro modos de autenticación.",{"_3496":71514,"_30262":71471,"_21040":119844,"_5":14474,"_27550":119747,"_2978":119845},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3496":71515,"_30262":71471,"_21040":119847,"_5":14474,"_27550":119750,"_2978":119848},[],"Los bloques son independientes:",{"_3496":71516,"_30262":71471,"_21040":119850,"_5":14474,"_27550":119750,"_2978":119851},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3496":71517,"_30262":71471,"_21040":119853,"_5":14474,"_27550":119750,"_2978":119854},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3496":71518,"_30262":71471,"_21040":119856,"_5":14474,"_27550":119750,"_2978":52404},[],{"_3496":71519,"_30262":71471,"_21040":119858,"_5":14474,"_27550":119750,"_2978":119859},[],"Control aplicado en la operación configurada",{"_3496":71520,"_30262":71471,"_21040":119861,"_5":14474,"_27550":119750,"_2978":52410},[],{"_3496":71521,"_30262":71471,"_21040":119863,"_5":14474,"_27550":119750,"_2978":119864},[],"Validación del certificado presentado.",{"_3496":71522,"_30262":71471,"_21040":119866,"_5":14474,"_27550":119750,"_2978":52416},[],{"_3496":71523,"_30262":71471,"_21040":119868,"_5":14474,"_27550":119750,"_2978":119869},[],"Autorización del webhook configurado.",{"_3496":71524,"_30262":71471,"_21040":119871,"_5":14474,"_27550":119750,"_2978":52422},[],{"_3496":71525,"_30262":71471,"_21040":119873,"_5":14474,"_27550":119750,"_2978":119874},[],"Validación del certificado y, después, aprobación del webhook.",{"_3496":71526,"_30262":71471,"_21040":119876,"_5":14474,"_27550":119750,"_2978":52428},[],{"_3496":71527,"_30262":71471,"_21040":119878,"_5":14474,"_27550":119750,"_2978":119879},[],"Sin autenticación del solicitante por el DMS.",{"_3496":71528,"_30262":71471,"_21040":119881,"_5":14474,"_27550":119750,"_2978":119882},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3496":71529,"_30262":71471,"_21040":119884,"_5":14474,"_27550":119750,"_2978":119885},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3496":71530,"_30262":71471,"_21040":119887,"_5":14474,"_27550":119750,"_2978":119888},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3496":71531,"_30262":71471,"_21040":119890,"_5":14474,"_27550":119750,"_2978":119891},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3496":71532,"_30262":71471,"_21040":119893,"_5":14474,"_27550":119754,"_2978":119894},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3496":71533,"_30262":71471,"_21040":119896,"_5":14474,"_27550":119754,"_2978":119897},[],"Campo de `external_webhook_settings`",{"_3496":71534,"_30262":71471,"_21040":119899,"_5":14474,"_27550":119754,"_2978":119817},[],{"_3496":71535,"_30262":71471,"_21040":119901,"_5":14474,"_27550":119754,"_2978":52454},[],{"_3496":71536,"_30262":71471,"_21040":119903,"_5":14474,"_27550":119754,"_2978":119904},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3496":71537,"_30262":71471,"_21040":119906,"_5":14474,"_27550":119754,"_2978":52460},[],{"_3496":71538,"_30262":71471,"_21040":119908,"_5":14474,"_27550":119754,"_2978":119909},[],"`POST` o `PUT`; `POST` por defecto.",{"_3496":71539,"_30262":71471,"_21040":119911,"_5":14474,"_27550":119754,"_2978":52466},[],{"_3496":71540,"_30262":71471,"_21040":119913,"_5":14474,"_27550":119754,"_2978":119914},[],"Etiqueta usada en los logs del servicio.",{"_3496":71541,"_30262":71471,"_21040":119916,"_5":14474,"_27550":119754,"_2978":52472},[],{"_3496":71542,"_30262":71471,"_21040":119918,"_5":14474,"_27550":119754,"_2978":119919},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3496":71543,"_30262":71471,"_21040":119921,"_5":14474,"_27550":119754,"_2978":52478},[],{"_3496":71544,"_30262":71471,"_21040":119923,"_5":14474,"_27550":119754,"_2978":119924},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3496":71545,"_30262":71471,"_21040":119926,"_5":14474,"_27550":119754,"_2978":52484},[],{"_3496":71546,"_30262":71471,"_21040":119928,"_5":14474,"_27550":119754,"_2978":119929},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3496":71547,"_30262":71471,"_21040":119931,"_5":14474,"_27550":119754,"_2978":52490},[],{"_3496":71548,"_30262":71471,"_21040":119933,"_5":14474,"_27550":119754,"_2978":119934},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3496":71549,"_30262":71471,"_21040":119936,"_5":14474,"_27550":119754,"_2978":52496},[],{"_3496":71550,"_30262":71471,"_21040":119938,"_5":14474,"_27550":119754,"_2978":119939},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3496":71551,"_30262":71471,"_21040":119941,"_5":14474,"_27550":119754,"_2978":52502},[],{"_3496":71552,"_30262":71471,"_21040":119943,"_5":14474,"_27550":119754,"_2978":119944},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3496":71553,"_30262":71471,"_21040":119946,"_5":14474,"_27550":119754,"_2978":52508},[],{"_3496":71554,"_30262":71471,"_21040":119948,"_5":14474,"_27550":119754,"_2978":119949},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3496":71555,"_30262":71471,"_21040":119951,"_5":14474,"_27550":119754,"_2978":119952},[],"Reglas de esa configuración:",{"_3496":71556,"_30262":71471,"_21040":119954,"_5":14474,"_27550":119754,"_2978":119955},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3496":71557,"_30262":71471,"_21040":119957,"_5":14474,"_27550":119754,"_2978":119958},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3496":71558,"_30262":71471,"_21040":119960,"_5":14474,"_27550":119754,"_2978":119961},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3496":71559,"_30262":71471,"_21040":119963,"_5":14474,"_27550":119754,"_2978":119964},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3496":71560,"_30262":71471,"_21040":119966,"_5":14474,"_27550":119754,"_2978":119967},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3496":71561,"_30262":71471,"_21040":119969,"_5":14474,"_27550":119754,"_2978":119970},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3496":71562,"_30262":71471,"_21040":119972,"_5":14474,"_27550":119754,"_2978":119973},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3496":71563,"_30262":71471,"_21040":119975,"_5":14474,"_27550":119754,"_2978":119976},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3496":71564,"_30262":71471,"_21040":119978,"_5":14474,"_27550":119754,"_2978":119979},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3496":71565,"_30262":71471,"_21040":119981,"_5":14474,"_27550":119758,"_2978":119982},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3496":71566,"_30262":71471,"_21040":119984,"_5":14474,"_27550":119762,"_2978":119985},[],"Campo de `settings.reenrollment_settings`",{"_3496":71567,"_30262":71471,"_21040":119987,"_5":14474,"_27550":119762,"_2978":119988},[],"Función",{"_3496":71568,"_30262":71471,"_21040":119990,"_5":14474,"_27550":119762,"_2978":52552},[],{"_3496":71569,"_30262":71471,"_21040":119992,"_5":14474,"_27550":119762,"_2978":119993},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3496":71570,"_30262":71471,"_21040":119995,"_5":14474,"_27550":119762,"_2978":52558},[],{"_3496":71571,"_30262":71471,"_21040":119997,"_5":14474,"_27550":119762,"_2978":119998},[],"Umbral operativo preventivo de monitorización.",{"_3496":71572,"_30262":71471,"_21040":120000,"_5":14474,"_27550":119762,"_2978":52564},[],{"_3496":71573,"_30262":71471,"_21040":120002,"_5":14474,"_27550":119762,"_2978":120003},[],"Umbral operativo crítico de monitorización.",{"_3496":71574,"_30262":71471,"_21040":120005,"_5":14474,"_27550":119762,"_2978":52570},[],{"_3496":71575,"_30262":71471,"_21040":120007,"_5":14474,"_27550":119762,"_2978":120008},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3496":71576,"_30262":71471,"_21040":120010,"_5":14474,"_27550":119762,"_2978":52576},[],{"_3496":71577,"_30262":71471,"_21040":120012,"_5":14474,"_27550":119762,"_2978":120013},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3496":71578,"_30262":71471,"_21040":120015,"_5":14474,"_27550":119762,"_2978":52582},[],{"_3496":71579,"_30262":71471,"_21040":120017,"_5":14474,"_27550":119762,"_2978":120018},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3496":71580,"_30262":71471,"_21040":120020,"_5":14474,"_27550":119762,"_2978":120021},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3496":71581,"_30262":71471,"_21040":120023,"_5":14474,"_27550":119766,"_2978":120024},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3496":71582,"_30262":71471,"_21040":120026,"_5":14474,"_27550":119769,"_2978":117386},[],{"_3496":71583,"_30262":71471,"_21040":120028,"_5":14474,"_27550":119769,"_2978":120029},[],"Qué publica",{"_3496":71584,"_30262":71471,"_21040":120031,"_5":14474,"_27550":119769,"_2978":52599},[],{"_3496":71585,"_30262":71471,"_21040":120033,"_5":14474,"_27550":119769,"_2978":120034},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3496":71586,"_30262":71471,"_21040":120036,"_5":14474,"_27550":119769,"_2978":52605},[],{"_3496":71587,"_30262":71471,"_21040":120038,"_5":14474,"_27550":119769,"_2978":120039},[],"Certificado de la CA emisora seleccionada.",{"_3496":71588,"_30262":71471,"_21040":120041,"_5":14474,"_27550":119769,"_2978":52611},[],{"_3496":71589,"_30262":71471,"_21040":120043,"_5":14474,"_27550":119769,"_2978":120044},[],"Certificados de las CAs elegidas explícitamente.",{"_3496":71590,"_30262":71471,"_21040":120046,"_5":14474,"_27550":119769,"_2978":120047},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3496":71591,"_30262":71471,"_21040":120049,"_5":14474,"_27550":119773,"_2978":120050},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3496":71592,"_30262":71471,"_21040":120052,"_5":14474,"_27550":119773,"_2978":120053},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3496":71593,"_30262":71471,"_21040":120055,"_5":14474,"_27550":119773,"_2978":120056},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3496":71594,"_30262":71471,"_21040":120058,"_5":14474,"_27550":119777,"_2978":120059},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3496":71595,"_30262":71595,"_5":14825,"_2978":120061,"_30620":120062,"_21040":120063,"_27550":71595},"Integra el cliente EST",[49507,118444,51989,119456,119631],[],{"_3496":71596,"_30262":71595,"_21040":120065,"_5":14474,"_27550":71595,"_2978":120066},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3496":71597,"_30262":71595,"_5":30617,"_21040":120068,"_27550":120069,"_2978":117022},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3496":71598,"_30262":71595,"_5":30617,"_21040":120071,"_27550":120072,"_2978":120073},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3496":71599,"_30262":71595,"_5":30617,"_21040":120075,"_27550":120076,"_2978":120077},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3496":71600,"_30262":71595,"_5":30617,"_21040":120079,"_27550":120080,"_2978":120081},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3496":71601,"_30262":71595,"_5":30617,"_21040":120083,"_27550":120084,"_2978":120085},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3496":71602,"_30262":71595,"_5":30617,"_21040":120087,"_27550":120088,"_2978":120089},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3496":71603,"_30262":71595,"_21040":120091,"_5":14474,"_27550":71595,"_2978":120092},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3496":71604,"_30262":71595,"_21040":120094,"_5":14474,"_27550":120069,"_2978":120095},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3496":71605,"_30262":71595,"_21040":120097,"_5":14474,"_27550":120069,"_2978":120098},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3496":71606,"_30262":71595,"_21040":120100,"_5":14474,"_27550":120069,"_2978":120101},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3496":71607,"_30262":71595,"_21040":120103,"_5":14474,"_27550":120072,"_2978":120104},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3496":71608,"_30262":71595,"_21040":120106,"_5":14474,"_27550":120072,"_2978":120107},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3496":71609,"_30262":71595,"_21040":120109,"_5":14474,"_27550":120076,"_2978":120110},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3496":71610,"_30262":71595,"_21040":120112,"_5":14474,"_27550":120076,"_2978":120113},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3496":71611,"_30262":71595,"_21040":120115,"_5":14474,"_27550":120080,"_2978":120116},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3496":71612,"_30262":71595,"_21040":120118,"_5":14474,"_27550":120080,"_2978":120119},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3496":71613,"_30262":71595,"_21040":120121,"_5":14474,"_27550":120084,"_2978":120122},[],"Para el caso de una raíz que emite directamente:",{"_3496":71614,"_30262":71595,"_21040":120124,"_5":14474,"_27550":120084,"_2978":120125},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3496":71615,"_30262":71595,"_21040":120127,"_5":14474,"_27550":120084,"_2978":120128},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3496":71616,"_30262":71595,"_21040":120130,"_5":14474,"_27550":120088,"_2978":120131},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3496":71617,"_30262":71617,"_5":14825,"_2978":120133,"_30620":120134,"_21040":120135,"_27550":71617},"Referencia EST",[49507,118444,51989,119456,119631],[],{"_3496":71618,"_30262":71617,"_21040":120137,"_5":14474,"_27550":71617,"_2978":120138},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3496":71619,"_30262":71617,"_5":30617,"_21040":120140,"_27550":120141,"_2978":120142},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3496":71620,"_30262":71617,"_5":30617,"_21040":120144,"_27550":120145,"_2978":22801},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3496":71621,"_30262":71617,"_5":30617,"_21040":120147,"_27550":120148,"_2978":26155},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3496":71622,"_30262":71617,"_5":30617,"_21040":120150,"_27550":120151,"_2978":26162},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3496":71623,"_30262":71617,"_5":30617,"_21040":120153,"_27550":120154,"_2978":25481},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3496":71624,"_30262":71617,"_5":30617,"_21040":120156,"_27550":120157,"_2978":120158},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3496":71625,"_30262":71617,"_5":30617,"_21040":120160,"_27550":120161,"_2978":120162},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3496":71626,"_30262":71617,"_5":30617,"_21040":120164,"_27550":120165,"_2978":120166},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3496":71627,"_30262":71617,"_21040":120168,"_5":14474,"_27550":71617,"_2978":120169},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3496":71628,"_30262":71617,"_21040":120171,"_5":14474,"_27550":120141,"_2978":120172},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3496":71629,"_30262":71617,"_21040":120174,"_5":14474,"_27550":120141,"_2978":118204},[],{"_3496":71630,"_30262":71617,"_21040":120176,"_5":14474,"_27550":120141,"_2978":120177},[],"Método",{"_3496":71631,"_30262":71617,"_21040":120179,"_5":14474,"_27550":120141,"_2978":120180},[],"Autenticación y condición",{"_3496":71632,"_30262":71617,"_21040":120182,"_5":14474,"_27550":120141,"_2978":52754},[],{"_3496":71633,"_30262":71617,"_21040":120184,"_5":14474,"_27550":120141,"_2978":52757},[],{"_3496":71634,"_30262":71617,"_21040":120186,"_5":14474,"_27550":120141,"_2978":120187},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3496":71635,"_30262":71617,"_21040":120189,"_5":14474,"_27550":120141,"_2978":52763},[],{"_3496":71636,"_30262":71617,"_21040":120191,"_5":14474,"_27550":120141,"_2978":52766},[],{"_3496":71637,"_30262":71617,"_21040":120193,"_5":14474,"_27550":120141,"_2978":120194},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3496":71638,"_30262":71617,"_21040":120196,"_5":14474,"_27550":120141,"_2978":52772},[],{"_3496":71639,"_30262":71617,"_21040":120198,"_5":14474,"_27550":120141,"_2978":52766},[],{"_3496":71640,"_30262":71617,"_21040":120200,"_5":14474,"_27550":120141,"_2978":120201},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3496":71641,"_30262":71617,"_21040":120203,"_5":14474,"_27550":120141,"_2978":52780},[],{"_3496":71642,"_30262":71617,"_21040":120205,"_5":14474,"_27550":120141,"_2978":52766},[],{"_3496":71643,"_30262":71617,"_21040":120207,"_5":14474,"_27550":120141,"_2978":120208},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3496":71644,"_30262":71617,"_21040":120210,"_5":14474,"_27550":120141,"_2978":120211},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3496":71645,"_30262":71617,"_21040":120213,"_5":14474,"_27550":120145,"_2978":120214},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3496":71646,"_30262":71617,"_21040":120216,"_5":14474,"_27550":120145,"_2978":120217},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3496":71647,"_30262":71617,"_21040":120219,"_5":14474,"_27550":120148,"_2978":120220},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3496":71648,"_30262":71617,"_21040":120222,"_5":14474,"_27550":120148,"_2978":120223},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3496":71649,"_30262":71617,"_21040":120225,"_5":14474,"_27550":120151,"_2978":120226},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3496":71650,"_30262":71617,"_21040":120228,"_5":14474,"_27550":120151,"_2978":120229},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3496":71651,"_30262":71617,"_21040":120231,"_5":14474,"_27550":120154,"_2978":120232},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3496":71652,"_30262":71617,"_21040":120234,"_5":14474,"_27550":120154,"_2978":120235},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3496":71653,"_30262":71617,"_21040":120237,"_5":14474,"_27550":120157,"_2978":120238},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3496":71654,"_30262":71617,"_21040":120240,"_5":14474,"_27550":120157,"_2978":120241},[],"Parte",{"_3496":71655,"_30262":71617,"_21040":120243,"_5":14474,"_27550":120157,"_2978":120244},[],"Contenido tras decodificar su Base64",{"_3496":71656,"_30262":71617,"_21040":120246,"_5":14474,"_27550":120157,"_2978":52824},[],{"_3496":71657,"_30262":71617,"_21040":120248,"_5":14474,"_27550":120157,"_2978":120249},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3496":71658,"_30262":71617,"_21040":120251,"_5":14474,"_27550":120157,"_2978":52830},[],{"_3496":71659,"_30262":71617,"_21040":120253,"_5":14474,"_27550":120157,"_2978":120254},[],"PKCS#7 DER con el certificado emitido.",{"_3496":71660,"_30262":71617,"_21040":120256,"_5":14474,"_27550":120157,"_2978":120257},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3496":71661,"_30262":71617,"_21040":120259,"_5":14474,"_27550":120161,"_2978":120260},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3496":71662,"_30262":71617,"_21040":120262,"_5":14474,"_27550":120161,"_2978":120263},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3496":71663,"_30262":71617,"_21040":120265,"_5":14474,"_27550":120161,"_2978":120266},[],"Convierte y comprueba el resultado:",{"_3496":71664,"_30262":71617,"_21040":120268,"_5":14474,"_27550":120161,"_2978":120269},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3496":71665,"_30262":71617,"_21040":120271,"_5":14474,"_27550":120165,"_2978":120272},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3496":71666,"_30262":71617,"_21040":120274,"_5":14474,"_27550":120165,"_2978":120275},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3496":71667,"_30262":71667,"_5":14825,"_2978":119631,"_30620":120277,"_21040":120278,"_27550":71667},[49507,118444,51989,119456,119631],[],{"_3496":71668,"_30262":71667,"_21040":120280,"_5":14474,"_27550":71667,"_2978":120281},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3496":71669,"_30262":71667,"_5":30617,"_21040":120283,"_27550":120284,"_2978":120285},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3496":71670,"_30262":71667,"_5":30617,"_21040":120287,"_27550":120288,"_2978":120289},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3496":71671,"_30262":71667,"_5":30617,"_21040":120291,"_27550":120292,"_2978":120293},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3496":71672,"_30262":71667,"_5":30617,"_21040":120295,"_27550":120296,"_2978":120297},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3496":71673,"_30262":71667,"_21040":120299,"_5":14474,"_27550":71667,"_2978":120300},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3496":71674,"_30262":71667,"_21040":120302,"_5":14474,"_27550":120284,"_2978":120303},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3496":71675,"_30262":71667,"_21040":120305,"_5":14474,"_27550":120284,"_2978":120306},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3496":71676,"_30262":71667,"_21040":120308,"_5":14474,"_27550":120284,"_2978":120309},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3496":71677,"_30262":71667,"_21040":120311,"_5":14474,"_27550":120284,"_2978":120312},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3496":71678,"_30262":71667,"_21040":120314,"_5":14474,"_27550":120284,"_2978":120315},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3496":71679,"_30262":71667,"_21040":120317,"_5":14474,"_27550":120284,"_2978":120318},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3496":71680,"_30262":71667,"_21040":120320,"_5":14474,"_27550":120288,"_2978":120321},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3496":71681,"_30262":71667,"_21040":120323,"_5":14474,"_27550":120288,"_2978":120324},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3496":71682,"_30262":71667,"_21040":120326,"_5":14474,"_27550":120288,"_2978":120327},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3496":71683,"_30262":71667,"_21040":120329,"_5":14474,"_27550":120288,"_2978":120330},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3496":71684,"_30262":71667,"_21040":120332,"_5":14474,"_27550":120292,"_2978":120333},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3496":71685,"_30262":71667,"_21040":120335,"_5":14474,"_27550":120292,"_2978":120336},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3496":71686,"_30262":71667,"_21040":120338,"_5":14474,"_27550":120292,"_2978":120339},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3496":71687,"_30262":71667,"_21040":120341,"_5":14474,"_27550":120292,"_2978":120342},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3496":71688,"_30262":71667,"_21040":120344,"_5":14474,"_27550":120296,"_2978":120345},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3496":71689,"_30262":71667,"_21040":120347,"_5":14474,"_27550":120296,"_2978":120348},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3496":71690,"_30262":71690,"_5":14825,"_2978":120350,"_30620":120351,"_21040":120352,"_27550":71690},"Estrategias de aprovisionamiento",[49507,118444,51989,119456,119631],[],{"_3496":71691,"_30262":71690,"_21040":120354,"_5":14474,"_27550":71690,"_2978":120355},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3496":71692,"_30262":71690,"_5":30617,"_21040":120357,"_27550":120358,"_2978":120359},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3496":71693,"_30262":71690,"_5":30617,"_21040":120361,"_27550":120362,"_2978":120363},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3496":71694,"_30262":71690,"_5":30617,"_21040":120365,"_27550":120366,"_2978":120367},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3496":71695,"_30262":71690,"_5":30617,"_21040":120369,"_27550":120370,"_2978":120371},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3496":71696,"_30262":71690,"_5":30617,"_21040":120373,"_27550":120374,"_2978":120375},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3496":71697,"_30262":71690,"_21040":120377,"_5":14474,"_27550":71690,"_2978":120378},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3496":71698,"_30262":71690,"_21040":120380,"_5":14474,"_27550":120358,"_2978":120381},[],"Recorrido",{"_3496":71699,"_30262":71690,"_21040":120383,"_5":14474,"_27550":120358,"_2978":120384},[],"Cuándo existe el dispositivo",{"_3496":71700,"_30262":71690,"_21040":120386,"_5":14474,"_27550":120358,"_2978":120387},[],"Qué compruebas",{"_3496":71701,"_30262":71690,"_21040":120389,"_5":14474,"_27550":120358,"_2978":120390},[],"Asignación manual",{"_3496":71702,"_30262":71690,"_21040":120392,"_5":14474,"_27550":120358,"_2978":120393},[],"El operador lo crea antes de asociar un certificado.",{"_3496":71703,"_30262":71690,"_21040":120395,"_5":14474,"_27550":120358,"_2978":120396},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3496":71704,"_30262":71690,"_21040":120398,"_5":14474,"_27550":120358,"_2978":120399},[],"EST con `JITP`",{"_3496":71705,"_30262":71690,"_21040":120401,"_5":14474,"_27550":120358,"_2978":120402},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3496":71706,"_30262":71690,"_21040":120404,"_5":14474,"_27550":120358,"_2978":120405},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3496":71707,"_30262":71690,"_21040":120407,"_5":14474,"_27550":120358,"_2978":120408},[],"EST con `PRE_REGISTRATION`",{"_3496":71708,"_30262":71690,"_21040":120410,"_5":14474,"_27550":120358,"_2978":120411},[],"Debe existir antes de `/simpleenroll`.",{"_3496":71709,"_30262":71690,"_21040":120413,"_5":14474,"_27550":120358,"_2978":120414},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3496":71710,"_30262":71690,"_21040":120416,"_5":14474,"_27550":120358,"_2978":120417},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3496":71711,"_30262":71690,"_21040":120419,"_5":14474,"_27550":120358,"_2978":120420},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3496":71712,"_30262":71690,"_21040":120422,"_5":14474,"_27550":120362,"_2978":120423},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3496":71713,"_30262":71690,"_21040":120425,"_5":14474,"_27550":120362,"_2978":120426},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3496":71714,"_30262":71690,"_21040":120428,"_5":14474,"_27550":120362,"_2978":120429},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3496":71715,"_30262":71690,"_21040":120431,"_5":14474,"_27550":120366,"_2978":120432},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3496":71716,"_30262":71690,"_21040":120434,"_5":14474,"_27550":120366,"_2978":120435},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3496":71717,"_30262":71690,"_21040":120437,"_5":14474,"_27550":120366,"_2978":120438},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3496":71718,"_30262":71690,"_21040":120440,"_5":14474,"_27550":120366,"_2978":120441},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3496":71719,"_30262":71690,"_21040":120443,"_5":14474,"_27550":120366,"_2978":120444},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3496":71720,"_30262":71690,"_21040":120446,"_5":14474,"_27550":120366,"_2978":120447},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3496":71721,"_30262":71690,"_21040":120449,"_5":14474,"_27550":120370,"_2978":117386},[],{"_3496":71722,"_30262":71690,"_21040":120451,"_5":14474,"_27550":120370,"_2978":120452},[],"Material que atraviesa EST",{"_3496":71723,"_30262":71690,"_21040":120454,"_5":14474,"_27550":120370,"_2978":120455},[],"Clave generada por el dispositivo",{"_3496":71724,"_30262":71690,"_21040":120457,"_5":14474,"_27550":120370,"_2978":120458},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3496":71725,"_30262":71690,"_21040":120460,"_5":14474,"_27550":120370,"_2978":120461},[],"Clave ya disponible en el dispositivo",{"_3496":71726,"_30262":71690,"_21040":120463,"_5":14474,"_27550":120370,"_2978":120464},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3496":71727,"_30262":71690,"_21040":120466,"_5":14474,"_27550":120370,"_2978":52308},[],{"_3496":71728,"_30262":71690,"_21040":120468,"_5":14474,"_27550":120370,"_2978":120469},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3496":71729,"_30262":71690,"_21040":120471,"_5":14474,"_27550":120370,"_2978":120472},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3496":71730,"_30262":71690,"_21040":120474,"_5":14474,"_27550":120374,"_2978":120475},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3496":71731,"_30262":71731,"_5":14825,"_2978":120477,"_30620":120478,"_21040":120479,"_27550":71731},"Renovación y recuperación",[49507,118444,51989,119456,119631],[],{"_3496":71732,"_30262":71731,"_21040":120481,"_5":14474,"_27550":71731,"_2978":120482},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3496":71733,"_30262":71731,"_5":30617,"_21040":120484,"_27550":120485,"_2978":120486},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3496":71734,"_30262":71731,"_5":30617,"_21040":120488,"_27550":120489,"_2978":120490},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3496":71735,"_30262":71731,"_5":30617,"_21040":120492,"_27550":120493,"_2978":120494},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3496":71736,"_30262":71731,"_5":30617,"_21040":120496,"_27550":120497,"_2978":120498},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3496":71737,"_30262":71731,"_5":30617,"_21040":120500,"_27550":120501,"_2978":120502},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3496":71738,"_30262":71731,"_21040":120504,"_5":14474,"_27550":71731,"_2978":120505},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3496":71739,"_30262":71731,"_21040":120507,"_5":14474,"_27550":120485,"_2978":120508},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3496":71740,"_30262":71731,"_21040":120510,"_5":14474,"_27550":120485,"_2978":120511},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3496":71741,"_30262":71731,"_21040":120513,"_5":14474,"_27550":120485,"_2978":120514},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3496":71742,"_30262":71731,"_21040":120516,"_5":14474,"_27550":120485,"_2978":120517},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3496":71743,"_30262":71731,"_21040":120519,"_5":14474,"_27550":120489,"_2978":120520},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3496":71744,"_30262":71731,"_21040":120522,"_5":14474,"_27550":120489,"_2978":120523},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3496":71745,"_30262":71731,"_21040":120525,"_5":14474,"_27550":120493,"_2978":120526},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3496":71746,"_30262":71731,"_21040":120528,"_5":14474,"_27550":120493,"_2978":120529},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3496":71747,"_30262":71731,"_21040":120531,"_5":14474,"_27550":120493,"_2978":120532},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3496":71748,"_30262":71731,"_21040":120534,"_5":14474,"_27550":120497,"_2978":120535},[],"Situación",{"_3496":71749,"_30262":71731,"_21040":120537,"_5":14474,"_27550":120497,"_2978":120538},[],"Procedimiento",{"_3496":71750,"_30262":71731,"_21040":120540,"_5":14474,"_27550":120497,"_2978":120541},[],"Certificado vigente, fuera de ventana",{"_3496":71751,"_30262":71731,"_21040":120543,"_5":14474,"_27550":120497,"_2978":120544},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3496":71752,"_30262":71731,"_21040":120546,"_5":14474,"_27550":120497,"_2978":120547},[],"Certificado vencido, clave disponible",{"_3496":71753,"_30262":71731,"_21040":120549,"_5":14474,"_27550":120497,"_2978":120550},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3496":71754,"_30262":71731,"_21040":120552,"_5":14474,"_27550":120497,"_2978":120553},[],"Renovación por webhook o `NO_AUTH`",{"_3496":71755,"_30262":71731,"_21040":120555,"_5":14474,"_27550":120497,"_2978":120556},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3496":71756,"_30262":71731,"_21040":120558,"_5":14474,"_27550":120497,"_2978":120559},[],"Clave perdida o inaccesible",{"_3496":71757,"_30262":71731,"_21040":120561,"_5":14474,"_27550":120497,"_2978":120562},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3496":71758,"_30262":71731,"_21040":120564,"_5":14474,"_27550":120497,"_2978":120565},[],"Identidad actual revocada",{"_3496":71759,"_30262":71731,"_21040":120567,"_5":14474,"_27550":120497,"_2978":120568},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3496":71760,"_30262":71731,"_21040":120570,"_5":14474,"_27550":120497,"_2978":120571},[],"Dispositivo sin identidad",{"_3496":71761,"_30262":71731,"_21040":120573,"_5":14474,"_27550":120497,"_2978":120574},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3496":71762,"_30262":71731,"_21040":120576,"_5":14474,"_27550":120497,"_2978":120577},[],"Dispositivo retirado",{"_3496":71763,"_30262":71731,"_21040":120579,"_5":14474,"_27550":120497,"_2978":120580},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3496":71764,"_30262":71731,"_21040":120582,"_5":14474,"_27550":120497,"_2978":120583},[],"Timeout, HTTP 500 o fallo de instalación",{"_3496":71765,"_30262":71731,"_21040":120585,"_5":14474,"_27550":120497,"_2978":120586},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3496":71766,"_30262":71731,"_21040":120588,"_5":14474,"_27550":120501,"_2978":120589},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3496":71767,"_30262":71731,"_21040":120591,"_5":14474,"_27550":120501,"_2978":120592},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3496":71768,"_30262":71768,"_5":14825,"_2978":120594,"_30620":120595,"_21040":120596,"_27550":71768},"Diagnóstico de enrolamiento",[49507,118444,51989,119456,119631],[],{"_3496":71769,"_30262":71768,"_21040":120598,"_5":14474,"_27550":71768,"_2978":120599},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3496":71770,"_30262":71768,"_5":30617,"_21040":120601,"_27550":120602,"_2978":120603},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3496":71771,"_30262":71768,"_5":30617,"_21040":120605,"_27550":120606,"_2978":120607},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3496":71772,"_30262":71768,"_5":30617,"_21040":120609,"_27550":120610,"_2978":120166},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3496":71773,"_30262":71768,"_5":30617,"_21040":120612,"_27550":120613,"_2978":120614},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3496":71774,"_30262":71768,"_21040":120616,"_5":14474,"_27550":71768,"_2978":120617},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3496":71775,"_30262":71768,"_21040":120619,"_5":14474,"_27550":120606,"_2978":120620},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3496":71776,"_30262":71768,"_21040":120622,"_5":14474,"_27550":120606,"_2978":120623},[],"Síntoma o mensaje",{"_3496":71777,"_30262":71768,"_21040":120625,"_5":14474,"_27550":120606,"_2978":120626},[],"Qué revisar",{"_3496":71778,"_30262":71768,"_21040":120628,"_5":14474,"_27550":120606,"_2978":120629},[],"curl rechaza TLS, nombre o emisor",{"_3496":71779,"_30262":71768,"_21040":120631,"_5":14474,"_27550":120606,"_2978":120632},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3496":71780,"_30262":71768,"_21040":120634,"_5":14474,"_27550":120606,"_2978":120635},[],"404 o APS ausente",{"_3496":71781,"_30262":71768,"_21040":120637,"_5":14474,"_27550":120606,"_2978":120638},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3496":71782,"_30262":71768,"_21040":120640,"_5":14474,"_27550":120606,"_2978":120641},[],"400, error de CSR o formato",{"_3496":71783,"_30262":71768,"_21040":120643,"_5":14474,"_27550":120606,"_2978":120644},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3496":71784,"_30262":71768,"_21040":120646,"_5":14474,"_27550":120606,"_2978":120647},[],"Credencial ausente o certificado no válido",{"_3496":71785,"_30262":71768,"_21040":120649,"_5":14474,"_27550":120606,"_2978":120650},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3496":71786,"_30262":71768,"_21040":120652,"_5":14474,"_27550":120606,"_2978":120653},[],"Webhook deniega, expira o responde sin autorización",{"_3496":71787,"_30262":71768,"_21040":120655,"_5":14474,"_27550":120606,"_2978":120656},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3496":71788,"_30262":71768,"_21040":120658,"_5":14474,"_27550":120606,"_2978":53237},[],{"_3496":71789,"_30262":71768,"_21040":120660,"_5":14474,"_27550":120606,"_2978":120661},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3496":71790,"_30262":71768,"_21040":120663,"_5":14474,"_27550":120606,"_2978":53243},[],{"_3496":71791,"_30262":71768,"_21040":120665,"_5":14474,"_27550":120606,"_2978":120666},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3496":71792,"_30262":71768,"_21040":120668,"_5":14474,"_27550":120606,"_2978":53249},[],{"_3496":71793,"_30262":71768,"_21040":120670,"_5":14474,"_27550":120606,"_2978":120671},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3496":71794,"_30262":71768,"_21040":120673,"_5":14474,"_27550":120606,"_2978":53255},[],{"_3496":71795,"_30262":71768,"_21040":120675,"_5":14474,"_27550":120606,"_2978":120676},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3496":71796,"_30262":71768,"_21040":120678,"_5":14474,"_27550":120606,"_2978":53261},[],{"_3496":71797,"_30262":71768,"_21040":120680,"_5":14474,"_27550":120606,"_2978":120681},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3496":71798,"_30262":71768,"_21040":120683,"_5":14474,"_27550":120606,"_2978":120684},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3496":71799,"_30262":71768,"_21040":120686,"_5":14474,"_27550":120606,"_2978":120687},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3496":71800,"_30262":71768,"_21040":120689,"_5":14474,"_27550":120606,"_2978":120690},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3496":71801,"_30262":71768,"_21040":120692,"_5":14474,"_27550":120606,"_2978":120693},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3496":71802,"_30262":71768,"_21040":120695,"_5":14474,"_27550":120606,"_2978":53279},[],{"_3496":71803,"_30262":71768,"_21040":120697,"_5":14474,"_27550":120606,"_2978":120698},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3496":71804,"_30262":71768,"_21040":120700,"_5":14474,"_27550":120606,"_2978":53285},[],{"_3496":71805,"_30262":71768,"_21040":120702,"_5":14474,"_27550":120606,"_2978":120703},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3496":71806,"_30262":71768,"_21040":120705,"_5":14474,"_27550":120606,"_2978":120706},[],"DMS propietario distinto",{"_3496":71807,"_30262":71768,"_21040":120708,"_5":14474,"_27550":120606,"_2978":120709},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3496":71808,"_30262":71768,"_21040":120711,"_5":14474,"_27550":120606,"_2978":53297},[],{"_3496":71809,"_30262":71768,"_21040":120713,"_5":14474,"_27550":120606,"_2978":120714},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3496":71810,"_30262":71768,"_21040":120716,"_5":14474,"_27550":120606,"_2978":53303},[],{"_3496":71811,"_30262":71768,"_21040":120718,"_5":14474,"_27550":120606,"_2978":120719},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3496":71812,"_30262":71768,"_21040":120721,"_5":14474,"_27550":120606,"_2978":120722},[],"Certificado actual revocado",{"_3496":71813,"_30262":71768,"_21040":120724,"_5":14474,"_27550":120606,"_2978":120725},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3496":71814,"_30262":71768,"_21040":120727,"_5":14474,"_27550":120606,"_2978":120728},[],"Error de CA, perfil o firma",{"_3496":71815,"_30262":71768,"_21040":120730,"_5":14474,"_27550":120606,"_2978":120731},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3496":71816,"_30262":71768,"_21040":120733,"_5":14474,"_27550":120606,"_2978":120734},[],"HTTP 200 sin conexión del dispositivo",{"_3496":71817,"_30262":71768,"_21040":120736,"_5":14474,"_27550":120606,"_2978":120737},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3496":71818,"_30262":71768,"_21040":120739,"_5":14474,"_27550":120606,"_2978":120740},[],"Timeout o error después de emitir",{"_3496":71819,"_30262":71768,"_21040":120742,"_5":14474,"_27550":120606,"_2978":120743},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3496":71820,"_30262":71768,"_21040":120745,"_5":14474,"_27550":120610,"_2978":120746},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3496":71821,"_30262":71768,"_21040":120748,"_5":14474,"_27550":120610,"_2978":120749},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3496":71822,"_30262":71768,"_21040":120751,"_5":14474,"_27550":120613,"_2978":120752},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3496":71823,"_30262":71768,"_21040":120754,"_5":14474,"_27550":120613,"_2978":120755},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3496":71824,"_30262":71768,"_21040":120757,"_5":14474,"_27550":120613,"_2978":120758},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3496":71825,"_30262":71768,"_21040":120760,"_5":14474,"_27550":120613,"_2978":120761},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3496":71826,"_30262":71768,"_21040":120763,"_5":14474,"_27550":120613,"_2978":120764},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3496":71827,"_30262":71768,"_21040":120766,"_5":14474,"_27550":120613,"_2978":120767},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3496":71828,"_30262":71768,"_21040":120769,"_5":14474,"_27550":120613,"_2978":120770},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3496":71829,"_30262":71829,"_5":14825,"_2978":120772,"_30620":120773,"_21040":120774,"_27550":71829},"Distribución y actualización de confianza",[49507,118444,51989,119456,119631],[],{"_3496":71830,"_30262":71829,"_21040":120776,"_5":14474,"_27550":71829,"_2978":120777},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3496":71831,"_30262":71829,"_5":30617,"_21040":120779,"_27550":120780,"_2978":120781},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3496":71832,"_30262":71829,"_5":30617,"_21040":120783,"_27550":120784,"_2978":120785},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3496":71833,"_30262":71829,"_5":30617,"_21040":120787,"_27550":120788,"_2978":120789},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3496":71834,"_30262":71829,"_5":30617,"_21040":120791,"_27550":120792,"_2978":120793},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3496":71835,"_30262":71829,"_5":30617,"_21040":120795,"_27550":120796,"_2978":120797},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3496":71836,"_30262":71829,"_21040":120799,"_5":14474,"_27550":71829,"_2978":120800},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3496":71837,"_30262":71829,"_21040":120802,"_5":14474,"_27550":120780,"_2978":120803},[],"Relación",{"_3496":71838,"_30262":71829,"_21040":120805,"_5":14474,"_27550":120780,"_2978":120806},[],"Material que prepara el responsable",{"_3496":71839,"_30262":71829,"_21040":120808,"_5":14474,"_27550":120780,"_2978":120809},[],"Dispositivo → servidor EST",{"_3496":71840,"_30262":71829,"_21040":120811,"_5":14474,"_27550":120780,"_2978":120812},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3496":71841,"_30262":71829,"_21040":120814,"_5":14474,"_27550":120780,"_2978":120815},[],"DMS → solicitante",{"_3496":71842,"_30262":71829,"_21040":120817,"_5":14474,"_27550":120780,"_2978":120818},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3496":71843,"_30262":71829,"_21040":120820,"_5":14474,"_27550":120780,"_2978":120821},[],"Consumidor → dispositivo",{"_3496":71844,"_30262":71829,"_21040":120823,"_5":14474,"_27550":120780,"_2978":120824},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3496":71845,"_30262":71829,"_21040":120826,"_5":14474,"_27550":120780,"_2978":120827},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3496":71846,"_30262":71829,"_21040":120829,"_5":14474,"_27550":120784,"_2978":120830},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3496":71847,"_30262":71829,"_21040":120832,"_5":14474,"_27550":120784,"_2978":120833},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3496":71848,"_30262":71829,"_21040":120835,"_5":14474,"_27550":120788,"_2978":120836},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3496":71849,"_30262":71829,"_21040":120838,"_5":14474,"_27550":120788,"_2978":120839},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3496":71850,"_30262":71829,"_21040":120841,"_5":14474,"_27550":120788,"_2978":120842},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3496":71851,"_30262":71829,"_21040":120844,"_5":14474,"_27550":120788,"_2978":120845},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3496":71852,"_30262":71829,"_21040":120847,"_5":14474,"_27550":120788,"_2978":120848},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3496":71853,"_30262":71829,"_21040":120850,"_5":14474,"_27550":120788,"_2978":120851},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3496":71854,"_30262":71829,"_21040":120853,"_5":14474,"_27550":120792,"_2978":120854},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3496":71855,"_30262":71829,"_21040":120856,"_5":14474,"_27550":120792,"_2978":120857},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3496":71856,"_30262":71829,"_21040":120859,"_5":14474,"_27550":120792,"_2978":120860},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3496":71857,"_30262":71829,"_21040":120862,"_5":14474,"_27550":120796,"_2978":120863},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3496":71858,"_30262":71858,"_5":14825,"_2978":53452,"_30620":120865,"_21040":120867,"_27550":71858},[49507,118444,51989,119456,120866],"Integraciones",[],{"_3496":71859,"_30262":71858,"_21040":120869,"_5":14474,"_27550":71858,"_2978":120870},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3496":71860,"_30262":71858,"_5":30617,"_21040":120872,"_27550":120873,"_2978":120874},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3496":71861,"_30262":71858,"_5":30617,"_21040":120876,"_27550":120877,"_2978":120878},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3496":71862,"_30262":71858,"_5":30617,"_21040":120880,"_27550":120881,"_2978":120882},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3496":71863,"_30262":71858,"_5":30617,"_21040":120884,"_27550":120885,"_2978":120886},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3496":71864,"_30262":71858,"_5":30617,"_21040":120888,"_27550":120889,"_2978":120890},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3496":71865,"_30262":71858,"_5":30617,"_21040":120892,"_27550":120893,"_2978":120894},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3496":71866,"_30262":71858,"_5":30617,"_21040":120896,"_27550":120897,"_2978":120898},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3496":71867,"_30262":71858,"_5":30617,"_21040":120900,"_27550":120901,"_2978":120902},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3496":71868,"_30262":71858,"_5":30617,"_21040":120904,"_27550":120905,"_2978":53494},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3496":71869,"_30262":71858,"_5":30617,"_21040":120907,"_27550":120908,"_2978":53498},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3496":71870,"_30262":71858,"_5":30617,"_21040":120910,"_27550":120911,"_2978":120912},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3496":71871,"_30262":71858,"_5":30617,"_21040":120914,"_27550":120915,"_2978":120916},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3496":71872,"_30262":71858,"_5":30617,"_21040":120918,"_27550":120919,"_2978":120920},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3496":71873,"_30262":71858,"_5":30617,"_21040":120922,"_27550":120923,"_2978":120924},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3496":71874,"_30262":71858,"_5":30617,"_21040":120926,"_27550":120927,"_2978":120928},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3496":71875,"_30262":71858,"_5":30617,"_21040":120930,"_27550":120931,"_2978":120932},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3496":71876,"_30262":71858,"_5":30617,"_21040":120934,"_27550":120935,"_2978":120936},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3496":71877,"_30262":71858,"_5":30617,"_21040":120938,"_27550":120939,"_2978":120940},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3496":71878,"_30262":71858,"_5":30617,"_21040":120942,"_27550":120943,"_2978":120944},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3496":71879,"_30262":71858,"_5":30617,"_21040":120946,"_27550":120947,"_2978":120948},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3496":71880,"_30262":71858,"_5":30617,"_21040":120950,"_27550":120951,"_2978":120952},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3496":71881,"_30262":71858,"_5":30617,"_21040":120954,"_27550":120955,"_2978":120956},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3496":71882,"_30262":71858,"_5":30617,"_21040":120958,"_27550":120959,"_2978":120960},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3496":71883,"_30262":71858,"_5":30617,"_21040":120962,"_27550":120963,"_2978":120964},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3496":71884,"_30262":71858,"_5":30617,"_21040":120966,"_27550":120967,"_2978":120968},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3496":71885,"_30262":71858,"_21040":120970,"_5":14474,"_27550":71858,"_2978":120971},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3496":71886,"_30262":71858,"_21040":120973,"_5":14474,"_27550":71858,"_2978":120974},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3496":71887,"_30262":71858,"_21040":120976,"_5":14474,"_27550":71858,"_2978":120977},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3496":71888,"_30262":71858,"_21040":120979,"_5":14474,"_27550":120873,"_2978":120980},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3496":71889,"_30262":71858,"_21040":120982,"_5":14474,"_27550":120873,"_2978":120983},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3496":71890,"_30262":71858,"_21040":120985,"_5":14474,"_27550":120873,"_2978":120986},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3496":71891,"_30262":71858,"_21040":120988,"_5":14474,"_27550":120873,"_2978":120989},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3496":71892,"_30262":71858,"_21040":120991,"_5":14474,"_27550":120877,"_2978":120992},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3496":71893,"_30262":71858,"_21040":120994,"_5":14474,"_27550":120881,"_2978":120995},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3496":71894,"_30262":71858,"_21040":120997,"_5":14474,"_27550":120881,"_2978":120998},[],"Acción IAM",{"_3496":71895,"_30262":71858,"_21040":121000,"_5":14474,"_27550":120881,"_2978":117392},[],{"_3496":71896,"_30262":71858,"_21040":121002,"_5":14474,"_27550":120881,"_2978":53593},[],{"_3496":71897,"_30262":71858,"_21040":121004,"_5":14474,"_27550":120881,"_2978":121005},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3496":71898,"_30262":71858,"_21040":121007,"_5":14474,"_27550":120881,"_2978":53599},[],{"_3496":71899,"_30262":71858,"_21040":121009,"_5":14474,"_27550":120881,"_2978":121010},[],"Registrar la CA en AWS IoT",{"_3496":71900,"_30262":71858,"_21040":121012,"_5":14474,"_27550":120881,"_2978":53605},[],{"_3496":71901,"_30262":71858,"_21040":121014,"_5":14474,"_27550":120881,"_2978":121015},[],"Consultar el estado del registro de la CA",{"_3496":71902,"_30262":71858,"_21040":121017,"_5":14474,"_27550":120881,"_2978":53611},[],{"_3496":71903,"_30262":71858,"_21040":121019,"_5":14474,"_27550":120881,"_2978":121020},[],"Crear o actualizar Things en IoT Core",{"_3496":71904,"_30262":71858,"_21040":121022,"_5":14474,"_27550":120881,"_2978":53617},[],{"_3496":71905,"_30262":71858,"_21040":121024,"_5":14474,"_27550":120881,"_2978":121025},[],"Aprovisionar Things mediante plantilla",{"_3496":71906,"_30262":71858,"_21040":121027,"_5":14474,"_27550":120881,"_2978":53623},[],{"_3496":71907,"_30262":71858,"_21040":121029,"_5":14474,"_27550":120881,"_2978":121030},[],"Registrar certificados de dispositivo",{"_3496":71908,"_30262":71858,"_21040":121032,"_5":14474,"_27550":120881,"_2978":53629},[],{"_3496":71909,"_30262":71858,"_21040":121034,"_5":14474,"_27550":120881,"_2978":121035},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3496":71910,"_30262":71858,"_21040":121037,"_5":14474,"_27550":120881,"_2978":53635},[],{"_3496":71911,"_30262":71858,"_21040":121039,"_5":14474,"_27550":120881,"_2978":121040},[],"Crear y adjuntar políticas IoT",{"_3496":71912,"_30262":71858,"_21040":121042,"_5":14474,"_27550":120881,"_2978":53641},[],{"_3496":71913,"_30262":71858,"_21040":121044,"_5":14474,"_27550":120881,"_2978":121045},[],"Gestionar grupos de Things",{"_3496":71914,"_30262":71858,"_21040":121047,"_5":14474,"_27550":120881,"_2978":53647},[],{"_3496":71915,"_30262":71858,"_21040":121049,"_5":14474,"_27550":120881,"_2978":121050},[],"Crear plantillas JITP",{"_3496":71916,"_30262":71858,"_21040":121052,"_5":14474,"_27550":120881,"_2978":53653},[],{"_3496":71917,"_30262":71858,"_21040":121054,"_5":14474,"_27550":120881,"_2978":121055},[],"Leer y escribir el Device Shadow",{"_3496":71918,"_30262":71858,"_21040":121057,"_5":14474,"_27550":120881,"_2978":121058},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3496":71919,"_30262":71858,"_21040":121060,"_5":14474,"_27550":120885,"_2978":121061},[],"Parámetro",{"_3496":71920,"_30262":71858,"_21040":121063,"_5":14474,"_27550":120885,"_2978":121064},[],"Tipo",{"_3496":71921,"_30262":71858,"_21040":121066,"_5":14474,"_27550":120885,"_2978":121067},[],"Requerido",{"_3496":71922,"_30262":71858,"_21040":121069,"_5":14474,"_27550":120885,"_2978":121070},[],"Descripción",{"_3496":71923,"_30262":71858,"_21040":121072,"_5":14474,"_27550":120885,"_2978":53674},[],{"_3496":71924,"_30262":71858,"_21040":121074,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71925,"_30262":71858,"_21040":121076,"_5":14474,"_27550":120885,"_2978":121077},[],"Sí",{"_3496":71926,"_30262":71858,"_21040":121079,"_5":14474,"_27550":120885,"_2978":121080},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3496":71927,"_30262":71858,"_21040":121082,"_5":14474,"_27550":120885,"_2978":53685},[],{"_3496":71928,"_30262":71858,"_21040":121084,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71929,"_30262":71858,"_21040":121086,"_5":14474,"_27550":120885,"_2978":121077},[],{"_3496":71930,"_30262":71858,"_21040":121088,"_5":14474,"_27550":120885,"_2978":121089},[],"Región AWS donde opera el conector.",{"_3496":71931,"_30262":71858,"_21040":121091,"_5":14474,"_27550":120885,"_2978":53695},[],{"_3496":71932,"_30262":71858,"_21040":121093,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71933,"_30262":71858,"_21040":121095,"_5":14474,"_27550":120885,"_2978":121077},[],{"_3496":71934,"_30262":71858,"_21040":121097,"_5":14474,"_27550":120885,"_2978":121098},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3496":71935,"_30262":71858,"_21040":121100,"_5":14474,"_27550":120885,"_2978":53705},[],{"_3496":71936,"_30262":71858,"_21040":121102,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71937,"_30262":71858,"_21040":121104,"_5":14474,"_27550":120885,"_2978":121105},[],"Solo con `auth_method=static`",{"_3496":71938,"_30262":71858,"_21040":121107,"_5":14474,"_27550":120885,"_2978":121108},[],"Clave de acceso AWS.",{"_3496":71939,"_30262":71858,"_21040":121110,"_5":14474,"_27550":120885,"_2978":53716},[],{"_3496":71940,"_30262":71858,"_21040":121112,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71941,"_30262":71858,"_21040":121114,"_5":14474,"_27550":120885,"_2978":121105},[],{"_3496":71942,"_30262":71858,"_21040":121116,"_5":14474,"_27550":120885,"_2978":121117},[],"Clave secreta AWS.",{"_3496":71943,"_30262":71858,"_21040":121119,"_5":14474,"_27550":120885,"_2978":53726},[],{"_3496":71944,"_30262":71858,"_21040":121121,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71945,"_30262":71858,"_21040":121123,"_5":14474,"_27550":120885,"_2978":53731},[],{"_3496":71946,"_30262":71858,"_21040":121125,"_5":14474,"_27550":120885,"_2978":121126},[],"Token de sesión (con `auth_method=static`).",{"_3496":71947,"_30262":71858,"_21040":121128,"_5":14474,"_27550":120885,"_2978":53737},[],{"_3496":71948,"_30262":71858,"_21040":121130,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71949,"_30262":71858,"_21040":121132,"_5":14474,"_27550":120885,"_2978":121133},[],"Solo con `auth_method=role`",{"_3496":71950,"_30262":71858,"_21040":121135,"_5":14474,"_27550":120885,"_2978":121136},[],"ARN del rol a asumir.",{"_3496":71951,"_30262":71858,"_21040":121138,"_5":14474,"_27550":120885,"_2978":53748},[],{"_3496":71952,"_30262":71858,"_21040":121140,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71953,"_30262":71858,"_21040":121142,"_5":14474,"_27550":120885,"_2978":53731},[],{"_3496":71954,"_30262":71858,"_21040":121144,"_5":14474,"_27550":120885,"_2978":121145},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3496":71955,"_30262":71858,"_21040":121147,"_5":14474,"_27550":120885,"_2978":53758},[],{"_3496":71956,"_30262":71858,"_21040":121149,"_5":14474,"_27550":120885,"_2978":90327},[],{"_3496":71957,"_30262":71858,"_21040":121151,"_5":14474,"_27550":120885,"_2978":121077},[],{"_3496":71958,"_30262":71858,"_21040":121153,"_5":14474,"_27550":120885,"_2978":121154},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3496":71959,"_30262":71858,"_21040":121156,"_5":14474,"_27550":120885,"_2978":53768},[],{"_3496":71960,"_30262":71858,"_21040":121158,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71961,"_30262":71858,"_21040":121160,"_5":14474,"_27550":120885,"_2978":121077},[],{"_3496":71962,"_30262":71858,"_21040":121162,"_5":14474,"_27550":120885,"_2978":121163},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3496":71963,"_30262":71858,"_21040":121165,"_5":14474,"_27550":120885,"_2978":53778},[],{"_3496":71964,"_30262":71858,"_21040":121167,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71965,"_30262":71858,"_21040":121169,"_5":14474,"_27550":120885,"_2978":121077},[],{"_3496":71966,"_30262":71858,"_21040":121171,"_5":14474,"_27550":120885,"_2978":121172},[],"URL HTTP del Device Manager de Lamassu.",{"_3496":71967,"_30262":71858,"_21040":121174,"_5":14474,"_27550":120885,"_2978":53788},[],{"_3496":71968,"_30262":71858,"_21040":121176,"_5":14474,"_27550":120885,"_2978":25121},[],{"_3496":71969,"_30262":71858,"_21040":121178,"_5":14474,"_27550":120885,"_2978":121077},[],{"_3496":71970,"_30262":71858,"_21040":121180,"_5":14474,"_27550":120885,"_2978":121181},[],"URL HTTP del servicio de CA de Lamassu.",{"_3496":71971,"_30262":71858,"_21040":121183,"_5":14474,"_27550":120889,"_2978":121184},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3496":71972,"_30262":71858,"_21040":121186,"_5":14474,"_27550":120889,"_2978":121187},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3496":71973,"_30262":71858,"_21040":121189,"_5":14474,"_27550":120889,"_2978":121190},[],"Tipo de CloudEvent",{"_3496":71974,"_30262":71858,"_21040":121192,"_5":14474,"_27550":120889,"_2978":121193},[],"Recurso en Lamassu",{"_3496":71975,"_30262":71858,"_21040":121195,"_5":14474,"_27550":120889,"_2978":121196},[],"Recurso AWS",{"_3496":71976,"_30262":71858,"_21040":121198,"_5":14474,"_27550":120889,"_2978":121199},[],"Acciones IAM",{"_3496":71977,"_30262":71858,"_21040":121201,"_5":14474,"_27550":120889,"_2978":121202},[],"Llamadas AWS y efecto",{"_3496":71978,"_30262":71858,"_21040":121204,"_5":14474,"_27550":120889,"_2978":121205},[],"Dónde en esta página",{"_3496":71979,"_30262":71858,"_21040":121207,"_5":14474,"_27550":120889,"_2978":53822},[],{"_3496":71980,"_30262":71858,"_21040":121209,"_5":14474,"_27550":120889,"_2978":53825},[],{"_3496":71981,"_30262":71858,"_21040":121211,"_5":14474,"_27550":120889,"_2978":53828},[],{"_3496":71982,"_30262":71858,"_21040":121213,"_5":14474,"_27550":120889,"_2978":53831},[],{"_3496":71983,"_30262":71858,"_21040":121215,"_5":14474,"_27550":120889,"_2978":121216},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3496":71984,"_30262":71858,"_21040":121218,"_5":14474,"_27550":120889,"_2978":120902},[],{"_3496":71985,"_30262":71858,"_21040":121220,"_5":14474,"_27550":120889,"_2978":53839},[],{"_3496":71986,"_30262":71858,"_21040":121222,"_5":14474,"_27550":120889,"_2978":53842},[],{"_3496":71987,"_30262":71858,"_21040":121224,"_5":14474,"_27550":120889,"_2978":53845},[],{"_3496":71988,"_30262":71858,"_21040":121226,"_5":14474,"_27550":120889,"_2978":53848},[],{"_3496":71989,"_30262":71858,"_21040":121228,"_5":14474,"_27550":120889,"_2978":121229},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3496":71990,"_30262":71858,"_21040":121231,"_5":14474,"_27550":120889,"_2978":120928},[],{"_3496":71991,"_30262":71858,"_21040":121233,"_5":14474,"_27550":120889,"_2978":53856},[],{"_3496":71992,"_30262":71858,"_21040":121235,"_5":14474,"_27550":120889,"_2978":121236},[],"Dispositivo",{"_3496":71993,"_30262":71858,"_21040":121238,"_5":14474,"_27550":120889,"_2978":53862},[],{"_3496":71994,"_30262":71858,"_21040":121240,"_5":14474,"_27550":120889,"_2978":53865},[],{"_3496":71995,"_30262":71858,"_21040":121242,"_5":14474,"_27550":120889,"_2978":121243},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3496":71996,"_30262":71858,"_21040":121245,"_5":14474,"_27550":120889,"_2978":120936},[],{"_3496":71997,"_30262":71858,"_21040":121247,"_5":14474,"_27550":120889,"_2978":53873},[],{"_3496":71998,"_30262":71858,"_21040":121249,"_5":14474,"_27550":120889,"_2978":121250},[],"Certificado",{"_3496":71999,"_30262":71858,"_21040":121252,"_5":14474,"_27550":120889,"_2978":53879},[],{"_3496":72000,"_30262":71858,"_21040":121254,"_5":14474,"_27550":120889,"_2978":121255},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3496":72001,"_30262":71858,"_21040":121257,"_5":14474,"_27550":120889,"_2978":121258},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3496":72002,"_30262":71858,"_21040":121260,"_5":14474,"_27550":120889,"_2978":120948},[],{"_3496":72003,"_30262":71858,"_21040":121262,"_5":14474,"_27550":120889,"_2978":53890},[],{"_3496":72004,"_30262":71858,"_21040":121264,"_5":14474,"_27550":120889,"_2978":121265},[],"Certificado / Dispositivo",{"_3496":72005,"_30262":71858,"_21040":121267,"_5":14474,"_27550":120889,"_2978":53896},[],{"_3496":72006,"_30262":71858,"_21040":121269,"_5":14474,"_27550":120889,"_2978":49903},[],{"_3496":72007,"_30262":71858,"_21040":121271,"_5":14474,"_27550":120889,"_2978":121272},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3496":72008,"_30262":71858,"_21040":121274,"_5":14474,"_27550":120889,"_2978":120956},[],{"_3496":72009,"_30262":71858,"_21040":121276,"_5":14474,"_27550":120893,"_2978":121277},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3496":72010,"_30262":71858,"_21040":121279,"_5":14474,"_27550":120897,"_2978":121280},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3496":72011,"_30262":71858,"_21040":121282,"_5":14474,"_27550":120897,"_2978":121283},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3496":72012,"_30262":71858,"_21040":121285,"_5":14474,"_27550":120901,"_2978":121286},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3496":72013,"_30262":71858,"_21040":121288,"_5":14474,"_27550":120901,"_2978":121289},[],"Transición",{"_3496":72014,"_30262":71858,"_21040":121291,"_5":14474,"_27550":120901,"_2978":121292},[],"Llamadas AWS",{"_3496":72015,"_30262":71858,"_21040":121294,"_5":14474,"_27550":120901,"_2978":121295},[],"`NoRegistrada` → `Solicitada`",{"_3496":72016,"_30262":71858,"_21040":121297,"_5":14474,"_27550":120901,"_2978":121298},[],"ninguna (solo escritura de metadatos)",{"_3496":72017,"_30262":71858,"_21040":121300,"_5":14474,"_27550":120901,"_2978":121301},[],"`Solicitada` → `Registrando`",{"_3496":72018,"_30262":71858,"_21040":121303,"_5":14474,"_27550":120901,"_2978":121304},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3496":72019,"_30262":71858,"_21040":121306,"_5":14474,"_27550":120901,"_2978":121307},[],"`Registrando` → `Completada`",{"_3496":72020,"_30262":71858,"_21040":121309,"_5":14474,"_27550":120901,"_2978":121310},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3496":72021,"_30262":71858,"_21040":121312,"_5":14474,"_27550":120901,"_2978":121313},[],"`Registrando` → `Fallida`",{"_3496":72022,"_30262":71858,"_21040":121315,"_5":14474,"_27550":120901,"_2978":121316},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3496":72023,"_30262":71858,"_21040":121318,"_5":14474,"_27550":120901,"_2978":121319},[],"`Fallida` / `Completada` → `Solicitada`",{"_3496":72024,"_30262":71858,"_21040":121321,"_5":14474,"_27550":120901,"_2978":121322},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3496":72025,"_30262":71858,"_21040":121324,"_5":14474,"_27550":120905,"_2978":121325},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3496":72026,"_30262":71858,"_21040":121327,"_5":14474,"_27550":120905,"_2978":121328},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3496":72027,"_30262":71858,"_21040":121330,"_5":14474,"_27550":120905,"_2978":121331},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3496":72028,"_30262":71858,"_21040":121333,"_5":14474,"_27550":120905,"_2978":121334},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3496":72029,"_30262":71858,"_21040":121336,"_5":14474,"_27550":120905,"_2978":121337},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3496":72030,"_30262":71858,"_21040":121339,"_5":14474,"_27550":120905,"_2978":121340},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3496":72031,"_30262":71858,"_21040":121342,"_5":14474,"_27550":120908,"_2978":121343},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3496":72032,"_30262":71858,"_21040":121345,"_5":14474,"_27550":120911,"_2978":121346},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3496":72033,"_30262":71858,"_21040":121348,"_5":14474,"_27550":120911,"_2978":121349},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3496":72034,"_30262":71858,"_21040":121351,"_5":14474,"_27550":120915,"_2978":121352},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3496":72035,"_30262":71858,"_21040":121354,"_5":14474,"_27550":120919,"_2978":121355},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3496":72036,"_30262":71858,"_21040":121357,"_5":14474,"_27550":120919,"_2978":121358},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3496":72037,"_30262":71858,"_21040":121360,"_5":14474,"_27550":120919,"_2978":121361},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3496":72038,"_30262":71858,"_21040":121363,"_5":14474,"_27550":120919,"_2978":121364},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3496":72039,"_30262":71858,"_21040":121366,"_5":14474,"_27550":120919,"_2978":121367},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3496":72040,"_30262":71858,"_21040":121369,"_5":14474,"_27550":120919,"_2978":121370},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3496":72041,"_30262":71858,"_21040":121372,"_5":14474,"_27550":120923,"_2978":121373},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3496":72042,"_30262":71858,"_21040":121375,"_5":14474,"_27550":120923,"_2978":121376},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3496":72043,"_30262":71858,"_21040":121378,"_5":14474,"_27550":120923,"_2978":121379},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3496":72044,"_30262":71858,"_21040":121381,"_5":14474,"_27550":120923,"_2978":121382},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3496":72045,"_30262":71858,"_21040":121384,"_5":14474,"_27550":120923,"_2978":121385},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3496":72046,"_30262":71858,"_21040":121387,"_5":14474,"_27550":120927,"_2978":121388},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3496":72047,"_30262":71858,"_21040":121390,"_5":14474,"_27550":120927,"_2978":121289},[],{"_3496":72048,"_30262":71858,"_21040":121392,"_5":14474,"_27550":120927,"_2978":121292},[],{"_3496":72049,"_30262":71858,"_21040":121394,"_5":14474,"_27550":120927,"_2978":121395},[],"`SinConfigurar` → `None` / `Auto`",{"_3496":72050,"_30262":71858,"_21040":121397,"_5":14474,"_27550":120927,"_2978":121398},[],"ninguna (solo configuración)",{"_3496":72051,"_30262":71858,"_21040":121400,"_5":14474,"_27550":120927,"_2978":54033},[],{"_3496":72052,"_30262":71858,"_21040":121402,"_5":14474,"_27550":120927,"_2978":121398},[],{"_3496":72053,"_30262":71858,"_21040":121404,"_5":14474,"_27550":120927,"_2978":121405},[],"Cualquiera → `Jitp`",{"_3496":72054,"_30262":71858,"_21040":121407,"_5":14474,"_27550":120927,"_2978":121408},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3496":72055,"_30262":71858,"_21040":121410,"_5":14474,"_27550":120927,"_2978":54044},[],{"_3496":72056,"_30262":71858,"_21040":121412,"_5":14474,"_27550":120927,"_2978":121413},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3496":72057,"_30262":71858,"_21040":121415,"_5":14474,"_27550":120931,"_2978":121416},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3496":72058,"_30262":71858,"_21040":121418,"_5":14474,"_27550":120931,"_2978":121419},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3496":72059,"_30262":71858,"_21040":121421,"_5":14474,"_27550":120931,"_2978":121422},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3496":72060,"_30262":71858,"_21040":121424,"_5":14474,"_27550":120935,"_2978":121425},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3496":72061,"_30262":71858,"_21040":121427,"_5":14474,"_27550":120935,"_2978":121289},[],{"_3496":72062,"_30262":71858,"_21040":121429,"_5":14474,"_27550":120935,"_2978":121292},[],{"_3496":72063,"_30262":71858,"_21040":121431,"_5":14474,"_27550":120935,"_2978":121432},[],"`Ausente` → `Aprovisionado`",{"_3496":72064,"_30262":71858,"_21040":121434,"_5":14474,"_27550":120935,"_2978":121435},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3496":72065,"_30262":71858,"_21040":121437,"_5":14474,"_27550":120935,"_2978":121438},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3496":72066,"_30262":71858,"_21040":121440,"_5":14474,"_27550":120935,"_2978":121441},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3496":72067,"_30262":71858,"_21040":121443,"_5":14474,"_27550":120935,"_2978":121444},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3496":72068,"_30262":71858,"_21040":121446,"_5":14474,"_27550":120939,"_2978":121447},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3496":72069,"_30262":71858,"_21040":121449,"_5":14474,"_27550":120939,"_2978":121450},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3496":72070,"_30262":71858,"_21040":121452,"_5":14474,"_27550":120939,"_2978":121453},[],"Para que el flujo JITP funcione correctamente:",{"_3496":72071,"_30262":71858,"_21040":121455,"_5":14474,"_27550":120939,"_2978":121456},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3496":72072,"_30262":71858,"_21040":121458,"_5":14474,"_27550":120939,"_2978":121459},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3496":72073,"_30262":71858,"_21040":121461,"_5":14474,"_27550":120939,"_2978":121462},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3496":72074,"_30262":71858,"_21040":121464,"_5":14474,"_27550":120939,"_2978":121465},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3496":72075,"_30262":71858,"_21040":121467,"_5":14474,"_27550":120943,"_2978":121468},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3496":72076,"_30262":71858,"_21040":121470,"_5":14474,"_27550":120943,"_2978":121471},[],"Estado en Lamassu",{"_3496":72077,"_30262":71858,"_21040":121473,"_5":14474,"_27550":120943,"_2978":121474},[],"Razón de revocación",{"_3496":72078,"_30262":71858,"_21040":121476,"_5":14474,"_27550":120943,"_2978":121477},[],"Estado en AWS IoT Core",{"_3496":72079,"_30262":71858,"_21040":121479,"_5":14474,"_27550":120943,"_2978":54114},[],{"_3496":72080,"_30262":71858,"_21040":121481,"_5":14474,"_27550":120943,"_2978":121482},[],"Ninguna",{"_3496":72081,"_30262":71858,"_21040":121484,"_5":14474,"_27550":120943,"_2978":54120},[],{"_3496":72082,"_30262":71858,"_21040":121486,"_5":14474,"_27550":120943,"_2978":54123},[],{"_3496":72083,"_30262":71858,"_21040":121488,"_5":14474,"_27550":120943,"_2978":54126},[],{"_3496":72084,"_30262":71858,"_21040":121490,"_5":14474,"_27550":120943,"_2978":54129},[],{"_3496":72085,"_30262":71858,"_21040":121492,"_5":14474,"_27550":120943,"_2978":54123},[],{"_3496":72086,"_30262":71858,"_21040":121494,"_5":14474,"_27550":120943,"_2978":121495},[],"Cualquier otra razón",{"_3496":72087,"_30262":71858,"_21040":121497,"_5":14474,"_27550":120943,"_2978":54137},[],{"_3496":72088,"_30262":71858,"_21040":121499,"_5":14474,"_27550":120943,"_2978":121500},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3496":72089,"_30262":71858,"_21040":121502,"_5":14474,"_27550":120947,"_2978":121503},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3496":72090,"_30262":71858,"_21040":121505,"_5":14474,"_27550":120947,"_2978":121289},[],{"_3496":72091,"_30262":71858,"_21040":121507,"_5":14474,"_27550":120947,"_2978":121292},[],{"_3496":72092,"_30262":71858,"_21040":121509,"_5":14474,"_27550":120947,"_2978":121510},[],"`NoSincronizado` → `Active`",{"_3496":72093,"_30262":71858,"_21040":121512,"_5":14474,"_27550":120947,"_2978":53629},[],{"_3496":72094,"_30262":71858,"_21040":121514,"_5":14474,"_27550":120947,"_2978":54155},[],{"_3496":72095,"_30262":71858,"_21040":121516,"_5":14474,"_27550":120947,"_2978":121517},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3496":72096,"_30262":71858,"_21040":121519,"_5":14474,"_27550":120947,"_2978":54161},[],{"_3496":72097,"_30262":71858,"_21040":121521,"_5":14474,"_27550":120947,"_2978":121517},[],{"_3496":72098,"_30262":71858,"_21040":121523,"_5":14474,"_27550":120947,"_2978":54166},[],{"_3496":72099,"_30262":71858,"_21040":121525,"_5":14474,"_27550":120947,"_2978":53629},[],{"_3496":72100,"_30262":71858,"_21040":121527,"_5":14474,"_27550":120947,"_2978":54171},[],{"_3496":72101,"_30262":71858,"_21040":121529,"_5":14474,"_27550":120947,"_2978":121530},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3496":72102,"_30262":71858,"_21040":121532,"_5":14474,"_27550":120951,"_2978":121533},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3496":72103,"_30262":71858,"_21040":121535,"_5":14474,"_27550":120951,"_2978":121536},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3496":72104,"_30262":71858,"_21040":121538,"_5":14474,"_27550":120951,"_2978":121539},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3496":72105,"_30262":71858,"_21040":121541,"_5":14474,"_27550":120955,"_2978":121542},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3496":72106,"_30262":71858,"_21040":121544,"_5":14474,"_27550":120955,"_2978":121545},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3496":72107,"_30262":71858,"_21040":121547,"_5":14474,"_27550":120959,"_2978":121548},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3496":72108,"_30262":71858,"_21040":121550,"_5":14474,"_27550":120959,"_2978":121551},[],"Existen dos tipos de acciones:",{"_3496":72109,"_30262":71858,"_21040":121553,"_5":14474,"_27550":120959,"_2978":121554},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3496":72110,"_30262":71858,"_21040":121556,"_5":14474,"_27550":120959,"_2978":121557},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3496":72111,"_30262":71858,"_21040":121559,"_5":14474,"_27550":120959,"_2978":121560},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3496":72112,"_30262":71858,"_21040":121562,"_5":14474,"_27550":120963,"_2978":121563},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3496":72113,"_30262":71858,"_21040":121565,"_5":14474,"_27550":120963,"_2978":121566},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3496":72114,"_30262":71858,"_21040":121568,"_5":14474,"_27550":120963,"_2978":121569},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3496":72115,"_30262":71858,"_21040":121571,"_5":14474,"_27550":120967,"_2978":121572},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3496":72116,"_30262":71858,"_21040":121574,"_5":14474,"_27550":120967,"_2978":121575},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3496":72117,"_30262":71858,"_21040":121577,"_5":14474,"_27550":120967,"_2978":121578},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3496":72118,"_30262":71858,"_21040":121580,"_5":14474,"_27550":120967,"_2978":121581},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3496":72119,"_30262":71858,"_21040":121583,"_5":14474,"_27550":120967,"_2978":121584},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3496":72120,"_30262":71858,"_21040":121586,"_5":14474,"_27550":120967,"_2978":121587},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3496":72121,"_30262":71858,"_21040":121589,"_5":14474,"_27550":120967,"_2978":121590},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3496":72122,"_30262":71858,"_21040":121592,"_5":14474,"_27550":120967,"_2978":121593},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3496":72123,"_30262":71858,"_21040":121595,"_5":14474,"_27550":120967,"_2978":121596},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3496":72124,"_30262":71858,"_21040":121598,"_5":14474,"_27550":120967,"_2978":121599},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3496":72125,"_30262":71858,"_21040":121601,"_5":14474,"_27550":120967,"_2978":121602},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3496":72126,"_30262":71858,"_21040":121604,"_5":14474,"_27550":120967,"_2978":121605},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3496":72127,"_30262":71858,"_21040":121607,"_5":14474,"_27550":120967,"_2978":121608},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3496":72128,"_30262":71858,"_21040":121610,"_5":14474,"_27550":120967,"_2978":121611},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3496":72129,"_30262":71858,"_21040":121613,"_5":14474,"_27550":120967,"_2978":121614},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3496":72130,"_30262":71858,"_21040":121616,"_5":14474,"_27550":120967,"_2978":121617},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3496":72131,"_30262":71858,"_21040":121619,"_5":14474,"_27550":120967,"_2978":121620},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3496":72132,"_30262":71858,"_21040":121622,"_5":14474,"_27550":120967,"_2978":121623},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3496":72133,"_30262":71858,"_21040":121625,"_5":14474,"_27550":120967,"_2978":121626},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3496":72134,"_30262":71858,"_21040":121628,"_5":14474,"_27550":120967,"_2978":121629},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3496":72135,"_30262":71858,"_21040":121631,"_5":14474,"_27550":120967,"_2978":121632},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3496":72136,"_30262":71858,"_21040":121634,"_5":14474,"_27550":120967,"_2978":121635},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3496":72137,"_30262":71858,"_21040":121637,"_5":14474,"_27550":120967,"_2978":121638},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3496":72138,"_30262":71858,"_21040":121640,"_5":14474,"_27550":120967,"_2978":121641},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3496":72139,"_30262":72139,"_5":14825,"_2978":51989,"_30620":121643,"_21040":121644,"_27550":72139},[49507,118444,51989],[],{"_3496":72140,"_30262":72139,"_21040":121646,"_5":14474,"_27550":72139,"_2978":121647},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3496":72141,"_30262":72139,"_5":30617,"_21040":121649,"_27550":121650,"_2978":121651},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3496":72142,"_30262":72139,"_5":30617,"_21040":121653,"_27550":121654,"_2978":119456},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3496":72143,"_30262":72139,"_5":30617,"_21040":121656,"_27550":121657,"_2978":119631},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3496":72144,"_30262":72139,"_5":30617,"_21040":121659,"_27550":121660,"_2978":120866},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#integraciones",{"_3496":72145,"_30262":72139,"_5":30617,"_21040":121662,"_27550":121663,"_2978":121664},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3496":72146,"_30262":72139,"_21040":121666,"_5":14474,"_27550":72139,"_2978":121667},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3496":72147,"_30262":72139,"_21040":121669,"_5":14474,"_27550":121650,"_2978":121670},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3496":72148,"_30262":72139,"_21040":121672,"_5":14474,"_27550":121650,"_2978":121673},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3496":72149,"_30262":72139,"_21040":121675,"_5":14474,"_27550":121654,"_2978":121676},[],"Recurso",{"_3496":72150,"_30262":72139,"_21040":121678,"_5":14474,"_27550":121654,"_2978":121679},[],"Qué representa",{"_3496":72151,"_30262":72139,"_21040":121681,"_5":14474,"_27550":121654,"_2978":121682},[],"**Dispositivo**",{"_3496":72152,"_30262":72139,"_21040":121684,"_5":14474,"_27550":121654,"_2978":121685},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3496":72153,"_30262":72139,"_21040":121687,"_5":14474,"_27550":121654,"_2978":121688},[],"**Identidad**",{"_3496":72154,"_30262":72139,"_21040":121690,"_5":14474,"_27550":121654,"_2978":121691},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3496":72155,"_30262":72139,"_21040":121693,"_5":14474,"_27550":121654,"_2978":54338},[],{"_3496":72156,"_30262":72139,"_21040":121695,"_5":14474,"_27550":121654,"_2978":121696},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3496":72157,"_30262":72139,"_21040":121698,"_5":14474,"_27550":121654,"_2978":121699},[],"**Flota**",{"_3496":72158,"_30262":72139,"_21040":121701,"_5":14474,"_27550":121654,"_2978":121702},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3496":72159,"_30262":72139,"_21040":121704,"_5":14474,"_27550":121654,"_2978":121705},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3496":72160,"_30262":72139,"_21040":121707,"_5":14474,"_27550":121654,"_2978":121708},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3496":72161,"_30262":72139,"_21040":121710,"_5":14474,"_27550":121657,"_2978":121711},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3496":72162,"_30262":72139,"_21040":121713,"_5":14474,"_27550":121657,"_2978":121714},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3496":72163,"_30262":72139,"_21040":121716,"_5":14474,"_27550":121657,"_2978":121717},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3496":72164,"_30262":72139,"_21040":121719,"_5":14474,"_27550":121657,"_2978":121720},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3496":72165,"_30262":72139,"_21040":121722,"_5":14474,"_27550":121657,"_2978":121723},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3496":72166,"_30262":72139,"_21040":121725,"_5":14474,"_27550":121657,"_2978":121726},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3496":72167,"_30262":72139,"_21040":121728,"_5":14474,"_27550":121657,"_2978":121729},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3496":72168,"_30262":72139,"_21040":121731,"_5":14474,"_27550":121657,"_2978":121732},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3496":72169,"_30262":72139,"_21040":121734,"_5":14474,"_27550":121660,"_2978":121735},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3496":72170,"_30262":72139,"_21040":121737,"_5":14474,"_27550":121660,"_2978":121738},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3496":72171,"_30262":72139,"_21040":121740,"_5":14474,"_27550":121663,"_2978":121741},[],"Participante",{"_3496":72172,"_30262":72139,"_21040":121743,"_5":14474,"_27550":121663,"_2978":121744},[],"Responsabilidad",{"_3496":72173,"_30262":72139,"_21040":121746,"_5":14474,"_27550":121663,"_2978":121747},[],"Administrador PKI",{"_3496":72174,"_30262":72139,"_21040":121749,"_5":14474,"_27550":121663,"_2978":121750},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3496":72175,"_30262":72139,"_21040":121752,"_5":14474,"_27550":121663,"_2978":121753},[],"Administrador del aprovisionamiento",{"_3496":72176,"_30262":72139,"_21040":121755,"_5":14474,"_27550":121663,"_2978":121756},[],"DMS, admisión, autenticación por operación e inventario.",{"_3496":72177,"_30262":72139,"_21040":121758,"_5":14474,"_27550":121663,"_2978":121759},[],"Integrador del dispositivo",{"_3496":72178,"_30262":72139,"_21040":121761,"_5":14474,"_27550":121663,"_2978":121762},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3496":72179,"_30262":72139,"_21040":121764,"_5":14474,"_27550":121663,"_2978":121765},[],"Integrador del consumidor",{"_3496":72180,"_30262":72139,"_21040":121767,"_5":14474,"_27550":121663,"_2978":121768},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3496":72181,"_30262":72139,"_21040":121770,"_5":14474,"_27550":121663,"_2978":121771},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3496":72182,"_30262":72182,"_5":14825,"_2978":121773,"_30620":121774,"_21040":121776,"_27550":72182},"Enrola y conecta tu primer dispositivo",[49507,118444,51989,121775],"Primeros pasos",[],{"_3496":72183,"_30262":72182,"_21040":121778,"_5":14474,"_27550":72182,"_2978":121779},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3496":72184,"_30262":72182,"_5":30617,"_21040":121781,"_27550":121782,"_2978":117022},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3496":72185,"_30262":72182,"_5":30617,"_21040":121784,"_27550":121785,"_2978":121786},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3496":72186,"_30262":72182,"_5":30617,"_21040":121788,"_27550":121789,"_2978":121790},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3496":72187,"_30262":72182,"_5":30617,"_21040":121792,"_27550":121793,"_2978":121794},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3496":72188,"_30262":72182,"_5":30617,"_21040":121796,"_27550":121797,"_2978":121798},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3496":72189,"_30262":72182,"_5":30617,"_21040":121800,"_27550":121801,"_2978":121802},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3496":72190,"_30262":72182,"_5":30617,"_21040":121804,"_27550":121805,"_2978":121806},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3496":72191,"_30262":72182,"_5":30617,"_21040":121808,"_27550":121809,"_2978":121810},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3496":72192,"_30262":72182,"_21040":121812,"_5":14474,"_27550":72182,"_2978":121813},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3496":72193,"_30262":72182,"_21040":121815,"_5":14474,"_27550":121782,"_2978":121816},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3496":72194,"_30262":72182,"_21040":121818,"_5":14474,"_27550":121782,"_2978":121819},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3496":72195,"_30262":72182,"_21040":121821,"_5":14474,"_27550":121782,"_2978":121822},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3496":72196,"_30262":72182,"_21040":121824,"_5":14474,"_27550":121782,"_2978":121825},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3496":72197,"_30262":72182,"_21040":121827,"_5":14474,"_27550":121782,"_2978":121828},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3496":72198,"_30262":72182,"_21040":121830,"_5":14474,"_27550":121785,"_2978":121831},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3496":72199,"_30262":72182,"_21040":121833,"_5":14474,"_27550":121785,"_2978":121834},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3496":72200,"_30262":72182,"_21040":121836,"_5":14474,"_27550":121789,"_2978":121837},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3496":72201,"_30262":72182,"_21040":121839,"_5":14474,"_27550":121789,"_2978":121840},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3496":72202,"_30262":72182,"_21040":121842,"_5":14474,"_27550":121789,"_2978":121843},[],"Ajuste",{"_3496":72203,"_30262":72182,"_21040":121845,"_5":14474,"_27550":121789,"_2978":121846},[],"Valor de evaluación",{"_3496":72204,"_30262":72182,"_21040":121848,"_5":14474,"_27550":121789,"_2978":54494},[],{"_3496":72205,"_30262":72182,"_21040":121850,"_5":14474,"_27550":121789,"_2978":121851},[],"Raíz emisora de `device-root.pem`.",{"_3496":72206,"_30262":72182,"_21040":121853,"_5":14474,"_27550":121789,"_2978":119759},[],{"_3496":72207,"_30262":72182,"_21040":121855,"_5":14474,"_27550":121789,"_2978":121856},[],"Perfil final de 1 hora que acabas de preparar.",{"_3496":72208,"_30262":72182,"_21040":121858,"_5":14474,"_27550":121789,"_2978":54505},[],{"_3496":72209,"_30262":72182,"_21040":121860,"_5":14474,"_27550":121789,"_2978":54508},[],{"_3496":72210,"_30262":72182,"_21040":121862,"_5":14474,"_27550":121789,"_2978":54511},[],{"_3496":72211,"_30262":72182,"_21040":121864,"_5":14474,"_27550":121789,"_2978":121865},[],"Habilitado.",{"_3496":72212,"_30262":72182,"_21040":121867,"_5":14474,"_27550":121789,"_2978":54517},[],{"_3496":72213,"_30262":72182,"_21040":121869,"_5":14474,"_27550":121789,"_2978":121870},[],"Deshabilitado; el ID debe ser nuevo.",{"_3496":72214,"_30262":72182,"_21040":121872,"_5":14474,"_27550":121789,"_2978":121873},[],"Autenticación inicial",{"_3496":72215,"_30262":72182,"_21040":121875,"_5":14474,"_27550":121789,"_2978":121876},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3496":72216,"_30262":72182,"_21040":121878,"_5":14474,"_27550":121789,"_2978":121879},[],"Autenticación de renovación",{"_3496":72217,"_30262":72182,"_21040":121881,"_5":14474,"_27550":121789,"_2978":121882},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3496":72218,"_30262":72182,"_21040":121884,"_5":14474,"_27550":121789,"_2978":54535},[],{"_3496":72219,"_30262":72182,"_21040":121886,"_5":14474,"_27550":121789,"_2978":121887},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3496":72220,"_30262":72182,"_21040":121889,"_5":14474,"_27550":121789,"_2978":54541},[],{"_3496":72221,"_30262":72182,"_21040":121891,"_5":14474,"_27550":121789,"_2978":121892},[],"1 hora.",{"_3496":72222,"_30262":72182,"_21040":121894,"_5":14474,"_27550":121789,"_2978":54547},[],{"_3496":72223,"_30262":72182,"_21040":121896,"_5":14474,"_27550":121789,"_2978":121897},[],"30 minutos / 10 minutos.",{"_3496":72224,"_30262":72182,"_21040":121899,"_5":14474,"_27550":121789,"_2978":54553},[],{"_3496":72225,"_30262":72182,"_21040":121901,"_5":14474,"_27550":121789,"_2978":121902},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3496":72226,"_30262":72182,"_21040":121904,"_5":14474,"_27550":121789,"_2978":52308},[],{"_3496":72227,"_30262":72182,"_21040":121906,"_5":14474,"_27550":121789,"_2978":121907},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3496":72228,"_30262":72182,"_21040":121909,"_5":14474,"_27550":121789,"_2978":54564},[],{"_3496":72229,"_30262":72182,"_21040":121911,"_5":14474,"_27550":121789,"_2978":121912},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3496":72230,"_30262":72182,"_21040":121914,"_5":14474,"_27550":121789,"_2978":121915},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3496":72231,"_30262":72182,"_21040":121917,"_5":14474,"_27550":121793,"_2978":121918},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3496":72232,"_30262":72182,"_21040":121920,"_5":14474,"_27550":121793,"_2978":121921},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3496":72233,"_30262":72182,"_21040":121923,"_5":14474,"_27550":121797,"_2978":121924},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3496":72234,"_30262":72182,"_21040":121926,"_5":14474,"_27550":121797,"_2978":121927},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3496":72235,"_30262":72182,"_21040":121929,"_5":14474,"_27550":121797,"_2978":121930},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3496":72236,"_30262":72182,"_21040":121932,"_5":14474,"_27550":121801,"_2978":121933},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3496":72237,"_30262":72182,"_21040":121935,"_5":14474,"_27550":121801,"_2978":121936},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3496":72238,"_30262":72182,"_21040":121938,"_5":14474,"_27550":121805,"_2978":121939},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3496":72239,"_30262":72182,"_21040":121941,"_5":14474,"_27550":121805,"_2978":121942},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3496":72240,"_30262":72182,"_21040":121944,"_5":14474,"_27550":121805,"_2978":121945},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3496":72241,"_30262":72182,"_21040":121947,"_5":14474,"_27550":121805,"_2978":121948},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3496":72242,"_30262":72182,"_21040":121950,"_5":14474,"_27550":121805,"_2978":121951},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3496":72243,"_30262":72182,"_21040":121953,"_5":14474,"_27550":121809,"_2978":121954},[],"Comprobación",{"_3496":72244,"_30262":72182,"_21040":121956,"_5":14474,"_27550":121809,"_2978":121957},[],"Resultado esperado",{"_3496":72245,"_30262":72182,"_21040":121959,"_5":14474,"_27550":121809,"_2978":121960},[],"Registro",{"_3496":72246,"_30262":72182,"_21040":121962,"_5":14474,"_27550":121809,"_2978":121963},[],"ID creado automáticamente y DMS correcto.",{"_3496":72247,"_30262":72182,"_21040":121965,"_5":14474,"_27550":121809,"_2978":121250},[],{"_3496":72248,"_30262":72182,"_21040":121967,"_5":14474,"_27550":121809,"_2978":121968},[],"CN, perfil, serie y clave verificados.",{"_3496":72249,"_30262":72182,"_21040":121970,"_5":14474,"_27550":121809,"_2978":121971},[],"Inventario",{"_3496":72250,"_30262":72182,"_21040":121973,"_5":14474,"_27550":121809,"_2978":121974},[],"Serie recibida visible como identidad actual y en el historial.",{"_3496":72251,"_30262":72182,"_21040":121976,"_5":14474,"_27550":121809,"_2978":121977},[],"Consumidor",{"_3496":72252,"_30262":72182,"_21040":121979,"_5":14474,"_27550":121809,"_2978":121980},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3496":72253,"_30262":72182,"_21040":121982,"_5":14474,"_27550":121809,"_2978":121983},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3496":72254,"_30262":72182,"_21040":121985,"_5":14474,"_27550":121809,"_2978":121986},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3496":72255,"_30262":72255,"_5":14825,"_2978":119473,"_30620":121988,"_21040":121989,"_27550":72255},[49507,118444,51989,121775],[],{"_3496":72256,"_30262":72255,"_21040":121991,"_5":14474,"_27550":72255,"_2978":121992},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3496":72257,"_30262":72255,"_5":30617,"_21040":121994,"_27550":121995,"_2978":117022},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3496":72258,"_30262":72255,"_5":30617,"_21040":121997,"_27550":121998,"_2978":121999},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3496":72259,"_30262":72255,"_5":30617,"_21040":122001,"_27550":122002,"_2978":122003},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3496":72260,"_30262":72255,"_5":30617,"_21040":122005,"_27550":122006,"_2978":122007},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3496":72261,"_30262":72255,"_5":30617,"_21040":122009,"_27550":122010,"_2978":122011},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3496":72262,"_30262":72255,"_5":30617,"_21040":122013,"_27550":122014,"_2978":122015},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3496":72263,"_30262":72255,"_5":30617,"_21040":122017,"_27550":122018,"_2978":121957},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3496":72264,"_30262":72255,"_5":30617,"_21040":122020,"_27550":122021,"_2978":122022},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3496":72265,"_30262":72255,"_5":30617,"_21040":122024,"_27550":122025,"_2978":122026},[],"/docs/pr-preview/pr-61/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3496":72266,"_30262":72255,"_21040":122028,"_5":14474,"_27550":72255,"_2978":122029},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3496":72267,"_30262":72255,"_21040":122031,"_5":14474,"_27550":72255,"_2978":122032},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3496":72268,"_30262":72255,"_21040":122034,"_5":14474,"_27550":121995,"_2978":122035},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3496":72269,"_30262":72255,"_21040":122037,"_5":14474,"_27550":121995,"_2978":122038},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3496":72270,"_30262":72255,"_21040":122040,"_5":14474,"_27550":121995,"_2978":122041},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3496":72271,"_30262":72255,"_21040":122043,"_5":14474,"_27550":121995,"_2978":122044},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3496":72272,"_30262":72255,"_21040":122046,"_5":14474,"_27550":121998,"_2978":122047},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3496":72273,"_30262":72255,"_21040":122049,"_5":14474,"_27550":121998,"_2978":122050},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3496":72274,"_30262":72255,"_21040":122052,"_5":14474,"_27550":121998,"_2978":122053},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3496":72275,"_30262":72255,"_21040":122055,"_5":14474,"_27550":121998,"_2978":122056},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3496":72276,"_30262":72255,"_21040":122058,"_5":14474,"_27550":121998,"_2978":122059},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3496":72277,"_30262":72255,"_21040":122061,"_5":14474,"_27550":121998,"_2978":122062},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3496":72278,"_30262":72255,"_21040":122064,"_5":14474,"_27550":121998,"_2978":122065},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3496":72279,"_30262":72255,"_21040":122067,"_5":14474,"_27550":121998,"_2978":122068},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3496":72280,"_30262":72255,"_21040":122070,"_5":14474,"_27550":122002,"_2978":122071},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3496":72281,"_30262":72255,"_21040":122073,"_5":14474,"_27550":122002,"_2978":54729},[],{"_3496":72282,"_30262":72255,"_21040":122075,"_5":14474,"_27550":122002,"_2978":122076},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3496":72283,"_30262":72255,"_21040":122078,"_5":14474,"_27550":122002,"_2978":122079},[],"**Icon** y **Tags**: clasificación opcional.",{"_3496":72284,"_30262":72255,"_21040":122081,"_5":14474,"_27550":122002,"_2978":122082},[],"Confirma el registro.",{"_3496":72285,"_30262":72255,"_21040":122084,"_5":14474,"_27550":122006,"_2978":122085},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3496":72286,"_30262":72255,"_21040":122087,"_5":14474,"_27550":122006,"_2978":122088},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3496":72287,"_30262":72255,"_21040":122090,"_5":14474,"_27550":122010,"_2978":122091},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3496":72288,"_30262":72255,"_21040":122093,"_5":14474,"_27550":122010,"_2978":122094},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3496":72289,"_30262":72255,"_21040":122096,"_5":14474,"_27550":122014,"_2978":122097},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3496":72290,"_30262":72255,"_21040":122099,"_5":14474,"_27550":122014,"_2978":122100},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3496":72291,"_30262":72255,"_21040":122102,"_5":14474,"_27550":122018,"_2978":121954},[],{"_3496":72292,"_30262":72255,"_21040":122104,"_5":14474,"_27550":122018,"_2978":122105},[],"Resultado",{"_3496":72293,"_30262":72255,"_21040":122107,"_5":14474,"_27550":122018,"_2978":121236},[],{"_3496":72294,"_30262":72255,"_21040":122109,"_5":14474,"_27550":122018,"_2978":122110},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3496":72295,"_30262":72255,"_21040":122112,"_5":14474,"_27550":122018,"_2978":122113},[],"Identidad actual",{"_3496":72296,"_30262":72255,"_21040":122115,"_5":14474,"_27550":122018,"_2978":122116},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3496":72297,"_30262":72255,"_21040":122118,"_5":14474,"_27550":122018,"_2978":122119},[],"Historial",{"_3496":72298,"_30262":72255,"_21040":122121,"_5":14474,"_27550":122018,"_2978":122122},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3496":72299,"_30262":72255,"_21040":122124,"_5":14474,"_27550":122018,"_2978":122125},[],"Clave y certificado",{"_3496":72300,"_30262":72255,"_21040":122127,"_5":14474,"_27550":122018,"_2978":122128},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3496":72301,"_30262":72255,"_21040":122130,"_5":14474,"_27550":122021,"_2978":122131},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3496":72302,"_30262":72255,"_21040":122133,"_5":14474,"_27550":122021,"_2978":122134},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3496":72303,"_30262":72255,"_21040":122136,"_5":14474,"_27550":122021,"_2978":122137},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3496":72304,"_30262":72255,"_21040":122139,"_5":14474,"_27550":122021,"_2978":122140},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3496":72305,"_30262":72255,"_21040":122142,"_5":14474,"_27550":122025,"_2978":122143},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3496":72306,"_30262":72255,"_21040":122145,"_5":14474,"_27550":122025,"_2978":122146},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3496":72307,"_30262":72255,"_21040":122148,"_5":14474,"_27550":122025,"_2978":122149},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3496":72308,"_30262":72308,"_5":14825,"_2978":122151,"_30620":122152,"_21040":122153,"_27550":72308},"Plataforma Lamassu IoT",[49507,118444],[],{"_3496":72309,"_30262":72308,"_21040":122155,"_5":14474,"_27550":72308,"_2978":122156},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3496":72310,"_30262":72308,"_5":30617,"_21040":122158,"_27550":122159,"_2978":121651},[],"/docs/pr-preview/pr-61/es/platform/overview#empieza-aquí",{"_3496":72311,"_30262":72308,"_5":30617,"_21040":122161,"_27550":122162,"_2978":122163},[],"/docs/pr-preview/pr-61/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3496":72312,"_30262":72308,"_5":30617,"_21040":122165,"_27550":122166,"_2978":122167},[],"/docs/pr-preview/pr-61/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3496":72313,"_30262":72308,"_5":30617,"_21040":122169,"_27550":122170,"_2978":122171},[],"/docs/pr-preview/pr-61/es/platform/overview#capacidades-principales","Capacidades principales",{"_3496":72314,"_30262":72308,"_5":30617,"_21040":122173,"_27550":122174,"_2978":122175},[],"/docs/pr-preview/pr-61/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3496":72315,"_30262":72308,"_5":30617,"_21040":122177,"_27550":122178,"_2978":122179},[],"/docs/pr-preview/pr-61/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3496":72316,"_30262":72308,"_5":30617,"_21040":122181,"_27550":122182,"_2978":122183},[],"/docs/pr-preview/pr-61/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3496":72317,"_30262":72308,"_5":30617,"_21040":122185,"_27550":122186,"_2978":122187},[],"/docs/pr-preview/pr-61/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3496":72318,"_30262":72308,"_5":30617,"_21040":122189,"_27550":122190,"_2978":122191},[],"/docs/pr-preview/pr-61/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3496":72319,"_30262":72308,"_5":30617,"_21040":122193,"_27550":122194,"_2978":122195},[],"/docs/pr-preview/pr-61/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3496":72320,"_30262":72308,"_5":30617,"_21040":122197,"_27550":122198,"_2978":122199},[],"/docs/pr-preview/pr-61/es/platform/overview#referencia-operativa","Referencia operativa",{"_3496":72321,"_30262":72308,"_21040":122201,"_5":14474,"_27550":72308,"_2978":122202},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3496":72322,"_30262":72308,"_21040":122204,"_5":14474,"_27550":122159,"_2978":122205},[],"Elige el resultado que necesitas obtener:",{"_3496":72323,"_30262":72308,"_21040":122207,"_5":14474,"_27550":122159,"_2978":122208},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3496":72324,"_30262":72308,"_21040":122210,"_5":14474,"_27550":122159,"_2978":122211},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3496":72325,"_30262":72308,"_21040":122213,"_5":14474,"_27550":122159,"_2978":122214},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3496":72326,"_30262":72308,"_21040":122216,"_5":14474,"_27550":122162,"_2978":122217},[],"Bloque",{"_3496":72327,"_30262":72308,"_21040":122219,"_5":14474,"_27550":122162,"_2978":122220},[],"Qué gestionas",{"_3496":72328,"_30262":72308,"_21040":122222,"_5":14474,"_27550":122162,"_2978":122223},[],"Punto de entrada",{"_3496":72329,"_30262":72308,"_21040":122225,"_5":14474,"_27550":122162,"_2978":54882},[],{"_3496":72330,"_30262":72308,"_21040":122227,"_5":14474,"_27550":122162,"_2978":122228},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3496":72331,"_30262":72308,"_21040":122230,"_5":14474,"_27550":122162,"_2978":122231},[],"Visión general de PKI",{"_3496":72332,"_30262":72308,"_21040":122233,"_5":14474,"_27550":122162,"_2978":54891},[],{"_3496":72333,"_30262":72308,"_21040":122235,"_5":14474,"_27550":122162,"_2978":122236},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3496":72334,"_30262":72308,"_21040":122238,"_5":14474,"_27550":122162,"_2978":122239},[],"Visión general de IoT Fleets",{"_3496":72335,"_30262":72308,"_21040":122241,"_5":14474,"_27550":122162,"_2978":122242},[],"**Administración**",{"_3496":72336,"_30262":72308,"_21040":122244,"_5":14474,"_27550":122162,"_2978":122245},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3496":72337,"_30262":72308,"_21040":122247,"_5":14474,"_27550":122162,"_2978":118442},[],{"_3496":72338,"_30262":72308,"_21040":122249,"_5":14474,"_27550":122162,"_2978":122250},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3496":72339,"_30262":72308,"_21040":122252,"_5":14474,"_27550":122166,"_2978":122253},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3496":72340,"_30262":72308,"_21040":122255,"_5":14474,"_27550":122166,"_2978":122256},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3496":72341,"_30262":72308,"_21040":122258,"_5":14474,"_27550":122166,"_2978":122259},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3496":72342,"_30262":72308,"_21040":122261,"_5":14474,"_27550":122166,"_2978":122262},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3496":72343,"_30262":72308,"_21040":122264,"_5":14474,"_27550":122166,"_2978":122265},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3496":72344,"_30262":72308,"_21040":122267,"_5":14474,"_27550":122166,"_2978":122268},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3496":72345,"_30262":72308,"_21040":122270,"_5":14474,"_27550":122174,"_2978":122271},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3496":72346,"_30262":72308,"_21040":122273,"_5":14474,"_27550":122178,"_2978":122274},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3496":72347,"_30262":72308,"_21040":122276,"_5":14474,"_27550":122182,"_2978":122277},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3496":72348,"_30262":72308,"_21040":122279,"_5":14474,"_27550":122186,"_2978":122280},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3496":72349,"_30262":72308,"_21040":122282,"_5":14474,"_27550":122190,"_2978":122283},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3496":72350,"_30262":72308,"_21040":122285,"_5":14474,"_27550":122194,"_2978":122286},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3496":72351,"_30262":72308,"_21040":122288,"_5":14474,"_27550":122198,"_2978":121744},[],{"_3496":72352,"_30262":72308,"_21040":122290,"_5":14474,"_27550":122198,"_2978":122291},[],"Qué prepara o comprueba",{"_3496":72353,"_30262":72308,"_21040":122293,"_5":14474,"_27550":122198,"_2978":121747},[],{"_3496":72354,"_30262":72308,"_21040":122295,"_5":14474,"_27550":122198,"_2978":122296},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3496":72355,"_30262":72308,"_21040":122298,"_5":14474,"_27550":122198,"_2978":122299},[],"Administrador de la flota",{"_3496":72356,"_30262":72308,"_21040":122301,"_5":14474,"_27550":122198,"_2978":122302},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3496":72357,"_30262":72308,"_21040":122304,"_5":14474,"_27550":122198,"_2978":121759},[],{"_3496":72358,"_30262":72308,"_21040":122306,"_5":14474,"_27550":122198,"_2978":122307},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3496":72359,"_30262":72308,"_21040":122309,"_5":14474,"_27550":122198,"_2978":121765},[],{"_3496":72360,"_30262":72308,"_21040":122311,"_5":14474,"_27550":122198,"_2978":122312},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3496":72361,"_30262":72308,"_21040":122314,"_5":14474,"_27550":122198,"_2978":122315},[],"Operador de infraestructura",{"_3496":72362,"_30262":72308,"_21040":122317,"_5":14474,"_27550":122198,"_2978":122318},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3496":72363,"_30262":72308,"_21040":122320,"_5":14474,"_27550":122198,"_2978":122321},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3496":72364,"_30262":72364,"_5":14825,"_2978":122323,"_30620":122324,"_21040":122326,"_27550":72364},"Jerarquía y rotación de CAs",[49507,118444,54983,122325],"Claves, autoridades y certificados",[],{"_3496":72365,"_30262":72364,"_21040":122328,"_5":14474,"_27550":72364,"_2978":122329},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3496":72366,"_30262":72364,"_5":30617,"_21040":122331,"_27550":122332,"_2978":122333},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3496":72367,"_30262":72364,"_5":30617,"_21040":122335,"_27550":122336,"_2978":122337},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3496":72368,"_30262":72364,"_5":30617,"_21040":122339,"_27550":122340,"_2978":122341},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3496":72369,"_30262":72364,"_5":30617,"_21040":122343,"_27550":122344,"_2978":122345},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3496":72370,"_30262":72364,"_5":30617,"_21040":122347,"_27550":122348,"_2978":122349},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3496":72371,"_30262":72364,"_5":30617,"_21040":122351,"_27550":122352,"_2978":122353},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3496":72372,"_30262":72364,"_5":30617,"_21040":122355,"_27550":122356,"_2978":122357},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3496":72373,"_30262":72364,"_5":30617,"_21040":122359,"_27550":122360,"_2978":122361},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3496":72374,"_30262":72364,"_5":30617,"_21040":122363,"_27550":122364,"_2978":122365},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3496":72375,"_30262":72364,"_5":30617,"_21040":122367,"_27550":122368,"_2978":122369},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3496":72376,"_30262":72364,"_5":30617,"_21040":122371,"_27550":122372,"_2978":122373},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3496":72377,"_30262":72364,"_5":30617,"_21040":122375,"_27550":122376,"_2978":122377},[],"/docs/pr-preview/pr-61/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3496":72378,"_30262":72364,"_21040":122379,"_5":14474,"_27550":72364,"_2978":122380},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3496":72379,"_30262":72364,"_21040":122382,"_5":14474,"_27550":72364,"_2978":122383},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3496":72380,"_30262":72364,"_21040":122385,"_5":14474,"_27550":122332,"_2978":122386},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3496":72381,"_30262":72364,"_21040":122388,"_5":14474,"_27550":122332,"_2978":122389},[],"entorno, como producción y preproducción;",{"_3496":72382,"_30262":72364,"_21040":122391,"_5":14474,"_27550":122332,"_2978":122392},[],"propietario o equipo operador;",{"_3496":72383,"_30262":72364,"_21040":122394,"_5":14474,"_27550":122332,"_2978":122395},[],"familia de dispositivos o proceso de fabricación;",{"_3496":72384,"_30262":72364,"_21040":122397,"_5":14474,"_27550":122332,"_2978":122398},[],"región o requisito regulatorio;",{"_3496":72385,"_30262":72364,"_21040":122400,"_5":14474,"_27550":122332,"_2978":122401},[],"motor criptográfico o política de clave;",{"_3496":72386,"_30262":72364,"_21040":122403,"_5":14474,"_27550":122332,"_2978":122404},[],"ventana de mantenimiento y ritmo de renovación.",{"_3496":72387,"_30262":72364,"_21040":122406,"_5":14474,"_27550":122332,"_2978":122407},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3496":72388,"_30262":72364,"_21040":122409,"_5":14474,"_27550":122332,"_2978":122410},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3496":72389,"_30262":72364,"_21040":122412,"_5":14474,"_27550":122336,"_2978":122413},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3496":72390,"_30262":72364,"_21040":122415,"_5":14474,"_27550":122336,"_2978":122416},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3496":72391,"_30262":72364,"_21040":122418,"_5":14474,"_27550":122336,"_2978":122419},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3496":72392,"_30262":72364,"_21040":122421,"_5":14474,"_27550":122336,"_2978":122422},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3496":72393,"_30262":72364,"_21040":122424,"_5":14474,"_27550":122340,"_2978":122425},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3496":72394,"_30262":72364,"_21040":122427,"_5":14474,"_27550":122340,"_2978":122428},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3496":72395,"_30262":72364,"_21040":122430,"_5":14474,"_27550":122340,"_2978":122431},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3496":72396,"_30262":72364,"_21040":122433,"_5":14474,"_27550":122340,"_2978":122434},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3496":72397,"_30262":72364,"_21040":122436,"_5":14474,"_27550":122348,"_2978":122437},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3496":72398,"_30262":72364,"_21040":122439,"_5":14474,"_27550":122352,"_2978":122440},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3496":72399,"_30262":72364,"_21040":122442,"_5":14474,"_27550":122356,"_2978":122443},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3496":72400,"_30262":72364,"_21040":122445,"_5":14474,"_27550":122360,"_2978":122446},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3496":72401,"_30262":72364,"_21040":122448,"_5":14474,"_27550":122364,"_2978":122449},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3496":72402,"_30262":72364,"_21040":122451,"_5":14474,"_27550":122368,"_2978":122452},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3496":72403,"_30262":72364,"_21040":122454,"_5":14474,"_27550":122372,"_2978":122455},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3496":72404,"_30262":72364,"_21040":122457,"_5":14474,"_27550":122372,"_2978":122458},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3496":72405,"_30262":72364,"_21040":122460,"_5":14474,"_27550":122372,"_2978":122461},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3496":72406,"_30262":72364,"_21040":122463,"_5":14474,"_27550":122372,"_2978":122464},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3496":72407,"_30262":72364,"_21040":122466,"_5":14474,"_27550":122376,"_2978":122467},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3496":72408,"_30262":72364,"_21040":122469,"_5":14474,"_27550":122376,"_2978":122470},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3496":72409,"_30262":72364,"_21040":122472,"_5":14474,"_27550":122376,"_2978":122473},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3496":72410,"_30262":72364,"_21040":122475,"_5":14474,"_27550":122376,"_2978":122476},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3496":72411,"_30262":72364,"_21040":122478,"_5":14474,"_27550":122376,"_2978":122479},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3496":72412,"_30262":72364,"_21040":122481,"_5":14474,"_27550":122376,"_2978":122482},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3496":72413,"_30262":72364,"_21040":122484,"_5":14474,"_27550":122376,"_2978":122485},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3496":72414,"_30262":72414,"_5":14825,"_2978":122487,"_30620":122488,"_21040":122489,"_27550":72414},"Autoridades de certificación",[49507,118444,54983,122325],[],{"_3496":72415,"_30262":72414,"_21040":122491,"_5":14474,"_27550":72414,"_2978":122492},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3496":72416,"_30262":72414,"_5":30617,"_21040":122494,"_27550":122495,"_2978":122496},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3496":72417,"_30262":72414,"_5":30617,"_21040":122498,"_27550":122499,"_2978":122500},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3496":72418,"_30262":72414,"_5":30617,"_21040":122502,"_27550":122503,"_2978":117022},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3496":72419,"_30262":72414,"_5":30617,"_21040":122505,"_27550":122506,"_2978":122507},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3496":72420,"_30262":72414,"_5":30617,"_21040":122509,"_27550":122510,"_2978":122511},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3496":72421,"_30262":72414,"_5":30617,"_21040":122513,"_27550":122514,"_2978":122515},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3496":72422,"_30262":72414,"_5":30617,"_21040":122517,"_27550":122518,"_2978":122519},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3496":72423,"_30262":72414,"_5":30617,"_21040":122521,"_27550":122522,"_2978":122523},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3496":72424,"_30262":72414,"_5":30617,"_21040":122525,"_27550":122526,"_2978":122527},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3496":72425,"_30262":72414,"_5":30617,"_21040":122529,"_27550":122530,"_2978":122531},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3496":72426,"_30262":72414,"_5":30617,"_21040":122533,"_27550":122534,"_2978":122535},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3496":72427,"_30262":72414,"_5":30617,"_21040":122537,"_27550":122538,"_2978":122539},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3496":72428,"_30262":72414,"_5":30617,"_21040":122541,"_27550":122542,"_2978":122543},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3496":72429,"_30262":72414,"_5":30617,"_21040":122545,"_27550":122546,"_2978":122547},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3496":72430,"_30262":72414,"_5":30617,"_21040":122549,"_27550":122550,"_2978":122551},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3496":72431,"_30262":72414,"_5":30617,"_21040":122553,"_27550":122554,"_2978":122555},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3496":72432,"_30262":72414,"_5":30617,"_21040":122557,"_27550":122558,"_2978":122559},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3496":72433,"_30262":72414,"_5":30617,"_21040":122561,"_27550":122562,"_2978":122563},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3496":72434,"_30262":72414,"_5":30617,"_21040":122565,"_27550":122566,"_2978":122567},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3496":72435,"_30262":72414,"_5":30617,"_21040":122569,"_27550":122570,"_2978":122571},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3496":72436,"_30262":72414,"_5":30617,"_21040":122573,"_27550":122574,"_2978":122575},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3496":72437,"_30262":72414,"_5":30617,"_21040":122577,"_27550":122578,"_2978":122579},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3496":72438,"_30262":72414,"_5":30617,"_21040":122581,"_27550":122582,"_2978":122583},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3496":72439,"_30262":72414,"_21040":122585,"_5":14474,"_27550":72414,"_2978":122586},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3496":72440,"_30262":72414,"_21040":122588,"_5":14474,"_27550":72414,"_2978":122589},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3496":72441,"_30262":72414,"_21040":122591,"_5":14474,"_27550":72414,"_2978":122592},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3496":72442,"_30262":72414,"_21040":122594,"_5":14474,"_27550":122495,"_2978":122595},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3496":72443,"_30262":72414,"_21040":122597,"_5":14474,"_27550":122495,"_2978":122598},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3496":72444,"_30262":72414,"_21040":122600,"_5":14474,"_27550":122495,"_2978":122601},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3496":72445,"_30262":72414,"_21040":122603,"_5":14474,"_27550":122495,"_2978":122604},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3496":72446,"_30262":72414,"_21040":122606,"_5":14474,"_27550":122495,"_2978":122607},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3496":72447,"_30262":72414,"_21040":122609,"_5":14474,"_27550":122503,"_2978":122610},[],"Decide si la CA será raíz o intermedia.",{"_3496":72448,"_30262":72414,"_21040":122612,"_5":14474,"_27550":122503,"_2978":122613},[],"Elige el motor que custodiará la clave.",{"_3496":72449,"_30262":72414,"_21040":122615,"_5":14474,"_27550":122503,"_2978":122616},[],"Define una validez superior a la de los certificados que emitirá.",{"_3496":72450,"_30262":72414,"_21040":122618,"_5":14474,"_27550":122503,"_2978":122619},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3496":72451,"_30262":72414,"_21040":122621,"_5":14474,"_27550":122506,"_2978":122622},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3496":72452,"_30262":72414,"_21040":122624,"_5":14474,"_27550":122510,"_2978":122625},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3496":72453,"_30262":72414,"_21040":122627,"_5":14474,"_27550":122510,"_2978":122628},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3496":72454,"_30262":72414,"_21040":122630,"_5":14474,"_27550":122514,"_2978":122631},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3496":72455,"_30262":72414,"_21040":122633,"_5":14474,"_27550":122518,"_2978":122634},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3496":72456,"_30262":72414,"_21040":122636,"_5":14474,"_27550":122518,"_2978":122637},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3496":72457,"_30262":72414,"_21040":122639,"_5":14474,"_27550":122518,"_2978":122640},[],"`ST`: estado o provincia.",{"_3496":72458,"_30262":72414,"_21040":122642,"_5":14474,"_27550":122518,"_2978":122643},[],"`L`: localidad.",{"_3496":72459,"_30262":72414,"_21040":122645,"_5":14474,"_27550":122518,"_2978":122646},[],"`O`: organización.",{"_3496":72460,"_30262":72414,"_21040":122648,"_5":14474,"_27550":122518,"_2978":122649},[],"`OU`: unidad organizativa.",{"_3496":72461,"_30262":72414,"_21040":122651,"_5":14474,"_27550":122518,"_2978":122652},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3496":72462,"_30262":72414,"_21040":122654,"_5":14474,"_27550":122522,"_2978":122655},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3496":72463,"_30262":72414,"_21040":122657,"_5":14474,"_27550":122522,"_2978":122658},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3496":72464,"_30262":72414,"_21040":122660,"_5":14474,"_27550":122526,"_2978":122661},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3496":72465,"_30262":72414,"_21040":122663,"_5":14474,"_27550":122526,"_2978":122664},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3496":72466,"_30262":72414,"_21040":122666,"_5":14474,"_27550":122530,"_2978":122667},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3496":72467,"_30262":72414,"_21040":122669,"_5":14474,"_27550":122530,"_2978":122670},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3496":72468,"_30262":72414,"_21040":122672,"_5":14474,"_27550":122534,"_2978":122673},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3496":72469,"_30262":72414,"_21040":122675,"_5":14474,"_27550":122534,"_2978":122676},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3496":72470,"_30262":72414,"_21040":122678,"_5":14474,"_27550":122534,"_2978":122679},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3496":72471,"_30262":72414,"_21040":122681,"_5":14474,"_27550":122538,"_2978":122682},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3496":72472,"_30262":72414,"_21040":122684,"_5":14474,"_27550":122542,"_2978":122685},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3496":72473,"_30262":72414,"_21040":122687,"_5":14474,"_27550":122542,"_2978":122688},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3496":72474,"_30262":72414,"_21040":122690,"_5":14474,"_27550":122546,"_2978":122691},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3496":72475,"_30262":72414,"_21040":122693,"_5":14474,"_27550":122550,"_2978":122694},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3496":72476,"_30262":72414,"_21040":122696,"_5":14474,"_27550":122550,"_2978":122697},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3496":72477,"_30262":72414,"_21040":122699,"_5":14474,"_27550":122554,"_2978":122700},[],"Abre una CA desde el inventario para consultar:",{"_3496":72478,"_30262":72414,"_21040":122702,"_5":14474,"_27550":122554,"_2978":122703},[],"Estado y periodo de validez.",{"_3496":72479,"_30262":72414,"_21040":122705,"_5":14474,"_27550":122554,"_2978":122706},[],"Certificado y cadena en formato PEM.",{"_3496":72480,"_30262":72414,"_21040":122708,"_5":14474,"_27550":122554,"_2978":122709},[],"Número de certificados activos, expirados y revocados.",{"_3496":72481,"_30262":72414,"_21040":122711,"_5":14474,"_27550":122554,"_2978":122712},[],"Certificados emitidos en **Issued Certificates**.",{"_3496":72482,"_30262":72414,"_21040":122714,"_5":14474,"_27550":122554,"_2978":122715},[],"CRL vinculada a la autoridad.",{"_3496":72483,"_30262":72414,"_21040":122717,"_5":14474,"_27550":122554,"_2978":122718},[],"Metadatos y motor criptográfico asociado.",{"_3496":72484,"_30262":72414,"_21040":122720,"_5":14474,"_27550":122554,"_2978":122721},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3496":72485,"_30262":72414,"_21040":122723,"_5":14474,"_27550":122558,"_2978":122724},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3496":72486,"_30262":72414,"_21040":122726,"_5":14474,"_27550":122558,"_2978":122727},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3496":72487,"_30262":72414,"_21040":122729,"_5":14474,"_27550":122558,"_2978":122730},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3496":72488,"_30262":72414,"_21040":122732,"_5":14474,"_27550":122558,"_2978":122733},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3496":72489,"_30262":72414,"_21040":122735,"_5":14474,"_27550":122562,"_2978":122736},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3496":72490,"_30262":72414,"_21040":122738,"_5":14474,"_27550":122566,"_2978":122739},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3496":72491,"_30262":72414,"_21040":122741,"_5":14474,"_27550":122570,"_2978":122742},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3496":72492,"_30262":72414,"_21040":122744,"_5":14474,"_27550":122574,"_2978":122745},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3496":72493,"_30262":72414,"_21040":122747,"_5":14474,"_27550":122578,"_2978":122748},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3496":72494,"_30262":72414,"_21040":122750,"_5":14474,"_27550":122582,"_2978":122751},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3496":72495,"_30262":72414,"_21040":122753,"_5":14474,"_27550":122582,"_2978":122754},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3496":72496,"_30262":72414,"_21040":122756,"_5":14474,"_27550":122582,"_2978":122757},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3496":72497,"_30262":72497,"_5":14825,"_2978":122759,"_30620":122760,"_21040":122761,"_27550":72497},"Perfiles de certificado",[49507,118444,54983,122325],[],{"_3496":72498,"_30262":72497,"_21040":122763,"_5":14474,"_27550":72497,"_2978":122764},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3496":72499,"_30262":72497,"_5":30617,"_21040":122766,"_27550":122767,"_2978":122768},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3496":72500,"_30262":72497,"_5":30617,"_21040":122770,"_27550":122771,"_2978":122772},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#validez","Validez",{"_3496":72501,"_30262":72497,"_5":30617,"_21040":122774,"_27550":122775,"_2978":122776},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3496":72502,"_30262":72497,"_5":30617,"_21040":122778,"_27550":122779,"_2978":122780},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3496":72503,"_30262":72497,"_5":30617,"_21040":122782,"_27550":122783,"_2978":122784},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3496":72504,"_30262":72497,"_5":30617,"_21040":122786,"_27550":122787,"_2978":122788},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3496":72505,"_30262":72497,"_5":30617,"_21040":122790,"_27550":122791,"_2978":122792},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3496":72506,"_30262":72497,"_5":30617,"_21040":122794,"_27550":122795,"_2978":122796},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3496":72507,"_30262":72497,"_5":30617,"_21040":122798,"_27550":122799,"_2978":122800},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3496":72508,"_30262":72497,"_5":30617,"_21040":122802,"_27550":122803,"_2978":122804},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3496":72509,"_30262":72497,"_5":30617,"_21040":122806,"_27550":122807,"_2978":122808},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3496":72510,"_30262":72497,"_5":30617,"_21040":122810,"_27550":122811,"_2978":122812},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3496":72511,"_30262":72497,"_5":30617,"_21040":122814,"_27550":122815,"_2978":122816},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3496":72512,"_30262":72497,"_5":30617,"_21040":122818,"_27550":122819,"_2978":122820},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3496":72513,"_30262":72497,"_5":30617,"_21040":122822,"_27550":122823,"_2978":122824},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3496":72514,"_30262":72497,"_5":30617,"_21040":122826,"_27550":122827,"_2978":122828},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3496":72515,"_30262":72497,"_21040":122830,"_5":14474,"_27550":72497,"_2978":122831},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3496":72516,"_30262":72497,"_21040":122833,"_5":14474,"_27550":72497,"_2978":122834},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3496":72517,"_30262":72497,"_21040":122836,"_5":14474,"_27550":122771,"_2978":122837},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3496":72518,"_30262":72497,"_21040":122839,"_5":14474,"_27550":122771,"_2978":122840},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3496":72519,"_30262":72497,"_21040":122842,"_5":14474,"_27550":122775,"_2978":122843},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3496":72520,"_30262":72497,"_21040":122845,"_5":14474,"_27550":122779,"_2978":122846},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3496":72521,"_30262":72497,"_21040":122848,"_5":14474,"_27550":122779,"_2978":122849},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3496":72522,"_30262":72497,"_21040":122851,"_5":14474,"_27550":122779,"_2978":122852},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3496":72523,"_30262":72497,"_21040":122854,"_5":14474,"_27550":122783,"_2978":122855},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3496":72524,"_30262":72497,"_21040":122857,"_5":14474,"_27550":122787,"_2978":122858},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3496":72525,"_30262":72497,"_21040":122860,"_5":14474,"_27550":122787,"_2978":122861},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3496":72526,"_30262":72497,"_21040":122863,"_5":14474,"_27550":122791,"_2978":122864},[],"La aplicación criptográfica puede:",{"_3496":72527,"_30262":72497,"_21040":122866,"_5":14474,"_27550":122791,"_2978":122867},[],"permitir o bloquear claves RSA;",{"_3496":72528,"_30262":72497,"_21040":122869,"_5":14474,"_27550":122791,"_2978":122870},[],"limitar los tamaños RSA admitidos;",{"_3496":72529,"_30262":72497,"_21040":122872,"_5":14474,"_27550":122791,"_2978":122873},[],"permitir o bloquear claves ECDSA;",{"_3496":72530,"_30262":72497,"_21040":122875,"_5":14474,"_27550":122791,"_2978":122876},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3496":72531,"_30262":72497,"_21040":122878,"_5":14474,"_27550":122791,"_2978":122879},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3496":72532,"_30262":72497,"_21040":122881,"_5":14474,"_27550":122795,"_2978":122882},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3496":72533,"_30262":72497,"_21040":122884,"_5":14474,"_27550":122795,"_2978":118204},[],{"_3496":72534,"_30262":72497,"_21040":122886,"_5":14474,"_27550":122795,"_2978":122887},[],"Primera opción",{"_3496":72535,"_30262":72497,"_21040":122889,"_5":14474,"_27550":122795,"_2978":122890},[],"Segunda opción",{"_3496":72536,"_30262":72497,"_21040":122892,"_5":14474,"_27550":122795,"_2978":122893},[],"Si no hay ninguna",{"_3496":72537,"_30262":72497,"_21040":122895,"_5":14474,"_27550":122795,"_2978":122896},[],"Firma directa con una CA",{"_3496":72538,"_30262":72497,"_21040":122898,"_5":14474,"_27550":122795,"_2978":122899},[],"`issuance_profile` incluido en la solicitud",{"_3496":72539,"_30262":72497,"_21040":122901,"_5":14474,"_27550":122795,"_2978":122902},[],"`issuance_profile_id` de la solicitud",{"_3496":72540,"_30262":72497,"_21040":122904,"_5":14474,"_27550":122795,"_2978":122905},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3496":72541,"_30262":72497,"_21040":122907,"_5":14474,"_27550":122795,"_2978":122908},[],"Emisión mediante DMS",{"_3496":72542,"_30262":72497,"_21040":122910,"_5":14474,"_27550":122795,"_2978":55570},[],{"_3496":72543,"_30262":72497,"_21040":122912,"_5":14474,"_27550":122795,"_2978":122913},[],"`settings.issuance_profile` incluido en el DMS",{"_3496":72544,"_30262":72497,"_21040":122915,"_5":14474,"_27550":122795,"_2978":122916},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3496":72545,"_30262":72497,"_21040":122918,"_5":14474,"_27550":122795,"_2978":122919},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3496":72546,"_30262":72497,"_21040":122921,"_5":14474,"_27550":122795,"_2978":122922},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3496":72547,"_30262":72497,"_21040":122924,"_5":14474,"_27550":122803,"_2978":122925},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3496":72548,"_30262":72497,"_21040":122927,"_5":14474,"_27550":122807,"_2978":122928},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3496":72549,"_30262":72497,"_21040":122930,"_5":14474,"_27550":122811,"_2978":122931},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3496":72550,"_30262":72497,"_21040":122933,"_5":14474,"_27550":122815,"_2978":122934},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3496":72551,"_30262":72497,"_21040":122936,"_5":14474,"_27550":122819,"_2978":122937},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3496":72552,"_30262":72497,"_21040":122939,"_5":14474,"_27550":122819,"_2978":122940},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3496":72553,"_30262":72497,"_21040":122942,"_5":14474,"_27550":122823,"_2978":122943},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3496":72554,"_30262":72497,"_21040":122945,"_5":14474,"_27550":122823,"_2978":122946},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3496":72555,"_30262":72497,"_21040":122948,"_5":14474,"_27550":122823,"_2978":122949},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3496":72556,"_30262":72497,"_21040":122951,"_5":14474,"_27550":122823,"_2978":122952},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3496":72557,"_30262":72497,"_21040":122954,"_5":14474,"_27550":122827,"_2978":122955},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3496":72558,"_30262":72497,"_21040":122957,"_5":14474,"_27550":122827,"_2978":122958},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3496":72559,"_30262":72559,"_5":14825,"_2978":122960,"_30620":122961,"_21040":122963,"_27550":72559},"Validación de certificados",[49507,118444,54983,122962],"Validación",[],{"_3496":72560,"_30262":72559,"_21040":122965,"_5":14474,"_27550":72559,"_2978":122966},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3496":72561,"_30262":72559,"_5":30617,"_21040":122968,"_27550":122969,"_2978":122970},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3496":72562,"_30262":72559,"_5":30617,"_21040":122972,"_27550":122973,"_2978":122974},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3496":72563,"_30262":72559,"_5":30617,"_21040":122976,"_27550":122977,"_2978":122978},[],"/docs/pr-preview/pr-61/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3496":72564,"_30262":72559,"_21040":122980,"_5":14474,"_27550":72559,"_2978":122981},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3496":72565,"_30262":72559,"_21040":122983,"_5":14474,"_27550":122969,"_2978":122984},[],"Verifica estos criterios juntos:",{"_3496":72566,"_30262":72559,"_21040":122986,"_5":14474,"_27550":122969,"_2978":121954},[],{"_3496":72567,"_30262":72559,"_21040":122988,"_5":14474,"_27550":122969,"_2978":122989},[],"Resultado necesario",{"_3496":72568,"_30262":72559,"_21040":122991,"_5":14474,"_27550":122969,"_2978":122992},[],"Cadena y firma",{"_3496":72569,"_30262":72559,"_21040":122994,"_5":14474,"_27550":122969,"_2978":122995},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3496":72570,"_30262":72559,"_21040":122997,"_5":14474,"_27550":122969,"_2978":122998},[],"Fechas",{"_3496":72571,"_30262":72559,"_21040":123000,"_5":14474,"_27550":122969,"_2978":123001},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3496":72572,"_30262":72559,"_21040":123003,"_5":14474,"_27550":122969,"_2978":118114},[],{"_3496":72573,"_30262":72559,"_21040":123005,"_5":14474,"_27550":122969,"_2978":123006},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3496":72574,"_30262":72559,"_21040":123008,"_5":14474,"_27550":122969,"_2978":123009},[],"Uso",{"_3496":72575,"_30262":72559,"_21040":123011,"_5":14474,"_27550":122969,"_2978":123012},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3496":72576,"_30262":72559,"_21040":123014,"_5":14474,"_27550":122969,"_2978":123015},[],"Revocación",{"_3496":72577,"_30262":72559,"_21040":123017,"_5":14474,"_27550":122969,"_2978":123018},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3496":72578,"_30262":72559,"_21040":123020,"_5":14474,"_27550":122969,"_2978":123021},[],"Autorización",{"_3496":72579,"_30262":72559,"_21040":123023,"_5":14474,"_27550":122969,"_2978":123024},[],"La aplicación permite la acción a esa identidad.",{"_3496":72580,"_30262":72559,"_21040":123026,"_5":14474,"_27550":122969,"_2978":123027},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3496":72581,"_30262":72559,"_21040":123029,"_5":14474,"_27550":122973,"_2978":123030},[],"Mecanismo",{"_3496":72582,"_30262":72559,"_21040":123032,"_5":14474,"_27550":122973,"_2978":123033},[],"Cuándo utilizarlo",{"_3496":72583,"_30262":72559,"_21040":123035,"_5":14474,"_27550":122973,"_2978":123036},[],"Qué debes mantener",{"_3496":72584,"_30262":72559,"_21040":123038,"_5":14474,"_27550":122973,"_2978":55698},[],{"_3496":72585,"_30262":72559,"_21040":123040,"_5":14474,"_27550":122973,"_2978":123041},[],"Consulta del estado de un certificado concreto.",{"_3496":72586,"_30262":72559,"_21040":123043,"_5":14474,"_27550":122973,"_2978":123044},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3496":72587,"_30262":72559,"_21040":123046,"_5":14474,"_27550":122973,"_2978":55707},[],{"_3496":72588,"_30262":72559,"_21040":123048,"_5":14474,"_27550":122973,"_2978":123049},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3496":72589,"_30262":72559,"_21040":123051,"_5":14474,"_27550":122973,"_2978":123052},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3496":72590,"_30262":72559,"_21040":123054,"_5":14474,"_27550":122973,"_2978":123055},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3496":72591,"_30262":72559,"_21040":123057,"_5":14474,"_27550":122973,"_2978":123058},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3496":72592,"_30262":72559,"_21040":123060,"_5":14474,"_27550":122977,"_2978":123061},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3496":72593,"_30262":72559,"_21040":123063,"_5":14474,"_27550":122977,"_2978":123064},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3496":72594,"_30262":72559,"_21040":123066,"_5":14474,"_27550":122977,"_2978":123067},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3496":72595,"_30262":72559,"_21040":123069,"_5":14474,"_27550":122977,"_2978":123070},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3496":72596,"_30262":72559,"_21040":123072,"_5":14474,"_27550":122977,"_2978":123073},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3496":72597,"_30262":72559,"_21040":123075,"_5":14474,"_27550":122977,"_2978":123076},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3496":72598,"_30262":72559,"_21040":123078,"_5":14474,"_27550":122977,"_2978":123079},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3496":72599,"_30262":72559,"_21040":123081,"_5":14474,"_27550":122977,"_2978":123082},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3496":72600,"_30262":72559,"_21040":123084,"_5":14474,"_27550":122977,"_2978":123085},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3496":72601,"_30262":72601,"_5":14825,"_2978":123087,"_30620":123088,"_21040":123089,"_27550":72601},"Certificados",[49507,118444,54983,122325],[],{"_3496":72602,"_30262":72601,"_21040":123091,"_5":14474,"_27550":72601,"_2978":123092},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3496":72603,"_30262":72601,"_5":30617,"_21040":123094,"_27550":123095,"_2978":123096},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3496":72604,"_30262":72601,"_5":30617,"_21040":123098,"_27550":123099,"_2978":123100},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3496":72605,"_30262":72601,"_5":30617,"_21040":123102,"_27550":123103,"_2978":123104},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3496":72606,"_30262":72601,"_5":30617,"_21040":123106,"_27550":123107,"_2978":123108},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3496":72607,"_30262":72601,"_5":30617,"_21040":123110,"_27550":123111,"_2978":123112},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3496":72608,"_30262":72601,"_5":30617,"_21040":123114,"_27550":123115,"_2978":123116},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3496":72609,"_30262":72601,"_5":30617,"_21040":123118,"_27550":123119,"_2978":123120},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3496":72610,"_30262":72601,"_5":30617,"_21040":123122,"_27550":123123,"_2978":123124},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3496":72611,"_30262":72601,"_5":30617,"_21040":123126,"_27550":123127,"_2978":123128},[],"/docs/pr-preview/pr-61/es/platform/pki/certificates#continúa","Continúa",{"_3496":72612,"_30262":72601,"_21040":123130,"_5":14474,"_27550":72601,"_2978":123131},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3496":72613,"_30262":72601,"_21040":123133,"_5":14474,"_27550":123095,"_2978":123134},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3496":72614,"_30262":72601,"_21040":123136,"_5":14474,"_27550":123095,"_2978":123137},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3496":72615,"_30262":72601,"_21040":123139,"_5":14474,"_27550":123095,"_2978":123140},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3496":72616,"_30262":72601,"_21040":123142,"_5":14474,"_27550":123095,"_2978":123143},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3496":72617,"_30262":72601,"_21040":123145,"_5":14474,"_27550":123095,"_2978":123146},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3496":72618,"_30262":72601,"_21040":123148,"_5":14474,"_27550":123095,"_2978":123149},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3496":72619,"_30262":72601,"_21040":123151,"_5":14474,"_27550":123095,"_2978":123152},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3496":72620,"_30262":72601,"_21040":123154,"_5":14474,"_27550":123099,"_2978":123155},[],"Descarga el PEM e inspecciónalo:",{"_3496":72621,"_30262":72601,"_21040":123157,"_5":14474,"_27550":123099,"_2978":123158},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3496":72622,"_30262":72601,"_21040":123160,"_5":14474,"_27550":123103,"_2978":123161},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3496":72623,"_30262":72601,"_21040":123163,"_5":14474,"_27550":123103,"_2978":123164},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3496":72624,"_30262":72601,"_21040":123166,"_5":14474,"_27550":123103,"_2978":123167},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3496":72625,"_30262":72601,"_21040":123169,"_5":14474,"_27550":123103,"_2978":123170},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3496":72626,"_30262":72601,"_21040":123172,"_5":14474,"_27550":123103,"_2978":123173},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3496":72627,"_30262":72601,"_21040":123175,"_5":14474,"_27550":123103,"_2978":123176},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3496":72628,"_30262":72601,"_21040":123178,"_5":14474,"_27550":123103,"_2978":123179},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3496":72629,"_30262":72601,"_21040":123181,"_5":14474,"_27550":123107,"_2978":123182},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3496":72630,"_30262":72601,"_21040":123184,"_5":14474,"_27550":123111,"_2978":123185},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Hay un recorrido guiado en Revoca un certificado y comprueba la CRL. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3496":72631,"_30262":72601,"_21040":123187,"_5":14474,"_27550":123115,"_2978":123188},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3496":72632,"_30262":72601,"_21040":123190,"_5":14474,"_27550":123119,"_2978":123191},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3496":72633,"_30262":72601,"_21040":123193,"_5":14474,"_27550":123119,"_2978":123194},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3496":72634,"_30262":72601,"_21040":123196,"_5":14474,"_27550":123119,"_2978":123197},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3496":72635,"_30262":72601,"_21040":123199,"_5":14474,"_27550":123123,"_2978":123200},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3496":72636,"_30262":72601,"_21040":123202,"_5":14474,"_27550":123123,"_2978":123203},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3496":72637,"_30262":72601,"_21040":123205,"_5":14474,"_27550":123123,"_2978":123206},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3496":72638,"_30262":72601,"_21040":123208,"_5":14474,"_27550":123127,"_2978":123209},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3496":72639,"_30262":72601,"_21040":123211,"_5":14474,"_27550":123127,"_2978":123212},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3496":72640,"_30262":72640,"_5":14825,"_2978":123214,"_30620":123215,"_21040":123217,"_27550":72640},"Ciclo de vida de un certificado",[49507,118444,54983,123216],"Conceptos",[],{"_3496":72641,"_30262":72640,"_21040":123219,"_5":14474,"_27550":72640,"_2978":123220},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3496":72642,"_30262":72640,"_5":30617,"_21040":123222,"_27550":123223,"_2978":123224},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3496":72643,"_30262":72640,"_5":30617,"_21040":123226,"_27550":123227,"_2978":123228},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3496":72644,"_30262":72640,"_5":30617,"_21040":123230,"_27550":123231,"_2978":123232},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3496":72645,"_30262":72640,"_5":30617,"_21040":123234,"_27550":123235,"_2978":123236},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3496":72646,"_30262":72640,"_5":30617,"_21040":123238,"_27550":123239,"_2978":123240},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3496":72647,"_30262":72640,"_5":30617,"_21040":123242,"_27550":123243,"_2978":123244},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3496":72648,"_30262":72640,"_5":30617,"_21040":123246,"_27550":123247,"_2978":120948},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3496":72649,"_30262":72640,"_5":30617,"_21040":123249,"_27550":123250,"_2978":123251},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3496":72650,"_30262":72640,"_5":30617,"_21040":123253,"_27550":123254,"_2978":123255},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3496":72651,"_30262":72640,"_5":30617,"_21040":123257,"_27550":123258,"_2978":123259},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3496":72652,"_30262":72640,"_21040":123261,"_5":14474,"_27550":72640,"_2978":123262},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3496":72653,"_30262":72640,"_21040":123264,"_5":14474,"_27550":123227,"_2978":123265},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3496":72654,"_30262":72640,"_21040":123267,"_5":14474,"_27550":123231,"_2978":123268},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3496":72655,"_30262":72640,"_21040":123270,"_5":14474,"_27550":123235,"_2978":123271},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3496":72656,"_30262":72640,"_21040":123273,"_5":14474,"_27550":123239,"_2978":123274},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3496":72657,"_30262":72640,"_21040":123276,"_5":14474,"_27550":123243,"_2978":123277},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3496":72658,"_30262":72640,"_21040":123279,"_5":14474,"_27550":123247,"_2978":123280},[],"Lamassu persiste cuatro estados X.509:",{"_3496":72659,"_30262":72640,"_21040":123282,"_5":14474,"_27550":123247,"_2978":123283},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3496":72660,"_30262":72640,"_21040":123285,"_5":14474,"_27550":123247,"_2978":123286},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3496":72661,"_30262":72640,"_21040":123288,"_5":14474,"_27550":123247,"_2978":123289},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3496":72662,"_30262":72640,"_21040":123291,"_5":14474,"_27550":123247,"_2978":123292},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3496":72663,"_30262":72640,"_21040":123294,"_5":14474,"_27550":123247,"_2978":123295},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3496":72664,"_30262":72640,"_21040":123297,"_5":14474,"_27550":123250,"_2978":123298},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3496":72665,"_30262":72640,"_21040":123300,"_5":14474,"_27550":123250,"_2978":123301},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3496":72666,"_30262":72640,"_21040":123303,"_5":14474,"_27550":123250,"_2978":123304},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3496":72667,"_30262":72640,"_21040":123306,"_5":14474,"_27550":123254,"_2978":123307},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3496":72668,"_30262":72640,"_21040":123309,"_5":14474,"_27550":123254,"_2978":123310},[],"Antes de confirmar:",{"_3496":72669,"_30262":72640,"_21040":123312,"_5":14474,"_27550":123254,"_2978":123313},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3496":72670,"_30262":72640,"_21040":123315,"_5":14474,"_27550":123254,"_2978":123316},[],"Distribuye la nueva cadena de confianza.",{"_3496":72671,"_30262":72640,"_21040":123318,"_5":14474,"_27550":123254,"_2978":123319},[],"Reemite las identidades necesarias.",{"_3496":72672,"_30262":72640,"_21040":123321,"_5":14474,"_27550":123254,"_2978":123322},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3496":72673,"_30262":72640,"_21040":123324,"_5":14474,"_27550":123254,"_2978":123325},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3496":72674,"_30262":72640,"_21040":123327,"_5":14474,"_27550":123254,"_2978":123328},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3496":72675,"_30262":72640,"_21040":123330,"_5":14474,"_27550":123258,"_2978":123331},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3496":72676,"_30262":72640,"_21040":123333,"_5":14474,"_27550":123258,"_2978":123334},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3496":72677,"_30262":72640,"_21040":123336,"_5":14474,"_27550":123258,"_2978":123337},[],"Cambios de estado y razones de revocación.",{"_3496":72678,"_30262":72640,"_21040":123339,"_5":14474,"_27550":123258,"_2978":123340},[],"Publicación y vigencia de OCSP y CRLs.",{"_3496":72679,"_30262":72640,"_21040":123342,"_5":14474,"_27550":123258,"_2978":123343},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3496":72680,"_30262":72640,"_21040":123345,"_5":14474,"_27550":123258,"_2978":123346},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3496":72681,"_30262":72681,"_5":14825,"_2978":123348,"_30620":123349,"_21040":123350,"_27550":72681},"Modelo de confianza",[49507,118444,54983,123216],[],{"_3496":72682,"_30262":72681,"_21040":123352,"_5":14474,"_27550":72681,"_2978":123353},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3496":72683,"_30262":72681,"_5":30617,"_21040":123355,"_27550":123356,"_2978":123357},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3496":72684,"_30262":72681,"_5":30617,"_21040":123359,"_27550":123360,"_2978":123361},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3496":72685,"_30262":72681,"_5":30617,"_21040":123363,"_27550":123364,"_2978":123365},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3496":72686,"_30262":72681,"_5":30617,"_21040":123367,"_27550":123368,"_2978":123369},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3496":72687,"_30262":72681,"_5":30617,"_21040":123371,"_27550":123372,"_2978":123373},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3496":72688,"_30262":72681,"_5":30617,"_21040":123375,"_27550":123376,"_2978":123377},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3496":72689,"_30262":72681,"_5":30617,"_21040":123379,"_27550":123380,"_2978":123381},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3496":72690,"_30262":72681,"_5":30617,"_21040":123383,"_27550":123384,"_2978":123385},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3496":72691,"_30262":72681,"_5":30617,"_21040":123387,"_27550":123388,"_2978":123389},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3496":72692,"_30262":72681,"_5":30617,"_21040":123391,"_27550":123392,"_2978":123393},[],"/docs/pr-preview/pr-61/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3496":72693,"_30262":72681,"_21040":123395,"_5":14474,"_27550":72681,"_2978":123396},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3496":72694,"_30262":72681,"_21040":123398,"_5":14474,"_27550":123360,"_2978":123399},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3496":72695,"_30262":72681,"_21040":123401,"_5":14474,"_27550":123364,"_2978":123402},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3496":72696,"_30262":72681,"_21040":123404,"_5":14474,"_27550":123368,"_2978":123405},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3496":72697,"_30262":72681,"_21040":123407,"_5":14474,"_27550":123372,"_2978":123408},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3496":72698,"_30262":72681,"_21040":123410,"_5":14474,"_27550":123376,"_2978":123411},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3496":72699,"_30262":72681,"_21040":123413,"_5":14474,"_27550":123376,"_2978":123414},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3496":72700,"_30262":72681,"_21040":123416,"_5":14474,"_27550":123376,"_2978":123417},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3496":72701,"_30262":72681,"_21040":123419,"_5":14474,"_27550":123376,"_2978":123420},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3496":72702,"_30262":72681,"_21040":123422,"_5":14474,"_27550":123376,"_2978":123423},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3496":72703,"_30262":72681,"_21040":123425,"_5":14474,"_27550":123376,"_2978":123426},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3496":72704,"_30262":72681,"_21040":123428,"_5":14474,"_27550":123380,"_2978":123429},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3496":72705,"_30262":72681,"_21040":123431,"_5":14474,"_27550":123380,"_2978":123432},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3496":72706,"_30262":72681,"_21040":123434,"_5":14474,"_27550":123380,"_2978":123435},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3496":72707,"_30262":72681,"_21040":123437,"_5":14474,"_27550":123380,"_2978":123438},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3496":72708,"_30262":72681,"_21040":123440,"_5":14474,"_27550":123380,"_2978":123441},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3496":72709,"_30262":72681,"_21040":123443,"_5":14474,"_27550":123384,"_2978":123444},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3496":72710,"_30262":72681,"_21040":123446,"_5":14474,"_27550":123384,"_2978":123447},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3496":72711,"_30262":72681,"_21040":123449,"_5":14474,"_27550":123384,"_2978":123450},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3496":72712,"_30262":72681,"_21040":123452,"_5":14474,"_27550":123384,"_2978":123453},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3496":72713,"_30262":72681,"_21040":123455,"_5":14474,"_27550":123384,"_2978":123456},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3496":72714,"_30262":72681,"_21040":123458,"_5":14474,"_27550":123384,"_2978":123459},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3496":72715,"_30262":72681,"_21040":123461,"_5":14474,"_27550":123384,"_2978":123462},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3496":72716,"_30262":72681,"_21040":123464,"_5":14474,"_27550":123388,"_2978":123465},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3496":72717,"_30262":72681,"_21040":123467,"_5":14474,"_27550":123392,"_2978":123468},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3496":72718,"_30262":72681,"_21040":123470,"_5":14474,"_27550":123392,"_2978":123471},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3496":72719,"_30262":72681,"_21040":123473,"_5":14474,"_27550":123392,"_2978":123474},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3496":72720,"_30262":72681,"_21040":123476,"_5":14474,"_27550":123392,"_2978":123477},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3496":72721,"_30262":72681,"_21040":123479,"_5":14474,"_27550":123392,"_2978":123480},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3496":72722,"_30262":72681,"_21040":123482,"_5":14474,"_27550":123392,"_2978":123483},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3496":72723,"_30262":72681,"_21040":123485,"_5":14474,"_27550":123392,"_2978":123486},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3496":72724,"_30262":72724,"_5":14825,"_2978":123488,"_30620":123489,"_21040":123490,"_27550":72724},"Listas de revocación (CRL)",[49507,118444,54983,122962],[],{"_3496":72725,"_30262":72724,"_21040":123492,"_5":14474,"_27550":72724,"_2978":123493},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3496":72726,"_30262":72724,"_5":30617,"_21040":123495,"_27550":123496,"_2978":123497},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3496":72727,"_30262":72724,"_5":30617,"_21040":123499,"_27550":123500,"_2978":123501},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3496":72728,"_30262":72724,"_5":30617,"_21040":123503,"_27550":123504,"_2978":123505},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3496":72729,"_30262":72724,"_5":30617,"_21040":123507,"_27550":123508,"_2978":123509},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3496":72730,"_30262":72724,"_5":30617,"_21040":123511,"_27550":123512,"_2978":123513},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3496":72731,"_30262":72724,"_5":30617,"_21040":123515,"_27550":123516,"_2978":123517},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3496":72732,"_30262":72724,"_5":30617,"_21040":123519,"_27550":123520,"_2978":123521},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3496":72733,"_30262":72724,"_5":30617,"_21040":123523,"_27550":123524,"_2978":123525},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3496":72734,"_30262":72724,"_5":30617,"_21040":123527,"_27550":123528,"_2978":123529},[],"/docs/pr-preview/pr-61/es/platform/pki/crl#referencias","Referencias",{"_3496":72735,"_30262":72724,"_21040":123531,"_5":14474,"_27550":72724,"_2978":123532},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3496":72736,"_30262":72724,"_21040":123534,"_5":14474,"_27550":123496,"_2978":123535},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3496":72737,"_30262":72724,"_21040":123537,"_5":14474,"_27550":123496,"_2978":123538},[],"Campo",{"_3496":72738,"_30262":72724,"_21040":123540,"_5":14474,"_27550":123496,"_2978":119988},[],{"_3496":72739,"_30262":72724,"_21040":123542,"_5":14474,"_27550":123496,"_2978":56205},[],{"_3496":72740,"_30262":72724,"_21040":123544,"_5":14474,"_27550":123496,"_2978":123545},[],"ID de la CA a la que pertenecen los ajustes.",{"_3496":72741,"_30262":72724,"_21040":123547,"_5":14474,"_27550":123496,"_2978":56211},[],{"_3496":72742,"_30262":72724,"_21040":123549,"_5":14474,"_27550":123496,"_2978":123550},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3496":72743,"_30262":72724,"_21040":123552,"_5":14474,"_27550":123496,"_2978":56217},[],{"_3496":72744,"_30262":72724,"_21040":123554,"_5":14474,"_27550":123496,"_2978":123555},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3496":72745,"_30262":72724,"_21040":123557,"_5":14474,"_27550":123496,"_2978":56223},[],{"_3496":72746,"_30262":72724,"_21040":123559,"_5":14474,"_27550":123496,"_2978":123560},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3496":72747,"_30262":72724,"_21040":123562,"_5":14474,"_27550":123496,"_2978":123563},[],"Campo de `crl_options`",{"_3496":72748,"_30262":72724,"_21040":123565,"_5":14474,"_27550":123496,"_2978":119988},[],{"_3496":72749,"_30262":72724,"_21040":123567,"_5":14474,"_27550":123496,"_2978":123568},[],"Valor inicial",{"_3496":72750,"_30262":72724,"_21040":123570,"_5":14474,"_27550":123496,"_2978":56237},[],{"_3496":72751,"_30262":72724,"_21040":123572,"_5":14474,"_27550":123496,"_2978":123573},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3496":72752,"_30262":72724,"_21040":123575,"_5":14474,"_27550":123496,"_2978":123576},[],"7 días.",{"_3496":72753,"_30262":72724,"_21040":123578,"_5":14474,"_27550":123496,"_2978":56246},[],{"_3496":72754,"_30262":72724,"_21040":123580,"_5":14474,"_27550":123496,"_2978":123581},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3496":72755,"_30262":72724,"_21040":123583,"_5":14474,"_27550":123496,"_2978":123584},[],"6 días y 23 horas.",{"_3496":72756,"_30262":72724,"_21040":123586,"_5":14474,"_27550":123496,"_2978":56255},[],{"_3496":72757,"_30262":72724,"_21040":123588,"_5":14474,"_27550":123496,"_2978":123589},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3496":72758,"_30262":72724,"_21040":123591,"_5":14474,"_27550":123496,"_2978":56261},[],{"_3496":72759,"_30262":72724,"_21040":123593,"_5":14474,"_27550":123496,"_2978":56264},[],{"_3496":72760,"_30262":72724,"_21040":123595,"_5":14474,"_27550":123496,"_2978":123596},[],"Número de serie del certificado existente que firma la CRL.",{"_3496":72761,"_30262":72724,"_21040":123598,"_5":14474,"_27550":123496,"_2978":123599},[],"Número de serie del certificado actual de la CA.",{"_3496":72762,"_30262":72724,"_21040":123601,"_5":14474,"_27550":123496,"_2978":123602},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3496":72763,"_30262":72724,"_21040":123604,"_5":14474,"_27550":123496,"_2978":123605},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3496":72764,"_30262":72724,"_21040":123607,"_5":14474,"_27550":123496,"_2978":123608},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3496":72765,"_30262":72724,"_21040":123610,"_5":14474,"_27550":123496,"_2978":123611},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3496":72766,"_30262":72724,"_21040":123613,"_5":14474,"_27550":123496,"_2978":123614},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3496":72767,"_30262":72724,"_21040":123616,"_5":14474,"_27550":123496,"_2978":123617},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3496":72768,"_30262":72724,"_21040":123619,"_5":14474,"_27550":123496,"_2978":123620},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3496":72769,"_30262":72724,"_21040":123622,"_5":14474,"_27550":123496,"_2978":123623},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3496":72770,"_30262":72724,"_21040":123625,"_5":14474,"_27550":123496,"_2978":123626},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3496":72771,"_30262":72724,"_21040":123628,"_5":14474,"_27550":123496,"_2978":123629},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3496":72772,"_30262":72724,"_21040":123631,"_5":14474,"_27550":123500,"_2978":123632},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3496":72773,"_30262":72724,"_21040":123634,"_5":14474,"_27550":123500,"_2978":123635},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3496":72774,"_30262":72724,"_21040":123637,"_5":14474,"_27550":123500,"_2978":123638},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3496":72775,"_30262":72724,"_21040":123640,"_5":14474,"_27550":123500,"_2978":123641},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3496":72776,"_30262":72724,"_21040":123643,"_5":14474,"_27550":123504,"_2978":123644},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3496":72777,"_30262":72724,"_21040":123646,"_5":14474,"_27550":123504,"_2978":123647},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3496":72778,"_30262":72724,"_21040":123649,"_5":14474,"_27550":123504,"_2978":123650},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3496":72779,"_30262":72724,"_21040":123652,"_5":14474,"_27550":123504,"_2978":123653},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3496":72780,"_30262":72724,"_21040":123655,"_5":14474,"_27550":123504,"_2978":123656},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3496":72781,"_30262":72724,"_21040":123658,"_5":14474,"_27550":123504,"_2978":123659},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3496":72782,"_30262":72724,"_21040":123661,"_5":14474,"_27550":123504,"_2978":123662},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3496":72783,"_30262":72724,"_21040":123664,"_5":14474,"_27550":123504,"_2978":123665},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3496":72784,"_30262":72724,"_21040":123667,"_5":14474,"_27550":123504,"_2978":123668},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3496":72785,"_30262":72724,"_21040":123670,"_5":14474,"_27550":123508,"_2978":123671},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3496":72786,"_30262":72724,"_21040":123673,"_5":14474,"_27550":123508,"_2978":123674},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3496":72787,"_30262":72724,"_21040":123676,"_5":14474,"_27550":123512,"_2978":123677},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3496":72788,"_30262":72724,"_21040":123679,"_5":14474,"_27550":123512,"_2978":123680},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3496":72789,"_30262":72724,"_21040":123682,"_5":14474,"_27550":123512,"_2978":123683},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3496":72790,"_30262":72724,"_21040":123685,"_5":14474,"_27550":123512,"_2978":123686},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3496":72791,"_30262":72724,"_21040":123688,"_5":14474,"_27550":123512,"_2978":123689},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3496":72792,"_30262":72724,"_21040":123691,"_5":14474,"_27550":123516,"_2978":123692},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3496":72793,"_30262":72724,"_21040":123694,"_5":14474,"_27550":123516,"_2978":120177},[],{"_3496":72794,"_30262":72724,"_21040":123696,"_5":14474,"_27550":123516,"_2978":123697},[],"Path relativo",{"_3496":72795,"_30262":72724,"_21040":123699,"_5":14474,"_27550":123516,"_2978":118204},[],{"_3496":72796,"_30262":72724,"_21040":123701,"_5":14474,"_27550":123516,"_2978":56373},[],{"_3496":72797,"_30262":72724,"_21040":123703,"_5":14474,"_27550":123516,"_2978":56376},[],{"_3496":72798,"_30262":72724,"_21040":123705,"_5":14474,"_27550":123516,"_2978":123706},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3496":72799,"_30262":72724,"_21040":123708,"_5":14474,"_27550":123516,"_2978":56373},[],{"_3496":72800,"_30262":72724,"_21040":123710,"_5":14474,"_27550":123516,"_2978":56384},[],{"_3496":72801,"_30262":72724,"_21040":123712,"_5":14474,"_27550":123516,"_2978":123713},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3496":72802,"_30262":72724,"_21040":123715,"_5":14474,"_27550":123516,"_2978":56390},[],{"_3496":72803,"_30262":72724,"_21040":123717,"_5":14474,"_27550":123516,"_2978":56384},[],{"_3496":72804,"_30262":72724,"_21040":123719,"_5":14474,"_27550":123516,"_2978":123720},[],"Sustituir la configuración de CRL de una CA.",{"_3496":72805,"_30262":72724,"_21040":123722,"_5":14474,"_27550":123516,"_2978":123723},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3496":72806,"_30262":72724,"_21040":123725,"_5":14474,"_27550":123516,"_2978":123726},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3496":72807,"_30262":72724,"_21040":123728,"_5":14474,"_27550":123520,"_2978":123729},[],"Síntoma",{"_3496":72808,"_30262":72724,"_21040":123731,"_5":14474,"_27550":123520,"_2978":123732},[],"Causa",{"_3496":72809,"_30262":72724,"_21040":123734,"_5":14474,"_27550":123520,"_2978":123735},[],"Acción",{"_3496":72810,"_30262":72724,"_21040":123737,"_5":14474,"_27550":123520,"_2978":123738},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3496":72811,"_30262":72724,"_21040":123740,"_5":14474,"_27550":123520,"_2978":123741},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3496":72812,"_30262":72724,"_21040":123743,"_5":14474,"_27550":123520,"_2978":123744},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3496":72813,"_30262":72724,"_21040":123746,"_5":14474,"_27550":123520,"_2978":123747},[],"`PUT` devuelve 400.",{"_3496":72814,"_30262":72724,"_21040":123749,"_5":14474,"_27550":123520,"_2978":123750},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3496":72815,"_30262":72724,"_21040":123752,"_5":14474,"_27550":123520,"_2978":123753},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3496":72816,"_30262":72724,"_21040":123755,"_5":14474,"_27550":123520,"_2978":123756},[],"`PUT` devuelve 404.",{"_3496":72817,"_30262":72724,"_21040":123758,"_5":14474,"_27550":123520,"_2978":123759},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3496":72818,"_30262":72724,"_21040":123761,"_5":14474,"_27550":123520,"_2978":123762},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3496":72819,"_30262":72724,"_21040":123764,"_5":14474,"_27550":123520,"_2978":123765},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3496":72820,"_30262":72724,"_21040":123767,"_5":14474,"_27550":123520,"_2978":123768},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3496":72821,"_30262":72724,"_21040":123770,"_5":14474,"_27550":123520,"_2978":123771},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3496":72822,"_30262":72724,"_21040":123773,"_5":14474,"_27550":123520,"_2978":123774},[],"La CRL no cambia tras revocar un certificado.",{"_3496":72823,"_30262":72724,"_21040":123776,"_5":14474,"_27550":123520,"_2978":123777},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3496":72824,"_30262":72724,"_21040":123779,"_5":14474,"_27550":123520,"_2978":123780},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3496":72825,"_30262":72724,"_21040":123782,"_5":14474,"_27550":123520,"_2978":123783},[],"Un verificador rechaza la CRL por el emisor.",{"_3496":72826,"_30262":72724,"_21040":123785,"_5":14474,"_27550":123520,"_2978":123786},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3496":72827,"_30262":72724,"_21040":123788,"_5":14474,"_27550":123520,"_2978":123789},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3496":72828,"_30262":72724,"_21040":123791,"_5":14474,"_27550":123524,"_2978":123792},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3496":72829,"_30262":72724,"_21040":123794,"_5":14474,"_27550":123528,"_2978":123795},[],"RFC 5280: perfil X.509 y CRL.",{"_3496":72830,"_30262":72724,"_21040":123797,"_5":14474,"_27550":123528,"_2978":56473},[],{"_3496":72831,"_30262":72724,"_21040":123799,"_5":14474,"_27550":123528,"_2978":56476},[],{"_3496":72832,"_30262":72724,"_21040":123801,"_5":14474,"_27550":123528,"_2978":123802},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3496":72833,"_30262":72724,"_21040":123804,"_5":14474,"_27550":123528,"_2978":123805},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3496":72834,"_30262":72834,"_5":14825,"_2978":123807,"_30620":123808,"_21040":123809,"_27550":72834},"Claves y motores criptográficos",[49507,118444,54983,122325],[],{"_3496":72835,"_30262":72834,"_21040":123811,"_5":14474,"_27550":72834,"_2978":123812},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3496":72836,"_30262":72834,"_5":30617,"_21040":123814,"_27550":123815,"_2978":123816},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3496":72837,"_30262":72834,"_5":30617,"_21040":123818,"_27550":123819,"_2978":123820},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3496":72838,"_30262":72834,"_5":30617,"_21040":123822,"_27550":123823,"_2978":56501},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#file-system",{"_3496":72839,"_30262":72834,"_5":30617,"_21040":123825,"_27550":123826,"_2978":56505},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#hashicorp-vault",{"_3496":72840,"_30262":72834,"_5":30617,"_21040":123828,"_27550":123829,"_2978":56509},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#aws-secrets-manager",{"_3496":72841,"_30262":72834,"_5":30617,"_21040":123831,"_27550":123832,"_2978":56513},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#aws-kms",{"_3496":72842,"_30262":72834,"_5":30617,"_21040":123834,"_27550":123835,"_2978":56517},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#pkcs11",{"_3496":72843,"_30262":72834,"_5":30617,"_21040":123837,"_27550":123838,"_2978":56521},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#azure-key-vault",{"_3496":72844,"_30262":72834,"_5":30617,"_21040":123840,"_27550":123841,"_2978":123842},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3496":72845,"_30262":72834,"_5":30617,"_21040":123844,"_27550":123845,"_2978":123846},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3496":72846,"_30262":72834,"_5":30617,"_21040":123848,"_27550":123849,"_2978":123850},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3496":72847,"_30262":72834,"_5":30617,"_21040":123852,"_27550":123853,"_2978":123854},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3496":72848,"_30262":72834,"_5":30617,"_21040":123856,"_27550":123857,"_2978":123858},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3496":72849,"_30262":72834,"_5":30617,"_21040":123860,"_27550":123861,"_2978":123862},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3496":72850,"_30262":72834,"_5":30617,"_21040":123864,"_27550":123865,"_2978":123866},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3496":72851,"_30262":72834,"_5":30617,"_21040":123868,"_27550":123869,"_2978":56553},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#sign",{"_3496":72852,"_30262":72834,"_5":30617,"_21040":123871,"_27550":123872,"_2978":56557},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#verify",{"_3496":72853,"_30262":72834,"_5":30617,"_21040":123874,"_27550":123875,"_2978":123876},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3496":72854,"_30262":72834,"_5":30617,"_21040":123878,"_27550":123879,"_2978":123880},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3496":72855,"_30262":72834,"_5":30617,"_21040":123882,"_27550":123883,"_2978":123884},[],"/docs/pr-preview/pr-61/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3496":72856,"_30262":72834,"_21040":123886,"_5":14474,"_27550":72834,"_2978":123887},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3496":72857,"_30262":72834,"_21040":123889,"_5":14474,"_27550":72834,"_2978":123890},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3496":72858,"_30262":72834,"_21040":123892,"_5":14474,"_27550":123815,"_2978":123893},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3496":72859,"_30262":72834,"_21040":123895,"_5":14474,"_27550":123815,"_2978":123896},[],"En la práctica, permite:",{"_3496":72860,"_30262":72834,"_21040":123898,"_5":14474,"_27550":123815,"_2978":123899},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3496":72861,"_30262":72834,"_21040":123901,"_5":14474,"_27550":123815,"_2978":123902},[],"Importar claves creadas externamente.",{"_3496":72862,"_30262":72834,"_21040":123904,"_5":14474,"_27550":123815,"_2978":123905},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3496":72863,"_30262":72834,"_21040":123907,"_5":14474,"_27550":123815,"_2978":123908},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3496":72864,"_30262":72834,"_21040":123910,"_5":14474,"_27550":123819,"_2978":123911},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3496":72865,"_30262":72834,"_21040":123913,"_5":14474,"_27550":123819,"_2978":123914},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3496":72866,"_30262":72834,"_21040":123916,"_5":14474,"_27550":123819,"_2978":123917},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3496":72867,"_30262":72834,"_21040":123919,"_5":14474,"_27550":123823,"_2978":123920},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3496":72868,"_30262":72834,"_21040":123922,"_5":14474,"_27550":123826,"_2978":123923},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3496":72869,"_30262":72834,"_21040":123925,"_5":14474,"_27550":123826,"_2978":123926},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3496":72870,"_30262":72834,"_21040":123928,"_5":14474,"_27550":123829,"_2978":123929},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3496":72871,"_30262":72834,"_21040":123931,"_5":14474,"_27550":123832,"_2978":123932},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3496":72872,"_30262":72834,"_21040":123934,"_5":14474,"_27550":123835,"_2978":123935},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3496":72873,"_30262":72834,"_21040":123937,"_5":14474,"_27550":123838,"_2978":123938},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3496":72874,"_30262":72834,"_21040":123940,"_5":14474,"_27550":123838,"_2978":123941},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3496":72875,"_30262":72834,"_21040":123943,"_5":14474,"_27550":123838,"_2978":123944},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3496":72876,"_30262":72834,"_21040":123946,"_5":14474,"_27550":123838,"_2978":123947},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3496":72877,"_30262":72834,"_21040":123949,"_5":14474,"_27550":123841,"_2978":123950},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3496":72878,"_30262":72834,"_21040":123952,"_5":14474,"_27550":123841,"_2978":123953},[],"La tabla incluye los siguientes campos:",{"_3496":72879,"_30262":72834,"_21040":123955,"_5":14474,"_27550":123841,"_2978":123956},[],"**Name**: nombre descriptivo de la clave.",{"_3496":72880,"_30262":72834,"_21040":123958,"_5":14474,"_27550":123841,"_2978":123959},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3496":72881,"_30262":72834,"_21040":123961,"_5":14474,"_27550":123841,"_2978":123962},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3496":72882,"_30262":72834,"_21040":123964,"_5":14474,"_27550":123841,"_2978":123965},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3496":72883,"_30262":72834,"_21040":123967,"_5":14474,"_27550":123841,"_2978":123968},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3496":72884,"_30262":72834,"_21040":123970,"_5":14474,"_27550":123841,"_2978":123971},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3496":72885,"_30262":72834,"_21040":123973,"_5":14474,"_27550":123841,"_2978":123974},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3496":72886,"_30262":72834,"_21040":123976,"_5":14474,"_27550":123841,"_2978":123977},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3496":72887,"_30262":72834,"_21040":123979,"_5":14474,"_27550":123841,"_2978":123980},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3496":72888,"_30262":72834,"_21040":123982,"_5":14474,"_27550":123841,"_2978":123983},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3496":72889,"_30262":72834,"_21040":123985,"_5":14474,"_27550":123841,"_2978":123986},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3496":72890,"_30262":72834,"_21040":123988,"_5":14474,"_27550":123841,"_2978":123989},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3496":72891,"_30262":72834,"_21040":123991,"_5":14474,"_27550":123841,"_2978":123992},[],"**Delete Key** para eliminar la clave del sistema.",{"_3496":72892,"_30262":72834,"_21040":123994,"_5":14474,"_27550":123845,"_2978":123995},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3496":72893,"_30262":72834,"_21040":123997,"_5":14474,"_27550":123849,"_2978":123998},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3496":72894,"_30262":72834,"_21040":124000,"_5":14474,"_27550":123849,"_2978":124001},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3496":72895,"_30262":72834,"_21040":124003,"_5":14474,"_27550":123849,"_2978":124004},[],"**Key Name**: nombre único y descriptivo.",{"_3496":72896,"_30262":72834,"_21040":124006,"_5":14474,"_27550":123849,"_2978":124007},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3496":72897,"_30262":72834,"_21040":124009,"_5":14474,"_27550":123849,"_2978":124010},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3496":72898,"_30262":72834,"_21040":124012,"_5":14474,"_27550":123849,"_2978":124013},[],"**Tags**: metadatos para clasificar la clave.",{"_3496":72899,"_30262":72834,"_21040":124015,"_5":14474,"_27550":123849,"_2978":124016},[],"**Metadata**: información adicional para usos avanzados.",{"_3496":72900,"_30262":72834,"_21040":124018,"_5":14474,"_27550":123853,"_2978":124019},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3496":72901,"_30262":72834,"_21040":124021,"_5":14474,"_27550":123853,"_2978":124022},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3496":72902,"_30262":72834,"_21040":124024,"_5":14474,"_27550":123853,"_2978":124025},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3496":72903,"_30262":72834,"_21040":124027,"_5":14474,"_27550":123853,"_2978":124028},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3496":72904,"_30262":72834,"_21040":124030,"_5":14474,"_27550":123853,"_2978":124031},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3496":72905,"_30262":72834,"_21040":124033,"_5":14474,"_27550":123853,"_2978":124034},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3496":72906,"_30262":72834,"_21040":124036,"_5":14474,"_27550":123853,"_2978":124037},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3496":72907,"_30262":72834,"_21040":124039,"_5":14474,"_27550":123853,"_2978":124040},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3496":72908,"_30262":72834,"_21040":124042,"_5":14474,"_27550":123853,"_2978":124043},[],"**Metadata**: información adicional opcional.",{"_3496":72909,"_30262":72834,"_21040":124045,"_5":14474,"_27550":123853,"_2978":124046},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3496":72910,"_30262":72834,"_21040":124048,"_5":14474,"_27550":123853,"_2978":124049},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3496":72911,"_30262":72834,"_21040":124051,"_5":14474,"_27550":123857,"_2978":124052},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3496":72912,"_30262":72834,"_21040":124054,"_5":14474,"_27550":123861,"_2978":124055},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3496":72913,"_30262":72834,"_21040":124057,"_5":14474,"_27550":123861,"_2978":124058},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3496":72914,"_30262":72834,"_21040":124060,"_5":14474,"_27550":123861,"_2978":124061},[],"**Key Name**: nombre descriptivo.",{"_3496":72915,"_30262":72834,"_21040":124063,"_5":14474,"_27550":123861,"_2978":124064},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3496":72916,"_30262":72834,"_21040":124066,"_5":14474,"_27550":123861,"_2978":124067},[],"**Tags**: etiquetas asociadas.",{"_3496":72917,"_30262":72834,"_21040":124069,"_5":14474,"_27550":123861,"_2978":124070},[],"**Aliases**: nombres alternativos.",{"_3496":72918,"_30262":72834,"_21040":124072,"_5":14474,"_27550":123861,"_2978":124073},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3496":72919,"_30262":72834,"_21040":124075,"_5":14474,"_27550":123861,"_2978":124076},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3496":72920,"_30262":72834,"_21040":124078,"_5":14474,"_27550":123861,"_2978":124079},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3496":72921,"_30262":72834,"_21040":124081,"_5":14474,"_27550":123861,"_2978":124082},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3496":72922,"_30262":72834,"_21040":124084,"_5":14474,"_27550":123865,"_2978":124085},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3496":72923,"_30262":72834,"_21040":124087,"_5":14474,"_27550":123865,"_2978":124088},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3496":72924,"_30262":72834,"_21040":124090,"_5":14474,"_27550":123865,"_2978":124091},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3496":72925,"_30262":72834,"_21040":124093,"_5":14474,"_27550":123869,"_2978":124094},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3496":72926,"_30262":72834,"_21040":124096,"_5":14474,"_27550":123869,"_2978":124097},[],"Campos principales:",{"_3496":72927,"_30262":72834,"_21040":124099,"_5":14474,"_27550":123869,"_2978":124100},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3496":72928,"_30262":72834,"_21040":124102,"_5":14474,"_27550":123869,"_2978":124103},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3496":72929,"_30262":72834,"_21040":124105,"_5":14474,"_27550":123869,"_2978":124106},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3496":72930,"_30262":72834,"_21040":124108,"_5":14474,"_27550":123869,"_2978":124109},[],"**Message**: contenido que se va a firmar.",{"_3496":72931,"_30262":72834,"_21040":124111,"_5":14474,"_27550":123869,"_2978":124112},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3496":72932,"_30262":72834,"_21040":124114,"_5":14474,"_27550":123872,"_2978":124115},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3496":72933,"_30262":72834,"_21040":124117,"_5":14474,"_27550":123872,"_2978":124097},[],{"_3496":72934,"_30262":72834,"_21040":124119,"_5":14474,"_27550":123872,"_2978":124120},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3496":72935,"_30262":72834,"_21040":124122,"_5":14474,"_27550":123872,"_2978":124123},[],"**Message Type**: `Raw` o `Digest`.",{"_3496":72936,"_30262":72834,"_21040":124125,"_5":14474,"_27550":123872,"_2978":124126},[],"**Payload Encoding**: codificación del mensaje.",{"_3496":72937,"_30262":72834,"_21040":124128,"_5":14474,"_27550":123872,"_2978":124129},[],"**Message**: mensaje original o hash.",{"_3496":72938,"_30262":72834,"_21040":124131,"_5":14474,"_27550":123872,"_2978":124132},[],"**Signature**: firma que se desea comprobar.",{"_3496":72939,"_30262":72834,"_21040":124134,"_5":14474,"_27550":123872,"_2978":124135},[],"**Result**: indicador del resultado de la validación.",{"_3496":72940,"_30262":72834,"_21040":124137,"_5":14474,"_27550":123875,"_2978":124138},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3496":72941,"_30262":72834,"_21040":124140,"_5":14474,"_27550":123875,"_2978":124141},[],"Este flujo es útil para:",{"_3496":72942,"_30262":72834,"_21040":124143,"_5":14474,"_27550":123875,"_2978":124144},[],"Solicitar certificados a una CA externa.",{"_3496":72943,"_30262":72834,"_21040":124146,"_5":14474,"_27550":123875,"_2978":124147},[],"Renovar una identidad manteniendo la misma clave.",{"_3496":72944,"_30262":72834,"_21040":124149,"_5":14474,"_27550":123875,"_2978":124150},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3496":72945,"_30262":72834,"_21040":124152,"_5":14474,"_27550":123875,"_2978":124153},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3496":72946,"_30262":72834,"_21040":124155,"_5":14474,"_27550":123875,"_2978":124156},[],"**Organization (O)**: organización o empresa.",{"_3496":72947,"_30262":72834,"_21040":124158,"_5":14474,"_27550":123875,"_2978":124159},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3496":72948,"_30262":72834,"_21040":124161,"_5":14474,"_27550":123875,"_2978":124162},[],"**Country (C)**: código de país de dos letras.",{"_3496":72949,"_30262":72834,"_21040":124164,"_5":14474,"_27550":123875,"_2978":124165},[],"**State / Province (ST)**: estado o provincia.",{"_3496":72950,"_30262":72834,"_21040":124167,"_5":14474,"_27550":123875,"_2978":124168},[],"**Locality (L)**: ciudad o localidad.",{"_3496":72951,"_30262":72834,"_21040":124170,"_5":14474,"_27550":123875,"_2978":124171},[],"**Email Address**: correo de contacto.",{"_3496":72952,"_30262":72834,"_21040":124173,"_5":14474,"_27550":123875,"_2978":124174},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3496":72953,"_30262":72834,"_21040":124176,"_5":14474,"_27550":123875,"_2978":124177},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3496":72954,"_30262":72834,"_21040":124179,"_5":14474,"_27550":123879,"_2978":124180},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3496":72955,"_30262":72834,"_21040":124182,"_5":14474,"_27550":123879,"_2978":124183},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3496":72956,"_30262":72834,"_21040":124185,"_5":14474,"_27550":123883,"_2978":124186},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3496":72957,"_30262":72834,"_21040":124188,"_5":14474,"_27550":123883,"_2978":124189},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3496":72958,"_30262":72958,"_5":14825,"_2978":124191,"_30620":124192,"_21040":124193,"_27550":72958},"Validación online con OCSP",[49507,118444,54983,122962],[],{"_3496":72959,"_30262":72958,"_21040":124195,"_5":14474,"_27550":72958,"_2978":124196},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3496":72960,"_30262":72958,"_5":30617,"_21040":124198,"_27550":124199,"_2978":124200},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3496":72961,"_30262":72958,"_5":30617,"_21040":124202,"_27550":124203,"_2978":124204},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3496":72962,"_30262":72958,"_5":30617,"_21040":124206,"_27550":124207,"_2978":124208},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3496":72963,"_30262":72958,"_5":30617,"_21040":124210,"_27550":124211,"_2978":124212},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3496":72964,"_30262":72958,"_5":30617,"_21040":124214,"_27550":124215,"_2978":124216},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3496":72965,"_30262":72958,"_5":30617,"_21040":124218,"_27550":124219,"_2978":123529},[],"/docs/pr-preview/pr-61/es/platform/pki/ocsp#referencias",{"_3496":72966,"_30262":72958,"_21040":124221,"_5":14474,"_27550":72958,"_2978":124222},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3496":72967,"_30262":72958,"_21040":124224,"_5":14474,"_27550":124199,"_2978":124225},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3496":72968,"_30262":72958,"_21040":124227,"_5":14474,"_27550":124199,"_2978":124228},[],"Estado del registro",{"_3496":72969,"_30262":72958,"_21040":124230,"_5":14474,"_27550":124199,"_2978":124231},[],"Respuesta firmada",{"_3496":72970,"_30262":72958,"_21040":124233,"_5":14474,"_27550":124199,"_2978":54120},[],{"_3496":72971,"_30262":72958,"_21040":124235,"_5":14474,"_27550":124199,"_2978":56921},[],{"_3496":72972,"_30262":72958,"_21040":124237,"_5":14474,"_27550":124199,"_2978":54137},[],{"_3496":72973,"_30262":72958,"_21040":124239,"_5":14474,"_27550":124199,"_2978":124240},[],"`Revoked`, con razón y fecha de revocación.",{"_3496":72974,"_30262":72958,"_21040":124242,"_5":14474,"_27550":124199,"_2978":124243},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3496":72975,"_30262":72958,"_21040":124245,"_5":14474,"_27550":124199,"_2978":124246},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3496":72976,"_30262":72958,"_21040":124248,"_5":14474,"_27550":124199,"_2978":124249},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3496":72977,"_30262":72958,"_21040":124251,"_5":14474,"_27550":124199,"_2978":124252},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3496":72978,"_30262":72958,"_21040":124254,"_5":14474,"_27550":124199,"_2978":124255},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3496":72979,"_30262":72958,"_21040":124257,"_5":14474,"_27550":124203,"_2978":124258},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3496":72980,"_30262":72958,"_21040":124260,"_5":14474,"_27550":124203,"_2978":124261},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3496":72981,"_30262":72958,"_21040":124263,"_5":14474,"_27550":124207,"_2978":124264},[],"El servicio acepta:",{"_3496":72982,"_30262":72958,"_21040":124266,"_5":14474,"_27550":124207,"_2978":120177},[],{"_3496":72983,"_30262":72958,"_21040":124268,"_5":14474,"_27550":124207,"_2978":124269},[],"Ruta del servicio VA",{"_3496":72984,"_30262":72958,"_21040":124271,"_5":14474,"_27550":124207,"_2978":124272},[],"Formato",{"_3496":72985,"_30262":72958,"_21040":124274,"_5":14474,"_27550":124207,"_2978":56961},[],{"_3496":72986,"_30262":72958,"_21040":124276,"_5":14474,"_27550":124207,"_2978":56964},[],{"_3496":72987,"_30262":72958,"_21040":124278,"_5":14474,"_27550":124207,"_2978":124279},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3496":72988,"_30262":72958,"_21040":124281,"_5":14474,"_27550":124207,"_2978":56373},[],{"_3496":72989,"_30262":72958,"_21040":124283,"_5":14474,"_27550":124207,"_2978":56972},[],{"_3496":72990,"_30262":72958,"_21040":124285,"_5":14474,"_27550":124207,"_2978":124286},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3496":72991,"_30262":72958,"_21040":124288,"_5":14474,"_27550":124207,"_2978":124289},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3496":72992,"_30262":72958,"_21040":124291,"_5":14474,"_27550":124211,"_2978":124292},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3496":72993,"_30262":72958,"_21040":124294,"_5":14474,"_27550":124211,"_2978":124295},[],"Genera la solicitud:",{"_3496":72994,"_30262":72958,"_21040":124297,"_5":14474,"_27550":124211,"_2978":124298},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3496":72995,"_30262":72958,"_21040":124300,"_5":14474,"_27550":124211,"_2978":124301},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3496":72996,"_30262":72958,"_21040":124303,"_5":14474,"_27550":124211,"_2978":124304},[],"Verifica el DER recibido:",{"_3496":72997,"_30262":72958,"_21040":124306,"_5":14474,"_27550":124211,"_2978":124307},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3496":72998,"_30262":72958,"_21040":124309,"_5":14474,"_27550":124215,"_2978":124310},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3496":72999,"_30262":72958,"_21040":124312,"_5":14474,"_27550":124215,"_2978":124313},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3496":73000,"_30262":72958,"_21040":124315,"_5":14474,"_27550":124219,"_2978":57005},[],{"_3496":73001,"_30262":72958,"_21040":124317,"_5":14474,"_27550":124219,"_2978":57008},[],{"_3496":73002,"_30262":72958,"_21040":124319,"_5":14474,"_27550":124219,"_2978":124320},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3496":73003,"_30262":72958,"_21040":124322,"_5":14474,"_27550":124219,"_2978":123805},[],{"_3496":73004,"_30262":73004,"_5":14825,"_2978":54983,"_30620":124324,"_21040":124325,"_27550":73004},[49507,118444,54983],[],{"_3496":73005,"_30262":73004,"_21040":124327,"_5":14474,"_27550":73004,"_2978":124328},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3496":73006,"_30262":73004,"_5":30617,"_21040":124330,"_27550":124331,"_2978":121651},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#empieza-aquí",{"_3496":73007,"_30262":73004,"_5":30617,"_21040":124333,"_27550":124334,"_2978":124335},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3496":73008,"_30262":73004,"_5":30617,"_21040":124337,"_27550":124338,"_2978":122171},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#capacidades-principales",{"_3496":73009,"_30262":73004,"_5":30617,"_21040":124340,"_27550":124341,"_2978":122175},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3496":73010,"_30262":73004,"_5":30617,"_21040":124343,"_27550":124344,"_2978":122179},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3496":73011,"_30262":73004,"_5":30617,"_21040":124346,"_27550":124347,"_2978":122183},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#emite-y-controla-certificados",{"_3496":73012,"_30262":73004,"_5":30617,"_21040":124349,"_27550":124350,"_2978":122191},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#publica-el-estado-de-validación",{"_3496":73013,"_30262":73004,"_5":30617,"_21040":124352,"_27550":124353,"_2978":124354},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3496":73014,"_30262":73004,"_5":30617,"_21040":124356,"_27550":124357,"_2978":123128},[],"/docs/pr-preview/pr-61/es/platform/pki/overview#continúa",{"_3496":73015,"_30262":73004,"_21040":124359,"_5":14474,"_27550":73004,"_2978":124360},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3496":73016,"_30262":73004,"_21040":124362,"_5":14474,"_27550":124331,"_2978":124363},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3496":73017,"_30262":73004,"_21040":124365,"_5":14474,"_27550":124331,"_2978":124366},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3496":73018,"_30262":73004,"_21040":124368,"_5":14474,"_27550":124334,"_2978":124369},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3496":73019,"_30262":73004,"_21040":124371,"_5":14474,"_27550":124334,"_2978":124372},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3496":73020,"_30262":73004,"_21040":124374,"_5":14474,"_27550":124334,"_2978":124375},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3496":73021,"_30262":73004,"_21040":124377,"_5":14474,"_27550":124334,"_2978":124378},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3496":73022,"_30262":73004,"_21040":124380,"_5":14474,"_27550":124334,"_2978":124381},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3496":73023,"_30262":73004,"_21040":124383,"_5":14474,"_27550":124341,"_2978":124384},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3496":73024,"_30262":73004,"_21040":124386,"_5":14474,"_27550":124344,"_2978":124387},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3496":73025,"_30262":73004,"_21040":124389,"_5":14474,"_27550":124347,"_2978":124390},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3496":73026,"_30262":73004,"_21040":124392,"_5":14474,"_27550":124350,"_2978":124393},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3496":73027,"_30262":73004,"_21040":124395,"_5":14474,"_27550":124353,"_2978":124396},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3496":73028,"_30262":73004,"_21040":124398,"_5":14474,"_27550":124353,"_2978":124399},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3496":73029,"_30262":73004,"_21040":124401,"_5":14474,"_27550":124353,"_2978":124402},[],"su clave pública corresponda a la clave privada del cliente;",{"_3496":73030,"_30262":73004,"_21040":124404,"_5":14474,"_27550":124353,"_2978":124405},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3496":73031,"_30262":73004,"_21040":124407,"_5":14474,"_27550":124353,"_2978":124408},[],"sus fechas y usos permitan la operación;",{"_3496":73032,"_30262":73004,"_21040":124410,"_5":14474,"_27550":124353,"_2978":124411},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3496":73033,"_30262":73004,"_21040":124413,"_5":14474,"_27550":124353,"_2978":124414},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3496":73034,"_30262":73004,"_21040":124416,"_5":14474,"_27550":124357,"_2978":124417},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3496":73035,"_30262":73004,"_21040":124419,"_5":14474,"_27550":124357,"_2978":124420},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3496":73036,"_30262":73004,"_21040":124422,"_5":14474,"_27550":124357,"_2978":124423},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3496":73037,"_30262":73037,"_5":14825,"_2978":124425,"_30620":124426,"_21040":124427,"_27550":73037},"Crea tu primera CA",[49507,118444,54983,121775],[],{"_3496":73038,"_30262":73037,"_21040":124429,"_5":14474,"_27550":73037,"_2978":124430},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3496":73039,"_30262":73037,"_5":30617,"_21040":124432,"_27550":124433,"_2978":117022},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3496":73040,"_30262":73037,"_5":30617,"_21040":124435,"_27550":124436,"_2978":124437},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#crea-la-autoridad","Crea la autoridad",{"_3496":73041,"_30262":73037,"_5":30617,"_21040":124439,"_27550":124440,"_2978":124441},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3496":73042,"_30262":73037,"_5":30617,"_21040":124443,"_27550":124444,"_2978":122022},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3496":73043,"_30262":73037,"_5":30617,"_21040":124446,"_27550":124447,"_2978":117046},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3496":73044,"_30262":73037,"_21040":124449,"_5":14474,"_27550":73037,"_2978":124450},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3496":73045,"_30262":73037,"_21040":124452,"_5":14474,"_27550":124433,"_2978":124453},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3496":73046,"_30262":73037,"_21040":124455,"_5":14474,"_27550":124433,"_2978":124456},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3496":73047,"_30262":73037,"_21040":124458,"_5":14474,"_27550":124433,"_2978":124459},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3496":73048,"_30262":73037,"_21040":124461,"_5":14474,"_27550":124433,"_2978":124462},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3496":73049,"_30262":73037,"_21040":124464,"_5":14474,"_27550":124436,"_2978":124465},[],"Sigue el recorrido interactivo para crear una CA raíz con una clave ECDSA P-384 nueva, un sujeto de ejemplo y un perfil de emisión para certificados de cliente. La disponibilidad y la vigencia de los perfiles dependen del entorno; elige valores adecuados para tu CA.",{"_3496":73050,"_30262":73037,"_21040":124467,"_5":14474,"_27550":124436,"_2978":124468},[],"El ejemplo define **CA Name** como `Acme Showcase Root CA`, que se convierte en el Common Name (CN) del subject. También completa los campos opcionales &#x2A;*Country (C)** con `ES` y &#x2A;*Organization (O)** con `Acme`; utiliza los valores que correspondan a tu autoridad.",{"_3496":73051,"_30262":73037,"_21040":124470,"_5":14474,"_27550":124436,"_2978":124471},[],"Abre la nueva CA y selecciona **Certificate PEM**. Descarga o copia su certificado público en `ca.pem`, incluyendo el bloque completo entre `BEGIN CERTIFICATE` y `END CERTIFICATE`. La clave privada permanece en el motor configurado. Para reutilizar una clave existente, consulta la guía de autoridades.",{"_3496":73052,"_30262":73037,"_21040":124473,"_5":14474,"_27550":124440,"_2978":124474},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3496":73053,"_30262":73037,"_21040":124476,"_5":14474,"_27550":124440,"_2978":124477},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3496":73054,"_30262":73037,"_21040":124479,"_5":14474,"_27550":124440,"_2978":124480},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3496":73055,"_30262":73037,"_21040":124482,"_5":14474,"_27550":124444,"_2978":124483},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3496":73056,"_30262":73037,"_21040":124485,"_5":14474,"_27550":124444,"_2978":124486},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3496":73057,"_30262":73037,"_21040":124488,"_5":14474,"_27550":124444,"_2978":124489},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3496":73058,"_30262":73037,"_21040":124491,"_5":14474,"_27550":124444,"_2978":124492},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3496":73059,"_30262":73037,"_21040":124494,"_5":14474,"_27550":124447,"_2978":124495},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3496":73060,"_30262":73060,"_5":14825,"_2978":124497,"_30620":124498,"_21040":124499,"_27550":73060},"Emite y verifica un certificado",[49507,118444,54983,121775],[],{"_3496":73061,"_30262":73060,"_21040":124501,"_5":14474,"_27550":73060,"_2978":124502},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3496":73062,"_30262":73060,"_5":30617,"_21040":124504,"_27550":124505,"_2978":117022},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3496":73063,"_30262":73060,"_5":30617,"_21040":124507,"_27550":124508,"_2978":124509},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3496":73064,"_30262":73060,"_5":30617,"_21040":124511,"_27550":124512,"_2978":124513},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3496":73065,"_30262":73060,"_5":30617,"_21040":124515,"_27550":124516,"_2978":124517},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3496":73066,"_30262":73060,"_5":30617,"_21040":124519,"_27550":124520,"_2978":124521},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3496":73067,"_30262":73060,"_5":30617,"_21040":124523,"_27550":124524,"_2978":124525},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3496":73068,"_30262":73060,"_5":30617,"_21040":124527,"_27550":124528,"_2978":124529},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3496":73069,"_30262":73060,"_5":30617,"_21040":124531,"_27550":124532,"_2978":124533},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3496":73070,"_30262":73060,"_5":30617,"_21040":124535,"_27550":124536,"_2978":124537},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3496":73071,"_30262":73060,"_5":30617,"_21040":124539,"_27550":124540,"_2978":124541},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3496":73072,"_30262":73060,"_5":30617,"_21040":124543,"_27550":124544,"_2978":122022},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3496":73073,"_30262":73060,"_5":30617,"_21040":124546,"_27550":124547,"_2978":117046},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3496":73074,"_30262":73060,"_21040":124549,"_5":14474,"_27550":73060,"_2978":124550},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3496":73075,"_30262":73060,"_21040":124552,"_5":14474,"_27550":124505,"_2978":124553},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3496":73076,"_30262":73060,"_21040":124555,"_5":14474,"_27550":124505,"_2978":124556},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3496":73077,"_30262":73060,"_21040":124558,"_5":14474,"_27550":124505,"_2978":124559},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3496":73078,"_30262":73060,"_21040":124561,"_5":14474,"_27550":124505,"_2978":124562},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3496":73079,"_30262":73060,"_21040":124564,"_5":14474,"_27550":124505,"_2978":124565},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3496":73080,"_30262":73060,"_21040":124567,"_5":14474,"_27550":124508,"_2978":124568},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3496":73081,"_30262":73060,"_21040":124570,"_5":14474,"_27550":124512,"_2978":124571},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3496":73082,"_30262":73060,"_21040":124573,"_5":14474,"_27550":124512,"_2978":124574},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3496":73083,"_30262":73060,"_21040":124576,"_5":14474,"_27550":124516,"_2978":124577},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3496":73084,"_30262":73060,"_21040":124579,"_5":14474,"_27550":124516,"_2978":124580},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3496":73085,"_30262":73060,"_21040":124582,"_5":14474,"_27550":124520,"_2978":124583},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3496":73086,"_30262":73060,"_21040":124585,"_5":14474,"_27550":124520,"_2978":124586},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3496":73087,"_30262":73060,"_21040":124588,"_5":14474,"_27550":124524,"_2978":124589},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3496":73088,"_30262":73060,"_21040":124591,"_5":14474,"_27550":124528,"_2978":124592},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3496":73089,"_30262":73060,"_21040":124594,"_5":14474,"_27550":124532,"_2978":124595},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3496":73090,"_30262":73060,"_21040":124597,"_5":14474,"_27550":124536,"_2978":124598},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3496":73091,"_30262":73060,"_21040":124600,"_5":14474,"_27550":124536,"_2978":124601},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3496":73092,"_30262":73060,"_21040":124603,"_5":14474,"_27550":124536,"_2978":124604},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3496":73093,"_30262":73060,"_21040":124606,"_5":14474,"_27550":124540,"_2978":124607},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3496":73094,"_30262":73060,"_21040":124609,"_5":14474,"_27550":124540,"_2978":124610},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3496":73095,"_30262":73060,"_21040":124612,"_5":14474,"_27550":124540,"_2978":124613},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3496":73096,"_30262":73060,"_21040":124615,"_5":14474,"_27550":124544,"_2978":122105},[],{"_3496":73097,"_30262":73060,"_21040":124617,"_5":14474,"_27550":124544,"_2978":120626},[],{"_3496":73098,"_30262":73060,"_21040":124619,"_5":14474,"_27550":124544,"_2978":124620},[],"La CA rechaza la emisión",{"_3496":73099,"_30262":73060,"_21040":124622,"_5":14474,"_27550":124544,"_2978":124623},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3496":73100,"_30262":73060,"_21040":124625,"_5":14474,"_27550":124544,"_2978":124626},[],"Sujeto o usos diferentes",{"_3496":73101,"_30262":73060,"_21040":124628,"_5":14474,"_27550":124544,"_2978":124629},[],"Perfil aplicado y valores solicitados.",{"_3496":73102,"_30262":73060,"_21040":124631,"_5":14474,"_27550":124544,"_2978":124632},[],"No se encuentra el emisor",{"_3496":73103,"_30262":73060,"_21040":124634,"_5":14474,"_27550":124544,"_2978":124635},[],"CA descargada y cadena intermedia necesaria.",{"_3496":73104,"_30262":73060,"_21040":124637,"_5":14474,"_27550":124544,"_2978":124638},[],"Falla la vigencia",{"_3496":73105,"_30262":73060,"_21040":124640,"_5":14474,"_27550":124544,"_2978":124641},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3496":73106,"_30262":73060,"_21040":124643,"_5":14474,"_27550":124544,"_2978":124644},[],"Los resúmenes de clave difieren",{"_3496":73107,"_30262":73060,"_21040":124646,"_5":14474,"_27550":124544,"_2978":124647},[],"Archivos de certificado y clave de la misma emisión.",{"_3496":73108,"_30262":73060,"_21040":124649,"_5":14474,"_27550":124544,"_2978":124650},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3496":73109,"_30262":73060,"_21040":124652,"_5":14474,"_27550":124547,"_2978":124653},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3496":73110,"_30262":73060,"_21040":124655,"_5":14474,"_27550":124547,"_2978":124656},[],"Gestionar certificados para inspección, estado y revocación.",{"_3496":73111,"_30262":73060,"_21040":124658,"_5":14474,"_27550":124547,"_2978":124659},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3496":73112,"_30262":73060,"_21040":124661,"_5":14474,"_27550":124547,"_2978":124662},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3496":73113,"_30262":73060,"_21040":124664,"_5":14474,"_27550":124547,"_2978":124665},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3496":73114,"_30262":73114,"_5":14825,"_2978":124667,"_30620":124668,"_21040":124669,"_27550":73114},"Primeros pasos de PKI",[49507,118444,54983,121775],[],{"_3496":73115,"_30262":73114,"_21040":124671,"_5":14474,"_27550":73114,"_2978":124672},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3496":73116,"_30262":73114,"_5":30617,"_21040":124674,"_27550":124675,"_2978":117022},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3496":73117,"_30262":73114,"_5":30617,"_21040":124677,"_27550":124678,"_2978":124679},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3496":73118,"_30262":73114,"_5":30617,"_21040":124681,"_27550":124682,"_2978":121957},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3496":73119,"_30262":73114,"_5":30617,"_21040":124684,"_27550":124685,"_2978":124686},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3496":73120,"_30262":73114,"_21040":124688,"_5":14474,"_27550":73114,"_2978":124689},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3496":73121,"_30262":73114,"_21040":124691,"_5":14474,"_27550":124675,"_2978":124692},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3496":73122,"_30262":73114,"_21040":124694,"_5":14474,"_27550":124675,"_2978":124695},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3496":73123,"_30262":73114,"_21040":124697,"_5":14474,"_27550":124675,"_2978":124698},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3496":73124,"_30262":73114,"_21040":124700,"_5":14474,"_27550":124675,"_2978":124701},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3496":73125,"_30262":73114,"_21040":124703,"_5":14474,"_27550":124675,"_2978":124704},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3496":73126,"_30262":73114,"_21040":124706,"_5":14474,"_27550":124678,"_2978":124707},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3496":73127,"_30262":73114,"_21040":124709,"_5":14474,"_27550":124678,"_2978":124710},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3496":73128,"_30262":73114,"_21040":124712,"_5":14474,"_27550":124678,"_2978":124713},[],"<Card title=\"3. Revoca un certificado y comprueba la CRL\" description=\"Revoca device-042 entre 100 certificados emitidos y confirma que aparece en la CRL de la CA.\" href=\"/docs/platform/pki/quickstarts/revoke-certificate\" />",{"_3496":73129,"_30262":73114,"_21040":124715,"_5":14474,"_27550":124678,"_2978":124716},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3496":73130,"_30262":73114,"_21040":124718,"_5":14474,"_27550":124678,"_2978":124719},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3496":73131,"_30262":73114,"_21040":124721,"_5":14474,"_27550":124682,"_2978":124722},[],"Archivo o recurso",{"_3496":73132,"_30262":73114,"_21040":124724,"_5":14474,"_27550":124682,"_2978":121954},[],{"_3496":73133,"_30262":73114,"_21040":124726,"_5":14474,"_27550":124682,"_2978":124727},[],"CA raíz activa y `ca.pem`",{"_3496":73134,"_30262":73114,"_21040":124729,"_5":14474,"_27550":124682,"_2978":124730},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3496":73135,"_30262":73114,"_21040":124732,"_5":14474,"_27550":124682,"_2978":124733},[],"Certificado final y `device.crt`",{"_3496":73136,"_30262":73114,"_21040":124735,"_5":14474,"_27550":124682,"_2978":124736},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3496":73137,"_30262":73114,"_21040":124738,"_5":14474,"_27550":124682,"_2978":124739},[],"Clave privada `device.key`",{"_3496":73138,"_30262":73114,"_21040":124741,"_5":14474,"_27550":124682,"_2978":124742},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3496":73139,"_30262":73114,"_21040":124744,"_5":14474,"_27550":124682,"_2978":124745},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3496":73140,"_30262":73114,"_21040":124747,"_5":14474,"_27550":124685,"_2978":124748},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3496":73141,"_30262":73114,"_21040":124750,"_5":14474,"_27550":124685,"_2978":124751},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3496":73142,"_30262":73114,"_21040":124753,"_5":14474,"_27550":124685,"_2978":124754},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3496":73143,"_30262":73143,"_5":14825,"_2978":124756,"_30620":124757,"_21040":124758,"_27550":73143},"Revoca un certificado y comprueba la CRL",[49507,118444,54983,121775],[],{"_3496":73144,"_30262":73143,"_21040":124760,"_5":14474,"_27550":73143,"_2978":124761},[],"Revoca un certificado entre los muchos emitidos por una CA y confirma que su CRL lo incluye.",{"_3496":73145,"_30262":73143,"_5":30617,"_21040":124763,"_27550":124764,"_2978":117022},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#antes-de-empezar",{"_3496":73146,"_30262":73143,"_5":30617,"_21040":124766,"_27550":124767,"_2978":124768},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#revoca-el-certificado","Revoca el certificado",{"_3496":73147,"_30262":73143,"_5":30617,"_21040":124770,"_27550":124771,"_2978":124772},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#localiza-el-certificado","Localiza el certificado",{"_3496":73148,"_30262":73143,"_5":30617,"_21040":124774,"_27550":124775,"_2978":124776},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#revócalo","Revócalo",{"_3496":73149,"_30262":73143,"_5":30617,"_21040":124778,"_27550":124779,"_2978":124780},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#confirma-y-lee-el-estado","Confirma y lee el estado",{"_3496":73150,"_30262":73143,"_5":30617,"_21040":124782,"_27550":124783,"_2978":123100},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#descarga-el-certificado",{"_3496":73151,"_30262":73143,"_5":30617,"_21040":124785,"_27550":124786,"_2978":124787},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#comprueba-la-crl","Comprueba la CRL",{"_3496":73152,"_30262":73143,"_5":30617,"_21040":124789,"_27550":124790,"_2978":124791},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#verifica-con-la-lista","Verifica con la lista",{"_3496":73153,"_30262":73143,"_5":30617,"_21040":124793,"_27550":124794,"_2978":122022},[],"/docs/pr-preview/pr-61/es/platform/pki/quickstarts/revoke-certificate#si-el-resultado-falla",{"_3496":73154,"_30262":73143,"_21040":124796,"_5":14474,"_27550":73143,"_2978":124797},[],"Revocarás el certificado de `device-042`, uno de los 100 certificados emitidos por la CA, y después comprobarás que la lista de revocación (CRL) de la CA lo incluye mientras los demás certificados siguen siendo válidos. Al terminar tendrás un certificado revocado en Lamassu y una CRL descargada que recoge su número de serie y el motivo.",{"_3496":73155,"_30262":73143,"_21040":124799,"_5":14474,"_27550":124764,"_2978":124800},[],"Una CA con certificados emitidos y permisos para cambiar su estado. El ejemplo utiliza `Acme Showcase Root CA`, de Crea tu primera CA, con los 100 certificados de cliente `device-001` a `device-100`. Con menos certificados el procedimiento es el mismo.",{"_3496":73156,"_30262":73143,"_21040":124802,"_5":14474,"_27550":124764,"_2978":124803},[],"El certificado público de la CA en `ca.pem`, tal como se guardó en el primer recorrido.",{"_3496":73157,"_30262":73143,"_21040":124805,"_5":14474,"_27550":124764,"_2978":124806},[],"OpenSSL 3.x y `curl` en un equipo con acceso al endpoint de la CRL.",{"_3496":73158,"_30262":73143,"_21040":124808,"_5":14474,"_27550":124764,"_2978":124809},[],"Solo `CertificateHold` puede deshacerse más adelante. Cualquier otro motivo es final, así que usa un certificado de evaluación en este recorrido. Antes de revocar en producción, identifica los consumidores de la identidad y prepara un reemplazo.",{"_3496":73159,"_30262":73143,"_21040":124811,"_5":14474,"_27550":124767,"_2978":124812},[],"Sigue el recorrido interactivo. Abre la CA emisora, filtra sus **Issued Certificates** por Common Name para localizar `device-042` entre los 100 y lo revoca con el motivo `KeyCompromise`.",{"_3496":73160,"_30262":73143,"_21040":124814,"_5":14474,"_27550":124767,"_2978":124815},[],"En la consola, los pasos son:",{"_3496":73161,"_30262":73143,"_21040":124817,"_5":14474,"_27550":124771,"_2978":124818},[],"Abre **Certification Authorities**, selecciona la CA emisora y entra en **Issued Certificates**. Busca `device-042` por `Common Name`. El certificado de la propia CA aparece también en esta pestaña; no los confundas.",{"_3496":73162,"_30262":73143,"_21040":124820,"_5":14474,"_27550":124775,"_2978":124821},[],"Abre el menú **More actions** de la fila encontrada y selecciona **Revoke Certificate**. En el diálogo de confirmación, elige el **Revocation Reason** que describa el incidente. Este ejemplo usa `KeyCompromise`, porque se considera que la clave del dispositivo está expuesta. Usa `CertificateHold` solo para una suspensión reversible.",{"_3496":73163,"_30262":73143,"_21040":124823,"_5":14474,"_27550":124779,"_2978":124824},[],"Selecciona **Confirm Revocation**. La fila pasa a `REVOKED` y muestra el motivo y la hora de revocación. Si necesitas verificarlo más tarde, vuelve a leer el registro en lugar de fiarte del diálogo.",{"_3496":73164,"_30262":73143,"_21040":124826,"_5":14474,"_27550":124779,"_2978":124827},[],"La revocación no elimina el certificado ni su clave, y no cierra las sesiones ya establecidas. Consulta Certificados para conocer los motivos y sus consecuencias.",{"_3496":73165,"_30262":73143,"_21040":124829,"_5":14474,"_27550":124783,"_2978":124830},[],"Desde el mismo menú **More actions**, selecciona **Download PEM** y guarda el archivo como `device-042.crt`. Anota su número de serie y el punto de distribución de CRL (CDP) que incluye:",{"_3496":73166,"_30262":73143,"_21040":124832,"_5":14474,"_27550":124783,"_2978":124833},[],"La URL termina con el ID de la **CA emisora**, no con el ID ni el número de serie del certificado. Tu número de serie será distinto del mostrado.",{"_3496":73167,"_30262":73143,"_21040":124835,"_5":14474,"_27550":124786,"_2978":124836},[],"Lamassu regenera la CRL de la CA cuando se revoca un certificado, siempre que `regenerate_on_revoke` esté activado, como ocurre por defecto. El endpoint es público y no requiere autenticación. Sustituye la URL por el CDP de tu certificado y descarga la lista:",{"_3496":73168,"_30262":73143,"_21040":124838,"_5":14474,"_27550":124786,"_2978":124839},[],"Comprueba que la lista está firmada por tu CA, está vigente y contiene el número de serie:",{"_3496":73169,"_30262":73143,"_21040":124841,"_5":14474,"_27550":124786,"_2978":124842},[],"Debe aparecer `verify OK`, el emisor esperado, un `lastUpdate` no anterior a la revocación y una entrada con el número de serie de `device-042` y el motivo `Key Compromise`; la lista recoge también cualquier otro certificado que esta CA hubiera revocado antes. Si el número de CRL es el mismo que antes de revocar, la lista todavía no se ha regenerado.",{"_3496":73170,"_30262":73143,"_21040":124844,"_5":14474,"_27550":124790,"_2978":124845},[],"`openssl verify` puede aplicar la lista descargada a un certificado. El certificado revocado debe rechazarse y cualquier otro certificado de la misma CA debe seguir superando la comprobación. Para `device-001`, descarga su PEM del mismo modo y guárdalo como `device-001.crt`:",{"_3496":73171,"_30262":73143,"_21040":124847,"_5":14474,"_27550":124790,"_2978":124848},[],"Esta comprobación usa tu copia local de la lista: no descarga listas más recientes ni demuestra que todos los clientes hayan refrescado la suya. Para consultar el estado en línea, consulta OCSP.",{"_3496":73172,"_30262":73143,"_21040":124850,"_5":14474,"_27550":124794,"_2978":122105},[],{"_3496":73173,"_30262":73143,"_21040":124852,"_5":14474,"_27550":124794,"_2978":120626},[],{"_3496":73174,"_30262":73143,"_21040":124854,"_5":14474,"_27550":124794,"_2978":124855},[],"**Revoke Certificate** no está disponible",{"_3496":73175,"_30262":73143,"_21040":124857,"_5":14474,"_27550":124794,"_2978":124858},[],"El certificado ya está `REVOKED` por un motivo final o está `EXPIRED`.",{"_3496":73176,"_30262":73143,"_21040":124860,"_5":14474,"_27550":124794,"_2978":124861},[],"La descarga de la CRL devuelve 404",{"_3496":73177,"_30262":73143,"_21040":124863,"_5":14474,"_27550":124794,"_2978":124864},[],"El ID de la URL no es el de la CA emisora: usa el CDP del certificado.",{"_3496":73178,"_30262":73143,"_21040":124866,"_5":14474,"_27550":124794,"_2978":124867},[],"`verify OK` no aparece",{"_3496":73179,"_30262":73143,"_21040":124869,"_5":14474,"_27550":124794,"_2978":124870},[],"`ca.pem` no es el certificado de la CA que firmó la lista.",{"_3496":73180,"_30262":73143,"_21040":124872,"_5":14474,"_27550":124794,"_2978":124873},[],"El serial no está en la lista",{"_3496":73181,"_30262":73143,"_21040":124875,"_5":14474,"_27550":124794,"_2978":124876},[],"La lista se descargó antes de la revocación o su regeneración falló. Consulta los errores de configuración de CRL.",{"_3496":73182,"_30262":73143,"_21040":124878,"_5":14474,"_27550":124794,"_2978":124879},[],"`device-001` también se rechaza",{"_3496":73183,"_30262":73143,"_21040":124881,"_5":14474,"_27550":124794,"_2978":124882},[],"El certificado fue revocado o `ca.pem` no corresponde a su emisor.",{"_3496":73184,"_30262":73143,"_21040":124884,"_5":14474,"_27550":124794,"_2978":124885},[],"<Card title=\"Gestionar certificados\" description=\"Motivos, suspensiones y reactivación.\" href=\"/docs/platform/pki/certificates\" />",{"_3496":73185,"_30262":73143,"_21040":124887,"_5":14474,"_27550":124794,"_2978":124888},[],"<Card title=\"Listas de revocación (CRL)\" description=\"Configuración, regeneración y publicación.\" href=\"/docs/platform/pki/crl\" />",{"_3496":73186,"_30262":73143,"_21040":124890,"_5":14474,"_27550":124794,"_2978":124891},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3496":73187,"_30262":73187,"_5":14825,"_2978":124893,"_30620":124894,"_21040":124896,"_27550":73187},"Resolución de problemas PKI",[49507,118444,54983,124895],"Resolución de problemas",[],{"_3496":73188,"_30262":73187,"_21040":124898,"_5":14474,"_27550":73187,"_2978":124899},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3496":73189,"_30262":73187,"_5":30617,"_21040":124901,"_27550":124902,"_2978":124903},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3496":73190,"_30262":73187,"_5":30617,"_21040":124905,"_27550":124906,"_2978":124907},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3496":73191,"_30262":73187,"_5":30617,"_21040":124909,"_27550":124910,"_2978":124911},[],"/docs/pr-preview/pr-61/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3496":73192,"_30262":73187,"_21040":124913,"_5":14474,"_27550":73187,"_2978":124914},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3496":73193,"_30262":73187,"_21040":124916,"_5":14474,"_27550":73187,"_2978":124917},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3496":73194,"_30262":73187,"_21040":124919,"_5":14474,"_27550":124902,"_2978":121954},[],{"_3496":73195,"_30262":73187,"_21040":124921,"_5":14474,"_27550":124902,"_2978":120626},[],{"_3496":73196,"_30262":73187,"_21040":124923,"_5":14474,"_27550":124902,"_2978":117046},[],{"_3496":73197,"_30262":73187,"_21040":124925,"_5":14474,"_27550":124902,"_2978":53825},[],{"_3496":73198,"_30262":73187,"_21040":124927,"_5":14474,"_27550":124902,"_2978":124928},[],"Existe, está activa y sus fechas son utilizables.",{"_3496":73199,"_30262":73187,"_21040":124930,"_5":14474,"_27550":124902,"_2978":124931},[],"Autoridades.",{"_3496":73200,"_30262":73187,"_21040":124933,"_5":14474,"_27550":124902,"_2978":124934},[],"Clave",{"_3496":73201,"_30262":73187,"_21040":124936,"_5":14474,"_27550":124902,"_2978":124937},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3496":73202,"_30262":73187,"_21040":124939,"_5":14474,"_27550":124902,"_2978":124940},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3496":73203,"_30262":73187,"_21040":124942,"_5":14474,"_27550":124902,"_2978":57635},[],{"_3496":73204,"_30262":73187,"_21040":124944,"_5":14474,"_27550":124902,"_2978":124945},[],"PEM correcto y firma verificable.",{"_3496":73205,"_30262":73187,"_21040":124947,"_5":14474,"_27550":124902,"_2978":57641},[],{"_3496":73206,"_30262":73187,"_21040":124949,"_5":14474,"_27550":124902,"_2978":124950},[],"Perfil",{"_3496":73207,"_30262":73187,"_21040":124952,"_5":14474,"_27550":124902,"_2978":124953},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3496":73208,"_30262":73187,"_21040":124955,"_5":14474,"_27550":124902,"_2978":124956},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3496":73209,"_30262":73187,"_21040":124958,"_5":14474,"_27550":124902,"_2978":122105},[],{"_3496":73210,"_30262":73187,"_21040":124960,"_5":14474,"_27550":124902,"_2978":124961},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3496":73211,"_30262":73187,"_21040":124963,"_5":14474,"_27550":124902,"_2978":124964},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3496":73212,"_30262":73187,"_21040":124966,"_5":14474,"_27550":124902,"_2978":124967},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3496":73213,"_30262":73187,"_21040":124969,"_5":14474,"_27550":124902,"_2978":124970},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3496":73214,"_30262":73187,"_21040":124972,"_5":14474,"_27550":124906,"_2978":124973},[],"Revisa cada frontera por separado:",{"_3496":73215,"_30262":73187,"_21040":124975,"_5":14474,"_27550":124906,"_2978":124976},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3496":73216,"_30262":73187,"_21040":124978,"_5":14474,"_27550":124906,"_2978":124979},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3496":73217,"_30262":73187,"_21040":124981,"_5":14474,"_27550":124906,"_2978":124982},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3496":73218,"_30262":73187,"_21040":124984,"_5":14474,"_27550":124906,"_2978":124985},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3496":73219,"_30262":73187,"_21040":124987,"_5":14474,"_27550":124906,"_2978":124988},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3496":73220,"_30262":73187,"_21040":124990,"_5":14474,"_27550":124906,"_2978":124991},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3496":73221,"_30262":73187,"_21040":124993,"_5":14474,"_27550":124910,"_2978":124994},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3496":73222,"_30262":73187,"_21040":124996,"_5":14474,"_27550":124910,"_2978":124997},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3496":73223,"_30262":73223,"_5":14825,"_2978":124999,"_30620":125000,"_21040":125001,"_27550":73223},"Seguridad",[49507],[],{"_3496":73224,"_30262":73223,"_21040":125003,"_5":14474,"_27550":73223,"_2978":125004},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3496":73225,"_30262":73223,"_5":30617,"_21040":125006,"_27550":125007,"_2978":125008},[],"/docs/pr-preview/pr-61/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3496":73226,"_30262":73223,"_5":30617,"_21040":125010,"_27550":125011,"_2978":125012},[],"/docs/pr-preview/pr-61/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3496":73227,"_30262":73223,"_5":30617,"_21040":125014,"_27550":125015,"_2978":125016},[],"/docs/pr-preview/pr-61/es/security#versiones-soportadas","Versiones soportadas",{"_3496":73228,"_30262":73223,"_5":30617,"_21040":125018,"_27550":125019,"_2978":125020},[],"/docs/pr-preview/pr-61/es/security#divulgación-responsable","Divulgación responsable",{"_3496":73229,"_30262":73223,"_21040":125022,"_5":14474,"_27550":73223,"_2978":125023},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3496":73230,"_30262":73223,"_21040":125025,"_5":14474,"_27550":125007,"_2978":125026},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3496":73231,"_30262":73223,"_21040":125028,"_5":14474,"_27550":125007,"_2978":125029},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3496":73232,"_30262":73223,"_21040":125031,"_5":14474,"_27550":125007,"_2978":15098},[],{"_3496":73233,"_30262":73223,"_21040":125033,"_5":14474,"_27550":125007,"_2978":15038},[],{"_3496":73234,"_30262":73223,"_21040":125035,"_5":14474,"_27550":125007,"_2978":15085},[],{"_3496":73235,"_30262":73223,"_21040":125037,"_5":14474,"_27550":125007,"_2978":125038},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3496":73236,"_30262":73223,"_21040":125040,"_5":14474,"_27550":125007,"_2978":125041},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3496":73237,"_30262":73223,"_21040":125043,"_5":14474,"_27550":125011,"_2978":125044},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3496":73238,"_30262":73223,"_21040":125046,"_5":14474,"_27550":125011,"_2978":125047},[],"No incluyas en el reporte:",{"_3496":73239,"_30262":73223,"_21040":125049,"_5":14474,"_27550":125011,"_2978":125050},[],"Credenciales, tokens o claves privadas",{"_3496":73240,"_30262":73223,"_21040":125052,"_5":14474,"_27550":125011,"_2978":125053},[],"Datos de clientes o información identificable de clientes",{"_3496":73241,"_30262":73223,"_21040":125055,"_5":14474,"_27550":125011,"_2978":125056},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3496":73242,"_30262":73223,"_21040":125058,"_5":14474,"_27550":125015,"_2978":125059},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3496":73243,"_30262":73223,"_21040":125061,"_5":14474,"_27550":125015,"_2978":125062},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3496":73244,"_30262":73223,"_21040":125064,"_5":14474,"_27550":125019,"_2978":125065},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3496":73245,"_30262":73223,"_21040":125067,"_5":14474,"_27550":125019,"_2978":125068},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3496":73246,"_30262":73223,"_21040":125070,"_5":14474,"_27550":125019,"_2978":125071},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3496":73247,"_30262":73223,"_21040":125073,"_5":14474,"_27550":125019,"_2978":125074},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3496":73248,"_30262":73223,"_21040":125076,"_5":14474,"_27550":125019,"_2978":125077},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3496":73249,"_30262":73249,"_5":14825,"_2978":125079,"_30620":125080,"_21040":125082,"_27550":73249},"3.8.0 a 4.0.0",[49507,125081],"Actualizaciones",[],{"_3496":73250,"_30262":73249,"_21040":125084,"_5":14474,"_27550":73249,"_2978":125085},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3496":73251,"_30262":73249,"_5":30617,"_21040":125087,"_27550":125088,"_2978":125089},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3496":73252,"_30262":73249,"_5":30617,"_21040":125091,"_27550":125092,"_2978":125093},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3496":73253,"_30262":73249,"_5":30617,"_21040":125095,"_27550":125096,"_2978":125097},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3496":73254,"_30262":73249,"_5":30617,"_21040":125099,"_27550":125100,"_2978":125101},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3496":73255,"_30262":73249,"_5":30617,"_21040":125103,"_27550":125104,"_2978":125105},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3496":73256,"_30262":73249,"_5":30617,"_21040":125107,"_27550":125108,"_2978":125109},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3496":73257,"_30262":73249,"_5":30617,"_21040":125111,"_27550":125112,"_2978":57807},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3496":73258,"_30262":73249,"_5":30617,"_21040":125114,"_27550":125115,"_2978":125116},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3496":73259,"_30262":73249,"_5":30617,"_21040":125118,"_27550":125119,"_2978":125120},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3496":73260,"_30262":73249,"_5":30617,"_21040":125122,"_27550":125123,"_2978":125124},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3496":73261,"_30262":73249,"_5":30617,"_21040":125126,"_27550":125127,"_2978":125128},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3496":73262,"_30262":73249,"_5":30617,"_21040":125130,"_27550":125131,"_2978":125132},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3496":73263,"_30262":73249,"_5":30617,"_21040":125134,"_27550":125135,"_2978":125136},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3496":73264,"_30262":73249,"_5":30617,"_21040":125138,"_27550":125139,"_2978":125140},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3496":73265,"_30262":73249,"_5":30617,"_21040":125142,"_27550":125143,"_2978":125144},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3496":73266,"_30262":73249,"_5":30617,"_21040":125146,"_27550":125147,"_2978":125148},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3496":73267,"_30262":73249,"_5":30617,"_21040":125150,"_27550":125151,"_2978":125152},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3496":73268,"_30262":73249,"_5":30617,"_21040":125154,"_27550":125155,"_2978":125156},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3496":73269,"_30262":73249,"_5":30617,"_21040":125158,"_27550":125159,"_2978":125160},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3496":73270,"_30262":73249,"_5":30617,"_21040":125162,"_27550":125163,"_2978":125164},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3496":73271,"_30262":73249,"_5":30617,"_21040":125166,"_27550":125167,"_2978":125168},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3496":73272,"_30262":73249,"_5":30617,"_21040":125170,"_27550":125171,"_2978":125172},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3496":73273,"_30262":73249,"_5":30617,"_21040":125174,"_27550":125175,"_2978":125176},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3496":73274,"_30262":73249,"_5":30617,"_21040":125178,"_27550":125179,"_2978":125180},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3496":73275,"_30262":73249,"_5":30617,"_21040":125182,"_27550":125183,"_2978":125184},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3496":73276,"_30262":73249,"_5":30617,"_21040":125186,"_27550":125187,"_2978":125188},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3496":73277,"_30262":73249,"_5":30617,"_21040":125190,"_27550":125191,"_2978":125192},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3496":73278,"_30262":73249,"_5":30617,"_21040":125194,"_27550":125195,"_2978":125196},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3496":73279,"_30262":73249,"_5":30617,"_21040":125198,"_27550":125199,"_2978":125200},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3496":73280,"_30262":73249,"_5":30617,"_21040":125202,"_27550":125203,"_2978":125204},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3496":73281,"_30262":73249,"_5":30617,"_21040":125206,"_27550":125207,"_2978":125208},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3496":73282,"_30262":73249,"_5":30617,"_21040":125210,"_27550":125211,"_2978":125212},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3496":73283,"_30262":73249,"_5":30617,"_21040":125214,"_27550":125215,"_2978":125216},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3496":73284,"_30262":73249,"_5":30617,"_21040":125218,"_27550":125219,"_2978":125220},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3496":73285,"_30262":73249,"_5":30617,"_21040":125222,"_27550":125223,"_2978":125224},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3496":73286,"_30262":73249,"_5":30617,"_21040":125226,"_27550":125227,"_2978":125228},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3496":73287,"_30262":73249,"_5":30617,"_21040":125230,"_27550":125231,"_2978":125232},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3496":73288,"_30262":73249,"_5":30617,"_21040":125234,"_27550":125235,"_2978":125236},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3496":73289,"_30262":73249,"_5":30617,"_21040":125238,"_27550":125239,"_2978":125240},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3496":73290,"_30262":73249,"_5":30617,"_21040":125242,"_27550":125243,"_2978":125244},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3496":73291,"_30262":73249,"_5":30617,"_21040":125246,"_27550":125247,"_2978":120968},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3496":73292,"_30262":73249,"_5":30617,"_21040":125249,"_27550":125250,"_2978":125251},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3496":73293,"_30262":73249,"_5":30617,"_21040":125253,"_27550":125254,"_2978":125255},[],"/docs/pr-preview/pr-61/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3496":73294,"_30262":73249,"_21040":125257,"_5":14474,"_27550":73249,"_2978":125258},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3496":73295,"_30262":73249,"_21040":125260,"_5":14474,"_27550":73249,"_2978":125261},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3496":73296,"_30262":73249,"_21040":125263,"_5":14474,"_27550":73249,"_2978":125264},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3496":73297,"_30262":73249,"_21040":125266,"_5":14474,"_27550":73249,"_2978":125267},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3496":73298,"_30262":73249,"_21040":125269,"_5":14474,"_27550":73249,"_2978":125270},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3496":73299,"_30262":73249,"_21040":125272,"_5":14474,"_27550":73249,"_2978":125273},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3496":73300,"_30262":73249,"_21040":125275,"_5":14474,"_27550":73249,"_2978":125276},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3496":73301,"_30262":73249,"_21040":125278,"_5":14474,"_27550":125092,"_2978":125279},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3496":73302,"_30262":73249,"_21040":125281,"_5":14474,"_27550":125092,"_2978":125282},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3496":73303,"_30262":73249,"_21040":125284,"_5":14474,"_27550":125096,"_2978":125285},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3496":73304,"_30262":73249,"_21040":125287,"_5":14474,"_27550":125096,"_2978":125288},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3496":73305,"_30262":73249,"_21040":125290,"_5":14474,"_27550":125100,"_2978":125291},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3496":73306,"_30262":73249,"_21040":125293,"_5":14474,"_27550":125104,"_2978":125294},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3496":73307,"_30262":73249,"_21040":125296,"_5":14474,"_27550":125104,"_2978":125297},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3496":73308,"_30262":73249,"_21040":125299,"_5":14474,"_27550":125104,"_2978":125300},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3496":73309,"_30262":73249,"_21040":125302,"_5":14474,"_27550":125104,"_2978":125303},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3496":73310,"_30262":73249,"_21040":125305,"_5":14474,"_27550":125104,"_2978":125306},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3496":73311,"_30262":73249,"_21040":125308,"_5":14474,"_27550":125108,"_2978":125309},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3496":73312,"_30262":73249,"_21040":125311,"_5":14474,"_27550":125108,"_2978":125312},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3496":73313,"_30262":73249,"_21040":125314,"_5":14474,"_27550":125108,"_2978":125315},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3496":73314,"_30262":73249,"_21040":125317,"_5":14474,"_27550":125108,"_2978":125318},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3496":73315,"_30262":73249,"_21040":125320,"_5":14474,"_27550":125108,"_2978":125321},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3496":73316,"_30262":73249,"_21040":125323,"_5":14474,"_27550":125108,"_2978":125324},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3496":73317,"_30262":73249,"_21040":125326,"_5":14474,"_27550":125112,"_2978":125327},[],"Cambio",{"_3496":73318,"_30262":73249,"_21040":125329,"_5":14474,"_27550":125112,"_2978":125330},[],"A quién afecta",{"_3496":73319,"_30262":73249,"_21040":125332,"_5":14474,"_27550":125112,"_2978":125333},[],"Gravedad",{"_3496":73320,"_30262":73249,"_21040":125335,"_5":14474,"_27550":125112,"_2978":123735},[],{"_3496":73321,"_30262":73249,"_21040":125337,"_5":14474,"_27550":125112,"_2978":125120},[],{"_3496":73322,"_30262":73249,"_21040":125339,"_5":14474,"_27550":125112,"_2978":125340},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3496":73323,"_30262":73249,"_21040":125342,"_5":14474,"_27550":125112,"_2978":125343},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3496":73324,"_30262":73249,"_21040":125345,"_5":14474,"_27550":125112,"_2978":125346},[],"Copiar los datos a los volúmenes nuevos",{"_3496":73325,"_30262":73249,"_21040":125348,"_5":14474,"_27550":125112,"_2978":125124},[],{"_3496":73326,"_30262":73249,"_21040":125350,"_5":14474,"_27550":125112,"_2978":125351},[],"Todas las releases de Helm",{"_3496":73327,"_30262":73249,"_21040":125353,"_5":14474,"_27550":125112,"_2978":125354},[],"Alta: `helm upgrade` falla",{"_3496":73328,"_30262":73249,"_21040":125356,"_5":14474,"_27550":125112,"_2978":125357},[],"Eliminar o renombrar las claves heredadas",{"_3496":73329,"_30262":73249,"_21040":125359,"_5":14474,"_27550":125112,"_2978":125128},[],{"_3496":73330,"_30262":73249,"_21040":125361,"_5":14474,"_27550":125112,"_2978":125362},[],"Todos los despliegues",{"_3496":73331,"_30262":73249,"_21040":125364,"_5":14474,"_27550":125112,"_2978":125365},[],"Alta: sin principal de bootstrap no hay administrador",{"_3496":73332,"_30262":73249,"_21040":125367,"_5":14474,"_27550":125112,"_2978":125368},[],"Configurar `services.authz`",{"_3496":73333,"_30262":73249,"_21040":125370,"_5":14474,"_27550":125112,"_2978":125132},[],{"_3496":73334,"_30262":73249,"_21040":125372,"_5":14474,"_27550":125112,"_2978":125351},[],{"_3496":73335,"_30262":73249,"_21040":125374,"_5":14474,"_27550":125112,"_2978":125375},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3496":73336,"_30262":73249,"_21040":125377,"_5":14474,"_27550":125112,"_2978":125378},[],"Mover JWKS y roles a `services.authz`",{"_3496":73337,"_30262":73249,"_21040":125380,"_5":14474,"_27550":125112,"_2978":125152},[],{"_3496":73338,"_30262":73249,"_21040":125382,"_5":14474,"_27550":125112,"_2978":125383},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3496":73339,"_30262":73249,"_21040":125385,"_5":14474,"_27550":125112,"_2978":125386},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3496":73340,"_30262":73249,"_21040":125388,"_5":14474,"_27550":125112,"_2978":125389},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3496":73341,"_30262":73249,"_21040":125391,"_5":14474,"_27550":125112,"_2978":125156},[],{"_3496":73342,"_30262":73249,"_21040":125393,"_5":14474,"_27550":125112,"_2978":125394},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3496":73343,"_30262":73249,"_21040":125396,"_5":14474,"_27550":125112,"_2978":125397},[],"Alta: el backend ya no arranca con ellos",{"_3496":73344,"_30262":73249,"_21040":125399,"_5":14474,"_27550":125112,"_2978":125400},[],"Pasar a PostgreSQL antes de actualizar",{"_3496":73345,"_30262":73249,"_21040":125402,"_5":14474,"_27550":125112,"_2978":125200},[],{"_3496":73346,"_30262":73249,"_21040":125404,"_5":14474,"_27550":125112,"_2978":125405},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3496":73347,"_30262":73249,"_21040":125407,"_5":14474,"_27550":125112,"_2978":125408},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3496":73348,"_30262":73249,"_21040":125410,"_5":14474,"_27550":125112,"_2978":125411},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3496":73349,"_30262":73249,"_21040":125413,"_5":14474,"_27550":125112,"_2978":125414},[],"Webhooks con referencias a archivos",{"_3496":73350,"_30262":73249,"_21040":125416,"_5":14474,"_27550":125112,"_2978":125417},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3496":73351,"_30262":73249,"_21040":125419,"_5":14474,"_27550":125112,"_2978":125420},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3496":73352,"_30262":73249,"_21040":125422,"_5":14474,"_27550":125112,"_2978":125423},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3496":73353,"_30262":73249,"_21040":125425,"_5":14474,"_27550":125112,"_2978":125136},[],{"_3496":73354,"_30262":73249,"_21040":125427,"_5":14474,"_27550":125112,"_2978":125428},[],"Releases con identidades por servicio o material de claves montado",{"_3496":73355,"_30262":73249,"_21040":125430,"_5":14474,"_27550":125112,"_2978":125431},[],"Media: los servicios no pueden leer sus archivos",{"_3496":73356,"_30262":73249,"_21040":125433,"_5":14474,"_27550":125112,"_2978":125434},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3496":73357,"_30262":73249,"_21040":125436,"_5":14474,"_27550":125112,"_2978":125140},[],{"_3496":73358,"_30262":73249,"_21040":125438,"_5":14474,"_27550":125112,"_2978":125439},[],"Releases que definen `amqp.tls`",{"_3496":73359,"_30262":73249,"_21040":125441,"_5":14474,"_27550":125112,"_2978":125442},[],"Media: los clientes se conectan al puerto equivocado",{"_3496":73360,"_30262":73249,"_21040":125444,"_5":14474,"_27550":125112,"_2978":125445},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3496":73361,"_30262":73249,"_21040":125447,"_5":14474,"_27550":125112,"_2978":125160},[],{"_3496":73362,"_30262":73249,"_21040":125449,"_5":14474,"_27550":125112,"_2978":125450},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3496":73363,"_30262":73249,"_21040":125452,"_5":14474,"_27550":125112,"_2978":125453},[],"Media: las claves de CA quedan sin gestionar",{"_3496":73364,"_30262":73249,"_21040":125455,"_5":14474,"_27550":125112,"_2978":125456},[],"Ejecutar la migración de CA a KMS",{"_3496":73365,"_30262":73249,"_21040":125458,"_5":14474,"_27550":125112,"_2978":125459},[],"Verificación del certificado del receptor",{"_3496":73366,"_30262":73249,"_21040":125461,"_5":14474,"_27550":125112,"_2978":125462},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3496":73367,"_30262":73249,"_21040":125464,"_5":14474,"_27550":125112,"_2978":125465},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3496":73368,"_30262":73249,"_21040":125467,"_5":14474,"_27550":125112,"_2978":125468},[],"Poner `insecure_skip_verify` a `false`",{"_3496":73369,"_30262":73249,"_21040":125470,"_5":14474,"_27550":125112,"_2978":125176},[],{"_3496":73370,"_30262":73249,"_21040":125472,"_5":14474,"_27550":125112,"_2978":125473},[],"Scripts y consolas que editan DMS por API",{"_3496":73371,"_30262":73249,"_21040":125475,"_5":14474,"_27550":125112,"_2978":125476},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3496":73372,"_30262":73249,"_21040":125478,"_5":14474,"_27550":125112,"_2978":125479},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3496":73373,"_30262":73249,"_21040":125481,"_5":14474,"_27550":125112,"_2978":125196},[],{"_3496":73374,"_30262":73249,"_21040":125483,"_5":14474,"_27550":125112,"_2978":125484},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3496":73375,"_30262":73249,"_21040":125486,"_5":14474,"_27550":125112,"_2978":125487},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3496":73376,"_30262":73249,"_21040":125489,"_5":14474,"_27550":125112,"_2978":125490},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3496":73377,"_30262":73249,"_21040":125492,"_5":14474,"_27550":125112,"_2978":125204},[],{"_3496":73378,"_30262":73249,"_21040":125494,"_5":14474,"_27550":125112,"_2978":125495},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3496":73379,"_30262":73249,"_21040":125497,"_5":14474,"_27550":125112,"_2978":125498},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3496":73380,"_30262":73249,"_21040":125500,"_5":14474,"_27550":125112,"_2978":125501},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3496":73381,"_30262":73249,"_21040":125503,"_5":14474,"_27550":125112,"_2978":125192},[],{"_3496":73382,"_30262":73249,"_21040":125505,"_5":14474,"_27550":125112,"_2978":125506},[],"Consumidores que leen el campo `events` del dispositivo",{"_3496":73383,"_30262":73249,"_21040":125508,"_5":14474,"_27550":125112,"_2978":125509},[],"Media: el campo desaparece",{"_3496":73384,"_30262":73249,"_21040":125511,"_5":14474,"_27550":125112,"_2978":125512},[],"Usar los nuevos endpoints de eventos",{"_3496":73385,"_30262":73249,"_21040":125514,"_5":14474,"_27550":125112,"_2978":125212},[],{"_3496":73386,"_30262":73249,"_21040":125516,"_5":14474,"_27550":125112,"_2978":125517},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3496":73387,"_30262":73249,"_21040":125519,"_5":14474,"_27550":125112,"_2978":125520},[],"Media: la migración de la VA aborta",{"_3496":73388,"_30262":73249,"_21040":125522,"_5":14474,"_27550":125112,"_2978":125523},[],"Corregir los roles afectados antes de actualizar",{"_3496":73389,"_30262":73249,"_21040":125525,"_5":14474,"_27550":125112,"_2978":125144},[],{"_3496":73390,"_30262":73249,"_21040":125527,"_5":14474,"_27550":125112,"_2978":125528},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3496":73391,"_30262":73249,"_21040":125530,"_5":14474,"_27550":125112,"_2978":125531},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3496":73392,"_30262":73249,"_21040":125533,"_5":14474,"_27550":125112,"_2978":125534},[],"Actualizar el archivo de values",{"_3496":73393,"_30262":73249,"_21040":125536,"_5":14474,"_27550":125112,"_2978":125184},[],{"_3496":73394,"_30262":73249,"_21040":125538,"_5":14474,"_27550":125112,"_2978":125539},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3496":73395,"_30262":73249,"_21040":125541,"_5":14474,"_27550":125112,"_2978":125542},[],"Baja: prevalece el ID de la URL",{"_3496":73396,"_30262":73249,"_21040":125544,"_5":14474,"_27550":125112,"_2978":125545},[],"Enviar el ID en la URL",{"_3496":73397,"_30262":73249,"_21040":125547,"_5":14474,"_27550":125112,"_2978":125208},[],{"_3496":73398,"_30262":73249,"_21040":125549,"_5":14474,"_27550":125112,"_2978":125550},[],"Clientes que envían un `id` al crear o importar CAs",{"_3496":73399,"_30262":73249,"_21040":125552,"_5":14474,"_27550":125112,"_2978":125553},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3496":73400,"_30262":73249,"_21040":125555,"_5":14474,"_27550":125112,"_2978":125556},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3496":73401,"_30262":73249,"_21040":125558,"_5":14474,"_27550":125112,"_2978":125188},[],{"_3496":73402,"_30262":73249,"_21040":125560,"_5":14474,"_27550":125112,"_2978":125561},[],"Consumidores que comparan el `type` del certificado",{"_3496":73403,"_30262":73249,"_21040":125563,"_5":14474,"_27550":125112,"_2978":125564},[],"Baja: dos valores cambian de nombre",{"_3496":73404,"_30262":73249,"_21040":125566,"_5":14474,"_27550":125112,"_2978":125567},[],"Adaptar los consumidores",{"_3496":73405,"_30262":73249,"_21040":125569,"_5":14474,"_27550":125112,"_2978":125180},[],{"_3496":73406,"_30262":73249,"_21040":125571,"_5":14474,"_27550":125112,"_2978":125572},[],"Cualquier DMS",{"_3496":73407,"_30262":73249,"_21040":125574,"_5":14474,"_27550":125112,"_2978":125575},[],"Baja: solo informativo",{"_3496":73408,"_30262":73249,"_21040":125577,"_5":14474,"_27550":125112,"_2978":125578},[],"Revisar ambos bloques antes de editar",{"_3496":73409,"_30262":73249,"_21040":125580,"_5":14474,"_27550":125119,"_2978":125581},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3496":73410,"_30262":73249,"_21040":125583,"_5":14474,"_27550":125119,"_2978":125584},[],"El paso 4 de la guía de migración copia los datos.",{"_3496":73411,"_30262":73249,"_21040":125586,"_5":14474,"_27550":125123,"_2978":125587},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3496":73412,"_30262":73249,"_21040":125589,"_5":14474,"_27550":125127,"_2978":125590},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3496":73413,"_30262":73249,"_21040":125592,"_5":14474,"_27550":125131,"_2978":125593},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3496":73414,"_30262":73249,"_21040":125595,"_5":14474,"_27550":125135,"_2978":125596},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3496":73415,"_30262":73249,"_21040":125598,"_5":14474,"_27550":125135,"_2978":125599},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3496":73416,"_30262":73249,"_21040":125601,"_5":14474,"_27550":125139,"_2978":125602},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3496":73417,"_30262":73249,"_21040":125604,"_5":14474,"_27550":125143,"_2978":125605},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3496":73418,"_30262":73249,"_21040":125607,"_5":14474,"_27550":125143,"_2978":125608},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3496":73419,"_30262":73249,"_21040":125610,"_5":14474,"_27550":125143,"_2978":125611},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3496":73420,"_30262":73249,"_21040":125613,"_5":14474,"_27550":125143,"_2978":125614},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3496":73421,"_30262":73249,"_21040":125616,"_5":14474,"_27550":125143,"_2978":125617},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3496":73422,"_30262":73249,"_21040":125619,"_5":14474,"_27550":125143,"_2978":125620},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3496":73423,"_30262":73249,"_21040":125622,"_5":14474,"_27550":125151,"_2978":125623},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3496":73424,"_30262":73249,"_21040":125625,"_5":14474,"_27550":125151,"_2978":125626},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3496":73425,"_30262":73249,"_21040":125628,"_5":14474,"_27550":125151,"_2978":125629},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3496":73426,"_30262":73249,"_21040":125631,"_5":14474,"_27550":125151,"_2978":125632},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3496":73427,"_30262":73249,"_21040":125634,"_5":14474,"_27550":125151,"_2978":125635},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3496":73428,"_30262":73249,"_21040":125637,"_5":14474,"_27550":125155,"_2978":125638},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3496":73429,"_30262":73249,"_21040":125640,"_5":14474,"_27550":125159,"_2978":125641},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3496":73430,"_30262":73249,"_21040":125643,"_5":14474,"_27550":125159,"_2978":125644},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3496":73431,"_30262":73249,"_21040":125646,"_5":14474,"_27550":125159,"_2978":125647},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3496":73432,"_30262":73249,"_21040":125649,"_5":14474,"_27550":125159,"_2978":125650},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3496":73433,"_30262":73249,"_21040":125652,"_5":14474,"_27550":125159,"_2978":125653},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3496":73434,"_30262":73249,"_21040":125655,"_5":14474,"_27550":125159,"_2978":125656},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3496":73435,"_30262":73249,"_21040":125658,"_5":14474,"_27550":125159,"_2978":125659},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3496":73436,"_30262":73249,"_21040":125661,"_5":14474,"_27550":125159,"_2978":125662},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3496":73437,"_30262":73249,"_21040":125664,"_5":14474,"_27550":125163,"_2978":125665},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3496":73438,"_30262":73249,"_21040":125667,"_5":14474,"_27550":125171,"_2978":125668},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3496":73439,"_30262":73249,"_21040":125670,"_5":14474,"_27550":125171,"_2978":125671},[],"Campo en 3.8.0",{"_3496":73440,"_30262":73249,"_21040":125673,"_5":14474,"_27550":125171,"_2978":125674},[],"Campo en 4.0.0",{"_3496":73441,"_30262":73249,"_21040":125676,"_5":14474,"_27550":125171,"_2978":58372},[],{"_3496":73442,"_30262":73249,"_21040":125678,"_5":14474,"_27550":125171,"_2978":125679},[],"`insecure_skip_verify` (con el valor negado)",{"_3496":73443,"_30262":73249,"_21040":125681,"_5":14474,"_27550":125171,"_2978":58378},[],{"_3496":73444,"_30262":73249,"_21040":125683,"_5":14474,"_27550":125171,"_2978":58381},[],{"_3496":73445,"_30262":73249,"_21040":125685,"_5":14474,"_27550":125171,"_2978":58384},[],{"_3496":73446,"_30262":73249,"_21040":125687,"_5":14474,"_27550":125171,"_2978":58387},[],{"_3496":73447,"_30262":73249,"_21040":125689,"_5":14474,"_27550":125171,"_2978":58390},[],{"_3496":73448,"_30262":73249,"_21040":125691,"_5":14474,"_27550":125171,"_2978":58393},[],{"_3496":73449,"_30262":73249,"_21040":125693,"_5":14474,"_27550":125171,"_2978":125694},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3496":73450,"_30262":73249,"_21040":125696,"_5":14474,"_27550":125171,"_2978":125697},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3496":73451,"_30262":73249,"_21040":125699,"_5":14474,"_27550":125171,"_2978":125700},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3496":73452,"_30262":73249,"_21040":125702,"_5":14474,"_27550":125175,"_2978":125703},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3496":73453,"_30262":73249,"_21040":125705,"_5":14474,"_27550":125175,"_2978":125706},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3496":73454,"_30262":73249,"_21040":125708,"_5":14474,"_27550":125175,"_2978":125709},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3496":73455,"_30262":73249,"_21040":125711,"_5":14474,"_27550":125179,"_2978":125712},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3496":73456,"_30262":73249,"_21040":125714,"_5":14474,"_27550":125183,"_2978":125715},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3496":73457,"_30262":73249,"_21040":125717,"_5":14474,"_27550":125187,"_2978":125718},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3496":73458,"_30262":73249,"_21040":125720,"_5":14474,"_27550":125191,"_2978":125721},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3496":73459,"_30262":73249,"_21040":125723,"_5":14474,"_27550":125191,"_2978":125724},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3496":73460,"_30262":73249,"_21040":125726,"_5":14474,"_27550":125191,"_2978":125727},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3496":73461,"_30262":73249,"_21040":125729,"_5":14474,"_27550":125191,"_2978":125730},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3496":73462,"_30262":73249,"_21040":125732,"_5":14474,"_27550":125195,"_2978":125733},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3496":73463,"_30262":73249,"_21040":125735,"_5":14474,"_27550":125199,"_2978":125736},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3496":73464,"_30262":73249,"_21040":125738,"_5":14474,"_27550":125199,"_2978":125739},[],"Ruta",{"_3496":73465,"_30262":73249,"_21040":125741,"_5":14474,"_27550":125199,"_2978":118204},[],{"_3496":73466,"_30262":73249,"_21040":125743,"_5":14474,"_27550":125199,"_2978":58446},[],{"_3496":73467,"_30262":73249,"_21040":125745,"_5":14474,"_27550":125199,"_2978":125746},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3496":73468,"_30262":73249,"_21040":125748,"_5":14474,"_27550":125199,"_2978":58452},[],{"_3496":73469,"_30262":73249,"_21040":125750,"_5":14474,"_27550":125199,"_2978":125751},[],"Lee los ajustes de una CA.",{"_3496":73470,"_30262":73249,"_21040":125753,"_5":14474,"_27550":125199,"_2978":58458},[],{"_3496":73471,"_30262":73249,"_21040":125755,"_5":14474,"_27550":125199,"_2978":125756},[],"Sustituye los `crl_options`.",{"_3496":73472,"_30262":73249,"_21040":125758,"_5":14474,"_27550":125199,"_2978":125759},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3496":73473,"_30262":73249,"_21040":125761,"_5":14474,"_27550":125199,"_2978":125762},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3496":73474,"_30262":73249,"_21040":125764,"_5":14474,"_27550":125199,"_2978":125765},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3496":73475,"_30262":73249,"_21040":125767,"_5":14474,"_27550":125199,"_2978":125768},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3496":73476,"_30262":73249,"_21040":125770,"_5":14474,"_27550":125199,"_2978":125771},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3496":73477,"_30262":73249,"_21040":125773,"_5":14474,"_27550":125199,"_2978":125774},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3496":73478,"_30262":73249,"_21040":125776,"_5":14474,"_27550":125199,"_2978":125777},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3496":73479,"_30262":73249,"_21040":125779,"_5":14474,"_27550":125199,"_2978":125780},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3496":73480,"_30262":73249,"_21040":125782,"_5":14474,"_27550":125199,"_2978":125783},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3496":73481,"_30262":73249,"_21040":125785,"_5":14474,"_27550":125199,"_2978":125786},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3496":73482,"_30262":73249,"_21040":125788,"_5":14474,"_27550":125199,"_2978":125789},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3496":73483,"_30262":73249,"_21040":125791,"_5":14474,"_27550":125203,"_2978":125792},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3496":73484,"_30262":73249,"_21040":125794,"_5":14474,"_27550":125207,"_2978":125795},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3496":73485,"_30262":73249,"_21040":125797,"_5":14474,"_27550":125211,"_2978":125798},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3496":73486,"_30262":73249,"_21040":125800,"_5":14474,"_27550":125215,"_2978":125801},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3496":73487,"_30262":73249,"_21040":125803,"_5":14474,"_27550":125219,"_2978":125804},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3496":73488,"_30262":73249,"_21040":125806,"_5":14474,"_27550":125219,"_2978":125807},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3496":73489,"_30262":73249,"_21040":125809,"_5":14474,"_27550":125219,"_2978":125810},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3496":73490,"_30262":73249,"_21040":125812,"_5":14474,"_27550":125219,"_2978":125813},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3496":73491,"_30262":73249,"_21040":125815,"_5":14474,"_27550":125219,"_2978":125816},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3496":73492,"_30262":73249,"_21040":125818,"_5":14474,"_27550":125219,"_2978":125819},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3496":73493,"_30262":73249,"_21040":125821,"_5":14474,"_27550":125223,"_2978":125822},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3496":73494,"_30262":73249,"_21040":125824,"_5":14474,"_27550":125223,"_2978":125825},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3496":73495,"_30262":73249,"_21040":125827,"_5":14474,"_27550":125223,"_2978":125828},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3496":73496,"_30262":73249,"_21040":125830,"_5":14474,"_27550":125223,"_2978":125831},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3496":73497,"_30262":73249,"_21040":125833,"_5":14474,"_27550":125223,"_2978":125834},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3496":73498,"_30262":73249,"_21040":125836,"_5":14474,"_27550":125227,"_2978":125837},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3496":73499,"_30262":73249,"_21040":125839,"_5":14474,"_27550":125227,"_2978":125840},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3496":73500,"_30262":73249,"_21040":125842,"_5":14474,"_27550":125227,"_2978":125843},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3496":73501,"_30262":73249,"_21040":125845,"_5":14474,"_27550":125227,"_2978":125846},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3496":73502,"_30262":73249,"_21040":125848,"_5":14474,"_27550":125227,"_2978":125849},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3496":73503,"_30262":73249,"_21040":125851,"_5":14474,"_27550":125227,"_2978":125852},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3496":73504,"_30262":73249,"_21040":125854,"_5":14474,"_27550":125227,"_2978":125855},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3496":73505,"_30262":73249,"_21040":125857,"_5":14474,"_27550":125227,"_2978":125858},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3496":73506,"_30262":73249,"_21040":125860,"_5":14474,"_27550":125227,"_2978":125861},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3496":73507,"_30262":73249,"_21040":125863,"_5":14474,"_27550":125227,"_2978":125864},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3496":73508,"_30262":73249,"_21040":125866,"_5":14474,"_27550":125227,"_2978":125867},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3496":73509,"_30262":73249,"_21040":125869,"_5":14474,"_27550":125227,"_2978":125870},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3496":73510,"_30262":73249,"_21040":125872,"_5":14474,"_27550":125231,"_2978":125873},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3496":73511,"_30262":73249,"_21040":125875,"_5":14474,"_27550":125231,"_2978":125876},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3496":73512,"_30262":73249,"_21040":125878,"_5":14474,"_27550":125235,"_2978":125879},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3496":73513,"_30262":73249,"_21040":125881,"_5":14474,"_27550":125235,"_2978":125882},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3496":73514,"_30262":73249,"_21040":125884,"_5":14474,"_27550":125235,"_2978":125885},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3496":73515,"_30262":73249,"_21040":125887,"_5":14474,"_27550":125235,"_2978":125888},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3496":73516,"_30262":73249,"_21040":125890,"_5":14474,"_27550":125235,"_2978":125891},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3496":73517,"_30262":73249,"_21040":125893,"_5":14474,"_27550":125235,"_2978":125894},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3496":73518,"_30262":73249,"_21040":125896,"_5":14474,"_27550":125235,"_2978":125897},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3496":73519,"_30262":73249,"_21040":125899,"_5":14474,"_27550":125235,"_2978":125900},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3496":73520,"_30262":73249,"_21040":125902,"_5":14474,"_27550":125235,"_2978":125903},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3496":73521,"_30262":73249,"_21040":125905,"_5":14474,"_27550":125235,"_2978":125906},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3496":73522,"_30262":73249,"_21040":125908,"_5":14474,"_27550":125235,"_2978":125909},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3496":73523,"_30262":73249,"_21040":125911,"_5":14474,"_27550":125239,"_2978":125912},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3496":73524,"_30262":73249,"_21040":125914,"_5":14474,"_27550":125239,"_2978":125915},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3496":73525,"_30262":73249,"_21040":125917,"_5":14474,"_27550":125243,"_2978":125918},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3496":73526,"_30262":73249,"_21040":125920,"_5":14474,"_27550":125243,"_2978":125921},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3496":73527,"_30262":73249,"_21040":125923,"_5":14474,"_27550":125243,"_2978":125924},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3496":73528,"_30262":73249,"_21040":125926,"_5":14474,"_27550":125243,"_2978":125927},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3496":73529,"_30262":73249,"_21040":125929,"_5":14474,"_27550":125243,"_2978":125930},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3496":73530,"_30262":73249,"_21040":125932,"_5":14474,"_27550":125243,"_2978":125933},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3496":73531,"_30262":73249,"_21040":125935,"_5":14474,"_27550":125243,"_2978":125936},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3496":73532,"_30262":73249,"_21040":125938,"_5":14474,"_27550":125243,"_2978":125939},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3496":73533,"_30262":73249,"_21040":125941,"_5":14474,"_27550":125247,"_2978":125942},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3496":73534,"_30262":73249,"_21040":125944,"_5":14474,"_27550":125247,"_2978":125945},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3496":73535,"_30262":73249,"_21040":125947,"_5":14474,"_27550":125247,"_2978":125948},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3496":73536,"_30262":73249,"_21040":125950,"_5":14474,"_27550":125247,"_2978":125951},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3496":73537,"_30262":73249,"_21040":125953,"_5":14474,"_27550":125247,"_2978":125954},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3496":73538,"_30262":73249,"_21040":125956,"_5":14474,"_27550":125247,"_2978":125957},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3496":73539,"_30262":73249,"_21040":125959,"_5":14474,"_27550":125247,"_2978":125960},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3496":73540,"_30262":73249,"_21040":125962,"_5":14474,"_27550":125247,"_2978":125963},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3496":73541,"_30262":73249,"_21040":125965,"_5":14474,"_27550":125247,"_2978":125966},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3496":73542,"_30262":73249,"_21040":125968,"_5":14474,"_27550":125247,"_2978":125969},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3496":73543,"_30262":73249,"_21040":125971,"_5":14474,"_27550":125247,"_2978":125972},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3496":73544,"_30262":73249,"_21040":125974,"_5":14474,"_27550":125250,"_2978":125975},[],"Tras la actualización, comprueba en este orden:",{"_3496":73545,"_30262":73249,"_21040":125977,"_5":14474,"_27550":125250,"_2978":125978},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3496":73546,"_30262":73249,"_21040":125980,"_5":14474,"_27550":125250,"_2978":125981},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3496":73547,"_30262":73249,"_21040":125983,"_5":14474,"_27550":125250,"_2978":125984},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3496":73548,"_30262":73249,"_21040":125986,"_5":14474,"_27550":125250,"_2978":125987},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3496":73549,"_30262":73249,"_21040":125989,"_5":14474,"_27550":125250,"_2978":125990},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3496":73550,"_30262":73249,"_21040":125992,"_5":14474,"_27550":125250,"_2978":125993},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3496":73551,"_30262":73249,"_21040":125995,"_5":14474,"_27550":125250,"_2978":125996},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3496":73552,"_30262":73249,"_21040":125998,"_5":14474,"_27550":125250,"_2978":125999},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3496":73553,"_30262":73249,"_21040":126001,"_5":14474,"_27550":125250,"_2978":126002},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3496":73554,"_30262":73249,"_21040":126004,"_5":14474,"_27550":125250,"_2978":126005},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3496":73555,"_30262":73249,"_21040":126007,"_5":14474,"_27550":125250,"_2978":126008},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3496":73556,"_30262":73249,"_21040":126010,"_5":14474,"_27550":125250,"_2978":126011},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3496":73557,"_30262":73249,"_21040":126013,"_5":14474,"_27550":125250,"_2978":126014},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3496":73558,"_30262":73249,"_21040":126016,"_5":14474,"_27550":125250,"_2978":126017},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3496":73559,"_30262":73249,"_21040":126019,"_5":14474,"_27550":125250,"_2978":126020},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3496":73560,"_30262":73249,"_21040":126022,"_5":14474,"_27550":125254,"_2978":126023},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3496":73561,"_30262":73249,"_21040":126025,"_5":14474,"_27550":125254,"_2978":126026},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3496":73562,"_30262":73249,"_21040":126028,"_5":14474,"_27550":125254,"_2978":126029},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3496":73563,"_30262":73249,"_21040":126031,"_5":14474,"_27550":125254,"_2978":126032},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3496":73564,"_30262":73249,"_21040":126034,"_5":14474,"_27550":125254,"_2978":126035},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58743":126037,"_58745":126038,"_58747":126039,"_58749":126040,"_18251":3013,"_70600":3013},"spanish",[2978,30262,5,27550],{"_2978":25121,"_30262":25121,"_5":25121,"_27550":25121},{"_2978":126041,"_30262":129002,"_5":131963,"_27550":134924},{"_4706":126042,"_58753":126043,"_5":25121},{"_3590":3289,"_14930":6058,"_14949":7421,"_3577":6361,"_14936":4051,"_19977":23449,"_14570":3391,"_14577":4140,"_29209":7095,"_29617":7369,"_29637":9378,"_29243":7105,"_34644":7749,"_29345":26326,"_29681":9941,"_34651":6615,"_34654":6028,"_34657":6663,"_34660":6048,"_30088":3382,"_34665":7019,"_34667":5595,"_30118":5014,"_14945":7347,"_34671":7576,"_34674":7650,"_34676":11056,"_29665":3800,"_30083":12930,"_30131":17884,"_34681":3206,"_34683":3165,"_34685":6152,"_29362":6377,"_34688":3564,"_34690":7619,"_34692":7665,"_34694":6445,"_34696":14598,"_29279":3417,"_34699":3725,"_3580":3766,"_29273":22998,"_29702":6652,"_34704":13807,"_34706":4250,"_34709":5324,"_29319":3276,"_34713":5031,"_29200":17396,"_34716":5922,"_29248":4433,"_34719":5019,"_34721":7045,"_34724":20455,"_14939":4604,"_34727":4278,"_34729":22917,"_34732":14547,"_34734":4607,"_30321":20816,"_34737":21535,"_34739":4450,"_19980":3464,"_34742":6062,"_34744":4116,"_29221":3151,"_29659":3370,"_34748":7132,"_34750":3442,"_34752":4678,"_30148":3485,"_34755":5184,"_34757":4217,"_34759":16905,"_30242":3697,"_29718":11975,"_34763":6413,"_34765":3288,"_29258":14988,"_34768":6039,"_34770":3383,"_34772":6497,"_30164":5607,"_29339":5912,"_28675":3979,"_34777":19799,