view.mdx",{"_53":379,"_60":98,"_73":-7,"_55":380},"es:_7","Kubernetes autogestionado",{"_53":382,"_60":70,"_55":383,"_64":384,"_73":-7,"_12":385,"_75":386},"es:deployment/self-hosted/overview.mdx","Kubernetes self-managed","Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.","/docs/pr-preview/pr-61/es/deployment/self-hosted/overview",{"_77":387},"deployment/self-hosted/overview.mdx",{"_53":389,"_60":70,"_55":390,"_64":391,"_73":-7,"_12":392,"_75":393},"es:deployment/self-hosted/helm.mdx","Instala con Helm","Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.","/docs/pr-preview/pr-61/es/deployment/self-hosted/helm",{"_77":394},"deployment/self-hosted/helm.mdx",{"_53":396,"_60":70,"_55":397,"_64":398,"_73":-7,"_12":399,"_75":400},"es:deployment/self-hosted/networking.mdx","Expón el Gateway","Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.","/docs/pr-preview/pr-61/es/deployment/self-hosted/networking",{"_77":401},"deployment/self-hosted/networking.mdx",{"_53":403,"_60":70,"_55":404,"_64":405,"_73":-7,"_12":406,"_75":407},"es:deployment/self-hosted/fastlane.mdx","Fastlane","Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.","/docs/pr-preview/pr-61/es/deployment/self-hosted/fastlane",{"_77":408},"deployment/self-hosted/fastlane.mdx",{"_53":410,"_60":98,"_73":-7,"_55":411},"es:_8","Operación",{"_53":413,"_60":70,"_55":414,"_64":415,"_73":-7,"_12":416,"_75":417},"es:deployment/troubleshooting.mdx","Resolución de problemas de despliegue","Diagnostica acceso, salud de los servicios y dependencias de infraestructura.","/docs/pr-preview/pr-61/es/deployment/troubleshooting",{"_77":418},"deployment/troubleshooting.mdx",{"_53":420,"_60":98,"_73":-7,"_55":421},"es:_9","Otros modelos",{"_53":423,"_60":70,"_55":424,"_64":425,"_73":-7,"_12":426,"_75":427},"es:deployment/aws-ma