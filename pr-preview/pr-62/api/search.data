125419,"_40403":125422,"_40405":125425,"_40408":125428,"_40410":125431,"_40412":125434,"_40414":125437,"_40416":125440,"_40418":125443,"_40420":125446,"_40422":125449,"_40424":125452,"_40426":125455,"_40428":125458,"_40430":125461,"_40432":125464,"_40434":125467,"_40436":125470,"_40438":125473,"_40440":125476,"_40442":125479,"_40444":125482,"_40446":125485,"_40448":125488,"_40450":125491,"_40452":125494,"_40454":125497,"_40456":125500,"_40458":125503,"_40460":125506,"_40462":125509,"_40464":125512,"_40466":125515,"_40468":125518,"_40471":125521,"_40473":125524,"_40475":125527,"_40477":125530,"_40479":125533,"_40481":125536,"_40483":125539,"_40485":125542,"_40487":125545,"_40489":125548,"_40491":125551,"_40493":125554,"_40495":125557,"_40497":125560,"_40499":125563,"_40501":125566,"_40503":125569,"_40505":125572,"_40507":125575,"_40509":125578,"_40512":125581,"_40514":125584,"_40516":125587,"_40518":125590,"_40520":125593,"_40522":125596,"_40524":125599,"_40526":125602,"_40528":125605,"_40530":125608,"_40532":125611,"_40534":125614,"_40536":125617,"_40538":125620,"_40540":125623,"_40542":125626,"_40544":125629,"_40546":125632,"_40548":125635,"_40550":125638,"_40552":125641,"_40554":125644,"_40556":125647,"_40558":125650,"_40560":125653,"_40562":125656,"_40565":125659,"_40567":125662,"_40569":125665},{"_3471":70385,"_30355":70385,"_5":14772,"_2954":116716,"_30708":116717,"_21010":116720,"_27589":70385},"Despliega desde AWS Marketplace",[49453,116718,116719],"Despliegue","Otros modelos",[],{"_3471":70386,"_30355":70385,"_21010":116722,"_5":14420,"_27589":70385,"_2954":116723},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3471":70387,"_30355":70385,"_5":30705,"_21010":116725,"_27589":116726,"_2954":116727},[],"/docs/pr-preview/pr-62/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3471":70388,"_30355":70385,"_5":30705,"_21010":116729,"_27589":116730,"_2954":116731},[],"/docs/pr-preview/pr-62/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3471":70389,"_30355":70385,"_5":30705,"_21010":116733,"_27589":116734,"_2954":116735},[],"/docs/pr-preview/pr-62/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3471":70390,"_30355":70385,"_5":30705,"_21010":116737,"_27589":116738,"_2954":116739},[],"/docs/pr-preview/pr-62/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3471":70391,"_30355":70385,"_5":30705,"_21010":116741,"_27589":116742,"_2954":116743},[],"/docs/pr-preview/pr-62/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3471":70392,"_30355":70385,"_5":30705,"_21010":116745,"_27589":116746,"_2954":116747},[],"/docs/pr-preview/pr-62/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3471":70393,"_30355":70385,"_5":30705,"_21010":116749,"_27589":116750,"_2954":116751},[],"/docs/pr-preview/pr-62/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3471":70394,"_30355":70385,"_21010":116753,"_5":14420,"_27589":70385,"_2954":116754},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3471":70395,"_30355":70385,"_21010":116756,"_5":14420,"_27589":116726,"_2954":116757},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3471":70396,"_30355":70385,"_21010":116759,"_5":14420,"_27589":116726,"_2954":116760},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3471":70397,"_30355":70385,"_21010":116762,"_5":14420,"_27589":116726,"_2954":116763},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3471":70398,"_30355":70385,"_21010":116765,"_5":14420,"_27589":116730,"_2954":116766},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3471":70399,"_30355":70385,"_21010":116768,"_5":14420,"_27589":116730,"_2954":116769},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3471":70400,"_30355":70385,"_21010":116771,"_5":14420,"_27589":116730,"_2954":116772},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3471":70401,"_30355":70385,"_21010":116774,"_5":14420,"_27589":116734,"_2954":116775},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3471":70402,"_30355":70385,"_21010":116777,"_5":14420,"_27589":116738,"_2954":116778},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3471":70403,"_30355":70385,"_21010":116780,"_5":14420,"_27589":116742,"_2954":116781},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3471":70404,"_30355":70385,"_21010":116783,"_5":14420,"_27589":116746,"_2954":116784},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3471":70405,"_30355":70385,"_21010":116786,"_5":14420,"_27589":116750,"_2954":116787},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3471":70406,"_30355":70406,"_5":14772,"_2954":116789,"_30708":116790,"_21010":116791,"_27589":70406},"Despliega Lamassu",[49453,116718],[],{"_3471":70407,"_30355":70406,"_21010":116793,"_5":14420,"_27589":70406,"_2954":116794},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3471":70408,"_30355":70406,"_5":30705,"_21010":116796,"_27589":116797,"_2954":116798},[],"/docs/pr-preview/pr-62/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3471":70409,"_30355":70406,"_5":30705,"_21010":116800,"_27589":116801,"_2954":116802},[],"/docs/pr-preview/pr-62/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3471":70410,"_30355":70406,"_5":30705,"_21010":116804,"_27589":116805,"_2954":116806},[],"/docs/pr-preview/pr-62/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3471":70411,"_30355":70406,"_21010":116808,"_5":14420,"_27589":70406,"_2954":116809},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3471":70412,"_30355":70406,"_21010":116811,"_5":14420,"_27589":116797,"_2954":116812},[],"Modelo",{"_3471":70413,"_30355":70406,"_21010":116814,"_5":14420,"_27589":116797,"_2954":116815},[],"Recomendado para",{"_3471":70414,"_30355":70406,"_21010":116817,"_5":14420,"_27589":116797,"_2954":116818},[],"Quién opera la infraestructura",{"_3471":70415,"_30355":70406,"_21010":116820,"_5":14420,"_27589":116797,"_2954":116821},[],"Punto de partida",{"_3471":70416,"_30355":70406,"_21010":116823,"_5":14420,"_27589":116797,"_2954":49560},[],{"_3471":70417,"_30355":70406,"_21010":116825,"_5":14420,"_27589":116797,"_2954":116826},[],"Producción, entornos regulados y despliegues personalizados",{"_3471":70418,"_30355":70406,"_21010":116828,"_5":14420,"_27589":116797,"_2954":116829},[],"Tu equipo",{"_3471":70419,"_30355":70406,"_21010":116831,"_5":14420,"_27589":116797,"_2954":116832},[],"Helm o Fastlane",{"_3471":70420,"_30355":70406,"_21010":116834,"_5":14420,"_27589":116797,"_2954":49572},[],{"_3471":70421,"_30355":70406,"_21010":116836,"_5":14420,"_27589":116797,"_2954":116837},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3471":70422,"_30355":70406,"_21010":116839,"_5":14420,"_27589":116797,"_2954":116829},[],{"_3471":70423,"_30355":70406,"_21010":116841,"_5":14420,"_27589":116797,"_2954":116842},[],"Imagen preconfigurada en EC2",{"_3471":70424,"_30355":70406,"_21010":116844,"_5":14420,"_27589":116797,"_2954":49583},[],{"_3471":70425,"_30355":70406,"_21010":116846,"_5":14420,"_27589":116797,"_2954":116847},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3471":70426,"_30355":70406,"_21010":116849,"_5":14420,"_27589":116797,"_2954":49589},[],{"_3471":70427,"_30355":70406,"_21010":116851,"_5":14420,"_27589":116797,"_2954":116852},[],"Suscripción gestionada",{"_3471":70428,"_30355":70406,"_21010":116854,"_5":14420,"_27589":116797,"_2954":116855},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3471":70429,"_30355":70406,"_21010":116857,"_5":14420,"_27589":116797,"_2954":116858},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3471":70430,"_30355":70406,"_21010":116860,"_5":14420,"_27589":116797,"_2954":116861},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3471":70431,"_30355":70406,"_21010":116863,"_5":14420,"_27589":116801,"_2954":116864},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3471":70432,"_30355":70406,"_21010":116866,"_5":14420,"_27589":116805,"_2954":116867},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3471":70433,"_30355":70433,"_5":14772,"_2954":116869,"_30708":116870,"_21010":116871,"_27589":70433},"Utiliza Lamassu como SaaS",[49453,116718,116719],[],{"_3471":70434,"_30355":70433,"_21010":116873,"_5":14420,"_27589":70433,"_2954":116874},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3471":70435,"_30355":70433,"_5":30705,"_21010":116876,"_27589":116877,"_2954":116878},[],"/docs/pr-preview/pr-62/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3471":70436,"_30355":70433,"_5":30705,"_21010":116880,"_27589":116881,"_2954":116882},[],"/docs/pr-preview/pr-62/es/deployment/saas#planes","Planes",{"_3471":70437,"_30355":70433,"_5":30705,"_21010":116884,"_27589":116885,"_2954":116886},[],"/docs/pr-preview/pr-62/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3471":70438,"_30355":70433,"_21010":116888,"_5":14420,"_27589":70433,"_2954":116889},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3471":70439,"_30355":70433,"_21010":116891,"_5":14420,"_27589":116877,"_2954":116892},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3471":70440,"_30355":70433,"_21010":116894,"_5":14420,"_27589":116877,"_2954":116895},[],"Copias de seguridad automáticas.",{"_3471":70441,"_30355":70433,"_21010":116897,"_5":14420,"_27589":116877,"_2954":116898},[],"Actualizaciones de versión.",{"_3471":70442,"_30355":70433,"_21010":116900,"_5":14420,"_27589":116877,"_2954":116901},[],"Soporte técnico y SLA según el plan contratado.",{"_3471":70443,"_30355":70433,"_21010":116903,"_5":14420,"_27589":116881,"_2954":49644},[],{"_3471":70444,"_30355":70433,"_21010":116905,"_5":14420,"_27589":116881,"_2954":116906},[],"Dispositivos",{"_3471":70445,"_30355":70433,"_21010":116908,"_5":14420,"_27589":116881,"_2954":116909},[],"Soporte",{"_3471":70446,"_30355":70433,"_21010":116911,"_5":14420,"_27589":116881,"_2954":49653},[],{"_3471":70447,"_30355":70433,"_21010":116913,"_5":14420,"_27589":116881,"_2954":49656},[],{"_3471":70448,"_30355":70433,"_21010":116915,"_5":14420,"_27589":116881,"_2954":116916},[],"Hasta 1.000",{"_3471":70449,"_30355":70433,"_21010":116918,"_5":14420,"_27589":116881,"_2954":49662},[],{"_3471":70450,"_30355":70433,"_21010":116920,"_5":14420,"_27589":116881,"_2954":116921},[],"99,5 %",{"_3471":70451,"_30355":70433,"_21010":116923,"_5":14420,"_27589":116881,"_2954":49668},[],{"_3471":70452,"_30355":70433,"_21010":116925,"_5":14420,"_27589":116881,"_2954":116926},[],"Hasta 10.000",{"_3471":70453,"_30355":70433,"_21010":116928,"_5":14420,"_27589":116881,"_2954":116929},[],"Email y chat",{"_3471":70454,"_30355":70433,"_21010":116931,"_5":14420,"_27589":116881,"_2954":116932},[],"99,9 %",{"_3471":70455,"_30355":70433,"_21010":116934,"_5":14420,"_27589":116881,"_2954":49680},[],{"_3471":70456,"_30355":70433,"_21010":116936,"_5":14420,"_27589":116881,"_2954":116937},[],"Ilimitados",{"_3471":70457,"_30355":70433,"_21010":116939,"_5":14420,"_27589":116881,"_2954":116940},[],"Dedicado",{"_3471":70458,"_30355":70433,"_21010":116942,"_5":14420,"_27589":116881,"_2954":116943},[],"99,99 %",{"_3471":70459,"_30355":70433,"_21010":116945,"_5":14420,"_27589":116885,"_2954":116946},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3471":70460,"_30355":70433,"_21010":116948,"_5":14420,"_27589":116885,"_2954":116949},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3471":70461,"_30355":70461,"_5":14772,"_2954":49697,"_30708":116951,"_21010":116953,"_27589":70461},[49453,116718,116952],"Kubernetes autogestionado",[],{"_3471":70462,"_30355":70461,"_21010":116955,"_5":14420,"_27589":70461,"_2954":116956},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3471":70463,"_30355":70461,"_5":30705,"_21010":116958,"_27589":116959,"_2954":116960},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3471":70464,"_30355":70461,"_5":30705,"_21010":116962,"_27589":116963,"_2954":116964},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3471":70465,"_30355":70461,"_5":30705,"_21010":116966,"_27589":116967,"_2954":116968},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3471":70466,"_30355":70461,"_5":30705,"_21010":116970,"_27589":116971,"_2954":116972},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3471":70467,"_30355":70461,"_5":30705,"_21010":116974,"_27589":116975,"_2954":116976},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3471":70468,"_30355":70461,"_5":30705,"_21010":116978,"_27589":116979,"_2954":116980},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3471":70469,"_30355":70461,"_5":30705,"_21010":116982,"_27589":116983,"_2954":116984},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3471":70470,"_30355":70461,"_5":30705,"_21010":116986,"_27589":116987,"_2954":116988},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3471":70471,"_30355":70461,"_5":30705,"_21010":116990,"_27589":116991,"_2954":116992},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3471":70472,"_30355":70461,"_5":30705,"_21010":116994,"_27589":116995,"_2954":116996},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3471":70473,"_30355":70461,"_5":30705,"_21010":116998,"_27589":116999,"_2954":117000},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3471":70474,"_30355":70461,"_21010":117002,"_5":14420,"_27589":116959,"_2954":117003},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3471":70475,"_30355":70461,"_21010":117005,"_5":14420,"_27589":116959,"_2954":117006},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3471":70476,"_30355":70461,"_21010":117008,"_5":14420,"_27589":116963,"_2954":117009},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3471":70477,"_30355":70461,"_21010":117011,"_5":14420,"_27589":116963,"_2954":117012},[],"Fastlane instala o configura",{"_3471":70478,"_30355":70461,"_21010":117014,"_5":14420,"_27589":116963,"_2954":117015},[],"Tú sigues proporcionando",{"_3471":70479,"_30355":70461,"_21010":117017,"_5":14420,"_27589":116963,"_2954":117018},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3471":70480,"_30355":70461,"_21010":117020,"_5":14420,"_27589":116963,"_2954":117021},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3471":70481,"_30355":70461,"_21010":117023,"_5":14420,"_27589":116963,"_2954":117024},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3471":70482,"_30355":70461,"_21010":117026,"_5":14420,"_27589":116963,"_2954":117027},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3471":70483,"_30355":70461,"_21010":117029,"_5":14420,"_27589":116963,"_2954":117030},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3471":70484,"_30355":70461,"_21010":117032,"_5":14420,"_27589":116963,"_2954":117033},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3471":70485,"_30355":70461,"_21010":117035,"_5":14420,"_27589":116963,"_2954":117036},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3471":70486,"_30355":70461,"_21010":117038,"_5":14420,"_27589":116963,"_2954":117039},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3471":70487,"_30355":70461,"_21010":117041,"_5":14420,"_27589":116963,"_2954":117042},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3471":70488,"_30355":70461,"_21010":117044,"_5":14420,"_27589":116967,"_2954":117045},[],"Necesitas:",{"_3471":70489,"_30355":70461,"_21010":117047,"_5":14420,"_27589":116967,"_2954":117048},[],"un clúster Kubernetes existente",{"_3471":70490,"_30355":70461,"_21010":117050,"_5":14420,"_27589":116967,"_2954":117051},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3471":70491,"_30355":70461,"_21010":117053,"_5":14420,"_27589":116967,"_2954":49799},[],{"_3471":70492,"_30355":70461,"_21010":117055,"_5":14420,"_27589":116967,"_2954":23761},[],{"_3471":70493,"_30355":70461,"_21010":117057,"_5":14420,"_27589":116967,"_2954":117058},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3471":70494,"_30355":70461,"_21010":117060,"_5":14420,"_27589":116967,"_2954":117061},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3471":70495,"_30355":70461,"_21010":117063,"_5":14420,"_27589":116967,"_2954":117064},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3471":70496,"_30355":70461,"_21010":117066,"_5":14420,"_27589":116967,"_2954":117067},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3471":70497,"_30355":70461,"_21010":117069,"_5":14420,"_27589":116967,"_2954":117070},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3471":70498,"_30355":70461,"_21010":117072,"_5":14420,"_27589":116971,"_2954":117073},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3471":70499,"_30355":70461,"_21010":117075,"_5":14420,"_27589":116971,"_2954":117076},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3471":70500,"_30355":70461,"_21010":117078,"_5":14420,"_27589":116975,"_2954":117079},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3471":70501,"_30355":70461,"_21010":117081,"_5":14420,"_27589":116975,"_2954":117082},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3471":70502,"_30355":70461,"_21010":117084,"_5":14420,"_27589":116975,"_2954":117085},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3471":70503,"_30355":70461,"_21010":117087,"_5":14420,"_27589":116975,"_2954":117088},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3471":70504,"_30355":70461,"_21010":117090,"_5":14420,"_27589":116979,"_2954":117091},[],"Opción",{"_3471":70505,"_30355":70461,"_21010":117093,"_5":14420,"_27589":116979,"_2954":117094},[],"Valor predeterminado",{"_3471":70506,"_30355":70461,"_21010":117096,"_5":14420,"_27589":116979,"_2954":117097},[],"Propósito",{"_3471":70507,"_30355":70461,"_21010":117099,"_5":14420,"_27589":116979,"_2954":49846},[],{"_3471":70508,"_30355":70461,"_21010":117101,"_5":14420,"_27589":116979,"_2954":49849},[],{"_3471":70509,"_30355":70461,"_21010":117103,"_5":14420,"_27589":116979,"_2954":117104},[],"Muestra la ayuda",{"_3471":70510,"_30355":70461,"_21010":117106,"_5":14420,"_27589":116979,"_2954":49855},[],{"_3471":70511,"_30355":70461,"_21010":117108,"_5":14420,"_27589":116979,"_2954":117109},[],"contexto actual",{"_3471":70512,"_30355":70461,"_21010":117111,"_5":14420,"_27589":116979,"_2954":117112},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3471":70513,"_30355":70461,"_21010":117114,"_5":14420,"_27589":116979,"_2954":49864},[],{"_3471":70514,"_30355":70461,"_21010":117116,"_5":14420,"_27589":116979,"_2954":6569},[],{"_3471":70515,"_30355":70461,"_21010":117118,"_5":14420,"_27589":116979,"_2954":117119},[],"Omite prompts y genera credenciales para las dependencias",{"_3471":70516,"_30355":70461,"_21010":117121,"_5":14420,"_27589":116979,"_2954":49872},[],{"_3471":70517,"_30355":70461,"_21010":117123,"_5":14420,"_27589":116979,"_2954":49875},[],{"_3471":70518,"_30355":70461,"_21010":117125,"_5":14420,"_27589":116979,"_2954":117126},[],"Namespace de la instalación",{"_3471":70519,"_30355":70461,"_21010":117128,"_5":14420,"_27589":116979,"_2954":49881},[],{"_3471":70520,"_30355":70461,"_21010":117130,"_5":14420,"_27589":116979,"_2954":49884},[],{"_3471":70521,"_30355":70461,"_21010":117132,"_5":14420,"_27589":116979,"_2954":117133},[],"Dominio usado por la UI, OIDC y el certificado",{"_3471":70522,"_30355":70461,"_21010":117135,"_5":14420,"_27589":116979,"_2954":49890},[],{"_3471":70523,"_30355":70461,"_21010":117137,"_5":14420,"_27589":116979,"_2954":15124},[],{"_3471":70524,"_30355":70461,"_21010":117139,"_5":14420,"_27589":116979,"_2954":117140},[],"Versión del chart de Lamassu",{"_3471":70525,"_30355":70461,"_21010":117142,"_5":14420,"_27589":116979,"_2954":49898},[],{"_3471":70526,"_30355":70461,"_21010":117144,"_5":14420,"_27589":116979,"_2954":49901},[],{"_3471":70527,"_30355":70461,"_21010":117146,"_5":14420,"_27589":116979,"_2954":117147},[],"Puerto del listener HTTPS",{"_3471":70528,"_30355":70461,"_21010":117149,"_5":14420,"_27589":116979,"_2954":49907},[],{"_3471":70529,"_30355":70461,"_21010":117151,"_5":14420,"_27589":116979,"_2954":49910},[],{"_3471":70530,"_30355":70461,"_21010":117153,"_5":14420,"_27589":116979,"_2954":117154},[],"Puerto del listener HTTP",{"_3471":70531,"_30355":70461,"_21010":117156,"_5":14420,"_27589":116979,"_2954":49916},[],{"_3471":70532,"_30355":70461,"_21010":117158,"_5":14420,"_27589":116979,"_2954":49849},[],{"_3471":70533,"_30355":70461,"_21010":117160,"_5":14420,"_27589":116979,"_2954":117161},[],"Certificado PEM para TLS downstream",{"_3471":70534,"_30355":70461,"_21010":117163,"_5":14420,"_27589":116979,"_2954":49924},[],{"_3471":70535,"_30355":70461,"_21010":117165,"_5":14420,"_27589":116979,"_2954":49849},[],{"_3471":70536,"_30355":70461,"_21010":117167,"_5":14420,"_27589":116979,"_2954":117168},[],"Clave privada PEM para TLS downstream",{"_3471":70537,"_30355":70461,"_21010":117170,"_5":14420,"_27589":116979,"_2954":49932},[],{"_3471":70538,"_30355":70461,"_21010":117172,"_5":14420,"_27589":116979,"_2954":117173},[],"chart del repositorio",{"_3471":70539,"_30355":70461,"_21010":117175,"_5":14420,"_27589":116979,"_2954":117176},[],"Usa un chart local de Lamassu sin empaquetar",{"_3471":70540,"_30355":70461,"_21010":117178,"_5":14420,"_27589":116979,"_2954":49941},[],{"_3471":70541,"_30355":70461,"_21010":117180,"_5":14420,"_27589":116979,"_2954":117181},[],"detección automática",{"_3471":70542,"_30355":70461,"_21010":117183,"_5":14420,"_27589":116979,"_2954":117184},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3471":70543,"_30355":70461,"_21010":117186,"_5":14420,"_27589":116979,"_2954":49949},[],{"_3471":70544,"_30355":70461,"_21010":117188,"_5":14420,"_27589":116979,"_2954":6569},[],{"_3471":70545,"_30355":70461,"_21010":117190,"_5":14420,"_27589":116979,"_2954":117191},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3471":70546,"_30355":70461,"_21010":117193,"_5":14420,"_27589":116979,"_2954":49957},[],{"_3471":70547,"_30355":70461,"_21010":117195,"_5":14420,"_27589":116979,"_2954":6569},[],{"_3471":70548,"_30355":70461,"_21010":117197,"_5":14420,"_27589":116979,"_2954":117198},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3471":70549,"_30355":70461,"_21010":117200,"_5":14420,"_27589":116979,"_2954":49965},[],{"_3471":70550,"_30355":70461,"_21010":117202,"_5":14420,"_27589":116979,"_2954":6569},[],{"_3471":70551,"_30355":70461,"_21010":117204,"_5":14420,"_27589":116979,"_2954":117205},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3471":70552,"_30355":70461,"_21010":117207,"_5":14420,"_27589":116979,"_2954":49973},[],{"_3471":70553,"_30355":70461,"_21010":117209,"_5":14420,"_27589":116979,"_2954":6569},[],{"_3471":70554,"_30355":70461,"_21010":117211,"_5":14420,"_27589":116979,"_2954":117212},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3471":70555,"_30355":70461,"_21010":117214,"_5":14420,"_27589":116979,"_2954":49981},[],{"_3471":70556,"_30355":70461,"_21010":117216,"_5":14420,"_27589":116979,"_2954":49984},[],{"_3471":70557,"_30355":70461,"_21010":117218,"_5":14420,"_27589":116979,"_2954":117219},[],"Usa otro chart local de SoftHSM",{"_3471":70558,"_30355":70461,"_21010":117221,"_5":14420,"_27589":116979,"_2954":117222},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3471":70559,"_30355":70461,"_21010":117224,"_5":14420,"_27589":116983,"_2954":117225},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3471":70560,"_30355":70461,"_21010":117227,"_5":14420,"_27589":116983,"_2954":117228},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3471":70561,"_30355":70461,"_21010":117230,"_5":14420,"_27589":116983,"_2954":117231},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3471":70562,"_30355":70461,"_21010":117233,"_5":14420,"_27589":116983,"_2954":117234},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3471":70563,"_30355":70461,"_21010":117236,"_5":14420,"_27589":116983,"_2954":117237},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3471":70564,"_30355":70461,"_21010":117239,"_5":14420,"_27589":116983,"_2954":117240},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3471":70565,"_30355":70461,"_21010":117242,"_5":14420,"_27589":116987,"_2954":50011},[],{"_3471":70566,"_30355":70461,"_21010":117244,"_5":14420,"_27589":116987,"_2954":117245},[],"valida las herramientas locales y el clúster seleccionado",{"_3471":70567,"_30355":70461,"_21010":117247,"_5":14420,"_27589":116987,"_2954":117248},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3471":70568,"_30355":70461,"_21010":117250,"_5":14420,"_27589":116987,"_2954":117251},[],"crea el namespace",{"_3471":70569,"_30355":70461,"_21010":117253,"_5":14420,"_27589":116987,"_2954":117254},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3471":70570,"_30355":70461,"_21010":117256,"_5":14420,"_27589":116987,"_2954":117257},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3471":70571,"_30355":70461,"_21010":117259,"_5":14420,"_27589":116987,"_2954":117260},[],"instala RabbitMQ",{"_3471":70572,"_30355":70461,"_21010":117262,"_5":14420,"_27589":116987,"_2954":117263},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3471":70573,"_30355":70461,"_21010":117265,"_5":14420,"_27589":116987,"_2954":117266},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3471":70574,"_30355":70461,"_21010":117268,"_5":14420,"_27589":116987,"_2954":117269},[],"carga datos de ejemplo opcionalmente",{"_3471":70575,"_30355":70461,"_21010":117271,"_5":14420,"_27589":116987,"_2954":117272},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3471":70576,"_30355":70461,"_21010":117274,"_5":14420,"_27589":116991,"_2954":117275},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3471":70577,"_30355":70461,"_21010":117277,"_5":14420,"_27589":116991,"_2954":117278},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3471":70578,"_30355":70461,"_21010":117280,"_5":14420,"_27589":116995,"_2954":117281},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3471":70579,"_30355":70461,"_21010":117283,"_5":14420,"_27589":116995,"_2954":117284},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3471":70580,"_30355":70461,"_21010":117286,"_5":14420,"_27589":116995,"_2954":117287},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3471":70581,"_30355":70461,"_21010":117289,"_5":14420,"_27589":116999,"_2954":117290},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3471":70582,"_30355":70582,"_5":14772,"_2954":117292,"_30708":117293,"_21010":117294,"_27589":70582},"Instala con Helm",[49453,116718,116952],[],{"_3471":70583,"_30355":70582,"_21010":117296,"_5":14420,"_27589":70582,"_2954":117297},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3471":70584,"_30355":70582,"_5":30705,"_21010":117299,"_27589":117300,"_2954":117301},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3471":70585,"_30355":70582,"_5":30705,"_21010":117303,"_27589":117304,"_2954":116968},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3471":70586,"_30355":70582,"_5":30705,"_21010":117306,"_27589":117307,"_2954":117308},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3471":70587,"_30355":70582,"_5":30705,"_21010":117310,"_27589":117311,"_2954":117312},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3471":70588,"_30355":70582,"_5":30705,"_21010":117314,"_27589":117315,"_2954":117316},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3471":70589,"_30355":70582,"_5":30705,"_21010":117318,"_27589":117319,"_2954":117320},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3471":70590,"_30355":70582,"_5":30705,"_21010":117322,"_27589":117323,"_2954":117324},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3471":70591,"_30355":70582,"_5":30705,"_21010":117326,"_27589":117327,"_2954":117328},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3471":70592,"_30355":70582,"_5":30705,"_21010":117330,"_27589":117331,"_2954":117332},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3471":70593,"_30355":70582,"_5":30705,"_21010":117334,"_27589":117335,"_2954":117336},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3471":70594,"_30355":70582,"_5":30705,"_21010":117338,"_27589":117339,"_2954":117340},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3471":70595,"_30355":70582,"_21010":117342,"_5":14420,"_27589":117300,"_2954":117343},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3471":70596,"_30355":70582,"_21010":117345,"_5":14420,"_27589":117304,"_2954":117346},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3471":70597,"_30355":70582,"_21010":117348,"_5":14420,"_27589":117304,"_2954":117349},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3471":70598,"_30355":70582,"_21010":117351,"_5":14420,"_27589":117304,"_2954":117352},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3471":70599,"_30355":70582,"_21010":117354,"_5":14420,"_27589":117304,"_2954":117355},[],"un broker RabbitMQ accesible y sus credenciales",{"_3471":70600,"_30355":70582,"_21010":117357,"_5":14420,"_27589":117304,"_2954":117358},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3471":70601,"_30355":70582,"_21010":117360,"_5":14420,"_27589":117304,"_2954":117361},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3471":70602,"_30355":70582,"_21010":117363,"_5":14420,"_27589":117304,"_2954":117364},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3471":70603,"_30355":70582,"_21010":117366,"_5":14420,"_27589":117304,"_2954":117367},[],"una StorageClass y un diseño de tráfico externo",{"_3471":70604,"_30355":70582,"_21010":117369,"_5":14420,"_27589":117304,"_2954":117370},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3471":70605,"_30355":70582,"_21010":117372,"_5":14420,"_27589":117304,"_2954":117373},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3471":70606,"_30355":70582,"_21010":117375,"_5":14420,"_27589":117304,"_2954":117376},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3471":70607,"_30355":70582,"_21010":117378,"_5":14420,"_27589":117307,"_2954":117379},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3471":70608,"_30355":70582,"_21010":117381,"_5":14420,"_27589":117307,"_2954":117382},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3471":70609,"_30355":70582,"_21010":117384,"_5":14420,"_27589":117307,"_2954":117385},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3471":70610,"_30355":70582,"_21010":117387,"_5":14420,"_27589":117311,"_2954":117388},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3471":70611,"_30355":70582,"_21010":117390,"_5":14420,"_27589":117311,"_2954":117391},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3471":70612,"_30355":70582,"_21010":117393,"_5":14420,"_27589":117311,"_2954":117394},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3471":70613,"_30355":70582,"_21010":117396,"_5":14420,"_27589":117311,"_2954":117397},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3471":70614,"_30355":70582,"_21010":117399,"_5":14420,"_27589":117315,"_2954":117400},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3471":70615,"_30355":70582,"_21010":117402,"_5":14420,"_27589":117319,"_2954":117403},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3471":70616,"_30355":70582,"_21010":117405,"_5":14420,"_27589":117319,"_2954":117406},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3471":70617,"_30355":70582,"_21010":117408,"_5":14420,"_27589":117319,"_2954":117409},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3471":70618,"_30355":70582,"_21010":117411,"_5":14420,"_27589":117319,"_2954":117412},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3471":70619,"_30355":70582,"_21010":117414,"_5":14420,"_27589":117319,"_2954":117415},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3471":70620,"_30355":70582,"_21010":117417,"_5":14420,"_27589":117319,"_2954":117418},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3471":70621,"_30355":70582,"_21010":117420,"_5":14420,"_27589":117319,"_2954":117421},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3471":70622,"_30355":70582,"_21010":117423,"_5":14420,"_27589":117323,"_2954":117424},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3471":70623,"_30355":70582,"_21010":117426,"_5":14420,"_27589":117323,"_2954":117427},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3471":70624,"_30355":70582,"_21010":117429,"_5":14420,"_27589":117323,"_2954":117430},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3471":70625,"_30355":70582,"_21010":117432,"_5":14420,"_27589":117323,"_2954":117433},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3471":70626,"_30355":70582,"_21010":117435,"_5":14420,"_27589":117327,"_2954":117436},[],"Para instalar un checkout local:",{"_3471":70627,"_30355":70582,"_21010":117438,"_5":14420,"_27589":117331,"_2954":117439},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3471":70628,"_30355":70582,"_21010":117441,"_5":14420,"_27589":117331,"_2954":117442},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3471":70629,"_30355":70582,"_21010":117444,"_5":14420,"_27589":117335,"_2954":117445},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3471":70630,"_30355":70582,"_21010":117447,"_5":14420,"_27589":117335,"_2954":117448},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3471":70631,"_30355":70582,"_21010":117450,"_5":14420,"_27589":117335,"_2954":117451},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3471":70632,"_30355":70582,"_21010":117453,"_5":14420,"_27589":117335,"_2954":117454},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3471":70633,"_30355":70582,"_21010":117456,"_5":14420,"_27589":117335,"_2954":117457},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3471":70634,"_30355":70582,"_21010":117459,"_5":14420,"_27589":117339,"_2954":117460},[],"Antes de pasar a producción, revisa:",{"_3471":70635,"_30355":70582,"_21010":117462,"_5":14420,"_27589":117339,"_2954":117463},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3471":70636,"_30355":70582,"_21010":117465,"_5":14420,"_27589":117339,"_2954":117466},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3471":70637,"_30355":70582,"_21010":117468,"_5":14420,"_27589":117339,"_2954":117469},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3471":70638,"_30355":70582,"_21010":117471,"_5":14420,"_27589":117339,"_2954":117472},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3471":70639,"_30355":70582,"_21010":117474,"_5":14420,"_27589":117339,"_2954":117475},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3471":70640,"_30355":70582,"_21010":117477,"_5":14420,"_27589":117339,"_2954":117478},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3471":70641,"_30355":70582,"_21010":117480,"_5":14420,"_27589":117339,"_2954":117481},[],"SMTP, observabilidad y entrega de alertas",{"_3471":70642,"_30355":70582,"_21010":117483,"_5":14420,"_27589":117339,"_2954":117484},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3471":70643,"_30355":70582,"_21010":117486,"_5":14420,"_27589":117339,"_2954":117487},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3471":70644,"_30355":70644,"_5":14772,"_2954":117489,"_30708":117490,"_21010":117491,"_27589":70644},"Expón el Gateway",[49453,116718,116952],[],{"_3471":70645,"_30355":70644,"_21010":117493,"_5":14420,"_27589":70644,"_2954":117494},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3471":70646,"_30355":70644,"_5":30705,"_21010":117496,"_27589":117497,"_2954":117498},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3471":70647,"_30355":70644,"_5":30705,"_21010":117500,"_27589":117501,"_2954":117502},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3471":70648,"_30355":70644,"_5":30705,"_21010":117504,"_27589":117505,"_2954":117506},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3471":70649,"_30355":70644,"_5":30705,"_21010":117508,"_27589":117509,"_2954":50279},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#k3s",{"_3471":70650,"_30355":70644,"_5":30705,"_21010":117511,"_27589":117512,"_2954":117513},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3471":70651,"_30355":70644,"_5":30705,"_21010":117515,"_27589":117516,"_2954":117517},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3471":70652,"_30355":70644,"_5":30705,"_21010":117519,"_27589":117520,"_2954":117521},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3471":70653,"_30355":70644,"_5":30705,"_21010":117523,"_27589":117524,"_2954":117525},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3471":70654,"_30355":70644,"_5":30705,"_21010":117527,"_27589":117528,"_2954":117529},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3471":70655,"_30355":70644,"_5":30705,"_21010":117531,"_27589":117532,"_2954":117533},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3471":70656,"_30355":70644,"_5":30705,"_21010":117535,"_27589":117536,"_2954":117537},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3471":70657,"_30355":70644,"_21010":117539,"_5":14420,"_27589":117497,"_2954":117540},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3471":70658,"_30355":70644,"_21010":117542,"_5":14420,"_27589":117497,"_2954":117543},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3471":70659,"_30355":70644,"_21010":117545,"_5":14420,"_27589":117501,"_2954":117546},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3471":70660,"_30355":70644,"_21010":117548,"_5":14420,"_27589":117501,"_2954":117549},[],"Defínelo únicamente cuando:",{"_3471":70661,"_30355":70644,"_21010":117551,"_5":14420,"_27589":117501,"_2954":117552},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3471":70662,"_30355":70644,"_21010":117554,"_5":14420,"_27589":117501,"_2954":117555},[],"esa dirección está asignada a este Gateway",{"_3471":70663,"_30355":70644,"_21010":117557,"_5":14420,"_27589":117501,"_2954":117558},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3471":70664,"_30355":70644,"_21010":117560,"_5":14420,"_27589":117501,"_2954":117561},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3471":70665,"_30355":70644,"_21010":117563,"_5":14420,"_27589":117501,"_2954":117564},[],"No confundas estos valores:",{"_3471":70666,"_30355":70644,"_21010":117566,"_5":14420,"_27589":117501,"_2954":117567},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3471":70667,"_30355":70644,"_21010":117569,"_5":14420,"_27589":117501,"_2954":117570},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3471":70668,"_30355":70644,"_21010":117572,"_5":14420,"_27589":117501,"_2954":117573},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3471":70669,"_30355":70644,"_21010":117575,"_5":14420,"_27589":117505,"_2954":117576},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3471":70670,"_30355":70644,"_21010":117578,"_5":14420,"_27589":117505,"_2954":117579},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3471":70671,"_30355":70644,"_21010":117581,"_5":14420,"_27589":117509,"_2954":117582},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3471":70672,"_30355":70644,"_21010":117584,"_5":14420,"_27589":117509,"_2954":117585},[],"Para el diseño recomendado:",{"_3471":70673,"_30355":70644,"_21010":117587,"_5":14420,"_27589":117509,"_2954":117588},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3471":70674,"_30355":70644,"_21010":117590,"_5":14420,"_27589":117509,"_2954":117591},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3471":70675,"_30355":70644,"_21010":117593,"_5":14420,"_27589":117509,"_2954":117594},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3471":70676,"_30355":70644,"_21010":117596,"_5":14420,"_27589":117509,"_2954":117597},[],"Apunta DNS a la dirección accesible de la VM.",{"_3471":70677,"_30355":70644,"_21010":117599,"_5":14420,"_27589":117509,"_2954":117600},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3471":70678,"_30355":70644,"_21010":117602,"_5":14420,"_27589":117512,"_2954":117603},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3471":70679,"_30355":70644,"_21010":117605,"_5":14420,"_27589":117516,"_2954":117606},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3471":70680,"_30355":70644,"_21010":117608,"_5":14420,"_27589":117516,"_2954":117609},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3471":70681,"_30355":70644,"_21010":117611,"_5":14420,"_27589":117520,"_2954":117612},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3471":70682,"_30355":70644,"_21010":117614,"_5":14420,"_27589":117520,"_2954":117615},[],"Requisito",{"_3471":70683,"_30355":70644,"_21010":117617,"_5":14420,"_27589":117520,"_2954":117618},[],"Diseño recomendado",{"_3471":70684,"_30355":70644,"_21010":117620,"_5":14420,"_27589":117520,"_2954":117621},[],"Consecuencia",{"_3471":70685,"_30355":70644,"_21010":117623,"_5":14420,"_27589":117520,"_2954":117624},[],"Varias URL o servicios de Lamassu",{"_3471":70686,"_30355":70644,"_21010":117626,"_5":14420,"_27589":117520,"_2954":117627},[],"Un Gateway con varias rutas",{"_3471":70687,"_30355":70644,"_21010":117629,"_5":14420,"_27589":117520,"_2954":117630},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3471":70688,"_30355":70644,"_21010":117632,"_5":14420,"_27589":117520,"_2954":117633},[],"Gateways independientes e IP externas distintas",{"_3471":70689,"_30355":70644,"_21010":117635,"_5":14420,"_27589":117520,"_2954":117636},[],"Una VIP por Gateway",{"_3471":70690,"_30355":70644,"_21010":117638,"_5":14420,"_27589":117520,"_2954":117639},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3471":70691,"_30355":70644,"_21010":117641,"_5":14420,"_27589":117520,"_2954":117642},[],"Gateways independientes, un nodo y una IP",{"_3471":70692,"_30355":70644,"_21010":117644,"_5":14420,"_27589":117520,"_2954":117645},[],"Puertos externos diferentes",{"_3471":70693,"_30355":70644,"_21010":117647,"_5":14420,"_27589":117520,"_2954":117648},[],"Los clientes deben indicar puertos no estándar",{"_3471":70694,"_30355":70644,"_21010":117650,"_5":14420,"_27589":117520,"_2954":117651},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3471":70695,"_30355":70644,"_21010":117653,"_5":14420,"_27589":117520,"_2954":117654},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3471":70696,"_30355":70644,"_21010":117656,"_5":14420,"_27589":117520,"_2954":117657},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3471":70697,"_30355":70644,"_21010":117659,"_5":14420,"_27589":117520,"_2954":117660},[],"Recursos Gateway separados pero proxy compartido",{"_3471":70698,"_30355":70644,"_21010":117662,"_5":14420,"_27589":117520,"_2954":117663},[],"Modo merged Gateway de Envoy",{"_3471":70699,"_30355":70644,"_21010":117665,"_5":14420,"_27589":117520,"_2954":117666},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3471":70700,"_30355":70644,"_21010":117668,"_5":14420,"_27589":117520,"_2954":117669},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3471":70701,"_30355":70644,"_21010":117671,"_5":14420,"_27589":117520,"_2954":117672},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3471":70702,"_30355":70644,"_21010":117674,"_5":14420,"_27589":117520,"_2954":117675},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3471":70703,"_30355":70644,"_21010":117677,"_5":14420,"_27589":117520,"_2954":117678},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3471":70704,"_30355":70644,"_21010":117680,"_5":14420,"_27589":117524,"_2954":117681},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3471":70705,"_30355":70644,"_21010":117683,"_5":14420,"_27589":117528,"_2954":117684},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3471":70706,"_30355":70644,"_21010":117686,"_5":14420,"_27589":117528,"_2954":117687},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3471":70707,"_30355":70644,"_21010":117689,"_5":14420,"_27589":117528,"_2954":117690},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3471":70708,"_30355":70644,"_21010":117692,"_5":14420,"_27589":117528,"_2954":117693},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3471":70709,"_30355":70644,"_21010":117695,"_5":14420,"_27589":117528,"_2954":117696},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3471":70710,"_30355":70644,"_21010":117698,"_5":14420,"_27589":117532,"_2954":117699},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3471":70711,"_30355":70644,"_21010":117701,"_5":14420,"_27589":117532,"_2954":117702},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3471":70712,"_30355":70644,"_21010":117704,"_5":14420,"_27589":117536,"_2954":117705},[],"Comprueba, en orden:",{"_3471":70713,"_30355":70644,"_21010":117707,"_5":14420,"_27589":117536,"_2954":117708},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3471":70714,"_30355":70644,"_21010":117710,"_5":14420,"_27589":117536,"_2954":117711},[],"Su estado contiene la dirección esperada.",{"_3471":70715,"_30355":70644,"_21010":117713,"_5":14420,"_27589":117536,"_2954":117714},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3471":70716,"_30355":70644,"_21010":117716,"_5":14420,"_27589":117536,"_2954":117717},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3471":70717,"_30355":70644,"_21010":117719,"_5":14420,"_27589":117536,"_2954":117720},[],"DNS resuelve al endpoint accesible externamente.",{"_3471":70718,"_30355":70644,"_21010":117722,"_5":14420,"_27589":117536,"_2954":117723},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3471":70719,"_30355":70644,"_21010":117725,"_5":14420,"_27589":117536,"_2954":117726},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3471":70720,"_30355":70720,"_5":14772,"_2954":49560,"_30708":117728,"_21010":117729,"_27589":70720},[49453,116718,116952],[],{"_3471":70721,"_30355":70720,"_21010":117731,"_5":14420,"_27589":70720,"_2954":117732},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3471":70722,"_30355":70720,"_5":30705,"_21010":117734,"_27589":117735,"_2954":117736},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3471":70723,"_30355":70720,"_5":30705,"_21010":117738,"_27589":117739,"_2954":117740},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3471":70724,"_30355":70720,"_5":30705,"_21010":117742,"_27589":117743,"_2954":117744},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3471":70725,"_30355":70720,"_5":30705,"_21010":117746,"_27589":117747,"_2954":117748},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3471":70726,"_30355":70720,"_5":30705,"_21010":117750,"_27589":117751,"_2954":117752},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3471":70727,"_30355":70720,"_5":30705,"_21010":117754,"_27589":117755,"_2954":117756},[],"/docs/pr-preview/pr-62/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3471":70728,"_30355":70720,"_21010":117758,"_5":14420,"_27589":117735,"_2954":117759},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3471":70729,"_30355":70720,"_21010":117761,"_5":14420,"_27589":117739,"_2954":117762},[],"Flujo",{"_3471":70730,"_30355":70720,"_21010":117764,"_5":14420,"_27589":117739,"_2954":117765},[],"Úsalo para",{"_3471":70731,"_30355":70720,"_21010":117767,"_5":14420,"_27589":117739,"_2954":117768},[],"Qué instala",{"_3471":70732,"_30355":70720,"_21010":117770,"_5":14420,"_27589":117739,"_2954":50541},[],{"_3471":70733,"_30355":70720,"_21010":117772,"_5":14420,"_27589":117739,"_2954":117773},[],"Producción y entornos controlados",{"_3471":70734,"_30355":70720,"_21010":117775,"_5":14420,"_27589":117739,"_2954":117776},[],"Servicios de Lamassu y recursos de Gateway API",{"_3471":70735,"_30355":70720,"_21010":117778,"_5":14420,"_27589":117739,"_2954":49697},[],{"_3471":70736,"_30355":70720,"_21010":117780,"_5":14420,"_27589":117739,"_2954":117781},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3471":70737,"_30355":70720,"_21010":117783,"_5":14420,"_27589":117739,"_2954":117784},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3471":70738,"_30355":70720,"_21010":117786,"_5":14420,"_27589":117743,"_2954":117787},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3471":70739,"_30355":70720,"_21010":117789,"_5":14420,"_27589":117743,"_2954":117790},[],"Área",{"_3471":70740,"_30355":70720,"_21010":117792,"_5":14420,"_27589":117743,"_2954":117793},[],"El chart de Lamassu proporciona",{"_3471":70741,"_30355":70720,"_21010":117795,"_5":14420,"_27589":117743,"_2954":117796},[],"Tú proporcionas",{"_3471":70742,"_30355":70720,"_21010":117798,"_5":14420,"_27589":117743,"_2954":117799},[],"Aplicaciones Lamassu",{"_3471":70743,"_30355":70720,"_21010":117801,"_5":14420,"_27589":117743,"_2954":117802},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3471":70744,"_30355":70720,"_21010":117804,"_5":14420,"_27589":117743,"_2954":117805},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3471":70745,"_30355":70720,"_21010":117807,"_5":14420,"_27589":117743,"_2954":117808},[],"Datos PostgreSQL",{"_3471":70746,"_30355":70720,"_21010":117810,"_5":14420,"_27589":117743,"_2954":117811},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3471":70747,"_30355":70720,"_21010":117813,"_5":14420,"_27589":117743,"_2954":117814},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3471":70748,"_30355":70720,"_21010":117816,"_5":14420,"_27589":117743,"_2954":117817},[],"Mensajería",{"_3471":70749,"_30355":70720,"_21010":117819,"_5":14420,"_27589":117743,"_2954":117820},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3471":70750,"_30355":70720,"_21010":117822,"_5":14420,"_27589":117743,"_2954":117823},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3471":70751,"_30355":70720,"_21010":117825,"_5":14420,"_27589":117743,"_2954":117826},[],"Identidad",{"_3471":70752,"_30355":70720,"_21010":117828,"_5":14420,"_27589":117743,"_2954":117829},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3471":70753,"_30355":70720,"_21010":117831,"_5":14420,"_27589":117743,"_2954":117832},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3471":70754,"_30355":70720,"_21010":117834,"_5":14420,"_27589":117743,"_2954":117835},[],"Enrutamiento externo",{"_3471":70755,"_30355":70720,"_21010":117837,"_5":14420,"_27589":117743,"_2954":117838},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3471":70756,"_30355":70720,"_21010":117840,"_5":14420,"_27589":117743,"_2954":117841},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3471":70757,"_30355":70720,"_21010":117843,"_5":14420,"_27589":117743,"_2954":50615},[],{"_3471":70758,"_30355":70720,"_21010":117845,"_5":14420,"_27589":117743,"_2954":117846},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3471":70759,"_30355":70720,"_21010":117848,"_5":14420,"_27589":117743,"_2954":117849},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3471":70760,"_30355":70720,"_21010":117851,"_5":14420,"_27589":117743,"_2954":117852},[],"Datos persistentes de la aplicación",{"_3471":70761,"_30355":70720,"_21010":117854,"_5":14420,"_27589":117743,"_2954":117855},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3471":70762,"_30355":70720,"_21010":117857,"_5":14420,"_27589":117743,"_2954":117858},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3471":70763,"_30355":70720,"_21010":117860,"_5":14420,"_27589":117743,"_2954":117861},[],"Integraciones opcionales",{"_3471":70764,"_30355":70720,"_21010":117863,"_5":14420,"_27589":117743,"_2954":117864},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3471":70765,"_30355":70720,"_21010":117866,"_5":14420,"_27589":117743,"_2954":117867},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3471":70766,"_30355":70720,"_21010":117869,"_5":14420,"_27589":117743,"_2954":117870},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3471":70767,"_30355":70720,"_21010":117872,"_5":14420,"_27589":117743,"_2954":117873},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3471":70768,"_30355":70720,"_21010":117875,"_5":14420,"_27589":117747,"_2954":117876},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3471":70769,"_30355":70720,"_21010":117878,"_5":14420,"_27589":117747,"_2954":117879},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3471":70770,"_30355":70720,"_21010":117881,"_5":14420,"_27589":117751,"_2954":117882},[],"Kubernetes 1.24 o posterior",{"_3471":70771,"_30355":70720,"_21010":117884,"_5":14420,"_27589":117751,"_2954":117885},[],"Helm 3.2 o posterior",{"_3471":70772,"_30355":70720,"_21010":117887,"_5":14420,"_27589":117751,"_2954":117888},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3471":70773,"_30355":70720,"_21010":117890,"_5":14420,"_27589":117751,"_2954":117891},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3471":70774,"_30355":70720,"_21010":117893,"_5":14420,"_27589":117751,"_2954":117894},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3471":70775,"_30355":70720,"_21010":117896,"_5":14420,"_27589":117751,"_2954":117897},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3471":70776,"_30355":70720,"_21010":117899,"_5":14420,"_27589":117751,"_2954":117900},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3471":70777,"_30355":70720,"_21010":117902,"_5":14420,"_27589":117755,"_2954":117903},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3471":70778,"_30355":70720,"_21010":117905,"_5":14420,"_27589":117755,"_2954":117906},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3471":70779,"_30355":70720,"_21010":117908,"_5":14420,"_27589":117755,"_2954":117909},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3471":70780,"_30355":70720,"_21010":117911,"_5":14420,"_27589":117755,"_2954":117912},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3471":70781,"_30355":70781,"_5":14772,"_2954":117914,"_30708":117915,"_21010":117917,"_27589":70781},"Resolución de problemas de despliegue",[49453,116718,117916],"Operación",[],{"_3471":70782,"_30355":70781,"_21010":117919,"_5":14420,"_27589":70781,"_2954":117920},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3471":70783,"_30355":70781,"_5":30705,"_21010":117922,"_27589":117923,"_2954":117924},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3471":70784,"_30355":70781,"_5":30705,"_21010":117926,"_27589":117927,"_2954":117928},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3471":70785,"_30355":70781,"_5":30705,"_21010":117930,"_27589":117931,"_2954":117932},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3471":70786,"_30355":70781,"_5":30705,"_21010":117934,"_27589":117935,"_2954":117936},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3471":70787,"_30355":70781,"_5":30705,"_21010":117938,"_27589":117939,"_2954":117940},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3471":70788,"_30355":70781,"_5":30705,"_21010":117942,"_27589":117943,"_2954":117944},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3471":70789,"_30355":70781,"_5":30705,"_21010":117946,"_27589":117947,"_2954":117948},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3471":70790,"_30355":70781,"_5":30705,"_21010":117950,"_27589":117951,"_2954":117952},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3471":70791,"_30355":70781,"_5":30705,"_21010":117954,"_27589":117955,"_2954":117956},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3471":70792,"_30355":70781,"_5":30705,"_21010":117958,"_27589":117959,"_2954":117960},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3471":70793,"_30355":70781,"_5":30705,"_21010":117962,"_27589":117963,"_2954":117964},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3471":70794,"_30355":70781,"_5":30705,"_21010":117966,"_27589":117967,"_2954":117968},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3471":70795,"_30355":70781,"_5":30705,"_21010":117970,"_27589":117971,"_2954":117972},[],"/docs/pr-preview/pr-62/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3471":70796,"_30355":70781,"_21010":117974,"_5":14420,"_27589":70781,"_2954":117975},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3471":70797,"_30355":70781,"_21010":117977,"_5":14420,"_27589":117927,"_2954":117978},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3471":70798,"_30355":70781,"_21010":117980,"_5":14420,"_27589":117931,"_2954":117981},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3471":70799,"_30355":70781,"_21010":117983,"_5":14420,"_27589":117935,"_2954":117984},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3471":70800,"_30355":70781,"_21010":117986,"_5":14420,"_27589":117939,"_2954":117987},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3471":70801,"_30355":70781,"_21010":117989,"_5":14420,"_27589":117943,"_2954":117990},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3471":70802,"_30355":70781,"_21010":117992,"_5":14420,"_27589":117947,"_2954":117993},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3471":70803,"_30355":70781,"_21010":117995,"_5":14420,"_27589":117947,"_2954":117996},[],"Ejecuta también la prueba de conectividad del chart:",{"_3471":70804,"_30355":70781,"_21010":117998,"_5":14420,"_27589":117947,"_2954":117999},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3471":70805,"_30355":70781,"_21010":118001,"_5":14420,"_27589":117947,"_2954":118002},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3471":70806,"_30355":70781,"_21010":118004,"_5":14420,"_27589":117951,"_2954":118005},[],"Si recibes un 401:",{"_3471":70807,"_30355":70781,"_21010":118007,"_5":14420,"_27589":117951,"_2954":118008},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3471":70808,"_30355":70781,"_21010":118010,"_5":14420,"_27589":117951,"_2954":118011},[],"verifica emisor, audiencia y expiración del token;",{"_3471":70809,"_30355":70781,"_21010":118013,"_5":14420,"_27589":117951,"_2954":118014},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3471":70810,"_30355":70781,"_21010":118016,"_5":14420,"_27589":117951,"_2954":118017},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3471":70811,"_30355":70781,"_21010":118019,"_5":14420,"_27589":117951,"_2954":118020},[],"Si el login termina pero las APIs devuelven 403:",{"_3471":70812,"_30355":70781,"_21010":118022,"_5":14420,"_27589":117951,"_2954":118023},[],"inspecciona los claims reales del token;",{"_3471":70813,"_30355":70781,"_21010":118025,"_5":14420,"_27589":117951,"_2954":118026},[],"confirma que coinciden con un principal activo;",{"_3471":70814,"_30355":70781,"_21010":118028,"_5":14420,"_27589":117951,"_2954":118029},[],"revisa las políticas concedidas al principal;",{"_3471":70815,"_30355":70781,"_21010":118031,"_5":14420,"_27589":117951,"_2954":118032},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3471":70816,"_30355":70781,"_21010":118034,"_5":14420,"_27589":117951,"_2954":118035},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3471":70817,"_30355":70781,"_21010":118037,"_5":14420,"_27589":117955,"_2954":118038},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3471":70818,"_30355":70781,"_21010":118040,"_5":14420,"_27589":117955,"_2954":118041},[],"Localiza el pod y Service de authz.",{"_3471":70819,"_30355":70781,"_21010":118043,"_5":14420,"_27589":117955,"_2954":118044},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3471":70820,"_30355":70781,"_21010":118046,"_5":14420,"_27589":117955,"_2954":118047},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3471":70821,"_30355":70781,"_21010":118049,"_5":14420,"_27589":117955,"_2954":118050},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3471":70822,"_30355":70781,"_21010":118052,"_5":14420,"_27589":117955,"_2954":118053},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3471":70823,"_30355":70781,"_21010":118055,"_5":14420,"_27589":117959,"_2954":118056},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3471":70824,"_30355":70781,"_21010":118058,"_5":14420,"_27589":117963,"_2954":118059},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3471":70825,"_30355":70781,"_21010":118061,"_5":14420,"_27589":117963,"_2954":118062},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3471":70826,"_30355":70781,"_21010":118064,"_5":14420,"_27589":117963,"_2954":118065},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3471":70827,"_30355":70781,"_21010":118067,"_5":14420,"_27589":117963,"_2954":118068},[],"volumen persistente sin enlazar;",{"_3471":70828,"_30355":70781,"_21010":118070,"_5":14420,"_27589":117963,"_2954":118071},[],"imagen inaccesible o política de pull incorrecta;",{"_3471":70829,"_30355":70781,"_21010":118073,"_5":14420,"_27589":117963,"_2954":118074},[],"configuración inválida del motor criptográfico;",{"_3471":70830,"_30355":70781,"_21010":118076,"_5":14420,"_27589":117963,"_2954":118077},[],"límites de CPU o memoria demasiado bajos;",{"_3471":70831,"_30355":70781,"_21010":118079,"_5":14420,"_27589":117963,"_2954":118080},[],"migración previa incompleta.",{"_3471":70832,"_30355":70781,"_21010":118082,"_5":14420,"_27589":117963,"_2954":118083},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3471":70833,"_30355":70781,"_21010":118085,"_5":14420,"_27589":117963,"_2954":118086},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3471":70834,"_30355":70781,"_21010":118088,"_5":14420,"_27589":117963,"_2954":118089},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3471":70835,"_30355":70781,"_21010":118091,"_5":14420,"_27589":117967,"_2954":118092},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3471":70836,"_30355":70781,"_21010":118094,"_5":14420,"_27589":117967,"_2954":118095},[],"verifica que esté habilitado en el servicio emisor;",{"_3471":70837,"_30355":70781,"_21010":118097,"_5":14420,"_27589":117967,"_2954":118098},[],"comprueba conectividad y credenciales AMQP;",{"_3471":70838,"_30355":70781,"_21010":118100,"_5":14420,"_27589":117967,"_2954":118101},[],"revisa exchange, routing key, colas y consumidores;",{"_3471":70839,"_30355":70781,"_21010":118103,"_5":14420,"_27589":117967,"_2954":118104},[],"inspecciona dead-letter queues;",{"_3471":70840,"_30355":70781,"_21010":118106,"_5":14420,"_27589":117967,"_2954":118107},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3471":70841,"_30355":70781,"_21010":118109,"_5":14420,"_27589":117967,"_2954":118110},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3471":70842,"_30355":70781,"_21010":118112,"_5":14420,"_27589":117967,"_2954":118113},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3471":70843,"_30355":70781,"_21010":118115,"_5":14420,"_27589":117967,"_2954":118116},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3471":70844,"_30355":70781,"_21010":118118,"_5":14420,"_27589":117967,"_2954":118119},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3471":70845,"_30355":70781,"_21010":118121,"_5":14420,"_27589":117967,"_2954":118122},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3471":70846,"_30355":70781,"_21010":118124,"_5":14420,"_27589":117967,"_2954":118125},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3471":70847,"_30355":70781,"_21010":118127,"_5":14420,"_27589":117967,"_2954":118128},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3471":70848,"_30355":70781,"_21010":118130,"_5":14420,"_27589":117971,"_2954":118131},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3471":70849,"_30355":70781,"_21010":118133,"_5":14420,"_27589":117971,"_2954":118134},[],"Antes de cerrar una incidencia, guarda:",{"_3471":70850,"_30355":70781,"_21010":118136,"_5":14420,"_27589":117971,"_2954":118137},[],"causa confirmada;",{"_3471":70851,"_30355":70781,"_21010":118139,"_5":14420,"_27589":117971,"_2954":118140},[],"alcance temporal y recursos afectados;",{"_3471":70852,"_30355":70781,"_21010":118142,"_5":14420,"_27589":117971,"_2954":118143},[],"comandos o consultas utilizados;",{"_3471":70853,"_30355":70781,"_21010":118145,"_5":14420,"_27589":117971,"_2954":118146},[],"cambio aplicado y forma de revertirlo;",{"_3471":70854,"_30355":70781,"_21010":118148,"_5":14420,"_27589":117971,"_2954":118149},[],"validación desde un consumidor;",{"_3471":70855,"_30355":70781,"_21010":118151,"_5":14420,"_27589":117971,"_2954":118152},[],"acción preventiva y propietario.",{"_3471":70856,"_30355":70856,"_5":14772,"_2954":118154,"_30708":118155,"_21010":118158,"_27589":70856},"Control de acceso",[49453,118156,118157],"Plataforma","Administración",[],{"_3471":70857,"_30355":70856,"_21010":118160,"_5":14420,"_27589":70856,"_2954":118161},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3471":70858,"_30355":70856,"_5":30705,"_21010":118163,"_27589":118164,"_2954":118165},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3471":70859,"_30355":70856,"_5":30705,"_21010":118167,"_27589":118168,"_2954":118169},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3471":70860,"_30355":70856,"_5":30705,"_21010":118171,"_27589":118172,"_2954":118173},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3471":70861,"_30355":70856,"_5":30705,"_21010":118175,"_27589":118176,"_2954":118177},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3471":70862,"_30355":70856,"_5":30705,"_21010":118179,"_27589":118180,"_2954":118181},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3471":70863,"_30355":70856,"_5":30705,"_21010":118183,"_27589":118184,"_2954":118185},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3471":70864,"_30355":70856,"_5":30705,"_21010":118187,"_27589":118188,"_2954":118189},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3471":70865,"_30355":70856,"_5":30705,"_21010":118191,"_27589":118192,"_2954":118193},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3471":70866,"_30355":70856,"_5":30705,"_21010":118195,"_27589":118196,"_2954":118197},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3471":70867,"_30355":70856,"_5":30705,"_21010":118199,"_27589":118200,"_2954":118201},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3471":70868,"_30355":70856,"_5":30705,"_21010":118203,"_27589":118204,"_2954":118205},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3471":70869,"_30355":70856,"_5":30705,"_21010":118207,"_27589":118208,"_2954":118209},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3471":70870,"_30355":70856,"_5":30705,"_21010":118211,"_27589":118212,"_2954":118213},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3471":70871,"_30355":70856,"_5":30705,"_21010":118215,"_27589":118216,"_2954":118217},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3471":70872,"_30355":70856,"_5":30705,"_21010":118219,"_27589":118220,"_2954":118221},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3471":70873,"_30355":70856,"_5":30705,"_21010":118223,"_27589":118224,"_2954":117324},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3471":70874,"_30355":70856,"_5":30705,"_21010":118226,"_27589":118227,"_2954":118228},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3471":70875,"_30355":70856,"_5":30705,"_21010":118230,"_27589":118231,"_2954":118232},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3471":70876,"_30355":70856,"_5":30705,"_21010":118234,"_27589":118235,"_2954":118236},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3471":70877,"_30355":70856,"_5":30705,"_21010":118238,"_27589":118239,"_2954":118240},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3471":70878,"_30355":70856,"_5":30705,"_21010":118242,"_27589":118243,"_2954":118244},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3471":70879,"_30355":70856,"_5":30705,"_21010":118246,"_27589":118247,"_2954":118248},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3471":70880,"_30355":70856,"_5":30705,"_21010":118250,"_27589":118251,"_2954":118252},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3471":70881,"_30355":70856,"_5":30705,"_21010":118254,"_27589":118255,"_2954":118256},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3471":70882,"_30355":70856,"_5":30705,"_21010":118258,"_27589":118259,"_2954":118260},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3471":70883,"_30355":70856,"_5":30705,"_21010":118262,"_27589":118263,"_2954":118264},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3471":70884,"_30355":70856,"_5":30705,"_21010":118266,"_27589":118267,"_2954":118268},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3471":70885,"_30355":70856,"_5":30705,"_21010":118270,"_27589":118271,"_2954":118272},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3471":70886,"_30355":70856,"_5":30705,"_21010":118274,"_27589":118275,"_2954":118276},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3471":70887,"_30355":70856,"_5":30705,"_21010":118278,"_27589":118279,"_2954":118280},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3471":70888,"_30355":70856,"_5":30705,"_21010":118282,"_27589":118283,"_2954":118284},[],"/docs/pr-preview/pr-62/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3471":70889,"_30355":70856,"_21010":118286,"_5":14420,"_27589":70856,"_2954":118287},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3471":70890,"_30355":70856,"_21010":118289,"_5":14420,"_27589":70856,"_2954":118290},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3471":70891,"_30355":70856,"_21010":118292,"_5":14420,"_27589":70856,"_2954":118293},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3471":70892,"_30355":70856,"_21010":118295,"_5":14420,"_27589":118164,"_2954":118296},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3471":70893,"_30355":70856,"_21010":118298,"_5":14420,"_27589":118164,"_2954":118299},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3471":70894,"_30355":70856,"_21010":118301,"_5":14420,"_27589":118164,"_2954":118302},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3471":70895,"_30355":70856,"_21010":118304,"_5":14420,"_27589":118164,"_2954":118305},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3471":70896,"_30355":70856,"_21010":118307,"_5":14420,"_27589":118164,"_2954":118308},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3471":70897,"_30355":70856,"_21010":118310,"_5":14420,"_27589":118164,"_2954":118311},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3471":70898,"_30355":70856,"_21010":118313,"_5":14420,"_27589":118168,"_2954":118314},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3471":70899,"_30355":70856,"_21010":118316,"_5":14420,"_27589":118168,"_2954":118317},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3471":70900,"_30355":70856,"_21010":118319,"_5":14420,"_27589":118172,"_2954":118320},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3471":70901,"_30355":70856,"_21010":118322,"_5":14420,"_27589":118172,"_2954":118323},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3471":70902,"_30355":70856,"_21010":118325,"_5":14420,"_27589":118172,"_2954":118326},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3471":70903,"_30355":70856,"_21010":118328,"_5":14420,"_27589":118172,"_2954":118329},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3471":70904,"_30355":70856,"_21010":118331,"_5":14420,"_27589":118172,"_2954":118332},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3471":70905,"_30355":70856,"_21010":118334,"_5":14420,"_27589":118172,"_2954":118335},[],"Carga por separado las políticas concedidas a cada principal.",{"_3471":70906,"_30355":70856,"_21010":118337,"_5":14420,"_27589":118172,"_2954":118338},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3471":70907,"_30355":70856,"_21010":118340,"_5":14420,"_27589":118172,"_2954":118341},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3471":70908,"_30355":70856,"_21010":118343,"_5":14420,"_27589":118172,"_2954":118344},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3471":70909,"_30355":70856,"_21010":118346,"_5":14420,"_27589":118172,"_2954":118347},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3471":70910,"_30355":70856,"_21010":118349,"_5":14420,"_27589":118172,"_2954":118350},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3471":70911,"_30355":70856,"_21010":118352,"_5":14420,"_27589":118172,"_2954":118353},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3471":70912,"_30355":70856,"_21010":118355,"_5":14420,"_27589":118176,"_2954":118356},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3471":70913,"_30355":70856,"_21010":118358,"_5":14420,"_27589":118176,"_2954":118359},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3471":70914,"_30355":70856,"_21010":118361,"_5":14420,"_27589":118176,"_2954":118362},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3471":70915,"_30355":70856,"_21010":118364,"_5":14420,"_27589":118176,"_2954":118365},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3471":70916,"_30355":70856,"_21010":118367,"_5":14420,"_27589":118176,"_2954":118368},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3471":70917,"_30355":70856,"_21010":118370,"_5":14420,"_27589":118176,"_2954":118371},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3471":70918,"_30355":70856,"_21010":118373,"_5":14420,"_27589":118176,"_2954":118374},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3471":70919,"_30355":70856,"_21010":118376,"_5":14420,"_27589":118176,"_2954":118377},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3471":70920,"_30355":70856,"_21010":118379,"_5":14420,"_27589":118180,"_2954":118380},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3471":70921,"_30355":70856,"_21010":118382,"_5":14420,"_27589":118180,"_2954":118383},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3471":70922,"_30355":70856,"_21010":118385,"_5":14420,"_27589":118180,"_2954":118386},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3471":70923,"_30355":70856,"_21010":118388,"_5":14420,"_27589":118180,"_2954":118389},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3471":70924,"_30355":70856,"_21010":118391,"_5":14420,"_27589":118180,"_2954":118392},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3471":70925,"_30355":70856,"_21010":118394,"_5":14420,"_27589":118180,"_2954":118395},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3471":70926,"_30355":70856,"_21010":118397,"_5":14420,"_27589":118180,"_2954":118398},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3471":70927,"_30355":70856,"_21010":118400,"_5":14420,"_27589":118180,"_2954":118401},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3471":70928,"_30355":70856,"_21010":118403,"_5":14420,"_27589":118180,"_2954":118404},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3471":70929,"_30355":70856,"_21010":118406,"_5":14420,"_27589":118180,"_2954":118407},[],"Las acciones se dividen en dos grupos:",{"_3471":70930,"_30355":70856,"_21010":118409,"_5":14420,"_27589":118180,"_2954":118410},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3471":70931,"_30355":70856,"_21010":118412,"_5":14420,"_27589":118180,"_2954":118413},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3471":70932,"_30355":70856,"_21010":118415,"_5":14420,"_27589":118180,"_2954":118416},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3471":70933,"_30355":70856,"_21010":118418,"_5":14420,"_27589":118184,"_2954":118419},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3471":70934,"_30355":70856,"_21010":118421,"_5":14420,"_27589":118184,"_2954":118422},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3471":70935,"_30355":70856,"_21010":118424,"_5":14420,"_27589":118184,"_2954":118425},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3471":70936,"_30355":70856,"_21010":118427,"_5":14420,"_27589":118188,"_2954":118428},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3471":70937,"_30355":70856,"_21010":118430,"_5":14420,"_27589":118188,"_2954":118431},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3471":70938,"_30355":70856,"_21010":118433,"_5":14420,"_27589":118188,"_2954":118434},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3471":70939,"_30355":70856,"_21010":118436,"_5":14420,"_27589":118188,"_2954":118437},[],"Los operadores implementados son:",{"_3471":70940,"_30355":70856,"_21010":118439,"_5":14420,"_27589":118188,"_2954":118440},[],"`equals`, para igualdad exacta;",{"_3471":70941,"_30355":70856,"_21010":118442,"_5":14420,"_27589":118188,"_2954":118443},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3471":70942,"_30355":70856,"_21010":118445,"_5":14420,"_27589":118188,"_2954":118446},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3471":70943,"_30355":70856,"_21010":118448,"_5":14420,"_27589":118188,"_2954":118449},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3471":70944,"_30355":70856,"_21010":118451,"_5":14420,"_27589":118192,"_2954":118452},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3471":70945,"_30355":70856,"_21010":118454,"_5":14420,"_27589":118192,"_2954":118455},[],"Los modos disponibles son:",{"_3471":70946,"_30355":70856,"_21010":118457,"_5":14420,"_27589":118192,"_2954":118458},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3471":70947,"_30355":70856,"_21010":118460,"_5":14420,"_27589":118192,"_2954":118461},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3471":70948,"_30355":70856,"_21010":118463,"_5":14420,"_27589":118192,"_2954":118464},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3471":70949,"_30355":70856,"_21010":118466,"_5":14420,"_27589":118192,"_2954":118467},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3471":70950,"_30355":70856,"_21010":118469,"_5":14420,"_27589":118192,"_2954":118470},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3471":70951,"_30355":70856,"_21010":118472,"_5":14420,"_27589":118192,"_2954":118473},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3471":70952,"_30355":70856,"_21010":118475,"_5":14420,"_27589":118196,"_2954":118476},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3471":70953,"_30355":70856,"_21010":118478,"_5":14420,"_27589":118196,"_2954":118479},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3471":70954,"_30355":70856,"_21010":118481,"_5":14420,"_27589":118196,"_2954":118482},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3471":70955,"_30355":70856,"_21010":118484,"_5":14420,"_27589":118196,"_2954":118485},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3471":70956,"_30355":70856,"_21010":118487,"_5":14420,"_27589":118204,"_2954":118488},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3471":70957,"_30355":70856,"_21010":118490,"_5":14420,"_27589":118204,"_2954":118491},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3471":70958,"_30355":70856,"_21010":118493,"_5":14420,"_27589":118208,"_2954":118494},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3471":70959,"_30355":70856,"_21010":118496,"_5":14420,"_27589":118208,"_2954":118497},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3471":70960,"_30355":70856,"_21010":118499,"_5":14420,"_27589":118212,"_2954":118500},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3471":70961,"_30355":70856,"_21010":118502,"_5":14420,"_27589":118212,"_2954":118503},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3471":70962,"_30355":70856,"_21010":118505,"_5":14420,"_27589":118212,"_2954":118506},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3471":70963,"_30355":70856,"_21010":118508,"_5":14420,"_27589":118216,"_2954":118509},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3471":70964,"_30355":70856,"_21010":118511,"_5":14420,"_27589":118216,"_2954":118512},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3471":70965,"_30355":70856,"_21010":118514,"_5":14420,"_27589":118216,"_2954":118515},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3471":70966,"_30355":70856,"_21010":118517,"_5":14420,"_27589":118216,"_2954":118518},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3471":70967,"_30355":70856,"_21010":118520,"_5":14420,"_27589":118216,"_2954":118521},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3471":70968,"_30355":70856,"_21010":118523,"_5":14420,"_27589":118216,"_2954":118524},[],"Ten en cuenta que:",{"_3471":70969,"_30355":70856,"_21010":118526,"_5":14420,"_27589":118216,"_2954":118527},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3471":70970,"_30355":70856,"_21010":118529,"_5":14420,"_27589":118216,"_2954":118530},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3471":70971,"_30355":70856,"_21010":118532,"_5":14420,"_27589":118216,"_2954":118533},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3471":70972,"_30355":70856,"_21010":118535,"_5":14420,"_27589":118220,"_2954":118536},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3471":70973,"_30355":70856,"_21010":118538,"_5":14420,"_27589":118220,"_2954":118539},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3471":70974,"_30355":70856,"_21010":118541,"_5":14420,"_27589":118220,"_2954":118542},[],"acceso completo y de solo lectura a KMS;",{"_3471":70975,"_30355":70856,"_21010":118544,"_5":14420,"_27589":118220,"_2954":118545},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3471":70976,"_30355":70856,"_21010":118547,"_5":14420,"_27589":118220,"_2954":118548},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3471":70977,"_30355":70856,"_21010":118550,"_5":14420,"_27589":118220,"_2954":118551},[],"acceso a la interfaz;",{"_3471":70978,"_30355":70856,"_21010":118553,"_5":14420,"_27589":118220,"_2954":118554},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3471":70979,"_30355":70856,"_21010":118556,"_5":14420,"_27589":118220,"_2954":118557},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3471":70980,"_30355":70856,"_21010":118559,"_5":14420,"_27589":118220,"_2954":118560},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3471":70981,"_30355":70856,"_21010":118562,"_5":14420,"_27589":118224,"_2954":118563},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3471":70982,"_30355":70856,"_21010":118565,"_5":14420,"_27589":118224,"_2954":118566},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3471":70983,"_30355":70856,"_21010":118568,"_5":14420,"_27589":118224,"_2954":118569},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3471":70984,"_30355":70856,"_21010":118571,"_5":14420,"_27589":118227,"_2954":118572},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3471":70985,"_30355":70856,"_21010":118574,"_5":14420,"_27589":118231,"_2954":118575},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3471":70986,"_30355":70856,"_21010":118577,"_5":14420,"_27589":118231,"_2954":118578},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3471":70987,"_30355":70856,"_21010":118580,"_5":14420,"_27589":118235,"_2954":118581},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3471":70988,"_30355":70856,"_21010":118583,"_5":14420,"_27589":118239,"_2954":118584},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3471":70989,"_30355":70856,"_21010":118586,"_5":14420,"_27589":118243,"_2954":118587},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3471":70990,"_30355":70856,"_21010":118589,"_5":14420,"_27589":118247,"_2954":118590},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3471":70991,"_30355":70856,"_21010":118592,"_5":14420,"_27589":118247,"_2954":118593},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3471":70992,"_30355":70856,"_21010":118595,"_5":14420,"_27589":118251,"_2954":118596},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3471":70993,"_30355":70856,"_21010":118598,"_5":14420,"_27589":118251,"_2954":118599},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3471":70994,"_30355":70856,"_21010":118601,"_5":14420,"_27589":118251,"_2954":118602},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3471":70995,"_30355":70856,"_21010":118604,"_5":14420,"_27589":118251,"_2954":118605},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3471":70996,"_30355":70856,"_21010":118607,"_5":14420,"_27589":118251,"_2954":118608},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3471":70997,"_30355":70856,"_21010":118610,"_5":14420,"_27589":118251,"_2954":118611},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3471":70998,"_30355":70856,"_21010":118613,"_5":14420,"_27589":118251,"_2954":118614},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3471":70999,"_30355":70856,"_21010":118616,"_5":14420,"_27589":118251,"_2954":118617},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3471":71000,"_30355":70856,"_21010":118619,"_5":14420,"_27589":118255,"_2954":118620},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3471":71001,"_30355":70856,"_21010":118622,"_5":14420,"_27589":118255,"_2954":118623},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3471":71002,"_30355":70856,"_21010":118625,"_5":14420,"_27589":118255,"_2954":118626},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3471":71003,"_30355":70856,"_21010":118628,"_5":14420,"_27589":118259,"_2954":118629},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3471":71004,"_30355":70856,"_21010":118631,"_5":14420,"_27589":118259,"_2954":118632},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3471":71005,"_30355":70856,"_21010":118634,"_5":14420,"_27589":118259,"_2954":118635},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3471":71006,"_30355":70856,"_21010":118637,"_5":14420,"_27589":118259,"_2954":118638},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3471":71007,"_30355":70856,"_21010":118640,"_5":14420,"_27589":118259,"_2954":118641},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3471":71008,"_30355":70856,"_21010":118643,"_5":14420,"_27589":118259,"_2954":118644},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3471":71009,"_30355":70856,"_21010":118646,"_5":14420,"_27589":118259,"_2954":118647},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3471":71010,"_30355":70856,"_21010":118649,"_5":14420,"_27589":118259,"_2954":118650},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3471":71011,"_30355":70856,"_21010":118652,"_5":14420,"_27589":118267,"_2954":118653},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3471":71012,"_30355":70856,"_21010":118655,"_5":14420,"_27589":118271,"_2954":118656},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3471":71013,"_30355":70856,"_21010":118658,"_5":14420,"_27589":118271,"_2954":118659},[],"que exista un principal activo del tipo correcto;",{"_3471":71014,"_30355":70856,"_21010":118661,"_5":14420,"_27589":118271,"_2954":118662},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3471":71015,"_30355":70856,"_21010":118664,"_5":14420,"_27589":118271,"_2954":118665},[],"que todas las condiciones del principal se cumplan;",{"_3471":71016,"_30355":70856,"_21010":118667,"_5":14420,"_27589":118271,"_2954":118668},[],"que el principal tenga concedida la política esperada;",{"_3471":71017,"_30355":70856,"_21010":118670,"_5":14420,"_27589":118271,"_2954":118671},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3471":71018,"_30355":70856,"_21010":118673,"_5":14420,"_27589":118271,"_2954":118674},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3471":71019,"_30355":70856,"_21010":118676,"_5":14420,"_27589":118271,"_2954":118677},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3471":71020,"_30355":70856,"_21010":118679,"_5":14420,"_27589":118275,"_2954":118680},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3471":71021,"_30355":70856,"_21010":118682,"_5":14420,"_27589":118279,"_2954":118683},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3471":71022,"_30355":70856,"_21010":118685,"_5":14420,"_27589":118283,"_2954":118686},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3471":71023,"_30355":70856,"_21010":118688,"_5":14420,"_27589":118283,"_2954":118689},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3471":71024,"_30355":71024,"_5":14772,"_2954":118691,"_30708":118692,"_21010":118693,"_27589":71024},"Alertas y suscripciones",[49453,118156,118157],[],{"_3471":71025,"_30355":71024,"_21010":118695,"_5":14420,"_27589":71024,"_2954":118696},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3471":71026,"_30355":71024,"_5":30705,"_21010":118698,"_27589":118699,"_2954":118700},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3471":71027,"_30355":71024,"_5":30705,"_21010":118702,"_27589":118703,"_2954":118704},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3471":71028,"_30355":71024,"_5":30705,"_21010":118706,"_27589":118707,"_2954":118708},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3471":71029,"_30355":71024,"_5":30705,"_21010":118710,"_27589":118711,"_2954":118712},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3471":71030,"_30355":71024,"_5":30705,"_21010":118714,"_27589":118715,"_2954":118716},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3471":71031,"_30355":71024,"_5":30705,"_21010":118718,"_27589":118719,"_2954":118720},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3471":71032,"_30355":71024,"_5":30705,"_21010":118722,"_27589":118723,"_2954":118724},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3471":71033,"_30355":71024,"_5":30705,"_21010":118726,"_27589":118727,"_2954":118728},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3471":71034,"_30355":71024,"_5":30705,"_21010":118730,"_27589":118731,"_2954":118732},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3471":71035,"_30355":71024,"_5":30705,"_21010":118734,"_27589":118735,"_2954":118736},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3471":71036,"_30355":71024,"_5":30705,"_21010":118738,"_27589":118739,"_2954":118740},[],"/docs/pr-preview/pr-62/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3471":71037,"_30355":71024,"_21010":118742,"_5":14420,"_27589":71024,"_2954":118743},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3471":71038,"_30355":71024,"_21010":118745,"_5":14420,"_27589":118699,"_2954":118746},[],"Un servicio publica un evento de dominio.",{"_3471":71039,"_30355":71024,"_21010":118748,"_5":14420,"_27589":118699,"_2954":118749},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3471":71040,"_30355":71024,"_21010":118751,"_5":14420,"_27589":118699,"_2954":118752},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3471":71041,"_30355":71024,"_21010":118754,"_5":14420,"_27589":118699,"_2954":118755},[],"Lamassu entrega el evento al canal configurado.",{"_3471":71042,"_30355":71024,"_21010":118757,"_5":14420,"_27589":118699,"_2954":118758},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3471":71043,"_30355":71024,"_21010":118760,"_5":14420,"_27589":118703,"_2954":118761},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3471":71044,"_30355":71024,"_21010":118763,"_5":14420,"_27589":118703,"_2954":118764},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3471":71045,"_30355":71024,"_21010":118766,"_5":14420,"_27589":118703,"_2954":118767},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3471":71046,"_30355":71024,"_21010":118769,"_5":14420,"_27589":118703,"_2954":118770},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3471":71047,"_30355":71024,"_21010":118772,"_5":14420,"_27589":118703,"_2954":118773},[],"`apikey_options` necesita `header` y `key`.",{"_3471":71048,"_30355":71024,"_21010":118775,"_5":14420,"_27589":118703,"_2954":118776},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3471":71049,"_30355":71024,"_21010":118778,"_5":14420,"_27589":118703,"_2954":118779},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3471":71050,"_30355":71024,"_21010":118781,"_5":14420,"_27589":118703,"_2954":118782},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3471":71051,"_30355":71024,"_21010":118784,"_5":14420,"_27589":118711,"_2954":118785},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3471":71052,"_30355":71024,"_21010":118787,"_5":14420,"_27589":118715,"_2954":118788},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3471":71053,"_30355":71024,"_21010":118790,"_5":14420,"_27589":118719,"_2954":118791},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3471":71054,"_30355":71024,"_21010":118793,"_5":14420,"_27589":118719,"_2954":118794},[],"**None** notifica todas las instancias del evento.",{"_3471":71055,"_30355":71024,"_21010":118796,"_5":14420,"_27589":118719,"_2954":118797},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3471":71056,"_30355":71024,"_21010":118799,"_5":14420,"_27589":118719,"_2954":118800},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3471":71057,"_30355":71024,"_21010":118802,"_5":14420,"_27589":118719,"_2954":118803},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3471":71058,"_30355":71024,"_21010":118805,"_5":14420,"_27589":118719,"_2954":118806},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3471":71059,"_30355":71024,"_21010":118808,"_5":14420,"_27589":118719,"_2954":118809},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3471":71060,"_30355":71024,"_21010":118811,"_5":14420,"_27589":118723,"_2954":118812},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3471":71061,"_30355":71024,"_21010":118814,"_5":14420,"_27589":118727,"_2954":118815},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3471":71062,"_30355":71024,"_21010":118817,"_5":14420,"_27589":118727,"_2954":118818},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3471":71063,"_30355":71024,"_21010":118820,"_5":14420,"_27589":118727,"_2954":118821},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3471":71064,"_30355":71024,"_21010":118823,"_5":14420,"_27589":118727,"_2954":118824},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3471":71065,"_30355":71024,"_21010":118826,"_5":14420,"_27589":118727,"_2954":118827},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3471":71066,"_30355":71024,"_21010":118829,"_5":14420,"_27589":118727,"_2954":118830},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3471":71067,"_30355":71024,"_21010":118832,"_5":14420,"_27589":118727,"_2954":118833},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3471":71068,"_30355":71024,"_21010":118835,"_5":14420,"_27589":118727,"_2954":118836},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3471":71069,"_30355":71024,"_21010":118838,"_5":14420,"_27589":118731,"_2954":118839},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3471":71070,"_30355":71024,"_21010":118841,"_5":14420,"_27589":118731,"_2954":118842},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3471":71071,"_30355":71024,"_21010":118844,"_5":14420,"_27589":118731,"_2954":118845},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3471":71072,"_30355":71024,"_21010":118847,"_5":14420,"_27589":118731,"_2954":118848},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3471":71073,"_30355":71024,"_21010":118850,"_5":14420,"_27589":118731,"_2954":118851},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3471":71074,"_30355":71024,"_21010":118853,"_5":14420,"_27589":118731,"_2954":118854},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3471":71075,"_30355":71024,"_21010":118856,"_5":14420,"_27589":118731,"_2954":118857},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3471":71076,"_30355":71024,"_21010":118859,"_5":14420,"_27589":118731,"_2954":118860},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3471":71077,"_30355":71024,"_21010":118862,"_5":14420,"_27589":118735,"_2954":118863},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3471":71078,"_30355":71024,"_21010":118865,"_5":14420,"_27589":118735,"_2954":118866},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3471":71079,"_30355":71024,"_21010":118868,"_5":14420,"_27589":118739,"_2954":118869},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3471":71080,"_30355":71024,"_21010":118871,"_5":14420,"_27589":118739,"_2954":118872},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3471":71081,"_30355":71024,"_21010":118874,"_5":14420,"_27589":118739,"_2954":118875},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3471":71082,"_30355":71024,"_21010":118877,"_5":14420,"_27589":118739,"_2954":118878},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3471":71083,"_30355":71024,"_21010":118880,"_5":14420,"_27589":118739,"_2954":118881},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3471":71084,"_30355":71024,"_21010":118883,"_5":14420,"_27589":118739,"_2954":118884},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3471":71085,"_30355":71024,"_21010":118886,"_5":14420,"_27589":118739,"_2954":118887},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3471":71086,"_30355":71024,"_21010":118889,"_5":14420,"_27589":118739,"_2954":118890},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3471":71087,"_30355":71024,"_21010":118892,"_5":14420,"_27589":118739,"_2954":118893},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3471":71088,"_30355":71088,"_5":14772,"_2954":118895,"_30708":118896,"_21010":118897,"_27589":71088},"Registros de auditoría",[49453,118156,118157],[],{"_3471":71089,"_30355":71088,"_21010":118899,"_5":14420,"_27589":71088,"_2954":118900},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3471":71090,"_30355":71088,"_5":30705,"_21010":118902,"_27589":118903,"_2954":118904},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3471":71091,"_30355":71088,"_5":30705,"_21010":118906,"_27589":118907,"_2954":118908},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3471":71092,"_30355":71088,"_5":30705,"_21010":118910,"_27589":118911,"_2954":118912},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3471":71093,"_30355":71088,"_5":30705,"_21010":118914,"_27589":118915,"_2954":118916},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3471":71094,"_30355":71088,"_5":30705,"_21010":118918,"_27589":118919,"_2954":118920},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3471":71095,"_30355":71088,"_5":30705,"_21010":118922,"_27589":118923,"_2954":118924},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3471":71096,"_30355":71088,"_5":30705,"_21010":118926,"_27589":118927,"_2954":118928},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3471":71097,"_30355":71088,"_5":30705,"_21010":118930,"_27589":118931,"_2954":118932},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3471":71098,"_30355":71088,"_5":30705,"_21010":118934,"_27589":118935,"_2954":118936},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3471":71099,"_30355":71088,"_5":30705,"_21010":118938,"_27589":118939,"_2954":118940},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3471":71100,"_30355":71088,"_5":30705,"_21010":118942,"_27589":118943,"_2954":118944},[],"/docs/pr-preview/pr-62/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3471":71101,"_30355":71088,"_21010":118946,"_5":14420,"_27589":71088,"_2954":118947},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3471":71102,"_30355":71088,"_21010":118949,"_5":14420,"_27589":118903,"_2954":118950},[],"El cuerpo de auditoría incluye:",{"_3471":71103,"_30355":71088,"_21010":118952,"_5":14420,"_27589":118903,"_2954":118953},[],"input: datos recibidos por la operación;",{"_3471":71104,"_30355":71088,"_21010":118955,"_5":14420,"_27589":118903,"_2954":118956},[],"has\\_error: indica si el servicio devolvió un error;",{"_3471":71105,"_30355":71088,"_21010":118958,"_5":14420,"_27589":118903,"_2954":118959},[],"output: resultado producido o mensaje de error;",{"_3471":71106,"_30355":71088,"_21010":118961,"_5":14420,"_27589":118903,"_2954":118962},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3471":71107,"_30355":71088,"_21010":118964,"_5":14420,"_27589":118903,"_2954":118965},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3471":71108,"_30355":71088,"_21010":118967,"_5":14420,"_27589":118903,"_2954":118968},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3471":71109,"_30355":71088,"_21010":118970,"_5":14420,"_27589":118907,"_2954":118971},[],"El backend aplica auditoría a mutaciones de:",{"_3471":71110,"_30355":71088,"_21010":118973,"_5":14420,"_27589":118907,"_2954":118974},[],"autoridades, certificados y perfiles de emisión;",{"_3471":71111,"_30355":71088,"_21010":118976,"_5":14420,"_27589":118907,"_2954":118977},[],"claves y motores KMS;",{"_3471":71112,"_30355":71088,"_21010":118979,"_5":14420,"_27589":118907,"_2954":118980},[],"dispositivos e identidades;",{"_3471":71113,"_30355":71088,"_21010":118982,"_5":14420,"_27589":118907,"_2954":118983},[],"DMS y operaciones de enrolamiento;",{"_3471":71114,"_30355":71088,"_21010":118985,"_5":14420,"_27589":118907,"_2954":118986},[],"funciones de validación y CRL;",{"_3471":71115,"_30355":71088,"_21010":118988,"_5":14420,"_27589":118907,"_2954":118989},[],"principales, políticas y concesiones de autorización.",{"_3471":71116,"_30355":71088,"_21010":118991,"_5":14420,"_27589":118907,"_2954":118992},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3471":71117,"_30355":71088,"_21010":118994,"_5":14420,"_27589":118911,"_2954":118995},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3471":71118,"_30355":71088,"_21010":118997,"_5":14420,"_27589":118911,"_2954":118998},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3471":71119,"_30355":71088,"_21010":119000,"_5":14420,"_27589":118911,"_2954":119001},[],"Diseña el consumidor para:",{"_3471":71120,"_30355":71088,"_21010":119003,"_5":14420,"_27589":118911,"_2954":119004},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3471":71121,"_30355":71088,"_21010":119006,"_5":14420,"_27589":118911,"_2954":119007},[],"conservar el CloudEvent completo sin modificar;",{"_3471":71122,"_30355":71088,"_21010":119009,"_5":14420,"_27589":118911,"_2954":119010},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3471":71123,"_30355":71088,"_21010":119012,"_5":14420,"_27589":118911,"_2954":119013},[],"cifrar en tránsito y en reposo;",{"_3471":71124,"_30355":71088,"_21010":119015,"_5":14420,"_27589":118911,"_2954":119016},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3471":71125,"_30355":71088,"_21010":119018,"_5":14420,"_27589":118911,"_2954":119019},[],"aplicar una política explícita de retención y legal hold;",{"_3471":71126,"_30355":71088,"_21010":119021,"_5":14420,"_27589":118911,"_2954":119022},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3471":71127,"_30355":71088,"_21010":119024,"_5":14420,"_27589":118915,"_2954":119025},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3471":71128,"_30355":71088,"_21010":119027,"_5":14420,"_27589":118915,"_2954":119028},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3471":71129,"_30355":71088,"_21010":119030,"_5":14420,"_27589":118923,"_2954":119031},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3471":71130,"_30355":71088,"_21010":119033,"_5":14420,"_27589":118927,"_2954":119034},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3471":71131,"_30355":71088,"_21010":119036,"_5":14420,"_27589":118931,"_2954":119037},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3471":71132,"_30355":71088,"_21010":119039,"_5":14420,"_27589":118935,"_2954":119040},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3471":71133,"_30355":71088,"_21010":119042,"_5":14420,"_27589":118939,"_2954":119043},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3471":71134,"_30355":71088,"_21010":119045,"_5":14420,"_27589":118943,"_2954":119046},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3471":71135,"_30355":71088,"_21010":119048,"_5":14420,"_27589":118943,"_2954":119049},[],"aparece un evento de auditoría correcto;",{"_3471":71136,"_30355":71088,"_21010":119051,"_5":14420,"_27589":118943,"_2954":119052},[],"el principal coincide con la identidad utilizada;",{"_3471":71137,"_30355":71088,"_21010":119054,"_5":14420,"_27589":118943,"_2954":119055},[],"el consumidor lo persiste una sola vez;",{"_3471":71138,"_30355":71088,"_21010":119057,"_5":14420,"_27589":118943,"_2954":119058},[],"puede recuperarse por recurso, actor y periodo;",{"_3471":71139,"_30355":71088,"_21010":119060,"_5":14420,"_27589":118943,"_2954":119061},[],"una interrupción del consumidor produce una alerta.",{"_3471":71140,"_30355":71088,"_21010":119063,"_5":14420,"_27589":118943,"_2954":119064},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3471":71141,"_30355":71141,"_5":14772,"_2954":119066,"_30708":119067,"_21010":119068,"_27589":71141},"Arquitectura de la plataforma",[49453,118156],[],{"_3471":71142,"_30355":71141,"_21010":119070,"_5":14420,"_27589":71141,"_2954":119071},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3471":71143,"_30355":71141,"_5":30705,"_21010":119073,"_27589":119074,"_2954":119075},[],"/docs/pr-preview/pr-62/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3471":71144,"_30355":71141,"_5":30705,"_21010":119077,"_27589":119078,"_2954":119079},[],"/docs/pr-preview/pr-62/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3471":71145,"_30355":71141,"_5":30705,"_21010":119081,"_27589":119082,"_2954":119083},[],"/docs/pr-preview/pr-62/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3471":71146,"_30355":71141,"_5":30705,"_21010":119085,"_27589":119086,"_2954":119087},[],"/docs/pr-preview/pr-62/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3471":71147,"_30355":71141,"_5":30705,"_21010":119089,"_27589":119090,"_2954":119091},[],"/docs/pr-preview/pr-62/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3471":71148,"_30355":71141,"_21010":119093,"_5":14420,"_27589":71141,"_2954":119094},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3471":71149,"_30355":71141,"_21010":119096,"_5":14420,"_27589":71141,"_2954":119097},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3471":71150,"_30355":71141,"_21010":119099,"_5":14420,"_27589":119074,"_2954":119100},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3471":71151,"_30355":71141,"_21010":119102,"_5":14420,"_27589":119078,"_2954":119103},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3471":71152,"_30355":71141,"_21010":119105,"_5":14420,"_27589":119082,"_2954":119106},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3471":71153,"_30355":71141,"_21010":119108,"_5":14420,"_27589":119086,"_2954":119109},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3471":71154,"_30355":71141,"_21010":119111,"_5":14420,"_27589":119090,"_2954":119112},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3471":71155,"_30355":71155,"_5":14772,"_2954":119114,"_30708":119115,"_21010":119116,"_27589":71155},"Cómo funciona Lamassu",[49453,118156],[],{"_3471":71156,"_30355":71155,"_21010":119118,"_5":14420,"_27589":71155,"_2954":119119},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3471":71157,"_30355":71155,"_5":30705,"_21010":119121,"_27589":119122,"_2954":119123},[],"/docs/pr-preview/pr-62/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3471":71158,"_30355":71155,"_5":30705,"_21010":119125,"_27589":119126,"_2954":119127},[],"/docs/pr-preview/pr-62/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3471":71159,"_30355":71155,"_21010":119129,"_5":14420,"_27589":71155,"_2954":119130},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3471":71160,"_30355":71155,"_21010":119132,"_5":14420,"_27589":119122,"_2954":119133},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3471":71161,"_30355":71155,"_21010":119135,"_5":14420,"_27589":119122,"_2954":119136},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3471":71162,"_30355":71155,"_21010":119138,"_5":14420,"_27589":119122,"_2954":119139},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3471":71163,"_30355":71155,"_21010":119141,"_5":14420,"_27589":119122,"_2954":119142},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3471":71164,"_30355":71155,"_21010":119144,"_5":14420,"_27589":119122,"_2954":119145},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3471":71165,"_30355":71155,"_21010":119147,"_5":14420,"_27589":119126,"_2954":119148},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3471":71166,"_30355":71155,"_21010":119150,"_5":14420,"_27589":119126,"_2954":119151},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3471":71167,"_30355":71155,"_21010":119153,"_5":14420,"_27589":119126,"_2954":119154},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3471":71168,"_30355":71155,"_21010":119156,"_5":14420,"_27589":119126,"_2954":119157},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3471":71169,"_30355":71155,"_21010":119159,"_5":14420,"_27589":119126,"_2954":119160},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3471":71170,"_30355":71155,"_21010":119162,"_5":14420,"_27589":119126,"_2954":119163},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3471":71171,"_30355":71155,"_21010":119165,"_5":14420,"_27589":119126,"_2954":119166},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3471":71172,"_30355":71172,"_5":14772,"_2954":119168,"_30708":119169,"_21010":119170,"_27589":71172},"Dispositivos e identidades",[49453,118156,51942,119168],[],{"_3471":71173,"_30355":71172,"_21010":119172,"_5":14420,"_27589":71172,"_2954":119173},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3471":71174,"_30355":71172,"_5":30705,"_21010":119175,"_27589":119176,"_2954":119177},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3471":71175,"_30355":71172,"_5":30705,"_21010":119179,"_27589":119180,"_2954":119181},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3471":71176,"_30355":71172,"_5":30705,"_21010":119183,"_27589":119184,"_2954":119185},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3471":71177,"_30355":71172,"_5":30705,"_21010":119187,"_27589":119188,"_2954":119189},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3471":71178,"_30355":71172,"_5":30705,"_21010":119191,"_27589":119192,"_2954":119193},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3471":71179,"_30355":71172,"_5":30705,"_21010":119195,"_27589":119196,"_2954":119197},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3471":71180,"_30355":71172,"_5":30705,"_21010":119199,"_27589":119200,"_2954":119201},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3471":71181,"_30355":71172,"_5":30705,"_21010":119203,"_27589":119204,"_2954":119205},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3471":71182,"_30355":71172,"_5":30705,"_21010":119207,"_27589":119208,"_2954":119209},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3471":71183,"_30355":71172,"_5":30705,"_21010":119211,"_27589":119212,"_2954":119213},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3471":71184,"_30355":71172,"_5":30705,"_21010":119215,"_27589":119216,"_2954":119217},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3471":71185,"_30355":71172,"_21010":119219,"_5":14420,"_27589":71172,"_2954":119220},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3471":71186,"_30355":71172,"_21010":119222,"_5":14420,"_27589":71172,"_2954":119223},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3471":71187,"_30355":71172,"_21010":119225,"_5":14420,"_27589":119176,"_2954":119226},[],"Vista operativa",{"_3471":71188,"_30355":71172,"_21010":119228,"_5":14420,"_27589":119176,"_2954":119229},[],"Interpretación",{"_3471":71189,"_30355":71172,"_21010":119231,"_5":14420,"_27589":119176,"_2954":52005},[],{"_3471":71190,"_30355":71172,"_21010":119233,"_5":14420,"_27589":119176,"_2954":119234},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3471":71191,"_30355":71172,"_21010":119236,"_5":14420,"_27589":119176,"_2954":52011},[],{"_3471":71192,"_30355":71172,"_21010":119238,"_5":14420,"_27589":119176,"_2954":119239},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3471":71193,"_30355":71172,"_21010":119241,"_5":14420,"_27589":119176,"_2954":52017},[],{"_3471":71194,"_30355":71172,"_21010":119243,"_5":14420,"_27589":119176,"_2954":119244},[],"La identidad está en la ventana operativa de renovación.",{"_3471":71195,"_30355":71172,"_21010":119246,"_5":14420,"_27589":119176,"_2954":52023},[],{"_3471":71196,"_30355":71172,"_21010":119248,"_5":14420,"_27589":119176,"_2954":119249},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3471":71197,"_30355":71172,"_21010":119251,"_5":14420,"_27589":119176,"_2954":52029},[],{"_3471":71198,"_30355":71172,"_21010":119253,"_5":14420,"_27589":119176,"_2954":119254},[],"La identidad ha vencido.",{"_3471":71199,"_30355":71172,"_21010":119256,"_5":14420,"_27589":119176,"_2954":52035},[],{"_3471":71200,"_30355":71172,"_21010":119258,"_5":14420,"_27589":119176,"_2954":119259},[],"La identidad está marcada como revocada.",{"_3471":71201,"_30355":71172,"_21010":119261,"_5":14420,"_27589":119176,"_2954":52041},[],{"_3471":71202,"_30355":71172,"_21010":119263,"_5":14420,"_27589":119176,"_2954":119264},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3471":71203,"_30355":71172,"_21010":119266,"_5":14420,"_27589":119176,"_2954":119267},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3471":71204,"_30355":71172,"_21010":119269,"_5":14420,"_27589":119180,"_2954":119270},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3471":71205,"_30355":71172,"_21010":119272,"_5":14420,"_27589":119180,"_2954":119273},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3471":71206,"_30355":71172,"_21010":119275,"_5":14420,"_27589":119180,"_2954":119276},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3471":71207,"_30355":71172,"_21010":119278,"_5":14420,"_27589":119180,"_2954":119279},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3471":71208,"_30355":71172,"_21010":119281,"_5":14420,"_27589":119184,"_2954":119282},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3471":71209,"_30355":71172,"_21010":119284,"_5":14420,"_27589":119188,"_2954":119285},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3471":71210,"_30355":71172,"_21010":119287,"_5":14420,"_27589":119192,"_2954":119288},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3471":71211,"_30355":71172,"_21010":119290,"_5":14420,"_27589":119196,"_2954":119291},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3471":71212,"_30355":71172,"_21010":119293,"_5":14420,"_27589":119200,"_2954":119294},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3471":71213,"_30355":71172,"_21010":119296,"_5":14420,"_27589":119200,"_2954":119297},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3471":71214,"_30355":71172,"_21010":119299,"_5":14420,"_27589":119204,"_2954":119300},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3471":71215,"_30355":71172,"_21010":119302,"_5":14420,"_27589":119204,"_2954":119303},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3471":71216,"_30355":71172,"_21010":119305,"_5":14420,"_27589":119204,"_2954":119306},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3471":71217,"_30355":71172,"_21010":119308,"_5":14420,"_27589":119204,"_2954":119309},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3471":71218,"_30355":71172,"_21010":119311,"_5":14420,"_27589":119204,"_2954":119312},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3471":71219,"_30355":71172,"_21010":119314,"_5":14420,"_27589":119204,"_2954":119315},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3471":71220,"_30355":71172,"_21010":119317,"_5":14420,"_27589":119208,"_2954":119318},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3471":71221,"_30355":71172,"_21010":119320,"_5":14420,"_27589":119208,"_2954":119321},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3471":71222,"_30355":71172,"_21010":119323,"_5":14420,"_27589":119212,"_2954":119324},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3471":71223,"_30355":71172,"_21010":119326,"_5":14420,"_27589":119212,"_2954":119327},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3471":71224,"_30355":71172,"_21010":119329,"_5":14420,"_27589":119212,"_2954":119330},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3471":71225,"_30355":71172,"_21010":119332,"_5":14420,"_27589":119212,"_2954":119333},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3471":71226,"_30355":71172,"_21010":119335,"_5":14420,"_27589":119216,"_2954":119336},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3471":71227,"_30355":71172,"_21010":119338,"_5":14420,"_27589":119216,"_2954":119339},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3471":71228,"_30355":71228,"_5":14772,"_2954":119341,"_30708":119342,"_21010":119344,"_27589":71228},"Identidad inicial y autenticación",[49453,118156,51942,119168,119343],"Enrolamiento con PKI",[],{"_3471":71229,"_30355":71228,"_21010":119346,"_5":14420,"_27589":71228,"_2954":119347},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3471":71230,"_30355":71228,"_5":30705,"_21010":119349,"_27589":119350,"_2954":119351},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3471":71231,"_30355":71228,"_5":30705,"_21010":119353,"_27589":119354,"_2954":119355},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3471":71232,"_30355":71228,"_5":30705,"_21010":119357,"_27589":119358,"_2954":119359},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3471":71233,"_30355":71228,"_5":30705,"_21010":119361,"_27589":119362,"_2954":119363},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3471":71234,"_30355":71228,"_5":30705,"_21010":119365,"_27589":119366,"_2954":119367},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3471":71235,"_30355":71228,"_21010":119369,"_5":14420,"_27589":71228,"_2954":119370},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3471":71236,"_30355":71228,"_21010":119372,"_5":14420,"_27589":119350,"_2954":119373},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3471":71237,"_30355":71228,"_21010":119375,"_5":14420,"_27589":119350,"_2954":119376},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3471":71238,"_30355":71228,"_21010":119378,"_5":14420,"_27589":119354,"_2954":119379},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3471":71239,"_30355":71228,"_21010":119381,"_5":14420,"_27589":119354,"_2954":119382},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3471":71240,"_30355":71228,"_21010":119384,"_5":14420,"_27589":119354,"_2954":119385},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3471":71241,"_30355":71228,"_21010":119387,"_5":14420,"_27589":119358,"_2954":119388},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3471":71242,"_30355":71228,"_21010":119390,"_5":14420,"_27589":119358,"_2954":119391},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3471":71243,"_30355":71228,"_21010":119393,"_5":14420,"_27589":119362,"_2954":119394},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3471":71244,"_30355":71228,"_21010":119396,"_5":14420,"_27589":119362,"_2954":119397},[],"Ejemplo de cuerpo:",{"_3471":71245,"_30355":71228,"_21010":119399,"_5":14420,"_27589":119362,"_2954":119400},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3471":71246,"_30355":71228,"_21010":119402,"_5":14420,"_27589":119362,"_2954":119403},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3471":71247,"_30355":71228,"_21010":119405,"_5":14420,"_27589":119362,"_2954":119406},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3471":71248,"_30355":71228,"_21010":119408,"_5":14420,"_27589":119362,"_2954":119409},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3471":71249,"_30355":71228,"_21010":119411,"_5":14420,"_27589":119366,"_2954":119412},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3471":71250,"_30355":71228,"_21010":119414,"_5":14420,"_27589":119366,"_2954":119415},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3471":71251,"_30355":71251,"_5":14772,"_2954":119417,"_30708":119418,"_21010":119419,"_27589":71251},"Configura y opera el DMS",[49453,118156,51942,119168,119343],[],{"_3471":71252,"_30355":71251,"_21010":119421,"_5":14420,"_27589":71251,"_2954":119422},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3471":71253,"_30355":71251,"_5":30705,"_21010":119424,"_27589":119425,"_2954":116727},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3471":71254,"_30355":71251,"_5":30705,"_21010":119427,"_27589":119428,"_2954":119429},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3471":71255,"_30355":71251,"_5":30705,"_21010":119431,"_27589":119432,"_2954":119433},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3471":71256,"_30355":71251,"_5":30705,"_21010":119435,"_27589":119436,"_2954":119437},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3471":71257,"_30355":71251,"_5":30705,"_21010":119439,"_27589":119440,"_2954":119441},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3471":71258,"_30355":71251,"_5":30705,"_21010":119443,"_27589":119444,"_2954":119445},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3471":71259,"_30355":71251,"_5":30705,"_21010":119447,"_27589":119448,"_2954":119449},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3471":71260,"_30355":71251,"_5":30705,"_21010":119451,"_27589":119452,"_2954":119453},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3471":71261,"_30355":71251,"_5":30705,"_21010":119455,"_27589":119456,"_2954":52237},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3471":71262,"_30355":71251,"_5":30705,"_21010":119458,"_27589":119459,"_2954":52241},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3471":71263,"_30355":71251,"_5":30705,"_21010":119461,"_27589":119462,"_2954":119463},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3471":71264,"_30355":71251,"_5":30705,"_21010":119465,"_27589":119466,"_2954":119467},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3471":71265,"_30355":71251,"_5":30705,"_21010":119469,"_27589":119470,"_2954":119471},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3471":71266,"_30355":71251,"_5":30705,"_21010":119473,"_27589":119474,"_2954":119475},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3471":71267,"_30355":71251,"_5":30705,"_21010":119477,"_27589":119478,"_2954":52261},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3471":71268,"_30355":71251,"_5":30705,"_21010":119480,"_27589":119481,"_2954":119482},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3471":71269,"_30355":71251,"_5":30705,"_21010":119484,"_27589":119485,"_2954":119486},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3471":71270,"_30355":71251,"_5":30705,"_21010":119488,"_27589":119489,"_2954":119490},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3471":71271,"_30355":71251,"_21010":119492,"_5":14420,"_27589":71251,"_2954":119493},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3471":71272,"_30355":71251,"_21010":119495,"_5":14420,"_27589":119425,"_2954":119496},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3471":71273,"_30355":71251,"_21010":119498,"_5":14420,"_27589":119425,"_2954":119499},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3471":71274,"_30355":71251,"_21010":119501,"_5":14420,"_27589":119432,"_2954":119502},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3471":71275,"_30355":71251,"_21010":119504,"_5":14420,"_27589":119436,"_2954":119505},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3471":71276,"_30355":71251,"_21010":119507,"_5":14420,"_27589":119440,"_2954":119508},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3471":71277,"_30355":71251,"_21010":119510,"_5":14420,"_27589":119444,"_2954":119511},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3471":71278,"_30355":71251,"_21010":119513,"_5":14420,"_27589":119448,"_2954":119514},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3471":71279,"_30355":71251,"_21010":119516,"_5":14420,"_27589":119456,"_2954":119517},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3471":71280,"_30355":71251,"_21010":119519,"_5":14420,"_27589":119456,"_2954":119520},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3471":71281,"_30355":71251,"_21010":119522,"_5":14420,"_27589":119459,"_2954":119523},[],"Campo de `settings.enrollment_settings`",{"_3471":71282,"_30355":71251,"_21010":119525,"_5":14420,"_27589":119459,"_2954":119526},[],"Decisión",{"_3471":71283,"_30355":71251,"_21010":119528,"_5":14420,"_27589":119459,"_2954":52312},[],{"_3471":71284,"_30355":71251,"_21010":119530,"_5":14420,"_27589":119459,"_2954":119531},[],"`EST_RFC7030` para estas operaciones.",{"_3471":71285,"_30355":71251,"_21010":119533,"_5":14420,"_27589":119459,"_2954":52318},[],{"_3471":71286,"_30355":71251,"_21010":119535,"_5":14420,"_27589":119459,"_2954":119536},[],"ID de la CA que firmará.",{"_3471":71287,"_30355":71251,"_21010":119538,"_5":14420,"_27589":119459,"_2954":52324},[],{"_3471":71288,"_30355":71251,"_21010":119540,"_5":14420,"_27589":119459,"_2954":119541},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3471":71289,"_30355":71251,"_21010":119543,"_5":14420,"_27589":119459,"_2954":52330},[],{"_3471":71290,"_30355":71251,"_21010":119545,"_5":14420,"_27589":119459,"_2954":119546},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3471":71291,"_30355":71251,"_21010":119548,"_5":14420,"_27589":119459,"_2954":52336},[],{"_3471":71292,"_30355":71251,"_21010":119550,"_5":14420,"_27589":119459,"_2954":119551},[],"Uno de los cuatro modos de autenticación.",{"_3471":71293,"_30355":71251,"_21010":119553,"_5":14420,"_27589":119459,"_2954":119554},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3471":71294,"_30355":71251,"_21010":119556,"_5":14420,"_27589":119462,"_2954":119557},[],"Los bloques son independientes:",{"_3471":71295,"_30355":71251,"_21010":119559,"_5":14420,"_27589":119462,"_2954":119560},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3471":71296,"_30355":71251,"_21010":119562,"_5":14420,"_27589":119462,"_2954":119563},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3471":71297,"_30355":71251,"_21010":119565,"_5":14420,"_27589":119462,"_2954":52354},[],{"_3471":71298,"_30355":71251,"_21010":119567,"_5":14420,"_27589":119462,"_2954":119568},[],"Control aplicado en la operación configurada",{"_3471":71299,"_30355":71251,"_21010":119570,"_5":14420,"_27589":119462,"_2954":52360},[],{"_3471":71300,"_30355":71251,"_21010":119572,"_5":14420,"_27589":119462,"_2954":119573},[],"Validación del certificado presentado.",{"_3471":71301,"_30355":71251,"_21010":119575,"_5":14420,"_27589":119462,"_2954":52366},[],{"_3471":71302,"_30355":71251,"_21010":119577,"_5":14420,"_27589":119462,"_2954":119578},[],"Autorización del webhook configurado.",{"_3471":71303,"_30355":71251,"_21010":119580,"_5":14420,"_27589":119462,"_2954":52372},[],{"_3471":71304,"_30355":71251,"_21010":119582,"_5":14420,"_27589":119462,"_2954":119583},[],"Validación del certificado y, después, aprobación del webhook.",{"_3471":71305,"_30355":71251,"_21010":119585,"_5":14420,"_27589":119462,"_2954":52378},[],{"_3471":71306,"_30355":71251,"_21010":119587,"_5":14420,"_27589":119462,"_2954":119588},[],"Sin autenticación del solicitante por el DMS.",{"_3471":71307,"_30355":71251,"_21010":119590,"_5":14420,"_27589":119462,"_2954":119591},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3471":71308,"_30355":71251,"_21010":119593,"_5":14420,"_27589":119462,"_2954":119594},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3471":71309,"_30355":71251,"_21010":119596,"_5":14420,"_27589":119462,"_2954":119597},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3471":71310,"_30355":71251,"_21010":119599,"_5":14420,"_27589":119462,"_2954":119600},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3471":71311,"_30355":71251,"_21010":119602,"_5":14420,"_27589":119466,"_2954":119603},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3471":71312,"_30355":71251,"_21010":119605,"_5":14420,"_27589":119466,"_2954":119606},[],"Campo de `external_webhook_settings`",{"_3471":71313,"_30355":71251,"_21010":119608,"_5":14420,"_27589":119466,"_2954":119526},[],{"_3471":71314,"_30355":71251,"_21010":119610,"_5":14420,"_27589":119466,"_2954":52404},[],{"_3471":71315,"_30355":71251,"_21010":119612,"_5":14420,"_27589":119466,"_2954":119613},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3471":71316,"_30355":71251,"_21010":119615,"_5":14420,"_27589":119466,"_2954":52410},[],{"_3471":71317,"_30355":71251,"_21010":119617,"_5":14420,"_27589":119466,"_2954":119618},[],"`POST` o `PUT`; `POST` por defecto.",{"_3471":71318,"_30355":71251,"_21010":119620,"_5":14420,"_27589":119466,"_2954":52416},[],{"_3471":71319,"_30355":71251,"_21010":119622,"_5":14420,"_27589":119466,"_2954":119623},[],"Etiqueta usada en los logs del servicio.",{"_3471":71320,"_30355":71251,"_21010":119625,"_5":14420,"_27589":119466,"_2954":52422},[],{"_3471":71321,"_30355":71251,"_21010":119627,"_5":14420,"_27589":119466,"_2954":119628},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3471":71322,"_30355":71251,"_21010":119630,"_5":14420,"_27589":119466,"_2954":52428},[],{"_3471":71323,"_30355":71251,"_21010":119632,"_5":14420,"_27589":119466,"_2954":119633},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3471":71324,"_30355":71251,"_21010":119635,"_5":14420,"_27589":119466,"_2954":52434},[],{"_3471":71325,"_30355":71251,"_21010":119637,"_5":14420,"_27589":119466,"_2954":119638},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3471":71326,"_30355":71251,"_21010":119640,"_5":14420,"_27589":119466,"_2954":52440},[],{"_3471":71327,"_30355":71251,"_21010":119642,"_5":14420,"_27589":119466,"_2954":119643},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3471":71328,"_30355":71251,"_21010":119645,"_5":14420,"_27589":119466,"_2954":52446},[],{"_3471":71329,"_30355":71251,"_21010":119647,"_5":14420,"_27589":119466,"_2954":119648},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3471":71330,"_30355":71251,"_21010":119650,"_5":14420,"_27589":119466,"_2954":52452},[],{"_3471":71331,"_30355":71251,"_21010":119652,"_5":14420,"_27589":119466,"_2954":119653},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3471":71332,"_30355":71251,"_21010":119655,"_5":14420,"_27589":119466,"_2954":52458},[],{"_3471":71333,"_30355":71251,"_21010":119657,"_5":14420,"_27589":119466,"_2954":119658},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3471":71334,"_30355":71251,"_21010":119660,"_5":14420,"_27589":119466,"_2954":119661},[],"Reglas de esa configuración:",{"_3471":71335,"_30355":71251,"_21010":119663,"_5":14420,"_27589":119466,"_2954":119664},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3471":71336,"_30355":71251,"_21010":119666,"_5":14420,"_27589":119466,"_2954":119667},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3471":71337,"_30355":71251,"_21010":119669,"_5":14420,"_27589":119466,"_2954":119670},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3471":71338,"_30355":71251,"_21010":119672,"_5":14420,"_27589":119466,"_2954":119673},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3471":71339,"_30355":71251,"_21010":119675,"_5":14420,"_27589":119466,"_2954":119676},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3471":71340,"_30355":71251,"_21010":119678,"_5":14420,"_27589":119466,"_2954":119679},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3471":71341,"_30355":71251,"_21010":119681,"_5":14420,"_27589":119466,"_2954":119682},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3471":71342,"_30355":71251,"_21010":119684,"_5":14420,"_27589":119466,"_2954":119685},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3471":71343,"_30355":71251,"_21010":119687,"_5":14420,"_27589":119466,"_2954":119688},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3471":71344,"_30355":71251,"_21010":119690,"_5":14420,"_27589":119470,"_2954":119691},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3471":71345,"_30355":71251,"_21010":119693,"_5":14420,"_27589":119474,"_2954":119694},[],"Campo de `settings.reenrollment_settings`",{"_3471":71346,"_30355":71251,"_21010":119696,"_5":14420,"_27589":119474,"_2954":119697},[],"Función",{"_3471":71347,"_30355":71251,"_21010":119699,"_5":14420,"_27589":119474,"_2954":52502},[],{"_3471":71348,"_30355":71251,"_21010":119701,"_5":14420,"_27589":119474,"_2954":119702},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3471":71349,"_30355":71251,"_21010":119704,"_5":14420,"_27589":119474,"_2954":52508},[],{"_3471":71350,"_30355":71251,"_21010":119706,"_5":14420,"_27589":119474,"_2954":119707},[],"Umbral operativo preventivo de monitorización.",{"_3471":71351,"_30355":71251,"_21010":119709,"_5":14420,"_27589":119474,"_2954":52514},[],{"_3471":71352,"_30355":71251,"_21010":119711,"_5":14420,"_27589":119474,"_2954":119712},[],"Umbral operativo crítico de monitorización.",{"_3471":71353,"_30355":71251,"_21010":119714,"_5":14420,"_27589":119474,"_2954":52520},[],{"_3471":71354,"_30355":71251,"_21010":119716,"_5":14420,"_27589":119474,"_2954":119717},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3471":71355,"_30355":71251,"_21010":119719,"_5":14420,"_27589":119474,"_2954":52526},[],{"_3471":71356,"_30355":71251,"_21010":119721,"_5":14420,"_27589":119474,"_2954":119722},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3471":71357,"_30355":71251,"_21010":119724,"_5":14420,"_27589":119474,"_2954":52532},[],{"_3471":71358,"_30355":71251,"_21010":119726,"_5":14420,"_27589":119474,"_2954":119727},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3471":71359,"_30355":71251,"_21010":119729,"_5":14420,"_27589":119474,"_2954":119730},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3471":71360,"_30355":71251,"_21010":119732,"_5":14420,"_27589":119478,"_2954":119733},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3471":71361,"_30355":71251,"_21010":119735,"_5":14420,"_27589":119481,"_2954":117091},[],{"_3471":71362,"_30355":71251,"_21010":119737,"_5":14420,"_27589":119481,"_2954":119738},[],"Qué publica",{"_3471":71363,"_30355":71251,"_21010":119740,"_5":14420,"_27589":119481,"_2954":52549},[],{"_3471":71364,"_30355":71251,"_21010":119742,"_5":14420,"_27589":119481,"_2954":119743},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3471":71365,"_30355":71251,"_21010":119745,"_5":14420,"_27589":119481,"_2954":52555},[],{"_3471":71366,"_30355":71251,"_21010":119747,"_5":14420,"_27589":119481,"_2954":119748},[],"Certificado de la CA emisora seleccionada.",{"_3471":71367,"_30355":71251,"_21010":119750,"_5":14420,"_27589":119481,"_2954":52561},[],{"_3471":71368,"_30355":71251,"_21010":119752,"_5":14420,"_27589":119481,"_2954":119753},[],"Certificados de las CAs elegidas explícitamente.",{"_3471":71369,"_30355":71251,"_21010":119755,"_5":14420,"_27589":119481,"_2954":119756},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3471":71370,"_30355":71251,"_21010":119758,"_5":14420,"_27589":119485,"_2954":119759},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3471":71371,"_30355":71251,"_21010":119761,"_5":14420,"_27589":119485,"_2954":119762},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3471":71372,"_30355":71251,"_21010":119764,"_5":14420,"_27589":119485,"_2954":119765},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3471":71373,"_30355":71251,"_21010":119767,"_5":14420,"_27589":119489,"_2954":119768},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3471":71374,"_30355":71374,"_5":14772,"_2954":119770,"_30708":119771,"_21010":119772,"_27589":71374},"Integra el cliente EST",[49453,118156,51942,119168,119343],[],{"_3471":71375,"_30355":71374,"_21010":119774,"_5":14420,"_27589":71374,"_2954":119775},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3471":71376,"_30355":71374,"_5":30705,"_21010":119777,"_27589":119778,"_2954":116727},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3471":71377,"_30355":71374,"_5":30705,"_21010":119780,"_27589":119781,"_2954":119782},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3471":71378,"_30355":71374,"_5":30705,"_21010":119784,"_27589":119785,"_2954":119786},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3471":71379,"_30355":71374,"_5":30705,"_21010":119788,"_27589":119789,"_2954":119790},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3471":71380,"_30355":71374,"_5":30705,"_21010":119792,"_27589":119793,"_2954":119794},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3471":71381,"_30355":71374,"_5":30705,"_21010":119796,"_27589":119797,"_2954":119798},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3471":71382,"_30355":71374,"_21010":119800,"_5":14420,"_27589":71374,"_2954":119801},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3471":71383,"_30355":71374,"_21010":119803,"_5":14420,"_27589":119778,"_2954":119804},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3471":71384,"_30355":71374,"_21010":119806,"_5":14420,"_27589":119778,"_2954":119807},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3471":71385,"_30355":71374,"_21010":119809,"_5":14420,"_27589":119778,"_2954":119810},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3471":71386,"_30355":71374,"_21010":119812,"_5":14420,"_27589":119781,"_2954":119813},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3471":71387,"_30355":71374,"_21010":119815,"_5":14420,"_27589":119781,"_2954":119816},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3471":71388,"_30355":71374,"_21010":119818,"_5":14420,"_27589":119785,"_2954":119819},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3471":71389,"_30355":71374,"_21010":119821,"_5":14420,"_27589":119785,"_2954":119822},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3471":71390,"_30355":71374,"_21010":119824,"_5":14420,"_27589":119789,"_2954":119825},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3471":71391,"_30355":71374,"_21010":119827,"_5":14420,"_27589":119789,"_2954":119828},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3471":71392,"_30355":71374,"_21010":119830,"_5":14420,"_27589":119793,"_2954":119831},[],"Para el caso de una raíz que emite directamente:",{"_3471":71393,"_30355":71374,"_21010":119833,"_5":14420,"_27589":119793,"_2954":119834},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3471":71394,"_30355":71374,"_21010":119836,"_5":14420,"_27589":119793,"_2954":119837},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3471":71395,"_30355":71374,"_21010":119839,"_5":14420,"_27589":119797,"_2954":119840},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3471":71396,"_30355":71396,"_5":14772,"_2954":119842,"_30708":119843,"_21010":119844,"_27589":71396},"Referencia EST",[49453,118156,51942,119168,119343],[],{"_3471":71397,"_30355":71396,"_21010":119846,"_5":14420,"_27589":71396,"_2954":119847},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3471":71398,"_30355":71396,"_5":30705,"_21010":119849,"_27589":119850,"_2954":119851},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3471":71399,"_30355":71396,"_5":30705,"_21010":119853,"_27589":119854,"_2954":22765},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3471":71400,"_30355":71396,"_5":30705,"_21010":119856,"_27589":119857,"_2954":26172},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3471":71401,"_30355":71396,"_5":30705,"_21010":119859,"_27589":119860,"_2954":26179},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3471":71402,"_30355":71396,"_5":30705,"_21010":119862,"_27589":119863,"_2954":25492},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3471":71403,"_30355":71396,"_5":30705,"_21010":119865,"_27589":119866,"_2954":119867},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3471":71404,"_30355":71396,"_5":30705,"_21010":119869,"_27589":119870,"_2954":119871},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3471":71405,"_30355":71396,"_5":30705,"_21010":119873,"_27589":119874,"_2954":119875},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3471":71406,"_30355":71396,"_21010":119877,"_5":14420,"_27589":71396,"_2954":119878},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3471":71407,"_30355":71396,"_21010":119880,"_5":14420,"_27589":119850,"_2954":119881},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3471":71408,"_30355":71396,"_21010":119883,"_5":14420,"_27589":119850,"_2954":117916},[],{"_3471":71409,"_30355":71396,"_21010":119885,"_5":14420,"_27589":119850,"_2954":119886},[],"Método",{"_3471":71410,"_30355":71396,"_21010":119888,"_5":14420,"_27589":119850,"_2954":119889},[],"Autenticación y condición",{"_3471":71411,"_30355":71396,"_21010":119891,"_5":14420,"_27589":119850,"_2954":52704},[],{"_3471":71412,"_30355":71396,"_21010":119893,"_5":14420,"_27589":119850,"_2954":52707},[],{"_3471":71413,"_30355":71396,"_21010":119895,"_5":14420,"_27589":119850,"_2954":119896},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3471":71414,"_30355":71396,"_21010":119898,"_5":14420,"_27589":119850,"_2954":52713},[],{"_3471":71415,"_30355":71396,"_21010":119900,"_5":14420,"_27589":119850,"_2954":52716},[],{"_3471":71416,"_30355":71396,"_21010":119902,"_5":14420,"_27589":119850,"_2954":119903},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3471":71417,"_30355":71396,"_21010":119905,"_5":14420,"_27589":119850,"_2954":52722},[],{"_3471":71418,"_30355":71396,"_21010":119907,"_5":14420,"_27589":119850,"_2954":52716},[],{"_3471":71419,"_30355":71396,"_21010":119909,"_5":14420,"_27589":119850,"_2954":119910},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3471":71420,"_30355":71396,"_21010":119912,"_5":14420,"_27589":119850,"_2954":52730},[],{"_3471":71421,"_30355":71396,"_21010":119914,"_5":14420,"_27589":119850,"_2954":52716},[],{"_3471":71422,"_30355":71396,"_21010":119916,"_5":14420,"_27589":119850,"_2954":119917},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3471":71423,"_30355":71396,"_21010":119919,"_5":14420,"_27589":119850,"_2954":119920},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3471":71424,"_30355":71396,"_21010":119922,"_5":14420,"_27589":119854,"_2954":119923},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3471":71425,"_30355":71396,"_21010":119925,"_5":14420,"_27589":119854,"_2954":119926},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3471":71426,"_30355":71396,"_21010":119928,"_5":14420,"_27589":119857,"_2954":119929},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3471":71427,"_30355":71396,"_21010":119931,"_5":14420,"_27589":119857,"_2954":119932},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3471":71428,"_30355":71396,"_21010":119934,"_5":14420,"_27589":119860,"_2954":119935},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3471":71429,"_30355":71396,"_21010":119937,"_5":14420,"_27589":119860,"_2954":119938},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3471":71430,"_30355":71396,"_21010":119940,"_5":14420,"_27589":119863,"_2954":119941},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3471":71431,"_30355":71396,"_21010":119943,"_5":14420,"_27589":119863,"_2954":119944},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3471":71432,"_30355":71396,"_21010":119946,"_5":14420,"_27589":119866,"_2954":119947},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3471":71433,"_30355":71396,"_21010":119949,"_5":14420,"_27589":119866,"_2954":119950},[],"Parte",{"_3471":71434,"_30355":71396,"_21010":119952,"_5":14420,"_27589":119866,"_2954":119953},[],"Contenido tras decodificar su Base64",{"_3471":71435,"_30355":71396,"_21010":119955,"_5":14420,"_27589":119866,"_2954":52774},[],{"_3471":71436,"_30355":71396,"_21010":119957,"_5":14420,"_27589":119866,"_2954":119958},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3471":71437,"_30355":71396,"_21010":119960,"_5":14420,"_27589":119866,"_2954":52780},[],{"_3471":71438,"_30355":71396,"_21010":119962,"_5":14420,"_27589":119866,"_2954":119963},[],"PKCS#7 DER con el certificado emitido.",{"_3471":71439,"_30355":71396,"_21010":119965,"_5":14420,"_27589":119866,"_2954":119966},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3471":71440,"_30355":71396,"_21010":119968,"_5":14420,"_27589":119870,"_2954":119969},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3471":71441,"_30355":71396,"_21010":119971,"_5":14420,"_27589":119870,"_2954":119972},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3471":71442,"_30355":71396,"_21010":119974,"_5":14420,"_27589":119870,"_2954":119975},[],"Convierte y comprueba el resultado:",{"_3471":71443,"_30355":71396,"_21010":119977,"_5":14420,"_27589":119870,"_2954":119978},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3471":71444,"_30355":71396,"_21010":119980,"_5":14420,"_27589":119874,"_2954":119981},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3471":71445,"_30355":71396,"_21010":119983,"_5":14420,"_27589":119874,"_2954":119984},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3471":71446,"_30355":71446,"_5":14772,"_2954":119343,"_30708":119986,"_21010":119987,"_27589":71446},[49453,118156,51942,119168,119343],[],{"_3471":71447,"_30355":71446,"_21010":119989,"_5":14420,"_27589":71446,"_2954":119990},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3471":71448,"_30355":71446,"_5":30705,"_21010":119992,"_27589":119993,"_2954":119994},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3471":71449,"_30355":71446,"_5":30705,"_21010":119996,"_27589":119997,"_2954":119998},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3471":71450,"_30355":71446,"_5":30705,"_21010":120000,"_27589":120001,"_2954":120002},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3471":71451,"_30355":71446,"_5":30705,"_21010":120004,"_27589":120005,"_2954":120006},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3471":71452,"_30355":71446,"_21010":120008,"_5":14420,"_27589":71446,"_2954":120009},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3471":71453,"_30355":71446,"_21010":120011,"_5":14420,"_27589":119993,"_2954":120012},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3471":71454,"_30355":71446,"_21010":120014,"_5":14420,"_27589":119993,"_2954":120015},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3471":71455,"_30355":71446,"_21010":120017,"_5":14420,"_27589":119993,"_2954":120018},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3471":71456,"_30355":71446,"_21010":120020,"_5":14420,"_27589":119993,"_2954":120021},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3471":71457,"_30355":71446,"_21010":120023,"_5":14420,"_27589":119993,"_2954":120024},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3471":71458,"_30355":71446,"_21010":120026,"_5":14420,"_27589":119993,"_2954":120027},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3471":71459,"_30355":71446,"_21010":120029,"_5":14420,"_27589":119997,"_2954":120030},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3471":71460,"_30355":71446,"_21010":120032,"_5":14420,"_27589":119997,"_2954":120033},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3471":71461,"_30355":71446,"_21010":120035,"_5":14420,"_27589":119997,"_2954":120036},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3471":71462,"_30355":71446,"_21010":120038,"_5":14420,"_27589":119997,"_2954":120039},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3471":71463,"_30355":71446,"_21010":120041,"_5":14420,"_27589":120001,"_2954":120042},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3471":71464,"_30355":71446,"_21010":120044,"_5":14420,"_27589":120001,"_2954":120045},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3471":71465,"_30355":71446,"_21010":120047,"_5":14420,"_27589":120001,"_2954":120048},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3471":71466,"_30355":71446,"_21010":120050,"_5":14420,"_27589":120001,"_2954":120051},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3471":71467,"_30355":71446,"_21010":120053,"_5":14420,"_27589":120005,"_2954":120054},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3471":71468,"_30355":71446,"_21010":120056,"_5":14420,"_27589":120005,"_2954":120057},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3471":71469,"_30355":71469,"_5":14772,"_2954":120059,"_30708":120060,"_21010":120061,"_27589":71469},"Estrategias de aprovisionamiento",[49453,118156,51942,119168,119343],[],{"_3471":71470,"_30355":71469,"_21010":120063,"_5":14420,"_27589":71469,"_2954":120064},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3471":71471,"_30355":71469,"_5":30705,"_21010":120066,"_27589":120067,"_2954":120068},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3471":71472,"_30355":71469,"_5":30705,"_21010":120070,"_27589":120071,"_2954":120072},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3471":71473,"_30355":71469,"_5":30705,"_21010":120074,"_27589":120075,"_2954":120076},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3471":71474,"_30355":71469,"_5":30705,"_21010":120078,"_27589":120079,"_2954":120080},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3471":71475,"_30355":71469,"_5":30705,"_21010":120082,"_27589":120083,"_2954":120084},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3471":71476,"_30355":71469,"_21010":120086,"_5":14420,"_27589":71469,"_2954":120087},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3471":71477,"_30355":71469,"_21010":120089,"_5":14420,"_27589":120067,"_2954":120090},[],"Recorrido",{"_3471":71478,"_30355":71469,"_21010":120092,"_5":14420,"_27589":120067,"_2954":120093},[],"Cuándo existe el dispositivo",{"_3471":71479,"_30355":71469,"_21010":120095,"_5":14420,"_27589":120067,"_2954":120096},[],"Qué compruebas",{"_3471":71480,"_30355":71469,"_21010":120098,"_5":14420,"_27589":120067,"_2954":120099},[],"Asignación manual",{"_3471":71481,"_30355":71469,"_21010":120101,"_5":14420,"_27589":120067,"_2954":120102},[],"El operador lo crea antes de asociar un certificado.",{"_3471":71482,"_30355":71469,"_21010":120104,"_5":14420,"_27589":120067,"_2954":120105},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3471":71483,"_30355":71469,"_21010":120107,"_5":14420,"_27589":120067,"_2954":120108},[],"EST con `JITP`",{"_3471":71484,"_30355":71469,"_21010":120110,"_5":14420,"_27589":120067,"_2954":120111},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3471":71485,"_30355":71469,"_21010":120113,"_5":14420,"_27589":120067,"_2954":120114},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3471":71486,"_30355":71469,"_21010":120116,"_5":14420,"_27589":120067,"_2954":120117},[],"EST con `PRE_REGISTRATION`",{"_3471":71487,"_30355":71469,"_21010":120119,"_5":14420,"_27589":120067,"_2954":120120},[],"Debe existir antes de `/simpleenroll`.",{"_3471":71488,"_30355":71469,"_21010":120122,"_5":14420,"_27589":120067,"_2954":120123},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3471":71489,"_30355":71469,"_21010":120125,"_5":14420,"_27589":120067,"_2954":120126},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3471":71490,"_30355":71469,"_21010":120128,"_5":14420,"_27589":120067,"_2954":120129},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3471":71491,"_30355":71469,"_21010":120131,"_5":14420,"_27589":120071,"_2954":120132},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3471":71492,"_30355":71469,"_21010":120134,"_5":14420,"_27589":120071,"_2954":120135},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3471":71493,"_30355":71469,"_21010":120137,"_5":14420,"_27589":120071,"_2954":120138},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3471":71494,"_30355":71469,"_21010":120140,"_5":14420,"_27589":120075,"_2954":120141},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3471":71495,"_30355":71469,"_21010":120143,"_5":14420,"_27589":120075,"_2954":120144},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3471":71496,"_30355":71469,"_21010":120146,"_5":14420,"_27589":120075,"_2954":120147},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3471":71497,"_30355":71469,"_21010":120149,"_5":14420,"_27589":120075,"_2954":120150},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3471":71498,"_30355":71469,"_21010":120152,"_5":14420,"_27589":120075,"_2954":120153},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3471":71499,"_30355":71469,"_21010":120155,"_5":14420,"_27589":120075,"_2954":120156},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3471":71500,"_30355":71469,"_21010":120158,"_5":14420,"_27589":120079,"_2954":117091},[],{"_3471":71501,"_30355":71469,"_21010":120160,"_5":14420,"_27589":120079,"_2954":120161},[],"Material que atraviesa EST",{"_3471":71502,"_30355":71469,"_21010":120163,"_5":14420,"_27589":120079,"_2954":120164},[],"Clave generada por el dispositivo",{"_3471":71503,"_30355":71469,"_21010":120166,"_5":14420,"_27589":120079,"_2954":120167},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3471":71504,"_30355":71469,"_21010":120169,"_5":14420,"_27589":120079,"_2954":120170},[],"Clave ya disponible en el dispositivo",{"_3471":71505,"_30355":71469,"_21010":120172,"_5":14420,"_27589":120079,"_2954":120173},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3471":71506,"_30355":71469,"_21010":120175,"_5":14420,"_27589":120079,"_2954":52261},[],{"_3471":71507,"_30355":71469,"_21010":120177,"_5":14420,"_27589":120079,"_2954":120178},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3471":71508,"_30355":71469,"_21010":120180,"_5":14420,"_27589":120079,"_2954":120181},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3471":71509,"_30355":71469,"_21010":120183,"_5":14420,"_27589":120083,"_2954":120184},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3471":71510,"_30355":71510,"_5":14772,"_2954":120186,"_30708":120187,"_21010":120188,"_27589":71510},"Renovación y recuperación",[49453,118156,51942,119168,119343],[],{"_3471":71511,"_30355":71510,"_21010":120190,"_5":14420,"_27589":71510,"_2954":120191},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3471":71512,"_30355":71510,"_5":30705,"_21010":120193,"_27589":120194,"_2954":120195},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3471":71513,"_30355":71510,"_5":30705,"_21010":120197,"_27589":120198,"_2954":120199},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3471":71514,"_30355":71510,"_5":30705,"_21010":120201,"_27589":120202,"_2954":120203},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3471":71515,"_30355":71510,"_5":30705,"_21010":120205,"_27589":120206,"_2954":120207},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3471":71516,"_30355":71510,"_5":30705,"_21010":120209,"_27589":120210,"_2954":120211},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3471":71517,"_30355":71510,"_21010":120213,"_5":14420,"_27589":71510,"_2954":120214},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3471":71518,"_30355":71510,"_21010":120216,"_5":14420,"_27589":120194,"_2954":120217},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3471":71519,"_30355":71510,"_21010":120219,"_5":14420,"_27589":120194,"_2954":120220},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3471":71520,"_30355":71510,"_21010":120222,"_5":14420,"_27589":120194,"_2954":120223},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3471":71521,"_30355":71510,"_21010":120225,"_5":14420,"_27589":120194,"_2954":120226},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3471":71522,"_30355":71510,"_21010":120228,"_5":14420,"_27589":120198,"_2954":120229},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3471":71523,"_30355":71510,"_21010":120231,"_5":14420,"_27589":120198,"_2954":120232},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3471":71524,"_30355":71510,"_21010":120234,"_5":14420,"_27589":120202,"_2954":120235},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3471":71525,"_30355":71510,"_21010":120237,"_5":14420,"_27589":120202,"_2954":120238},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3471":71526,"_30355":71510,"_21010":120240,"_5":14420,"_27589":120202,"_2954":120241},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3471":71527,"_30355":71510,"_21010":120243,"_5":14420,"_27589":120206,"_2954":120244},[],"Situación",{"_3471":71528,"_30355":71510,"_21010":120246,"_5":14420,"_27589":120206,"_2954":120247},[],"Procedimiento",{"_3471":71529,"_30355":71510,"_21010":120249,"_5":14420,"_27589":120206,"_2954":120250},[],"Certificado vigente, fuera de ventana",{"_3471":71530,"_30355":71510,"_21010":120252,"_5":14420,"_27589":120206,"_2954":120253},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3471":71531,"_30355":71510,"_21010":120255,"_5":14420,"_27589":120206,"_2954":120256},[],"Certificado vencido, clave disponible",{"_3471":71532,"_30355":71510,"_21010":120258,"_5":14420,"_27589":120206,"_2954":120259},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3471":71533,"_30355":71510,"_21010":120261,"_5":14420,"_27589":120206,"_2954":120262},[],"Renovación por webhook o `NO_AUTH`",{"_3471":71534,"_30355":71510,"_21010":120264,"_5":14420,"_27589":120206,"_2954":120265},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3471":71535,"_30355":71510,"_21010":120267,"_5":14420,"_27589":120206,"_2954":120268},[],"Clave perdida o inaccesible",{"_3471":71536,"_30355":71510,"_21010":120270,"_5":14420,"_27589":120206,"_2954":120271},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3471":71537,"_30355":71510,"_21010":120273,"_5":14420,"_27589":120206,"_2954":120274},[],"Identidad actual revocada",{"_3471":71538,"_30355":71510,"_21010":120276,"_5":14420,"_27589":120206,"_2954":120277},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3471":71539,"_30355":71510,"_21010":120279,"_5":14420,"_27589":120206,"_2954":120280},[],"Dispositivo sin identidad",{"_3471":71540,"_30355":71510,"_21010":120282,"_5":14420,"_27589":120206,"_2954":120283},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3471":71541,"_30355":71510,"_21010":120285,"_5":14420,"_27589":120206,"_2954":120286},[],"Dispositivo retirado",{"_3471":71542,"_30355":71510,"_21010":120288,"_5":14420,"_27589":120206,"_2954":120289},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3471":71543,"_30355":71510,"_21010":120291,"_5":14420,"_27589":120206,"_2954":120292},[],"Timeout, HTTP 500 o fallo de instalación",{"_3471":71544,"_30355":71510,"_21010":120294,"_5":14420,"_27589":120206,"_2954":120295},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3471":71545,"_30355":71510,"_21010":120297,"_5":14420,"_27589":120210,"_2954":120298},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3471":71546,"_30355":71510,"_21010":120300,"_5":14420,"_27589":120210,"_2954":120301},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3471":71547,"_30355":71547,"_5":14772,"_2954":120303,"_30708":120304,"_21010":120305,"_27589":71547},"Diagnóstico de enrolamiento",[49453,118156,51942,119168,119343],[],{"_3471":71548,"_30355":71547,"_21010":120307,"_5":14420,"_27589":71547,"_2954":120308},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3471":71549,"_30355":71547,"_5":30705,"_21010":120310,"_27589":120311,"_2954":120312},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3471":71550,"_30355":71547,"_5":30705,"_21010":120314,"_27589":120315,"_2954":120316},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3471":71551,"_30355":71547,"_5":30705,"_21010":120318,"_27589":120319,"_2954":119875},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3471":71552,"_30355":71547,"_5":30705,"_21010":120321,"_27589":120322,"_2954":120323},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3471":71553,"_30355":71547,"_21010":120325,"_5":14420,"_27589":71547,"_2954":120326},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3471":71554,"_30355":71547,"_21010":120328,"_5":14420,"_27589":120315,"_2954":120329},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3471":71555,"_30355":71547,"_21010":120331,"_5":14420,"_27589":120315,"_2954":120332},[],"Síntoma o mensaje",{"_3471":71556,"_30355":71547,"_21010":120334,"_5":14420,"_27589":120315,"_2954":120335},[],"Qué revisar",{"_3471":71557,"_30355":71547,"_21010":120337,"_5":14420,"_27589":120315,"_2954":120338},[],"curl rechaza TLS, nombre o emisor",{"_3471":71558,"_30355":71547,"_21010":120340,"_5":14420,"_27589":120315,"_2954":120341},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3471":71559,"_30355":71547,"_21010":120343,"_5":14420,"_27589":120315,"_2954":120344},[],"404 o APS ausente",{"_3471":71560,"_30355":71547,"_21010":120346,"_5":14420,"_27589":120315,"_2954":120347},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3471":71561,"_30355":71547,"_21010":120349,"_5":14420,"_27589":120315,"_2954":120350},[],"400, error de CSR o formato",{"_3471":71562,"_30355":71547,"_21010":120352,"_5":14420,"_27589":120315,"_2954":120353},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3471":71563,"_30355":71547,"_21010":120355,"_5":14420,"_27589":120315,"_2954":120356},[],"Credencial ausente o certificado no válido",{"_3471":71564,"_30355":71547,"_21010":120358,"_5":14420,"_27589":120315,"_2954":120359},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3471":71565,"_30355":71547,"_21010":120361,"_5":14420,"_27589":120315,"_2954":120362},[],"Webhook deniega, expira o responde sin autorización",{"_3471":71566,"_30355":71547,"_21010":120364,"_5":14420,"_27589":120315,"_2954":120365},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3471":71567,"_30355":71547,"_21010":120367,"_5":14420,"_27589":120315,"_2954":53187},[],{"_3471":71568,"_30355":71547,"_21010":120369,"_5":14420,"_27589":120315,"_2954":120370},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3471":71569,"_30355":71547,"_21010":120372,"_5":14420,"_27589":120315,"_2954":53193},[],{"_3471":71570,"_30355":71547,"_21010":120374,"_5":14420,"_27589":120315,"_2954":120375},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3471":71571,"_30355":71547,"_21010":120377,"_5":14420,"_27589":120315,"_2954":53199},[],{"_3471":71572,"_30355":71547,"_21010":120379,"_5":14420,"_27589":120315,"_2954":120380},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3471":71573,"_30355":71547,"_21010":120382,"_5":14420,"_27589":120315,"_2954":53205},[],{"_3471":71574,"_30355":71547,"_21010":120384,"_5":14420,"_27589":120315,"_2954":120385},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3471":71575,"_30355":71547,"_21010":120387,"_5":14420,"_27589":120315,"_2954":53211},[],{"_3471":71576,"_30355":71547,"_21010":120389,"_5":14420,"_27589":120315,"_2954":120390},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3471":71577,"_30355":71547,"_21010":120392,"_5":14420,"_27589":120315,"_2954":120393},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3471":71578,"_30355":71547,"_21010":120395,"_5":14420,"_27589":120315,"_2954":120396},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3471":71579,"_30355":71547,"_21010":120398,"_5":14420,"_27589":120315,"_2954":120399},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3471":71580,"_30355":71547,"_21010":120401,"_5":14420,"_27589":120315,"_2954":120402},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3471":71581,"_30355":71547,"_21010":120404,"_5":14420,"_27589":120315,"_2954":53229},[],{"_3471":71582,"_30355":71547,"_21010":120406,"_5":14420,"_27589":120315,"_2954":120407},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3471":71583,"_30355":71547,"_21010":120409,"_5":14420,"_27589":120315,"_2954":53235},[],{"_3471":71584,"_30355":71547,"_21010":120411,"_5":14420,"_27589":120315,"_2954":120412},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3471":71585,"_30355":71547,"_21010":120414,"_5":14420,"_27589":120315,"_2954":120415},[],"DMS propietario distinto",{"_3471":71586,"_30355":71547,"_21010":120417,"_5":14420,"_27589":120315,"_2954":120418},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3471":71587,"_30355":71547,"_21010":120420,"_5":14420,"_27589":120315,"_2954":53247},[],{"_3471":71588,"_30355":71547,"_21010":120422,"_5":14420,"_27589":120315,"_2954":120423},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3471":71589,"_30355":71547,"_21010":120425,"_5":14420,"_27589":120315,"_2954":53253},[],{"_3471":71590,"_30355":71547,"_21010":120427,"_5":14420,"_27589":120315,"_2954":120428},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3471":71591,"_30355":71547,"_21010":120430,"_5":14420,"_27589":120315,"_2954":120431},[],"Certificado actual revocado",{"_3471":71592,"_30355":71547,"_21010":120433,"_5":14420,"_27589":120315,"_2954":120434},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3471":71593,"_30355":71547,"_21010":120436,"_5":14420,"_27589":120315,"_2954":120437},[],"Error de CA, perfil o firma",{"_3471":71594,"_30355":71547,"_21010":120439,"_5":14420,"_27589":120315,"_2954":120440},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3471":71595,"_30355":71547,"_21010":120442,"_5":14420,"_27589":120315,"_2954":120443},[],"HTTP 200 sin conexión del dispositivo",{"_3471":71596,"_30355":71547,"_21010":120445,"_5":14420,"_27589":120315,"_2954":120446},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3471":71597,"_30355":71547,"_21010":120448,"_5":14420,"_27589":120315,"_2954":120449},[],"Timeout o error después de emitir",{"_3471":71598,"_30355":71547,"_21010":120451,"_5":14420,"_27589":120315,"_2954":120452},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3471":71599,"_30355":71547,"_21010":120454,"_5":14420,"_27589":120319,"_2954":120455},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3471":71600,"_30355":71547,"_21010":120457,"_5":14420,"_27589":120319,"_2954":120458},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3471":71601,"_30355":71547,"_21010":120460,"_5":14420,"_27589":120322,"_2954":120461},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3471":71602,"_30355":71547,"_21010":120463,"_5":14420,"_27589":120322,"_2954":120464},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3471":71603,"_30355":71547,"_21010":120466,"_5":14420,"_27589":120322,"_2954":120467},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3471":71604,"_30355":71547,"_21010":120469,"_5":14420,"_27589":120322,"_2954":120470},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3471":71605,"_30355":71547,"_21010":120472,"_5":14420,"_27589":120322,"_2954":120473},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3471":71606,"_30355":71547,"_21010":120475,"_5":14420,"_27589":120322,"_2954":120476},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3471":71607,"_30355":71547,"_21010":120478,"_5":14420,"_27589":120322,"_2954":120479},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3471":71608,"_30355":71608,"_5":14772,"_2954":120481,"_30708":120482,"_21010":120483,"_27589":71608},"Distribución y actualización de confianza",[49453,118156,51942,119168,119343],[],{"_3471":71609,"_30355":71608,"_21010":120485,"_5":14420,"_27589":71608,"_2954":120486},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3471":71610,"_30355":71608,"_5":30705,"_21010":120488,"_27589":120489,"_2954":120490},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3471":71611,"_30355":71608,"_5":30705,"_21010":120492,"_27589":120493,"_2954":120494},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3471":71612,"_30355":71608,"_5":30705,"_21010":120496,"_27589":120497,"_2954":120498},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3471":71613,"_30355":71608,"_5":30705,"_21010":120500,"_27589":120501,"_2954":120502},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3471":71614,"_30355":71608,"_5":30705,"_21010":120504,"_27589":120505,"_2954":120506},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3471":71615,"_30355":71608,"_21010":120508,"_5":14420,"_27589":71608,"_2954":120509},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3471":71616,"_30355":71608,"_21010":120511,"_5":14420,"_27589":120489,"_2954":120512},[],"Relación",{"_3471":71617,"_30355":71608,"_21010":120514,"_5":14420,"_27589":120489,"_2954":120515},[],"Material que prepara el responsable",{"_3471":71618,"_30355":71608,"_21010":120517,"_5":14420,"_27589":120489,"_2954":120518},[],"Dispositivo → servidor EST",{"_3471":71619,"_30355":71608,"_21010":120520,"_5":14420,"_27589":120489,"_2954":120521},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3471":71620,"_30355":71608,"_21010":120523,"_5":14420,"_27589":120489,"_2954":120524},[],"DMS → solicitante",{"_3471":71621,"_30355":71608,"_21010":120526,"_5":14420,"_27589":120489,"_2954":120527},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3471":71622,"_30355":71608,"_21010":120529,"_5":14420,"_27589":120489,"_2954":120530},[],"Consumidor → dispositivo",{"_3471":71623,"_30355":71608,"_21010":120532,"_5":14420,"_27589":120489,"_2954":120533},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3471":71624,"_30355":71608,"_21010":120535,"_5":14420,"_27589":120489,"_2954":120536},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3471":71625,"_30355":71608,"_21010":120538,"_5":14420,"_27589":120493,"_2954":120539},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3471":71626,"_30355":71608,"_21010":120541,"_5":14420,"_27589":120493,"_2954":120542},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3471":71627,"_30355":71608,"_21010":120544,"_5":14420,"_27589":120497,"_2954":120545},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3471":71628,"_30355":71608,"_21010":120547,"_5":14420,"_27589":120497,"_2954":120548},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3471":71629,"_30355":71608,"_21010":120550,"_5":14420,"_27589":120497,"_2954":120551},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3471":71630,"_30355":71608,"_21010":120553,"_5":14420,"_27589":120497,"_2954":120554},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3471":71631,"_30355":71608,"_21010":120556,"_5":14420,"_27589":120497,"_2954":120557},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3471":71632,"_30355":71608,"_21010":120559,"_5":14420,"_27589":120497,"_2954":120560},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3471":71633,"_30355":71608,"_21010":120562,"_5":14420,"_27589":120501,"_2954":120563},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3471":71634,"_30355":71608,"_21010":120565,"_5":14420,"_27589":120501,"_2954":120566},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3471":71635,"_30355":71608,"_21010":120568,"_5":14420,"_27589":120501,"_2954":120569},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3471":71636,"_30355":71608,"_21010":120571,"_5":14420,"_27589":120505,"_2954":120572},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3471":71637,"_30355":71637,"_5":14772,"_2954":53402,"_30708":120574,"_21010":120576,"_27589":71637},[49453,118156,51942,119168,120575],"Integraciones",[],{"_3471":71638,"_30355":71637,"_21010":120578,"_5":14420,"_27589":71637,"_2954":120579},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3471":71639,"_30355":71637,"_5":30705,"_21010":120581,"_27589":120582,"_2954":120583},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3471":71640,"_30355":71637,"_5":30705,"_21010":120585,"_27589":120586,"_2954":120587},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3471":71641,"_30355":71637,"_5":30705,"_21010":120589,"_27589":120590,"_2954":120591},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3471":71642,"_30355":71637,"_5":30705,"_21010":120593,"_27589":120594,"_2954":120595},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3471":71643,"_30355":71637,"_5":30705,"_21010":120597,"_27589":120598,"_2954":120599},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3471":71644,"_30355":71637,"_5":30705,"_21010":120601,"_27589":120602,"_2954":120603},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3471":71645,"_30355":71637,"_5":30705,"_21010":120605,"_27589":120606,"_2954":120607},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3471":71646,"_30355":71637,"_5":30705,"_21010":120609,"_27589":120610,"_2954":120611},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3471":71647,"_30355":71637,"_5":30705,"_21010":120613,"_27589":120614,"_2954":53444},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3471":71648,"_30355":71637,"_5":30705,"_21010":120616,"_27589":120617,"_2954":53448},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3471":71649,"_30355":71637,"_5":30705,"_21010":120619,"_27589":120620,"_2954":120621},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3471":71650,"_30355":71637,"_5":30705,"_21010":120623,"_27589":120624,"_2954":120625},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3471":71651,"_30355":71637,"_5":30705,"_21010":120627,"_27589":120628,"_2954":120629},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3471":71652,"_30355":71637,"_5":30705,"_21010":120631,"_27589":120632,"_2954":120633},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3471":71653,"_30355":71637,"_5":30705,"_21010":120635,"_27589":120636,"_2954":120637},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3471":71654,"_30355":71637,"_5":30705,"_21010":120639,"_27589":120640,"_2954":120641},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3471":71655,"_30355":71637,"_5":30705,"_21010":120643,"_27589":120644,"_2954":120645},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3471":71656,"_30355":71637,"_5":30705,"_21010":120647,"_27589":120648,"_2954":120649},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3471":71657,"_30355":71637,"_5":30705,"_21010":120651,"_27589":120652,"_2954":120653},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3471":71658,"_30355":71637,"_5":30705,"_21010":120655,"_27589":120656,"_2954":120657},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3471":71659,"_30355":71637,"_5":30705,"_21010":120659,"_27589":120660,"_2954":120661},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3471":71660,"_30355":71637,"_5":30705,"_21010":120663,"_27589":120664,"_2954":120665},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3471":71661,"_30355":71637,"_5":30705,"_21010":120667,"_27589":120668,"_2954":120669},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3471":71662,"_30355":71637,"_5":30705,"_21010":120671,"_27589":120672,"_2954":120673},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3471":71663,"_30355":71637,"_5":30705,"_21010":120675,"_27589":120676,"_2954":120677},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3471":71664,"_30355":71637,"_21010":120679,"_5":14420,"_27589":71637,"_2954":120680},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3471":71665,"_30355":71637,"_21010":120682,"_5":14420,"_27589":71637,"_2954":120683},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3471":71666,"_30355":71637,"_21010":120685,"_5":14420,"_27589":71637,"_2954":120686},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3471":71667,"_30355":71637,"_21010":120688,"_5":14420,"_27589":120582,"_2954":120689},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3471":71668,"_30355":71637,"_21010":120691,"_5":14420,"_27589":120582,"_2954":120692},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3471":71669,"_30355":71637,"_21010":120694,"_5":14420,"_27589":120582,"_2954":120695},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3471":71670,"_30355":71637,"_21010":120697,"_5":14420,"_27589":120582,"_2954":120698},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3471":71671,"_30355":71637,"_21010":120700,"_5":14420,"_27589":120586,"_2954":120701},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3471":71672,"_30355":71637,"_21010":120703,"_5":14420,"_27589":120590,"_2954":120704},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3471":71673,"_30355":71637,"_21010":120706,"_5":14420,"_27589":120590,"_2954":120707},[],"Acción IAM",{"_3471":71674,"_30355":71637,"_21010":120709,"_5":14420,"_27589":120590,"_2954":117097},[],{"_3471":71675,"_30355":71637,"_21010":120711,"_5":14420,"_27589":120590,"_2954":53543},[],{"_3471":71676,"_30355":71637,"_21010":120713,"_5":14420,"_27589":120590,"_2954":120714},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3471":71677,"_30355":71637,"_21010":120716,"_5":14420,"_27589":120590,"_2954":53549},[],{"_3471":71678,"_30355":71637,"_21010":120718,"_5":14420,"_27589":120590,"_2954":120719},[],"Registrar la CA en AWS IoT",{"_3471":71679,"_30355":71637,"_21010":120721,"_5":14420,"_27589":120590,"_2954":53555},[],{"_3471":71680,"_30355":71637,"_21010":120723,"_5":14420,"_27589":120590,"_2954":120724},[],"Consultar el estado del registro de la CA",{"_3471":71681,"_30355":71637,"_21010":120726,"_5":14420,"_27589":120590,"_2954":53561},[],{"_3471":71682,"_30355":71637,"_21010":120728,"_5":14420,"_27589":120590,"_2954":120729},[],"Crear o actualizar Things en IoT Core",{"_3471":71683,"_30355":71637,"_21010":120731,"_5":14420,"_27589":120590,"_2954":53567},[],{"_3471":71684,"_30355":71637,"_21010":120733,"_5":14420,"_27589":120590,"_2954":120734},[],"Aprovisionar Things mediante plantilla",{"_3471":71685,"_30355":71637,"_21010":120736,"_5":14420,"_27589":120590,"_2954":53573},[],{"_3471":71686,"_30355":71637,"_21010":120738,"_5":14420,"_27589":120590,"_2954":120739},[],"Registrar certificados de dispositivo",{"_3471":71687,"_30355":71637,"_21010":120741,"_5":14420,"_27589":120590,"_2954":53579},[],{"_3471":71688,"_30355":71637,"_21010":120743,"_5":14420,"_27589":120590,"_2954":120744},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3471":71689,"_30355":71637,"_21010":120746,"_5":14420,"_27589":120590,"_2954":53585},[],{"_3471":71690,"_30355":71637,"_21010":120748,"_5":14420,"_27589":120590,"_2954":120749},[],"Crear y adjuntar políticas IoT",{"_3471":71691,"_30355":71637,"_21010":120751,"_5":14420,"_27589":120590,"_2954":53591},[],{"_3471":71692,"_30355":71637,"_21010":120753,"_5":14420,"_27589":120590,"_2954":120754},[],"Gestionar grupos de Things",{"_3471":71693,"_30355":71637,"_21010":120756,"_5":14420,"_27589":120590,"_2954":53597},[],{"_3471":71694,"_30355":71637,"_21010":120758,"_5":14420,"_27589":120590,"_2954":120759},[],"Crear plantillas JITP",{"_3471":71695,"_30355":71637,"_21010":120761,"_5":14420,"_27589":120590,"_2954":53603},[],{"_3471":71696,"_30355":71637,"_21010":120763,"_5":14420,"_27589":120590,"_2954":120764},[],"Leer y escribir el Device Shadow",{"_3471":71697,"_30355":71637,"_21010":120766,"_5":14420,"_27589":120590,"_2954":120767},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3471":71698,"_30355":71637,"_21010":120769,"_5":14420,"_27589":120594,"_2954":120770},[],"Parámetro",{"_3471":71699,"_30355":71637,"_21010":120772,"_5":14420,"_27589":120594,"_2954":120773},[],"Tipo",{"_3471":71700,"_30355":71637,"_21010":120775,"_5":14420,"_27589":120594,"_2954":120776},[],"Requerido",{"_3471":71701,"_30355":71637,"_21010":120778,"_5":14420,"_27589":120594,"_2954":120779},[],"Descripción",{"_3471":71702,"_30355":71637,"_21010":120781,"_5":14420,"_27589":120594,"_2954":53624},[],{"_3471":71703,"_30355":71637,"_21010":120783,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71704,"_30355":71637,"_21010":120785,"_5":14420,"_27589":120594,"_2954":120786},[],"Sí",{"_3471":71705,"_30355":71637,"_21010":120788,"_5":14420,"_27589":120594,"_2954":120789},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3471":71706,"_30355":71637,"_21010":120791,"_5":14420,"_27589":120594,"_2954":53635},[],{"_3471":71707,"_30355":71637,"_21010":120793,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71708,"_30355":71637,"_21010":120795,"_5":14420,"_27589":120594,"_2954":120786},[],{"_3471":71709,"_30355":71637,"_21010":120797,"_5":14420,"_27589":120594,"_2954":120798},[],"Región AWS donde opera el conector.",{"_3471":71710,"_30355":71637,"_21010":120800,"_5":14420,"_27589":120594,"_2954":53645},[],{"_3471":71711,"_30355":71637,"_21010":120802,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71712,"_30355":71637,"_21010":120804,"_5":14420,"_27589":120594,"_2954":120786},[],{"_3471":71713,"_30355":71637,"_21010":120806,"_5":14420,"_27589":120594,"_2954":120807},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3471":71714,"_30355":71637,"_21010":120809,"_5":14420,"_27589":120594,"_2954":53655},[],{"_3471":71715,"_30355":71637,"_21010":120811,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71716,"_30355":71637,"_21010":120813,"_5":14420,"_27589":120594,"_2954":120814},[],"Solo con `auth_method=static`",{"_3471":71717,"_30355":71637,"_21010":120816,"_5":14420,"_27589":120594,"_2954":120817},[],"Clave de acceso AWS.",{"_3471":71718,"_30355":71637,"_21010":120819,"_5":14420,"_27589":120594,"_2954":53666},[],{"_3471":71719,"_30355":71637,"_21010":120821,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71720,"_30355":71637,"_21010":120823,"_5":14420,"_27589":120594,"_2954":120814},[],{"_3471":71721,"_30355":71637,"_21010":120825,"_5":14420,"_27589":120594,"_2954":120826},[],"Clave secreta AWS.",{"_3471":71722,"_30355":71637,"_21010":120828,"_5":14420,"_27589":120594,"_2954":53676},[],{"_3471":71723,"_30355":71637,"_21010":120830,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71724,"_30355":71637,"_21010":120832,"_5":14420,"_27589":120594,"_2954":53681},[],{"_3471":71725,"_30355":71637,"_21010":120834,"_5":14420,"_27589":120594,"_2954":120835},[],"Token de sesión (con `auth_method=static`).",{"_3471":71726,"_30355":71637,"_21010":120837,"_5":14420,"_27589":120594,"_2954":53687},[],{"_3471":71727,"_30355":71637,"_21010":120839,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71728,"_30355":71637,"_21010":120841,"_5":14420,"_27589":120594,"_2954":120842},[],"Solo con `auth_method=role`",{"_3471":71729,"_30355":71637,"_21010":120844,"_5":14420,"_27589":120594,"_2954":120845},[],"ARN del rol a asumir.",{"_3471":71730,"_30355":71637,"_21010":120847,"_5":14420,"_27589":120594,"_2954":53698},[],{"_3471":71731,"_30355":71637,"_21010":120849,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71732,"_30355":71637,"_21010":120851,"_5":14420,"_27589":120594,"_2954":53681},[],{"_3471":71733,"_30355":71637,"_21010":120853,"_5":14420,"_27589":120594,"_2954":120854},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3471":71734,"_30355":71637,"_21010":120856,"_5":14420,"_27589":120594,"_2954":53708},[],{"_3471":71735,"_30355":71637,"_21010":120858,"_5":14420,"_27589":120594,"_2954":90111},[],{"_3471":71736,"_30355":71637,"_21010":120860,"_5":14420,"_27589":120594,"_2954":120786},[],{"_3471":71737,"_30355":71637,"_21010":120862,"_5":14420,"_27589":120594,"_2954":120863},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3471":71738,"_30355":71637,"_21010":120865,"_5":14420,"_27589":120594,"_2954":53718},[],{"_3471":71739,"_30355":71637,"_21010":120867,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71740,"_30355":71637,"_21010":120869,"_5":14420,"_27589":120594,"_2954":120786},[],{"_3471":71741,"_30355":71637,"_21010":120871,"_5":14420,"_27589":120594,"_2954":120872},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3471":71742,"_30355":71637,"_21010":120874,"_5":14420,"_27589":120594,"_2954":53728},[],{"_3471":71743,"_30355":71637,"_21010":120876,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71744,"_30355":71637,"_21010":120878,"_5":14420,"_27589":120594,"_2954":120786},[],{"_3471":71745,"_30355":71637,"_21010":120880,"_5":14420,"_27589":120594,"_2954":120881},[],"URL HTTP del Device Manager de Lamassu.",{"_3471":71746,"_30355":71637,"_21010":120883,"_5":14420,"_27589":120594,"_2954":53738},[],{"_3471":71747,"_30355":71637,"_21010":120885,"_5":14420,"_27589":120594,"_2954":25132},[],{"_3471":71748,"_30355":71637,"_21010":120887,"_5":14420,"_27589":120594,"_2954":120786},[],{"_3471":71749,"_30355":71637,"_21010":120889,"_5":14420,"_27589":120594,"_2954":120890},[],"URL HTTP del servicio de CA de Lamassu.",{"_3471":71750,"_30355":71637,"_21010":120892,"_5":14420,"_27589":120598,"_2954":120893},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3471":71751,"_30355":71637,"_21010":120895,"_5":14420,"_27589":120598,"_2954":120896},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3471":71752,"_30355":71637,"_21010":120898,"_5":14420,"_27589":120598,"_2954":120899},[],"Tipo de CloudEvent",{"_3471":71753,"_30355":71637,"_21010":120901,"_5":14420,"_27589":120598,"_2954":120902},[],"Recurso en Lamassu",{"_3471":71754,"_30355":71637,"_21010":120904,"_5":14420,"_27589":120598,"_2954":120905},[],"Recurso AWS",{"_3471":71755,"_30355":71637,"_21010":120907,"_5":14420,"_27589":120598,"_2954":120908},[],"Acciones IAM",{"_3471":71756,"_30355":71637,"_21010":120910,"_5":14420,"_27589":120598,"_2954":120911},[],"Llamadas AWS y efecto",{"_3471":71757,"_30355":71637,"_21010":120913,"_5":14420,"_27589":120598,"_2954":120914},[],"Dónde en esta página",{"_3471":71758,"_30355":71637,"_21010":120916,"_5":14420,"_27589":120598,"_2954":53772},[],{"_3471":71759,"_30355":71637,"_21010":120918,"_5":14420,"_27589":120598,"_2954":53775},[],{"_3471":71760,"_30355":71637,"_21010":120920,"_5":14420,"_27589":120598,"_2954":53778},[],{"_3471":71761,"_30355":71637,"_21010":120922,"_5":14420,"_27589":120598,"_2954":53781},[],{"_3471":71762,"_30355":71637,"_21010":120924,"_5":14420,"_27589":120598,"_2954":120925},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3471":71763,"_30355":71637,"_21010":120927,"_5":14420,"_27589":120598,"_2954":120611},[],{"_3471":71764,"_30355":71637,"_21010":120929,"_5":14420,"_27589":120598,"_2954":53789},[],{"_3471":71765,"_30355":71637,"_21010":120931,"_5":14420,"_27589":120598,"_2954":53792},[],{"_3471":71766,"_30355":71637,"_21010":120933,"_5":14420,"_27589":120598,"_2954":53795},[],{"_3471":71767,"_30355":71637,"_21010":120935,"_5":14420,"_27589":120598,"_2954":53798},[],{"_3471":71768,"_30355":71637,"_21010":120937,"_5":14420,"_27589":120598,"_2954":120938},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3471":71769,"_30355":71637,"_21010":120940,"_5":14420,"_27589":120598,"_2954":120637},[],{"_3471":71770,"_30355":71637,"_21010":120942,"_5":14420,"_27589":120598,"_2954":53806},[],{"_3471":71771,"_30355":71637,"_21010":120944,"_5":14420,"_27589":120598,"_2954":120945},[],"Dispositivo",{"_3471":71772,"_30355":71637,"_21010":120947,"_5":14420,"_27589":120598,"_2954":53812},[],{"_3471":71773,"_30355":71637,"_21010":120949,"_5":14420,"_27589":120598,"_2954":53815},[],{"_3471":71774,"_30355":71637,"_21010":120951,"_5":14420,"_27589":120598,"_2954":120952},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3471":71775,"_30355":71637,"_21010":120954,"_5":14420,"_27589":120598,"_2954":120645},[],{"_3471":71776,"_30355":71637,"_21010":120956,"_5":14420,"_27589":120598,"_2954":53823},[],{"_3471":71777,"_30355":71637,"_21010":120958,"_5":14420,"_27589":120598,"_2954":120959},[],"Certificado",{"_3471":71778,"_30355":71637,"_21010":120961,"_5":14420,"_27589":120598,"_2954":53829},[],{"_3471":71779,"_30355":71637,"_21010":120963,"_5":14420,"_27589":120598,"_2954":120964},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3471":71780,"_30355":71637,"_21010":120966,"_5":14420,"_27589":120598,"_2954":120967},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3471":71781,"_30355":71637,"_21010":120969,"_5":14420,"_27589":120598,"_2954":120657},[],{"_3471":71782,"_30355":71637,"_21010":120971,"_5":14420,"_27589":120598,"_2954":53840},[],{"_3471":71783,"_30355":71637,"_21010":120973,"_5":14420,"_27589":120598,"_2954":120974},[],"Certificado / Dispositivo",{"_3471":71784,"_30355":71637,"_21010":120976,"_5":14420,"_27589":120598,"_2954":53846},[],{"_3471":71785,"_30355":71637,"_21010":120978,"_5":14420,"_27589":120598,"_2954":49849},[],{"_3471":71786,"_30355":71637,"_21010":120980,"_5":14420,"_27589":120598,"_2954":120981},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3471":71787,"_30355":71637,"_21010":120983,"_5":14420,"_27589":120598,"_2954":120665},[],{"_3471":71788,"_30355":71637,"_21010":120985,"_5":14420,"_27589":120602,"_2954":120986},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3471":71789,"_30355":71637,"_21010":120988,"_5":14420,"_27589":120606,"_2954":120989},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3471":71790,"_30355":71637,"_21010":120991,"_5":14420,"_27589":120606,"_2954":120992},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3471":71791,"_30355":71637,"_21010":120994,"_5":14420,"_27589":120610,"_2954":120995},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3471":71792,"_30355":71637,"_21010":120997,"_5":14420,"_27589":120610,"_2954":120998},[],"Transición",{"_3471":71793,"_30355":71637,"_21010":121000,"_5":14420,"_27589":120610,"_2954":121001},[],"Llamadas AWS",{"_3471":71794,"_30355":71637,"_21010":121003,"_5":14420,"_27589":120610,"_2954":121004},[],"`NoRegistrada` → `Solicitada`",{"_3471":71795,"_30355":71637,"_21010":121006,"_5":14420,"_27589":120610,"_2954":121007},[],"ninguna (solo escritura de metadatos)",{"_3471":71796,"_30355":71637,"_21010":121009,"_5":14420,"_27589":120610,"_2954":121010},[],"`Solicitada` → `Registrando`",{"_3471":71797,"_30355":71637,"_21010":121012,"_5":14420,"_27589":120610,"_2954":121013},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3471":71798,"_30355":71637,"_21010":121015,"_5":14420,"_27589":120610,"_2954":121016},[],"`Registrando` → `Completada`",{"_3471":71799,"_30355":71637,"_21010":121018,"_5":14420,"_27589":120610,"_2954":121019},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3471":71800,"_30355":71637,"_21010":121021,"_5":14420,"_27589":120610,"_2954":121022},[],"`Registrando` → `Fallida`",{"_3471":71801,"_30355":71637,"_21010":121024,"_5":14420,"_27589":120610,"_2954":121025},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3471":71802,"_30355":71637,"_21010":121027,"_5":14420,"_27589":120610,"_2954":121028},[],"`Fallida` / `Completada` → `Solicitada`",{"_3471":71803,"_30355":71637,"_21010":121030,"_5":14420,"_27589":120610,"_2954":121031},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3471":71804,"_30355":71637,"_21010":121033,"_5":14420,"_27589":120614,"_2954":121034},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3471":71805,"_30355":71637,"_21010":121036,"_5":14420,"_27589":120614,"_2954":121037},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3471":71806,"_30355":71637,"_21010":121039,"_5":14420,"_27589":120614,"_2954":121040},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3471":71807,"_30355":71637,"_21010":121042,"_5":14420,"_27589":120614,"_2954":121043},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3471":71808,"_30355":71637,"_21010":121045,"_5":14420,"_27589":120614,"_2954":121046},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3471":71809,"_30355":71637,"_21010":121048,"_5":14420,"_27589":120614,"_2954":121049},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3471":71810,"_30355":71637,"_21010":121051,"_5":14420,"_27589":120617,"_2954":121052},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3471":71811,"_30355":71637,"_21010":121054,"_5":14420,"_27589":120620,"_2954":121055},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3471":71812,"_30355":71637,"_21010":121057,"_5":14420,"_27589":120620,"_2954":121058},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3471":71813,"_30355":71637,"_21010":121060,"_5":14420,"_27589":120624,"_2954":121061},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3471":71814,"_30355":71637,"_21010":121063,"_5":14420,"_27589":120628,"_2954":121064},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3471":71815,"_30355":71637,"_21010":121066,"_5":14420,"_27589":120628,"_2954":121067},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3471":71816,"_30355":71637,"_21010":121069,"_5":14420,"_27589":120628,"_2954":121070},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3471":71817,"_30355":71637,"_21010":121072,"_5":14420,"_27589":120628,"_2954":121073},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3471":71818,"_30355":71637,"_21010":121075,"_5":14420,"_27589":120628,"_2954":121076},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3471":71819,"_30355":71637,"_21010":121078,"_5":14420,"_27589":120628,"_2954":121079},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3471":71820,"_30355":71637,"_21010":121081,"_5":14420,"_27589":120632,"_2954":121082},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3471":71821,"_30355":71637,"_21010":121084,"_5":14420,"_27589":120632,"_2954":121085},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3471":71822,"_30355":71637,"_21010":121087,"_5":14420,"_27589":120632,"_2954":121088},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3471":71823,"_30355":71637,"_21010":121090,"_5":14420,"_27589":120632,"_2954":121091},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3471":71824,"_30355":71637,"_21010":121093,"_5":14420,"_27589":120632,"_2954":121094},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3471":71825,"_30355":71637,"_21010":121096,"_5":14420,"_27589":120636,"_2954":121097},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3471":71826,"_30355":71637,"_21010":121099,"_5":14420,"_27589":120636,"_2954":120998},[],{"_3471":71827,"_30355":71637,"_21010":121101,"_5":14420,"_27589":120636,"_2954":121001},[],{"_3471":71828,"_30355":71637,"_21010":121103,"_5":14420,"_27589":120636,"_2954":121104},[],"`SinConfigurar` → `None` / `Auto`",{"_3471":71829,"_30355":71637,"_21010":121106,"_5":14420,"_27589":120636,"_2954":121107},[],"ninguna (solo configuración)",{"_3471":71830,"_30355":71637,"_21010":121109,"_5":14420,"_27589":120636,"_2954":53983},[],{"_3471":71831,"_30355":71637,"_21010":121111,"_5":14420,"_27589":120636,"_2954":121107},[],{"_3471":71832,"_30355":71637,"_21010":121113,"_5":14420,"_27589":120636,"_2954":121114},[],"Cualquiera → `Jitp`",{"_3471":71833,"_30355":71637,"_21010":121116,"_5":14420,"_27589":120636,"_2954":121117},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3471":71834,"_30355":71637,"_21010":121119,"_5":14420,"_27589":120636,"_2954":53994},[],{"_3471":71835,"_30355":71637,"_21010":121121,"_5":14420,"_27589":120636,"_2954":121122},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3471":71836,"_30355":71637,"_21010":121124,"_5":14420,"_27589":120640,"_2954":121125},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3471":71837,"_30355":71637,"_21010":121127,"_5":14420,"_27589":120640,"_2954":121128},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3471":71838,"_30355":71637,"_21010":121130,"_5":14420,"_27589":120640,"_2954":121131},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3471":71839,"_30355":71637,"_21010":121133,"_5":14420,"_27589":120644,"_2954":121134},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3471":71840,"_30355":71637,"_21010":121136,"_5":14420,"_27589":120644,"_2954":120998},[],{"_3471":71841,"_30355":71637,"_21010":121138,"_5":14420,"_27589":120644,"_2954":121001},[],{"_3471":71842,"_30355":71637,"_21010":121140,"_5":14420,"_27589":120644,"_2954":121141},[],"`Ausente` → `Aprovisionado`",{"_3471":71843,"_30355":71637,"_21010":121143,"_5":14420,"_27589":120644,"_2954":121144},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3471":71844,"_30355":71637,"_21010":121146,"_5":14420,"_27589":120644,"_2954":121147},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3471":71845,"_30355":71637,"_21010":121149,"_5":14420,"_27589":120644,"_2954":121150},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3471":71846,"_30355":71637,"_21010":121152,"_5":14420,"_27589":120644,"_2954":121153},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3471":71847,"_30355":71637,"_21010":121155,"_5":14420,"_27589":120648,"_2954":121156},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3471":71848,"_30355":71637,"_21010":121158,"_5":14420,"_27589":120648,"_2954":121159},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3471":71849,"_30355":71637,"_21010":121161,"_5":14420,"_27589":120648,"_2954":121162},[],"Para que el flujo JITP funcione correctamente:",{"_3471":71850,"_30355":71637,"_21010":121164,"_5":14420,"_27589":120648,"_2954":121165},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3471":71851,"_30355":71637,"_21010":121167,"_5":14420,"_27589":120648,"_2954":121168},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3471":71852,"_30355":71637,"_21010":121170,"_5":14420,"_27589":120648,"_2954":121171},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3471":71853,"_30355":71637,"_21010":121173,"_5":14420,"_27589":120648,"_2954":121174},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3471":71854,"_30355":71637,"_21010":121176,"_5":14420,"_27589":120652,"_2954":121177},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3471":71855,"_30355":71637,"_21010":121179,"_5":14420,"_27589":120652,"_2954":121180},[],"Estado en Lamassu",{"_3471":71856,"_30355":71637,"_21010":121182,"_5":14420,"_27589":120652,"_2954":121183},[],"Razón de revocación",{"_3471":71857,"_30355":71637,"_21010":121185,"_5":14420,"_27589":120652,"_2954":121186},[],"Estado en AWS IoT Core",{"_3471":71858,"_30355":71637,"_21010":121188,"_5":14420,"_27589":120652,"_2954":54064},[],{"_3471":71859,"_30355":71637,"_21010":121190,"_5":14420,"_27589":120652,"_2954":121191},[],"Ninguna",{"_3471":71860,"_30355":71637,"_21010":121193,"_5":14420,"_27589":120652,"_2954":54070},[],{"_3471":71861,"_30355":71637,"_21010":121195,"_5":14420,"_27589":120652,"_2954":54073},[],{"_3471":71862,"_30355":71637,"_21010":121197,"_5":14420,"_27589":120652,"_2954":54076},[],{"_3471":71863,"_30355":71637,"_21010":121199,"_5":14420,"_27589":120652,"_2954":54079},[],{"_3471":71864,"_30355":71637,"_21010":121201,"_5":14420,"_27589":120652,"_2954":54073},[],{"_3471":71865,"_30355":71637,"_21010":121203,"_5":14420,"_27589":120652,"_2954":121204},[],"Cualquier otra razón",{"_3471":71866,"_30355":71637,"_21010":121206,"_5":14420,"_27589":120652,"_2954":54087},[],{"_3471":71867,"_30355":71637,"_21010":121208,"_5":14420,"_27589":120652,"_2954":121209},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3471":71868,"_30355":71637,"_21010":121211,"_5":14420,"_27589":120656,"_2954":121212},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3471":71869,"_30355":71637,"_21010":121214,"_5":14420,"_27589":120656,"_2954":120998},[],{"_3471":71870,"_30355":71637,"_21010":121216,"_5":14420,"_27589":120656,"_2954":121001},[],{"_3471":71871,"_30355":71637,"_21010":121218,"_5":14420,"_27589":120656,"_2954":121219},[],"`NoSincronizado` → `Active`",{"_3471":71872,"_30355":71637,"_21010":121221,"_5":14420,"_27589":120656,"_2954":53579},[],{"_3471":71873,"_30355":71637,"_21010":121223,"_5":14420,"_27589":120656,"_2954":54105},[],{"_3471":71874,"_30355":71637,"_21010":121225,"_5":14420,"_27589":120656,"_2954":121226},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3471":71875,"_30355":71637,"_21010":121228,"_5":14420,"_27589":120656,"_2954":54111},[],{"_3471":71876,"_30355":71637,"_21010":121230,"_5":14420,"_27589":120656,"_2954":121226},[],{"_3471":71877,"_30355":71637,"_21010":121232,"_5":14420,"_27589":120656,"_2954":54116},[],{"_3471":71878,"_30355":71637,"_21010":121234,"_5":14420,"_27589":120656,"_2954":53579},[],{"_3471":71879,"_30355":71637,"_21010":121236,"_5":14420,"_27589":120656,"_2954":54121},[],{"_3471":71880,"_30355":71637,"_21010":121238,"_5":14420,"_27589":120656,"_2954":121239},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3471":71881,"_30355":71637,"_21010":121241,"_5":14420,"_27589":120660,"_2954":121242},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3471":71882,"_30355":71637,"_21010":121244,"_5":14420,"_27589":120660,"_2954":121245},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3471":71883,"_30355":71637,"_21010":121247,"_5":14420,"_27589":120660,"_2954":121248},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3471":71884,"_30355":71637,"_21010":121250,"_5":14420,"_27589":120664,"_2954":121251},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3471":71885,"_30355":71637,"_21010":121253,"_5":14420,"_27589":120664,"_2954":121254},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3471":71886,"_30355":71637,"_21010":121256,"_5":14420,"_27589":120668,"_2954":121257},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3471":71887,"_30355":71637,"_21010":121259,"_5":14420,"_27589":120668,"_2954":121260},[],"Existen dos tipos de acciones:",{"_3471":71888,"_30355":71637,"_21010":121262,"_5":14420,"_27589":120668,"_2954":121263},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3471":71889,"_30355":71637,"_21010":121265,"_5":14420,"_27589":120668,"_2954":121266},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3471":71890,"_30355":71637,"_21010":121268,"_5":14420,"_27589":120668,"_2954":121269},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3471":71891,"_30355":71637,"_21010":121271,"_5":14420,"_27589":120672,"_2954":121272},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3471":71892,"_30355":71637,"_21010":121274,"_5":14420,"_27589":120672,"_2954":121275},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3471":71893,"_30355":71637,"_21010":121277,"_5":14420,"_27589":120672,"_2954":121278},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3471":71894,"_30355":71637,"_21010":121280,"_5":14420,"_27589":120676,"_2954":121281},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3471":71895,"_30355":71637,"_21010":121283,"_5":14420,"_27589":120676,"_2954":121284},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3471":71896,"_30355":71637,"_21010":121286,"_5":14420,"_27589":120676,"_2954":121287},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3471":71897,"_30355":71637,"_21010":121289,"_5":14420,"_27589":120676,"_2954":121290},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3471":71898,"_30355":71637,"_21010":121292,"_5":14420,"_27589":120676,"_2954":121293},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3471":71899,"_30355":71637,"_21010":121295,"_5":14420,"_27589":120676,"_2954":121296},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3471":71900,"_30355":71637,"_21010":121298,"_5":14420,"_27589":120676,"_2954":121299},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3471":71901,"_30355":71637,"_21010":121301,"_5":14420,"_27589":120676,"_2954":121302},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3471":71902,"_30355":71637,"_21010":121304,"_5":14420,"_27589":120676,"_2954":121305},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3471":71903,"_30355":71637,"_21010":121307,"_5":14420,"_27589":120676,"_2954":121308},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3471":71904,"_30355":71637,"_21010":121310,"_5":14420,"_27589":120676,"_2954":121311},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3471":71905,"_30355":71637,"_21010":121313,"_5":14420,"_27589":120676,"_2954":121314},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3471":71906,"_30355":71637,"_21010":121316,"_5":14420,"_27589":120676,"_2954":121317},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3471":71907,"_30355":71637,"_21010":121319,"_5":14420,"_27589":120676,"_2954":121320},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3471":71908,"_30355":71637,"_21010":121322,"_5":14420,"_27589":120676,"_2954":121323},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3471":71909,"_30355":71637,"_21010":121325,"_5":14420,"_27589":120676,"_2954":121326},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3471":71910,"_30355":71637,"_21010":121328,"_5":14420,"_27589":120676,"_2954":121329},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3471":71911,"_30355":71637,"_21010":121331,"_5":14420,"_27589":120676,"_2954":121332},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3471":71912,"_30355":71637,"_21010":121334,"_5":14420,"_27589":120676,"_2954":121335},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3471":71913,"_30355":71637,"_21010":121337,"_5":14420,"_27589":120676,"_2954":121338},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3471":71914,"_30355":71637,"_21010":121340,"_5":14420,"_27589":120676,"_2954":121341},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3471":71915,"_30355":71637,"_21010":121343,"_5":14420,"_27589":120676,"_2954":121344},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3471":71916,"_30355":71637,"_21010":121346,"_5":14420,"_27589":120676,"_2954":121347},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3471":71917,"_30355":71637,"_21010":121349,"_5":14420,"_27589":120676,"_2954":121350},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3471":71918,"_30355":71918,"_5":14772,"_2954":51942,"_30708":121352,"_21010":121353,"_27589":71918},[49453,118156,51942],[],{"_3471":71919,"_30355":71918,"_21010":121355,"_5":14420,"_27589":71918,"_2954":121356},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3471":71920,"_30355":71918,"_5":30705,"_21010":121358,"_27589":121359,"_2954":121360},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3471":71921,"_30355":71918,"_5":30705,"_21010":121362,"_27589":121363,"_2954":119168},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3471":71922,"_30355":71918,"_5":30705,"_21010":121365,"_27589":121366,"_2954":119343},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3471":71923,"_30355":71918,"_5":30705,"_21010":121368,"_27589":121369,"_2954":120575},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/overview#integraciones",{"_3471":71924,"_30355":71918,"_5":30705,"_21010":121371,"_27589":121372,"_2954":121373},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3471":71925,"_30355":71918,"_21010":121375,"_5":14420,"_27589":71918,"_2954":121376},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3471":71926,"_30355":71918,"_21010":121378,"_5":14420,"_27589":121359,"_2954":121379},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3471":71927,"_30355":71918,"_21010":121381,"_5":14420,"_27589":121359,"_2954":121382},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3471":71928,"_30355":71918,"_21010":121384,"_5":14420,"_27589":121363,"_2954":121385},[],"Recurso",{"_3471":71929,"_30355":71918,"_21010":121387,"_5":14420,"_27589":121363,"_2954":121388},[],"Qué representa",{"_3471":71930,"_30355":71918,"_21010":121390,"_5":14420,"_27589":121363,"_2954":121391},[],"**Dispositivo**",{"_3471":71931,"_30355":71918,"_21010":121393,"_5":14420,"_27589":121363,"_2954":121394},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3471":71932,"_30355":71918,"_21010":121396,"_5":14420,"_27589":121363,"_2954":121397},[],"**Identidad**",{"_3471":71933,"_30355":71918,"_21010":121399,"_5":14420,"_27589":121363,"_2954":121400},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3471":71934,"_30355":71918,"_21010":121402,"_5":14420,"_27589":121363,"_2954":54288},[],{"_3471":71935,"_30355":71918,"_21010":121404,"_5":14420,"_27589":121363,"_2954":121405},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3471":71936,"_30355":71918,"_21010":121407,"_5":14420,"_27589":121363,"_2954":121408},[],"**Flota**",{"_3471":71937,"_30355":71918,"_21010":121410,"_5":14420,"_27589":121363,"_2954":121411},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3471":71938,"_30355":71918,"_21010":121413,"_5":14420,"_27589":121363,"_2954":121414},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3471":71939,"_30355":71918,"_21010":121416,"_5":14420,"_27589":121363,"_2954":121417},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3471":71940,"_30355":71918,"_21010":121419,"_5":14420,"_27589":121366,"_2954":121420},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3471":71941,"_30355":71918,"_21010":121422,"_5":14420,"_27589":121366,"_2954":121423},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3471":71942,"_30355":71918,"_21010":121425,"_5":14420,"_27589":121366,"_2954":121426},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3471":71943,"_30355":71918,"_21010":121428,"_5":14420,"_27589":121366,"_2954":121429},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3471":71944,"_30355":71918,"_21010":121431,"_5":14420,"_27589":121366,"_2954":121432},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3471":71945,"_30355":71918,"_21010":121434,"_5":14420,"_27589":121366,"_2954":121435},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3471":71946,"_30355":71918,"_21010":121437,"_5":14420,"_27589":121366,"_2954":121438},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3471":71947,"_30355":71918,"_21010":121440,"_5":14420,"_27589":121366,"_2954":121441},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3471":71948,"_30355":71918,"_21010":121443,"_5":14420,"_27589":121369,"_2954":121444},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3471":71949,"_30355":71918,"_21010":121446,"_5":14420,"_27589":121369,"_2954":121447},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3471":71950,"_30355":71918,"_21010":121449,"_5":14420,"_27589":121372,"_2954":121450},[],"Participante",{"_3471":71951,"_30355":71918,"_21010":121452,"_5":14420,"_27589":121372,"_2954":121453},[],"Responsabilidad",{"_3471":71952,"_30355":71918,"_21010":121455,"_5":14420,"_27589":121372,"_2954":121456},[],"Administrador PKI",{"_3471":71953,"_30355":71918,"_21010":121458,"_5":14420,"_27589":121372,"_2954":121459},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3471":71954,"_30355":71918,"_21010":121461,"_5":14420,"_27589":121372,"_2954":121462},[],"Administrador del aprovisionamiento",{"_3471":71955,"_30355":71918,"_21010":121464,"_5":14420,"_27589":121372,"_2954":121465},[],"DMS, admisión, autenticación por operación e inventario.",{"_3471":71956,"_30355":71918,"_21010":121467,"_5":14420,"_27589":121372,"_2954":121468},[],"Integrador del dispositivo",{"_3471":71957,"_30355":71918,"_21010":121470,"_5":14420,"_27589":121372,"_2954":121471},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3471":71958,"_30355":71918,"_21010":121473,"_5":14420,"_27589":121372,"_2954":121474},[],"Integrador del consumidor",{"_3471":71959,"_30355":71918,"_21010":121476,"_5":14420,"_27589":121372,"_2954":121477},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3471":71960,"_30355":71918,"_21010":121479,"_5":14420,"_27589":121372,"_2954":121480},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3471":71961,"_30355":71961,"_5":14772,"_2954":121482,"_30708":121483,"_21010":121485,"_27589":71961},"Enrola y conecta tu primer dispositivo",[49453,118156,51942,121484],"Primeros pasos",[],{"_3471":71962,"_30355":71961,"_21010":121487,"_5":14420,"_27589":71961,"_2954":121488},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3471":71963,"_30355":71961,"_5":30705,"_21010":121490,"_27589":121491,"_2954":116727},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3471":71964,"_30355":71961,"_5":30705,"_21010":121493,"_27589":121494,"_2954":121495},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3471":71965,"_30355":71961,"_5":30705,"_21010":121497,"_27589":121498,"_2954":121499},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3471":71966,"_30355":71961,"_5":30705,"_21010":121501,"_27589":121502,"_2954":121503},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3471":71967,"_30355":71961,"_5":30705,"_21010":121505,"_27589":121506,"_2954":121507},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3471":71968,"_30355":71961,"_5":30705,"_21010":121509,"_27589":121510,"_2954":121511},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3471":71969,"_30355":71961,"_5":30705,"_21010":121513,"_27589":121514,"_2954":121515},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3471":71970,"_30355":71961,"_5":30705,"_21010":121517,"_27589":121518,"_2954":121519},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3471":71971,"_30355":71961,"_21010":121521,"_5":14420,"_27589":71961,"_2954":121522},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3471":71972,"_30355":71961,"_21010":121524,"_5":14420,"_27589":121491,"_2954":121525},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3471":71973,"_30355":71961,"_21010":121527,"_5":14420,"_27589":121491,"_2954":121528},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3471":71974,"_30355":71961,"_21010":121530,"_5":14420,"_27589":121491,"_2954":121531},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3471":71975,"_30355":71961,"_21010":121533,"_5":14420,"_27589":121491,"_2954":121534},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3471":71976,"_30355":71961,"_21010":121536,"_5":14420,"_27589":121491,"_2954":121537},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3471":71977,"_30355":71961,"_21010":121539,"_5":14420,"_27589":121494,"_2954":121540},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3471":71978,"_30355":71961,"_21010":121542,"_5":14420,"_27589":121494,"_2954":121543},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3471":71979,"_30355":71961,"_21010":121545,"_5":14420,"_27589":121498,"_2954":121546},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3471":71980,"_30355":71961,"_21010":121548,"_5":14420,"_27589":121498,"_2954":121549},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3471":71981,"_30355":71961,"_21010":121551,"_5":14420,"_27589":121498,"_2954":121552},[],"Ajuste",{"_3471":71982,"_30355":71961,"_21010":121554,"_5":14420,"_27589":121498,"_2954":121555},[],"Valor de evaluación",{"_3471":71983,"_30355":71961,"_21010":121557,"_5":14420,"_27589":121498,"_2954":54444},[],{"_3471":71984,"_30355":71961,"_21010":121559,"_5":14420,"_27589":121498,"_2954":121560},[],"Raíz emisora de `device-root.pem`.",{"_3471":71985,"_30355":71961,"_21010":121562,"_5":14420,"_27589":121498,"_2954":119471},[],{"_3471":71986,"_30355":71961,"_21010":121564,"_5":14420,"_27589":121498,"_2954":121565},[],"Perfil final de 1 hora que acabas de preparar.",{"_3471":71987,"_30355":71961,"_21010":121567,"_5":14420,"_27589":121498,"_2954":54455},[],{"_3471":71988,"_30355":71961,"_21010":121569,"_5":14420,"_27589":121498,"_2954":54458},[],{"_3471":71989,"_30355":71961,"_21010":121571,"_5":14420,"_27589":121498,"_2954":54461},[],{"_3471":71990,"_30355":71961,"_21010":121573,"_5":14420,"_27589":121498,"_2954":121574},[],"Habilitado.",{"_3471":71991,"_30355":71961,"_21010":121576,"_5":14420,"_27589":121498,"_2954":54467},[],{"_3471":71992,"_30355":71961,"_21010":121578,"_5":14420,"_27589":121498,"_2954":121579},[],"Deshabilitado; el ID debe ser nuevo.",{"_3471":71993,"_30355":71961,"_21010":121581,"_5":14420,"_27589":121498,"_2954":121582},[],"Autenticación inicial",{"_3471":71994,"_30355":71961,"_21010":121584,"_5":14420,"_27589":121498,"_2954":121585},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3471":71995,"_30355":71961,"_21010":121587,"_5":14420,"_27589":121498,"_2954":121588},[],"Autenticación de renovación",{"_3471":71996,"_30355":71961,"_21010":121590,"_5":14420,"_27589":121498,"_2954":121591},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3471":71997,"_30355":71961,"_21010":121593,"_5":14420,"_27589":121498,"_2954":54485},[],{"_3471":71998,"_30355":71961,"_21010":121595,"_5":14420,"_27589":121498,"_2954":121596},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3471":71999,"_30355":71961,"_21010":121598,"_5":14420,"_27589":121498,"_2954":54491},[],{"_3471":72000,"_30355":71961,"_21010":121600,"_5":14420,"_27589":121498,"_2954":121601},[],"1 hora.",{"_3471":72001,"_30355":71961,"_21010":121603,"_5":14420,"_27589":121498,"_2954":54497},[],{"_3471":72002,"_30355":71961,"_21010":121605,"_5":14420,"_27589":121498,"_2954":121606},[],"30 minutos / 10 minutos.",{"_3471":72003,"_30355":71961,"_21010":121608,"_5":14420,"_27589":121498,"_2954":54503},[],{"_3471":72004,"_30355":71961,"_21010":121610,"_5":14420,"_27589":121498,"_2954":121611},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3471":72005,"_30355":71961,"_21010":121613,"_5":14420,"_27589":121498,"_2954":52261},[],{"_3471":72006,"_30355":71961,"_21010":121615,"_5":14420,"_27589":121498,"_2954":121616},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3471":72007,"_30355":71961,"_21010":121618,"_5":14420,"_27589":121498,"_2954":54514},[],{"_3471":72008,"_30355":71961,"_21010":121620,"_5":14420,"_27589":121498,"_2954":121621},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3471":72009,"_30355":71961,"_21010":121623,"_5":14420,"_27589":121498,"_2954":121624},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3471":72010,"_30355":71961,"_21010":121626,"_5":14420,"_27589":121502,"_2954":121627},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3471":72011,"_30355":71961,"_21010":121629,"_5":14420,"_27589":121502,"_2954":121630},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3471":72012,"_30355":71961,"_21010":121632,"_5":14420,"_27589":121506,"_2954":121633},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3471":72013,"_30355":71961,"_21010":121635,"_5":14420,"_27589":121506,"_2954":121636},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3471":72014,"_30355":71961,"_21010":121638,"_5":14420,"_27589":121506,"_2954":121639},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3471":72015,"_30355":71961,"_21010":121641,"_5":14420,"_27589":121510,"_2954":121642},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3471":72016,"_30355":71961,"_21010":121644,"_5":14420,"_27589":121510,"_2954":121645},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3471":72017,"_30355":71961,"_21010":121647,"_5":14420,"_27589":121514,"_2954":121648},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3471":72018,"_30355":71961,"_21010":121650,"_5":14420,"_27589":121514,"_2954":121651},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3471":72019,"_30355":71961,"_21010":121653,"_5":14420,"_27589":121514,"_2954":121654},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3471":72020,"_30355":71961,"_21010":121656,"_5":14420,"_27589":121514,"_2954":121657},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3471":72021,"_30355":71961,"_21010":121659,"_5":14420,"_27589":121514,"_2954":121660},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3471":72022,"_30355":71961,"_21010":121662,"_5":14420,"_27589":121518,"_2954":121663},[],"Comprobación",{"_3471":72023,"_30355":71961,"_21010":121665,"_5":14420,"_27589":121518,"_2954":121666},[],"Resultado esperado",{"_3471":72024,"_30355":71961,"_21010":121668,"_5":14420,"_27589":121518,"_2954":121669},[],"Registro",{"_3471":72025,"_30355":71961,"_21010":121671,"_5":14420,"_27589":121518,"_2954":121672},[],"ID creado automáticamente y DMS correcto.",{"_3471":72026,"_30355":71961,"_21010":121674,"_5":14420,"_27589":121518,"_2954":120959},[],{"_3471":72027,"_30355":71961,"_21010":121676,"_5":14420,"_27589":121518,"_2954":121677},[],"CN, perfil, serie y clave verificados.",{"_3471":72028,"_30355":71961,"_21010":121679,"_5":14420,"_27589":121518,"_2954":121680},[],"Inventario",{"_3471":72029,"_30355":71961,"_21010":121682,"_5":14420,"_27589":121518,"_2954":121683},[],"Serie recibida visible como identidad actual y en el historial.",{"_3471":72030,"_30355":71961,"_21010":121685,"_5":14420,"_27589":121518,"_2954":121686},[],"Consumidor",{"_3471":72031,"_30355":71961,"_21010":121688,"_5":14420,"_27589":121518,"_2954":121689},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3471":72032,"_30355":71961,"_21010":121691,"_5":14420,"_27589":121518,"_2954":121692},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3471":72033,"_30355":71961,"_21010":121694,"_5":14420,"_27589":121518,"_2954":121695},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3471":72034,"_30355":72034,"_5":14772,"_2954":119185,"_30708":121697,"_21010":121698,"_27589":72034},[49453,118156,51942,121484],[],{"_3471":72035,"_30355":72034,"_21010":121700,"_5":14420,"_27589":72034,"_2954":121701},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3471":72036,"_30355":72034,"_5":30705,"_21010":121703,"_27589":121704,"_2954":116727},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3471":72037,"_30355":72034,"_5":30705,"_21010":121706,"_27589":121707,"_2954":121708},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3471":72038,"_30355":72034,"_5":30705,"_21010":121710,"_27589":121711,"_2954":121712},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3471":72039,"_30355":72034,"_5":30705,"_21010":121714,"_27589":121715,"_2954":121716},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3471":72040,"_30355":72034,"_5":30705,"_21010":121718,"_27589":121719,"_2954":121720},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3471":72041,"_30355":72034,"_5":30705,"_21010":121722,"_27589":121723,"_2954":121724},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3471":72042,"_30355":72034,"_5":30705,"_21010":121726,"_27589":121727,"_2954":121666},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3471":72043,"_30355":72034,"_5":30705,"_21010":121729,"_27589":121730,"_2954":121731},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3471":72044,"_30355":72034,"_5":30705,"_21010":121733,"_27589":121734,"_2954":121735},[],"/docs/pr-preview/pr-62/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3471":72045,"_30355":72034,"_21010":121737,"_5":14420,"_27589":72034,"_2954":121738},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3471":72046,"_30355":72034,"_21010":121740,"_5":14420,"_27589":72034,"_2954":121741},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3471":72047,"_30355":72034,"_21010":121743,"_5":14420,"_27589":121704,"_2954":121744},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3471":72048,"_30355":72034,"_21010":121746,"_5":14420,"_27589":121704,"_2954":121747},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3471":72049,"_30355":72034,"_21010":121749,"_5":14420,"_27589":121704,"_2954":121750},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3471":72050,"_30355":72034,"_21010":121752,"_5":14420,"_27589":121704,"_2954":121753},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3471":72051,"_30355":72034,"_21010":121755,"_5":14420,"_27589":121707,"_2954":121756},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3471":72052,"_30355":72034,"_21010":121758,"_5":14420,"_27589":121707,"_2954":121759},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3471":72053,"_30355":72034,"_21010":121761,"_5":14420,"_27589":121707,"_2954":121762},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3471":72054,"_30355":72034,"_21010":121764,"_5":14420,"_27589":121707,"_2954":121765},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3471":72055,"_30355":72034,"_21010":121767,"_5":14420,"_27589":121707,"_2954":121768},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3471":72056,"_30355":72034,"_21010":121770,"_5":14420,"_27589":121707,"_2954":121771},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3471":72057,"_30355":72034,"_21010":121773,"_5":14420,"_27589":121707,"_2954":121774},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3471":72058,"_30355":72034,"_21010":121776,"_5":14420,"_27589":121707,"_2954":121777},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3471":72059,"_30355":72034,"_21010":121779,"_5":14420,"_27589":121711,"_2954":121780},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3471":72060,"_30355":72034,"_21010":121782,"_5":14420,"_27589":121711,"_2954":54679},[],{"_3471":72061,"_30355":72034,"_21010":121784,"_5":14420,"_27589":121711,"_2954":121785},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3471":72062,"_30355":72034,"_21010":121787,"_5":14420,"_27589":121711,"_2954":121788},[],"**Icon** y **Tags**: clasificación opcional.",{"_3471":72063,"_30355":72034,"_21010":121790,"_5":14420,"_27589":121711,"_2954":121791},[],"Confirma el registro.",{"_3471":72064,"_30355":72034,"_21010":121793,"_5":14420,"_27589":121715,"_2954":121794},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3471":72065,"_30355":72034,"_21010":121796,"_5":14420,"_27589":121715,"_2954":121797},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3471":72066,"_30355":72034,"_21010":121799,"_5":14420,"_27589":121719,"_2954":121800},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3471":72067,"_30355":72034,"_21010":121802,"_5":14420,"_27589":121719,"_2954":121803},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3471":72068,"_30355":72034,"_21010":121805,"_5":14420,"_27589":121723,"_2954":121806},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3471":72069,"_30355":72034,"_21010":121808,"_5":14420,"_27589":121723,"_2954":121809},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3471":72070,"_30355":72034,"_21010":121811,"_5":14420,"_27589":121727,"_2954":121663},[],{"_3471":72071,"_30355":72034,"_21010":121813,"_5":14420,"_27589":121727,"_2954":121814},[],"Resultado",{"_3471":72072,"_30355":72034,"_21010":121816,"_5":14420,"_27589":121727,"_2954":120945},[],{"_3471":72073,"_30355":72034,"_21010":121818,"_5":14420,"_27589":121727,"_2954":121819},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3471":72074,"_30355":72034,"_21010":121821,"_5":14420,"_27589":121727,"_2954":121822},[],"Identidad actual",{"_3471":72075,"_30355":72034,"_21010":121824,"_5":14420,"_27589":121727,"_2954":121825},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3471":72076,"_30355":72034,"_21010":121827,"_5":14420,"_27589":121727,"_2954":121828},[],"Historial",{"_3471":72077,"_30355":72034,"_21010":121830,"_5":14420,"_27589":121727,"_2954":121831},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3471":72078,"_30355":72034,"_21010":121833,"_5":14420,"_27589":121727,"_2954":121834},[],"Clave y certificado",{"_3471":72079,"_30355":72034,"_21010":121836,"_5":14420,"_27589":121727,"_2954":121837},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3471":72080,"_30355":72034,"_21010":121839,"_5":14420,"_27589":121730,"_2954":121840},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3471":72081,"_30355":72034,"_21010":121842,"_5":14420,"_27589":121730,"_2954":121843},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3471":72082,"_30355":72034,"_21010":121845,"_5":14420,"_27589":121730,"_2954":121846},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3471":72083,"_30355":72034,"_21010":121848,"_5":14420,"_27589":121730,"_2954":121849},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3471":72084,"_30355":72034,"_21010":121851,"_5":14420,"_27589":121734,"_2954":121852},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3471":72085,"_30355":72034,"_21010":121854,"_5":14420,"_27589":121734,"_2954":121855},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3471":72086,"_30355":72034,"_21010":121857,"_5":14420,"_27589":121734,"_2954":121858},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3471":72087,"_30355":72087,"_5":14772,"_2954":121860,"_30708":121861,"_21010":121862,"_27589":72087},"Plataforma Lamassu IoT",[49453,118156],[],{"_3471":72088,"_30355":72087,"_21010":121864,"_5":14420,"_27589":72087,"_2954":121865},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3471":72089,"_30355":72087,"_5":30705,"_21010":121867,"_27589":121868,"_2954":121360},[],"/docs/pr-preview/pr-62/es/platform/overview#empieza-aquí",{"_3471":72090,"_30355":72087,"_5":30705,"_21010":121870,"_27589":121871,"_2954":121872},[],"/docs/pr-preview/pr-62/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3471":72091,"_30355":72087,"_5":30705,"_21010":121874,"_27589":121875,"_2954":121876},[],"/docs/pr-preview/pr-62/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3471":72092,"_30355":72087,"_5":30705,"_21010":121878,"_27589":121879,"_2954":121880},[],"/docs/pr-preview/pr-62/es/platform/overview#capacidades-principales","Capacidades principales",{"_3471":72093,"_30355":72087,"_5":30705,"_21010":121882,"_27589":121883,"_2954":121884},[],"/docs/pr-preview/pr-62/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3471":72094,"_30355":72087,"_5":30705,"_21010":121886,"_27589":121887,"_2954":121888},[],"/docs/pr-preview/pr-62/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3471":72095,"_30355":72087,"_5":30705,"_21010":121890,"_27589":121891,"_2954":121892},[],"/docs/pr-preview/pr-62/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3471":72096,"_30355":72087,"_5":30705,"_21010":121894,"_27589":121895,"_2954":121896},[],"/docs/pr-preview/pr-62/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3471":72097,"_30355":72087,"_5":30705,"_21010":121898,"_27589":121899,"_2954":121900},[],"/docs/pr-preview/pr-62/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3471":72098,"_30355":72087,"_5":30705,"_21010":121902,"_27589":121903,"_2954":121904},[],"/docs/pr-preview/pr-62/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3471":72099,"_30355":72087,"_5":30705,"_21010":121906,"_27589":121907,"_2954":121908},[],"/docs/pr-preview/pr-62/es/platform/overview#referencia-operativa","Referencia operativa",{"_3471":72100,"_30355":72087,"_21010":121910,"_5":14420,"_27589":72087,"_2954":121911},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3471":72101,"_30355":72087,"_21010":121913,"_5":14420,"_27589":121868,"_2954":121914},[],"Elige el resultado que necesitas obtener:",{"_3471":72102,"_30355":72087,"_21010":121916,"_5":14420,"_27589":121868,"_2954":121917},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3471":72103,"_30355":72087,"_21010":121919,"_5":14420,"_27589":121868,"_2954":121920},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3471":72104,"_30355":72087,"_21010":121922,"_5":14420,"_27589":121868,"_2954":121923},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3471":72105,"_30355":72087,"_21010":121925,"_5":14420,"_27589":121871,"_2954":121926},[],"Bloque",{"_3471":72106,"_30355":72087,"_21010":121928,"_5":14420,"_27589":121871,"_2954":121929},[],"Qué gestionas",{"_3471":72107,"_30355":72087,"_21010":121931,"_5":14420,"_27589":121871,"_2954":121932},[],"Punto de entrada",{"_3471":72108,"_30355":72087,"_21010":121934,"_5":14420,"_27589":121871,"_2954":54832},[],{"_3471":72109,"_30355":72087,"_21010":121936,"_5":14420,"_27589":121871,"_2954":121937},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3471":72110,"_30355":72087,"_21010":121939,"_5":14420,"_27589":121871,"_2954":121940},[],"Visión general de PKI",{"_3471":72111,"_30355":72087,"_21010":121942,"_5":14420,"_27589":121871,"_2954":54841},[],{"_3471":72112,"_30355":72087,"_21010":121944,"_5":14420,"_27589":121871,"_2954":121945},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3471":72113,"_30355":72087,"_21010":121947,"_5":14420,"_27589":121871,"_2954":121948},[],"Visión general de IoT Fleets",{"_3471":72114,"_30355":72087,"_21010":121950,"_5":14420,"_27589":121871,"_2954":121951},[],"**Administración**",{"_3471":72115,"_30355":72087,"_21010":121953,"_5":14420,"_27589":121871,"_2954":121954},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3471":72116,"_30355":72087,"_21010":121956,"_5":14420,"_27589":121871,"_2954":118154},[],{"_3471":72117,"_30355":72087,"_21010":121958,"_5":14420,"_27589":121871,"_2954":121959},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3471":72118,"_30355":72087,"_21010":121961,"_5":14420,"_27589":121875,"_2954":121962},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3471":72119,"_30355":72087,"_21010":121964,"_5":14420,"_27589":121875,"_2954":121965},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3471":72120,"_30355":72087,"_21010":121967,"_5":14420,"_27589":121875,"_2954":121968},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3471":72121,"_30355":72087,"_21010":121970,"_5":14420,"_27589":121875,"_2954":121971},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3471":72122,"_30355":72087,"_21010":121973,"_5":14420,"_27589":121875,"_2954":121974},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3471":72123,"_30355":72087,"_21010":121976,"_5":14420,"_27589":121875,"_2954":121977},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3471":72124,"_30355":72087,"_21010":121979,"_5":14420,"_27589":121883,"_2954":121980},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3471":72125,"_30355":72087,"_21010":121982,"_5":14420,"_27589":121887,"_2954":121983},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3471":72126,"_30355":72087,"_21010":121985,"_5":14420,"_27589":121891,"_2954":121986},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3471":72127,"_30355":72087,"_21010":121988,"_5":14420,"_27589":121895,"_2954":121989},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3471":72128,"_30355":72087,"_21010":121991,"_5":14420,"_27589":121899,"_2954":121992},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3471":72129,"_30355":72087,"_21010":121994,"_5":14420,"_27589":121903,"_2954":121995},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3471":72130,"_30355":72087,"_21010":121997,"_5":14420,"_27589":121907,"_2954":121453},[],{"_3471":72131,"_30355":72087,"_21010":121999,"_5":14420,"_27589":121907,"_2954":122000},[],"Qué prepara o comprueba",{"_3471":72132,"_30355":72087,"_21010":122002,"_5":14420,"_27589":121907,"_2954":121456},[],{"_3471":72133,"_30355":72087,"_21010":122004,"_5":14420,"_27589":121907,"_2954":122005},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3471":72134,"_30355":72087,"_21010":122007,"_5":14420,"_27589":121907,"_2954":122008},[],"Administrador de la flota",{"_3471":72135,"_30355":72087,"_21010":122010,"_5":14420,"_27589":121907,"_2954":122011},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3471":72136,"_30355":72087,"_21010":122013,"_5":14420,"_27589":121907,"_2954":121468},[],{"_3471":72137,"_30355":72087,"_21010":122015,"_5":14420,"_27589":121907,"_2954":122016},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3471":72138,"_30355":72087,"_21010":122018,"_5":14420,"_27589":121907,"_2954":121474},[],{"_3471":72139,"_30355":72087,"_21010":122020,"_5":14420,"_27589":121907,"_2954":122021},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3471":72140,"_30355":72087,"_21010":122023,"_5":14420,"_27589":121907,"_2954":122024},[],"Operador de infraestructura",{"_3471":72141,"_30355":72087,"_21010":122026,"_5":14420,"_27589":121907,"_2954":122027},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3471":72142,"_30355":72087,"_21010":122029,"_5":14420,"_27589":121907,"_2954":122030},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3471":72143,"_30355":72143,"_5":14772,"_2954":122032,"_30708":122033,"_21010":122035,"_27589":72143},"Jerarquía y rotación de CAs",[49453,118156,54933,122034],"Claves, autoridades y certificados",[],{"_3471":72144,"_30355":72143,"_21010":122037,"_5":14420,"_27589":72143,"_2954":122038},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3471":72145,"_30355":72143,"_5":30705,"_21010":122040,"_27589":122041,"_2954":122042},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3471":72146,"_30355":72143,"_5":30705,"_21010":122044,"_27589":122045,"_2954":122046},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3471":72147,"_30355":72143,"_5":30705,"_21010":122048,"_27589":122049,"_2954":122050},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3471":72148,"_30355":72143,"_5":30705,"_21010":122052,"_27589":122053,"_2954":122054},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3471":72149,"_30355":72143,"_5":30705,"_21010":122056,"_27589":122057,"_2954":122058},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3471":72150,"_30355":72143,"_5":30705,"_21010":122060,"_27589":122061,"_2954":122062},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3471":72151,"_30355":72143,"_5":30705,"_21010":122064,"_27589":122065,"_2954":122066},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3471":72152,"_30355":72143,"_5":30705,"_21010":122068,"_27589":122069,"_2954":122070},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3471":72153,"_30355":72143,"_5":30705,"_21010":122072,"_27589":122073,"_2954":122074},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3471":72154,"_30355":72143,"_5":30705,"_21010":122076,"_27589":122077,"_2954":122078},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3471":72155,"_30355":72143,"_5":30705,"_21010":122080,"_27589":122081,"_2954":122082},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3471":72156,"_30355":72143,"_5":30705,"_21010":122084,"_27589":122085,"_2954":122086},[],"/docs/pr-preview/pr-62/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3471":72157,"_30355":72143,"_21010":122088,"_5":14420,"_27589":72143,"_2954":122089},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3471":72158,"_30355":72143,"_21010":122091,"_5":14420,"_27589":72143,"_2954":122092},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3471":72159,"_30355":72143,"_21010":122094,"_5":14420,"_27589":122041,"_2954":122095},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3471":72160,"_30355":72143,"_21010":122097,"_5":14420,"_27589":122041,"_2954":122098},[],"entorno, como producción y preproducción;",{"_3471":72161,"_30355":72143,"_21010":122100,"_5":14420,"_27589":122041,"_2954":122101},[],"propietario o equipo operador;",{"_3471":72162,"_30355":72143,"_21010":122103,"_5":14420,"_27589":122041,"_2954":122104},[],"familia de dispositivos o proceso de fabricación;",{"_3471":72163,"_30355":72143,"_21010":122106,"_5":14420,"_27589":122041,"_2954":122107},[],"región o requisito regulatorio;",{"_3471":72164,"_30355":72143,"_21010":122109,"_5":14420,"_27589":122041,"_2954":122110},[],"motor criptográfico o política de clave;",{"_3471":72165,"_30355":72143,"_21010":122112,"_5":14420,"_27589":122041,"_2954":122113},[],"ventana de mantenimiento y ritmo de renovación.",{"_3471":72166,"_30355":72143,"_21010":122115,"_5":14420,"_27589":122041,"_2954":122116},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3471":72167,"_30355":72143,"_21010":122118,"_5":14420,"_27589":122041,"_2954":122119},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3471":72168,"_30355":72143,"_21010":122121,"_5":14420,"_27589":122045,"_2954":122122},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3471":72169,"_30355":72143,"_21010":122124,"_5":14420,"_27589":122045,"_2954":122125},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3471":72170,"_30355":72143,"_21010":122127,"_5":14420,"_27589":122045,"_2954":122128},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3471":72171,"_30355":72143,"_21010":122130,"_5":14420,"_27589":122045,"_2954":122131},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3471":72172,"_30355":72143,"_21010":122133,"_5":14420,"_27589":122049,"_2954":122134},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3471":72173,"_30355":72143,"_21010":122136,"_5":14420,"_27589":122049,"_2954":122137},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3471":72174,"_30355":72143,"_21010":122139,"_5":14420,"_27589":122049,"_2954":122140},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3471":72175,"_30355":72143,"_21010":122142,"_5":14420,"_27589":122049,"_2954":122143},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3471":72176,"_30355":72143,"_21010":122145,"_5":14420,"_27589":122057,"_2954":122146},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3471":72177,"_30355":72143,"_21010":122148,"_5":14420,"_27589":122061,"_2954":122149},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3471":72178,"_30355":72143,"_21010":122151,"_5":14420,"_27589":122065,"_2954":122152},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3471":72179,"_30355":72143,"_21010":122154,"_5":14420,"_27589":122069,"_2954":122155},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3471":72180,"_30355":72143,"_21010":122157,"_5":14420,"_27589":122073,"_2954":122158},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3471":72181,"_30355":72143,"_21010":122160,"_5":14420,"_27589":122077,"_2954":122161},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3471":72182,"_30355":72143,"_21010":122163,"_5":14420,"_27589":122081,"_2954":122164},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3471":72183,"_30355":72143,"_21010":122166,"_5":14420,"_27589":122081,"_2954":122167},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3471":72184,"_30355":72143,"_21010":122169,"_5":14420,"_27589":122081,"_2954":122170},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3471":72185,"_30355":72143,"_21010":122172,"_5":14420,"_27589":122081,"_2954":122173},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3471":72186,"_30355":72143,"_21010":122175,"_5":14420,"_27589":122085,"_2954":122176},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3471":72187,"_30355":72143,"_21010":122178,"_5":14420,"_27589":122085,"_2954":122179},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3471":72188,"_30355":72143,"_21010":122181,"_5":14420,"_27589":122085,"_2954":122182},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3471":72189,"_30355":72143,"_21010":122184,"_5":14420,"_27589":122085,"_2954":122185},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3471":72190,"_30355":72143,"_21010":122187,"_5":14420,"_27589":122085,"_2954":122188},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3471":72191,"_30355":72143,"_21010":122190,"_5":14420,"_27589":122085,"_2954":122191},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3471":72192,"_30355":72143,"_21010":122193,"_5":14420,"_27589":122085,"_2954":122194},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3471":72193,"_30355":72193,"_5":14772,"_2954":122196,"_30708":122197,"_21010":122198,"_27589":72193},"Autoridades de certificación",[49453,118156,54933,122034],[],{"_3471":72194,"_30355":72193,"_21010":122200,"_5":14420,"_27589":72193,"_2954":122201},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3471":72195,"_30355":72193,"_5":30705,"_21010":122203,"_27589":122204,"_2954":122205},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3471":72196,"_30355":72193,"_5":30705,"_21010":122207,"_27589":122208,"_2954":122209},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3471":72197,"_30355":72193,"_5":30705,"_21010":122211,"_27589":122212,"_2954":116727},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3471":72198,"_30355":72193,"_5":30705,"_21010":122214,"_27589":122215,"_2954":122216},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3471":72199,"_30355":72193,"_5":30705,"_21010":122218,"_27589":122219,"_2954":122220},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3471":72200,"_30355":72193,"_5":30705,"_21010":122222,"_27589":122223,"_2954":122224},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3471":72201,"_30355":72193,"_5":30705,"_21010":122226,"_27589":122227,"_2954":122228},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3471":72202,"_30355":72193,"_5":30705,"_21010":122230,"_27589":122231,"_2954":122232},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3471":72203,"_30355":72193,"_5":30705,"_21010":122234,"_27589":122235,"_2954":122236},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3471":72204,"_30355":72193,"_5":30705,"_21010":122238,"_27589":122239,"_2954":122240},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3471":72205,"_30355":72193,"_5":30705,"_21010":122242,"_27589":122243,"_2954":122244},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3471":72206,"_30355":72193,"_5":30705,"_21010":122246,"_27589":122247,"_2954":122248},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3471":72207,"_30355":72193,"_5":30705,"_21010":122250,"_27589":122251,"_2954":122252},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3471":72208,"_30355":72193,"_5":30705,"_21010":122254,"_27589":122255,"_2954":122256},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3471":72209,"_30355":72193,"_5":30705,"_21010":122258,"_27589":122259,"_2954":122260},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3471":72210,"_30355":72193,"_5":30705,"_21010":122262,"_27589":122263,"_2954":122264},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3471":72211,"_30355":72193,"_5":30705,"_21010":122266,"_27589":122267,"_2954":122268},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3471":72212,"_30355":72193,"_5":30705,"_21010":122270,"_27589":122271,"_2954":122272},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3471":72213,"_30355":72193,"_5":30705,"_21010":122274,"_27589":122275,"_2954":122276},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3471":72214,"_30355":72193,"_5":30705,"_21010":122278,"_27589":122279,"_2954":122280},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3471":72215,"_30355":72193,"_5":30705,"_21010":122282,"_27589":122283,"_2954":122284},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3471":72216,"_30355":72193,"_5":30705,"_21010":122286,"_27589":122287,"_2954":122288},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3471":72217,"_30355":72193,"_5":30705,"_21010":122290,"_27589":122291,"_2954":122292},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3471":72218,"_30355":72193,"_21010":122294,"_5":14420,"_27589":72193,"_2954":122295},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3471":72219,"_30355":72193,"_21010":122297,"_5":14420,"_27589":72193,"_2954":122298},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3471":72220,"_30355":72193,"_21010":122300,"_5":14420,"_27589":72193,"_2954":122301},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3471":72221,"_30355":72193,"_21010":122303,"_5":14420,"_27589":122204,"_2954":122304},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3471":72222,"_30355":72193,"_21010":122306,"_5":14420,"_27589":122204,"_2954":122307},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3471":72223,"_30355":72193,"_21010":122309,"_5":14420,"_27589":122204,"_2954":122310},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3471":72224,"_30355":72193,"_21010":122312,"_5":14420,"_27589":122204,"_2954":122313},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3471":72225,"_30355":72193,"_21010":122315,"_5":14420,"_27589":122204,"_2954":122316},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3471":72226,"_30355":72193,"_21010":122318,"_5":14420,"_27589":122212,"_2954":122319},[],"Decide si la CA será raíz o intermedia.",{"_3471":72227,"_30355":72193,"_21010":122321,"_5":14420,"_27589":122212,"_2954":122322},[],"Elige el motor que custodiará la clave.",{"_3471":72228,"_30355":72193,"_21010":122324,"_5":14420,"_27589":122212,"_2954":122325},[],"Define una validez superior a la de los certificados que emitirá.",{"_3471":72229,"_30355":72193,"_21010":122327,"_5":14420,"_27589":122212,"_2954":122328},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3471":72230,"_30355":72193,"_21010":122330,"_5":14420,"_27589":122215,"_2954":122331},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3471":72231,"_30355":72193,"_21010":122333,"_5":14420,"_27589":122219,"_2954":122334},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3471":72232,"_30355":72193,"_21010":122336,"_5":14420,"_27589":122219,"_2954":122337},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3471":72233,"_30355":72193,"_21010":122339,"_5":14420,"_27589":122223,"_2954":122340},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3471":72234,"_30355":72193,"_21010":122342,"_5":14420,"_27589":122227,"_2954":122343},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3471":72235,"_30355":72193,"_21010":122345,"_5":14420,"_27589":122227,"_2954":122346},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3471":72236,"_30355":72193,"_21010":122348,"_5":14420,"_27589":122227,"_2954":122349},[],"`ST`: estado o provincia.",{"_3471":72237,"_30355":72193,"_21010":122351,"_5":14420,"_27589":122227,"_2954":122352},[],"`L`: localidad.",{"_3471":72238,"_30355":72193,"_21010":122354,"_5":14420,"_27589":122227,"_2954":122355},[],"`O`: organización.",{"_3471":72239,"_30355":72193,"_21010":122357,"_5":14420,"_27589":122227,"_2954":122358},[],"`OU`: unidad organizativa.",{"_3471":72240,"_30355":72193,"_21010":122360,"_5":14420,"_27589":122227,"_2954":122361},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3471":72241,"_30355":72193,"_21010":122363,"_5":14420,"_27589":122231,"_2954":122364},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3471":72242,"_30355":72193,"_21010":122366,"_5":14420,"_27589":122231,"_2954":122367},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3471":72243,"_30355":72193,"_21010":122369,"_5":14420,"_27589":122235,"_2954":122370},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3471":72244,"_30355":72193,"_21010":122372,"_5":14420,"_27589":122235,"_2954":122373},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3471":72245,"_30355":72193,"_21010":122375,"_5":14420,"_27589":122239,"_2954":122376},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3471":72246,"_30355":72193,"_21010":122378,"_5":14420,"_27589":122239,"_2954":122379},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3471":72247,"_30355":72193,"_21010":122381,"_5":14420,"_27589":122243,"_2954":122382},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3471":72248,"_30355":72193,"_21010":122384,"_5":14420,"_27589":122243,"_2954":122385},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3471":72249,"_30355":72193,"_21010":122387,"_5":14420,"_27589":122243,"_2954":122388},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3471":72250,"_30355":72193,"_21010":122390,"_5":14420,"_27589":122247,"_2954":122391},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3471":72251,"_30355":72193,"_21010":122393,"_5":14420,"_27589":122251,"_2954":122394},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3471":72252,"_30355":72193,"_21010":122396,"_5":14420,"_27589":122251,"_2954":122397},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3471":72253,"_30355":72193,"_21010":122399,"_5":14420,"_27589":122255,"_2954":122400},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3471":72254,"_30355":72193,"_21010":122402,"_5":14420,"_27589":122259,"_2954":122403},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3471":72255,"_30355":72193,"_21010":122405,"_5":14420,"_27589":122259,"_2954":122406},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3471":72256,"_30355":72193,"_21010":122408,"_5":14420,"_27589":122263,"_2954":122409},[],"Abre una CA desde el inventario para consultar:",{"_3471":72257,"_30355":72193,"_21010":122411,"_5":14420,"_27589":122263,"_2954":122412},[],"Estado y periodo de validez.",{"_3471":72258,"_30355":72193,"_21010":122414,"_5":14420,"_27589":122263,"_2954":122415},[],"Certificado y cadena en formato PEM.",{"_3471":72259,"_30355":72193,"_21010":122417,"_5":14420,"_27589":122263,"_2954":122418},[],"Número de certificados activos, expirados y revocados.",{"_3471":72260,"_30355":72193,"_21010":122420,"_5":14420,"_27589":122263,"_2954":122421},[],"Certificados emitidos en **Issued Certificates**.",{"_3471":72261,"_30355":72193,"_21010":122423,"_5":14420,"_27589":122263,"_2954":122424},[],"CRL vinculada a la autoridad.",{"_3471":72262,"_30355":72193,"_21010":122426,"_5":14420,"_27589":122263,"_2954":122427},[],"Metadatos y motor criptográfico asociado.",{"_3471":72263,"_30355":72193,"_21010":122429,"_5":14420,"_27589":122263,"_2954":122430},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3471":72264,"_30355":72193,"_21010":122432,"_5":14420,"_27589":122267,"_2954":122433},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3471":72265,"_30355":72193,"_21010":122435,"_5":14420,"_27589":122267,"_2954":122436},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3471":72266,"_30355":72193,"_21010":122438,"_5":14420,"_27589":122267,"_2954":122439},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3471":72267,"_30355":72193,"_21010":122441,"_5":14420,"_27589":122267,"_2954":122442},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3471":72268,"_30355":72193,"_21010":122444,"_5":14420,"_27589":122271,"_2954":122445},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3471":72269,"_30355":72193,"_21010":122447,"_5":14420,"_27589":122275,"_2954":122448},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3471":72270,"_30355":72193,"_21010":122450,"_5":14420,"_27589":122279,"_2954":122451},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3471":72271,"_30355":72193,"_21010":122453,"_5":14420,"_27589":122283,"_2954":122454},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3471":72272,"_30355":72193,"_21010":122456,"_5":14420,"_27589":122287,"_2954":122457},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3471":72273,"_30355":72193,"_21010":122459,"_5":14420,"_27589":122291,"_2954":122460},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3471":72274,"_30355":72193,"_21010":122462,"_5":14420,"_27589":122291,"_2954":122463},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3471":72275,"_30355":72193,"_21010":122465,"_5":14420,"_27589":122291,"_2954":122466},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3471":72276,"_30355":72276,"_5":14772,"_2954":122468,"_30708":122469,"_21010":122470,"_27589":72276},"Perfiles de certificado",[49453,118156,54933,122034],[],{"_3471":72277,"_30355":72276,"_21010":122472,"_5":14420,"_27589":72276,"_2954":122473},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3471":72278,"_30355":72276,"_5":30705,"_21010":122475,"_27589":122476,"_2954":122477},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3471":72279,"_30355":72276,"_5":30705,"_21010":122479,"_27589":122480,"_2954":122481},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#validez","Validez",{"_3471":72280,"_30355":72276,"_5":30705,"_21010":122483,"_27589":122484,"_2954":122485},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3471":72281,"_30355":72276,"_5":30705,"_21010":122487,"_27589":122488,"_2954":122489},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3471":72282,"_30355":72276,"_5":30705,"_21010":122491,"_27589":122492,"_2954":122493},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3471":72283,"_30355":72276,"_5":30705,"_21010":122495,"_27589":122496,"_2954":122497},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3471":72284,"_30355":72276,"_5":30705,"_21010":122499,"_27589":122500,"_2954":122501},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3471":72285,"_30355":72276,"_5":30705,"_21010":122503,"_27589":122504,"_2954":122505},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3471":72286,"_30355":72276,"_5":30705,"_21010":122507,"_27589":122508,"_2954":122509},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3471":72287,"_30355":72276,"_5":30705,"_21010":122511,"_27589":122512,"_2954":122513},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3471":72288,"_30355":72276,"_5":30705,"_21010":122515,"_27589":122516,"_2954":122517},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3471":72289,"_30355":72276,"_5":30705,"_21010":122519,"_27589":122520,"_2954":122521},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3471":72290,"_30355":72276,"_5":30705,"_21010":122523,"_27589":122524,"_2954":122525},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3471":72291,"_30355":72276,"_5":30705,"_21010":122527,"_27589":122528,"_2954":122529},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3471":72292,"_30355":72276,"_5":30705,"_21010":122531,"_27589":122532,"_2954":122533},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3471":72293,"_30355":72276,"_5":30705,"_21010":122535,"_27589":122536,"_2954":122537},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3471":72294,"_30355":72276,"_21010":122539,"_5":14420,"_27589":72276,"_2954":122540},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3471":72295,"_30355":72276,"_21010":122542,"_5":14420,"_27589":72276,"_2954":122543},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3471":72296,"_30355":72276,"_21010":122545,"_5":14420,"_27589":122480,"_2954":122546},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3471":72297,"_30355":72276,"_21010":122548,"_5":14420,"_27589":122480,"_2954":122549},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3471":72298,"_30355":72276,"_21010":122551,"_5":14420,"_27589":122484,"_2954":122552},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3471":72299,"_30355":72276,"_21010":122554,"_5":14420,"_27589":122488,"_2954":122555},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3471":72300,"_30355":72276,"_21010":122557,"_5":14420,"_27589":122488,"_2954":122558},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3471":72301,"_30355":72276,"_21010":122560,"_5":14420,"_27589":122488,"_2954":122561},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3471":72302,"_30355":72276,"_21010":122563,"_5":14420,"_27589":122492,"_2954":122564},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3471":72303,"_30355":72276,"_21010":122566,"_5":14420,"_27589":122496,"_2954":122567},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3471":72304,"_30355":72276,"_21010":122569,"_5":14420,"_27589":122496,"_2954":122570},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3471":72305,"_30355":72276,"_21010":122572,"_5":14420,"_27589":122500,"_2954":122573},[],"La aplicación criptográfica puede:",{"_3471":72306,"_30355":72276,"_21010":122575,"_5":14420,"_27589":122500,"_2954":122576},[],"permitir o bloquear claves RSA;",{"_3471":72307,"_30355":72276,"_21010":122578,"_5":14420,"_27589":122500,"_2954":122579},[],"limitar los tamaños RSA admitidos;",{"_3471":72308,"_30355":72276,"_21010":122581,"_5":14420,"_27589":122500,"_2954":122582},[],"permitir o bloquear claves ECDSA;",{"_3471":72309,"_30355":72276,"_21010":122584,"_5":14420,"_27589":122500,"_2954":122585},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3471":72310,"_30355":72276,"_21010":122587,"_5":14420,"_27589":122500,"_2954":122588},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3471":72311,"_30355":72276,"_21010":122590,"_5":14420,"_27589":122504,"_2954":122591},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3471":72312,"_30355":72276,"_21010":122593,"_5":14420,"_27589":122504,"_2954":117916},[],{"_3471":72313,"_30355":72276,"_21010":122595,"_5":14420,"_27589":122504,"_2954":122596},[],"Primera opción",{"_3471":72314,"_30355":72276,"_21010":122598,"_5":14420,"_27589":122504,"_2954":122599},[],"Segunda opción",{"_3471":72315,"_30355":72276,"_21010":122601,"_5":14420,"_27589":122504,"_2954":122602},[],"Si no hay ninguna",{"_3471":72316,"_30355":72276,"_21010":122604,"_5":14420,"_27589":122504,"_2954":122605},[],"Firma directa con una CA",{"_3471":72317,"_30355":72276,"_21010":122607,"_5":14420,"_27589":122504,"_2954":122608},[],"`issuance_profile` incluido en la solicitud",{"_3471":72318,"_30355":72276,"_21010":122610,"_5":14420,"_27589":122504,"_2954":122611},[],"`issuance_profile_id` de la solicitud",{"_3471":72319,"_30355":72276,"_21010":122613,"_5":14420,"_27589":122504,"_2954":122614},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3471":72320,"_30355":72276,"_21010":122616,"_5":14420,"_27589":122504,"_2954":122617},[],"Emisión mediante DMS",{"_3471":72321,"_30355":72276,"_21010":122619,"_5":14420,"_27589":122504,"_2954":55520},[],{"_3471":72322,"_30355":72276,"_21010":122621,"_5":14420,"_27589":122504,"_2954":122622},[],"`settings.issuance_profile` incluido en el DMS",{"_3471":72323,"_30355":72276,"_21010":122624,"_5":14420,"_27589":122504,"_2954":122625},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3471":72324,"_30355":72276,"_21010":122627,"_5":14420,"_27589":122504,"_2954":122628},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3471":72325,"_30355":72276,"_21010":122630,"_5":14420,"_27589":122504,"_2954":122631},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3471":72326,"_30355":72276,"_21010":122633,"_5":14420,"_27589":122512,"_2954":122634},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3471":72327,"_30355":72276,"_21010":122636,"_5":14420,"_27589":122516,"_2954":122637},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3471":72328,"_30355":72276,"_21010":122639,"_5":14420,"_27589":122520,"_2954":122640},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3471":72329,"_30355":72276,"_21010":122642,"_5":14420,"_27589":122524,"_2954":122643},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3471":72330,"_30355":72276,"_21010":122645,"_5":14420,"_27589":122528,"_2954":122646},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3471":72331,"_30355":72276,"_21010":122648,"_5":14420,"_27589":122528,"_2954":122649},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3471":72332,"_30355":72276,"_21010":122651,"_5":14420,"_27589":122532,"_2954":122652},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3471":72333,"_30355":72276,"_21010":122654,"_5":14420,"_27589":122532,"_2954":122655},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3471":72334,"_30355":72276,"_21010":122657,"_5":14420,"_27589":122532,"_2954":122658},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3471":72335,"_30355":72276,"_21010":122660,"_5":14420,"_27589":122532,"_2954":122661},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3471":72336,"_30355":72276,"_21010":122663,"_5":14420,"_27589":122536,"_2954":122664},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3471":72337,"_30355":72276,"_21010":122666,"_5":14420,"_27589":122536,"_2954":122667},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3471":72338,"_30355":72338,"_5":14772,"_2954":122669,"_30708":122670,"_21010":122672,"_27589":72338},"Validación de certificados",[49453,118156,54933,122671],"Validación",[],{"_3471":72339,"_30355":72338,"_21010":122674,"_5":14420,"_27589":72338,"_2954":122675},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3471":72340,"_30355":72338,"_5":30705,"_21010":122677,"_27589":122678,"_2954":122679},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3471":72341,"_30355":72338,"_5":30705,"_21010":122681,"_27589":122682,"_2954":122683},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3471":72342,"_30355":72338,"_5":30705,"_21010":122685,"_27589":122686,"_2954":122687},[],"/docs/pr-preview/pr-62/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3471":72343,"_30355":72338,"_21010":122689,"_5":14420,"_27589":72338,"_2954":122690},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3471":72344,"_30355":72338,"_21010":122692,"_5":14420,"_27589":122678,"_2954":122693},[],"Verifica estos criterios juntos:",{"_3471":72345,"_30355":72338,"_21010":122695,"_5":14420,"_27589":122678,"_2954":121663},[],{"_3471":72346,"_30355":72338,"_21010":122697,"_5":14420,"_27589":122678,"_2954":122698},[],"Resultado necesario",{"_3471":72347,"_30355":72338,"_21010":122700,"_5":14420,"_27589":122678,"_2954":122701},[],"Cadena y firma",{"_3471":72348,"_30355":72338,"_21010":122703,"_5":14420,"_27589":122678,"_2954":122704},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3471":72349,"_30355":72338,"_21010":122706,"_5":14420,"_27589":122678,"_2954":122707},[],"Fechas",{"_3471":72350,"_30355":72338,"_21010":122709,"_5":14420,"_27589":122678,"_2954":122710},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3471":72351,"_30355":72338,"_21010":122712,"_5":14420,"_27589":122678,"_2954":117826},[],{"_3471":72352,"_30355":72338,"_21010":122714,"_5":14420,"_27589":122678,"_2954":122715},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3471":72353,"_30355":72338,"_21010":122717,"_5":14420,"_27589":122678,"_2954":122718},[],"Uso",{"_3471":72354,"_30355":72338,"_21010":122720,"_5":14420,"_27589":122678,"_2954":122721},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3471":72355,"_30355":72338,"_21010":122723,"_5":14420,"_27589":122678,"_2954":122724},[],"Revocación",{"_3471":72356,"_30355":72338,"_21010":122726,"_5":14420,"_27589":122678,"_2954":122727},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3471":72357,"_30355":72338,"_21010":122729,"_5":14420,"_27589":122678,"_2954":122730},[],"Autorización",{"_3471":72358,"_30355":72338,"_21010":122732,"_5":14420,"_27589":122678,"_2954":122733},[],"La aplicación permite la acción a esa identidad.",{"_3471":72359,"_30355":72338,"_21010":122735,"_5":14420,"_27589":122678,"_2954":122736},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3471":72360,"_30355":72338,"_21010":122738,"_5":14420,"_27589":122682,"_2954":122739},[],"Mecanismo",{"_3471":72361,"_30355":72338,"_21010":122741,"_5":14420,"_27589":122682,"_2954":122742},[],"Cuándo utilizarlo",{"_3471":72362,"_30355":72338,"_21010":122744,"_5":14420,"_27589":122682,"_2954":122745},[],"Qué debes mantener",{"_3471":72363,"_30355":72338,"_21010":122747,"_5":14420,"_27589":122682,"_2954":55648},[],{"_3471":72364,"_30355":72338,"_21010":122749,"_5":14420,"_27589":122682,"_2954":122750},[],"Consulta del estado de un certificado concreto.",{"_3471":72365,"_30355":72338,"_21010":122752,"_5":14420,"_27589":122682,"_2954":122753},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3471":72366,"_30355":72338,"_21010":122755,"_5":14420,"_27589":122682,"_2954":55657},[],{"_3471":72367,"_30355":72338,"_21010":122757,"_5":14420,"_27589":122682,"_2954":122758},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3471":72368,"_30355":72338,"_21010":122760,"_5":14420,"_27589":122682,"_2954":122761},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3471":72369,"_30355":72338,"_21010":122763,"_5":14420,"_27589":122682,"_2954":122764},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3471":72370,"_30355":72338,"_21010":122766,"_5":14420,"_27589":122682,"_2954":122767},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3471":72371,"_30355":72338,"_21010":122769,"_5":14420,"_27589":122686,"_2954":122770},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3471":72372,"_30355":72338,"_21010":122772,"_5":14420,"_27589":122686,"_2954":122773},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3471":72373,"_30355":72338,"_21010":122775,"_5":14420,"_27589":122686,"_2954":122776},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3471":72374,"_30355":72338,"_21010":122778,"_5":14420,"_27589":122686,"_2954":122779},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3471":72375,"_30355":72338,"_21010":122781,"_5":14420,"_27589":122686,"_2954":122782},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3471":72376,"_30355":72338,"_21010":122784,"_5":14420,"_27589":122686,"_2954":122785},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3471":72377,"_30355":72338,"_21010":122787,"_5":14420,"_27589":122686,"_2954":122788},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3471":72378,"_30355":72338,"_21010":122790,"_5":14420,"_27589":122686,"_2954":122791},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3471":72379,"_30355":72338,"_21010":122793,"_5":14420,"_27589":122686,"_2954":122794},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3471":72380,"_30355":72380,"_5":14772,"_2954":122796,"_30708":122797,"_21010":122798,"_27589":72380},"Certificados",[49453,118156,54933,122034],[],{"_3471":72381,"_30355":72380,"_21010":122800,"_5":14420,"_27589":72380,"_2954":122801},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3471":72382,"_30355":72380,"_5":30705,"_21010":122803,"_27589":122804,"_2954":122805},[],"/docs/pr-preview/pr-62/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3471":72383,"_30355":72380,"_5":30705,"_21010":122807,"_27589":122808,"_2954":122809},[],"/docs/pr-preview/pr-62/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3471":72384,"_30355":72380,"_5":30705,"_21010":122811,"_27589":122812,"_2954":122813},[],"/docs/pr-preview/pr-62/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3471":72385,"_30355":72380,"_5":30705,"_21010":122815,"_27589":122816,"_2954":122817},[],"/docs/pr-preview/pr-62/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3471":72386,"_30355":72380,"_5":30705,"_21010":122819,"_27589":122820,"_2954":122821},[],"/docs/pr-preview/pr-62/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3471":72387,"_30355":72380,"_5":30705,"_21010":122823,"_27589":122824,"_2954":122825},[],"/docs/pr-preview/pr-62/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3471":72388,"_30355":72380,"_5":30705,"_21010":122827,"_27589":122828,"_2954":122829},[],"/docs/pr-preview/pr-62/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3471":72389,"_30355":72380,"_5":30705,"_21010":122831,"_27589":122832,"_2954":122833},[],"/docs/pr-preview/pr-62/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3471":72390,"_30355":72380,"_5":30705,"_21010":122835,"_27589":122836,"_2954":122837},[],"/docs/pr-preview/pr-62/es/platform/pki/certificates#continúa","Continúa",{"_3471":72391,"_30355":72380,"_21010":122839,"_5":14420,"_27589":72380,"_2954":122840},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3471":72392,"_30355":72380,"_21010":122842,"_5":14420,"_27589":122804,"_2954":122843},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3471":72393,"_30355":72380,"_21010":122845,"_5":14420,"_27589":122804,"_2954":122846},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3471":72394,"_30355":72380,"_21010":122848,"_5":14420,"_27589":122804,"_2954":122849},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3471":72395,"_30355":72380,"_21010":122851,"_5":14420,"_27589":122804,"_2954":122852},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3471":72396,"_30355":72380,"_21010":122854,"_5":14420,"_27589":122804,"_2954":122855},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3471":72397,"_30355":72380,"_21010":122857,"_5":14420,"_27589":122804,"_2954":122858},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3471":72398,"_30355":72380,"_21010":122860,"_5":14420,"_27589":122804,"_2954":122861},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3471":72399,"_30355":72380,"_21010":122863,"_5":14420,"_27589":122808,"_2954":122864},[],"Descarga el PEM e inspecciónalo:",{"_3471":72400,"_30355":72380,"_21010":122866,"_5":14420,"_27589":122808,"_2954":122867},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3471":72401,"_30355":72380,"_21010":122869,"_5":14420,"_27589":122812,"_2954":122870},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3471":72402,"_30355":72380,"_21010":122872,"_5":14420,"_27589":122812,"_2954":122873},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3471":72403,"_30355":72380,"_21010":122875,"_5":14420,"_27589":122812,"_2954":122876},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3471":72404,"_30355":72380,"_21010":122878,"_5":14420,"_27589":122812,"_2954":122879},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3471":72405,"_30355":72380,"_21010":122881,"_5":14420,"_27589":122812,"_2954":122882},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3471":72406,"_30355":72380,"_21010":122884,"_5":14420,"_27589":122812,"_2954":122885},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3471":72407,"_30355":72380,"_21010":122887,"_5":14420,"_27589":122812,"_2954":122888},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3471":72408,"_30355":72380,"_21010":122890,"_5":14420,"_27589":122816,"_2954":122891},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3471":72409,"_30355":72380,"_21010":122893,"_5":14420,"_27589":122820,"_2954":122894},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3471":72410,"_30355":72380,"_21010":122896,"_5":14420,"_27589":122824,"_2954":122897},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3471":72411,"_30355":72380,"_21010":122899,"_5":14420,"_27589":122828,"_2954":122900},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3471":72412,"_30355":72380,"_21010":122902,"_5":14420,"_27589":122828,"_2954":122903},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3471":72413,"_30355":72380,"_21010":122905,"_5":14420,"_27589":122828,"_2954":122906},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3471":72414,"_30355":72380,"_21010":122908,"_5":14420,"_27589":122832,"_2954":122909},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3471":72415,"_30355":72380,"_21010":122911,"_5":14420,"_27589":122832,"_2954":122912},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3471":72416,"_30355":72380,"_21010":122914,"_5":14420,"_27589":122832,"_2954":122915},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3471":72417,"_30355":72380,"_21010":122917,"_5":14420,"_27589":122836,"_2954":122918},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3471":72418,"_30355":72380,"_21010":122920,"_5":14420,"_27589":122836,"_2954":122921},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3471":72419,"_30355":72419,"_5":14772,"_2954":122923,"_30708":122924,"_21010":122926,"_27589":72419},"Ciclo de vida de un certificado",[49453,118156,54933,122925],"Conceptos",[],{"_3471":72420,"_30355":72419,"_21010":122928,"_5":14420,"_27589":72419,"_2954":122929},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3471":72421,"_30355":72419,"_5":30705,"_21010":122931,"_27589":122932,"_2954":122933},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3471":72422,"_30355":72419,"_5":30705,"_21010":122935,"_27589":122936,"_2954":122937},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3471":72423,"_30355":72419,"_5":30705,"_21010":122939,"_27589":122940,"_2954":122941},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3471":72424,"_30355":72419,"_5":30705,"_21010":122943,"_27589":122944,"_2954":122945},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3471":72425,"_30355":72419,"_5":30705,"_21010":122947,"_27589":122948,"_2954":122949},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3471":72426,"_30355":72419,"_5":30705,"_21010":122951,"_27589":122952,"_2954":122953},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3471":72427,"_30355":72419,"_5":30705,"_21010":122955,"_27589":122956,"_2954":120657},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3471":72428,"_30355":72419,"_5":30705,"_21010":122958,"_27589":122959,"_2954":122960},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3471":72429,"_30355":72419,"_5":30705,"_21010":122962,"_27589":122963,"_2954":122964},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3471":72430,"_30355":72419,"_5":30705,"_21010":122966,"_27589":122967,"_2954":122968},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3471":72431,"_30355":72419,"_21010":122970,"_5":14420,"_27589":72419,"_2954":122971},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3471":72432,"_30355":72419,"_21010":122973,"_5":14420,"_27589":122936,"_2954":122974},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3471":72433,"_30355":72419,"_21010":122976,"_5":14420,"_27589":122940,"_2954":122977},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3471":72434,"_30355":72419,"_21010":122979,"_5":14420,"_27589":122944,"_2954":122980},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3471":72435,"_30355":72419,"_21010":122982,"_5":14420,"_27589":122948,"_2954":122983},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3471":72436,"_30355":72419,"_21010":122985,"_5":14420,"_27589":122952,"_2954":122986},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3471":72437,"_30355":72419,"_21010":122988,"_5":14420,"_27589":122956,"_2954":122989},[],"Lamassu persiste cuatro estados X.509:",{"_3471":72438,"_30355":72419,"_21010":122991,"_5":14420,"_27589":122956,"_2954":122992},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3471":72439,"_30355":72419,"_21010":122994,"_5":14420,"_27589":122956,"_2954":122995},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3471":72440,"_30355":72419,"_21010":122997,"_5":14420,"_27589":122956,"_2954":122998},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3471":72441,"_30355":72419,"_21010":123000,"_5":14420,"_27589":122956,"_2954":123001},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3471":72442,"_30355":72419,"_21010":123003,"_5":14420,"_27589":122956,"_2954":123004},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3471":72443,"_30355":72419,"_21010":123006,"_5":14420,"_27589":122959,"_2954":123007},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3471":72444,"_30355":72419,"_21010":123009,"_5":14420,"_27589":122959,"_2954":123010},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3471":72445,"_30355":72419,"_21010":123012,"_5":14420,"_27589":122959,"_2954":123013},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3471":72446,"_30355":72419,"_21010":123015,"_5":14420,"_27589":122963,"_2954":123016},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3471":72447,"_30355":72419,"_21010":123018,"_5":14420,"_27589":122963,"_2954":123019},[],"Antes de confirmar:",{"_3471":72448,"_30355":72419,"_21010":123021,"_5":14420,"_27589":122963,"_2954":123022},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3471":72449,"_30355":72419,"_21010":123024,"_5":14420,"_27589":122963,"_2954":123025},[],"Distribuye la nueva cadena de confianza.",{"_3471":72450,"_30355":72419,"_21010":123027,"_5":14420,"_27589":122963,"_2954":123028},[],"Reemite las identidades necesarias.",{"_3471":72451,"_30355":72419,"_21010":123030,"_5":14420,"_27589":122963,"_2954":123031},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3471":72452,"_30355":72419,"_21010":123033,"_5":14420,"_27589":122963,"_2954":123034},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3471":72453,"_30355":72419,"_21010":123036,"_5":14420,"_27589":122963,"_2954":123037},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3471":72454,"_30355":72419,"_21010":123039,"_5":14420,"_27589":122967,"_2954":123040},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3471":72455,"_30355":72419,"_21010":123042,"_5":14420,"_27589":122967,"_2954":123043},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3471":72456,"_30355":72419,"_21010":123045,"_5":14420,"_27589":122967,"_2954":123046},[],"Cambios de estado y razones de revocación.",{"_3471":72457,"_30355":72419,"_21010":123048,"_5":14420,"_27589":122967,"_2954":123049},[],"Publicación y vigencia de OCSP y CRLs.",{"_3471":72458,"_30355":72419,"_21010":123051,"_5":14420,"_27589":122967,"_2954":123052},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3471":72459,"_30355":72419,"_21010":123054,"_5":14420,"_27589":122967,"_2954":123055},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3471":72460,"_30355":72460,"_5":14772,"_2954":123057,"_30708":123058,"_21010":123059,"_27589":72460},"Modelo de confianza",[49453,118156,54933,122925],[],{"_3471":72461,"_30355":72460,"_21010":123061,"_5":14420,"_27589":72460,"_2954":123062},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3471":72462,"_30355":72460,"_5":30705,"_21010":123064,"_27589":123065,"_2954":123066},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3471":72463,"_30355":72460,"_5":30705,"_21010":123068,"_27589":123069,"_2954":123070},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3471":72464,"_30355":72460,"_5":30705,"_21010":123072,"_27589":123073,"_2954":123074},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3471":72465,"_30355":72460,"_5":30705,"_21010":123076,"_27589":123077,"_2954":123078},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3471":72466,"_30355":72460,"_5":30705,"_21010":123080,"_27589":123081,"_2954":123082},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3471":72467,"_30355":72460,"_5":30705,"_21010":123084,"_27589":123085,"_2954":123086},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3471":72468,"_30355":72460,"_5":30705,"_21010":123088,"_27589":123089,"_2954":123090},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3471":72469,"_30355":72460,"_5":30705,"_21010":123092,"_27589":123093,"_2954":123094},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3471":72470,"_30355":72460,"_5":30705,"_21010":123096,"_27589":123097,"_2954":123098},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3471":72471,"_30355":72460,"_5":30705,"_21010":123100,"_27589":123101,"_2954":123102},[],"/docs/pr-preview/pr-62/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3471":72472,"_30355":72460,"_21010":123104,"_5":14420,"_27589":72460,"_2954":123105},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3471":72473,"_30355":72460,"_21010":123107,"_5":14420,"_27589":123069,"_2954":123108},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3471":72474,"_30355":72460,"_21010":123110,"_5":14420,"_27589":123073,"_2954":123111},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3471":72475,"_30355":72460,"_21010":123113,"_5":14420,"_27589":123077,"_2954":123114},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3471":72476,"_30355":72460,"_21010":123116,"_5":14420,"_27589":123081,"_2954":123117},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3471":72477,"_30355":72460,"_21010":123119,"_5":14420,"_27589":123085,"_2954":123120},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3471":72478,"_30355":72460,"_21010":123122,"_5":14420,"_27589":123085,"_2954":123123},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3471":72479,"_30355":72460,"_21010":123125,"_5":14420,"_27589":123085,"_2954":123126},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3471":72480,"_30355":72460,"_21010":123128,"_5":14420,"_27589":123085,"_2954":123129},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3471":72481,"_30355":72460,"_21010":123131,"_5":14420,"_27589":123085,"_2954":123132},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3471":72482,"_30355":72460,"_21010":123134,"_5":14420,"_27589":123085,"_2954":123135},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3471":72483,"_30355":72460,"_21010":123137,"_5":14420,"_27589":123089,"_2954":123138},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3471":72484,"_30355":72460,"_21010":123140,"_5":14420,"_27589":123089,"_2954":123141},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3471":72485,"_30355":72460,"_21010":123143,"_5":14420,"_27589":123089,"_2954":123144},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3471":72486,"_30355":72460,"_21010":123146,"_5":14420,"_27589":123089,"_2954":123147},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3471":72487,"_30355":72460,"_21010":123149,"_5":14420,"_27589":123089,"_2954":123150},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3471":72488,"_30355":72460,"_21010":123152,"_5":14420,"_27589":123093,"_2954":123153},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3471":72489,"_30355":72460,"_21010":123155,"_5":14420,"_27589":123093,"_2954":123156},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3471":72490,"_30355":72460,"_21010":123158,"_5":14420,"_27589":123093,"_2954":123159},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3471":72491,"_30355":72460,"_21010":123161,"_5":14420,"_27589":123093,"_2954":123162},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3471":72492,"_30355":72460,"_21010":123164,"_5":14420,"_27589":123093,"_2954":123165},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3471":72493,"_30355":72460,"_21010":123167,"_5":14420,"_27589":123093,"_2954":123168},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3471":72494,"_30355":72460,"_21010":123170,"_5":14420,"_27589":123093,"_2954":123171},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3471":72495,"_30355":72460,"_21010":123173,"_5":14420,"_27589":123097,"_2954":123174},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3471":72496,"_30355":72460,"_21010":123176,"_5":14420,"_27589":123101,"_2954":123177},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3471":72497,"_30355":72460,"_21010":123179,"_5":14420,"_27589":123101,"_2954":123180},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3471":72498,"_30355":72460,"_21010":123182,"_5":14420,"_27589":123101,"_2954":123183},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3471":72499,"_30355":72460,"_21010":123185,"_5":14420,"_27589":123101,"_2954":123186},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3471":72500,"_30355":72460,"_21010":123188,"_5":14420,"_27589":123101,"_2954":123189},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3471":72501,"_30355":72460,"_21010":123191,"_5":14420,"_27589":123101,"_2954":123192},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3471":72502,"_30355":72460,"_21010":123194,"_5":14420,"_27589":123101,"_2954":123195},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3471":72503,"_30355":72503,"_5":14772,"_2954":123197,"_30708":123198,"_21010":123199,"_27589":72503},"Listas de revocación (CRL)",[49453,118156,54933,122671],[],{"_3471":72504,"_30355":72503,"_21010":123201,"_5":14420,"_27589":72503,"_2954":123202},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3471":72505,"_30355":72503,"_5":30705,"_21010":123204,"_27589":123205,"_2954":123206},[],"/docs/pr-preview/pr-62/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3471":72506,"_30355":72503,"_5":30705,"_21010":123208,"_27589":123209,"_2954":123210},[],"/docs/pr-preview/pr-62/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3471":72507,"_30355":72503,"_5":30705,"_21010":123212,"_27589":123213,"_2954":123214},[],"/docs/pr-preview/pr-62/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3471":72508,"_30355":72503,"_5":30705,"_21010":123216,"_27589":123217,"_2954":123218},[],"/docs/pr-preview/pr-62/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3471":72509,"_30355":72503,"_5":30705,"_21010":123220,"_27589":123221,"_2954":123222},[],"/docs/pr-preview/pr-62/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3471":72510,"_30355":72503,"_5":30705,"_21010":123224,"_27589":123225,"_2954":123226},[],"/docs/pr-preview/pr-62/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3471":72511,"_30355":72503,"_5":30705,"_21010":123228,"_27589":123229,"_2954":123230},[],"/docs/pr-preview/pr-62/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3471":72512,"_30355":72503,"_5":30705,"_21010":123232,"_27589":123233,"_2954":123234},[],"/docs/pr-preview/pr-62/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3471":72513,"_30355":72503,"_5":30705,"_21010":123236,"_27589":123237,"_2954":123238},[],"/docs/pr-preview/pr-62/es/platform/pki/crl#referencias","Referencias",{"_3471":72514,"_30355":72503,"_21010":123240,"_5":14420,"_27589":72503,"_2954":123241},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3471":72515,"_30355":72503,"_21010":123243,"_5":14420,"_27589":123205,"_2954":123244},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3471":72516,"_30355":72503,"_21010":123246,"_5":14420,"_27589":123205,"_2954":123247},[],"Campo",{"_3471":72517,"_30355":72503,"_21010":123249,"_5":14420,"_27589":123205,"_2954":119697},[],{"_3471":72518,"_30355":72503,"_21010":123251,"_5":14420,"_27589":123205,"_2954":56155},[],{"_3471":72519,"_30355":72503,"_21010":123253,"_5":14420,"_27589":123205,"_2954":123254},[],"ID de la CA a la que pertenecen los ajustes.",{"_3471":72520,"_30355":72503,"_21010":123256,"_5":14420,"_27589":123205,"_2954":56161},[],{"_3471":72521,"_30355":72503,"_21010":123258,"_5":14420,"_27589":123205,"_2954":123259},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3471":72522,"_30355":72503,"_21010":123261,"_5":14420,"_27589":123205,"_2954":56167},[],{"_3471":72523,"_30355":72503,"_21010":123263,"_5":14420,"_27589":123205,"_2954":123264},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3471":72524,"_30355":72503,"_21010":123266,"_5":14420,"_27589":123205,"_2954":56173},[],{"_3471":72525,"_30355":72503,"_21010":123268,"_5":14420,"_27589":123205,"_2954":123269},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3471":72526,"_30355":72503,"_21010":123271,"_5":14420,"_27589":123205,"_2954":123272},[],"Campo de `crl_options`",{"_3471":72527,"_30355":72503,"_21010":123274,"_5":14420,"_27589":123205,"_2954":119697},[],{"_3471":72528,"_30355":72503,"_21010":123276,"_5":14420,"_27589":123205,"_2954":123277},[],"Valor inicial",{"_3471":72529,"_30355":72503,"_21010":123279,"_5":14420,"_27589":123205,"_2954":56187},[],{"_3471":72530,"_30355":72503,"_21010":123281,"_5":14420,"_27589":123205,"_2954":123282},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3471":72531,"_30355":72503,"_21010":123284,"_5":14420,"_27589":123205,"_2954":123285},[],"7 días.",{"_3471":72532,"_30355":72503,"_21010":123287,"_5":14420,"_27589":123205,"_2954":56196},[],{"_3471":72533,"_30355":72503,"_21010":123289,"_5":14420,"_27589":123205,"_2954":123290},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3471":72534,"_30355":72503,"_21010":123292,"_5":14420,"_27589":123205,"_2954":123293},[],"6 días y 23 horas.",{"_3471":72535,"_30355":72503,"_21010":123295,"_5":14420,"_27589":123205,"_2954":56205},[],{"_3471":72536,"_30355":72503,"_21010":123297,"_5":14420,"_27589":123205,"_2954":123298},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3471":72537,"_30355":72503,"_21010":123300,"_5":14420,"_27589":123205,"_2954":56211},[],{"_3471":72538,"_30355":72503,"_21010":123302,"_5":14420,"_27589":123205,"_2954":56214},[],{"_3471":72539,"_30355":72503,"_21010":123304,"_5":14420,"_27589":123205,"_2954":123305},[],"Número de serie del certificado existente que firma la CRL.",{"_3471":72540,"_30355":72503,"_21010":123307,"_5":14420,"_27589":123205,"_2954":123308},[],"Número de serie del certificado actual de la CA.",{"_3471":72541,"_30355":72503,"_21010":123310,"_5":14420,"_27589":123205,"_2954":123311},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3471":72542,"_30355":72503,"_21010":123313,"_5":14420,"_27589":123205,"_2954":123314},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3471":72543,"_30355":72503,"_21010":123316,"_5":14420,"_27589":123205,"_2954":123317},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3471":72544,"_30355":72503,"_21010":123319,"_5":14420,"_27589":123205,"_2954":123320},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3471":72545,"_30355":72503,"_21010":123322,"_5":14420,"_27589":123205,"_2954":123323},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3471":72546,"_30355":72503,"_21010":123325,"_5":14420,"_27589":123205,"_2954":123326},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3471":72547,"_30355":72503,"_21010":123328,"_5":14420,"_27589":123205,"_2954":123329},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3471":72548,"_30355":72503,"_21010":123331,"_5":14420,"_27589":123205,"_2954":123332},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3471":72549,"_30355":72503,"_21010":123334,"_5":14420,"_27589":123205,"_2954":123335},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3471":72550,"_30355":72503,"_21010":123337,"_5":14420,"_27589":123205,"_2954":123338},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3471":72551,"_30355":72503,"_21010":123340,"_5":14420,"_27589":123209,"_2954":123341},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3471":72552,"_30355":72503,"_21010":123343,"_5":14420,"_27589":123209,"_2954":123344},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3471":72553,"_30355":72503,"_21010":123346,"_5":14420,"_27589":123209,"_2954":123347},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3471":72554,"_30355":72503,"_21010":123349,"_5":14420,"_27589":123209,"_2954":123350},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3471":72555,"_30355":72503,"_21010":123352,"_5":14420,"_27589":123213,"_2954":123353},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3471":72556,"_30355":72503,"_21010":123355,"_5":14420,"_27589":123213,"_2954":123356},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3471":72557,"_30355":72503,"_21010":123358,"_5":14420,"_27589":123213,"_2954":123359},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3471":72558,"_30355":72503,"_21010":123361,"_5":14420,"_27589":123213,"_2954":123362},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3471":72559,"_30355":72503,"_21010":123364,"_5":14420,"_27589":123213,"_2954":123365},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3471":72560,"_30355":72503,"_21010":123367,"_5":14420,"_27589":123213,"_2954":123368},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3471":72561,"_30355":72503,"_21010":123370,"_5":14420,"_27589":123213,"_2954":123371},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3471":72562,"_30355":72503,"_21010":123373,"_5":14420,"_27589":123213,"_2954":123374},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3471":72563,"_30355":72503,"_21010":123376,"_5":14420,"_27589":123213,"_2954":123377},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3471":72564,"_30355":72503,"_21010":123379,"_5":14420,"_27589":123217,"_2954":123380},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3471":72565,"_30355":72503,"_21010":123382,"_5":14420,"_27589":123217,"_2954":123383},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3471":72566,"_30355":72503,"_21010":123385,"_5":14420,"_27589":123221,"_2954":123386},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3471":72567,"_30355":72503,"_21010":123388,"_5":14420,"_27589":123221,"_2954":123389},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3471":72568,"_30355":72503,"_21010":123391,"_5":14420,"_27589":123221,"_2954":123392},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3471":72569,"_30355":72503,"_21010":123394,"_5":14420,"_27589":123221,"_2954":123395},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3471":72570,"_30355":72503,"_21010":123397,"_5":14420,"_27589":123221,"_2954":123398},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3471":72571,"_30355":72503,"_21010":123400,"_5":14420,"_27589":123225,"_2954":123401},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3471":72572,"_30355":72503,"_21010":123403,"_5":14420,"_27589":123225,"_2954":119886},[],{"_3471":72573,"_30355":72503,"_21010":123405,"_5":14420,"_27589":123225,"_2954":123406},[],"Path relativo",{"_3471":72574,"_30355":72503,"_21010":123408,"_5":14420,"_27589":123225,"_2954":117916},[],{"_3471":72575,"_30355":72503,"_21010":123410,"_5":14420,"_27589":123225,"_2954":56323},[],{"_3471":72576,"_30355":72503,"_21010":123412,"_5":14420,"_27589":123225,"_2954":56326},[],{"_3471":72577,"_30355":72503,"_21010":123414,"_5":14420,"_27589":123225,"_2954":123415},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3471":72578,"_30355":72503,"_21010":123417,"_5":14420,"_27589":123225,"_2954":56323},[],{"_3471":72579,"_30355":72503,"_21010":123419,"_5":14420,"_27589":123225,"_2954":56334},[],{"_3471":72580,"_30355":72503,"_21010":123421,"_5":14420,"_27589":123225,"_2954":123422},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3471":72581,"_30355":72503,"_21010":123424,"_5":14420,"_27589":123225,"_2954":56340},[],{"_3471":72582,"_30355":72503,"_21010":123426,"_5":14420,"_27589":123225,"_2954":56334},[],{"_3471":72583,"_30355":72503,"_21010":123428,"_5":14420,"_27589":123225,"_2954":123429},[],"Sustituir la configuración de CRL de una CA.",{"_3471":72584,"_30355":72503,"_21010":123431,"_5":14420,"_27589":123225,"_2954":123432},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3471":72585,"_30355":72503,"_21010":123434,"_5":14420,"_27589":123225,"_2954":123435},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3471":72586,"_30355":72503,"_21010":123437,"_5":14420,"_27589":123229,"_2954":123438},[],"Síntoma",{"_3471":72587,"_30355":72503,"_21010":123440,"_5":14420,"_27589":123229,"_2954":123441},[],"Causa",{"_3471":72588,"_30355":72503,"_21010":123443,"_5":14420,"_27589":123229,"_2954":123444},[],"Acción",{"_3471":72589,"_30355":72503,"_21010":123446,"_5":14420,"_27589":123229,"_2954":123447},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3471":72590,"_30355":72503,"_21010":123449,"_5":14420,"_27589":123229,"_2954":123450},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3471":72591,"_30355":72503,"_21010":123452,"_5":14420,"_27589":123229,"_2954":123453},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3471":72592,"_30355":72503,"_21010":123455,"_5":14420,"_27589":123229,"_2954":123456},[],"`PUT` devuelve 400.",{"_3471":72593,"_30355":72503,"_21010":123458,"_5":14420,"_27589":123229,"_2954":123459},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3471":72594,"_30355":72503,"_21010":123461,"_5":14420,"_27589":123229,"_2954":123462},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3471":72595,"_30355":72503,"_21010":123464,"_5":14420,"_27589":123229,"_2954":123465},[],"`PUT` devuelve 404.",{"_3471":72596,"_30355":72503,"_21010":123467,"_5":14420,"_27589":123229,"_2954":123468},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3471":72597,"_30355":72503,"_21010":123470,"_5":14420,"_27589":123229,"_2954":123471},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3471":72598,"_30355":72503,"_21010":123473,"_5":14420,"_27589":123229,"_2954":123474},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3471":72599,"_30355":72503,"_21010":123476,"_5":14420,"_27589":123229,"_2954":123477},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3471":72600,"_30355":72503,"_21010":123479,"_5":14420,"_27589":123229,"_2954":123480},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3471":72601,"_30355":72503,"_21010":123482,"_5":14420,"_27589":123229,"_2954":123483},[],"La CRL no cambia tras revocar un certificado.",{"_3471":72602,"_30355":72503,"_21010":123485,"_5":14420,"_27589":123229,"_2954":123486},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3471":72603,"_30355":72503,"_21010":123488,"_5":14420,"_27589":123229,"_2954":123489},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3471":72604,"_30355":72503,"_21010":123491,"_5":14420,"_27589":123229,"_2954":123492},[],"Un verificador rechaza la CRL por el emisor.",{"_3471":72605,"_30355":72503,"_21010":123494,"_5":14420,"_27589":123229,"_2954":123495},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3471":72606,"_30355":72503,"_21010":123497,"_5":14420,"_27589":123229,"_2954":123498},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3471":72607,"_30355":72503,"_21010":123500,"_5":14420,"_27589":123233,"_2954":123501},[],"Los ajustes de CRL de una CA se editan en la pestaña **Validation Authority** de la vista de la CA y en la página **Verification Authorities** de la consola. Ambos los leen y actualizan por ID de CA en `/v1/crl-settings/{ca-id}`, que requiere un backend 4.0.0.",{"_3471":72608,"_30355":72503,"_21010":123503,"_5":14420,"_27589":123233,"_2954":123504},[],"Si el backend aún no tiene ajustes para una CA, la pestaña muestra un panel **No CRL Settings** que indica que los ajustes de CRL se crean junto con la CA y que, si la CA se acaba de crear, pueden seguir inicializándose, con un botón **Retry**. Mientras cargan los ajustes, muestra &#x2A;*Loading CRL Settings...**; si falla la consulta, muestra **Error Loading CRL Settings**, también con un botón **Retry**. La fila 404 de Errores frecuentes de los ajustes de CRL enumera cuándo puede una CA no tener ajustes.",{"_3471":72609,"_30355":72503,"_21010":123506,"_5":14420,"_27589":123233,"_2954":123507},[],"Los ajustes cuya CA se eliminó antes de la actualización a 4.0.0 quedan `ARCHIVED`: la interfaz los muestra en solo lectura dentro de un aviso de advertencia, y la página Verification Authorities marca la CA con la insignia **Archived**. Su última CRL sigue sirviéndose, pero nunca se regenera, y los ajustes no pueden editarse — consulta Casos en los que los ajustes dejan de poder editarse. Los ajustes migrados del modelo indexado por SKI muestran una nota con su URL de CRL heredada `/crl/<legacy-ski>`, que sigue resolviendo a la lista de esta CA.",{"_3471":72610,"_30355":72503,"_21010":123509,"_5":14420,"_27589":123233,"_2954":123510},[],"El campo **CRL Refresh Interval** acepta `0`. Entonces un aviso informativo explica que no se genera una CRL nueva solo porque pase el tiempo — una se genera únicamente poco antes de que venza la actual — y, con **Regenerate CRL Immediately on Revocation** desactivado, que las revocaciones no se publican hasta entonces. El resumen de la página Verification Authorities muestra **Disabled** para un intervalo de renovación de `0`; la semántica está descrita en Regeneración periódica y automática. El campo **CRL Max Validity / Cache Duration** sigue exigiendo una duración positiva y rechaza `0`.",{"_3471":72611,"_30355":72503,"_21010":123512,"_5":14420,"_27589":123233,"_2954":123513},[],"La edición es tolerante: un campo muestra su error solo cuando lo abandonas. **Save CRL Settings** siempre está activado; si al guardar hay campos no válidos, la interfaz los marca todos, muestra los errores y enfoca el primero no válido en lugar de dejar desactivado el botón.",{"_3471":72612,"_30355":72503,"_21010":123515,"_5":14420,"_27589":123233,"_2954":123516},[],"El firmante seleccionado aparece como una tarjeta con su emisor (el DN completo en un tooltip que se abre al pasar el ratón y al enfocar con el teclado, y cuyo nombre enlaza a su CA cuando existe su registro), su fecha de vencimiento, su algoritmo de clave, sus chips de usos y su número de serie, bajo el pie **CRL signer — Signs the CRLs of this CA**. El selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`.",{"_3471":72613,"_30355":72503,"_21010":123518,"_5":14420,"_27589":123233,"_2954":123519},[],"La vista de la CA permite inspeccionar y descargar la lista disponible; el fichero descargado se llama `<ca-id>.crl`. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3471":72614,"_30355":72503,"_21010":123521,"_5":14420,"_27589":123237,"_2954":123522},[],"RFC 5280: perfil X.509 y CRL.",{"_3471":72615,"_30355":72503,"_21010":123524,"_5":14420,"_27589":123237,"_2954":56441},[],{"_3471":72616,"_30355":72503,"_21010":123526,"_5":14420,"_27589":123237,"_2954":56444},[],{"_3471":72617,"_30355":72503,"_21010":123528,"_5":14420,"_27589":123237,"_2954":123529},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3471":72618,"_30355":72503,"_21010":123531,"_5":14420,"_27589":123237,"_2954":123532},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3471":72619,"_30355":72619,"_5":14772,"_2954":123534,"_30708":123535,"_21010":123536,"_27589":72619},"Claves y motores criptográficos",[49453,118156,54933,122034],[],{"_3471":72620,"_30355":72619,"_21010":123538,"_5":14420,"_27589":72619,"_2954":123539},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3471":72621,"_30355":72619,"_5":30705,"_21010":123541,"_27589":123542,"_2954":123543},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3471":72622,"_30355":72619,"_5":30705,"_21010":123545,"_27589":123546,"_2954":123547},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3471":72623,"_30355":72619,"_5":30705,"_21010":123549,"_27589":123550,"_2954":56469},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#file-system",{"_3471":72624,"_30355":72619,"_5":30705,"_21010":123552,"_27589":123553,"_2954":56473},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#hashicorp-vault",{"_3471":72625,"_30355":72619,"_5":30705,"_21010":123555,"_27589":123556,"_2954":56477},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#aws-secrets-manager",{"_3471":72626,"_30355":72619,"_5":30705,"_21010":123558,"_27589":123559,"_2954":56481},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#aws-kms",{"_3471":72627,"_30355":72619,"_5":30705,"_21010":123561,"_27589":123562,"_2954":56485},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#pkcs11",{"_3471":72628,"_30355":72619,"_5":30705,"_21010":123564,"_27589":123565,"_2954":56489},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#azure-key-vault",{"_3471":72629,"_30355":72619,"_5":30705,"_21010":123567,"_27589":123568,"_2954":123569},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3471":72630,"_30355":72619,"_5":30705,"_21010":123571,"_27589":123572,"_2954":123573},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3471":72631,"_30355":72619,"_5":30705,"_21010":123575,"_27589":123576,"_2954":123577},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3471":72632,"_30355":72619,"_5":30705,"_21010":123579,"_27589":123580,"_2954":123581},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3471":72633,"_30355":72619,"_5":30705,"_21010":123583,"_27589":123584,"_2954":123585},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3471":72634,"_30355":72619,"_5":30705,"_21010":123587,"_27589":123588,"_2954":123589},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3471":72635,"_30355":72619,"_5":30705,"_21010":123591,"_27589":123592,"_2954":123593},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3471":72636,"_30355":72619,"_5":30705,"_21010":123595,"_27589":123596,"_2954":56521},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#sign",{"_3471":72637,"_30355":72619,"_5":30705,"_21010":123598,"_27589":123599,"_2954":56525},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#verify",{"_3471":72638,"_30355":72619,"_5":30705,"_21010":123601,"_27589":123602,"_2954":123603},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3471":72639,"_30355":72619,"_5":30705,"_21010":123605,"_27589":123606,"_2954":123607},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3471":72640,"_30355":72619,"_5":30705,"_21010":123609,"_27589":123610,"_2954":123611},[],"/docs/pr-preview/pr-62/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3471":72641,"_30355":72619,"_21010":123613,"_5":14420,"_27589":72619,"_2954":123614},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3471":72642,"_30355":72619,"_21010":123616,"_5":14420,"_27589":72619,"_2954":123617},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3471":72643,"_30355":72619,"_21010":123619,"_5":14420,"_27589":123542,"_2954":123620},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3471":72644,"_30355":72619,"_21010":123622,"_5":14420,"_27589":123542,"_2954":123623},[],"En la práctica, permite:",{"_3471":72645,"_30355":72619,"_21010":123625,"_5":14420,"_27589":123542,"_2954":123626},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3471":72646,"_30355":72619,"_21010":123628,"_5":14420,"_27589":123542,"_2954":123629},[],"Importar claves creadas externamente.",{"_3471":72647,"_30355":72619,"_21010":123631,"_5":14420,"_27589":123542,"_2954":123632},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3471":72648,"_30355":72619,"_21010":123634,"_5":14420,"_27589":123542,"_2954":123635},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3471":72649,"_30355":72619,"_21010":123637,"_5":14420,"_27589":123546,"_2954":123638},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3471":72650,"_30355":72619,"_21010":123640,"_5":14420,"_27589":123546,"_2954":123641},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3471":72651,"_30355":72619,"_21010":123643,"_5":14420,"_27589":123546,"_2954":123644},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3471":72652,"_30355":72619,"_21010":123646,"_5":14420,"_27589":123550,"_2954":123647},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3471":72653,"_30355":72619,"_21010":123649,"_5":14420,"_27589":123553,"_2954":123650},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3471":72654,"_30355":72619,"_21010":123652,"_5":14420,"_27589":123553,"_2954":123653},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3471":72655,"_30355":72619,"_21010":123655,"_5":14420,"_27589":123556,"_2954":123656},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3471":72656,"_30355":72619,"_21010":123658,"_5":14420,"_27589":123559,"_2954":123659},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3471":72657,"_30355":72619,"_21010":123661,"_5":14420,"_27589":123562,"_2954":123662},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3471":72658,"_30355":72619,"_21010":123664,"_5":14420,"_27589":123565,"_2954":123665},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3471":72659,"_30355":72619,"_21010":123667,"_5":14420,"_27589":123565,"_2954":123668},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3471":72660,"_30355":72619,"_21010":123670,"_5":14420,"_27589":123565,"_2954":123671},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3471":72661,"_30355":72619,"_21010":123673,"_5":14420,"_27589":123565,"_2954":123674},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3471":72662,"_30355":72619,"_21010":123676,"_5":14420,"_27589":123568,"_2954":123677},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3471":72663,"_30355":72619,"_21010":123679,"_5":14420,"_27589":123568,"_2954":123680},[],"La tabla incluye los siguientes campos:",{"_3471":72664,"_30355":72619,"_21010":123682,"_5":14420,"_27589":123568,"_2954":123683},[],"**Name**: nombre descriptivo de la clave.",{"_3471":72665,"_30355":72619,"_21010":123685,"_5":14420,"_27589":123568,"_2954":123686},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3471":72666,"_30355":72619,"_21010":123688,"_5":14420,"_27589":123568,"_2954":123689},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3471":72667,"_30355":72619,"_21010":123691,"_5":14420,"_27589":123568,"_2954":123692},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3471":72668,"_30355":72619,"_21010":123694,"_5":14420,"_27589":123568,"_2954":123695},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3471":72669,"_30355":72619,"_21010":123697,"_5":14420,"_27589":123568,"_2954":123698},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3471":72670,"_30355":72619,"_21010":123700,"_5":14420,"_27589":123568,"_2954":123701},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3471":72671,"_30355":72619,"_21010":123703,"_5":14420,"_27589":123568,"_2954":123704},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3471":72672,"_30355":72619,"_21010":123706,"_5":14420,"_27589":123568,"_2954":123707},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3471":72673,"_30355":72619,"_21010":123709,"_5":14420,"_27589":123568,"_2954":123710},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3471":72674,"_30355":72619,"_21010":123712,"_5":14420,"_27589":123568,"_2954":123713},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3471":72675,"_30355":72619,"_21010":123715,"_5":14420,"_27589":123568,"_2954":123716},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3471":72676,"_30355":72619,"_21010":123718,"_5":14420,"_27589":123568,"_2954":123719},[],"**Delete Key** para eliminar la clave del sistema.",{"_3471":72677,"_30355":72619,"_21010":123721,"_5":14420,"_27589":123572,"_2954":123722},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3471":72678,"_30355":72619,"_21010":123724,"_5":14420,"_27589":123576,"_2954":123725},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3471":72679,"_30355":72619,"_21010":123727,"_5":14420,"_27589":123576,"_2954":123728},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3471":72680,"_30355":72619,"_21010":123730,"_5":14420,"_27589":123576,"_2954":123731},[],"**Key Name**: nombre único y descriptivo.",{"_3471":72681,"_30355":72619,"_21010":123733,"_5":14420,"_27589":123576,"_2954":123734},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3471":72682,"_30355":72619,"_21010":123736,"_5":14420,"_27589":123576,"_2954":123737},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3471":72683,"_30355":72619,"_21010":123739,"_5":14420,"_27589":123576,"_2954":123740},[],"**Tags**: metadatos para clasificar la clave.",{"_3471":72684,"_30355":72619,"_21010":123742,"_5":14420,"_27589":123576,"_2954":123743},[],"**Metadata**: información adicional para usos avanzados.",{"_3471":72685,"_30355":72619,"_21010":123745,"_5":14420,"_27589":123580,"_2954":123746},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3471":72686,"_30355":72619,"_21010":123748,"_5":14420,"_27589":123580,"_2954":123749},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3471":72687,"_30355":72619,"_21010":123751,"_5":14420,"_27589":123580,"_2954":123752},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3471":72688,"_30355":72619,"_21010":123754,"_5":14420,"_27589":123580,"_2954":123755},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3471":72689,"_30355":72619,"_21010":123757,"_5":14420,"_27589":123580,"_2954":123758},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3471":72690,"_30355":72619,"_21010":123760,"_5":14420,"_27589":123580,"_2954":123761},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3471":72691,"_30355":72619,"_21010":123763,"_5":14420,"_27589":123580,"_2954":123764},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3471":72692,"_30355":72619,"_21010":123766,"_5":14420,"_27589":123580,"_2954":123767},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3471":72693,"_30355":72619,"_21010":123769,"_5":14420,"_27589":123580,"_2954":123770},[],"**Metadata**: información adicional opcional.",{"_3471":72694,"_30355":72619,"_21010":123772,"_5":14420,"_27589":123580,"_2954":123773},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3471":72695,"_30355":72619,"_21010":123775,"_5":14420,"_27589":123580,"_2954":123776},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3471":72696,"_30355":72619,"_21010":123778,"_5":14420,"_27589":123584,"_2954":123779},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3471":72697,"_30355":72619,"_21010":123781,"_5":14420,"_27589":123588,"_2954":123782},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3471":72698,"_30355":72619,"_21010":123784,"_5":14420,"_27589":123588,"_2954":123785},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3471":72699,"_30355":72619,"_21010":123787,"_5":14420,"_27589":123588,"_2954":123788},[],"**Key Name**: nombre descriptivo.",{"_3471":72700,"_30355":72619,"_21010":123790,"_5":14420,"_27589":123588,"_2954":123791},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3471":72701,"_30355":72619,"_21010":123793,"_5":14420,"_27589":123588,"_2954":123794},[],"**Tags**: etiquetas asociadas.",{"_3471":72702,"_30355":72619,"_21010":123796,"_5":14420,"_27589":123588,"_2954":123797},[],"**Aliases**: nombres alternativos.",{"_3471":72703,"_30355":72619,"_21010":123799,"_5":14420,"_27589":123588,"_2954":123800},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3471":72704,"_30355":72619,"_21010":123802,"_5":14420,"_27589":123588,"_2954":123803},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3471":72705,"_30355":72619,"_21010":123805,"_5":14420,"_27589":123588,"_2954":123806},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3471":72706,"_30355":72619,"_21010":123808,"_5":14420,"_27589":123588,"_2954":123809},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3471":72707,"_30355":72619,"_21010":123811,"_5":14420,"_27589":123592,"_2954":123812},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3471":72708,"_30355":72619,"_21010":123814,"_5":14420,"_27589":123592,"_2954":123815},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3471":72709,"_30355":72619,"_21010":123817,"_5":14420,"_27589":123592,"_2954":123818},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3471":72710,"_30355":72619,"_21010":123820,"_5":14420,"_27589":123596,"_2954":123821},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3471":72711,"_30355":72619,"_21010":123823,"_5":14420,"_27589":123596,"_2954":123824},[],"Campos principales:",{"_3471":72712,"_30355":72619,"_21010":123826,"_5":14420,"_27589":123596,"_2954":123827},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3471":72713,"_30355":72619,"_21010":123829,"_5":14420,"_27589":123596,"_2954":123830},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3471":72714,"_30355":72619,"_21010":123832,"_5":14420,"_27589":123596,"_2954":123833},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3471":72715,"_30355":72619,"_21010":123835,"_5":14420,"_27589":123596,"_2954":123836},[],"**Message**: contenido que se va a firmar.",{"_3471":72716,"_30355":72619,"_21010":123838,"_5":14420,"_27589":123596,"_2954":123839},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3471":72717,"_30355":72619,"_21010":123841,"_5":14420,"_27589":123599,"_2954":123842},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3471":72718,"_30355":72619,"_21010":123844,"_5":14420,"_27589":123599,"_2954":123824},[],{"_3471":72719,"_30355":72619,"_21010":123846,"_5":14420,"_27589":123599,"_2954":123847},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3471":72720,"_30355":72619,"_21010":123849,"_5":14420,"_27589":123599,"_2954":123850},[],"**Message Type**: `Raw` o `Digest`.",{"_3471":72721,"_30355":72619,"_21010":123852,"_5":14420,"_27589":123599,"_2954":123853},[],"**Payload Encoding**: codificación del mensaje.",{"_3471":72722,"_30355":72619,"_21010":123855,"_5":14420,"_27589":123599,"_2954":123856},[],"**Message**: mensaje original o hash.",{"_3471":72723,"_30355":72619,"_21010":123858,"_5":14420,"_27589":123599,"_2954":123859},[],"**Signature**: firma que se desea comprobar.",{"_3471":72724,"_30355":72619,"_21010":123861,"_5":14420,"_27589":123599,"_2954":123862},[],"**Result**: indicador del resultado de la validación.",{"_3471":72725,"_30355":72619,"_21010":123864,"_5":14420,"_27589":123602,"_2954":123865},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3471":72726,"_30355":72619,"_21010":123867,"_5":14420,"_27589":123602,"_2954":123868},[],"Este flujo es útil para:",{"_3471":72727,"_30355":72619,"_21010":123870,"_5":14420,"_27589":123602,"_2954":123871},[],"Solicitar certificados a una CA externa.",{"_3471":72728,"_30355":72619,"_21010":123873,"_5":14420,"_27589":123602,"_2954":123874},[],"Renovar una identidad manteniendo la misma clave.",{"_3471":72729,"_30355":72619,"_21010":123876,"_5":14420,"_27589":123602,"_2954":123877},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3471":72730,"_30355":72619,"_21010":123879,"_5":14420,"_27589":123602,"_2954":123880},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3471":72731,"_30355":72619,"_21010":123882,"_5":14420,"_27589":123602,"_2954":123883},[],"**Organization (O)**: organización o empresa.",{"_3471":72732,"_30355":72619,"_21010":123885,"_5":14420,"_27589":123602,"_2954":123886},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3471":72733,"_30355":72619,"_21010":123888,"_5":14420,"_27589":123602,"_2954":123889},[],"**Country (C)**: código de país de dos letras.",{"_3471":72734,"_30355":72619,"_21010":123891,"_5":14420,"_27589":123602,"_2954":123892},[],"**State / Province (ST)**: estado o provincia.",{"_3471":72735,"_30355":72619,"_21010":123894,"_5":14420,"_27589":123602,"_2954":123895},[],"**Locality (L)**: ciudad o localidad.",{"_3471":72736,"_30355":72619,"_21010":123897,"_5":14420,"_27589":123602,"_2954":123898},[],"**Email Address**: correo de contacto.",{"_3471":72737,"_30355":72619,"_21010":123900,"_5":14420,"_27589":123602,"_2954":123901},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3471":72738,"_30355":72619,"_21010":123903,"_5":14420,"_27589":123602,"_2954":123904},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3471":72739,"_30355":72619,"_21010":123906,"_5":14420,"_27589":123606,"_2954":123907},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3471":72740,"_30355":72619,"_21010":123909,"_5":14420,"_27589":123606,"_2954":123910},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3471":72741,"_30355":72619,"_21010":123912,"_5":14420,"_27589":123610,"_2954":123913},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3471":72742,"_30355":72619,"_21010":123915,"_5":14420,"_27589":123610,"_2954":123916},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3471":72743,"_30355":72743,"_5":14772,"_2954":123918,"_30708":123919,"_21010":123920,"_27589":72743},"Validación online con OCSP",[49453,118156,54933,122671],[],{"_3471":72744,"_30355":72743,"_21010":123922,"_5":14420,"_27589":72743,"_2954":123923},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3471":72745,"_30355":72743,"_5":30705,"_21010":123925,"_27589":123926,"_2954":123927},[],"/docs/pr-preview/pr-62/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3471":72746,"_30355":72743,"_5":30705,"_21010":123929,"_27589":123930,"_2954":123931},[],"/docs/pr-preview/pr-62/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3471":72747,"_30355":72743,"_5":30705,"_21010":123933,"_27589":123934,"_2954":123935},[],"/docs/pr-preview/pr-62/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3471":72748,"_30355":72743,"_5":30705,"_21010":123937,"_27589":123938,"_2954":123939},[],"/docs/pr-preview/pr-62/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3471":72749,"_30355":72743,"_5":30705,"_21010":123941,"_27589":123942,"_2954":123943},[],"/docs/pr-preview/pr-62/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3471":72750,"_30355":72743,"_5":30705,"_21010":123945,"_27589":123946,"_2954":123238},[],"/docs/pr-preview/pr-62/es/platform/pki/ocsp#referencias",{"_3471":72751,"_30355":72743,"_21010":123948,"_5":14420,"_27589":72743,"_2954":123949},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3471":72752,"_30355":72743,"_21010":123951,"_5":14420,"_27589":123926,"_2954":123952},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3471":72753,"_30355":72743,"_21010":123954,"_5":14420,"_27589":123926,"_2954":123955},[],"Estado del registro",{"_3471":72754,"_30355":72743,"_21010":123957,"_5":14420,"_27589":123926,"_2954":123958},[],"Respuesta firmada",{"_3471":72755,"_30355":72743,"_21010":123960,"_5":14420,"_27589":123926,"_2954":54070},[],{"_3471":72756,"_30355":72743,"_21010":123962,"_5":14420,"_27589":123926,"_2954":56889},[],{"_3471":72757,"_30355":72743,"_21010":123964,"_5":14420,"_27589":123926,"_2954":54087},[],{"_3471":72758,"_30355":72743,"_21010":123966,"_5":14420,"_27589":123926,"_2954":123967},[],"`Revoked`, con razón y fecha de revocación.",{"_3471":72759,"_30355":72743,"_21010":123969,"_5":14420,"_27589":123926,"_2954":123970},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3471":72760,"_30355":72743,"_21010":123972,"_5":14420,"_27589":123926,"_2954":123973},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3471":72761,"_30355":72743,"_21010":123975,"_5":14420,"_27589":123926,"_2954":123976},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3471":72762,"_30355":72743,"_21010":123978,"_5":14420,"_27589":123926,"_2954":123979},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3471":72763,"_30355":72743,"_21010":123981,"_5":14420,"_27589":123926,"_2954":123982},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3471":72764,"_30355":72743,"_21010":123984,"_5":14420,"_27589":123930,"_2954":123985},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3471":72765,"_30355":72743,"_21010":123987,"_5":14420,"_27589":123930,"_2954":123988},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3471":72766,"_30355":72743,"_21010":123990,"_5":14420,"_27589":123934,"_2954":123991},[],"El servicio acepta:",{"_3471":72767,"_30355":72743,"_21010":123993,"_5":14420,"_27589":123934,"_2954":119886},[],{"_3471":72768,"_30355":72743,"_21010":123995,"_5":14420,"_27589":123934,"_2954":123996},[],"Ruta del servicio VA",{"_3471":72769,"_30355":72743,"_21010":123998,"_5":14420,"_27589":123934,"_2954":123999},[],"Formato",{"_3471":72770,"_30355":72743,"_21010":124001,"_5":14420,"_27589":123934,"_2954":56929},[],{"_3471":72771,"_30355":72743,"_21010":124003,"_5":14420,"_27589":123934,"_2954":56932},[],{"_3471":72772,"_30355":72743,"_21010":124005,"_5":14420,"_27589":123934,"_2954":124006},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3471":72773,"_30355":72743,"_21010":124008,"_5":14420,"_27589":123934,"_2954":56323},[],{"_3471":72774,"_30355":72743,"_21010":124010,"_5":14420,"_27589":123934,"_2954":56940},[],{"_3471":72775,"_30355":72743,"_21010":124012,"_5":14420,"_27589":123934,"_2954":124013},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3471":72776,"_30355":72743,"_21010":124015,"_5":14420,"_27589":123934,"_2954":124016},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3471":72777,"_30355":72743,"_21010":124018,"_5":14420,"_27589":123938,"_2954":124019},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3471":72778,"_30355":72743,"_21010":124021,"_5":14420,"_27589":123938,"_2954":124022},[],"Genera la solicitud:",{"_3471":72779,"_30355":72743,"_21010":124024,"_5":14420,"_27589":123938,"_2954":124025},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3471":72780,"_30355":72743,"_21010":124027,"_5":14420,"_27589":123938,"_2954":124028},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3471":72781,"_30355":72743,"_21010":124030,"_5":14420,"_27589":123938,"_2954":124031},[],"Verifica el DER recibido:",{"_3471":72782,"_30355":72743,"_21010":124033,"_5":14420,"_27589":123938,"_2954":124034},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3471":72783,"_30355":72743,"_21010":124036,"_5":14420,"_27589":123942,"_2954":124037},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3471":72784,"_30355":72743,"_21010":124039,"_5":14420,"_27589":123942,"_2954":124040},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3471":72785,"_30355":72743,"_21010":124042,"_5":14420,"_27589":123946,"_2954":56973},[],{"_3471":72786,"_30355":72743,"_21010":124044,"_5":14420,"_27589":123946,"_2954":56976},[],{"_3471":72787,"_30355":72743,"_21010":124046,"_5":14420,"_27589":123946,"_2954":124047},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3471":72788,"_30355":72743,"_21010":124049,"_5":14420,"_27589":123946,"_2954":123532},[],{"_3471":72789,"_30355":72789,"_5":14772,"_2954":54933,"_30708":124051,"_21010":124052,"_27589":72789},[49453,118156,54933],[],{"_3471":72790,"_30355":72789,"_21010":124054,"_5":14420,"_27589":72789,"_2954":124055},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3471":72791,"_30355":72789,"_5":30705,"_21010":124057,"_27589":124058,"_2954":121360},[],"/docs/pr-preview/pr-62/es/platform/pki/overview#empieza-aquí",{"_3471":72792,"_30355":72789,"_5":30705,"_21010":124060,"_27589":124061,"_2954":124062},[],"/docs/pr-preview/pr-62/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3471":72793,"_30355":72789,"_5":30705,"_21010":124064,"_27589":124065,"_2954":121880},[],"/docs/pr-preview/pr-62/es/platform/pki/overview#capacidades-principales",{"_3471":72794,"_30355":72789,"_5":30705,"_21010":124067,"_27589":124068,"_2954":121884},[],"/docs/pr-preview/pr-62/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3471":72795,"_30355":72789,"_5":30705,"_21010":124070,"_27589":124071,"_2954":121888},[],"/docs/pr-preview/pr-62/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3471":72796,"_30355":72789,"_5":30705,"_21010":124073,"_27589":124074,"_2954":121892},[],"/docs/pr-preview/pr-62/es/platform/pki/overview#emite-y-controla-certificados",{"_3471":72797,"_30355":72789,"_5":30705,"_21010":124076,"_27589":124077,"_2954":121900},[],"/docs/pr-preview/pr-62/es/platform/pki/overview#publica-el-estado-de-validación",{"_3471":72798,"_30355":72789,"_5":30705,"_21010":124079,"_27589":124080,"_2954":124081},[],"/docs/pr-preview/pr-62/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3471":72799,"_30355":72789,"_5":30705,"_21010":124083,"_27589":124084,"_2954":122837},[],"/docs/pr-preview/pr-62/es/platform/pki/overview#continúa",{"_3471":72800,"_30355":72789,"_21010":124086,"_5":14420,"_27589":72789,"_2954":124087},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3471":72801,"_30355":72789,"_21010":124089,"_5":14420,"_27589":124058,"_2954":124090},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3471":72802,"_30355":72789,"_21010":124092,"_5":14420,"_27589":124058,"_2954":124093},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3471":72803,"_30355":72789,"_21010":124095,"_5":14420,"_27589":124061,"_2954":124096},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3471":72804,"_30355":72789,"_21010":124098,"_5":14420,"_27589":124061,"_2954":124099},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3471":72805,"_30355":72789,"_21010":124101,"_5":14420,"_27589":124061,"_2954":124102},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3471":72806,"_30355":72789,"_21010":124104,"_5":14420,"_27589":124061,"_2954":124105},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3471":72807,"_30355":72789,"_21010":124107,"_5":14420,"_27589":124061,"_2954":124108},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3471":72808,"_30355":72789,"_21010":124110,"_5":14420,"_27589":124068,"_2954":124111},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3471":72809,"_30355":72789,"_21010":124113,"_5":14420,"_27589":124071,"_2954":124114},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3471":72810,"_30355":72789,"_21010":124116,"_5":14420,"_27589":124074,"_2954":124117},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3471":72811,"_30355":72789,"_21010":124119,"_5":14420,"_27589":124077,"_2954":124120},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3471":72812,"_30355":72789,"_21010":124122,"_5":14420,"_27589":124080,"_2954":124123},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3471":72813,"_30355":72789,"_21010":124125,"_5":14420,"_27589":124080,"_2954":124126},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3471":72814,"_30355":72789,"_21010":124128,"_5":14420,"_27589":124080,"_2954":124129},[],"su clave pública corresponda a la clave privada del cliente;",{"_3471":72815,"_30355":72789,"_21010":124131,"_5":14420,"_27589":124080,"_2954":124132},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3471":72816,"_30355":72789,"_21010":124134,"_5":14420,"_27589":124080,"_2954":124135},[],"sus fechas y usos permitan la operación;",{"_3471":72817,"_30355":72789,"_21010":124137,"_5":14420,"_27589":124080,"_2954":124138},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3471":72818,"_30355":72789,"_21010":124140,"_5":14420,"_27589":124080,"_2954":124141},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3471":72819,"_30355":72789,"_21010":124143,"_5":14420,"_27589":124084,"_2954":124144},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3471":72820,"_30355":72789,"_21010":124146,"_5":14420,"_27589":124084,"_2954":124147},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3471":72821,"_30355":72789,"_21010":124149,"_5":14420,"_27589":124084,"_2954":124150},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3471":72822,"_30355":72822,"_5":14772,"_2954":124152,"_30708":124153,"_21010":124154,"_27589":72822},"Crea tu primera CA",[49453,118156,54933,121484],[],{"_3471":72823,"_30355":72822,"_21010":124156,"_5":14420,"_27589":72822,"_2954":124157},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3471":72824,"_30355":72822,"_5":30705,"_21010":124159,"_27589":124160,"_2954":116727},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3471":72825,"_30355":72822,"_5":30705,"_21010":124162,"_27589":124163,"_2954":124164},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3471":72826,"_30355":72822,"_5":30705,"_21010":124166,"_27589":124167,"_2954":124168},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3471":72827,"_30355":72822,"_5":30705,"_21010":124170,"_27589":124171,"_2954":124172},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3471":72828,"_30355":72822,"_5":30705,"_21010":124174,"_27589":124175,"_2954":124176},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3471":72829,"_30355":72822,"_5":30705,"_21010":124178,"_27589":124179,"_2954":124180},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3471":72830,"_30355":72822,"_5":30705,"_21010":124182,"_27589":124183,"_2954":124184},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3471":72831,"_30355":72822,"_5":30705,"_21010":124186,"_27589":124187,"_2954":121731},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3471":72832,"_30355":72822,"_5":30705,"_21010":124189,"_27589":124190,"_2954":116751},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3471":72833,"_30355":72822,"_21010":124192,"_5":14420,"_27589":72822,"_2954":124193},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3471":72834,"_30355":72822,"_21010":124195,"_5":14420,"_27589":124160,"_2954":124196},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3471":72835,"_30355":72822,"_21010":124198,"_5":14420,"_27589":124160,"_2954":124199},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3471":72836,"_30355":72822,"_21010":124201,"_5":14420,"_27589":124160,"_2954":124202},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3471":72837,"_30355":72822,"_21010":124204,"_5":14420,"_27589":124160,"_2954":124205},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3471":72838,"_30355":72822,"_21010":124207,"_5":14420,"_27589":124163,"_2954":124208},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3471":72839,"_30355":72822,"_21010":124210,"_5":14420,"_27589":124163,"_2954":124211},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3471":72840,"_30355":72822,"_21010":124213,"_5":14420,"_27589":124167,"_2954":124214},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3471":72841,"_30355":72822,"_21010":124216,"_5":14420,"_27589":124167,"_2954":124217},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3471":72842,"_30355":72822,"_21010":124219,"_5":14420,"_27589":124171,"_2954":124220},[],"Selecciona **Root CA** y completa:",{"_3471":72843,"_30355":72822,"_21010":124222,"_5":14420,"_27589":124171,"_2954":57155},[],{"_3471":72844,"_30355":72822,"_21010":124224,"_5":14420,"_27589":124171,"_2954":124225},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3471":72845,"_30355":72822,"_21010":124227,"_5":14420,"_27589":124171,"_2954":124228},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3471":72846,"_30355":72822,"_21010":124230,"_5":14420,"_27589":124171,"_2954":124231},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3471":72847,"_30355":72822,"_21010":124233,"_5":14420,"_27589":124171,"_2954":124234},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3471":72848,"_30355":72822,"_21010":124236,"_5":14420,"_27589":124175,"_2954":124237},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3471":72849,"_30355":72822,"_21010":124239,"_5":14420,"_27589":124179,"_2954":124240},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3471":72850,"_30355":72822,"_21010":124242,"_5":14420,"_27589":124179,"_2954":124243},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3471":72851,"_30355":72822,"_21010":124245,"_5":14420,"_27589":124183,"_2954":124246},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3471":72852,"_30355":72822,"_21010":124248,"_5":14420,"_27589":124183,"_2954":124249},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3471":72853,"_30355":72822,"_21010":124251,"_5":14420,"_27589":124183,"_2954":124252},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3471":72854,"_30355":72822,"_21010":124254,"_5":14420,"_27589":124187,"_2954":124255},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3471":72855,"_30355":72822,"_21010":124257,"_5":14420,"_27589":124187,"_2954":124258},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3471":72856,"_30355":72822,"_21010":124260,"_5":14420,"_27589":124187,"_2954":124261},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3471":72857,"_30355":72822,"_21010":124263,"_5":14420,"_27589":124187,"_2954":124264},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3471":72858,"_30355":72822,"_21010":124266,"_5":14420,"_27589":124190,"_2954":124267},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3471":72859,"_30355":72859,"_5":14772,"_2954":124269,"_30708":124270,"_21010":124271,"_27589":72859},"Emite y verifica un certificado",[49453,118156,54933,121484],[],{"_3471":72860,"_30355":72859,"_21010":124273,"_5":14420,"_27589":72859,"_2954":124274},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3471":72861,"_30355":72859,"_5":30705,"_21010":124276,"_27589":124277,"_2954":116727},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3471":72862,"_30355":72859,"_5":30705,"_21010":124279,"_27589":124280,"_2954":124281},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3471":72863,"_30355":72859,"_5":30705,"_21010":124283,"_27589":124284,"_2954":124285},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3471":72864,"_30355":72859,"_5":30705,"_21010":124287,"_27589":124288,"_2954":124289},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3471":72865,"_30355":72859,"_5":30705,"_21010":124291,"_27589":124292,"_2954":124293},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3471":72866,"_30355":72859,"_5":30705,"_21010":124295,"_27589":124296,"_2954":124297},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3471":72867,"_30355":72859,"_5":30705,"_21010":124299,"_27589":124300,"_2954":124301},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3471":72868,"_30355":72859,"_5":30705,"_21010":124303,"_27589":124304,"_2954":124305},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3471":72869,"_30355":72859,"_5":30705,"_21010":124307,"_27589":124308,"_2954":124309},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3471":72870,"_30355":72859,"_5":30705,"_21010":124311,"_27589":124312,"_2954":124313},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3471":72871,"_30355":72859,"_5":30705,"_21010":124315,"_27589":124316,"_2954":121731},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3471":72872,"_30355":72859,"_5":30705,"_21010":124318,"_27589":124319,"_2954":116751},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3471":72873,"_30355":72859,"_21010":124321,"_5":14420,"_27589":72859,"_2954":124322},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3471":72874,"_30355":72859,"_21010":124324,"_5":14420,"_27589":124277,"_2954":124325},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3471":72875,"_30355":72859,"_21010":124327,"_5":14420,"_27589":124277,"_2954":124328},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3471":72876,"_30355":72859,"_21010":124330,"_5":14420,"_27589":124277,"_2954":124331},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3471":72877,"_30355":72859,"_21010":124333,"_5":14420,"_27589":124277,"_2954":124334},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3471":72878,"_30355":72859,"_21010":124336,"_5":14420,"_27589":124277,"_2954":124337},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3471":72879,"_30355":72859,"_21010":124339,"_5":14420,"_27589":124280,"_2954":124340},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3471":72880,"_30355":72859,"_21010":124342,"_5":14420,"_27589":124284,"_2954":124343},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3471":72881,"_30355":72859,"_21010":124345,"_5":14420,"_27589":124284,"_2954":124346},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3471":72882,"_30355":72859,"_21010":124348,"_5":14420,"_27589":124288,"_2954":124349},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3471":72883,"_30355":72859,"_21010":124351,"_5":14420,"_27589":124288,"_2954":124352},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3471":72884,"_30355":72859,"_21010":124354,"_5":14420,"_27589":124292,"_2954":124355},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3471":72885,"_30355":72859,"_21010":124357,"_5":14420,"_27589":124292,"_2954":124358},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3471":72886,"_30355":72859,"_21010":124360,"_5":14420,"_27589":124296,"_2954":124361},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3471":72887,"_30355":72859,"_21010":124363,"_5":14420,"_27589":124300,"_2954":124364},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3471":72888,"_30355":72859,"_21010":124366,"_5":14420,"_27589":124304,"_2954":124367},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3471":72889,"_30355":72859,"_21010":124369,"_5":14420,"_27589":124308,"_2954":124370},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3471":72890,"_30355":72859,"_21010":124372,"_5":14420,"_27589":124308,"_2954":124373},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3471":72891,"_30355":72859,"_21010":124375,"_5":14420,"_27589":124308,"_2954":124376},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3471":72892,"_30355":72859,"_21010":124378,"_5":14420,"_27589":124312,"_2954":124379},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3471":72893,"_30355":72859,"_21010":124381,"_5":14420,"_27589":124312,"_2954":124382},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3471":72894,"_30355":72859,"_21010":124384,"_5":14420,"_27589":124312,"_2954":124385},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3471":72895,"_30355":72859,"_21010":124387,"_5":14420,"_27589":124316,"_2954":121814},[],{"_3471":72896,"_30355":72859,"_21010":124389,"_5":14420,"_27589":124316,"_2954":120335},[],{"_3471":72897,"_30355":72859,"_21010":124391,"_5":14420,"_27589":124316,"_2954":124392},[],"La CA rechaza la emisión",{"_3471":72898,"_30355":72859,"_21010":124394,"_5":14420,"_27589":124316,"_2954":124395},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3471":72899,"_30355":72859,"_21010":124397,"_5":14420,"_27589":124316,"_2954":124398},[],"Sujeto o usos diferentes",{"_3471":72900,"_30355":72859,"_21010":124400,"_5":14420,"_27589":124316,"_2954":124401},[],"Perfil aplicado y valores solicitados.",{"_3471":72901,"_30355":72859,"_21010":124403,"_5":14420,"_27589":124316,"_2954":124404},[],"No se encuentra el emisor",{"_3471":72902,"_30355":72859,"_21010":124406,"_5":14420,"_27589":124316,"_2954":124407},[],"CA descargada y cadena intermedia necesaria.",{"_3471":72903,"_30355":72859,"_21010":124409,"_5":14420,"_27589":124316,"_2954":124410},[],"Falla la vigencia",{"_3471":72904,"_30355":72859,"_21010":124412,"_5":14420,"_27589":124316,"_2954":124413},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3471":72905,"_30355":72859,"_21010":124415,"_5":14420,"_27589":124316,"_2954":124416},[],"Los resúmenes de clave difieren",{"_3471":72906,"_30355":72859,"_21010":124418,"_5":14420,"_27589":124316,"_2954":124419},[],"Archivos de certificado y clave de la misma emisión.",{"_3471":72907,"_30355":72859,"_21010":124421,"_5":14420,"_27589":124316,"_2954":124422},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3471":72908,"_30355":72859,"_21010":124424,"_5":14420,"_27589":124319,"_2954":124425},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3471":72909,"_30355":72859,"_21010":124427,"_5":14420,"_27589":124319,"_2954":124428},[],"Gestionar certificados para inspección, estado y revocación.",{"_3471":72910,"_30355":72859,"_21010":124430,"_5":14420,"_27589":124319,"_2954":124431},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3471":72911,"_30355":72859,"_21010":124433,"_5":14420,"_27589":124319,"_2954":124434},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3471":72912,"_30355":72859,"_21010":124436,"_5":14420,"_27589":124319,"_2954":124437},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3471":72913,"_30355":72913,"_5":14772,"_2954":124439,"_30708":124440,"_21010":124441,"_27589":72913},"Primeros pasos de PKI",[49453,118156,54933,121484],[],{"_3471":72914,"_30355":72913,"_21010":124443,"_5":14420,"_27589":72913,"_2954":124444},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3471":72915,"_30355":72913,"_5":30705,"_21010":124446,"_27589":124447,"_2954":116727},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3471":72916,"_30355":72913,"_5":30705,"_21010":124449,"_27589":124450,"_2954":124451},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3471":72917,"_30355":72913,"_5":30705,"_21010":124453,"_27589":124454,"_2954":121666},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3471":72918,"_30355":72913,"_5":30705,"_21010":124456,"_27589":124457,"_2954":124458},[],"/docs/pr-preview/pr-62/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3471":72919,"_30355":72913,"_21010":124460,"_5":14420,"_27589":72913,"_2954":124461},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3471":72920,"_30355":72913,"_21010":124463,"_5":14420,"_27589":124447,"_2954":124464},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3471":72921,"_30355":72913,"_21010":124466,"_5":14420,"_27589":124447,"_2954":124467},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3471":72922,"_30355":72913,"_21010":124469,"_5":14420,"_27589":124447,"_2954":124470},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3471":72923,"_30355":72913,"_21010":124472,"_5":14420,"_27589":124447,"_2954":124473},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3471":72924,"_30355":72913,"_21010":124475,"_5":14420,"_27589":124447,"_2954":124476},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3471":72925,"_30355":72913,"_21010":124478,"_5":14420,"_27589":124450,"_2954":124479},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3471":72926,"_30355":72913,"_21010":124481,"_5":14420,"_27589":124450,"_2954":124482},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3471":72927,"_30355":72913,"_21010":124484,"_5":14420,"_27589":124450,"_2954":124485},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3471":72928,"_30355":72913,"_21010":124487,"_5":14420,"_27589":124450,"_2954":124488},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3471":72929,"_30355":72913,"_21010":124490,"_5":14420,"_27589":124454,"_2954":124491},[],"Archivo o recurso",{"_3471":72930,"_30355":72913,"_21010":124493,"_5":14420,"_27589":124454,"_2954":121663},[],{"_3471":72931,"_30355":72913,"_21010":124495,"_5":14420,"_27589":124454,"_2954":124496},[],"CA raíz activa y `ca.pem`",{"_3471":72932,"_30355":72913,"_21010":124498,"_5":14420,"_27589":124454,"_2954":124499},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3471":72933,"_30355":72913,"_21010":124501,"_5":14420,"_27589":124454,"_2954":124502},[],"Certificado final y `device.crt`",{"_3471":72934,"_30355":72913,"_21010":124504,"_5":14420,"_27589":124454,"_2954":124505},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3471":72935,"_30355":72913,"_21010":124507,"_5":14420,"_27589":124454,"_2954":124508},[],"Clave privada `device.key`",{"_3471":72936,"_30355":72913,"_21010":124510,"_5":14420,"_27589":124454,"_2954":124511},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3471":72937,"_30355":72913,"_21010":124513,"_5":14420,"_27589":124454,"_2954":124514},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3471":72938,"_30355":72913,"_21010":124516,"_5":14420,"_27589":124457,"_2954":124517},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3471":72939,"_30355":72913,"_21010":124519,"_5":14420,"_27589":124457,"_2954":124520},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3471":72940,"_30355":72913,"_21010":124522,"_5":14420,"_27589":124457,"_2954":124523},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3471":72941,"_30355":72941,"_5":14772,"_2954":124525,"_30708":124526,"_21010":124528,"_27589":72941},"Resolución de problemas PKI",[49453,118156,54933,124527],"Resolución de problemas",[],{"_3471":72942,"_30355":72941,"_21010":124530,"_5":14420,"_27589":72941,"_2954":124531},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3471":72943,"_30355":72941,"_5":30705,"_21010":124533,"_27589":124534,"_2954":124535},[],"/docs/pr-preview/pr-62/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3471":72944,"_30355":72941,"_5":30705,"_21010":124537,"_27589":124538,"_2954":124539},[],"/docs/pr-preview/pr-62/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3471":72945,"_30355":72941,"_5":30705,"_21010":124541,"_27589":124542,"_2954":124543},[],"/docs/pr-preview/pr-62/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3471":72946,"_30355":72941,"_21010":124545,"_5":14420,"_27589":72941,"_2954":124546},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3471":72947,"_30355":72941,"_21010":124548,"_5":14420,"_27589":72941,"_2954":124549},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3471":72948,"_30355":72941,"_21010":124551,"_5":14420,"_27589":124534,"_2954":121663},[],{"_3471":72949,"_30355":72941,"_21010":124553,"_5":14420,"_27589":124534,"_2954":120335},[],{"_3471":72950,"_30355":72941,"_21010":124555,"_5":14420,"_27589":124534,"_2954":116751},[],{"_3471":72951,"_30355":72941,"_21010":124557,"_5":14420,"_27589":124534,"_2954":53775},[],{"_3471":72952,"_30355":72941,"_21010":124559,"_5":14420,"_27589":124534,"_2954":124560},[],"Existe, está activa y sus fechas son utilizables.",{"_3471":72953,"_30355":72941,"_21010":124562,"_5":14420,"_27589":124534,"_2954":124563},[],"Autoridades.",{"_3471":72954,"_30355":72941,"_21010":124565,"_5":14420,"_27589":124534,"_2954":124566},[],"Clave",{"_3471":72955,"_30355":72941,"_21010":124568,"_5":14420,"_27589":124534,"_2954":124569},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3471":72956,"_30355":72941,"_21010":124571,"_5":14420,"_27589":124534,"_2954":124572},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3471":72957,"_30355":72941,"_21010":124574,"_5":14420,"_27589":124534,"_2954":57509},[],{"_3471":72958,"_30355":72941,"_21010":124576,"_5":14420,"_27589":124534,"_2954":124577},[],"PEM correcto y firma verificable.",{"_3471":72959,"_30355":72941,"_21010":124579,"_5":14420,"_27589":124534,"_2954":57515},[],{"_3471":72960,"_30355":72941,"_21010":124581,"_5":14420,"_27589":124534,"_2954":124582},[],"Perfil",{"_3471":72961,"_30355":72941,"_21010":124584,"_5":14420,"_27589":124534,"_2954":124585},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3471":72962,"_30355":72941,"_21010":124587,"_5":14420,"_27589":124534,"_2954":124588},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3471":72963,"_30355":72941,"_21010":124590,"_5":14420,"_27589":124534,"_2954":121814},[],{"_3471":72964,"_30355":72941,"_21010":124592,"_5":14420,"_27589":124534,"_2954":124593},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3471":72965,"_30355":72941,"_21010":124595,"_5":14420,"_27589":124534,"_2954":124596},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3471":72966,"_30355":72941,"_21010":124598,"_5":14420,"_27589":124534,"_2954":124599},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3471":72967,"_30355":72941,"_21010":124601,"_5":14420,"_27589":124534,"_2954":124602},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3471":72968,"_30355":72941,"_21010":124604,"_5":14420,"_27589":124538,"_2954":124605},[],"Revisa cada frontera por separado:",{"_3471":72969,"_30355":72941,"_21010":124607,"_5":14420,"_27589":124538,"_2954":124608},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3471":72970,"_30355":72941,"_21010":124610,"_5":14420,"_27589":124538,"_2954":124611},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3471":72971,"_30355":72941,"_21010":124613,"_5":14420,"_27589":124538,"_2954":124614},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3471":72972,"_30355":72941,"_21010":124616,"_5":14420,"_27589":124538,"_2954":124617},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3471":72973,"_30355":72941,"_21010":124619,"_5":14420,"_27589":124538,"_2954":124620},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3471":72974,"_30355":72941,"_21010":124622,"_5":14420,"_27589":124538,"_2954":124623},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3471":72975,"_30355":72941,"_21010":124625,"_5":14420,"_27589":124542,"_2954":124626},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3471":72976,"_30355":72941,"_21010":124628,"_5":14420,"_27589":124542,"_2954":124629},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3471":72977,"_30355":72977,"_5":14772,"_2954":124631,"_30708":124632,"_21010":124633,"_27589":72977},"Seguridad",[49453],[],{"_3471":72978,"_30355":72977,"_21010":124635,"_5":14420,"_27589":72977,"_2954":124636},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3471":72979,"_30355":72977,"_5":30705,"_21010":124638,"_27589":124639,"_2954":124640},[],"/docs/pr-preview/pr-62/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3471":72980,"_30355":72977,"_5":30705,"_21010":124642,"_27589":124643,"_2954":124644},[],"/docs/pr-preview/pr-62/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3471":72981,"_30355":72977,"_5":30705,"_21010":124646,"_27589":124647,"_2954":124648},[],"/docs/pr-preview/pr-62/es/security#versiones-soportadas","Versiones soportadas",{"_3471":72982,"_30355":72977,"_5":30705,"_21010":124650,"_27589":124651,"_2954":124652},[],"/docs/pr-preview/pr-62/es/security#divulgación-responsable","Divulgación responsable",{"_3471":72983,"_30355":72977,"_21010":124654,"_5":14420,"_27589":72977,"_2954":124655},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3471":72984,"_30355":72977,"_21010":124657,"_5":14420,"_27589":124639,"_2954":124658},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3471":72985,"_30355":72977,"_21010":124660,"_5":14420,"_27589":124639,"_2954":124661},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3471":72986,"_30355":72977,"_21010":124663,"_5":14420,"_27589":124639,"_2954":15051},[],{"_3471":72987,"_30355":72977,"_21010":124665,"_5":14420,"_27589":124639,"_2954":14991},[],{"_3471":72988,"_30355":72977,"_21010":124667,"_5":14420,"_27589":124639,"_2954":15038},[],{"_3471":72989,"_30355":72977,"_21010":124669,"_5":14420,"_27589":124639,"_2954":124670},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3471":72990,"_30355":72977,"_21010":124672,"_5":14420,"_27589":124639,"_2954":124673},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3471":72991,"_30355":72977,"_21010":124675,"_5":14420,"_27589":124643,"_2954":124676},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3471":72992,"_30355":72977,"_21010":124678,"_5":14420,"_27589":124643,"_2954":124679},[],"No incluyas en el reporte:",{"_3471":72993,"_30355":72977,"_21010":124681,"_5":14420,"_27589":124643,"_2954":124682},[],"Credenciales, tokens o claves privadas",{"_3471":72994,"_30355":72977,"_21010":124684,"_5":14420,"_27589":124643,"_2954":124685},[],"Datos de clientes o información identificable de clientes",{"_3471":72995,"_30355":72977,"_21010":124687,"_5":14420,"_27589":124643,"_2954":124688},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3471":72996,"_30355":72977,"_21010":124690,"_5":14420,"_27589":124647,"_2954":124691},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3471":72997,"_30355":72977,"_21010":124693,"_5":14420,"_27589":124647,"_2954":124694},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3471":72998,"_30355":72977,"_21010":124696,"_5":14420,"_27589":124651,"_2954":124697},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3471":72999,"_30355":72977,"_21010":124699,"_5":14420,"_27589":124651,"_2954":124700},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3471":73000,"_30355":72977,"_21010":124702,"_5":14420,"_27589":124651,"_2954":124703},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3471":73001,"_30355":72977,"_21010":124705,"_5":14420,"_27589":124651,"_2954":124706},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3471":73002,"_30355":72977,"_21010":124708,"_5":14420,"_27589":124651,"_2954":124709},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3471":73003,"_30355":73003,"_5":14772,"_2954":124711,"_30708":124712,"_21010":124714,"_27589":73003},"3.8.0 a 4.0.0",[49453,124713],"Actualizaciones",[],{"_3471":73004,"_30355":73003,"_21010":124716,"_5":14420,"_27589":73003,"_2954":124717},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3471":73005,"_30355":73003,"_5":30705,"_21010":124719,"_27589":124720,"_2954":124721},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3471":73006,"_30355":73003,"_5":30705,"_21010":124723,"_27589":124724,"_2954":124725},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3471":73007,"_30355":73003,"_5":30705,"_21010":124727,"_27589":124728,"_2954":124729},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3471":73008,"_30355":73003,"_5":30705,"_21010":124731,"_27589":124732,"_2954":124733},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3471":73009,"_30355":73003,"_5":30705,"_21010":124735,"_27589":124736,"_2954":124737},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3471":73010,"_30355":73003,"_5":30705,"_21010":124739,"_27589":124740,"_2954":124741},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3471":73011,"_30355":73003,"_5":30705,"_21010":124743,"_27589":124744,"_2954":57681},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3471":73012,"_30355":73003,"_5":30705,"_21010":124746,"_27589":124747,"_2954":124748},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3471":73013,"_30355":73003,"_5":30705,"_21010":124750,"_27589":124751,"_2954":124752},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3471":73014,"_30355":73003,"_5":30705,"_21010":124754,"_27589":124755,"_2954":124756},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3471":73015,"_30355":73003,"_5":30705,"_21010":124758,"_27589":124759,"_2954":124760},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3471":73016,"_30355":73003,"_5":30705,"_21010":124762,"_27589":124763,"_2954":124764},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3471":73017,"_30355":73003,"_5":30705,"_21010":124766,"_27589":124767,"_2954":124768},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3471":73018,"_30355":73003,"_5":30705,"_21010":124770,"_27589":124771,"_2954":124772},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3471":73019,"_30355":73003,"_5":30705,"_21010":124774,"_27589":124775,"_2954":124776},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3471":73020,"_30355":73003,"_5":30705,"_21010":124778,"_27589":124779,"_2954":124780},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3471":73021,"_30355":73003,"_5":30705,"_21010":124782,"_27589":124783,"_2954":124784},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3471":73022,"_30355":73003,"_5":30705,"_21010":124786,"_27589":124787,"_2954":124788},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3471":73023,"_30355":73003,"_5":30705,"_21010":124790,"_27589":124791,"_2954":124792},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3471":73024,"_30355":73003,"_5":30705,"_21010":124794,"_27589":124795,"_2954":124796},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3471":73025,"_30355":73003,"_5":30705,"_21010":124798,"_27589":124799,"_2954":124800},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3471":73026,"_30355":73003,"_5":30705,"_21010":124802,"_27589":124803,"_2954":124804},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3471":73027,"_30355":73003,"_5":30705,"_21010":124806,"_27589":124807,"_2954":124808},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3471":73028,"_30355":73003,"_5":30705,"_21010":124810,"_27589":124811,"_2954":124812},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3471":73029,"_30355":73003,"_5":30705,"_21010":124814,"_27589":124815,"_2954":124816},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3471":73030,"_30355":73003,"_5":30705,"_21010":124818,"_27589":124819,"_2954":124820},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3471":73031,"_30355":73003,"_5":30705,"_21010":124822,"_27589":124823,"_2954":124824},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3471":73032,"_30355":73003,"_5":30705,"_21010":124826,"_27589":124827,"_2954":124828},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3471":73033,"_30355":73003,"_5":30705,"_21010":124830,"_27589":124831,"_2954":124832},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3471":73034,"_30355":73003,"_5":30705,"_21010":124834,"_27589":124835,"_2954":124836},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3471":73035,"_30355":73003,"_5":30705,"_21010":124838,"_27589":124839,"_2954":124840},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3471":73036,"_30355":73003,"_5":30705,"_21010":124842,"_27589":124843,"_2954":124844},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3471":73037,"_30355":73003,"_5":30705,"_21010":124846,"_27589":124847,"_2954":124848},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3471":73038,"_30355":73003,"_5":30705,"_21010":124850,"_27589":124851,"_2954":124852},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3471":73039,"_30355":73003,"_5":30705,"_21010":124854,"_27589":124855,"_2954":124856},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3471":73040,"_30355":73003,"_5":30705,"_21010":124858,"_27589":124859,"_2954":124860},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3471":73041,"_30355":73003,"_5":30705,"_21010":124862,"_27589":124863,"_2954":124864},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3471":73042,"_30355":73003,"_5":30705,"_21010":124866,"_27589":124867,"_2954":124868},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3471":73043,"_30355":73003,"_5":30705,"_21010":124870,"_27589":124871,"_2954":124872},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3471":73044,"_30355":73003,"_5":30705,"_21010":124874,"_27589":124875,"_2954":124876},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3471":73045,"_30355":73003,"_5":30705,"_21010":124878,"_27589":124879,"_2954":120677},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3471":73046,"_30355":73003,"_5":30705,"_21010":124881,"_27589":124882,"_2954":124883},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3471":73047,"_30355":73003,"_5":30705,"_21010":124885,"_27589":124886,"_2954":124887},[],"/docs/pr-preview/pr-62/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3471":73048,"_30355":73003,"_21010":124889,"_5":14420,"_27589":73003,"_2954":124890},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3471":73049,"_30355":73003,"_21010":124892,"_5":14420,"_27589":73003,"_2954":124893},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3471":73050,"_30355":73003,"_21010":124895,"_5":14420,"_27589":73003,"_2954":124896},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3471":73051,"_30355":73003,"_21010":124898,"_5":14420,"_27589":73003,"_2954":124899},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3471":73052,"_30355":73003,"_21010":124901,"_5":14420,"_27589":73003,"_2954":124902},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3471":73053,"_30355":73003,"_21010":124904,"_5":14420,"_27589":73003,"_2954":124905},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3471":73054,"_30355":73003,"_21010":124907,"_5":14420,"_27589":73003,"_2954":124908},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3471":73055,"_30355":73003,"_21010":124910,"_5":14420,"_27589":124724,"_2954":124911},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3471":73056,"_30355":73003,"_21010":124913,"_5":14420,"_27589":124724,"_2954":124914},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3471":73057,"_30355":73003,"_21010":124916,"_5":14420,"_27589":124728,"_2954":124917},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3471":73058,"_30355":73003,"_21010":124919,"_5":14420,"_27589":124728,"_2954":124920},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3471":73059,"_30355":73003,"_21010":124922,"_5":14420,"_27589":124732,"_2954":124923},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3471":73060,"_30355":73003,"_21010":124925,"_5":14420,"_27589":124736,"_2954":124926},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3471":73061,"_30355":73003,"_21010":124928,"_5":14420,"_27589":124736,"_2954":124929},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3471":73062,"_30355":73003,"_21010":124931,"_5":14420,"_27589":124736,"_2954":124932},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3471":73063,"_30355":73003,"_21010":124934,"_5":14420,"_27589":124736,"_2954":124935},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3471":73064,"_30355":73003,"_21010":124937,"_5":14420,"_27589":124736,"_2954":124938},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3471":73065,"_30355":73003,"_21010":124940,"_5":14420,"_27589":124740,"_2954":124941},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3471":73066,"_30355":73003,"_21010":124943,"_5":14420,"_27589":124740,"_2954":124944},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3471":73067,"_30355":73003,"_21010":124946,"_5":14420,"_27589":124740,"_2954":124947},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3471":73068,"_30355":73003,"_21010":124949,"_5":14420,"_27589":124740,"_2954":124950},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3471":73069,"_30355":73003,"_21010":124952,"_5":14420,"_27589":124740,"_2954":124953},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3471":73070,"_30355":73003,"_21010":124955,"_5":14420,"_27589":124740,"_2954":124956},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3471":73071,"_30355":73003,"_21010":124958,"_5":14420,"_27589":124744,"_2954":124959},[],"Cambio",{"_3471":73072,"_30355":73003,"_21010":124961,"_5":14420,"_27589":124744,"_2954":124962},[],"A quién afecta",{"_3471":73073,"_30355":73003,"_21010":124964,"_5":14420,"_27589":124744,"_2954":124965},[],"Gravedad",{"_3471":73074,"_30355":73003,"_21010":124967,"_5":14420,"_27589":124744,"_2954":123444},[],{"_3471":73075,"_30355":73003,"_21010":124969,"_5":14420,"_27589":124744,"_2954":124752},[],{"_3471":73076,"_30355":73003,"_21010":124971,"_5":14420,"_27589":124744,"_2954":124972},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3471":73077,"_30355":73003,"_21010":124974,"_5":14420,"_27589":124744,"_2954":124975},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3471":73078,"_30355":73003,"_21010":124977,"_5":14420,"_27589":124744,"_2954":124978},[],"Copiar los datos a los volúmenes nuevos",{"_3471":73079,"_30355":73003,"_21010":124980,"_5":14420,"_27589":124744,"_2954":124756},[],{"_3471":73080,"_30355":73003,"_21010":124982,"_5":14420,"_27589":124744,"_2954":124983},[],"Todas las releases de Helm",{"_3471":73081,"_30355":73003,"_21010":124985,"_5":14420,"_27589":124744,"_2954":124986},[],"Alta: `helm upgrade` falla",{"_3471":73082,"_30355":73003,"_21010":124988,"_5":14420,"_27589":124744,"_2954":124989},[],"Eliminar o renombrar las claves heredadas",{"_3471":73083,"_30355":73003,"_21010":124991,"_5":14420,"_27589":124744,"_2954":124760},[],{"_3471":73084,"_30355":73003,"_21010":124993,"_5":14420,"_27589":124744,"_2954":124994},[],"Todos los despliegues",{"_3471":73085,"_30355":73003,"_21010":124996,"_5":14420,"_27589":124744,"_2954":124997},[],"Alta: sin principal de bootstrap no hay administrador",{"_3471":73086,"_30355":73003,"_21010":124999,"_5":14420,"_27589":124744,"_2954":125000},[],"Configurar `services.authz`",{"_3471":73087,"_30355":73003,"_21010":125002,"_5":14420,"_27589":124744,"_2954":124764},[],{"_3471":73088,"_30355":73003,"_21010":125004,"_5":14420,"_27589":124744,"_2954":124983},[],{"_3471":73089,"_30355":73003,"_21010":125006,"_5":14420,"_27589":124744,"_2954":125007},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3471":73090,"_30355":73003,"_21010":125009,"_5":14420,"_27589":124744,"_2954":125010},[],"Mover JWKS y roles a `services.authz`",{"_3471":73091,"_30355":73003,"_21010":125012,"_5":14420,"_27589":124744,"_2954":124784},[],{"_3471":73092,"_30355":73003,"_21010":125014,"_5":14420,"_27589":124744,"_2954":125015},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3471":73093,"_30355":73003,"_21010":125017,"_5":14420,"_27589":124744,"_2954":125018},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3471":73094,"_30355":73003,"_21010":125020,"_5":14420,"_27589":124744,"_2954":125021},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3471":73095,"_30355":73003,"_21010":125023,"_5":14420,"_27589":124744,"_2954":124788},[],{"_3471":73096,"_30355":73003,"_21010":125025,"_5":14420,"_27589":124744,"_2954":125026},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3471":73097,"_30355":73003,"_21010":125028,"_5":14420,"_27589":124744,"_2954":125029},[],"Alta: el backend ya no arranca con ellos",{"_3471":73098,"_30355":73003,"_21010":125031,"_5":14420,"_27589":124744,"_2954":125032},[],"Pasar a PostgreSQL antes de actualizar",{"_3471":73099,"_30355":73003,"_21010":125034,"_5":14420,"_27589":124744,"_2954":124832},[],{"_3471":73100,"_30355":73003,"_21010":125036,"_5":14420,"_27589":124744,"_2954":125037},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3471":73101,"_30355":73003,"_21010":125039,"_5":14420,"_27589":124744,"_2954":125040},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3471":73102,"_30355":73003,"_21010":125042,"_5":14420,"_27589":124744,"_2954":125043},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3471":73103,"_30355":73003,"_21010":125045,"_5":14420,"_27589":124744,"_2954":125046},[],"Webhooks con referencias a archivos",{"_3471":73104,"_30355":73003,"_21010":125048,"_5":14420,"_27589":124744,"_2954":125049},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3471":73105,"_30355":73003,"_21010":125051,"_5":14420,"_27589":124744,"_2954":125052},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3471":73106,"_30355":73003,"_21010":125054,"_5":14420,"_27589":124744,"_2954":125055},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3471":73107,"_30355":73003,"_21010":125057,"_5":14420,"_27589":124744,"_2954":124768},[],{"_3471":73108,"_30355":73003,"_21010":125059,"_5":14420,"_27589":124744,"_2954":125060},[],"Releases con identidades por servicio o material de claves montado",{"_3471":73109,"_30355":73003,"_21010":125062,"_5":14420,"_27589":124744,"_2954":125063},[],"Media: los servicios no pueden leer sus archivos",{"_3471":73110,"_30355":73003,"_21010":125065,"_5":14420,"_27589":124744,"_2954":125066},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3471":73111,"_30355":73003,"_21010":125068,"_5":14420,"_27589":124744,"_2954":124772},[],{"_3471":73112,"_30355":73003,"_21010":125070,"_5":14420,"_27589":124744,"_2954":125071},[],"Releases que definen `amqp.tls`",{"_3471":73113,"_30355":73003,"_21010":125073,"_5":14420,"_27589":124744,"_2954":125074},[],"Media: los clientes se conectan al puerto equivocado",{"_3471":73114,"_30355":73003,"_21010":125076,"_5":14420,"_27589":124744,"_2954":125077},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3471":73115,"_30355":73003,"_21010":125079,"_5":14420,"_27589":124744,"_2954":124792},[],{"_3471":73116,"_30355":73003,"_21010":125081,"_5":14420,"_27589":124744,"_2954":125082},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3471":73117,"_30355":73003,"_21010":125084,"_5":14420,"_27589":124744,"_2954":125085},[],"Media: las claves de CA quedan sin gestionar",{"_3471":73118,"_30355":73003,"_21010":125087,"_5":14420,"_27589":124744,"_2954":125088},[],"Ejecutar la migración de CA a KMS",{"_3471":73119,"_30355":73003,"_21010":125090,"_5":14420,"_27589":124744,"_2954":125091},[],"Verificación del certificado del receptor",{"_3471":73120,"_30355":73003,"_21010":125093,"_5":14420,"_27589":124744,"_2954":125094},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3471":73121,"_30355":73003,"_21010":125096,"_5":14420,"_27589":124744,"_2954":125097},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3471":73122,"_30355":73003,"_21010":125099,"_5":14420,"_27589":124744,"_2954":125100},[],"Poner `insecure_skip_verify` a `false`",{"_3471":73123,"_30355":73003,"_21010":125102,"_5":14420,"_27589":124744,"_2954":124808},[],{"_3471":73124,"_30355":73003,"_21010":125104,"_5":14420,"_27589":124744,"_2954":125105},[],"Scripts y consolas que editan DMS por API",{"_3471":73125,"_30355":73003,"_21010":125107,"_5":14420,"_27589":124744,"_2954":125108},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3471":73126,"_30355":73003,"_21010":125110,"_5":14420,"_27589":124744,"_2954":125111},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3471":73127,"_30355":73003,"_21010":125113,"_5":14420,"_27589":124744,"_2954":124828},[],{"_3471":73128,"_30355":73003,"_21010":125115,"_5":14420,"_27589":124744,"_2954":125116},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3471":73129,"_30355":73003,"_21010":125118,"_5":14420,"_27589":124744,"_2954":125119},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3471":73130,"_30355":73003,"_21010":125121,"_5":14420,"_27589":124744,"_2954":125122},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3471":73131,"_30355":73003,"_21010":125124,"_5":14420,"_27589":124744,"_2954":124836},[],{"_3471":73132,"_30355":73003,"_21010":125126,"_5":14420,"_27589":124744,"_2954":125127},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3471":73133,"_30355":73003,"_21010":125129,"_5":14420,"_27589":124744,"_2954":125130},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3471":73134,"_30355":73003,"_21010":125132,"_5":14420,"_27589":124744,"_2954":125133},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3471":73135,"_30355":73003,"_21010":125135,"_5":14420,"_27589":124744,"_2954":124824},[],{"_3471":73136,"_30355":73003,"_21010":125137,"_5":14420,"_27589":124744,"_2954":125138},[],"Consumidores que leen el campo `events` del dispositivo",{"_3471":73137,"_30355":73003,"_21010":125140,"_5":14420,"_27589":124744,"_2954":125141},[],"Media: el campo desaparece",{"_3471":73138,"_30355":73003,"_21010":125143,"_5":14420,"_27589":124744,"_2954":125144},[],"Usar los nuevos endpoints de eventos",{"_3471":73139,"_30355":73003,"_21010":125146,"_5":14420,"_27589":124744,"_2954":124844},[],{"_3471":73140,"_30355":73003,"_21010":125148,"_5":14420,"_27589":124744,"_2954":125149},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3471":73141,"_30355":73003,"_21010":125151,"_5":14420,"_27589":124744,"_2954":125152},[],"Media: la migración de la VA aborta",{"_3471":73142,"_30355":73003,"_21010":125154,"_5":14420,"_27589":124744,"_2954":125155},[],"Corregir los roles afectados antes de actualizar",{"_3471":73143,"_30355":73003,"_21010":125157,"_5":14420,"_27589":124744,"_2954":124776},[],{"_3471":73144,"_30355":73003,"_21010":125159,"_5":14420,"_27589":124744,"_2954":125160},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3471":73145,"_30355":73003,"_21010":125162,"_5":14420,"_27589":124744,"_2954":125163},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3471":73146,"_30355":73003,"_21010":125165,"_5":14420,"_27589":124744,"_2954":125166},[],"Actualizar el archivo de values",{"_3471":73147,"_30355":73003,"_21010":125168,"_5":14420,"_27589":124744,"_2954":124816},[],{"_3471":73148,"_30355":73003,"_21010":125170,"_5":14420,"_27589":124744,"_2954":125171},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3471":73149,"_30355":73003,"_21010":125173,"_5":14420,"_27589":124744,"_2954":125174},[],"Baja: prevalece el ID de la URL",{"_3471":73150,"_30355":73003,"_21010":125176,"_5":14420,"_27589":124744,"_2954":125177},[],"Enviar el ID en la URL",{"_3471":73151,"_30355":73003,"_21010":125179,"_5":14420,"_27589":124744,"_2954":124840},[],{"_3471":73152,"_30355":73003,"_21010":125181,"_5":14420,"_27589":124744,"_2954":125182},[],"Clientes que envían un `id` al crear o importar CAs",{"_3471":73153,"_30355":73003,"_21010":125184,"_5":14420,"_27589":124744,"_2954":125185},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3471":73154,"_30355":73003,"_21010":125187,"_5":14420,"_27589":124744,"_2954":125188},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3471":73155,"_30355":73003,"_21010":125190,"_5":14420,"_27589":124744,"_2954":124820},[],{"_3471":73156,"_30355":73003,"_21010":125192,"_5":14420,"_27589":124744,"_2954":125193},[],"Consumidores que comparan el `type` del certificado",{"_3471":73157,"_30355":73003,"_21010":125195,"_5":14420,"_27589":124744,"_2954":125196},[],"Baja: dos valores cambian de nombre",{"_3471":73158,"_30355":73003,"_21010":125198,"_5":14420,"_27589":124744,"_2954":125199},[],"Adaptar los consumidores",{"_3471":73159,"_30355":73003,"_21010":125201,"_5":14420,"_27589":124744,"_2954":124812},[],{"_3471":73160,"_30355":73003,"_21010":125203,"_5":14420,"_27589":124744,"_2954":125204},[],"Cualquier DMS",{"_3471":73161,"_30355":73003,"_21010":125206,"_5":14420,"_27589":124744,"_2954":125207},[],"Baja: solo informativo",{"_3471":73162,"_30355":73003,"_21010":125209,"_5":14420,"_27589":124744,"_2954":125210},[],"Revisar ambos bloques antes de editar",{"_3471":73163,"_30355":73003,"_21010":125212,"_5":14420,"_27589":124751,"_2954":125213},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3471":73164,"_30355":73003,"_21010":125215,"_5":14420,"_27589":124751,"_2954":125216},[],"El paso 4 de la guía de migración copia los datos.",{"_3471":73165,"_30355":73003,"_21010":125218,"_5":14420,"_27589":124755,"_2954":125219},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3471":73166,"_30355":73003,"_21010":125221,"_5":14420,"_27589":124759,"_2954":125222},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3471":73167,"_30355":73003,"_21010":125224,"_5":14420,"_27589":124763,"_2954":125225},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3471":73168,"_30355":73003,"_21010":125227,"_5":14420,"_27589":124767,"_2954":125228},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3471":73169,"_30355":73003,"_21010":125230,"_5":14420,"_27589":124767,"_2954":125231},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3471":73170,"_30355":73003,"_21010":125233,"_5":14420,"_27589":124771,"_2954":125234},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3471":73171,"_30355":73003,"_21010":125236,"_5":14420,"_27589":124775,"_2954":125237},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3471":73172,"_30355":73003,"_21010":125239,"_5":14420,"_27589":124775,"_2954":125240},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3471":73173,"_30355":73003,"_21010":125242,"_5":14420,"_27589":124775,"_2954":125243},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3471":73174,"_30355":73003,"_21010":125245,"_5":14420,"_27589":124775,"_2954":125246},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3471":73175,"_30355":73003,"_21010":125248,"_5":14420,"_27589":124775,"_2954":125249},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3471":73176,"_30355":73003,"_21010":125251,"_5":14420,"_27589":124775,"_2954":125252},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3471":73177,"_30355":73003,"_21010":125254,"_5":14420,"_27589":124783,"_2954":125255},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3471":73178,"_30355":73003,"_21010":125257,"_5":14420,"_27589":124783,"_2954":125258},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3471":73179,"_30355":73003,"_21010":125260,"_5":14420,"_27589":124783,"_2954":125261},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3471":73180,"_30355":73003,"_21010":125263,"_5":14420,"_27589":124783,"_2954":125264},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3471":73181,"_30355":73003,"_21010":125266,"_5":14420,"_27589":124783,"_2954":125267},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3471":73182,"_30355":73003,"_21010":125269,"_5":14420,"_27589":124787,"_2954":125270},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3471":73183,"_30355":73003,"_21010":125272,"_5":14420,"_27589":124791,"_2954":125273},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3471":73184,"_30355":73003,"_21010":125275,"_5":14420,"_27589":124791,"_2954":125276},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3471":73185,"_30355":73003,"_21010":125278,"_5":14420,"_27589":124791,"_2954":125279},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3471":73186,"_30355":73003,"_21010":125281,"_5":14420,"_27589":124791,"_2954":125282},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3471":73187,"_30355":73003,"_21010":125284,"_5":14420,"_27589":124791,"_2954":125285},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3471":73188,"_30355":73003,"_21010":125287,"_5":14420,"_27589":124791,"_2954":125288},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3471":73189,"_30355":73003,"_21010":125290,"_5":14420,"_27589":124791,"_2954":125291},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3471":73190,"_30355":73003,"_21010":125293,"_5":14420,"_27589":124791,"_2954":125294},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3471":73191,"_30355":73003,"_21010":125296,"_5":14420,"_27589":124795,"_2954":125297},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3471":73192,"_30355":73003,"_21010":125299,"_5":14420,"_27589":124803,"_2954":125300},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3471":73193,"_30355":73003,"_21010":125302,"_5":14420,"_27589":124803,"_2954":125303},[],"Campo en 3.8.0",{"_3471":73194,"_30355":73003,"_21010":125305,"_5":14420,"_27589":124803,"_2954":125306},[],"Campo en 4.0.0",{"_3471":73195,"_30355":73003,"_21010":125308,"_5":14420,"_27589":124803,"_2954":58246},[],{"_3471":73196,"_30355":73003,"_21010":125310,"_5":14420,"_27589":124803,"_2954":125311},[],"`insecure_skip_verify` (con el valor negado)",{"_3471":73197,"_30355":73003,"_21010":125313,"_5":14420,"_27589":124803,"_2954":58252},[],{"_3471":73198,"_30355":73003,"_21010":125315,"_5":14420,"_27589":124803,"_2954":58255},[],{"_3471":73199,"_30355":73003,"_21010":125317,"_5":14420,"_27589":124803,"_2954":58258},[],{"_3471":73200,"_30355":73003,"_21010":125319,"_5":14420,"_27589":124803,"_2954":58261},[],{"_3471":73201,"_30355":73003,"_21010":125321,"_5":14420,"_27589":124803,"_2954":58264},[],{"_3471":73202,"_30355":73003,"_21010":125323,"_5":14420,"_27589":124803,"_2954":58267},[],{"_3471":73203,"_30355":73003,"_21010":125325,"_5":14420,"_27589":124803,"_2954":125326},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3471":73204,"_30355":73003,"_21010":125328,"_5":14420,"_27589":124803,"_2954":125329},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3471":73205,"_30355":73003,"_21010":125331,"_5":14420,"_27589":124803,"_2954":125332},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3471":73206,"_30355":73003,"_21010":125334,"_5":14420,"_27589":124807,"_2954":125335},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3471":73207,"_30355":73003,"_21010":125337,"_5":14420,"_27589":124807,"_2954":125338},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3471":73208,"_30355":73003,"_21010":125340,"_5":14420,"_27589":124807,"_2954":125341},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3471":73209,"_30355":73003,"_21010":125343,"_5":14420,"_27589":124811,"_2954":125344},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3471":73210,"_30355":73003,"_21010":125346,"_5":14420,"_27589":124815,"_2954":125347},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3471":73211,"_30355":73003,"_21010":125349,"_5":14420,"_27589":124819,"_2954":125350},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3471":73212,"_30355":73003,"_21010":125352,"_5":14420,"_27589":124823,"_2954":125353},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3471":73213,"_30355":73003,"_21010":125355,"_5":14420,"_27589":124823,"_2954":125356},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3471":73214,"_30355":73003,"_21010":125358,"_5":14420,"_27589":124823,"_2954":125359},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3471":73215,"_30355":73003,"_21010":125361,"_5":14420,"_27589":124823,"_2954":125362},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3471":73216,"_30355":73003,"_21010":125364,"_5":14420,"_27589":124827,"_2954":125365},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3471":73217,"_30355":73003,"_21010":125367,"_5":14420,"_27589":124831,"_2954":125368},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3471":73218,"_30355":73003,"_21010":125370,"_5":14420,"_27589":124831,"_2954":125371},[],"Ruta",{"_3471":73219,"_30355":73003,"_21010":125373,"_5":14420,"_27589":124831,"_2954":117916},[],{"_3471":73220,"_30355":73003,"_21010":125375,"_5":14420,"_27589":124831,"_2954":58320},[],{"_3471":73221,"_30355":73003,"_21010":125377,"_5":14420,"_27589":124831,"_2954":125378},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3471":73222,"_30355":73003,"_21010":125380,"_5":14420,"_27589":124831,"_2954":58326},[],{"_3471":73223,"_30355":73003,"_21010":125382,"_5":14420,"_27589":124831,"_2954":125383},[],"Lee los ajustes de una CA.",{"_3471":73224,"_30355":73003,"_21010":125385,"_5":14420,"_27589":124831,"_2954":58332},[],{"_3471":73225,"_30355":73003,"_21010":125387,"_5":14420,"_27589":124831,"_2954":125388},[],"Sustituye los `crl_options`.",{"_3471":73226,"_30355":73003,"_21010":125390,"_5":14420,"_27589":124831,"_2954":125391},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3471":73227,"_30355":73003,"_21010":125393,"_5":14420,"_27589":124831,"_2954":125394},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3471":73228,"_30355":73003,"_21010":125396,"_5":14420,"_27589":124831,"_2954":125397},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3471":73229,"_30355":73003,"_21010":125399,"_5":14420,"_27589":124831,"_2954":125400},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3471":73230,"_30355":73003,"_21010":125402,"_5":14420,"_27589":124831,"_2954":125403},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3471":73231,"_30355":73003,"_21010":125405,"_5":14420,"_27589":124831,"_2954":125406},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3471":73232,"_30355":73003,"_21010":125408,"_5":14420,"_27589":124831,"_2954":125409},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3471":73233,"_30355":73003,"_21010":125411,"_5":14420,"_27589":124831,"_2954":125412},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3471":73234,"_30355":73003,"_21010":125414,"_5":14420,"_27589":124831,"_2954":125415},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3471":73235,"_30355":73003,"_21010":125417,"_5":14420,"_27589":124831,"_2954":125418},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3471":73236,"_30355":73003,"_21010":125420,"_5":14420,"_27589":124831,"_2954":125421},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3471":73237,"_30355":73003,"_21010":125423,"_5":14420,"_27589":124835,"_2954":125424},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3471":73238,"_30355":73003,"_21010":125426,"_5":14420,"_27589":124839,"_2954":125427},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3471":73239,"_30355":73003,"_21010":125429,"_5":14420,"_27589":124843,"_2954":125430},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3471":73240,"_30355":73003,"_21010":125432,"_5":14420,"_27589":124847,"_2954":125433},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3471":73241,"_30355":73003,"_21010":125435,"_5":14420,"_27589":124851,"_2954":125436},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3471":73242,"_30355":73003,"_21010":125438,"_5":14420,"_27589":124851,"_2954":125439},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3471":73243,"_30355":73003,"_21010":125441,"_5":14420,"_27589":124851,"_2954":125442},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3471":73244,"_30355":73003,"_21010":125444,"_5":14420,"_27589":124851,"_2954":125445},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3471":73245,"_30355":73003,"_21010":125447,"_5":14420,"_27589":124851,"_2954":125448},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3471":73246,"_30355":73003,"_21010":125450,"_5":14420,"_27589":124851,"_2954":125451},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3471":73247,"_30355":73003,"_21010":125453,"_5":14420,"_27589":124855,"_2954":125454},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3471":73248,"_30355":73003,"_21010":125456,"_5":14420,"_27589":124855,"_2954":125457},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3471":73249,"_30355":73003,"_21010":125459,"_5":14420,"_27589":124855,"_2954":125460},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3471":73250,"_30355":73003,"_21010":125462,"_5":14420,"_27589":124855,"_2954":125463},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3471":73251,"_30355":73003,"_21010":125465,"_5":14420,"_27589":124855,"_2954":125466},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3471":73252,"_30355":73003,"_21010":125468,"_5":14420,"_27589":124859,"_2954":125469},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3471":73253,"_30355":73003,"_21010":125471,"_5":14420,"_27589":124859,"_2954":125472},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3471":73254,"_30355":73003,"_21010":125474,"_5":14420,"_27589":124859,"_2954":125475},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3471":73255,"_30355":73003,"_21010":125477,"_5":14420,"_27589":124859,"_2954":125478},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3471":73256,"_30355":73003,"_21010":125480,"_5":14420,"_27589":124859,"_2954":125481},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3471":73257,"_30355":73003,"_21010":125483,"_5":14420,"_27589":124859,"_2954":125484},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3471":73258,"_30355":73003,"_21010":125486,"_5":14420,"_27589":124859,"_2954":125487},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3471":73259,"_30355":73003,"_21010":125489,"_5":14420,"_27589":124859,"_2954":125490},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3471":73260,"_30355":73003,"_21010":125492,"_5":14420,"_27589":124859,"_2954":125493},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3471":73261,"_30355":73003,"_21010":125495,"_5":14420,"_27589":124859,"_2954":125496},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3471":73262,"_30355":73003,"_21010":125498,"_5":14420,"_27589":124859,"_2954":125499},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3471":73263,"_30355":73003,"_21010":125501,"_5":14420,"_27589":124859,"_2954":125502},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3471":73264,"_30355":73003,"_21010":125504,"_5":14420,"_27589":124863,"_2954":125505},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3471":73265,"_30355":73003,"_21010":125507,"_5":14420,"_27589":124863,"_2954":125508},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3471":73266,"_30355":73003,"_21010":125510,"_5":14420,"_27589":124867,"_2954":125511},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3471":73267,"_30355":73003,"_21010":125513,"_5":14420,"_27589":124867,"_2954":125514},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3471":73268,"_30355":73003,"_21010":125516,"_5":14420,"_27589":124867,"_2954":125517},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3471":73269,"_30355":73003,"_21010":125519,"_5":14420,"_27589":124867,"_2954":125520},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3471":73270,"_30355":73003,"_21010":125522,"_5":14420,"_27589":124867,"_2954":125523},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3471":73271,"_30355":73003,"_21010":125525,"_5":14420,"_27589":124867,"_2954":125526},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3471":73272,"_30355":73003,"_21010":125528,"_5":14420,"_27589":124867,"_2954":125529},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3471":73273,"_30355":73003,"_21010":125531,"_5":14420,"_27589":124867,"_2954":125532},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3471":73274,"_30355":73003,"_21010":125534,"_5":14420,"_27589":124867,"_2954":125535},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3471":73275,"_30355":73003,"_21010":125537,"_5":14420,"_27589":124867,"_2954":125538},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3471":73276,"_30355":73003,"_21010":125540,"_5":14420,"_27589":124867,"_2954":125541},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3471":73277,"_30355":73003,"_21010":125543,"_5":14420,"_27589":124871,"_2954":125544},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3471":73278,"_30355":73003,"_21010":125546,"_5":14420,"_27589":124871,"_2954":125547},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3471":73279,"_30355":73003,"_21010":125549,"_5":14420,"_27589":124875,"_2954":125550},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3471":73280,"_30355":73003,"_21010":125552,"_5":14420,"_27589":124875,"_2954":125553},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3471":73281,"_30355":73003,"_21010":125555,"_5":14420,"_27589":124875,"_2954":125556},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3471":73282,"_30355":73003,"_21010":125558,"_5":14420,"_27589":124875,"_2954":125559},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3471":73283,"_30355":73003,"_21010":125561,"_5":14420,"_27589":124875,"_2954":125562},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3471":73284,"_30355":73003,"_21010":125564,"_5":14420,"_27589":124875,"_2954":125565},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3471":73285,"_30355":73003,"_21010":125567,"_5":14420,"_27589":124875,"_2954":125568},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3471":73286,"_30355":73003,"_21010":125570,"_5":14420,"_27589":124875,"_2954":125571},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3471":73287,"_30355":73003,"_21010":125573,"_5":14420,"_27589":124879,"_2954":125574},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3471":73288,"_30355":73003,"_21010":125576,"_5":14420,"_27589":124879,"_2954":125577},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3471":73289,"_30355":73003,"_21010":125579,"_5":14420,"_27589":124879,"_2954":125580},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3471":73290,"_30355":73003,"_21010":125582,"_5":14420,"_27589":124879,"_2954":125583},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3471":73291,"_30355":73003,"_21010":125585,"_5":14420,"_27589":124879,"_2954":125586},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3471":73292,"_30355":73003,"_21010":125588,"_5":14420,"_27589":124879,"_2954":125589},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3471":73293,"_30355":73003,"_21010":125591,"_5":14420,"_27589":124879,"_2954":125592},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3471":73294,"_30355":73003,"_21010":125594,"_5":14420,"_27589":124879,"_2954":125595},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3471":73295,"_30355":73003,"_21010":125597,"_5":14420,"_27589":124879,"_2954":125598},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3471":73296,"_30355":73003,"_21010":125600,"_5":14420,"_27589":124879,"_2954":125601},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3471":73297,"_30355":73003,"_21010":125603,"_5":14420,"_27589":124879,"_2954":125604},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3471":73298,"_30355":73003,"_21010":125606,"_5":14420,"_27589":124882,"_2954":125607},[],"Tras la actualización, comprueba en este orden:",{"_3471":73299,"_30355":73003,"_21010":125609,"_5":14420,"_27589":124882,"_2954":125610},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3471":73300,"_30355":73003,"_21010":125612,"_5":14420,"_27589":124882,"_2954":125613},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3471":73301,"_30355":73003,"_21010":125615,"_5":14420,"_27589":124882,"_2954":125616},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3471":73302,"_30355":73003,"_21010":125618,"_5":14420,"_27589":124882,"_2954":125619},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3471":73303,"_30355":73003,"_21010":125621,"_5":14420,"_27589":124882,"_2954":125622},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3471":73304,"_30355":73003,"_21010":125624,"_5":14420,"_27589":124882,"_2954":125625},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3471":73305,"_30355":73003,"_21010":125627,"_5":14420,"_27589":124882,"_2954":125628},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3471":73306,"_30355":73003,"_21010":125630,"_5":14420,"_27589":124882,"_2954":125631},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3471":73307,"_30355":73003,"_21010":125633,"_5":14420,"_27589":124882,"_2954":125634},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3471":73308,"_30355":73003,"_21010":125636,"_5":14420,"_27589":124882,"_2954":125637},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3471":73309,"_30355":73003,"_21010":125639,"_5":14420,"_27589":124882,"_2954":125640},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3471":73310,"_30355":73003,"_21010":125642,"_5":14420,"_27589":124882,"_2954":125643},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3471":73311,"_30355":73003,"_21010":125645,"_5":14420,"_27589":124882,"_2954":125646},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3471":73312,"_30355":73003,"_21010":125648,"_5":14420,"_27589":124882,"_2954":125649},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3471":73313,"_30355":73003,"_21010":125651,"_5":14420,"_27589":124882,"_2954":125652},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3471":73314,"_30355":73003,"_21010":125654,"_5":14420,"_27589":124886,"_2954":125655},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3471":73315,"_30355":73003,"_21010":125657,"_5":14420,"_27589":124886,"_2954":125658},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3471":73316,"_30355":73003,"_21010":125660,"_5":14420,"_27589":124886,"_2954":125661},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3471":73317,"_30355":73003,"_21010":125663,"_5":14420,"_27589":124886,"_2954":125664},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3471":73318,"_30355":73003,"_21010":125666,"_5":14420,"_27589":124886,"_2954":125667},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58617":125669,"_58619":125670,"_58621":125671,"_58623":125672,"_18204":2989,"_70378":2989},"spanish",[2954,30355,5,27589],{"_2954":25132,"_30355":25132,"_5":25132,"_27589":25132},{"_2954":125673,"_30355":128610,"_5":131547,"_27589":134484},{"_4653":125674,"_58627":125675,"_5":25132},{"_14496":10500,"_14883":4620,"_14902":7236,"_29358":3658,"_14889":5964,"_19930":8689,"_14517":6259,"_14524":24684,"_29300":20426,"_29709":3776,"_29730":7027,"_29334":7064,"_34708":12310,"_29437":20421,"_29774":9901,"_34715":22923,"_34718":4601,"_34721":3391,"_34724":14125,"_30181":3460,"_34729":16857,"_34731":7610,"_30211":15848,"_14898":8889,"_34735":7536,"_34738":6616,"_34740":11239,"_29758":3372,"_30176":4226,"_30224":5858,"_34745":6527,"_34747":7641,"_34749":3955,"_29454":6407,"_34752":6004,"_34754":4322,"_34756":7862,"_34758":7173,"_34760":7631,"_29371":4782,"_34763":4014,"_34765":5843,"_29365":8845,"_29795":5644,"_34769":16343,"_34771":11123,"_34774":5267,"_29411":6981,"_34778":4975,"_29291":9959,"_34781":7522,"_29339":7676,"_34784":11801,"_34786":11331,"_34789":5323,"_14892":23954,"_34792":5968,"_34794":4396,"_34797":4658,"_34799":22002,"_34801":22881,"_30414":7703,"_34804":4965,"_19933":3438,"_34807":10171,"_34809":4600,"_29312":7032,"_29752":4744,