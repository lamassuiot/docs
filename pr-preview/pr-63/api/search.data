5":124946,"_40228":124949,"_40230":124952,"_40232":124955,"_40234":124958,"_40236":124961,"_40238":124964,"_40240":124967,"_40242":124970,"_40244":124973,"_40246":124976,"_40249":124979,"_40251":124982,"_40253":124985,"_40255":124988,"_40257":124991,"_40259":124994,"_40261":124997,"_40263":125000,"_40265":125003,"_40267":125006,"_40269":125009,"_40271":125012,"_40273":125015,"_40275":125018,"_40277":125021,"_40279":125024,"_40281":125027,"_40283":125030,"_40285":125033,"_40287":125036,"_40289":125039,"_40291":125042,"_40293":125045,"_40295":125048,"_40297":125051,"_40299":125054,"_40301":125057,"_40303":125060,"_40305":125063,"_40307":125066,"_40309":125069,"_40312":125072,"_40314":125075,"_40316":125078,"_40318":125081,"_40320":125084,"_40322":125087,"_40324":125090,"_40326":125093,"_40328":125096,"_40330":125099,"_40332":125102,"_40334":125105,"_40336":125108,"_40338":125111,"_40340":125114,"_40342":125117,"_40344":125120,"_40346":125123,"_40348":125126,"_40350":125129,"_40353":125132,"_40355":125135,"_40357":125138,"_40359":125141,"_40361":125144,"_40363":125147,"_40365":125150,"_40367":125153,"_40369":125156,"_40371":125159,"_40373":125162,"_40375":125165,"_40377":125168,"_40379":125171,"_40381":125174,"_40383":125177,"_40385":125180,"_40387":125183,"_40389":125186,"_40391":125189,"_40393":125192,"_40395":125195,"_40397":125198,"_40399":125201,"_40401":125204,"_40403":125207,"_40406":125210,"_40408":125213,"_40410":125216},{"_3464":70166,"_30209":70166,"_5":14725,"_2948":116285,"_30562":116286,"_20922":116289,"_27447":70166},"Despliega desde AWS Marketplace",[49276,116287,116288],"Despliegue","Otros modelos",[],{"_3464":70167,"_30209":70166,"_20922":116291,"_5":14373,"_27447":70166,"_2948":116292},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3464":70168,"_30209":70166,"_5":30559,"_20922":116294,"_27447":116295,"_2948":116296},[],"/docs/pr-preview/pr-63/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3464":70169,"_30209":70166,"_5":30559,"_20922":116298,"_27447":116299,"_2948":116300},[],"/docs/pr-preview/pr-63/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3464":70170,"_30209":70166,"_5":30559,"_20922":116302,"_27447":116303,"_2948":116304},[],"/docs/pr-preview/pr-63/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3464":70171,"_30209":70166,"_5":30559,"_20922":116306,"_27447":116307,"_2948":116308},[],"/docs/pr-preview/pr-63/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3464":70172,"_30209":70166,"_5":30559,"_20922":116310,"_27447":116311,"_2948":116312},[],"/docs/pr-preview/pr-63/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3464":70173,"_30209":70166,"_5":30559,"_20922":116314,"_27447":116315,"_2948":116316},[],"/docs/pr-preview/pr-63/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3464":70174,"_30209":70166,"_5":30559,"_20922":116318,"_27447":116319,"_2948":116320},[],"/docs/pr-preview/pr-63/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3464":70175,"_30209":70166,"_20922":116322,"_5":14373,"_27447":70166,"_2948":116323},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3464":70176,"_30209":70166,"_20922":116325,"_5":14373,"_27447":116295,"_2948":116326},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3464":70177,"_30209":70166,"_20922":116328,"_5":14373,"_27447":116295,"_2948":116329},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3464":70178,"_30209":70166,"_20922":116331,"_5":14373,"_27447":116295,"_2948":116332},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3464":70179,"_30209":70166,"_20922":116334,"_5":14373,"_27447":116299,"_2948":116335},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3464":70180,"_30209":70166,"_20922":116337,"_5":14373,"_27447":116299,"_2948":116338},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3464":70181,"_30209":70166,"_20922":116340,"_5":14373,"_27447":116299,"_2948":116341},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3464":70182,"_30209":70166,"_20922":116343,"_5":14373,"_27447":116303,"_2948":116344},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3464":70183,"_30209":70166,"_20922":116346,"_5":14373,"_27447":116307,"_2948":116347},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3464":70184,"_30209":70166,"_20922":116349,"_5":14373,"_27447":116311,"_2948":116350},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3464":70185,"_30209":70166,"_20922":116352,"_5":14373,"_27447":116315,"_2948":116353},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3464":70186,"_30209":70166,"_20922":116355,"_5":14373,"_27447":116319,"_2948":116356},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3464":70187,"_30209":70187,"_5":14725,"_2948":116358,"_30562":116359,"_20922":116360,"_27447":70187},"Despliega Lamassu",[49276,116287],[],{"_3464":70188,"_30209":70187,"_20922":116362,"_5":14373,"_27447":70187,"_2948":116363},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3464":70189,"_30209":70187,"_5":30559,"_20922":116365,"_27447":116366,"_2948":116367},[],"/docs/pr-preview/pr-63/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3464":70190,"_30209":70187,"_5":30559,"_20922":116369,"_27447":116370,"_2948":116371},[],"/docs/pr-preview/pr-63/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3464":70191,"_30209":70187,"_5":30559,"_20922":116373,"_27447":116374,"_2948":116375},[],"/docs/pr-preview/pr-63/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3464":70192,"_30209":70187,"_20922":116377,"_5":14373,"_27447":70187,"_2948":116378},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3464":70193,"_30209":70187,"_20922":116380,"_5":14373,"_27447":116366,"_2948":116381},[],"Modelo",{"_3464":70194,"_30209":70187,"_20922":116383,"_5":14373,"_27447":116366,"_2948":116384},[],"Recomendado para",{"_3464":70195,"_30209":70187,"_20922":116386,"_5":14373,"_27447":116366,"_2948":116387},[],"Quién opera la infraestructura",{"_3464":70196,"_30209":70187,"_20922":116389,"_5":14373,"_27447":116366,"_2948":116390},[],"Punto de partida",{"_3464":70197,"_30209":70187,"_20922":116392,"_5":14373,"_27447":116366,"_2948":49383},[],{"_3464":70198,"_30209":70187,"_20922":116394,"_5":14373,"_27447":116366,"_2948":116395},[],"Producción, entornos regulados y despliegues personalizados",{"_3464":70199,"_30209":70187,"_20922":116397,"_5":14373,"_27447":116366,"_2948":116398},[],"Tu equipo",{"_3464":70200,"_30209":70187,"_20922":116400,"_5":14373,"_27447":116366,"_2948":116401},[],"Helm o Fastlane",{"_3464":70201,"_30209":70187,"_20922":116403,"_5":14373,"_27447":116366,"_2948":49395},[],{"_3464":70202,"_30209":70187,"_20922":116405,"_5":14373,"_27447":116366,"_2948":116406},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3464":70203,"_30209":70187,"_20922":116408,"_5":14373,"_27447":116366,"_2948":116398},[],{"_3464":70204,"_30209":70187,"_20922":116410,"_5":14373,"_27447":116366,"_2948":116411},[],"Imagen preconfigurada en EC2",{"_3464":70205,"_30209":70187,"_20922":116413,"_5":14373,"_27447":116366,"_2948":49406},[],{"_3464":70206,"_30209":70187,"_20922":116415,"_5":14373,"_27447":116366,"_2948":116416},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3464":70207,"_30209":70187,"_20922":116418,"_5":14373,"_27447":116366,"_2948":49412},[],{"_3464":70208,"_30209":70187,"_20922":116420,"_5":14373,"_27447":116366,"_2948":116421},[],"Suscripción gestionada",{"_3464":70209,"_30209":70187,"_20922":116423,"_5":14373,"_27447":116366,"_2948":116424},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3464":70210,"_30209":70187,"_20922":116426,"_5":14373,"_27447":116366,"_2948":116427},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3464":70211,"_30209":70187,"_20922":116429,"_5":14373,"_27447":116366,"_2948":116430},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3464":70212,"_30209":70187,"_20922":116432,"_5":14373,"_27447":116370,"_2948":116433},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3464":70213,"_30209":70187,"_20922":116435,"_5":14373,"_27447":116374,"_2948":116436},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3464":70214,"_30209":70214,"_5":14725,"_2948":116438,"_30562":116439,"_20922":116440,"_27447":70214},"Utiliza Lamassu como SaaS",[49276,116287,116288],[],{"_3464":70215,"_30209":70214,"_20922":116442,"_5":14373,"_27447":70214,"_2948":116443},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3464":70216,"_30209":70214,"_5":30559,"_20922":116445,"_27447":116446,"_2948":116447},[],"/docs/pr-preview/pr-63/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3464":70217,"_30209":70214,"_5":30559,"_20922":116449,"_27447":116450,"_2948":116451},[],"/docs/pr-preview/pr-63/es/deployment/saas#planes","Planes",{"_3464":70218,"_30209":70214,"_5":30559,"_20922":116453,"_27447":116454,"_2948":116455},[],"/docs/pr-preview/pr-63/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3464":70219,"_30209":70214,"_20922":116457,"_5":14373,"_27447":70214,"_2948":116458},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3464":70220,"_30209":70214,"_20922":116460,"_5":14373,"_27447":116446,"_2948":116461},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3464":70221,"_30209":70214,"_20922":116463,"_5":14373,"_27447":116446,"_2948":116464},[],"Copias de seguridad automáticas.",{"_3464":70222,"_30209":70214,"_20922":116466,"_5":14373,"_27447":116446,"_2948":116467},[],"Actualizaciones de versión.",{"_3464":70223,"_30209":70214,"_20922":116469,"_5":14373,"_27447":116446,"_2948":116470},[],"Soporte técnico y SLA según el plan contratado.",{"_3464":70224,"_30209":70214,"_20922":116472,"_5":14373,"_27447":116450,"_2948":49467},[],{"_3464":70225,"_30209":70214,"_20922":116474,"_5":14373,"_27447":116450,"_2948":116475},[],"Dispositivos",{"_3464":70226,"_30209":70214,"_20922":116477,"_5":14373,"_27447":116450,"_2948":116478},[],"Soporte",{"_3464":70227,"_30209":70214,"_20922":116480,"_5":14373,"_27447":116450,"_2948":49476},[],{"_3464":70228,"_30209":70214,"_20922":116482,"_5":14373,"_27447":116450,"_2948":49479},[],{"_3464":70229,"_30209":70214,"_20922":116484,"_5":14373,"_27447":116450,"_2948":116485},[],"Hasta 1.000",{"_3464":70230,"_30209":70214,"_20922":116487,"_5":14373,"_27447":116450,"_2948":49485},[],{"_3464":70231,"_30209":70214,"_20922":116489,"_5":14373,"_27447":116450,"_2948":116490},[],"99,5 %",{"_3464":70232,"_30209":70214,"_20922":116492,"_5":14373,"_27447":116450,"_2948":49491},[],{"_3464":70233,"_30209":70214,"_20922":116494,"_5":14373,"_27447":116450,"_2948":116495},[],"Hasta 10.000",{"_3464":70234,"_30209":70214,"_20922":116497,"_5":14373,"_27447":116450,"_2948":116498},[],"Email y chat",{"_3464":70235,"_30209":70214,"_20922":116500,"_5":14373,"_27447":116450,"_2948":116501},[],"99,9 %",{"_3464":70236,"_30209":70214,"_20922":116503,"_5":14373,"_27447":116450,"_2948":49503},[],{"_3464":70237,"_30209":70214,"_20922":116505,"_5":14373,"_27447":116450,"_2948":116506},[],"Ilimitados",{"_3464":70238,"_30209":70214,"_20922":116508,"_5":14373,"_27447":116450,"_2948":116509},[],"Dedicado",{"_3464":70239,"_30209":70214,"_20922":116511,"_5":14373,"_27447":116450,"_2948":116512},[],"99,99 %",{"_3464":70240,"_30209":70214,"_20922":116514,"_5":14373,"_27447":116454,"_2948":116515},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3464":70241,"_30209":70214,"_20922":116517,"_5":14373,"_27447":116454,"_2948":116518},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3464":70242,"_30209":70242,"_5":14725,"_2948":49520,"_30562":116520,"_20922":116522,"_27447":70242},[49276,116287,116521],"Kubernetes autogestionado",[],{"_3464":70243,"_30209":70242,"_20922":116524,"_5":14373,"_27447":70242,"_2948":116525},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3464":70244,"_30209":70242,"_5":30559,"_20922":116527,"_27447":116528,"_2948":116529},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3464":70245,"_30209":70242,"_5":30559,"_20922":116531,"_27447":116532,"_2948":116533},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3464":70246,"_30209":70242,"_5":30559,"_20922":116535,"_27447":116536,"_2948":116537},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3464":70247,"_30209":70242,"_5":30559,"_20922":116539,"_27447":116540,"_2948":116541},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3464":70248,"_30209":70242,"_5":30559,"_20922":116543,"_27447":116544,"_2948":116545},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3464":70249,"_30209":70242,"_5":30559,"_20922":116547,"_27447":116548,"_2948":116549},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3464":70250,"_30209":70242,"_5":30559,"_20922":116551,"_27447":116552,"_2948":116553},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3464":70251,"_30209":70242,"_5":30559,"_20922":116555,"_27447":116556,"_2948":116557},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3464":70252,"_30209":70242,"_5":30559,"_20922":116559,"_27447":116560,"_2948":116561},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3464":70253,"_30209":70242,"_5":30559,"_20922":116563,"_27447":116564,"_2948":116565},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3464":70254,"_30209":70242,"_5":30559,"_20922":116567,"_27447":116568,"_2948":116569},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3464":70255,"_30209":70242,"_20922":116571,"_5":14373,"_27447":116528,"_2948":116572},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3464":70256,"_30209":70242,"_20922":116574,"_5":14373,"_27447":116528,"_2948":116575},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3464":70257,"_30209":70242,"_20922":116577,"_5":14373,"_27447":116532,"_2948":116578},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3464":70258,"_30209":70242,"_20922":116580,"_5":14373,"_27447":116532,"_2948":116581},[],"Fastlane instala o configura",{"_3464":70259,"_30209":70242,"_20922":116583,"_5":14373,"_27447":116532,"_2948":116584},[],"Tú sigues proporcionando",{"_3464":70260,"_30209":70242,"_20922":116586,"_5":14373,"_27447":116532,"_2948":116587},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3464":70261,"_30209":70242,"_20922":116589,"_5":14373,"_27447":116532,"_2948":116590},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3464":70262,"_30209":70242,"_20922":116592,"_5":14373,"_27447":116532,"_2948":116593},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3464":70263,"_30209":70242,"_20922":116595,"_5":14373,"_27447":116532,"_2948":116596},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3464":70264,"_30209":70242,"_20922":116598,"_5":14373,"_27447":116532,"_2948":116599},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3464":70265,"_30209":70242,"_20922":116601,"_5":14373,"_27447":116532,"_2948":116602},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3464":70266,"_30209":70242,"_20922":116604,"_5":14373,"_27447":116532,"_2948":116605},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3464":70267,"_30209":70242,"_20922":116607,"_5":14373,"_27447":116532,"_2948":116608},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3464":70268,"_30209":70242,"_20922":116610,"_5":14373,"_27447":116532,"_2948":116611},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3464":70269,"_30209":70242,"_20922":116613,"_5":14373,"_27447":116536,"_2948":116614},[],"Necesitas:",{"_3464":70270,"_30209":70242,"_20922":116616,"_5":14373,"_27447":116536,"_2948":116617},[],"un clúster Kubernetes existente",{"_3464":70271,"_30209":70242,"_20922":116619,"_5":14373,"_27447":116536,"_2948":116620},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3464":70272,"_30209":70242,"_20922":116622,"_5":14373,"_27447":116536,"_2948":49622},[],{"_3464":70273,"_30209":70242,"_20922":116624,"_5":14373,"_27447":116536,"_2948":23655},[],{"_3464":70274,"_30209":70242,"_20922":116626,"_5":14373,"_27447":116536,"_2948":116627},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3464":70275,"_30209":70242,"_20922":116629,"_5":14373,"_27447":116536,"_2948":116630},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3464":70276,"_30209":70242,"_20922":116632,"_5":14373,"_27447":116536,"_2948":116633},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3464":70277,"_30209":70242,"_20922":116635,"_5":14373,"_27447":116536,"_2948":116636},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3464":70278,"_30209":70242,"_20922":116638,"_5":14373,"_27447":116536,"_2948":116639},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3464":70279,"_30209":70242,"_20922":116641,"_5":14373,"_27447":116540,"_2948":116642},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3464":70280,"_30209":70242,"_20922":116644,"_5":14373,"_27447":116540,"_2948":116645},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3464":70281,"_30209":70242,"_20922":116647,"_5":14373,"_27447":116544,"_2948":116648},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3464":70282,"_30209":70242,"_20922":116650,"_5":14373,"_27447":116544,"_2948":116651},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3464":70283,"_30209":70242,"_20922":116653,"_5":14373,"_27447":116544,"_2948":116654},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3464":70284,"_30209":70242,"_20922":116656,"_5":14373,"_27447":116544,"_2948":116657},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3464":70285,"_30209":70242,"_20922":116659,"_5":14373,"_27447":116548,"_2948":116660},[],"Opción",{"_3464":70286,"_30209":70242,"_20922":116662,"_5":14373,"_27447":116548,"_2948":116663},[],"Valor predeterminado",{"_3464":70287,"_30209":70242,"_20922":116665,"_5":14373,"_27447":116548,"_2948":116666},[],"Propósito",{"_3464":70288,"_30209":70242,"_20922":116668,"_5":14373,"_27447":116548,"_2948":49669},[],{"_3464":70289,"_30209":70242,"_20922":116670,"_5":14373,"_27447":116548,"_2948":49672},[],{"_3464":70290,"_30209":70242,"_20922":116672,"_5":14373,"_27447":116548,"_2948":116673},[],"Muestra la ayuda",{"_3464":70291,"_30209":70242,"_20922":116675,"_5":14373,"_27447":116548,"_2948":49678},[],{"_3464":70292,"_30209":70242,"_20922":116677,"_5":14373,"_27447":116548,"_2948":116678},[],"contexto actual",{"_3464":70293,"_30209":70242,"_20922":116680,"_5":14373,"_27447":116548,"_2948":116681},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3464":70294,"_30209":70242,"_20922":116683,"_5":14373,"_27447":116548,"_2948":49687},[],{"_3464":70295,"_30209":70242,"_20922":116685,"_5":14373,"_27447":116548,"_2948":6533},[],{"_3464":70296,"_30209":70242,"_20922":116687,"_5":14373,"_27447":116548,"_2948":116688},[],"Omite prompts y genera credenciales para las dependencias",{"_3464":70297,"_30209":70242,"_20922":116690,"_5":14373,"_27447":116548,"_2948":49695},[],{"_3464":70298,"_30209":70242,"_20922":116692,"_5":14373,"_27447":116548,"_2948":49698},[],{"_3464":70299,"_30209":70242,"_20922":116694,"_5":14373,"_27447":116548,"_2948":116695},[],"Namespace de la instalación",{"_3464":70300,"_30209":70242,"_20922":116697,"_5":14373,"_27447":116548,"_2948":49704},[],{"_3464":70301,"_30209":70242,"_20922":116699,"_5":14373,"_27447":116548,"_2948":49707},[],{"_3464":70302,"_30209":70242,"_20922":116701,"_5":14373,"_27447":116548,"_2948":116702},[],"Dominio usado por la UI, OIDC y el certificado",{"_3464":70303,"_30209":70242,"_20922":116704,"_5":14373,"_27447":116548,"_2948":49713},[],{"_3464":70304,"_30209":70242,"_20922":116706,"_5":14373,"_27447":116548,"_2948":15070},[],{"_3464":70305,"_30209":70242,"_20922":116708,"_5":14373,"_27447":116548,"_2948":116709},[],"Versión del chart de Lamassu",{"_3464":70306,"_30209":70242,"_20922":116711,"_5":14373,"_27447":116548,"_2948":49721},[],{"_3464":70307,"_30209":70242,"_20922":116713,"_5":14373,"_27447":116548,"_2948":49724},[],{"_3464":70308,"_30209":70242,"_20922":116715,"_5":14373,"_27447":116548,"_2948":116716},[],"Puerto del listener HTTPS",{"_3464":70309,"_30209":70242,"_20922":116718,"_5":14373,"_27447":116548,"_2948":49730},[],{"_3464":70310,"_30209":70242,"_20922":116720,"_5":14373,"_27447":116548,"_2948":49733},[],{"_3464":70311,"_30209":70242,"_20922":116722,"_5":14373,"_27447":116548,"_2948":116723},[],"Puerto del listener HTTP",{"_3464":70312,"_30209":70242,"_20922":116725,"_5":14373,"_27447":116548,"_2948":49739},[],{"_3464":70313,"_30209":70242,"_20922":116727,"_5":14373,"_27447":116548,"_2948":49672},[],{"_3464":70314,"_30209":70242,"_20922":116729,"_5":14373,"_27447":116548,"_2948":116730},[],"Certificado PEM para TLS downstream",{"_3464":70315,"_30209":70242,"_20922":116732,"_5":14373,"_27447":116548,"_2948":49747},[],{"_3464":70316,"_30209":70242,"_20922":116734,"_5":14373,"_27447":116548,"_2948":49672},[],{"_3464":70317,"_30209":70242,"_20922":116736,"_5":14373,"_27447":116548,"_2948":116737},[],"Clave privada PEM para TLS downstream",{"_3464":70318,"_30209":70242,"_20922":116739,"_5":14373,"_27447":116548,"_2948":49755},[],{"_3464":70319,"_30209":70242,"_20922":116741,"_5":14373,"_27447":116548,"_2948":116742},[],"chart del repositorio",{"_3464":70320,"_30209":70242,"_20922":116744,"_5":14373,"_27447":116548,"_2948":116745},[],"Usa un chart local de Lamassu sin empaquetar",{"_3464":70321,"_30209":70242,"_20922":116747,"_5":14373,"_27447":116548,"_2948":49764},[],{"_3464":70322,"_30209":70242,"_20922":116749,"_5":14373,"_27447":116548,"_2948":116750},[],"detección automática",{"_3464":70323,"_30209":70242,"_20922":116752,"_5":14373,"_27447":116548,"_2948":116753},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3464":70324,"_30209":70242,"_20922":116755,"_5":14373,"_27447":116548,"_2948":49772},[],{"_3464":70325,"_30209":70242,"_20922":116757,"_5":14373,"_27447":116548,"_2948":6533},[],{"_3464":70326,"_30209":70242,"_20922":116759,"_5":14373,"_27447":116548,"_2948":116760},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3464":70327,"_30209":70242,"_20922":116762,"_5":14373,"_27447":116548,"_2948":49780},[],{"_3464":70328,"_30209":70242,"_20922":116764,"_5":14373,"_27447":116548,"_2948":6533},[],{"_3464":70329,"_30209":70242,"_20922":116766,"_5":14373,"_27447":116548,"_2948":116767},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3464":70330,"_30209":70242,"_20922":116769,"_5":14373,"_27447":116548,"_2948":49788},[],{"_3464":70331,"_30209":70242,"_20922":116771,"_5":14373,"_27447":116548,"_2948":6533},[],{"_3464":70332,"_30209":70242,"_20922":116773,"_5":14373,"_27447":116548,"_2948":116774},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3464":70333,"_30209":70242,"_20922":116776,"_5":14373,"_27447":116548,"_2948":49796},[],{"_3464":70334,"_30209":70242,"_20922":116778,"_5":14373,"_27447":116548,"_2948":6533},[],{"_3464":70335,"_30209":70242,"_20922":116780,"_5":14373,"_27447":116548,"_2948":116781},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3464":70336,"_30209":70242,"_20922":116783,"_5":14373,"_27447":116548,"_2948":49804},[],{"_3464":70337,"_30209":70242,"_20922":116785,"_5":14373,"_27447":116548,"_2948":49807},[],{"_3464":70338,"_30209":70242,"_20922":116787,"_5":14373,"_27447":116548,"_2948":116788},[],"Usa otro chart local de SoftHSM",{"_3464":70339,"_30209":70242,"_20922":116790,"_5":14373,"_27447":116548,"_2948":116791},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3464":70340,"_30209":70242,"_20922":116793,"_5":14373,"_27447":116552,"_2948":116794},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3464":70341,"_30209":70242,"_20922":116796,"_5":14373,"_27447":116552,"_2948":116797},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3464":70342,"_30209":70242,"_20922":116799,"_5":14373,"_27447":116552,"_2948":116800},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3464":70343,"_30209":70242,"_20922":116802,"_5":14373,"_27447":116552,"_2948":116803},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3464":70344,"_30209":70242,"_20922":116805,"_5":14373,"_27447":116552,"_2948":116806},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3464":70345,"_30209":70242,"_20922":116808,"_5":14373,"_27447":116552,"_2948":116809},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3464":70346,"_30209":70242,"_20922":116811,"_5":14373,"_27447":116556,"_2948":49834},[],{"_3464":70347,"_30209":70242,"_20922":116813,"_5":14373,"_27447":116556,"_2948":116814},[],"valida las herramientas locales y el clúster seleccionado",{"_3464":70348,"_30209":70242,"_20922":116816,"_5":14373,"_27447":116556,"_2948":116817},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3464":70349,"_30209":70242,"_20922":116819,"_5":14373,"_27447":116556,"_2948":116820},[],"crea el namespace",{"_3464":70350,"_30209":70242,"_20922":116822,"_5":14373,"_27447":116556,"_2948":116823},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3464":70351,"_30209":70242,"_20922":116825,"_5":14373,"_27447":116556,"_2948":116826},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3464":70352,"_30209":70242,"_20922":116828,"_5":14373,"_27447":116556,"_2948":116829},[],"instala RabbitMQ",{"_3464":70353,"_30209":70242,"_20922":116831,"_5":14373,"_27447":116556,"_2948":116832},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3464":70354,"_30209":70242,"_20922":116834,"_5":14373,"_27447":116556,"_2948":116835},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3464":70355,"_30209":70242,"_20922":116837,"_5":14373,"_27447":116556,"_2948":116838},[],"carga datos de ejemplo opcionalmente",{"_3464":70356,"_30209":70242,"_20922":116840,"_5":14373,"_27447":116556,"_2948":116841},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3464":70357,"_30209":70242,"_20922":116843,"_5":14373,"_27447":116560,"_2948":116844},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3464":70358,"_30209":70242,"_20922":116846,"_5":14373,"_27447":116560,"_2948":116847},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3464":70359,"_30209":70242,"_20922":116849,"_5":14373,"_27447":116564,"_2948":116850},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3464":70360,"_30209":70242,"_20922":116852,"_5":14373,"_27447":116564,"_2948":116853},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3464":70361,"_30209":70242,"_20922":116855,"_5":14373,"_27447":116564,"_2948":116856},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3464":70362,"_30209":70242,"_20922":116858,"_5":14373,"_27447":116568,"_2948":116859},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3464":70363,"_30209":70363,"_5":14725,"_2948":116861,"_30562":116862,"_20922":116863,"_27447":70363},"Instala con Helm",[49276,116287,116521],[],{"_3464":70364,"_30209":70363,"_20922":116865,"_5":14373,"_27447":70363,"_2948":116866},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3464":70365,"_30209":70363,"_5":30559,"_20922":116868,"_27447":116869,"_2948":116870},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3464":70366,"_30209":70363,"_5":30559,"_20922":116872,"_27447":116873,"_2948":116537},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3464":70367,"_30209":70363,"_5":30559,"_20922":116875,"_27447":116876,"_2948":116877},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3464":70368,"_30209":70363,"_5":30559,"_20922":116879,"_27447":116880,"_2948":116881},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3464":70369,"_30209":70363,"_5":30559,"_20922":116883,"_27447":116884,"_2948":116885},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3464":70370,"_30209":70363,"_5":30559,"_20922":116887,"_27447":116888,"_2948":116889},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3464":70371,"_30209":70363,"_5":30559,"_20922":116891,"_27447":116892,"_2948":116893},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3464":70372,"_30209":70363,"_5":30559,"_20922":116895,"_27447":116896,"_2948":116897},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3464":70373,"_30209":70363,"_5":30559,"_20922":116899,"_27447":116900,"_2948":116901},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3464":70374,"_30209":70363,"_5":30559,"_20922":116903,"_27447":116904,"_2948":116905},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3464":70375,"_30209":70363,"_5":30559,"_20922":116907,"_27447":116908,"_2948":116909},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3464":70376,"_30209":70363,"_20922":116911,"_5":14373,"_27447":116869,"_2948":116912},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3464":70377,"_30209":70363,"_20922":116914,"_5":14373,"_27447":116873,"_2948":116915},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3464":70378,"_30209":70363,"_20922":116917,"_5":14373,"_27447":116873,"_2948":116918},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3464":70379,"_30209":70363,"_20922":116920,"_5":14373,"_27447":116873,"_2948":116921},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3464":70380,"_30209":70363,"_20922":116923,"_5":14373,"_27447":116873,"_2948":116924},[],"un broker RabbitMQ accesible y sus credenciales",{"_3464":70381,"_30209":70363,"_20922":116926,"_5":14373,"_27447":116873,"_2948":116927},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3464":70382,"_30209":70363,"_20922":116929,"_5":14373,"_27447":116873,"_2948":116930},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3464":70383,"_30209":70363,"_20922":116932,"_5":14373,"_27447":116873,"_2948":116933},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3464":70384,"_30209":70363,"_20922":116935,"_5":14373,"_27447":116873,"_2948":116936},[],"una StorageClass y un diseño de tráfico externo",{"_3464":70385,"_30209":70363,"_20922":116938,"_5":14373,"_27447":116873,"_2948":116939},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3464":70386,"_30209":70363,"_20922":116941,"_5":14373,"_27447":116873,"_2948":116942},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3464":70387,"_30209":70363,"_20922":116944,"_5":14373,"_27447":116873,"_2948":116945},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3464":70388,"_30209":70363,"_20922":116947,"_5":14373,"_27447":116876,"_2948":116948},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3464":70389,"_30209":70363,"_20922":116950,"_5":14373,"_27447":116876,"_2948":116951},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3464":70390,"_30209":70363,"_20922":116953,"_5":14373,"_27447":116876,"_2948":116954},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3464":70391,"_30209":70363,"_20922":116956,"_5":14373,"_27447":116880,"_2948":116957},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3464":70392,"_30209":70363,"_20922":116959,"_5":14373,"_27447":116880,"_2948":116960},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3464":70393,"_30209":70363,"_20922":116962,"_5":14373,"_27447":116880,"_2948":116963},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3464":70394,"_30209":70363,"_20922":116965,"_5":14373,"_27447":116880,"_2948":116966},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3464":70395,"_30209":70363,"_20922":116968,"_5":14373,"_27447":116884,"_2948":116969},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3464":70396,"_30209":70363,"_20922":116971,"_5":14373,"_27447":116888,"_2948":116972},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3464":70397,"_30209":70363,"_20922":116974,"_5":14373,"_27447":116888,"_2948":116975},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3464":70398,"_30209":70363,"_20922":116977,"_5":14373,"_27447":116888,"_2948":116978},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3464":70399,"_30209":70363,"_20922":116980,"_5":14373,"_27447":116888,"_2948":116981},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3464":70400,"_30209":70363,"_20922":116983,"_5":14373,"_27447":116888,"_2948":116984},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3464":70401,"_30209":70363,"_20922":116986,"_5":14373,"_27447":116888,"_2948":116987},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3464":70402,"_30209":70363,"_20922":116989,"_5":14373,"_27447":116888,"_2948":116990},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3464":70403,"_30209":70363,"_20922":116992,"_5":14373,"_27447":116892,"_2948":116993},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3464":70404,"_30209":70363,"_20922":116995,"_5":14373,"_27447":116892,"_2948":116996},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3464":70405,"_30209":70363,"_20922":116998,"_5":14373,"_27447":116892,"_2948":116999},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3464":70406,"_30209":70363,"_20922":117001,"_5":14373,"_27447":116892,"_2948":117002},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3464":70407,"_30209":70363,"_20922":117004,"_5":14373,"_27447":116896,"_2948":117005},[],"Para instalar un checkout local:",{"_3464":70408,"_30209":70363,"_20922":117007,"_5":14373,"_27447":116900,"_2948":117008},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3464":70409,"_30209":70363,"_20922":117010,"_5":14373,"_27447":116900,"_2948":117011},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3464":70410,"_30209":70363,"_20922":117013,"_5":14373,"_27447":116904,"_2948":117014},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3464":70411,"_30209":70363,"_20922":117016,"_5":14373,"_27447":116904,"_2948":117017},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3464":70412,"_30209":70363,"_20922":117019,"_5":14373,"_27447":116904,"_2948":117020},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3464":70413,"_30209":70363,"_20922":117022,"_5":14373,"_27447":116904,"_2948":117023},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3464":70414,"_30209":70363,"_20922":117025,"_5":14373,"_27447":116904,"_2948":117026},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3464":70415,"_30209":70363,"_20922":117028,"_5":14373,"_27447":116908,"_2948":117029},[],"Antes de pasar a producción, revisa:",{"_3464":70416,"_30209":70363,"_20922":117031,"_5":14373,"_27447":116908,"_2948":117032},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3464":70417,"_30209":70363,"_20922":117034,"_5":14373,"_27447":116908,"_2948":117035},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3464":70418,"_30209":70363,"_20922":117037,"_5":14373,"_27447":116908,"_2948":117038},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3464":70419,"_30209":70363,"_20922":117040,"_5":14373,"_27447":116908,"_2948":117041},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3464":70420,"_30209":70363,"_20922":117043,"_5":14373,"_27447":116908,"_2948":117044},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3464":70421,"_30209":70363,"_20922":117046,"_5":14373,"_27447":116908,"_2948":117047},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3464":70422,"_30209":70363,"_20922":117049,"_5":14373,"_27447":116908,"_2948":117050},[],"SMTP, observabilidad y entrega de alertas",{"_3464":70423,"_30209":70363,"_20922":117052,"_5":14373,"_27447":116908,"_2948":117053},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3464":70424,"_30209":70363,"_20922":117055,"_5":14373,"_27447":116908,"_2948":117056},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3464":70425,"_30209":70425,"_5":14725,"_2948":117058,"_30562":117059,"_20922":117060,"_27447":70425},"Expón el Gateway",[49276,116287,116521],[],{"_3464":70426,"_30209":70425,"_20922":117062,"_5":14373,"_27447":70425,"_2948":117063},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3464":70427,"_30209":70425,"_5":30559,"_20922":117065,"_27447":117066,"_2948":117067},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3464":70428,"_30209":70425,"_5":30559,"_20922":117069,"_27447":117070,"_2948":117071},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3464":70429,"_30209":70425,"_5":30559,"_20922":117073,"_27447":117074,"_2948":117075},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3464":70430,"_30209":70425,"_5":30559,"_20922":117077,"_27447":117078,"_2948":50102},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#k3s",{"_3464":70431,"_30209":70425,"_5":30559,"_20922":117080,"_27447":117081,"_2948":117082},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3464":70432,"_30209":70425,"_5":30559,"_20922":117084,"_27447":117085,"_2948":117086},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3464":70433,"_30209":70425,"_5":30559,"_20922":117088,"_27447":117089,"_2948":117090},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3464":70434,"_30209":70425,"_5":30559,"_20922":117092,"_27447":117093,"_2948":117094},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3464":70435,"_30209":70425,"_5":30559,"_20922":117096,"_27447":117097,"_2948":117098},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3464":70436,"_30209":70425,"_5":30559,"_20922":117100,"_27447":117101,"_2948":117102},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3464":70437,"_30209":70425,"_5":30559,"_20922":117104,"_27447":117105,"_2948":117106},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3464":70438,"_30209":70425,"_20922":117108,"_5":14373,"_27447":117066,"_2948":117109},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3464":70439,"_30209":70425,"_20922":117111,"_5":14373,"_27447":117066,"_2948":117112},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3464":70440,"_30209":70425,"_20922":117114,"_5":14373,"_27447":117070,"_2948":117115},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3464":70441,"_30209":70425,"_20922":117117,"_5":14373,"_27447":117070,"_2948":117118},[],"Defínelo únicamente cuando:",{"_3464":70442,"_30209":70425,"_20922":117120,"_5":14373,"_27447":117070,"_2948":117121},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3464":70443,"_30209":70425,"_20922":117123,"_5":14373,"_27447":117070,"_2948":117124},[],"esa dirección está asignada a este Gateway",{"_3464":70444,"_30209":70425,"_20922":117126,"_5":14373,"_27447":117070,"_2948":117127},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3464":70445,"_30209":70425,"_20922":117129,"_5":14373,"_27447":117070,"_2948":117130},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3464":70446,"_30209":70425,"_20922":117132,"_5":14373,"_27447":117070,"_2948":117133},[],"No confundas estos valores:",{"_3464":70447,"_30209":70425,"_20922":117135,"_5":14373,"_27447":117070,"_2948":117136},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3464":70448,"_30209":70425,"_20922":117138,"_5":14373,"_27447":117070,"_2948":117139},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3464":70449,"_30209":70425,"_20922":117141,"_5":14373,"_27447":117070,"_2948":117142},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3464":70450,"_30209":70425,"_20922":117144,"_5":14373,"_27447":117074,"_2948":117145},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3464":70451,"_30209":70425,"_20922":117147,"_5":14373,"_27447":117074,"_2948":117148},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3464":70452,"_30209":70425,"_20922":117150,"_5":14373,"_27447":117078,"_2948":117151},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3464":70453,"_30209":70425,"_20922":117153,"_5":14373,"_27447":117078,"_2948":117154},[],"Para el diseño recomendado:",{"_3464":70454,"_30209":70425,"_20922":117156,"_5":14373,"_27447":117078,"_2948":117157},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3464":70455,"_30209":70425,"_20922":117159,"_5":14373,"_27447":117078,"_2948":117160},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3464":70456,"_30209":70425,"_20922":117162,"_5":14373,"_27447":117078,"_2948":117163},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3464":70457,"_30209":70425,"_20922":117165,"_5":14373,"_27447":117078,"_2948":117166},[],"Apunta DNS a la dirección accesible de la VM.",{"_3464":70458,"_30209":70425,"_20922":117168,"_5":14373,"_27447":117078,"_2948":117169},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3464":70459,"_30209":70425,"_20922":117171,"_5":14373,"_27447":117081,"_2948":117172},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3464":70460,"_30209":70425,"_20922":117174,"_5":14373,"_27447":117085,"_2948":117175},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3464":70461,"_30209":70425,"_20922":117177,"_5":14373,"_27447":117085,"_2948":117178},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3464":70462,"_30209":70425,"_20922":117180,"_5":14373,"_27447":117089,"_2948":117181},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3464":70463,"_30209":70425,"_20922":117183,"_5":14373,"_27447":117089,"_2948":117184},[],"Requisito",{"_3464":70464,"_30209":70425,"_20922":117186,"_5":14373,"_27447":117089,"_2948":117187},[],"Diseño recomendado",{"_3464":70465,"_30209":70425,"_20922":117189,"_5":14373,"_27447":117089,"_2948":117190},[],"Consecuencia",{"_3464":70466,"_30209":70425,"_20922":117192,"_5":14373,"_27447":117089,"_2948":117193},[],"Varias URL o servicios de Lamassu",{"_3464":70467,"_30209":70425,"_20922":117195,"_5":14373,"_27447":117089,"_2948":117196},[],"Un Gateway con varias rutas",{"_3464":70468,"_30209":70425,"_20922":117198,"_5":14373,"_27447":117089,"_2948":117199},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3464":70469,"_30209":70425,"_20922":117201,"_5":14373,"_27447":117089,"_2948":117202},[],"Gateways independientes e IP externas distintas",{"_3464":70470,"_30209":70425,"_20922":117204,"_5":14373,"_27447":117089,"_2948":117205},[],"Una VIP por Gateway",{"_3464":70471,"_30209":70425,"_20922":117207,"_5":14373,"_27447":117089,"_2948":117208},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3464":70472,"_30209":70425,"_20922":117210,"_5":14373,"_27447":117089,"_2948":117211},[],"Gateways independientes, un nodo y una IP",{"_3464":70473,"_30209":70425,"_20922":117213,"_5":14373,"_27447":117089,"_2948":117214},[],"Puertos externos diferentes",{"_3464":70474,"_30209":70425,"_20922":117216,"_5":14373,"_27447":117089,"_2948":117217},[],"Los clientes deben indicar puertos no estándar",{"_3464":70475,"_30209":70425,"_20922":117219,"_5":14373,"_27447":117089,"_2948":117220},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3464":70476,"_30209":70425,"_20922":117222,"_5":14373,"_27447":117089,"_2948":117223},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3464":70477,"_30209":70425,"_20922":117225,"_5":14373,"_27447":117089,"_2948":117226},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3464":70478,"_30209":70425,"_20922":117228,"_5":14373,"_27447":117089,"_2948":117229},[],"Recursos Gateway separados pero proxy compartido",{"_3464":70479,"_30209":70425,"_20922":117231,"_5":14373,"_27447":117089,"_2948":117232},[],"Modo merged Gateway de Envoy",{"_3464":70480,"_30209":70425,"_20922":117234,"_5":14373,"_27447":117089,"_2948":117235},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3464":70481,"_30209":70425,"_20922":117237,"_5":14373,"_27447":117089,"_2948":117238},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3464":70482,"_30209":70425,"_20922":117240,"_5":14373,"_27447":117089,"_2948":117241},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3464":70483,"_30209":70425,"_20922":117243,"_5":14373,"_27447":117089,"_2948":117244},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3464":70484,"_30209":70425,"_20922":117246,"_5":14373,"_27447":117089,"_2948":117247},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3464":70485,"_30209":70425,"_20922":117249,"_5":14373,"_27447":117093,"_2948":117250},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3464":70486,"_30209":70425,"_20922":117252,"_5":14373,"_27447":117097,"_2948":117253},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3464":70487,"_30209":70425,"_20922":117255,"_5":14373,"_27447":117097,"_2948":117256},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3464":70488,"_30209":70425,"_20922":117258,"_5":14373,"_27447":117097,"_2948":117259},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3464":70489,"_30209":70425,"_20922":117261,"_5":14373,"_27447":117097,"_2948":117262},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3464":70490,"_30209":70425,"_20922":117264,"_5":14373,"_27447":117097,"_2948":117265},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3464":70491,"_30209":70425,"_20922":117267,"_5":14373,"_27447":117101,"_2948":117268},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3464":70492,"_30209":70425,"_20922":117270,"_5":14373,"_27447":117101,"_2948":117271},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3464":70493,"_30209":70425,"_20922":117273,"_5":14373,"_27447":117105,"_2948":117274},[],"Comprueba, en orden:",{"_3464":70494,"_30209":70425,"_20922":117276,"_5":14373,"_27447":117105,"_2948":117277},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3464":70495,"_30209":70425,"_20922":117279,"_5":14373,"_27447":117105,"_2948":117280},[],"Su estado contiene la dirección esperada.",{"_3464":70496,"_30209":70425,"_20922":117282,"_5":14373,"_27447":117105,"_2948":117283},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3464":70497,"_30209":70425,"_20922":117285,"_5":14373,"_27447":117105,"_2948":117286},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3464":70498,"_30209":70425,"_20922":117288,"_5":14373,"_27447":117105,"_2948":117289},[],"DNS resuelve al endpoint accesible externamente.",{"_3464":70499,"_30209":70425,"_20922":117291,"_5":14373,"_27447":117105,"_2948":117292},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3464":70500,"_30209":70425,"_20922":117294,"_5":14373,"_27447":117105,"_2948":117295},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3464":70501,"_30209":70501,"_5":14725,"_2948":49383,"_30562":117297,"_20922":117298,"_27447":70501},[49276,116287,116521],[],{"_3464":70502,"_30209":70501,"_20922":117300,"_5":14373,"_27447":70501,"_2948":117301},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3464":70503,"_30209":70501,"_5":30559,"_20922":117303,"_27447":117304,"_2948":117305},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3464":70504,"_30209":70501,"_5":30559,"_20922":117307,"_27447":117308,"_2948":117309},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3464":70505,"_30209":70501,"_5":30559,"_20922":117311,"_27447":117312,"_2948":117313},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3464":70506,"_30209":70501,"_5":30559,"_20922":117315,"_27447":117316,"_2948":117317},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3464":70507,"_30209":70501,"_5":30559,"_20922":117319,"_27447":117320,"_2948":117321},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3464":70508,"_30209":70501,"_5":30559,"_20922":117323,"_27447":117324,"_2948":117325},[],"/docs/pr-preview/pr-63/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3464":70509,"_30209":70501,"_20922":117327,"_5":14373,"_27447":117304,"_2948":117328},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3464":70510,"_30209":70501,"_20922":117330,"_5":14373,"_27447":117308,"_2948":117331},[],"Flujo",{"_3464":70511,"_30209":70501,"_20922":117333,"_5":14373,"_27447":117308,"_2948":117334},[],"Úsalo para",{"_3464":70512,"_30209":70501,"_20922":117336,"_5":14373,"_27447":117308,"_2948":117337},[],"Qué instala",{"_3464":70513,"_30209":70501,"_20922":117339,"_5":14373,"_27447":117308,"_2948":50364},[],{"_3464":70514,"_30209":70501,"_20922":117341,"_5":14373,"_27447":117308,"_2948":117342},[],"Producción y entornos controlados",{"_3464":70515,"_30209":70501,"_20922":117344,"_5":14373,"_27447":117308,"_2948":117345},[],"Servicios de Lamassu y recursos de Gateway API",{"_3464":70516,"_30209":70501,"_20922":117347,"_5":14373,"_27447":117308,"_2948":49520},[],{"_3464":70517,"_30209":70501,"_20922":117349,"_5":14373,"_27447":117308,"_2948":117350},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3464":70518,"_30209":70501,"_20922":117352,"_5":14373,"_27447":117308,"_2948":117353},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3464":70519,"_30209":70501,"_20922":117355,"_5":14373,"_27447":117312,"_2948":117356},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3464":70520,"_30209":70501,"_20922":117358,"_5":14373,"_27447":117312,"_2948":117359},[],"Área",{"_3464":70521,"_30209":70501,"_20922":117361,"_5":14373,"_27447":117312,"_2948":117362},[],"El chart de Lamassu proporciona",{"_3464":70522,"_30209":70501,"_20922":117364,"_5":14373,"_27447":117312,"_2948":117365},[],"Tú proporcionas",{"_3464":70523,"_30209":70501,"_20922":117367,"_5":14373,"_27447":117312,"_2948":117368},[],"Aplicaciones Lamassu",{"_3464":70524,"_30209":70501,"_20922":117370,"_5":14373,"_27447":117312,"_2948":117371},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3464":70525,"_30209":70501,"_20922":117373,"_5":14373,"_27447":117312,"_2948":117374},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3464":70526,"_30209":70501,"_20922":117376,"_5":14373,"_27447":117312,"_2948":117377},[],"Datos PostgreSQL",{"_3464":70527,"_30209":70501,"_20922":117379,"_5":14373,"_27447":117312,"_2948":117380},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3464":70528,"_30209":70501,"_20922":117382,"_5":14373,"_27447":117312,"_2948":117383},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3464":70529,"_30209":70501,"_20922":117385,"_5":14373,"_27447":117312,"_2948":117386},[],"Mensajería",{"_3464":70530,"_30209":70501,"_20922":117388,"_5":14373,"_27447":117312,"_2948":117389},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3464":70531,"_30209":70501,"_20922":117391,"_5":14373,"_27447":117312,"_2948":117392},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3464":70532,"_30209":70501,"_20922":117394,"_5":14373,"_27447":117312,"_2948":117395},[],"Identidad",{"_3464":70533,"_30209":70501,"_20922":117397,"_5":14373,"_27447":117312,"_2948":117398},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3464":70534,"_30209":70501,"_20922":117400,"_5":14373,"_27447":117312,"_2948":117401},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3464":70535,"_30209":70501,"_20922":117403,"_5":14373,"_27447":117312,"_2948":117404},[],"Enrutamiento externo",{"_3464":70536,"_30209":70501,"_20922":117406,"_5":14373,"_27447":117312,"_2948":117407},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3464":70537,"_30209":70501,"_20922":117409,"_5":14373,"_27447":117312,"_2948":117410},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3464":70538,"_30209":70501,"_20922":117412,"_5":14373,"_27447":117312,"_2948":50438},[],{"_3464":70539,"_30209":70501,"_20922":117414,"_5":14373,"_27447":117312,"_2948":117415},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3464":70540,"_30209":70501,"_20922":117417,"_5":14373,"_27447":117312,"_2948":117418},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3464":70541,"_30209":70501,"_20922":117420,"_5":14373,"_27447":117312,"_2948":117421},[],"Datos persistentes de la aplicación",{"_3464":70542,"_30209":70501,"_20922":117423,"_5":14373,"_27447":117312,"_2948":117424},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3464":70543,"_30209":70501,"_20922":117426,"_5":14373,"_27447":117312,"_2948":117427},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3464":70544,"_30209":70501,"_20922":117429,"_5":14373,"_27447":117312,"_2948":117430},[],"Integraciones opcionales",{"_3464":70545,"_30209":70501,"_20922":117432,"_5":14373,"_27447":117312,"_2948":117433},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3464":70546,"_30209":70501,"_20922":117435,"_5":14373,"_27447":117312,"_2948":117436},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3464":70547,"_30209":70501,"_20922":117438,"_5":14373,"_27447":117312,"_2948":117439},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3464":70548,"_30209":70501,"_20922":117441,"_5":14373,"_27447":117312,"_2948":117442},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3464":70549,"_30209":70501,"_20922":117444,"_5":14373,"_27447":117316,"_2948":117445},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3464":70550,"_30209":70501,"_20922":117447,"_5":14373,"_27447":117316,"_2948":117448},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3464":70551,"_30209":70501,"_20922":117450,"_5":14373,"_27447":117320,"_2948":117451},[],"Kubernetes 1.24 o posterior",{"_3464":70552,"_30209":70501,"_20922":117453,"_5":14373,"_27447":117320,"_2948":117454},[],"Helm 3.2 o posterior",{"_3464":70553,"_30209":70501,"_20922":117456,"_5":14373,"_27447":117320,"_2948":117457},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3464":70554,"_30209":70501,"_20922":117459,"_5":14373,"_27447":117320,"_2948":117460},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3464":70555,"_30209":70501,"_20922":117462,"_5":14373,"_27447":117320,"_2948":117463},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3464":70556,"_30209":70501,"_20922":117465,"_5":14373,"_27447":117320,"_2948":117466},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3464":70557,"_30209":70501,"_20922":117468,"_5":14373,"_27447":117320,"_2948":117469},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3464":70558,"_30209":70501,"_20922":117471,"_5":14373,"_27447":117324,"_2948":117472},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3464":70559,"_30209":70501,"_20922":117474,"_5":14373,"_27447":117324,"_2948":117475},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3464":70560,"_30209":70501,"_20922":117477,"_5":14373,"_27447":117324,"_2948":117478},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3464":70561,"_30209":70501,"_20922":117480,"_5":14373,"_27447":117324,"_2948":117481},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3464":70562,"_30209":70562,"_5":14725,"_2948":117483,"_30562":117484,"_20922":117486,"_27447":70562},"Resolución de problemas de despliegue",[49276,116287,117485],"Operación",[],{"_3464":70563,"_30209":70562,"_20922":117488,"_5":14373,"_27447":70562,"_2948":117489},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3464":70564,"_30209":70562,"_5":30559,"_20922":117491,"_27447":117492,"_2948":117493},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3464":70565,"_30209":70562,"_5":30559,"_20922":117495,"_27447":117496,"_2948":117497},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3464":70566,"_30209":70562,"_5":30559,"_20922":117499,"_27447":117500,"_2948":117501},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3464":70567,"_30209":70562,"_5":30559,"_20922":117503,"_27447":117504,"_2948":117505},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3464":70568,"_30209":70562,"_5":30559,"_20922":117507,"_27447":117508,"_2948":117509},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3464":70569,"_30209":70562,"_5":30559,"_20922":117511,"_27447":117512,"_2948":117513},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3464":70570,"_30209":70562,"_5":30559,"_20922":117515,"_27447":117516,"_2948":117517},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3464":70571,"_30209":70562,"_5":30559,"_20922":117519,"_27447":117520,"_2948":117521},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3464":70572,"_30209":70562,"_5":30559,"_20922":117523,"_27447":117524,"_2948":117525},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3464":70573,"_30209":70562,"_5":30559,"_20922":117527,"_27447":117528,"_2948":117529},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3464":70574,"_30209":70562,"_5":30559,"_20922":117531,"_27447":117532,"_2948":117533},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3464":70575,"_30209":70562,"_5":30559,"_20922":117535,"_27447":117536,"_2948":117537},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3464":70576,"_30209":70562,"_5":30559,"_20922":117539,"_27447":117540,"_2948":117541},[],"/docs/pr-preview/pr-63/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3464":70577,"_30209":70562,"_20922":117543,"_5":14373,"_27447":70562,"_2948":117544},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3464":70578,"_30209":70562,"_20922":117546,"_5":14373,"_27447":117496,"_2948":117547},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3464":70579,"_30209":70562,"_20922":117549,"_5":14373,"_27447":117500,"_2948":117550},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3464":70580,"_30209":70562,"_20922":117552,"_5":14373,"_27447":117504,"_2948":117553},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3464":70581,"_30209":70562,"_20922":117555,"_5":14373,"_27447":117508,"_2948":117556},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3464":70582,"_30209":70562,"_20922":117558,"_5":14373,"_27447":117512,"_2948":117559},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3464":70583,"_30209":70562,"_20922":117561,"_5":14373,"_27447":117516,"_2948":117562},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3464":70584,"_30209":70562,"_20922":117564,"_5":14373,"_27447":117516,"_2948":117565},[],"Ejecuta también la prueba de conectividad del chart:",{"_3464":70585,"_30209":70562,"_20922":117567,"_5":14373,"_27447":117516,"_2948":117568},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3464":70586,"_30209":70562,"_20922":117570,"_5":14373,"_27447":117516,"_2948":117571},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3464":70587,"_30209":70562,"_20922":117573,"_5":14373,"_27447":117520,"_2948":117574},[],"Si recibes un 401:",{"_3464":70588,"_30209":70562,"_20922":117576,"_5":14373,"_27447":117520,"_2948":117577},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3464":70589,"_30209":70562,"_20922":117579,"_5":14373,"_27447":117520,"_2948":117580},[],"verifica emisor, audiencia y expiración del token;",{"_3464":70590,"_30209":70562,"_20922":117582,"_5":14373,"_27447":117520,"_2948":117583},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3464":70591,"_30209":70562,"_20922":117585,"_5":14373,"_27447":117520,"_2948":117586},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3464":70592,"_30209":70562,"_20922":117588,"_5":14373,"_27447":117520,"_2948":117589},[],"Si el login termina pero las APIs devuelven 403:",{"_3464":70593,"_30209":70562,"_20922":117591,"_5":14373,"_27447":117520,"_2948":117592},[],"inspecciona los claims reales del token;",{"_3464":70594,"_30209":70562,"_20922":117594,"_5":14373,"_27447":117520,"_2948":117595},[],"confirma que coinciden con un principal activo;",{"_3464":70595,"_30209":70562,"_20922":117597,"_5":14373,"_27447":117520,"_2948":117598},[],"revisa las políticas concedidas al principal;",{"_3464":70596,"_30209":70562,"_20922":117600,"_5":14373,"_27447":117520,"_2948":117601},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3464":70597,"_30209":70562,"_20922":117603,"_5":14373,"_27447":117520,"_2948":117604},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3464":70598,"_30209":70562,"_20922":117606,"_5":14373,"_27447":117524,"_2948":117607},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3464":70599,"_30209":70562,"_20922":117609,"_5":14373,"_27447":117524,"_2948":117610},[],"Localiza el pod y Service de authz.",{"_3464":70600,"_30209":70562,"_20922":117612,"_5":14373,"_27447":117524,"_2948":117613},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3464":70601,"_30209":70562,"_20922":117615,"_5":14373,"_27447":117524,"_2948":117616},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3464":70602,"_30209":70562,"_20922":117618,"_5":14373,"_27447":117524,"_2948":117619},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3464":70603,"_30209":70562,"_20922":117621,"_5":14373,"_27447":117524,"_2948":117622},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3464":70604,"_30209":70562,"_20922":117624,"_5":14373,"_27447":117528,"_2948":117625},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3464":70605,"_30209":70562,"_20922":117627,"_5":14373,"_27447":117532,"_2948":117628},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3464":70606,"_30209":70562,"_20922":117630,"_5":14373,"_27447":117532,"_2948":117631},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3464":70607,"_30209":70562,"_20922":117633,"_5":14373,"_27447":117532,"_2948":117634},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3464":70608,"_30209":70562,"_20922":117636,"_5":14373,"_27447":117532,"_2948":117637},[],"volumen persistente sin enlazar;",{"_3464":70609,"_30209":70562,"_20922":117639,"_5":14373,"_27447":117532,"_2948":117640},[],"imagen inaccesible o política de pull incorrecta;",{"_3464":70610,"_30209":70562,"_20922":117642,"_5":14373,"_27447":117532,"_2948":117643},[],"configuración inválida del motor criptográfico;",{"_3464":70611,"_30209":70562,"_20922":117645,"_5":14373,"_27447":117532,"_2948":117646},[],"límites de CPU o memoria demasiado bajos;",{"_3464":70612,"_30209":70562,"_20922":117648,"_5":14373,"_27447":117532,"_2948":117649},[],"migración previa incompleta.",{"_3464":70613,"_30209":70562,"_20922":117651,"_5":14373,"_27447":117532,"_2948":117652},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3464":70614,"_30209":70562,"_20922":117654,"_5":14373,"_27447":117532,"_2948":117655},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3464":70615,"_30209":70562,"_20922":117657,"_5":14373,"_27447":117532,"_2948":117658},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3464":70616,"_30209":70562,"_20922":117660,"_5":14373,"_27447":117536,"_2948":117661},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3464":70617,"_30209":70562,"_20922":117663,"_5":14373,"_27447":117536,"_2948":117664},[],"verifica que esté habilitado en el servicio emisor;",{"_3464":70618,"_30209":70562,"_20922":117666,"_5":14373,"_27447":117536,"_2948":117667},[],"comprueba conectividad y credenciales AMQP;",{"_3464":70619,"_30209":70562,"_20922":117669,"_5":14373,"_27447":117536,"_2948":117670},[],"revisa exchange, routing key, colas y consumidores;",{"_3464":70620,"_30209":70562,"_20922":117672,"_5":14373,"_27447":117536,"_2948":117673},[],"inspecciona dead-letter queues;",{"_3464":70621,"_30209":70562,"_20922":117675,"_5":14373,"_27447":117536,"_2948":117676},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3464":70622,"_30209":70562,"_20922":117678,"_5":14373,"_27447":117536,"_2948":117679},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3464":70623,"_30209":70562,"_20922":117681,"_5":14373,"_27447":117536,"_2948":117682},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3464":70624,"_30209":70562,"_20922":117684,"_5":14373,"_27447":117536,"_2948":117685},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3464":70625,"_30209":70562,"_20922":117687,"_5":14373,"_27447":117536,"_2948":117688},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3464":70626,"_30209":70562,"_20922":117690,"_5":14373,"_27447":117536,"_2948":117691},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3464":70627,"_30209":70562,"_20922":117693,"_5":14373,"_27447":117536,"_2948":117694},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3464":70628,"_30209":70562,"_20922":117696,"_5":14373,"_27447":117536,"_2948":117697},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3464":70629,"_30209":70562,"_20922":117699,"_5":14373,"_27447":117540,"_2948":117700},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3464":70630,"_30209":70562,"_20922":117702,"_5":14373,"_27447":117540,"_2948":117703},[],"Antes de cerrar una incidencia, guarda:",{"_3464":70631,"_30209":70562,"_20922":117705,"_5":14373,"_27447":117540,"_2948":117706},[],"causa confirmada;",{"_3464":70632,"_30209":70562,"_20922":117708,"_5":14373,"_27447":117540,"_2948":117709},[],"alcance temporal y recursos afectados;",{"_3464":70633,"_30209":70562,"_20922":117711,"_5":14373,"_27447":117540,"_2948":117712},[],"comandos o consultas utilizados;",{"_3464":70634,"_30209":70562,"_20922":117714,"_5":14373,"_27447":117540,"_2948":117715},[],"cambio aplicado y forma de revertirlo;",{"_3464":70635,"_30209":70562,"_20922":117717,"_5":14373,"_27447":117540,"_2948":117718},[],"validación desde un consumidor;",{"_3464":70636,"_30209":70562,"_20922":117720,"_5":14373,"_27447":117540,"_2948":117721},[],"acción preventiva y propietario.",{"_3464":70637,"_30209":70637,"_5":14725,"_2948":117723,"_30562":117724,"_20922":117727,"_27447":70637},"Control de acceso",[49276,117725,117726],"Plataforma","Administración",[],{"_3464":70638,"_30209":70637,"_20922":117729,"_5":14373,"_27447":70637,"_2948":117730},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3464":70639,"_30209":70637,"_5":30559,"_20922":117732,"_27447":117733,"_2948":117734},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3464":70640,"_30209":70637,"_5":30559,"_20922":117736,"_27447":117737,"_2948":117738},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3464":70641,"_30209":70637,"_5":30559,"_20922":117740,"_27447":117741,"_2948":117742},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3464":70642,"_30209":70637,"_5":30559,"_20922":117744,"_27447":117745,"_2948":117746},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3464":70643,"_30209":70637,"_5":30559,"_20922":117748,"_27447":117749,"_2948":117750},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3464":70644,"_30209":70637,"_5":30559,"_20922":117752,"_27447":117753,"_2948":117754},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3464":70645,"_30209":70637,"_5":30559,"_20922":117756,"_27447":117757,"_2948":117758},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3464":70646,"_30209":70637,"_5":30559,"_20922":117760,"_27447":117761,"_2948":117762},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3464":70647,"_30209":70637,"_5":30559,"_20922":117764,"_27447":117765,"_2948":117766},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3464":70648,"_30209":70637,"_5":30559,"_20922":117768,"_27447":117769,"_2948":117770},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3464":70649,"_30209":70637,"_5":30559,"_20922":117772,"_27447":117773,"_2948":117774},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3464":70650,"_30209":70637,"_5":30559,"_20922":117776,"_27447":117777,"_2948":117778},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3464":70651,"_30209":70637,"_5":30559,"_20922":117780,"_27447":117781,"_2948":117782},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3464":70652,"_30209":70637,"_5":30559,"_20922":117784,"_27447":117785,"_2948":117786},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3464":70653,"_30209":70637,"_5":30559,"_20922":117788,"_27447":117789,"_2948":117790},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3464":70654,"_30209":70637,"_5":30559,"_20922":117792,"_27447":117793,"_2948":116893},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3464":70655,"_30209":70637,"_5":30559,"_20922":117795,"_27447":117796,"_2948":117797},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3464":70656,"_30209":70637,"_5":30559,"_20922":117799,"_27447":117800,"_2948":117801},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3464":70657,"_30209":70637,"_5":30559,"_20922":117803,"_27447":117804,"_2948":117805},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3464":70658,"_30209":70637,"_5":30559,"_20922":117807,"_27447":117808,"_2948":117809},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3464":70659,"_30209":70637,"_5":30559,"_20922":117811,"_27447":117812,"_2948":117813},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3464":70660,"_30209":70637,"_5":30559,"_20922":117815,"_27447":117816,"_2948":117817},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3464":70661,"_30209":70637,"_5":30559,"_20922":117819,"_27447":117820,"_2948":117821},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3464":70662,"_30209":70637,"_5":30559,"_20922":117823,"_27447":117824,"_2948":117825},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3464":70663,"_30209":70637,"_5":30559,"_20922":117827,"_27447":117828,"_2948":117829},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3464":70664,"_30209":70637,"_5":30559,"_20922":117831,"_27447":117832,"_2948":117833},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3464":70665,"_30209":70637,"_5":30559,"_20922":117835,"_27447":117836,"_2948":117837},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3464":70666,"_30209":70637,"_5":30559,"_20922":117839,"_27447":117840,"_2948":117841},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3464":70667,"_30209":70637,"_5":30559,"_20922":117843,"_27447":117844,"_2948":117845},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3464":70668,"_30209":70637,"_5":30559,"_20922":117847,"_27447":117848,"_2948":117849},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3464":70669,"_30209":70637,"_5":30559,"_20922":117851,"_27447":117852,"_2948":117853},[],"/docs/pr-preview/pr-63/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3464":70670,"_30209":70637,"_20922":117855,"_5":14373,"_27447":70637,"_2948":117856},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3464":70671,"_30209":70637,"_20922":117858,"_5":14373,"_27447":70637,"_2948":117859},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3464":70672,"_30209":70637,"_20922":117861,"_5":14373,"_27447":70637,"_2948":117862},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3464":70673,"_30209":70637,"_20922":117864,"_5":14373,"_27447":117733,"_2948":117865},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3464":70674,"_30209":70637,"_20922":117867,"_5":14373,"_27447":117733,"_2948":117868},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3464":70675,"_30209":70637,"_20922":117870,"_5":14373,"_27447":117733,"_2948":117871},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3464":70676,"_30209":70637,"_20922":117873,"_5":14373,"_27447":117733,"_2948":117874},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3464":70677,"_30209":70637,"_20922":117876,"_5":14373,"_27447":117733,"_2948":117877},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3464":70678,"_30209":70637,"_20922":117879,"_5":14373,"_27447":117733,"_2948":117880},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3464":70679,"_30209":70637,"_20922":117882,"_5":14373,"_27447":117737,"_2948":117883},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3464":70680,"_30209":70637,"_20922":117885,"_5":14373,"_27447":117737,"_2948":117886},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3464":70681,"_30209":70637,"_20922":117888,"_5":14373,"_27447":117741,"_2948":117889},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3464":70682,"_30209":70637,"_20922":117891,"_5":14373,"_27447":117741,"_2948":117892},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3464":70683,"_30209":70637,"_20922":117894,"_5":14373,"_27447":117741,"_2948":117895},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3464":70684,"_30209":70637,"_20922":117897,"_5":14373,"_27447":117741,"_2948":117898},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3464":70685,"_30209":70637,"_20922":117900,"_5":14373,"_27447":117741,"_2948":117901},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3464":70686,"_30209":70637,"_20922":117903,"_5":14373,"_27447":117741,"_2948":117904},[],"Carga por separado las políticas concedidas a cada principal.",{"_3464":70687,"_30209":70637,"_20922":117906,"_5":14373,"_27447":117741,"_2948":117907},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3464":70688,"_30209":70637,"_20922":117909,"_5":14373,"_27447":117741,"_2948":117910},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3464":70689,"_30209":70637,"_20922":117912,"_5":14373,"_27447":117741,"_2948":117913},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3464":70690,"_30209":70637,"_20922":117915,"_5":14373,"_27447":117741,"_2948":117916},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3464":70691,"_30209":70637,"_20922":117918,"_5":14373,"_27447":117741,"_2948":117919},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3464":70692,"_30209":70637,"_20922":117921,"_5":14373,"_27447":117741,"_2948":117922},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3464":70693,"_30209":70637,"_20922":117924,"_5":14373,"_27447":117745,"_2948":117925},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3464":70694,"_30209":70637,"_20922":117927,"_5":14373,"_27447":117745,"_2948":117928},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3464":70695,"_30209":70637,"_20922":117930,"_5":14373,"_27447":117745,"_2948":117931},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3464":70696,"_30209":70637,"_20922":117933,"_5":14373,"_27447":117745,"_2948":117934},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3464":70697,"_30209":70637,"_20922":117936,"_5":14373,"_27447":117745,"_2948":117937},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3464":70698,"_30209":70637,"_20922":117939,"_5":14373,"_27447":117745,"_2948":117940},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3464":70699,"_30209":70637,"_20922":117942,"_5":14373,"_27447":117745,"_2948":117943},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3464":70700,"_30209":70637,"_20922":117945,"_5":14373,"_27447":117745,"_2948":117946},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3464":70701,"_30209":70637,"_20922":117948,"_5":14373,"_27447":117749,"_2948":117949},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3464":70702,"_30209":70637,"_20922":117951,"_5":14373,"_27447":117749,"_2948":117952},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3464":70703,"_30209":70637,"_20922":117954,"_5":14373,"_27447":117749,"_2948":117955},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3464":70704,"_30209":70637,"_20922":117957,"_5":14373,"_27447":117749,"_2948":117958},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3464":70705,"_30209":70637,"_20922":117960,"_5":14373,"_27447":117749,"_2948":117961},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3464":70706,"_30209":70637,"_20922":117963,"_5":14373,"_27447":117749,"_2948":117964},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3464":70707,"_30209":70637,"_20922":117966,"_5":14373,"_27447":117749,"_2948":117967},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3464":70708,"_30209":70637,"_20922":117969,"_5":14373,"_27447":117749,"_2948":117970},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3464":70709,"_30209":70637,"_20922":117972,"_5":14373,"_27447":117749,"_2948":117973},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3464":70710,"_30209":70637,"_20922":117975,"_5":14373,"_27447":117749,"_2948":117976},[],"Las acciones se dividen en dos grupos:",{"_3464":70711,"_30209":70637,"_20922":117978,"_5":14373,"_27447":117749,"_2948":117979},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3464":70712,"_30209":70637,"_20922":117981,"_5":14373,"_27447":117749,"_2948":117982},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3464":70713,"_30209":70637,"_20922":117984,"_5":14373,"_27447":117749,"_2948":117985},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3464":70714,"_30209":70637,"_20922":117987,"_5":14373,"_27447":117753,"_2948":117988},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3464":70715,"_30209":70637,"_20922":117990,"_5":14373,"_27447":117753,"_2948":117991},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3464":70716,"_30209":70637,"_20922":117993,"_5":14373,"_27447":117753,"_2948":117994},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3464":70717,"_30209":70637,"_20922":117996,"_5":14373,"_27447":117757,"_2948":117997},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3464":70718,"_30209":70637,"_20922":117999,"_5":14373,"_27447":117757,"_2948":118000},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3464":70719,"_30209":70637,"_20922":118002,"_5":14373,"_27447":117757,"_2948":118003},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3464":70720,"_30209":70637,"_20922":118005,"_5":14373,"_27447":117757,"_2948":118006},[],"Los operadores implementados son:",{"_3464":70721,"_30209":70637,"_20922":118008,"_5":14373,"_27447":117757,"_2948":118009},[],"`equals`, para igualdad exacta;",{"_3464":70722,"_30209":70637,"_20922":118011,"_5":14373,"_27447":117757,"_2948":118012},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3464":70723,"_30209":70637,"_20922":118014,"_5":14373,"_27447":117757,"_2948":118015},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3464":70724,"_30209":70637,"_20922":118017,"_5":14373,"_27447":117757,"_2948":118018},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3464":70725,"_30209":70637,"_20922":118020,"_5":14373,"_27447":117761,"_2948":118021},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3464":70726,"_30209":70637,"_20922":118023,"_5":14373,"_27447":117761,"_2948":118024},[],"Los modos disponibles son:",{"_3464":70727,"_30209":70637,"_20922":118026,"_5":14373,"_27447":117761,"_2948":118027},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3464":70728,"_30209":70637,"_20922":118029,"_5":14373,"_27447":117761,"_2948":118030},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3464":70729,"_30209":70637,"_20922":118032,"_5":14373,"_27447":117761,"_2948":118033},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3464":70730,"_30209":70637,"_20922":118035,"_5":14373,"_27447":117761,"_2948":118036},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3464":70731,"_30209":70637,"_20922":118038,"_5":14373,"_27447":117761,"_2948":118039},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3464":70732,"_30209":70637,"_20922":118041,"_5":14373,"_27447":117761,"_2948":118042},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3464":70733,"_30209":70637,"_20922":118044,"_5":14373,"_27447":117765,"_2948":118045},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3464":70734,"_30209":70637,"_20922":118047,"_5":14373,"_27447":117765,"_2948":118048},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3464":70735,"_30209":70637,"_20922":118050,"_5":14373,"_27447":117765,"_2948":118051},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3464":70736,"_30209":70637,"_20922":118053,"_5":14373,"_27447":117765,"_2948":118054},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3464":70737,"_30209":70637,"_20922":118056,"_5":14373,"_27447":117773,"_2948":118057},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3464":70738,"_30209":70637,"_20922":118059,"_5":14373,"_27447":117773,"_2948":118060},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3464":70739,"_30209":70637,"_20922":118062,"_5":14373,"_27447":117777,"_2948":118063},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3464":70740,"_30209":70637,"_20922":118065,"_5":14373,"_27447":117777,"_2948":118066},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3464":70741,"_30209":70637,"_20922":118068,"_5":14373,"_27447":117781,"_2948":118069},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3464":70742,"_30209":70637,"_20922":118071,"_5":14373,"_27447":117781,"_2948":118072},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3464":70743,"_30209":70637,"_20922":118074,"_5":14373,"_27447":117781,"_2948":118075},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3464":70744,"_30209":70637,"_20922":118077,"_5":14373,"_27447":117785,"_2948":118078},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3464":70745,"_30209":70637,"_20922":118080,"_5":14373,"_27447":117785,"_2948":118081},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3464":70746,"_30209":70637,"_20922":118083,"_5":14373,"_27447":117785,"_2948":118084},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3464":70747,"_30209":70637,"_20922":118086,"_5":14373,"_27447":117785,"_2948":118087},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3464":70748,"_30209":70637,"_20922":118089,"_5":14373,"_27447":117785,"_2948":118090},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3464":70749,"_30209":70637,"_20922":118092,"_5":14373,"_27447":117785,"_2948":118093},[],"Ten en cuenta que:",{"_3464":70750,"_30209":70637,"_20922":118095,"_5":14373,"_27447":117785,"_2948":118096},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3464":70751,"_30209":70637,"_20922":118098,"_5":14373,"_27447":117785,"_2948":118099},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3464":70752,"_30209":70637,"_20922":118101,"_5":14373,"_27447":117785,"_2948":118102},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3464":70753,"_30209":70637,"_20922":118104,"_5":14373,"_27447":117789,"_2948":118105},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3464":70754,"_30209":70637,"_20922":118107,"_5":14373,"_27447":117789,"_2948":118108},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3464":70755,"_30209":70637,"_20922":118110,"_5":14373,"_27447":117789,"_2948":118111},[],"acceso completo y de solo lectura a KMS;",{"_3464":70756,"_30209":70637,"_20922":118113,"_5":14373,"_27447":117789,"_2948":118114},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3464":70757,"_30209":70637,"_20922":118116,"_5":14373,"_27447":117789,"_2948":118117},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3464":70758,"_30209":70637,"_20922":118119,"_5":14373,"_27447":117789,"_2948":118120},[],"acceso a la interfaz;",{"_3464":70759,"_30209":70637,"_20922":118122,"_5":14373,"_27447":117789,"_2948":118123},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3464":70760,"_30209":70637,"_20922":118125,"_5":14373,"_27447":117789,"_2948":118126},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3464":70761,"_30209":70637,"_20922":118128,"_5":14373,"_27447":117789,"_2948":118129},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3464":70762,"_30209":70637,"_20922":118131,"_5":14373,"_27447":117793,"_2948":118132},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3464":70763,"_30209":70637,"_20922":118134,"_5":14373,"_27447":117793,"_2948":118135},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3464":70764,"_30209":70637,"_20922":118137,"_5":14373,"_27447":117793,"_2948":118138},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3464":70765,"_30209":70637,"_20922":118140,"_5":14373,"_27447":117796,"_2948":118141},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3464":70766,"_30209":70637,"_20922":118143,"_5":14373,"_27447":117800,"_2948":118144},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3464":70767,"_30209":70637,"_20922":118146,"_5":14373,"_27447":117800,"_2948":118147},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3464":70768,"_30209":70637,"_20922":118149,"_5":14373,"_27447":117804,"_2948":118150},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3464":70769,"_30209":70637,"_20922":118152,"_5":14373,"_27447":117808,"_2948":118153},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3464":70770,"_30209":70637,"_20922":118155,"_5":14373,"_27447":117812,"_2948":118156},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3464":70771,"_30209":70637,"_20922":118158,"_5":14373,"_27447":117816,"_2948":118159},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3464":70772,"_30209":70637,"_20922":118161,"_5":14373,"_27447":117816,"_2948":118162},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3464":70773,"_30209":70637,"_20922":118164,"_5":14373,"_27447":117820,"_2948":118165},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3464":70774,"_30209":70637,"_20922":118167,"_5":14373,"_27447":117820,"_2948":118168},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3464":70775,"_30209":70637,"_20922":118170,"_5":14373,"_27447":117820,"_2948":118171},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3464":70776,"_30209":70637,"_20922":118173,"_5":14373,"_27447":117820,"_2948":118174},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3464":70777,"_30209":70637,"_20922":118176,"_5":14373,"_27447":117820,"_2948":118177},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3464":70778,"_30209":70637,"_20922":118179,"_5":14373,"_27447":117820,"_2948":118180},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3464":70779,"_30209":70637,"_20922":118182,"_5":14373,"_27447":117820,"_2948":118183},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3464":70780,"_30209":70637,"_20922":118185,"_5":14373,"_27447":117820,"_2948":118186},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3464":70781,"_30209":70637,"_20922":118188,"_5":14373,"_27447":117824,"_2948":118189},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3464":70782,"_30209":70637,"_20922":118191,"_5":14373,"_27447":117824,"_2948":118192},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3464":70783,"_30209":70637,"_20922":118194,"_5":14373,"_27447":117824,"_2948":118195},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3464":70784,"_30209":70637,"_20922":118197,"_5":14373,"_27447":117828,"_2948":118198},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3464":70785,"_30209":70637,"_20922":118200,"_5":14373,"_27447":117828,"_2948":118201},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3464":70786,"_30209":70637,"_20922":118203,"_5":14373,"_27447":117828,"_2948":118204},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3464":70787,"_30209":70637,"_20922":118206,"_5":14373,"_27447":117828,"_2948":118207},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3464":70788,"_30209":70637,"_20922":118209,"_5":14373,"_27447":117828,"_2948":118210},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3464":70789,"_30209":70637,"_20922":118212,"_5":14373,"_27447":117828,"_2948":118213},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3464":70790,"_30209":70637,"_20922":118215,"_5":14373,"_27447":117828,"_2948":118216},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3464":70791,"_30209":70637,"_20922":118218,"_5":14373,"_27447":117828,"_2948":118219},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3464":70792,"_30209":70637,"_20922":118221,"_5":14373,"_27447":117836,"_2948":118222},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3464":70793,"_30209":70637,"_20922":118224,"_5":14373,"_27447":117840,"_2948":118225},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3464":70794,"_30209":70637,"_20922":118227,"_5":14373,"_27447":117840,"_2948":118228},[],"que exista un principal activo del tipo correcto;",{"_3464":70795,"_30209":70637,"_20922":118230,"_5":14373,"_27447":117840,"_2948":118231},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3464":70796,"_30209":70637,"_20922":118233,"_5":14373,"_27447":117840,"_2948":118234},[],"que todas las condiciones del principal se cumplan;",{"_3464":70797,"_30209":70637,"_20922":118236,"_5":14373,"_27447":117840,"_2948":118237},[],"que el principal tenga concedida la política esperada;",{"_3464":70798,"_30209":70637,"_20922":118239,"_5":14373,"_27447":117840,"_2948":118240},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3464":70799,"_30209":70637,"_20922":118242,"_5":14373,"_27447":117840,"_2948":118243},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3464":70800,"_30209":70637,"_20922":118245,"_5":14373,"_27447":117840,"_2948":118246},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3464":70801,"_30209":70637,"_20922":118248,"_5":14373,"_27447":117844,"_2948":118249},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3464":70802,"_30209":70637,"_20922":118251,"_5":14373,"_27447":117848,"_2948":118252},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3464":70803,"_30209":70637,"_20922":118254,"_5":14373,"_27447":117852,"_2948":118255},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3464":70804,"_30209":70637,"_20922":118257,"_5":14373,"_27447":117852,"_2948":118258},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3464":70805,"_30209":70805,"_5":14725,"_2948":118260,"_30562":118261,"_20922":118262,"_27447":70805},"Alertas y suscripciones",[49276,117725,117726],[],{"_3464":70806,"_30209":70805,"_20922":118264,"_5":14373,"_27447":70805,"_2948":118265},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3464":70807,"_30209":70805,"_5":30559,"_20922":118267,"_27447":118268,"_2948":118269},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3464":70808,"_30209":70805,"_5":30559,"_20922":118271,"_27447":118272,"_2948":118273},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3464":70809,"_30209":70805,"_5":30559,"_20922":118275,"_27447":118276,"_2948":118277},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3464":70810,"_30209":70805,"_5":30559,"_20922":118279,"_27447":118280,"_2948":118281},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3464":70811,"_30209":70805,"_5":30559,"_20922":118283,"_27447":118284,"_2948":118285},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3464":70812,"_30209":70805,"_5":30559,"_20922":118287,"_27447":118288,"_2948":118289},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3464":70813,"_30209":70805,"_5":30559,"_20922":118291,"_27447":118292,"_2948":118293},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3464":70814,"_30209":70805,"_5":30559,"_20922":118295,"_27447":118296,"_2948":118297},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3464":70815,"_30209":70805,"_5":30559,"_20922":118299,"_27447":118300,"_2948":118301},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3464":70816,"_30209":70805,"_5":30559,"_20922":118303,"_27447":118304,"_2948":118305},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3464":70817,"_30209":70805,"_5":30559,"_20922":118307,"_27447":118308,"_2948":118309},[],"/docs/pr-preview/pr-63/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3464":70818,"_30209":70805,"_20922":118311,"_5":14373,"_27447":70805,"_2948":118312},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3464":70819,"_30209":70805,"_20922":118314,"_5":14373,"_27447":118268,"_2948":118315},[],"Un servicio publica un evento de dominio.",{"_3464":70820,"_30209":70805,"_20922":118317,"_5":14373,"_27447":118268,"_2948":118318},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3464":70821,"_30209":70805,"_20922":118320,"_5":14373,"_27447":118268,"_2948":118321},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3464":70822,"_30209":70805,"_20922":118323,"_5":14373,"_27447":118268,"_2948":118324},[],"Lamassu entrega el evento al canal configurado.",{"_3464":70823,"_30209":70805,"_20922":118326,"_5":14373,"_27447":118268,"_2948":118327},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3464":70824,"_30209":70805,"_20922":118329,"_5":14373,"_27447":118272,"_2948":118330},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3464":70825,"_30209":70805,"_20922":118332,"_5":14373,"_27447":118272,"_2948":118333},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3464":70826,"_30209":70805,"_20922":118335,"_5":14373,"_27447":118272,"_2948":118336},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3464":70827,"_30209":70805,"_20922":118338,"_5":14373,"_27447":118272,"_2948":118339},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3464":70828,"_30209":70805,"_20922":118341,"_5":14373,"_27447":118272,"_2948":118342},[],"`apikey_options` necesita `header` y `key`.",{"_3464":70829,"_30209":70805,"_20922":118344,"_5":14373,"_27447":118272,"_2948":118345},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3464":70830,"_30209":70805,"_20922":118347,"_5":14373,"_27447":118272,"_2948":118348},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3464":70831,"_30209":70805,"_20922":118350,"_5":14373,"_27447":118272,"_2948":118351},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3464":70832,"_30209":70805,"_20922":118353,"_5":14373,"_27447":118280,"_2948":118354},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3464":70833,"_30209":70805,"_20922":118356,"_5":14373,"_27447":118284,"_2948":118357},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3464":70834,"_30209":70805,"_20922":118359,"_5":14373,"_27447":118288,"_2948":118360},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3464":70835,"_30209":70805,"_20922":118362,"_5":14373,"_27447":118288,"_2948":118363},[],"**None** notifica todas las instancias del evento.",{"_3464":70836,"_30209":70805,"_20922":118365,"_5":14373,"_27447":118288,"_2948":118366},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3464":70837,"_30209":70805,"_20922":118368,"_5":14373,"_27447":118288,"_2948":118369},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3464":70838,"_30209":70805,"_20922":118371,"_5":14373,"_27447":118288,"_2948":118372},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3464":70839,"_30209":70805,"_20922":118374,"_5":14373,"_27447":118288,"_2948":118375},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3464":70840,"_30209":70805,"_20922":118377,"_5":14373,"_27447":118288,"_2948":118378},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3464":70841,"_30209":70805,"_20922":118380,"_5":14373,"_27447":118292,"_2948":118381},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3464":70842,"_30209":70805,"_20922":118383,"_5":14373,"_27447":118296,"_2948":118384},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3464":70843,"_30209":70805,"_20922":118386,"_5":14373,"_27447":118296,"_2948":118387},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3464":70844,"_30209":70805,"_20922":118389,"_5":14373,"_27447":118296,"_2948":118390},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3464":70845,"_30209":70805,"_20922":118392,"_5":14373,"_27447":118296,"_2948":118393},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3464":70846,"_30209":70805,"_20922":118395,"_5":14373,"_27447":118296,"_2948":118396},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3464":70847,"_30209":70805,"_20922":118398,"_5":14373,"_27447":118296,"_2948":118399},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3464":70848,"_30209":70805,"_20922":118401,"_5":14373,"_27447":118296,"_2948":118402},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3464":70849,"_30209":70805,"_20922":118404,"_5":14373,"_27447":118296,"_2948":118405},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3464":70850,"_30209":70805,"_20922":118407,"_5":14373,"_27447":118300,"_2948":118408},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3464":70851,"_30209":70805,"_20922":118410,"_5":14373,"_27447":118300,"_2948":118411},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3464":70852,"_30209":70805,"_20922":118413,"_5":14373,"_27447":118300,"_2948":118414},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3464":70853,"_30209":70805,"_20922":118416,"_5":14373,"_27447":118300,"_2948":118417},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3464":70854,"_30209":70805,"_20922":118419,"_5":14373,"_27447":118300,"_2948":118420},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3464":70855,"_30209":70805,"_20922":118422,"_5":14373,"_27447":118300,"_2948":118423},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3464":70856,"_30209":70805,"_20922":118425,"_5":14373,"_27447":118300,"_2948":118426},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3464":70857,"_30209":70805,"_20922":118428,"_5":14373,"_27447":118300,"_2948":118429},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3464":70858,"_30209":70805,"_20922":118431,"_5":14373,"_27447":118304,"_2948":118432},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3464":70859,"_30209":70805,"_20922":118434,"_5":14373,"_27447":118304,"_2948":118435},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3464":70860,"_30209":70805,"_20922":118437,"_5":14373,"_27447":118308,"_2948":118438},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3464":70861,"_30209":70805,"_20922":118440,"_5":14373,"_27447":118308,"_2948":118441},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3464":70862,"_30209":70805,"_20922":118443,"_5":14373,"_27447":118308,"_2948":118444},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3464":70863,"_30209":70805,"_20922":118446,"_5":14373,"_27447":118308,"_2948":118447},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3464":70864,"_30209":70805,"_20922":118449,"_5":14373,"_27447":118308,"_2948":118450},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3464":70865,"_30209":70805,"_20922":118452,"_5":14373,"_27447":118308,"_2948":118453},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3464":70866,"_30209":70805,"_20922":118455,"_5":14373,"_27447":118308,"_2948":118456},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3464":70867,"_30209":70805,"_20922":118458,"_5":14373,"_27447":118308,"_2948":118459},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3464":70868,"_30209":70805,"_20922":118461,"_5":14373,"_27447":118308,"_2948":118462},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3464":70869,"_30209":70869,"_5":14725,"_2948":118464,"_30562":118465,"_20922":118466,"_27447":70869},"Registros de auditoría",[49276,117725,117726],[],{"_3464":70870,"_30209":70869,"_20922":118468,"_5":14373,"_27447":70869,"_2948":118469},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3464":70871,"_30209":70869,"_5":30559,"_20922":118471,"_27447":118472,"_2948":118473},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3464":70872,"_30209":70869,"_5":30559,"_20922":118475,"_27447":118476,"_2948":118477},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3464":70873,"_30209":70869,"_5":30559,"_20922":118479,"_27447":118480,"_2948":118481},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3464":70874,"_30209":70869,"_5":30559,"_20922":118483,"_27447":118484,"_2948":118485},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3464":70875,"_30209":70869,"_5":30559,"_20922":118487,"_27447":118488,"_2948":118489},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3464":70876,"_30209":70869,"_5":30559,"_20922":118491,"_27447":118492,"_2948":118493},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3464":70877,"_30209":70869,"_5":30559,"_20922":118495,"_27447":118496,"_2948":118497},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3464":70878,"_30209":70869,"_5":30559,"_20922":118499,"_27447":118500,"_2948":118501},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3464":70879,"_30209":70869,"_5":30559,"_20922":118503,"_27447":118504,"_2948":118505},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3464":70880,"_30209":70869,"_5":30559,"_20922":118507,"_27447":118508,"_2948":118509},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3464":70881,"_30209":70869,"_5":30559,"_20922":118511,"_27447":118512,"_2948":118513},[],"/docs/pr-preview/pr-63/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3464":70882,"_30209":70869,"_20922":118515,"_5":14373,"_27447":70869,"_2948":118516},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3464":70883,"_30209":70869,"_20922":118518,"_5":14373,"_27447":118472,"_2948":118519},[],"El cuerpo de auditoría incluye:",{"_3464":70884,"_30209":70869,"_20922":118521,"_5":14373,"_27447":118472,"_2948":118522},[],"input: datos recibidos por la operación;",{"_3464":70885,"_30209":70869,"_20922":118524,"_5":14373,"_27447":118472,"_2948":118525},[],"has\\_error: indica si el servicio devolvió un error;",{"_3464":70886,"_30209":70869,"_20922":118527,"_5":14373,"_27447":118472,"_2948":118528},[],"output: resultado producido o mensaje de error;",{"_3464":70887,"_30209":70869,"_20922":118530,"_5":14373,"_27447":118472,"_2948":118531},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3464":70888,"_30209":70869,"_20922":118533,"_5":14373,"_27447":118472,"_2948":118534},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3464":70889,"_30209":70869,"_20922":118536,"_5":14373,"_27447":118472,"_2948":118537},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3464":70890,"_30209":70869,"_20922":118539,"_5":14373,"_27447":118476,"_2948":118540},[],"El backend aplica auditoría a mutaciones de:",{"_3464":70891,"_30209":70869,"_20922":118542,"_5":14373,"_27447":118476,"_2948":118543},[],"autoridades, certificados y perfiles de emisión;",{"_3464":70892,"_30209":70869,"_20922":118545,"_5":14373,"_27447":118476,"_2948":118546},[],"claves y motores KMS;",{"_3464":70893,"_30209":70869,"_20922":118548,"_5":14373,"_27447":118476,"_2948":118549},[],"dispositivos e identidades;",{"_3464":70894,"_30209":70869,"_20922":118551,"_5":14373,"_27447":118476,"_2948":118552},[],"DMS y operaciones de enrolamiento;",{"_3464":70895,"_30209":70869,"_20922":118554,"_5":14373,"_27447":118476,"_2948":118555},[],"funciones de validación y CRL;",{"_3464":70896,"_30209":70869,"_20922":118557,"_5":14373,"_27447":118476,"_2948":118558},[],"principales, políticas y concesiones de autorización.",{"_3464":70897,"_30209":70869,"_20922":118560,"_5":14373,"_27447":118476,"_2948":118561},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3464":70898,"_30209":70869,"_20922":118563,"_5":14373,"_27447":118480,"_2948":118564},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3464":70899,"_30209":70869,"_20922":118566,"_5":14373,"_27447":118480,"_2948":118567},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3464":70900,"_30209":70869,"_20922":118569,"_5":14373,"_27447":118480,"_2948":118570},[],"Diseña el consumidor para:",{"_3464":70901,"_30209":70869,"_20922":118572,"_5":14373,"_27447":118480,"_2948":118573},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3464":70902,"_30209":70869,"_20922":118575,"_5":14373,"_27447":118480,"_2948":118576},[],"conservar el CloudEvent completo sin modificar;",{"_3464":70903,"_30209":70869,"_20922":118578,"_5":14373,"_27447":118480,"_2948":118579},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3464":70904,"_30209":70869,"_20922":118581,"_5":14373,"_27447":118480,"_2948":118582},[],"cifrar en tránsito y en reposo;",{"_3464":70905,"_30209":70869,"_20922":118584,"_5":14373,"_27447":118480,"_2948":118585},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3464":70906,"_30209":70869,"_20922":118587,"_5":14373,"_27447":118480,"_2948":118588},[],"aplicar una política explícita de retención y legal hold;",{"_3464":70907,"_30209":70869,"_20922":118590,"_5":14373,"_27447":118480,"_2948":118591},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3464":70908,"_30209":70869,"_20922":118593,"_5":14373,"_27447":118484,"_2948":118594},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3464":70909,"_30209":70869,"_20922":118596,"_5":14373,"_27447":118484,"_2948":118597},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3464":70910,"_30209":70869,"_20922":118599,"_5":14373,"_27447":118492,"_2948":118600},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3464":70911,"_30209":70869,"_20922":118602,"_5":14373,"_27447":118496,"_2948":118603},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3464":70912,"_30209":70869,"_20922":118605,"_5":14373,"_27447":118500,"_2948":118606},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3464":70913,"_30209":70869,"_20922":118608,"_5":14373,"_27447":118504,"_2948":118609},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3464":70914,"_30209":70869,"_20922":118611,"_5":14373,"_27447":118508,"_2948":118612},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3464":70915,"_30209":70869,"_20922":118614,"_5":14373,"_27447":118512,"_2948":118615},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3464":70916,"_30209":70869,"_20922":118617,"_5":14373,"_27447":118512,"_2948":118618},[],"aparece un evento de auditoría correcto;",{"_3464":70917,"_30209":70869,"_20922":118620,"_5":14373,"_27447":118512,"_2948":118621},[],"el principal coincide con la identidad utilizada;",{"_3464":70918,"_30209":70869,"_20922":118623,"_5":14373,"_27447":118512,"_2948":118624},[],"el consumidor lo persiste una sola vez;",{"_3464":70919,"_30209":70869,"_20922":118626,"_5":14373,"_27447":118512,"_2948":118627},[],"puede recuperarse por recurso, actor y periodo;",{"_3464":70920,"_30209":70869,"_20922":118629,"_5":14373,"_27447":118512,"_2948":118630},[],"una interrupción del consumidor produce una alerta.",{"_3464":70921,"_30209":70869,"_20922":118632,"_5":14373,"_27447":118512,"_2948":118633},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3464":70922,"_30209":70922,"_5":14725,"_2948":118635,"_30562":118636,"_20922":118637,"_27447":70922},"Arquitectura de la plataforma",[49276,117725],[],{"_3464":70923,"_30209":70922,"_20922":118639,"_5":14373,"_27447":70922,"_2948":118640},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3464":70924,"_30209":70922,"_5":30559,"_20922":118642,"_27447":118643,"_2948":118644},[],"/docs/pr-preview/pr-63/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3464":70925,"_30209":70922,"_5":30559,"_20922":118646,"_27447":118647,"_2948":118648},[],"/docs/pr-preview/pr-63/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3464":70926,"_30209":70922,"_5":30559,"_20922":118650,"_27447":118651,"_2948":118652},[],"/docs/pr-preview/pr-63/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3464":70927,"_30209":70922,"_5":30559,"_20922":118654,"_27447":118655,"_2948":118656},[],"/docs/pr-preview/pr-63/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3464":70928,"_30209":70922,"_5":30559,"_20922":118658,"_27447":118659,"_2948":118660},[],"/docs/pr-preview/pr-63/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3464":70929,"_30209":70922,"_20922":118662,"_5":14373,"_27447":70922,"_2948":118663},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3464":70930,"_30209":70922,"_20922":118665,"_5":14373,"_27447":70922,"_2948":118666},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3464":70931,"_30209":70922,"_20922":118668,"_5":14373,"_27447":118643,"_2948":118669},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3464":70932,"_30209":70922,"_20922":118671,"_5":14373,"_27447":118647,"_2948":118672},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3464":70933,"_30209":70922,"_20922":118674,"_5":14373,"_27447":118651,"_2948":118675},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3464":70934,"_30209":70922,"_20922":118677,"_5":14373,"_27447":118655,"_2948":118678},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3464":70935,"_30209":70922,"_20922":118680,"_5":14373,"_27447":118659,"_2948":118681},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3464":70936,"_30209":70936,"_5":14725,"_2948":118683,"_30562":118684,"_20922":118685,"_27447":70936},"Cómo funciona Lamassu",[49276,117725],[],{"_3464":70937,"_30209":70936,"_20922":118687,"_5":14373,"_27447":70936,"_2948":118688},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3464":70938,"_30209":70936,"_5":30559,"_20922":118690,"_27447":118691,"_2948":118692},[],"/docs/pr-preview/pr-63/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3464":70939,"_30209":70936,"_5":30559,"_20922":118694,"_27447":118695,"_2948":118696},[],"/docs/pr-preview/pr-63/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3464":70940,"_30209":70936,"_20922":118698,"_5":14373,"_27447":70936,"_2948":118699},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3464":70941,"_30209":70936,"_20922":118701,"_5":14373,"_27447":118691,"_2948":118702},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3464":70942,"_30209":70936,"_20922":118704,"_5":14373,"_27447":118691,"_2948":118705},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3464":70943,"_30209":70936,"_20922":118707,"_5":14373,"_27447":118691,"_2948":118708},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3464":70944,"_30209":70936,"_20922":118710,"_5":14373,"_27447":118691,"_2948":118711},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3464":70945,"_30209":70936,"_20922":118713,"_5":14373,"_27447":118691,"_2948":118714},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3464":70946,"_30209":70936,"_20922":118716,"_5":14373,"_27447":118695,"_2948":118717},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3464":70947,"_30209":70936,"_20922":118719,"_5":14373,"_27447":118695,"_2948":118720},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3464":70948,"_30209":70936,"_20922":118722,"_5":14373,"_27447":118695,"_2948":118723},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3464":70949,"_30209":70936,"_20922":118725,"_5":14373,"_27447":118695,"_2948":118726},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3464":70950,"_30209":70936,"_20922":118728,"_5":14373,"_27447":118695,"_2948":118729},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3464":70951,"_30209":70936,"_20922":118731,"_5":14373,"_27447":118695,"_2948":118732},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3464":70952,"_30209":70936,"_20922":118734,"_5":14373,"_27447":118695,"_2948":118735},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3464":70953,"_30209":70953,"_5":14725,"_2948":118737,"_30562":118738,"_20922":118739,"_27447":70953},"Dispositivos e identidades",[49276,117725,51765,118737],[],{"_3464":70954,"_30209":70953,"_20922":118741,"_5":14373,"_27447":70953,"_2948":118742},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3464":70955,"_30209":70953,"_5":30559,"_20922":118744,"_27447":118745,"_2948":118746},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3464":70956,"_30209":70953,"_5":30559,"_20922":118748,"_27447":118749,"_2948":118750},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3464":70957,"_30209":70953,"_5":30559,"_20922":118752,"_27447":118753,"_2948":118754},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3464":70958,"_30209":70953,"_5":30559,"_20922":118756,"_27447":118757,"_2948":118758},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3464":70959,"_30209":70953,"_5":30559,"_20922":118760,"_27447":118761,"_2948":118762},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3464":70960,"_30209":70953,"_5":30559,"_20922":118764,"_27447":118765,"_2948":118766},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3464":70961,"_30209":70953,"_5":30559,"_20922":118768,"_27447":118769,"_2948":118770},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3464":70962,"_30209":70953,"_5":30559,"_20922":118772,"_27447":118773,"_2948":118774},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3464":70963,"_30209":70953,"_5":30559,"_20922":118776,"_27447":118777,"_2948":118778},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3464":70964,"_30209":70953,"_5":30559,"_20922":118780,"_27447":118781,"_2948":118782},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3464":70965,"_30209":70953,"_5":30559,"_20922":118784,"_27447":118785,"_2948":118786},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3464":70966,"_30209":70953,"_20922":118788,"_5":14373,"_27447":70953,"_2948":118789},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3464":70967,"_30209":70953,"_20922":118791,"_5":14373,"_27447":70953,"_2948":118792},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3464":70968,"_30209":70953,"_20922":118794,"_5":14373,"_27447":118745,"_2948":118795},[],"Vista operativa",{"_3464":70969,"_30209":70953,"_20922":118797,"_5":14373,"_27447":118745,"_2948":118798},[],"Interpretación",{"_3464":70970,"_30209":70953,"_20922":118800,"_5":14373,"_27447":118745,"_2948":51828},[],{"_3464":70971,"_30209":70953,"_20922":118802,"_5":14373,"_27447":118745,"_2948":118803},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3464":70972,"_30209":70953,"_20922":118805,"_5":14373,"_27447":118745,"_2948":51834},[],{"_3464":70973,"_30209":70953,"_20922":118807,"_5":14373,"_27447":118745,"_2948":118808},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3464":70974,"_30209":70953,"_20922":118810,"_5":14373,"_27447":118745,"_2948":51840},[],{"_3464":70975,"_30209":70953,"_20922":118812,"_5":14373,"_27447":118745,"_2948":118813},[],"La identidad está en la ventana operativa de renovación.",{"_3464":70976,"_30209":70953,"_20922":118815,"_5":14373,"_27447":118745,"_2948":51846},[],{"_3464":70977,"_30209":70953,"_20922":118817,"_5":14373,"_27447":118745,"_2948":118818},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3464":70978,"_30209":70953,"_20922":118820,"_5":14373,"_27447":118745,"_2948":51852},[],{"_3464":70979,"_30209":70953,"_20922":118822,"_5":14373,"_27447":118745,"_2948":118823},[],"La identidad ha vencido.",{"_3464":70980,"_30209":70953,"_20922":118825,"_5":14373,"_27447":118745,"_2948":51858},[],{"_3464":70981,"_30209":70953,"_20922":118827,"_5":14373,"_27447":118745,"_2948":118828},[],"La identidad está marcada como revocada.",{"_3464":70982,"_30209":70953,"_20922":118830,"_5":14373,"_27447":118745,"_2948":51864},[],{"_3464":70983,"_30209":70953,"_20922":118832,"_5":14373,"_27447":118745,"_2948":118833},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3464":70984,"_30209":70953,"_20922":118835,"_5":14373,"_27447":118745,"_2948":118836},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3464":70985,"_30209":70953,"_20922":118838,"_5":14373,"_27447":118749,"_2948":118839},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3464":70986,"_30209":70953,"_20922":118841,"_5":14373,"_27447":118749,"_2948":118842},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3464":70987,"_30209":70953,"_20922":118844,"_5":14373,"_27447":118749,"_2948":118845},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3464":70988,"_30209":70953,"_20922":118847,"_5":14373,"_27447":118749,"_2948":118848},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3464":70989,"_30209":70953,"_20922":118850,"_5":14373,"_27447":118753,"_2948":118851},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3464":70990,"_30209":70953,"_20922":118853,"_5":14373,"_27447":118757,"_2948":118854},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3464":70991,"_30209":70953,"_20922":118856,"_5":14373,"_27447":118761,"_2948":118857},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3464":70992,"_30209":70953,"_20922":118859,"_5":14373,"_27447":118765,"_2948":118860},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3464":70993,"_30209":70953,"_20922":118862,"_5":14373,"_27447":118769,"_2948":118863},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3464":70994,"_30209":70953,"_20922":118865,"_5":14373,"_27447":118769,"_2948":118866},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3464":70995,"_30209":70953,"_20922":118868,"_5":14373,"_27447":118773,"_2948":118869},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3464":70996,"_30209":70953,"_20922":118871,"_5":14373,"_27447":118773,"_2948":118872},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3464":70997,"_30209":70953,"_20922":118874,"_5":14373,"_27447":118773,"_2948":118875},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3464":70998,"_30209":70953,"_20922":118877,"_5":14373,"_27447":118773,"_2948":118878},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3464":70999,"_30209":70953,"_20922":118880,"_5":14373,"_27447":118773,"_2948":118881},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3464":71000,"_30209":70953,"_20922":118883,"_5":14373,"_27447":118773,"_2948":118884},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3464":71001,"_30209":70953,"_20922":118886,"_5":14373,"_27447":118777,"_2948":118887},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3464":71002,"_30209":70953,"_20922":118889,"_5":14373,"_27447":118777,"_2948":118890},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3464":71003,"_30209":70953,"_20922":118892,"_5":14373,"_27447":118781,"_2948":118893},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3464":71004,"_30209":70953,"_20922":118895,"_5":14373,"_27447":118781,"_2948":118896},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3464":71005,"_30209":70953,"_20922":118898,"_5":14373,"_27447":118781,"_2948":118899},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3464":71006,"_30209":70953,"_20922":118901,"_5":14373,"_27447":118781,"_2948":118902},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3464":71007,"_30209":70953,"_20922":118904,"_5":14373,"_27447":118785,"_2948":118905},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3464":71008,"_30209":70953,"_20922":118907,"_5":14373,"_27447":118785,"_2948":118908},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3464":71009,"_30209":71009,"_5":14725,"_2948":118910,"_30562":118911,"_20922":118913,"_27447":71009},"Identidad inicial y autenticación",[49276,117725,51765,118737,118912],"Enrolamiento con PKI",[],{"_3464":71010,"_30209":71009,"_20922":118915,"_5":14373,"_27447":71009,"_2948":118916},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3464":71011,"_30209":71009,"_5":30559,"_20922":118918,"_27447":118919,"_2948":118920},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3464":71012,"_30209":71009,"_5":30559,"_20922":118922,"_27447":118923,"_2948":118924},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3464":71013,"_30209":71009,"_5":30559,"_20922":118926,"_27447":118927,"_2948":118928},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3464":71014,"_30209":71009,"_5":30559,"_20922":118930,"_27447":118931,"_2948":118932},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3464":71015,"_30209":71009,"_5":30559,"_20922":118934,"_27447":118935,"_2948":118936},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3464":71016,"_30209":71009,"_20922":118938,"_5":14373,"_27447":71009,"_2948":118939},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3464":71017,"_30209":71009,"_20922":118941,"_5":14373,"_27447":118919,"_2948":118942},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3464":71018,"_30209":71009,"_20922":118944,"_5":14373,"_27447":118919,"_2948":118945},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3464":71019,"_30209":71009,"_20922":118947,"_5":14373,"_27447":118923,"_2948":118948},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3464":71020,"_30209":71009,"_20922":118950,"_5":14373,"_27447":118923,"_2948":118951},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3464":71021,"_30209":71009,"_20922":118953,"_5":14373,"_27447":118923,"_2948":118954},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3464":71022,"_30209":71009,"_20922":118956,"_5":14373,"_27447":118927,"_2948":118957},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3464":71023,"_30209":71009,"_20922":118959,"_5":14373,"_27447":118927,"_2948":118960},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3464":71024,"_30209":71009,"_20922":118962,"_5":14373,"_27447":118931,"_2948":118963},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3464":71025,"_30209":71009,"_20922":118965,"_5":14373,"_27447":118931,"_2948":118966},[],"Ejemplo de cuerpo:",{"_3464":71026,"_30209":71009,"_20922":118968,"_5":14373,"_27447":118931,"_2948":118969},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3464":71027,"_30209":71009,"_20922":118971,"_5":14373,"_27447":118931,"_2948":118972},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3464":71028,"_30209":71009,"_20922":118974,"_5":14373,"_27447":118931,"_2948":118975},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3464":71029,"_30209":71009,"_20922":118977,"_5":14373,"_27447":118931,"_2948":118978},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3464":71030,"_30209":71009,"_20922":118980,"_5":14373,"_27447":118935,"_2948":118981},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3464":71031,"_30209":71009,"_20922":118983,"_5":14373,"_27447":118935,"_2948":118984},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3464":71032,"_30209":71032,"_5":14725,"_2948":118986,"_30562":118987,"_20922":118988,"_27447":71032},"Configura y opera el DMS",[49276,117725,51765,118737,118912],[],{"_3464":71033,"_30209":71032,"_20922":118990,"_5":14373,"_27447":71032,"_2948":118991},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3464":71034,"_30209":71032,"_5":30559,"_20922":118993,"_27447":118994,"_2948":116296},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3464":71035,"_30209":71032,"_5":30559,"_20922":118996,"_27447":118997,"_2948":118998},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3464":71036,"_30209":71032,"_5":30559,"_20922":119000,"_27447":119001,"_2948":119002},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3464":71037,"_30209":71032,"_5":30559,"_20922":119004,"_27447":119005,"_2948":119006},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3464":71038,"_30209":71032,"_5":30559,"_20922":119008,"_27447":119009,"_2948":119010},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3464":71039,"_30209":71032,"_5":30559,"_20922":119012,"_27447":119013,"_2948":119014},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3464":71040,"_30209":71032,"_5":30559,"_20922":119016,"_27447":119017,"_2948":119018},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3464":71041,"_30209":71032,"_5":30559,"_20922":119020,"_27447":119021,"_2948":119022},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3464":71042,"_30209":71032,"_5":30559,"_20922":119024,"_27447":119025,"_2948":52060},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3464":71043,"_30209":71032,"_5":30559,"_20922":119027,"_27447":119028,"_2948":52064},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3464":71044,"_30209":71032,"_5":30559,"_20922":119030,"_27447":119031,"_2948":119032},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3464":71045,"_30209":71032,"_5":30559,"_20922":119034,"_27447":119035,"_2948":119036},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3464":71046,"_30209":71032,"_5":30559,"_20922":119038,"_27447":119039,"_2948":119040},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3464":71047,"_30209":71032,"_5":30559,"_20922":119042,"_27447":119043,"_2948":119044},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3464":71048,"_30209":71032,"_5":30559,"_20922":119046,"_27447":119047,"_2948":52084},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3464":71049,"_30209":71032,"_5":30559,"_20922":119049,"_27447":119050,"_2948":119051},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3464":71050,"_30209":71032,"_5":30559,"_20922":119053,"_27447":119054,"_2948":119055},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3464":71051,"_30209":71032,"_5":30559,"_20922":119057,"_27447":119058,"_2948":119059},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3464":71052,"_30209":71032,"_20922":119061,"_5":14373,"_27447":71032,"_2948":119062},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3464":71053,"_30209":71032,"_20922":119064,"_5":14373,"_27447":118994,"_2948":119065},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3464":71054,"_30209":71032,"_20922":119067,"_5":14373,"_27447":118994,"_2948":119068},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3464":71055,"_30209":71032,"_20922":119070,"_5":14373,"_27447":119001,"_2948":119071},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3464":71056,"_30209":71032,"_20922":119073,"_5":14373,"_27447":119005,"_2948":119074},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3464":71057,"_30209":71032,"_20922":119076,"_5":14373,"_27447":119009,"_2948":119077},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3464":71058,"_30209":71032,"_20922":119079,"_5":14373,"_27447":119013,"_2948":119080},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3464":71059,"_30209":71032,"_20922":119082,"_5":14373,"_27447":119017,"_2948":119083},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3464":71060,"_30209":71032,"_20922":119085,"_5":14373,"_27447":119025,"_2948":119086},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3464":71061,"_30209":71032,"_20922":119088,"_5":14373,"_27447":119025,"_2948":119089},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3464":71062,"_30209":71032,"_20922":119091,"_5":14373,"_27447":119028,"_2948":119092},[],"Campo de `settings.enrollment_settings`",{"_3464":71063,"_30209":71032,"_20922":119094,"_5":14373,"_27447":119028,"_2948":119095},[],"Decisión",{"_3464":71064,"_30209":71032,"_20922":119097,"_5":14373,"_27447":119028,"_2948":52135},[],{"_3464":71065,"_30209":71032,"_20922":119099,"_5":14373,"_27447":119028,"_2948":119100},[],"`EST_RFC7030` para estas operaciones.",{"_3464":71066,"_30209":71032,"_20922":119102,"_5":14373,"_27447":119028,"_2948":52141},[],{"_3464":71067,"_30209":71032,"_20922":119104,"_5":14373,"_27447":119028,"_2948":119105},[],"ID de la CA que firmará.",{"_3464":71068,"_30209":71032,"_20922":119107,"_5":14373,"_27447":119028,"_2948":52147},[],{"_3464":71069,"_30209":71032,"_20922":119109,"_5":14373,"_27447":119028,"_2948":119110},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3464":71070,"_30209":71032,"_20922":119112,"_5":14373,"_27447":119028,"_2948":52153},[],{"_3464":71071,"_30209":71032,"_20922":119114,"_5":14373,"_27447":119028,"_2948":119115},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3464":71072,"_30209":71032,"_20922":119117,"_5":14373,"_27447":119028,"_2948":52159},[],{"_3464":71073,"_30209":71032,"_20922":119119,"_5":14373,"_27447":119028,"_2948":119120},[],"Uno de los cuatro modos de autenticación.",{"_3464":71074,"_30209":71032,"_20922":119122,"_5":14373,"_27447":119028,"_2948":119123},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3464":71075,"_30209":71032,"_20922":119125,"_5":14373,"_27447":119031,"_2948":119126},[],"Los bloques son independientes:",{"_3464":71076,"_30209":71032,"_20922":119128,"_5":14373,"_27447":119031,"_2948":119129},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3464":71077,"_30209":71032,"_20922":119131,"_5":14373,"_27447":119031,"_2948":119132},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3464":71078,"_30209":71032,"_20922":119134,"_5":14373,"_27447":119031,"_2948":52177},[],{"_3464":71079,"_30209":71032,"_20922":119136,"_5":14373,"_27447":119031,"_2948":119137},[],"Control aplicado en la operación configurada",{"_3464":71080,"_30209":71032,"_20922":119139,"_5":14373,"_27447":119031,"_2948":52183},[],{"_3464":71081,"_30209":71032,"_20922":119141,"_5":14373,"_27447":119031,"_2948":119142},[],"Validación del certificado presentado.",{"_3464":71082,"_30209":71032,"_20922":119144,"_5":14373,"_27447":119031,"_2948":52189},[],{"_3464":71083,"_30209":71032,"_20922":119146,"_5":14373,"_27447":119031,"_2948":119147},[],"Autorización del webhook configurado.",{"_3464":71084,"_30209":71032,"_20922":119149,"_5":14373,"_27447":119031,"_2948":52195},[],{"_3464":71085,"_30209":71032,"_20922":119151,"_5":14373,"_27447":119031,"_2948":119152},[],"Validación del certificado y, después, aprobación del webhook.",{"_3464":71086,"_30209":71032,"_20922":119154,"_5":14373,"_27447":119031,"_2948":52201},[],{"_3464":71087,"_30209":71032,"_20922":119156,"_5":14373,"_27447":119031,"_2948":119157},[],"Sin autenticación del solicitante por el DMS.",{"_3464":71088,"_30209":71032,"_20922":119159,"_5":14373,"_27447":119031,"_2948":119160},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3464":71089,"_30209":71032,"_20922":119162,"_5":14373,"_27447":119031,"_2948":119163},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3464":71090,"_30209":71032,"_20922":119165,"_5":14373,"_27447":119031,"_2948":119166},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3464":71091,"_30209":71032,"_20922":119168,"_5":14373,"_27447":119031,"_2948":119169},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3464":71092,"_30209":71032,"_20922":119171,"_5":14373,"_27447":119035,"_2948":119172},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3464":71093,"_30209":71032,"_20922":119174,"_5":14373,"_27447":119035,"_2948":119175},[],"Campo de `external_webhook_settings`",{"_3464":71094,"_30209":71032,"_20922":119177,"_5":14373,"_27447":119035,"_2948":119095},[],{"_3464":71095,"_30209":71032,"_20922":119179,"_5":14373,"_27447":119035,"_2948":52227},[],{"_3464":71096,"_30209":71032,"_20922":119181,"_5":14373,"_27447":119035,"_2948":119182},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3464":71097,"_30209":71032,"_20922":119184,"_5":14373,"_27447":119035,"_2948":52233},[],{"_3464":71098,"_30209":71032,"_20922":119186,"_5":14373,"_27447":119035,"_2948":119187},[],"`POST` o `PUT`; `POST` por defecto.",{"_3464":71099,"_30209":71032,"_20922":119189,"_5":14373,"_27447":119035,"_2948":52239},[],{"_3464":71100,"_30209":71032,"_20922":119191,"_5":14373,"_27447":119035,"_2948":119192},[],"Etiqueta usada en los logs del servicio.",{"_3464":71101,"_30209":71032,"_20922":119194,"_5":14373,"_27447":119035,"_2948":52245},[],{"_3464":71102,"_30209":71032,"_20922":119196,"_5":14373,"_27447":119035,"_2948":119197},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3464":71103,"_30209":71032,"_20922":119199,"_5":14373,"_27447":119035,"_2948":52251},[],{"_3464":71104,"_30209":71032,"_20922":119201,"_5":14373,"_27447":119035,"_2948":119202},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3464":71105,"_30209":71032,"_20922":119204,"_5":14373,"_27447":119035,"_2948":52257},[],{"_3464":71106,"_30209":71032,"_20922":119206,"_5":14373,"_27447":119035,"_2948":119207},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3464":71107,"_30209":71032,"_20922":119209,"_5":14373,"_27447":119035,"_2948":52263},[],{"_3464":71108,"_30209":71032,"_20922":119211,"_5":14373,"_27447":119035,"_2948":119212},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3464":71109,"_30209":71032,"_20922":119214,"_5":14373,"_27447":119035,"_2948":52269},[],{"_3464":71110,"_30209":71032,"_20922":119216,"_5":14373,"_27447":119035,"_2948":119217},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3464":71111,"_30209":71032,"_20922":119219,"_5":14373,"_27447":119035,"_2948":52275},[],{"_3464":71112,"_30209":71032,"_20922":119221,"_5":14373,"_27447":119035,"_2948":119222},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3464":71113,"_30209":71032,"_20922":119224,"_5":14373,"_27447":119035,"_2948":52281},[],{"_3464":71114,"_30209":71032,"_20922":119226,"_5":14373,"_27447":119035,"_2948":119227},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3464":71115,"_30209":71032,"_20922":119229,"_5":14373,"_27447":119035,"_2948":119230},[],"Reglas de esa configuración:",{"_3464":71116,"_30209":71032,"_20922":119232,"_5":14373,"_27447":119035,"_2948":119233},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3464":71117,"_30209":71032,"_20922":119235,"_5":14373,"_27447":119035,"_2948":119236},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3464":71118,"_30209":71032,"_20922":119238,"_5":14373,"_27447":119035,"_2948":119239},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3464":71119,"_30209":71032,"_20922":119241,"_5":14373,"_27447":119035,"_2948":119242},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3464":71120,"_30209":71032,"_20922":119244,"_5":14373,"_27447":119035,"_2948":119245},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3464":71121,"_30209":71032,"_20922":119247,"_5":14373,"_27447":119035,"_2948":119248},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3464":71122,"_30209":71032,"_20922":119250,"_5":14373,"_27447":119035,"_2948":119251},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3464":71123,"_30209":71032,"_20922":119253,"_5":14373,"_27447":119035,"_2948":119254},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3464":71124,"_30209":71032,"_20922":119256,"_5":14373,"_27447":119035,"_2948":119257},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3464":71125,"_30209":71032,"_20922":119259,"_5":14373,"_27447":119039,"_2948":119260},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3464":71126,"_30209":71032,"_20922":119262,"_5":14373,"_27447":119043,"_2948":119263},[],"Campo de `settings.reenrollment_settings`",{"_3464":71127,"_30209":71032,"_20922":119265,"_5":14373,"_27447":119043,"_2948":119266},[],"Función",{"_3464":71128,"_30209":71032,"_20922":119268,"_5":14373,"_27447":119043,"_2948":52325},[],{"_3464":71129,"_30209":71032,"_20922":119270,"_5":14373,"_27447":119043,"_2948":119271},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3464":71130,"_30209":71032,"_20922":119273,"_5":14373,"_27447":119043,"_2948":52331},[],{"_3464":71131,"_30209":71032,"_20922":119275,"_5":14373,"_27447":119043,"_2948":119276},[],"Umbral operativo preventivo de monitorización.",{"_3464":71132,"_30209":71032,"_20922":119278,"_5":14373,"_27447":119043,"_2948":52337},[],{"_3464":71133,"_30209":71032,"_20922":119280,"_5":14373,"_27447":119043,"_2948":119281},[],"Umbral operativo crítico de monitorización.",{"_3464":71134,"_30209":71032,"_20922":119283,"_5":14373,"_27447":119043,"_2948":52343},[],{"_3464":71135,"_30209":71032,"_20922":119285,"_5":14373,"_27447":119043,"_2948":119286},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3464":71136,"_30209":71032,"_20922":119288,"_5":14373,"_27447":119043,"_2948":52349},[],{"_3464":71137,"_30209":71032,"_20922":119290,"_5":14373,"_27447":119043,"_2948":119291},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3464":71138,"_30209":71032,"_20922":119293,"_5":14373,"_27447":119043,"_2948":52355},[],{"_3464":71139,"_30209":71032,"_20922":119295,"_5":14373,"_27447":119043,"_2948":119296},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3464":71140,"_30209":71032,"_20922":119298,"_5":14373,"_27447":119043,"_2948":119299},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3464":71141,"_30209":71032,"_20922":119301,"_5":14373,"_27447":119047,"_2948":119302},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3464":71142,"_30209":71032,"_20922":119304,"_5":14373,"_27447":119050,"_2948":116660},[],{"_3464":71143,"_30209":71032,"_20922":119306,"_5":14373,"_27447":119050,"_2948":119307},[],"Qué publica",{"_3464":71144,"_30209":71032,"_20922":119309,"_5":14373,"_27447":119050,"_2948":52372},[],{"_3464":71145,"_30209":71032,"_20922":119311,"_5":14373,"_27447":119050,"_2948":119312},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3464":71146,"_30209":71032,"_20922":119314,"_5":14373,"_27447":119050,"_2948":52378},[],{"_3464":71147,"_30209":71032,"_20922":119316,"_5":14373,"_27447":119050,"_2948":119317},[],"Certificado de la CA emisora seleccionada.",{"_3464":71148,"_30209":71032,"_20922":119319,"_5":14373,"_27447":119050,"_2948":52384},[],{"_3464":71149,"_30209":71032,"_20922":119321,"_5":14373,"_27447":119050,"_2948":119322},[],"Certificados de las CAs elegidas explícitamente.",{"_3464":71150,"_30209":71032,"_20922":119324,"_5":14373,"_27447":119050,"_2948":119325},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3464":71151,"_30209":71032,"_20922":119327,"_5":14373,"_27447":119054,"_2948":119328},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3464":71152,"_30209":71032,"_20922":119330,"_5":14373,"_27447":119054,"_2948":119331},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3464":71153,"_30209":71032,"_20922":119333,"_5":14373,"_27447":119054,"_2948":119334},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3464":71154,"_30209":71032,"_20922":119336,"_5":14373,"_27447":119058,"_2948":119337},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3464":71155,"_30209":71155,"_5":14725,"_2948":119339,"_30562":119340,"_20922":119341,"_27447":71155},"Integra el cliente EST",[49276,117725,51765,118737,118912],[],{"_3464":71156,"_30209":71155,"_20922":119343,"_5":14373,"_27447":71155,"_2948":119344},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3464":71157,"_30209":71155,"_5":30559,"_20922":119346,"_27447":119347,"_2948":116296},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3464":71158,"_30209":71155,"_5":30559,"_20922":119349,"_27447":119350,"_2948":119351},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3464":71159,"_30209":71155,"_5":30559,"_20922":119353,"_27447":119354,"_2948":119355},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3464":71160,"_30209":71155,"_5":30559,"_20922":119357,"_27447":119358,"_2948":119359},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3464":71161,"_30209":71155,"_5":30559,"_20922":119361,"_27447":119362,"_2948":119363},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3464":71162,"_30209":71155,"_5":30559,"_20922":119365,"_27447":119366,"_2948":119367},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3464":71163,"_30209":71155,"_20922":119369,"_5":14373,"_27447":71155,"_2948":119370},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3464":71164,"_30209":71155,"_20922":119372,"_5":14373,"_27447":119347,"_2948":119373},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3464":71165,"_30209":71155,"_20922":119375,"_5":14373,"_27447":119347,"_2948":119376},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3464":71166,"_30209":71155,"_20922":119378,"_5":14373,"_27447":119347,"_2948":119379},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3464":71167,"_30209":71155,"_20922":119381,"_5":14373,"_27447":119350,"_2948":119382},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3464":71168,"_30209":71155,"_20922":119384,"_5":14373,"_27447":119350,"_2948":119385},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3464":71169,"_30209":71155,"_20922":119387,"_5":14373,"_27447":119354,"_2948":119388},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3464":71170,"_30209":71155,"_20922":119390,"_5":14373,"_27447":119354,"_2948":119391},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3464":71171,"_30209":71155,"_20922":119393,"_5":14373,"_27447":119358,"_2948":119394},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3464":71172,"_30209":71155,"_20922":119396,"_5":14373,"_27447":119358,"_2948":119397},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3464":71173,"_30209":71155,"_20922":119399,"_5":14373,"_27447":119362,"_2948":119400},[],"Para el caso de una raíz que emite directamente:",{"_3464":71174,"_30209":71155,"_20922":119402,"_5":14373,"_27447":119362,"_2948":119403},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3464":71175,"_30209":71155,"_20922":119405,"_5":14373,"_27447":119362,"_2948":119406},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3464":71176,"_30209":71155,"_20922":119408,"_5":14373,"_27447":119366,"_2948":119409},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3464":71177,"_30209":71177,"_5":14725,"_2948":119411,"_30562":119412,"_20922":119413,"_27447":71177},"Referencia EST",[49276,117725,51765,118737,118912],[],{"_3464":71178,"_30209":71177,"_20922":119415,"_5":14373,"_27447":71177,"_2948":119416},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3464":71179,"_30209":71177,"_5":30559,"_20922":119418,"_27447":119419,"_2948":119420},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3464":71180,"_30209":71177,"_5":30559,"_20922":119422,"_27447":119423,"_2948":22673},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3464":71181,"_30209":71177,"_5":30559,"_20922":119425,"_27447":119426,"_2948":26050},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3464":71182,"_30209":71177,"_5":30559,"_20922":119428,"_27447":119429,"_2948":26057},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3464":71183,"_30209":71177,"_5":30559,"_20922":119431,"_27447":119432,"_2948":25376},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3464":71184,"_30209":71177,"_5":30559,"_20922":119434,"_27447":119435,"_2948":119436},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3464":71185,"_30209":71177,"_5":30559,"_20922":119438,"_27447":119439,"_2948":119440},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3464":71186,"_30209":71177,"_5":30559,"_20922":119442,"_27447":119443,"_2948":119444},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3464":71187,"_30209":71177,"_20922":119446,"_5":14373,"_27447":71177,"_2948":119447},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3464":71188,"_30209":71177,"_20922":119449,"_5":14373,"_27447":119419,"_2948":119450},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3464":71189,"_30209":71177,"_20922":119452,"_5":14373,"_27447":119419,"_2948":117485},[],{"_3464":71190,"_30209":71177,"_20922":119454,"_5":14373,"_27447":119419,"_2948":119455},[],"Método",{"_3464":71191,"_30209":71177,"_20922":119457,"_5":14373,"_27447":119419,"_2948":119458},[],"Autenticación y condición",{"_3464":71192,"_30209":71177,"_20922":119460,"_5":14373,"_27447":119419,"_2948":52527},[],{"_3464":71193,"_30209":71177,"_20922":119462,"_5":14373,"_27447":119419,"_2948":52530},[],{"_3464":71194,"_30209":71177,"_20922":119464,"_5":14373,"_27447":119419,"_2948":119465},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3464":71195,"_30209":71177,"_20922":119467,"_5":14373,"_27447":119419,"_2948":52536},[],{"_3464":71196,"_30209":71177,"_20922":119469,"_5":14373,"_27447":119419,"_2948":52539},[],{"_3464":71197,"_30209":71177,"_20922":119471,"_5":14373,"_27447":119419,"_2948":119472},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3464":71198,"_30209":71177,"_20922":119474,"_5":14373,"_27447":119419,"_2948":52545},[],{"_3464":71199,"_30209":71177,"_20922":119476,"_5":14373,"_27447":119419,"_2948":52539},[],{"_3464":71200,"_30209":71177,"_20922":119478,"_5":14373,"_27447":119419,"_2948":119479},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3464":71201,"_30209":71177,"_20922":119481,"_5":14373,"_27447":119419,"_2948":52553},[],{"_3464":71202,"_30209":71177,"_20922":119483,"_5":14373,"_27447":119419,"_2948":52539},[],{"_3464":71203,"_30209":71177,"_20922":119485,"_5":14373,"_27447":119419,"_2948":119486},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3464":71204,"_30209":71177,"_20922":119488,"_5":14373,"_27447":119419,"_2948":119489},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3464":71205,"_30209":71177,"_20922":119491,"_5":14373,"_27447":119423,"_2948":119492},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3464":71206,"_30209":71177,"_20922":119494,"_5":14373,"_27447":119423,"_2948":119495},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3464":71207,"_30209":71177,"_20922":119497,"_5":14373,"_27447":119426,"_2948":119498},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3464":71208,"_30209":71177,"_20922":119500,"_5":14373,"_27447":119426,"_2948":119501},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3464":71209,"_30209":71177,"_20922":119503,"_5":14373,"_27447":119429,"_2948":119504},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3464":71210,"_30209":71177,"_20922":119506,"_5":14373,"_27447":119429,"_2948":119507},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3464":71211,"_30209":71177,"_20922":119509,"_5":14373,"_27447":119432,"_2948":119510},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3464":71212,"_30209":71177,"_20922":119512,"_5":14373,"_27447":119432,"_2948":119513},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3464":71213,"_30209":71177,"_20922":119515,"_5":14373,"_27447":119435,"_2948":119516},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3464":71214,"_30209":71177,"_20922":119518,"_5":14373,"_27447":119435,"_2948":119519},[],"Parte",{"_3464":71215,"_30209":71177,"_20922":119521,"_5":14373,"_27447":119435,"_2948":119522},[],"Contenido tras decodificar su Base64",{"_3464":71216,"_30209":71177,"_20922":119524,"_5":14373,"_27447":119435,"_2948":52597},[],{"_3464":71217,"_30209":71177,"_20922":119526,"_5":14373,"_27447":119435,"_2948":119527},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3464":71218,"_30209":71177,"_20922":119529,"_5":14373,"_27447":119435,"_2948":52603},[],{"_3464":71219,"_30209":71177,"_20922":119531,"_5":14373,"_27447":119435,"_2948":119532},[],"PKCS#7 DER con el certificado emitido.",{"_3464":71220,"_30209":71177,"_20922":119534,"_5":14373,"_27447":119435,"_2948":119535},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3464":71221,"_30209":71177,"_20922":119537,"_5":14373,"_27447":119439,"_2948":119538},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3464":71222,"_30209":71177,"_20922":119540,"_5":14373,"_27447":119439,"_2948":119541},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3464":71223,"_30209":71177,"_20922":119543,"_5":14373,"_27447":119439,"_2948":119544},[],"Convierte y comprueba el resultado:",{"_3464":71224,"_30209":71177,"_20922":119546,"_5":14373,"_27447":119439,"_2948":119547},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3464":71225,"_30209":71177,"_20922":119549,"_5":14373,"_27447":119443,"_2948":119550},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3464":71226,"_30209":71177,"_20922":119552,"_5":14373,"_27447":119443,"_2948":119553},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3464":71227,"_30209":71227,"_5":14725,"_2948":118912,"_30562":119555,"_20922":119556,"_27447":71227},[49276,117725,51765,118737,118912],[],{"_3464":71228,"_30209":71227,"_20922":119558,"_5":14373,"_27447":71227,"_2948":119559},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3464":71229,"_30209":71227,"_5":30559,"_20922":119561,"_27447":119562,"_2948":119563},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3464":71230,"_30209":71227,"_5":30559,"_20922":119565,"_27447":119566,"_2948":119567},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3464":71231,"_30209":71227,"_5":30559,"_20922":119569,"_27447":119570,"_2948":119571},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3464":71232,"_30209":71227,"_5":30559,"_20922":119573,"_27447":119574,"_2948":119575},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3464":71233,"_30209":71227,"_20922":119577,"_5":14373,"_27447":71227,"_2948":119578},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3464":71234,"_30209":71227,"_20922":119580,"_5":14373,"_27447":119562,"_2948":119581},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3464":71235,"_30209":71227,"_20922":119583,"_5":14373,"_27447":119562,"_2948":119584},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3464":71236,"_30209":71227,"_20922":119586,"_5":14373,"_27447":119562,"_2948":119587},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3464":71237,"_30209":71227,"_20922":119589,"_5":14373,"_27447":119562,"_2948":119590},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3464":71238,"_30209":71227,"_20922":119592,"_5":14373,"_27447":119562,"_2948":119593},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3464":71239,"_30209":71227,"_20922":119595,"_5":14373,"_27447":119562,"_2948":119596},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3464":71240,"_30209":71227,"_20922":119598,"_5":14373,"_27447":119566,"_2948":119599},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3464":71241,"_30209":71227,"_20922":119601,"_5":14373,"_27447":119566,"_2948":119602},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":71242,"_30209":71227,"_20922":119604,"_5":14373,"_27447":119566,"_2948":119605},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3464":71243,"_30209":71227,"_20922":119607,"_5":14373,"_27447":119566,"_2948":119608},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3464":71244,"_30209":71227,"_20922":119610,"_5":14373,"_27447":119570,"_2948":119611},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3464":71245,"_30209":71227,"_20922":119613,"_5":14373,"_27447":119570,"_2948":119614},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3464":71246,"_30209":71227,"_20922":119616,"_5":14373,"_27447":119570,"_2948":119617},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3464":71247,"_30209":71227,"_20922":119619,"_5":14373,"_27447":119570,"_2948":119620},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3464":71248,"_30209":71227,"_20922":119622,"_5":14373,"_27447":119574,"_2948":119623},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3464":71249,"_30209":71227,"_20922":119625,"_5":14373,"_27447":119574,"_2948":119626},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3464":71250,"_30209":71250,"_5":14725,"_2948":119628,"_30562":119629,"_20922":119630,"_27447":71250},"Estrategias de aprovisionamiento",[49276,117725,51765,118737,118912],[],{"_3464":71251,"_30209":71250,"_20922":119632,"_5":14373,"_27447":71250,"_2948":119633},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3464":71252,"_30209":71250,"_5":30559,"_20922":119635,"_27447":119636,"_2948":119637},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3464":71253,"_30209":71250,"_5":30559,"_20922":119639,"_27447":119640,"_2948":119641},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3464":71254,"_30209":71250,"_5":30559,"_20922":119643,"_27447":119644,"_2948":119645},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3464":71255,"_30209":71250,"_5":30559,"_20922":119647,"_27447":119648,"_2948":119649},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3464":71256,"_30209":71250,"_5":30559,"_20922":119651,"_27447":119652,"_2948":119653},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3464":71257,"_30209":71250,"_20922":119655,"_5":14373,"_27447":71250,"_2948":119656},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3464":71258,"_30209":71250,"_20922":119658,"_5":14373,"_27447":119636,"_2948":119659},[],"Recorrido",{"_3464":71259,"_30209":71250,"_20922":119661,"_5":14373,"_27447":119636,"_2948":119662},[],"Cuándo existe el dispositivo",{"_3464":71260,"_30209":71250,"_20922":119664,"_5":14373,"_27447":119636,"_2948":119665},[],"Qué compruebas",{"_3464":71261,"_30209":71250,"_20922":119667,"_5":14373,"_27447":119636,"_2948":119668},[],"Asignación manual",{"_3464":71262,"_30209":71250,"_20922":119670,"_5":14373,"_27447":119636,"_2948":119671},[],"El operador lo crea antes de asociar un certificado.",{"_3464":71263,"_30209":71250,"_20922":119673,"_5":14373,"_27447":119636,"_2948":119674},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3464":71264,"_30209":71250,"_20922":119676,"_5":14373,"_27447":119636,"_2948":119677},[],"EST con `JITP`",{"_3464":71265,"_30209":71250,"_20922":119679,"_5":14373,"_27447":119636,"_2948":119680},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3464":71266,"_30209":71250,"_20922":119682,"_5":14373,"_27447":119636,"_2948":119683},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3464":71267,"_30209":71250,"_20922":119685,"_5":14373,"_27447":119636,"_2948":119686},[],"EST con `PRE_REGISTRATION`",{"_3464":71268,"_30209":71250,"_20922":119688,"_5":14373,"_27447":119636,"_2948":119689},[],"Debe existir antes de `/simpleenroll`.",{"_3464":71269,"_30209":71250,"_20922":119691,"_5":14373,"_27447":119636,"_2948":119692},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3464":71270,"_30209":71250,"_20922":119694,"_5":14373,"_27447":119636,"_2948":119695},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3464":71271,"_30209":71250,"_20922":119697,"_5":14373,"_27447":119636,"_2948":119698},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3464":71272,"_30209":71250,"_20922":119700,"_5":14373,"_27447":119640,"_2948":119701},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3464":71273,"_30209":71250,"_20922":119703,"_5":14373,"_27447":119640,"_2948":119704},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3464":71274,"_30209":71250,"_20922":119706,"_5":14373,"_27447":119640,"_2948":119707},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3464":71275,"_30209":71250,"_20922":119709,"_5":14373,"_27447":119644,"_2948":119710},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3464":71276,"_30209":71250,"_20922":119712,"_5":14373,"_27447":119644,"_2948":119713},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3464":71277,"_30209":71250,"_20922":119715,"_5":14373,"_27447":119644,"_2948":119716},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3464":71278,"_30209":71250,"_20922":119718,"_5":14373,"_27447":119644,"_2948":119719},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3464":71279,"_30209":71250,"_20922":119721,"_5":14373,"_27447":119644,"_2948":119722},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3464":71280,"_30209":71250,"_20922":119724,"_5":14373,"_27447":119644,"_2948":119725},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3464":71281,"_30209":71250,"_20922":119727,"_5":14373,"_27447":119648,"_2948":116660},[],{"_3464":71282,"_30209":71250,"_20922":119729,"_5":14373,"_27447":119648,"_2948":119730},[],"Material que atraviesa EST",{"_3464":71283,"_30209":71250,"_20922":119732,"_5":14373,"_27447":119648,"_2948":119733},[],"Clave generada por el dispositivo",{"_3464":71284,"_30209":71250,"_20922":119735,"_5":14373,"_27447":119648,"_2948":119736},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3464":71285,"_30209":71250,"_20922":119738,"_5":14373,"_27447":119648,"_2948":119739},[],"Clave ya disponible en el dispositivo",{"_3464":71286,"_30209":71250,"_20922":119741,"_5":14373,"_27447":119648,"_2948":119742},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3464":71287,"_30209":71250,"_20922":119744,"_5":14373,"_27447":119648,"_2948":52084},[],{"_3464":71288,"_30209":71250,"_20922":119746,"_5":14373,"_27447":119648,"_2948":119747},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3464":71289,"_30209":71250,"_20922":119749,"_5":14373,"_27447":119648,"_2948":119750},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3464":71290,"_30209":71250,"_20922":119752,"_5":14373,"_27447":119652,"_2948":119753},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3464":71291,"_30209":71291,"_5":14725,"_2948":119755,"_30562":119756,"_20922":119757,"_27447":71291},"Renovación y recuperación",[49276,117725,51765,118737,118912],[],{"_3464":71292,"_30209":71291,"_20922":119759,"_5":14373,"_27447":71291,"_2948":119760},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3464":71293,"_30209":71291,"_5":30559,"_20922":119762,"_27447":119763,"_2948":119764},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3464":71294,"_30209":71291,"_5":30559,"_20922":119766,"_27447":119767,"_2948":119768},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3464":71295,"_30209":71291,"_5":30559,"_20922":119770,"_27447":119771,"_2948":119772},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3464":71296,"_30209":71291,"_5":30559,"_20922":119774,"_27447":119775,"_2948":119776},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3464":71297,"_30209":71291,"_5":30559,"_20922":119778,"_27447":119779,"_2948":119780},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3464":71298,"_30209":71291,"_20922":119782,"_5":14373,"_27447":71291,"_2948":119783},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3464":71299,"_30209":71291,"_20922":119785,"_5":14373,"_27447":119763,"_2948":119786},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3464":71300,"_30209":71291,"_20922":119788,"_5":14373,"_27447":119763,"_2948":119789},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3464":71301,"_30209":71291,"_20922":119791,"_5":14373,"_27447":119763,"_2948":119792},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3464":71302,"_30209":71291,"_20922":119794,"_5":14373,"_27447":119763,"_2948":119795},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3464":71303,"_30209":71291,"_20922":119797,"_5":14373,"_27447":119767,"_2948":119798},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3464":71304,"_30209":71291,"_20922":119800,"_5":14373,"_27447":119767,"_2948":119801},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3464":71305,"_30209":71291,"_20922":119803,"_5":14373,"_27447":119771,"_2948":119804},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3464":71306,"_30209":71291,"_20922":119806,"_5":14373,"_27447":119771,"_2948":119807},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3464":71307,"_30209":71291,"_20922":119809,"_5":14373,"_27447":119771,"_2948":119810},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3464":71308,"_30209":71291,"_20922":119812,"_5":14373,"_27447":119775,"_2948":119813},[],"Situación",{"_3464":71309,"_30209":71291,"_20922":119815,"_5":14373,"_27447":119775,"_2948":119816},[],"Procedimiento",{"_3464":71310,"_30209":71291,"_20922":119818,"_5":14373,"_27447":119775,"_2948":119819},[],"Certificado vigente, fuera de ventana",{"_3464":71311,"_30209":71291,"_20922":119821,"_5":14373,"_27447":119775,"_2948":119822},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3464":71312,"_30209":71291,"_20922":119824,"_5":14373,"_27447":119775,"_2948":119825},[],"Certificado vencido, clave disponible",{"_3464":71313,"_30209":71291,"_20922":119827,"_5":14373,"_27447":119775,"_2948":119828},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3464":71314,"_30209":71291,"_20922":119830,"_5":14373,"_27447":119775,"_2948":119831},[],"Renovación por webhook o `NO_AUTH`",{"_3464":71315,"_30209":71291,"_20922":119833,"_5":14373,"_27447":119775,"_2948":119834},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3464":71316,"_30209":71291,"_20922":119836,"_5":14373,"_27447":119775,"_2948":119837},[],"Clave perdida o inaccesible",{"_3464":71317,"_30209":71291,"_20922":119839,"_5":14373,"_27447":119775,"_2948":119840},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3464":71318,"_30209":71291,"_20922":119842,"_5":14373,"_27447":119775,"_2948":119843},[],"Identidad actual revocada",{"_3464":71319,"_30209":71291,"_20922":119845,"_5":14373,"_27447":119775,"_2948":119846},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3464":71320,"_30209":71291,"_20922":119848,"_5":14373,"_27447":119775,"_2948":119849},[],"Dispositivo sin identidad",{"_3464":71321,"_30209":71291,"_20922":119851,"_5":14373,"_27447":119775,"_2948":119852},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3464":71322,"_30209":71291,"_20922":119854,"_5":14373,"_27447":119775,"_2948":119855},[],"Dispositivo retirado",{"_3464":71323,"_30209":71291,"_20922":119857,"_5":14373,"_27447":119775,"_2948":119858},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3464":71324,"_30209":71291,"_20922":119860,"_5":14373,"_27447":119775,"_2948":119861},[],"Timeout, HTTP 500 o fallo de instalación",{"_3464":71325,"_30209":71291,"_20922":119863,"_5":14373,"_27447":119775,"_2948":119864},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3464":71326,"_30209":71291,"_20922":119866,"_5":14373,"_27447":119779,"_2948":119867},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3464":71327,"_30209":71291,"_20922":119869,"_5":14373,"_27447":119779,"_2948":119870},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3464":71328,"_30209":71328,"_5":14725,"_2948":119872,"_30562":119873,"_20922":119874,"_27447":71328},"Diagnóstico de enrolamiento",[49276,117725,51765,118737,118912],[],{"_3464":71329,"_30209":71328,"_20922":119876,"_5":14373,"_27447":71328,"_2948":119877},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3464":71330,"_30209":71328,"_5":30559,"_20922":119879,"_27447":119880,"_2948":119881},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3464":71331,"_30209":71328,"_5":30559,"_20922":119883,"_27447":119884,"_2948":119885},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3464":71332,"_30209":71328,"_5":30559,"_20922":119887,"_27447":119888,"_2948":119444},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3464":71333,"_30209":71328,"_5":30559,"_20922":119890,"_27447":119891,"_2948":119892},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3464":71334,"_30209":71328,"_20922":119894,"_5":14373,"_27447":71328,"_2948":119895},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3464":71335,"_30209":71328,"_20922":119897,"_5":14373,"_27447":119884,"_2948":119898},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3464":71336,"_30209":71328,"_20922":119900,"_5":14373,"_27447":119884,"_2948":119901},[],"Síntoma o mensaje",{"_3464":71337,"_30209":71328,"_20922":119903,"_5":14373,"_27447":119884,"_2948":119904},[],"Qué revisar",{"_3464":71338,"_30209":71328,"_20922":119906,"_5":14373,"_27447":119884,"_2948":119907},[],"curl rechaza TLS, nombre o emisor",{"_3464":71339,"_30209":71328,"_20922":119909,"_5":14373,"_27447":119884,"_2948":119910},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3464":71340,"_30209":71328,"_20922":119912,"_5":14373,"_27447":119884,"_2948":119913},[],"404 o APS ausente",{"_3464":71341,"_30209":71328,"_20922":119915,"_5":14373,"_27447":119884,"_2948":119916},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3464":71342,"_30209":71328,"_20922":119918,"_5":14373,"_27447":119884,"_2948":119919},[],"400, error de CSR o formato",{"_3464":71343,"_30209":71328,"_20922":119921,"_5":14373,"_27447":119884,"_2948":119922},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3464":71344,"_30209":71328,"_20922":119924,"_5":14373,"_27447":119884,"_2948":119925},[],"Credencial ausente o certificado no válido",{"_3464":71345,"_30209":71328,"_20922":119927,"_5":14373,"_27447":119884,"_2948":119928},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3464":71346,"_30209":71328,"_20922":119930,"_5":14373,"_27447":119884,"_2948":119931},[],"Webhook deniega, expira o responde sin autorización",{"_3464":71347,"_30209":71328,"_20922":119933,"_5":14373,"_27447":119884,"_2948":119934},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3464":71348,"_30209":71328,"_20922":119936,"_5":14373,"_27447":119884,"_2948":53010},[],{"_3464":71349,"_30209":71328,"_20922":119938,"_5":14373,"_27447":119884,"_2948":119939},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3464":71350,"_30209":71328,"_20922":119941,"_5":14373,"_27447":119884,"_2948":53016},[],{"_3464":71351,"_30209":71328,"_20922":119943,"_5":14373,"_27447":119884,"_2948":119944},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3464":71352,"_30209":71328,"_20922":119946,"_5":14373,"_27447":119884,"_2948":53022},[],{"_3464":71353,"_30209":71328,"_20922":119948,"_5":14373,"_27447":119884,"_2948":119949},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3464":71354,"_30209":71328,"_20922":119951,"_5":14373,"_27447":119884,"_2948":53028},[],{"_3464":71355,"_30209":71328,"_20922":119953,"_5":14373,"_27447":119884,"_2948":119954},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3464":71356,"_30209":71328,"_20922":119956,"_5":14373,"_27447":119884,"_2948":53034},[],{"_3464":71357,"_30209":71328,"_20922":119958,"_5":14373,"_27447":119884,"_2948":119959},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3464":71358,"_30209":71328,"_20922":119961,"_5":14373,"_27447":119884,"_2948":119962},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3464":71359,"_30209":71328,"_20922":119964,"_5":14373,"_27447":119884,"_2948":119965},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3464":71360,"_30209":71328,"_20922":119967,"_5":14373,"_27447":119884,"_2948":119968},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3464":71361,"_30209":71328,"_20922":119970,"_5":14373,"_27447":119884,"_2948":119971},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3464":71362,"_30209":71328,"_20922":119973,"_5":14373,"_27447":119884,"_2948":53052},[],{"_3464":71363,"_30209":71328,"_20922":119975,"_5":14373,"_27447":119884,"_2948":119976},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3464":71364,"_30209":71328,"_20922":119978,"_5":14373,"_27447":119884,"_2948":53058},[],{"_3464":71365,"_30209":71328,"_20922":119980,"_5":14373,"_27447":119884,"_2948":119981},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3464":71366,"_30209":71328,"_20922":119983,"_5":14373,"_27447":119884,"_2948":119984},[],"DMS propietario distinto",{"_3464":71367,"_30209":71328,"_20922":119986,"_5":14373,"_27447":119884,"_2948":119987},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3464":71368,"_30209":71328,"_20922":119989,"_5":14373,"_27447":119884,"_2948":53070},[],{"_3464":71369,"_30209":71328,"_20922":119991,"_5":14373,"_27447":119884,"_2948":119992},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3464":71370,"_30209":71328,"_20922":119994,"_5":14373,"_27447":119884,"_2948":53076},[],{"_3464":71371,"_30209":71328,"_20922":119996,"_5":14373,"_27447":119884,"_2948":119997},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3464":71372,"_30209":71328,"_20922":119999,"_5":14373,"_27447":119884,"_2948":120000},[],"Certificado actual revocado",{"_3464":71373,"_30209":71328,"_20922":120002,"_5":14373,"_27447":119884,"_2948":120003},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3464":71374,"_30209":71328,"_20922":120005,"_5":14373,"_27447":119884,"_2948":120006},[],"Error de CA, perfil o firma",{"_3464":71375,"_30209":71328,"_20922":120008,"_5":14373,"_27447":119884,"_2948":120009},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3464":71376,"_30209":71328,"_20922":120011,"_5":14373,"_27447":119884,"_2948":120012},[],"HTTP 200 sin conexión del dispositivo",{"_3464":71377,"_30209":71328,"_20922":120014,"_5":14373,"_27447":119884,"_2948":120015},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3464":71378,"_30209":71328,"_20922":120017,"_5":14373,"_27447":119884,"_2948":120018},[],"Timeout o error después de emitir",{"_3464":71379,"_30209":71328,"_20922":120020,"_5":14373,"_27447":119884,"_2948":120021},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3464":71380,"_30209":71328,"_20922":120023,"_5":14373,"_27447":119888,"_2948":120024},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3464":71381,"_30209":71328,"_20922":120026,"_5":14373,"_27447":119888,"_2948":120027},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3464":71382,"_30209":71328,"_20922":120029,"_5":14373,"_27447":119891,"_2948":120030},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3464":71383,"_30209":71328,"_20922":120032,"_5":14373,"_27447":119891,"_2948":120033},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3464":71384,"_30209":71328,"_20922":120035,"_5":14373,"_27447":119891,"_2948":120036},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3464":71385,"_30209":71328,"_20922":120038,"_5":14373,"_27447":119891,"_2948":120039},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3464":71386,"_30209":71328,"_20922":120041,"_5":14373,"_27447":119891,"_2948":120042},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3464":71387,"_30209":71328,"_20922":120044,"_5":14373,"_27447":119891,"_2948":120045},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3464":71388,"_30209":71328,"_20922":120047,"_5":14373,"_27447":119891,"_2948":120048},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3464":71389,"_30209":71389,"_5":14725,"_2948":120050,"_30562":120051,"_20922":120052,"_27447":71389},"Distribución y actualización de confianza",[49276,117725,51765,118737,118912],[],{"_3464":71390,"_30209":71389,"_20922":120054,"_5":14373,"_27447":71389,"_2948":120055},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3464":71391,"_30209":71389,"_5":30559,"_20922":120057,"_27447":120058,"_2948":120059},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3464":71392,"_30209":71389,"_5":30559,"_20922":120061,"_27447":120062,"_2948":120063},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3464":71393,"_30209":71389,"_5":30559,"_20922":120065,"_27447":120066,"_2948":120067},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3464":71394,"_30209":71389,"_5":30559,"_20922":120069,"_27447":120070,"_2948":120071},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3464":71395,"_30209":71389,"_5":30559,"_20922":120073,"_27447":120074,"_2948":120075},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3464":71396,"_30209":71389,"_20922":120077,"_5":14373,"_27447":71389,"_2948":120078},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3464":71397,"_30209":71389,"_20922":120080,"_5":14373,"_27447":120058,"_2948":120081},[],"Relación",{"_3464":71398,"_30209":71389,"_20922":120083,"_5":14373,"_27447":120058,"_2948":120084},[],"Material que prepara el responsable",{"_3464":71399,"_30209":71389,"_20922":120086,"_5":14373,"_27447":120058,"_2948":120087},[],"Dispositivo → servidor EST",{"_3464":71400,"_30209":71389,"_20922":120089,"_5":14373,"_27447":120058,"_2948":120090},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3464":71401,"_30209":71389,"_20922":120092,"_5":14373,"_27447":120058,"_2948":120093},[],"DMS → solicitante",{"_3464":71402,"_30209":71389,"_20922":120095,"_5":14373,"_27447":120058,"_2948":120096},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3464":71403,"_30209":71389,"_20922":120098,"_5":14373,"_27447":120058,"_2948":120099},[],"Consumidor → dispositivo",{"_3464":71404,"_30209":71389,"_20922":120101,"_5":14373,"_27447":120058,"_2948":120102},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3464":71405,"_30209":71389,"_20922":120104,"_5":14373,"_27447":120058,"_2948":120105},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3464":71406,"_30209":71389,"_20922":120107,"_5":14373,"_27447":120062,"_2948":120108},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3464":71407,"_30209":71389,"_20922":120110,"_5":14373,"_27447":120062,"_2948":120111},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3464":71408,"_30209":71389,"_20922":120113,"_5":14373,"_27447":120066,"_2948":120114},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3464":71409,"_30209":71389,"_20922":120116,"_5":14373,"_27447":120066,"_2948":120117},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3464":71410,"_30209":71389,"_20922":120119,"_5":14373,"_27447":120066,"_2948":120120},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3464":71411,"_30209":71389,"_20922":120122,"_5":14373,"_27447":120066,"_2948":120123},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3464":71412,"_30209":71389,"_20922":120125,"_5":14373,"_27447":120066,"_2948":120126},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3464":71413,"_30209":71389,"_20922":120128,"_5":14373,"_27447":120066,"_2948":120129},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3464":71414,"_30209":71389,"_20922":120131,"_5":14373,"_27447":120070,"_2948":120132},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3464":71415,"_30209":71389,"_20922":120134,"_5":14373,"_27447":120070,"_2948":120135},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3464":71416,"_30209":71389,"_20922":120137,"_5":14373,"_27447":120070,"_2948":120138},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3464":71417,"_30209":71389,"_20922":120140,"_5":14373,"_27447":120074,"_2948":120141},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3464":71418,"_30209":71418,"_5":14725,"_2948":53225,"_30562":120143,"_20922":120145,"_27447":71418},[49276,117725,51765,118737,120144],"Integraciones",[],{"_3464":71419,"_30209":71418,"_20922":120147,"_5":14373,"_27447":71418,"_2948":120148},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3464":71420,"_30209":71418,"_5":30559,"_20922":120150,"_27447":120151,"_2948":120152},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3464":71421,"_30209":71418,"_5":30559,"_20922":120154,"_27447":120155,"_2948":120156},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3464":71422,"_30209":71418,"_5":30559,"_20922":120158,"_27447":120159,"_2948":120160},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3464":71423,"_30209":71418,"_5":30559,"_20922":120162,"_27447":120163,"_2948":120164},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3464":71424,"_30209":71418,"_5":30559,"_20922":120166,"_27447":120167,"_2948":120168},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3464":71425,"_30209":71418,"_5":30559,"_20922":120170,"_27447":120171,"_2948":120172},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3464":71426,"_30209":71418,"_5":30559,"_20922":120174,"_27447":120175,"_2948":120176},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3464":71427,"_30209":71418,"_5":30559,"_20922":120178,"_27447":120179,"_2948":120180},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3464":71428,"_30209":71418,"_5":30559,"_20922":120182,"_27447":120183,"_2948":53267},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3464":71429,"_30209":71418,"_5":30559,"_20922":120185,"_27447":120186,"_2948":53271},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3464":71430,"_30209":71418,"_5":30559,"_20922":120188,"_27447":120189,"_2948":120190},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3464":71431,"_30209":71418,"_5":30559,"_20922":120192,"_27447":120193,"_2948":120194},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3464":71432,"_30209":71418,"_5":30559,"_20922":120196,"_27447":120197,"_2948":120198},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3464":71433,"_30209":71418,"_5":30559,"_20922":120200,"_27447":120201,"_2948":120202},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3464":71434,"_30209":71418,"_5":30559,"_20922":120204,"_27447":120205,"_2948":120206},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3464":71435,"_30209":71418,"_5":30559,"_20922":120208,"_27447":120209,"_2948":120210},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3464":71436,"_30209":71418,"_5":30559,"_20922":120212,"_27447":120213,"_2948":120214},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3464":71437,"_30209":71418,"_5":30559,"_20922":120216,"_27447":120217,"_2948":120218},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3464":71438,"_30209":71418,"_5":30559,"_20922":120220,"_27447":120221,"_2948":120222},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3464":71439,"_30209":71418,"_5":30559,"_20922":120224,"_27447":120225,"_2948":120226},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3464":71440,"_30209":71418,"_5":30559,"_20922":120228,"_27447":120229,"_2948":120230},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3464":71441,"_30209":71418,"_5":30559,"_20922":120232,"_27447":120233,"_2948":120234},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3464":71442,"_30209":71418,"_5":30559,"_20922":120236,"_27447":120237,"_2948":120238},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3464":71443,"_30209":71418,"_5":30559,"_20922":120240,"_27447":120241,"_2948":120242},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3464":71444,"_30209":71418,"_5":30559,"_20922":120244,"_27447":120245,"_2948":120246},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3464":71445,"_30209":71418,"_20922":120248,"_5":14373,"_27447":71418,"_2948":120249},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3464":71446,"_30209":71418,"_20922":120251,"_5":14373,"_27447":71418,"_2948":120252},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3464":71447,"_30209":71418,"_20922":120254,"_5":14373,"_27447":71418,"_2948":120255},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3464":71448,"_30209":71418,"_20922":120257,"_5":14373,"_27447":120151,"_2948":120258},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3464":71449,"_30209":71418,"_20922":120260,"_5":14373,"_27447":120151,"_2948":120261},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3464":71450,"_30209":71418,"_20922":120263,"_5":14373,"_27447":120151,"_2948":120264},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3464":71451,"_30209":71418,"_20922":120266,"_5":14373,"_27447":120151,"_2948":120267},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3464":71452,"_30209":71418,"_20922":120269,"_5":14373,"_27447":120155,"_2948":120270},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3464":71453,"_30209":71418,"_20922":120272,"_5":14373,"_27447":120159,"_2948":120273},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3464":71454,"_30209":71418,"_20922":120275,"_5":14373,"_27447":120159,"_2948":120276},[],"Acción IAM",{"_3464":71455,"_30209":71418,"_20922":120278,"_5":14373,"_27447":120159,"_2948":116666},[],{"_3464":71456,"_30209":71418,"_20922":120280,"_5":14373,"_27447":120159,"_2948":53366},[],{"_3464":71457,"_30209":71418,"_20922":120282,"_5":14373,"_27447":120159,"_2948":120283},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3464":71458,"_30209":71418,"_20922":120285,"_5":14373,"_27447":120159,"_2948":53372},[],{"_3464":71459,"_30209":71418,"_20922":120287,"_5":14373,"_27447":120159,"_2948":120288},[],"Registrar la CA en AWS IoT",{"_3464":71460,"_30209":71418,"_20922":120290,"_5":14373,"_27447":120159,"_2948":53378},[],{"_3464":71461,"_30209":71418,"_20922":120292,"_5":14373,"_27447":120159,"_2948":120293},[],"Consultar el estado del registro de la CA",{"_3464":71462,"_30209":71418,"_20922":120295,"_5":14373,"_27447":120159,"_2948":53384},[],{"_3464":71463,"_30209":71418,"_20922":120297,"_5":14373,"_27447":120159,"_2948":120298},[],"Crear o actualizar Things en IoT Core",{"_3464":71464,"_30209":71418,"_20922":120300,"_5":14373,"_27447":120159,"_2948":53390},[],{"_3464":71465,"_30209":71418,"_20922":120302,"_5":14373,"_27447":120159,"_2948":120303},[],"Aprovisionar Things mediante plantilla",{"_3464":71466,"_30209":71418,"_20922":120305,"_5":14373,"_27447":120159,"_2948":53396},[],{"_3464":71467,"_30209":71418,"_20922":120307,"_5":14373,"_27447":120159,"_2948":120308},[],"Registrar certificados de dispositivo",{"_3464":71468,"_30209":71418,"_20922":120310,"_5":14373,"_27447":120159,"_2948":53402},[],{"_3464":71469,"_30209":71418,"_20922":120312,"_5":14373,"_27447":120159,"_2948":120313},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3464":71470,"_30209":71418,"_20922":120315,"_5":14373,"_27447":120159,"_2948":53408},[],{"_3464":71471,"_30209":71418,"_20922":120317,"_5":14373,"_27447":120159,"_2948":120318},[],"Crear y adjuntar políticas IoT",{"_3464":71472,"_30209":71418,"_20922":120320,"_5":14373,"_27447":120159,"_2948":53414},[],{"_3464":71473,"_30209":71418,"_20922":120322,"_5":14373,"_27447":120159,"_2948":120323},[],"Gestionar grupos de Things",{"_3464":71474,"_30209":71418,"_20922":120325,"_5":14373,"_27447":120159,"_2948":53420},[],{"_3464":71475,"_30209":71418,"_20922":120327,"_5":14373,"_27447":120159,"_2948":120328},[],"Crear plantillas JITP",{"_3464":71476,"_30209":71418,"_20922":120330,"_5":14373,"_27447":120159,"_2948":53426},[],{"_3464":71477,"_30209":71418,"_20922":120332,"_5":14373,"_27447":120159,"_2948":120333},[],"Leer y escribir el Device Shadow",{"_3464":71478,"_30209":71418,"_20922":120335,"_5":14373,"_27447":120159,"_2948":120336},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3464":71479,"_30209":71418,"_20922":120338,"_5":14373,"_27447":120163,"_2948":120339},[],"Parámetro",{"_3464":71480,"_30209":71418,"_20922":120341,"_5":14373,"_27447":120163,"_2948":120342},[],"Tipo",{"_3464":71481,"_30209":71418,"_20922":120344,"_5":14373,"_27447":120163,"_2948":120345},[],"Requerido",{"_3464":71482,"_30209":71418,"_20922":120347,"_5":14373,"_27447":120163,"_2948":120348},[],"Descripción",{"_3464":71483,"_30209":71418,"_20922":120350,"_5":14373,"_27447":120163,"_2948":53447},[],{"_3464":71484,"_30209":71418,"_20922":120352,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71485,"_30209":71418,"_20922":120354,"_5":14373,"_27447":120163,"_2948":120355},[],"Sí",{"_3464":71486,"_30209":71418,"_20922":120357,"_5":14373,"_27447":120163,"_2948":120358},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3464":71487,"_30209":71418,"_20922":120360,"_5":14373,"_27447":120163,"_2948":53458},[],{"_3464":71488,"_30209":71418,"_20922":120362,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71489,"_30209":71418,"_20922":120364,"_5":14373,"_27447":120163,"_2948":120355},[],{"_3464":71490,"_30209":71418,"_20922":120366,"_5":14373,"_27447":120163,"_2948":120367},[],"Región AWS donde opera el conector.",{"_3464":71491,"_30209":71418,"_20922":120369,"_5":14373,"_27447":120163,"_2948":53468},[],{"_3464":71492,"_30209":71418,"_20922":120371,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71493,"_30209":71418,"_20922":120373,"_5":14373,"_27447":120163,"_2948":120355},[],{"_3464":71494,"_30209":71418,"_20922":120375,"_5":14373,"_27447":120163,"_2948":120376},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3464":71495,"_30209":71418,"_20922":120378,"_5":14373,"_27447":120163,"_2948":53478},[],{"_3464":71496,"_30209":71418,"_20922":120380,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71497,"_30209":71418,"_20922":120382,"_5":14373,"_27447":120163,"_2948":120383},[],"Solo con `auth_method=static`",{"_3464":71498,"_30209":71418,"_20922":120385,"_5":14373,"_27447":120163,"_2948":120386},[],"Clave de acceso AWS.",{"_3464":71499,"_30209":71418,"_20922":120388,"_5":14373,"_27447":120163,"_2948":53489},[],{"_3464":71500,"_30209":71418,"_20922":120390,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71501,"_30209":71418,"_20922":120392,"_5":14373,"_27447":120163,"_2948":120383},[],{"_3464":71502,"_30209":71418,"_20922":120394,"_5":14373,"_27447":120163,"_2948":120395},[],"Clave secreta AWS.",{"_3464":71503,"_30209":71418,"_20922":120397,"_5":14373,"_27447":120163,"_2948":53499},[],{"_3464":71504,"_30209":71418,"_20922":120399,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71505,"_30209":71418,"_20922":120401,"_5":14373,"_27447":120163,"_2948":53504},[],{"_3464":71506,"_30209":71418,"_20922":120403,"_5":14373,"_27447":120163,"_2948":120404},[],"Token de sesión (con `auth_method=static`).",{"_3464":71507,"_30209":71418,"_20922":120406,"_5":14373,"_27447":120163,"_2948":53510},[],{"_3464":71508,"_30209":71418,"_20922":120408,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71509,"_30209":71418,"_20922":120410,"_5":14373,"_27447":120163,"_2948":120411},[],"Solo con `auth_method=role`",{"_3464":71510,"_30209":71418,"_20922":120413,"_5":14373,"_27447":120163,"_2948":120414},[],"ARN del rol a asumir.",{"_3464":71511,"_30209":71418,"_20922":120416,"_5":14373,"_27447":120163,"_2948":53521},[],{"_3464":71512,"_30209":71418,"_20922":120418,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71513,"_30209":71418,"_20922":120420,"_5":14373,"_27447":120163,"_2948":53504},[],{"_3464":71514,"_30209":71418,"_20922":120422,"_5":14373,"_27447":120163,"_2948":120423},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3464":71515,"_30209":71418,"_20922":120425,"_5":14373,"_27447":120163,"_2948":53531},[],{"_3464":71516,"_30209":71418,"_20922":120427,"_5":14373,"_27447":120163,"_2948":89767},[],{"_3464":71517,"_30209":71418,"_20922":120429,"_5":14373,"_27447":120163,"_2948":120355},[],{"_3464":71518,"_30209":71418,"_20922":120431,"_5":14373,"_27447":120163,"_2948":120432},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3464":71519,"_30209":71418,"_20922":120434,"_5":14373,"_27447":120163,"_2948":53541},[],{"_3464":71520,"_30209":71418,"_20922":120436,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71521,"_30209":71418,"_20922":120438,"_5":14373,"_27447":120163,"_2948":120355},[],{"_3464":71522,"_30209":71418,"_20922":120440,"_5":14373,"_27447":120163,"_2948":120441},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3464":71523,"_30209":71418,"_20922":120443,"_5":14373,"_27447":120163,"_2948":53551},[],{"_3464":71524,"_30209":71418,"_20922":120445,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71525,"_30209":71418,"_20922":120447,"_5":14373,"_27447":120163,"_2948":120355},[],{"_3464":71526,"_30209":71418,"_20922":120449,"_5":14373,"_27447":120163,"_2948":120450},[],"URL HTTP del Device Manager de Lamassu.",{"_3464":71527,"_30209":71418,"_20922":120452,"_5":14373,"_27447":120163,"_2948":53561},[],{"_3464":71528,"_30209":71418,"_20922":120454,"_5":14373,"_27447":120163,"_2948":25016},[],{"_3464":71529,"_30209":71418,"_20922":120456,"_5":14373,"_27447":120163,"_2948":120355},[],{"_3464":71530,"_30209":71418,"_20922":120458,"_5":14373,"_27447":120163,"_2948":120459},[],"URL HTTP del servicio de CA de Lamassu.",{"_3464":71531,"_30209":71418,"_20922":120461,"_5":14373,"_27447":120167,"_2948":120462},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3464":71532,"_30209":71418,"_20922":120464,"_5":14373,"_27447":120167,"_2948":120465},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3464":71533,"_30209":71418,"_20922":120467,"_5":14373,"_27447":120167,"_2948":120468},[],"Tipo de CloudEvent",{"_3464":71534,"_30209":71418,"_20922":120470,"_5":14373,"_27447":120167,"_2948":120471},[],"Recurso en Lamassu",{"_3464":71535,"_30209":71418,"_20922":120473,"_5":14373,"_27447":120167,"_2948":120474},[],"Recurso AWS",{"_3464":71536,"_30209":71418,"_20922":120476,"_5":14373,"_27447":120167,"_2948":120477},[],"Acciones IAM",{"_3464":71537,"_30209":71418,"_20922":120479,"_5":14373,"_27447":120167,"_2948":120480},[],"Llamadas AWS y efecto",{"_3464":71538,"_30209":71418,"_20922":120482,"_5":14373,"_27447":120167,"_2948":120483},[],"Dónde en esta página",{"_3464":71539,"_30209":71418,"_20922":120485,"_5":14373,"_27447":120167,"_2948":53595},[],{"_3464":71540,"_30209":71418,"_20922":120487,"_5":14373,"_27447":120167,"_2948":53598},[],{"_3464":71541,"_30209":71418,"_20922":120489,"_5":14373,"_27447":120167,"_2948":53601},[],{"_3464":71542,"_30209":71418,"_20922":120491,"_5":14373,"_27447":120167,"_2948":53604},[],{"_3464":71543,"_30209":71418,"_20922":120493,"_5":14373,"_27447":120167,"_2948":120494},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3464":71544,"_30209":71418,"_20922":120496,"_5":14373,"_27447":120167,"_2948":120180},[],{"_3464":71545,"_30209":71418,"_20922":120498,"_5":14373,"_27447":120167,"_2948":53612},[],{"_3464":71546,"_30209":71418,"_20922":120500,"_5":14373,"_27447":120167,"_2948":53615},[],{"_3464":71547,"_30209":71418,"_20922":120502,"_5":14373,"_27447":120167,"_2948":53618},[],{"_3464":71548,"_30209":71418,"_20922":120504,"_5":14373,"_27447":120167,"_2948":53621},[],{"_3464":71549,"_30209":71418,"_20922":120506,"_5":14373,"_27447":120167,"_2948":120507},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3464":71550,"_30209":71418,"_20922":120509,"_5":14373,"_27447":120167,"_2948":120206},[],{"_3464":71551,"_30209":71418,"_20922":120511,"_5":14373,"_27447":120167,"_2948":53629},[],{"_3464":71552,"_30209":71418,"_20922":120513,"_5":14373,"_27447":120167,"_2948":120514},[],"Dispositivo",{"_3464":71553,"_30209":71418,"_20922":120516,"_5":14373,"_27447":120167,"_2948":53635},[],{"_3464":71554,"_30209":71418,"_20922":120518,"_5":14373,"_27447":120167,"_2948":53638},[],{"_3464":71555,"_30209":71418,"_20922":120520,"_5":14373,"_27447":120167,"_2948":120521},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3464":71556,"_30209":71418,"_20922":120523,"_5":14373,"_27447":120167,"_2948":120214},[],{"_3464":71557,"_30209":71418,"_20922":120525,"_5":14373,"_27447":120167,"_2948":53646},[],{"_3464":71558,"_30209":71418,"_20922":120527,"_5":14373,"_27447":120167,"_2948":120528},[],"Certificado",{"_3464":71559,"_30209":71418,"_20922":120530,"_5":14373,"_27447":120167,"_2948":53652},[],{"_3464":71560,"_30209":71418,"_20922":120532,"_5":14373,"_27447":120167,"_2948":120533},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3464":71561,"_30209":71418,"_20922":120535,"_5":14373,"_27447":120167,"_2948":120536},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3464":71562,"_30209":71418,"_20922":120538,"_5":14373,"_27447":120167,"_2948":120226},[],{"_3464":71563,"_30209":71418,"_20922":120540,"_5":14373,"_27447":120167,"_2948":53663},[],{"_3464":71564,"_30209":71418,"_20922":120542,"_5":14373,"_27447":120167,"_2948":120543},[],"Certificado / Dispositivo",{"_3464":71565,"_30209":71418,"_20922":120545,"_5":14373,"_27447":120167,"_2948":53669},[],{"_3464":71566,"_30209":71418,"_20922":120547,"_5":14373,"_27447":120167,"_2948":49672},[],{"_3464":71567,"_30209":71418,"_20922":120549,"_5":14373,"_27447":120167,"_2948":120550},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3464":71568,"_30209":71418,"_20922":120552,"_5":14373,"_27447":120167,"_2948":120234},[],{"_3464":71569,"_30209":71418,"_20922":120554,"_5":14373,"_27447":120171,"_2948":120555},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3464":71570,"_30209":71418,"_20922":120557,"_5":14373,"_27447":120175,"_2948":120558},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3464":71571,"_30209":71418,"_20922":120560,"_5":14373,"_27447":120175,"_2948":120561},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3464":71572,"_30209":71418,"_20922":120563,"_5":14373,"_27447":120179,"_2948":120564},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3464":71573,"_30209":71418,"_20922":120566,"_5":14373,"_27447":120179,"_2948":120567},[],"Transición",{"_3464":71574,"_30209":71418,"_20922":120569,"_5":14373,"_27447":120179,"_2948":120570},[],"Llamadas AWS",{"_3464":71575,"_30209":71418,"_20922":120572,"_5":14373,"_27447":120179,"_2948":120573},[],"`NoRegistrada` → `Solicitada`",{"_3464":71576,"_30209":71418,"_20922":120575,"_5":14373,"_27447":120179,"_2948":120576},[],"ninguna (solo escritura de metadatos)",{"_3464":71577,"_30209":71418,"_20922":120578,"_5":14373,"_27447":120179,"_2948":120579},[],"`Solicitada` → `Registrando`",{"_3464":71578,"_30209":71418,"_20922":120581,"_5":14373,"_27447":120179,"_2948":120582},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3464":71579,"_30209":71418,"_20922":120584,"_5":14373,"_27447":120179,"_2948":120585},[],"`Registrando` → `Completada`",{"_3464":71580,"_30209":71418,"_20922":120587,"_5":14373,"_27447":120179,"_2948":120588},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3464":71581,"_30209":71418,"_20922":120590,"_5":14373,"_27447":120179,"_2948":120591},[],"`Registrando` → `Fallida`",{"_3464":71582,"_30209":71418,"_20922":120593,"_5":14373,"_27447":120179,"_2948":120594},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3464":71583,"_30209":71418,"_20922":120596,"_5":14373,"_27447":120179,"_2948":120597},[],"`Fallida` / `Completada` → `Solicitada`",{"_3464":71584,"_30209":71418,"_20922":120599,"_5":14373,"_27447":120179,"_2948":120600},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3464":71585,"_30209":71418,"_20922":120602,"_5":14373,"_27447":120183,"_2948":120603},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3464":71586,"_30209":71418,"_20922":120605,"_5":14373,"_27447":120183,"_2948":120606},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3464":71587,"_30209":71418,"_20922":120608,"_5":14373,"_27447":120183,"_2948":120609},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3464":71588,"_30209":71418,"_20922":120611,"_5":14373,"_27447":120183,"_2948":120612},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3464":71589,"_30209":71418,"_20922":120614,"_5":14373,"_27447":120183,"_2948":120615},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3464":71590,"_30209":71418,"_20922":120617,"_5":14373,"_27447":120183,"_2948":120618},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3464":71591,"_30209":71418,"_20922":120620,"_5":14373,"_27447":120186,"_2948":120621},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3464":71592,"_30209":71418,"_20922":120623,"_5":14373,"_27447":120189,"_2948":120624},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3464":71593,"_30209":71418,"_20922":120626,"_5":14373,"_27447":120189,"_2948":120627},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3464":71594,"_30209":71418,"_20922":120629,"_5":14373,"_27447":120193,"_2948":120630},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3464":71595,"_30209":71418,"_20922":120632,"_5":14373,"_27447":120197,"_2948":120633},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3464":71596,"_30209":71418,"_20922":120635,"_5":14373,"_27447":120197,"_2948":120636},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3464":71597,"_30209":71418,"_20922":120638,"_5":14373,"_27447":120197,"_2948":120639},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3464":71598,"_30209":71418,"_20922":120641,"_5":14373,"_27447":120197,"_2948":120642},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3464":71599,"_30209":71418,"_20922":120644,"_5":14373,"_27447":120197,"_2948":120645},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3464":71600,"_30209":71418,"_20922":120647,"_5":14373,"_27447":120197,"_2948":120648},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3464":71601,"_30209":71418,"_20922":120650,"_5":14373,"_27447":120201,"_2948":120651},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3464":71602,"_30209":71418,"_20922":120653,"_5":14373,"_27447":120201,"_2948":120654},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3464":71603,"_30209":71418,"_20922":120656,"_5":14373,"_27447":120201,"_2948":120657},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3464":71604,"_30209":71418,"_20922":120659,"_5":14373,"_27447":120201,"_2948":120660},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3464":71605,"_30209":71418,"_20922":120662,"_5":14373,"_27447":120201,"_2948":120663},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3464":71606,"_30209":71418,"_20922":120665,"_5":14373,"_27447":120205,"_2948":120666},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3464":71607,"_30209":71418,"_20922":120668,"_5":14373,"_27447":120205,"_2948":120567},[],{"_3464":71608,"_30209":71418,"_20922":120670,"_5":14373,"_27447":120205,"_2948":120570},[],{"_3464":71609,"_30209":71418,"_20922":120672,"_5":14373,"_27447":120205,"_2948":120673},[],"`SinConfigurar` → `None` / `Auto`",{"_3464":71610,"_30209":71418,"_20922":120675,"_5":14373,"_27447":120205,"_2948":120676},[],"ninguna (solo configuración)",{"_3464":71611,"_30209":71418,"_20922":120678,"_5":14373,"_27447":120205,"_2948":53806},[],{"_3464":71612,"_30209":71418,"_20922":120680,"_5":14373,"_27447":120205,"_2948":120676},[],{"_3464":71613,"_30209":71418,"_20922":120682,"_5":14373,"_27447":120205,"_2948":120683},[],"Cualquiera → `Jitp`",{"_3464":71614,"_30209":71418,"_20922":120685,"_5":14373,"_27447":120205,"_2948":120686},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3464":71615,"_30209":71418,"_20922":120688,"_5":14373,"_27447":120205,"_2948":53817},[],{"_3464":71616,"_30209":71418,"_20922":120690,"_5":14373,"_27447":120205,"_2948":120691},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3464":71617,"_30209":71418,"_20922":120693,"_5":14373,"_27447":120209,"_2948":120694},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3464":71618,"_30209":71418,"_20922":120696,"_5":14373,"_27447":120209,"_2948":120697},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3464":71619,"_30209":71418,"_20922":120699,"_5":14373,"_27447":120209,"_2948":120700},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3464":71620,"_30209":71418,"_20922":120702,"_5":14373,"_27447":120213,"_2948":120703},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3464":71621,"_30209":71418,"_20922":120705,"_5":14373,"_27447":120213,"_2948":120567},[],{"_3464":71622,"_30209":71418,"_20922":120707,"_5":14373,"_27447":120213,"_2948":120570},[],{"_3464":71623,"_30209":71418,"_20922":120709,"_5":14373,"_27447":120213,"_2948":120710},[],"`Ausente` → `Aprovisionado`",{"_3464":71624,"_30209":71418,"_20922":120712,"_5":14373,"_27447":120213,"_2948":120713},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3464":71625,"_30209":71418,"_20922":120715,"_5":14373,"_27447":120213,"_2948":120716},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3464":71626,"_30209":71418,"_20922":120718,"_5":14373,"_27447":120213,"_2948":120719},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3464":71627,"_30209":71418,"_20922":120721,"_5":14373,"_27447":120213,"_2948":120722},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3464":71628,"_30209":71418,"_20922":120724,"_5":14373,"_27447":120217,"_2948":120725},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3464":71629,"_30209":71418,"_20922":120727,"_5":14373,"_27447":120217,"_2948":120728},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3464":71630,"_30209":71418,"_20922":120730,"_5":14373,"_27447":120217,"_2948":120731},[],"Para que el flujo JITP funcione correctamente:",{"_3464":71631,"_30209":71418,"_20922":120733,"_5":14373,"_27447":120217,"_2948":120734},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3464":71632,"_30209":71418,"_20922":120736,"_5":14373,"_27447":120217,"_2948":120737},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3464":71633,"_30209":71418,"_20922":120739,"_5":14373,"_27447":120217,"_2948":120740},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3464":71634,"_30209":71418,"_20922":120742,"_5":14373,"_27447":120217,"_2948":120743},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3464":71635,"_30209":71418,"_20922":120745,"_5":14373,"_27447":120221,"_2948":120746},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3464":71636,"_30209":71418,"_20922":120748,"_5":14373,"_27447":120221,"_2948":120749},[],"Estado en Lamassu",{"_3464":71637,"_30209":71418,"_20922":120751,"_5":14373,"_27447":120221,"_2948":120752},[],"Razón de revocación",{"_3464":71638,"_30209":71418,"_20922":120754,"_5":14373,"_27447":120221,"_2948":120755},[],"Estado en AWS IoT Core",{"_3464":71639,"_30209":71418,"_20922":120757,"_5":14373,"_27447":120221,"_2948":53887},[],{"_3464":71640,"_30209":71418,"_20922":120759,"_5":14373,"_27447":120221,"_2948":120760},[],"Ninguna",{"_3464":71641,"_30209":71418,"_20922":120762,"_5":14373,"_27447":120221,"_2948":53893},[],{"_3464":71642,"_30209":71418,"_20922":120764,"_5":14373,"_27447":120221,"_2948":53896},[],{"_3464":71643,"_30209":71418,"_20922":120766,"_5":14373,"_27447":120221,"_2948":53899},[],{"_3464":71644,"_30209":71418,"_20922":120768,"_5":14373,"_27447":120221,"_2948":53902},[],{"_3464":71645,"_30209":71418,"_20922":120770,"_5":14373,"_27447":120221,"_2948":53896},[],{"_3464":71646,"_30209":71418,"_20922":120772,"_5":14373,"_27447":120221,"_2948":120773},[],"Cualquier otra razón",{"_3464":71647,"_30209":71418,"_20922":120775,"_5":14373,"_27447":120221,"_2948":53910},[],{"_3464":71648,"_30209":71418,"_20922":120777,"_5":14373,"_27447":120221,"_2948":120778},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3464":71649,"_30209":71418,"_20922":120780,"_5":14373,"_27447":120225,"_2948":120781},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3464":71650,"_30209":71418,"_20922":120783,"_5":14373,"_27447":120225,"_2948":120567},[],{"_3464":71651,"_30209":71418,"_20922":120785,"_5":14373,"_27447":120225,"_2948":120570},[],{"_3464":71652,"_30209":71418,"_20922":120787,"_5":14373,"_27447":120225,"_2948":120788},[],"`NoSincronizado` → `Active`",{"_3464":71653,"_30209":71418,"_20922":120790,"_5":14373,"_27447":120225,"_2948":53402},[],{"_3464":71654,"_30209":71418,"_20922":120792,"_5":14373,"_27447":120225,"_2948":53928},[],{"_3464":71655,"_30209":71418,"_20922":120794,"_5":14373,"_27447":120225,"_2948":120795},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3464":71656,"_30209":71418,"_20922":120797,"_5":14373,"_27447":120225,"_2948":53934},[],{"_3464":71657,"_30209":71418,"_20922":120799,"_5":14373,"_27447":120225,"_2948":120795},[],{"_3464":71658,"_30209":71418,"_20922":120801,"_5":14373,"_27447":120225,"_2948":53939},[],{"_3464":71659,"_30209":71418,"_20922":120803,"_5":14373,"_27447":120225,"_2948":53402},[],{"_3464":71660,"_30209":71418,"_20922":120805,"_5":14373,"_27447":120225,"_2948":53944},[],{"_3464":71661,"_30209":71418,"_20922":120807,"_5":14373,"_27447":120225,"_2948":120808},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3464":71662,"_30209":71418,"_20922":120810,"_5":14373,"_27447":120229,"_2948":120811},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3464":71663,"_30209":71418,"_20922":120813,"_5":14373,"_27447":120229,"_2948":120814},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3464":71664,"_30209":71418,"_20922":120816,"_5":14373,"_27447":120229,"_2948":120817},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3464":71665,"_30209":71418,"_20922":120819,"_5":14373,"_27447":120233,"_2948":120820},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3464":71666,"_30209":71418,"_20922":120822,"_5":14373,"_27447":120233,"_2948":120823},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3464":71667,"_30209":71418,"_20922":120825,"_5":14373,"_27447":120237,"_2948":120826},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3464":71668,"_30209":71418,"_20922":120828,"_5":14373,"_27447":120237,"_2948":120829},[],"Existen dos tipos de acciones:",{"_3464":71669,"_30209":71418,"_20922":120831,"_5":14373,"_27447":120237,"_2948":120832},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3464":71670,"_30209":71418,"_20922":120834,"_5":14373,"_27447":120237,"_2948":120835},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3464":71671,"_30209":71418,"_20922":120837,"_5":14373,"_27447":120237,"_2948":120838},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3464":71672,"_30209":71418,"_20922":120840,"_5":14373,"_27447":120241,"_2948":120841},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3464":71673,"_30209":71418,"_20922":120843,"_5":14373,"_27447":120241,"_2948":120844},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3464":71674,"_30209":71418,"_20922":120846,"_5":14373,"_27447":120241,"_2948":120847},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3464":71675,"_30209":71418,"_20922":120849,"_5":14373,"_27447":120245,"_2948":120850},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3464":71676,"_30209":71418,"_20922":120852,"_5":14373,"_27447":120245,"_2948":120853},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3464":71677,"_30209":71418,"_20922":120855,"_5":14373,"_27447":120245,"_2948":120856},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3464":71678,"_30209":71418,"_20922":120858,"_5":14373,"_27447":120245,"_2948":120859},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3464":71679,"_30209":71418,"_20922":120861,"_5":14373,"_27447":120245,"_2948":120862},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3464":71680,"_30209":71418,"_20922":120864,"_5":14373,"_27447":120245,"_2948":120865},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3464":71681,"_30209":71418,"_20922":120867,"_5":14373,"_27447":120245,"_2948":120868},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3464":71682,"_30209":71418,"_20922":120870,"_5":14373,"_27447":120245,"_2948":120871},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3464":71683,"_30209":71418,"_20922":120873,"_5":14373,"_27447":120245,"_2948":120874},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3464":71684,"_30209":71418,"_20922":120876,"_5":14373,"_27447":120245,"_2948":120877},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3464":71685,"_30209":71418,"_20922":120879,"_5":14373,"_27447":120245,"_2948":120880},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3464":71686,"_30209":71418,"_20922":120882,"_5":14373,"_27447":120245,"_2948":120883},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3464":71687,"_30209":71418,"_20922":120885,"_5":14373,"_27447":120245,"_2948":120886},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3464":71688,"_30209":71418,"_20922":120888,"_5":14373,"_27447":120245,"_2948":120889},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3464":71689,"_30209":71418,"_20922":120891,"_5":14373,"_27447":120245,"_2948":120892},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3464":71690,"_30209":71418,"_20922":120894,"_5":14373,"_27447":120245,"_2948":120895},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3464":71691,"_30209":71418,"_20922":120897,"_5":14373,"_27447":120245,"_2948":120898},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3464":71692,"_30209":71418,"_20922":120900,"_5":14373,"_27447":120245,"_2948":120901},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3464":71693,"_30209":71418,"_20922":120903,"_5":14373,"_27447":120245,"_2948":120904},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3464":71694,"_30209":71418,"_20922":120906,"_5":14373,"_27447":120245,"_2948":120907},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3464":71695,"_30209":71418,"_20922":120909,"_5":14373,"_27447":120245,"_2948":120910},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3464":71696,"_30209":71418,"_20922":120912,"_5":14373,"_27447":120245,"_2948":120913},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":71697,"_30209":71418,"_20922":120915,"_5":14373,"_27447":120245,"_2948":120916},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3464":71698,"_30209":71418,"_20922":120918,"_5":14373,"_27447":120245,"_2948":120919},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3464":71699,"_30209":71699,"_5":14725,"_2948":51765,"_30562":120921,"_20922":120922,"_27447":71699},[49276,117725,51765],[],{"_3464":71700,"_30209":71699,"_20922":120924,"_5":14373,"_27447":71699,"_2948":120925},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3464":71701,"_30209":71699,"_5":30559,"_20922":120927,"_27447":120928,"_2948":120929},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3464":71702,"_30209":71699,"_5":30559,"_20922":120931,"_27447":120932,"_2948":118737},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3464":71703,"_30209":71699,"_5":30559,"_20922":120934,"_27447":120935,"_2948":118912},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3464":71704,"_30209":71699,"_5":30559,"_20922":120937,"_27447":120938,"_2948":120144},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/overview#integraciones",{"_3464":71705,"_30209":71699,"_5":30559,"_20922":120940,"_27447":120941,"_2948":120942},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3464":71706,"_30209":71699,"_20922":120944,"_5":14373,"_27447":71699,"_2948":120945},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3464":71707,"_30209":71699,"_20922":120947,"_5":14373,"_27447":120928,"_2948":120948},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3464":71708,"_30209":71699,"_20922":120950,"_5":14373,"_27447":120928,"_2948":120951},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3464":71709,"_30209":71699,"_20922":120953,"_5":14373,"_27447":120932,"_2948":120954},[],"Recurso",{"_3464":71710,"_30209":71699,"_20922":120956,"_5":14373,"_27447":120932,"_2948":120957},[],"Qué representa",{"_3464":71711,"_30209":71699,"_20922":120959,"_5":14373,"_27447":120932,"_2948":120960},[],"**Dispositivo**",{"_3464":71712,"_30209":71699,"_20922":120962,"_5":14373,"_27447":120932,"_2948":120963},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3464":71713,"_30209":71699,"_20922":120965,"_5":14373,"_27447":120932,"_2948":120966},[],"**Identidad**",{"_3464":71714,"_30209":71699,"_20922":120968,"_5":14373,"_27447":120932,"_2948":120969},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3464":71715,"_30209":71699,"_20922":120971,"_5":14373,"_27447":120932,"_2948":54111},[],{"_3464":71716,"_30209":71699,"_20922":120973,"_5":14373,"_27447":120932,"_2948":120974},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3464":71717,"_30209":71699,"_20922":120976,"_5":14373,"_27447":120932,"_2948":120977},[],"**Flota**",{"_3464":71718,"_30209":71699,"_20922":120979,"_5":14373,"_27447":120932,"_2948":120980},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3464":71719,"_30209":71699,"_20922":120982,"_5":14373,"_27447":120932,"_2948":120983},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3464":71720,"_30209":71699,"_20922":120985,"_5":14373,"_27447":120932,"_2948":120986},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3464":71721,"_30209":71699,"_20922":120988,"_5":14373,"_27447":120935,"_2948":120989},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3464":71722,"_30209":71699,"_20922":120991,"_5":14373,"_27447":120935,"_2948":120992},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3464":71723,"_30209":71699,"_20922":120994,"_5":14373,"_27447":120935,"_2948":120995},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3464":71724,"_30209":71699,"_20922":120997,"_5":14373,"_27447":120935,"_2948":120998},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3464":71725,"_30209":71699,"_20922":121000,"_5":14373,"_27447":120935,"_2948":121001},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3464":71726,"_30209":71699,"_20922":121003,"_5":14373,"_27447":120935,"_2948":121004},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3464":71727,"_30209":71699,"_20922":121006,"_5":14373,"_27447":120935,"_2948":121007},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3464":71728,"_30209":71699,"_20922":121009,"_5":14373,"_27447":120935,"_2948":121010},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3464":71729,"_30209":71699,"_20922":121012,"_5":14373,"_27447":120938,"_2948":121013},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3464":71730,"_30209":71699,"_20922":121015,"_5":14373,"_27447":120938,"_2948":121016},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3464":71731,"_30209":71699,"_20922":121018,"_5":14373,"_27447":120941,"_2948":121019},[],"Participante",{"_3464":71732,"_30209":71699,"_20922":121021,"_5":14373,"_27447":120941,"_2948":121022},[],"Responsabilidad",{"_3464":71733,"_30209":71699,"_20922":121024,"_5":14373,"_27447":120941,"_2948":121025},[],"Administrador PKI",{"_3464":71734,"_30209":71699,"_20922":121027,"_5":14373,"_27447":120941,"_2948":121028},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3464":71735,"_30209":71699,"_20922":121030,"_5":14373,"_27447":120941,"_2948":121031},[],"Administrador del aprovisionamiento",{"_3464":71736,"_30209":71699,"_20922":121033,"_5":14373,"_27447":120941,"_2948":121034},[],"DMS, admisión, autenticación por operación e inventario.",{"_3464":71737,"_30209":71699,"_20922":121036,"_5":14373,"_27447":120941,"_2948":121037},[],"Integrador del dispositivo",{"_3464":71738,"_30209":71699,"_20922":121039,"_5":14373,"_27447":120941,"_2948":121040},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3464":71739,"_30209":71699,"_20922":121042,"_5":14373,"_27447":120941,"_2948":121043},[],"Integrador del consumidor",{"_3464":71740,"_30209":71699,"_20922":121045,"_5":14373,"_27447":120941,"_2948":121046},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3464":71741,"_30209":71699,"_20922":121048,"_5":14373,"_27447":120941,"_2948":121049},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3464":71742,"_30209":71742,"_5":14725,"_2948":121051,"_30562":121052,"_20922":121054,"_27447":71742},"Enrola y conecta tu primer dispositivo",[49276,117725,51765,121053],"Primeros pasos",[],{"_3464":71743,"_30209":71742,"_20922":121056,"_5":14373,"_27447":71742,"_2948":121057},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3464":71744,"_30209":71742,"_5":30559,"_20922":121059,"_27447":121060,"_2948":116296},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3464":71745,"_30209":71742,"_5":30559,"_20922":121062,"_27447":121063,"_2948":121064},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3464":71746,"_30209":71742,"_5":30559,"_20922":121066,"_27447":121067,"_2948":121068},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3464":71747,"_30209":71742,"_5":30559,"_20922":121070,"_27447":121071,"_2948":121072},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3464":71748,"_30209":71742,"_5":30559,"_20922":121074,"_27447":121075,"_2948":121076},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3464":71749,"_30209":71742,"_5":30559,"_20922":121078,"_27447":121079,"_2948":121080},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3464":71750,"_30209":71742,"_5":30559,"_20922":121082,"_27447":121083,"_2948":121084},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3464":71751,"_30209":71742,"_5":30559,"_20922":121086,"_27447":121087,"_2948":121088},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3464":71752,"_30209":71742,"_20922":121090,"_5":14373,"_27447":71742,"_2948":121091},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3464":71753,"_30209":71742,"_20922":121093,"_5":14373,"_27447":121060,"_2948":121094},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3464":71754,"_30209":71742,"_20922":121096,"_5":14373,"_27447":121060,"_2948":121097},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3464":71755,"_30209":71742,"_20922":121099,"_5":14373,"_27447":121060,"_2948":121100},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3464":71756,"_30209":71742,"_20922":121102,"_5":14373,"_27447":121060,"_2948":121103},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3464":71757,"_30209":71742,"_20922":121105,"_5":14373,"_27447":121060,"_2948":121106},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3464":71758,"_30209":71742,"_20922":121108,"_5":14373,"_27447":121063,"_2948":121109},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3464":71759,"_30209":71742,"_20922":121111,"_5":14373,"_27447":121063,"_2948":121112},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3464":71760,"_30209":71742,"_20922":121114,"_5":14373,"_27447":121067,"_2948":121115},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3464":71761,"_30209":71742,"_20922":121117,"_5":14373,"_27447":121067,"_2948":121118},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3464":71762,"_30209":71742,"_20922":121120,"_5":14373,"_27447":121067,"_2948":121121},[],"Ajuste",{"_3464":71763,"_30209":71742,"_20922":121123,"_5":14373,"_27447":121067,"_2948":121124},[],"Valor de evaluación",{"_3464":71764,"_30209":71742,"_20922":121126,"_5":14373,"_27447":121067,"_2948":54267},[],{"_3464":71765,"_30209":71742,"_20922":121128,"_5":14373,"_27447":121067,"_2948":121129},[],"Raíz emisora de `device-root.pem`.",{"_3464":71766,"_30209":71742,"_20922":121131,"_5":14373,"_27447":121067,"_2948":119040},[],{"_3464":71767,"_30209":71742,"_20922":121133,"_5":14373,"_27447":121067,"_2948":121134},[],"Perfil final de 1 hora que acabas de preparar.",{"_3464":71768,"_30209":71742,"_20922":121136,"_5":14373,"_27447":121067,"_2948":54278},[],{"_3464":71769,"_30209":71742,"_20922":121138,"_5":14373,"_27447":121067,"_2948":54281},[],{"_3464":71770,"_30209":71742,"_20922":121140,"_5":14373,"_27447":121067,"_2948":54284},[],{"_3464":71771,"_30209":71742,"_20922":121142,"_5":14373,"_27447":121067,"_2948":121143},[],"Habilitado.",{"_3464":71772,"_30209":71742,"_20922":121145,"_5":14373,"_27447":121067,"_2948":54290},[],{"_3464":71773,"_30209":71742,"_20922":121147,"_5":14373,"_27447":121067,"_2948":121148},[],"Deshabilitado; el ID debe ser nuevo.",{"_3464":71774,"_30209":71742,"_20922":121150,"_5":14373,"_27447":121067,"_2948":121151},[],"Autenticación inicial",{"_3464":71775,"_30209":71742,"_20922":121153,"_5":14373,"_27447":121067,"_2948":121154},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3464":71776,"_30209":71742,"_20922":121156,"_5":14373,"_27447":121067,"_2948":121157},[],"Autenticación de renovación",{"_3464":71777,"_30209":71742,"_20922":121159,"_5":14373,"_27447":121067,"_2948":121160},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3464":71778,"_30209":71742,"_20922":121162,"_5":14373,"_27447":121067,"_2948":54308},[],{"_3464":71779,"_30209":71742,"_20922":121164,"_5":14373,"_27447":121067,"_2948":121165},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3464":71780,"_30209":71742,"_20922":121167,"_5":14373,"_27447":121067,"_2948":54314},[],{"_3464":71781,"_30209":71742,"_20922":121169,"_5":14373,"_27447":121067,"_2948":121170},[],"1 hora.",{"_3464":71782,"_30209":71742,"_20922":121172,"_5":14373,"_27447":121067,"_2948":54320},[],{"_3464":71783,"_30209":71742,"_20922":121174,"_5":14373,"_27447":121067,"_2948":121175},[],"30 minutos / 10 minutos.",{"_3464":71784,"_30209":71742,"_20922":121177,"_5":14373,"_27447":121067,"_2948":54326},[],{"_3464":71785,"_30209":71742,"_20922":121179,"_5":14373,"_27447":121067,"_2948":121180},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3464":71786,"_30209":71742,"_20922":121182,"_5":14373,"_27447":121067,"_2948":52084},[],{"_3464":71787,"_30209":71742,"_20922":121184,"_5":14373,"_27447":121067,"_2948":121185},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3464":71788,"_30209":71742,"_20922":121187,"_5":14373,"_27447":121067,"_2948":54337},[],{"_3464":71789,"_30209":71742,"_20922":121189,"_5":14373,"_27447":121067,"_2948":121190},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3464":71790,"_30209":71742,"_20922":121192,"_5":14373,"_27447":121067,"_2948":121193},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3464":71791,"_30209":71742,"_20922":121195,"_5":14373,"_27447":121071,"_2948":121196},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3464":71792,"_30209":71742,"_20922":121198,"_5":14373,"_27447":121071,"_2948":121199},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3464":71793,"_30209":71742,"_20922":121201,"_5":14373,"_27447":121075,"_2948":121202},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3464":71794,"_30209":71742,"_20922":121204,"_5":14373,"_27447":121075,"_2948":121205},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3464":71795,"_30209":71742,"_20922":121207,"_5":14373,"_27447":121075,"_2948":121208},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3464":71796,"_30209":71742,"_20922":121210,"_5":14373,"_27447":121079,"_2948":121211},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3464":71797,"_30209":71742,"_20922":121213,"_5":14373,"_27447":121079,"_2948":121214},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3464":71798,"_30209":71742,"_20922":121216,"_5":14373,"_27447":121083,"_2948":121217},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3464":71799,"_30209":71742,"_20922":121219,"_5":14373,"_27447":121083,"_2948":121220},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3464":71800,"_30209":71742,"_20922":121222,"_5":14373,"_27447":121083,"_2948":121223},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3464":71801,"_30209":71742,"_20922":121225,"_5":14373,"_27447":121083,"_2948":121226},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3464":71802,"_30209":71742,"_20922":121228,"_5":14373,"_27447":121083,"_2948":121229},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3464":71803,"_30209":71742,"_20922":121231,"_5":14373,"_27447":121087,"_2948":121232},[],"Comprobación",{"_3464":71804,"_30209":71742,"_20922":121234,"_5":14373,"_27447":121087,"_2948":121235},[],"Resultado esperado",{"_3464":71805,"_30209":71742,"_20922":121237,"_5":14373,"_27447":121087,"_2948":121238},[],"Registro",{"_3464":71806,"_30209":71742,"_20922":121240,"_5":14373,"_27447":121087,"_2948":121241},[],"ID creado automáticamente y DMS correcto.",{"_3464":71807,"_30209":71742,"_20922":121243,"_5":14373,"_27447":121087,"_2948":120528},[],{"_3464":71808,"_30209":71742,"_20922":121245,"_5":14373,"_27447":121087,"_2948":121246},[],"CN, perfil, serie y clave verificados.",{"_3464":71809,"_30209":71742,"_20922":121248,"_5":14373,"_27447":121087,"_2948":121249},[],"Inventario",{"_3464":71810,"_30209":71742,"_20922":121251,"_5":14373,"_27447":121087,"_2948":121252},[],"Serie recibida visible como identidad actual y en el historial.",{"_3464":71811,"_30209":71742,"_20922":121254,"_5":14373,"_27447":121087,"_2948":121255},[],"Consumidor",{"_3464":71812,"_30209":71742,"_20922":121257,"_5":14373,"_27447":121087,"_2948":121258},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3464":71813,"_30209":71742,"_20922":121260,"_5":14373,"_27447":121087,"_2948":121261},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3464":71814,"_30209":71742,"_20922":121263,"_5":14373,"_27447":121087,"_2948":121264},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3464":71815,"_30209":71815,"_5":14725,"_2948":118754,"_30562":121266,"_20922":121267,"_27447":71815},[49276,117725,51765,121053],[],{"_3464":71816,"_30209":71815,"_20922":121269,"_5":14373,"_27447":71815,"_2948":121270},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3464":71817,"_30209":71815,"_5":30559,"_20922":121272,"_27447":121273,"_2948":116296},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3464":71818,"_30209":71815,"_5":30559,"_20922":121275,"_27447":121276,"_2948":121277},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3464":71819,"_30209":71815,"_5":30559,"_20922":121279,"_27447":121280,"_2948":121281},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3464":71820,"_30209":71815,"_5":30559,"_20922":121283,"_27447":121284,"_2948":121285},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3464":71821,"_30209":71815,"_5":30559,"_20922":121287,"_27447":121288,"_2948":121289},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3464":71822,"_30209":71815,"_5":30559,"_20922":121291,"_27447":121292,"_2948":121293},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3464":71823,"_30209":71815,"_5":30559,"_20922":121295,"_27447":121296,"_2948":121235},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3464":71824,"_30209":71815,"_5":30559,"_20922":121298,"_27447":121299,"_2948":121300},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3464":71825,"_30209":71815,"_5":30559,"_20922":121302,"_27447":121303,"_2948":121304},[],"/docs/pr-preview/pr-63/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3464":71826,"_30209":71815,"_20922":121306,"_5":14373,"_27447":71815,"_2948":121307},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3464":71827,"_30209":71815,"_20922":121309,"_5":14373,"_27447":71815,"_2948":121310},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3464":71828,"_30209":71815,"_20922":121312,"_5":14373,"_27447":121273,"_2948":121313},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3464":71829,"_30209":71815,"_20922":121315,"_5":14373,"_27447":121273,"_2948":121316},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3464":71830,"_30209":71815,"_20922":121318,"_5":14373,"_27447":121273,"_2948":121319},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3464":71831,"_30209":71815,"_20922":121321,"_5":14373,"_27447":121273,"_2948":121322},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3464":71832,"_30209":71815,"_20922":121324,"_5":14373,"_27447":121276,"_2948":121325},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3464":71833,"_30209":71815,"_20922":121327,"_5":14373,"_27447":121276,"_2948":121328},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3464":71834,"_30209":71815,"_20922":121330,"_5":14373,"_27447":121276,"_2948":121331},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3464":71835,"_30209":71815,"_20922":121333,"_5":14373,"_27447":121276,"_2948":121334},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3464":71836,"_30209":71815,"_20922":121336,"_5":14373,"_27447":121276,"_2948":121337},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3464":71837,"_30209":71815,"_20922":121339,"_5":14373,"_27447":121276,"_2948":121340},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3464":71838,"_30209":71815,"_20922":121342,"_5":14373,"_27447":121276,"_2948":121343},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3464":71839,"_30209":71815,"_20922":121345,"_5":14373,"_27447":121276,"_2948":121346},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3464":71840,"_30209":71815,"_20922":121348,"_5":14373,"_27447":121280,"_2948":121349},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3464":71841,"_30209":71815,"_20922":121351,"_5":14373,"_27447":121280,"_2948":54502},[],{"_3464":71842,"_30209":71815,"_20922":121353,"_5":14373,"_27447":121280,"_2948":121354},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3464":71843,"_30209":71815,"_20922":121356,"_5":14373,"_27447":121280,"_2948":121357},[],"**Icon** y **Tags**: clasificación opcional.",{"_3464":71844,"_30209":71815,"_20922":121359,"_5":14373,"_27447":121280,"_2948":121360},[],"Confirma el registro.",{"_3464":71845,"_30209":71815,"_20922":121362,"_5":14373,"_27447":121284,"_2948":121363},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3464":71846,"_30209":71815,"_20922":121365,"_5":14373,"_27447":121284,"_2948":121366},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3464":71847,"_30209":71815,"_20922":121368,"_5":14373,"_27447":121288,"_2948":121369},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3464":71848,"_30209":71815,"_20922":121371,"_5":14373,"_27447":121288,"_2948":121372},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3464":71849,"_30209":71815,"_20922":121374,"_5":14373,"_27447":121292,"_2948":121375},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3464":71850,"_30209":71815,"_20922":121377,"_5":14373,"_27447":121292,"_2948":121378},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3464":71851,"_30209":71815,"_20922":121380,"_5":14373,"_27447":121296,"_2948":121232},[],{"_3464":71852,"_30209":71815,"_20922":121382,"_5":14373,"_27447":121296,"_2948":121383},[],"Resultado",{"_3464":71853,"_30209":71815,"_20922":121385,"_5":14373,"_27447":121296,"_2948":120514},[],{"_3464":71854,"_30209":71815,"_20922":121387,"_5":14373,"_27447":121296,"_2948":121388},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3464":71855,"_30209":71815,"_20922":121390,"_5":14373,"_27447":121296,"_2948":121391},[],"Identidad actual",{"_3464":71856,"_30209":71815,"_20922":121393,"_5":14373,"_27447":121296,"_2948":121394},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3464":71857,"_30209":71815,"_20922":121396,"_5":14373,"_27447":121296,"_2948":121397},[],"Historial",{"_3464":71858,"_30209":71815,"_20922":121399,"_5":14373,"_27447":121296,"_2948":121400},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3464":71859,"_30209":71815,"_20922":121402,"_5":14373,"_27447":121296,"_2948":121403},[],"Clave y certificado",{"_3464":71860,"_30209":71815,"_20922":121405,"_5":14373,"_27447":121296,"_2948":121406},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3464":71861,"_30209":71815,"_20922":121408,"_5":14373,"_27447":121299,"_2948":121409},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3464":71862,"_30209":71815,"_20922":121411,"_5":14373,"_27447":121299,"_2948":121412},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3464":71863,"_30209":71815,"_20922":121414,"_5":14373,"_27447":121299,"_2948":121415},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3464":71864,"_30209":71815,"_20922":121417,"_5":14373,"_27447":121299,"_2948":121418},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3464":71865,"_30209":71815,"_20922":121420,"_5":14373,"_27447":121303,"_2948":121421},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3464":71866,"_30209":71815,"_20922":121423,"_5":14373,"_27447":121303,"_2948":121424},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3464":71867,"_30209":71815,"_20922":121426,"_5":14373,"_27447":121303,"_2948":121427},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3464":71868,"_30209":71868,"_5":14725,"_2948":121429,"_30562":121430,"_20922":121431,"_27447":71868},"Plataforma Lamassu IoT",[49276,117725],[],{"_3464":71869,"_30209":71868,"_20922":121433,"_5":14373,"_27447":71868,"_2948":121434},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3464":71870,"_30209":71868,"_5":30559,"_20922":121436,"_27447":121437,"_2948":120929},[],"/docs/pr-preview/pr-63/es/platform/overview#empieza-aquí",{"_3464":71871,"_30209":71868,"_5":30559,"_20922":121439,"_27447":121440,"_2948":121441},[],"/docs/pr-preview/pr-63/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3464":71872,"_30209":71868,"_5":30559,"_20922":121443,"_27447":121444,"_2948":121445},[],"/docs/pr-preview/pr-63/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3464":71873,"_30209":71868,"_5":30559,"_20922":121447,"_27447":121448,"_2948":121449},[],"/docs/pr-preview/pr-63/es/platform/overview#capacidades-principales","Capacidades principales",{"_3464":71874,"_30209":71868,"_5":30559,"_20922":121451,"_27447":121452,"_2948":121453},[],"/docs/pr-preview/pr-63/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3464":71875,"_30209":71868,"_5":30559,"_20922":121455,"_27447":121456,"_2948":121457},[],"/docs/pr-preview/pr-63/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3464":71876,"_30209":71868,"_5":30559,"_20922":121459,"_27447":121460,"_2948":121461},[],"/docs/pr-preview/pr-63/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3464":71877,"_30209":71868,"_5":30559,"_20922":121463,"_27447":121464,"_2948":121465},[],"/docs/pr-preview/pr-63/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3464":71878,"_30209":71868,"_5":30559,"_20922":121467,"_27447":121468,"_2948":121469},[],"/docs/pr-preview/pr-63/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3464":71879,"_30209":71868,"_5":30559,"_20922":121471,"_27447":121472,"_2948":121473},[],"/docs/pr-preview/pr-63/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3464":71880,"_30209":71868,"_5":30559,"_20922":121475,"_27447":121476,"_2948":121477},[],"/docs/pr-preview/pr-63/es/platform/overview#referencia-operativa","Referencia operativa",{"_3464":71881,"_30209":71868,"_20922":121479,"_5":14373,"_27447":71868,"_2948":121480},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3464":71882,"_30209":71868,"_20922":121482,"_5":14373,"_27447":121437,"_2948":121483},[],"Elige el resultado que necesitas obtener:",{"_3464":71883,"_30209":71868,"_20922":121485,"_5":14373,"_27447":121437,"_2948":121486},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3464":71884,"_30209":71868,"_20922":121488,"_5":14373,"_27447":121437,"_2948":121489},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3464":71885,"_30209":71868,"_20922":121491,"_5":14373,"_27447":121437,"_2948":121492},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3464":71886,"_30209":71868,"_20922":121494,"_5":14373,"_27447":121440,"_2948":121495},[],"Bloque",{"_3464":71887,"_30209":71868,"_20922":121497,"_5":14373,"_27447":121440,"_2948":121498},[],"Qué gestionas",{"_3464":71888,"_30209":71868,"_20922":121500,"_5":14373,"_27447":121440,"_2948":121501},[],"Punto de entrada",{"_3464":71889,"_30209":71868,"_20922":121503,"_5":14373,"_27447":121440,"_2948":54655},[],{"_3464":71890,"_30209":71868,"_20922":121505,"_5":14373,"_27447":121440,"_2948":121506},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3464":71891,"_30209":71868,"_20922":121508,"_5":14373,"_27447":121440,"_2948":121509},[],"Visión general de PKI",{"_3464":71892,"_30209":71868,"_20922":121511,"_5":14373,"_27447":121440,"_2948":54664},[],{"_3464":71893,"_30209":71868,"_20922":121513,"_5":14373,"_27447":121440,"_2948":121514},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3464":71894,"_30209":71868,"_20922":121516,"_5":14373,"_27447":121440,"_2948":121517},[],"Visión general de IoT Fleets",{"_3464":71895,"_30209":71868,"_20922":121519,"_5":14373,"_27447":121440,"_2948":121520},[],"**Administración**",{"_3464":71896,"_30209":71868,"_20922":121522,"_5":14373,"_27447":121440,"_2948":121523},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3464":71897,"_30209":71868,"_20922":121525,"_5":14373,"_27447":121440,"_2948":117723},[],{"_3464":71898,"_30209":71868,"_20922":121527,"_5":14373,"_27447":121440,"_2948":121528},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3464":71899,"_30209":71868,"_20922":121530,"_5":14373,"_27447":121444,"_2948":121531},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3464":71900,"_30209":71868,"_20922":121533,"_5":14373,"_27447":121444,"_2948":121534},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3464":71901,"_30209":71868,"_20922":121536,"_5":14373,"_27447":121444,"_2948":121537},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3464":71902,"_30209":71868,"_20922":121539,"_5":14373,"_27447":121444,"_2948":121540},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3464":71903,"_30209":71868,"_20922":121542,"_5":14373,"_27447":121444,"_2948":121543},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3464":71904,"_30209":71868,"_20922":121545,"_5":14373,"_27447":121444,"_2948":121546},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3464":71905,"_30209":71868,"_20922":121548,"_5":14373,"_27447":121452,"_2948":121549},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3464":71906,"_30209":71868,"_20922":121551,"_5":14373,"_27447":121456,"_2948":121552},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3464":71907,"_30209":71868,"_20922":121554,"_5":14373,"_27447":121460,"_2948":121555},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3464":71908,"_30209":71868,"_20922":121557,"_5":14373,"_27447":121464,"_2948":121558},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3464":71909,"_30209":71868,"_20922":121560,"_5":14373,"_27447":121468,"_2948":121561},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3464":71910,"_30209":71868,"_20922":121563,"_5":14373,"_27447":121472,"_2948":121564},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3464":71911,"_30209":71868,"_20922":121566,"_5":14373,"_27447":121476,"_2948":121022},[],{"_3464":71912,"_30209":71868,"_20922":121568,"_5":14373,"_27447":121476,"_2948":121569},[],"Qué prepara o comprueba",{"_3464":71913,"_30209":71868,"_20922":121571,"_5":14373,"_27447":121476,"_2948":121025},[],{"_3464":71914,"_30209":71868,"_20922":121573,"_5":14373,"_27447":121476,"_2948":121574},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3464":71915,"_30209":71868,"_20922":121576,"_5":14373,"_27447":121476,"_2948":121577},[],"Administrador de la flota",{"_3464":71916,"_30209":71868,"_20922":121579,"_5":14373,"_27447":121476,"_2948":121580},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3464":71917,"_30209":71868,"_20922":121582,"_5":14373,"_27447":121476,"_2948":121037},[],{"_3464":71918,"_30209":71868,"_20922":121584,"_5":14373,"_27447":121476,"_2948":121585},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3464":71919,"_30209":71868,"_20922":121587,"_5":14373,"_27447":121476,"_2948":121043},[],{"_3464":71920,"_30209":71868,"_20922":121589,"_5":14373,"_27447":121476,"_2948":121590},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3464":71921,"_30209":71868,"_20922":121592,"_5":14373,"_27447":121476,"_2948":121593},[],"Operador de infraestructura",{"_3464":71922,"_30209":71868,"_20922":121595,"_5":14373,"_27447":121476,"_2948":121596},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3464":71923,"_30209":71868,"_20922":121598,"_5":14373,"_27447":121476,"_2948":121599},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3464":71924,"_30209":71924,"_5":14725,"_2948":121601,"_30562":121602,"_20922":121604,"_27447":71924},"Jerarquía y rotación de CAs",[49276,117725,54756,121603],"Claves, autoridades y certificados",[],{"_3464":71925,"_30209":71924,"_20922":121606,"_5":14373,"_27447":71924,"_2948":121607},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3464":71926,"_30209":71924,"_5":30559,"_20922":121609,"_27447":121610,"_2948":121611},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3464":71927,"_30209":71924,"_5":30559,"_20922":121613,"_27447":121614,"_2948":121615},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3464":71928,"_30209":71924,"_5":30559,"_20922":121617,"_27447":121618,"_2948":121619},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3464":71929,"_30209":71924,"_5":30559,"_20922":121621,"_27447":121622,"_2948":121623},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3464":71930,"_30209":71924,"_5":30559,"_20922":121625,"_27447":121626,"_2948":121627},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3464":71931,"_30209":71924,"_5":30559,"_20922":121629,"_27447":121630,"_2948":121631},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3464":71932,"_30209":71924,"_5":30559,"_20922":121633,"_27447":121634,"_2948":121635},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3464":71933,"_30209":71924,"_5":30559,"_20922":121637,"_27447":121638,"_2948":121639},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3464":71934,"_30209":71924,"_5":30559,"_20922":121641,"_27447":121642,"_2948":121643},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3464":71935,"_30209":71924,"_5":30559,"_20922":121645,"_27447":121646,"_2948":121647},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3464":71936,"_30209":71924,"_5":30559,"_20922":121649,"_27447":121650,"_2948":121651},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3464":71937,"_30209":71924,"_5":30559,"_20922":121653,"_27447":121654,"_2948":121655},[],"/docs/pr-preview/pr-63/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3464":71938,"_30209":71924,"_20922":121657,"_5":14373,"_27447":71924,"_2948":121658},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3464":71939,"_30209":71924,"_20922":121660,"_5":14373,"_27447":71924,"_2948":121661},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3464":71940,"_30209":71924,"_20922":121663,"_5":14373,"_27447":121610,"_2948":121664},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3464":71941,"_30209":71924,"_20922":121666,"_5":14373,"_27447":121610,"_2948":121667},[],"entorno, como producción y preproducción;",{"_3464":71942,"_30209":71924,"_20922":121669,"_5":14373,"_27447":121610,"_2948":121670},[],"propietario o equipo operador;",{"_3464":71943,"_30209":71924,"_20922":121672,"_5":14373,"_27447":121610,"_2948":121673},[],"familia de dispositivos o proceso de fabricación;",{"_3464":71944,"_30209":71924,"_20922":121675,"_5":14373,"_27447":121610,"_2948":121676},[],"región o requisito regulatorio;",{"_3464":71945,"_30209":71924,"_20922":121678,"_5":14373,"_27447":121610,"_2948":121679},[],"motor criptográfico o política de clave;",{"_3464":71946,"_30209":71924,"_20922":121681,"_5":14373,"_27447":121610,"_2948":121682},[],"ventana de mantenimiento y ritmo de renovación.",{"_3464":71947,"_30209":71924,"_20922":121684,"_5":14373,"_27447":121610,"_2948":121685},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3464":71948,"_30209":71924,"_20922":121687,"_5":14373,"_27447":121610,"_2948":121688},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3464":71949,"_30209":71924,"_20922":121690,"_5":14373,"_27447":121614,"_2948":121691},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3464":71950,"_30209":71924,"_20922":121693,"_5":14373,"_27447":121614,"_2948":121694},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3464":71951,"_30209":71924,"_20922":121696,"_5":14373,"_27447":121614,"_2948":121697},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3464":71952,"_30209":71924,"_20922":121699,"_5":14373,"_27447":121614,"_2948":121700},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3464":71953,"_30209":71924,"_20922":121702,"_5":14373,"_27447":121618,"_2948":121703},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3464":71954,"_30209":71924,"_20922":121705,"_5":14373,"_27447":121618,"_2948":121706},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3464":71955,"_30209":71924,"_20922":121708,"_5":14373,"_27447":121618,"_2948":121709},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3464":71956,"_30209":71924,"_20922":121711,"_5":14373,"_27447":121618,"_2948":121712},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3464":71957,"_30209":71924,"_20922":121714,"_5":14373,"_27447":121626,"_2948":121715},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3464":71958,"_30209":71924,"_20922":121717,"_5":14373,"_27447":121630,"_2948":121718},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3464":71959,"_30209":71924,"_20922":121720,"_5":14373,"_27447":121634,"_2948":121721},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3464":71960,"_30209":71924,"_20922":121723,"_5":14373,"_27447":121638,"_2948":121724},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3464":71961,"_30209":71924,"_20922":121726,"_5":14373,"_27447":121642,"_2948":121727},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3464":71962,"_30209":71924,"_20922":121729,"_5":14373,"_27447":121646,"_2948":121730},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3464":71963,"_30209":71924,"_20922":121732,"_5":14373,"_27447":121650,"_2948":121733},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3464":71964,"_30209":71924,"_20922":121735,"_5":14373,"_27447":121650,"_2948":121736},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3464":71965,"_30209":71924,"_20922":121738,"_5":14373,"_27447":121650,"_2948":121739},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3464":71966,"_30209":71924,"_20922":121741,"_5":14373,"_27447":121650,"_2948":121742},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3464":71967,"_30209":71924,"_20922":121744,"_5":14373,"_27447":121654,"_2948":121745},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3464":71968,"_30209":71924,"_20922":121747,"_5":14373,"_27447":121654,"_2948":121748},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3464":71969,"_30209":71924,"_20922":121750,"_5":14373,"_27447":121654,"_2948":121751},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3464":71970,"_30209":71924,"_20922":121753,"_5":14373,"_27447":121654,"_2948":121754},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3464":71971,"_30209":71924,"_20922":121756,"_5":14373,"_27447":121654,"_2948":121757},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3464":71972,"_30209":71924,"_20922":121759,"_5":14373,"_27447":121654,"_2948":121760},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3464":71973,"_30209":71924,"_20922":121762,"_5":14373,"_27447":121654,"_2948":121763},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3464":71974,"_30209":71974,"_5":14725,"_2948":121765,"_30562":121766,"_20922":121767,"_27447":71974},"Autoridades de certificación",[49276,117725,54756,121603],[],{"_3464":71975,"_30209":71974,"_20922":121769,"_5":14373,"_27447":71974,"_2948":121770},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3464":71976,"_30209":71974,"_5":30559,"_20922":121772,"_27447":121773,"_2948":121774},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3464":71977,"_30209":71974,"_5":30559,"_20922":121776,"_27447":121777,"_2948":121778},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3464":71978,"_30209":71974,"_5":30559,"_20922":121780,"_27447":121781,"_2948":116296},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3464":71979,"_30209":71974,"_5":30559,"_20922":121783,"_27447":121784,"_2948":121785},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3464":71980,"_30209":71974,"_5":30559,"_20922":121787,"_27447":121788,"_2948":121789},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3464":71981,"_30209":71974,"_5":30559,"_20922":121791,"_27447":121792,"_2948":121793},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3464":71982,"_30209":71974,"_5":30559,"_20922":121795,"_27447":121796,"_2948":121797},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3464":71983,"_30209":71974,"_5":30559,"_20922":121799,"_27447":121800,"_2948":121801},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3464":71984,"_30209":71974,"_5":30559,"_20922":121803,"_27447":121804,"_2948":121805},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3464":71985,"_30209":71974,"_5":30559,"_20922":121807,"_27447":121808,"_2948":121809},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3464":71986,"_30209":71974,"_5":30559,"_20922":121811,"_27447":121812,"_2948":121813},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3464":71987,"_30209":71974,"_5":30559,"_20922":121815,"_27447":121816,"_2948":121817},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3464":71988,"_30209":71974,"_5":30559,"_20922":121819,"_27447":121820,"_2948":121821},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3464":71989,"_30209":71974,"_5":30559,"_20922":121823,"_27447":121824,"_2948":121825},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3464":71990,"_30209":71974,"_5":30559,"_20922":121827,"_27447":121828,"_2948":121829},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3464":71991,"_30209":71974,"_5":30559,"_20922":121831,"_27447":121832,"_2948":121833},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3464":71992,"_30209":71974,"_5":30559,"_20922":121835,"_27447":121836,"_2948":121837},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3464":71993,"_30209":71974,"_5":30559,"_20922":121839,"_27447":121840,"_2948":121841},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3464":71994,"_30209":71974,"_5":30559,"_20922":121843,"_27447":121844,"_2948":121845},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3464":71995,"_30209":71974,"_5":30559,"_20922":121847,"_27447":121848,"_2948":121849},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3464":71996,"_30209":71974,"_5":30559,"_20922":121851,"_27447":121852,"_2948":121853},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3464":71997,"_30209":71974,"_5":30559,"_20922":121855,"_27447":121856,"_2948":121857},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3464":71998,"_30209":71974,"_5":30559,"_20922":121859,"_27447":121860,"_2948":121861},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3464":71999,"_30209":71974,"_20922":121863,"_5":14373,"_27447":71974,"_2948":121864},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3464":72000,"_30209":71974,"_20922":121866,"_5":14373,"_27447":71974,"_2948":121867},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3464":72001,"_30209":71974,"_20922":121869,"_5":14373,"_27447":71974,"_2948":121870},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3464":72002,"_30209":71974,"_20922":121872,"_5":14373,"_27447":121773,"_2948":121873},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3464":72003,"_30209":71974,"_20922":121875,"_5":14373,"_27447":121773,"_2948":121876},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3464":72004,"_30209":71974,"_20922":121878,"_5":14373,"_27447":121773,"_2948":121879},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3464":72005,"_30209":71974,"_20922":121881,"_5":14373,"_27447":121773,"_2948":121882},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3464":72006,"_30209":71974,"_20922":121884,"_5":14373,"_27447":121773,"_2948":121885},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3464":72007,"_30209":71974,"_20922":121887,"_5":14373,"_27447":121781,"_2948":121888},[],"Decide si la CA será raíz o intermedia.",{"_3464":72008,"_30209":71974,"_20922":121890,"_5":14373,"_27447":121781,"_2948":121891},[],"Elige el motor que custodiará la clave.",{"_3464":72009,"_30209":71974,"_20922":121893,"_5":14373,"_27447":121781,"_2948":121894},[],"Define una validez superior a la de los certificados que emitirá.",{"_3464":72010,"_30209":71974,"_20922":121896,"_5":14373,"_27447":121781,"_2948":121897},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3464":72011,"_30209":71974,"_20922":121899,"_5":14373,"_27447":121784,"_2948":121900},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3464":72012,"_30209":71974,"_20922":121902,"_5":14373,"_27447":121788,"_2948":121903},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3464":72013,"_30209":71974,"_20922":121905,"_5":14373,"_27447":121788,"_2948":121906},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3464":72014,"_30209":71974,"_20922":121908,"_5":14373,"_27447":121792,"_2948":121909},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3464":72015,"_30209":71974,"_20922":121911,"_5":14373,"_27447":121796,"_2948":121912},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3464":72016,"_30209":71974,"_20922":121914,"_5":14373,"_27447":121796,"_2948":121915},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3464":72017,"_30209":71974,"_20922":121917,"_5":14373,"_27447":121796,"_2948":121918},[],"`ST`: estado o provincia.",{"_3464":72018,"_30209":71974,"_20922":121920,"_5":14373,"_27447":121796,"_2948":121921},[],"`L`: localidad.",{"_3464":72019,"_30209":71974,"_20922":121923,"_5":14373,"_27447":121796,"_2948":121924},[],"`O`: organización.",{"_3464":72020,"_30209":71974,"_20922":121926,"_5":14373,"_27447":121796,"_2948":121927},[],"`OU`: unidad organizativa.",{"_3464":72021,"_30209":71974,"_20922":121929,"_5":14373,"_27447":121796,"_2948":121930},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3464":72022,"_30209":71974,"_20922":121932,"_5":14373,"_27447":121800,"_2948":121933},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3464":72023,"_30209":71974,"_20922":121935,"_5":14373,"_27447":121800,"_2948":121936},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3464":72024,"_30209":71974,"_20922":121938,"_5":14373,"_27447":121804,"_2948":121939},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3464":72025,"_30209":71974,"_20922":121941,"_5":14373,"_27447":121804,"_2948":121942},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3464":72026,"_30209":71974,"_20922":121944,"_5":14373,"_27447":121808,"_2948":121945},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3464":72027,"_30209":71974,"_20922":121947,"_5":14373,"_27447":121808,"_2948":121948},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3464":72028,"_30209":71974,"_20922":121950,"_5":14373,"_27447":121812,"_2948":121951},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3464":72029,"_30209":71974,"_20922":121953,"_5":14373,"_27447":121812,"_2948":121954},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3464":72030,"_30209":71974,"_20922":121956,"_5":14373,"_27447":121812,"_2948":121957},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3464":72031,"_30209":71974,"_20922":121959,"_5":14373,"_27447":121816,"_2948":121960},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3464":72032,"_30209":71974,"_20922":121962,"_5":14373,"_27447":121820,"_2948":121963},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3464":72033,"_30209":71974,"_20922":121965,"_5":14373,"_27447":121820,"_2948":121966},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3464":72034,"_30209":71974,"_20922":121968,"_5":14373,"_27447":121824,"_2948":121969},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3464":72035,"_30209":71974,"_20922":121971,"_5":14373,"_27447":121828,"_2948":121972},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3464":72036,"_30209":71974,"_20922":121974,"_5":14373,"_27447":121828,"_2948":121975},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3464":72037,"_30209":71974,"_20922":121977,"_5":14373,"_27447":121832,"_2948":121978},[],"Abre una CA desde el inventario para consultar:",{"_3464":72038,"_30209":71974,"_20922":121980,"_5":14373,"_27447":121832,"_2948":121981},[],"Estado y periodo de validez.",{"_3464":72039,"_30209":71974,"_20922":121983,"_5":14373,"_27447":121832,"_2948":121984},[],"Certificado y cadena en formato PEM.",{"_3464":72040,"_30209":71974,"_20922":121986,"_5":14373,"_27447":121832,"_2948":121987},[],"Número de certificados activos, expirados y revocados.",{"_3464":72041,"_30209":71974,"_20922":121989,"_5":14373,"_27447":121832,"_2948":121990},[],"Certificados emitidos en **Issued Certificates**.",{"_3464":72042,"_30209":71974,"_20922":121992,"_5":14373,"_27447":121832,"_2948":121993},[],"CRL vinculada a la autoridad.",{"_3464":72043,"_30209":71974,"_20922":121995,"_5":14373,"_27447":121832,"_2948":121996},[],"Metadatos y motor criptográfico asociado.",{"_3464":72044,"_30209":71974,"_20922":121998,"_5":14373,"_27447":121832,"_2948":121999},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3464":72045,"_30209":71974,"_20922":122001,"_5":14373,"_27447":121836,"_2948":122002},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3464":72046,"_30209":71974,"_20922":122004,"_5":14373,"_27447":121836,"_2948":122005},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3464":72047,"_30209":71974,"_20922":122007,"_5":14373,"_27447":121836,"_2948":122008},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3464":72048,"_30209":71974,"_20922":122010,"_5":14373,"_27447":121836,"_2948":122011},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3464":72049,"_30209":71974,"_20922":122013,"_5":14373,"_27447":121840,"_2948":122014},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3464":72050,"_30209":71974,"_20922":122016,"_5":14373,"_27447":121844,"_2948":122017},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3464":72051,"_30209":71974,"_20922":122019,"_5":14373,"_27447":121848,"_2948":122020},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3464":72052,"_30209":71974,"_20922":122022,"_5":14373,"_27447":121852,"_2948":122023},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3464":72053,"_30209":71974,"_20922":122025,"_5":14373,"_27447":121856,"_2948":122026},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3464":72054,"_30209":71974,"_20922":122028,"_5":14373,"_27447":121860,"_2948":122029},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3464":72055,"_30209":71974,"_20922":122031,"_5":14373,"_27447":121860,"_2948":122032},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3464":72056,"_30209":71974,"_20922":122034,"_5":14373,"_27447":121860,"_2948":122035},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3464":72057,"_30209":72057,"_5":14725,"_2948":122037,"_30562":122038,"_20922":122039,"_27447":72057},"Perfiles de certificado",[49276,117725,54756,121603],[],{"_3464":72058,"_30209":72057,"_20922":122041,"_5":14373,"_27447":72057,"_2948":122042},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3464":72059,"_30209":72057,"_5":30559,"_20922":122044,"_27447":122045,"_2948":122046},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3464":72060,"_30209":72057,"_5":30559,"_20922":122048,"_27447":122049,"_2948":122050},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#validez","Validez",{"_3464":72061,"_30209":72057,"_5":30559,"_20922":122052,"_27447":122053,"_2948":122054},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3464":72062,"_30209":72057,"_5":30559,"_20922":122056,"_27447":122057,"_2948":122058},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3464":72063,"_30209":72057,"_5":30559,"_20922":122060,"_27447":122061,"_2948":122062},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3464":72064,"_30209":72057,"_5":30559,"_20922":122064,"_27447":122065,"_2948":122066},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3464":72065,"_30209":72057,"_5":30559,"_20922":122068,"_27447":122069,"_2948":122070},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3464":72066,"_30209":72057,"_5":30559,"_20922":122072,"_27447":122073,"_2948":122074},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3464":72067,"_30209":72057,"_5":30559,"_20922":122076,"_27447":122077,"_2948":122078},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3464":72068,"_30209":72057,"_5":30559,"_20922":122080,"_27447":122081,"_2948":122082},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3464":72069,"_30209":72057,"_5":30559,"_20922":122084,"_27447":122085,"_2948":122086},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3464":72070,"_30209":72057,"_5":30559,"_20922":122088,"_27447":122089,"_2948":122090},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3464":72071,"_30209":72057,"_5":30559,"_20922":122092,"_27447":122093,"_2948":122094},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3464":72072,"_30209":72057,"_5":30559,"_20922":122096,"_27447":122097,"_2948":122098},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3464":72073,"_30209":72057,"_5":30559,"_20922":122100,"_27447":122101,"_2948":122102},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3464":72074,"_30209":72057,"_5":30559,"_20922":122104,"_27447":122105,"_2948":122106},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3464":72075,"_30209":72057,"_20922":122108,"_5":14373,"_27447":72057,"_2948":122109},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3464":72076,"_30209":72057,"_20922":122111,"_5":14373,"_27447":72057,"_2948":122112},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3464":72077,"_30209":72057,"_20922":122114,"_5":14373,"_27447":122049,"_2948":122115},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3464":72078,"_30209":72057,"_20922":122117,"_5":14373,"_27447":122049,"_2948":122118},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3464":72079,"_30209":72057,"_20922":122120,"_5":14373,"_27447":122053,"_2948":122121},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3464":72080,"_30209":72057,"_20922":122123,"_5":14373,"_27447":122057,"_2948":122124},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3464":72081,"_30209":72057,"_20922":122126,"_5":14373,"_27447":122057,"_2948":122127},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3464":72082,"_30209":72057,"_20922":122129,"_5":14373,"_27447":122057,"_2948":122130},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3464":72083,"_30209":72057,"_20922":122132,"_5":14373,"_27447":122061,"_2948":122133},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3464":72084,"_30209":72057,"_20922":122135,"_5":14373,"_27447":122065,"_2948":122136},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3464":72085,"_30209":72057,"_20922":122138,"_5":14373,"_27447":122065,"_2948":122139},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3464":72086,"_30209":72057,"_20922":122141,"_5":14373,"_27447":122069,"_2948":122142},[],"La aplicación criptográfica puede:",{"_3464":72087,"_30209":72057,"_20922":122144,"_5":14373,"_27447":122069,"_2948":122145},[],"permitir o bloquear claves RSA;",{"_3464":72088,"_30209":72057,"_20922":122147,"_5":14373,"_27447":122069,"_2948":122148},[],"limitar los tamaños RSA admitidos;",{"_3464":72089,"_30209":72057,"_20922":122150,"_5":14373,"_27447":122069,"_2948":122151},[],"permitir o bloquear claves ECDSA;",{"_3464":72090,"_30209":72057,"_20922":122153,"_5":14373,"_27447":122069,"_2948":122154},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3464":72091,"_30209":72057,"_20922":122156,"_5":14373,"_27447":122069,"_2948":122157},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3464":72092,"_30209":72057,"_20922":122159,"_5":14373,"_27447":122073,"_2948":122160},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3464":72093,"_30209":72057,"_20922":122162,"_5":14373,"_27447":122073,"_2948":117485},[],{"_3464":72094,"_30209":72057,"_20922":122164,"_5":14373,"_27447":122073,"_2948":122165},[],"Primera opción",{"_3464":72095,"_30209":72057,"_20922":122167,"_5":14373,"_27447":122073,"_2948":122168},[],"Segunda opción",{"_3464":72096,"_30209":72057,"_20922":122170,"_5":14373,"_27447":122073,"_2948":122171},[],"Si no hay ninguna",{"_3464":72097,"_30209":72057,"_20922":122173,"_5":14373,"_27447":122073,"_2948":122174},[],"Firma directa con una CA",{"_3464":72098,"_30209":72057,"_20922":122176,"_5":14373,"_27447":122073,"_2948":122177},[],"`issuance_profile` incluido en la solicitud",{"_3464":72099,"_30209":72057,"_20922":122179,"_5":14373,"_27447":122073,"_2948":122180},[],"`issuance_profile_id` de la solicitud",{"_3464":72100,"_30209":72057,"_20922":122182,"_5":14373,"_27447":122073,"_2948":122183},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3464":72101,"_30209":72057,"_20922":122185,"_5":14373,"_27447":122073,"_2948":122186},[],"Emisión mediante DMS",{"_3464":72102,"_30209":72057,"_20922":122188,"_5":14373,"_27447":122073,"_2948":55343},[],{"_3464":72103,"_30209":72057,"_20922":122190,"_5":14373,"_27447":122073,"_2948":122191},[],"`settings.issuance_profile` incluido en el DMS",{"_3464":72104,"_30209":72057,"_20922":122193,"_5":14373,"_27447":122073,"_2948":122194},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3464":72105,"_30209":72057,"_20922":122196,"_5":14373,"_27447":122073,"_2948":122197},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3464":72106,"_30209":72057,"_20922":122199,"_5":14373,"_27447":122073,"_2948":122200},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3464":72107,"_30209":72057,"_20922":122202,"_5":14373,"_27447":122081,"_2948":122203},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3464":72108,"_30209":72057,"_20922":122205,"_5":14373,"_27447":122085,"_2948":122206},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3464":72109,"_30209":72057,"_20922":122208,"_5":14373,"_27447":122089,"_2948":122209},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3464":72110,"_30209":72057,"_20922":122211,"_5":14373,"_27447":122093,"_2948":122212},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3464":72111,"_30209":72057,"_20922":122214,"_5":14373,"_27447":122097,"_2948":122215},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3464":72112,"_30209":72057,"_20922":122217,"_5":14373,"_27447":122097,"_2948":122218},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3464":72113,"_30209":72057,"_20922":122220,"_5":14373,"_27447":122101,"_2948":122221},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3464":72114,"_30209":72057,"_20922":122223,"_5":14373,"_27447":122101,"_2948":122224},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3464":72115,"_30209":72057,"_20922":122226,"_5":14373,"_27447":122101,"_2948":122227},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3464":72116,"_30209":72057,"_20922":122229,"_5":14373,"_27447":122101,"_2948":122230},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3464":72117,"_30209":72057,"_20922":122232,"_5":14373,"_27447":122105,"_2948":122233},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3464":72118,"_30209":72057,"_20922":122235,"_5":14373,"_27447":122105,"_2948":122236},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3464":72119,"_30209":72119,"_5":14725,"_2948":122238,"_30562":122239,"_20922":122241,"_27447":72119},"Validación de certificados",[49276,117725,54756,122240],"Validación",[],{"_3464":72120,"_30209":72119,"_20922":122243,"_5":14373,"_27447":72119,"_2948":122244},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3464":72121,"_30209":72119,"_5":30559,"_20922":122246,"_27447":122247,"_2948":122248},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3464":72122,"_30209":72119,"_5":30559,"_20922":122250,"_27447":122251,"_2948":122252},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3464":72123,"_30209":72119,"_5":30559,"_20922":122254,"_27447":122255,"_2948":122256},[],"/docs/pr-preview/pr-63/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3464":72124,"_30209":72119,"_20922":122258,"_5":14373,"_27447":72119,"_2948":122259},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3464":72125,"_30209":72119,"_20922":122261,"_5":14373,"_27447":122247,"_2948":122262},[],"Verifica estos criterios juntos:",{"_3464":72126,"_30209":72119,"_20922":122264,"_5":14373,"_27447":122247,"_2948":121232},[],{"_3464":72127,"_30209":72119,"_20922":122266,"_5":14373,"_27447":122247,"_2948":122267},[],"Resultado necesario",{"_3464":72128,"_30209":72119,"_20922":122269,"_5":14373,"_27447":122247,"_2948":122270},[],"Cadena y firma",{"_3464":72129,"_30209":72119,"_20922":122272,"_5":14373,"_27447":122247,"_2948":122273},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3464":72130,"_30209":72119,"_20922":122275,"_5":14373,"_27447":122247,"_2948":122276},[],"Fechas",{"_3464":72131,"_30209":72119,"_20922":122278,"_5":14373,"_27447":122247,"_2948":122279},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3464":72132,"_30209":72119,"_20922":122281,"_5":14373,"_27447":122247,"_2948":117395},[],{"_3464":72133,"_30209":72119,"_20922":122283,"_5":14373,"_27447":122247,"_2948":122284},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3464":72134,"_30209":72119,"_20922":122286,"_5":14373,"_27447":122247,"_2948":122287},[],"Uso",{"_3464":72135,"_30209":72119,"_20922":122289,"_5":14373,"_27447":122247,"_2948":122290},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3464":72136,"_30209":72119,"_20922":122292,"_5":14373,"_27447":122247,"_2948":122293},[],"Revocación",{"_3464":72137,"_30209":72119,"_20922":122295,"_5":14373,"_27447":122247,"_2948":122296},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3464":72138,"_30209":72119,"_20922":122298,"_5":14373,"_27447":122247,"_2948":122299},[],"Autorización",{"_3464":72139,"_30209":72119,"_20922":122301,"_5":14373,"_27447":122247,"_2948":122302},[],"La aplicación permite la acción a esa identidad.",{"_3464":72140,"_30209":72119,"_20922":122304,"_5":14373,"_27447":122247,"_2948":122305},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3464":72141,"_30209":72119,"_20922":122307,"_5":14373,"_27447":122251,"_2948":122308},[],"Mecanismo",{"_3464":72142,"_30209":72119,"_20922":122310,"_5":14373,"_27447":122251,"_2948":122311},[],"Cuándo utilizarlo",{"_3464":72143,"_30209":72119,"_20922":122313,"_5":14373,"_27447":122251,"_2948":122314},[],"Qué debes mantener",{"_3464":72144,"_30209":72119,"_20922":122316,"_5":14373,"_27447":122251,"_2948":55471},[],{"_3464":72145,"_30209":72119,"_20922":122318,"_5":14373,"_27447":122251,"_2948":122319},[],"Consulta del estado de un certificado concreto.",{"_3464":72146,"_30209":72119,"_20922":122321,"_5":14373,"_27447":122251,"_2948":122322},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3464":72147,"_30209":72119,"_20922":122324,"_5":14373,"_27447":122251,"_2948":55480},[],{"_3464":72148,"_30209":72119,"_20922":122326,"_5":14373,"_27447":122251,"_2948":122327},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3464":72149,"_30209":72119,"_20922":122329,"_5":14373,"_27447":122251,"_2948":122330},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3464":72150,"_30209":72119,"_20922":122332,"_5":14373,"_27447":122251,"_2948":122333},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3464":72151,"_30209":72119,"_20922":122335,"_5":14373,"_27447":122251,"_2948":122336},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3464":72152,"_30209":72119,"_20922":122338,"_5":14373,"_27447":122255,"_2948":122339},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3464":72153,"_30209":72119,"_20922":122341,"_5":14373,"_27447":122255,"_2948":122342},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3464":72154,"_30209":72119,"_20922":122344,"_5":14373,"_27447":122255,"_2948":122345},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3464":72155,"_30209":72119,"_20922":122347,"_5":14373,"_27447":122255,"_2948":122348},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3464":72156,"_30209":72119,"_20922":122350,"_5":14373,"_27447":122255,"_2948":122351},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3464":72157,"_30209":72119,"_20922":122353,"_5":14373,"_27447":122255,"_2948":122354},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3464":72158,"_30209":72119,"_20922":122356,"_5":14373,"_27447":122255,"_2948":122357},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3464":72159,"_30209":72119,"_20922":122359,"_5":14373,"_27447":122255,"_2948":122360},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":72160,"_30209":72119,"_20922":122362,"_5":14373,"_27447":122255,"_2948":122363},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3464":72161,"_30209":72161,"_5":14725,"_2948":122365,"_30562":122366,"_20922":122367,"_27447":72161},"Certificados",[49276,117725,54756,121603],[],{"_3464":72162,"_30209":72161,"_20922":122369,"_5":14373,"_27447":72161,"_2948":122370},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3464":72163,"_30209":72161,"_5":30559,"_20922":122372,"_27447":122373,"_2948":122374},[],"/docs/pr-preview/pr-63/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3464":72164,"_30209":72161,"_5":30559,"_20922":122376,"_27447":122377,"_2948":122378},[],"/docs/pr-preview/pr-63/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3464":72165,"_30209":72161,"_5":30559,"_20922":122380,"_27447":122381,"_2948":122382},[],"/docs/pr-preview/pr-63/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3464":72166,"_30209":72161,"_5":30559,"_20922":122384,"_27447":122385,"_2948":122386},[],"/docs/pr-preview/pr-63/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3464":72167,"_30209":72161,"_5":30559,"_20922":122388,"_27447":122389,"_2948":122390},[],"/docs/pr-preview/pr-63/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3464":72168,"_30209":72161,"_5":30559,"_20922":122392,"_27447":122393,"_2948":122394},[],"/docs/pr-preview/pr-63/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3464":72169,"_30209":72161,"_5":30559,"_20922":122396,"_27447":122397,"_2948":122398},[],"/docs/pr-preview/pr-63/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3464":72170,"_30209":72161,"_5":30559,"_20922":122400,"_27447":122401,"_2948":122402},[],"/docs/pr-preview/pr-63/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3464":72171,"_30209":72161,"_5":30559,"_20922":122404,"_27447":122405,"_2948":122406},[],"/docs/pr-preview/pr-63/es/platform/pki/certificates#continúa","Continúa",{"_3464":72172,"_30209":72161,"_20922":122408,"_5":14373,"_27447":72161,"_2948":122409},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3464":72173,"_30209":72161,"_20922":122411,"_5":14373,"_27447":122373,"_2948":122412},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3464":72174,"_30209":72161,"_20922":122414,"_5":14373,"_27447":122373,"_2948":122415},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3464":72175,"_30209":72161,"_20922":122417,"_5":14373,"_27447":122373,"_2948":122418},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3464":72176,"_30209":72161,"_20922":122420,"_5":14373,"_27447":122373,"_2948":122421},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3464":72177,"_30209":72161,"_20922":122423,"_5":14373,"_27447":122373,"_2948":122424},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3464":72178,"_30209":72161,"_20922":122426,"_5":14373,"_27447":122373,"_2948":122427},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3464":72179,"_30209":72161,"_20922":122429,"_5":14373,"_27447":122373,"_2948":122430},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3464":72180,"_30209":72161,"_20922":122432,"_5":14373,"_27447":122377,"_2948":122433},[],"Descarga el PEM e inspecciónalo:",{"_3464":72181,"_30209":72161,"_20922":122435,"_5":14373,"_27447":122377,"_2948":122436},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3464":72182,"_30209":72161,"_20922":122438,"_5":14373,"_27447":122381,"_2948":122439},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3464":72183,"_30209":72161,"_20922":122441,"_5":14373,"_27447":122381,"_2948":122442},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3464":72184,"_30209":72161,"_20922":122444,"_5":14373,"_27447":122381,"_2948":122445},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3464":72185,"_30209":72161,"_20922":122447,"_5":14373,"_27447":122381,"_2948":122448},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3464":72186,"_30209":72161,"_20922":122450,"_5":14373,"_27447":122381,"_2948":122451},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3464":72187,"_30209":72161,"_20922":122453,"_5":14373,"_27447":122381,"_2948":122454},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3464":72188,"_30209":72161,"_20922":122456,"_5":14373,"_27447":122381,"_2948":122457},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3464":72189,"_30209":72161,"_20922":122459,"_5":14373,"_27447":122385,"_2948":122460},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3464":72190,"_30209":72161,"_20922":122462,"_5":14373,"_27447":122389,"_2948":122463},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3464":72191,"_30209":72161,"_20922":122465,"_5":14373,"_27447":122393,"_2948":122466},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3464":72192,"_30209":72161,"_20922":122468,"_5":14373,"_27447":122397,"_2948":122469},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3464":72193,"_30209":72161,"_20922":122471,"_5":14373,"_27447":122397,"_2948":122472},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3464":72194,"_30209":72161,"_20922":122474,"_5":14373,"_27447":122397,"_2948":122475},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3464":72195,"_30209":72161,"_20922":122477,"_5":14373,"_27447":122401,"_2948":122478},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3464":72196,"_30209":72161,"_20922":122480,"_5":14373,"_27447":122401,"_2948":122481},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3464":72197,"_30209":72161,"_20922":122483,"_5":14373,"_27447":122401,"_2948":122484},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3464":72198,"_30209":72161,"_20922":122486,"_5":14373,"_27447":122405,"_2948":122487},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":72199,"_30209":72161,"_20922":122489,"_5":14373,"_27447":122405,"_2948":122490},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3464":72200,"_30209":72200,"_5":14725,"_2948":122492,"_30562":122493,"_20922":122495,"_27447":72200},"Ciclo de vida de un certificado",[49276,117725,54756,122494],"Conceptos",[],{"_3464":72201,"_30209":72200,"_20922":122497,"_5":14373,"_27447":72200,"_2948":122498},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3464":72202,"_30209":72200,"_5":30559,"_20922":122500,"_27447":122501,"_2948":122502},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3464":72203,"_30209":72200,"_5":30559,"_20922":122504,"_27447":122505,"_2948":122506},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3464":72204,"_30209":72200,"_5":30559,"_20922":122508,"_27447":122509,"_2948":122510},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3464":72205,"_30209":72200,"_5":30559,"_20922":122512,"_27447":122513,"_2948":122514},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3464":72206,"_30209":72200,"_5":30559,"_20922":122516,"_27447":122517,"_2948":122518},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3464":72207,"_30209":72200,"_5":30559,"_20922":122520,"_27447":122521,"_2948":122522},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3464":72208,"_30209":72200,"_5":30559,"_20922":122524,"_27447":122525,"_2948":120226},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3464":72209,"_30209":72200,"_5":30559,"_20922":122527,"_27447":122528,"_2948":122529},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3464":72210,"_30209":72200,"_5":30559,"_20922":122531,"_27447":122532,"_2948":122533},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3464":72211,"_30209":72200,"_5":30559,"_20922":122535,"_27447":122536,"_2948":122537},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3464":72212,"_30209":72200,"_20922":122539,"_5":14373,"_27447":72200,"_2948":122540},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3464":72213,"_30209":72200,"_20922":122542,"_5":14373,"_27447":122505,"_2948":122543},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3464":72214,"_30209":72200,"_20922":122545,"_5":14373,"_27447":122509,"_2948":122546},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3464":72215,"_30209":72200,"_20922":122548,"_5":14373,"_27447":122513,"_2948":122549},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3464":72216,"_30209":72200,"_20922":122551,"_5":14373,"_27447":122517,"_2948":122552},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3464":72217,"_30209":72200,"_20922":122554,"_5":14373,"_27447":122521,"_2948":122555},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3464":72218,"_30209":72200,"_20922":122557,"_5":14373,"_27447":122525,"_2948":122558},[],"Lamassu persiste cuatro estados X.509:",{"_3464":72219,"_30209":72200,"_20922":122560,"_5":14373,"_27447":122525,"_2948":122561},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3464":72220,"_30209":72200,"_20922":122563,"_5":14373,"_27447":122525,"_2948":122564},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3464":72221,"_30209":72200,"_20922":122566,"_5":14373,"_27447":122525,"_2948":122567},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3464":72222,"_30209":72200,"_20922":122569,"_5":14373,"_27447":122525,"_2948":122570},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3464":72223,"_30209":72200,"_20922":122572,"_5":14373,"_27447":122525,"_2948":122573},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3464":72224,"_30209":72200,"_20922":122575,"_5":14373,"_27447":122528,"_2948":122576},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3464":72225,"_30209":72200,"_20922":122578,"_5":14373,"_27447":122528,"_2948":122579},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3464":72226,"_30209":72200,"_20922":122581,"_5":14373,"_27447":122528,"_2948":122582},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3464":72227,"_30209":72200,"_20922":122584,"_5":14373,"_27447":122532,"_2948":122585},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3464":72228,"_30209":72200,"_20922":122587,"_5":14373,"_27447":122532,"_2948":122588},[],"Antes de confirmar:",{"_3464":72229,"_30209":72200,"_20922":122590,"_5":14373,"_27447":122532,"_2948":122591},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3464":72230,"_30209":72200,"_20922":122593,"_5":14373,"_27447":122532,"_2948":122594},[],"Distribuye la nueva cadena de confianza.",{"_3464":72231,"_30209":72200,"_20922":122596,"_5":14373,"_27447":122532,"_2948":122597},[],"Reemite las identidades necesarias.",{"_3464":72232,"_30209":72200,"_20922":122599,"_5":14373,"_27447":122532,"_2948":122600},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3464":72233,"_30209":72200,"_20922":122602,"_5":14373,"_27447":122532,"_2948":122603},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3464":72234,"_30209":72200,"_20922":122605,"_5":14373,"_27447":122532,"_2948":122606},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3464":72235,"_30209":72200,"_20922":122608,"_5":14373,"_27447":122536,"_2948":122609},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3464":72236,"_30209":72200,"_20922":122611,"_5":14373,"_27447":122536,"_2948":122612},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3464":72237,"_30209":72200,"_20922":122614,"_5":14373,"_27447":122536,"_2948":122615},[],"Cambios de estado y razones de revocación.",{"_3464":72238,"_30209":72200,"_20922":122617,"_5":14373,"_27447":122536,"_2948":122618},[],"Publicación y vigencia de OCSP y CRLs.",{"_3464":72239,"_30209":72200,"_20922":122620,"_5":14373,"_27447":122536,"_2948":122621},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3464":72240,"_30209":72200,"_20922":122623,"_5":14373,"_27447":122536,"_2948":122624},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3464":72241,"_30209":72241,"_5":14725,"_2948":122626,"_30562":122627,"_20922":122628,"_27447":72241},"Modelo de confianza",[49276,117725,54756,122494],[],{"_3464":72242,"_30209":72241,"_20922":122630,"_5":14373,"_27447":72241,"_2948":122631},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3464":72243,"_30209":72241,"_5":30559,"_20922":122633,"_27447":122634,"_2948":122635},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3464":72244,"_30209":72241,"_5":30559,"_20922":122637,"_27447":122638,"_2948":122639},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3464":72245,"_30209":72241,"_5":30559,"_20922":122641,"_27447":122642,"_2948":122643},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3464":72246,"_30209":72241,"_5":30559,"_20922":122645,"_27447":122646,"_2948":122647},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3464":72247,"_30209":72241,"_5":30559,"_20922":122649,"_27447":122650,"_2948":122651},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3464":72248,"_30209":72241,"_5":30559,"_20922":122653,"_27447":122654,"_2948":122655},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3464":72249,"_30209":72241,"_5":30559,"_20922":122657,"_27447":122658,"_2948":122659},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3464":72250,"_30209":72241,"_5":30559,"_20922":122661,"_27447":122662,"_2948":122663},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3464":72251,"_30209":72241,"_5":30559,"_20922":122665,"_27447":122666,"_2948":122667},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3464":72252,"_30209":72241,"_5":30559,"_20922":122669,"_27447":122670,"_2948":122671},[],"/docs/pr-preview/pr-63/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3464":72253,"_30209":72241,"_20922":122673,"_5":14373,"_27447":72241,"_2948":122674},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3464":72254,"_30209":72241,"_20922":122676,"_5":14373,"_27447":122638,"_2948":122677},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3464":72255,"_30209":72241,"_20922":122679,"_5":14373,"_27447":122642,"_2948":122680},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3464":72256,"_30209":72241,"_20922":122682,"_5":14373,"_27447":122646,"_2948":122683},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3464":72257,"_30209":72241,"_20922":122685,"_5":14373,"_27447":122650,"_2948":122686},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3464":72258,"_30209":72241,"_20922":122688,"_5":14373,"_27447":122654,"_2948":122689},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3464":72259,"_30209":72241,"_20922":122691,"_5":14373,"_27447":122654,"_2948":122692},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3464":72260,"_30209":72241,"_20922":122694,"_5":14373,"_27447":122654,"_2948":122695},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3464":72261,"_30209":72241,"_20922":122697,"_5":14373,"_27447":122654,"_2948":122698},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3464":72262,"_30209":72241,"_20922":122700,"_5":14373,"_27447":122654,"_2948":122701},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3464":72263,"_30209":72241,"_20922":122703,"_5":14373,"_27447":122654,"_2948":122704},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3464":72264,"_30209":72241,"_20922":122706,"_5":14373,"_27447":122658,"_2948":122707},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3464":72265,"_30209":72241,"_20922":122709,"_5":14373,"_27447":122658,"_2948":122710},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3464":72266,"_30209":72241,"_20922":122712,"_5":14373,"_27447":122658,"_2948":122713},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3464":72267,"_30209":72241,"_20922":122715,"_5":14373,"_27447":122658,"_2948":122716},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3464":72268,"_30209":72241,"_20922":122718,"_5":14373,"_27447":122658,"_2948":122719},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3464":72269,"_30209":72241,"_20922":122721,"_5":14373,"_27447":122662,"_2948":122722},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3464":72270,"_30209":72241,"_20922":122724,"_5":14373,"_27447":122662,"_2948":122725},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3464":72271,"_30209":72241,"_20922":122727,"_5":14373,"_27447":122662,"_2948":122728},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3464":72272,"_30209":72241,"_20922":122730,"_5":14373,"_27447":122662,"_2948":122731},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3464":72273,"_30209":72241,"_20922":122733,"_5":14373,"_27447":122662,"_2948":122734},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3464":72274,"_30209":72241,"_20922":122736,"_5":14373,"_27447":122662,"_2948":122737},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3464":72275,"_30209":72241,"_20922":122739,"_5":14373,"_27447":122662,"_2948":122740},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3464":72276,"_30209":72241,"_20922":122742,"_5":14373,"_27447":122666,"_2948":122743},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3464":72277,"_30209":72241,"_20922":122745,"_5":14373,"_27447":122670,"_2948":122746},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3464":72278,"_30209":72241,"_20922":122748,"_5":14373,"_27447":122670,"_2948":122749},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3464":72279,"_30209":72241,"_20922":122751,"_5":14373,"_27447":122670,"_2948":122752},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3464":72280,"_30209":72241,"_20922":122754,"_5":14373,"_27447":122670,"_2948":122755},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3464":72281,"_30209":72241,"_20922":122757,"_5":14373,"_27447":122670,"_2948":122758},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3464":72282,"_30209":72241,"_20922":122760,"_5":14373,"_27447":122670,"_2948":122761},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3464":72283,"_30209":72241,"_20922":122763,"_5":14373,"_27447":122670,"_2948":122764},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3464":72284,"_30209":72284,"_5":14725,"_2948":122766,"_30562":122767,"_20922":122768,"_27447":72284},"Listas de revocación (CRL)",[49276,117725,54756,122240],[],{"_3464":72285,"_30209":72284,"_20922":122770,"_5":14373,"_27447":72284,"_2948":122771},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3464":72286,"_30209":72284,"_5":30559,"_20922":122773,"_27447":122774,"_2948":122775},[],"/docs/pr-preview/pr-63/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3464":72287,"_30209":72284,"_5":30559,"_20922":122777,"_27447":122778,"_2948":122779},[],"/docs/pr-preview/pr-63/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3464":72288,"_30209":72284,"_5":30559,"_20922":122781,"_27447":122782,"_2948":122783},[],"/docs/pr-preview/pr-63/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3464":72289,"_30209":72284,"_5":30559,"_20922":122785,"_27447":122786,"_2948":122787},[],"/docs/pr-preview/pr-63/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3464":72290,"_30209":72284,"_5":30559,"_20922":122789,"_27447":122790,"_2948":122791},[],"/docs/pr-preview/pr-63/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3464":72291,"_30209":72284,"_5":30559,"_20922":122793,"_27447":122794,"_2948":122795},[],"/docs/pr-preview/pr-63/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3464":72292,"_30209":72284,"_5":30559,"_20922":122797,"_27447":122798,"_2948":122799},[],"/docs/pr-preview/pr-63/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3464":72293,"_30209":72284,"_5":30559,"_20922":122801,"_27447":122802,"_2948":122803},[],"/docs/pr-preview/pr-63/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3464":72294,"_30209":72284,"_5":30559,"_20922":122805,"_27447":122806,"_2948":122807},[],"/docs/pr-preview/pr-63/es/platform/pki/crl#referencias","Referencias",{"_3464":72295,"_30209":72284,"_20922":122809,"_5":14373,"_27447":72284,"_2948":122810},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3464":72296,"_30209":72284,"_20922":122812,"_5":14373,"_27447":122774,"_2948":122813},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3464":72297,"_30209":72284,"_20922":122815,"_5":14373,"_27447":122774,"_2948":122816},[],"Campo",{"_3464":72298,"_30209":72284,"_20922":122818,"_5":14373,"_27447":122774,"_2948":119266},[],{"_3464":72299,"_30209":72284,"_20922":122820,"_5":14373,"_27447":122774,"_2948":55978},[],{"_3464":72300,"_30209":72284,"_20922":122822,"_5":14373,"_27447":122774,"_2948":122823},[],"ID de la CA a la que pertenecen los ajustes.",{"_3464":72301,"_30209":72284,"_20922":122825,"_5":14373,"_27447":122774,"_2948":55984},[],{"_3464":72302,"_30209":72284,"_20922":122827,"_5":14373,"_27447":122774,"_2948":122828},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3464":72303,"_30209":72284,"_20922":122830,"_5":14373,"_27447":122774,"_2948":55990},[],{"_3464":72304,"_30209":72284,"_20922":122832,"_5":14373,"_27447":122774,"_2948":122833},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3464":72305,"_30209":72284,"_20922":122835,"_5":14373,"_27447":122774,"_2948":55996},[],{"_3464":72306,"_30209":72284,"_20922":122837,"_5":14373,"_27447":122774,"_2948":122838},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3464":72307,"_30209":72284,"_20922":122840,"_5":14373,"_27447":122774,"_2948":122841},[],"Campo de `crl_options`",{"_3464":72308,"_30209":72284,"_20922":122843,"_5":14373,"_27447":122774,"_2948":119266},[],{"_3464":72309,"_30209":72284,"_20922":122845,"_5":14373,"_27447":122774,"_2948":122846},[],"Valor inicial",{"_3464":72310,"_30209":72284,"_20922":122848,"_5":14373,"_27447":122774,"_2948":56010},[],{"_3464":72311,"_30209":72284,"_20922":122850,"_5":14373,"_27447":122774,"_2948":122851},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3464":72312,"_30209":72284,"_20922":122853,"_5":14373,"_27447":122774,"_2948":122854},[],"7 días.",{"_3464":72313,"_30209":72284,"_20922":122856,"_5":14373,"_27447":122774,"_2948":56019},[],{"_3464":72314,"_30209":72284,"_20922":122858,"_5":14373,"_27447":122774,"_2948":122859},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3464":72315,"_30209":72284,"_20922":122861,"_5":14373,"_27447":122774,"_2948":122862},[],"6 días y 23 horas.",{"_3464":72316,"_30209":72284,"_20922":122864,"_5":14373,"_27447":122774,"_2948":56028},[],{"_3464":72317,"_30209":72284,"_20922":122866,"_5":14373,"_27447":122774,"_2948":122867},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3464":72318,"_30209":72284,"_20922":122869,"_5":14373,"_27447":122774,"_2948":56034},[],{"_3464":72319,"_30209":72284,"_20922":122871,"_5":14373,"_27447":122774,"_2948":56037},[],{"_3464":72320,"_30209":72284,"_20922":122873,"_5":14373,"_27447":122774,"_2948":122874},[],"Número de serie del certificado existente que firma la CRL.",{"_3464":72321,"_30209":72284,"_20922":122876,"_5":14373,"_27447":122774,"_2948":122877},[],"Número de serie del certificado actual de la CA.",{"_3464":72322,"_30209":72284,"_20922":122879,"_5":14373,"_27447":122774,"_2948":122880},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3464":72323,"_30209":72284,"_20922":122882,"_5":14373,"_27447":122774,"_2948":122883},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3464":72324,"_30209":72284,"_20922":122885,"_5":14373,"_27447":122774,"_2948":122886},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3464":72325,"_30209":72284,"_20922":122888,"_5":14373,"_27447":122774,"_2948":122889},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3464":72326,"_30209":72284,"_20922":122891,"_5":14373,"_27447":122774,"_2948":122892},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3464":72327,"_30209":72284,"_20922":122894,"_5":14373,"_27447":122774,"_2948":122895},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3464":72328,"_30209":72284,"_20922":122897,"_5":14373,"_27447":122774,"_2948":122898},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3464":72329,"_30209":72284,"_20922":122900,"_5":14373,"_27447":122774,"_2948":122901},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3464":72330,"_30209":72284,"_20922":122903,"_5":14373,"_27447":122774,"_2948":122904},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3464":72331,"_30209":72284,"_20922":122906,"_5":14373,"_27447":122774,"_2948":122907},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3464":72332,"_30209":72284,"_20922":122909,"_5":14373,"_27447":122778,"_2948":122910},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3464":72333,"_30209":72284,"_20922":122912,"_5":14373,"_27447":122778,"_2948":122913},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3464":72334,"_30209":72284,"_20922":122915,"_5":14373,"_27447":122778,"_2948":122916},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3464":72335,"_30209":72284,"_20922":122918,"_5":14373,"_27447":122778,"_2948":122919},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3464":72336,"_30209":72284,"_20922":122921,"_5":14373,"_27447":122782,"_2948":122922},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3464":72337,"_30209":72284,"_20922":122924,"_5":14373,"_27447":122782,"_2948":122925},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3464":72338,"_30209":72284,"_20922":122927,"_5":14373,"_27447":122782,"_2948":122928},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3464":72339,"_30209":72284,"_20922":122930,"_5":14373,"_27447":122782,"_2948":122931},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3464":72340,"_30209":72284,"_20922":122933,"_5":14373,"_27447":122782,"_2948":122934},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3464":72341,"_30209":72284,"_20922":122936,"_5":14373,"_27447":122782,"_2948":122937},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3464":72342,"_30209":72284,"_20922":122939,"_5":14373,"_27447":122782,"_2948":122940},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3464":72343,"_30209":72284,"_20922":122942,"_5":14373,"_27447":122782,"_2948":122943},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3464":72344,"_30209":72284,"_20922":122945,"_5":14373,"_27447":122782,"_2948":122946},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3464":72345,"_30209":72284,"_20922":122948,"_5":14373,"_27447":122786,"_2948":122949},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3464":72346,"_30209":72284,"_20922":122951,"_5":14373,"_27447":122786,"_2948":122952},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3464":72347,"_30209":72284,"_20922":122954,"_5":14373,"_27447":122790,"_2948":122955},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3464":72348,"_30209":72284,"_20922":122957,"_5":14373,"_27447":122790,"_2948":122958},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3464":72349,"_30209":72284,"_20922":122960,"_5":14373,"_27447":122790,"_2948":122961},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3464":72350,"_30209":72284,"_20922":122963,"_5":14373,"_27447":122790,"_2948":122964},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3464":72351,"_30209":72284,"_20922":122966,"_5":14373,"_27447":122790,"_2948":122967},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3464":72352,"_30209":72284,"_20922":122969,"_5":14373,"_27447":122794,"_2948":122970},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3464":72353,"_30209":72284,"_20922":122972,"_5":14373,"_27447":122794,"_2948":119455},[],{"_3464":72354,"_30209":72284,"_20922":122974,"_5":14373,"_27447":122794,"_2948":122975},[],"Path relativo",{"_3464":72355,"_30209":72284,"_20922":122977,"_5":14373,"_27447":122794,"_2948":117485},[],{"_3464":72356,"_30209":72284,"_20922":122979,"_5":14373,"_27447":122794,"_2948":56146},[],{"_3464":72357,"_30209":72284,"_20922":122981,"_5":14373,"_27447":122794,"_2948":56149},[],{"_3464":72358,"_30209":72284,"_20922":122983,"_5":14373,"_27447":122794,"_2948":122984},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3464":72359,"_30209":72284,"_20922":122986,"_5":14373,"_27447":122794,"_2948":56146},[],{"_3464":72360,"_30209":72284,"_20922":122988,"_5":14373,"_27447":122794,"_2948":56157},[],{"_3464":72361,"_30209":72284,"_20922":122990,"_5":14373,"_27447":122794,"_2948":122991},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3464":72362,"_30209":72284,"_20922":122993,"_5":14373,"_27447":122794,"_2948":56163},[],{"_3464":72363,"_30209":72284,"_20922":122995,"_5":14373,"_27447":122794,"_2948":56157},[],{"_3464":72364,"_30209":72284,"_20922":122997,"_5":14373,"_27447":122794,"_2948":122998},[],"Sustituir la configuración de CRL de una CA.",{"_3464":72365,"_30209":72284,"_20922":123000,"_5":14373,"_27447":122794,"_2948":123001},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3464":72366,"_30209":72284,"_20922":123003,"_5":14373,"_27447":122794,"_2948":123004},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3464":72367,"_30209":72284,"_20922":123006,"_5":14373,"_27447":122798,"_2948":123007},[],"Síntoma",{"_3464":72368,"_30209":72284,"_20922":123009,"_5":14373,"_27447":122798,"_2948":123010},[],"Causa",{"_3464":72369,"_30209":72284,"_20922":123012,"_5":14373,"_27447":122798,"_2948":123013},[],"Acción",{"_3464":72370,"_30209":72284,"_20922":123015,"_5":14373,"_27447":122798,"_2948":123016},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3464":72371,"_30209":72284,"_20922":123018,"_5":14373,"_27447":122798,"_2948":123019},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3464":72372,"_30209":72284,"_20922":123021,"_5":14373,"_27447":122798,"_2948":123022},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3464":72373,"_30209":72284,"_20922":123024,"_5":14373,"_27447":122798,"_2948":123025},[],"`PUT` devuelve 400.",{"_3464":72374,"_30209":72284,"_20922":123027,"_5":14373,"_27447":122798,"_2948":123028},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3464":72375,"_30209":72284,"_20922":123030,"_5":14373,"_27447":122798,"_2948":123031},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3464":72376,"_30209":72284,"_20922":123033,"_5":14373,"_27447":122798,"_2948":123034},[],"`PUT` devuelve 404.",{"_3464":72377,"_30209":72284,"_20922":123036,"_5":14373,"_27447":122798,"_2948":123037},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3464":72378,"_30209":72284,"_20922":123039,"_5":14373,"_27447":122798,"_2948":123040},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3464":72379,"_30209":72284,"_20922":123042,"_5":14373,"_27447":122798,"_2948":123043},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3464":72380,"_30209":72284,"_20922":123045,"_5":14373,"_27447":122798,"_2948":123046},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3464":72381,"_30209":72284,"_20922":123048,"_5":14373,"_27447":122798,"_2948":123049},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3464":72382,"_30209":72284,"_20922":123051,"_5":14373,"_27447":122798,"_2948":123052},[],"La CRL no cambia tras revocar un certificado.",{"_3464":72383,"_30209":72284,"_20922":123054,"_5":14373,"_27447":122798,"_2948":123055},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3464":72384,"_30209":72284,"_20922":123057,"_5":14373,"_27447":122798,"_2948":123058},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3464":72385,"_30209":72284,"_20922":123060,"_5":14373,"_27447":122798,"_2948":123061},[],"Un verificador rechaza la CRL por el emisor.",{"_3464":72386,"_30209":72284,"_20922":123063,"_5":14373,"_27447":122798,"_2948":123064},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3464":72387,"_30209":72284,"_20922":123066,"_5":14373,"_27447":122798,"_2948":123067},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3464":72388,"_30209":72284,"_20922":123069,"_5":14373,"_27447":122802,"_2948":123070},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3464":72389,"_30209":72284,"_20922":123072,"_5":14373,"_27447":122806,"_2948":123073},[],"RFC 5280: perfil X.509 y CRL.",{"_3464":72390,"_30209":72284,"_20922":123075,"_5":14373,"_27447":122806,"_2948":56246},[],{"_3464":72391,"_30209":72284,"_20922":123077,"_5":14373,"_27447":122806,"_2948":56249},[],{"_3464":72392,"_30209":72284,"_20922":123079,"_5":14373,"_27447":122806,"_2948":123080},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3464":72393,"_30209":72284,"_20922":123082,"_5":14373,"_27447":122806,"_2948":123083},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3464":72394,"_30209":72394,"_5":14725,"_2948":123085,"_30562":123086,"_20922":123087,"_27447":72394},"Claves y motores criptográficos",[49276,117725,54756,121603],[],{"_3464":72395,"_30209":72394,"_20922":123089,"_5":14373,"_27447":72394,"_2948":123090},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3464":72396,"_30209":72394,"_5":30559,"_20922":123092,"_27447":123093,"_2948":123094},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3464":72397,"_30209":72394,"_5":30559,"_20922":123096,"_27447":123097,"_2948":123098},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3464":72398,"_30209":72394,"_5":30559,"_20922":123100,"_27447":123101,"_2948":56274},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#file-system",{"_3464":72399,"_30209":72394,"_5":30559,"_20922":123103,"_27447":123104,"_2948":56278},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#hashicorp-vault",{"_3464":72400,"_30209":72394,"_5":30559,"_20922":123106,"_27447":123107,"_2948":56282},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#aws-secrets-manager",{"_3464":72401,"_30209":72394,"_5":30559,"_20922":123109,"_27447":123110,"_2948":56286},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#aws-kms",{"_3464":72402,"_30209":72394,"_5":30559,"_20922":123112,"_27447":123113,"_2948":56290},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#pkcs11",{"_3464":72403,"_30209":72394,"_5":30559,"_20922":123115,"_27447":123116,"_2948":56294},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#azure-key-vault",{"_3464":72404,"_30209":72394,"_5":30559,"_20922":123118,"_27447":123119,"_2948":123120},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3464":72405,"_30209":72394,"_5":30559,"_20922":123122,"_27447":123123,"_2948":123124},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3464":72406,"_30209":72394,"_5":30559,"_20922":123126,"_27447":123127,"_2948":123128},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3464":72407,"_30209":72394,"_5":30559,"_20922":123130,"_27447":123131,"_2948":123132},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3464":72408,"_30209":72394,"_5":30559,"_20922":123134,"_27447":123135,"_2948":123136},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3464":72409,"_30209":72394,"_5":30559,"_20922":123138,"_27447":123139,"_2948":123140},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3464":72410,"_30209":72394,"_5":30559,"_20922":123142,"_27447":123143,"_2948":123144},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3464":72411,"_30209":72394,"_5":30559,"_20922":123146,"_27447":123147,"_2948":56326},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#sign",{"_3464":72412,"_30209":72394,"_5":30559,"_20922":123149,"_27447":123150,"_2948":56330},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#verify",{"_3464":72413,"_30209":72394,"_5":30559,"_20922":123152,"_27447":123153,"_2948":123154},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3464":72414,"_30209":72394,"_5":30559,"_20922":123156,"_27447":123157,"_2948":123158},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3464":72415,"_30209":72394,"_5":30559,"_20922":123160,"_27447":123161,"_2948":123162},[],"/docs/pr-preview/pr-63/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3464":72416,"_30209":72394,"_20922":123164,"_5":14373,"_27447":72394,"_2948":123165},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3464":72417,"_30209":72394,"_20922":123167,"_5":14373,"_27447":72394,"_2948":123168},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3464":72418,"_30209":72394,"_20922":123170,"_5":14373,"_27447":123093,"_2948":123171},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3464":72419,"_30209":72394,"_20922":123173,"_5":14373,"_27447":123093,"_2948":123174},[],"En la práctica, permite:",{"_3464":72420,"_30209":72394,"_20922":123176,"_5":14373,"_27447":123093,"_2948":123177},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3464":72421,"_30209":72394,"_20922":123179,"_5":14373,"_27447":123093,"_2948":123180},[],"Importar claves creadas externamente.",{"_3464":72422,"_30209":72394,"_20922":123182,"_5":14373,"_27447":123093,"_2948":123183},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3464":72423,"_30209":72394,"_20922":123185,"_5":14373,"_27447":123093,"_2948":123186},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3464":72424,"_30209":72394,"_20922":123188,"_5":14373,"_27447":123097,"_2948":123189},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3464":72425,"_30209":72394,"_20922":123191,"_5":14373,"_27447":123097,"_2948":123192},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3464":72426,"_30209":72394,"_20922":123194,"_5":14373,"_27447":123097,"_2948":123195},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3464":72427,"_30209":72394,"_20922":123197,"_5":14373,"_27447":123101,"_2948":123198},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3464":72428,"_30209":72394,"_20922":123200,"_5":14373,"_27447":123104,"_2948":123201},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3464":72429,"_30209":72394,"_20922":123203,"_5":14373,"_27447":123104,"_2948":123204},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3464":72430,"_30209":72394,"_20922":123206,"_5":14373,"_27447":123107,"_2948":123207},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3464":72431,"_30209":72394,"_20922":123209,"_5":14373,"_27447":123110,"_2948":123210},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3464":72432,"_30209":72394,"_20922":123212,"_5":14373,"_27447":123113,"_2948":123213},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3464":72433,"_30209":72394,"_20922":123215,"_5":14373,"_27447":123116,"_2948":123216},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3464":72434,"_30209":72394,"_20922":123218,"_5":14373,"_27447":123116,"_2948":123219},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3464":72435,"_30209":72394,"_20922":123221,"_5":14373,"_27447":123116,"_2948":123222},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3464":72436,"_30209":72394,"_20922":123224,"_5":14373,"_27447":123116,"_2948":123225},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3464":72437,"_30209":72394,"_20922":123227,"_5":14373,"_27447":123119,"_2948":123228},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3464":72438,"_30209":72394,"_20922":123230,"_5":14373,"_27447":123119,"_2948":123231},[],"La tabla incluye los siguientes campos:",{"_3464":72439,"_30209":72394,"_20922":123233,"_5":14373,"_27447":123119,"_2948":123234},[],"**Name**: nombre descriptivo de la clave.",{"_3464":72440,"_30209":72394,"_20922":123236,"_5":14373,"_27447":123119,"_2948":123237},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3464":72441,"_30209":72394,"_20922":123239,"_5":14373,"_27447":123119,"_2948":123240},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3464":72442,"_30209":72394,"_20922":123242,"_5":14373,"_27447":123119,"_2948":123243},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3464":72443,"_30209":72394,"_20922":123245,"_5":14373,"_27447":123119,"_2948":123246},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3464":72444,"_30209":72394,"_20922":123248,"_5":14373,"_27447":123119,"_2948":123249},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3464":72445,"_30209":72394,"_20922":123251,"_5":14373,"_27447":123119,"_2948":123252},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3464":72446,"_30209":72394,"_20922":123254,"_5":14373,"_27447":123119,"_2948":123255},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3464":72447,"_30209":72394,"_20922":123257,"_5":14373,"_27447":123119,"_2948":123258},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3464":72448,"_30209":72394,"_20922":123260,"_5":14373,"_27447":123119,"_2948":123261},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3464":72449,"_30209":72394,"_20922":123263,"_5":14373,"_27447":123119,"_2948":123264},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3464":72450,"_30209":72394,"_20922":123266,"_5":14373,"_27447":123119,"_2948":123267},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3464":72451,"_30209":72394,"_20922":123269,"_5":14373,"_27447":123119,"_2948":123270},[],"**Delete Key** para eliminar la clave del sistema.",{"_3464":72452,"_30209":72394,"_20922":123272,"_5":14373,"_27447":123123,"_2948":123273},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3464":72453,"_30209":72394,"_20922":123275,"_5":14373,"_27447":123127,"_2948":123276},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3464":72454,"_30209":72394,"_20922":123278,"_5":14373,"_27447":123127,"_2948":123279},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3464":72455,"_30209":72394,"_20922":123281,"_5":14373,"_27447":123127,"_2948":123282},[],"**Key Name**: nombre único y descriptivo.",{"_3464":72456,"_30209":72394,"_20922":123284,"_5":14373,"_27447":123127,"_2948":123285},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3464":72457,"_30209":72394,"_20922":123287,"_5":14373,"_27447":123127,"_2948":123288},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3464":72458,"_30209":72394,"_20922":123290,"_5":14373,"_27447":123127,"_2948":123291},[],"**Tags**: metadatos para clasificar la clave.",{"_3464":72459,"_30209":72394,"_20922":123293,"_5":14373,"_27447":123127,"_2948":123294},[],"**Metadata**: información adicional para usos avanzados.",{"_3464":72460,"_30209":72394,"_20922":123296,"_5":14373,"_27447":123131,"_2948":123297},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3464":72461,"_30209":72394,"_20922":123299,"_5":14373,"_27447":123131,"_2948":123300},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3464":72462,"_30209":72394,"_20922":123302,"_5":14373,"_27447":123131,"_2948":123303},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3464":72463,"_30209":72394,"_20922":123305,"_5":14373,"_27447":123131,"_2948":123306},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3464":72464,"_30209":72394,"_20922":123308,"_5":14373,"_27447":123131,"_2948":123309},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3464":72465,"_30209":72394,"_20922":123311,"_5":14373,"_27447":123131,"_2948":123312},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3464":72466,"_30209":72394,"_20922":123314,"_5":14373,"_27447":123131,"_2948":123315},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3464":72467,"_30209":72394,"_20922":123317,"_5":14373,"_27447":123131,"_2948":123318},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3464":72468,"_30209":72394,"_20922":123320,"_5":14373,"_27447":123131,"_2948":123321},[],"**Metadata**: información adicional opcional.",{"_3464":72469,"_30209":72394,"_20922":123323,"_5":14373,"_27447":123131,"_2948":123324},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3464":72470,"_30209":72394,"_20922":123326,"_5":14373,"_27447":123131,"_2948":123327},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3464":72471,"_30209":72394,"_20922":123329,"_5":14373,"_27447":123135,"_2948":123330},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3464":72472,"_30209":72394,"_20922":123332,"_5":14373,"_27447":123139,"_2948":123333},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3464":72473,"_30209":72394,"_20922":123335,"_5":14373,"_27447":123139,"_2948":123336},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3464":72474,"_30209":72394,"_20922":123338,"_5":14373,"_27447":123139,"_2948":123339},[],"**Key Name**: nombre descriptivo.",{"_3464":72475,"_30209":72394,"_20922":123341,"_5":14373,"_27447":123139,"_2948":123342},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3464":72476,"_30209":72394,"_20922":123344,"_5":14373,"_27447":123139,"_2948":123345},[],"**Tags**: etiquetas asociadas.",{"_3464":72477,"_30209":72394,"_20922":123347,"_5":14373,"_27447":123139,"_2948":123348},[],"**Aliases**: nombres alternativos.",{"_3464":72478,"_30209":72394,"_20922":123350,"_5":14373,"_27447":123139,"_2948":123351},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3464":72479,"_30209":72394,"_20922":123353,"_5":14373,"_27447":123139,"_2948":123354},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3464":72480,"_30209":72394,"_20922":123356,"_5":14373,"_27447":123139,"_2948":123357},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3464":72481,"_30209":72394,"_20922":123359,"_5":14373,"_27447":123139,"_2948":123360},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3464":72482,"_30209":72394,"_20922":123362,"_5":14373,"_27447":123143,"_2948":123363},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3464":72483,"_30209":72394,"_20922":123365,"_5":14373,"_27447":123143,"_2948":123366},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3464":72484,"_30209":72394,"_20922":123368,"_5":14373,"_27447":123143,"_2948":123369},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3464":72485,"_30209":72394,"_20922":123371,"_5":14373,"_27447":123147,"_2948":123372},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3464":72486,"_30209":72394,"_20922":123374,"_5":14373,"_27447":123147,"_2948":123375},[],"Campos principales:",{"_3464":72487,"_30209":72394,"_20922":123377,"_5":14373,"_27447":123147,"_2948":123378},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3464":72488,"_30209":72394,"_20922":123380,"_5":14373,"_27447":123147,"_2948":123381},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3464":72489,"_30209":72394,"_20922":123383,"_5":14373,"_27447":123147,"_2948":123384},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3464":72490,"_30209":72394,"_20922":123386,"_5":14373,"_27447":123147,"_2948":123387},[],"**Message**: contenido que se va a firmar.",{"_3464":72491,"_30209":72394,"_20922":123389,"_5":14373,"_27447":123147,"_2948":123390},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3464":72492,"_30209":72394,"_20922":123392,"_5":14373,"_27447":123150,"_2948":123393},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3464":72493,"_30209":72394,"_20922":123395,"_5":14373,"_27447":123150,"_2948":123375},[],{"_3464":72494,"_30209":72394,"_20922":123397,"_5":14373,"_27447":123150,"_2948":123398},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3464":72495,"_30209":72394,"_20922":123400,"_5":14373,"_27447":123150,"_2948":123401},[],"**Message Type**: `Raw` o `Digest`.",{"_3464":72496,"_30209":72394,"_20922":123403,"_5":14373,"_27447":123150,"_2948":123404},[],"**Payload Encoding**: codificación del mensaje.",{"_3464":72497,"_30209":72394,"_20922":123406,"_5":14373,"_27447":123150,"_2948":123407},[],"**Message**: mensaje original o hash.",{"_3464":72498,"_30209":72394,"_20922":123409,"_5":14373,"_27447":123150,"_2948":123410},[],"**Signature**: firma que se desea comprobar.",{"_3464":72499,"_30209":72394,"_20922":123412,"_5":14373,"_27447":123150,"_2948":123413},[],"**Result**: indicador del resultado de la validación.",{"_3464":72500,"_30209":72394,"_20922":123415,"_5":14373,"_27447":123153,"_2948":123416},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3464":72501,"_30209":72394,"_20922":123418,"_5":14373,"_27447":123153,"_2948":123419},[],"Este flujo es útil para:",{"_3464":72502,"_30209":72394,"_20922":123421,"_5":14373,"_27447":123153,"_2948":123422},[],"Solicitar certificados a una CA externa.",{"_3464":72503,"_30209":72394,"_20922":123424,"_5":14373,"_27447":123153,"_2948":123425},[],"Renovar una identidad manteniendo la misma clave.",{"_3464":72504,"_30209":72394,"_20922":123427,"_5":14373,"_27447":123153,"_2948":123428},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3464":72505,"_30209":72394,"_20922":123430,"_5":14373,"_27447":123153,"_2948":123431},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3464":72506,"_30209":72394,"_20922":123433,"_5":14373,"_27447":123153,"_2948":123434},[],"**Organization (O)**: organización o empresa.",{"_3464":72507,"_30209":72394,"_20922":123436,"_5":14373,"_27447":123153,"_2948":123437},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3464":72508,"_30209":72394,"_20922":123439,"_5":14373,"_27447":123153,"_2948":123440},[],"**Country (C)**: código de país de dos letras.",{"_3464":72509,"_30209":72394,"_20922":123442,"_5":14373,"_27447":123153,"_2948":123443},[],"**State / Province (ST)**: estado o provincia.",{"_3464":72510,"_30209":72394,"_20922":123445,"_5":14373,"_27447":123153,"_2948":123446},[],"**Locality (L)**: ciudad o localidad.",{"_3464":72511,"_30209":72394,"_20922":123448,"_5":14373,"_27447":123153,"_2948":123449},[],"**Email Address**: correo de contacto.",{"_3464":72512,"_30209":72394,"_20922":123451,"_5":14373,"_27447":123153,"_2948":123452},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3464":72513,"_30209":72394,"_20922":123454,"_5":14373,"_27447":123153,"_2948":123455},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3464":72514,"_30209":72394,"_20922":123457,"_5":14373,"_27447":123157,"_2948":123458},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3464":72515,"_30209":72394,"_20922":123460,"_5":14373,"_27447":123157,"_2948":123461},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3464":72516,"_30209":72394,"_20922":123463,"_5":14373,"_27447":123161,"_2948":123464},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3464":72517,"_30209":72394,"_20922":123466,"_5":14373,"_27447":123161,"_2948":123467},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3464":72518,"_30209":72518,"_5":14725,"_2948":123469,"_30562":123470,"_20922":123471,"_27447":72518},"Validación online con OCSP",[49276,117725,54756,122240],[],{"_3464":72519,"_30209":72518,"_20922":123473,"_5":14373,"_27447":72518,"_2948":123474},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3464":72520,"_30209":72518,"_5":30559,"_20922":123476,"_27447":123477,"_2948":123478},[],"/docs/pr-preview/pr-63/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3464":72521,"_30209":72518,"_5":30559,"_20922":123480,"_27447":123481,"_2948":123482},[],"/docs/pr-preview/pr-63/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3464":72522,"_30209":72518,"_5":30559,"_20922":123484,"_27447":123485,"_2948":123486},[],"/docs/pr-preview/pr-63/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3464":72523,"_30209":72518,"_5":30559,"_20922":123488,"_27447":123489,"_2948":123490},[],"/docs/pr-preview/pr-63/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3464":72524,"_30209":72518,"_5":30559,"_20922":123492,"_27447":123493,"_2948":123494},[],"/docs/pr-preview/pr-63/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3464":72525,"_30209":72518,"_5":30559,"_20922":123496,"_27447":123497,"_2948":122807},[],"/docs/pr-preview/pr-63/es/platform/pki/ocsp#referencias",{"_3464":72526,"_30209":72518,"_20922":123499,"_5":14373,"_27447":72518,"_2948":123500},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3464":72527,"_30209":72518,"_20922":123502,"_5":14373,"_27447":123477,"_2948":123503},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3464":72528,"_30209":72518,"_20922":123505,"_5":14373,"_27447":123477,"_2948":123506},[],"Estado del registro",{"_3464":72529,"_30209":72518,"_20922":123508,"_5":14373,"_27447":123477,"_2948":123509},[],"Respuesta firmada",{"_3464":72530,"_30209":72518,"_20922":123511,"_5":14373,"_27447":123477,"_2948":53893},[],{"_3464":72531,"_30209":72518,"_20922":123513,"_5":14373,"_27447":123477,"_2948":56694},[],{"_3464":72532,"_30209":72518,"_20922":123515,"_5":14373,"_27447":123477,"_2948":53910},[],{"_3464":72533,"_30209":72518,"_20922":123517,"_5":14373,"_27447":123477,"_2948":123518},[],"`Revoked`, con razón y fecha de revocación.",{"_3464":72534,"_30209":72518,"_20922":123520,"_5":14373,"_27447":123477,"_2948":123521},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3464":72535,"_30209":72518,"_20922":123523,"_5":14373,"_27447":123477,"_2948":123524},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3464":72536,"_30209":72518,"_20922":123526,"_5":14373,"_27447":123477,"_2948":123527},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3464":72537,"_30209":72518,"_20922":123529,"_5":14373,"_27447":123477,"_2948":123530},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3464":72538,"_30209":72518,"_20922":123532,"_5":14373,"_27447":123477,"_2948":123533},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3464":72539,"_30209":72518,"_20922":123535,"_5":14373,"_27447":123481,"_2948":123536},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3464":72540,"_30209":72518,"_20922":123538,"_5":14373,"_27447":123481,"_2948":123539},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3464":72541,"_30209":72518,"_20922":123541,"_5":14373,"_27447":123485,"_2948":123542},[],"El servicio acepta:",{"_3464":72542,"_30209":72518,"_20922":123544,"_5":14373,"_27447":123485,"_2948":119455},[],{"_3464":72543,"_30209":72518,"_20922":123546,"_5":14373,"_27447":123485,"_2948":123547},[],"Ruta del servicio VA",{"_3464":72544,"_30209":72518,"_20922":123549,"_5":14373,"_27447":123485,"_2948":123550},[],"Formato",{"_3464":72545,"_30209":72518,"_20922":123552,"_5":14373,"_27447":123485,"_2948":56734},[],{"_3464":72546,"_30209":72518,"_20922":123554,"_5":14373,"_27447":123485,"_2948":56737},[],{"_3464":72547,"_30209":72518,"_20922":123556,"_5":14373,"_27447":123485,"_2948":123557},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3464":72548,"_30209":72518,"_20922":123559,"_5":14373,"_27447":123485,"_2948":56146},[],{"_3464":72549,"_30209":72518,"_20922":123561,"_5":14373,"_27447":123485,"_2948":56745},[],{"_3464":72550,"_30209":72518,"_20922":123563,"_5":14373,"_27447":123485,"_2948":123564},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3464":72551,"_30209":72518,"_20922":123566,"_5":14373,"_27447":123485,"_2948":123567},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3464":72552,"_30209":72518,"_20922":123569,"_5":14373,"_27447":123489,"_2948":123570},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3464":72553,"_30209":72518,"_20922":123572,"_5":14373,"_27447":123489,"_2948":123573},[],"Genera la solicitud:",{"_3464":72554,"_30209":72518,"_20922":123575,"_5":14373,"_27447":123489,"_2948":123576},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3464":72555,"_30209":72518,"_20922":123578,"_5":14373,"_27447":123489,"_2948":123579},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3464":72556,"_30209":72518,"_20922":123581,"_5":14373,"_27447":123489,"_2948":123582},[],"Verifica el DER recibido:",{"_3464":72557,"_30209":72518,"_20922":123584,"_5":14373,"_27447":123489,"_2948":123585},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3464":72558,"_30209":72518,"_20922":123587,"_5":14373,"_27447":123493,"_2948":123588},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3464":72559,"_30209":72518,"_20922":123590,"_5":14373,"_27447":123493,"_2948":123591},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3464":72560,"_30209":72518,"_20922":123593,"_5":14373,"_27447":123497,"_2948":56778},[],{"_3464":72561,"_30209":72518,"_20922":123595,"_5":14373,"_27447":123497,"_2948":56781},[],{"_3464":72562,"_30209":72518,"_20922":123597,"_5":14373,"_27447":123497,"_2948":123598},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3464":72563,"_30209":72518,"_20922":123600,"_5":14373,"_27447":123497,"_2948":123083},[],{"_3464":72564,"_30209":72564,"_5":14725,"_2948":54756,"_30562":123602,"_20922":123603,"_27447":72564},[49276,117725,54756],[],{"_3464":72565,"_30209":72564,"_20922":123605,"_5":14373,"_27447":72564,"_2948":123606},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3464":72566,"_30209":72564,"_5":30559,"_20922":123608,"_27447":123609,"_2948":120929},[],"/docs/pr-preview/pr-63/es/platform/pki/overview#empieza-aquí",{"_3464":72567,"_30209":72564,"_5":30559,"_20922":123611,"_27447":123612,"_2948":123613},[],"/docs/pr-preview/pr-63/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3464":72568,"_30209":72564,"_5":30559,"_20922":123615,"_27447":123616,"_2948":121449},[],"/docs/pr-preview/pr-63/es/platform/pki/overview#capacidades-principales",{"_3464":72569,"_30209":72564,"_5":30559,"_20922":123618,"_27447":123619,"_2948":121453},[],"/docs/pr-preview/pr-63/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3464":72570,"_30209":72564,"_5":30559,"_20922":123621,"_27447":123622,"_2948":121457},[],"/docs/pr-preview/pr-63/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3464":72571,"_30209":72564,"_5":30559,"_20922":123624,"_27447":123625,"_2948":121461},[],"/docs/pr-preview/pr-63/es/platform/pki/overview#emite-y-controla-certificados",{"_3464":72572,"_30209":72564,"_5":30559,"_20922":123627,"_27447":123628,"_2948":121469},[],"/docs/pr-preview/pr-63/es/platform/pki/overview#publica-el-estado-de-validación",{"_3464":72573,"_30209":72564,"_5":30559,"_20922":123630,"_27447":123631,"_2948":123632},[],"/docs/pr-preview/pr-63/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3464":72574,"_30209":72564,"_5":30559,"_20922":123634,"_27447":123635,"_2948":122406},[],"/docs/pr-preview/pr-63/es/platform/pki/overview#continúa",{"_3464":72575,"_30209":72564,"_20922":123637,"_5":14373,"_27447":72564,"_2948":123638},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3464":72576,"_30209":72564,"_20922":123640,"_5":14373,"_27447":123609,"_2948":123641},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3464":72577,"_30209":72564,"_20922":123643,"_5":14373,"_27447":123609,"_2948":123644},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3464":72578,"_30209":72564,"_20922":123646,"_5":14373,"_27447":123612,"_2948":123647},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3464":72579,"_30209":72564,"_20922":123649,"_5":14373,"_27447":123612,"_2948":123650},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3464":72580,"_30209":72564,"_20922":123652,"_5":14373,"_27447":123612,"_2948":123653},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3464":72581,"_30209":72564,"_20922":123655,"_5":14373,"_27447":123612,"_2948":123656},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3464":72582,"_30209":72564,"_20922":123658,"_5":14373,"_27447":123612,"_2948":123659},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3464":72583,"_30209":72564,"_20922":123661,"_5":14373,"_27447":123619,"_2948":123662},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3464":72584,"_30209":72564,"_20922":123664,"_5":14373,"_27447":123622,"_2948":123665},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3464":72585,"_30209":72564,"_20922":123667,"_5":14373,"_27447":123625,"_2948":123668},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3464":72586,"_30209":72564,"_20922":123670,"_5":14373,"_27447":123628,"_2948":123671},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3464":72587,"_30209":72564,"_20922":123673,"_5":14373,"_27447":123631,"_2948":123674},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3464":72588,"_30209":72564,"_20922":123676,"_5":14373,"_27447":123631,"_2948":123677},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3464":72589,"_30209":72564,"_20922":123679,"_5":14373,"_27447":123631,"_2948":123680},[],"su clave pública corresponda a la clave privada del cliente;",{"_3464":72590,"_30209":72564,"_20922":123682,"_5":14373,"_27447":123631,"_2948":123683},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3464":72591,"_30209":72564,"_20922":123685,"_5":14373,"_27447":123631,"_2948":123686},[],"sus fechas y usos permitan la operación;",{"_3464":72592,"_30209":72564,"_20922":123688,"_5":14373,"_27447":123631,"_2948":123689},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3464":72593,"_30209":72564,"_20922":123691,"_5":14373,"_27447":123631,"_2948":123692},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3464":72594,"_30209":72564,"_20922":123694,"_5":14373,"_27447":123635,"_2948":123695},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3464":72595,"_30209":72564,"_20922":123697,"_5":14373,"_27447":123635,"_2948":123698},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3464":72596,"_30209":72564,"_20922":123700,"_5":14373,"_27447":123635,"_2948":123701},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3464":72597,"_30209":72597,"_5":14725,"_2948":123703,"_30562":123704,"_20922":123705,"_27447":72597},"Crea tu primera CA",[49276,117725,54756,121053],[],{"_3464":72598,"_30209":72597,"_20922":123707,"_5":14373,"_27447":72597,"_2948":123708},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3464":72599,"_30209":72597,"_5":30559,"_20922":123710,"_27447":123711,"_2948":116296},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3464":72600,"_30209":72597,"_5":30559,"_20922":123713,"_27447":123714,"_2948":123715},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3464":72601,"_30209":72597,"_5":30559,"_20922":123717,"_27447":123718,"_2948":123719},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3464":72602,"_30209":72597,"_5":30559,"_20922":123721,"_27447":123722,"_2948":123723},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3464":72603,"_30209":72597,"_5":30559,"_20922":123725,"_27447":123726,"_2948":123727},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3464":72604,"_30209":72597,"_5":30559,"_20922":123729,"_27447":123730,"_2948":123731},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3464":72605,"_30209":72597,"_5":30559,"_20922":123733,"_27447":123734,"_2948":123735},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3464":72606,"_30209":72597,"_5":30559,"_20922":123737,"_27447":123738,"_2948":121300},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3464":72607,"_30209":72597,"_5":30559,"_20922":123740,"_27447":123741,"_2948":116320},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3464":72608,"_30209":72597,"_20922":123743,"_5":14373,"_27447":72597,"_2948":123744},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3464":72609,"_30209":72597,"_20922":123746,"_5":14373,"_27447":123711,"_2948":123747},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3464":72610,"_30209":72597,"_20922":123749,"_5":14373,"_27447":123711,"_2948":123750},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3464":72611,"_30209":72597,"_20922":123752,"_5":14373,"_27447":123711,"_2948":123753},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3464":72612,"_30209":72597,"_20922":123755,"_5":14373,"_27447":123711,"_2948":123756},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3464":72613,"_30209":72597,"_20922":123758,"_5":14373,"_27447":123714,"_2948":123759},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3464":72614,"_30209":72597,"_20922":123761,"_5":14373,"_27447":123714,"_2948":123762},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3464":72615,"_30209":72597,"_20922":123764,"_5":14373,"_27447":123718,"_2948":123765},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3464":72616,"_30209":72597,"_20922":123767,"_5":14373,"_27447":123718,"_2948":123768},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3464":72617,"_30209":72597,"_20922":123770,"_5":14373,"_27447":123722,"_2948":123771},[],"Selecciona **Root CA** y completa:",{"_3464":72618,"_30209":72597,"_20922":123773,"_5":14373,"_27447":123722,"_2948":56960},[],{"_3464":72619,"_30209":72597,"_20922":123775,"_5":14373,"_27447":123722,"_2948":123776},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3464":72620,"_30209":72597,"_20922":123778,"_5":14373,"_27447":123722,"_2948":123779},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3464":72621,"_30209":72597,"_20922":123781,"_5":14373,"_27447":123722,"_2948":123782},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3464":72622,"_30209":72597,"_20922":123784,"_5":14373,"_27447":123722,"_2948":123785},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3464":72623,"_30209":72597,"_20922":123787,"_5":14373,"_27447":123726,"_2948":123788},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3464":72624,"_30209":72597,"_20922":123790,"_5":14373,"_27447":123730,"_2948":123791},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3464":72625,"_30209":72597,"_20922":123793,"_5":14373,"_27447":123730,"_2948":123794},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3464":72626,"_30209":72597,"_20922":123796,"_5":14373,"_27447":123734,"_2948":123797},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3464":72627,"_30209":72597,"_20922":123799,"_5":14373,"_27447":123734,"_2948":123800},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3464":72628,"_30209":72597,"_20922":123802,"_5":14373,"_27447":123734,"_2948":123803},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3464":72629,"_30209":72597,"_20922":123805,"_5":14373,"_27447":123738,"_2948":123806},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3464":72630,"_30209":72597,"_20922":123808,"_5":14373,"_27447":123738,"_2948":123809},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3464":72631,"_30209":72597,"_20922":123811,"_5":14373,"_27447":123738,"_2948":123812},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3464":72632,"_30209":72597,"_20922":123814,"_5":14373,"_27447":123738,"_2948":123815},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3464":72633,"_30209":72597,"_20922":123817,"_5":14373,"_27447":123741,"_2948":123818},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3464":72634,"_30209":72634,"_5":14725,"_2948":123820,"_30562":123821,"_20922":123822,"_27447":72634},"Emite y verifica un certificado",[49276,117725,54756,121053],[],{"_3464":72635,"_30209":72634,"_20922":123824,"_5":14373,"_27447":72634,"_2948":123825},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3464":72636,"_30209":72634,"_5":30559,"_20922":123827,"_27447":123828,"_2948":116296},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3464":72637,"_30209":72634,"_5":30559,"_20922":123830,"_27447":123831,"_2948":123832},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3464":72638,"_30209":72634,"_5":30559,"_20922":123834,"_27447":123835,"_2948":123836},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3464":72639,"_30209":72634,"_5":30559,"_20922":123838,"_27447":123839,"_2948":123840},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3464":72640,"_30209":72634,"_5":30559,"_20922":123842,"_27447":123843,"_2948":123844},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3464":72641,"_30209":72634,"_5":30559,"_20922":123846,"_27447":123847,"_2948":123848},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3464":72642,"_30209":72634,"_5":30559,"_20922":123850,"_27447":123851,"_2948":123852},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3464":72643,"_30209":72634,"_5":30559,"_20922":123854,"_27447":123855,"_2948":123856},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3464":72644,"_30209":72634,"_5":30559,"_20922":123858,"_27447":123859,"_2948":123860},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3464":72645,"_30209":72634,"_5":30559,"_20922":123862,"_27447":123863,"_2948":123864},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3464":72646,"_30209":72634,"_5":30559,"_20922":123866,"_27447":123867,"_2948":121300},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3464":72647,"_30209":72634,"_5":30559,"_20922":123869,"_27447":123870,"_2948":116320},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3464":72648,"_30209":72634,"_20922":123872,"_5":14373,"_27447":72634,"_2948":123873},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3464":72649,"_30209":72634,"_20922":123875,"_5":14373,"_27447":123828,"_2948":123876},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3464":72650,"_30209":72634,"_20922":123878,"_5":14373,"_27447":123828,"_2948":123879},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3464":72651,"_30209":72634,"_20922":123881,"_5":14373,"_27447":123828,"_2948":123882},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3464":72652,"_30209":72634,"_20922":123884,"_5":14373,"_27447":123828,"_2948":123885},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3464":72653,"_30209":72634,"_20922":123887,"_5":14373,"_27447":123828,"_2948":123888},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3464":72654,"_30209":72634,"_20922":123890,"_5":14373,"_27447":123831,"_2948":123891},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3464":72655,"_30209":72634,"_20922":123893,"_5":14373,"_27447":123835,"_2948":123894},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3464":72656,"_30209":72634,"_20922":123896,"_5":14373,"_27447":123835,"_2948":123897},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3464":72657,"_30209":72634,"_20922":123899,"_5":14373,"_27447":123839,"_2948":123900},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3464":72658,"_30209":72634,"_20922":123902,"_5":14373,"_27447":123839,"_2948":123903},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3464":72659,"_30209":72634,"_20922":123905,"_5":14373,"_27447":123843,"_2948":123906},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3464":72660,"_30209":72634,"_20922":123908,"_5":14373,"_27447":123843,"_2948":123909},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3464":72661,"_30209":72634,"_20922":123911,"_5":14373,"_27447":123847,"_2948":123912},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3464":72662,"_30209":72634,"_20922":123914,"_5":14373,"_27447":123851,"_2948":123915},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3464":72663,"_30209":72634,"_20922":123917,"_5":14373,"_27447":123855,"_2948":123918},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3464":72664,"_30209":72634,"_20922":123920,"_5":14373,"_27447":123859,"_2948":123921},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3464":72665,"_30209":72634,"_20922":123923,"_5":14373,"_27447":123859,"_2948":123924},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3464":72666,"_30209":72634,"_20922":123926,"_5":14373,"_27447":123859,"_2948":123927},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3464":72667,"_30209":72634,"_20922":123929,"_5":14373,"_27447":123863,"_2948":123930},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3464":72668,"_30209":72634,"_20922":123932,"_5":14373,"_27447":123863,"_2948":123933},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3464":72669,"_30209":72634,"_20922":123935,"_5":14373,"_27447":123863,"_2948":123936},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3464":72670,"_30209":72634,"_20922":123938,"_5":14373,"_27447":123867,"_2948":121383},[],{"_3464":72671,"_30209":72634,"_20922":123940,"_5":14373,"_27447":123867,"_2948":119904},[],{"_3464":72672,"_30209":72634,"_20922":123942,"_5":14373,"_27447":123867,"_2948":123943},[],"La CA rechaza la emisión",{"_3464":72673,"_30209":72634,"_20922":123945,"_5":14373,"_27447":123867,"_2948":123946},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3464":72674,"_30209":72634,"_20922":123948,"_5":14373,"_27447":123867,"_2948":123949},[],"Sujeto o usos diferentes",{"_3464":72675,"_30209":72634,"_20922":123951,"_5":14373,"_27447":123867,"_2948":123952},[],"Perfil aplicado y valores solicitados.",{"_3464":72676,"_30209":72634,"_20922":123954,"_5":14373,"_27447":123867,"_2948":123955},[],"No se encuentra el emisor",{"_3464":72677,"_30209":72634,"_20922":123957,"_5":14373,"_27447":123867,"_2948":123958},[],"CA descargada y cadena intermedia necesaria.",{"_3464":72678,"_30209":72634,"_20922":123960,"_5":14373,"_27447":123867,"_2948":123961},[],"Falla la vigencia",{"_3464":72679,"_30209":72634,"_20922":123963,"_5":14373,"_27447":123867,"_2948":123964},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3464":72680,"_30209":72634,"_20922":123966,"_5":14373,"_27447":123867,"_2948":123967},[],"Los resúmenes de clave difieren",{"_3464":72681,"_30209":72634,"_20922":123969,"_5":14373,"_27447":123867,"_2948":123970},[],"Archivos de certificado y clave de la misma emisión.",{"_3464":72682,"_30209":72634,"_20922":123972,"_5":14373,"_27447":123867,"_2948":123973},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3464":72683,"_30209":72634,"_20922":123975,"_5":14373,"_27447":123870,"_2948":123976},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3464":72684,"_30209":72634,"_20922":123978,"_5":14373,"_27447":123870,"_2948":123979},[],"Gestionar certificados para inspección, estado y revocación.",{"_3464":72685,"_30209":72634,"_20922":123981,"_5":14373,"_27447":123870,"_2948":123982},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3464":72686,"_30209":72634,"_20922":123984,"_5":14373,"_27447":123870,"_2948":123985},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3464":72687,"_30209":72634,"_20922":123987,"_5":14373,"_27447":123870,"_2948":123988},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3464":72688,"_30209":72688,"_5":14725,"_2948":123990,"_30562":123991,"_20922":123992,"_27447":72688},"Primeros pasos de PKI",[49276,117725,54756,121053],[],{"_3464":72689,"_30209":72688,"_20922":123994,"_5":14373,"_27447":72688,"_2948":123995},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3464":72690,"_30209":72688,"_5":30559,"_20922":123997,"_27447":123998,"_2948":116296},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3464":72691,"_30209":72688,"_5":30559,"_20922":124000,"_27447":124001,"_2948":124002},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3464":72692,"_30209":72688,"_5":30559,"_20922":124004,"_27447":124005,"_2948":121235},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3464":72693,"_30209":72688,"_5":30559,"_20922":124007,"_27447":124008,"_2948":124009},[],"/docs/pr-preview/pr-63/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3464":72694,"_30209":72688,"_20922":124011,"_5":14373,"_27447":72688,"_2948":124012},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3464":72695,"_30209":72688,"_20922":124014,"_5":14373,"_27447":123998,"_2948":124015},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3464":72696,"_30209":72688,"_20922":124017,"_5":14373,"_27447":123998,"_2948":124018},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3464":72697,"_30209":72688,"_20922":124020,"_5":14373,"_27447":123998,"_2948":124021},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3464":72698,"_30209":72688,"_20922":124023,"_5":14373,"_27447":123998,"_2948":124024},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3464":72699,"_30209":72688,"_20922":124026,"_5":14373,"_27447":123998,"_2948":124027},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3464":72700,"_30209":72688,"_20922":124029,"_5":14373,"_27447":124001,"_2948":124030},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3464":72701,"_30209":72688,"_20922":124032,"_5":14373,"_27447":124001,"_2948":124033},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3464":72702,"_30209":72688,"_20922":124035,"_5":14373,"_27447":124001,"_2948":124036},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3464":72703,"_30209":72688,"_20922":124038,"_5":14373,"_27447":124001,"_2948":124039},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3464":72704,"_30209":72688,"_20922":124041,"_5":14373,"_27447":124005,"_2948":124042},[],"Archivo o recurso",{"_3464":72705,"_30209":72688,"_20922":124044,"_5":14373,"_27447":124005,"_2948":121232},[],{"_3464":72706,"_30209":72688,"_20922":124046,"_5":14373,"_27447":124005,"_2948":124047},[],"CA raíz activa y `ca.pem`",{"_3464":72707,"_30209":72688,"_20922":124049,"_5":14373,"_27447":124005,"_2948":124050},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3464":72708,"_30209":72688,"_20922":124052,"_5":14373,"_27447":124005,"_2948":124053},[],"Certificado final y `device.crt`",{"_3464":72709,"_30209":72688,"_20922":124055,"_5":14373,"_27447":124005,"_2948":124056},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3464":72710,"_30209":72688,"_20922":124058,"_5":14373,"_27447":124005,"_2948":124059},[],"Clave privada `device.key`",{"_3464":72711,"_30209":72688,"_20922":124061,"_5":14373,"_27447":124005,"_2948":124062},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3464":72712,"_30209":72688,"_20922":124064,"_5":14373,"_27447":124005,"_2948":124065},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3464":72713,"_30209":72688,"_20922":124067,"_5":14373,"_27447":124008,"_2948":124068},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3464":72714,"_30209":72688,"_20922":124070,"_5":14373,"_27447":124008,"_2948":124071},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3464":72715,"_30209":72688,"_20922":124073,"_5":14373,"_27447":124008,"_2948":124074},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3464":72716,"_30209":72716,"_5":14725,"_2948":124076,"_30562":124077,"_20922":124079,"_27447":72716},"Resolución de problemas PKI",[49276,117725,54756,124078],"Resolución de problemas",[],{"_3464":72717,"_30209":72716,"_20922":124081,"_5":14373,"_27447":72716,"_2948":124082},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3464":72718,"_30209":72716,"_5":30559,"_20922":124084,"_27447":124085,"_2948":124086},[],"/docs/pr-preview/pr-63/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3464":72719,"_30209":72716,"_5":30559,"_20922":124088,"_27447":124089,"_2948":124090},[],"/docs/pr-preview/pr-63/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3464":72720,"_30209":72716,"_5":30559,"_20922":124092,"_27447":124093,"_2948":124094},[],"/docs/pr-preview/pr-63/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3464":72721,"_30209":72716,"_20922":124096,"_5":14373,"_27447":72716,"_2948":124097},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3464":72722,"_30209":72716,"_20922":124099,"_5":14373,"_27447":72716,"_2948":124100},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3464":72723,"_30209":72716,"_20922":124102,"_5":14373,"_27447":124085,"_2948":121232},[],{"_3464":72724,"_30209":72716,"_20922":124104,"_5":14373,"_27447":124085,"_2948":119904},[],{"_3464":72725,"_30209":72716,"_20922":124106,"_5":14373,"_27447":124085,"_2948":116320},[],{"_3464":72726,"_30209":72716,"_20922":124108,"_5":14373,"_27447":124085,"_2948":53598},[],{"_3464":72727,"_30209":72716,"_20922":124110,"_5":14373,"_27447":124085,"_2948":124111},[],"Existe, está activa y sus fechas son utilizables.",{"_3464":72728,"_30209":72716,"_20922":124113,"_5":14373,"_27447":124085,"_2948":124114},[],"Autoridades.",{"_3464":72729,"_30209":72716,"_20922":124116,"_5":14373,"_27447":124085,"_2948":124117},[],"Clave",{"_3464":72730,"_30209":72716,"_20922":124119,"_5":14373,"_27447":124085,"_2948":124120},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3464":72731,"_30209":72716,"_20922":124122,"_5":14373,"_27447":124085,"_2948":124123},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3464":72732,"_30209":72716,"_20922":124125,"_5":14373,"_27447":124085,"_2948":57314},[],{"_3464":72733,"_30209":72716,"_20922":124127,"_5":14373,"_27447":124085,"_2948":124128},[],"PEM correcto y firma verificable.",{"_3464":72734,"_30209":72716,"_20922":124130,"_5":14373,"_27447":124085,"_2948":57320},[],{"_3464":72735,"_30209":72716,"_20922":124132,"_5":14373,"_27447":124085,"_2948":124133},[],"Perfil",{"_3464":72736,"_30209":72716,"_20922":124135,"_5":14373,"_27447":124085,"_2948":124136},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3464":72737,"_30209":72716,"_20922":124138,"_5":14373,"_27447":124085,"_2948":124139},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3464":72738,"_30209":72716,"_20922":124141,"_5":14373,"_27447":124085,"_2948":121383},[],{"_3464":72739,"_30209":72716,"_20922":124143,"_5":14373,"_27447":124085,"_2948":124144},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3464":72740,"_30209":72716,"_20922":124146,"_5":14373,"_27447":124085,"_2948":124147},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3464":72741,"_30209":72716,"_20922":124149,"_5":14373,"_27447":124085,"_2948":124150},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3464":72742,"_30209":72716,"_20922":124152,"_5":14373,"_27447":124085,"_2948":124153},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3464":72743,"_30209":72716,"_20922":124155,"_5":14373,"_27447":124089,"_2948":124156},[],"Revisa cada frontera por separado:",{"_3464":72744,"_30209":72716,"_20922":124158,"_5":14373,"_27447":124089,"_2948":124159},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3464":72745,"_30209":72716,"_20922":124161,"_5":14373,"_27447":124089,"_2948":124162},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3464":72746,"_30209":72716,"_20922":124164,"_5":14373,"_27447":124089,"_2948":124165},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3464":72747,"_30209":72716,"_20922":124167,"_5":14373,"_27447":124089,"_2948":124168},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3464":72748,"_30209":72716,"_20922":124170,"_5":14373,"_27447":124089,"_2948":124171},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3464":72749,"_30209":72716,"_20922":124173,"_5":14373,"_27447":124089,"_2948":124174},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3464":72750,"_30209":72716,"_20922":124176,"_5":14373,"_27447":124093,"_2948":124177},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3464":72751,"_30209":72716,"_20922":124179,"_5":14373,"_27447":124093,"_2948":124180},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3464":72752,"_30209":72752,"_5":14725,"_2948":124182,"_30562":124183,"_20922":124184,"_27447":72752},"Seguridad",[49276],[],{"_3464":72753,"_30209":72752,"_20922":124186,"_5":14373,"_27447":72752,"_2948":124187},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3464":72754,"_30209":72752,"_5":30559,"_20922":124189,"_27447":124190,"_2948":124191},[],"/docs/pr-preview/pr-63/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3464":72755,"_30209":72752,"_5":30559,"_20922":124193,"_27447":124194,"_2948":124195},[],"/docs/pr-preview/pr-63/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3464":72756,"_30209":72752,"_5":30559,"_20922":124197,"_27447":124198,"_2948":124199},[],"/docs/pr-preview/pr-63/es/security#versiones-soportadas","Versiones soportadas",{"_3464":72757,"_30209":72752,"_5":30559,"_20922":124201,"_27447":124202,"_2948":124203},[],"/docs/pr-preview/pr-63/es/security#divulgación-responsable","Divulgación responsable",{"_3464":72758,"_30209":72752,"_20922":124205,"_5":14373,"_27447":72752,"_2948":124206},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3464":72759,"_30209":72752,"_20922":124208,"_5":14373,"_27447":124190,"_2948":124209},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3464":72760,"_30209":72752,"_20922":124211,"_5":14373,"_27447":124190,"_2948":124212},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3464":72761,"_30209":72752,"_20922":124214,"_5":14373,"_27447":124190,"_2948":14997},[],{"_3464":72762,"_30209":72752,"_20922":124216,"_5":14373,"_27447":124190,"_2948":14937},[],{"_3464":72763,"_30209":72752,"_20922":124218,"_5":14373,"_27447":124190,"_2948":14984},[],{"_3464":72764,"_30209":72752,"_20922":124220,"_5":14373,"_27447":124190,"_2948":124221},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3464":72765,"_30209":72752,"_20922":124223,"_5":14373,"_27447":124190,"_2948":124224},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3464":72766,"_30209":72752,"_20922":124226,"_5":14373,"_27447":124194,"_2948":124227},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3464":72767,"_30209":72752,"_20922":124229,"_5":14373,"_27447":124194,"_2948":124230},[],"No incluyas en el reporte:",{"_3464":72768,"_30209":72752,"_20922":124232,"_5":14373,"_27447":124194,"_2948":124233},[],"Credenciales, tokens o claves privadas",{"_3464":72769,"_30209":72752,"_20922":124235,"_5":14373,"_27447":124194,"_2948":124236},[],"Datos de clientes o información identificable de clientes",{"_3464":72770,"_30209":72752,"_20922":124238,"_5":14373,"_27447":124194,"_2948":124239},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3464":72771,"_30209":72752,"_20922":124241,"_5":14373,"_27447":124198,"_2948":124242},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3464":72772,"_30209":72752,"_20922":124244,"_5":14373,"_27447":124198,"_2948":124245},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3464":72773,"_30209":72752,"_20922":124247,"_5":14373,"_27447":124202,"_2948":124248},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3464":72774,"_30209":72752,"_20922":124250,"_5":14373,"_27447":124202,"_2948":124251},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3464":72775,"_30209":72752,"_20922":124253,"_5":14373,"_27447":124202,"_2948":124254},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3464":72776,"_30209":72752,"_20922":124256,"_5":14373,"_27447":124202,"_2948":124257},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3464":72777,"_30209":72752,"_20922":124259,"_5":14373,"_27447":124202,"_2948":124260},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3464":72778,"_30209":72778,"_5":14725,"_2948":124262,"_30562":124263,"_20922":124265,"_27447":72778},"3.8.0 a 4.0.0",[49276,124264],"Actualizaciones",[],{"_3464":72779,"_30209":72778,"_20922":124267,"_5":14373,"_27447":72778,"_2948":124268},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3464":72780,"_30209":72778,"_5":30559,"_20922":124270,"_27447":124271,"_2948":124272},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3464":72781,"_30209":72778,"_5":30559,"_20922":124274,"_27447":124275,"_2948":124276},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3464":72782,"_30209":72778,"_5":30559,"_20922":124278,"_27447":124279,"_2948":124280},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3464":72783,"_30209":72778,"_5":30559,"_20922":124282,"_27447":124283,"_2948":124284},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3464":72784,"_30209":72778,"_5":30559,"_20922":124286,"_27447":124287,"_2948":124288},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3464":72785,"_30209":72778,"_5":30559,"_20922":124290,"_27447":124291,"_2948":124292},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3464":72786,"_30209":72778,"_5":30559,"_20922":124294,"_27447":124295,"_2948":57486},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3464":72787,"_30209":72778,"_5":30559,"_20922":124297,"_27447":124298,"_2948":124299},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3464":72788,"_30209":72778,"_5":30559,"_20922":124301,"_27447":124302,"_2948":124303},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3464":72789,"_30209":72778,"_5":30559,"_20922":124305,"_27447":124306,"_2948":124307},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3464":72790,"_30209":72778,"_5":30559,"_20922":124309,"_27447":124310,"_2948":124311},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3464":72791,"_30209":72778,"_5":30559,"_20922":124313,"_27447":124314,"_2948":124315},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3464":72792,"_30209":72778,"_5":30559,"_20922":124317,"_27447":124318,"_2948":124319},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3464":72793,"_30209":72778,"_5":30559,"_20922":124321,"_27447":124322,"_2948":124323},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3464":72794,"_30209":72778,"_5":30559,"_20922":124325,"_27447":124326,"_2948":124327},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3464":72795,"_30209":72778,"_5":30559,"_20922":124329,"_27447":124330,"_2948":124331},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3464":72796,"_30209":72778,"_5":30559,"_20922":124333,"_27447":124334,"_2948":124335},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3464":72797,"_30209":72778,"_5":30559,"_20922":124337,"_27447":124338,"_2948":124339},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3464":72798,"_30209":72778,"_5":30559,"_20922":124341,"_27447":124342,"_2948":124343},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3464":72799,"_30209":72778,"_5":30559,"_20922":124345,"_27447":124346,"_2948":124347},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3464":72800,"_30209":72778,"_5":30559,"_20922":124349,"_27447":124350,"_2948":124351},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3464":72801,"_30209":72778,"_5":30559,"_20922":124353,"_27447":124354,"_2948":124355},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3464":72802,"_30209":72778,"_5":30559,"_20922":124357,"_27447":124358,"_2948":124359},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3464":72803,"_30209":72778,"_5":30559,"_20922":124361,"_27447":124362,"_2948":124363},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3464":72804,"_30209":72778,"_5":30559,"_20922":124365,"_27447":124366,"_2948":124367},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3464":72805,"_30209":72778,"_5":30559,"_20922":124369,"_27447":124370,"_2948":124371},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3464":72806,"_30209":72778,"_5":30559,"_20922":124373,"_27447":124374,"_2948":124375},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3464":72807,"_30209":72778,"_5":30559,"_20922":124377,"_27447":124378,"_2948":124379},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3464":72808,"_30209":72778,"_5":30559,"_20922":124381,"_27447":124382,"_2948":124383},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3464":72809,"_30209":72778,"_5":30559,"_20922":124385,"_27447":124386,"_2948":124387},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3464":72810,"_30209":72778,"_5":30559,"_20922":124389,"_27447":124390,"_2948":124391},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3464":72811,"_30209":72778,"_5":30559,"_20922":124393,"_27447":124394,"_2948":124395},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3464":72812,"_30209":72778,"_5":30559,"_20922":124397,"_27447":124398,"_2948":124399},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3464":72813,"_30209":72778,"_5":30559,"_20922":124401,"_27447":124402,"_2948":124403},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3464":72814,"_30209":72778,"_5":30559,"_20922":124405,"_27447":124406,"_2948":124407},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3464":72815,"_30209":72778,"_5":30559,"_20922":124409,"_27447":124410,"_2948":124411},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3464":72816,"_30209":72778,"_5":30559,"_20922":124413,"_27447":124414,"_2948":124415},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3464":72817,"_30209":72778,"_5":30559,"_20922":124417,"_27447":124418,"_2948":124419},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3464":72818,"_30209":72778,"_5":30559,"_20922":124421,"_27447":124422,"_2948":124423},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3464":72819,"_30209":72778,"_5":30559,"_20922":124425,"_27447":124426,"_2948":124427},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3464":72820,"_30209":72778,"_5":30559,"_20922":124429,"_27447":124430,"_2948":120246},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3464":72821,"_30209":72778,"_5":30559,"_20922":124432,"_27447":124433,"_2948":124434},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3464":72822,"_30209":72778,"_5":30559,"_20922":124436,"_27447":124437,"_2948":124438},[],"/docs/pr-preview/pr-63/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3464":72823,"_30209":72778,"_20922":124440,"_5":14373,"_27447":72778,"_2948":124441},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3464":72824,"_30209":72778,"_20922":124443,"_5":14373,"_27447":72778,"_2948":124444},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3464":72825,"_30209":72778,"_20922":124446,"_5":14373,"_27447":72778,"_2948":124447},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3464":72826,"_30209":72778,"_20922":124449,"_5":14373,"_27447":72778,"_2948":124450},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3464":72827,"_30209":72778,"_20922":124452,"_5":14373,"_27447":72778,"_2948":124453},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3464":72828,"_30209":72778,"_20922":124455,"_5":14373,"_27447":72778,"_2948":124456},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3464":72829,"_30209":72778,"_20922":124458,"_5":14373,"_27447":72778,"_2948":124459},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3464":72830,"_30209":72778,"_20922":124461,"_5":14373,"_27447":124275,"_2948":124462},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3464":72831,"_30209":72778,"_20922":124464,"_5":14373,"_27447":124275,"_2948":124465},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3464":72832,"_30209":72778,"_20922":124467,"_5":14373,"_27447":124279,"_2948":124468},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3464":72833,"_30209":72778,"_20922":124470,"_5":14373,"_27447":124279,"_2948":124471},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3464":72834,"_30209":72778,"_20922":124473,"_5":14373,"_27447":124283,"_2948":124474},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3464":72835,"_30209":72778,"_20922":124476,"_5":14373,"_27447":124287,"_2948":124477},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3464":72836,"_30209":72778,"_20922":124479,"_5":14373,"_27447":124287,"_2948":124480},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3464":72837,"_30209":72778,"_20922":124482,"_5":14373,"_27447":124287,"_2948":124483},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3464":72838,"_30209":72778,"_20922":124485,"_5":14373,"_27447":124287,"_2948":124486},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3464":72839,"_30209":72778,"_20922":124488,"_5":14373,"_27447":124287,"_2948":124489},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3464":72840,"_30209":72778,"_20922":124491,"_5":14373,"_27447":124291,"_2948":124492},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3464":72841,"_30209":72778,"_20922":124494,"_5":14373,"_27447":124291,"_2948":124495},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3464":72842,"_30209":72778,"_20922":124497,"_5":14373,"_27447":124291,"_2948":124498},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3464":72843,"_30209":72778,"_20922":124500,"_5":14373,"_27447":124291,"_2948":124501},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3464":72844,"_30209":72778,"_20922":124503,"_5":14373,"_27447":124291,"_2948":124504},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3464":72845,"_30209":72778,"_20922":124506,"_5":14373,"_27447":124291,"_2948":124507},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3464":72846,"_30209":72778,"_20922":124509,"_5":14373,"_27447":124295,"_2948":124510},[],"Cambio",{"_3464":72847,"_30209":72778,"_20922":124512,"_5":14373,"_27447":124295,"_2948":124513},[],"A quién afecta",{"_3464":72848,"_30209":72778,"_20922":124515,"_5":14373,"_27447":124295,"_2948":124516},[],"Gravedad",{"_3464":72849,"_30209":72778,"_20922":124518,"_5":14373,"_27447":124295,"_2948":123013},[],{"_3464":72850,"_30209":72778,"_20922":124520,"_5":14373,"_27447":124295,"_2948":124303},[],{"_3464":72851,"_30209":72778,"_20922":124522,"_5":14373,"_27447":124295,"_2948":124523},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3464":72852,"_30209":72778,"_20922":124525,"_5":14373,"_27447":124295,"_2948":124526},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3464":72853,"_30209":72778,"_20922":124528,"_5":14373,"_27447":124295,"_2948":124529},[],"Copiar los datos a los volúmenes nuevos",{"_3464":72854,"_30209":72778,"_20922":124531,"_5":14373,"_27447":124295,"_2948":124307},[],{"_3464":72855,"_30209":72778,"_20922":124533,"_5":14373,"_27447":124295,"_2948":124534},[],"Todas las releases de Helm",{"_3464":72856,"_30209":72778,"_20922":124536,"_5":14373,"_27447":124295,"_2948":124537},[],"Alta: `helm upgrade` falla",{"_3464":72857,"_30209":72778,"_20922":124539,"_5":14373,"_27447":124295,"_2948":124540},[],"Eliminar o renombrar las claves heredadas",{"_3464":72858,"_30209":72778,"_20922":124542,"_5":14373,"_27447":124295,"_2948":124311},[],{"_3464":72859,"_30209":72778,"_20922":124544,"_5":14373,"_27447":124295,"_2948":124545},[],"Todos los despliegues",{"_3464":72860,"_30209":72778,"_20922":124547,"_5":14373,"_27447":124295,"_2948":124548},[],"Alta: sin principal de bootstrap no hay administrador",{"_3464":72861,"_30209":72778,"_20922":124550,"_5":14373,"_27447":124295,"_2948":124551},[],"Configurar `services.authz`",{"_3464":72862,"_30209":72778,"_20922":124553,"_5":14373,"_27447":124295,"_2948":124315},[],{"_3464":72863,"_30209":72778,"_20922":124555,"_5":14373,"_27447":124295,"_2948":124534},[],{"_3464":72864,"_30209":72778,"_20922":124557,"_5":14373,"_27447":124295,"_2948":124558},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3464":72865,"_30209":72778,"_20922":124560,"_5":14373,"_27447":124295,"_2948":124561},[],"Mover JWKS y roles a `services.authz`",{"_3464":72866,"_30209":72778,"_20922":124563,"_5":14373,"_27447":124295,"_2948":124335},[],{"_3464":72867,"_30209":72778,"_20922":124565,"_5":14373,"_27447":124295,"_2948":124566},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3464":72868,"_30209":72778,"_20922":124568,"_5":14373,"_27447":124295,"_2948":124569},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3464":72869,"_30209":72778,"_20922":124571,"_5":14373,"_27447":124295,"_2948":124572},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3464":72870,"_30209":72778,"_20922":124574,"_5":14373,"_27447":124295,"_2948":124339},[],{"_3464":72871,"_30209":72778,"_20922":124576,"_5":14373,"_27447":124295,"_2948":124577},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3464":72872,"_30209":72778,"_20922":124579,"_5":14373,"_27447":124295,"_2948":124580},[],"Alta: el backend ya no arranca con ellos",{"_3464":72873,"_30209":72778,"_20922":124582,"_5":14373,"_27447":124295,"_2948":124583},[],"Pasar a PostgreSQL antes de actualizar",{"_3464":72874,"_30209":72778,"_20922":124585,"_5":14373,"_27447":124295,"_2948":124383},[],{"_3464":72875,"_30209":72778,"_20922":124587,"_5":14373,"_27447":124295,"_2948":124588},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3464":72876,"_30209":72778,"_20922":124590,"_5":14373,"_27447":124295,"_2948":124591},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3464":72877,"_30209":72778,"_20922":124593,"_5":14373,"_27447":124295,"_2948":124594},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3464":72878,"_30209":72778,"_20922":124596,"_5":14373,"_27447":124295,"_2948":124597},[],"Webhooks con referencias a archivos",{"_3464":72879,"_30209":72778,"_20922":124599,"_5":14373,"_27447":124295,"_2948":124600},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3464":72880,"_30209":72778,"_20922":124602,"_5":14373,"_27447":124295,"_2948":124603},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3464":72881,"_30209":72778,"_20922":124605,"_5":14373,"_27447":124295,"_2948":124606},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3464":72882,"_30209":72778,"_20922":124608,"_5":14373,"_27447":124295,"_2948":124319},[],{"_3464":72883,"_30209":72778,"_20922":124610,"_5":14373,"_27447":124295,"_2948":124611},[],"Releases con identidades por servicio o material de claves montado",{"_3464":72884,"_30209":72778,"_20922":124613,"_5":14373,"_27447":124295,"_2948":124614},[],"Media: los servicios no pueden leer sus archivos",{"_3464":72885,"_30209":72778,"_20922":124616,"_5":14373,"_27447":124295,"_2948":124617},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3464":72886,"_30209":72778,"_20922":124619,"_5":14373,"_27447":124295,"_2948":124323},[],{"_3464":72887,"_30209":72778,"_20922":124621,"_5":14373,"_27447":124295,"_2948":124622},[],"Releases que definen `amqp.tls`",{"_3464":72888,"_30209":72778,"_20922":124624,"_5":14373,"_27447":124295,"_2948":124625},[],"Media: los clientes se conectan al puerto equivocado",{"_3464":72889,"_30209":72778,"_20922":124627,"_5":14373,"_27447":124295,"_2948":124628},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3464":72890,"_30209":72778,"_20922":124630,"_5":14373,"_27447":124295,"_2948":124343},[],{"_3464":72891,"_30209":72778,"_20922":124632,"_5":14373,"_27447":124295,"_2948":124633},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3464":72892,"_30209":72778,"_20922":124635,"_5":14373,"_27447":124295,"_2948":124636},[],"Media: las claves de CA quedan sin gestionar",{"_3464":72893,"_30209":72778,"_20922":124638,"_5":14373,"_27447":124295,"_2948":124639},[],"Ejecutar la migración de CA a KMS",{"_3464":72894,"_30209":72778,"_20922":124641,"_5":14373,"_27447":124295,"_2948":124642},[],"Verificación del certificado del receptor",{"_3464":72895,"_30209":72778,"_20922":124644,"_5":14373,"_27447":124295,"_2948":124645},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3464":72896,"_30209":72778,"_20922":124647,"_5":14373,"_27447":124295,"_2948":124648},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3464":72897,"_30209":72778,"_20922":124650,"_5":14373,"_27447":124295,"_2948":124651},[],"Poner `insecure_skip_verify` a `false`",{"_3464":72898,"_30209":72778,"_20922":124653,"_5":14373,"_27447":124295,"_2948":124359},[],{"_3464":72899,"_30209":72778,"_20922":124655,"_5":14373,"_27447":124295,"_2948":124656},[],"Scripts y consolas que editan DMS por API",{"_3464":72900,"_30209":72778,"_20922":124658,"_5":14373,"_27447":124295,"_2948":124659},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3464":72901,"_30209":72778,"_20922":124661,"_5":14373,"_27447":124295,"_2948":124662},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3464":72902,"_30209":72778,"_20922":124664,"_5":14373,"_27447":124295,"_2948":124379},[],{"_3464":72903,"_30209":72778,"_20922":124666,"_5":14373,"_27447":124295,"_2948":124667},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3464":72904,"_30209":72778,"_20922":124669,"_5":14373,"_27447":124295,"_2948":124670},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3464":72905,"_30209":72778,"_20922":124672,"_5":14373,"_27447":124295,"_2948":124673},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3464":72906,"_30209":72778,"_20922":124675,"_5":14373,"_27447":124295,"_2948":124387},[],{"_3464":72907,"_30209":72778,"_20922":124677,"_5":14373,"_27447":124295,"_2948":124678},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3464":72908,"_30209":72778,"_20922":124680,"_5":14373,"_27447":124295,"_2948":124681},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3464":72909,"_30209":72778,"_20922":124683,"_5":14373,"_27447":124295,"_2948":124684},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3464":72910,"_30209":72778,"_20922":124686,"_5":14373,"_27447":124295,"_2948":124375},[],{"_3464":72911,"_30209":72778,"_20922":124688,"_5":14373,"_27447":124295,"_2948":124689},[],"Consumidores que leen el campo `events` del dispositivo",{"_3464":72912,"_30209":72778,"_20922":124691,"_5":14373,"_27447":124295,"_2948":124692},[],"Media: el campo desaparece",{"_3464":72913,"_30209":72778,"_20922":124694,"_5":14373,"_27447":124295,"_2948":124695},[],"Usar los nuevos endpoints de eventos",{"_3464":72914,"_30209":72778,"_20922":124697,"_5":14373,"_27447":124295,"_2948":124395},[],{"_3464":72915,"_30209":72778,"_20922":124699,"_5":14373,"_27447":124295,"_2948":124700},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3464":72916,"_30209":72778,"_20922":124702,"_5":14373,"_27447":124295,"_2948":124703},[],"Media: la migración de la VA aborta",{"_3464":72917,"_30209":72778,"_20922":124705,"_5":14373,"_27447":124295,"_2948":124706},[],"Corregir los roles afectados antes de actualizar",{"_3464":72918,"_30209":72778,"_20922":124708,"_5":14373,"_27447":124295,"_2948":124327},[],{"_3464":72919,"_30209":72778,"_20922":124710,"_5":14373,"_27447":124295,"_2948":124711},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3464":72920,"_30209":72778,"_20922":124713,"_5":14373,"_27447":124295,"_2948":124714},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3464":72921,"_30209":72778,"_20922":124716,"_5":14373,"_27447":124295,"_2948":124717},[],"Actualizar el archivo de values",{"_3464":72922,"_30209":72778,"_20922":124719,"_5":14373,"_27447":124295,"_2948":124367},[],{"_3464":72923,"_30209":72778,"_20922":124721,"_5":14373,"_27447":124295,"_2948":124722},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3464":72924,"_30209":72778,"_20922":124724,"_5":14373,"_27447":124295,"_2948":124725},[],"Baja: prevalece el ID de la URL",{"_3464":72925,"_30209":72778,"_20922":124727,"_5":14373,"_27447":124295,"_2948":124728},[],"Enviar el ID en la URL",{"_3464":72926,"_30209":72778,"_20922":124730,"_5":14373,"_27447":124295,"_2948":124391},[],{"_3464":72927,"_30209":72778,"_20922":124732,"_5":14373,"_27447":124295,"_2948":124733},[],"Clientes que envían un `id` al crear o importar CAs",{"_3464":72928,"_30209":72778,"_20922":124735,"_5":14373,"_27447":124295,"_2948":124736},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3464":72929,"_30209":72778,"_20922":124738,"_5":14373,"_27447":124295,"_2948":124739},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3464":72930,"_30209":72778,"_20922":124741,"_5":14373,"_27447":124295,"_2948":124371},[],{"_3464":72931,"_30209":72778,"_20922":124743,"_5":14373,"_27447":124295,"_2948":124744},[],"Consumidores que comparan el `type` del certificado",{"_3464":72932,"_30209":72778,"_20922":124746,"_5":14373,"_27447":124295,"_2948":124747},[],"Baja: dos valores cambian de nombre",{"_3464":72933,"_30209":72778,"_20922":124749,"_5":14373,"_27447":124295,"_2948":124750},[],"Adaptar los consumidores",{"_3464":72934,"_30209":72778,"_20922":124752,"_5":14373,"_27447":124295,"_2948":124363},[],{"_3464":72935,"_30209":72778,"_20922":124754,"_5":14373,"_27447":124295,"_2948":124755},[],"Cualquier DMS",{"_3464":72936,"_30209":72778,"_20922":124757,"_5":14373,"_27447":124295,"_2948":124758},[],"Baja: solo informativo",{"_3464":72937,"_30209":72778,"_20922":124760,"_5":14373,"_27447":124295,"_2948":124761},[],"Revisar ambos bloques antes de editar",{"_3464":72938,"_30209":72778,"_20922":124763,"_5":14373,"_27447":124302,"_2948":124764},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3464":72939,"_30209":72778,"_20922":124766,"_5":14373,"_27447":124302,"_2948":124767},[],"El paso 4 de la guía de migración copia los datos.",{"_3464":72940,"_30209":72778,"_20922":124769,"_5":14373,"_27447":124306,"_2948":124770},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3464":72941,"_30209":72778,"_20922":124772,"_5":14373,"_27447":124310,"_2948":124773},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3464":72942,"_30209":72778,"_20922":124775,"_5":14373,"_27447":124314,"_2948":124776},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3464":72943,"_30209":72778,"_20922":124778,"_5":14373,"_27447":124318,"_2948":124779},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3464":72944,"_30209":72778,"_20922":124781,"_5":14373,"_27447":124318,"_2948":124782},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3464":72945,"_30209":72778,"_20922":124784,"_5":14373,"_27447":124322,"_2948":124785},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3464":72946,"_30209":72778,"_20922":124787,"_5":14373,"_27447":124326,"_2948":124788},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3464":72947,"_30209":72778,"_20922":124790,"_5":14373,"_27447":124326,"_2948":124791},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3464":72948,"_30209":72778,"_20922":124793,"_5":14373,"_27447":124326,"_2948":124794},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3464":72949,"_30209":72778,"_20922":124796,"_5":14373,"_27447":124326,"_2948":124797},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3464":72950,"_30209":72778,"_20922":124799,"_5":14373,"_27447":124326,"_2948":124800},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3464":72951,"_30209":72778,"_20922":124802,"_5":14373,"_27447":124326,"_2948":124803},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3464":72952,"_30209":72778,"_20922":124805,"_5":14373,"_27447":124334,"_2948":124806},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3464":72953,"_30209":72778,"_20922":124808,"_5":14373,"_27447":124334,"_2948":124809},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3464":72954,"_30209":72778,"_20922":124811,"_5":14373,"_27447":124334,"_2948":124812},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3464":72955,"_30209":72778,"_20922":124814,"_5":14373,"_27447":124334,"_2948":124815},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3464":72956,"_30209":72778,"_20922":124817,"_5":14373,"_27447":124334,"_2948":124818},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3464":72957,"_30209":72778,"_20922":124820,"_5":14373,"_27447":124338,"_2948":124821},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3464":72958,"_30209":72778,"_20922":124823,"_5":14373,"_27447":124342,"_2948":124824},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3464":72959,"_30209":72778,"_20922":124826,"_5":14373,"_27447":124342,"_2948":124827},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3464":72960,"_30209":72778,"_20922":124829,"_5":14373,"_27447":124342,"_2948":124830},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3464":72961,"_30209":72778,"_20922":124832,"_5":14373,"_27447":124342,"_2948":124833},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3464":72962,"_30209":72778,"_20922":124835,"_5":14373,"_27447":124342,"_2948":124836},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3464":72963,"_30209":72778,"_20922":124838,"_5":14373,"_27447":124342,"_2948":124839},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3464":72964,"_30209":72778,"_20922":124841,"_5":14373,"_27447":124342,"_2948":124842},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3464":72965,"_30209":72778,"_20922":124844,"_5":14373,"_27447":124342,"_2948":124845},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3464":72966,"_30209":72778,"_20922":124847,"_5":14373,"_27447":124346,"_2948":124848},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3464":72967,"_30209":72778,"_20922":124850,"_5":14373,"_27447":124354,"_2948":124851},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3464":72968,"_30209":72778,"_20922":124853,"_5":14373,"_27447":124354,"_2948":124854},[],"Campo en 3.8.0",{"_3464":72969,"_30209":72778,"_20922":124856,"_5":14373,"_27447":124354,"_2948":124857},[],"Campo en 4.0.0",{"_3464":72970,"_30209":72778,"_20922":124859,"_5":14373,"_27447":124354,"_2948":58051},[],{"_3464":72971,"_30209":72778,"_20922":124861,"_5":14373,"_27447":124354,"_2948":124862},[],"`insecure_skip_verify` (con el valor negado)",{"_3464":72972,"_30209":72778,"_20922":124864,"_5":14373,"_27447":124354,"_2948":58057},[],{"_3464":72973,"_30209":72778,"_20922":124866,"_5":14373,"_27447":124354,"_2948":58060},[],{"_3464":72974,"_30209":72778,"_20922":124868,"_5":14373,"_27447":124354,"_2948":58063},[],{"_3464":72975,"_30209":72778,"_20922":124870,"_5":14373,"_27447":124354,"_2948":58066},[],{"_3464":72976,"_30209":72778,"_20922":124872,"_5":14373,"_27447":124354,"_2948":58069},[],{"_3464":72977,"_30209":72778,"_20922":124874,"_5":14373,"_27447":124354,"_2948":58072},[],{"_3464":72978,"_30209":72778,"_20922":124876,"_5":14373,"_27447":124354,"_2948":124877},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3464":72979,"_30209":72778,"_20922":124879,"_5":14373,"_27447":124354,"_2948":124880},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3464":72980,"_30209":72778,"_20922":124882,"_5":14373,"_27447":124354,"_2948":124883},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3464":72981,"_30209":72778,"_20922":124885,"_5":14373,"_27447":124358,"_2948":124886},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3464":72982,"_30209":72778,"_20922":124888,"_5":14373,"_27447":124358,"_2948":124889},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3464":72983,"_30209":72778,"_20922":124891,"_5":14373,"_27447":124358,"_2948":124892},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3464":72984,"_30209":72778,"_20922":124894,"_5":14373,"_27447":124362,"_2948":124895},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3464":72985,"_30209":72778,"_20922":124897,"_5":14373,"_27447":124366,"_2948":124898},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3464":72986,"_30209":72778,"_20922":124900,"_5":14373,"_27447":124370,"_2948":124901},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3464":72987,"_30209":72778,"_20922":124903,"_5":14373,"_27447":124374,"_2948":124904},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3464":72988,"_30209":72778,"_20922":124906,"_5":14373,"_27447":124374,"_2948":124907},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3464":72989,"_30209":72778,"_20922":124909,"_5":14373,"_27447":124374,"_2948":124910},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3464":72990,"_30209":72778,"_20922":124912,"_5":14373,"_27447":124374,"_2948":124913},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3464":72991,"_30209":72778,"_20922":124915,"_5":14373,"_27447":124378,"_2948":124916},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3464":72992,"_30209":72778,"_20922":124918,"_5":14373,"_27447":124382,"_2948":124919},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3464":72993,"_30209":72778,"_20922":124921,"_5":14373,"_27447":124382,"_2948":124922},[],"Ruta",{"_3464":72994,"_30209":72778,"_20922":124924,"_5":14373,"_27447":124382,"_2948":117485},[],{"_3464":72995,"_30209":72778,"_20922":124926,"_5":14373,"_27447":124382,"_2948":58125},[],{"_3464":72996,"_30209":72778,"_20922":124928,"_5":14373,"_27447":124382,"_2948":124929},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3464":72997,"_30209":72778,"_20922":124931,"_5":14373,"_27447":124382,"_2948":58131},[],{"_3464":72998,"_30209":72778,"_20922":124933,"_5":14373,"_27447":124382,"_2948":124934},[],"Lee los ajustes de una CA.",{"_3464":72999,"_30209":72778,"_20922":124936,"_5":14373,"_27447":124382,"_2948":58137},[],{"_3464":73000,"_30209":72778,"_20922":124938,"_5":14373,"_27447":124382,"_2948":124939},[],"Sustituye los `crl_options`.",{"_3464":73001,"_30209":72778,"_20922":124941,"_5":14373,"_27447":124382,"_2948":124942},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3464":73002,"_30209":72778,"_20922":124944,"_5":14373,"_27447":124382,"_2948":124945},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3464":73003,"_30209":72778,"_20922":124947,"_5":14373,"_27447":124382,"_2948":124948},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3464":73004,"_30209":72778,"_20922":124950,"_5":14373,"_27447":124382,"_2948":124951},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3464":73005,"_30209":72778,"_20922":124953,"_5":14373,"_27447":124382,"_2948":124954},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3464":73006,"_30209":72778,"_20922":124956,"_5":14373,"_27447":124382,"_2948":124957},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3464":73007,"_30209":72778,"_20922":124959,"_5":14373,"_27447":124382,"_2948":124960},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3464":73008,"_30209":72778,"_20922":124962,"_5":14373,"_27447":124382,"_2948":124963},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3464":73009,"_30209":72778,"_20922":124965,"_5":14373,"_27447":124382,"_2948":124966},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3464":73010,"_30209":72778,"_20922":124968,"_5":14373,"_27447":124382,"_2948":124969},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3464":73011,"_30209":72778,"_20922":124971,"_5":14373,"_27447":124382,"_2948":124972},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3464":73012,"_30209":72778,"_20922":124974,"_5":14373,"_27447":124386,"_2948":124975},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3464":73013,"_30209":72778,"_20922":124977,"_5":14373,"_27447":124390,"_2948":124978},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3464":73014,"_30209":72778,"_20922":124980,"_5":14373,"_27447":124394,"_2948":124981},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3464":73015,"_30209":72778,"_20922":124983,"_5":14373,"_27447":124398,"_2948":124984},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3464":73016,"_30209":72778,"_20922":124986,"_5":14373,"_27447":124402,"_2948":124987},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3464":73017,"_30209":72778,"_20922":124989,"_5":14373,"_27447":124402,"_2948":124990},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3464":73018,"_30209":72778,"_20922":124992,"_5":14373,"_27447":124402,"_2948":124993},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3464":73019,"_30209":72778,"_20922":124995,"_5":14373,"_27447":124402,"_2948":124996},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3464":73020,"_30209":72778,"_20922":124998,"_5":14373,"_27447":124402,"_2948":124999},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3464":73021,"_30209":72778,"_20922":125001,"_5":14373,"_27447":124402,"_2948":125002},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3464":73022,"_30209":72778,"_20922":125004,"_5":14373,"_27447":124406,"_2948":125005},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3464":73023,"_30209":72778,"_20922":125007,"_5":14373,"_27447":124406,"_2948":125008},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3464":73024,"_30209":72778,"_20922":125010,"_5":14373,"_27447":124406,"_2948":125011},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3464":73025,"_30209":72778,"_20922":125013,"_5":14373,"_27447":124406,"_2948":125014},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3464":73026,"_30209":72778,"_20922":125016,"_5":14373,"_27447":124406,"_2948":125017},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3464":73027,"_30209":72778,"_20922":125019,"_5":14373,"_27447":124410,"_2948":125020},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3464":73028,"_30209":72778,"_20922":125022,"_5":14373,"_27447":124410,"_2948":125023},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3464":73029,"_30209":72778,"_20922":125025,"_5":14373,"_27447":124410,"_2948":125026},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3464":73030,"_30209":72778,"_20922":125028,"_5":14373,"_27447":124410,"_2948":125029},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3464":73031,"_30209":72778,"_20922":125031,"_5":14373,"_27447":124410,"_2948":125032},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3464":73032,"_30209":72778,"_20922":125034,"_5":14373,"_27447":124410,"_2948":125035},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3464":73033,"_30209":72778,"_20922":125037,"_5":14373,"_27447":124410,"_2948":125038},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3464":73034,"_30209":72778,"_20922":125040,"_5":14373,"_27447":124410,"_2948":125041},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3464":73035,"_30209":72778,"_20922":125043,"_5":14373,"_27447":124410,"_2948":125044},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3464":73036,"_30209":72778,"_20922":125046,"_5":14373,"_27447":124410,"_2948":125047},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3464":73037,"_30209":72778,"_20922":125049,"_5":14373,"_27447":124410,"_2948":125050},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3464":73038,"_30209":72778,"_20922":125052,"_5":14373,"_27447":124410,"_2948":125053},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3464":73039,"_30209":72778,"_20922":125055,"_5":14373,"_27447":124414,"_2948":125056},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3464":73040,"_30209":72778,"_20922":125058,"_5":14373,"_27447":124414,"_2948":125059},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3464":73041,"_30209":72778,"_20922":125061,"_5":14373,"_27447":124418,"_2948":125062},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3464":73042,"_30209":72778,"_20922":125064,"_5":14373,"_27447":124418,"_2948":125065},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3464":73043,"_30209":72778,"_20922":125067,"_5":14373,"_27447":124418,"_2948":125068},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3464":73044,"_30209":72778,"_20922":125070,"_5":14373,"_27447":124418,"_2948":125071},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3464":73045,"_30209":72778,"_20922":125073,"_5":14373,"_27447":124418,"_2948":125074},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3464":73046,"_30209":72778,"_20922":125076,"_5":14373,"_27447":124418,"_2948":125077},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3464":73047,"_30209":72778,"_20922":125079,"_5":14373,"_27447":124418,"_2948":125080},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3464":73048,"_30209":72778,"_20922":125082,"_5":14373,"_27447":124418,"_2948":125083},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3464":73049,"_30209":72778,"_20922":125085,"_5":14373,"_27447":124418,"_2948":125086},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3464":73050,"_30209":72778,"_20922":125088,"_5":14373,"_27447":124418,"_2948":125089},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3464":73051,"_30209":72778,"_20922":125091,"_5":14373,"_27447":124418,"_2948":125092},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3464":73052,"_30209":72778,"_20922":125094,"_5":14373,"_27447":124422,"_2948":125095},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3464":73053,"_30209":72778,"_20922":125097,"_5":14373,"_27447":124422,"_2948":125098},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3464":73054,"_30209":72778,"_20922":125100,"_5":14373,"_27447":124426,"_2948":125101},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3464":73055,"_30209":72778,"_20922":125103,"_5":14373,"_27447":124426,"_2948":125104},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3464":73056,"_30209":72778,"_20922":125106,"_5":14373,"_27447":124426,"_2948":125107},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3464":73057,"_30209":72778,"_20922":125109,"_5":14373,"_27447":124426,"_2948":125110},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3464":73058,"_30209":72778,"_20922":125112,"_5":14373,"_27447":124426,"_2948":125113},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3464":73059,"_30209":72778,"_20922":125115,"_5":14373,"_27447":124426,"_2948":125116},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3464":73060,"_30209":72778,"_20922":125118,"_5":14373,"_27447":124426,"_2948":125119},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3464":73061,"_30209":72778,"_20922":125121,"_5":14373,"_27447":124426,"_2948":125122},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3464":73062,"_30209":72778,"_20922":125124,"_5":14373,"_27447":124430,"_2948":125125},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3464":73063,"_30209":72778,"_20922":125127,"_5":14373,"_27447":124430,"_2948":125128},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3464":73064,"_30209":72778,"_20922":125130,"_5":14373,"_27447":124430,"_2948":125131},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3464":73065,"_30209":72778,"_20922":125133,"_5":14373,"_27447":124430,"_2948":125134},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3464":73066,"_30209":72778,"_20922":125136,"_5":14373,"_27447":124430,"_2948":125137},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3464":73067,"_30209":72778,"_20922":125139,"_5":14373,"_27447":124430,"_2948":125140},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3464":73068,"_30209":72778,"_20922":125142,"_5":14373,"_27447":124430,"_2948":125143},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3464":73069,"_30209":72778,"_20922":125145,"_5":14373,"_27447":124430,"_2948":125146},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3464":73070,"_30209":72778,"_20922":125148,"_5":14373,"_27447":124430,"_2948":125149},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3464":73071,"_30209":72778,"_20922":125151,"_5":14373,"_27447":124430,"_2948":125152},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3464":73072,"_30209":72778,"_20922":125154,"_5":14373,"_27447":124430,"_2948":125155},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3464":73073,"_30209":72778,"_20922":125157,"_5":14373,"_27447":124433,"_2948":125158},[],"Tras la actualización, comprueba en este orden:",{"_3464":73074,"_30209":72778,"_20922":125160,"_5":14373,"_27447":124433,"_2948":125161},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3464":73075,"_30209":72778,"_20922":125163,"_5":14373,"_27447":124433,"_2948":125164},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3464":73076,"_30209":72778,"_20922":125166,"_5":14373,"_27447":124433,"_2948":125167},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3464":73077,"_30209":72778,"_20922":125169,"_5":14373,"_27447":124433,"_2948":125170},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3464":73078,"_30209":72778,"_20922":125172,"_5":14373,"_27447":124433,"_2948":125173},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3464":73079,"_30209":72778,"_20922":125175,"_5":14373,"_27447":124433,"_2948":125176},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3464":73080,"_30209":72778,"_20922":125178,"_5":14373,"_27447":124433,"_2948":125179},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3464":73081,"_30209":72778,"_20922":125181,"_5":14373,"_27447":124433,"_2948":125182},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3464":73082,"_30209":72778,"_20922":125184,"_5":14373,"_27447":124433,"_2948":125185},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3464":73083,"_30209":72778,"_20922":125187,"_5":14373,"_27447":124433,"_2948":125188},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3464":73084,"_30209":72778,"_20922":125190,"_5":14373,"_27447":124433,"_2948":125191},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3464":73085,"_30209":72778,"_20922":125193,"_5":14373,"_27447":124433,"_2948":125194},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3464":73086,"_30209":72778,"_20922":125196,"_5":14373,"_27447":124433,"_2948":125197},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3464":73087,"_30209":72778,"_20922":125199,"_5":14373,"_27447":124433,"_2948":125200},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3464":73088,"_30209":72778,"_20922":125202,"_5":14373,"_27447":124433,"_2948":125203},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3464":73089,"_30209":72778,"_20922":125205,"_5":14373,"_27447":124437,"_2948":125206},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3464":73090,"_30209":72778,"_20922":125208,"_5":14373,"_27447":124437,"_2948":125209},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3464":73091,"_30209":72778,"_20922":125211,"_5":14373,"_27447":124437,"_2948":125212},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3464":73092,"_30209":72778,"_20922":125214,"_5":14373,"_27447":124437,"_2948":125215},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3464":73093,"_30209":72778,"_20922":125217,"_5":14373,"_27447":124437,"_2948":125218},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58422":125220,"_58424":125221,"_58426":125222,"_58428":125223,"_18133":2983,"_70159":2983},"spanish",[2948,30209,5,27447],{"_2948":25016,"_30209":25016,"_5":25016,"_27447":25016},{"_2948":125224,"_30209":128155,"_5":131086,"_27447":134017},{"_4644":125225,"_58432":125226,"_5":25016},{"_14449":10458,"_14829":4611,"_14848":7199,"_29212":3443,"_14835":5949,"_19854":8652,"_14470":6970,"_14477":13293,"_29154":20339,"_29563":14244,"_29584":6541,"_29188":7027,"_34562":12263,"_29291":20334,"_29628":9859,"_34569":22831,"_34572":4592,"_34575":7010,"_34578":14078,"_30035":3348,"_34583":16786,"_34585":7573,"_30065":5132,"_14844":15806,"_34589":7499,"_34592":6580,"_34594":7643,"_29612":23591,"_30030":4798,"_30078":12179,"_34599":6015,"_34601":3766,"_34603":6995,"_29308":6371,"_34606":5151,"_34608":4314,"_34610":7824,"_34612":7136,"_34614":28735,"_29225":4687,"_34617":4616,"_34619":5053,"_29219":8808,"_29649":5629,"_34623":16272,"_34625":11081,"_34628":5253,"_29265":6945,"_34632":4965,"_29145":9917,"_346