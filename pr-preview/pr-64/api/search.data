":49177},[],"/docs/pr-preview/pr-64/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3462":18,"_30116":15,"_5":30465,"_20912":49179,"_27402":49180,"_2946":49181},[],"/docs/pr-preview/pr-64/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3462":19,"_30116":15,"_5":30465,"_20912":49183,"_27402":49184,"_2946":49185},[],"/docs/pr-preview/pr-64/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3462":20,"_30116":15,"_5":30465,"_20912":49187,"_27402":49188,"_2946":49189},[],"/docs/pr-preview/pr-64/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3462":21,"_30116":15,"_5":30465,"_20912":49191,"_27402":49192,"_2946":49193},[],"/docs/pr-preview/pr-64/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3462":22,"_30116":15,"_5":30465,"_20912":49195,"_27402":49196,"_2946":49197},[],"/docs/pr-preview/pr-64/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3462":23,"_30116":15,"_5":30465,"_20912":49199,"_27402":49200,"_2946":49201},[],"/docs/pr-preview/pr-64/deployment/aws-marketplace#next-step","Next step",{"_3462":24,"_30116":15,"_20912":49203,"_5":14363,"_27402":15,"_2946":49204},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3462":25,"_30116":15,"_20912":49206,"_5":14363,"_27402":49176,"_2946":49207},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3462":26,"_30116":15,"_20912":49209,"_5":14363,"_27402":49176,"_2946":49210},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3462":27,"_30116":15,"_20912":49212,"_5":14363,"_27402":49176,"_2946":49213},[],"A security group allowing the necessary endpoints.",{"_3462":28,"_30116":15,"_20912":49215,"_5":14363,"_27402":49180,"_2946":49216},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3462":29,"_30116":15,"_20912":49218,"_5":14363,"_27402":49180,"_2946":49219},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3462":30,"_30116":15,"_20912":49221,"_5":14363,"_27402":49180,"_2946":49222},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3462":31,"_30116":15,"_20912":49224,"_5":14363,"_27402":49184,"_2946":49225},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3462":32,"_30116":15,"_20912":49227,"_5":14363,"_27402":49188,"_2946":49228},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3462":33,"_30116":15,"_20912":49230,"_5":14363,"_27402":49192,"_2946":49231},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3462":34,"_30116":15,"_20912":49233,"_5":14363,"_27402":49196,"_2946":49234},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3462":35,"_30116":15,"_20912":49236,"_5":14363,"_27402":49200,"_2946":49237},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3462":36,"_30116":36,"_5":14715,"_2946":49239,"_30468":49240,"_20912":49241,"_27402":36},"Deploy Lamassu",[49167,49168],[],{"_3462":37,"_30116":36,"_20912":49243,"_5":14363,"_27402":36,"_2946":49244},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3462":38,"_30116":36,"_5":30465,"_20912":49246,"_27402":49247,"_2946":49248},[],"/docs/pr-preview/pr-64/deployment/overview#choose-a-model","Choose a model",{"_3462":39,"_30116":36,"_5":30465,"_20912":49250,"_27402":49251,"_2946":49252},[],"/docs/pr-preview/pr-64/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3462":40,"_30116":36,"_5":30465,"_20912":49254,"_27402":49255,"_2946":49256},[],"/docs/pr-preview/pr-64/deployment/overview#after-deployment","After deployment",{"_3462":41,"_30116":36,"_20912":49258,"_5":14363,"_27402":36,"_2946":49259},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3462":42,"_30116":36,"_20912":49261,"_5":14363,"_27402":49247,"_2946":49262},[],"Model",{"_3462":43,"_30116":36,"_20912":49264,"_5":14363,"_27402":49247,"_2946":49265},[],"Recommended for",{"_3462":44,"_30116":36,"_20912":49267,"_5":14363,"_27402":49247,"_2946":49268},[],"Who operates the infrastructure",{"_3462":45,"_30116":36,"_20912":49270,"_5":14363,"_27402":49247,"_2946":49271},[],"Starting point",{"_3462":46,"_30116":36,"_20912":49273,"_5":14363,"_27402":49247,"_2946":49274},[],"Kubernetes self-managed",{"_3462":47,"_30116":36,"_20912":49276,"_5":14363,"_27402":49247,"_2946":49277},[],"Production, regulated environments and custom deployments",{"_3462":48,"_30116":36,"_20912":49279,"_5":14363,"_27402":49247,"_2946":49280},[],"Your team",{"_3462":49,"_30116":36,"_20912":49282,"_5":14363,"_27402":49247,"_2946":49283},[],"Helm or Fastlane",{"_3462":50,"_30116":36,"_20912":49285,"_5":14363,"_27402":49247,"_2946":49286},[],"AWS Marketplace",{"_3462":51,"_30116":36,"_20912":49288,"_5":14363,"_27402":49247,"_2946":49289},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3462":52,"_30116":36,"_20912":49291,"_5":14363,"_27402":49247,"_2946":49280},[],{"_3462":53,"_30116":36,"_20912":49293,"_5":14363,"_27402":49247,"_2946":49294},[],"Preconfigured image on EC2",{"_3462":54,"_30116":36,"_20912":49296,"_5":14363,"_27402":49247,"_2946":49297},[],"SaaS",{"_3462":55,"_30116":36,"_20912":49299,"_5":14363,"_27402":49247,"_2946":49300},[],"Teams that want to use the platform without operating it",{"_3462":56,"_30116":36,"_20912":49302,"_5":14363,"_27402":49247,"_2946":49303},[],"Lamassu",{"_3462":57,"_30116":36,"_20912":49305,"_5":14363,"_27402":49247,"_2946":49306},[],"Managed subscription",{"_3462":58,"_30116":36,"_20912":49308,"_5":14363,"_27402":49247,"_2946":49309},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3462":59,"_30116":36,"_20912":49311,"_5":14363,"_27402":49247,"_2946":49312},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3462":60,"_30116":36,"_20912":49314,"_5":14363,"_27402":49247,"_2946":49315},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3462":61,"_30116":36,"_20912":49317,"_5":14363,"_27402":49251,"_2946":49318},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3462":62,"_30116":36,"_20912":49320,"_5":14363,"_27402":49255,"_2946":49321},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3462":63,"_30116":63,"_5":14715,"_2946":49323,"_30468":49324,"_20912":49325,"_27402":63},"Use Lamassu as SaaS",[49167,49168,49169],[],{"_3462":64,"_30116":63,"_20912":49327,"_5":14363,"_27402":63,"_2946":49328},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3462":65,"_30116":63,"_5":30465,"_20912":49330,"_27402":49331,"_2946":49332},[],"/docs/pr-preview/pr-64/deployment/saas#what-the-service-manages","What the service manages",{"_3462":66,"_30116":63,"_5":30465,"_20912":49334,"_27402":49335,"_2946":49336},[],"/docs/pr-preview/pr-64/deployment/saas#plans","Plans",{"_3462":67,"_30116":63,"_5":30465,"_20912":49338,"_27402":49339,"_2946":49340},[],"/docs/pr-preview/pr-64/deployment/saas#request-access","Request access",{"_3462":68,"_30116":63,"_20912":49342,"_5":14363,"_27402":63,"_2946":49343},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3462":69,"_30116":63,"_20912":49345,"_5":14363,"_27402":49331,"_2946":49346},[],"Platform availability and maintenance.",{"_3462":70,"_30116":63,"_20912":49348,"_5":14363,"_27402":49331,"_2946":49349},[],"Automatic backups.",{"_3462":71,"_30116":63,"_20912":49351,"_5":14363,"_27402":49331,"_2946":49352},[],"Version upgrades.",{"_3462":72,"_30116":63,"_20912":49354,"_5":14363,"_27402":49331,"_2946":49355},[],"Technical support and SLA according to your plan.",{"_3462":73,"_30116":63,"_20912":49357,"_5":14363,"_27402":49335,"_2946":49358},[],"Plan",{"_3462":74,"_30116":63,"_20912":49360,"_5":14363,"_27402":49335,"_2946":49361},[],"Devices",{"_3462":75,"_30116":63,"_20912":49363,"_5":14363,"_27402":49335,"_2946":49364},[],"Support",{"_3462":76,"_30116":63,"_20912":49366,"_5":14363,"_27402":49335,"_2946":49367},[],"SLA",{"_3462":77,"_30116":63,"_20912":49369,"_5":14363,"_27402":49335,"_2946":49370},[],"Starter",{"_3462":78,"_30116":63,"_20912":49372,"_5":14363,"_27402":49335,"_2946":49373},[],"Up to 1,000",{"_3462":79,"_30116":63,"_20912":49375,"_5":14363,"_27402":49335,"_2946":49376},[],"Email",{"_3462":80,"_30116":63,"_20912":49378,"_5":14363,"_27402":49335,"_2946":49379},[],"99.5 %",{"_3462":81,"_30116":63,"_20912":49381,"_5":14363,"_27402":49335,"_2946":49382},[],"Professional",{"_3462":82,"_30116":63,"_20912":49384,"_5":14363,"_27402":49335,"_2946":49385},[],"Up to 10,000",{"_3462":83,"_30116":63,"_20912":49387,"_5":14363,"_27402":49335,"_2946":49388},[],"Email and chat",{"_3462":84,"_30116":63,"_20912":49390,"_5":14363,"_27402":49335,"_2946":49391},[],"99.9 %",{"_3462":85,"_30116":63,"_20912":49393,"_5":14363,"_27402":49335,"_2946":49394},[],"Enterprise",{"_3462":86,"_30116":63,"_20912":49396,"_5":14363,"_27402":49335,"_2946":49397},[],"Unlimited",{"_3462":87,"_30116":63,"_20912":49399,"_5":14363,"_27402":49335,"_2946":49400},[],"Dedicated",{"_3462":88,"_30116":63,"_20912":49402,"_5":14363,"_27402":49335,"_2946":49403},[],"99.99 %",{"_3462":89,"_30116":63,"_20912":49405,"_5":14363,"_27402":49339,"_2946":49406},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3462":90,"_30116":63,"_20912":49408,"_5":14363,"_27402":49339,"_2946":49409},[],"When you receive your instance's credentials, continue with Get started.",{"_3462":91,"_30116":91,"_5":14715,"_2946":49411,"_30468":49412,"_20912":49413,"_27402":91},"Fastlane",[49167,49168,49274],[],{"_3462":92,"_30116":91,"_20912":49415,"_5":14363,"_27402":91,"_2946":49416},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3462":93,"_30116":91,"_5":30465,"_20912":49418,"_27402":49419,"_2946":49420},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3462":94,"_30116":91,"_5":30465,"_20912":49422,"_27402":49423,"_2946":49424},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3462":95,"_30116":91,"_5":30465,"_20912":49426,"_27402":49427,"_2946":49177},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#before-you-begin",{"_3462":96,"_30116":91,"_5":30465,"_20912":49429,"_27402":49430,"_2946":49431},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3462":97,"_30116":91,"_5":30465,"_20912":49433,"_27402":49434,"_2946":49435},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3462":98,"_30116":91,"_5":30465,"_20912":49437,"_27402":49438,"_2946":49439},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3462":99,"_30116":91,"_5":30465,"_20912":49441,"_27402":49442,"_2946":49443},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3462":100,"_30116":91,"_5":30465,"_20912":49445,"_27402":49446,"_2946":49447},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3462":101,"_30116":91,"_5":30465,"_20912":49449,"_27402":49450,"_2946":49451},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3462":102,"_30116":91,"_5":30465,"_20912":49453,"_27402":49454,"_2946":49455},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3462":103,"_30116":91,"_5":30465,"_20912":49457,"_27402":49458,"_2946":49459},[],"/docs/pr-preview/pr-64/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3462":104,"_30116":91,"_20912":49461,"_5":14363,"_27402":49419,"_2946":49462},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3462":105,"_30116":91,"_20912":49464,"_5":14363,"_27402":49419,"_2946":49465},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3462":106,"_30116":91,"_20912":49467,"_5":14363,"_27402":49423,"_2946":49468},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3462":107,"_30116":91,"_20912":49470,"_5":14363,"_27402":49423,"_2946":49471},[],"Fastlane installs or configures",{"_3462":108,"_30116":91,"_20912":49473,"_5":14363,"_27402":49423,"_2946":49474},[],"You still provide",{"_3462":109,"_30116":91,"_20912":49476,"_5":14363,"_27402":49423,"_2946":49477},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3462":110,"_30116":91,"_20912":49479,"_5":14363,"_27402":49423,"_2946":49480},[],"The Kubernetes cluster, nodes and persistent storage",{"_3462":111,"_30116":91,"_20912":49482,"_5":14363,"_27402":49423,"_2946":49483},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3462":112,"_30116":91,"_20912":49485,"_5":14363,"_27402":49423,"_2946":49486},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3462":113,"_30116":91,"_20912":49488,"_5":14363,"_27402":49423,"_2946":49489},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3462":114,"_30116":91,"_20912":49491,"_5":14363,"_27402":49423,"_2946":49492},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3462":115,"_30116":91,"_20912":49494,"_5":14363,"_27402":49423,"_2946":49495},[],"Optional observability and lab HSM components",{"_3462":116,"_30116":91,"_20912":49497,"_5":14363,"_27402":49423,"_2946":49498},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3462":117,"_30116":91,"_20912":49500,"_5":14363,"_27402":49423,"_2946":49501},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3462":118,"_30116":91,"_20912":49503,"_5":14363,"_27402":49427,"_2946":49504},[],"You need:",{"_3462":119,"_30116":91,"_20912":49506,"_5":14363,"_27402":49427,"_2946":49507},[],"an existing Kubernetes cluster",{"_3462":120,"_30116":91,"_20912":49509,"_5":14363,"_27402":49427,"_2946":49510},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3462":121,"_30116":91,"_20912":49512,"_5":14363,"_27402":49427,"_2946":49513},[],"`yq`",{"_3462":122,"_30116":91,"_20912":49515,"_5":14363,"_27402":49427,"_2946":23638},[],{"_3462":123,"_30116":91,"_20912":49517,"_5":14363,"_27402":49427,"_2946":49518},[],"`jq` only when using `--sample-data` or `--development`",{"_3462":124,"_30116":91,"_20912":49520,"_5":14363,"_27402":49427,"_2946":49521},[],"`ssh-keygen` only when using `--with-hsm`",{"_3462":125,"_30116":91,"_20912":49523,"_5":14363,"_27402":49427,"_2946":49524},[],"free external ports 80 and 443 on a single-node K3s host",{"_3462":126,"_30116":91,"_20912":49526,"_5":14363,"_27402":49427,"_2946":49527},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3462":127,"_30116":91,"_20912":49529,"_5":14363,"_27402":49427,"_2946":49530},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3462":128,"_30116":91,"_20912":49532,"_5":14363,"_27402":49430,"_2946":49533},[],"Run the script from a clone of the Helm repository:",{"_3462":129,"_30116":91,"_20912":49535,"_5":14363,"_27402":49430,"_2946":49536},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3462":130,"_30116":91,"_20912":49538,"_5":14363,"_27402":49434,"_2946":49539},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3462":131,"_30116":91,"_20912":49541,"_5":14363,"_27402":49434,"_2946":49542},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3462":132,"_30116":91,"_20912":49544,"_5":14363,"_27402":49434,"_2946":49545},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3462":133,"_30116":91,"_20912":49547,"_5":14363,"_27402":49434,"_2946":49548},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3462":134,"_30116":91,"_20912":49550,"_5":14363,"_27402":49438,"_2946":49551},[],"Option",{"_3462":135,"_30116":91,"_20912":49553,"_5":14363,"_27402":49438,"_2946":49554},[],"Default",{"_3462":136,"_30116":91,"_20912":49556,"_5":14363,"_27402":49438,"_2946":49557},[],"Purpose",{"_3462":137,"_30116":91,"_20912":49559,"_5":14363,"_27402":49438,"_2946":49560},[],"`-h`, `--help`",{"_3462":138,"_30116":91,"_20912":49562,"_5":14363,"_27402":49438,"_2946":49563},[],"—",{"_3462":139,"_30116":91,"_20912":49565,"_5":14363,"_27402":49438,"_2946":49566},[],"Show help",{"_3462":140,"_30116":91,"_20912":49568,"_5":14363,"_27402":49438,"_2946":49569},[],"`-c`, `--context`",{"_3462":141,"_30116":91,"_20912":49571,"_5":14363,"_27402":49438,"_2946":49572},[],"current context",{"_3462":142,"_30116":91,"_20912":49574,"_5":14363,"_27402":49438,"_2946":49575},[],"Select the kubeconfig context for kubectl and Helm",{"_3462":143,"_30116":91,"_20912":49577,"_5":14363,"_27402":49438,"_2946":49578},[],"`-n`, `--non-interactive`",{"_3462":144,"_30116":91,"_20912":49580,"_5":14363,"_27402":49438,"_2946":6523},[],{"_3462":145,"_30116":91,"_20912":49582,"_5":14363,"_27402":49438,"_2946":49583},[],"Skip prompts and generate dependency credentials",{"_3462":146,"_30116":91,"_20912":49585,"_5":14363,"_27402":49438,"_2946":49586},[],"`-ns`, `--namespace`",{"_3462":147,"_30116":91,"_20912":49588,"_5":14363,"_27402":49438,"_2946":49589},[],"`lamassu-dev`",{"_3462":148,"_30116":91,"_20912":49591,"_5":14363,"_27402":49438,"_2946":49592},[],"Namespace for the installation",{"_3462":149,"_30116":91,"_20912":49594,"_5":14363,"_27402":49438,"_2946":49595},[],"`-d`, `--domain`",{"_3462":150,"_30116":91,"_20912":49597,"_5":14363,"_27402":49438,"_2946":49598},[],"`dev.lamassu.io`",{"_3462":151,"_30116":91,"_20912":49600,"_5":14363,"_27402":49438,"_2946":49601},[],"Domain used by the UI, OIDC and certificate",{"_3462":152,"_30116":91,"_20912":49603,"_5":14363,"_27402":49438,"_2946":49604},[],"`-v`, `--version`",{"_3462":153,"_30116":91,"_20912":49606,"_5":14363,"_27402":49438,"_2946":15061},[],{"_3462":154,"_30116":91,"_20912":49608,"_5":14363,"_27402":49438,"_2946":49609},[],"Lamassu chart version",{"_3462":155,"_30116":91,"_20912":49611,"_5":14363,"_27402":49438,"_2946":49612},[],"`--https-port`",{"_3462":156,"_30116":91,"_20912":49614,"_5":14363,"_27402":49438,"_2946":49615},[],"`443`",{"_3462":157,"_30116":91,"_20912":49617,"_5":14363,"_27402":49438,"_2946":49618},[],"Gateway HTTPS listener port",{"_3462":158,"_30116":91,"_20912":49620,"_5":14363,"_27402":49438,"_2946":49621},[],"`--http-port`",{"_3462":159,"_30116":91,"_20912":49623,"_5":14363,"_27402":49438,"_2946":49624},[],"`80`",{"_3462":160,"_30116":91,"_20912":49626,"_5":14363,"_27402":49438,"_2946":49627},[],"Gateway HTTP listener port",{"_3462":161,"_30116":91,"_20912":49629,"_5":14363,"_27402":49438,"_2946":49630},[],"`--tls-crt`",{"_3462":162,"_30116":91,"_20912":49632,"_5":14363,"_27402":49438,"_2946":49563},[],{"_3462":163,"_30116":91,"_20912":49634,"_5":14363,"_27402":49438,"_2946":49635},[],"PEM certificate for downstream TLS",{"_3462":164,"_30116":91,"_20912":49637,"_5":14363,"_27402":49438,"_2946":49638},[],"`--tls-key`",{"_3462":165,"_30116":91,"_20912":49640,"_5":14363,"_27402":49438,"_2946":49563},[],{"_3462":166,"_30116":91,"_20912":49642,"_5":14363,"_27402":49438,"_2946":49643},[],"PEM private key for downstream TLS",{"_3462":167,"_30116":91,"_20912":49645,"_5":14363,"_27402":49438,"_2946":49646},[],"`-l`, `--local-chart-path`",{"_3462":168,"_30116":91,"_20912":49648,"_5":14363,"_27402":49438,"_2946":49649},[],"repository chart",{"_3462":169,"_30116":91,"_20912":49651,"_5":14363,"_27402":49438,"_2946":49652},[],"Use an unpacked local Lamassu chart",{"_3462":170,"_30116":91,"_20912":49654,"_5":14363,"_27402":49438,"_2946":49655},[],"`-ip`, `--gateway-ip`",{"_3462":171,"_30116":91,"_20912":49657,"_5":14363,"_27402":49438,"_2946":8724},[],{"_3462":172,"_30116":91,"_20912":49659,"_5":14363,"_27402":49438,"_2946":49660},[],"Override the address written to `gateway.addresses`",{"_3462":173,"_30116":91,"_20912":49662,"_5":14363,"_27402":49438,"_2946":49663},[],"`--otel`",{"_3462":174,"_30116":91,"_20912":49665,"_5":14363,"_27402":49438,"_2946":6523},[],{"_3462":175,"_30116":91,"_20912":49667,"_5":14363,"_27402":49438,"_2946":49668},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3462":176,"_30116":91,"_20912":49670,"_5":14363,"_27402":49438,"_2946":49671},[],"`--development`",{"_3462":177,"_30116":91,"_20912":49673,"_5":14363,"_27402":49438,"_2946":6523},[],{"_3462":178,"_30116":91,"_20912":49675,"_5":14363,"_27402":49438,"_2946":49676},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3462":179,"_30116":91,"_20912":49678,"_5":14363,"_27402":49438,"_2946":49679},[],"`--sample-data`",{"_3462":180,"_30116":91,"_20912":49681,"_5":14363,"_27402":49438,"_2946":6523},[],{"_3462":181,"_30116":91,"_20912":49683,"_5":14363,"_27402":49438,"_2946":49684},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3462":182,"_30116":91,"_20912":49686,"_5":14363,"_27402":49438,"_2946":49687},[],"`--with-hsm`",{"_3462":183,"_30116":91,"_20912":49689,"_5":14363,"_27402":49438,"_2946":6523},[],{"_3462":184,"_30116":91,"_20912":49691,"_5":14363,"_27402":49438,"_2946":49692},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3462":185,"_30116":91,"_20912":49694,"_5":14363,"_27402":49438,"_2946":49695},[],"`--softhsm-chart-path`",{"_3462":186,"_30116":91,"_20912":49697,"_5":14363,"_27402":49438,"_2946":49698},[],"`./charts/softhsm`",{"_3462":187,"_30116":91,"_20912":49700,"_5":14363,"_27402":49438,"_2946":49701},[],"Use a different local SoftHSM chart",{"_3462":188,"_30116":91,"_20912":49703,"_5":14363,"_27402":49438,"_2946":49704},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3462":189,"_30116":91,"_20912":49706,"_5":14363,"_27402":49442,"_2946":49707},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3462":190,"_30116":91,"_20912":49709,"_5":14363,"_27402":49442,"_2946":49710},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3462":191,"_30116":91,"_20912":49712,"_5":14363,"_27402":49442,"_2946":49713},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3462":192,"_30116":91,"_20912":49715,"_5":14363,"_27402":49442,"_2946":49716},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3462":193,"_30116":91,"_20912":49718,"_5":14363,"_27402":49442,"_2946":49719},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3462":194,"_30116":91,"_20912":49721,"_5":14363,"_27402":49442,"_2946":49722},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3462":195,"_30116":91,"_20912":49724,"_5":14363,"_27402":49446,"_2946":49725},[],"Fastlane:",{"_3462":196,"_30116":91,"_20912":49727,"_5":14363,"_27402":49446,"_2946":49728},[],"validates local tools and the selected cluster",{"_3462":197,"_30116":91,"_20912":49730,"_5":14363,"_27402":49446,"_2946":49731},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3462":198,"_30116":91,"_20912":49733,"_5":14363,"_27402":49446,"_2946":49734},[],"creates the namespace",{"_3462":199,"_30116":91,"_20912":49736,"_5":14363,"_27402":49446,"_2946":49737},[],"installs PostgreSQL and creates the required databases",{"_3462":200,"_30116":91,"_20912":49739,"_5":14363,"_27402":49446,"_2946":49740},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3462":201,"_30116":91,"_20912":49742,"_5":14363,"_27402":49446,"_2946":49743},[],"installs RabbitMQ",{"_3462":202,"_30116":91,"_20912":49745,"_5":14363,"_27402":49446,"_2946":49746},[],"optionally installs observability and lab HSM components",{"_3462":203,"_30116":91,"_20912":49748,"_5":14363,"_27402":49446,"_2946":49749},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3462":204,"_30116":91,"_20912":49751,"_5":14363,"_27402":49446,"_2946":49752},[],"optionally loads sample data",{"_3462":205,"_30116":91,"_20912":49754,"_5":14363,"_27402":49446,"_2946":49755},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3462":206,"_30116":91,"_20912":49757,"_5":14363,"_27402":49450,"_2946":49758},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3462":207,"_30116":91,"_20912":49760,"_5":14363,"_27402":49450,"_2946":49761},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3462":208,"_30116":91,"_20912":49763,"_5":14363,"_27402":49454,"_2946":49764},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3462":209,"_30116":91,"_20912":49766,"_5":14363,"_27402":49454,"_2946":49767},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3462":210,"_30116":91,"_20912":49769,"_5":14363,"_27402":49454,"_2946":49770},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3462":211,"_30116":91,"_20912":49772,"_5":14363,"_27402":49458,"_2946":49773},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3462":212,"_30116":212,"_5":14715,"_2946":49775,"_30468":49776,"_20912":49777,"_27402":212},"Install with Helm",[49167,49168,49274],[],{"_3462":213,"_30116":212,"_20912":49779,"_5":14363,"_27402":212,"_2946":49780},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3462":214,"_30116":212,"_5":30465,"_20912":49782,"_27402":49783,"_2946":49784},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3462":215,"_30116":212,"_5":30465,"_20912":49786,"_27402":49787,"_2946":49177},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#before-you-begin",{"_3462":216,"_30116":212,"_5":30465,"_20912":49789,"_27402":49790,"_2946":49791},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3462":217,"_30116":212,"_5":30465,"_20912":49793,"_27402":49794,"_2946":49795},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3462":218,"_30116":212,"_5":30465,"_20912":49797,"_27402":49798,"_2946":49799},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3462":219,"_30116":212,"_5":30465,"_20912":49801,"_27402":49802,"_2946":49803},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3462":220,"_30116":212,"_5":30465,"_20912":49805,"_27402":49806,"_2946":49807},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3462":221,"_30116":212,"_5":30465,"_20912":49809,"_27402":49810,"_2946":49811},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3462":222,"_30116":212,"_5":30465,"_20912":49813,"_27402":49814,"_2946":49815},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3462":223,"_30116":212,"_5":30465,"_20912":49817,"_27402":49818,"_2946":49819},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3462":224,"_30116":212,"_5":30465,"_20912":49821,"_27402":49822,"_2946":49823},[],"/docs/pr-preview/pr-64/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3462":225,"_30116":212,"_20912":49825,"_5":14363,"_27402":49783,"_2946":49826},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3462":226,"_30116":212,"_20912":49828,"_5":14363,"_27402":49787,"_2946":49829},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3462":227,"_30116":212,"_20912":49831,"_5":14363,"_27402":49787,"_2946":49832},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3462":228,"_30116":212,"_20912":49834,"_5":14363,"_27402":49787,"_2946":49835},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3462":229,"_30116":212,"_20912":49837,"_5":14363,"_27402":49787,"_2946":49838},[],"a reachable RabbitMQ broker and credentials",{"_3462":230,"_30116":212,"_20912":49840,"_5":14363,"_27402":49787,"_2946":49841},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3462":231,"_30116":212,"_20912":49843,"_5":14363,"_27402":49787,"_2946":49844},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3462":232,"_30116":212,"_20912":49846,"_5":14363,"_27402":49787,"_2946":49847},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3462":233,"_30116":212,"_20912":49849,"_5":14363,"_27402":49787,"_2946":49850},[],"a StorageClass and an external traffic design",{"_3462":234,"_30116":212,"_20912":49852,"_5":14363,"_27402":49787,"_2946":49853},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3462":235,"_30116":212,"_20912":49855,"_5":14363,"_27402":49787,"_2946":49856},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3462":236,"_30116":212,"_20912":49858,"_5":14363,"_27402":49787,"_2946":49859},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3462":237,"_30116":212,"_20912":49861,"_5":14363,"_27402":49790,"_2946":49862},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3462":238,"_30116":212,"_20912":49864,"_5":14363,"_27402":49790,"_2946":49865},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3462":239,"_30116":212,"_20912":49867,"_5":14363,"_27402":49790,"_2946":49868},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3462":240,"_30116":212,"_20912":49870,"_5":14363,"_27402":49794,"_2946":49871},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3462":241,"_30116":212,"_20912":49873,"_5":14363,"_27402":49794,"_2946":49874},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3462":242,"_30116":212,"_20912":49876,"_5":14363,"_27402":49794,"_2946":49877},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3462":243,"_30116":212,"_20912":49879,"_5":14363,"_27402":49794,"_2946":49880},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3462":244,"_30116":212,"_20912":49882,"_5":14363,"_27402":49798,"_2946":49883},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3462":245,"_30116":212,"_20912":49885,"_5":14363,"_27402":49802,"_2946":49886},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3462":246,"_30116":212,"_20912":49888,"_5":14363,"_27402":49802,"_2946":49889},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3462":247,"_30116":212,"_20912":49891,"_5":14363,"_27402":49802,"_2946":49892},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3462":248,"_30116":212,"_20912":49894,"_5":14363,"_27402":49802,"_2946":49895},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3462":249,"_30116":212,"_20912":49897,"_5":14363,"_27402":49802,"_2946":49898},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3462":250,"_30116":212,"_20912":49900,"_5":14363,"_27402":49802,"_2946":49901},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3462":251,"_30116":212,"_20912":49903,"_5":14363,"_27402":49802,"_2946":49904},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3462":252,"_30116":212,"_20912":49906,"_5":14363,"_27402":49806,"_2946":49907},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3462":253,"_30116":212,"_20912":49909,"_5":14363,"_27402":49806,"_2946":49910},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3462":254,"_30116":212,"_20912":49912,"_5":14363,"_27402":49806,"_2946":49913},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3462":255,"_30116":212,"_20912":49915,"_5":14363,"_27402":49806,"_2946":49916},[],"See Access control for the principal and policy model.",{"_3462":256,"_30116":212,"_20912":49918,"_5":14363,"_27402":49810,"_2946":49919},[],"To install a local checkout instead:",{"_3462":257,"_30116":212,"_20912":49921,"_5":14363,"_27402":49814,"_2946":49922},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3462":258,"_30116":212,"_20912":49924,"_5":14363,"_27402":49814,"_2946":49925},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3462":259,"_30116":212,"_20912":49927,"_5":14363,"_27402":49818,"_2946":49928},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3462":260,"_30116":212,"_20912":49930,"_5":14363,"_27402":49818,"_2946":49931},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3462":261,"_30116":212,"_20912":49933,"_5":14363,"_27402":49818,"_2946":49934},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3462":262,"_30116":212,"_20912":49936,"_5":14363,"_27402":49818,"_2946":49937},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3462":263,"_30116":212,"_20912":49939,"_5":14363,"_27402":49818,"_2946":49940},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3462":264,"_30116":212,"_20912":49942,"_5":14363,"_27402":49822,"_2946":49943},[],"Before going live, review:",{"_3462":265,"_30116":212,"_20912":49945,"_5":14363,"_27402":49822,"_2946":49946},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3462":266,"_30116":212,"_20912":49948,"_5":14363,"_27402":49822,"_2946":49949},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3462":267,"_30116":212,"_20912":49951,"_5":14363,"_27402":49822,"_2946":49952},[],"shared VA storage before increasing VA replicas",{"_3462":268,"_30116":212,"_20912":49954,"_5":14363,"_27402":49822,"_2946":49955},[],"managed OIDC roles and removal of evaluation credentials",{"_3462":269,"_30116":212,"_20912":49957,"_5":14363,"_27402":49822,"_2946":49958},[],"a trusted TLS issuer or externally managed certificate",{"_3462":270,"_30116":212,"_20912":49960,"_5":14363,"_27402":49822,"_2946":49961},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3462":271,"_30116":212,"_20912":49963,"_5":14363,"_27402":49822,"_2946":49964},[],"SMTP, observability and alert delivery",{"_3462":272,"_30116":212,"_20912":49966,"_5":14363,"_27402":49822,"_2946":49967},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3462":273,"_30116":212,"_20912":49969,"_5":14363,"_27402":49822,"_2946":49970},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3462":274,"_30116":274,"_5":14715,"_2946":49972,"_30468":49973,"_20912":49974,"_27402":274},"Expose the Gateway",[49167,49168,49274],[],{"_3462":275,"_30116":274,"_20912":49976,"_5":14363,"_27402":274,"_2946":49977},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3462":276,"_30116":274,"_5":30465,"_20912":49979,"_27402":49980,"_2946":49981},[],"/docs/pr-preview/pr-64/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3462":277,"_30116":274,"_5":30465,"_20912":49983,"_27402":49984,"_2946":49985},[],"/docs/pr-preview/pr-64/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3462":278,"_30116":274,"_5":30465,"_20912":49987,"_27402":49988,"_2946":49989},[],"/docs/pr-preview/pr-64/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3462":279,"_30116":274,"_5":30465,"_20912":49991,"_27402":49992,"_2946":49993},[],"/docs/pr-preview/pr-64/deployment/self-hosted/networking#k3s","K3s",{"_3462":280,"_30116":274,"_5":30465,"_20912":49995,"_27402":49996,"_2946":49997},[],"/docs/pr-preview/pr-64/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3462":281,"_30116":274,"_5":30465,"_20912":49999,"_27402":50000,"_2946":50001},[],"/docs/pr-preview/pr-64/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3462":282,"_30116":274,"_5":30465,"_20912":50003,"_27402":50004,"_2946":50005},[],"/docs/pr-preview/pr-64/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3462":283,"_30116":274,"_5":30465,"_20912":50007,"_27402":50008,"_2946":50009},[],"/docs/pr-preview/pr-64/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3462":284,"_30116":274,"_5":30465,"_20912":50011,"_27402":50012,"_2946":50013},[],"/docs/pr-preview/pr-64/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3462":285,"_30116":274,"_5":30465,"_20912":50015,"_27402":50016,"_2946":50017},[],"/docs/pr-preview/pr-64/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3462":286,"_30116":274,"_20912":50019,"_5":14363,"_27402":49980,"_2946":50020},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3462":287,"_30116":274,"_20912":50022,"_5":14363,"_27402":49980,"_2946":50023},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3462":288,"_30116":274,"_20912":50025,"_5":14363,"_27402":49984,"_2946":50026},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3462":289,"_30116":274,"_20912":50028,"_5":14363,"_27402":49984,"_2946":50029},[],"Set it only when:",{"_3462":290,"_30116":274,"_20912":50031,"_5":14363,"_27402":49984,"_2946":50032},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3462":291,"_30116":274,"_20912":50034,"_5":14363,"_27402":49984,"_2946":50035},[],"that address is allocated to this Gateway",{"_3462":292,"_30116":274,"_20912":50037,"_5":14363,"_27402":49984,"_2946":50038},[],"the surrounding network already routes traffic for it to the cluster",{"_3462":293,"_30116":274,"_20912":50040,"_5":14363,"_27402":49984,"_2946":50041},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3462":294,"_30116":274,"_20912":50043,"_5":14363,"_27402":49984,"_2946":50044},[],"Keep these two settings separate:",{"_3462":295,"_30116":274,"_20912":50046,"_5":14363,"_27402":49984,"_2946":50047},[],"`gateway.addresses` requests an address for the Gateway.",{"_3462":296,"_30116":274,"_20912":50049,"_5":14363,"_27402":49984,"_2946":50050},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3462":297,"_30116":274,"_20912":50052,"_5":14363,"_27402":49984,"_2946":50053},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3462":298,"_30116":274,"_20912":50055,"_5":14363,"_27402":49988,"_2946":50056},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3462":299,"_30116":274,"_20912":50058,"_5":14363,"_27402":49988,"_2946":50059},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3462":300,"_30116":274,"_20912":50061,"_5":14363,"_27402":49992,"_2946":50062},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3462":301,"_30116":274,"_20912":50064,"_5":14363,"_27402":49992,"_2946":50065},[],"For the recommended design:",{"_3462":302,"_30116":274,"_20912":50067,"_5":14363,"_27402":49992,"_2946":50068},[],"Use only one externally exposed Lamassu Gateway.",{"_3462":303,"_30116":274,"_20912":50070,"_5":14363,"_27402":49992,"_2946":50071},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3462":304,"_30116":274,"_20912":50073,"_5":14363,"_27402":49992,"_2946":50074},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3462":305,"_30116":274,"_20912":50076,"_5":14363,"_27402":49992,"_2946":50077},[],"Point DNS at the VM's reachable address.",{"_3462":306,"_30116":274,"_20912":50079,"_5":14363,"_27402":49992,"_2946":50080},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3462":307,"_30116":274,"_20912":50082,"_5":14363,"_27402":49996,"_2946":50083},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3462":308,"_30116":274,"_20912":50085,"_5":14363,"_27402":50000,"_2946":50086},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3462":309,"_30116":274,"_20912":50088,"_5":14363,"_27402":50000,"_2946":50089},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3462":310,"_30116":274,"_20912":50091,"_5":14363,"_27402":50004,"_2946":50092},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3462":311,"_30116":274,"_20912":50094,"_5":14363,"_27402":50004,"_2946":50095},[],"Requirement",{"_3462":312,"_30116":274,"_20912":50097,"_5":14363,"_27402":50004,"_2946":50098},[],"Recommended design",{"_3462":313,"_30116":274,"_20912":50100,"_5":14363,"_27402":50004,"_2946":50101},[],"Consequence",{"_3462":314,"_30116":274,"_20912":50103,"_5":14363,"_27402":50004,"_2946":50104},[],"Several Lamassu URLs or services",{"_3462":315,"_30116":274,"_20912":50106,"_5":14363,"_27402":50004,"_2946":50107},[],"One Gateway with multiple routes",{"_3462":316,"_30116":274,"_20912":50109,"_5":14363,"_27402":50004,"_2946":50110},[],"One IP and one proxy fleet; this is the chart default",{"_3462":317,"_30116":274,"_20912":50112,"_5":14363,"_27402":50004,"_2946":50113},[],"Independent Gateways and separate external IPs",{"_3462":318,"_30116":274,"_20912":50115,"_5":14363,"_27402":50004,"_2946":50116},[],"One VIP per Gateway",{"_3462":319,"_30116":274,"_20912":50118,"_5":14363,"_27402":50004,"_2946":50119},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3462":320,"_30116":274,"_20912":50121,"_5":14363,"_27402":50004,"_2946":50122},[],"Independent Gateways on one node and one IP",{"_3462":321,"_30116":274,"_20912":50124,"_5":14363,"_27402":50004,"_2946":50125},[],"Use different external ports",{"_3462":322,"_30116":274,"_20912":50127,"_5":14363,"_27402":50004,"_2946":50128},[],"Clients must include non-standard ports",{"_3462":323,"_30116":274,"_20912":50130,"_5":14363,"_27402":50004,"_2946":50131},[],"Separate TLS/mTLS termination behind one IP",{"_3462":324,"_30116":274,"_20912":50133,"_5":14363,"_27402":50004,"_2946":50134},[],"Front-door SNI routing to internal Gateways",{"_3462":325,"_30116":274,"_20912":50136,"_5":14363,"_27402":50004,"_2946":50137},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3462":326,"_30116":274,"_20912":50139,"_5":14363,"_27402":50004,"_2946":50140},[],"Separate Gateway resources but shared proxy infrastructure",{"_3462":327,"_30116":274,"_20912":50142,"_5":14363,"_27402":50004,"_2946":50143},[],"Envoy merged-Gateway mode",{"_3462":328,"_30116":274,"_20912":50145,"_5":14363,"_27402":50004,"_2946":50146},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3462":329,"_30116":274,"_20912":50148,"_5":14363,"_27402":50004,"_2946":50149},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3462":330,"_30116":274,"_20912":50151,"_5":14363,"_27402":50004,"_2946":50152},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3462":331,"_30116":274,"_20912":50154,"_5":14363,"_27402":50004,"_2946":50155},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3462":332,"_30116":274,"_20912":50157,"_5":14363,"_27402":50004,"_2946":50158},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3462":333,"_30116":274,"_20912":50160,"_5":14363,"_27402":50008,"_2946":50161},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3462":334,"_30116":274,"_20912":50163,"_5":14363,"_27402":50008,"_2946":50164},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3462":335,"_30116":274,"_20912":50166,"_5":14363,"_27402":50008,"_2946":50167},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3462":336,"_30116":274,"_20912":50169,"_5":14363,"_27402":50008,"_2946":50170},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3462":337,"_30116":274,"_20912":50172,"_5":14363,"_27402":50008,"_2946":50173},[],"If none of those are possible, use different external ports or change the external network design.",{"_3462":338,"_30116":274,"_20912":50175,"_5":14363,"_27402":50012,"_2946":50176},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3462":339,"_30116":274,"_20912":50178,"_5":14363,"_27402":50012,"_2946":50179},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3462":340,"_30116":274,"_20912":50181,"_5":14363,"_27402":50016,"_2946":50182},[],"Check, in order:",{"_3462":341,"_30116":274,"_20912":50184,"_5":14363,"_27402":50016,"_2946":50185},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3462":342,"_30116":274,"_20912":50187,"_5":14363,"_27402":50016,"_2946":50188},[],"Its status contains the expected address.",{"_3462":343,"_30116":274,"_20912":50190,"_5":14363,"_27402":50016,"_2946":50191},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3462":344,"_30116":274,"_20912":50193,"_5":14363,"_27402":50016,"_2946":50194},[],"Port 443 reaches that address from the client network.",{"_3462":345,"_30116":274,"_20912":50196,"_5":14363,"_27402":50016,"_2946":50197},[],"DNS resolves to the externally reachable endpoint.",{"_3462":346,"_30116":274,"_20912":50199,"_5":14363,"_27402":50016,"_2946":50200},[],"The certificate contains the DNS name or IP used by the client.",{"_3462":347,"_30116":274,"_20912":50202,"_5":14363,"_27402":50016,"_2946":50203},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3462":348,"_30116":348,"_5":14715,"_2946":49274,"_30468":50205,"_20912":50206,"_27402":348},[49167,49168,49274],[],{"_3462":349,"_30116":348,"_20912":50208,"_5":14363,"_27402":348,"_2946":50209},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3462":350,"_30116":348,"_5":30465,"_20912":50211,"_27402":50212,"_2946":50213},[],"/docs/pr-preview/pr-64/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3462":351,"_30116":348,"_5":30465,"_20912":50215,"_27402":50216,"_2946":50217},[],"/docs/pr-preview/pr-64/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3462":352,"_30116":348,"_5":30465,"_20912":50219,"_27402":50220,"_2946":50221},[],"/docs/pr-preview/pr-64/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3462":353,"_30116":348,"_5":30465,"_20912":50223,"_27402":50224,"_2946":50225},[],"/docs/pr-preview/pr-64/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3462":354,"_30116":348,"_5":30465,"_20912":50227,"_27402":50228,"_2946":50229},[],"/docs/pr-preview/pr-64/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3462":355,"_30116":348,"_5":30465,"_20912":50231,"_27402":50232,"_2946":50233},[],"/docs/pr-preview/pr-64/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3462":356,"_30116":348,"_20912":50235,"_5":14363,"_27402":50212,"_2946":50236},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3462":357,"_30116":348,"_20912":50238,"_5":14363,"_27402":50216,"_2946":50239},[],"Workflow",{"_3462":358,"_30116":348,"_20912":50241,"_5":14363,"_27402":50216,"_2946":50242},[],"Use it for",{"_3462":359,"_30116":348,"_20912":50244,"_5":14363,"_27402":50216,"_2946":50245},[],"What it installs",{"_3462":360,"_30116":348,"_20912":50247,"_5":14363,"_27402":50216,"_2946":50248},[],"Helm",{"_3462":361,"_30116":348,"_20912":50250,"_5":14363,"_27402":50216,"_2946":50251},[],"Production and controlled environments",{"_3462":362,"_30116":348,"_20912":50253,"_5":14363,"_27402":50216,"_2946":50254},[],"Lamassu services and Gateway API resources",{"_3462":363,"_30116":348,"_20912":50256,"_5":14363,"_27402":50216,"_2946":49411},[],{"_3462":364,"_30116":348,"_20912":50258,"_5":14363,"_27402":50216,"_2946":50259},[],"Evaluation, demos, CI and small lab clusters",{"_3462":365,"_30116":348,"_20912":50261,"_5":14363,"_27402":50216,"_2946":50262},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3462":366,"_30116":348,"_20912":50264,"_5":14363,"_27402":50220,"_2946":50265},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3462":367,"_30116":348,"_20912":50267,"_5":14363,"_27402":50220,"_2946":50268},[],"Area",{"_3462":368,"_30116":348,"_20912":50270,"_5":14363,"_27402":50220,"_2946":50271},[],"The Lamassu chart provides",{"_3462":369,"_30116":348,"_20912":50273,"_5":14363,"_27402":50220,"_2946":50274},[],"You provide",{"_3462":370,"_30116":348,"_20912":50276,"_5":14363,"_27402":50220,"_2946":50277},[],"Lamassu applications",{"_3462":371,"_30116":348,"_20912":50279,"_5":14363,"_27402":50220,"_2946":50280},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3462":372,"_30116":348,"_20912":50282,"_5":14363,"_27402":50220,"_2946":50283},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3462":373,"_30116":348,"_20912":50285,"_5":14363,"_27402":50220,"_2946":50286},[],"PostgreSQL data",{"_3462":374,"_30116":348,"_20912":50288,"_5":14363,"_27402":50220,"_2946":50289},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3462":375,"_30116":348,"_20912":50291,"_5":14363,"_27402":50220,"_2946":50292},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3462":376,"_30116":348,"_20912":50294,"_5":14363,"_27402":50220,"_2946":50295},[],"Messaging",{"_3462":377,"_30116":348,"_20912":50297,"_5":14363,"_27402":50220,"_2946":50298},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3462":378,"_30116":348,"_20912":50300,"_5":14363,"_27402":50220,"_2946":50301},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3462":379,"_30116":348,"_20912":50303,"_5":14363,"_27402":50220,"_2946":50304},[],"Identity",{"_3462":380,"_30116":348,"_20912":50306,"_5":14363,"_27402":50220,"_2946":50307},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3462":381,"_30116":348,"_20912":50309,"_5":14363,"_27402":50220,"_2946":50310},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3462":382,"_30116":348,"_20912":50312,"_5":14363,"_27402":50220,"_2946":50313},[],"External routing",{"_3462":383,"_30116":348,"_20912":50315,"_5":14363,"_27402":50220,"_2946":50316},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3462":384,"_30116":348,"_20912":50318,"_5":14363,"_27402":50220,"_2946":50319},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3462":385,"_30116":348,"_20912":50321,"_5":14363,"_27402":50220,"_2946":50322},[],"TLS",{"_3462":386,"_30116":348,"_20912":50324,"_5":14363,"_27402":50220,"_2946":50325},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3462":387,"_30116":348,"_20912":50327,"_5":14363,"_27402":50220,"_2946":50328},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3462":388,"_30116":348,"_20912":50330,"_5":14363,"_27402":50220,"_2946":50331},[],"Persistent application data",{"_3462":389,"_30116":348,"_20912":50333,"_5":14363,"_27402":50220,"_2946":50334},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3462":390,"_30116":348,"_20912":50336,"_5":14363,"_27402":50220,"_2946":50337},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3462":391,"_30116":348,"_20912":50339,"_5":14363,"_27402":50220,"_2946":50340},[],"Optional integrations",{"_3462":392,"_30116":348,"_20912":50342,"_5":14363,"_27402":50220,"_2946":50343},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3462":393,"_30116":348,"_20912":50345,"_5":14363,"_27402":50220,"_2946":50346},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3462":394,"_30116":348,"_20912":50348,"_5":14363,"_27402":50220,"_2946":50349},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3462":395,"_30116":348,"_20912":50351,"_5":14363,"_27402":50220,"_2946":50352},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3462":396,"_30116":348,"_20912":50354,"_5":14363,"_27402":50224,"_2946":50355},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3462":397,"_30116":348,"_20912":50357,"_5":14363,"_27402":50224,"_2946":50358},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3462":398,"_30116":348,"_20912":50360,"_5":14363,"_27402":50228,"_2946":50361},[],"Kubernetes 1.24 or newer",{"_3462":399,"_30116":348,"_20912":50363,"_5":14363,"_27402":50228,"_2946":50364},[],"Helm 3.2 or newer",{"_3462":400,"_30116":348,"_20912":50366,"_5":14363,"_27402":50228,"_2946":50367},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3462":401,"_30116":348,"_20912":50369,"_5":14363,"_27402":50228,"_2946":50370},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3462":402,"_30116":348,"_20912":50372,"_5":14363,"_27402":50228,"_2946":50373},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3462":403,"_30116":348,"_20912":50375,"_5":14363,"_27402":50228,"_2946":50376},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3462":404,"_30116":348,"_20912":50378,"_5":14363,"_27402":50228,"_2946":50379},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3462":405,"_30116":348,"_20912":50381,"_5":14363,"_27402":50232,"_2946":50382},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3462":406,"_30116":348,"_20912":50384,"_5":14363,"_27402":50232,"_2946":50385},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3462":407,"_30116":348,"_20912":50387,"_5":14363,"_27402":50232,"_2946":50388},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3462":408,"_30116":348,"_20912":50390,"_5":14363,"_27402":50232,"_2946":50391},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3462":409,"_30116":409,"_5":14715,"_2946":50393,"_30468":50394,"_20912":50396,"_27402":409},"Deployment troubleshooting",[49167,49168,50395],"Operations",[],{"_3462":410,"_30116":409,"_20912":50398,"_5":14363,"_27402":409,"_2946":50399},[],"Diagnose access, service health and infrastructure dependencies.",{"_3462":411,"_30116":409,"_5":30465,"_20912":50401,"_27402":50402,"_2946":50403},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3462":412,"_30116":409,"_5":30465,"_20912":50405,"_27402":50406,"_2946":50407},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3462":413,"_30116":409,"_5":30465,"_20912":50409,"_27402":50410,"_2946":50411},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3462":414,"_30116":409,"_5":30465,"_20912":50413,"_27402":50414,"_2946":50415},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3462":415,"_30116":409,"_5":30465,"_20912":50417,"_27402":50418,"_2946":50419},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3462":416,"_30116":409,"_5":30465,"_20912":50421,"_27402":50422,"_2946":50423},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3462":417,"_30116":409,"_5":30465,"_20912":50425,"_27402":50426,"_2946":50427},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3462":418,"_30116":409,"_5":30465,"_20912":50429,"_27402":50430,"_2946":50431},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3462":419,"_30116":409,"_5":30465,"_20912":50433,"_27402":50434,"_2946":50435},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3462":420,"_30116":409,"_5":30465,"_20912":50437,"_27402":50438,"_2946":50439},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3462":421,"_30116":409,"_5":30465,"_20912":50441,"_27402":50442,"_2946":50443},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3462":422,"_30116":409,"_5":30465,"_20912":50445,"_27402":50446,"_2946":50447},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3462":423,"_30116":409,"_5":30465,"_20912":50449,"_27402":50450,"_2946":50451},[],"/docs/pr-preview/pr-64/deployment/troubleshooting#observability","Observability",{"_3462":424,"_30116":409,"_20912":50453,"_5":14363,"_27402":409,"_2946":50454},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3462":425,"_30116":409,"_20912":50456,"_5":14363,"_27402":50406,"_2946":50457},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3462":426,"_30116":409,"_20912":50459,"_5":14363,"_27402":50410,"_2946":50460},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3462":427,"_30116":409,"_20912":50462,"_5":14363,"_27402":50414,"_2946":50463},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3462":428,"_30116":409,"_20912":50465,"_5":14363,"_27402":50418,"_2946":50466},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3462":429,"_30116":409,"_20912":50468,"_5":14363,"_27402":50422,"_2946":50469},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3462":430,"_30116":409,"_20912":50471,"_5":14363,"_27402":50426,"_2946":50472},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3462":431,"_30116":409,"_20912":50474,"_5":14363,"_27402":50426,"_2946":50475},[],"Also run the chart's connectivity test:",{"_3462":432,"_30116":409,"_20912":50477,"_5":14363,"_27402":50426,"_2946":50478},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3462":433,"_30116":409,"_20912":50480,"_5":14363,"_27402":50426,"_2946":50481},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3462":434,"_30116":409,"_20912":50483,"_5":14363,"_27402":50430,"_2946":50484},[],"If you receive a 401:",{"_3462":435,"_30116":409,"_20912":50486,"_5":14363,"_27402":50430,"_2946":50487},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3462":436,"_30116":409,"_20912":50489,"_5":14363,"_27402":50430,"_2946":50490},[],"verify issuer, audience and expiration of the token;",{"_3462":437,"_30116":409,"_20912":50492,"_5":14363,"_27402":50430,"_2946":50493},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3462":438,"_30116":409,"_20912":50495,"_5":14363,"_27402":50430,"_2946":50496},[],"check that the provider's public and internal routes point to the same realm.",{"_3462":439,"_30116":409,"_20912":50498,"_5":14363,"_27402":50430,"_2946":50499},[],"If login succeeds but the APIs return 403:",{"_3462":440,"_30116":409,"_20912":50501,"_5":14363,"_27402":50430,"_2946":50502},[],"inspect the token's real claims;",{"_3462":441,"_30116":409,"_20912":50504,"_5":14363,"_27402":50430,"_2946":50505},[],"confirm they match an active principal;",{"_3462":442,"_30116":409,"_20912":50507,"_5":14363,"_27402":50430,"_2946":50508},[],"review the policies granted to that principal;",{"_3462":443,"_30116":409,"_20912":50510,"_5":14363,"_27402":50430,"_2946":50511},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3462":444,"_30116":409,"_20912":50513,"_5":14363,"_27402":50430,"_2946":50514},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3462":445,"_30116":409,"_20912":50516,"_5":14363,"_27402":50434,"_2946":50517},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3462":446,"_30116":409,"_20912":50519,"_5":14363,"_27402":50434,"_2946":50520},[],"Locate the authz pod and Service.",{"_3462":447,"_30116":409,"_20912":50522,"_5":14363,"_27402":50434,"_2946":50523},[],"Check /health, logs and its database connection.",{"_3462":448,"_30116":409,"_20912":50525,"_5":14363,"_27402":50434,"_2946":50526},[],"Verify the DNS and port configured in externalAuthorization.",{"_3462":449,"_30116":409,"_20912":50528,"_5":14363,"_27402":50434,"_2946":50529},[],"Check the check route is /v1/ext\\_authz/check.",{"_3462":450,"_30116":409,"_20912":50531,"_5":14363,"_27402":50434,"_2946":50532},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3462":451,"_30116":409,"_20912":50534,"_5":14363,"_27402":50438,"_2946":50535},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3462":452,"_30116":409,"_20912":50537,"_5":14363,"_27402":50442,"_2946":50538},[],"Review kubectl describe pod first. Common causes are:",{"_3462":453,"_30116":409,"_20912":50540,"_5":14363,"_27402":50442,"_2946":50541},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3462":454,"_30116":409,"_20912":50543,"_5":14363,"_27402":50442,"_2946":50544},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3462":455,"_30116":409,"_20912":50546,"_5":14363,"_27402":50442,"_2946":50547},[],"unbound persistent volume;",{"_3462":456,"_30116":409,"_20912":50549,"_5":14363,"_27402":50442,"_2946":50550},[],"inaccessible image or incorrect pull policy;",{"_3462":457,"_30116":409,"_20912":50552,"_5":14363,"_27402":50442,"_2946":50553},[],"invalid cryptographic engine configuration;",{"_3462":458,"_30116":409,"_20912":50555,"_5":14363,"_27402":50442,"_2946":50556},[],"CPU or memory limits set too low;",{"_3462":459,"_30116":409,"_20912":50558,"_5":14363,"_27402":50442,"_2946":50559},[],"an incomplete prior migration.",{"_3462":460,"_30116":409,"_20912":50561,"_5":14363,"_27402":50442,"_2946":50562},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3462":461,"_30116":409,"_20912":50564,"_5":14363,"_27402":50442,"_2946":50565},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3462":462,"_30116":409,"_20912":50567,"_5":14363,"_27402":50442,"_2946":50568},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3462":463,"_30116":409,"_20912":50570,"_5":14363,"_27402":50446,"_2946":50571},[],"Domain and audit events depend on the bus publisher:",{"_3462":464,"_30116":409,"_20912":50573,"_5":14363,"_27402":50446,"_2946":50574},[],"verify it is enabled in the emitting service;",{"_3462":465,"_30116":409,"_20912":50576,"_5":14363,"_27402":50446,"_2946":50577},[],"check AMQP connectivity and credentials;",{"_3462":466,"_30116":409,"_20912":50579,"_5":14363,"_27402":50446,"_2946":50580},[],"review exchange, routing key, queues and consumers;",{"_3462":467,"_30116":409,"_20912":50582,"_5":14363,"_27402":50446,"_2946":50583},[],"inspect dead-letter queues;",{"_3462":468,"_30116":409,"_20912":50585,"_5":14363,"_27402":50446,"_2946":50586},[],"alert on orphan durable queues and backlog growth.",{"_3462":469,"_30116":409,"_20912":50588,"_5":14363,"_27402":50446,"_2946":50589},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3462":470,"_30116":409,"_20912":50591,"_5":14363,"_27402":50446,"_2946":50592},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3462":471,"_30116":409,"_20912":50594,"_5":14363,"_27402":50446,"_2946":50595},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3462":472,"_30116":409,"_20912":50597,"_5":14363,"_27402":50446,"_2946":50598},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3462":473,"_30116":409,"_20912":50600,"_5":14363,"_27402":50446,"_2946":50601},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3462":474,"_30116":409,"_20912":50603,"_5":14363,"_27402":50446,"_2946":50604},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3462":475,"_30116":409,"_20912":50606,"_5":14363,"_27402":50446,"_2946":50607},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3462":476,"_30116":409,"_20912":50609,"_5":14363,"_27402":50450,"_2946":50610},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3462":477,"_30116":409,"_20912":50612,"_5":14363,"_27402":50450,"_2946":50613},[],"Before closing an incident, record:",{"_3462":478,"_30116":409,"_20912":50615,"_5":14363,"_27402":50450,"_2946":50616},[],"the confirmed cause;",{"_3462":479,"_30116":409,"_20912":50618,"_5":14363,"_27402":50450,"_2946":50619},[],"the time scope and affected resources;",{"_3462":480,"_30116":409,"_20912":50621,"_5":14363,"_27402":50450,"_2946":50622},[],"the commands or queries used;",{"_3462":481,"_30116":409,"_20912":50624,"_5":14363,"_27402":50450,"_2946":50625},[],"the applied change and how to revert it;",{"_3462":482,"_30116":409,"_20912":50627,"_5":14363,"_27402":50450,"_2946":50628},[],"validation from a consumer;",{"_3462":483,"_30116":409,"_20912":50630,"_5":14363,"_27402":50450,"_2946":50631},[],"the preventive action and its owner.",{"_3462":484,"_30116":484,"_5":14715,"_2946":50633,"_30468":50634,"_20912":50637,"_27402":484},"Access control",[49167,50635,50636],"Platform","Administration",[],{"_3462":485,"_30116":484,"_20912":50639,"_5":14363,"_27402":484,"_2946":50640},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3462":486,"_30116":484,"_5":30465,"_20912":50642,"_27402":50643,"_2946":50644},[],"/docs/pr-preview/pr-64/platform/administration/access-control#essential-concepts","Essential concepts",{"_3462":487,"_30116":484,"_5":30465,"_20912":50646,"_27402":50647,"_2946":50648},[],"/docs/pr-preview/pr-64/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3462":488,"_30116":484,"_5":30465,"_20912":50650,"_27402":50651,"_2946":50652},[],"/docs/pr-preview/pr-64/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3462":489,"_30116":484,"_5":30465,"_20912":50654,"_27402":50655,"_2946":50656},[],"/docs/pr-preview/pr-64/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3462":490,"_30116":484,"_5":30465,"_20912":50658,"_27402":50659,"_2946":50660},[],"/docs/pr-preview/pr-64/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3462":491,"_30116":484,"_5":30465,"_20912":50662,"_27402":50663,"_2946":50664},[],"/docs/pr-preview/pr-64/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3462":492,"_30116":484,"_5":30465,"_20912":50666,"_27402":50667,"_2946":50668},[],"/docs/pr-preview/pr-64/platform/administration/access-control#oidc-principals","OIDC principals",{"_3462":493,"_30116":484,"_5":30465,"_20912":50670,"_27402":50671,"_2946":50672},[],"/docs/pr-preview/pr-64/platform/administration/access-control#x509-principals","X.509 principals",{"_3462":494,"_30116":484,"_5":30465,"_20912":50674,"_27402":50675,"_2946":50676},[],"/docs/pr-preview/pr-64/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3462":495,"_30116":484,"_5":30465,"_20912":50678,"_27402":50679,"_2946":50680},[],"/docs/pr-preview/pr-64/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3462":496,"_30116":484,"_5":30465,"_20912":50682,"_27402":50683,"_2946":50684},[],"/docs/pr-preview/pr-64/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3462":497,"_30116":484,"_5":30465,"_20912":50686,"_27402":50687,"_2946":50688},[],"/docs/pr-preview/pr-64/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3462":498,"_30116":484,"_5":30465,"_20912":50690,"_27402":50691,"_2946":50692},[],"/docs/pr-preview/pr-64/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3462":499,"_30116":484,"_5":30465,"_20912":50694,"_27402":50695,"_2946":50696},[],"/docs/pr-preview/pr-64/platform/administration/access-control#http-rules","HTTP rules",{"_3462":500,"_30116":484,"_5":30465,"_20912":50698,"_27402":50699,"_2946":50700},[],"/docs/pr-preview/pr-64/platform/administration/access-control#included-policies","Included policies",{"_3462":501,"_30116":484,"_5":30465,"_20912":50702,"_27402":50703,"_2946":49807},[],"/docs/pr-preview/pr-64/platform/administration/access-control#provision-the-first-administrator",{"_3462":502,"_30116":484,"_5":30465,"_20912":50705,"_27402":50706,"_2946":50707},[],"/docs/pr-preview/pr-64/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3462":503,"_30116":484,"_5":30465,"_20912":50709,"_27402":50710,"_2946":50711},[],"/docs/pr-preview/pr-64/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3462":504,"_30116":484,"_5":30465,"_20912":50713,"_27402":50714,"_2946":50715},[],"/docs/pr-preview/pr-64/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3462":505,"_30116":484,"_5":30465,"_20912":50717,"_27402":50718,"_2946":50719},[],"/docs/pr-preview/pr-64/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3462":506,"_30116":484,"_5":30465,"_20912":50721,"_27402":50722,"_2946":50723},[],"/docs/pr-preview/pr-64/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3462":507,"_30116":484,"_5":30465,"_20912":50725,"_27402":50726,"_2946":50727},[],"/docs/pr-preview/pr-64/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3462":508,"_30116":484,"_5":30465,"_20912":50729,"_27402":50730,"_2946":50731},[],"/docs/pr-preview/pr-64/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3462":509,"_30116":484,"_5":30465,"_20912":50733,"_27402":50734,"_2946":50735},[],"/docs/pr-preview/pr-64/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3462":510,"_30116":484,"_5":30465,"_20912":50737,"_27402":50738,"_2946":50739},[],"/docs/pr-preview/pr-64/platform/administration/access-control#operational-checklist","Operational checklist",{"_3462":511,"_30116":484,"_5":30465,"_20912":50741,"_27402":50742,"_2946":50743},[],"/docs/pr-preview/pr-64/platform/administration/access-control#diagnostics","Diagnostics",{"_3462":512,"_30116":484,"_5":30465,"_20912":50745,"_27402":50746,"_2946":50747},[],"/docs/pr-preview/pr-64/platform/administration/access-control#the-response-is-401","The response is 401",{"_3462":513,"_30116":484,"_5":30465,"_20912":50749,"_27402":50750,"_2946":50751},[],"/docs/pr-preview/pr-64/platform/administration/access-control#the-response-is-403","The response is 403",{"_3462":514,"_30116":484,"_5":30465,"_20912":50753,"_27402":50754,"_2946":50755},[],"/docs/pr-preview/pr-64/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3462":515,"_30116":484,"_5":30465,"_20912":50757,"_27402":50758,"_2946":50759},[],"/docs/pr-preview/pr-64/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3462":516,"_30116":484,"_5":30465,"_20912":50761,"_27402":50762,"_2946":50763},[],"/docs/pr-preview/pr-64/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3462":517,"_30116":484,"_20912":50765,"_5":14363,"_27402":484,"_2946":50766},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3462":518,"_30116":484,"_20912":50768,"_5":14363,"_27402":484,"_2946":50769},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3462":519,"_30116":484,"_20912":50771,"_5":14363,"_27402":484,"_2946":50772},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3462":520,"_30116":484,"_20912":50774,"_5":14363,"_27402":50643,"_2946":50775},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3462":521,"_30116":484,"_20912":50777,"_5":14363,"_27402":50643,"_2946":50778},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3462":522,"_30116":484,"_20912":50780,"_5":14363,"_27402":50643,"_2946":50781},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3462":523,"_30116":484,"_20912":50783,"_5":14363,"_27402":50643,"_2946":50784},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3462":524,"_30116":484,"_20912":50786,"_5":14363,"_27402":50643,"_2946":50787},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3462":525,"_30116":484,"_20912":50789,"_5":14363,"_27402":50643,"_2946":50790},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3462":526,"_30116":484,"_20912":50792,"_5":14363,"_27402":50647,"_2946":50793},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3462":527,"_30116":484,"_20912":50795,"_5":14363,"_27402":50647,"_2946":50796},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3462":528,"_30116":484,"_20912":50798,"_5":14363,"_27402":50651,"_2946":50799},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3462":529,"_30116":484,"_20912":50801,"_5":14363,"_27402":50651,"_2946":50802},[],"The decision is made **before forwarding the request to the service**:",{"_3462":530,"_30116":484,"_20912":50804,"_5":14363,"_27402":50651,"_2946":50805},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3462":531,"_30116":484,"_20912":50807,"_5":14363,"_27402":50651,"_2946":50808},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3462":532,"_30116":484,"_20912":50810,"_5":14363,"_27402":50651,"_2946":50811},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3462":533,"_30116":484,"_20912":50813,"_5":14363,"_27402":50651,"_2946":50814},[],"It separately loads the policies granted to each principal.",{"_3462":534,"_30116":484,"_20912":50816,"_5":14363,"_27402":50651,"_2946":50817},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3462":535,"_30116":484,"_20912":50819,"_5":14363,"_27402":50651,"_2946":50820},[],"`authz` looks for an HTTP rule granting that action.",{"_3462":536,"_30116":484,"_20912":50822,"_5":14363,"_27402":50651,"_2946":50823},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3462":537,"_30116":484,"_20912":50825,"_5":14363,"_27402":50651,"_2946":50826},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3462":538,"_30116":484,"_20912":50828,"_5":14363,"_27402":50651,"_2946":50829},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3462":539,"_30116":484,"_20912":50831,"_5":14363,"_27402":50651,"_2946":50832},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3462":540,"_30116":484,"_20912":50834,"_5":14363,"_27402":50655,"_2946":50835},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3462":541,"_30116":484,"_20912":50837,"_5":14363,"_27402":50655,"_2946":50838},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3462":542,"_30116":484,"_20912":50840,"_5":14363,"_27402":50655,"_2946":50841},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3462":543,"_30116":484,"_20912":50843,"_5":14363,"_27402":50655,"_2946":50844},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3462":544,"_30116":484,"_20912":50846,"_5":14363,"_27402":50655,"_2946":50847},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3462":545,"_30116":484,"_20912":50849,"_5":14363,"_27402":50655,"_2946":50850},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3462":546,"_30116":484,"_20912":50852,"_5":14363,"_27402":50655,"_2946":50853},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3462":547,"_30116":484,"_20912":50855,"_5":14363,"_27402":50655,"_2946":50856},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3462":548,"_30116":484,"_20912":50858,"_5":14363,"_27402":50659,"_2946":50859},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3462":549,"_30116":484,"_20912":50861,"_5":14363,"_27402":50659,"_2946":50862},[],"The decision is made with the domain operation context:",{"_3462":550,"_30116":484,"_20912":50864,"_5":14363,"_27402":50659,"_2946":50865},[],"The middleware extracts the credential and resolves the matching principals.",{"_3462":551,"_30116":484,"_20912":50867,"_5":14363,"_27402":50659,"_2946":50868},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3462":552,"_30116":484,"_20912":50870,"_5":14363,"_27402":50659,"_2946":50871},[],"`authz` gathers the entity rules of the granted policies.",{"_3462":553,"_30116":484,"_20912":50873,"_5":14363,"_27402":50659,"_2946":50874},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3462":554,"_30116":484,"_20912":50876,"_5":14363,"_27402":50659,"_2946":50877},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3462":555,"_30116":484,"_20912":50879,"_5":14363,"_27402":50659,"_2946":50880},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3462":556,"_30116":484,"_20912":50882,"_5":14363,"_27402":50659,"_2946":50883},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3462":557,"_30116":484,"_20912":50885,"_5":14363,"_27402":50659,"_2946":50886},[],"Actions fall into two groups:",{"_3462":558,"_30116":484,"_20912":50888,"_5":14363,"_27402":50659,"_2946":50889},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3462":559,"_30116":484,"_20912":50891,"_5":14363,"_27402":50659,"_2946":50892},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3462":560,"_30116":484,"_20912":50894,"_5":14363,"_27402":50659,"_2946":50895},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3462":561,"_30116":484,"_20912":50897,"_5":14363,"_27402":50663,"_2946":50898},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3462":562,"_30116":484,"_20912":50900,"_5":14363,"_27402":50663,"_2946":50901},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3462":563,"_30116":484,"_20912":50903,"_5":14363,"_27402":50663,"_2946":50904},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3462":564,"_30116":484,"_20912":50906,"_5":14363,"_27402":50667,"_2946":50907},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3462":565,"_30116":484,"_20912":50909,"_5":14363,"_27402":50667,"_2946":50910},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3462":566,"_30116":484,"_20912":50912,"_5":14363,"_27402":50667,"_2946":50913},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3462":567,"_30116":484,"_20912":50915,"_5":14363,"_27402":50667,"_2946":50916},[],"The implemented operators are:",{"_3462":568,"_30116":484,"_20912":50918,"_5":14363,"_27402":50667,"_2946":50919},[],"`equals`, for exact equality;",{"_3462":569,"_30116":484,"_20912":50921,"_5":14363,"_27402":50667,"_2946":50922},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3462":570,"_30116":484,"_20912":50924,"_5":14363,"_27402":50667,"_2946":50925},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3462":571,"_30116":484,"_20912":50927,"_5":14363,"_27402":50667,"_2946":50928},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3462":572,"_30116":484,"_20912":50930,"_5":14363,"_27402":50671,"_2946":50931},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3462":573,"_30116":484,"_20912":50933,"_5":14363,"_27402":50671,"_2946":50934},[],"The available modes are:",{"_3462":574,"_30116":484,"_20912":50936,"_5":14363,"_27402":50671,"_2946":50937},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3462":575,"_30116":484,"_20912":50939,"_5":14363,"_27402":50671,"_2946":50940},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3462":576,"_30116":484,"_20912":50942,"_5":14363,"_27402":50671,"_2946":50943},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3462":577,"_30116":484,"_20912":50945,"_5":14363,"_27402":50671,"_2946":50946},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3462":578,"_30116":484,"_20912":50948,"_5":14363,"_27402":50671,"_2946":50949},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3462":579,"_30116":484,"_20912":50951,"_5":14363,"_27402":50671,"_2946":50952},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3462":580,"_30116":484,"_20912":50954,"_5":14363,"_27402":50675,"_2946":50955},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3462":581,"_30116":484,"_20912":50957,"_5":14363,"_27402":50675,"_2946":50958},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3462":582,"_30116":484,"_20912":50960,"_5":14363,"_27402":50675,"_2946":50961},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3462":583,"_30116":484,"_20912":50963,"_5":14363,"_27402":50675,"_2946":50964},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3462":584,"_30116":484,"_20912":50966,"_5":14363,"_27402":50683,"_2946":50967},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3462":585,"_30116":484,"_20912":50969,"_5":14363,"_27402":50683,"_2946":50970},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3462":586,"_30116":484,"_20912":50972,"_5":14363,"_27402":50687,"_2946":50973},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3462":587,"_30116":484,"_20912":50975,"_5":14363,"_27402":50687,"_2946":50976},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3462":588,"_30116":484,"_20912":50978,"_5":14363,"_27402":50691,"_2946":50979},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3462":589,"_30116":484,"_20912":50981,"_5":14363,"_27402":50691,"_2946":50982},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3462":590,"_30116":484,"_20912":50984,"_5":14363,"_27402":50691,"_2946":50985},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3462":591,"_30116":484,"_20912":50987,"_5":14363,"_27402":50695,"_2946":50988},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3462":592,"_30116":484,"_20912":50990,"_5":14363,"_27402":50695,"_2946":50991},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3462":593,"_30116":484,"_20912":50993,"_5":14363,"_27402":50695,"_2946":50994},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3462":594,"_30116":484,"_20912":50996,"_5":14363,"_27402":50695,"_2946":50997},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3462":595,"_30116":484,"_20912":50999,"_5":14363,"_27402":50695,"_2946":51000},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3462":596,"_30116":484,"_20912":51002,"_5":14363,"_27402":50695,"_2946":51003},[],"Note that:",{"_3462":597,"_30116":484,"_20912":51005,"_5":14363,"_27402":50695,"_2946":51006},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3462":598,"_30116":484,"_20912":51008,"_5":14363,"_27402":50695,"_2946":51009},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3462":599,"_30116":484,"_20912":51011,"_5":14363,"_27402":50695,"_2946":51012},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3462":600,"_30116":484,"_20912":51014,"_5":14363,"_27402":50699,"_2946":51015},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3462":601,"_30116":484,"_20912":51017,"_5":14363,"_27402":50699,"_2946":51018},[],"full and read-only access to certificates and authorities;",{"_3462":602,"_30116":484,"_20912":51020,"_5":14363,"_27402":50699,"_2946":51021},[],"full and read-only access to the KMS;",{"_3462":603,"_30116":484,"_20912":51023,"_5":14363,"_27402":50699,"_2946":51024},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3462":604,"_30116":484,"_20912":51026,"_5":14363,"_27402":50699,"_2946":51027},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3462":605,"_30116":484,"_20912":51029,"_5":14363,"_27402":50699,"_2946":51030},[],"console access;",{"_3462":606,"_30116":484,"_20912":51032,"_5":14363,"_27402":50699,"_2946":51033},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3462":607,"_30116":484,"_20912":51035,"_5":14363,"_27402":50699,"_2946":51036},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3462":608,"_30116":484,"_20912":51038,"_5":14363,"_27402":50699,"_2946":51039},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3462":609,"_30116":484,"_20912":51041,"_5":14363,"_27402":50703,"_2946":51042},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3462":610,"_30116":484,"_20912":51044,"_5":14363,"_27402":50703,"_2946":51045},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3462":611,"_30116":484,"_20912":51047,"_5":14363,"_27402":50703,"_2946":51048},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3462":612,"_30116":484,"_20912":51050,"_5":14363,"_27402":50706,"_2946":51051},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3462":613,"_30116":484,"_20912":51053,"_5":14363,"_27402":50710,"_2946":51054},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3462":614,"_30116":484,"_20912":51056,"_5":14363,"_27402":50710,"_2946":51057},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3462":615,"_30116":484,"_20912":51059,"_5":14363,"_27402":50714,"_2946":51060},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3462":616,"_30116":484,"_20912":51062,"_5":14363,"_27402":50718,"_2946":51063},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3462":617,"_30116":484,"_20912":51065,"_5":14363,"_27402":50722,"_2946":51066},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3462":618,"_30116":484,"_20912":51068,"_5":14363,"_27402":50726,"_2946":51069},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3462":619,"_30116":484,"_20912":51071,"_5":14363,"_27402":50726,"_2946":51072},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3462":620,"_30116":484,"_20912":51074,"_5":14363,"_27402":50730,"_2946":51075},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3462":621,"_30116":484,"_20912":51077,"_5":14363,"_27402":50730,"_2946":51078},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3462":622,"_30116":484,"_20912":51080,"_5":14363,"_27402":50730,"_2946":51081},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3462":623,"_30116":484,"_20912":51083,"_5":14363,"_27402":50730,"_2946":51084},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3462":624,"_30116":484,"_20912":51086,"_5":14363,"_27402":50730,"_2946":51087},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3462":625,"_30116":484,"_20912":51089,"_5":14363,"_27402":50730,"_2946":51090},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3462":626,"_30116":484,"_20912":51092,"_5":14363,"_27402":50730,"_2946":51093},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3462":627,"_30116":484,"_20912":51095,"_5":14363,"_27402":50730,"_2946":51096},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3462":628,"_30116":484,"_20912":51098,"_5":14363,"_27402":50734,"_2946":51099},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3462":629,"_30116":484,"_20912":51101,"_5":14363,"_27402":50734,"_2946":51102},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3462":630,"_30116":484,"_20912":51104,"_5":14363,"_27402":50734,"_2946":51105},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3462":631,"_30116":484,"_20912":51107,"_5":14363,"_27402":50738,"_2946":51108},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3462":632,"_30116":484,"_20912":51110,"_5":14363,"_27402":50738,"_2946":51111},[],"Use groups or stable roles for people and independent identities for automations.",{"_3462":633,"_30116":484,"_20912":51113,"_5":14363,"_27402":50738,"_2946":51114},[],"Keep at least two recovery administrators and test their access periodically.",{"_3462":634,"_30116":484,"_20912":51116,"_5":14363,"_27402":50738,"_2946":51117},[],"Review active principals, their matches and their grants after IdP changes.",{"_3462":635,"_30116":484,"_20912":51119,"_5":14363,"_27402":50738,"_2946":51120},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3462":636,"_30116":484,"_20912":51122,"_5":14363,"_27402":50738,"_2946":51123},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3462":637,"_30116":484,"_20912":51125,"_5":14363,"_27402":50738,"_2946":51126},[],"Always test one allowed and one denied operation for each role.",{"_3462":638,"_30116":484,"_20912":51128,"_5":14363,"_27402":50738,"_2946":51129},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3462":639,"_30116":484,"_20912":51131,"_5":14363,"_27402":50746,"_2946":51132},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3462":640,"_30116":484,"_20912":51134,"_5":14363,"_27402":50750,"_2946":51135},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3462":641,"_30116":484,"_20912":51137,"_5":14363,"_27402":50750,"_2946":51138},[],"that an active principal of the correct type exists;",{"_3462":642,"_30116":484,"_20912":51140,"_5":14363,"_27402":50750,"_2946":51141},[],"that the claim paths and values match the real token exactly;",{"_3462":643,"_30116":484,"_20912":51143,"_5":14363,"_27402":50750,"_2946":51144},[],"that all of the principal's conditions hold;",{"_3462":644,"_30116":484,"_20912":51146,"_5":14363,"_27402":50750,"_2946":51147},[],"that the principal has the expected policy granted;",{"_3462":645,"_30116":484,"_20912":51149,"_5":14363,"_27402":50750,"_2946":51150},[],"that the policy includes the action and the requested resource type or route;",{"_3462":646,"_30116":484,"_20912":51152,"_5":14363,"_27402":50750,"_2946":51153},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3462":647,"_30116":484,"_20912":51155,"_5":14363,"_27402":50750,"_2946":51156},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3462":648,"_30116":484,"_20912":51158,"_5":14363,"_27402":50754,"_2946":51159},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3462":649,"_30116":484,"_20912":51161,"_5":14363,"_27402":50758,"_2946":51162},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3462":650,"_30116":484,"_20912":51164,"_5":14363,"_27402":50762,"_2946":51165},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3462":651,"_30116":484,"_20912":51167,"_5":14363,"_27402":50762,"_2946":51168},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3462":652,"_30116":652,"_5":14715,"_2946":51170,"_30468":51171,"_20912":51172,"_27402":652},"Alerts and subscriptions",[49167,50635,50636],[],{"_3462":653,"_30116":652,"_20912":51174,"_5":14363,"_27402":652,"_2946":51175},[],"Send PKI events to people and external systems.",{"_3462":654,"_30116":652,"_5":30465,"_20912":51177,"_27402":51178,"_2946":51179},[],"/docs/pr-preview/pr-64/platform/administration/alerts#how-it-works","How it works",{"_3462":655,"_30116":652,"_5":30465,"_20912":51181,"_27402":51182,"_2946":51183},[],"/docs/pr-preview/pr-64/platform/administration/alerts#available-channels","Available channels",{"_3462":656,"_30116":652,"_5":30465,"_20912":51185,"_27402":51186,"_2946":51187},[],"/docs/pr-preview/pr-64/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3462":657,"_30116":652,"_5":30465,"_20912":51189,"_27402":51190,"_2946":51191},[],"/docs/pr-preview/pr-64/platform/administration/alerts#choose-the-event","Choose the event",{"_3462":658,"_30116":652,"_5":30465,"_20912":51193,"_27402":51194,"_2946":51195},[],"/docs/pr-preview/pr-64/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3462":659,"_30116":652,"_5":30465,"_20912":51197,"_27402":51198,"_2946":51199},[],"/docs/pr-preview/pr-64/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3462":660,"_30116":652,"_5":30465,"_20912":51201,"_27402":51202,"_2946":51203},[],"/docs/pr-preview/pr-64/platform/administration/alerts#review-and-activate","Review and activate",{"_3462":661,"_30116":652,"_5":30465,"_20912":51205,"_27402":51206,"_2946":51207},[],"/docs/pr-preview/pr-64/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3462":662,"_30116":652,"_5":30465,"_20912":51209,"_27402":51210,"_2946":51211},[],"/docs/pr-preview/pr-64/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3462":663,"_30116":652,"_5":30465,"_20912":51213,"_27402":51214,"_2946":51215},[],"/docs/pr-preview/pr-64/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3462":664,"_30116":652,"_5":30465,"_20912":51217,"_27402":51218,"_2946":51219},[],"/docs/pr-preview/pr-64/platform/administration/alerts#event-families","Event families",{"_3462":665,"_30116":652,"_20912":51221,"_5":14363,"_27402":652,"_2946":51222},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3462":666,"_30116":652,"_20912":51224,"_5":14363,"_27402":51178,"_2946":51225},[],"A service publishes a domain event.",{"_3462":667,"_30116":652,"_20912":51227,"_5":14363,"_27402":51178,"_2946":51228},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3462":668,"_30116":652,"_20912":51230,"_5":14363,"_27402":51178,"_2946":51231},[],"Each subscription's filter decides whether it should be notified.",{"_3462":669,"_30116":652,"_20912":51233,"_5":14363,"_27402":51178,"_2946":51234},[],"Lamassu delivers the event to the configured channel.",{"_3462":670,"_30116":652,"_20912":51236,"_5":14363,"_27402":51178,"_2946":51237},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3462":671,"_30116":652,"_20912":51239,"_5":14363,"_27402":51182,"_2946":51240},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3462":672,"_30116":652,"_20912":51242,"_5":14363,"_27402":51182,"_2946":51243},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3462":673,"_30116":652,"_20912":51245,"_5":14363,"_27402":51182,"_2946":51246},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3462":674,"_30116":652,"_20912":51248,"_5":14363,"_27402":51182,"_2946":51249},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3462":675,"_30116":652,"_20912":51251,"_5":14363,"_27402":51182,"_2946":51252},[],"`apikey_options` requires `header` and `key`.",{"_3462":676,"_30116":652,"_20912":51254,"_5":14363,"_27402":51182,"_2946":51255},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3462":677,"_30116":652,"_20912":51257,"_5":14363,"_27402":51182,"_2946":51258},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3462":678,"_30116":652,"_20912":51260,"_5":14363,"_27402":51182,"_2946":51261},[],"The alerts API reference documents the full `http_client` schema.",{"_3462":679,"_30116":652,"_20912":51263,"_5":14363,"_27402":51190,"_2946":51264},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3462":680,"_30116":652,"_20912":51266,"_5":14363,"_27402":51194,"_2946":51267},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3462":681,"_30116":652,"_20912":51269,"_5":14363,"_27402":51198,"_2946":51270},[],"Add a filter if you don't want to receive every instance of the event.",{"_3462":682,"_30116":652,"_20912":51272,"_5":14363,"_27402":51198,"_2946":51273},[],"**None** notifies all instances of the event.",{"_3462":683,"_30116":652,"_20912":51275,"_5":14363,"_27402":51198,"_2946":51276},[],"**JSON Path** evaluates one or more specific fields.",{"_3462":684,"_30116":652,"_20912":51278,"_5":14363,"_27402":51198,"_2946":51279},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3462":685,"_30116":652,"_20912":51281,"_5":14363,"_27402":51198,"_2946":51282},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3462":686,"_30116":652,"_20912":51284,"_5":14363,"_27402":51198,"_2946":51285},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3462":687,"_30116":652,"_20912":51287,"_5":14363,"_27402":51198,"_2946":51288},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3462":688,"_30116":652,"_20912":51290,"_5":14363,"_27402":51202,"_2946":51291},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3462":689,"_30116":652,"_20912":51293,"_5":14363,"_27402":51206,"_2946":51294},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3462":690,"_30116":652,"_20912":51296,"_5":14363,"_27402":51206,"_2946":51297},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3462":691,"_30116":652,"_20912":51299,"_5":14363,"_27402":51206,"_2946":51300},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3462":692,"_30116":652,"_20912":51302,"_5":14363,"_27402":51206,"_2946":51303},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3462":693,"_30116":652,"_20912":51305,"_5":14363,"_27402":51206,"_2946":51306},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3462":694,"_30116":652,"_20912":51308,"_5":14363,"_27402":51206,"_2946":51309},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3462":695,"_30116":652,"_20912":51311,"_5":14363,"_27402":51206,"_2946":51312},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3462":696,"_30116":652,"_20912":51314,"_5":14363,"_27402":51206,"_2946":51315},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3462":697,"_30116":652,"_20912":51317,"_5":14363,"_27402":51210,"_2946":51318},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3462":698,"_30116":652,"_20912":51320,"_5":14363,"_27402":51210,"_2946":51321},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3462":699,"_30116":652,"_20912":51323,"_5":14363,"_27402":51210,"_2946":51324},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3462":700,"_30116":652,"_20912":51326,"_5":14363,"_27402":51210,"_2946":51327},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3462":701,"_30116":652,"_20912":51329,"_5":14363,"_27402":51210,"_2946":51330},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3462":702,"_30116":652,"_20912":51332,"_5":14363,"_27402":51210,"_2946":51333},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3462":703,"_30116":652,"_20912":51335,"_5":14363,"_27402":51210,"_2946":51336},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3462":704,"_30116":652,"_20912":51338,"_5":14363,"_27402":51210,"_2946":51339},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3462":705,"_30116":652,"_20912":51341,"_5":14363,"_27402":51214,"_2946":51342},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3462":706,"_30116":652,"_20912":51344,"_5":14363,"_27402":51214,"_2946":51345},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3462":707,"_30116":652,"_20912":51347,"_5":14363,"_27402":51218,"_2946":51348},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3462":708,"_30116":652,"_20912":51350,"_5":14363,"_27402":51218,"_2946":51351},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3462":709,"_30116":652,"_20912":51353,"_5":14363,"_27402":51218,"_2946":51354},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3462":710,"_30116":652,"_20912":51356,"_5":14363,"_27402":51218,"_2946":51357},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3462":711,"_30116":652,"_20912":51359,"_5":14363,"_27402":51218,"_2946":51360},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3462":712,"_30116":652,"_20912":51362,"_5":14363,"_27402":51218,"_2946":51363},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3462":713,"_30116":652,"_20912":51365,"_5":14363,"_27402":51218,"_2946":51366},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3462":714,"_30116":652,"_20912":51368,"_5":14363,"_27402":51218,"_2946":51369},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3462":715,"_30116":652,"_20912":51371,"_5":14363,"_27402":51218,"_2946":51372},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3462":716,"_30116":716,"_5":14715,"_2946":51374,"_30468":51375,"_20912":51376,"_27402":716},"Audit logs",[49167,50635,50636],[],{"_3462":717,"_30116":716,"_20912":51378,"_5":14363,"_27402":716,"_2946":51379},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3462":718,"_30116":716,"_5":30465,"_20912":51381,"_27402":51382,"_2946":51383},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3462":719,"_30116":716,"_5":30465,"_20912":51385,"_27402":51386,"_2946":51387},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#coverage","Coverage",{"_3462":720,"_30116":716,"_5":30465,"_20912":51389,"_27402":51390,"_2946":51391},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3462":721,"_30116":716,"_5":30465,"_20912":51393,"_27402":51394,"_2946":51395},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3462":722,"_30116":716,"_5":30465,"_20912":51397,"_27402":51398,"_2946":51399},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3462":723,"_30116":716,"_5":30465,"_20912":51401,"_27402":51402,"_2946":51403},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3462":724,"_30116":716,"_5":30465,"_20912":51405,"_27402":51406,"_2946":51407},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3462":725,"_30116":716,"_5":30465,"_20912":51409,"_27402":51410,"_2946":51411},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3462":726,"_30116":716,"_5":30465,"_20912":51413,"_27402":51414,"_2946":51415},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3462":727,"_30116":716,"_5":30465,"_20912":51417,"_27402":51418,"_2946":51419},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3462":728,"_30116":716,"_5":30465,"_20912":51421,"_27402":51422,"_2946":51423},[],"/docs/pr-preview/pr-64/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3462":729,"_30116":716,"_20912":51425,"_5":14363,"_27402":716,"_2946":51426},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3462":730,"_30116":716,"_20912":51428,"_5":14363,"_27402":51382,"_2946":51429},[],"The audit body includes:",{"_3462":731,"_30116":716,"_20912":51431,"_5":14363,"_27402":51382,"_2946":51432},[],"input: data received by the operation;",{"_3462":732,"_30116":716,"_20912":51434,"_5":14363,"_27402":51382,"_2946":51435},[],"has\\_error: whether the service returned an error;",{"_3462":733,"_30116":716,"_20912":51437,"_5":14363,"_27402":51382,"_2946":51438},[],"output: produced result or error message;",{"_3462":734,"_30116":716,"_20912":51440,"_5":14363,"_27402":51382,"_2946":51441},[],"principals: identifiers of the principals that matched the request.",{"_3462":735,"_30116":716,"_20912":51443,"_5":14363,"_27402":51382,"_2946":51444},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3462":736,"_30116":716,"_20912":51446,"_5":14363,"_27402":51382,"_2946":51447},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3462":737,"_30116":716,"_20912":51449,"_5":14363,"_27402":51386,"_2946":51450},[],"The backend applies auditing to mutations of:",{"_3462":738,"_30116":716,"_20912":51452,"_5":14363,"_27402":51386,"_2946":51453},[],"authorities, certificates and issuance profiles;",{"_3462":739,"_30116":716,"_20912":51455,"_5":14363,"_27402":51386,"_2946":51456},[],"keys and KMS engines;",{"_3462":740,"_30116":716,"_20912":51458,"_5":14363,"_27402":51386,"_2946":51459},[],"devices and identities;",{"_3462":741,"_30116":716,"_20912":51461,"_5":14363,"_27402":51386,"_2946":51462},[],"DMSs and enrollment operations;",{"_3462":742,"_30116":716,"_20912":51464,"_5":14363,"_27402":51386,"_2946":51465},[],"validation functions and CRL;",{"_3462":743,"_30116":716,"_20912":51467,"_5":14363,"_27402":51386,"_2946":51468},[],"principals, policies and authorization grants.",{"_3462":744,"_30116":716,"_20912":51470,"_5":14363,"_27402":51386,"_2946":51471},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3462":745,"_30116":716,"_20912":51473,"_5":14363,"_27402":51390,"_2946":51474},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3462":746,"_30116":716,"_20912":51476,"_5":14363,"_27402":51390,"_2946":51477},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3462":747,"_30116":716,"_20912":51479,"_5":14363,"_27402":51390,"_2946":51480},[],"Design the consumer to:",{"_3462":748,"_30116":716,"_20912":51482,"_5":14363,"_27402":51390,"_2946":51483},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3462":749,"_30116":716,"_20912":51485,"_5":14363,"_27402":51390,"_2946":51486},[],"keep the complete CloudEvent unmodified;",{"_3462":750,"_30116":716,"_20912":51488,"_5":14363,"_27402":51390,"_2946":51489},[],"record the ingestion time and detect duplicates by ID;",{"_3462":751,"_30116":716,"_20912":51491,"_5":14363,"_27402":51390,"_2946":51492},[],"encrypt in transit and at rest;",{"_3462":752,"_30116":716,"_20912":51494,"_5":14363,"_27402":51390,"_2946":51495},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3462":753,"_30116":716,"_20912":51497,"_5":14363,"_27402":51390,"_2946":51498},[],"apply an explicit retention and legal hold policy;",{"_3462":754,"_30116":716,"_20912":51500,"_5":14363,"_27402":51390,"_2946":51501},[],"alert if it stops consuming or the pending queue grows.",{"_3462":755,"_30116":716,"_20912":51503,"_5":14363,"_27402":51394,"_2946":51504},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3462":756,"_30116":716,"_20912":51506,"_5":14363,"_27402":51394,"_2946":51507},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3462":757,"_30116":716,"_20912":51509,"_5":14363,"_27402":51402,"_2946":51510},[],"Start from the reported time and normalize every source to UTC.",{"_3462":758,"_30116":716,"_20912":51512,"_5":14363,"_27402":51406,"_2946":51513},[],"Filter by event type, service source and resource identifier.",{"_3462":759,"_30116":716,"_20912":51515,"_5":14363,"_27402":51410,"_2946":51516},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3462":760,"_30116":716,"_20912":51518,"_5":14363,"_27402":51414,"_2946":51519},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3462":761,"_30116":716,"_20912":51521,"_5":14363,"_27402":51418,"_2946":51522},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3462":762,"_30116":716,"_20912":51524,"_5":14363,"_27402":51422,"_2946":51525},[],"Generate a controlled mutation in a test environment and check that:",{"_3462":763,"_30116":716,"_20912":51527,"_5":14363,"_27402":51422,"_2946":51528},[],"a successful audit event appears;",{"_3462":764,"_30116":716,"_20912":51530,"_5":14363,"_27402":51422,"_2946":51531},[],"the principal matches the identity used;",{"_3462":765,"_30116":716,"_20912":51533,"_5":14363,"_27402":51422,"_2946":51534},[],"the consumer persists it exactly once;",{"_3462":766,"_30116":716,"_20912":51536,"_5":14363,"_27402":51422,"_2946":51537},[],"it can be retrieved by resource, actor and period;",{"_3462":767,"_30116":716,"_20912":51539,"_5":14363,"_27402":51422,"_2946":51540},[],"a consumer outage raises an alert.",{"_3462":768,"_30116":716,"_20912":51542,"_5":14363,"_27402":51422,"_2946":51543},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3462":769,"_30116":769,"_5":14715,"_2946":51545,"_30468":51546,"_20912":51547,"_27402":769},"Platform architecture",[49167,50635],[],{"_3462":770,"_30116":769,"_20912":51549,"_5":14363,"_27402":769,"_2946":51550},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3462":771,"_30116":769,"_5":30465,"_20912":51552,"_27402":51553,"_2946":51554},[],"/docs/pr-preview/pr-64/platform/concepts/architecture#control-plane","Control plane",{"_3462":772,"_30116":769,"_5":30465,"_20912":51556,"_27402":51557,"_2946":51558},[],"/docs/pr-preview/pr-64/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3462":773,"_30116":769,"_5":30465,"_20912":51560,"_27402":51561,"_2946":51562},[],"/docs/pr-preview/pr-64/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3462":774,"_30116":769,"_5":30465,"_20912":51564,"_27402":51565,"_2946":51566},[],"/docs/pr-preview/pr-64/platform/concepts/architecture#status-and-validation","Status and validation",{"_3462":775,"_30116":769,"_5":30465,"_20912":51568,"_27402":51569,"_2946":51570},[],"/docs/pr-preview/pr-64/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3462":776,"_30116":769,"_20912":51572,"_5":14363,"_27402":769,"_2946":51573},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3462":777,"_30116":769,"_20912":51575,"_5":14363,"_27402":769,"_2946":51576},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3462":778,"_30116":769,"_20912":51578,"_5":14363,"_27402":51553,"_2946":51579},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3462":779,"_30116":769,"_20912":51581,"_5":14363,"_27402":51557,"_2946":51582},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3462":780,"_30116":769,"_20912":51584,"_5":14363,"_27402":51561,"_2946":51585},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3462":781,"_30116":769,"_20912":51587,"_5":14363,"_27402":51565,"_2946":51588},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3462":782,"_30116":769,"_20912":51590,"_5":14363,"_27402":51569,"_2946":51591},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3462":783,"_30116":783,"_5":14715,"_2946":51593,"_30468":51594,"_20912":51595,"_27402":783},"How Lamassu works",[49167,50635],[],{"_3462":784,"_30116":783,"_20912":51597,"_5":14363,"_27402":783,"_2946":51598},[],"The mental model of trust, keys, certificates and devices.",{"_3462":785,"_30116":783,"_5":30465,"_20912":51600,"_27402":51601,"_2946":51602},[],"/docs/pr-preview/pr-64/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3462":786,"_30116":783,"_5":30465,"_20912":51604,"_27402":51605,"_2946":51606},[],"/docs/pr-preview/pr-64/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3462":787,"_30116":783,"_20912":51608,"_5":14363,"_27402":783,"_2946":51609},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3462":788,"_30116":783,"_20912":51611,"_5":14363,"_27402":51601,"_2946":51612},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3462":789,"_30116":783,"_20912":51614,"_5":14363,"_27402":51601,"_2946":51615},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3462":790,"_30116":783,"_20912":51617,"_5":14363,"_27402":51601,"_2946":51618},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3462":791,"_30116":783,"_20912":51620,"_5":14363,"_27402":51601,"_2946":51621},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3462":792,"_30116":783,"_20912":51623,"_5":14363,"_27402":51601,"_2946":51624},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3462":793,"_30116":783,"_20912":51626,"_5":14363,"_27402":51605,"_2946":51627},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3462":794,"_30116":783,"_20912":51629,"_5":14363,"_27402":51605,"_2946":51630},[],"A DMS relates that CA to an enrollment policy.",{"_3462":795,"_30116":783,"_20912":51632,"_5":14363,"_27402":51605,"_2946":51633},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3462":796,"_30116":783,"_20912":51635,"_5":14363,"_27402":51605,"_2946":51636},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3462":797,"_30116":783,"_20912":51638,"_5":14363,"_27402":51605,"_2946":51639},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3462":798,"_30116":783,"_20912":51641,"_5":14363,"_27402":51605,"_2946":51642},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3462":799,"_30116":783,"_20912":51644,"_5":14363,"_27402":51605,"_2946":51645},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3462":800,"_30116":800,"_5":14715,"_2946":51647,"_30468":51648,"_20912":51650,"_27402":800},"Devices and identities",[49167,50635,51649,51647],"IoT Fleets",[],{"_3462":801,"_30116":800,"_20912":51652,"_5":14363,"_27402":800,"_2946":51653},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3462":802,"_30116":800,"_5":30465,"_20912":51655,"_27402":51656,"_2946":51657},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#device-states","Device states",{"_3462":803,"_30116":800,"_5":30465,"_20912":51659,"_27402":51660,"_2946":51661},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3462":804,"_30116":800,"_5":30465,"_20912":51663,"_27402":51664,"_2946":51665},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3462":805,"_30116":800,"_5":30465,"_20912":51667,"_27402":51668,"_2946":51669},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3462":806,"_30116":800,"_5":30465,"_20912":51671,"_27402":51672,"_2946":51673},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3462":807,"_30116":800,"_5":30465,"_20912":51675,"_27402":51676,"_2946":51677},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3462":808,"_30116":800,"_5":30465,"_20912":51679,"_27402":51680,"_2946":51681},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3462":809,"_30116":800,"_5":30465,"_20912":51683,"_27402":51684,"_2946":51685},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3462":810,"_30116":800,"_5":30465,"_20912":51687,"_27402":51688,"_2946":51689},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3462":811,"_30116":800,"_5":30465,"_20912":51691,"_27402":51692,"_2946":51693},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3462":812,"_30116":800,"_5":30465,"_20912":51695,"_27402":51696,"_2946":51697},[],"/docs/pr-preview/pr-64/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3462":813,"_30116":800,"_20912":51699,"_5":14363,"_27402":800,"_2946":51700},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3462":814,"_30116":800,"_20912":51702,"_5":14363,"_27402":800,"_2946":51703},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3462":815,"_30116":800,"_20912":51705,"_5":14363,"_27402":51656,"_2946":51706},[],"Operational view",{"_3462":816,"_30116":800,"_20912":51708,"_5":14363,"_27402":51656,"_2946":51709},[],"Meaning",{"_3462":817,"_30116":800,"_20912":51711,"_5":14363,"_27402":51656,"_2946":51712},[],"**No Identity**",{"_3462":818,"_30116":800,"_20912":51714,"_5":14363,"_27402":51656,"_2946":51715},[],"A record exists without an associated identity.",{"_3462":819,"_30116":800,"_20912":51717,"_5":14363,"_27402":51656,"_2946":51718},[],"**Active**",{"_3462":820,"_30116":800,"_20912":51720,"_5":14363,"_27402":51656,"_2946":51721},[],"The slot is active; also check certificate dates, status and usages.",{"_3462":821,"_30116":800,"_20912":51723,"_5":14363,"_27402":51656,"_2946":51724},[],"**Renewal Pending**",{"_3462":822,"_30116":800,"_20912":51726,"_5":14363,"_27402":51656,"_2946":51727},[],"The identity is in the operational renewal window.",{"_3462":823,"_30116":800,"_20912":51729,"_5":14363,"_27402":51656,"_2946":51730},[],"**Expiring Soon**",{"_3462":824,"_30116":800,"_20912":51732,"_5":14363,"_27402":51656,"_2946":51733},[],"Expiration is approaching according to configured thresholds.",{"_3462":825,"_30116":800,"_20912":51735,"_5":14363,"_27402":51656,"_2946":51736},[],"**Expired**",{"_3462":826,"_30116":800,"_20912":51738,"_5":14363,"_27402":51656,"_2946":51739},[],"The identity has expired.",{"_3462":827,"_30116":800,"_20912":51741,"_5":14363,"_27402":51656,"_2946":51742},[],"**Revoked**",{"_3462":828,"_30116":800,"_20912":51744,"_5":14363,"_27402":51656,"_2946":51745},[],"The identity is marked revoked.",{"_3462":829,"_30116":800,"_20912":51747,"_5":14363,"_27402":51656,"_2946":51748},[],"**Decommissioned**",{"_3462":830,"_30116":800,"_20912":51750,"_5":14363,"_27402":51656,"_2946":51751},[],"The record is retired and ordinary updates do not restore operation.",{"_3462":831,"_30116":800,"_20912":51753,"_5":14363,"_27402":51656,"_2946":51754},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3462":832,"_30116":800,"_20912":51756,"_5":14363,"_27402":51660,"_2946":51757},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3462":833,"_30116":800,"_20912":51759,"_5":14363,"_27402":51660,"_2946":51760},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3462":834,"_30116":800,"_20912":51762,"_5":14363,"_27402":51660,"_2946":51763},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3462":835,"_30116":800,"_20912":51765,"_5":14363,"_27402":51660,"_2946":51766},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3462":836,"_30116":800,"_20912":51768,"_5":14363,"_27402":51664,"_2946":51769},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3462":837,"_30116":800,"_20912":51771,"_5":14363,"_27402":51668,"_2946":51772},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3462":838,"_30116":800,"_20912":51774,"_5":14363,"_27402":51672,"_2946":51775},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3462":839,"_30116":800,"_20912":51777,"_5":14363,"_27402":51676,"_2946":51778},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3462":840,"_30116":800,"_20912":51780,"_5":14363,"_27402":51680,"_2946":51781},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3462":841,"_30116":800,"_20912":51783,"_5":14363,"_27402":51680,"_2946":51784},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3462":842,"_30116":800,"_20912":51786,"_5":14363,"_27402":51684,"_2946":51787},[],"From **No Identity**, use **Assign Identity**:",{"_3462":843,"_30116":800,"_20912":51789,"_5":14363,"_27402":51684,"_2946":51790},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3462":844,"_30116":800,"_20912":51792,"_5":14363,"_27402":51684,"_2946":51793},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3462":845,"_30116":800,"_20912":51795,"_5":14363,"_27402":51684,"_2946":51796},[],"Confirm and read the serial, active version and history again.",{"_3462":846,"_30116":800,"_20912":51798,"_5":14363,"_27402":51684,"_2946":51799},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3462":847,"_30116":800,"_20912":51801,"_5":14363,"_27402":51684,"_2946":51802},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3462":848,"_30116":800,"_20912":51804,"_5":14363,"_27402":51688,"_2946":51805},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3462":849,"_30116":800,"_20912":51807,"_5":14363,"_27402":51688,"_2946":51808},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3462":850,"_30116":800,"_20912":51810,"_5":14363,"_27402":51692,"_2946":51811},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3462":851,"_30116":800,"_20912":51813,"_5":14363,"_27402":51692,"_2946":51814},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3462":852,"_30116":800,"_20912":51816,"_5":14363,"_27402":51692,"_2946":51817},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3462":853,"_30116":800,"_20912":51819,"_5":14363,"_27402":51692,"_2946":51820},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3462":854,"_30116":800,"_20912":51822,"_5":14363,"_27402":51696,"_2946":51823},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3462":855,"_30116":800,"_20912":51825,"_5":14363,"_27402":51696,"_2946":51826},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3462":856,"_30116":856,"_5":14715,"_2946":51828,"_30468":51829,"_20912":51831,"_27402":856},"Bootstrap identity and authentication",[49167,50635,51649,51647,51830],"Enrollment with PKI",[],{"_3462":857,"_30116":856,"_20912":51833,"_5":14363,"_27402":856,"_2946":51834},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3462":858,"_30116":856,"_5":30465,"_20912":51836,"_27402":51837,"_2946":51838},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3462":859,"_30116":856,"_5":30465,"_20912":51840,"_27402":51841,"_2946":51842},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3462":860,"_30116":856,"_5":30465,"_20912":51844,"_27402":51845,"_2946":51846},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3462":861,"_30116":856,"_5":30465,"_20912":51848,"_27402":51849,"_2946":51850},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3462":862,"_30116":856,"_5":30465,"_20912":51852,"_27402":51853,"_2946":51854},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3462":863,"_30116":856,"_20912":51856,"_5":14363,"_27402":856,"_2946":51857},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3462":864,"_30116":856,"_20912":51859,"_5":14363,"_27402":51837,"_2946":51860},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3462":865,"_30116":856,"_20912":51862,"_5":14363,"_27402":51837,"_2946":51863},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3462":866,"_30116":856,"_20912":51865,"_5":14363,"_27402":51841,"_2946":51866},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3462":867,"_30116":856,"_20912":51868,"_5":14363,"_27402":51841,"_2946":51869},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3462":868,"_30116":856,"_20912":51871,"_5":14363,"_27402":51841,"_2946":51872},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3462":869,"_30116":856,"_20912":51874,"_5":14363,"_27402":51845,"_2946":51875},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3462":870,"_30116":856,"_20912":51877,"_5":14363,"_27402":51845,"_2946":51878},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3462":871,"_30116":856,"_20912":51880,"_5":14363,"_27402":51849,"_2946":51881},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3462":872,"_30116":856,"_20912":51883,"_5":14363,"_27402":51849,"_2946":51884},[],"Example body:",{"_3462":873,"_30116":856,"_20912":51886,"_5":14363,"_27402":51849,"_2946":51887},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3462":874,"_30116":856,"_20912":51889,"_5":14363,"_27402":51849,"_2946":51890},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3462":875,"_30116":856,"_20912":51892,"_5":14363,"_27402":51849,"_2946":51893},[],"Continuation requires a successful HTTP response and JSON:",{"_3462":876,"_30116":856,"_20912":51895,"_5":14363,"_27402":51849,"_2946":51896},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3462":877,"_30116":856,"_20912":51898,"_5":14363,"_27402":51853,"_2946":51899},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3462":878,"_30116":856,"_20912":51901,"_5":14363,"_27402":51853,"_2946":51902},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3462":879,"_30116":879,"_5":14715,"_2946":51904,"_30468":51905,"_20912":51906,"_27402":879},"Configure and operate the DMS",[49167,50635,51649,51647,51830],[],{"_3462":880,"_30116":879,"_20912":51908,"_5":14363,"_27402":879,"_2946":51909},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3462":881,"_30116":879,"_5":30465,"_20912":51911,"_27402":51912,"_2946":49177},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3462":882,"_30116":879,"_5":30465,"_20912":51914,"_27402":51915,"_2946":51916},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3462":883,"_30116":879,"_5":30465,"_20912":51918,"_27402":51919,"_2946":51920},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3462":884,"_30116":879,"_5":30465,"_20912":51922,"_27402":51923,"_2946":51924},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3462":885,"_30116":879,"_5":30465,"_20912":51926,"_27402":51927,"_2946":51928},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3462":886,"_30116":879,"_5":30465,"_20912":51930,"_27402":51931,"_2946":51932},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3462":887,"_30116":879,"_5":30465,"_20912":51934,"_27402":51935,"_2946":51936},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3462":888,"_30116":879,"_5":30465,"_20912":51938,"_27402":51939,"_2946":51940},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3462":889,"_30116":879,"_5":30465,"_20912":51942,"_27402":51943,"_2946":51944},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3462":890,"_30116":879,"_5":30465,"_20912":51946,"_27402":51947,"_2946":51948},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3462":891,"_30116":879,"_5":30465,"_20912":51950,"_27402":51951,"_2946":51952},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3462":892,"_30116":879,"_5":30465,"_20912":51954,"_27402":51955,"_2946":51956},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3462":893,"_30116":879,"_5":30465,"_20912":51958,"_27402":51959,"_2946":51960},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3462":894,"_30116":879,"_5":30465,"_20912":51962,"_27402":51963,"_2946":51964},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3462":895,"_30116":879,"_5":30465,"_20912":51966,"_27402":51967,"_2946":51968},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3462":896,"_30116":879,"_5":30465,"_20912":51970,"_27402":51971,"_2946":51972},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3462":897,"_30116":879,"_5":30465,"_20912":51974,"_27402":51975,"_2946":51976},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3462":898,"_30116":879,"_5":30465,"_20912":51978,"_27402":51979,"_2946":51980},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3462":899,"_30116":879,"_20912":51982,"_5":14363,"_27402":879,"_2946":51983},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3462":900,"_30116":879,"_20912":51985,"_5":14363,"_27402":51912,"_2946":51986},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3462":901,"_30116":879,"_20912":51988,"_5":14363,"_27402":51912,"_2946":51989},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3462":902,"_30116":879,"_20912":51991,"_5":14363,"_27402":51919,"_2946":51992},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3462":903,"_30116":879,"_20912":51994,"_5":14363,"_27402":51923,"_2946":51995},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3462":904,"_30116":879,"_20912":51997,"_5":14363,"_27402":51927,"_2946":51998},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3462":905,"_30116":879,"_20912":52000,"_5":14363,"_27402":51931,"_2946":52001},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3462":906,"_30116":879,"_20912":52003,"_5":14363,"_27402":51935,"_2946":52004},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3462":907,"_30116":879,"_20912":52006,"_5":14363,"_27402":51943,"_2946":52007},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3462":908,"_30116":879,"_20912":52009,"_5":14363,"_27402":51943,"_2946":52010},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3462":909,"_30116":879,"_20912":52012,"_5":14363,"_27402":51947,"_2946":52013},[],"`settings.enrollment_settings` field",{"_3462":910,"_30116":879,"_20912":52015,"_5":14363,"_27402":51947,"_2946":52016},[],"Decision",{"_3462":911,"_30116":879,"_20912":52018,"_5":14363,"_27402":51947,"_2946":52019},[],"`protocol`",{"_3462":912,"_30116":879,"_20912":52021,"_5":14363,"_27402":51947,"_2946":52022},[],"`EST_RFC7030` for these operations.",{"_3462":913,"_30116":879,"_20912":52024,"_5":14363,"_27402":51947,"_2946":52025},[],"`enrollment_ca`",{"_3462":914,"_30116":879,"_20912":52027,"_5":14363,"_27402":51947,"_2946":52028},[],"ID of the signing CA.",{"_3462":915,"_30116":879,"_20912":52030,"_5":14363,"_27402":51947,"_2946":52031},[],"`verify_csr_signature`",{"_3462":916,"_30116":879,"_20912":52033,"_5":14363,"_27402":51947,"_2946":52034},[],"Keep `true` to verify CSR key possession.",{"_3462":917,"_30116":879,"_20912":52036,"_5":14363,"_27402":51947,"_2946":52037},[],"`enable_replaceable_enrollment`",{"_3462":918,"_30116":879,"_20912":52039,"_5":14363,"_27402":51947,"_2946":52040},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3462":919,"_30116":879,"_20912":52042,"_5":14363,"_27402":51947,"_2946":52043},[],"`est_rfc7030_settings.auth_mode`",{"_3462":920,"_30116":879,"_20912":52045,"_5":14363,"_27402":51947,"_2946":52046},[],"One of the four authentication modes.",{"_3462":921,"_30116":879,"_20912":52048,"_5":14363,"_27402":51947,"_2946":52049},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3462":922,"_30116":879,"_20912":52051,"_5":14363,"_27402":51951,"_2946":52052},[],"The blocks are independent:",{"_3462":923,"_30116":879,"_20912":52054,"_5":14363,"_27402":51951,"_2946":52055},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3462":924,"_30116":879,"_20912":52057,"_5":14363,"_27402":51951,"_2946":52058},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3462":925,"_30116":879,"_20912":52060,"_5":14363,"_27402":51951,"_2946":52061},[],"`auth_mode`",{"_3462":926,"_30116":879,"_20912":52063,"_5":14363,"_27402":51951,"_2946":52064},[],"Control applied in the configured operation",{"_3462":927,"_30116":879,"_20912":52066,"_5":14363,"_27402":51951,"_2946":52067},[],"`CLIENT_CERTIFICATE`",{"_3462":928,"_30116":879,"_20912":52069,"_5":14363,"_27402":51951,"_2946":52070},[],"Presented certificate validation.",{"_3462":929,"_30116":879,"_20912":52072,"_5":14363,"_27402":51951,"_2946":52073},[],"`EXTERNAL_WEBHOOK`",{"_3462":930,"_30116":879,"_20912":52075,"_5":14363,"_27402":51951,"_2946":52076},[],"Configured webhook authorization.",{"_3462":931,"_30116":879,"_20912":52078,"_5":14363,"_27402":51951,"_2946":52079},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3462":932,"_30116":879,"_20912":52081,"_5":14363,"_27402":51951,"_2946":52082},[],"Certificate validation followed by webhook approval.",{"_3462":933,"_30116":879,"_20912":52084,"_5":14363,"_27402":51951,"_2946":52085},[],"`NO_AUTH`",{"_3462":934,"_30116":879,"_20912":52087,"_5":14363,"_27402":51951,"_2946":52088},[],"No DMS requester authentication.",{"_3462":935,"_30116":879,"_20912":52090,"_5":14363,"_27402":51951,"_2946":52091},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3462":936,"_30116":879,"_20912":52093,"_5":14363,"_27402":51951,"_2946":52094},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3462":937,"_30116":879,"_20912":52096,"_5":14363,"_27402":51951,"_2946":52097},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3462":938,"_30116":879,"_20912":52099,"_5":14363,"_27402":51951,"_2946":52100},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3462":939,"_30116":879,"_20912":52102,"_5":14363,"_27402":51955,"_2946":52103},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3462":940,"_30116":879,"_20912":52105,"_5":14363,"_27402":51955,"_2946":52106},[],"`external_webhook_settings` field",{"_3462":941,"_30116":879,"_20912":52108,"_5":14363,"_27402":51955,"_2946":52016},[],{"_3462":942,"_30116":879,"_20912":52110,"_5":14363,"_27402":51955,"_2946":52111},[],"`url`",{"_3462":943,"_30116":879,"_20912":52113,"_5":14363,"_27402":51955,"_2946":52114},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3462":944,"_30116":879,"_20912":52116,"_5":14363,"_27402":51955,"_2946":52117},[],"`method`",{"_3462":945,"_30116":879,"_20912":52119,"_5":14363,"_27402":51955,"_2946":52120},[],"`POST` or `PUT`; `POST` by default.",{"_3462":946,"_30116":879,"_20912":52122,"_5":14363,"_27402":51955,"_2946":52123},[],"`name`",{"_3462":947,"_30116":879,"_20912":52125,"_5":14363,"_27402":51955,"_2946":52126},[],"Label used in service logs.",{"_3462":948,"_30116":879,"_20912":52128,"_5":14363,"_27402":51955,"_2946":52129},[],"`config.auth_mode`",{"_3462":949,"_30116":879,"_20912":52131,"_5":14363,"_27402":51955,"_2946":52132},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3462":950,"_30116":879,"_20912":52134,"_5":14363,"_27402":51955,"_2946":52135},[],"`config.log_level`",{"_3462":951,"_30116":879,"_20912":52137,"_5":14363,"_27402":51955,"_2946":52138},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3462":952,"_30116":879,"_20912":52140,"_5":14363,"_27402":51955,"_2946":52141},[],"`config.apikey_options`",{"_3462":953,"_30116":879,"_20912":52143,"_5":14363,"_27402":51955,"_2946":52144},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3462":954,"_30116":879,"_20912":52146,"_5":14363,"_27402":51955,"_2946":52147},[],"`config.jwt_options`",{"_3462":955,"_30116":879,"_20912":52149,"_5":14363,"_27402":51955,"_2946":52150},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3462":956,"_30116":879,"_20912":52152,"_5":14363,"_27402":51955,"_2946":52153},[],"`config.mtls_options`",{"_3462":957,"_30116":879,"_20912":52155,"_5":14363,"_27402":51955,"_2946":52156},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3462":958,"_30116":879,"_20912":52158,"_5":14363,"_27402":51955,"_2946":52159},[],"`config.insecure_skip_verify`",{"_3462":959,"_30116":879,"_20912":52161,"_5":14363,"_27402":51955,"_2946":52162},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3462":960,"_30116":879,"_20912":52164,"_5":14363,"_27402":51955,"_2946":52165},[],"`config.call_timeout`",{"_3462":961,"_30116":879,"_20912":52167,"_5":14363,"_27402":51955,"_2946":52168},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3462":962,"_30116":879,"_20912":52170,"_5":14363,"_27402":51955,"_2946":52171},[],"Rules for that configuration:",{"_3462":963,"_30116":879,"_20912":52173,"_5":14363,"_27402":51955,"_2946":52174},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3462":964,"_30116":879,"_20912":52176,"_5":14363,"_27402":51955,"_2946":52177},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3462":965,"_30116":879,"_20912":52179,"_5":14363,"_27402":51955,"_2946":52180},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3462":966,"_30116":879,"_20912":52182,"_5":14363,"_27402":51955,"_2946":52183},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3462":967,"_30116":879,"_20912":52185,"_5":14363,"_27402":51955,"_2946":52186},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3462":968,"_30116":879,"_20912":52188,"_5":14363,"_27402":51955,"_2946":52189},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3462":969,"_30116":879,"_20912":52191,"_5":14363,"_27402":51955,"_2946":52192},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3462":970,"_30116":879,"_20912":52194,"_5":14363,"_27402":51955,"_2946":52195},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3462":971,"_30116":879,"_20912":52197,"_5":14363,"_27402":51955,"_2946":52198},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3462":972,"_30116":879,"_20912":52200,"_5":14363,"_27402":51959,"_2946":52201},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3462":973,"_30116":879,"_20912":52203,"_5":14363,"_27402":51963,"_2946":52204},[],"`settings.reenrollment_settings` field",{"_3462":974,"_30116":879,"_20912":52206,"_5":14363,"_27402":51963,"_2946":49557},[],{"_3462":975,"_30116":879,"_20912":52208,"_5":14363,"_27402":51963,"_2946":52209},[],"`reenrollment_delta`",{"_3462":976,"_30116":879,"_20912":52211,"_5":14363,"_27402":51963,"_2946":52212},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3462":977,"_30116":879,"_20912":52214,"_5":14363,"_27402":51963,"_2946":52215},[],"`preventive_delta`",{"_3462":978,"_30116":879,"_20912":52217,"_5":14363,"_27402":51963,"_2946":52218},[],"Preventive operational monitoring threshold.",{"_3462":979,"_30116":879,"_20912":52220,"_5":14363,"_27402":51963,"_2946":52221},[],"`critical_delta`",{"_3462":980,"_30116":879,"_20912":52223,"_5":14363,"_27402":51963,"_2946":52224},[],"Critical operational monitoring threshold.",{"_3462":981,"_30116":879,"_20912":52226,"_5":14363,"_27402":51963,"_2946":52227},[],"`enable_expired_renewal`",{"_3462":982,"_30116":879,"_20912":52229,"_5":14363,"_27402":51963,"_2946":52230},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3462":983,"_30116":879,"_20912":52232,"_5":14363,"_27402":51963,"_2946":52233},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3462":984,"_30116":879,"_20912":52235,"_5":14363,"_27402":51963,"_2946":52236},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3462":985,"_30116":879,"_20912":52238,"_5":14363,"_27402":51963,"_2946":52239},[],"`revoke_on_reenrollment`",{"_3462":986,"_30116":879,"_20912":52241,"_5":14363,"_27402":51963,"_2946":52242},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3462":987,"_30116":879,"_20912":52244,"_5":14363,"_27402":51963,"_2946":52245},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3462":988,"_30116":879,"_20912":52247,"_5":14363,"_27402":51967,"_2946":52248},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3462":989,"_30116":879,"_20912":52250,"_5":14363,"_27402":51971,"_2946":49551},[],{"_3462":990,"_30116":879,"_20912":52252,"_5":14363,"_27402":51971,"_2946":52253},[],"Published material",{"_3462":991,"_30116":879,"_20912":52255,"_5":14363,"_27402":51971,"_2946":52256},[],"**Include Lamassu System CA**",{"_3462":992,"_30116":879,"_20912":52258,"_5":14363,"_27402":51971,"_2946":52259},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3462":993,"_30116":879,"_20912":52261,"_5":14363,"_27402":51971,"_2946":52262},[],"**Include Enrollment CA**",{"_3462":994,"_30116":879,"_20912":52264,"_5":14363,"_27402":51971,"_2946":52265},[],"Selected issuing CA certificate.",{"_3462":995,"_30116":879,"_20912":52267,"_5":14363,"_27402":51971,"_2946":52268},[],"**Managed CAs**",{"_3462":996,"_30116":879,"_20912":52270,"_5":14363,"_27402":51971,"_2946":52271},[],"Explicitly selected CA certificates.",{"_3462":997,"_30116":879,"_20912":52273,"_5":14363,"_27402":51971,"_2946":52274},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3462":998,"_30116":879,"_20912":52276,"_5":14363,"_27402":51975,"_2946":52277},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3462":999,"_30116":879,"_20912":52279,"_5":14363,"_27402":51975,"_2946":52280},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3462":1000,"_30116":879,"_20912":52282,"_5":14363,"_27402":51975,"_2946":52283},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3462":1001,"_30116":879,"_20912":52285,"_5":14363,"_27402":51979,"_2946":52286},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3462":1002,"_30116":1002,"_5":14715,"_2946":52288,"_30468":52289,"_20912":52290,"_27402":1002},"Integrate the EST client",[49167,50635,51649,51647,51830],[],{"_3462":1003,"_30116":1002,"_20912":52292,"_5":14363,"_27402":1002,"_2946":52293},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3462":1004,"_30116":1002,"_5":30465,"_20912":52295,"_27402":52296,"_2946":49177},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3462":1005,"_30116":1002,"_5":30465,"_20912":52298,"_27402":52299,"_2946":52300},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3462":1006,"_30116":1002,"_5":30465,"_20912":52302,"_27402":52303,"_2946":52304},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3462":1007,"_30116":1002,"_5":30465,"_20912":52306,"_27402":52307,"_2946":52308},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3462":1008,"_30116":1002,"_5":30465,"_20912":52310,"_27402":52311,"_2946":52312},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3462":1009,"_30116":1002,"_5":30465,"_20912":52314,"_27402":52315,"_2946":52316},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3462":1010,"_30116":1002,"_20912":52318,"_5":14363,"_27402":1002,"_2946":52319},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3462":1011,"_30116":1002,"_20912":52321,"_5":14363,"_27402":52296,"_2946":52322},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3462":1012,"_30116":1002,"_20912":52324,"_5":14363,"_27402":52296,"_2946":52325},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3462":1013,"_30116":1002,"_20912":52327,"_5":14363,"_27402":52296,"_2946":52328},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3462":1014,"_30116":1002,"_20912":52330,"_5":14363,"_27402":52299,"_2946":52331},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3462":1015,"_30116":1002,"_20912":52333,"_5":14363,"_27402":52299,"_2946":52334},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3462":1016,"_30116":1002,"_20912":52336,"_5":14363,"_27402":52303,"_2946":52337},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3462":1017,"_30116":1002,"_20912":52339,"_5":14363,"_27402":52303,"_2946":52340},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3462":1018,"_30116":1002,"_20912":52342,"_5":14363,"_27402":52307,"_2946":52343},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3462":1019,"_30116":1002,"_20912":52345,"_5":14363,"_27402":52307,"_2946":52346},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3462":1020,"_30116":1002,"_20912":52348,"_5":14363,"_27402":52311,"_2946":52349},[],"For a root that issues directly:",{"_3462":1021,"_30116":1002,"_20912":52351,"_5":14363,"_27402":52311,"_2946":52352},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3462":1022,"_30116":1002,"_20912":52354,"_5":14363,"_27402":52311,"_2946":52355},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3462":1023,"_30116":1002,"_20912":52357,"_5":14363,"_27402":52315,"_2946":52358},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3462":1024,"_30116":1024,"_5":14715,"_2946":52360,"_30468":52361,"_20912":52362,"_27402":1024},"EST reference",[49167,50635,51649,51647,51830],[],{"_3462":1025,"_30116":1024,"_20912":52364,"_5":14363,"_27402":1024,"_2946":52365},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3462":1026,"_30116":1024,"_5":30465,"_20912":52367,"_27402":52368,"_2946":52369},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3462":1027,"_30116":1024,"_5":30465,"_20912":52371,"_27402":52372,"_2946":22668},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3462":1028,"_30116":1024,"_5":30465,"_20912":52374,"_27402":52375,"_2946":26017},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3462":1029,"_30116":1024,"_5":30465,"_20912":52377,"_27402":52378,"_2946":26024},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3462":1030,"_30116":1024,"_5":30465,"_20912":52380,"_27402":52381,"_2946":25343},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3462":1031,"_30116":1024,"_5":30465,"_20912":52383,"_27402":52384,"_2946":52385},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3462":1032,"_30116":1024,"_5":30465,"_20912":52387,"_27402":52388,"_2946":52389},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3462":1033,"_30116":1024,"_5":30465,"_20912":52391,"_27402":52392,"_2946":52393},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3462":1034,"_30116":1024,"_20912":52395,"_5":14363,"_27402":1024,"_2946":52396},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3462":1035,"_30116":1024,"_20912":52398,"_5":14363,"_27402":52368,"_2946":52399},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3462":1036,"_30116":1024,"_20912":52401,"_5":14363,"_27402":52368,"_2946":52402},[],"Operation",{"_3462":1037,"_30116":1024,"_20912":52404,"_5":14363,"_27402":52368,"_2946":52405},[],"Method",{"_3462":1038,"_30116":1024,"_20912":52407,"_5":14363,"_27402":52368,"_2946":52408},[],"Authentication and condition",{"_3462":1039,"_30116":1024,"_20912":52410,"_5":14363,"_27402":52368,"_2946":52411},[],"`/cacerts`",{"_3462":1040,"_30116":1024,"_20912":52413,"_5":14363,"_27402":52368,"_2946":52414},[],"GET",{"_3462":1041,"_30116":1024,"_20912":52416,"_5":14363,"_27402":52368,"_2946":52417},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3462":1042,"_30116":1024,"_20912":52419,"_5":14363,"_27402":52368,"_2946":52420},[],"`/simpleenroll`",{"_3462":1043,"_30116":1024,"_20912":52422,"_5":14363,"_27402":52368,"_2946":52423},[],"POST",{"_3462":1044,"_30116":1024,"_20912":52425,"_5":14363,"_27402":52368,"_2946":52426},[],"Initial authentication and DMS registration/replacement policy.",{"_3462":1045,"_30116":1024,"_20912":52428,"_5":14363,"_27402":52368,"_2946":52429},[],"`/simplereenroll`",{"_3462":1046,"_30116":1024,"_20912":52431,"_5":14363,"_27402":52368,"_2946":52423},[],{"_3462":1047,"_30116":1024,"_20912":52433,"_5":14363,"_27402":52368,"_2946":52434},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3462":1048,"_30116":1024,"_20912":52436,"_5":14363,"_27402":52368,"_2946":52437},[],"`/serverkeygen`",{"_3462":1049,"_30116":1024,"_20912":52439,"_5":14363,"_27402":52368,"_2946":52423},[],{"_3462":1050,"_30116":1024,"_20912":52441,"_5":14363,"_27402":52368,"_2946":52442},[],"Initial authentication and admission; server generation enabled.",{"_3462":1051,"_30116":1024,"_20912":52444,"_5":14363,"_27402":52368,"_2946":52445},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3462":1052,"_30116":1024,"_20912":52447,"_5":14363,"_27402":52372,"_2946":52448},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3462":1053,"_30116":1024,"_20912":52450,"_5":14363,"_27402":52372,"_2946":52451},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3462":1054,"_30116":1024,"_20912":52453,"_5":14363,"_27402":52375,"_2946":52454},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3462":1055,"_30116":1024,"_20912":52456,"_5":14363,"_27402":52375,"_2946":52457},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3462":1056,"_30116":1024,"_20912":52459,"_5":14363,"_27402":52378,"_2946":52460},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3462":1057,"_30116":1024,"_20912":52462,"_5":14363,"_27402":52378,"_2946":52463},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3462":1058,"_30116":1024,"_20912":52465,"_5":14363,"_27402":52381,"_2946":52466},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3462":1059,"_30116":1024,"_20912":52468,"_5":14363,"_27402":52381,"_2946":52469},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3462":1060,"_30116":1024,"_20912":52471,"_5":14363,"_27402":52384,"_2946":52472},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3462":1061,"_30116":1024,"_20912":52474,"_5":14363,"_27402":52384,"_2946":52475},[],"Part",{"_3462":1062,"_30116":1024,"_20912":52477,"_5":14363,"_27402":52384,"_2946":52478},[],"Content after decoding its Base64",{"_3462":1063,"_30116":1024,"_20912":52480,"_5":14363,"_27402":52384,"_2946":52481},[],"`application/pkcs8`",{"_3462":1064,"_30116":1024,"_20912":52483,"_5":14363,"_27402":52384,"_2946":52484},[],"Unencrypted DER PKCS#8 private key.",{"_3462":1065,"_30116":1024,"_20912":52486,"_5":14363,"_27402":52384,"_2946":52487},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3462":1066,"_30116":1024,"_20912":52489,"_5":14363,"_27402":52384,"_2946":52490},[],"DER PKCS#7 containing the issued certificate.",{"_3462":1067,"_30116":1024,"_20912":52492,"_5":14363,"_27402":52384,"_2946":52493},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3462":1068,"_30116":1024,"_20912":52495,"_5":14363,"_27402":52388,"_2946":52496},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3462":1069,"_30116":1024,"_20912":52498,"_5":14363,"_27402":52388,"_2946":52499},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3462":1070,"_30116":1024,"_20912":52501,"_5":14363,"_27402":52388,"_2946":52502},[],"Convert and check the result:",{"_3462":1071,"_30116":1024,"_20912":52504,"_5":14363,"_27402":52388,"_2946":52505},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3462":1072,"_30116":1024,"_20912":52507,"_5":14363,"_27402":52392,"_2946":52508},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3462":1073,"_30116":1024,"_20912":52510,"_5":14363,"_27402":52392,"_2946":52511},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3462":1074,"_30116":1074,"_5":14715,"_2946":51830,"_30468":52513,"_20912":52514,"_27402":1074},[49167,50635,51649,51647,51830],[],{"_3462":1075,"_30116":1074,"_20912":52516,"_5":14363,"_27402":1074,"_2946":52517},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3462":1076,"_30116":1074,"_5":30465,"_20912":52519,"_27402":52520,"_2946":52521},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3462":1077,"_30116":1074,"_5":30465,"_20912":52523,"_27402":52524,"_2946":52525},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3462":1078,"_30116":1074,"_5":30465,"_20912":52527,"_27402":52528,"_2946":52529},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3462":1079,"_30116":1074,"_5":30465,"_20912":52531,"_27402":52532,"_2946":52533},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3462":1080,"_30116":1074,"_20912":52535,"_5":14363,"_27402":1074,"_2946":52536},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3462":1081,"_30116":1074,"_20912":52538,"_5":14363,"_27402":52520,"_2946":52539},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3462":1082,"_30116":1074,"_20912":52541,"_5":14363,"_27402":52520,"_2946":52542},[],"The integrator installs initial EST server trust and an admission credential.",{"_3462":1083,"_30116":1074,"_20912":52544,"_5":14363,"_27402":52520,"_2946":52545},[],"The client requests an identity for its `Device ID` through EST.",{"_3462":1084,"_30116":1074,"_20912":52547,"_5":14363,"_27402":52520,"_2946":52548},[],"Certificate, device binding and key/certificate installation are checked.",{"_3462":1085,"_30116":1074,"_20912":52550,"_5":14363,"_27402":52520,"_2946":52551},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3462":1086,"_30116":1074,"_20912":52553,"_5":14363,"_27402":52520,"_2946":52554},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3462":1087,"_30116":1074,"_20912":52556,"_5":14363,"_27402":52524,"_2946":52557},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3462":1088,"_30116":1074,"_20912":52559,"_5":14363,"_27402":52524,"_2946":52560},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3462":1089,"_30116":1074,"_20912":52562,"_5":14363,"_27402":52524,"_2946":52563},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3462":1090,"_30116":1074,"_20912":52565,"_5":14363,"_27402":52524,"_2946":52566},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3462":1091,"_30116":1074,"_20912":52568,"_5":14363,"_27402":52528,"_2946":52569},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3462":1092,"_30116":1074,"_20912":52571,"_5":14363,"_27402":52528,"_2946":52572},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3462":1093,"_30116":1074,"_20912":52574,"_5":14363,"_27402":52528,"_2946":52575},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3462":1094,"_30116":1074,"_20912":52577,"_5":14363,"_27402":52528,"_2946":52578},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3462":1095,"_30116":1074,"_20912":52580,"_5":14363,"_27402":52532,"_2946":52581},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3462":1096,"_30116":1074,"_20912":52583,"_5":14363,"_27402":52532,"_2946":52584},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3462":1097,"_30116":1097,"_5":14715,"_2946":52586,"_30468":52587,"_20912":52588,"_27402":1097},"Provisioning strategies",[49167,50635,51649,51647,51830],[],{"_3462":1098,"_30116":1097,"_20912":52590,"_5":14363,"_27402":1097,"_2946":52591},[],"Choose device registration, identity authorization and key generation.",{"_3462":1099,"_30116":1097,"_5":30465,"_20912":52593,"_27402":52594,"_2946":52595},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3462":1100,"_30116":1097,"_5":30465,"_20912":52597,"_27402":52598,"_2946":52599},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3462":1101,"_30116":1097,"_5":30465,"_20912":52601,"_27402":52602,"_2946":52603},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3462":1102,"_30116":1097,"_5":30465,"_20912":52605,"_27402":52606,"_2946":52607},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3462":1103,"_30116":1097,"_5":30465,"_20912":52609,"_27402":52610,"_2946":52611},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3462":1104,"_30116":1097,"_20912":52613,"_5":14363,"_27402":1097,"_2946":52614},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3462":1105,"_30116":1097,"_20912":52616,"_5":14363,"_27402":52594,"_2946":52617},[],"Path",{"_3462":1106,"_30116":1097,"_20912":52619,"_5":14363,"_27402":52594,"_2946":52620},[],"When the device exists",{"_3462":1107,"_30116":1097,"_20912":52622,"_5":14363,"_27402":52594,"_2946":52623},[],"What to check",{"_3462":1108,"_30116":1097,"_20912":52625,"_5":14363,"_27402":52594,"_2946":52626},[],"Manual assignment",{"_3462":1109,"_30116":1097,"_20912":52628,"_5":14363,"_27402":52594,"_2946":52629},[],"An operator creates it before associating a certificate.",{"_3462":1110,"_30116":1097,"_20912":52631,"_5":14363,"_27402":52594,"_2946":52632},[],"ID, owning DMS, certificate CN and bound serial.",{"_3462":1111,"_30116":1097,"_20912":52634,"_5":14363,"_27402":52594,"_2946":52635},[],"EST with `JITP`",{"_3462":1112,"_30116":1097,"_20912":52637,"_5":14363,"_27402":52594,"_2946":52638},[],"Created for an unknown CN during `/simpleenroll`.",{"_3462":1113,"_30116":1097,"_20912":52640,"_5":14363,"_27402":52594,"_2946":52641},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3462":1114,"_30116":1097,"_20912":52643,"_5":14363,"_27402":52594,"_2946":52644},[],"EST with `PRE_REGISTRATION`",{"_3462":1115,"_30116":1097,"_20912":52646,"_5":14363,"_27402":52594,"_2946":52647},[],"Must exist before `/simpleenroll`.",{"_3462":1116,"_30116":1097,"_20912":52649,"_5":14363,"_27402":52594,"_2946":52650},[],"Approved record, same DMS and replacement conditions for your version.",{"_3462":1117,"_30116":1097,"_20912":52652,"_5":14363,"_27402":52594,"_2946":52653},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3462":1118,"_30116":1097,"_20912":52655,"_5":14363,"_27402":52594,"_2946":52656},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3462":1119,"_30116":1097,"_20912":52658,"_5":14363,"_27402":52598,"_2946":52659},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3462":1120,"_30116":1097,"_20912":52661,"_5":14363,"_27402":52598,"_2946":52662},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3462":1121,"_30116":1097,"_20912":52664,"_5":14363,"_27402":52598,"_2946":52665},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3462":1122,"_30116":1097,"_20912":52667,"_5":14363,"_27402":52602,"_2946":52668},[],"Decide initial enrollment and re-enrollment separately:",{"_3462":1123,"_30116":1097,"_20912":52670,"_5":14363,"_27402":52602,"_2946":52671},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3462":1124,"_30116":1097,"_20912":52673,"_5":14363,"_27402":52602,"_2946":52674},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3462":1125,"_30116":1097,"_20912":52676,"_5":14363,"_27402":52602,"_2946":52677},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3462":1126,"_30116":1097,"_20912":52679,"_5":14363,"_27402":52602,"_2946":52680},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3462":1127,"_30116":1097,"_20912":52682,"_5":14363,"_27402":52602,"_2946":52683},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3462":1128,"_30116":1097,"_20912":52685,"_5":14363,"_27402":52606,"_2946":49551},[],{"_3462":1129,"_30116":1097,"_20912":52687,"_5":14363,"_27402":52606,"_2946":52688},[],"Material crossing EST",{"_3462":1130,"_30116":1097,"_20912":52690,"_5":14363,"_27402":52606,"_2946":52691},[],"Device-generated key",{"_3462":1131,"_30116":1097,"_20912":52693,"_5":14363,"_27402":52606,"_2946":52694},[],"Public CSR and certificate; the key stays on the client.",{"_3462":1132,"_30116":1097,"_20912":52696,"_5":14363,"_27402":52606,"_2946":52697},[],"Existing device key",{"_3462":1133,"_30116":1097,"_20912":52699,"_5":14363,"_27402":52606,"_2946":52700},[],"CSR signed with that key and a new certificate.",{"_3462":1134,"_30116":1097,"_20912":52702,"_5":14363,"_27402":52606,"_2946":51968},[],{"_3462":1135,"_30116":1097,"_20912":52704,"_5":14363,"_27402":52606,"_2946":52705},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3462":1136,"_30116":1097,"_20912":52707,"_5":14363,"_27402":52606,"_2946":52708},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3462":1137,"_30116":1097,"_20912":52710,"_5":14363,"_27402":52610,"_2946":52711},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3462":1138,"_30116":1138,"_5":14715,"_2946":52713,"_30468":52714,"_20912":52715,"_27402":1138},"Renewal and recovery",[49167,50635,51649,51647,51830],[],{"_3462":1139,"_30116":1138,"_20912":52717,"_5":14363,"_27402":1138,"_2946":52718},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3462":1140,"_30116":1138,"_5":30465,"_20912":52720,"_27402":52721,"_2946":52722},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3462":1141,"_30116":1138,"_5":30465,"_20912":52724,"_27402":52725,"_2946":52726},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3462":1142,"_30116":1138,"_5":30465,"_20912":52728,"_27402":52729,"_2946":52730},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3462":1143,"_30116":1138,"_5":30465,"_20912":52732,"_27402":52733,"_2946":52734},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3462":1144,"_30116":1138,"_5":30465,"_20912":52736,"_27402":52737,"_2946":52738},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3462":1145,"_30116":1138,"_20912":52740,"_5":14363,"_27402":1138,"_2946":52741},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3462":1146,"_30116":1138,"_20912":52743,"_5":14363,"_27402":52721,"_2946":52744},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3462":1147,"_30116":1138,"_20912":52746,"_5":14363,"_27402":52721,"_2946":52747},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3462":1148,"_30116":1138,"_20912":52749,"_5":14363,"_27402":52721,"_2946":52750},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3462":1149,"_30116":1138,"_20912":52752,"_5":14363,"_27402":52721,"_2946":52753},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3462":1150,"_30116":1138,"_20912":52755,"_5":14363,"_27402":52725,"_2946":52756},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3462":1151,"_30116":1138,"_20912":52758,"_5":14363,"_27402":52725,"_2946":52759},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3462":1152,"_30116":1138,"_20912":52761,"_5":14363,"_27402":52729,"_2946":52762},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3462":1153,"_30116":1138,"_20912":52764,"_5":14363,"_27402":52729,"_2946":52765},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3462":1154,"_30116":1138,"_20912":52767,"_5":14363,"_27402":52729,"_2946":52768},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3462":1155,"_30116":1138,"_20912":52770,"_5":14363,"_27402":52733,"_2946":52771},[],"Situation",{"_3462":1156,"_30116":1138,"_20912":52773,"_5":14363,"_27402":52733,"_2946":52774},[],"Procedure",{"_3462":1157,"_30116":1138,"_20912":52776,"_5":14363,"_27402":52733,"_2946":52777},[],"Valid certificate, outside the window",{"_3462":1158,"_30116":1138,"_20912":52779,"_5":14363,"_27402":52733,"_2946":52780},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3462":1159,"_30116":1138,"_20912":52782,"_5":14363,"_27402":52733,"_2946":52783},[],"Expired certificate, key available",{"_3462":1160,"_30116":1138,"_20912":52785,"_5":14363,"_27402":52733,"_2946":52786},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3462":1161,"_30116":1138,"_20912":52788,"_5":14363,"_27402":52733,"_2946":52789},[],"Renewal through webhook or `NO_AUTH`",{"_3462":1162,"_30116":1138,"_20912":52791,"_5":14363,"_27402":52733,"_2946":52792},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3462":1163,"_30116":1138,"_20912":52794,"_5":14363,"_27402":52733,"_2946":52795},[],"Lost or inaccessible key",{"_3462":1164,"_30116":1138,"_20912":52797,"_5":14363,"_27402":52733,"_2946":52798},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3462":1165,"_30116":1138,"_20912":52800,"_5":14363,"_27402":52733,"_2946":52801},[],"Current identity revoked",{"_3462":1166,"_30116":1138,"_20912":52803,"_5":14363,"_27402":52733,"_2946":52804},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3462":1167,"_30116":1138,"_20912":52806,"_5":14363,"_27402":52733,"_2946":52807},[],"Device without an identity",{"_3462":1168,"_30116":1138,"_20912":52809,"_5":14363,"_27402":52733,"_2946":52810},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3462":1169,"_30116":1138,"_20912":52812,"_5":14363,"_27402":52733,"_2946":52813},[],"Retired device",{"_3462":1170,"_30116":1138,"_20912":52815,"_5":14363,"_27402":52733,"_2946":52816},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3462":1171,"_30116":1138,"_20912":52818,"_5":14363,"_27402":52733,"_2946":52819},[],"Timeout, HTTP 500 or installation failure",{"_3462":1172,"_30116":1138,"_20912":52821,"_5":14363,"_27402":52733,"_2946":52822},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3462":1173,"_30116":1138,"_20912":52824,"_5":14363,"_27402":52737,"_2946":52825},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3462":1174,"_30116":1138,"_20912":52827,"_5":14363,"_27402":52737,"_2946":52828},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3462":1175,"_30116":1175,"_5":14715,"_2946":52830,"_30468":52831,"_20912":52832,"_27402":1175},"Enrollment troubleshooting",[49167,50635,51649,51647,51830],[],{"_3462":1176,"_30116":1175,"_20912":52834,"_5":14363,"_27402":1175,"_2946":52835},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3462":1177,"_30116":1175,"_5":30465,"_20912":52837,"_27402":52838,"_2946":52839},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3462":1178,"_30116":1175,"_5":30465,"_20912":52841,"_27402":52842,"_2946":52843},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3462":1179,"_30116":1175,"_5":30465,"_20912":52845,"_27402":52846,"_2946":52393},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3462":1180,"_30116":1175,"_5":30465,"_20912":52848,"_27402":52849,"_2946":52850},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3462":1181,"_30116":1175,"_20912":52852,"_5":14363,"_27402":1175,"_2946":52853},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3462":1182,"_30116":1175,"_20912":52855,"_5":14363,"_27402":52842,"_2946":52856},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3462":1183,"_30116":1175,"_20912":52858,"_5":14363,"_27402":52842,"_2946":52859},[],"Symptom or message",{"_3462":1184,"_30116":1175,"_20912":52861,"_5":14363,"_27402":52842,"_2946":52623},[],{"_3462":1185,"_30116":1175,"_20912":52863,"_5":14363,"_27402":52842,"_2946":52864},[],"curl rejects TLS, name or issuer",{"_3462":1186,"_30116":1175,"_20912":52866,"_5":14363,"_27402":52842,"_2946":52867},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3462":1187,"_30116":1175,"_20912":52869,"_5":14363,"_27402":52842,"_2946":52870},[],"404 or missing APS",{"_3462":1188,"_30116":1175,"_20912":52872,"_5":14363,"_27402":52842,"_2946":52873},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3462":1189,"_30116":1175,"_20912":52875,"_5":14363,"_27402":52842,"_2946":52876},[],"400, CSR or format error",{"_3462":1190,"_30116":1175,"_20912":52878,"_5":14363,"_27402":52842,"_2946":52879},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3462":1191,"_30116":1175,"_20912":52881,"_5":14363,"_27402":52842,"_2946":52882},[],"Missing credential or invalid certificate",{"_3462":1192,"_30116":1175,"_20912":52884,"_5":14363,"_27402":52842,"_2946":52885},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3462":1193,"_30116":1175,"_20912":52887,"_5":14363,"_27402":52842,"_2946":52888},[],"Webhook denies, times out or responds without authorization",{"_3462":1194,"_30116":1175,"_20912":52890,"_5":14363,"_27402":52842,"_2946":52891},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3462":1195,"_30116":1175,"_20912":52893,"_5":14363,"_27402":52842,"_2946":52894},[],"`unexpected status code: <n>: redirects are not followed`",{"_3462":1196,"_30116":1175,"_20912":52896,"_5":14363,"_27402":52842,"_2946":52897},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3462":1197,"_30116":1175,"_20912":52899,"_5":14363,"_27402":52842,"_2946":52900},[],"`webhook response exceeds 1048576 bytes`",{"_3462":1198,"_30116":1175,"_20912":52902,"_5":14363,"_27402":52842,"_2946":52903},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3462":1199,"_30116":1175,"_20912":52905,"_5":14363,"_27402":52842,"_2946":52906},[],"`webhook config must not reference files`",{"_3462":1200,"_30116":1175,"_20912":52908,"_5":14363,"_27402":52842,"_2946":52909},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3462":1201,"_30116":1175,"_20912":52911,"_5":14363,"_27402":52842,"_2946":52912},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3462":1202,"_30116":1175,"_20912":52914,"_5":14363,"_27402":52842,"_2946":52915},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3462":1203,"_30116":1175,"_20912":52917,"_5":14363,"_27402":52842,"_2946":52918},[],"`webhook mTLS certificate and key are invalid: …`",{"_3462":1204,"_30116":1175,"_20912":52920,"_5":14363,"_27402":52842,"_2946":52921},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3462":1205,"_30116":1175,"_20912":52923,"_5":14363,"_27402":52842,"_2946":52924},[],"400 `struct validation error` creating or updating a DMS",{"_3462":1206,"_30116":1175,"_20912":52926,"_5":14363,"_27402":52842,"_2946":52927},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3462":1207,"_30116":1175,"_20912":52929,"_5":14363,"_27402":52842,"_2946":52930},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3462":1208,"_30116":1175,"_20912":52932,"_5":14363,"_27402":52842,"_2946":52933},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3462":1209,"_30116":1175,"_20912":52935,"_5":14363,"_27402":52842,"_2946":52936},[],"`device not preregistered`",{"_3462":1210,"_30116":1175,"_20912":52938,"_5":14363,"_27402":52842,"_2946":52939},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3462":1211,"_30116":1175,"_20912":52941,"_5":14363,"_27402":52842,"_2946":52942},[],"`forbiddenNewEnrollment`",{"_3462":1212,"_30116":1175,"_20912":52944,"_5":14363,"_27402":52842,"_2946":52945},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3462":1213,"_30116":1175,"_20912":52947,"_5":14363,"_27402":52842,"_2946":52948},[],"Different owning DMS",{"_3462":1214,"_30116":1175,"_20912":52950,"_5":14363,"_27402":52842,"_2946":52951},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3462":1215,"_30116":1175,"_20912":52953,"_5":14363,"_27402":52842,"_2946":52954},[],"`invalid RawSubject bytes`",{"_3462":1216,"_30116":1175,"_20912":52956,"_5":14363,"_27402":52842,"_2946":52957},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3462":1217,"_30116":1175,"_20912":52959,"_5":14363,"_27402":52842,"_2946":52960},[],"`invalid reenroll window`",{"_3462":1218,"_30116":1175,"_20912":52962,"_5":14363,"_27402":52842,"_2946":52963},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3462":1219,"_30116":1175,"_20912":52965,"_5":14363,"_27402":52842,"_2946":52966},[],"Current certificate revoked",{"_3462":1220,"_30116":1175,"_20912":52968,"_5":14363,"_27402":52842,"_2946":52969},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3462":1221,"_30116":1175,"_20912":52971,"_5":14363,"_27402":52842,"_2946":52972},[],"CA, profile or signing error",{"_3462":1222,"_30116":1175,"_20912":52974,"_5":14363,"_27402":52842,"_2946":52975},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3462":1223,"_30116":1175,"_20912":52977,"_5":14363,"_27402":52842,"_2946":52978},[],"HTTP 200 without a device connection",{"_3462":1224,"_30116":1175,"_20912":52980,"_5":14363,"_27402":52842,"_2946":52981},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3462":1225,"_30116":1175,"_20912":52983,"_5":14363,"_27402":52842,"_2946":52984},[],"Timeout or error after issuance",{"_3462":1226,"_30116":1175,"_20912":52986,"_5":14363,"_27402":52842,"_2946":52987},[],"New certificates, current slot and previous identity's state before retrying.",{"_3462":1227,"_30116":1175,"_20912":52989,"_5":14363,"_27402":52846,"_2946":52990},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3462":1228,"_30116":1175,"_20912":52992,"_5":14363,"_27402":52846,"_2946":52993},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3462":1229,"_30116":1175,"_20912":52995,"_5":14363,"_27402":52849,"_2946":52996},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3462":1230,"_30116":1175,"_20912":52998,"_5":14363,"_27402":52849,"_2946":52999},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3462":1231,"_30116":1175,"_20912":53001,"_5":14363,"_27402":52849,"_2946":53002},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3462":1232,"_30116":1175,"_20912":53004,"_5":14363,"_27402":52849,"_2946":53005},[],"Make one request, save headers/body and query the device and certificates.",{"_3462":1233,"_30116":1175,"_20912":53007,"_5":14363,"_27402":52849,"_2946":53008},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3462":1234,"_30116":1175,"_20912":53010,"_5":14363,"_27402":52849,"_2946":53011},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3462":1235,"_30116":1175,"_20912":53013,"_5":14363,"_27402":52849,"_2946":53014},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3462":1236,"_30116":1236,"_5":14715,"_2946":53016,"_30468":53017,"_20912":53018,"_27402":1236},"Trust distribution and updates",[49167,50635,51649,51647,51830],[],{"_3462":1237,"_30116":1236,"_20912":53020,"_5":14363,"_27402":1236,"_2946":53021},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3462":1238,"_30116":1236,"_5":30465,"_20912":53023,"_27402":53024,"_2946":53025},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3462":1239,"_30116":1236,"_5":30465,"_20912":53027,"_27402":53028,"_2946":53029},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3462":1240,"_30116":1236,"_5":30465,"_20912":53031,"_27402":53032,"_2946":53033},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3462":1241,"_30116":1236,"_5":30465,"_20912":53035,"_27402":53036,"_2946":53037},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3462":1242,"_30116":1236,"_5":30465,"_20912":53039,"_27402":53040,"_2946":53041},[],"/docs/pr-preview/pr-64/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3462":1243,"_30116":1236,"_20912":53043,"_5":14363,"_27402":1236,"_2946":53044},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3462":1244,"_30116":1236,"_20912":53046,"_5":14363,"_27402":53024,"_2946":53047},[],"Relationship",{"_3462":1245,"_30116":1236,"_20912":53049,"_5":14363,"_27402":53024,"_2946":53050},[],"Material prepared by its owner",{"_3462":1246,"_30116":1236,"_20912":53052,"_5":14363,"_27402":53024,"_2946":53053},[],"Device → EST server",{"_3462":1247,"_30116":1236,"_20912":53055,"_5":14363,"_27402":53024,"_2946":53056},[],"Previously verified server root, chain or pin and TLS name.",{"_3462":1248,"_30116":1236,"_20912":53058,"_5":14363,"_27402":53024,"_2946":53059},[],"DMS → requester",{"_3462":1249,"_30116":1236,"_20912":53061,"_5":14363,"_27402":53024,"_2946":53062},[],"CAs and rules authorizing initial or renewal credentials.",{"_3462":1250,"_30116":1236,"_20912":53064,"_5":14363,"_27402":53024,"_2946":53065},[],"Consumer → device",{"_3462":1251,"_30116":1236,"_20912":53067,"_5":14363,"_27402":53024,"_2946":53068},[],"Operational identity roots, intermediates, validation and permissions.",{"_3462":1252,"_30116":1236,"_20912":53070,"_5":14363,"_27402":53024,"_2946":53071},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3462":1253,"_30116":1236,"_20912":53073,"_5":14363,"_27402":53028,"_2946":53074},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3462":1254,"_30116":1236,"_20912":53076,"_5":14363,"_27402":53028,"_2946":53077},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3462":1255,"_30116":1236,"_20912":53079,"_5":14363,"_27402":53032,"_2946":53080},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3462":1256,"_30116":1236,"_20912":53082,"_5":14363,"_27402":53032,"_2946":53083},[],"Select policy-approved roots as anchors.",{"_3462":1257,"_30116":1236,"_20912":53085,"_5":14363,"_27402":53032,"_2946":53086},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3462":1258,"_30116":1236,"_20912":53088,"_5":14363,"_27402":53032,"_2946":53089},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3462":1259,"_30116":1236,"_20912":53091,"_5":14363,"_27402":53032,"_2946":53092},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3462":1260,"_30116":1236,"_20912":53094,"_5":14363,"_27402":53032,"_2946":53095},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3462":1261,"_30116":1236,"_20912":53097,"_5":14363,"_27402":53036,"_2946":53098},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3462":1262,"_30116":1236,"_20912":53100,"_5":14363,"_27402":53036,"_2946":53101},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3462":1263,"_30116":1236,"_20912":53103,"_5":14363,"_27402":53036,"_2946":53104},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3462":1264,"_30116":1236,"_20912":53106,"_5":14363,"_27402":53040,"_2946":53107},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3462":1265,"_30116":1265,"_5":14715,"_2946":53109,"_30468":53110,"_20912":53112,"_27402":1265},"AWS IoT Core",[49167,50635,51649,51647,53111],"Integrations",[],{"_3462":1266,"_30116":1265,"_20912":53114,"_5":14363,"_27402":1265,"_2946":53115},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3462":1267,"_30116":1265,"_5":30465,"_20912":53117,"_27402":53118,"_2946":53119},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3462":1268,"_30116":1265,"_5":30465,"_20912":53121,"_27402":53122,"_2946":53123},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3462":1269,"_30116":1265,"_5":30465,"_20912":53125,"_27402":53126,"_2946":53127},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3462":1270,"_30116":1265,"_5":30465,"_20912":53129,"_27402":53130,"_2946":53131},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3462":1271,"_30116":1265,"_5":30465,"_20912":53133,"_27402":53134,"_2946":53135},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3462":1272,"_30116":1265,"_5":30465,"_20912":53137,"_27402":53138,"_2946":53139},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3462":1273,"_30116":1265,"_5":30465,"_20912":53141,"_27402":53142,"_2946":53143},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3462":1274,"_30116":1265,"_5":30465,"_20912":53145,"_27402":53146,"_2946":53147},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3462":1275,"_30116":1265,"_5":30465,"_20912":53149,"_27402":53150,"_2946":53151},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3462":1276,"_30116":1265,"_5":30465,"_20912":53153,"_27402":53154,"_2946":53155},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3462":1277,"_30116":1265,"_5":30465,"_20912":53157,"_27402":53158,"_2946":53159},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3462":1278,"_30116":1265,"_5":30465,"_20912":53161,"_27402":53162,"_2946":53163},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3462":1279,"_30116":1265,"_5":30465,"_20912":53165,"_27402":53166,"_2946":53167},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3462":1280,"_30116":1265,"_5":30465,"_20912":53169,"_27402":53170,"_2946":53171},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3462":1281,"_30116":1265,"_5":30465,"_20912":53173,"_27402":53174,"_2946":53175},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3462":1282,"_30116":1265,"_5":30465,"_20912":53177,"_27402":53178,"_2946":53179},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3462":1283,"_30116":1265,"_5":30465,"_20912":53181,"_27402":53182,"_2946":53183},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3462":1284,"_30116":1265,"_5":30465,"_20912":53185,"_27402":53186,"_2946":53187},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3462":1285,"_30116":1265,"_5":30465,"_20912":53189,"_27402":53190,"_2946":53191},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3462":1286,"_30116":1265,"_5":30465,"_20912":53193,"_27402":53194,"_2946":53195},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3462":1287,"_30116":1265,"_5":30465,"_20912":53197,"_27402":53198,"_2946":53199},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3462":1288,"_30116":1265,"_5":30465,"_20912":53201,"_27402":53202,"_2946":53203},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3462":1289,"_30116":1265,"_5":30465,"_20912":53205,"_27402":53206,"_2946":53207},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3462":1290,"_30116":1265,"_5":30465,"_20912":53209,"_27402":53210,"_2946":53211},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3462":1291,"_30116":1265,"_5":30465,"_20912":53213,"_27402":53214,"_2946":53215},[],"/docs/pr-preview/pr-64/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3462":1292,"_30116":1265,"_20912":53217,"_5":14363,"_27402":1265,"_2946":53218},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3462":1293,"_30116":1265,"_20912":53220,"_5":14363,"_27402":1265,"_2946":53221},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3462":1294,"_30116":1265,"_20912":53223,"_5":14363,"_27402":1265,"_2946":53224},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3462":1295,"_30116":1265,"_20912":53226,"_5":14363,"_27402":53118,"_2946":53227},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3462":1296,"_30116":1265,"_20912":53229,"_5":14363,"_27402":53118,"_2946":53230},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3462":1297,"_30116":1265,"_20912":53232,"_5":14363,"_27402":53118,"_2946":53233},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3462":1298,"_30116":1265,"_20912":53235,"_5":14363,"_27402":53118,"_2946":53236},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3462":1299,"_30116":1265,"_20912":53238,"_5":14363,"_27402":53122,"_2946":53239},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3462":1300,"_30116":1265,"_20912":53241,"_5":14363,"_27402":53126,"_2946":53242},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3462":1301,"_30116":1265,"_20912":53244,"_5":14363,"_27402":53126,"_2946":53245},[],"IAM action",{"_3462":1302,"_30116":1265,"_20912":53247,"_5":14363,"_27402":53126,"_2946":49557},[],{"_3462":1303,"_30116":1265,"_20912":53249,"_5":14363,"_27402":53126,"_2946":53250},[],"`iot:GetRegistrationCode`",{"_3462":1304,"_30116":1265,"_20912":53252,"_5":14363,"_27402":53126,"_2946":53253},[],"Obtain the verification code for CA registration in the Primary Account",{"_3462":1305,"_30116":1265,"_20912":53255,"_5":14363,"_27402":53126,"_2946":53256},[],"`iot:RegisterCACertificate`",{"_3462":1306,"_30116":1265,"_20912":53258,"_5":14363,"_27402":53126,"_2946":53259},[],"Register the CA in AWS IoT",{"_3462":1307,"_30116":1265,"_20912":53261,"_5":14363,"_27402":53126,"_2946":53262},[],"`iot:DescribeCACertificate`",{"_3462":1308,"_30116":1265,"_20912":53264,"_5":14363,"_27402":53126,"_2946":53265},[],"Check the CA registration status",{"_3462":1309,"_30116":1265,"_20912":53267,"_5":14363,"_27402":53126,"_2946":53268},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3462":1310,"_30116":1265,"_20912":53270,"_5":14363,"_27402":53126,"_2946":53271},[],"Create or update Things in IoT Core",{"_3462":1311,"_30116":1265,"_20912":53273,"_5":14363,"_27402":53126,"_2946":53274},[],"`iot:RegisterThing`",{"_3462":1312,"_30116":1265,"_20912":53276,"_5":14363,"_27402":53126,"_2946":53277},[],"Provision Things through a template",{"_3462":1313,"_30116":1265,"_20912":53279,"_5":14363,"_27402":53126,"_2946":53280},[],"`iot:RegisterCertificate`",{"_3462":1314,"_30116":1265,"_20912":53282,"_5":14363,"_27402":53126,"_2946":53283},[],"Register device certificates",{"_3462":1315,"_30116":1265,"_20912":53285,"_5":14363,"_27402":53126,"_2946":53286},[],"`iot:UpdateCertificate`",{"_3462":1316,"_30116":1265,"_20912":53288,"_5":14363,"_27402":53126,"_2946":53289},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3462":1317,"_30116":1265,"_20912":53291,"_5":14363,"_27402":53126,"_2946":53292},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3462":1318,"_30116":1265,"_20912":53294,"_5":14363,"_27402":53126,"_2946":53295},[],"Create and attach IoT policies",{"_3462":1319,"_30116":1265,"_20912":53297,"_5":14363,"_27402":53126,"_2946":53298},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3462":1320,"_30116":1265,"_20912":53300,"_5":14363,"_27402":53126,"_2946":53301},[],"Manage Thing groups",{"_3462":1321,"_30116":1265,"_20912":53303,"_5":14363,"_27402":53126,"_2946":53304},[],"`iot:CreateProvisioningTemplate`",{"_3462":1322,"_30116":1265,"_20912":53306,"_5":14363,"_27402":53126,"_2946":53307},[],"Create JITP templates",{"_3462":1323,"_30116":1265,"_20912":53309,"_5":14363,"_27402":53126,"_2946":53310},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3462":1324,"_30116":1265,"_20912":53312,"_5":14363,"_27402":53126,"_2946":53313},[],"Read and write the Device Shadow",{"_3462":1325,"_30116":1265,"_20912":53315,"_5":14363,"_27402":53126,"_2946":53316},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3462":1326,"_30116":1265,"_20912":53318,"_5":14363,"_27402":53130,"_2946":53319},[],"Parameter",{"_3462":1327,"_30116":1265,"_20912":53321,"_5":14363,"_27402":53130,"_2946":53322},[],"Type",{"_3462":1328,"_30116":1265,"_20912":53324,"_5":14363,"_27402":53130,"_2946":53325},[],"Required",{"_3462":1329,"_30116":1265,"_20912":53327,"_5":14363,"_27402":53130,"_2946":53328},[],"Description",{"_3462":1330,"_30116":1265,"_20912":53330,"_5":14363,"_27402":53130,"_2946":53331},[],"`connector_id`",{"_3462":1331,"_30116":1265,"_20912":53333,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1332,"_30116":1265,"_20912":53335,"_5":14363,"_27402":53130,"_2946":53336},[],"Yes",{"_3462":1333,"_30116":1265,"_20912":53338,"_5":14363,"_27402":53130,"_2946":53339},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3462":1334,"_30116":1265,"_20912":53341,"_5":14363,"_27402":53130,"_2946":53342},[],"`aws_config.region`",{"_3462":1335,"_30116":1265,"_20912":53344,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1336,"_30116":1265,"_20912":53346,"_5":14363,"_27402":53130,"_2946":53336},[],{"_3462":1337,"_30116":1265,"_20912":53348,"_5":14363,"_27402":53130,"_2946":53349},[],"AWS region where the connector operates.",{"_3462":1338,"_30116":1265,"_20912":53351,"_5":14363,"_27402":53130,"_2946":53352},[],"`aws_config.auth_method`",{"_3462":1339,"_30116":1265,"_20912":53354,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1340,"_30116":1265,"_20912":53356,"_5":14363,"_27402":53130,"_2946":53336},[],{"_3462":1341,"_30116":1265,"_20912":53358,"_5":14363,"_27402":53130,"_2946":53359},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3462":1342,"_30116":1265,"_20912":53361,"_5":14363,"_27402":53130,"_2946":53362},[],"`aws_config.access_key_id`",{"_3462":1343,"_30116":1265,"_20912":53364,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1344,"_30116":1265,"_20912":53366,"_5":14363,"_27402":53130,"_2946":53367},[],"Only with `auth_method=static`",{"_3462":1345,"_30116":1265,"_20912":53369,"_5":14363,"_27402":53130,"_2946":53370},[],"AWS access key.",{"_3462":1346,"_30116":1265,"_20912":53372,"_5":14363,"_27402":53130,"_2946":53373},[],"`aws_config.secret_access_key`",{"_3462":1347,"_30116":1265,"_20912":53375,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1348,"_30116":1265,"_20912":53377,"_5":14363,"_27402":53130,"_2946":53367},[],{"_3462":1349,"_30116":1265,"_20912":53379,"_5":14363,"_27402":53130,"_2946":53380},[],"AWS secret key.",{"_3462":1350,"_30116":1265,"_20912":53382,"_5":14363,"_27402":53130,"_2946":53383},[],"`aws_config.session_token`",{"_3462":1351,"_30116":1265,"_20912":53385,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1352,"_30116":1265,"_20912":53387,"_5":14363,"_27402":53130,"_2946":53388},[],"No",{"_3462":1353,"_30116":1265,"_20912":53390,"_5":14363,"_27402":53130,"_2946":53391},[],"Session token (with `auth_method=static`).",{"_3462":1354,"_30116":1265,"_20912":53393,"_5":14363,"_27402":53130,"_2946":53394},[],"`aws_config.role_arn`",{"_3462":1355,"_30116":1265,"_20912":53396,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1356,"_30116":1265,"_20912":53398,"_5":14363,"_27402":53130,"_2946":53399},[],"Only with `auth_method=role`",{"_3462":1357,"_30116":1265,"_20912":53401,"_5":14363,"_27402":53130,"_2946":53402},[],"ARN of the role to assume.",{"_3462":1358,"_30116":1265,"_20912":53404,"_5":14363,"_27402":53130,"_2946":53405},[],"`aws_config.endpoint_url`",{"_3462":1359,"_30116":1265,"_20912":53407,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1360,"_30116":1265,"_20912":53409,"_5":14363,"_27402":53130,"_2946":53388},[],{"_3462":1361,"_30116":1265,"_20912":53411,"_5":14363,"_27402":53130,"_2946":53412},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3462":1362,"_30116":1265,"_20912":53414,"_5":14363,"_27402":53130,"_2946":53415},[],"`subscriber_event_bus`",{"_3462":1363,"_30116":1265,"_20912":53417,"_5":14363,"_27402":53130,"_2946":17602},[],{"_3462":1364,"_30116":1265,"_20912":53419,"_5":14363,"_27402":53130,"_2946":53336},[],{"_3462":1365,"_30116":1265,"_20912":53421,"_5":14363,"_27402":53130,"_2946":53422},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3462":1366,"_30116":1265,"_20912":53424,"_5":14363,"_27402":53130,"_2946":53425},[],"`dms_manager_client`",{"_3462":1367,"_30116":1265,"_20912":53427,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1368,"_30116":1265,"_20912":53429,"_5":14363,"_27402":53130,"_2946":53336},[],{"_3462":1369,"_30116":1265,"_20912":53431,"_5":14363,"_27402":53130,"_2946":53432},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3462":1370,"_30116":1265,"_20912":53434,"_5":14363,"_27402":53130,"_2946":53435},[],"`device_manager_client`",{"_3462":1371,"_30116":1265,"_20912":53437,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1372,"_30116":1265,"_20912":53439,"_5":14363,"_27402":53130,"_2946":53336},[],{"_3462":1373,"_30116":1265,"_20912":53441,"_5":14363,"_27402":53130,"_2946":53442},[],"HTTP URL of Lamassu's Device Manager.",{"_3462":1374,"_30116":1265,"_20912":53444,"_5":14363,"_27402":53130,"_2946":53445},[],"`ca_client`",{"_3462":1375,"_30116":1265,"_20912":53447,"_5":14363,"_27402":53130,"_2946":24983},[],{"_3462":1376,"_30116":1265,"_20912":53449,"_5":14363,"_27402":53130,"_2946":53336},[],{"_3462":1377,"_30116":1265,"_20912":53451,"_5":14363,"_27402":53130,"_2946":53452},[],"HTTP URL of Lamassu's CA service.",{"_3462":1378,"_30116":1265,"_20912":53454,"_5":14363,"_27402":53134,"_2946":53455},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3462":1379,"_30116":1265,"_20912":53457,"_5":14363,"_27402":53134,"_2946":53458},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3462":1380,"_30116":1265,"_20912":53460,"_5":14363,"_27402":53134,"_2946":53461},[],"CloudEvent type",{"_3462":1381,"_30116":1265,"_20912":53463,"_5":14363,"_27402":53134,"_2946":53464},[],"Lamassu resource",{"_3462":1382,"_30116":1265,"_20912":53466,"_5":14363,"_27402":53134,"_2946":53467},[],"AWS Resource",{"_3462":1383,"_30116":1265,"_20912":53469,"_5":14363,"_27402":53134,"_2946":53470},[],"IAM actions",{"_3462":1384,"_30116":1265,"_20912":53472,"_5":14363,"_27402":53134,"_2946":53473},[],"AWS calls and effect",{"_3462":1385,"_30116":1265,"_20912":53475,"_5":14363,"_27402":53134,"_2946":53476},[],"Where in this page",{"_3462":1386,"_30116":1265,"_20912":53478,"_5":14363,"_27402":53134,"_2946":53479},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3462":1387,"_30116":1265,"_20912":53481,"_5":14363,"_27402":53134,"_2946":53482},[],"CA",{"_3462":1388,"_30116":1265,"_20912":53484,"_5":14363,"_27402":53134,"_2946":53485},[],"`IoTCore/CACertificate`",{"_3462":1389,"_30116":1265,"_20912":53487,"_5":14363,"_27402":53134,"_2946":53488},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3462":1390,"_30116":1265,"_20912":53490,"_5":14363,"_27402":53134,"_2946":53491},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3462":1391,"_30116":1265,"_20912":53493,"_5":14363,"_27402":53134,"_2946":53147},[],{"_3462":1392,"_30116":1265,"_20912":53495,"_5":14363,"_27402":53134,"_2946":53496},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3462":1393,"_30116":1265,"_20912":53498,"_5":14363,"_27402":53134,"_2946":53499},[],"DMS",{"_3462":1394,"_30116":1265,"_20912":53501,"_5":14363,"_27402":53134,"_2946":53502},[],"`IoTCore/ProvisioningTemplate`",{"_3462":1395,"_30116":1265,"_20912":53504,"_5":14363,"_27402":53134,"_2946":53505},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3462":1396,"_30116":1265,"_20912":53507,"_5":14363,"_27402":53134,"_2946":53508},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3462":1397,"_30116":1265,"_20912":53510,"_5":14363,"_27402":53134,"_2946":53175},[],{"_3462":1398,"_30116":1265,"_20912":53512,"_5":14363,"_27402":53134,"_2946":53513},[],"`EventBindDeviceIdentityKey`",{"_3462":1399,"_30116":1265,"_20912":53515,"_5":14363,"_27402":53134,"_2946":53516},[],"Device",{"_3462":1400,"_30116":1265,"_20912":53518,"_5":14363,"_27402":53134,"_2946":53519},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3462":1401,"_30116":1265,"_20912":53521,"_5":14363,"_27402":53134,"_2946":53522},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3462":1402,"_30116":1265,"_20912":53524,"_5":14363,"_27402":53134,"_2946":53525},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3462":1403,"_30116":1265,"_20912":53527,"_5":14363,"_27402":53134,"_2946":53183},[],{"_3462":1404,"_30116":1265,"_20912":53529,"_5":14363,"_27402":53134,"_2946":53530},[],"`EventUpdateCertificateStatusKey`",{"_3462":1405,"_30116":1265,"_20912":53532,"_5":14363,"_27402":53134,"_2946":53533},[],"Certificate",{"_3462":1406,"_30116":1265,"_20912":53535,"_5":14363,"_27402":53134,"_2946":53536},[],"`IoTCore/Certificate`",{"_3462":1407,"_30116":1265,"_20912":53538,"_5":14363,"_27402":53134,"_2946":53539},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3462":1408,"_30116":1265,"_20912":53541,"_5":14363,"_27402":53134,"_2946":53542},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3462":1409,"_30116":1265,"_20912":53544,"_5":14363,"_27402":53134,"_2946":53195},[],{"_3462":1410,"_30116":1265,"_20912":53546,"_5":14363,"_27402":53134,"_2946":53547},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3462":1411,"_30116":1265,"_20912":53549,"_5":14363,"_27402":53134,"_2946":53550},[],"Certificate / Device",{"_3462":1412,"_30116":1265,"_20912":53552,"_5":14363,"_27402":53134,"_2946":53553},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3462":1413,"_30116":1265,"_20912":53555,"_5":14363,"_27402":53134,"_2946":49563},[],{"_3462":1414,"_30116":1265,"_20912":53557,"_5":14363,"_27402":53134,"_2946":53558},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3462":1415,"_30116":1265,"_20912":53560,"_5":14363,"_27402":53134,"_2946":53203},[],{"_3462":1416,"_30116":1265,"_20912":53562,"_5":14363,"_27402":53138,"_2946":53563},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3462":1417,"_30116":1265,"_20912":53565,"_5":14363,"_27402":53142,"_2946":53566},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3462":1418,"_30116":1265,"_20912":53568,"_5":14363,"_27402":53142,"_2946":53569},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3462":1419,"_30116":1265,"_20912":53571,"_5":14363,"_27402":53146,"_2946":53572},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3462":1420,"_30116":1265,"_20912":53574,"_5":14363,"_27402":53146,"_2946":53575},[],"Transition",{"_3462":1421,"_30116":1265,"_20912":53577,"_5":14363,"_27402":53146,"_2946":53578},[],"AWS calls",{"_3462":1422,"_30116":1265,"_20912":53580,"_5":14363,"_27402":53146,"_2946":53581},[],"`NotRegistered` → `Requested`",{"_3462":1423,"_30116":1265,"_20912":53583,"_5":14363,"_27402":53146,"_2946":53584},[],"none (metadata write only)",{"_3462":1424,"_30116":1265,"_20912":53586,"_5":14363,"_27402":53146,"_2946":53587},[],"`Requested` → `Registering`",{"_3462":1425,"_30116":1265,"_20912":53589,"_5":14363,"_27402":53146,"_2946":53590},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3462":1426,"_30116":1265,"_20912":53592,"_5":14363,"_27402":53146,"_2946":53593},[],"`Registering` → `Succeeded`",{"_3462":1427,"_30116":1265,"_20912":53595,"_5":14363,"_27402":53146,"_2946":53596},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3462":1428,"_30116":1265,"_20912":53598,"_5":14363,"_27402":53146,"_2946":53599},[],"`Registering` → `Failed`",{"_3462":1429,"_30116":1265,"_20912":53601,"_5":14363,"_27402":53146,"_2946":53602},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3462":1430,"_30116":1265,"_20912":53604,"_5":14363,"_27402":53146,"_2946":53605},[],"`Failed` / `Succeeded` → `Requested`",{"_3462":1431,"_30116":1265,"_20912":53607,"_5":14363,"_27402":53146,"_2946":53608},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3462":1432,"_30116":1265,"_20912":53610,"_5":14363,"_27402":53150,"_2946":53611},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3462":1433,"_30116":1265,"_20912":53613,"_5":14363,"_27402":53150,"_2946":53614},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3462":1434,"_30116":1265,"_20912":53616,"_5":14363,"_27402":53150,"_2946":53617},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3462":1435,"_30116":1265,"_20912":53619,"_5":14363,"_27402":53150,"_2946":53620},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3462":1436,"_30116":1265,"_20912":53622,"_5":14363,"_27402":53150,"_2946":53623},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3462":1437,"_30116":1265,"_20912":53625,"_5":14363,"_27402":53150,"_2946":53626},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3462":1438,"_30116":1265,"_20912":53628,"_5":14363,"_27402":53154,"_2946":53629},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3462":1439,"_30116":1265,"_20912":53631,"_5":14363,"_27402":53158,"_2946":53632},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3462":1440,"_30116":1265,"_20912":53634,"_5":14363,"_27402":53158,"_2946":53635},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3462":1441,"_30116":1265,"_20912":53637,"_5":14363,"_27402":53162,"_2946":53638},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3462":1442,"_30116":1265,"_20912":53640,"_5":14363,"_27402":53166,"_2946":53641},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3462":1443,"_30116":1265,"_20912":53643,"_5":14363,"_27402":53166,"_2946":53644},[],"Creates or updates the IoT policies configured in the DMS.",{"_3462":1444,"_30116":1265,"_20912":53646,"_5":14363,"_27402":53166,"_2946":53647},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3462":1445,"_30116":1265,"_20912":53649,"_5":14363,"_27402":53166,"_2946":53650},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3462":1446,"_30116":1265,"_20912":53652,"_5":14363,"_27402":53166,"_2946":53653},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3462":1447,"_30116":1265,"_20912":53655,"_5":14363,"_27402":53166,"_2946":53656},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3462":1448,"_30116":1265,"_20912":53658,"_5":14363,"_27402":53166,"_2946":53659},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3462":1449,"_30116":1265,"_20912":53661,"_5":14363,"_27402":53170,"_2946":53662},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3462":1450,"_30116":1265,"_20912":53664,"_5":14363,"_27402":53170,"_2946":53665},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3462":1451,"_30116":1265,"_20912":53667,"_5":14363,"_27402":53170,"_2946":53668},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3462":1452,"_30116":1265,"_20912":53670,"_5":14363,"_27402":53170,"_2946":53671},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3462":1453,"_30116":1265,"_20912":53673,"_5":14363,"_27402":53170,"_2946":53674},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3462":1454,"_30116":1265,"_20912":53676,"_5":14363,"_27402":53174,"_2946":53677},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3462":1455,"_30116":1265,"_20912":53679,"_5":14363,"_27402":53174,"_2946":53575},[],{"_3462":1456,"_30116":1265,"_20912":53681,"_5":14363,"_27402":53174,"_2946":53578},[],{"_3462":1457,"_30116":1265,"_20912":53683,"_5":14363,"_27402":53174,"_2946":53684},[],"`Unconfigured` → `None` / `Auto`",{"_3462":1458,"_30116":1265,"_20912":53686,"_5":14363,"_27402":53174,"_2946":53687},[],"none (configuration only)",{"_3462":1459,"_30116":1265,"_20912":53689,"_5":14363,"_27402":53174,"_2946":53690},[],"`None` ↔ `Auto`",{"_3462":1460,"_30116":1265,"_20912":53692,"_5":14363,"_27402":53174,"_2946":53687},[],{"_3462":1461,"_30116":1265,"_20912":53694,"_5":14363,"_27402":53174,"_2946":53695},[],"Any → `Jitp`",{"_3462":1462,"_30116":1265,"_20912":53697,"_5":14363,"_27402":53174,"_2946":53698},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3462":1463,"_30116":1265,"_20912":53700,"_5":14363,"_27402":53174,"_2946":53701},[],"`Jitp` → `None` / `Auto`",{"_3462":1464,"_30116":1265,"_20912":53703,"_5":14363,"_27402":53174,"_2946":53704},[],"none (the template stays in the AWS account)",{"_3462":1465,"_30116":1265,"_20912":53706,"_5":14363,"_27402":53178,"_2946":53707},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3462":1466,"_30116":1265,"_20912":53709,"_5":14363,"_27402":53178,"_2946":53710},[],"The full flow from the device's perspective is:",{"_3462":1467,"_30116":1265,"_20912":53712,"_5":14363,"_27402":53178,"_2946":53713},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3462":1468,"_30116":1265,"_20912":53715,"_5":14363,"_27402":53182,"_2946":53716},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3462":1469,"_30116":1265,"_20912":53718,"_5":14363,"_27402":53182,"_2946":53575},[],{"_3462":1470,"_30116":1265,"_20912":53720,"_5":14363,"_27402":53182,"_2946":53578},[],{"_3462":1471,"_30116":1265,"_20912":53722,"_5":14363,"_27402":53182,"_2946":53723},[],"`Absent` → `Provisioned`",{"_3462":1472,"_30116":1265,"_20912":53725,"_5":14363,"_27402":53182,"_2946":53726},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3462":1473,"_30116":1265,"_20912":53728,"_5":14363,"_27402":53182,"_2946":53729},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3462":1474,"_30116":1265,"_20912":53731,"_5":14363,"_27402":53182,"_2946":53732},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3462":1475,"_30116":1265,"_20912":53734,"_5":14363,"_27402":53182,"_2946":53735},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3462":1476,"_30116":1265,"_20912":53737,"_5":14363,"_27402":53186,"_2946":53738},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3462":1477,"_30116":1265,"_20912":53740,"_5":14363,"_27402":53186,"_2946":53741},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3462":1478,"_30116":1265,"_20912":53743,"_5":14363,"_27402":53186,"_2946":53744},[],"For the JITP flow to work correctly:",{"_3462":1479,"_30116":1265,"_20912":53746,"_5":14363,"_27402":53186,"_2946":53747},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3462":1480,"_30116":1265,"_20912":53749,"_5":14363,"_27402":53186,"_2946":53750},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3462":1481,"_30116":1265,"_20912":53752,"_5":14363,"_27402":53186,"_2946":53753},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3462":1482,"_30116":1265,"_20912":53755,"_5":14363,"_27402":53186,"_2946":53756},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3462":1483,"_30116":1265,"_20912":53758,"_5":14363,"_27402":53190,"_2946":53759},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3462":1484,"_30116":1265,"_20912":53761,"_5":14363,"_27402":53190,"_2946":53762},[],"Status in Lamassu",{"_3462":1485,"_30116":1265,"_20912":53764,"_5":14363,"_27402":53190,"_2946":53765},[],"Revocation reason",{"_3462":1486,"_30116":1265,"_20912":53767,"_5":14363,"_27402":53190,"_2946":53768},[],"Status in AWS IoT Core",{"_3462":1487,"_30116":1265,"_20912":53770,"_5":14363,"_27402":53190,"_2946":53771},[],"`Active`",{"_3462":1488,"_30116":1265,"_20912":53773,"_5":14363,"_27402":53190,"_2946":53774},[],"None",{"_3462":1489,"_30116":1265,"_20912":53776,"_5":14363,"_27402":53190,"_2946":53777},[],"`ACTIVE`",{"_3462":1490,"_30116":1265,"_20912":53779,"_5":14363,"_27402":53190,"_2946":53780},[],"`Revoked`",{"_3462":1491,"_30116":1265,"_20912":53782,"_5":14363,"_27402":53190,"_2946":53783},[],"`certificateHold`",{"_3462":1492,"_30116":1265,"_20912":53785,"_5":14363,"_27402":53190,"_2946":53786},[],"`INACTIVE`",{"_3462":1493,"_30116":1265,"_20912":53788,"_5":14363,"_27402":53190,"_2946":53780},[],{"_3462":1494,"_30116":1265,"_20912":53790,"_5":14363,"_27402":53190,"_2946":53791},[],"Any other reason",{"_3462":1495,"_30116":1265,"_20912":53793,"_5":14363,"_27402":53190,"_2946":53794},[],"`REVOKED`",{"_3462":1496,"_30116":1265,"_20912":53796,"_5":14363,"_27402":53190,"_2946":53797},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3462":1497,"_30116":1265,"_20912":53799,"_5":14363,"_27402":53194,"_2946":53800},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3462":1498,"_30116":1265,"_20912":53802,"_5":14363,"_27402":53194,"_2946":53575},[],{"_3462":1499,"_30116":1265,"_20912":53804,"_5":14363,"_27402":53194,"_2946":53578},[],{"_3462":1500,"_30116":1265,"_20912":53806,"_5":14363,"_27402":53194,"_2946":53807},[],"`NotSynced` → `Active`",{"_3462":1501,"_30116":1265,"_20912":53809,"_5":14363,"_27402":53194,"_2946":53286},[],{"_3462":1502,"_30116":1265,"_20912":53811,"_5":14363,"_27402":53194,"_2946":53812},[],"`Active` → `Inactive`",{"_3462":1503,"_30116":1265,"_20912":53814,"_5":14363,"_27402":53194,"_2946":53815},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3462":1504,"_30116":1265,"_20912":53817,"_5":14363,"_27402":53194,"_2946":53818},[],"`Active` → `Revoked`",{"_3462":1505,"_30116":1265,"_20912":53820,"_5":14363,"_27402":53194,"_2946":53815},[],{"_3462":1506,"_30116":1265,"_20912":53822,"_5":14363,"_27402":53194,"_2946":53823},[],"`Inactive` / `Revoked` → `Active`",{"_3462":1507,"_30116":1265,"_20912":53825,"_5":14363,"_27402":53194,"_2946":53286},[],{"_3462":1508,"_30116":1265,"_20912":53827,"_5":14363,"_27402":53194,"_2946":53828},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3462":1509,"_30116":1265,"_20912":53830,"_5":14363,"_27402":53194,"_2946":53831},[],"none (these states are not synced to AWS)",{"_3462":1510,"_30116":1265,"_20912":53833,"_5":14363,"_27402":53198,"_2946":53834},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3462":1511,"_30116":1265,"_20912":53836,"_5":14363,"_27402":53198,"_2946":53837},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3462":1512,"_30116":1265,"_20912":53839,"_5":14363,"_27402":53198,"_2946":53840},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3462":1513,"_30116":1265,"_20912":53842,"_5":14363,"_27402":53202,"_2946":53843},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3462":1514,"_30116":1265,"_20912":53845,"_5":14363,"_27402":53202,"_2946":53846},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3462":1515,"_30116":1265,"_20912":53848,"_5":14363,"_27402":53206,"_2946":53849},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3462":1516,"_30116":1265,"_20912":53851,"_5":14363,"_27402":53206,"_2946":53852},[],"There are two action types:",{"_3462":1517,"_30116":1265,"_20912":53854,"_5":14363,"_27402":53206,"_2946":53855},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3462":1518,"_30116":1265,"_20912":53857,"_5":14363,"_27402":53206,"_2946":53858},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3462":1519,"_30116":1265,"_20912":53860,"_5":14363,"_27402":53206,"_2946":53861},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3462":1520,"_30116":1265,"_20912":53863,"_5":14363,"_27402":53210,"_2946":53864},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3462":1521,"_30116":1265,"_20912":53866,"_5":14363,"_27402":53210,"_2946":53867},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3462":1522,"_30116":1265,"_20912":53869,"_5":14363,"_27402":53210,"_2946":53870},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3462":1523,"_30116":1265,"_20912":53872,"_5":14363,"_27402":53214,"_2946":53873},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3462":1524,"_30116":1265,"_20912":53875,"_5":14363,"_27402":53214,"_2946":53876},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3462":1525,"_30116":1265,"_20912":53878,"_5":14363,"_27402":53214,"_2946":53879},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3462":1526,"_30116":1265,"_20912":53881,"_5":14363,"_27402":53214,"_2946":53882},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3462":1527,"_30116":1265,"_20912":53884,"_5":14363,"_27402":53214,"_2946":53885},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3462":1528,"_30116":1265,"_20912":53887,"_5":14363,"_27402":53214,"_2946":53888},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3462":1529,"_30116":1265,"_20912":53890,"_5":14363,"_27402":53214,"_2946":53891},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3462":1530,"_30116":1265,"_20912":53893,"_5":14363,"_27402":53214,"_2946":53894},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3462":1531,"_30116":1265,"_20912":53896,"_5":14363,"_27402":53214,"_2946":53897},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3462":1532,"_30116":1265,"_20912":53899,"_5":14363,"_27402":53214,"_2946":53900},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3462":1533,"_30116":1265,"_20912":53902,"_5":14363,"_27402":53214,"_2946":53903},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3462":1534,"_30116":1265,"_20912":53905,"_5":14363,"_27402":53214,"_2946":53906},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3462":1535,"_30116":1265,"_20912":53908,"_5":14363,"_27402":53214,"_2946":53909},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3462":1536,"_30116":1265,"_20912":53911,"_5":14363,"_27402":53214,"_2946":53912},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3462":1537,"_30116":1265,"_20912":53914,"_5":14363,"_27402":53214,"_2946":53915},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3462":1538,"_30116":1265,"_20912":53917,"_5":14363,"_27402":53214,"_2946":53918},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3462":1539,"_30116":1265,"_20912":53920,"_5":14363,"_27402":53214,"_2946":53921},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3462":1540,"_30116":1265,"_20912":53923,"_5":14363,"_27402":53214,"_2946":53924},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3462":1541,"_30116":1265,"_20912":53926,"_5":14363,"_27402":53214,"_2946":53927},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3462":1542,"_30116":1265,"_20912":53929,"_5":14363,"_27402":53214,"_2946":53930},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3462":1543,"_30116":1265,"_20912":53932,"_5":14363,"_27402":53214,"_2946":53933},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3462":1544,"_30116":1265,"_20912":53935,"_5":14363,"_27402":53214,"_2946":53936},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3462":1545,"_30116":1265,"_20912":53938,"_5":14363,"_27402":53214,"_2946":53939},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3462":1546,"_30116":1265,"_20912":53941,"_5":14363,"_27402":53214,"_2946":53942},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3462":1547,"_30116":1547,"_5":14715,"_2946":51649,"_30468":53944,"_20912":53945,"_27402":1547},[49167,50635,51649],[],{"_3462":1548,"_30116":1547,"_20912":53947,"_5":14363,"_27402":1547,"_2946":53948},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3462":1549,"_30116":1547,"_5":30465,"_20912":53950,"_27402":53951,"_2946":53952},[],"/docs/pr-preview/pr-64/platform/iot-fleets/overview#start-here","Start here",{"_3462":1550,"_30116":1547,"_5":30465,"_20912":53954,"_27402":53955,"_2946":51647},[],"/docs/pr-preview/pr-64/platform/iot-fleets/overview#devices-and-identities",{"_3462":1551,"_30116":1547,"_5":30465,"_20912":53957,"_27402":53958,"_2946":51830},[],"/docs/pr-preview/pr-64/platform/iot-fleets/overview#enrollment-with-pki",{"_3462":1552,"_30116":1547,"_5":30465,"_20912":53960,"_27402":53961,"_2946":53111},[],"/docs/pr-preview/pr-64/platform/iot-fleets/overview#integrations",{"_3462":1553,"_30116":1547,"_5":30465,"_20912":53963,"_27402":53964,"_2946":53965},[],"/docs/pr-preview/pr-64/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3462":1554,"_30116":1547,"_20912":53967,"_5":14363,"_27402":1547,"_2946":53968},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3462":1555,"_30116":1547,"_20912":53970,"_5":14363,"_27402":53951,"_2946":53971},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3462":1556,"_30116":1547,"_20912":53973,"_5":14363,"_27402":53951,"_2946":53974},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3462":1557,"_30116":1547,"_20912":53976,"_5":14363,"_27402":53955,"_2946":53977},[],"Resource",{"_3462":1558,"_30116":1547,"_20912":53979,"_5":14363,"_27402":53955,"_2946":53980},[],"What it represents",{"_3462":1559,"_30116":1547,"_20912":53982,"_5":14363,"_27402":53955,"_2946":53983},[],"**Device**",{"_3462":1560,"_30116":1547,"_20912":53985,"_5":14363,"_27402":53955,"_2946":53986},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3462":1561,"_30116":1547,"_20912":53988,"_5":14363,"_27402":53955,"_2946":53989},[],"**Identity**",{"_3462":1562,"_30116":1547,"_20912":53991,"_5":14363,"_27402":53955,"_2946":53992},[],"The device's association with its certificates: an active version and a history.",{"_3462":1563,"_30116":1547,"_20912":53994,"_5":14363,"_27402":53955,"_2946":53995},[],"**DMS**",{"_3462":1564,"_30116":1547,"_20912":53997,"_5":14363,"_27402":53955,"_2946":53998},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3462":1565,"_30116":1547,"_20912":54000,"_5":14363,"_27402":53955,"_2946":54001},[],"**Fleet**",{"_3462":1566,"_30116":1547,"_20912":54003,"_5":14363,"_27402":53955,"_2946":54004},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3462":1567,"_30116":1547,"_20912":54006,"_5":14363,"_27402":53955,"_2946":54007},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3462":1568,"_30116":1547,"_20912":54009,"_5":14363,"_27402":53955,"_2946":54010},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3462":1569,"_30116":1547,"_20912":54012,"_5":14363,"_27402":53958,"_2946":54013},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3462":1570,"_30116":1547,"_20912":54015,"_5":14363,"_27402":53958,"_2946":54016},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3462":1571,"_30116":1547,"_20912":54018,"_5":14363,"_27402":53958,"_2946":54019},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3462":1572,"_30116":1547,"_20912":54021,"_5":14363,"_27402":53958,"_2946":54022},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3462":1573,"_30116":1547,"_20912":54024,"_5":14363,"_27402":53958,"_2946":54025},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3462":1574,"_30116":1547,"_20912":54027,"_5":14363,"_27402":53958,"_2946":54028},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3462":1575,"_30116":1547,"_20912":54030,"_5":14363,"_27402":53958,"_2946":54031},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3462":1576,"_30116":1547,"_20912":54033,"_5":14363,"_27402":53958,"_2946":54034},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3462":1577,"_30116":1547,"_20912":54036,"_5":14363,"_27402":53961,"_2946":54037},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3462":1578,"_30116":1547,"_20912":54039,"_5":14363,"_27402":53961,"_2946":54040},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3462":1579,"_30116":1547,"_20912":54042,"_5":14363,"_27402":53964,"_2946":54043},[],"Participant",{"_3462":1580,"_30116":1547,"_20912":54045,"_5":14363,"_27402":53964,"_2946":54046},[],"Responsibility",{"_3462":1581,"_30116":1547,"_20912":54048,"_5":14363,"_27402":53964,"_2946":54049},[],"PKI administrator",{"_3462":1582,"_30116":1547,"_20912":54051,"_5":14363,"_27402":53964,"_2946":54052},[],"CA, issuance profile, chain and revocation publication.",{"_3462":1583,"_30116":1547,"_20912":54054,"_5":14363,"_27402":53964,"_2946":54055},[],"Provisioning administrator",{"_3462":1584,"_30116":1547,"_20912":54057,"_5":14363,"_27402":53964,"_2946":54058},[],"DMS, admission, authentication per operation and inventory.",{"_3462":1585,"_30116":1547,"_20912":54060,"_5":14363,"_27402":53964,"_2946":54061},[],"Device integrator",{"_3462":1586,"_30116":1547,"_20912":54063,"_5":14363,"_27402":53964,"_2946":54064},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3462":1587,"_30116":1547,"_20912":54066,"_5":14363,"_27402":53964,"_2946":54067},[],"Consumer integrator",{"_3462":1588,"_30116":1547,"_20912":54069,"_5":14363,"_27402":53964,"_2946":54070},[],"Trusted issuers, validation and device permissions in the destination.",{"_3462":1589,"_30116":1547,"_20912":54072,"_5":14363,"_27402":53964,"_2946":54073},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3462":1590,"_30116":1590,"_5":14715,"_2946":54075,"_30468":54076,"_20912":54078,"_27402":1590},"Enroll and connect your first device",[49167,50635,51649,54077],"Getting started",[],{"_3462":1591,"_30116":1590,"_20912":54080,"_5":14363,"_27402":1590,"_2946":54081},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3462":1592,"_30116":1590,"_5":30465,"_20912":54083,"_27402":54084,"_2946":49177},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3462":1593,"_30116":1590,"_5":30465,"_20912":54086,"_27402":54087,"_2946":54088},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3462":1594,"_30116":1590,"_5":30465,"_20912":54090,"_27402":54091,"_2946":54092},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3462":1595,"_30116":1590,"_5":30465,"_20912":54094,"_27402":54095,"_2946":54096},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3462":1596,"_30116":1590,"_5":30465,"_20912":54098,"_27402":54099,"_2946":54100},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3462":1597,"_30116":1590,"_5":30465,"_20912":54102,"_27402":54103,"_2946":54104},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3462":1598,"_30116":1590,"_5":30465,"_20912":54106,"_27402":54107,"_2946":54108},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3462":1599,"_30116":1590,"_5":30465,"_20912":54110,"_27402":54111,"_2946":54112},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3462":1600,"_30116":1590,"_20912":54114,"_5":14363,"_27402":1590,"_2946":54115},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3462":1601,"_30116":1590,"_20912":54117,"_5":14363,"_27402":54084,"_2946":54118},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3462":1602,"_30116":1590,"_20912":54120,"_5":14363,"_27402":54084,"_2946":54121},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3462":1603,"_30116":1590,"_20912":54123,"_5":14363,"_27402":54084,"_2946":54124},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3462":1604,"_30116":1590,"_20912":54126,"_5":14363,"_27402":54084,"_2946":54127},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3462":1605,"_30116":1590,"_20912":54129,"_5":14363,"_27402":54084,"_2946":54130},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3462":1606,"_30116":1590,"_20912":54132,"_5":14363,"_27402":54087,"_2946":54133},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3462":1607,"_30116":1590,"_20912":54135,"_5":14363,"_27402":54087,"_2946":54136},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3462":1608,"_30116":1590,"_20912":54138,"_5":14363,"_27402":54091,"_2946":54139},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3462":1609,"_30116":1590,"_20912":54141,"_5":14363,"_27402":54091,"_2946":54142},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3462":1610,"_30116":1590,"_20912":54144,"_5":14363,"_27402":54091,"_2946":54145},[],"Setting",{"_3462":1611,"_30116":1590,"_20912":54147,"_5":14363,"_27402":54091,"_2946":54148},[],"Evaluation value",{"_3462":1612,"_30116":1590,"_20912":54150,"_5":14363,"_27402":54091,"_2946":54151},[],"Enrollment CA",{"_3462":1613,"_30116":1590,"_20912":54153,"_5":14363,"_27402":54091,"_2946":54154},[],"Issuing root from `device-root.pem`.",{"_3462":1614,"_30116":1590,"_20912":54156,"_5":14363,"_27402":54091,"_2946":51960},[],{"_3462":1615,"_30116":1590,"_20912":54158,"_5":14363,"_27402":54091,"_2946":54159},[],"The 1-hour leaf profile you just prepared.",{"_3462":1616,"_30116":1590,"_20912":54161,"_5":14363,"_27402":54091,"_2946":54162},[],"Protocol / Registration Mode",{"_3462":1617,"_30116":1590,"_20912":54164,"_5":14363,"_27402":54091,"_2946":54165},[],"`EST_RFC7030` / `JITP`.",{"_3462":1618,"_30116":1590,"_20912":54167,"_5":14363,"_27402":54091,"_2946":54168},[],"Verify CSR Signature",{"_3462":1619,"_30116":1590,"_20912":54170,"_5":14363,"_27402":54091,"_2946":54171},[],"Enabled.",{"_3462":1620,"_30116":1590,"_20912":54173,"_5":14363,"_27402":54091,"_2946":54174},[],"Enable Replaceable Enrollment",{"_3462":1621,"_30116":1590,"_20912":54176,"_5":14363,"_27402":54091,"_2946":54177},[],"Disabled; the ID must be new.",{"_3462":1622,"_30116":1590,"_20912":54179,"_5":14363,"_27402":54091,"_2946":54180},[],"Initial authentication",{"_3462":1623,"_30116":1590,"_20912":54182,"_5":14363,"_27402":54091,"_2946":54183},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3462":1624,"_30116":1590,"_20912":54185,"_5":14363,"_27402":54091,"_2946":54186},[],"Renewal authentication",{"_3462":1625,"_30116":1590,"_20912":54188,"_5":14363,"_27402":54091,"_2946":54189},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3462":1626,"_30116":1590,"_20912":54191,"_5":14363,"_27402":54091,"_2946":54192},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3462":1627,"_30116":1590,"_20912":54194,"_5":14363,"_27402":54091,"_2946":54195},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3462":1628,"_30116":1590,"_20912":54197,"_5":14363,"_27402":54091,"_2946":54198},[],"Re-enrollment Delta",{"_3462":1629,"_30116":1590,"_20912":54200,"_5":14363,"_27402":54091,"_2946":54201},[],"1 hour.",{"_3462":1630,"_30116":1590,"_20912":54203,"_5":14363,"_27402":54091,"_2946":54204},[],"Preventive / Critical Delta",{"_3462":1631,"_30116":1590,"_20912":54206,"_5":14363,"_27402":54091,"_2946":54207},[],"30 minutes / 10 minutes.",{"_3462":1632,"_30116":1590,"_20912":54209,"_5":14363,"_27402":54091,"_2946":54210},[],"Revoke on Re-enrollment",{"_3462":1633,"_30116":1590,"_20912":54212,"_5":14363,"_27402":54091,"_2946":54213},[],"Disabled to test the successor before retiring the previous identity.",{"_3462":1634,"_30116":1590,"_20912":54215,"_5":14363,"_27402":54091,"_2946":51968},[],{"_3462":1635,"_30116":1590,"_20912":54217,"_5":14363,"_27402":54091,"_2946":54218},[],"Disabled; the operational key is generated in the client.",{"_3462":1636,"_30116":1590,"_20912":54220,"_5":14363,"_27402":54091,"_2946":54221},[],"CA Distribution",{"_3462":1637,"_30116":1590,"_20912":54223,"_5":14363,"_27402":54091,"_2946":54224},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3462":1638,"_30116":1590,"_20912":54226,"_5":14363,"_27402":54091,"_2946":54227},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3462":1639,"_30116":1590,"_20912":54229,"_5":14363,"_27402":54095,"_2946":54230},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3462":1640,"_30116":1590,"_20912":54232,"_5":14363,"_27402":54095,"_2946":54233},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3462":1641,"_30116":1590,"_20912":54235,"_5":14363,"_27402":54099,"_2946":54236},[],"Generate a new key and CSR with the selected identifier:",{"_3462":1642,"_30116":1590,"_20912":54238,"_5":14363,"_27402":54099,"_2946":54239},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3462":1643,"_30116":1590,"_20912":54241,"_5":14363,"_27402":54099,"_2946":54242},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3462":1644,"_30116":1590,"_20912":54244,"_5":14363,"_27402":54103,"_2946":54245},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3462":1645,"_30116":1590,"_20912":54247,"_5":14363,"_27402":54103,"_2946":54248},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3462":1646,"_30116":1590,"_20912":54250,"_5":14363,"_27402":54107,"_2946":54251},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3462":1647,"_30116":1590,"_20912":54253,"_5":14363,"_27402":54107,"_2946":54254},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3462":1648,"_30116":1590,"_20912":54256,"_5":14363,"_27402":54107,"_2946":54257},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3462":1649,"_30116":1590,"_20912":54259,"_5":14363,"_27402":54107,"_2946":54260},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3462":1650,"_30116":1590,"_20912":54262,"_5":14363,"_27402":54107,"_2946":54263},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3462":1651,"_30116":1590,"_20912":54265,"_5":14363,"_27402":54111,"_2946":54266},[],"Check",{"_3462":1652,"_30116":1590,"_20912":54268,"_5":14363,"_27402":54111,"_2946":54269},[],"Expected result",{"_3462":1653,"_30116":1590,"_20912":54271,"_5":14363,"_27402":54111,"_2946":54272},[],"Registration",{"_3462":1654,"_30116":1590,"_20912":54274,"_5":14363,"_27402":54111,"_2946":54275},[],"ID created automatically and correct DMS.",{"_3462":1655,"_30116":1590,"_20912":54277,"_5":14363,"_27402":54111,"_2946":53533},[],{"_3462":1656,"_30116":1590,"_20912":54279,"_5":14363,"_27402":54111,"_2946":54280},[],"CN, profile, serial and key verified.",{"_3462":1657,"_30116":1590,"_20912":54282,"_5":14363,"_27402":54111,"_2946":54283},[],"Inventory",{"_3462":1658,"_30116":1590,"_20912":54285,"_5":14363,"_27402":54111,"_2946":54286},[],"Received serial visible as the current identity and in history.",{"_3462":1659,"_30116":1590,"_20912":54288,"_5":14363,"_27402":54111,"_2946":54289},[],"Consumer",{"_3462":1660,"_30116":1590,"_20912":54291,"_5":14363,"_27402":54111,"_2946":54292},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3462":1661,"_30116":1590,"_20912":54294,"_5":14363,"_27402":54111,"_2946":54295},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3462":1662,"_30116":1590,"_20912":54297,"_5":14363,"_27402":54111,"_2946":54298},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3462":1663,"_30116":1663,"_5":14715,"_2946":51665,"_30468":54300,"_20912":54301,"_27402":1663},[49167,50635,51649,54077],[],{"_3462":1664,"_30116":1663,"_20912":54303,"_5":14363,"_27402":1663,"_2946":54304},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3462":1665,"_30116":1663,"_5":30465,"_20912":54306,"_27402":54307,"_2946":49177},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3462":1666,"_30116":1663,"_5":30465,"_20912":54309,"_27402":54310,"_2946":54311},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3462":1667,"_30116":1663,"_5":30465,"_20912":54313,"_27402":54314,"_2946":54315},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3462":1668,"_30116":1663,"_5":30465,"_20912":54317,"_27402":54318,"_2946":54319},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3462":1669,"_30116":1663,"_5":30465,"_20912":54321,"_27402":54322,"_2946":54323},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3462":1670,"_30116":1663,"_5":30465,"_20912":54325,"_27402":54326,"_2946":54327},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3462":1671,"_30116":1663,"_5":30465,"_20912":54329,"_27402":54330,"_2946":54269},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3462":1672,"_30116":1663,"_5":30465,"_20912":54332,"_27402":54333,"_2946":54334},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3462":1673,"_30116":1663,"_5":30465,"_20912":54336,"_27402":54337,"_2946":54338},[],"/docs/pr-preview/pr-64/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3462":1674,"_30116":1663,"_20912":54340,"_5":14363,"_27402":1663,"_2946":54341},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3462":1675,"_30116":1663,"_20912":54343,"_5":14363,"_27402":1663,"_2946":54344},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3462":1676,"_30116":1663,"_20912":54346,"_5":14363,"_27402":54307,"_2946":54347},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3462":1677,"_30116":1663,"_20912":54349,"_5":14363,"_27402":54307,"_2946":54350},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3462":1678,"_30116":1663,"_20912":54352,"_5":14363,"_27402":54307,"_2946":54353},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3462":1679,"_30116":1663,"_20912":54355,"_5":14363,"_27402":54307,"_2946":54356},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3462":1680,"_30116":1663,"_20912":54358,"_5":14363,"_27402":54310,"_2946":54359},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3462":1681,"_30116":1663,"_20912":54361,"_5":14363,"_27402":54310,"_2946":54362},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3462":1682,"_30116":1663,"_20912":54364,"_5":14363,"_27402":54310,"_2946":54365},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3462":1683,"_30116":1663,"_20912":54367,"_5":14363,"_27402":54310,"_2946":54368},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3462":1684,"_30116":1663,"_20912":54370,"_5":14363,"_27402":54310,"_2946":54371},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3462":1685,"_30116":1663,"_20912":54373,"_5":14363,"_27402":54310,"_2946":54374},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3462":1686,"_30116":1663,"_20912":54376,"_5":14363,"_27402":54310,"_2946":54377},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3462":1687,"_30116":1663,"_20912":54379,"_5":14363,"_27402":54310,"_2946":54380},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3462":1688,"_30116":1663,"_20912":54382,"_5":14363,"_27402":54314,"_2946":54383},[],"Open **Managed Devices** and the registration action. Complete:",{"_3462":1689,"_30116":1663,"_20912":54385,"_5":14363,"_27402":54314,"_2946":54386},[],"**Device ID**: `device-001`.",{"_3462":1690,"_30116":1663,"_20912":54388,"_5":14363,"_27402":54314,"_2946":54389},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3462":1691,"_30116":1663,"_20912":54391,"_5":14363,"_27402":54314,"_2946":54392},[],"**Icon** and **Tags**: optional classification.",{"_3462":1692,"_30116":1663,"_20912":54394,"_5":14363,"_27402":54314,"_2946":54395},[],"Confirm registration.",{"_3462":1693,"_30116":1663,"_20912":54397,"_5":14363,"_27402":54318,"_2946":54398},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3462":1694,"_30116":1663,"_20912":54400,"_5":14363,"_27402":54318,"_2946":54401},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3462":1695,"_30116":1663,"_20912":54403,"_5":14363,"_27402":54322,"_2946":54404},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3462":1696,"_30116":1663,"_20912":54406,"_5":14363,"_27402":54322,"_2946":54407},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3462":1697,"_30116":1663,"_20912":54409,"_5":14363,"_27402":54326,"_2946":54410},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3462":1698,"_30116":1663,"_20912":54412,"_5":14363,"_27402":54326,"_2946":54413},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3462":1699,"_30116":1663,"_20912":54415,"_5":14363,"_27402":54330,"_2946":54266},[],{"_3462":1700,"_30116":1663,"_20912":54417,"_5":14363,"_27402":54330,"_2946":54418},[],"Result",{"_3462":1701,"_30116":1663,"_20912":54420,"_5":14363,"_27402":54330,"_2946":53516},[],{"_3462":1702,"_30116":1663,"_20912":54422,"_5":14363,"_27402":54330,"_2946":54423},[],"`device-001` appears in inventory with the expected DMS.",{"_3462":1703,"_30116":1663,"_20912":54425,"_5":14363,"_27402":54330,"_2946":54426},[],"Current identity",{"_3462":1704,"_30116":1663,"_20912":54428,"_5":14363,"_27402":54330,"_2946":54429},[],"The associated certificate matches the one you verified in PKI.",{"_3462":1705,"_30116":1663,"_20912":54431,"_5":14363,"_27402":54330,"_2946":54432},[],"History",{"_3462":1706,"_30116":1663,"_20912":54434,"_5":14363,"_27402":54330,"_2946":54435},[],"The associated issuance appears with its serial number and dates.",{"_3462":1707,"_30116":1663,"_20912":54437,"_5":14363,"_27402":54330,"_2946":54438},[],"Key and certificate",{"_3462":1708,"_30116":1663,"_20912":54440,"_5":14363,"_27402":54330,"_2946":54441},[],"You have the verified pair ready to install on the device.",{"_3462":1709,"_30116":1663,"_20912":54443,"_5":14363,"_27402":54333,"_2946":54444},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3462":1710,"_30116":1663,"_20912":54446,"_5":14363,"_27402":54333,"_2946":54447},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3462":1711,"_30116":1663,"_20912":54449,"_5":14363,"_27402":54333,"_2946":54450},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3462":1712,"_30116":1663,"_20912":54452,"_5":14363,"_27402":54333,"_2946":54453},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3462":1713,"_30116":1663,"_20912":54455,"_5":14363,"_27402":54337,"_2946":54456},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3462":1714,"_30116":1663,"_20912":54458,"_5":14363,"_27402":54337,"_2946":54459},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3462":1715,"_30116":1663,"_20912":54461,"_5":14363,"_27402":54337,"_2946":54462},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3462":1716,"_30116":1716,"_5":14715,"_2946":54464,"_30468":54465,"_20912":54466,"_27402":1716},"Lamassu IoT Platform",[49167,50635],[],{"_3462":1717,"_30116":1716,"_20912":54468,"_5":14363,"_27402":1716,"_2946":54469},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3462":1718,"_30116":1716,"_5":30465,"_20912":54471,"_27402":54472,"_2946":53952},[],"/docs/pr-preview/pr-64/platform/overview#start-here",{"_3462":1719,"_30116":1716,"_5":30465,"_20912":54474,"_27402":54475,"_2946":54476},[],"/docs/pr-preview/pr-64/platform/overview#choose-your-path","Choose your path",{"_3462":1720,"_30116":1716,"_5":30465,"_20912":54478,"_27402":54479,"_2946":54480},[],"/docs/pr-preview/pr-64/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3462":1721,"_30116":1716,"_5":30465,"_20912":54482,"_27402":54483,"_2946":54484},[],"/docs/pr-preview/pr-64/platform/overview#core-capabilities","Core capabilities",{"_3462":1722,"_30116":1716,"_5":30465,"_20912":54486,"_27402":54487,"_2946":54488},[],"/docs/pr-preview/pr-64/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3462":1723,"_30116":1716,"_5":30465,"_20912":54490,"_27402":54491,"_2946":54492},[],"/docs/pr-preview/pr-64/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3462":1724,"_30116":1716,"_5":30465,"_20912":54494,"_27402":54495,"_2946":54496},[],"/docs/pr-preview/pr-64/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3462":1725,"_30116":1716,"_5":30465,"_20912":54498,"_27402":54499,"_2946":54500},[],"/docs/pr-preview/pr-64/platform/overview#automate-device-identities","Automate device identities",{"_3462":1726,"_30116":1716,"_5":30465,"_20912":54502,"_27402":54503,"_2946":54504},[],"/docs/pr-preview/pr-64/platform/overview#publish-validation-status","Publish validation status",{"_3462":1727,"_30116":1716,"_5":30465,"_20912":54506,"_27402":54507,"_2946":54508},[],"/docs/pr-preview/pr-64/platform/overview#react-to-events","React to events",{"_3462":1728,"_30116":1716,"_5":30465,"_20912":54510,"_27402":54511,"_2946":54512},[],"/docs/pr-preview/pr-64/platform/overview#operational-reference","Operational reference",{"_3462":1729,"_30116":1716,"_20912":54514,"_5":14363,"_27402":1716,"_2946":54515},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3462":1730,"_30116":1716,"_20912":54517,"_5":14363,"_27402":54472,"_2946":54518},[],"Choose the result you need:",{"_3462":1731,"_30116":1716,"_20912":54520,"_5":14363,"_27402":54472,"_2946":54521},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3462":1732,"_30116":1716,"_20912":54523,"_5":14363,"_27402":54472,"_2946":54524},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3462":1733,"_30116":1716,"_20912":54526,"_5":14363,"_27402":54472,"_2946":54527},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3462":1734,"_30116":1716,"_20912":54529,"_5":14363,"_27402":54475,"_2946":54530},[],"Section",{"_3462":1735,"_30116":1716,"_20912":54532,"_5":14363,"_27402":54475,"_2946":54533},[],"What you manage",{"_3462":1736,"_30116":1716,"_20912":54535,"_5":14363,"_27402":54475,"_2946":54536},[],"Entry point",{"_3462":1737,"_30116":1716,"_20912":54538,"_5":14363,"_27402":54475,"_2946":54539},[],"**PKI**",{"_3462":1738,"_30116":1716,"_20912":54541,"_5":14363,"_27402":54475,"_2946":54542},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3462":1739,"_30116":1716,"_20912":54544,"_5":14363,"_27402":54475,"_2946":54545},[],"PKI overview",{"_3462":1740,"_30116":1716,"_20912":54547,"_5":14363,"_27402":54475,"_2946":54548},[],"**IoT Fleets**",{"_3462":1741,"_30116":1716,"_20912":54550,"_5":14363,"_27402":54475,"_2946":54551},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3462":1742,"_30116":1716,"_20912":54553,"_5":14363,"_27402":54475,"_2946":54554},[],"IoT Fleets overview",{"_3462":1743,"_30116":1716,"_20912":54556,"_5":14363,"_27402":54475,"_2946":54557},[],"**Administration**",{"_3462":1744,"_30116":1716,"_20912":54559,"_5":14363,"_27402":54475,"_2946":54560},[],"Operator permissions, audit and event subscriptions.",{"_3462":1745,"_30116":1716,"_20912":54562,"_5":14363,"_27402":54475,"_2946":50633},[],{"_3462":1746,"_30116":1716,"_20912":54564,"_5":14363,"_27402":54475,"_2946":54565},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3462":1747,"_30116":1716,"_20912":54567,"_5":14363,"_27402":54479,"_2946":54568},[],"An identity's journey connects four responsibilities:",{"_3462":1748,"_30116":1716,"_20912":54570,"_5":14363,"_27402":54479,"_2946":54571},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3462":1749,"_30116":1716,"_20912":54573,"_5":14363,"_27402":54479,"_2946":54574},[],"The provisioning administrator configures the DMS and initial trust.",{"_3462":1750,"_30116":1716,"_20912":54576,"_5":14363,"_27402":54479,"_2946":54577},[],"The device client requests a certificate and installs it with the matching key.",{"_3462":1751,"_30116":1716,"_20912":54579,"_5":14363,"_27402":54479,"_2946":54580},[],"The consumer validates the identity and applies its access permissions.",{"_3462":1752,"_30116":1716,"_20912":54582,"_5":14363,"_27402":54479,"_2946":54583},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3462":1753,"_30116":1716,"_20912":54585,"_5":14363,"_27402":54487,"_2946":54586},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3462":1754,"_30116":1716,"_20912":54588,"_5":14363,"_27402":54491,"_2946":54589},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3462":1755,"_30116":1716,"_20912":54591,"_5":14363,"_27402":54495,"_2946":54592},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3462":1756,"_30116":1716,"_20912":54594,"_5":14363,"_27402":54499,"_2946":54595},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3462":1757,"_30116":1716,"_20912":54597,"_5":14363,"_27402":54503,"_2946":54598},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3462":1758,"_30116":1716,"_20912":54600,"_5":14363,"_27402":54507,"_2946":54601},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3462":1759,"_30116":1716,"_20912":54603,"_5":14363,"_27402":54511,"_2946":54046},[],{"_3462":1760,"_30116":1716,"_20912":54605,"_5":14363,"_27402":54511,"_2946":54606},[],"What it prepares or checks",{"_3462":1761,"_30116":1716,"_20912":54608,"_5":14363,"_27402":54511,"_2946":54049},[],{"_3462":1762,"_30116":1716,"_20912":54610,"_5":14363,"_27402":54511,"_2946":54611},[],"Key custody, CA hierarchy, profiles and validation.",{"_3462":1763,"_30116":1716,"_20912":54613,"_5":14363,"_27402":54511,"_2946":54614},[],"Fleet administrator",{"_3462":1764,"_30116":1716,"_20912":54616,"_5":14363,"_27402":54511,"_2946":54617},[],"DMS, device admission, renewal policy and inventory.",{"_3462":1765,"_30116":1716,"_20912":54619,"_5":14363,"_27402":54511,"_2946":54061},[],{"_3462":1766,"_30116":1716,"_20912":54621,"_5":14363,"_27402":54511,"_2946":54622},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3462":1767,"_30116":1716,"_20912":54624,"_5":14363,"_27402":54511,"_2946":54067},[],{"_3462":1768,"_30116":1716,"_20912":54626,"_5":14363,"_27402":54511,"_2946":54627},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3462":1769,"_30116":1716,"_20912":54629,"_5":14363,"_27402":54511,"_2946":54630},[],"Infrastructure operator",{"_3462":1770,"_30116":1716,"_20912":54632,"_5":14363,"_27402":54511,"_2946":54633},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3462":1771,"_30116":1716,"_20912":54635,"_5":14363,"_27402":54511,"_2946":54636},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3462":1772,"_30116":1772,"_5":14715,"_2946":54638,"_30468":54639,"_20912":54642,"_27402":1772},"CA hierarchy and rotation",[49167,50635,54640,54641],"PKI","Keys, authorities and certificates",[],{"_3462":1773,"_30116":1772,"_20912":54644,"_5":14363,"_27402":1772,"_2946":54645},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3462":1774,"_30116":1772,"_5":30465,"_20912":54647,"_27402":54648,"_2946":54649},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3462":1775,"_30116":1772,"_5":30465,"_20912":54651,"_27402":54652,"_2946":54653},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3462":1776,"_30116":1772,"_5":30465,"_20912":54655,"_27402":54656,"_2946":54657},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3462":1777,"_30116":1772,"_5":30465,"_20912":54659,"_27402":54660,"_2946":54661},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3462":1778,"_30116":1772,"_5":30465,"_20912":54663,"_27402":54664,"_2946":54665},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3462":1779,"_30116":1772,"_5":30465,"_20912":54667,"_27402":54668,"_2946":54669},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3462":1780,"_30116":1772,"_5":30465,"_20912":54671,"_27402":54672,"_2946":54673},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3462":1781,"_30116":1772,"_5":30465,"_20912":54675,"_27402":54676,"_2946":54677},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3462":1782,"_30116":1772,"_5":30465,"_20912":54679,"_27402":54680,"_2946":54681},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3462":1783,"_30116":1772,"_5":30465,"_20912":54683,"_27402":54684,"_2946":54685},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3462":1784,"_30116":1772,"_5":30465,"_20912":54687,"_27402":54688,"_2946":54689},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3462":1785,"_30116":1772,"_5":30465,"_20912":54691,"_27402":54692,"_2946":54693},[],"/docs/pr-preview/pr-64/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3462":1786,"_30116":1772,"_20912":54695,"_5":14363,"_27402":1772,"_2946":54696},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3462":1787,"_30116":1772,"_20912":54698,"_5":14363,"_27402":1772,"_2946":54699},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3462":1788,"_30116":1772,"_20912":54701,"_5":14363,"_27402":54648,"_2946":54702},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3462":1789,"_30116":1772,"_20912":54704,"_5":14363,"_27402":54648,"_2946":54705},[],"environment, such as production and preproduction;",{"_3462":1790,"_30116":1772,"_20912":54707,"_5":14363,"_27402":54648,"_2946":54708},[],"owner or operating team;",{"_3462":1791,"_30116":1772,"_20912":54710,"_5":14363,"_27402":54648,"_2946":54711},[],"device family or manufacturing process;",{"_3462":1792,"_30116":1772,"_20912":54713,"_5":14363,"_27402":54648,"_2946":54714},[],"region or regulatory requirement;",{"_3462":1793,"_30116":1772,"_20912":54716,"_5":14363,"_27402":54648,"_2946":54717},[],"cryptographic engine or key policy;",{"_3462":1794,"_30116":1772,"_20912":54719,"_5":14363,"_27402":54648,"_2946":54720},[],"maintenance window and renewal cadence.",{"_3462":1795,"_30116":1772,"_20912":54722,"_5":14363,"_27402":54648,"_2946":54723},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3462":1796,"_30116":1772,"_20912":54725,"_5":14363,"_27402":54648,"_2946":54726},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3462":1797,"_30116":1772,"_20912":54728,"_5":14363,"_27402":54652,"_2946":54729},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3462":1798,"_30116":1772,"_20912":54731,"_5":14363,"_27402":54652,"_2946":54732},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3462":1799,"_30116":1772,"_20912":54734,"_5":14363,"_27402":54652,"_2946":54735},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3462":1800,"_30116":1772,"_20912":54737,"_5":14363,"_27402":54652,"_2946":54738},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3462":1801,"_30116":1772,"_20912":54740,"_5":14363,"_27402":54656,"_2946":54741},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3462":1802,"_30116":1772,"_20912":54743,"_5":14363,"_27402":54656,"_2946":54744},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3462":1803,"_30116":1772,"_20912":54746,"_5":14363,"_27402":54656,"_2946":54747},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3462":1804,"_30116":1772,"_20912":54749,"_5":14363,"_27402":54656,"_2946":54750},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3462":1805,"_30116":1772,"_20912":54752,"_5":14363,"_27402":54664,"_2946":54753},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3462":1806,"_30116":1772,"_20912":54755,"_5":14363,"_27402":54668,"_2946":54756},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3462":1807,"_30116":1772,"_20912":54758,"_5":14363,"_27402":54672,"_2946":54759},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3462":1808,"_30116":1772,"_20912":54761,"_5":14363,"_27402":54676,"_2946":54762},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3462":1809,"_30116":1772,"_20912":54764,"_5":14363,"_27402":54680,"_2946":54765},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3462":1810,"_30116":1772,"_20912":54767,"_5":14363,"_27402":54684,"_2946":54768},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3462":1811,"_30116":1772,"_20912":54770,"_5":14363,"_27402":54688,"_2946":54771},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3462":1812,"_30116":1772,"_20912":54773,"_5":14363,"_27402":54688,"_2946":54774},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3462":1813,"_30116":1772,"_20912":54776,"_5":14363,"_27402":54688,"_2946":54777},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3462":1814,"_30116":1772,"_20912":54779,"_5":14363,"_27402":54688,"_2946":54780},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3462":1815,"_30116":1772,"_20912":54782,"_5":14363,"_27402":54692,"_2946":54783},[],"The new chain ends in an anchor installed by the consumer.",{"_3462":1816,"_30116":1772,"_20912":54785,"_5":14363,"_27402":54692,"_2946":54786},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3462":1817,"_30116":1772,"_20912":54788,"_5":14363,"_27402":54692,"_2946":54789},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3462":1818,"_30116":1772,"_20912":54791,"_5":14363,"_27402":54692,"_2946":54792},[],"Re-enrollment accepts the old identity during the planned period.",{"_3462":1819,"_30116":1772,"_20912":54794,"_5":14363,"_27402":54692,"_2946":54795},[],"OCSP and CRL respond for the authorities that remain active.",{"_3462":1820,"_30116":1772,"_20912":54797,"_5":14363,"_27402":54692,"_2946":54798},[],"No DMS is left accidentally issuing from the old CA.",{"_3462":1821,"_30116":1772,"_20912":54800,"_5":14363,"_27402":54692,"_2946":54801},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3462":1822,"_30116":1822,"_5":14715,"_2946":54803,"_30468":54804,"_20912":54805,"_27402":1822},"Certification authorities",[49167,50635,54640,54641],[],{"_3462":1823,"_30116":1822,"_20912":54807,"_5":14363,"_27402":1822,"_2946":54808},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3462":1824,"_30116":1822,"_5":30465,"_20912":54810,"_27402":54811,"_2946":54812},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3462":1825,"_30116":1822,"_5":30465,"_20912":54814,"_27402":54815,"_2946":54816},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3462":1826,"_30116":1822,"_5":30465,"_20912":54818,"_27402":54819,"_2946":49177},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#before-you-begin",{"_3462":1827,"_30116":1822,"_5":30465,"_20912":54821,"_27402":54822,"_2946":54823},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3462":1828,"_30116":1822,"_5":30465,"_20912":54825,"_27402":54826,"_2946":54827},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3462":1829,"_30116":1822,"_5":30465,"_20912":54829,"_27402":54830,"_2946":54831},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3462":1830,"_30116":1822,"_5":30465,"_20912":54833,"_27402":54834,"_2946":54835},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3462":1831,"_30116":1822,"_5":30465,"_20912":54837,"_27402":54838,"_2946":54839},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3462":1832,"_30116":1822,"_5":30465,"_20912":54841,"_27402":54842,"_2946":54843},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3462":1833,"_30116":1822,"_5":30465,"_20912":54845,"_27402":54846,"_2946":54847},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3462":1834,"_30116":1822,"_5":30465,"_20912":54849,"_27402":54850,"_2946":54851},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3462":1835,"_30116":1822,"_5":30465,"_20912":54853,"_27402":54854,"_2946":54855},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3462":1836,"_30116":1822,"_5":30465,"_20912":54857,"_27402":54858,"_2946":54859},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3462":1837,"_30116":1822,"_5":30465,"_20912":54861,"_27402":54862,"_2946":54863},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3462":1838,"_30116":1822,"_5":30465,"_20912":54865,"_27402":54866,"_2946":54867},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3462":1839,"_30116":1822,"_5":30465,"_20912":54869,"_27402":54870,"_2946":54871},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3462":1840,"_30116":1822,"_5":30465,"_20912":54873,"_27402":54874,"_2946":54875},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3462":1841,"_30116":1822,"_5":30465,"_20912":54877,"_27402":54878,"_2946":54879},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3462":1842,"_30116":1822,"_5":30465,"_20912":54881,"_27402":54882,"_2946":54883},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3462":1843,"_30116":1822,"_5":30465,"_20912":54885,"_27402":54886,"_2946":54887},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3462":1844,"_30116":1822,"_5":30465,"_20912":54889,"_27402":54890,"_2946":54891},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3462":1845,"_30116":1822,"_5":30465,"_20912":54893,"_27402":54894,"_2946":54895},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3462":1846,"_30116":1822,"_5":30465,"_20912":54897,"_27402":54898,"_2946":54899},[],"/docs/pr-preview/pr-64/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3462":1847,"_30116":1822,"_20912":54901,"_5":14363,"_27402":1822,"_2946":54902},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3462":1848,"_30116":1822,"_20912":54904,"_5":14363,"_27402":1822,"_2946":54905},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3462":1849,"_30116":1822,"_20912":54907,"_5":14363,"_27402":1822,"_2946":54908},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3462":1850,"_30116":1822,"_20912":54910,"_5":14363,"_27402":54811,"_2946":54911},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3462":1851,"_30116":1822,"_20912":54913,"_5":14363,"_27402":54811,"_2946":54914},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3462":1852,"_30116":1822,"_20912":54916,"_5":14363,"_27402":54811,"_2946":54917},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3462":1853,"_30116":1822,"_20912":54919,"_5":14363,"_27402":54811,"_2946":54920},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3462":1854,"_30116":1822,"_20912":54922,"_5":14363,"_27402":54811,"_2946":54923},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3462":1855,"_30116":1822,"_20912":54925,"_5":14363,"_27402":54819,"_2946":54926},[],"Decide whether the CA will be a root or an intermediate.",{"_3462":1856,"_30116":1822,"_20912":54928,"_5":14363,"_27402":54819,"_2946":54929},[],"Choose the engine that will keep the key.",{"_3462":1857,"_30116":1822,"_20912":54931,"_5":14363,"_27402":54819,"_2946":54932},[],"Define a validity longer than that of the certificates it will issue.",{"_3462":1858,"_30116":1822,"_20912":54934,"_5":14363,"_27402":54819,"_2946":54935},[],"For an intermediate CA, make sure the parent CA is active.",{"_3462":1859,"_30116":1822,"_20912":54937,"_5":14363,"_27402":54822,"_2946":54938},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3462":1860,"_30116":1822,"_20912":54940,"_5":14363,"_27402":54826,"_2946":54941},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3462":1861,"_30116":1822,"_20912":54943,"_5":14363,"_27402":54826,"_2946":54944},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3462":1862,"_30116":1822,"_20912":54946,"_5":14363,"_27402":54830,"_2946":54947},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3462":1863,"_30116":1822,"_20912":54949,"_5":14363,"_27402":54834,"_2946":54950},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3462":1864,"_30116":1822,"_20912":54952,"_5":14363,"_27402":54834,"_2946":54953},[],"`C`: two-letter ISO 3166-1 country code.",{"_3462":1865,"_30116":1822,"_20912":54955,"_5":14363,"_27402":54834,"_2946":54956},[],"`ST`: state or province.",{"_3462":1866,"_30116":1822,"_20912":54958,"_5":14363,"_27402":54834,"_2946":54959},[],"`L`: locality.",{"_3462":1867,"_30116":1822,"_20912":54961,"_5":14363,"_27402":54834,"_2946":54962},[],"`O`: organization.",{"_3462":1868,"_30116":1822,"_20912":54964,"_5":14363,"_27402":54834,"_2946":54965},[],"`OU`: organizational unit.",{"_3462":1869,"_30116":1822,"_20912":54967,"_5":14363,"_27402":54834,"_2946":54968},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3462":1870,"_30116":1822,"_20912":54970,"_5":14363,"_27402":54838,"_2946":54971},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3462":1871,"_30116":1822,"_20912":54973,"_5":14363,"_27402":54838,"_2946":54974},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3462":1872,"_30116":1822,"_20912":54976,"_5":14363,"_27402":54842,"_2946":54977},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3462":1873,"_30116":1822,"_20912":54979,"_5":14363,"_27402":54842,"_2946":54980},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3462":1874,"_30116":1822,"_20912":54982,"_5":14363,"_27402":54846,"_2946":54983},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3462":1875,"_30116":1822,"_20912":54985,"_5":14363,"_27402":54846,"_2946":54986},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3462":1876,"_30116":1822,"_20912":54988,"_5":14363,"_27402":54850,"_2946":54989},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3462":1877,"_30116":1822,"_20912":54991,"_5":14363,"_27402":54850,"_2946":54992},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3462":1878,"_30116":1822,"_20912":54994,"_5":14363,"_27402":54850,"_2946":54995},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3462":1879,"_30116":1822,"_20912":54997,"_5":14363,"_27402":54854,"_2946":54998},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3462":1880,"_30116":1822,"_20912":55000,"_5":14363,"_27402":54858,"_2946":55001},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3462":1881,"_30116":1822,"_20912":55003,"_5":14363,"_27402":54858,"_2946":55004},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3462":1882,"_30116":1822,"_20912":55006,"_5":14363,"_27402":54862,"_2946":55007},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3462":1883,"_30116":1822,"_20912":55009,"_5":14363,"_27402":54866,"_2946":55010},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3462":1884,"_30116":1822,"_20912":55012,"_5":14363,"_27402":54866,"_2946":55013},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3462":1885,"_30116":1822,"_20912":55015,"_5":14363,"_27402":54870,"_2946":55016},[],"Open a CA from the inventory to review:",{"_3462":1886,"_30116":1822,"_20912":55018,"_5":14363,"_27402":54870,"_2946":55019},[],"Status and validity period.",{"_3462":1887,"_30116":1822,"_20912":55021,"_5":14363,"_27402":54870,"_2946":55022},[],"Certificate and chain in PEM format.",{"_3462":1888,"_30116":1822,"_20912":55024,"_5":14363,"_27402":54870,"_2946":55025},[],"Number of active, expired and revoked certificates.",{"_3462":1889,"_30116":1822,"_20912":55027,"_5":14363,"_27402":54870,"_2946":55028},[],"Certificates issued in **Issued Certificates**.",{"_3462":1890,"_30116":1822,"_20912":55030,"_5":14363,"_27402":54870,"_2946":55031},[],"The CRL linked to the authority.",{"_3462":1891,"_30116":1822,"_20912":55033,"_5":14363,"_27402":54870,"_2946":55034},[],"Metadata and the associated cryptographic engine.",{"_3462":1892,"_30116":1822,"_20912":55036,"_5":14363,"_27402":54870,"_2946":55037},[],"You can filter the inventory by name, status and CA type.",{"_3462":1893,"_30116":1822,"_20912":55039,"_5":14363,"_27402":54874,"_2946":55040},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3462":1894,"_30116":1822,"_20912":55042,"_5":14363,"_27402":54874,"_2946":55043},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3462":1895,"_30116":1822,"_20912":55045,"_5":14363,"_27402":54874,"_2946":55046},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3462":1896,"_30116":1822,"_20912":55048,"_5":14363,"_27402":54874,"_2946":55049},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3462":1897,"_30116":1822,"_20912":55051,"_5":14363,"_27402":54878,"_2946":55052},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3462":1898,"_30116":1822,"_20912":55054,"_5":14363,"_27402":54882,"_2946":55055},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3462":1899,"_30116":1822,"_20912":55057,"_5":14363,"_27402":54886,"_2946":55058},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3462":1900,"_30116":1822,"_20912":55060,"_5":14363,"_27402":54890,"_2946":55061},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3462":1901,"_30116":1822,"_20912":55063,"_5":14363,"_27402":54894,"_2946":55064},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3462":1902,"_30116":1822,"_20912":55066,"_5":14363,"_27402":54898,"_2946":55067},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3462":1903,"_30116":1822,"_20912":55069,"_5":14363,"_27402":54898,"_2946":55070},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3462":1904,"_30116":1822,"_20912":55072,"_5":14363,"_27402":54898,"_2946":55073},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3462":1905,"_30116":1905,"_5":14715,"_2946":55075,"_30468":55076,"_20912":55077,"_27402":1905},"Certificate profiles",[49167,50635,54640,54641],[],{"_3462":1906,"_30116":1905,"_20912":55079,"_5":14363,"_27402":1905,"_2946":55080},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3462":1907,"_30116":1905,"_5":30465,"_20912":55082,"_27402":55083,"_2946":55084},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3462":1908,"_30116":1905,"_5":30465,"_20912":55086,"_27402":55087,"_2946":55088},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#validity","Validity",{"_3462":1909,"_30116":1905,"_5":30465,"_20912":55090,"_27402":55091,"_2946":55092},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3462":1910,"_30116":1905,"_5":30465,"_20912":55094,"_27402":55095,"_2946":55096},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3462":1911,"_30116":1905,"_5":30465,"_20912":55098,"_27402":55099,"_2946":55100},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#subject","Subject",{"_3462":1912,"_30116":1905,"_5":30465,"_20912":55102,"_27402":55103,"_2946":55104},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3462":1913,"_30116":1905,"_5":30465,"_20912":55106,"_27402":55107,"_2946":55108},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3462":1914,"_30116":1905,"_5":30465,"_20912":55110,"_27402":55111,"_2946":55112},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3462":1915,"_30116":1905,"_5":30465,"_20912":55114,"_27402":55115,"_2946":55116},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3462":1916,"_30116":1905,"_5":30465,"_20912":55118,"_27402":55119,"_2946":55120},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3462":1917,"_30116":1905,"_5":30465,"_20912":55122,"_27402":55123,"_2946":55124},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3462":1918,"_30116":1905,"_5":30465,"_20912":55126,"_27402":55127,"_2946":55128},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3462":1919,"_30116":1905,"_5":30465,"_20912":55130,"_27402":55131,"_2946":55132},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3462":1920,"_30116":1905,"_5":30465,"_20912":55134,"_27402":55135,"_2946":55136},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3462":1921,"_30116":1905,"_5":30465,"_20912":55138,"_27402":55139,"_2946":55140},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#design-examples","Design examples",{"_3462":1922,"_30116":1905,"_5":30465,"_20912":55142,"_27402":55143,"_2946":55144},[],"/docs/pr-preview/pr-64/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3462":1923,"_30116":1905,"_20912":55146,"_5":14363,"_27402":1905,"_2946":55147},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3462":1924,"_30116":1905,"_20912":55149,"_5":14363,"_27402":1905,"_2946":55150},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3462":1925,"_30116":1905,"_20912":55152,"_5":14363,"_27402":55087,"_2946":55153},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3462":1926,"_30116":1905,"_20912":55155,"_5":14363,"_27402":55087,"_2946":55156},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3462":1927,"_30116":1905,"_20912":55158,"_5":14363,"_27402":55091,"_2946":55159},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3462":1928,"_30116":1905,"_20912":55161,"_5":14363,"_27402":55095,"_2946":55162},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3462":1929,"_30116":1905,"_20912":55164,"_5":14363,"_27402":55095,"_2946":55165},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3462":1930,"_30116":1905,"_20912":55167,"_5":14363,"_27402":55095,"_2946":55168},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3462":1931,"_30116":1905,"_20912":55170,"_5":14363,"_27402":55099,"_2946":55171},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3462":1932,"_30116":1905,"_20912":55173,"_5":14363,"_27402":55103,"_2946":55174},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3462":1933,"_30116":1905,"_20912":55176,"_5":14363,"_27402":55103,"_2946":55177},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3462":1934,"_30116":1905,"_20912":55179,"_5":14363,"_27402":55107,"_2946":55180},[],"The cryptographic enforcement can:",{"_3462":1935,"_30116":1905,"_20912":55182,"_5":14363,"_27402":55107,"_2946":55183},[],"allow or block RSA keys;",{"_3462":1936,"_30116":1905,"_20912":55185,"_5":14363,"_27402":55107,"_2946":55186},[],"limit the supported RSA sizes;",{"_3462":1937,"_30116":1905,"_20912":55188,"_5":14363,"_27402":55107,"_2946":55189},[],"allow or block ECDSA keys;",{"_3462":1938,"_30116":1905,"_20912":55191,"_5":14363,"_27402":55107,"_2946":55192},[],"limit the supported ECDSA sizes or curves.",{"_3462":1939,"_30116":1905,"_20912":55194,"_5":14363,"_27402":55107,"_2946":55195},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3462":1940,"_30116":1905,"_20912":55197,"_5":14363,"_27402":55111,"_2946":55198},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3462":1941,"_30116":1905,"_20912":55200,"_5":14363,"_27402":55111,"_2946":52402},[],{"_3462":1942,"_30116":1905,"_20912":55202,"_5":14363,"_27402":55111,"_2946":55203},[],"First choice",{"_3462":1943,"_30116":1905,"_20912":55205,"_5":14363,"_27402":55111,"_2946":55206},[],"Second choice",{"_3462":1944,"_30116":1905,"_20912":55208,"_5":14363,"_27402":55111,"_2946":55209},[],"If neither is supplied",{"_3462":1945,"_30116":1905,"_20912":55211,"_5":14363,"_27402":55111,"_2946":55212},[],"Direct signing with a CA",{"_3462":1946,"_30116":1905,"_20912":55214,"_5":14363,"_27402":55111,"_2946":55215},[],"`issuance_profile` embedded in the request",{"_3462":1947,"_30116":1905,"_20912":55217,"_5":14363,"_27402":55111,"_2946":55218},[],"Request `issuance_profile_id`",{"_3462":1948,"_30116":1905,"_20912":55220,"_5":14363,"_27402":55111,"_2946":55221},[],"CA default profile (`profile_id`).",{"_3462":1949,"_30116":1905,"_20912":55223,"_5":14363,"_27402":55111,"_2946":55224},[],"Issuance through a DMS",{"_3462":1950,"_30116":1905,"_20912":55226,"_5":14363,"_27402":55111,"_2946":55227},[],"`settings.issuance_profile_id`",{"_3462":1951,"_30116":1905,"_20912":55229,"_5":14363,"_27402":55111,"_2946":55230},[],"`settings.issuance_profile` embedded in the DMS",{"_3462":1952,"_30116":1905,"_20912":55232,"_5":14363,"_27402":55111,"_2946":55233},[],"Enrollment CA default profile.",{"_3462":1953,"_30116":1905,"_20912":55235,"_5":14363,"_27402":55111,"_2946":55236},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3462":1954,"_30116":1905,"_20912":55238,"_5":14363,"_27402":55111,"_2946":55239},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3462":1955,"_30116":1905,"_20912":55241,"_5":14363,"_27402":55119,"_2946":55242},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3462":1956,"_30116":1905,"_20912":55244,"_5":14363,"_27402":55123,"_2946":55245},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3462":1957,"_30116":1905,"_20912":55247,"_5":14363,"_27402":55127,"_2946":55248},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3462":1958,"_30116":1905,"_20912":55250,"_5":14363,"_27402":55131,"_2946":55251},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3462":1959,"_30116":1905,"_20912":55253,"_5":14363,"_27402":55135,"_2946":55254},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3462":1960,"_30116":1905,"_20912":55256,"_5":14363,"_27402":55135,"_2946":55257},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3462":1961,"_30116":1905,"_20912":55259,"_5":14363,"_27402":55139,"_2946":55260},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3462":1962,"_30116":1905,"_20912":55262,"_5":14363,"_27402":55139,"_2946":55263},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3462":1963,"_30116":1905,"_20912":55265,"_5":14363,"_27402":55139,"_2946":55266},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3462":1964,"_30116":1905,"_20912":55268,"_5":14363,"_27402":55139,"_2946":55269},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3462":1965,"_30116":1905,"_20912":55271,"_5":14363,"_27402":55143,"_2946":55272},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3462":1966,"_30116":1905,"_20912":55274,"_5":14363,"_27402":55143,"_2946":55275},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3462":1967,"_30116":1967,"_5":14715,"_2946":55277,"_30468":55278,"_20912":55280,"_27402":1967},"Certificate validation",[49167,50635,54640,55279],"Validation",[],{"_3462":1968,"_30116":1967,"_20912":55282,"_5":14363,"_27402":1967,"_2946":55283},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3462":1969,"_30116":1967,"_5":30465,"_20912":55285,"_27402":55286,"_2946":55287},[],"/docs/pr-preview/pr-64/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3462":1970,"_30116":1967,"_5":30465,"_20912":55289,"_27402":55290,"_2946":55291},[],"/docs/pr-preview/pr-64/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3462":1971,"_30116":1967,"_5":30465,"_20912":55293,"_27402":55294,"_2946":55295},[],"/docs/pr-preview/pr-64/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3462":1972,"_30116":1967,"_20912":55297,"_5":14363,"_27402":1967,"_2946":55298},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3462":1973,"_30116":1967,"_20912":55300,"_5":14363,"_27402":55286,"_2946":55301},[],"Verify these criteria together:",{"_3462":1974,"_30116":1967,"_20912":55303,"_5":14363,"_27402":55286,"_2946":54266},[],{"_3462":1975,"_30116":1967,"_20912":55305,"_5":14363,"_27402":55286,"_2946":55306},[],"Required result",{"_3462":1976,"_30116":1967,"_20912":55308,"_5":14363,"_27402":55286,"_2946":55309},[],"Chain and signature",{"_3462":1977,"_30116":1967,"_20912":55311,"_5":14363,"_27402":55286,"_2946":55312},[],"Valid chain to a root deliberately installed in the consumer.",{"_3462":1978,"_30116":1967,"_20912":55314,"_5":14363,"_27402":55286,"_2946":55315},[],"Dates",{"_3462":1979,"_30116":1967,"_20912":55317,"_5":14363,"_27402":55286,"_2946":55318},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3462":1980,"_30116":1967,"_20912":55320,"_5":14363,"_27402":55286,"_2946":50304},[],{"_3462":1981,"_30116":1967,"_20912":55322,"_5":14363,"_27402":55286,"_2946":55323},[],"Name, SAN or identifier matches the expected peer.",{"_3462":1982,"_30116":1967,"_20912":55325,"_5":14363,"_27402":55286,"_2946":49557},[],{"_3462":1983,"_30116":1967,"_20912":55327,"_5":14363,"_27402":55286,"_2946":55328},[],"KU, EKU and constraints permit the specific operation.",{"_3462":1984,"_30116":1967,"_20912":55330,"_5":14363,"_27402":55286,"_2946":55331},[],"Revocation",{"_3462":1985,"_30116":1967,"_20912":55333,"_5":14363,"_27402":55286,"_2946":55334},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3462":1986,"_30116":1967,"_20912":55336,"_5":14363,"_27402":55286,"_2946":55337},[],"Authorization",{"_3462":1987,"_30116":1967,"_20912":55339,"_5":14363,"_27402":55286,"_2946":55340},[],"The application permits that identity to perform the action.",{"_3462":1988,"_30116":1967,"_20912":55342,"_5":14363,"_27402":55286,"_2946":55343},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3462":1989,"_30116":1967,"_20912":55345,"_5":14363,"_27402":55290,"_2946":55346},[],"Mechanism",{"_3462":1990,"_30116":1967,"_20912":55348,"_5":14363,"_27402":55290,"_2946":55349},[],"When to use it",{"_3462":1991,"_30116":1967,"_20912":55351,"_5":14363,"_27402":55290,"_2946":55352},[],"What you must maintain",{"_3462":1992,"_30116":1967,"_20912":55354,"_5":14363,"_27402":55290,"_2946":55355},[],"OCSP",{"_3462":1993,"_30116":1967,"_20912":55357,"_5":14363,"_27402":55290,"_2946":55358},[],"Status query for a specific certificate.",{"_3462":1994,"_30116":1967,"_20912":55360,"_5":14363,"_27402":55290,"_2946":55361},[],"Responder access, signature verification and cache/freshness policy.",{"_3462":1995,"_30116":1967,"_20912":55363,"_5":14363,"_27402":55290,"_2946":55364},[],"CRL",{"_3462":1996,"_30116":1967,"_20912":55366,"_5":14363,"_27402":55290,"_2946":55367},[],"Local checks for many certificates or offline operation.",{"_3462":1997,"_30116":1967,"_20912":55369,"_5":14363,"_27402":55290,"_2946":55370},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3462":1998,"_30116":1967,"_20912":55372,"_5":14363,"_27402":55290,"_2946":55373},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3462":1999,"_30116":1967,"_20912":55375,"_5":14363,"_27402":55290,"_2946":55376},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3462":2000,"_30116":1967,"_20912":55378,"_5":14363,"_27402":55294,"_2946":55379},[],"Accept a current, authorized certificate with a known chain.",{"_3462":2001,"_30116":1967,"_20912":55381,"_5":14363,"_27402":55294,"_2946":55382},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3462":2002,"_30116":1967,"_20912":55384,"_5":14363,"_27402":55294,"_2946":55385},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3462":2003,"_30116":1967,"_20912":55387,"_5":14363,"_27402":55294,"_2946":55388},[],"Check that a new connection with that identity is rejected.",{"_3462":2004,"_30116":1967,"_20912":55390,"_5":14363,"_27402":55294,"_2946":55391},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3462":2005,"_30116":1967,"_20912":55393,"_5":14363,"_27402":55294,"_2946":55394},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3462":2006,"_30116":1967,"_20912":55396,"_5":14363,"_27402":55294,"_2946":55397},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3462":2007,"_30116":1967,"_20912":55399,"_5":14363,"_27402":55294,"_2946":55400},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3462":2008,"_30116":1967,"_20912":55402,"_5":14363,"_27402":55294,"_2946":55403},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3462":2009,"_30116":2009,"_5":14715,"_2946":55405,"_30468":55406,"_20912":55407,"_27402":2009},"Certificates",[49167,50635,54640,54641],[],{"_3462":2010,"_30116":2009,"_20912":55409,"_5":14363,"_27402":2009,"_2946":55410},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3462":2011,"_30116":2009,"_5":30465,"_20912":55412,"_27402":55413,"_2946":55414},[],"/docs/pr-preview/pr-64/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3462":2012,"_30116":2009,"_5":30465,"_20912":55416,"_27402":55417,"_2946":55418},[],"/docs/pr-preview/pr-64/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3462":2013,"_30116":2009,"_5":30465,"_20912":55420,"_27402":55421,"_2946":55422},[],"/docs/pr-preview/pr-64/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3462":2014,"_30116":2009,"_5":30465,"_20912":55424,"_27402":55425,"_2946":55426},[],"/docs/pr-preview/pr-64/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3462":2015,"_30116":2009,"_5":30465,"_20912":55428,"_27402":55429,"_2946":55430},[],"/docs/pr-preview/pr-64/platform/pki/certificates#open-the-action","Open the action",{"_3462":2016,"_30116":2009,"_5":30465,"_20912":55432,"_27402":55433,"_2946":55434},[],"/docs/pr-preview/pr-64/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3462":2017,"_30116":2009,"_5":30465,"_20912":55436,"_27402":55437,"_2946":55438},[],"/docs/pr-preview/pr-64/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3462":2018,"_30116":2009,"_5":30465,"_20912":55440,"_27402":55441,"_2946":55442},[],"/docs/pr-preview/pr-64/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3462":2019,"_30116":2009,"_5":30465,"_20912":55444,"_27402":55445,"_2946":55446},[],"/docs/pr-preview/pr-64/platform/pki/certificates#continue","Continue",{"_3462":2020,"_30116":2009,"_20912":55448,"_5":14363,"_27402":2009,"_2946":55449},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3462":2021,"_30116":2009,"_20912":55451,"_5":14363,"_27402":55413,"_2946":55452},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3462":2022,"_30116":2009,"_20912":55454,"_5":14363,"_27402":55413,"_2946":55455},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3462":2023,"_30116":2009,"_20912":55457,"_5":14363,"_27402":55413,"_2946":55458},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3462":2024,"_30116":2009,"_20912":55460,"_5":14363,"_27402":55413,"_2946":55461},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3462":2025,"_30116":2009,"_20912":55463,"_5":14363,"_27402":55413,"_2946":55464},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3462":2026,"_30116":2009,"_20912":55466,"_5":14363,"_27402":55413,"_2946":55467},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3462":2027,"_30116":2009,"_20912":55469,"_5":14363,"_27402":55413,"_2946":55470},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3462":2028,"_30116":2009,"_20912":55472,"_5":14363,"_27402":55417,"_2946":55473},[],"Download the PEM and inspect it:",{"_3462":2029,"_30116":2009,"_20912":55475,"_5":14363,"_27402":55417,"_2946":55476},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3462":2030,"_30116":2009,"_20912":55478,"_5":14363,"_27402":55421,"_2946":55479},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3462":2031,"_30116":2009,"_20912":55481,"_5":14363,"_27402":55421,"_2946":55482},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3462":2032,"_30116":2009,"_20912":55484,"_5":14363,"_27402":55421,"_2946":55485},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3462":2033,"_30116":2009,"_20912":55487,"_5":14363,"_27402":55421,"_2946":55488},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3462":2034,"_30116":2009,"_20912":55490,"_5":14363,"_27402":55421,"_2946":55491},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3462":2035,"_30116":2009,"_20912":55493,"_5":14363,"_27402":55421,"_2946":55494},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3462":2036,"_30116":2009,"_20912":55496,"_5":14363,"_27402":55421,"_2946":55497},[],"For browser key generation, follow Issue your first certificate.",{"_3462":2037,"_30116":2009,"_20912":55499,"_5":14363,"_27402":55425,"_2946":55500},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3462":2038,"_30116":2009,"_20912":55502,"_5":14363,"_27402":55429,"_2946":55503},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3462":2039,"_30116":2009,"_20912":55505,"_5":14363,"_27402":55433,"_2946":55506},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3462":2040,"_30116":2009,"_20912":55508,"_5":14363,"_27402":55437,"_2946":55509},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3462":2041,"_30116":2009,"_20912":55511,"_5":14363,"_27402":55437,"_2946":55512},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3462":2042,"_30116":2009,"_20912":55514,"_5":14363,"_27402":55437,"_2946":55515},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3462":2043,"_30116":2009,"_20912":55517,"_5":14363,"_27402":55441,"_2946":55518},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3462":2044,"_30116":2009,"_20912":55520,"_5":14363,"_27402":55441,"_2946":55521},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3462":2045,"_30116":2009,"_20912":55523,"_5":14363,"_27402":55441,"_2946":55524},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3462":2046,"_30116":2009,"_20912":55526,"_5":14363,"_27402":55445,"_2946":55527},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3462":2047,"_30116":2009,"_20912":55529,"_5":14363,"_27402":55445,"_2946":55530},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3462":2048,"_30116":2048,"_5":14715,"_2946":55532,"_30468":55533,"_20912":55535,"_27402":2048},"Certificate lifecycle",[49167,50635,54640,55534],"Concepts",[],{"_3462":2049,"_30116":2048,"_20912":55537,"_5":14363,"_27402":2048,"_2946":55538},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3462":2050,"_30116":2048,"_5":30465,"_20912":55540,"_27402":55541,"_2946":55542},[],"/docs/pr-preview/pr-64/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3462":2051,"_30116":2048,"_5":30465,"_20912":55544,"_27402":55545,"_2946":55546},[],"/docs/pr-preview/pr-64/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3462":2052,"_30116":2048,"_5":30465,"_20912":55548,"_27402":55549,"_2946":55550},[],"/docs/pr-preview/pr-64/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3462":2053,"_30116":2048,"_5":30465,"_20912":55552,"_27402":55553,"_2946":55554},[],"/docs/pr-preview/pr-64/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3462":2054,"_30116":2048,"_5":30465,"_20912":55556,"_27402":55557,"_2946":55558},[],"/docs/pr-preview/pr-64/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3462":2055,"_30116":2048,"_5":30465,"_20912":55560,"_27402":55561,"_2946":55562},[],"/docs/pr-preview/pr-64/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3462":2056,"_30116":2048,"_5":30465,"_20912":55564,"_27402":55565,"_2946":55566},[],"/docs/pr-preview/pr-64/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3462":2057,"_30116":2048,"_5":30465,"_20912":55568,"_27402":55569,"_2946":55570},[],"/docs/pr-preview/pr-64/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3462":2058,"_30116":2048,"_5":30465,"_20912":55572,"_27402":55573,"_2946":55574},[],"/docs/pr-preview/pr-64/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3462":2059,"_30116":2048,"_5":30465,"_20912":55576,"_27402":55577,"_2946":55578},[],"/docs/pr-preview/pr-64/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3462":2060,"_30116":2048,"_20912":55580,"_5":14363,"_27402":2048,"_2946":55581},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3462":2061,"_30116":2048,"_20912":55583,"_5":14363,"_27402":55545,"_2946":55584},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3462":2062,"_30116":2048,"_20912":55586,"_5":14363,"_27402":55549,"_2946":55587},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3462":2063,"_30116":2048,"_20912":55589,"_5":14363,"_27402":55553,"_2946":55590},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3462":2064,"_30116":2048,"_20912":55592,"_5":14363,"_27402":55557,"_2946":55593},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3462":2065,"_30116":2048,"_20912":55595,"_5":14363,"_27402":55561,"_2946":55596},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3462":2066,"_30116":2048,"_20912":55598,"_5":14363,"_27402":55565,"_2946":55599},[],"Lamassu persists four X.509 states:",{"_3462":2067,"_30116":2048,"_20912":55601,"_5":14363,"_27402":55565,"_2946":55602},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3462":2068,"_30116":2048,"_20912":55604,"_5":14363,"_27402":55565,"_2946":55605},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3462":2069,"_30116":2048,"_20912":55607,"_5":14363,"_27402":55565,"_2946":55608},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3462":2070,"_30116":2048,"_20912":55610,"_5":14363,"_27402":55565,"_2946":55611},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3462":2071,"_30116":2048,"_20912":55613,"_5":14363,"_27402":55565,"_2946":55614},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3462":2072,"_30116":2048,"_20912":55616,"_5":14363,"_27402":55569,"_2946":55617},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3462":2073,"_30116":2048,"_20912":55619,"_5":14363,"_27402":55569,"_2946":55620},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3462":2074,"_30116":2048,"_20912":55622,"_5":14363,"_27402":55569,"_2946":55623},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3462":2075,"_30116":2048,"_20912":55625,"_5":14363,"_27402":55573,"_2946":55626},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3462":2076,"_30116":2048,"_20912":55628,"_5":14363,"_27402":55573,"_2946":55629},[],"Before confirming:",{"_3462":2077,"_30116":2048,"_20912":55631,"_5":14363,"_27402":55573,"_2946":55632},[],"Identify DMSs, devices and services that trust that chain.",{"_3462":2078,"_30116":2048,"_20912":55634,"_5":14363,"_27402":55573,"_2946":55635},[],"Distribute the new chain of trust.",{"_3462":2079,"_30116":2048,"_20912":55637,"_5":14363,"_27402":55573,"_2946":55638},[],"Reissue the necessary identities.",{"_3462":2080,"_30116":2048,"_20912":55640,"_5":14363,"_27402":55573,"_2946":55641},[],"Check OCSP and CRL from a real consumer.",{"_3462":2081,"_30116":2048,"_20912":55643,"_5":14363,"_27402":55573,"_2946":55644},[],"Revoke the old CA once no legitimate traffic remains.",{"_3462":2082,"_30116":2048,"_20912":55646,"_5":14363,"_27402":55573,"_2946":55647},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3462":2083,"_30116":2048,"_20912":55649,"_5":14363,"_27402":55577,"_2946":55650},[],"Certificates entering the preventive or critical renewal window.",{"_3462":2084,"_30116":2048,"_20912":55652,"_5":14363,"_27402":55577,"_2946":55653},[],"Repeated enrollment or re-enrollment failures.",{"_3462":2085,"_30116":2048,"_20912":55655,"_5":14363,"_27402":55577,"_2946":55656},[],"Status changes and revocation reasons.",{"_3462":2086,"_30116":2048,"_20912":55658,"_5":14363,"_27402":55577,"_2946":55659},[],"OCSP and CRL publication and validity.",{"_3462":2087,"_30116":2048,"_20912":55661,"_5":14363,"_27402":55577,"_2946":55662},[],"Dependencies still presenting a replaced certificate.",{"_3462":2088,"_30116":2048,"_20912":55664,"_5":14363,"_27402":55577,"_2946":55665},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3462":2089,"_30116":2089,"_5":14715,"_2946":55667,"_30468":55668,"_20912":55669,"_27402":2089},"Trust model",[49167,50635,54640,55534],[],{"_3462":2090,"_30116":2089,"_20912":55671,"_5":14363,"_27402":2089,"_2946":55672},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3462":2091,"_30116":2089,"_5":30465,"_20912":55674,"_27402":55675,"_2946":55676},[],"/docs/pr-preview/pr-64/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3462":2092,"_30116":2089,"_5":30465,"_20912":55678,"_27402":55679,"_2946":55680},[],"/docs/pr-preview/pr-64/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3462":2093,"_30116":2089,"_5":30465,"_20912":55682,"_27402":55683,"_2946":55684},[],"/docs/pr-preview/pr-64/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3462":2094,"_30116":2089,"_5":30465,"_20912":55686,"_27402":55687,"_2946":55688},[],"/docs/pr-preview/pr-64/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3462":2095,"_30116":2089,"_5":30465,"_20912":55690,"_27402":55691,"_2946":55692},[],"/docs/pr-preview/pr-64/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3462":2096,"_30116":2089,"_5":30465,"_20912":55694,"_27402":55695,"_2946":55696},[],"/docs/pr-preview/pr-64/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3462":2097,"_30116":2089,"_5":30465,"_20912":55698,"_27402":55699,"_2946":55700},[],"/docs/pr-preview/pr-64/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3462":2098,"_30116":2089,"_5":30465,"_20912":55702,"_27402":55703,"_2946":55704},[],"/docs/pr-preview/pr-64/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3462":2099,"_30116":2089,"_5":30465,"_20912":55706,"_27402":55707,"_2946":55708},[],"/docs/pr-preview/pr-64/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3462":2100,"_30116":2089,"_5":30465,"_20912":55710,"_27402":55711,"_2946":55712},[],"/docs/pr-preview/pr-64/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3462":2101,"_30116":2089,"_20912":55714,"_5":14363,"_27402":2089,"_2946":55715},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3462":2102,"_30116":2089,"_20912":55717,"_5":14363,"_27402":55679,"_2946":55718},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3462":2103,"_30116":2089,"_20912":55720,"_5":14363,"_27402":55683,"_2946":55721},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3462":2104,"_30116":2089,"_20912":55723,"_5":14363,"_27402":55687,"_2946":55724},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3462":2105,"_30116":2089,"_20912":55726,"_5":14363,"_27402":55691,"_2946":55727},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3462":2106,"_30116":2089,"_20912":55729,"_5":14363,"_27402":55695,"_2946":55730},[],"The device proves it can enroll according to the DMS policy.",{"_3462":2107,"_30116":2089,"_20912":55732,"_5":14363,"_27402":55695,"_2946":55733},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3462":2108,"_30116":2089,"_20912":55735,"_5":14363,"_27402":55695,"_2946":55736},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3462":2109,"_30116":2089,"_20912":55738,"_5":14363,"_27402":55695,"_2946":55739},[],"The device installs the certificate and the chain it needs.",{"_3462":2110,"_30116":2089,"_20912":55741,"_5":14363,"_27402":55695,"_2946":55742},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3462":2111,"_30116":2089,"_20912":55744,"_5":14363,"_27402":55695,"_2946":55745},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3462":2112,"_30116":2089,"_20912":55747,"_5":14363,"_27402":55699,"_2946":55748},[],"A DMS relates three sets that are worth designing separately:",{"_3462":2113,"_30116":2089,"_20912":55750,"_5":14363,"_27402":55699,"_2946":55751},[],"**Enrollment CA:** signs the new identities.",{"_3462":2114,"_30116":2089,"_20912":55753,"_5":14363,"_27402":55699,"_2946":55754},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3462":2115,"_30116":2089,"_20912":55756,"_5":14363,"_27402":55699,"_2946":55757},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3462":2116,"_30116":2089,"_20912":55759,"_5":14363,"_27402":55699,"_2946":55760},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3462":2117,"_30116":2089,"_20912":55762,"_5":14363,"_27402":55703,"_2946":55763},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3462":2118,"_30116":2089,"_20912":55765,"_5":14363,"_27402":55703,"_2946":55766},[],"that the current date is between `Not Before` and `Not After`;",{"_3462":2119,"_30116":2089,"_20912":55768,"_5":14363,"_27402":55703,"_2946":55769},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3462":2120,"_30116":2089,"_20912":55771,"_5":14363,"_27402":55703,"_2946":55772},[],"that names, SANs and subject match the expected identity;",{"_3462":2121,"_30116":2089,"_20912":55774,"_5":14363,"_27402":55703,"_2946":55775},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3462":2122,"_30116":2089,"_20912":55777,"_5":14363,"_27402":55703,"_2946":55778},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3462":2123,"_30116":2089,"_20912":55780,"_5":14363,"_27402":55703,"_2946":55781},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3462":2124,"_30116":2089,"_20912":55783,"_5":14363,"_27402":55707,"_2946":55784},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3462":2125,"_30116":2089,"_20912":55786,"_5":14363,"_27402":55711,"_2946":55787},[],"Keep the root out of daily operations, or with very restricted access.",{"_3462":2126,"_30116":2089,"_20912":55789,"_5":14363,"_27402":55711,"_2946":55790},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3462":2127,"_30116":2089,"_20912":55792,"_5":14363,"_27402":55711,"_2946":55793},[],"Assign explicit profiles to every use case.",{"_3462":2128,"_30116":2089,"_20912":55795,"_5":14363,"_27402":55711,"_2946":55796},[],"Distribute the new trust before starting a rotation.",{"_3462":2129,"_30116":2089,"_20912":55798,"_5":14363,"_27402":55711,"_2946":55799},[],"Keep enough overlap to renew a disconnected fleet.",{"_3462":2130,"_30116":2089,"_20912":55801,"_5":14363,"_27402":55711,"_2946":55802},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3462":2131,"_30116":2089,"_20912":55804,"_5":14363,"_27402":55711,"_2946":55805},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3462":2132,"_30116":2132,"_5":14715,"_2946":55807,"_30468":55808,"_20912":55809,"_27402":2132},"Revocation lists (CRL)",[49167,50635,54640,55279],[],{"_3462":2133,"_30116":2132,"_20912":55811,"_5":14363,"_27402":2132,"_2946":55812},[],"Generate and distribute signed lists to validate certificates offline.",{"_3462":2134,"_30116":2132,"_5":30465,"_20912":55814,"_27402":55815,"_2946":55816},[],"/docs/pr-preview/pr-64/platform/pki/crl#crl-settings","CRL settings",{"_3462":2135,"_30116":2132,"_5":30465,"_20912":55818,"_27402":55819,"_2946":55820},[],"/docs/pr-preview/pr-64/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3462":2136,"_30116":2132,"_5":30465,"_20912":55822,"_27402":55823,"_2946":55824},[],"/docs/pr-preview/pr-64/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3462":2137,"_30116":2132,"_5":30465,"_20912":55826,"_27402":55827,"_2946":55828},[],"/docs/pr-preview/pr-64/platform/pki/crl#crl-contents","CRL contents",{"_3462":2138,"_30116":2132,"_5":30465,"_20912":55830,"_27402":55831,"_2946":55832},[],"/docs/pr-preview/pr-64/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3462":2139,"_30116":2132,"_5":30465,"_20912":55834,"_27402":55835,"_2946":55836},[],"/docs/pr-preview/pr-64/platform/pki/crl#crl-settings-api","CRL settings API",{"_3462":2140,"_30116":2132,"_5":30465,"_20912":55838,"_27402":55839,"_2946":55840},[],"/docs/pr-preview/pr-64/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3462":2141,"_30116":2132,"_5":30465,"_20912":55842,"_27402":55843,"_2946":55844},[],"/docs/pr-preview/pr-64/platform/pki/crl#from-the-interface","From the interface",{"_3462":2142,"_30116":2132,"_5":30465,"_20912":55846,"_27402":55847,"_2946":55848},[],"/docs/pr-preview/pr-64/platform/pki/crl#references","References",{"_3462":2143,"_30116":2132,"_20912":55850,"_5":14363,"_27402":2132,"_2946":55851},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3462":2144,"_30116":2132,"_20912":55853,"_5":14363,"_27402":55815,"_2946":55854},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3462":2145,"_30116":2132,"_20912":55856,"_5":14363,"_27402":55815,"_2946":55857},[],"Field",{"_3462":2146,"_30116":2132,"_20912":55859,"_5":14363,"_27402":55815,"_2946":49557},[],{"_3462":2147,"_30116":2132,"_20912":55861,"_5":14363,"_27402":55815,"_2946":55862},[],"`ca_id`",{"_3462":2148,"_30116":2132,"_20912":55864,"_5":14363,"_27402":55815,"_2946":55865},[],"ID of the CA the settings belong to.",{"_3462":2149,"_30116":2132,"_20912":55867,"_5":14363,"_27402":55815,"_2946":55868},[],"`status`",{"_3462":2150,"_30116":2132,"_20912":55870,"_5":14363,"_27402":55815,"_2946":55871},[],"`ACTIVE` settings generate CRLs. `ARCHIVED` ones belong to a CA that no longer exists: their last CRL is still served, but never regenerated.",{"_3462":2151,"_30116":2132,"_20912":55873,"_5":14363,"_27402":55815,"_2946":55874},[],"`legacy_ski`",{"_3462":2152,"_30116":2132,"_20912":55876,"_5":14363,"_27402":55815,"_2946":55877},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3462":2153,"_30116":2132,"_20912":55879,"_5":14363,"_27402":55815,"_2946":55880},[],"`latest_crl`",{"_3462":2154,"_30116":2132,"_20912":55882,"_5":14363,"_27402":55815,"_2946":55883},[],"Version, validity start and end of the last published list. Read-only.",{"_3462":2155,"_30116":2132,"_20912":55885,"_5":14363,"_27402":55815,"_2946":55886},[],"`crl_options` field",{"_3462":2156,"_30116":2132,"_20912":55888,"_5":14363,"_27402":55815,"_2946":49557},[],{"_3462":2157,"_30116":2132,"_20912":55890,"_5":14363,"_27402":55815,"_2946":55891},[],"Initial value",{"_3462":2158,"_30116":2132,"_20912":55893,"_5":14363,"_27402":55815,"_2946":55894},[],"`validity`",{"_3462":2159,"_30116":2132,"_20912":55896,"_5":14363,"_27402":55815,"_2946":55897},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3462":2160,"_30116":2132,"_20912":55899,"_5":14363,"_27402":55815,"_2946":55900},[],"7 days.",{"_3462":2161,"_30116":2132,"_20912":55902,"_5":14363,"_27402":55815,"_2946":55903},[],"`refresh_interval`",{"_3462":2162,"_30116":2132,"_20912":55905,"_5":14363,"_27402":55815,"_2946":55906},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3462":2163,"_30116":2132,"_20912":55908,"_5":14363,"_27402":55815,"_2946":55909},[],"6 days and 23 hours.",{"_3462":2164,"_30116":2132,"_20912":55911,"_5":14363,"_27402":55815,"_2946":55912},[],"`regenerate_on_revoke`",{"_3462":2165,"_30116":2132,"_20912":55914,"_5":14363,"_27402":55815,"_2946":55915},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3462":2166,"_30116":2132,"_20912":55917,"_5":14363,"_27402":55815,"_2946":55918},[],"`true`.",{"_3462":2167,"_30116":2132,"_20912":55920,"_5":14363,"_27402":55815,"_2946":55921},[],"`signer_serial_number`",{"_3462":2168,"_30116":2132,"_20912":55923,"_5":14363,"_27402":55815,"_2946":55924},[],"Serial number of the existing certificate that signs the CRL.",{"_3462":2169,"_30116":2132,"_20912":55926,"_5":14363,"_27402":55815,"_2946":55927},[],"Serial number of the CA’s current certificate.",{"_3462":2170,"_30116":2132,"_20912":55929,"_5":14363,"_27402":55815,"_2946":55930},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3462":2171,"_30116":2132,"_20912":55932,"_5":14363,"_27402":55815,"_2946":55933},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3462":2172,"_30116":2132,"_20912":55935,"_5":14363,"_27402":55815,"_2946":55936},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3462":2173,"_30116":2132,"_20912":55938,"_5":14363,"_27402":55815,"_2946":55939},[],"Deleting a CA keeps its CRL settings, and they cannot be removed through the API. What happens next depends on when the CA was deleted:",{"_3462":2174,"_30116":2132,"_20912":55941,"_5":14363,"_27402":55815,"_2946":55942},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3462":2175,"_30116":2132,"_20912":55944,"_5":14363,"_27402":55815,"_2946":55945},[],"A CA deleted while running 4.0.0 leaves `ACTIVE` settings. The last CRL keeps being served, but once it expires nothing regenerates it: the renewal job logs `something went wrong while calculating CRL for CA <ca-id>` on every cycle because it can no longer resolve the CA. The options can still be edited while the signer is unchanged; changing the signer fails, because there is no CA left to match it.",{"_3462":2176,"_30116":2132,"_20912":55947,"_5":14363,"_27402":55815,"_2946":55948},[],"Adjust validity and signer before deleting a CA.",{"_3462":2177,"_30116":2132,"_20912":55950,"_5":14363,"_27402":55815,"_2946":55951},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3462":2178,"_30116":2132,"_20912":55953,"_5":14363,"_27402":55815,"_2946":55954},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3462":2179,"_30116":2132,"_20912":55956,"_5":14363,"_27402":55815,"_2946":55957},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3462":2180,"_30116":2132,"_20912":55959,"_5":14363,"_27402":55819,"_2946":55960},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3462":2181,"_30116":2132,"_20912":55962,"_5":14363,"_27402":55819,"_2946":55963},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3462":2182,"_30116":2132,"_20912":55965,"_5":14363,"_27402":55819,"_2946":55966},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3462":2183,"_30116":2132,"_20912":55968,"_5":14363,"_27402":55819,"_2946":55969},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3462":2184,"_30116":2132,"_20912":55971,"_5":14363,"_27402":55823,"_2946":55972},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3462":2185,"_30116":2132,"_20912":55974,"_5":14363,"_27402":55823,"_2946":55975},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3462":2186,"_30116":2132,"_20912":55977,"_5":14363,"_27402":55823,"_2946":55978},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3462":2187,"_30116":2132,"_20912":55980,"_5":14363,"_27402":55823,"_2946":55981},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3462":2188,"_30116":2132,"_20912":55983,"_5":14363,"_27402":55823,"_2946":55984},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3462":2189,"_30116":2132,"_20912":55986,"_5":14363,"_27402":55823,"_2946":55987},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3462":2190,"_30116":2132,"_20912":55989,"_5":14363,"_27402":55823,"_2946":55990},[],"Settings whose `status` is `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3462":2191,"_30116":2132,"_20912":55992,"_5":14363,"_27402":55823,"_2946":55993},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3462":2192,"_30116":2132,"_20912":55995,"_5":14363,"_27402":55823,"_2946":55996},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3462":2193,"_30116":2132,"_20912":55998,"_5":14363,"_27402":55827,"_2946":55999},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3462":2194,"_30116":2132,"_20912":56001,"_5":14363,"_27402":55827,"_2946":56002},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3462":2195,"_30116":2132,"_20912":56004,"_5":14363,"_27402":55831,"_2946":56005},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3462":2196,"_30116":2132,"_20912":56007,"_5":14363,"_27402":55831,"_2946":56008},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3462":2197,"_30116":2132,"_20912":56010,"_5":14363,"_27402":55831,"_2946":56011},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3462":2198,"_30116":2132,"_20912":56013,"_5":14363,"_27402":55831,"_2946":56014},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3462":2199,"_30116":2132,"_20912":56016,"_5":14363,"_27402":55831,"_2946":56017},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3462":2200,"_30116":2132,"_20912":56019,"_5":14363,"_27402":55835,"_2946":56020},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3462":2201,"_30116":2132,"_20912":56022,"_5":14363,"_27402":55835,"_2946":52405},[],{"_3462":2202,"_30116":2132,"_20912":56024,"_5":14363,"_27402":55835,"_2946":56025},[],"Relative path",{"_3462":2203,"_30116":2132,"_20912":56027,"_5":14363,"_27402":55835,"_2946":52402},[],{"_3462":2204,"_30116":2132,"_20912":56029,"_5":14363,"_27402":55835,"_2946":56030},[],"`GET`",{"_3462":2205,"_30116":2132,"_20912":56032,"_5":14363,"_27402":55835,"_2946":56033},[],"`/v1/crl-settings`",{"_3462":2206,"_30116":2132,"_20912":56035,"_5":14363,"_27402":55835,"_2946":56036},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3462":2207,"_30116":2132,"_20912":56038,"_5":14363,"_27402":55835,"_2946":56030},[],{"_3462":2208,"_30116":2132,"_20912":56040,"_5":14363,"_27402":55835,"_2946":56041},[],"`/v1/crl-settings/{ca-id}`",{"_3462":2209,"_30116":2132,"_20912":56043,"_5":14363,"_27402":55835,"_2946":56044},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3462":2210,"_30116":2132,"_20912":56046,"_5":14363,"_27402":55835,"_2946":56047},[],"`PUT`",{"_3462":2211,"_30116":2132,"_20912":56049,"_5":14363,"_27402":55835,"_2946":56041},[],{"_3462":2212,"_30116":2132,"_20912":56051,"_5":14363,"_27402":55835,"_2946":56052},[],"Replace the CRL configuration of a CA.",{"_3462":2213,"_30116":2132,"_20912":56054,"_5":14363,"_27402":55835,"_2946":56055},[],"You need authentication and CRL settings read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3462":2214,"_30116":2132,"_20912":56057,"_5":14363,"_27402":55835,"_2946":56058},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3462":2215,"_30116":2132,"_20912":56060,"_5":14363,"_27402":55839,"_2946":56061},[],"Symptom",{"_3462":2216,"_30116":2132,"_20912":56063,"_5":14363,"_27402":55839,"_2946":56064},[],"Cause",{"_3462":2217,"_30116":2132,"_20912":56066,"_5":14363,"_27402":55839,"_2946":56067},[],"Action",{"_3462":2218,"_30116":2132,"_20912":56069,"_5":14363,"_27402":55839,"_2946":56070},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3462":2219,"_30116":2132,"_20912":56072,"_5":14363,"_27402":55839,"_2946":56073},[],"The settings are not `ACTIVE`: the migration archived them because their CA was deleted before the upgrade.",{"_3462":2220,"_30116":2132,"_20912":56075,"_5":14363,"_27402":55839,"_2946":56076},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3462":2221,"_30116":2132,"_20912":56078,"_5":14363,"_27402":55839,"_2946":56079},[],"`PUT` returns 400.",{"_3462":2222,"_30116":2132,"_20912":56081,"_5":14363,"_27402":55839,"_2946":56082},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3462":2223,"_30116":2132,"_20912":56084,"_5":14363,"_27402":55839,"_2946":56085},[],"Set the serial number of a valid certificate of that CA.",{"_3462":2224,"_30116":2132,"_20912":56087,"_5":14363,"_27402":55839,"_2946":56088},[],"`PUT` returns 404.",{"_3462":2225,"_30116":2132,"_20912":56090,"_5":14363,"_27402":55839,"_2946":56091},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3462":2226,"_30116":2132,"_20912":56093,"_5":14363,"_27402":55839,"_2946":56094},[],"Check the CA ID and the signer serial number.",{"_3462":2227,"_30116":2132,"_20912":56096,"_5":14363,"_27402":55839,"_2946":56097},[],"`PUT` returns 400 from a 3.x client.",{"_3462":2228,"_30116":2132,"_20912":56099,"_5":14363,"_27402":55839,"_2946":56100},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3462":2229,"_30116":2132,"_20912":56102,"_5":14363,"_27402":55839,"_2946":56103},[],"Update the client to send the new field.",{"_3462":2230,"_30116":2132,"_20912":56105,"_5":14363,"_27402":55839,"_2946":56106},[],"The CRL does not change after revoking a certificate.",{"_3462":2231,"_30116":2132,"_20912":56108,"_5":14363,"_27402":55839,"_2946":56109},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3462":2232,"_30116":2132,"_20912":56111,"_5":14363,"_27402":55839,"_2946":56112},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3462":2233,"_30116":2132,"_20912":56114,"_5":14363,"_27402":55839,"_2946":56115},[],"A verifier rejects the CRL because of the issuer.",{"_3462":2234,"_30116":2132,"_20912":56117,"_5":14363,"_27402":55839,"_2946":56118},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3462":2235,"_30116":2132,"_20912":56120,"_5":14363,"_27402":55839,"_2946":56121},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3462":2236,"_30116":2132,"_20912":56123,"_5":14363,"_27402":55843,"_2946":56124},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. The CA’s VA settings also let you select the CRL signer: the certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`. Diagnose differences using PKI troubleshooting.",{"_3462":2237,"_30116":2132,"_20912":56126,"_5":14363,"_27402":55847,"_2946":56127},[],"RFC 5280: X.509 and CRL profile.",{"_3462":2238,"_30116":2132,"_20912":56129,"_5":14363,"_27402":55847,"_2946":56130},[],"OpenSSL: openssl-crl.",{"_3462":2239,"_30116":2132,"_20912":56132,"_5":14363,"_27402":55847,"_2946":56133},[],"OpenSSL: openssl-verify.",{"_3462":2240,"_30116":2132,"_20912":56135,"_5":14363,"_27402":55847,"_2946":56136},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3462":2241,"_30116":2132,"_20912":56138,"_5":14363,"_27402":55847,"_2946":56139},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3462":2242,"_30116":2242,"_5":14715,"_2946":56141,"_30468":56142,"_20912":56143,"_27402":2242},"Keys and cryptographic engines",[49167,50635,54640,54641],[],{"_3462":2243,"_30116":2242,"_20912":56145,"_5":14363,"_27402":2242,"_2946":56146},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3462":2244,"_30116":2242,"_5":30465,"_20912":56148,"_27402":56149,"_2946":56150},[],"/docs/pr-preview/pr-64/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3462":2245,"_30116":2242,"_5":30465,"_20912":56152,"_27402":56153,"_2946":56154},[],"/docs/pr-preview/pr-64/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3462":2246,"_30116":2242,"_5":30465,"_20912":56156,"_27402":56157,"_2946":56158},[],"/docs/pr-preview/pr-64/platform/pki/key-management#file-system","File System",{"_3462":2247,"_30116":2242,"_5":30465,"_20912":56160,"_27402":56161,"_2946":56162},[],"/docs/pr-preview/pr-64/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3462":2248,"_30116":2242,"_5":30465,"_20912":56164,"_27402":56165,"_2946":56166},[],"/docs/pr-preview/pr-64/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3462":2249,"_30116":2242,"_5":30465,"_20912":56168,"_27402":56169,"_2946":56170},[],"/docs/pr-preview/pr-64/platform/pki/key-management#aws-kms","AWS KMS",{"_3462":2250,"_30116":2242,"_5":30465,"_20912":56172,"_27402":56173,"_2946":56174},[],"/docs/pr-preview/pr-64/platform/pki/key-management#pkcs11","PKCS#11",{"_3462":2251,"_30116":2242,"_5":30465,"_20912":56176,"_27402":56177,"_2946":56178},[],"/docs/pr-preview/pr-64/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3462":2252,"_30116":2242,"_5":30465,"_20912":56180,"_27402":56181,"_2946":56182},[],"/docs/pr-preview/pr-64/platform/pki/key-management#key-inventory","Key inventory",{"_3462":2253,"_30116":2242,"_5":30465,"_20912":56184,"_27402":56185,"_2946":56186},[],"/docs/pr-preview/pr-64/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3462":2254,"_30116":2242,"_5":30465,"_20912":56188,"_27402":56189,"_2946":56190},[],"/docs/pr-preview/pr-64/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3462":2255,"_30116":2242,"_5":30465,"_20912":56192,"_27402":56193,"_2946":56194},[],"/docs/pr-preview/pr-64/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3462":2256,"_30116":2242,"_5":30465,"_20912":56196,"_27402":56197,"_2946":56198},[],"/docs/pr-preview/pr-64/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3462":2257,"_30116":2242,"_5":30465,"_20912":56200,"_27402":56201,"_2946":56202},[],"/docs/pr-preview/pr-64/platform/pki/key-management#view-details","View details",{"_3462":2258,"_30116":2242,"_5":30465,"_20912":56204,"_27402":56205,"_2946":56206},[],"/docs/pr-preview/pr-64/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3462":2259,"_30116":2242,"_5":30465,"_20912":56208,"_27402":56209,"_2946":56210},[],"/docs/pr-preview/pr-64/platform/pki/key-management#sign","Sign",{"_3462":2260,"_30116":2242,"_5":30465,"_20912":56212,"_27402":56213,"_2946":56214},[],"/docs/pr-preview/pr-64/platform/pki/key-management#verify","Verify",{"_3462":2261,"_30116":2242,"_5":30465,"_20912":56216,"_27402":56217,"_2946":56218},[],"/docs/pr-preview/pr-64/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3462":2262,"_30116":2242,"_5":30465,"_20912":56220,"_27402":56221,"_2946":56222},[],"/docs/pr-preview/pr-64/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3462":2263,"_30116":2242,"_5":30465,"_20912":56224,"_27402":56225,"_2946":56226},[],"/docs/pr-preview/pr-64/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3462":2264,"_30116":2242,"_20912":56228,"_5":14363,"_27402":2242,"_2946":56229},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3462":2265,"_30116":2242,"_20912":56231,"_5":14363,"_27402":2242,"_2946":56232},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3462":2266,"_30116":2242,"_20912":56234,"_5":14363,"_27402":56149,"_2946":56235},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3462":2267,"_30116":2242,"_20912":56237,"_5":14363,"_27402":56149,"_2946":56238},[],"In practice, it lets you:",{"_3462":2268,"_30116":2242,"_20912":56240,"_5":14363,"_27402":56149,"_2946":56241},[],"Generate new key pairs from Lamassu IoT.",{"_3462":2269,"_30116":2242,"_20912":56243,"_5":14363,"_27402":56149,"_2946":56244},[],"Import keys created externally.",{"_3462":2270,"_30116":2242,"_20912":56246,"_5":14363,"_27402":56149,"_2946":56247},[],"Delegate custody and cryptographic operations to external engines.",{"_3462":2271,"_30116":2242,"_20912":56249,"_5":14363,"_27402":56149,"_2946":56250},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3462":2272,"_30116":2242,"_20912":56252,"_5":14363,"_27402":56153,"_2946":56253},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3462":2273,"_30116":2242,"_20912":56255,"_5":14363,"_27402":56153,"_2946":56256},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3462":2274,"_30116":2242,"_20912":56258,"_5":14363,"_27402":56153,"_2946":56259},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3462":2275,"_30116":2242,"_20912":56261,"_5":14363,"_27402":56157,"_2946":56262},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3462":2276,"_30116":2242,"_20912":56264,"_5":14363,"_27402":56161,"_2946":56265},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3462":2277,"_30116":2242,"_20912":56267,"_5":14363,"_27402":56161,"_2946":56268},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3462":2278,"_30116":2242,"_20912":56270,"_5":14363,"_27402":56165,"_2946":56271},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3462":2279,"_30116":2242,"_20912":56273,"_5":14363,"_27402":56169,"_2946":56274},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3462":2280,"_30116":2242,"_20912":56276,"_5":14363,"_27402":56173,"_2946":56277},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3462":2281,"_30116":2242,"_20912":56279,"_5":14363,"_27402":56177,"_2946":56280},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3462":2282,"_30116":2242,"_20912":56282,"_5":14363,"_27402":56177,"_2946":56283},[],"Lamassu shows the enabled engines in the console.",{"_3462":2283,"_30116":2242,"_20912":56285,"_5":14363,"_27402":56177,"_2946":56286},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3462":2284,"_30116":2242,"_20912":56288,"_5":14363,"_27402":56177,"_2946":56289},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3462":2285,"_30116":2242,"_20912":56291,"_5":14363,"_27402":56181,"_2946":56292},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3462":2286,"_30116":2242,"_20912":56294,"_5":14363,"_27402":56181,"_2946":56295},[],"The table includes the following fields:",{"_3462":2287,"_30116":2242,"_20912":56297,"_5":14363,"_27402":56181,"_2946":56298},[],"**Name**: descriptive name of the key.",{"_3462":2288,"_30116":2242,"_20912":56300,"_5":14363,"_27402":56181,"_2946":56301},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3462":2289,"_30116":2242,"_20912":56303,"_5":14363,"_27402":56181,"_2946":56304},[],"**Strength**: visual indicator of cryptographic strength.",{"_3462":2290,"_30116":2242,"_20912":56306,"_5":14363,"_27402":56181,"_2946":56307},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3462":2291,"_30116":2242,"_20912":56309,"_5":14363,"_27402":56181,"_2946":56310},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3462":2292,"_30116":2242,"_20912":56312,"_5":14363,"_27402":56181,"_2946":56313},[],"**Aliases**: alternative names associated with the key.",{"_3462":2293,"_30116":2242,"_20912":56315,"_5":14363,"_27402":56181,"_2946":56316},[],"**Tags**: labels for classification and search.",{"_3462":2294,"_30116":2242,"_20912":56318,"_5":14363,"_27402":56181,"_2946":56319},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3462":2295,"_30116":2242,"_20912":56321,"_5":14363,"_27402":56181,"_2946":56322},[],"From this view you also reach the most common actions:",{"_3462":2296,"_30116":2242,"_20912":56324,"_5":14363,"_27402":56181,"_2946":56325},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3462":2297,"_30116":2242,"_20912":56327,"_5":14363,"_27402":56181,"_2946":56328},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3462":2298,"_30116":2242,"_20912":56330,"_5":14363,"_27402":56181,"_2946":56331},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3462":2299,"_30116":2242,"_20912":56333,"_5":14363,"_27402":56181,"_2946":56334},[],"**Delete Key** to remove the key from the system.",{"_3462":2300,"_30116":2242,"_20912":56336,"_5":14363,"_27402":56185,"_2946":56337},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3462":2301,"_30116":2242,"_20912":56339,"_5":14363,"_27402":56189,"_2946":56340},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3462":2302,"_30116":2242,"_20912":56342,"_5":14363,"_27402":56189,"_2946":56343},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3462":2303,"_30116":2242,"_20912":56345,"_5":14363,"_27402":56189,"_2946":56346},[],"**Key Name**: unique and descriptive name.",{"_3462":2304,"_30116":2242,"_20912":56348,"_5":14363,"_27402":56189,"_2946":56349},[],"**Crypto Engine**: engine that will keep the key.",{"_3462":2305,"_30116":2242,"_20912":56351,"_5":14363,"_27402":56189,"_2946":56352},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3462":2306,"_30116":2242,"_20912":56354,"_5":14363,"_27402":56189,"_2946":56355},[],"**Tags**: metadata to classify the key.",{"_3462":2307,"_30116":2242,"_20912":56357,"_5":14363,"_27402":56189,"_2946":56358},[],"**Metadata**: additional information for advanced uses.",{"_3462":2308,"_30116":2242,"_20912":56360,"_5":14363,"_27402":56193,"_2946":56361},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3462":2309,"_30116":2242,"_20912":56363,"_5":14363,"_27402":56193,"_2946":56364},[],"When you have an exportable private key and the destination engine supports import.",{"_3462":2310,"_30116":2242,"_20912":56366,"_5":14363,"_27402":56193,"_2946":56367},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3462":2311,"_30116":2242,"_20912":56369,"_5":14363,"_27402":56193,"_2946":56370},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3462":2312,"_30116":2242,"_20912":56372,"_5":14363,"_27402":56193,"_2946":56373},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3462":2313,"_30116":2242,"_20912":56375,"_5":14363,"_27402":56193,"_2946":56376},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3462":2314,"_30116":2242,"_20912":56378,"_5":14363,"_27402":56193,"_2946":56379},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3462":2315,"_30116":2242,"_20912":56381,"_5":14363,"_27402":56193,"_2946":56382},[],"**Tags**: labels for organization and search.",{"_3462":2316,"_30116":2242,"_20912":56384,"_5":14363,"_27402":56193,"_2946":56385},[],"**Metadata**: additional optional information.",{"_3462":2317,"_30116":2242,"_20912":56387,"_5":14363,"_27402":56193,"_2946":56388},[],"**Private Key (PEM)**: private key in PEM format.",{"_3462":2318,"_30116":2242,"_20912":56390,"_5":14363,"_27402":56193,"_2946":56391},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3462":2319,"_30116":2242,"_20912":56393,"_5":14363,"_27402":56197,"_2946":56394},[],"Each registered key has a detail view and several operational actions.",{"_3462":2320,"_30116":2242,"_20912":56396,"_5":14363,"_27402":56201,"_2946":56397},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3462":2321,"_30116":2242,"_20912":56399,"_5":14363,"_27402":56201,"_2946":56400},[],"The **Overview** tab shows, among others, these fields:",{"_3462":2322,"_30116":2242,"_20912":56402,"_5":14363,"_27402":56201,"_2946":56403},[],"**Key Name**: descriptive name.",{"_3462":2323,"_30116":2242,"_20912":56405,"_5":14363,"_27402":56201,"_2946":56406},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3462":2324,"_30116":2242,"_20912":56408,"_5":14363,"_27402":56201,"_2946":56409},[],"**Tags**: associated labels.",{"_3462":2325,"_30116":2242,"_20912":56411,"_5":14363,"_27402":56201,"_2946":56412},[],"**Aliases**: alternative names.",{"_3462":2326,"_30116":2242,"_20912":56414,"_5":14363,"_27402":56201,"_2946":56415},[],"**Crypto Engine**: engine where the key resides.",{"_3462":2327,"_30116":2242,"_20912":56417,"_5":14363,"_27402":56201,"_2946":56418},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3462":2328,"_30116":2242,"_20912":56420,"_5":14363,"_27402":56201,"_2946":56421},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3462":2329,"_30116":2242,"_20912":56423,"_5":14363,"_27402":56201,"_2946":56424},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3462":2330,"_30116":2242,"_20912":56426,"_5":14363,"_27402":56205,"_2946":56427},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3462":2331,"_30116":2242,"_20912":56429,"_5":14363,"_27402":56205,"_2946":56430},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3462":2332,"_30116":2242,"_20912":56432,"_5":14363,"_27402":56205,"_2946":56433},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3462":2333,"_30116":2242,"_20912":56435,"_5":14363,"_27402":56209,"_2946":56436},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3462":2334,"_30116":2242,"_20912":56438,"_5":14363,"_27402":56209,"_2946":56439},[],"Main fields:",{"_3462":2335,"_30116":2242,"_20912":56441,"_5":14363,"_27402":56209,"_2946":56442},[],"**Algorithm**: signing algorithm available for the key type.",{"_3462":2336,"_30116":2242,"_20912":56444,"_5":14363,"_27402":56209,"_2946":56445},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3462":2337,"_30116":2242,"_20912":56447,"_5":14363,"_27402":56209,"_2946":56448},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3462":2338,"_30116":2242,"_20912":56450,"_5":14363,"_27402":56209,"_2946":56451},[],"**Message**: content to sign.",{"_3462":2339,"_30116":2242,"_20912":56453,"_5":14363,"_27402":56209,"_2946":56454},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3462":2340,"_30116":2242,"_20912":56456,"_5":14363,"_27402":56213,"_2946":56457},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3462":2341,"_30116":2242,"_20912":56459,"_5":14363,"_27402":56213,"_2946":56439},[],{"_3462":2342,"_30116":2242,"_20912":56461,"_5":14363,"_27402":56213,"_2946":56462},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3462":2343,"_30116":2242,"_20912":56464,"_5":14363,"_27402":56213,"_2946":56465},[],"**Message Type**: `Raw` or `Digest`.",{"_3462":2344,"_30116":2242,"_20912":56467,"_5":14363,"_27402":56213,"_2946":56468},[],"**Payload Encoding**: encoding of the message.",{"_3462":2345,"_30116":2242,"_20912":56470,"_5":14363,"_27402":56213,"_2946":56471},[],"**Message**: original message or hash.",{"_3462":2346,"_30116":2242,"_20912":56473,"_5":14363,"_27402":56213,"_2946":56474},[],"**Signature**: signature to check.",{"_3462":2347,"_30116":2242,"_20912":56476,"_5":14363,"_27402":56213,"_2946":56477},[],"**Result**: indicator of the validation result.",{"_3462":2348,"_30116":2242,"_20912":56479,"_5":14363,"_27402":56217,"_2946":56480},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3462":2349,"_30116":2242,"_20912":56482,"_5":14363,"_27402":56217,"_2946":56483},[],"This flow is useful for:",{"_3462":2350,"_30116":2242,"_20912":56485,"_5":14363,"_27402":56217,"_2946":56486},[],"Requesting certificates from an external CA.",{"_3462":2351,"_30116":2242,"_20912":56488,"_5":14363,"_27402":56217,"_2946":56489},[],"Renewing an identity while keeping the same key.",{"_3462":2352,"_30116":2242,"_20912":56491,"_5":14363,"_27402":56217,"_2946":56492},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3462":2353,"_30116":2242,"_20912":56494,"_5":14363,"_27402":56217,"_2946":56495},[],"**Common Name (CN)**: main name of the identity.",{"_3462":2354,"_30116":2242,"_20912":56497,"_5":14363,"_27402":56217,"_2946":56498},[],"**Organization (O)**: organization or company.",{"_3462":2355,"_30116":2242,"_20912":56500,"_5":14363,"_27402":56217,"_2946":56501},[],"**Organizational Unit (OU)**: department or unit.",{"_3462":2356,"_30116":2242,"_20912":56503,"_5":14363,"_27402":56217,"_2946":56504},[],"**Country (C)**: two-letter country code.",{"_3462":2357,"_30116":2242,"_20912":56506,"_5":14363,"_27402":56217,"_2946":56507},[],"**State / Province (ST)**: state or province.",{"_3462":2358,"_30116":2242,"_20912":56509,"_5":14363,"_27402":56217,"_2946":56510},[],"**Locality (L)**: city or locality.",{"_3462":2359,"_30116":2242,"_20912":56512,"_5":14363,"_27402":56217,"_2946":56513},[],"**Email Address**: contact email.",{"_3462":2360,"_30116":2242,"_20912":56515,"_5":14363,"_27402":56217,"_2946":56516},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3462":2361,"_30116":2242,"_20912":56518,"_5":14363,"_27402":56217,"_2946":56519},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3462":2362,"_30116":2242,"_20912":56521,"_5":14363,"_27402":56221,"_2946":56522},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3462":2363,"_30116":2242,"_20912":56524,"_5":14363,"_27402":56221,"_2946":56525},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3462":2364,"_30116":2242,"_20912":56527,"_5":14363,"_27402":56225,"_2946":56528},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3462":2365,"_30116":2242,"_20912":56530,"_5":14363,"_27402":56225,"_2946":56531},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3462":2366,"_30116":2366,"_5":14715,"_2946":56533,"_30468":56534,"_20912":56535,"_27402":2366},"Online validation with OCSP",[49167,50635,54640,55279],[],{"_3462":2367,"_30116":2366,"_20912":56537,"_5":14363,"_27402":2366,"_2946":56538},[],"Query signed status and verify the responder’s response.",{"_3462":2368,"_30116":2366,"_5":30465,"_20912":56540,"_27402":56541,"_2946":56542},[],"/docs/pr-preview/pr-64/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3462":2369,"_30116":2366,"_5":30465,"_20912":56544,"_27402":56545,"_2946":56546},[],"/docs/pr-preview/pr-64/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3462":2370,"_30116":2366,"_5":30465,"_20912":56548,"_27402":56549,"_2946":56550},[],"/docs/pr-preview/pr-64/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3462":2371,"_30116":2366,"_5":30465,"_20912":56552,"_27402":56553,"_2946":56554},[],"/docs/pr-preview/pr-64/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3462":2372,"_30116":2366,"_5":30465,"_20912":56556,"_27402":56557,"_2946":56558},[],"/docs/pr-preview/pr-64/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3462":2373,"_30116":2366,"_5":30465,"_20912":56560,"_27402":56561,"_2946":55848},[],"/docs/pr-preview/pr-64/platform/pki/ocsp#references",{"_3462":2374,"_30116":2366,"_20912":56563,"_5":14363,"_27402":2366,"_2946":56564},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3462":2375,"_30116":2366,"_20912":56566,"_5":14363,"_27402":56541,"_2946":56567},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3462":2376,"_30116":2366,"_20912":56569,"_5":14363,"_27402":56541,"_2946":56570},[],"Record status",{"_3462":2377,"_30116":2366,"_20912":56572,"_5":14363,"_27402":56541,"_2946":56573},[],"Signed response",{"_3462":2378,"_30116":2366,"_20912":56575,"_5":14363,"_27402":56541,"_2946":53777},[],{"_3462":2379,"_30116":2366,"_20912":56577,"_5":14363,"_27402":56541,"_2946":56578},[],"`Good`.",{"_3462":2380,"_30116":2366,"_20912":56580,"_5":14363,"_27402":56541,"_2946":53794},[],{"_3462":2381,"_30116":2366,"_20912":56582,"_5":14363,"_27402":56541,"_2946":56583},[],"`Revoked`, with revocation reason and timestamp.",{"_3462":2382,"_30116":2366,"_20912":56585,"_5":14363,"_27402":56541,"_2946":56586},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3462":2383,"_30116":2366,"_20912":56588,"_5":14363,"_27402":56541,"_2946":56589},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3462":2384,"_30116":2366,"_20912":56591,"_5":14363,"_27402":56541,"_2946":56592},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3462":2385,"_30116":2366,"_20912":56594,"_5":14363,"_27402":56541,"_2946":56595},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3462":2386,"_30116":2366,"_20912":56597,"_5":14363,"_27402":56541,"_2946":56598},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3462":2387,"_30116":2366,"_20912":56600,"_5":14363,"_27402":56545,"_2946":56601},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3462":2388,"_30116":2366,"_20912":56603,"_5":14363,"_27402":56545,"_2946":56604},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3462":2389,"_30116":2366,"_20912":56606,"_5":14363,"_27402":56549,"_2946":56607},[],"The service accepts:",{"_3462":2390,"_30116":2366,"_20912":56609,"_5":14363,"_27402":56549,"_2946":52405},[],{"_3462":2391,"_30116":2366,"_20912":56611,"_5":14363,"_27402":56549,"_2946":56612},[],"VA service path",{"_3462":2392,"_30116":2366,"_20912":56614,"_5":14363,"_27402":56549,"_2946":56615},[],"Format",{"_3462":2393,"_30116":2366,"_20912":56617,"_5":14363,"_27402":56549,"_2946":56618},[],"`POST`",{"_3462":2394,"_30116":2366,"_20912":56620,"_5":14363,"_27402":56549,"_2946":56621},[],"`/ocsp`",{"_3462":2395,"_30116":2366,"_20912":56623,"_5":14363,"_27402":56549,"_2946":56624},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3462":2396,"_30116":2366,"_20912":56626,"_5":14363,"_27402":56549,"_2946":56030},[],{"_3462":2397,"_30116":2366,"_20912":56628,"_5":14363,"_27402":56549,"_2946":56629},[],"`/ocsp/{ocsp_request}`",{"_3462":2398,"_30116":2366,"_20912":56631,"_5":14363,"_27402":56549,"_2946":56632},[],"DER request encoded using padded URL Base64.",{"_3462":2399,"_30116":2366,"_20912":56634,"_5":14363,"_27402":56549,"_2946":56635},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3462":2400,"_30116":2366,"_20912":56637,"_5":14363,"_27402":56553,"_2946":56638},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3462":2401,"_30116":2366,"_20912":56640,"_5":14363,"_27402":56553,"_2946":56641},[],"Generate the request:",{"_3462":2402,"_30116":2366,"_20912":56643,"_5":14363,"_27402":56553,"_2946":56644},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3462":2403,"_30116":2366,"_20912":56646,"_5":14363,"_27402":56553,"_2946":56647},[],"Replace the example URL with the inspected endpoint:",{"_3462":2404,"_30116":2366,"_20912":56649,"_5":14363,"_27402":56553,"_2946":56650},[],"Verify the returned DER:",{"_3462":2405,"_30116":2366,"_20912":56652,"_5":14363,"_27402":56553,"_2946":56653},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3462":2406,"_30116":2366,"_20912":56655,"_5":14363,"_27402":56557,"_2946":56656},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3462":2407,"_30116":2366,"_20912":56658,"_5":14363,"_27402":56557,"_2946":56659},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3462":2408,"_30116":2366,"_20912":56661,"_5":14363,"_27402":56561,"_2946":56662},[],"RFC 6960: OCSP.",{"_3462":2409,"_30116":2366,"_20912":56664,"_5":14363,"_27402":56561,"_2946":56665},[],"OpenSSL: openssl-ocsp.",{"_3462":2410,"_30116":2366,"_20912":56667,"_5":14363,"_27402":56561,"_2946":56668},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3462":2411,"_30116":2366,"_20912":56670,"_5":14363,"_27402":56561,"_2946":56139},[],{"_3462":2412,"_30116":2412,"_5":14715,"_2946":54640,"_30468":56672,"_20912":56673,"_27402":2412},[49167,50635,54640],[],{"_3462":2413,"_30116":2412,"_20912":56675,"_5":14363,"_27402":2412,"_2946":56676},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3462":2414,"_30116":2412,"_5":30465,"_20912":56678,"_27402":56679,"_2946":53952},[],"/docs/pr-preview/pr-64/platform/pki/overview#start-here",{"_3462":2415,"_30116":2412,"_5":30465,"_20912":56681,"_27402":56682,"_2946":56683},[],"/docs/pr-preview/pr-64/platform/pki/overview#what-you-need","What you need",{"_3462":2416,"_30116":2412,"_5":30465,"_20912":56685,"_27402":56686,"_2946":54484},[],"/docs/pr-preview/pr-64/platform/pki/overview#core-capabilities",{"_3462":2417,"_30116":2412,"_5":30465,"_20912":56688,"_27402":56689,"_2946":54488},[],"/docs/pr-preview/pr-64/platform/pki/overview#build-your-trust-hierarchy",{"_3462":2418,"_30116":2412,"_5":30465,"_20912":56691,"_27402":56692,"_2946":54492},[],"/docs/pr-preview/pr-64/platform/pki/overview#protect-cryptographic-keys",{"_3462":2419,"_30116":2412,"_5":30465,"_20912":56694,"_27402":56695,"_2946":54496},[],"/docs/pr-preview/pr-64/platform/pki/overview#issue-and-control-certificates",{"_3462":2420,"_30116":2412,"_5":30465,"_20912":56697,"_27402":56698,"_2946":54504},[],"/docs/pr-preview/pr-64/platform/pki/overview#publish-validation-status",{"_3462":2421,"_30116":2412,"_5":30465,"_20912":56700,"_27402":56701,"_2946":56702},[],"/docs/pr-preview/pr-64/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3462":2422,"_30116":2412,"_5":30465,"_20912":56704,"_27402":56705,"_2946":55446},[],"/docs/pr-preview/pr-64/platform/pki/overview#continue",{"_3462":2423,"_30116":2412,"_20912":56707,"_5":14363,"_27402":2412,"_2946":56708},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3462":2424,"_30116":2412,"_20912":56710,"_5":14363,"_27402":56679,"_2946":56711},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3462":2425,"_30116":2412,"_20912":56713,"_5":14363,"_27402":56679,"_2946":56714},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3462":2426,"_30116":2412,"_20912":56716,"_5":14363,"_27402":56682,"_2946":56717},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3462":2427,"_30116":2412,"_20912":56719,"_5":14363,"_27402":56682,"_2946":56720},[],"An available cryptographic engine to keep the authority's key.",{"_3462":2428,"_30116":2412,"_20912":56722,"_5":14363,"_27402":56682,"_2946":56723},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3462":2429,"_30116":2412,"_20912":56725,"_5":14363,"_27402":56682,"_2946":56726},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3462":2430,"_30116":2412,"_20912":56728,"_5":14363,"_27402":56682,"_2946":56729},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3462":2431,"_30116":2412,"_20912":56731,"_5":14363,"_27402":56689,"_2946":56732},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3462":2432,"_30116":2412,"_20912":56734,"_5":14363,"_27402":56692,"_2946":56735},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3462":2433,"_30116":2412,"_20912":56737,"_5":14363,"_27402":56695,"_2946":56738},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3462":2434,"_30116":2412,"_20912":56740,"_5":14363,"_27402":56698,"_2946":56741},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3462":2435,"_30116":2412,"_20912":56743,"_5":14363,"_27402":56701,"_2946":56744},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3462":2436,"_30116":2412,"_20912":56746,"_5":14363,"_27402":56701,"_2946":56747},[],"its subject and extensions identify the expected client;",{"_3462":2437,"_30116":2412,"_20912":56749,"_5":14363,"_27402":56701,"_2946":56750},[],"its public key matches the client's private key;",{"_3462":2438,"_30116":2412,"_20912":56752,"_5":14363,"_27402":56701,"_2946":56753},[],"its chain reaches a root trusted by the consumer;",{"_3462":2439,"_30116":2412,"_20912":56755,"_5":14363,"_27402":56701,"_2946":56756},[],"its dates and usages allow the operation;",{"_3462":2440,"_30116":2412,"_20912":56758,"_5":14363,"_27402":56701,"_2946":56759},[],"the consumer applies revocation checks and authorization.",{"_3462":2441,"_30116":2412,"_20912":56761,"_5":14363,"_27402":56701,"_2946":56762},[],"The issuance path includes the first independent checks.",{"_3462":2442,"_30116":2412,"_20912":56764,"_5":14363,"_27402":56705,"_2946":56765},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3462":2443,"_30116":2412,"_20912":56767,"_5":14363,"_27402":56705,"_2946":56768},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3462":2444,"_30116":2412,"_20912":56770,"_5":14363,"_27402":56705,"_2946":56771},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3462":2445,"_30116":2445,"_5":14715,"_2946":56773,"_30468":56774,"_20912":56775,"_27402":2445},"Create your first CA",[49167,50635,54640,54077],[],{"_3462":2446,"_30116":2445,"_20912":56777,"_5":14363,"_27402":2445,"_2946":56778},[],"Create an evaluation root and check its certificate before issuing.",{"_3462":2447,"_30116":2445,"_5":30465,"_20912":56780,"_27402":56781,"_2946":49177},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3462":2448,"_30116":2445,"_5":30465,"_20912":56783,"_27402":56784,"_2946":56785},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3462":2449,"_30116":2445,"_5":30465,"_20912":56787,"_27402":56788,"_2946":56789},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3462":2450,"_30116":2445,"_5":30465,"_20912":56791,"_27402":56792,"_2946":56793},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3462":2451,"_30116":2445,"_5":30465,"_20912":56795,"_27402":56796,"_2946":56797},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3462":2452,"_30116":2445,"_5":30465,"_20912":56799,"_27402":56800,"_2946":56801},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3462":2453,"_30116":2445,"_5":30465,"_20912":56803,"_27402":56804,"_2946":56805},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3462":2454,"_30116":2445,"_5":30465,"_20912":56807,"_27402":56808,"_2946":54334},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3462":2455,"_30116":2445,"_5":30465,"_20912":56810,"_27402":56811,"_2946":49201},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3462":2456,"_30116":2445,"_20912":56813,"_5":14363,"_27402":2445,"_2946":56814},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3462":2457,"_30116":2445,"_20912":56816,"_5":14363,"_27402":56781,"_2946":56817},[],"Console access and permission to create keys and authorities.",{"_3462":2458,"_30116":2445,"_20912":56819,"_5":14363,"_27402":56781,"_2946":56820},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3462":2459,"_30116":2445,"_20912":56822,"_5":14363,"_27402":56781,"_2946":56823},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3462":2460,"_30116":2445,"_20912":56825,"_5":14363,"_27402":56781,"_2946":56826},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3462":2461,"_30116":2445,"_20912":56828,"_5":14363,"_27402":56784,"_2946":56829},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3462":2462,"_30116":2445,"_20912":56831,"_5":14363,"_27402":56784,"_2946":56832},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3462":2463,"_30116":2445,"_20912":56834,"_5":14363,"_27402":56788,"_2946":56835},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3462":2464,"_30116":2445,"_20912":56837,"_5":14363,"_27402":56788,"_2946":56838},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3462":2465,"_30116":2445,"_20912":56840,"_5":14363,"_27402":56792,"_2946":56841},[],"Select **Root CA** and complete:",{"_3462":2466,"_30116":2445,"_20912":56843,"_5":14363,"_27402":56792,"_2946":56844},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3462":2467,"_30116":2445,"_20912":56846,"_5":14363,"_27402":56792,"_2946":56847},[],"**Subject**: organization and country details for your evaluation.",{"_3462":2468,"_30116":2445,"_20912":56849,"_5":14363,"_27402":56792,"_2946":56850},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3462":2469,"_30116":2445,"_20912":56852,"_5":14363,"_27402":56792,"_2946":56853},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3462":2470,"_30116":2445,"_20912":56855,"_5":14363,"_27402":56792,"_2946":56856},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3462":2471,"_30116":2445,"_20912":56858,"_5":14363,"_27402":56796,"_2946":56859},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3462":2472,"_30116":2445,"_20912":56861,"_5":14363,"_27402":56800,"_2946":56862},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3462":2473,"_30116":2445,"_20912":56864,"_5":14363,"_27402":56800,"_2946":56865},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3462":2474,"_30116":2445,"_20912":56867,"_5":14363,"_27402":56804,"_2946":56868},[],"Run from the directory where you saved `ca.pem`:",{"_3462":2475,"_30116":2445,"_20912":56870,"_5":14363,"_27402":56804,"_2946":56871},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3462":2476,"_30116":2445,"_20912":56873,"_5":14363,"_27402":56804,"_2946":56874},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3462":2477,"_30116":2445,"_20912":56876,"_5":14363,"_27402":56808,"_2946":56877},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3462":2478,"_30116":2445,"_20912":56879,"_5":14363,"_27402":56808,"_2946":56880},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3462":2479,"_30116":2445,"_20912":56882,"_5":14363,"_27402":56808,"_2946":56883},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3462":2480,"_30116":2445,"_20912":56885,"_5":14363,"_27402":56808,"_2946":56886},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3462":2481,"_30116":2445,"_20912":56888,"_5":14363,"_27402":56811,"_2946":56889},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3462":2482,"_30116":2482,"_5":14715,"_2946":56891,"_30468":56892,"_20912":56893,"_27402":2482},"Issue and verify a certificate",[49167,50635,54640,54077],[],{"_3462":2483,"_30116":2482,"_20912":56895,"_5":14363,"_27402":2482,"_2946":56896},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3462":2484,"_30116":2482,"_5":30465,"_20912":56898,"_27402":56899,"_2946":49177},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3462":2485,"_30116":2482,"_5":30465,"_20912":56901,"_27402":56902,"_2946":56903},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3462":2486,"_30116":2482,"_5":30465,"_20912":56905,"_27402":56906,"_2946":56907},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3462":2487,"_30116":2482,"_5":30465,"_20912":56909,"_27402":56910,"_2946":56911},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3462":2488,"_30116":2482,"_5":30465,"_20912":56913,"_27402":56914,"_2946":56915},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3462":2489,"_30116":2482,"_5":30465,"_20912":56917,"_27402":56918,"_2946":56919},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3462":2490,"_30116":2482,"_5":30465,"_20912":56921,"_27402":56922,"_2946":56923},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3462":2491,"_30116":2482,"_5":30465,"_20912":56925,"_27402":56926,"_2946":56927},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3462":2492,"_30116":2482,"_5":30465,"_20912":56929,"_27402":56930,"_2946":56931},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3462":2493,"_30116":2482,"_5":30465,"_20912":56933,"_27402":56934,"_2946":56935},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3462":2494,"_30116":2482,"_5":30465,"_20912":56937,"_27402":56938,"_2946":54334},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3462":2495,"_30116":2482,"_5":30465,"_20912":56940,"_27402":56941,"_2946":49201},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/issue-certificate#next-step",{"_3462":2496,"_30116":2482,"_20912":56943,"_5":14363,"_27402":2482,"_2946":56944},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3462":2497,"_30116":2482,"_20912":56946,"_5":14363,"_27402":56899,"_2946":56947},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3462":2498,"_30116":2482,"_20912":56949,"_5":14363,"_27402":56899,"_2946":56950},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3462":2499,"_30116":2482,"_20912":56952,"_5":14363,"_27402":56899,"_2946":56953},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3462":2500,"_30116":2482,"_20912":56955,"_5":14363,"_27402":56899,"_2946":56956},[],"A client identifier: here we use `device-001`.",{"_3462":2501,"_30116":2482,"_20912":56958,"_5":14363,"_27402":56899,"_2946":56959},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3462":2502,"_30116":2482,"_20912":56961,"_5":14363,"_27402":56902,"_2946":56962},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3462":2503,"_30116":2482,"_20912":56964,"_5":14363,"_27402":56906,"_2946":56965},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3462":2504,"_30116":2482,"_20912":56967,"_5":14363,"_27402":56906,"_2946":56968},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3462":2505,"_30116":2482,"_20912":56970,"_5":14363,"_27402":56910,"_2946":56971},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3462":2506,"_30116":2482,"_20912":56973,"_5":14363,"_27402":56910,"_2946":56974},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3462":2507,"_30116":2482,"_20912":56976,"_5":14363,"_27402":56914,"_2946":56977},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3462":2508,"_30116":2482,"_20912":56979,"_5":14363,"_27402":56914,"_2946":56980},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3462":2509,"_30116":2482,"_20912":56982,"_5":14363,"_27402":56918,"_2946":56983},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3462":2510,"_30116":2482,"_20912":56985,"_5":14363,"_27402":56922,"_2946":56986},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3462":2511,"_30116":2482,"_20912":56988,"_5":14363,"_27402":56926,"_2946":56989},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3462":2512,"_30116":2482,"_20912":56991,"_5":14363,"_27402":56930,"_2946":56992},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3462":2513,"_30116":2482,"_20912":56994,"_5":14363,"_27402":56930,"_2946":56995},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3462":2514,"_30116":2482,"_20912":56997,"_5":14363,"_27402":56930,"_2946":56998},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3462":2515,"_30116":2482,"_20912":57000,"_5":14363,"_27402":56934,"_2946":57001},[],"In Bash, compare the two public-key digests:",{"_3462":2516,"_30116":2482,"_20912":57003,"_5":14363,"_27402":56934,"_2946":57004},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3462":2517,"_30116":2482,"_20912":57006,"_5":14363,"_27402":56934,"_2946":57007},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3462":2518,"_30116":2482,"_20912":57009,"_5":14363,"_27402":56938,"_2946":54418},[],{"_3462":2519,"_30116":2482,"_20912":57011,"_5":14363,"_27402":56938,"_2946":57012},[],"What to review",{"_3462":2520,"_30116":2482,"_20912":57014,"_5":14363,"_27402":56938,"_2946":57015},[],"The CA rejects issuance",{"_3462":2521,"_30116":2482,"_20912":57017,"_5":14363,"_27402":56938,"_2946":57018},[],"Permissions, CA state and key, algorithm and profile.",{"_3462":2522,"_30116":2482,"_20912":57020,"_5":14363,"_27402":56938,"_2946":57021},[],"Different subject or usages",{"_3462":2523,"_30116":2482,"_20912":57023,"_5":14363,"_27402":56938,"_2946":57024},[],"Applied profile and requested values.",{"_3462":2524,"_30116":2482,"_20912":57026,"_5":14363,"_27402":56938,"_2946":57027},[],"Issuer cannot be found",{"_3462":2525,"_30116":2482,"_20912":57029,"_5":14363,"_27402":56938,"_2946":57030},[],"Downloaded CA and required intermediate chain.",{"_3462":2526,"_30116":2482,"_20912":57032,"_5":14363,"_27402":56938,"_2946":57033},[],"Validity fails",{"_3462":2527,"_30116":2482,"_20912":57035,"_5":14363,"_27402":56938,"_2946":57036},[],"Certificate and CA dates, and the computer's clock.",{"_3462":2528,"_30116":2482,"_20912":57038,"_5":14363,"_27402":56938,"_2946":57039},[],"Public-key digests differ",{"_3462":2529,"_30116":2482,"_20912":57041,"_5":14363,"_27402":56938,"_2946":57042},[],"Certificate and key files from the same issuance.",{"_3462":2530,"_30116":2482,"_20912":57044,"_5":14363,"_27402":56938,"_2946":57045},[],"See PKI diagnostics to narrow an issuance failure.",{"_3462":2531,"_30116":2482,"_20912":57047,"_5":14363,"_27402":56941,"_2946":57048},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3462":2532,"_30116":2482,"_20912":57050,"_5":14363,"_27402":56941,"_2946":57051},[],"Manage certificates for inspection, status and revocation.",{"_3462":2533,"_30116":2482,"_20912":57053,"_5":14363,"_27402":56941,"_2946":57054},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3462":2534,"_30116":2482,"_20912":57056,"_5":14363,"_27402":56941,"_2946":57057},[],"Prepare EST for the device to request its next identities.",{"_3462":2535,"_30116":2482,"_20912":57059,"_5":14363,"_27402":56941,"_2946":57060},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3462":2536,"_30116":2536,"_5":14715,"_2946":57062,"_30468":57063,"_20912":57064,"_27402":2536},"PKI getting started",[49167,50635,54640,54077],[],{"_3462":2537,"_30116":2536,"_20912":57066,"_5":14363,"_27402":2536,"_2946":57067},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3462":2538,"_30116":2536,"_5":30465,"_20912":57069,"_27402":57070,"_2946":49177},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/overview#before-you-begin",{"_3462":2539,"_30116":2536,"_5":30465,"_20912":57072,"_27402":57073,"_2946":57074},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3462":2540,"_30116":2536,"_5":30465,"_20912":57076,"_27402":57077,"_2946":54269},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/overview#expected-result",{"_3462":2541,"_30116":2536,"_5":30465,"_20912":57079,"_27402":57080,"_2946":57081},[],"/docs/pr-preview/pr-64/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3462":2542,"_30116":2536,"_20912":57083,"_5":14363,"_27402":2536,"_2946":57084},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3462":2543,"_30116":2536,"_20912":57086,"_5":14363,"_27402":57070,"_2946":57087},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3462":2544,"_30116":2536,"_20912":57089,"_5":14363,"_27402":57070,"_2946":57090},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3462":2545,"_30116":2536,"_20912":57092,"_5":14363,"_27402":57070,"_2946":57093},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3462":2546,"_30116":2536,"_20912":57095,"_5":14363,"_27402":57070,"_2946":57096},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3462":2547,"_30116":2536,"_20912":57098,"_5":14363,"_27402":57070,"_2946":57099},[],"A working directory with restricted access for the downloaded key.",{"_3462":2548,"_30116":2536,"_20912":57101,"_5":14363,"_27402":57073,"_2946":57102},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3462":2549,"_30116":2536,"_20912":57104,"_5":14363,"_27402":57073,"_2946":57105},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3462":2550,"_30116":2536,"_20912":57107,"_5":14363,"_27402":57073,"_2946":57108},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3462":2551,"_30116":2536,"_20912":57110,"_5":14363,"_27402":57073,"_2946":57111},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3462":2552,"_30116":2536,"_20912":57113,"_5":14363,"_27402":57077,"_2946":57114},[],"File or resource",{"_3462":2553,"_30116":2536,"_20912":57116,"_5":14363,"_27402":57077,"_2946":54266},[],{"_3462":2554,"_30116":2536,"_20912":57118,"_5":14363,"_27402":57077,"_2946":57119},[],"Active root CA and `ca.pem`",{"_3462":2555,"_30116":2536,"_20912":57121,"_5":14363,"_27402":57077,"_2946":57122},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3462":2556,"_30116":2536,"_20912":57124,"_5":14363,"_27402":57077,"_2946":57125},[],"End-entity certificate and `device.crt`",{"_3462":2557,"_30116":2536,"_20912":57127,"_5":14363,"_27402":57077,"_2946":57128},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3462":2558,"_30116":2536,"_20912":57130,"_5":14363,"_27402":57077,"_2946":57131},[],"Private key `device.key`",{"_3462":2559,"_30116":2536,"_20912":57133,"_5":14363,"_27402":57077,"_2946":57134},[],"Its public key matches the one included in `device.crt`.",{"_3462":2560,"_30116":2536,"_20912":57136,"_5":14363,"_27402":57077,"_2946":57137},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3462":2561,"_30116":2536,"_20912":57139,"_5":14363,"_27402":57080,"_2946":57140},[],"To operate certificates, continue with Certificates and Validation.",{"_3462":2562,"_30116":2536,"_20912":57142,"_5":14363,"_27402":57080,"_2946":57143},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3462":2563,"_30116":2536,"_20912":57145,"_5":14363,"_27402":57080,"_2946":57146},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3462":2564,"_30116":2564,"_5":14715,"_2946":57148,"_30468":57149,"_20912":57150,"_27402":2564},"PKI troubleshooting",[49167,50635,54640,53215],[],{"_3462":2565,"_30116":2564,"_20912":57152,"_5":14363,"_27402":2564,"_2946":57153},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3462":2566,"_30116":2564,"_5":30465,"_20912":57155,"_27402":57156,"_2946":57157},[],"/docs/pr-preview/pr-64/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3462":2567,"_30116":2564,"_5":30465,"_20912":57159,"_27402":57160,"_2946":57161},[],"/docs/pr-preview/pr-64/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3462":2568,"_30116":2564,"_5":30465,"_20912":57163,"_27402":57164,"_2946":57165},[],"/docs/pr-preview/pr-64/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3462":2569,"_30116":2564,"_20912":57167,"_5":14363,"_27402":2564,"_2946":57168},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3462":2570,"_30116":2564,"_20912":57170,"_5":14363,"_27402":2564,"_2946":57171},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3462":2571,"_30116":2564,"_20912":57173,"_5":14363,"_27402":57156,"_2946":54266},[],{"_3462":2572,"_30116":2564,"_20912":57175,"_5":14363,"_27402":57156,"_2946":57176},[],"What to inspect",{"_3462":2573,"_30116":2564,"_20912":57178,"_5":14363,"_27402":57156,"_2946":49201},[],{"_3462":2574,"_30116":2564,"_20912":57180,"_5":14363,"_27402":57156,"_2946":53482},[],{"_3462":2575,"_30116":2564,"_20912":57182,"_5":14363,"_27402":57156,"_2946":57183},[],"Exists, is active and has usable dates.",{"_3462":2576,"_30116":2564,"_20912":57185,"_5":14363,"_27402":57156,"_2946":57186},[],"Authorities.",{"_3462":2577,"_30116":2564,"_20912":57188,"_5":14363,"_27402":57156,"_2946":57189},[],"Key",{"_3462":2578,"_30116":2564,"_20912":57191,"_5":14363,"_27402":57156,"_2946":57192},[],"The record has a usable private key and the engine can sign.",{"_3462":2579,"_30116":2564,"_20912":57194,"_5":14363,"_27402":57156,"_2946":57195},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3462":2580,"_30116":2564,"_20912":57197,"_5":14363,"_27402":57156,"_2946":57198},[],"CSR",{"_3462":2581,"_30116":2564,"_20912":57200,"_5":14363,"_27402":57156,"_2946":57201},[],"Correct PEM and verifiable signature.",{"_3462":2582,"_30116":2564,"_20912":57203,"_5":14363,"_27402":57156,"_2946":57204},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3462":2583,"_30116":2564,"_20912":57206,"_5":14363,"_27402":57156,"_2946":57207},[],"Profile",{"_3462":2584,"_30116":2564,"_20912":57209,"_5":14363,"_27402":57156,"_2946":57210},[],"Selected source, existing ID, allowed algorithm and size.",{"_3462":2585,"_30116":2564,"_20912":57212,"_5":14363,"_27402":57156,"_2946":57213},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3462":2586,"_30116":2564,"_20912":57215,"_5":14363,"_27402":57156,"_2946":54418},[],{"_3462":2587,"_30116":2564,"_20912":57217,"_5":14363,"_27402":57156,"_2946":57218},[],"Appropriate subject, SAN, usages and dates.",{"_3462":2588,"_30116":2564,"_20912":57220,"_5":14363,"_27402":57156,"_2946":57221},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3462":2589,"_30116":2564,"_20912":57223,"_5":14363,"_27402":57156,"_2946":57224},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3462":2590,"_30116":2564,"_20912":57226,"_5":14363,"_27402":57156,"_2946":57227},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3462":2591,"_30116":2564,"_20912":57229,"_5":14363,"_27402":57160,"_2946":57230},[],"Check each boundary independently:",{"_3462":2592,"_30116":2564,"_20912":57232,"_5":14363,"_27402":57160,"_2946":57233},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3462":2593,"_30116":2564,"_20912":57235,"_5":14363,"_27402":57160,"_2946":57236},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3462":2594,"_30116":2564,"_20912":57238,"_5":14363,"_27402":57160,"_2946":57239},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3462":2595,"_30116":2564,"_20912":57241,"_5":14363,"_27402":57160,"_2946":57242},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3462":2596,"_30116":2564,"_20912":57244,"_5":14363,"_27402":57160,"_2946":57245},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3462":2597,"_30116":2564,"_20912":57247,"_5":14363,"_27402":57160,"_2946":57248},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3462":2598,"_30116":2564,"_20912":57250,"_5":14363,"_27402":57164,"_2946":57251},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3462":2599,"_30116":2564,"_20912":57253,"_5":14363,"_27402":57164,"_2946":57254},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3462":2600,"_30116":2600,"_5":14715,"_2946":57256,"_30468":57257,"_20912":57258,"_27402":2600},"Security",[49167],[],{"_3462":2601,"_30116":2600,"_20912":57260,"_5":14363,"_27402":2600,"_2946":57261},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3462":2602,"_30116":2600,"_5":30465,"_20912":57263,"_27402":57264,"_2946":57265},[],"/docs/pr-preview/pr-64/security#report-a-vulnerability","Report a vulnerability",{"_3462":2603,"_30116":2600,"_5":30465,"_20912":57267,"_27402":57268,"_2946":57269},[],"/docs/pr-preview/pr-64/security#what-to-include-in-a-report","What to include in a report",{"_3462":2604,"_30116":2600,"_5":30465,"_20912":57271,"_27402":57272,"_2946":57273},[],"/docs/pr-preview/pr-64/security#supported-versions","Supported versions",{"_3462":2605,"_30116":2600,"_5":30465,"_20912":57275,"_27402":57276,"_2946":57277},[],"/docs/pr-preview/pr-64/security#responsible-disclosure","Responsible disclosure",{"_3462":2606,"_30116":2600,"_20912":57279,"_5":14363,"_27402":2600,"_2946":57280},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3462":2607,"_30116":2600,"_20912":57282,"_5":14363,"_27402":57264,"_2946":57283},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3462":2608,"_30116":2600,"_20912":57285,"_5":14363,"_27402":57264,"_2946":57286},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3462":2609,"_30116":2600,"_20912":57288,"_5":14363,"_27402":57264,"_2946":14988},[],{"_3462":2610,"_30116":2600,"_20912":57290,"_5":14363,"_27402":57264,"_2946":14928},[],{"_3462":2611,"_30116":2600,"_20912":57292,"_5":14363,"_27402":57264,"_2946":14975},[],{"_3462":2612,"_30116":2600,"_20912":57294,"_5":14363,"_27402":57264,"_2946":57295},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3462":2613,"_30116":2600,"_20912":57297,"_5":14363,"_27402":57264,"_2946":57298},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3462":2614,"_30116":2600,"_20912":57300,"_5":14363,"_27402":57268,"_2946":57301},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3462":2615,"_30116":2600,"_20912":57303,"_5":14363,"_27402":57268,"_2946":57304},[],"Do not include in the report:",{"_3462":2616,"_30116":2600,"_20912":57306,"_5":14363,"_27402":57268,"_2946":57307},[],"Credentials, tokens, or private keys",{"_3462":2617,"_30116":2600,"_20912":57309,"_5":14363,"_27402":57268,"_2946":57310},[],"Customer data or customer-identifiable information",{"_3462":2618,"_30116":2600,"_20912":57312,"_5":14363,"_27402":57268,"_2946":57313},[],"Confidential architecture or internal infrastructure details",{"_3462":2619,"_30116":2600,"_20912":57315,"_5":14363,"_27402":57272,"_2946":57316},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3462":2620,"_30116":2600,"_20912":57318,"_5":14363,"_27402":57272,"_2946":57319},[],"For upgrade guidance, see Upgrades.",{"_3462":2621,"_30116":2600,"_20912":57321,"_5":14363,"_27402":57276,"_2946":57322},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3462":2622,"_30116":2600,"_20912":57324,"_5":14363,"_27402":57276,"_2946":57325},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3462":2623,"_30116":2600,"_20912":57327,"_5":14363,"_27402":57276,"_2946":57328},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3462":2624,"_30116":2600,"_20912":57330,"_5":14363,"_27402":57276,"_2946":57331},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3462":2625,"_30116":2600,"_20912":57333,"_5":14363,"_27402":57276,"_2946":57334},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3462":2626,"_30116":2626,"_5":14715,"_2946":57336,"_30468":57337,"_20912":57339,"_27402":2626},"3.8.0 to 4.0.0",[49167,57338],"Upgrades",[],{"_3462":2627,"_30116":2626,"_20912":57341,"_5":14363,"_27402":2626,"_2946":57342},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3462":2628,"_30116":2626,"_5":30465,"_20912":57344,"_27402":57345,"_2946":57346},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3462":2629,"_30116":2626,"_5":30465,"_20912":57348,"_27402":57349,"_2946":57350},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3462":2630,"_30116":2626,"_5":30465,"_20912":57352,"_27402":57353,"_2946":57354},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3462":2631,"_30116":2626,"_5":30465,"_20912":57356,"_27402":57357,"_2946":57358},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3462":2632,"_30116":2626,"_5":30465,"_20912":57360,"_27402":57361,"_2946":57362},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3462":2633,"_30116":2626,"_5":30465,"_20912":57364,"_27402":57365,"_2946":57366},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3462":2634,"_30116":2626,"_5":30465,"_20912":57368,"_27402":57369,"_2946":57370},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3462":2635,"_30116":2626,"_5":30465,"_20912":57372,"_27402":57373,"_2946":57374},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3462":2636,"_30116":2626,"_5":30465,"_20912":57376,"_27402":57377,"_2946":57378},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3462":2637,"_30116":2626,"_5":30465,"_20912":57380,"_27402":57381,"_2946":57382},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3462":2638,"_30116":2626,"_5":30465,"_20912":57384,"_27402":57385,"_2946":57386},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3462":2639,"_30116":2626,"_5":30465,"_20912":57388,"_27402":57389,"_2946":57390},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3462":2640,"_30116":2626,"_5":30465,"_20912":57392,"_27402":57393,"_2946":57394},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3462":2641,"_30116":2626,"_5":30465,"_20912":57396,"_27402":57397,"_2946":57398},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3462":2642,"_30116":2626,"_5":30465,"_20912":57400,"_27402":57401,"_2946":57402},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3462":2643,"_30116":2626,"_5":30465,"_20912":57404,"_27402":57405,"_2946":57406},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3462":2644,"_30116":2626,"_5":30465,"_20912":57408,"_27402":57409,"_2946":57410},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3462":2645,"_30116":2626,"_5":30465,"_20912":57412,"_27402":57413,"_2946":57414},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3462":2646,"_30116":2626,"_5":30465,"_20912":57416,"_27402":57417,"_2946":57418},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3462":2647,"_30116":2626,"_5":30465,"_20912":57420,"_27402":57421,"_2946":57422},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3462":2648,"_30116":2626,"_5":30465,"_20912":57424,"_27402":57425,"_2946":57426},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3462":2649,"_30116":2626,"_5":30465,"_20912":57428,"_27402":57429,"_2946":57430},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3462":2650,"_30116":2626,"_5":30465,"_20912":57432,"_27402":57433,"_2946":57434},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3462":2651,"_30116":2626,"_5":30465,"_20912":57436,"_27402":57437,"_2946":57438},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3462":2652,"_30116":2626,"_5":30465,"_20912":57440,"_27402":57441,"_2946":57442},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3462":2653,"_30116":2626,"_5":30465,"_20912":57444,"_27402":57445,"_2946":57446},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3462":2654,"_30116":2626,"_5":30465,"_20912":57448,"_27402":57449,"_2946":57450},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3462":2655,"_30116":2626,"_5":30465,"_20912":57452,"_27402":57453,"_2946":57454},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3462":2656,"_30116":2626,"_5":30465,"_20912":57456,"_27402":57457,"_2946":57458},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3462":2657,"_30116":2626,"_5":30465,"_20912":57460,"_27402":57461,"_2946":57462},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3462":2658,"_30116":2626,"_5":30465,"_20912":57464,"_27402":57465,"_2946":57466},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3462":2659,"_30116":2626,"_5":30465,"_20912":57468,"_27402":57469,"_2946":57470},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3462":2660,"_30116":2626,"_5":30465,"_20912":57472,"_27402":57473,"_2946":57474},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3462":2661,"_30116":2626,"_5":30465,"_20912":57476,"_27402":57477,"_2946":57478},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3462":2662,"_30116":2626,"_5":30465,"_20912":57480,"_27402":57481,"_2946":57482},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3462":2663,"_30116":2626,"_5":30465,"_20912":57484,"_27402":57485,"_2946":57486},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3462":2664,"_30116":2626,"_5":30465,"_20912":57488,"_27402":57489,"_2946":57490},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3462":2665,"_30116":2626,"_5":30465,"_20912":57492,"_27402":57493,"_2946":57494},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3462":2666,"_30116":2626,"_5":30465,"_20912":57496,"_27402":57497,"_2946":57498},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3462":2667,"_30116":2626,"_5":30465,"_20912":57500,"_27402":57501,"_2946":57502},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3462":2668,"_30116":2626,"_5":30465,"_20912":57504,"_27402":57505,"_2946":53215},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3462":2669,"_30116":2626,"_5":30465,"_20912":57507,"_27402":57508,"_2946":57509},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3462":2670,"_30116":2626,"_5":30465,"_20912":57511,"_27402":57512,"_2946":57513},[],"/docs/pr-preview/pr-64/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3462":2671,"_30116":2626,"_20912":57515,"_5":14363,"_27402":2626,"_2946":57516},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3462":2672,"_30116":2626,"_20912":57518,"_5":14363,"_27402":2626,"_2946":57519},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3462":2673,"_30116":2626,"_20912":57521,"_5":14363,"_27402":2626,"_2946":57522},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3462":2674,"_30116":2626,"_20912":57524,"_5":14363,"_27402":2626,"_2946":57525},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3462":2675,"_30116":2626,"_20912":57527,"_5":14363,"_27402":2626,"_2946":57528},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3462":2676,"_30116":2626,"_20912":57530,"_5":14363,"_27402":2626,"_2946":57531},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3462":2677,"_30116":2626,"_20912":57533,"_5":14363,"_27402":2626,"_2946":57534},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3462":2678,"_30116":2626,"_20912":57536,"_5":14363,"_27402":57349,"_2946":57537},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3462":2679,"_30116":2626,"_20912":57539,"_5":14363,"_27402":57349,"_2946":57540},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3462":2680,"_30116":2626,"_20912":57542,"_5":14363,"_27402":57353,"_2946":57543},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3462":2681,"_30116":2626,"_20912":57545,"_5":14363,"_27402":57353,"_2946":57546},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3462":2682,"_30116":2626,"_20912":57548,"_5":14363,"_27402":57357,"_2946":57549},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3462":2683,"_30116":2626,"_20912":57551,"_5":14363,"_27402":57361,"_2946":57552},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3462":2684,"_30116":2626,"_20912":57554,"_5":14363,"_27402":57361,"_2946":57555},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3462":2685,"_30116":2626,"_20912":57557,"_5":14363,"_27402":57361,"_2946":57558},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3462":2686,"_30116":2626,"_20912":57560,"_5":14363,"_27402":57361,"_2946":57561},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3462":2687,"_30116":2626,"_20912":57563,"_5":14363,"_27402":57361,"_2946":57564},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3462":2688,"_30116":2626,"_20912":57566,"_5":14363,"_27402":57365,"_2946":57567},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3462":2689,"_30116":2626,"_20912":57569,"_5":14363,"_27402":57365,"_2946":57570},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3462":2690,"_30116":2626,"_20912":57572,"_5":14363,"_27402":57365,"_2946":57573},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3462":2691,"_30116":2626,"_20912":57575,"_5":14363,"_27402":57365,"_2946":57576},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3462":2692,"_30116":2626,"_20912":57578,"_5":14363,"_27402":57365,"_2946":57579},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3462":2693,"_30116":2626,"_20912":57581,"_5":14363,"_27402":57365,"_2946":57582},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3462":2694,"_30116":2626,"_20912":57584,"_5":14363,"_27402":57369,"_2946":57585},[],"Change",{"_3462":2695,"_30116":2626,"_20912":57587,"_5":14363,"_27402":57369,"_2946":57588},[],"Who is affected",{"_3462":2696,"_30116":2626,"_20912":57590,"_5":14363,"_27402":57369,"_2946":57591},[],"Severity",{"_3462":2697,"_30116":2626,"_20912":57593,"_5":14363,"_27402":57369,"_2946":56067},[],{"_3462":2698,"_30116":2626,"_20912":57595,"_5":14363,"_27402":57369,"_2946":57378},[],{"_3462":2699,"_30116":2626,"_20912":57597,"_5":14363,"_27402":57369,"_2946":57598},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3462":2700,"_30116":2626,"_20912":57600,"_5":14363,"_27402":57369,"_2946":57601},[],"High: KMS and VA start on empty volumes",{"_3462":2701,"_30116":2626,"_20912":57603,"_5":14363,"_27402":57369,"_2946":57604},[],"Copy the data into the new volumes",{"_3462":2702,"_30116":2626,"_20912":57606,"_5":14363,"_27402":57369,"_2946":57382},[],{"_3462":2703,"_30116":2626,"_20912":57608,"_5":14363,"_27402":57369,"_2946":57609},[],"Every Helm release",{"_3462":2704,"_30116":2626,"_20912":57611,"_5":14363,"_27402":57369,"_2946":57612},[],"High: `helm upgrade` fails",{"_3462":2705,"_30116":2626,"_20912":57614,"_5":14363,"_27402":57369,"_2946":57615},[],"Remove or rename legacy keys",{"_3462":2706,"_30116":2626,"_20912":57617,"_5":14363,"_27402":57369,"_2946":57386},[],{"_3462":2707,"_30116":2626,"_20912":57619,"_5":14363,"_27402":57369,"_2946":57620},[],"Every deployment",{"_3462":2708,"_30116":2626,"_20912":57622,"_5":14363,"_27402":57369,"_2946":57623},[],"High: without a bootstrap principal there is no administrator",{"_3462":2709,"_30116":2626,"_20912":57625,"_5":14363,"_27402":57369,"_2946":57626},[],"Configure `services.authz`",{"_3462":2710,"_30116":2626,"_20912":57628,"_5":14363,"_27402":57369,"_2946":57390},[],{"_3462":2711,"_30116":2626,"_20912":57630,"_5":14363,"_27402":57369,"_2946":57609},[],{"_3462":2712,"_30116":2626,"_20912":57632,"_5":14363,"_27402":57369,"_2946":57633},[],"High: `helm upgrade` fails on the old keys",{"_3462":2713,"_30116":2626,"_20912":57635,"_5":14363,"_27402":57369,"_2946":57636},[],"Move JWKS and roles into `services.authz`",{"_3462":2714,"_30116":2626,"_20912":57638,"_5":14363,"_27402":57369,"_2946":57410},[],{"_3462":2715,"_30116":2626,"_20912":57640,"_5":14363,"_27402":57369,"_2946":57641},[],"3.8.0 deployments with per-service databases",{"_3462":2716,"_30116":2626,"_20912":57643,"_5":14363,"_27402":57369,"_2946":57644},[],"High: services find no data, or a migration aborts",{"_3462":2717,"_30116":2626,"_20912":57646,"_5":14363,"_27402":57369,"_2946":57647},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3462":2718,"_30116":2626,"_20912":57649,"_5":14363,"_27402":57369,"_2946":57414},[],{"_3462":2719,"_30116":2626,"_20912":57651,"_5":14363,"_27402":57369,"_2946":57652},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3462":2720,"_30116":2626,"_20912":57654,"_5":14363,"_27402":57369,"_2946":57655},[],"High: the backend no longer starts with them",{"_3462":2721,"_30116":2626,"_20912":57657,"_5":14363,"_27402":57369,"_2946":57658},[],"Move to PostgreSQL before upgrading",{"_3462":2722,"_30116":2626,"_20912":57660,"_5":14363,"_27402":57369,"_2946":57458},[],{"_3462":2723,"_30116":2626,"_20912":57662,"_5":14363,"_27402":57369,"_2946":57663},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3462":2724,"_30116":2626,"_20912":57665,"_5":14363,"_27402":57369,"_2946":57666},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3462":2725,"_30116":2626,"_20912":57668,"_5":14363,"_27402":57369,"_2946":57669},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3462":2726,"_30116":2626,"_20912":57671,"_5":14363,"_27402":57369,"_2946":57672},[],"Webhooks with file references",{"_3462":2727,"_30116":2626,"_20912":57674,"_5":14363,"_27402":57369,"_2946":57675},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3462":2728,"_30116":2626,"_20912":57677,"_5":14363,"_27402":57369,"_2946":57678},[],"High: enrollments calling the webhook fail",{"_3462":2729,"_30116":2626,"_20912":57680,"_5":14363,"_27402":57369,"_2946":57681},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3462":2730,"_30116":2626,"_20912":57683,"_5":14363,"_27402":57369,"_2946":57394},[],{"_3462":2731,"_30116":2626,"_20912":57685,"_5":14363,"_27402":57369,"_2946":57686},[],"Releases with per-service identity overrides or mounted key material",{"_3462":2732,"_30116":2626,"_20912":57688,"_5":14363,"_27402":57369,"_2946":57689},[],"Medium: services cannot read their files",{"_3462":2733,"_30116":2626,"_20912":57691,"_5":14363,"_27402":57369,"_2946":57692},[],"Remove the overrides and fix volume ownership",{"_3462":2734,"_30116":2626,"_20912":57694,"_5":14363,"_27402":57369,"_2946":57398},[],{"_3462":2735,"_30116":2626,"_20912":57696,"_5":14363,"_27402":57369,"_2946":57697},[],"Releases that set `amqp.tls`",{"_3462":2736,"_30116":2626,"_20912":57699,"_5":14363,"_27402":57369,"_2946":57700},[],"Medium: clients connect to the wrong port",{"_3462":2737,"_30116":2626,"_20912":57702,"_5":14363,"_27402":57369,"_2946":57703},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3462":2738,"_30116":2626,"_20912":57705,"_5":14363,"_27402":57369,"_2946":57418},[],{"_3462":2739,"_30116":2626,"_20912":57707,"_5":14363,"_27402":57369,"_2946":57708},[],"Installations whose CA keys predate the KMS",{"_3462":2740,"_30116":2626,"_20912":57710,"_5":14363,"_27402":57369,"_2946":57711},[],"Medium: CA keys stay unmanaged",{"_3462":2741,"_30116":2626,"_20912":57713,"_5":14363,"_27402":57369,"_2946":57714},[],"Run the CA-to-KMS migration",{"_3462":2742,"_30116":2626,"_20912":57716,"_5":14363,"_27402":57369,"_2946":57717},[],"Receiver certificate verification",{"_3462":2743,"_30116":2626,"_20912":57719,"_5":14363,"_27402":57369,"_2946":57720},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3462":2744,"_30116":2626,"_20912":57722,"_5":14363,"_27402":57369,"_2946":57723},[],"Medium: credentials go to an unverified receiver",{"_3462":2745,"_30116":2626,"_20912":57725,"_5":14363,"_27402":57369,"_2946":57726},[],"Set `insecure_skip_verify` to `false`",{"_3462":2746,"_30116":2626,"_20912":57728,"_5":14363,"_27402":57369,"_2946":57434},[],{"_3462":2747,"_30116":2626,"_20912":57730,"_5":14363,"_27402":57369,"_2946":57731},[],"Scripts and consoles that edit DMSs through the API",{"_3462":2748,"_30116":2626,"_20912":57733,"_5":14363,"_27402":57369,"_2946":57734},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3462":2749,"_30116":2626,"_20912":57736,"_5":14363,"_27402":57369,"_2946":57737},[],"Read the DMS before editing and use the new field",{"_3462":2750,"_30116":2626,"_20912":57739,"_5":14363,"_27402":57369,"_2946":57454},[],{"_3462":2751,"_30116":2626,"_20912":57741,"_5":14363,"_27402":57369,"_2946":57742},[],"Clients that create or update CRL settings through the API",{"_3462":2752,"_30116":2626,"_20912":57744,"_5":14363,"_27402":57369,"_2946":57745},[],"Medium: requests with the old field return an error",{"_3462":2753,"_30116":2626,"_20912":57747,"_5":14363,"_27402":57369,"_2946":57748},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3462":2754,"_30116":2626,"_20912":57750,"_5":14363,"_27402":57369,"_2946":57462},[],{"_3462":2755,"_30116":2626,"_20912":57752,"_5":14363,"_27402":57369,"_2946":57753},[],"Alert subscriptions and consumers of the VA events",{"_3462":2756,"_30116":2626,"_20912":57755,"_5":14363,"_27402":57369,"_2946":57756},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3462":2757,"_30116":2626,"_20912":57758,"_5":14363,"_27402":57369,"_2946":57759},[],"Review conditions filtering on the old event payload or subject",{"_3462":2758,"_30116":2626,"_20912":57761,"_5":14363,"_27402":57369,"_2946":57450},[],{"_3462":2759,"_30116":2626,"_20912":57763,"_5":14363,"_27402":57369,"_2946":57764},[],"Consumers that read the device `events` field",{"_3462":2760,"_30116":2626,"_20912":57766,"_5":14363,"_27402":57369,"_2946":57767},[],"Medium: the field disappears",{"_3462":2761,"_30116":2626,"_20912":57769,"_5":14363,"_27402":57369,"_2946":57770},[],"Use the new event endpoints",{"_3462":2762,"_30116":2626,"_20912":57772,"_5":14363,"_27402":57369,"_2946":57470},[],{"_3462":2763,"_30116":2626,"_20912":57774,"_5":14363,"_27402":57369,"_2946":57775},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3462":2764,"_30116":2626,"_20912":57777,"_5":14363,"_27402":57369,"_2946":57778},[],"Medium: the VA migration aborts",{"_3462":2765,"_30116":2626,"_20912":57780,"_5":14363,"_27402":57369,"_2946":57781},[],"Fix the affected roles before upgrading",{"_3462":2766,"_30116":2626,"_20912":57783,"_5":14363,"_27402":57369,"_2946":57402},[],{"_3462":2767,"_30116":2626,"_20912":57785,"_5":14363,"_27402":57369,"_2946":57786},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3462":2768,"_30116":2626,"_20912":57788,"_5":14363,"_27402":57369,"_2946":57789},[],"Low to medium: validation errors or changed defaults",{"_3462":2769,"_30116":2626,"_20912":57791,"_5":14363,"_27402":57369,"_2946":57792},[],"Update the values file",{"_3462":2770,"_30116":2626,"_20912":57794,"_5":14363,"_27402":57369,"_2946":57442},[],{"_3462":2771,"_30116":2626,"_20912":57796,"_5":14363,"_27402":57369,"_2946":57797},[],"Clients that send the DMS ID in the update body",{"_3462":2772,"_30116":2626,"_20912":57799,"_5":14363,"_27402":57369,"_2946":57800},[],"Low: the ID in the URL wins",{"_3462":2773,"_30116":2626,"_20912":57802,"_5":14363,"_27402":57369,"_2946":57803},[],"Send the ID in the URL",{"_3462":2774,"_30116":2626,"_20912":57805,"_5":14363,"_27402":57369,"_2946":57466},[],{"_3462":2775,"_30116":2626,"_20912":57807,"_5":14363,"_27402":57369,"_2946":57808},[],"Clients that send an `id` when creating or importing CAs",{"_3462":2776,"_30116":2626,"_20912":57810,"_5":14363,"_27402":57369,"_2946":57811},[],"Low: the ID in the body is ignored, and the field is removed",{"_3462":2777,"_30116":2626,"_20912":57813,"_5":14363,"_27402":57369,"_2946":57814},[],"Let the backend assign the ID and use the returned one",{"_3462":2778,"_30116":2626,"_20912":57816,"_5":14363,"_27402":57369,"_2946":57446},[],{"_3462":2779,"_30116":2626,"_20912":57818,"_5":14363,"_27402":57369,"_2946":57819},[],"Consumers that match on certificate `type`",{"_3462":2780,"_30116":2626,"_20912":57821,"_5":14363,"_27402":57369,"_2946":57822},[],"Low: two values are renamed",{"_3462":2781,"_30116":2626,"_20912":57824,"_5":14363,"_27402":57369,"_2946":57825},[],"Adapt consumers",{"_3462":2782,"_30116":2626,"_20912":57827,"_5":14363,"_27402":57369,"_2946":57438},[],{"_3462":2783,"_30116":2626,"_20912":57829,"_5":14363,"_27402":57369,"_2946":57830},[],"Any DMS",{"_3462":2784,"_30116":2626,"_20912":57832,"_5":14363,"_27402":57369,"_2946":57833},[],"Low: informational",{"_3462":2785,"_30116":2626,"_20912":57835,"_5":14363,"_27402":57369,"_2946":57836},[],"Read both blocks before editing",{"_3462":2786,"_30116":2626,"_20912":57838,"_5":14363,"_27402":57377,"_2946":57839},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3462":2787,"_30116":2626,"_20912":57841,"_5":14363,"_27402":57377,"_2946":57842},[],"Step 4 of the migration guide copies the data.",{"_3462":2788,"_30116":2626,"_20912":57844,"_5":14363,"_27402":57381,"_2946":57845},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3462":2789,"_30116":2626,"_20912":57847,"_5":14363,"_27402":57385,"_2946":57848},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3462":2790,"_30116":2626,"_20912":57850,"_5":14363,"_27402":57389,"_2946":57851},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3462":2791,"_30116":2626,"_20912":57853,"_5":14363,"_27402":57393,"_2946":57854},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3462":2792,"_30116":2626,"_20912":57856,"_5":14363,"_27402":57393,"_2946":57857},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3462":2793,"_30116":2626,"_20912":57859,"_5":14363,"_27402":57397,"_2946":57860},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3462":2794,"_30116":2626,"_20912":57862,"_5":14363,"_27402":57401,"_2946":57863},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3462":2795,"_30116":2626,"_20912":57865,"_5":14363,"_27402":57401,"_2946":57866},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3462":2796,"_30116":2626,"_20912":57868,"_5":14363,"_27402":57401,"_2946":57869},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3462":2797,"_30116":2626,"_20912":57871,"_5":14363,"_27402":57401,"_2946":57872},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3462":2798,"_30116":2626,"_20912":57874,"_5":14363,"_27402":57401,"_2946":57875},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3462":2799,"_30116":2626,"_20912":57877,"_5":14363,"_27402":57401,"_2946":57878},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3462":2800,"_30116":2626,"_20912":57880,"_5":14363,"_27402":57409,"_2946":57881},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3462":2801,"_30116":2626,"_20912":57883,"_5":14363,"_27402":57409,"_2946":57884},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3462":2802,"_30116":2626,"_20912":57886,"_5":14363,"_27402":57409,"_2946":57887},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3462":2803,"_30116":2626,"_20912":57889,"_5":14363,"_27402":57409,"_2946":57890},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3462":2804,"_30116":2626,"_20912":57892,"_5":14363,"_27402":57409,"_2946":57893},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3462":2805,"_30116":2626,"_20912":57895,"_5":14363,"_27402":57413,"_2946":57896},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3462":2806,"_30116":2626,"_20912":57898,"_5":14363,"_27402":57417,"_2946":57899},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3462":2807,"_30116":2626,"_20912":57901,"_5":14363,"_27402":57417,"_2946":57902},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3462":2808,"_30116":2626,"_20912":57904,"_5":14363,"_27402":57417,"_2946":57905},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3462":2809,"_30116":2626,"_20912":57907,"_5":14363,"_27402":57417,"_2946":57908},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3462":2810,"_30116":2626,"_20912":57910,"_5":14363,"_27402":57417,"_2946":57911},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3462":2811,"_30116":2626,"_20912":57913,"_5":14363,"_27402":57417,"_2946":57914},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3462":2812,"_30116":2626,"_20912":57916,"_5":14363,"_27402":57417,"_2946":57917},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3462":2813,"_30116":2626,"_20912":57919,"_5":14363,"_27402":57417,"_2946":57920},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3462":2814,"_30116":2626,"_20912":57922,"_5":14363,"_27402":57421,"_2946":57923},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3462":2815,"_30116":2626,"_20912":57925,"_5":14363,"_27402":57429,"_2946":57926},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3462":2816,"_30116":2626,"_20912":57928,"_5":14363,"_27402":57429,"_2946":57929},[],"Field in 3.8.0",{"_3462":2817,"_30116":2626,"_20912":57931,"_5":14363,"_27402":57429,"_2946":57932},[],"Field in 4.0.0",{"_3462":2818,"_30116":2626,"_20912":57934,"_5":14363,"_27402":57429,"_2946":57935},[],"`validate_server_cert`",{"_3462":2819,"_30116":2626,"_20912":57937,"_5":14363,"_27402":57429,"_2946":57938},[],"`insecure_skip_verify` (value negated)",{"_3462":2820,"_30116":2626,"_20912":57940,"_5":14363,"_27402":57429,"_2946":57941},[],"`oidc`",{"_3462":2821,"_30116":2626,"_20912":57943,"_5":14363,"_27402":57429,"_2946":57944},[],"`jwt_options`",{"_3462":2822,"_30116":2626,"_20912":57946,"_5":14363,"_27402":57429,"_2946":57947},[],"`apikey`",{"_3462":2823,"_30116":2626,"_20912":57949,"_5":14363,"_27402":57429,"_2946":57950},[],"`apikey_options`",{"_3462":2824,"_30116":2626,"_20912":57952,"_5":14363,"_27402":57429,"_2946":57953},[],"`mtls`",{"_3462":2825,"_30116":2626,"_20912":57955,"_5":14363,"_27402":57429,"_2946":57956},[],"`mtls_options`",{"_3462":2826,"_30116":2626,"_20912":57958,"_5":14363,"_27402":57429,"_2946":57959},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3462":2827,"_30116":2626,"_20912":57961,"_5":14363,"_27402":57429,"_2946":57962},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3462":2828,"_30116":2626,"_20912":57964,"_5":14363,"_27402":57429,"_2946":57965},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3462":2829,"_30116":2626,"_20912":57967,"_5":14363,"_27402":57433,"_2946":57968},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3462":2830,"_30116":2626,"_20912":57970,"_5":14363,"_27402":57433,"_2946":57971},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3462":2831,"_30116":2626,"_20912":57973,"_5":14363,"_27402":57433,"_2946":57974},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3462":2832,"_30116":2626,"_20912":57976,"_5":14363,"_27402":57437,"_2946":57977},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3462":2833,"_30116":2626,"_20912":57979,"_5":14363,"_27402":57441,"_2946":57980},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3462":2834,"_30116":2626,"_20912":57982,"_5":14363,"_27402":57445,"_2946":57983},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3462":2835,"_30116":2626,"_20912":57985,"_5":14363,"_27402":57449,"_2946":57986},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3462":2836,"_30116":2626,"_20912":57988,"_5":14363,"_27402":57449,"_2946":57989},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3462":2837,"_30116":2626,"_20912":57991,"_5":14363,"_27402":57449,"_2946":57992},[],"`POST /v1/devices/:id/events` creates an event.",{"_3462":2838,"_30116":2626,"_20912":57994,"_5":14363,"_27402":57449,"_2946":57995},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3462":2839,"_30116":2626,"_20912":57997,"_5":14363,"_27402":57453,"_2946":57998},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3462":2840,"_30116":2626,"_20912":58000,"_5":14363,"_27402":57457,"_2946":58001},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3462":2841,"_30116":2626,"_20912":58003,"_5":14363,"_27402":57457,"_2946":58004},[],"Route",{"_3462":2842,"_30116":2626,"_20912":58006,"_5":14363,"_27402":57457,"_2946":52402},[],{"_3462":2843,"_30116":2626,"_20912":58008,"_5":14363,"_27402":57457,"_2946":58009},[],"`GET /v1/crl-settings`",{"_3462":2844,"_30116":2626,"_20912":58011,"_5":14363,"_27402":57457,"_2946":58012},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3462":2845,"_30116":2626,"_20912":58014,"_5":14363,"_27402":57457,"_2946":58015},[],"`GET /v1/crl-settings/{ca-id}`",{"_3462":2846,"_30116":2626,"_20912":58017,"_5":14363,"_27402":57457,"_2946":58018},[],"Reads the settings of a CA.",{"_3462":2847,"_30116":2626,"_20912":58020,"_5":14363,"_27402":57457,"_2946":58021},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3462":2848,"_30116":2626,"_20912":58023,"_5":14363,"_27402":57457,"_2946":58024},[],"Replaces `crl_options`.",{"_3462":2849,"_30116":2626,"_20912":58026,"_5":14363,"_27402":57457,"_2946":58027},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3462":2850,"_30116":2626,"_20912":58029,"_5":14363,"_27402":57457,"_2946":58030},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3462":2851,"_30116":2626,"_20912":58032,"_5":14363,"_27402":57457,"_2946":58033},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3462":2852,"_30116":2626,"_20912":58035,"_5":14363,"_27402":57457,"_2946":58036},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3462":2853,"_30116":2626,"_20912":58038,"_5":14363,"_27402":57457,"_2946":58039},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3462":2854,"_30116":2626,"_20912":58041,"_5":14363,"_27402":57457,"_2946":58042},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3462":2855,"_30116":2626,"_20912":58044,"_5":14363,"_27402":57457,"_2946":58045},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3462":2856,"_30116":2626,"_20912":58047,"_5":14363,"_27402":57457,"_2946":58048},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3462":2857,"_30116":2626,"_20912":58050,"_5":14363,"_27402":57457,"_2946":58051},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3462":2858,"_30116":2626,"_20912":58053,"_5":14363,"_27402":57457,"_2946":58054},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3462":2859,"_30116":2626,"_20912":58056,"_5":14363,"_27402":57457,"_2946":58057},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3462":2860,"_30116":2626,"_20912":58059,"_5":14363,"_27402":57461,"_2946":58060},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3462":2861,"_30116":2626,"_20912":58062,"_5":14363,"_27402":57465,"_2946":58063},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3462":2862,"_30116":2626,"_20912":58065,"_5":14363,"_27402":57469,"_2946":58066},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3462":2863,"_30116":2626,"_20912":58068,"_5":14363,"_27402":57473,"_2946":58069},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3462":2864,"_30116":2626,"_20912":58071,"_5":14363,"_27402":57477,"_2946":58072},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3462":2865,"_30116":2626,"_20912":58074,"_5":14363,"_27402":57477,"_2946":58075},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3462":2866,"_30116":2626,"_20912":58077,"_5":14363,"_27402":57477,"_2946":58078},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3462":2867,"_30116":2626,"_20912":58080,"_5":14363,"_27402":57477,"_2946":58081},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3462":2868,"_30116":2626,"_20912":58083,"_5":14363,"_27402":57477,"_2946":58084},[],"Record the names of your local-storage PVCs:",{"_3462":2869,"_30116":2626,"_20912":58086,"_5":14363,"_27402":57477,"_2946":58087},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3462":2870,"_30116":2626,"_20912":58089,"_5":14363,"_27402":57481,"_2946":58090},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3462":2871,"_30116":2626,"_20912":58092,"_5":14363,"_27402":57481,"_2946":58093},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3462":2872,"_30116":2626,"_20912":58095,"_5":14363,"_27402":57481,"_2946":58096},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3462":2873,"_30116":2626,"_20912":58098,"_5":14363,"_27402":57481,"_2946":58099},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3462":2874,"_30116":2626,"_20912":58101,"_5":14363,"_27402":57481,"_2946":58102},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3462":2875,"_30116":2626,"_20912":58104,"_5":14363,"_27402":57485,"_2946":58105},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3462":2876,"_30116":2626,"_20912":58107,"_5":14363,"_27402":57485,"_2946":58108},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3462":2877,"_30116":2626,"_20912":58110,"_5":14363,"_27402":57485,"_2946":58111},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3462":2878,"_30116":2626,"_20912":58113,"_5":14363,"_27402":57485,"_2946":58114},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3462":2879,"_30116":2626,"_20912":58116,"_5":14363,"_27402":57485,"_2946":58117},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3462":2880,"_30116":2626,"_20912":58119,"_5":14363,"_27402":57485,"_2946":58120},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3462":2881,"_30116":2626,"_20912":58122,"_5":14363,"_27402":57485,"_2946":58123},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3462":2882,"_30116":2626,"_20912":58125,"_5":14363,"_27402":57485,"_2946":58126},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3462":2883,"_30116":2626,"_20912":58128,"_5":14363,"_27402":57485,"_2946":58129},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3462":2884,"_30116":2626,"_20912":58131,"_5":14363,"_27402":57485,"_2946":58132},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3462":2885,"_30116":2626,"_20912":58134,"_5":14363,"_27402":57485,"_2946":58135},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3462":2886,"_30116":2626,"_20912":58137,"_5":14363,"_27402":57485,"_2946":58138},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3462":2887,"_30116":2626,"_20912":58140,"_5":14363,"_27402":57489,"_2946":58141},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3462":2888,"_30116":2626,"_20912":58143,"_5":14363,"_27402":57489,"_2946":58144},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3462":2889,"_30116":2626,"_20912":58146,"_5":14363,"_27402":57493,"_2946":58147},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3462":2890,"_30116":2626,"_20912":58149,"_5":14363,"_27402":57493,"_2946":58150},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3462":2891,"_30116":2626,"_20912":58152,"_5":14363,"_27402":57493,"_2946":58153},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3462":2892,"_30116":2626,"_20912":58155,"_5":14363,"_27402":57493,"_2946":58156},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3462":2893,"_30116":2626,"_20912":58158,"_5":14363,"_27402":57493,"_2946":58159},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3462":2894,"_30116":2626,"_20912":58161,"_5":14363,"_27402":57493,"_2946":58162},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3462":2895,"_30116":2626,"_20912":58164,"_5":14363,"_27402":57493,"_2946":58165},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3462":2896,"_30116":2626,"_20912":58167,"_5":14363,"_27402":57493,"_2946":58168},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3462":2897,"_30116":2626,"_20912":58170,"_5":14363,"_27402":57493,"_2946":58171},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3462":2898,"_30116":2626,"_20912":58173,"_5":14363,"_27402":57493,"_2946":58174},[],"**Remove the helper and restore the recorded replica counts:**",{"_3462":2899,"_30116":2626,"_20912":58176,"_5":14363,"_27402":57493,"_2946":58177},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3462":2900,"_30116":2626,"_20912":58179,"_5":14363,"_27402":57497,"_2946":58180},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3462":2901,"_30116":2626,"_20912":58182,"_5":14363,"_27402":57497,"_2946":58183},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3462":2902,"_30116":2626,"_20912":58185,"_5":14363,"_27402":57501,"_2946":58186},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3462":2903,"_30116":2626,"_20912":58188,"_5":14363,"_27402":57501,"_2946":58189},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3462":2904,"_30116":2626,"_20912":58191,"_5":14363,"_27402":57501,"_2946":58192},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3462":2905,"_30116":2626,"_20912":58194,"_5":14363,"_27402":57501,"_2946":58195},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3462":2906,"_30116":2626,"_20912":58197,"_5":14363,"_27402":57501,"_2946":58198},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3462":2907,"_30116":2626,"_20912":58200,"_5":14363,"_27402":57501,"_2946":58201},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3462":2908,"_30116":2626,"_20912":58203,"_5":14363,"_27402":57501,"_2946":58204},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3462":2909,"_30116":2626,"_20912":58206,"_5":14363,"_27402":57501,"_2946":58207},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3462":2910,"_30116":2626,"_20912":58209,"_5":14363,"_27402":57505,"_2946":58210},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3462":2911,"_30116":2626,"_20912":58212,"_5":14363,"_27402":57505,"_2946":58213},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3462":2912,"_30116":2626,"_20912":58215,"_5":14363,"_27402":57505,"_2946":58216},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3462":2913,"_30116":2626,"_20912":58218,"_5":14363,"_27402":57505,"_2946":58219},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3462":2914,"_30116":2626,"_20912":58221,"_5":14363,"_27402":57505,"_2946":58222},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3462":2915,"_30116":2626,"_20912":58224,"_5":14363,"_27402":57505,"_2946":58225},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3462":2916,"_30116":2626,"_20912":58227,"_5":14363,"_27402":57505,"_2946":58228},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3462":2917,"_30116":2626,"_20912":58230,"_5":14363,"_27402":57505,"_2946":58231},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3462":2918,"_30116":2626,"_20912":58233,"_5":14363,"_27402":57505,"_2946":58234},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3462":2919,"_30116":2626,"_20912":58236,"_5":14363,"_27402":57505,"_2946":58237},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3462":2920,"_30116":2626,"_20912":58239,"_5":14363,"_27402":57505,"_2946":58240},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3462":2921,"_30116":2626,"_20912":58242,"_5":14363,"_27402":57508,"_2946":58243},[],"After the upgrade, check in this order:",{"_3462":2922,"_30116":2626,"_20912":58245,"_5":14363,"_27402":57508,"_2946":58246},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3462":2923,"_30116":2626,"_20912":58248,"_5":14363,"_27402":57508,"_2946":58249},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3462":2924,"_30116":2626,"_20912":58251,"_5":14363,"_27402":57508,"_2946":58252},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3462":2925,"_30116":2626,"_20912":58254,"_5":14363,"_27402":57508,"_2946":58255},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3462":2926,"_30116":2626,"_20912":58257,"_5":14363,"_27402":57508,"_2946":58258},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3462":2927,"_30116":2626,"_20912":58260,"_5":14363,"_27402":57508,"_2946":58261},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3462":2928,"_30116":2626,"_20912":58263,"_5":14363,"_27402":57508,"_2946":58264},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3462":2929,"_30116":2626,"_20912":58266,"_5":14363,"_27402":57508,"_2946":58267},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3462":2930,"_30116":2626,"_20912":58269,"_5":14363,"_27402":57508,"_2946":58270},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3462":2931,"_30116":2626,"_20912":58272,"_5":14363,"_27402":57508,"_2946":58273},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3462":2932,"_30116":2626,"_20912":58275,"_5":14363,"_27402":57508,"_2946":58276},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3462":2933,"_30116":2626,"_20912":58278,"_5":14363,"_27402":57508,"_2946":58279},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3462":2934,"_30116":2626,"_20912":58281,"_5":14363,"_27402":57508,"_2946":58282},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3462":2935,"_30116":2626,"_20912":58284,"_5":14363,"_27402":57508,"_2946":58285},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3462":2936,"_30116":2626,"_20912":58287,"_5":14363,"_27402":57508,"_2946":58288},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3462":2937,"_30116":2626,"_20912":58290,"_5":14363,"_27402":57512,"_2946":58291},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3462":2938,"_30116":2626,"_20912":58293,"_5":14363,"_27402":57512,"_2946":58294},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3462":2939,"_30116":2626,"_20912":58296,"_5":14363,"_27402":57512,"_2946":58297},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3462":2940,"_30116":2626,"_20912":58299,"_5":14363,"_27402":57512,"_2946":58300},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3462":2941,"_30116":2626,"_20912":58302,"_5":14363,"_27402":57512,"_2946":58303},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58306":58307,"_58308":58309,"_58310":58311,"_58312":58313,"_18124":2981,"_70035":2981},"language","english","sortableProperties",[2946,30116,5,27402],"sortablePropertiesWithTypes",{"_2946":24983,"_30116":24983,"_5":24983,"_27402":24983},"sorts",{"_2946":58314,"_30116":61245,"_5":64175,"_27402":67105},{"_4642":58315,"_58316":58317,"_5":24983},{"_14439":4180,"_14820":6978,"_14839":3201,"_29119":5142,"_14826":6957,"_19844":6460,"_14460":9362,"_14467":10962,"_29061":4618,"_29470":6992,"_29491":4077,"_29095":4707,"_34463":5954,"_29198":7493,"_29535":4933,"_34470":4784,"_34473":10475,"_34476":6981,"_34479":12429,"_29942":6078,"_34484":3999,"_34486":3250,"_29972":4572,"_14835":18138,"_34490":3428,"_34493":7528,"_34495":6187,"_29519":4579,"_29937":3922,"_29985":4983,"_34500":4764,"_34502":11585,"_34504":4746,"_29215":3046,"_34507":6615,"_34509":7541,"_34511":10449,"_34513":3652,"_34515":19438,"_29132":4404,"_34518":5841,"_34520":3525,"_29126":15966,"_29556":4701,"_34524":5553,"_34526":3406,"_34529":9171