947,"_40270":124950,"_40272":124953,"_40274":124956,"_40276":124959,"_40278":124962,"_40280":124965,"_40282":124968,"_40284":124971,"_40286":124974,"_40288":124977,"_40290":124980,"_40292":124983,"_40294":124986,"_40296":124989,"_40298":124992,"_40300":124995,"_40303":124998,"_40305":125001,"_40307":125004},{"_3462":70042,"_30116":70042,"_5":14715,"_2946":116080,"_30468":116081,"_20912":116084,"_27402":70042},"Despliega desde AWS Marketplace",[49167,116082,116083],"Despliegue","Otros modelos",[],{"_3462":70043,"_30116":70042,"_20912":116086,"_5":14363,"_27402":70042,"_2946":116087},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3462":70044,"_30116":70042,"_5":30465,"_20912":116089,"_27402":116090,"_2946":116091},[],"/docs/pr-preview/pr-64/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3462":70045,"_30116":70042,"_5":30465,"_20912":116093,"_27402":116094,"_2946":116095},[],"/docs/pr-preview/pr-64/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3462":70046,"_30116":70042,"_5":30465,"_20912":116097,"_27402":116098,"_2946":116099},[],"/docs/pr-preview/pr-64/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3462":70047,"_30116":70042,"_5":30465,"_20912":116101,"_27402":116102,"_2946":116103},[],"/docs/pr-preview/pr-64/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3462":70048,"_30116":70042,"_5":30465,"_20912":116105,"_27402":116106,"_2946":116107},[],"/docs/pr-preview/pr-64/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3462":70049,"_30116":70042,"_5":30465,"_20912":116109,"_27402":116110,"_2946":116111},[],"/docs/pr-preview/pr-64/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3462":70050,"_30116":70042,"_5":30465,"_20912":116113,"_27402":116114,"_2946":116115},[],"/docs/pr-preview/pr-64/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3462":70051,"_30116":70042,"_20912":116117,"_5":14363,"_27402":70042,"_2946":116118},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3462":70052,"_30116":70042,"_20912":116120,"_5":14363,"_27402":116090,"_2946":116121},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3462":70053,"_30116":70042,"_20912":116123,"_5":14363,"_27402":116090,"_2946":116124},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3462":70054,"_30116":70042,"_20912":116126,"_5":14363,"_27402":116090,"_2946":116127},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3462":70055,"_30116":70042,"_20912":116129,"_5":14363,"_27402":116094,"_2946":116130},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3462":70056,"_30116":70042,"_20912":116132,"_5":14363,"_27402":116094,"_2946":116133},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3462":70057,"_30116":70042,"_20912":116135,"_5":14363,"_27402":116094,"_2946":116136},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3462":70058,"_30116":70042,"_20912":116138,"_5":14363,"_27402":116098,"_2946":116139},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3462":70059,"_30116":70042,"_20912":116141,"_5":14363,"_27402":116102,"_2946":116142},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3462":70060,"_30116":70042,"_20912":116144,"_5":14363,"_27402":116106,"_2946":116145},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3462":70061,"_30116":70042,"_20912":116147,"_5":14363,"_27402":116110,"_2946":116148},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3462":70062,"_30116":70042,"_20912":116150,"_5":14363,"_27402":116114,"_2946":116151},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3462":70063,"_30116":70063,"_5":14715,"_2946":116153,"_30468":116154,"_20912":116155,"_27402":70063},"Despliega Lamassu",[49167,116082],[],{"_3462":70064,"_30116":70063,"_20912":116157,"_5":14363,"_27402":70063,"_2946":116158},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3462":70065,"_30116":70063,"_5":30465,"_20912":116160,"_27402":116161,"_2946":116162},[],"/docs/pr-preview/pr-64/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3462":70066,"_30116":70063,"_5":30465,"_20912":116164,"_27402":116165,"_2946":116166},[],"/docs/pr-preview/pr-64/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3462":70067,"_30116":70063,"_5":30465,"_20912":116168,"_27402":116169,"_2946":116170},[],"/docs/pr-preview/pr-64/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3462":70068,"_30116":70063,"_20912":116172,"_5":14363,"_27402":70063,"_2946":116173},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3462":70069,"_30116":70063,"_20912":116175,"_5":14363,"_27402":116161,"_2946":116176},[],"Modelo",{"_3462":70070,"_30116":70063,"_20912":116178,"_5":14363,"_27402":116161,"_2946":116179},[],"Recomendado para",{"_3462":70071,"_30116":70063,"_20912":116181,"_5":14363,"_27402":116161,"_2946":116182},[],"Quién opera la infraestructura",{"_3462":70072,"_30116":70063,"_20912":116184,"_5":14363,"_27402":116161,"_2946":116185},[],"Punto de partida",{"_3462":70073,"_30116":70063,"_20912":116187,"_5":14363,"_27402":116161,"_2946":49274},[],{"_3462":70074,"_30116":70063,"_20912":116189,"_5":14363,"_27402":116161,"_2946":116190},[],"Producción, entornos regulados y despliegues personalizados",{"_3462":70075,"_30116":70063,"_20912":116192,"_5":14363,"_27402":116161,"_2946":116193},[],"Tu equipo",{"_3462":70076,"_30116":70063,"_20912":116195,"_5":14363,"_27402":116161,"_2946":116196},[],"Helm o Fastlane",{"_3462":70077,"_30116":70063,"_20912":116198,"_5":14363,"_27402":116161,"_2946":49286},[],{"_3462":70078,"_30116":70063,"_20912":116200,"_5":14363,"_27402":116161,"_2946":116201},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3462":70079,"_30116":70063,"_20912":116203,"_5":14363,"_27402":116161,"_2946":116193},[],{"_3462":70080,"_30116":70063,"_20912":116205,"_5":14363,"_27402":116161,"_2946":116206},[],"Imagen preconfigurada en EC2",{"_3462":70081,"_30116":70063,"_20912":116208,"_5":14363,"_27402":116161,"_2946":49297},[],{"_3462":70082,"_30116":70063,"_20912":116210,"_5":14363,"_27402":116161,"_2946":116211},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3462":70083,"_30116":70063,"_20912":116213,"_5":14363,"_27402":116161,"_2946":49303},[],{"_3462":70084,"_30116":70063,"_20912":116215,"_5":14363,"_27402":116161,"_2946":116216},[],"Suscripción gestionada",{"_3462":70085,"_30116":70063,"_20912":116218,"_5":14363,"_27402":116161,"_2946":116219},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3462":70086,"_30116":70063,"_20912":116221,"_5":14363,"_27402":116161,"_2946":116222},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3462":70087,"_30116":70063,"_20912":116224,"_5":14363,"_27402":116161,"_2946":116225},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3462":70088,"_30116":70063,"_20912":116227,"_5":14363,"_27402":116165,"_2946":116228},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3462":70089,"_30116":70063,"_20912":116230,"_5":14363,"_27402":116169,"_2946":116231},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3462":70090,"_30116":70090,"_5":14715,"_2946":116233,"_30468":116234,"_20912":116235,"_27402":70090},"Utiliza Lamassu como SaaS",[49167,116082,116083],[],{"_3462":70091,"_30116":70090,"_20912":116237,"_5":14363,"_27402":70090,"_2946":116238},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3462":70092,"_30116":70090,"_5":30465,"_20912":116240,"_27402":116241,"_2946":116242},[],"/docs/pr-preview/pr-64/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3462":70093,"_30116":70090,"_5":30465,"_20912":116244,"_27402":116245,"_2946":116246},[],"/docs/pr-preview/pr-64/es/deployment/saas#planes","Planes",{"_3462":70094,"_30116":70090,"_5":30465,"_20912":116248,"_27402":116249,"_2946":116250},[],"/docs/pr-preview/pr-64/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3462":70095,"_30116":70090,"_20912":116252,"_5":14363,"_27402":70090,"_2946":116253},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3462":70096,"_30116":70090,"_20912":116255,"_5":14363,"_27402":116241,"_2946":116256},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3462":70097,"_30116":70090,"_20912":116258,"_5":14363,"_27402":116241,"_2946":116259},[],"Copias de seguridad automáticas.",{"_3462":70098,"_30116":70090,"_20912":116261,"_5":14363,"_27402":116241,"_2946":116262},[],"Actualizaciones de versión.",{"_3462":70099,"_30116":70090,"_20912":116264,"_5":14363,"_27402":116241,"_2946":116265},[],"Soporte técnico y SLA según el plan contratado.",{"_3462":70100,"_30116":70090,"_20912":116267,"_5":14363,"_27402":116245,"_2946":49358},[],{"_3462":70101,"_30116":70090,"_20912":116269,"_5":14363,"_27402":116245,"_2946":116270},[],"Dispositivos",{"_3462":70102,"_30116":70090,"_20912":116272,"_5":14363,"_27402":116245,"_2946":116273},[],"Soporte",{"_3462":70103,"_30116":70090,"_20912":116275,"_5":14363,"_27402":116245,"_2946":49367},[],{"_3462":70104,"_30116":70090,"_20912":116277,"_5":14363,"_27402":116245,"_2946":49370},[],{"_3462":70105,"_30116":70090,"_20912":116279,"_5":14363,"_27402":116245,"_2946":116280},[],"Hasta 1.000",{"_3462":70106,"_30116":70090,"_20912":116282,"_5":14363,"_27402":116245,"_2946":49376},[],{"_3462":70107,"_30116":70090,"_20912":116284,"_5":14363,"_27402":116245,"_2946":116285},[],"99,5 %",{"_3462":70108,"_30116":70090,"_20912":116287,"_5":14363,"_27402":116245,"_2946":49382},[],{"_3462":70109,"_30116":70090,"_20912":116289,"_5":14363,"_27402":116245,"_2946":116290},[],"Hasta 10.000",{"_3462":70110,"_30116":70090,"_20912":116292,"_5":14363,"_27402":116245,"_2946":116293},[],"Email y chat",{"_3462":70111,"_30116":70090,"_20912":116295,"_5":14363,"_27402":116245,"_2946":116296},[],"99,9 %",{"_3462":70112,"_30116":70090,"_20912":116298,"_5":14363,"_27402":116245,"_2946":49394},[],{"_3462":70113,"_30116":70090,"_20912":116300,"_5":14363,"_27402":116245,"_2946":116301},[],"Ilimitados",{"_3462":70114,"_30116":70090,"_20912":116303,"_5":14363,"_27402":116245,"_2946":116304},[],"Dedicado",{"_3462":70115,"_30116":70090,"_20912":116306,"_5":14363,"_27402":116245,"_2946":116307},[],"99,99 %",{"_3462":70116,"_30116":70090,"_20912":116309,"_5":14363,"_27402":116249,"_2946":116310},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3462":70117,"_30116":70090,"_20912":116312,"_5":14363,"_27402":116249,"_2946":116313},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3462":70118,"_30116":70118,"_5":14715,"_2946":49411,"_30468":116315,"_20912":116317,"_27402":70118},[49167,116082,116316],"Kubernetes autogestionado",[],{"_3462":70119,"_30116":70118,"_20912":116319,"_5":14363,"_27402":70118,"_2946":116320},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3462":70120,"_30116":70118,"_5":30465,"_20912":116322,"_27402":116323,"_2946":116324},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3462":70121,"_30116":70118,"_5":30465,"_20912":116326,"_27402":116327,"_2946":116328},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3462":70122,"_30116":70118,"_5":30465,"_20912":116330,"_27402":116331,"_2946":116332},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3462":70123,"_30116":70118,"_5":30465,"_20912":116334,"_27402":116335,"_2946":116336},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3462":70124,"_30116":70118,"_5":30465,"_20912":116338,"_27402":116339,"_2946":116340},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3462":70125,"_30116":70118,"_5":30465,"_20912":116342,"_27402":116343,"_2946":116344},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3462":70126,"_30116":70118,"_5":30465,"_20912":116346,"_27402":116347,"_2946":116348},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3462":70127,"_30116":70118,"_5":30465,"_20912":116350,"_27402":116351,"_2946":116352},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3462":70128,"_30116":70118,"_5":30465,"_20912":116354,"_27402":116355,"_2946":116356},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3462":70129,"_30116":70118,"_5":30465,"_20912":116358,"_27402":116359,"_2946":116360},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3462":70130,"_30116":70118,"_5":30465,"_20912":116362,"_27402":116363,"_2946":116364},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3462":70131,"_30116":70118,"_20912":116366,"_5":14363,"_27402":116323,"_2946":116367},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3462":70132,"_30116":70118,"_20912":116369,"_5":14363,"_27402":116323,"_2946":116370},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3462":70133,"_30116":70118,"_20912":116372,"_5":14363,"_27402":116327,"_2946":116373},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3462":70134,"_30116":70118,"_20912":116375,"_5":14363,"_27402":116327,"_2946":116376},[],"Fastlane instala o configura",{"_3462":70135,"_30116":70118,"_20912":116378,"_5":14363,"_27402":116327,"_2946":116379},[],"Tú sigues proporcionando",{"_3462":70136,"_30116":70118,"_20912":116381,"_5":14363,"_27402":116327,"_2946":116382},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3462":70137,"_30116":70118,"_20912":116384,"_5":14363,"_27402":116327,"_2946":116385},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3462":70138,"_30116":70118,"_20912":116387,"_5":14363,"_27402":116327,"_2946":116388},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3462":70139,"_30116":70118,"_20912":116390,"_5":14363,"_27402":116327,"_2946":116391},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3462":70140,"_30116":70118,"_20912":116393,"_5":14363,"_27402":116327,"_2946":116394},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3462":70141,"_30116":70118,"_20912":116396,"_5":14363,"_27402":116327,"_2946":116397},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3462":70142,"_30116":70118,"_20912":116399,"_5":14363,"_27402":116327,"_2946":116400},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3462":70143,"_30116":70118,"_20912":116402,"_5":14363,"_27402":116327,"_2946":116403},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3462":70144,"_30116":70118,"_20912":116405,"_5":14363,"_27402":116327,"_2946":116406},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3462":70145,"_30116":70118,"_20912":116408,"_5":14363,"_27402":116331,"_2946":116409},[],"Necesitas:",{"_3462":70146,"_30116":70118,"_20912":116411,"_5":14363,"_27402":116331,"_2946":116412},[],"un clúster Kubernetes existente",{"_3462":70147,"_30116":70118,"_20912":116414,"_5":14363,"_27402":116331,"_2946":116415},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3462":70148,"_30116":70118,"_20912":116417,"_5":14363,"_27402":116331,"_2946":49513},[],{"_3462":70149,"_30116":70118,"_20912":116419,"_5":14363,"_27402":116331,"_2946":23638},[],{"_3462":70150,"_30116":70118,"_20912":116421,"_5":14363,"_27402":116331,"_2946":116422},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3462":70151,"_30116":70118,"_20912":116424,"_5":14363,"_27402":116331,"_2946":116425},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3462":70152,"_30116":70118,"_20912":116427,"_5":14363,"_27402":116331,"_2946":116428},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3462":70153,"_30116":70118,"_20912":116430,"_5":14363,"_27402":116331,"_2946":116431},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3462":70154,"_30116":70118,"_20912":116433,"_5":14363,"_27402":116331,"_2946":116434},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3462":70155,"_30116":70118,"_20912":116436,"_5":14363,"_27402":116335,"_2946":116437},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3462":70156,"_30116":70118,"_20912":116439,"_5":14363,"_27402":116335,"_2946":116440},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3462":70157,"_30116":70118,"_20912":116442,"_5":14363,"_27402":116339,"_2946":116443},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3462":70158,"_30116":70118,"_20912":116445,"_5":14363,"_27402":116339,"_2946":116446},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3462":70159,"_30116":70118,"_20912":116448,"_5":14363,"_27402":116339,"_2946":116449},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3462":70160,"_30116":70118,"_20912":116451,"_5":14363,"_27402":116339,"_2946":116452},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3462":70161,"_30116":70118,"_20912":116454,"_5":14363,"_27402":116343,"_2946":116455},[],"Opción",{"_3462":70162,"_30116":70118,"_20912":116457,"_5":14363,"_27402":116343,"_2946":116458},[],"Valor predeterminado",{"_3462":70163,"_30116":70118,"_20912":116460,"_5":14363,"_27402":116343,"_2946":116461},[],"Propósito",{"_3462":70164,"_30116":70118,"_20912":116463,"_5":14363,"_27402":116343,"_2946":49560},[],{"_3462":70165,"_30116":70118,"_20912":116465,"_5":14363,"_27402":116343,"_2946":49563},[],{"_3462":70166,"_30116":70118,"_20912":116467,"_5":14363,"_27402":116343,"_2946":116468},[],"Muestra la ayuda",{"_3462":70167,"_30116":70118,"_20912":116470,"_5":14363,"_27402":116343,"_2946":49569},[],{"_3462":70168,"_30116":70118,"_20912":116472,"_5":14363,"_27402":116343,"_2946":116473},[],"contexto actual",{"_3462":70169,"_30116":70118,"_20912":116475,"_5":14363,"_27402":116343,"_2946":116476},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3462":70170,"_30116":70118,"_20912":116478,"_5":14363,"_27402":116343,"_2946":49578},[],{"_3462":70171,"_30116":70118,"_20912":116480,"_5":14363,"_27402":116343,"_2946":6523},[],{"_3462":70172,"_30116":70118,"_20912":116482,"_5":14363,"_27402":116343,"_2946":116483},[],"Omite prompts y genera credenciales para las dependencias",{"_3462":70173,"_30116":70118,"_20912":116485,"_5":14363,"_27402":116343,"_2946":49586},[],{"_3462":70174,"_30116":70118,"_20912":116487,"_5":14363,"_27402":116343,"_2946":49589},[],{"_3462":70175,"_30116":70118,"_20912":116489,"_5":14363,"_27402":116343,"_2946":116490},[],"Namespace de la instalación",{"_3462":70176,"_30116":70118,"_20912":116492,"_5":14363,"_27402":116343,"_2946":49595},[],{"_3462":70177,"_30116":70118,"_20912":116494,"_5":14363,"_27402":116343,"_2946":49598},[],{"_3462":70178,"_30116":70118,"_20912":116496,"_5":14363,"_27402":116343,"_2946":116497},[],"Dominio usado por la UI, OIDC y el certificado",{"_3462":70179,"_30116":70118,"_20912":116499,"_5":14363,"_27402":116343,"_2946":49604},[],{"_3462":70180,"_30116":70118,"_20912":116501,"_5":14363,"_27402":116343,"_2946":15061},[],{"_3462":70181,"_30116":70118,"_20912":116503,"_5":14363,"_27402":116343,"_2946":116504},[],"Versión del chart de Lamassu",{"_3462":70182,"_30116":70118,"_20912":116506,"_5":14363,"_27402":116343,"_2946":49612},[],{"_3462":70183,"_30116":70118,"_20912":116508,"_5":14363,"_27402":116343,"_2946":49615},[],{"_3462":70184,"_30116":70118,"_20912":116510,"_5":14363,"_27402":116343,"_2946":116511},[],"Puerto del listener HTTPS",{"_3462":70185,"_30116":70118,"_20912":116513,"_5":14363,"_27402":116343,"_2946":49621},[],{"_3462":70186,"_30116":70118,"_20912":116515,"_5":14363,"_27402":116343,"_2946":49624},[],{"_3462":70187,"_30116":70118,"_20912":116517,"_5":14363,"_27402":116343,"_2946":116518},[],"Puerto del listener HTTP",{"_3462":70188,"_30116":70118,"_20912":116520,"_5":14363,"_27402":116343,"_2946":49630},[],{"_3462":70189,"_30116":70118,"_20912":116522,"_5":14363,"_27402":116343,"_2946":49563},[],{"_3462":70190,"_30116":70118,"_20912":116524,"_5":14363,"_27402":116343,"_2946":116525},[],"Certificado PEM para TLS downstream",{"_3462":70191,"_30116":70118,"_20912":116527,"_5":14363,"_27402":116343,"_2946":49638},[],{"_3462":70192,"_30116":70118,"_20912":116529,"_5":14363,"_27402":116343,"_2946":49563},[],{"_3462":70193,"_30116":70118,"_20912":116531,"_5":14363,"_27402":116343,"_2946":116532},[],"Clave privada PEM para TLS downstream",{"_3462":70194,"_30116":70118,"_20912":116534,"_5":14363,"_27402":116343,"_2946":49646},[],{"_3462":70195,"_30116":70118,"_20912":116536,"_5":14363,"_27402":116343,"_2946":116537},[],"chart del repositorio",{"_3462":70196,"_30116":70118,"_20912":116539,"_5":14363,"_27402":116343,"_2946":116540},[],"Usa un chart local de Lamassu sin empaquetar",{"_3462":70197,"_30116":70118,"_20912":116542,"_5":14363,"_27402":116343,"_2946":49655},[],{"_3462":70198,"_30116":70118,"_20912":116544,"_5":14363,"_27402":116343,"_2946":116545},[],"detección automática",{"_3462":70199,"_30116":70118,"_20912":116547,"_5":14363,"_27402":116343,"_2946":116548},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3462":70200,"_30116":70118,"_20912":116550,"_5":14363,"_27402":116343,"_2946":49663},[],{"_3462":70201,"_30116":70118,"_20912":116552,"_5":14363,"_27402":116343,"_2946":6523},[],{"_3462":70202,"_30116":70118,"_20912":116554,"_5":14363,"_27402":116343,"_2946":116555},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3462":70203,"_30116":70118,"_20912":116557,"_5":14363,"_27402":116343,"_2946":49671},[],{"_3462":70204,"_30116":70118,"_20912":116559,"_5":14363,"_27402":116343,"_2946":6523},[],{"_3462":70205,"_30116":70118,"_20912":116561,"_5":14363,"_27402":116343,"_2946":116562},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3462":70206,"_30116":70118,"_20912":116564,"_5":14363,"_27402":116343,"_2946":49679},[],{"_3462":70207,"_30116":70118,"_20912":116566,"_5":14363,"_27402":116343,"_2946":6523},[],{"_3462":70208,"_30116":70118,"_20912":116568,"_5":14363,"_27402":116343,"_2946":116569},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3462":70209,"_30116":70118,"_20912":116571,"_5":14363,"_27402":116343,"_2946":49687},[],{"_3462":70210,"_30116":70118,"_20912":116573,"_5":14363,"_27402":116343,"_2946":6523},[],{"_3462":70211,"_30116":70118,"_20912":116575,"_5":14363,"_27402":116343,"_2946":116576},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3462":70212,"_30116":70118,"_20912":116578,"_5":14363,"_27402":116343,"_2946":49695},[],{"_3462":70213,"_30116":70118,"_20912":116580,"_5":14363,"_27402":116343,"_2946":49698},[],{"_3462":70214,"_30116":70118,"_20912":116582,"_5":14363,"_27402":116343,"_2946":116583},[],"Usa otro chart local de SoftHSM",{"_3462":70215,"_30116":70118,"_20912":116585,"_5":14363,"_27402":116343,"_2946":116586},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3462":70216,"_30116":70118,"_20912":116588,"_5":14363,"_27402":116347,"_2946":116589},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3462":70217,"_30116":70118,"_20912":116591,"_5":14363,"_27402":116347,"_2946":116592},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3462":70218,"_30116":70118,"_20912":116594,"_5":14363,"_27402":116347,"_2946":116595},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3462":70219,"_30116":70118,"_20912":116597,"_5":14363,"_27402":116347,"_2946":116598},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3462":70220,"_30116":70118,"_20912":116600,"_5":14363,"_27402":116347,"_2946":116601},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3462":70221,"_30116":70118,"_20912":116603,"_5":14363,"_27402":116347,"_2946":116604},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3462":70222,"_30116":70118,"_20912":116606,"_5":14363,"_27402":116351,"_2946":49725},[],{"_3462":70223,"_30116":70118,"_20912":116608,"_5":14363,"_27402":116351,"_2946":116609},[],"valida las herramientas locales y el clúster seleccionado",{"_3462":70224,"_30116":70118,"_20912":116611,"_5":14363,"_27402":116351,"_2946":116612},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3462":70225,"_30116":70118,"_20912":116614,"_5":14363,"_27402":116351,"_2946":116615},[],"crea el namespace",{"_3462":70226,"_30116":70118,"_20912":116617,"_5":14363,"_27402":116351,"_2946":116618},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3462":70227,"_30116":70118,"_20912":116620,"_5":14363,"_27402":116351,"_2946":116621},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3462":70228,"_30116":70118,"_20912":116623,"_5":14363,"_27402":116351,"_2946":116624},[],"instala RabbitMQ",{"_3462":70229,"_30116":70118,"_20912":116626,"_5":14363,"_27402":116351,"_2946":116627},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3462":70230,"_30116":70118,"_20912":116629,"_5":14363,"_27402":116351,"_2946":116630},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3462":70231,"_30116":70118,"_20912":116632,"_5":14363,"_27402":116351,"_2946":116633},[],"carga datos de ejemplo opcionalmente",{"_3462":70232,"_30116":70118,"_20912":116635,"_5":14363,"_27402":116351,"_2946":116636},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3462":70233,"_30116":70118,"_20912":116638,"_5":14363,"_27402":116355,"_2946":116639},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3462":70234,"_30116":70118,"_20912":116641,"_5":14363,"_27402":116355,"_2946":116642},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3462":70235,"_30116":70118,"_20912":116644,"_5":14363,"_27402":116359,"_2946":116645},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3462":70236,"_30116":70118,"_20912":116647,"_5":14363,"_27402":116359,"_2946":116648},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3462":70237,"_30116":70118,"_20912":116650,"_5":14363,"_27402":116359,"_2946":116651},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3462":70238,"_30116":70118,"_20912":116653,"_5":14363,"_27402":116363,"_2946":116654},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3462":70239,"_30116":70239,"_5":14715,"_2946":116656,"_30468":116657,"_20912":116658,"_27402":70239},"Instala con Helm",[49167,116082,116316],[],{"_3462":70240,"_30116":70239,"_20912":116660,"_5":14363,"_27402":70239,"_2946":116661},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3462":70241,"_30116":70239,"_5":30465,"_20912":116663,"_27402":116664,"_2946":116665},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3462":70242,"_30116":70239,"_5":30465,"_20912":116667,"_27402":116668,"_2946":116332},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3462":70243,"_30116":70239,"_5":30465,"_20912":116670,"_27402":116671,"_2946":116672},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3462":70244,"_30116":70239,"_5":30465,"_20912":116674,"_27402":116675,"_2946":116676},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3462":70245,"_30116":70239,"_5":30465,"_20912":116678,"_27402":116679,"_2946":116680},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3462":70246,"_30116":70239,"_5":30465,"_20912":116682,"_27402":116683,"_2946":116684},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3462":70247,"_30116":70239,"_5":30465,"_20912":116686,"_27402":116687,"_2946":116688},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3462":70248,"_30116":70239,"_5":30465,"_20912":116690,"_27402":116691,"_2946":116692},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3462":70249,"_30116":70239,"_5":30465,"_20912":116694,"_27402":116695,"_2946":116696},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3462":70250,"_30116":70239,"_5":30465,"_20912":116698,"_27402":116699,"_2946":116700},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3462":70251,"_30116":70239,"_5":30465,"_20912":116702,"_27402":116703,"_2946":116704},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3462":70252,"_30116":70239,"_20912":116706,"_5":14363,"_27402":116664,"_2946":116707},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3462":70253,"_30116":70239,"_20912":116709,"_5":14363,"_27402":116668,"_2946":116710},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3462":70254,"_30116":70239,"_20912":116712,"_5":14363,"_27402":116668,"_2946":116713},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3462":70255,"_30116":70239,"_20912":116715,"_5":14363,"_27402":116668,"_2946":116716},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3462":70256,"_30116":70239,"_20912":116718,"_5":14363,"_27402":116668,"_2946":116719},[],"un broker RabbitMQ accesible y sus credenciales",{"_3462":70257,"_30116":70239,"_20912":116721,"_5":14363,"_27402":116668,"_2946":116722},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3462":70258,"_30116":70239,"_20912":116724,"_5":14363,"_27402":116668,"_2946":116725},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3462":70259,"_30116":70239,"_20912":116727,"_5":14363,"_27402":116668,"_2946":116728},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3462":70260,"_30116":70239,"_20912":116730,"_5":14363,"_27402":116668,"_2946":116731},[],"una StorageClass y un diseño de tráfico externo",{"_3462":70261,"_30116":70239,"_20912":116733,"_5":14363,"_27402":116668,"_2946":116734},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3462":70262,"_30116":70239,"_20912":116736,"_5":14363,"_27402":116668,"_2946":116737},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3462":70263,"_30116":70239,"_20912":116739,"_5":14363,"_27402":116668,"_2946":116740},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3462":70264,"_30116":70239,"_20912":116742,"_5":14363,"_27402":116671,"_2946":116743},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3462":70265,"_30116":70239,"_20912":116745,"_5":14363,"_27402":116671,"_2946":116746},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3462":70266,"_30116":70239,"_20912":116748,"_5":14363,"_27402":116671,"_2946":116749},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3462":70267,"_30116":70239,"_20912":116751,"_5":14363,"_27402":116675,"_2946":116752},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3462":70268,"_30116":70239,"_20912":116754,"_5":14363,"_27402":116675,"_2946":116755},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3462":70269,"_30116":70239,"_20912":116757,"_5":14363,"_27402":116675,"_2946":116758},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3462":70270,"_30116":70239,"_20912":116760,"_5":14363,"_27402":116675,"_2946":116761},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3462":70271,"_30116":70239,"_20912":116763,"_5":14363,"_27402":116679,"_2946":116764},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3462":70272,"_30116":70239,"_20912":116766,"_5":14363,"_27402":116683,"_2946":116767},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3462":70273,"_30116":70239,"_20912":116769,"_5":14363,"_27402":116683,"_2946":116770},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3462":70274,"_30116":70239,"_20912":116772,"_5":14363,"_27402":116683,"_2946":116773},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3462":70275,"_30116":70239,"_20912":116775,"_5":14363,"_27402":116683,"_2946":116776},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3462":70276,"_30116":70239,"_20912":116778,"_5":14363,"_27402":116683,"_2946":116779},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3462":70277,"_30116":70239,"_20912":116781,"_5":14363,"_27402":116683,"_2946":116782},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3462":70278,"_30116":70239,"_20912":116784,"_5":14363,"_27402":116683,"_2946":116785},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3462":70279,"_30116":70239,"_20912":116787,"_5":14363,"_27402":116687,"_2946":116788},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3462":70280,"_30116":70239,"_20912":116790,"_5":14363,"_27402":116687,"_2946":116791},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3462":70281,"_30116":70239,"_20912":116793,"_5":14363,"_27402":116687,"_2946":116794},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3462":70282,"_30116":70239,"_20912":116796,"_5":14363,"_27402":116687,"_2946":116797},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3462":70283,"_30116":70239,"_20912":116799,"_5":14363,"_27402":116691,"_2946":116800},[],"Para instalar un checkout local:",{"_3462":70284,"_30116":70239,"_20912":116802,"_5":14363,"_27402":116695,"_2946":116803},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3462":70285,"_30116":70239,"_20912":116805,"_5":14363,"_27402":116695,"_2946":116806},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3462":70286,"_30116":70239,"_20912":116808,"_5":14363,"_27402":116699,"_2946":116809},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3462":70287,"_30116":70239,"_20912":116811,"_5":14363,"_27402":116699,"_2946":116812},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3462":70288,"_30116":70239,"_20912":116814,"_5":14363,"_27402":116699,"_2946":116815},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3462":70289,"_30116":70239,"_20912":116817,"_5":14363,"_27402":116699,"_2946":116818},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3462":70290,"_30116":70239,"_20912":116820,"_5":14363,"_27402":116699,"_2946":116821},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3462":70291,"_30116":70239,"_20912":116823,"_5":14363,"_27402":116703,"_2946":116824},[],"Antes de pasar a producción, revisa:",{"_3462":70292,"_30116":70239,"_20912":116826,"_5":14363,"_27402":116703,"_2946":116827},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3462":70293,"_30116":70239,"_20912":116829,"_5":14363,"_27402":116703,"_2946":116830},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3462":70294,"_30116":70239,"_20912":116832,"_5":14363,"_27402":116703,"_2946":116833},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3462":70295,"_30116":70239,"_20912":116835,"_5":14363,"_27402":116703,"_2946":116836},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3462":70296,"_30116":70239,"_20912":116838,"_5":14363,"_27402":116703,"_2946":116839},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3462":70297,"_30116":70239,"_20912":116841,"_5":14363,"_27402":116703,"_2946":116842},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3462":70298,"_30116":70239,"_20912":116844,"_5":14363,"_27402":116703,"_2946":116845},[],"SMTP, observabilidad y entrega de alertas",{"_3462":70299,"_30116":70239,"_20912":116847,"_5":14363,"_27402":116703,"_2946":116848},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3462":70300,"_30116":70239,"_20912":116850,"_5":14363,"_27402":116703,"_2946":116851},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3462":70301,"_30116":70301,"_5":14715,"_2946":116853,"_30468":116854,"_20912":116855,"_27402":70301},"Expón el Gateway",[49167,116082,116316],[],{"_3462":70302,"_30116":70301,"_20912":116857,"_5":14363,"_27402":70301,"_2946":116858},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3462":70303,"_30116":70301,"_5":30465,"_20912":116860,"_27402":116861,"_2946":116862},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3462":70304,"_30116":70301,"_5":30465,"_20912":116864,"_27402":116865,"_2946":116866},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3462":70305,"_30116":70301,"_5":30465,"_20912":116868,"_27402":116869,"_2946":116870},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3462":70306,"_30116":70301,"_5":30465,"_20912":116872,"_27402":116873,"_2946":49993},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/networking#k3s",{"_3462":70307,"_30116":70301,"_5":30465,"_20912":116875,"_27402":116876,"_2946":116877},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3462":70308,"_30116":70301,"_5":30465,"_20912":116879,"_27402":116880,"_2946":116881},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3462":70309,"_30116":70301,"_5":30465,"_20912":116883,"_27402":116884,"_2946":116885},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3462":70310,"_30116":70301,"_5":30465,"_20912":116887,"_27402":116888,"_2946":116889},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3462":70311,"_30116":70301,"_5":30465,"_20912":116891,"_27402":116892,"_2946":116893},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3462":70312,"_30116":70301,"_5":30465,"_20912":116895,"_27402":116896,"_2946":116897},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3462":70313,"_30116":70301,"_20912":116899,"_5":14363,"_27402":116861,"_2946":116900},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3462":70314,"_30116":70301,"_20912":116902,"_5":14363,"_27402":116861,"_2946":116903},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3462":70315,"_30116":70301,"_20912":116905,"_5":14363,"_27402":116865,"_2946":116906},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3462":70316,"_30116":70301,"_20912":116908,"_5":14363,"_27402":116865,"_2946":116909},[],"Defínelo únicamente cuando:",{"_3462":70317,"_30116":70301,"_20912":116911,"_5":14363,"_27402":116865,"_2946":116912},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3462":70318,"_30116":70301,"_20912":116914,"_5":14363,"_27402":116865,"_2946":116915},[],"esa dirección está asignada a este Gateway",{"_3462":70319,"_30116":70301,"_20912":116917,"_5":14363,"_27402":116865,"_2946":116918},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3462":70320,"_30116":70301,"_20912":116920,"_5":14363,"_27402":116865,"_2946":116921},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3462":70321,"_30116":70301,"_20912":116923,"_5":14363,"_27402":116865,"_2946":116924},[],"No confundas estos valores:",{"_3462":70322,"_30116":70301,"_20912":116926,"_5":14363,"_27402":116865,"_2946":116927},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3462":70323,"_30116":70301,"_20912":116929,"_5":14363,"_27402":116865,"_2946":116930},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3462":70324,"_30116":70301,"_20912":116932,"_5":14363,"_27402":116865,"_2946":116933},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3462":70325,"_30116":70301,"_20912":116935,"_5":14363,"_27402":116869,"_2946":116936},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3462":70326,"_30116":70301,"_20912":116938,"_5":14363,"_27402":116869,"_2946":116939},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3462":70327,"_30116":70301,"_20912":116941,"_5":14363,"_27402":116873,"_2946":116942},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3462":70328,"_30116":70301,"_20912":116944,"_5":14363,"_27402":116873,"_2946":116945},[],"Para el diseño recomendado:",{"_3462":70329,"_30116":70301,"_20912":116947,"_5":14363,"_27402":116873,"_2946":116948},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3462":70330,"_30116":70301,"_20912":116950,"_5":14363,"_27402":116873,"_2946":116951},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3462":70331,"_30116":70301,"_20912":116953,"_5":14363,"_27402":116873,"_2946":116954},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3462":70332,"_30116":70301,"_20912":116956,"_5":14363,"_27402":116873,"_2946":116957},[],"Apunta DNS a la dirección accesible de la VM.",{"_3462":70333,"_30116":70301,"_20912":116959,"_5":14363,"_27402":116873,"_2946":116960},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3462":70334,"_30116":70301,"_20912":116962,"_5":14363,"_27402":116876,"_2946":116963},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3462":70335,"_30116":70301,"_20912":116965,"_5":14363,"_27402":116880,"_2946":116966},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3462":70336,"_30116":70301,"_20912":116968,"_5":14363,"_27402":116880,"_2946":116969},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3462":70337,"_30116":70301,"_20912":116971,"_5":14363,"_27402":116884,"_2946":116972},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3462":70338,"_30116":70301,"_20912":116974,"_5":14363,"_27402":116884,"_2946":116975},[],"Requisito",{"_3462":70339,"_30116":70301,"_20912":116977,"_5":14363,"_27402":116884,"_2946":116978},[],"Diseño recomendado",{"_3462":70340,"_30116":70301,"_20912":116980,"_5":14363,"_27402":116884,"_2946":116981},[],"Consecuencia",{"_3462":70341,"_30116":70301,"_20912":116983,"_5":14363,"_27402":116884,"_2946":116984},[],"Varias URL o servicios de Lamassu",{"_3462":70342,"_30116":70301,"_20912":116986,"_5":14363,"_27402":116884,"_2946":116987},[],"Un Gateway con varias rutas",{"_3462":70343,"_30116":70301,"_20912":116989,"_5":14363,"_27402":116884,"_2946":116990},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3462":70344,"_30116":70301,"_20912":116992,"_5":14363,"_27402":116884,"_2946":116993},[],"Gateways independientes e IP externas distintas",{"_3462":70345,"_30116":70301,"_20912":116995,"_5":14363,"_27402":116884,"_2946":116996},[],"Una VIP por Gateway",{"_3462":70346,"_30116":70301,"_20912":116998,"_5":14363,"_27402":116884,"_2946":116999},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3462":70347,"_30116":70301,"_20912":117001,"_5":14363,"_27402":116884,"_2946":117002},[],"Gateways independientes, un nodo y una IP",{"_3462":70348,"_30116":70301,"_20912":117004,"_5":14363,"_27402":116884,"_2946":117005},[],"Puertos externos diferentes",{"_3462":70349,"_30116":70301,"_20912":117007,"_5":14363,"_27402":116884,"_2946":117008},[],"Los clientes deben indicar puertos no estándar",{"_3462":70350,"_30116":70301,"_20912":117010,"_5":14363,"_27402":116884,"_2946":117011},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3462":70351,"_30116":70301,"_20912":117013,"_5":14363,"_27402":116884,"_2946":117014},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3462":70352,"_30116":70301,"_20912":117016,"_5":14363,"_27402":116884,"_2946":117017},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3462":70353,"_30116":70301,"_20912":117019,"_5":14363,"_27402":116884,"_2946":117020},[],"Recursos Gateway separados pero proxy compartido",{"_3462":70354,"_30116":70301,"_20912":117022,"_5":14363,"_27402":116884,"_2946":117023},[],"Modo merged Gateway de Envoy",{"_3462":70355,"_30116":70301,"_20912":117025,"_5":14363,"_27402":116884,"_2946":117026},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3462":70356,"_30116":70301,"_20912":117028,"_5":14363,"_27402":116884,"_2946":117029},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3462":70357,"_30116":70301,"_20912":117031,"_5":14363,"_27402":116884,"_2946":117032},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3462":70358,"_30116":70301,"_20912":117034,"_5":14363,"_27402":116884,"_2946":117035},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3462":70359,"_30116":70301,"_20912":117037,"_5":14363,"_27402":116884,"_2946":117038},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3462":70360,"_30116":70301,"_20912":117040,"_5":14363,"_27402":116888,"_2946":117041},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3462":70361,"_30116":70301,"_20912":117043,"_5":14363,"_27402":116888,"_2946":117044},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3462":70362,"_30116":70301,"_20912":117046,"_5":14363,"_27402":116888,"_2946":117047},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3462":70363,"_30116":70301,"_20912":117049,"_5":14363,"_27402":116888,"_2946":117050},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3462":70364,"_30116":70301,"_20912":117052,"_5":14363,"_27402":116888,"_2946":117053},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3462":70365,"_30116":70301,"_20912":117055,"_5":14363,"_27402":116892,"_2946":117056},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3462":70366,"_30116":70301,"_20912":117058,"_5":14363,"_27402":116892,"_2946":117059},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3462":70367,"_30116":70301,"_20912":117061,"_5":14363,"_27402":116896,"_2946":117062},[],"Comprueba, en orden:",{"_3462":70368,"_30116":70301,"_20912":117064,"_5":14363,"_27402":116896,"_2946":117065},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3462":70369,"_30116":70301,"_20912":117067,"_5":14363,"_27402":116896,"_2946":117068},[],"Su estado contiene la dirección esperada.",{"_3462":70370,"_30116":70301,"_20912":117070,"_5":14363,"_27402":116896,"_2946":117071},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3462":70371,"_30116":70301,"_20912":117073,"_5":14363,"_27402":116896,"_2946":117074},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3462":70372,"_30116":70301,"_20912":117076,"_5":14363,"_27402":116896,"_2946":117077},[],"DNS resuelve al endpoint accesible externamente.",{"_3462":70373,"_30116":70301,"_20912":117079,"_5":14363,"_27402":116896,"_2946":117080},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3462":70374,"_30116":70301,"_20912":117082,"_5":14363,"_27402":116896,"_2946":117083},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3462":70375,"_30116":70375,"_5":14715,"_2946":49274,"_30468":117085,"_20912":117086,"_27402":70375},[49167,116082,116316],[],{"_3462":70376,"_30116":70375,"_20912":117088,"_5":14363,"_27402":70375,"_2946":117089},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3462":70377,"_30116":70375,"_5":30465,"_20912":117091,"_27402":117092,"_2946":117093},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3462":70378,"_30116":70375,"_5":30465,"_20912":117095,"_27402":117096,"_2946":117097},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3462":70379,"_30116":70375,"_5":30465,"_20912":117099,"_27402":117100,"_2946":117101},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3462":70380,"_30116":70375,"_5":30465,"_20912":117103,"_27402":117104,"_2946":117105},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3462":70381,"_30116":70375,"_5":30465,"_20912":117107,"_27402":117108,"_2946":117109},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3462":70382,"_30116":70375,"_5":30465,"_20912":117111,"_27402":117112,"_2946":117113},[],"/docs/pr-preview/pr-64/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3462":70383,"_30116":70375,"_20912":117115,"_5":14363,"_27402":117092,"_2946":117116},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3462":70384,"_30116":70375,"_20912":117118,"_5":14363,"_27402":117096,"_2946":117119},[],"Flujo",{"_3462":70385,"_30116":70375,"_20912":117121,"_5":14363,"_27402":117096,"_2946":117122},[],"Úsalo para",{"_3462":70386,"_30116":70375,"_20912":117124,"_5":14363,"_27402":117096,"_2946":117125},[],"Qué instala",{"_3462":70387,"_30116":70375,"_20912":117127,"_5":14363,"_27402":117096,"_2946":50248},[],{"_3462":70388,"_30116":70375,"_20912":117129,"_5":14363,"_27402":117096,"_2946":117130},[],"Producción y entornos controlados",{"_3462":70389,"_30116":70375,"_20912":117132,"_5":14363,"_27402":117096,"_2946":117133},[],"Servicios de Lamassu y recursos de Gateway API",{"_3462":70390,"_30116":70375,"_20912":117135,"_5":14363,"_27402":117096,"_2946":49411},[],{"_3462":70391,"_30116":70375,"_20912":117137,"_5":14363,"_27402":117096,"_2946":117138},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3462":70392,"_30116":70375,"_20912":117140,"_5":14363,"_27402":117096,"_2946":117141},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3462":70393,"_30116":70375,"_20912":117143,"_5":14363,"_27402":117100,"_2946":117144},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3462":70394,"_30116":70375,"_20912":117146,"_5":14363,"_27402":117100,"_2946":117147},[],"Área",{"_3462":70395,"_30116":70375,"_20912":117149,"_5":14363,"_27402":117100,"_2946":117150},[],"El chart de Lamassu proporciona",{"_3462":70396,"_30116":70375,"_20912":117152,"_5":14363,"_27402":117100,"_2946":117153},[],"Tú proporcionas",{"_3462":70397,"_30116":70375,"_20912":117155,"_5":14363,"_27402":117100,"_2946":117156},[],"Aplicaciones Lamassu",{"_3462":70398,"_30116":70375,"_20912":117158,"_5":14363,"_27402":117100,"_2946":117159},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3462":70399,"_30116":70375,"_20912":117161,"_5":14363,"_27402":117100,"_2946":117162},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3462":70400,"_30116":70375,"_20912":117164,"_5":14363,"_27402":117100,"_2946":117165},[],"Datos PostgreSQL",{"_3462":70401,"_30116":70375,"_20912":117167,"_5":14363,"_27402":117100,"_2946":117168},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3462":70402,"_30116":70375,"_20912":117170,"_5":14363,"_27402":117100,"_2946":117171},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3462":70403,"_30116":70375,"_20912":117173,"_5":14363,"_27402":117100,"_2946":117174},[],"Mensajería",{"_3462":70404,"_30116":70375,"_20912":117176,"_5":14363,"_27402":117100,"_2946":117177},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3462":70405,"_30116":70375,"_20912":117179,"_5":14363,"_27402":117100,"_2946":117180},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3462":70406,"_30116":70375,"_20912":117182,"_5":14363,"_27402":117100,"_2946":117183},[],"Identidad",{"_3462":70407,"_30116":70375,"_20912":117185,"_5":14363,"_27402":117100,"_2946":117186},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3462":70408,"_30116":70375,"_20912":117188,"_5":14363,"_27402":117100,"_2946":117189},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3462":70409,"_30116":70375,"_20912":117191,"_5":14363,"_27402":117100,"_2946":117192},[],"Enrutamiento externo",{"_3462":70410,"_30116":70375,"_20912":117194,"_5":14363,"_27402":117100,"_2946":117195},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3462":70411,"_30116":70375,"_20912":117197,"_5":14363,"_27402":117100,"_2946":117198},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3462":70412,"_30116":70375,"_20912":117200,"_5":14363,"_27402":117100,"_2946":50322},[],{"_3462":70413,"_30116":70375,"_20912":117202,"_5":14363,"_27402":117100,"_2946":117203},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3462":70414,"_30116":70375,"_20912":117205,"_5":14363,"_27402":117100,"_2946":117206},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3462":70415,"_30116":70375,"_20912":117208,"_5":14363,"_27402":117100,"_2946":117209},[],"Datos persistentes de la aplicación",{"_3462":70416,"_30116":70375,"_20912":117211,"_5":14363,"_27402":117100,"_2946":117212},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3462":70417,"_30116":70375,"_20912":117214,"_5":14363,"_27402":117100,"_2946":117215},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3462":70418,"_30116":70375,"_20912":117217,"_5":14363,"_27402":117100,"_2946":117218},[],"Integraciones opcionales",{"_3462":70419,"_30116":70375,"_20912":117220,"_5":14363,"_27402":117100,"_2946":117221},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3462":70420,"_30116":70375,"_20912":117223,"_5":14363,"_27402":117100,"_2946":117224},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3462":70421,"_30116":70375,"_20912":117226,"_5":14363,"_27402":117100,"_2946":117227},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3462":70422,"_30116":70375,"_20912":117229,"_5":14363,"_27402":117100,"_2946":117230},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3462":70423,"_30116":70375,"_20912":117232,"_5":14363,"_27402":117104,"_2946":117233},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3462":70424,"_30116":70375,"_20912":117235,"_5":14363,"_27402":117104,"_2946":117236},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3462":70425,"_30116":70375,"_20912":117238,"_5":14363,"_27402":117108,"_2946":117239},[],"Kubernetes 1.24 o posterior",{"_3462":70426,"_30116":70375,"_20912":117241,"_5":14363,"_27402":117108,"_2946":117242},[],"Helm 3.2 o posterior",{"_3462":70427,"_30116":70375,"_20912":117244,"_5":14363,"_27402":117108,"_2946":117245},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3462":70428,"_30116":70375,"_20912":117247,"_5":14363,"_27402":117108,"_2946":117248},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3462":70429,"_30116":70375,"_20912":117250,"_5":14363,"_27402":117108,"_2946":117251},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3462":70430,"_30116":70375,"_20912":117253,"_5":14363,"_27402":117108,"_2946":117254},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3462":70431,"_30116":70375,"_20912":117256,"_5":14363,"_27402":117108,"_2946":117257},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3462":70432,"_30116":70375,"_20912":117259,"_5":14363,"_27402":117112,"_2946":117260},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3462":70433,"_30116":70375,"_20912":117262,"_5":14363,"_27402":117112,"_2946":117263},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3462":70434,"_30116":70375,"_20912":117265,"_5":14363,"_27402":117112,"_2946":117266},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3462":70435,"_30116":70375,"_20912":117268,"_5":14363,"_27402":117112,"_2946":117269},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3462":70436,"_30116":70436,"_5":14715,"_2946":117271,"_30468":117272,"_20912":117274,"_27402":70436},"Resolución de problemas de despliegue",[49167,116082,117273],"Operación",[],{"_3462":70437,"_30116":70436,"_20912":117276,"_5":14363,"_27402":70436,"_2946":117277},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3462":70438,"_30116":70436,"_5":30465,"_20912":117279,"_27402":117280,"_2946":117281},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3462":70439,"_30116":70436,"_5":30465,"_20912":117283,"_27402":117284,"_2946":117285},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3462":70440,"_30116":70436,"_5":30465,"_20912":117287,"_27402":117288,"_2946":117289},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3462":70441,"_30116":70436,"_5":30465,"_20912":117291,"_27402":117292,"_2946":117293},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3462":70442,"_30116":70436,"_5":30465,"_20912":117295,"_27402":117296,"_2946":117297},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3462":70443,"_30116":70436,"_5":30465,"_20912":117299,"_27402":117300,"_2946":117301},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3462":70444,"_30116":70436,"_5":30465,"_20912":117303,"_27402":117304,"_2946":117305},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3462":70445,"_30116":70436,"_5":30465,"_20912":117307,"_27402":117308,"_2946":117309},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3462":70446,"_30116":70436,"_5":30465,"_20912":117311,"_27402":117312,"_2946":117313},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3462":70447,"_30116":70436,"_5":30465,"_20912":117315,"_27402":117316,"_2946":117317},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3462":70448,"_30116":70436,"_5":30465,"_20912":117319,"_27402":117320,"_2946":117321},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3462":70449,"_30116":70436,"_5":30465,"_20912":117323,"_27402":117324,"_2946":117325},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3462":70450,"_30116":70436,"_5":30465,"_20912":117327,"_27402":117328,"_2946":117329},[],"/docs/pr-preview/pr-64/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3462":70451,"_30116":70436,"_20912":117331,"_5":14363,"_27402":70436,"_2946":117332},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3462":70452,"_30116":70436,"_20912":117334,"_5":14363,"_27402":117284,"_2946":117335},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3462":70453,"_30116":70436,"_20912":117337,"_5":14363,"_27402":117288,"_2946":117338},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3462":70454,"_30116":70436,"_20912":117340,"_5":14363,"_27402":117292,"_2946":117341},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3462":70455,"_30116":70436,"_20912":117343,"_5":14363,"_27402":117296,"_2946":117344},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3462":70456,"_30116":70436,"_20912":117346,"_5":14363,"_27402":117300,"_2946":117347},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3462":70457,"_30116":70436,"_20912":117349,"_5":14363,"_27402":117304,"_2946":117350},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3462":70458,"_30116":70436,"_20912":117352,"_5":14363,"_27402":117304,"_2946":117353},[],"Ejecuta también la prueba de conectividad del chart:",{"_3462":70459,"_30116":70436,"_20912":117355,"_5":14363,"_27402":117304,"_2946":117356},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3462":70460,"_30116":70436,"_20912":117358,"_5":14363,"_27402":117304,"_2946":117359},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3462":70461,"_30116":70436,"_20912":117361,"_5":14363,"_27402":117308,"_2946":117362},[],"Si recibes un 401:",{"_3462":70462,"_30116":70436,"_20912":117364,"_5":14363,"_27402":117308,"_2946":117365},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3462":70463,"_30116":70436,"_20912":117367,"_5":14363,"_27402":117308,"_2946":117368},[],"verifica emisor, audiencia y expiración del token;",{"_3462":70464,"_30116":70436,"_20912":117370,"_5":14363,"_27402":117308,"_2946":117371},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3462":70465,"_30116":70436,"_20912":117373,"_5":14363,"_27402":117308,"_2946":117374},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3462":70466,"_30116":70436,"_20912":117376,"_5":14363,"_27402":117308,"_2946":117377},[],"Si el login termina pero las APIs devuelven 403:",{"_3462":70467,"_30116":70436,"_20912":117379,"_5":14363,"_27402":117308,"_2946":117380},[],"inspecciona los claims reales del token;",{"_3462":70468,"_30116":70436,"_20912":117382,"_5":14363,"_27402":117308,"_2946":117383},[],"confirma que coinciden con un principal activo;",{"_3462":70469,"_30116":70436,"_20912":117385,"_5":14363,"_27402":117308,"_2946":117386},[],"revisa las políticas concedidas al principal;",{"_3462":70470,"_30116":70436,"_20912":117388,"_5":14363,"_27402":117308,"_2946":117389},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3462":70471,"_30116":70436,"_20912":117391,"_5":14363,"_27402":117308,"_2946":117392},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3462":70472,"_30116":70436,"_20912":117394,"_5":14363,"_27402":117312,"_2946":117395},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3462":70473,"_30116":70436,"_20912":117397,"_5":14363,"_27402":117312,"_2946":117398},[],"Localiza el pod y Service de authz.",{"_3462":70474,"_30116":70436,"_20912":117400,"_5":14363,"_27402":117312,"_2946":117401},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3462":70475,"_30116":70436,"_20912":117403,"_5":14363,"_27402":117312,"_2946":117404},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3462":70476,"_30116":70436,"_20912":117406,"_5":14363,"_27402":117312,"_2946":117407},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3462":70477,"_30116":70436,"_20912":117409,"_5":14363,"_27402":117312,"_2946":117410},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3462":70478,"_30116":70436,"_20912":117412,"_5":14363,"_27402":117316,"_2946":117413},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3462":70479,"_30116":70436,"_20912":117415,"_5":14363,"_27402":117320,"_2946":117416},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3462":70480,"_30116":70436,"_20912":117418,"_5":14363,"_27402":117320,"_2946":117419},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3462":70481,"_30116":70436,"_20912":117421,"_5":14363,"_27402":117320,"_2946":117422},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3462":70482,"_30116":70436,"_20912":117424,"_5":14363,"_27402":117320,"_2946":117425},[],"volumen persistente sin enlazar;",{"_3462":70483,"_30116":70436,"_20912":117427,"_5":14363,"_27402":117320,"_2946":117428},[],"imagen inaccesible o política de pull incorrecta;",{"_3462":70484,"_30116":70436,"_20912":117430,"_5":14363,"_27402":117320,"_2946":117431},[],"configuración inválida del motor criptográfico;",{"_3462":70485,"_30116":70436,"_20912":117433,"_5":14363,"_27402":117320,"_2946":117434},[],"límites de CPU o memoria demasiado bajos;",{"_3462":70486,"_30116":70436,"_20912":117436,"_5":14363,"_27402":117320,"_2946":117437},[],"migración previa incompleta.",{"_3462":70487,"_30116":70436,"_20912":117439,"_5":14363,"_27402":117320,"_2946":117440},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3462":70488,"_30116":70436,"_20912":117442,"_5":14363,"_27402":117320,"_2946":117443},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3462":70489,"_30116":70436,"_20912":117445,"_5":14363,"_27402":117320,"_2946":117446},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3462":70490,"_30116":70436,"_20912":117448,"_5":14363,"_27402":117324,"_2946":117449},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3462":70491,"_30116":70436,"_20912":117451,"_5":14363,"_27402":117324,"_2946":117452},[],"verifica que esté habilitado en el servicio emisor;",{"_3462":70492,"_30116":70436,"_20912":117454,"_5":14363,"_27402":117324,"_2946":117455},[],"comprueba conectividad y credenciales AMQP;",{"_3462":70493,"_30116":70436,"_20912":117457,"_5":14363,"_27402":117324,"_2946":117458},[],"revisa exchange, routing key, colas y consumidores;",{"_3462":70494,"_30116":70436,"_20912":117460,"_5":14363,"_27402":117324,"_2946":117461},[],"inspecciona dead-letter queues;",{"_3462":70495,"_30116":70436,"_20912":117463,"_5":14363,"_27402":117324,"_2946":117464},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3462":70496,"_30116":70436,"_20912":117466,"_5":14363,"_27402":117324,"_2946":117467},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3462":70497,"_30116":70436,"_20912":117469,"_5":14363,"_27402":117324,"_2946":117470},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3462":70498,"_30116":70436,"_20912":117472,"_5":14363,"_27402":117324,"_2946":117473},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3462":70499,"_30116":70436,"_20912":117475,"_5":14363,"_27402":117324,"_2946":117476},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3462":70500,"_30116":70436,"_20912":117478,"_5":14363,"_27402":117324,"_2946":117479},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3462":70501,"_30116":70436,"_20912":117481,"_5":14363,"_27402":117324,"_2946":117482},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3462":70502,"_30116":70436,"_20912":117484,"_5":14363,"_27402":117324,"_2946":117485},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3462":70503,"_30116":70436,"_20912":117487,"_5":14363,"_27402":117328,"_2946":117488},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3462":70504,"_30116":70436,"_20912":117490,"_5":14363,"_27402":117328,"_2946":117491},[],"Antes de cerrar una incidencia, guarda:",{"_3462":70505,"_30116":70436,"_20912":117493,"_5":14363,"_27402":117328,"_2946":117494},[],"causa confirmada;",{"_3462":70506,"_30116":70436,"_20912":117496,"_5":14363,"_27402":117328,"_2946":117497},[],"alcance temporal y recursos afectados;",{"_3462":70507,"_30116":70436,"_20912":117499,"_5":14363,"_27402":117328,"_2946":117500},[],"comandos o consultas utilizados;",{"_3462":70508,"_30116":70436,"_20912":117502,"_5":14363,"_27402":117328,"_2946":117503},[],"cambio aplicado y forma de revertirlo;",{"_3462":70509,"_30116":70436,"_20912":117505,"_5":14363,"_27402":117328,"_2946":117506},[],"validación desde un consumidor;",{"_3462":70510,"_30116":70436,"_20912":117508,"_5":14363,"_27402":117328,"_2946":117509},[],"acción preventiva y propietario.",{"_3462":70511,"_30116":70511,"_5":14715,"_2946":117511,"_30468":117512,"_20912":117515,"_27402":70511},"Control de acceso",[49167,117513,117514],"Plataforma","Administración",[],{"_3462":70512,"_30116":70511,"_20912":117517,"_5":14363,"_27402":70511,"_2946":117518},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3462":70513,"_30116":70511,"_5":30465,"_20912":117520,"_27402":117521,"_2946":117522},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3462":70514,"_30116":70511,"_5":30465,"_20912":117524,"_27402":117525,"_2946":117526},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3462":70515,"_30116":70511,"_5":30465,"_20912":117528,"_27402":117529,"_2946":117530},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3462":70516,"_30116":70511,"_5":30465,"_20912":117532,"_27402":117533,"_2946":117534},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3462":70517,"_30116":70511,"_5":30465,"_20912":117536,"_27402":117537,"_2946":117538},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3462":70518,"_30116":70511,"_5":30465,"_20912":117540,"_27402":117541,"_2946":117542},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3462":70519,"_30116":70511,"_5":30465,"_20912":117544,"_27402":117545,"_2946":117546},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3462":70520,"_30116":70511,"_5":30465,"_20912":117548,"_27402":117549,"_2946":117550},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3462":70521,"_30116":70511,"_5":30465,"_20912":117552,"_27402":117553,"_2946":117554},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3462":70522,"_30116":70511,"_5":30465,"_20912":117556,"_27402":117557,"_2946":117558},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3462":70523,"_30116":70511,"_5":30465,"_20912":117560,"_27402":117561,"_2946":117562},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3462":70524,"_30116":70511,"_5":30465,"_20912":117564,"_27402":117565,"_2946":117566},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3462":70525,"_30116":70511,"_5":30465,"_20912":117568,"_27402":117569,"_2946":117570},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3462":70526,"_30116":70511,"_5":30465,"_20912":117572,"_27402":117573,"_2946":117574},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3462":70527,"_30116":70511,"_5":30465,"_20912":117576,"_27402":117577,"_2946":117578},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3462":70528,"_30116":70511,"_5":30465,"_20912":117580,"_27402":117581,"_2946":116688},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3462":70529,"_30116":70511,"_5":30465,"_20912":117583,"_27402":117584,"_2946":117585},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3462":70530,"_30116":70511,"_5":30465,"_20912":117587,"_27402":117588,"_2946":117589},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3462":70531,"_30116":70511,"_5":30465,"_20912":117591,"_27402":117592,"_2946":117593},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3462":70532,"_30116":70511,"_5":30465,"_20912":117595,"_27402":117596,"_2946":117597},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3462":70533,"_30116":70511,"_5":30465,"_20912":117599,"_27402":117600,"_2946":117601},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3462":70534,"_30116":70511,"_5":30465,"_20912":117603,"_27402":117604,"_2946":117605},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3462":70535,"_30116":70511,"_5":30465,"_20912":117607,"_27402":117608,"_2946":117609},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3462":70536,"_30116":70511,"_5":30465,"_20912":117611,"_27402":117612,"_2946":117613},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3462":70537,"_30116":70511,"_5":30465,"_20912":117615,"_27402":117616,"_2946":117617},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3462":70538,"_30116":70511,"_5":30465,"_20912":117619,"_27402":117620,"_2946":117621},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3462":70539,"_30116":70511,"_5":30465,"_20912":117623,"_27402":117624,"_2946":117625},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3462":70540,"_30116":70511,"_5":30465,"_20912":117627,"_27402":117628,"_2946":117629},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3462":70541,"_30116":70511,"_5":30465,"_20912":117631,"_27402":117632,"_2946":117633},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3462":70542,"_30116":70511,"_5":30465,"_20912":117635,"_27402":117636,"_2946":117637},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3462":70543,"_30116":70511,"_5":30465,"_20912":117639,"_27402":117640,"_2946":117641},[],"/docs/pr-preview/pr-64/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3462":70544,"_30116":70511,"_20912":117643,"_5":14363,"_27402":70511,"_2946":117644},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3462":70545,"_30116":70511,"_20912":117646,"_5":14363,"_27402":70511,"_2946":117647},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3462":70546,"_30116":70511,"_20912":117649,"_5":14363,"_27402":70511,"_2946":117650},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3462":70547,"_30116":70511,"_20912":117652,"_5":14363,"_27402":117521,"_2946":117653},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3462":70548,"_30116":70511,"_20912":117655,"_5":14363,"_27402":117521,"_2946":117656},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3462":70549,"_30116":70511,"_20912":117658,"_5":14363,"_27402":117521,"_2946":117659},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3462":70550,"_30116":70511,"_20912":117661,"_5":14363,"_27402":117521,"_2946":117662},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3462":70551,"_30116":70511,"_20912":117664,"_5":14363,"_27402":117521,"_2946":117665},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3462":70552,"_30116":70511,"_20912":117667,"_5":14363,"_27402":117521,"_2946":117668},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3462":70553,"_30116":70511,"_20912":117670,"_5":14363,"_27402":117525,"_2946":117671},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3462":70554,"_30116":70511,"_20912":117673,"_5":14363,"_27402":117525,"_2946":117674},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3462":70555,"_30116":70511,"_20912":117676,"_5":14363,"_27402":117529,"_2946":117677},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3462":70556,"_30116":70511,"_20912":117679,"_5":14363,"_27402":117529,"_2946":117680},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3462":70557,"_30116":70511,"_20912":117682,"_5":14363,"_27402":117529,"_2946":117683},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3462":70558,"_30116":70511,"_20912":117685,"_5":14363,"_27402":117529,"_2946":117686},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3462":70559,"_30116":70511,"_20912":117688,"_5":14363,"_27402":117529,"_2946":117689},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3462":70560,"_30116":70511,"_20912":117691,"_5":14363,"_27402":117529,"_2946":117692},[],"Carga por separado las políticas concedidas a cada principal.",{"_3462":70561,"_30116":70511,"_20912":117694,"_5":14363,"_27402":117529,"_2946":117695},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3462":70562,"_30116":70511,"_20912":117697,"_5":14363,"_27402":117529,"_2946":117698},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3462":70563,"_30116":70511,"_20912":117700,"_5":14363,"_27402":117529,"_2946":117701},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3462":70564,"_30116":70511,"_20912":117703,"_5":14363,"_27402":117529,"_2946":117704},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3462":70565,"_30116":70511,"_20912":117706,"_5":14363,"_27402":117529,"_2946":117707},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3462":70566,"_30116":70511,"_20912":117709,"_5":14363,"_27402":117529,"_2946":117710},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3462":70567,"_30116":70511,"_20912":117712,"_5":14363,"_27402":117533,"_2946":117713},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3462":70568,"_30116":70511,"_20912":117715,"_5":14363,"_27402":117533,"_2946":117716},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3462":70569,"_30116":70511,"_20912":117718,"_5":14363,"_27402":117533,"_2946":117719},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3462":70570,"_30116":70511,"_20912":117721,"_5":14363,"_27402":117533,"_2946":117722},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3462":70571,"_30116":70511,"_20912":117724,"_5":14363,"_27402":117533,"_2946":117725},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3462":70572,"_30116":70511,"_20912":117727,"_5":14363,"_27402":117533,"_2946":117728},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3462":70573,"_30116":70511,"_20912":117730,"_5":14363,"_27402":117533,"_2946":117731},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3462":70574,"_30116":70511,"_20912":117733,"_5":14363,"_27402":117533,"_2946":117734},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3462":70575,"_30116":70511,"_20912":117736,"_5":14363,"_27402":117537,"_2946":117737},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3462":70576,"_30116":70511,"_20912":117739,"_5":14363,"_27402":117537,"_2946":117740},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3462":70577,"_30116":70511,"_20912":117742,"_5":14363,"_27402":117537,"_2946":117743},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3462":70578,"_30116":70511,"_20912":117745,"_5":14363,"_27402":117537,"_2946":117746},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3462":70579,"_30116":70511,"_20912":117748,"_5":14363,"_27402":117537,"_2946":117749},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3462":70580,"_30116":70511,"_20912":117751,"_5":14363,"_27402":117537,"_2946":117752},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3462":70581,"_30116":70511,"_20912":117754,"_5":14363,"_27402":117537,"_2946":117755},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3462":70582,"_30116":70511,"_20912":117757,"_5":14363,"_27402":117537,"_2946":117758},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3462":70583,"_30116":70511,"_20912":117760,"_5":14363,"_27402":117537,"_2946":117761},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3462":70584,"_30116":70511,"_20912":117763,"_5":14363,"_27402":117537,"_2946":117764},[],"Las acciones se dividen en dos grupos:",{"_3462":70585,"_30116":70511,"_20912":117766,"_5":14363,"_27402":117537,"_2946":117767},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3462":70586,"_30116":70511,"_20912":117769,"_5":14363,"_27402":117537,"_2946":117770},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3462":70587,"_30116":70511,"_20912":117772,"_5":14363,"_27402":117537,"_2946":117773},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3462":70588,"_30116":70511,"_20912":117775,"_5":14363,"_27402":117541,"_2946":117776},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3462":70589,"_30116":70511,"_20912":117778,"_5":14363,"_27402":117541,"_2946":117779},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3462":70590,"_30116":70511,"_20912":117781,"_5":14363,"_27402":117541,"_2946":117782},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3462":70591,"_30116":70511,"_20912":117784,"_5":14363,"_27402":117545,"_2946":117785},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3462":70592,"_30116":70511,"_20912":117787,"_5":14363,"_27402":117545,"_2946":117788},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3462":70593,"_30116":70511,"_20912":117790,"_5":14363,"_27402":117545,"_2946":117791},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3462":70594,"_30116":70511,"_20912":117793,"_5":14363,"_27402":117545,"_2946":117794},[],"Los operadores implementados son:",{"_3462":70595,"_30116":70511,"_20912":117796,"_5":14363,"_27402":117545,"_2946":117797},[],"`equals`, para igualdad exacta;",{"_3462":70596,"_30116":70511,"_20912":117799,"_5":14363,"_27402":117545,"_2946":117800},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3462":70597,"_30116":70511,"_20912":117802,"_5":14363,"_27402":117545,"_2946":117803},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3462":70598,"_30116":70511,"_20912":117805,"_5":14363,"_27402":117545,"_2946":117806},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3462":70599,"_30116":70511,"_20912":117808,"_5":14363,"_27402":117549,"_2946":117809},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3462":70600,"_30116":70511,"_20912":117811,"_5":14363,"_27402":117549,"_2946":117812},[],"Los modos disponibles son:",{"_3462":70601,"_30116":70511,"_20912":117814,"_5":14363,"_27402":117549,"_2946":117815},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3462":70602,"_30116":70511,"_20912":117817,"_5":14363,"_27402":117549,"_2946":117818},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3462":70603,"_30116":70511,"_20912":117820,"_5":14363,"_27402":117549,"_2946":117821},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3462":70604,"_30116":70511,"_20912":117823,"_5":14363,"_27402":117549,"_2946":117824},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3462":70605,"_30116":70511,"_20912":117826,"_5":14363,"_27402":117549,"_2946":117827},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3462":70606,"_30116":70511,"_20912":117829,"_5":14363,"_27402":117549,"_2946":117830},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3462":70607,"_30116":70511,"_20912":117832,"_5":14363,"_27402":117553,"_2946":117833},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3462":70608,"_30116":70511,"_20912":117835,"_5":14363,"_27402":117553,"_2946":117836},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3462":70609,"_30116":70511,"_20912":117838,"_5":14363,"_27402":117553,"_2946":117839},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3462":70610,"_30116":70511,"_20912":117841,"_5":14363,"_27402":117553,"_2946":117842},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3462":70611,"_30116":70511,"_20912":117844,"_5":14363,"_27402":117561,"_2946":117845},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3462":70612,"_30116":70511,"_20912":117847,"_5":14363,"_27402":117561,"_2946":117848},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3462":70613,"_30116":70511,"_20912":117850,"_5":14363,"_27402":117565,"_2946":117851},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3462":70614,"_30116":70511,"_20912":117853,"_5":14363,"_27402":117565,"_2946":117854},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3462":70615,"_30116":70511,"_20912":117856,"_5":14363,"_27402":117569,"_2946":117857},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3462":70616,"_30116":70511,"_20912":117859,"_5":14363,"_27402":117569,"_2946":117860},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3462":70617,"_30116":70511,"_20912":117862,"_5":14363,"_27402":117569,"_2946":117863},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3462":70618,"_30116":70511,"_20912":117865,"_5":14363,"_27402":117573,"_2946":117866},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3462":70619,"_30116":70511,"_20912":117868,"_5":14363,"_27402":117573,"_2946":117869},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3462":70620,"_30116":70511,"_20912":117871,"_5":14363,"_27402":117573,"_2946":117872},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3462":70621,"_30116":70511,"_20912":117874,"_5":14363,"_27402":117573,"_2946":117875},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3462":70622,"_30116":70511,"_20912":117877,"_5":14363,"_27402":117573,"_2946":117878},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3462":70623,"_30116":70511,"_20912":117880,"_5":14363,"_27402":117573,"_2946":117881},[],"Ten en cuenta que:",{"_3462":70624,"_30116":70511,"_20912":117883,"_5":14363,"_27402":117573,"_2946":117884},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3462":70625,"_30116":70511,"_20912":117886,"_5":14363,"_27402":117573,"_2946":117887},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3462":70626,"_30116":70511,"_20912":117889,"_5":14363,"_27402":117573,"_2946":117890},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3462":70627,"_30116":70511,"_20912":117892,"_5":14363,"_27402":117577,"_2946":117893},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3462":70628,"_30116":70511,"_20912":117895,"_5":14363,"_27402":117577,"_2946":117896},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3462":70629,"_30116":70511,"_20912":117898,"_5":14363,"_27402":117577,"_2946":117899},[],"acceso completo y de solo lectura a KMS;",{"_3462":70630,"_30116":70511,"_20912":117901,"_5":14363,"_27402":117577,"_2946":117902},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3462":70631,"_30116":70511,"_20912":117904,"_5":14363,"_27402":117577,"_2946":117905},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3462":70632,"_30116":70511,"_20912":117907,"_5":14363,"_27402":117577,"_2946":117908},[],"acceso a la interfaz;",{"_3462":70633,"_30116":70511,"_20912":117910,"_5":14363,"_27402":117577,"_2946":117911},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3462":70634,"_30116":70511,"_20912":117913,"_5":14363,"_27402":117577,"_2946":117914},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3462":70635,"_30116":70511,"_20912":117916,"_5":14363,"_27402":117577,"_2946":117917},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3462":70636,"_30116":70511,"_20912":117919,"_5":14363,"_27402":117581,"_2946":117920},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3462":70637,"_30116":70511,"_20912":117922,"_5":14363,"_27402":117581,"_2946":117923},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3462":70638,"_30116":70511,"_20912":117925,"_5":14363,"_27402":117581,"_2946":117926},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3462":70639,"_30116":70511,"_20912":117928,"_5":14363,"_27402":117584,"_2946":117929},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3462":70640,"_30116":70511,"_20912":117931,"_5":14363,"_27402":117588,"_2946":117932},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3462":70641,"_30116":70511,"_20912":117934,"_5":14363,"_27402":117588,"_2946":117935},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3462":70642,"_30116":70511,"_20912":117937,"_5":14363,"_27402":117592,"_2946":117938},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3462":70643,"_30116":70511,"_20912":117940,"_5":14363,"_27402":117596,"_2946":117941},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3462":70644,"_30116":70511,"_20912":117943,"_5":14363,"_27402":117600,"_2946":117944},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3462":70645,"_30116":70511,"_20912":117946,"_5":14363,"_27402":117604,"_2946":117947},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3462":70646,"_30116":70511,"_20912":117949,"_5":14363,"_27402":117604,"_2946":117950},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3462":70647,"_30116":70511,"_20912":117952,"_5":14363,"_27402":117608,"_2946":117953},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3462":70648,"_30116":70511,"_20912":117955,"_5":14363,"_27402":117608,"_2946":117956},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3462":70649,"_30116":70511,"_20912":117958,"_5":14363,"_27402":117608,"_2946":117959},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3462":70650,"_30116":70511,"_20912":117961,"_5":14363,"_27402":117608,"_2946":117962},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3462":70651,"_30116":70511,"_20912":117964,"_5":14363,"_27402":117608,"_2946":117965},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3462":70652,"_30116":70511,"_20912":117967,"_5":14363,"_27402":117608,"_2946":117968},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3462":70653,"_30116":70511,"_20912":117970,"_5":14363,"_27402":117608,"_2946":117971},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3462":70654,"_30116":70511,"_20912":117973,"_5":14363,"_27402":117608,"_2946":117974},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3462":70655,"_30116":70511,"_20912":117976,"_5":14363,"_27402":117612,"_2946":117977},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3462":70656,"_30116":70511,"_20912":117979,"_5":14363,"_27402":117612,"_2946":117980},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3462":70657,"_30116":70511,"_20912":117982,"_5":14363,"_27402":117612,"_2946":117983},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3462":70658,"_30116":70511,"_20912":117985,"_5":14363,"_27402":117616,"_2946":117986},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3462":70659,"_30116":70511,"_20912":117988,"_5":14363,"_27402":117616,"_2946":117989},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3462":70660,"_30116":70511,"_20912":117991,"_5":14363,"_27402":117616,"_2946":117992},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3462":70661,"_30116":70511,"_20912":117994,"_5":14363,"_27402":117616,"_2946":117995},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3462":70662,"_30116":70511,"_20912":117997,"_5":14363,"_27402":117616,"_2946":117998},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3462":70663,"_30116":70511,"_20912":118000,"_5":14363,"_27402":117616,"_2946":118001},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3462":70664,"_30116":70511,"_20912":118003,"_5":14363,"_27402":117616,"_2946":118004},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3462":70665,"_30116":70511,"_20912":118006,"_5":14363,"_27402":117616,"_2946":118007},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3462":70666,"_30116":70511,"_20912":118009,"_5":14363,"_27402":117624,"_2946":118010},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3462":70667,"_30116":70511,"_20912":118012,"_5":14363,"_27402":117628,"_2946":118013},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3462":70668,"_30116":70511,"_20912":118015,"_5":14363,"_27402":117628,"_2946":118016},[],"que exista un principal activo del tipo correcto;",{"_3462":70669,"_30116":70511,"_20912":118018,"_5":14363,"_27402":117628,"_2946":118019},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3462":70670,"_30116":70511,"_20912":118021,"_5":14363,"_27402":117628,"_2946":118022},[],"que todas las condiciones del principal se cumplan;",{"_3462":70671,"_30116":70511,"_20912":118024,"_5":14363,"_27402":117628,"_2946":118025},[],"que el principal tenga concedida la política esperada;",{"_3462":70672,"_30116":70511,"_20912":118027,"_5":14363,"_27402":117628,"_2946":118028},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3462":70673,"_30116":70511,"_20912":118030,"_5":14363,"_27402":117628,"_2946":118031},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3462":70674,"_30116":70511,"_20912":118033,"_5":14363,"_27402":117628,"_2946":118034},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3462":70675,"_30116":70511,"_20912":118036,"_5":14363,"_27402":117632,"_2946":118037},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3462":70676,"_30116":70511,"_20912":118039,"_5":14363,"_27402":117636,"_2946":118040},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3462":70677,"_30116":70511,"_20912":118042,"_5":14363,"_27402":117640,"_2946":118043},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3462":70678,"_30116":70511,"_20912":118045,"_5":14363,"_27402":117640,"_2946":118046},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3462":70679,"_30116":70679,"_5":14715,"_2946":118048,"_30468":118049,"_20912":118050,"_27402":70679},"Alertas y suscripciones",[49167,117513,117514],[],{"_3462":70680,"_30116":70679,"_20912":118052,"_5":14363,"_27402":70679,"_2946":118053},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3462":70681,"_30116":70679,"_5":30465,"_20912":118055,"_27402":118056,"_2946":118057},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3462":70682,"_30116":70679,"_5":30465,"_20912":118059,"_27402":118060,"_2946":118061},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3462":70683,"_30116":70679,"_5":30465,"_20912":118063,"_27402":118064,"_2946":118065},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3462":70684,"_30116":70679,"_5":30465,"_20912":118067,"_27402":118068,"_2946":118069},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3462":70685,"_30116":70679,"_5":30465,"_20912":118071,"_27402":118072,"_2946":118073},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3462":70686,"_30116":70679,"_5":30465,"_20912":118075,"_27402":118076,"_2946":118077},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3462":70687,"_30116":70679,"_5":30465,"_20912":118079,"_27402":118080,"_2946":118081},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3462":70688,"_30116":70679,"_5":30465,"_20912":118083,"_27402":118084,"_2946":118085},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3462":70689,"_30116":70679,"_5":30465,"_20912":118087,"_27402":118088,"_2946":118089},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3462":70690,"_30116":70679,"_5":30465,"_20912":118091,"_27402":118092,"_2946":118093},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3462":70691,"_30116":70679,"_5":30465,"_20912":118095,"_27402":118096,"_2946":118097},[],"/docs/pr-preview/pr-64/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3462":70692,"_30116":70679,"_20912":118099,"_5":14363,"_27402":70679,"_2946":118100},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3462":70693,"_30116":70679,"_20912":118102,"_5":14363,"_27402":118056,"_2946":118103},[],"Un servicio publica un evento de dominio.",{"_3462":70694,"_30116":70679,"_20912":118105,"_5":14363,"_27402":118056,"_2946":118106},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3462":70695,"_30116":70679,"_20912":118108,"_5":14363,"_27402":118056,"_2946":118109},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3462":70696,"_30116":70679,"_20912":118111,"_5":14363,"_27402":118056,"_2946":118112},[],"Lamassu entrega el evento al canal configurado.",{"_3462":70697,"_30116":70679,"_20912":118114,"_5":14363,"_27402":118056,"_2946":118115},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3462":70698,"_30116":70679,"_20912":118117,"_5":14363,"_27402":118060,"_2946":118118},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3462":70699,"_30116":70679,"_20912":118120,"_5":14363,"_27402":118060,"_2946":118121},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3462":70700,"_30116":70679,"_20912":118123,"_5":14363,"_27402":118060,"_2946":118124},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3462":70701,"_30116":70679,"_20912":118126,"_5":14363,"_27402":118060,"_2946":118127},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3462":70702,"_30116":70679,"_20912":118129,"_5":14363,"_27402":118060,"_2946":118130},[],"`apikey_options` necesita `header` y `key`.",{"_3462":70703,"_30116":70679,"_20912":118132,"_5":14363,"_27402":118060,"_2946":118133},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3462":70704,"_30116":70679,"_20912":118135,"_5":14363,"_27402":118060,"_2946":118136},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3462":70705,"_30116":70679,"_20912":118138,"_5":14363,"_27402":118060,"_2946":118139},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3462":70706,"_30116":70679,"_20912":118141,"_5":14363,"_27402":118068,"_2946":118142},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3462":70707,"_30116":70679,"_20912":118144,"_5":14363,"_27402":118072,"_2946":118145},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3462":70708,"_30116":70679,"_20912":118147,"_5":14363,"_27402":118076,"_2946":118148},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3462":70709,"_30116":70679,"_20912":118150,"_5":14363,"_27402":118076,"_2946":118151},[],"**None** notifica todas las instancias del evento.",{"_3462":70710,"_30116":70679,"_20912":118153,"_5":14363,"_27402":118076,"_2946":118154},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3462":70711,"_30116":70679,"_20912":118156,"_5":14363,"_27402":118076,"_2946":118157},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3462":70712,"_30116":70679,"_20912":118159,"_5":14363,"_27402":118076,"_2946":118160},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3462":70713,"_30116":70679,"_20912":118162,"_5":14363,"_27402":118076,"_2946":118163},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3462":70714,"_30116":70679,"_20912":118165,"_5":14363,"_27402":118076,"_2946":118166},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3462":70715,"_30116":70679,"_20912":118168,"_5":14363,"_27402":118080,"_2946":118169},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3462":70716,"_30116":70679,"_20912":118171,"_5":14363,"_27402":118084,"_2946":118172},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3462":70717,"_30116":70679,"_20912":118174,"_5":14363,"_27402":118084,"_2946":118175},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3462":70718,"_30116":70679,"_20912":118177,"_5":14363,"_27402":118084,"_2946":118178},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3462":70719,"_30116":70679,"_20912":118180,"_5":14363,"_27402":118084,"_2946":118181},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3462":70720,"_30116":70679,"_20912":118183,"_5":14363,"_27402":118084,"_2946":118184},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3462":70721,"_30116":70679,"_20912":118186,"_5":14363,"_27402":118084,"_2946":118187},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3462":70722,"_30116":70679,"_20912":118189,"_5":14363,"_27402":118084,"_2946":118190},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3462":70723,"_30116":70679,"_20912":118192,"_5":14363,"_27402":118084,"_2946":118193},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3462":70724,"_30116":70679,"_20912":118195,"_5":14363,"_27402":118088,"_2946":118196},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3462":70725,"_30116":70679,"_20912":118198,"_5":14363,"_27402":118088,"_2946":118199},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3462":70726,"_30116":70679,"_20912":118201,"_5":14363,"_27402":118088,"_2946":118202},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3462":70727,"_30116":70679,"_20912":118204,"_5":14363,"_27402":118088,"_2946":118205},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3462":70728,"_30116":70679,"_20912":118207,"_5":14363,"_27402":118088,"_2946":118208},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3462":70729,"_30116":70679,"_20912":118210,"_5":14363,"_27402":118088,"_2946":118211},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3462":70730,"_30116":70679,"_20912":118213,"_5":14363,"_27402":118088,"_2946":118214},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3462":70731,"_30116":70679,"_20912":118216,"_5":14363,"_27402":118088,"_2946":118217},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3462":70732,"_30116":70679,"_20912":118219,"_5":14363,"_27402":118092,"_2946":118220},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3462":70733,"_30116":70679,"_20912":118222,"_5":14363,"_27402":118092,"_2946":118223},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3462":70734,"_30116":70679,"_20912":118225,"_5":14363,"_27402":118096,"_2946":118226},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3462":70735,"_30116":70679,"_20912":118228,"_5":14363,"_27402":118096,"_2946":118229},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3462":70736,"_30116":70679,"_20912":118231,"_5":14363,"_27402":118096,"_2946":118232},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3462":70737,"_30116":70679,"_20912":118234,"_5":14363,"_27402":118096,"_2946":118235},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3462":70738,"_30116":70679,"_20912":118237,"_5":14363,"_27402":118096,"_2946":118238},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3462":70739,"_30116":70679,"_20912":118240,"_5":14363,"_27402":118096,"_2946":118241},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3462":70740,"_30116":70679,"_20912":118243,"_5":14363,"_27402":118096,"_2946":118244},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3462":70741,"_30116":70679,"_20912":118246,"_5":14363,"_27402":118096,"_2946":118247},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3462":70742,"_30116":70679,"_20912":118249,"_5":14363,"_27402":118096,"_2946":118250},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3462":70743,"_30116":70743,"_5":14715,"_2946":118252,"_30468":118253,"_20912":118254,"_27402":70743},"Registros de auditoría",[49167,117513,117514],[],{"_3462":70744,"_30116":70743,"_20912":118256,"_5":14363,"_27402":70743,"_2946":118257},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3462":70745,"_30116":70743,"_5":30465,"_20912":118259,"_27402":118260,"_2946":118261},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3462":70746,"_30116":70743,"_5":30465,"_20912":118263,"_27402":118264,"_2946":118265},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3462":70747,"_30116":70743,"_5":30465,"_20912":118267,"_27402":118268,"_2946":118269},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3462":70748,"_30116":70743,"_5":30465,"_20912":118271,"_27402":118272,"_2946":118273},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3462":70749,"_30116":70743,"_5":30465,"_20912":118275,"_27402":118276,"_2946":118277},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3462":70750,"_30116":70743,"_5":30465,"_20912":118279,"_27402":118280,"_2946":118281},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3462":70751,"_30116":70743,"_5":30465,"_20912":118283,"_27402":118284,"_2946":118285},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3462":70752,"_30116":70743,"_5":30465,"_20912":118287,"_27402":118288,"_2946":118289},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3462":70753,"_30116":70743,"_5":30465,"_20912":118291,"_27402":118292,"_2946":118293},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3462":70754,"_30116":70743,"_5":30465,"_20912":118295,"_27402":118296,"_2946":118297},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3462":70755,"_30116":70743,"_5":30465,"_20912":118299,"_27402":118300,"_2946":118301},[],"/docs/pr-preview/pr-64/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3462":70756,"_30116":70743,"_20912":118303,"_5":14363,"_27402":70743,"_2946":118304},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3462":70757,"_30116":70743,"_20912":118306,"_5":14363,"_27402":118260,"_2946":118307},[],"El cuerpo de auditoría incluye:",{"_3462":70758,"_30116":70743,"_20912":118309,"_5":14363,"_27402":118260,"_2946":118310},[],"input: datos recibidos por la operación;",{"_3462":70759,"_30116":70743,"_20912":118312,"_5":14363,"_27402":118260,"_2946":118313},[],"has\\_error: indica si el servicio devolvió un error;",{"_3462":70760,"_30116":70743,"_20912":118315,"_5":14363,"_27402":118260,"_2946":118316},[],"output: resultado producido o mensaje de error;",{"_3462":70761,"_30116":70743,"_20912":118318,"_5":14363,"_27402":118260,"_2946":118319},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3462":70762,"_30116":70743,"_20912":118321,"_5":14363,"_27402":118260,"_2946":118322},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3462":70763,"_30116":70743,"_20912":118324,"_5":14363,"_27402":118260,"_2946":118325},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3462":70764,"_30116":70743,"_20912":118327,"_5":14363,"_27402":118264,"_2946":118328},[],"El backend aplica auditoría a mutaciones de:",{"_3462":70765,"_30116":70743,"_20912":118330,"_5":14363,"_27402":118264,"_2946":118331},[],"autoridades, certificados y perfiles de emisión;",{"_3462":70766,"_30116":70743,"_20912":118333,"_5":14363,"_27402":118264,"_2946":118334},[],"claves y motores KMS;",{"_3462":70767,"_30116":70743,"_20912":118336,"_5":14363,"_27402":118264,"_2946":118337},[],"dispositivos e identidades;",{"_3462":70768,"_30116":70743,"_20912":118339,"_5":14363,"_27402":118264,"_2946":118340},[],"DMS y operaciones de enrolamiento;",{"_3462":70769,"_30116":70743,"_20912":118342,"_5":14363,"_27402":118264,"_2946":118343},[],"funciones de validación y CRL;",{"_3462":70770,"_30116":70743,"_20912":118345,"_5":14363,"_27402":118264,"_2946":118346},[],"principales, políticas y concesiones de autorización.",{"_3462":70771,"_30116":70743,"_20912":118348,"_5":14363,"_27402":118264,"_2946":118349},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3462":70772,"_30116":70743,"_20912":118351,"_5":14363,"_27402":118268,"_2946":118352},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3462":70773,"_30116":70743,"_20912":118354,"_5":14363,"_27402":118268,"_2946":118355},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3462":70774,"_30116":70743,"_20912":118357,"_5":14363,"_27402":118268,"_2946":118358},[],"Diseña el consumidor para:",{"_3462":70775,"_30116":70743,"_20912":118360,"_5":14363,"_27402":118268,"_2946":118361},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3462":70776,"_30116":70743,"_20912":118363,"_5":14363,"_27402":118268,"_2946":118364},[],"conservar el CloudEvent completo sin modificar;",{"_3462":70777,"_30116":70743,"_20912":118366,"_5":14363,"_27402":118268,"_2946":118367},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3462":70778,"_30116":70743,"_20912":118369,"_5":14363,"_27402":118268,"_2946":118370},[],"cifrar en tránsito y en reposo;",{"_3462":70779,"_30116":70743,"_20912":118372,"_5":14363,"_27402":118268,"_2946":118373},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3462":70780,"_30116":70743,"_20912":118375,"_5":14363,"_27402":118268,"_2946":118376},[],"aplicar una política explícita de retención y legal hold;",{"_3462":70781,"_30116":70743,"_20912":118378,"_5":14363,"_27402":118268,"_2946":118379},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3462":70782,"_30116":70743,"_20912":118381,"_5":14363,"_27402":118272,"_2946":118382},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3462":70783,"_30116":70743,"_20912":118384,"_5":14363,"_27402":118272,"_2946":118385},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3462":70784,"_30116":70743,"_20912":118387,"_5":14363,"_27402":118280,"_2946":118388},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3462":70785,"_30116":70743,"_20912":118390,"_5":14363,"_27402":118284,"_2946":118391},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3462":70786,"_30116":70743,"_20912":118393,"_5":14363,"_27402":118288,"_2946":118394},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3462":70787,"_30116":70743,"_20912":118396,"_5":14363,"_27402":118292,"_2946":118397},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3462":70788,"_30116":70743,"_20912":118399,"_5":14363,"_27402":118296,"_2946":118400},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3462":70789,"_30116":70743,"_20912":118402,"_5":14363,"_27402":118300,"_2946":118403},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3462":70790,"_30116":70743,"_20912":118405,"_5":14363,"_27402":118300,"_2946":118406},[],"aparece un evento de auditoría correcto;",{"_3462":70791,"_30116":70743,"_20912":118408,"_5":14363,"_27402":118300,"_2946":118409},[],"el principal coincide con la identidad utilizada;",{"_3462":70792,"_30116":70743,"_20912":118411,"_5":14363,"_27402":118300,"_2946":118412},[],"el consumidor lo persiste una sola vez;",{"_3462":70793,"_30116":70743,"_20912":118414,"_5":14363,"_27402":118300,"_2946":118415},[],"puede recuperarse por recurso, actor y periodo;",{"_3462":70794,"_30116":70743,"_20912":118417,"_5":14363,"_27402":118300,"_2946":118418},[],"una interrupción del consumidor produce una alerta.",{"_3462":70795,"_30116":70743,"_20912":118420,"_5":14363,"_27402":118300,"_2946":118421},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3462":70796,"_30116":70796,"_5":14715,"_2946":118423,"_30468":118424,"_20912":118425,"_27402":70796},"Arquitectura de la plataforma",[49167,117513],[],{"_3462":70797,"_30116":70796,"_20912":118427,"_5":14363,"_27402":70796,"_2946":118428},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3462":70798,"_30116":70796,"_5":30465,"_20912":118430,"_27402":118431,"_2946":118432},[],"/docs/pr-preview/pr-64/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3462":70799,"_30116":70796,"_5":30465,"_20912":118434,"_27402":118435,"_2946":118436},[],"/docs/pr-preview/pr-64/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3462":70800,"_30116":70796,"_5":30465,"_20912":118438,"_27402":118439,"_2946":118440},[],"/docs/pr-preview/pr-64/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3462":70801,"_30116":70796,"_5":30465,"_20912":118442,"_27402":118443,"_2946":118444},[],"/docs/pr-preview/pr-64/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3462":70802,"_30116":70796,"_5":30465,"_20912":118446,"_27402":118447,"_2946":118448},[],"/docs/pr-preview/pr-64/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3462":70803,"_30116":70796,"_20912":118450,"_5":14363,"_27402":70796,"_2946":118451},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3462":70804,"_30116":70796,"_20912":118453,"_5":14363,"_27402":70796,"_2946":118454},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3462":70805,"_30116":70796,"_20912":118456,"_5":14363,"_27402":118431,"_2946":118457},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3462":70806,"_30116":70796,"_20912":118459,"_5":14363,"_27402":118435,"_2946":118460},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3462":70807,"_30116":70796,"_20912":118462,"_5":14363,"_27402":118439,"_2946":118463},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3462":70808,"_30116":70796,"_20912":118465,"_5":14363,"_27402":118443,"_2946":118466},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3462":70809,"_30116":70796,"_20912":118468,"_5":14363,"_27402":118447,"_2946":118469},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3462":70810,"_30116":70810,"_5":14715,"_2946":118471,"_30468":118472,"_20912":118473,"_27402":70810},"Cómo funciona Lamassu",[49167,117513],[],{"_3462":70811,"_30116":70810,"_20912":118475,"_5":14363,"_27402":70810,"_2946":118476},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3462":70812,"_30116":70810,"_5":30465,"_20912":118478,"_27402":118479,"_2946":118480},[],"/docs/pr-preview/pr-64/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3462":70813,"_30116":70810,"_5":30465,"_20912":118482,"_27402":118483,"_2946":118484},[],"/docs/pr-preview/pr-64/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3462":70814,"_30116":70810,"_20912":118486,"_5":14363,"_27402":70810,"_2946":118487},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3462":70815,"_30116":70810,"_20912":118489,"_5":14363,"_27402":118479,"_2946":118490},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3462":70816,"_30116":70810,"_20912":118492,"_5":14363,"_27402":118479,"_2946":118493},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3462":70817,"_30116":70810,"_20912":118495,"_5":14363,"_27402":118479,"_2946":118496},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3462":70818,"_30116":70810,"_20912":118498,"_5":14363,"_27402":118479,"_2946":118499},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3462":70819,"_30116":70810,"_20912":118501,"_5":14363,"_27402":118479,"_2946":118502},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3462":70820,"_30116":70810,"_20912":118504,"_5":14363,"_27402":118483,"_2946":118505},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3462":70821,"_30116":70810,"_20912":118507,"_5":14363,"_27402":118483,"_2946":118508},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3462":70822,"_30116":70810,"_20912":118510,"_5":14363,"_27402":118483,"_2946":118511},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3462":70823,"_30116":70810,"_20912":118513,"_5":14363,"_27402":118483,"_2946":118514},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3462":70824,"_30116":70810,"_20912":118516,"_5":14363,"_27402":118483,"_2946":118517},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3462":70825,"_30116":70810,"_20912":118519,"_5":14363,"_27402":118483,"_2946":118520},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3462":70826,"_30116":70810,"_20912":118522,"_5":14363,"_27402":118483,"_2946":118523},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3462":70827,"_30116":70827,"_5":14715,"_2946":118525,"_30468":118526,"_20912":118527,"_27402":70827},"Dispositivos e identidades",[49167,117513,51649,118525],[],{"_3462":70828,"_30116":70827,"_20912":118529,"_5":14363,"_27402":70827,"_2946":118530},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3462":70829,"_30116":70827,"_5":30465,"_20912":118532,"_27402":118533,"_2946":118534},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3462":70830,"_30116":70827,"_5":30465,"_20912":118536,"_27402":118537,"_2946":118538},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3462":70831,"_30116":70827,"_5":30465,"_20912":118540,"_27402":118541,"_2946":118542},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3462":70832,"_30116":70827,"_5":30465,"_20912":118544,"_27402":118545,"_2946":118546},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3462":70833,"_30116":70827,"_5":30465,"_20912":118548,"_27402":118549,"_2946":118550},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3462":70834,"_30116":70827,"_5":30465,"_20912":118552,"_27402":118553,"_2946":118554},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3462":70835,"_30116":70827,"_5":30465,"_20912":118556,"_27402":118557,"_2946":118558},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3462":70836,"_30116":70827,"_5":30465,"_20912":118560,"_27402":118561,"_2946":118562},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3462":70837,"_30116":70827,"_5":30465,"_20912":118564,"_27402":118565,"_2946":118566},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3462":70838,"_30116":70827,"_5":30465,"_20912":118568,"_27402":118569,"_2946":118570},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3462":70839,"_30116":70827,"_5":30465,"_20912":118572,"_27402":118573,"_2946":118574},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3462":70840,"_30116":70827,"_20912":118576,"_5":14363,"_27402":70827,"_2946":118577},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3462":70841,"_30116":70827,"_20912":118579,"_5":14363,"_27402":70827,"_2946":118580},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3462":70842,"_30116":70827,"_20912":118582,"_5":14363,"_27402":118533,"_2946":118583},[],"Vista operativa",{"_3462":70843,"_30116":70827,"_20912":118585,"_5":14363,"_27402":118533,"_2946":118586},[],"Interpretación",{"_3462":70844,"_30116":70827,"_20912":118588,"_5":14363,"_27402":118533,"_2946":51712},[],{"_3462":70845,"_30116":70827,"_20912":118590,"_5":14363,"_27402":118533,"_2946":118591},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3462":70846,"_30116":70827,"_20912":118593,"_5":14363,"_27402":118533,"_2946":51718},[],{"_3462":70847,"_30116":70827,"_20912":118595,"_5":14363,"_27402":118533,"_2946":118596},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3462":70848,"_30116":70827,"_20912":118598,"_5":14363,"_27402":118533,"_2946":51724},[],{"_3462":70849,"_30116":70827,"_20912":118600,"_5":14363,"_27402":118533,"_2946":118601},[],"La identidad está en la ventana operativa de renovación.",{"_3462":70850,"_30116":70827,"_20912":118603,"_5":14363,"_27402":118533,"_2946":51730},[],{"_3462":70851,"_30116":70827,"_20912":118605,"_5":14363,"_27402":118533,"_2946":118606},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3462":70852,"_30116":70827,"_20912":118608,"_5":14363,"_27402":118533,"_2946":51736},[],{"_3462":70853,"_30116":70827,"_20912":118610,"_5":14363,"_27402":118533,"_2946":118611},[],"La identidad ha vencido.",{"_3462":70854,"_30116":70827,"_20912":118613,"_5":14363,"_27402":118533,"_2946":51742},[],{"_3462":70855,"_30116":70827,"_20912":118615,"_5":14363,"_27402":118533,"_2946":118616},[],"La identidad está marcada como revocada.",{"_3462":70856,"_30116":70827,"_20912":118618,"_5":14363,"_27402":118533,"_2946":51748},[],{"_3462":70857,"_30116":70827,"_20912":118620,"_5":14363,"_27402":118533,"_2946":118621},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3462":70858,"_30116":70827,"_20912":118623,"_5":14363,"_27402":118533,"_2946":118624},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3462":70859,"_30116":70827,"_20912":118626,"_5":14363,"_27402":118537,"_2946":118627},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3462":70860,"_30116":70827,"_20912":118629,"_5":14363,"_27402":118537,"_2946":118630},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3462":70861,"_30116":70827,"_20912":118632,"_5":14363,"_27402":118537,"_2946":118633},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3462":70862,"_30116":70827,"_20912":118635,"_5":14363,"_27402":118537,"_2946":118636},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3462":70863,"_30116":70827,"_20912":118638,"_5":14363,"_27402":118541,"_2946":118639},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3462":70864,"_30116":70827,"_20912":118641,"_5":14363,"_27402":118545,"_2946":118642},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3462":70865,"_30116":70827,"_20912":118644,"_5":14363,"_27402":118549,"_2946":118645},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3462":70866,"_30116":70827,"_20912":118647,"_5":14363,"_27402":118553,"_2946":118648},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3462":70867,"_30116":70827,"_20912":118650,"_5":14363,"_27402":118557,"_2946":118651},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3462":70868,"_30116":70827,"_20912":118653,"_5":14363,"_27402":118557,"_2946":118654},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3462":70869,"_30116":70827,"_20912":118656,"_5":14363,"_27402":118561,"_2946":118657},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3462":70870,"_30116":70827,"_20912":118659,"_5":14363,"_27402":118561,"_2946":118660},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3462":70871,"_30116":70827,"_20912":118662,"_5":14363,"_27402":118561,"_2946":118663},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3462":70872,"_30116":70827,"_20912":118665,"_5":14363,"_27402":118561,"_2946":118666},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3462":70873,"_30116":70827,"_20912":118668,"_5":14363,"_27402":118561,"_2946":118669},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3462":70874,"_30116":70827,"_20912":118671,"_5":14363,"_27402":118561,"_2946":118672},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3462":70875,"_30116":70827,"_20912":118674,"_5":14363,"_27402":118565,"_2946":118675},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3462":70876,"_30116":70827,"_20912":118677,"_5":14363,"_27402":118565,"_2946":118678},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3462":70877,"_30116":70827,"_20912":118680,"_5":14363,"_27402":118569,"_2946":118681},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3462":70878,"_30116":70827,"_20912":118683,"_5":14363,"_27402":118569,"_2946":118684},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3462":70879,"_30116":70827,"_20912":118686,"_5":14363,"_27402":118569,"_2946":118687},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3462":70880,"_30116":70827,"_20912":118689,"_5":14363,"_27402":118569,"_2946":118690},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3462":70881,"_30116":70827,"_20912":118692,"_5":14363,"_27402":118573,"_2946":118693},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3462":70882,"_30116":70827,"_20912":118695,"_5":14363,"_27402":118573,"_2946":118696},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3462":70883,"_30116":70883,"_5":14715,"_2946":118698,"_30468":118699,"_20912":118701,"_27402":70883},"Identidad inicial y autenticación",[49167,117513,51649,118525,118700],"Enrolamiento con PKI",[],{"_3462":70884,"_30116":70883,"_20912":118703,"_5":14363,"_27402":70883,"_2946":118704},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3462":70885,"_30116":70883,"_5":30465,"_20912":118706,"_27402":118707,"_2946":118708},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3462":70886,"_30116":70883,"_5":30465,"_20912":118710,"_27402":118711,"_2946":118712},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3462":70887,"_30116":70883,"_5":30465,"_20912":118714,"_27402":118715,"_2946":118716},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3462":70888,"_30116":70883,"_5":30465,"_20912":118718,"_27402":118719,"_2946":118720},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3462":70889,"_30116":70883,"_5":30465,"_20912":118722,"_27402":118723,"_2946":118724},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3462":70890,"_30116":70883,"_20912":118726,"_5":14363,"_27402":70883,"_2946":118727},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3462":70891,"_30116":70883,"_20912":118729,"_5":14363,"_27402":118707,"_2946":118730},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3462":70892,"_30116":70883,"_20912":118732,"_5":14363,"_27402":118707,"_2946":118733},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3462":70893,"_30116":70883,"_20912":118735,"_5":14363,"_27402":118711,"_2946":118736},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3462":70894,"_30116":70883,"_20912":118738,"_5":14363,"_27402":118711,"_2946":118739},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3462":70895,"_30116":70883,"_20912":118741,"_5":14363,"_27402":118711,"_2946":118742},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3462":70896,"_30116":70883,"_20912":118744,"_5":14363,"_27402":118715,"_2946":118745},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3462":70897,"_30116":70883,"_20912":118747,"_5":14363,"_27402":118715,"_2946":118748},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3462":70898,"_30116":70883,"_20912":118750,"_5":14363,"_27402":118719,"_2946":118751},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3462":70899,"_30116":70883,"_20912":118753,"_5":14363,"_27402":118719,"_2946":118754},[],"Ejemplo de cuerpo:",{"_3462":70900,"_30116":70883,"_20912":118756,"_5":14363,"_27402":118719,"_2946":118757},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3462":70901,"_30116":70883,"_20912":118759,"_5":14363,"_27402":118719,"_2946":118760},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3462":70902,"_30116":70883,"_20912":118762,"_5":14363,"_27402":118719,"_2946":118763},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3462":70903,"_30116":70883,"_20912":118765,"_5":14363,"_27402":118719,"_2946":118766},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3462":70904,"_30116":70883,"_20912":118768,"_5":14363,"_27402":118723,"_2946":118769},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3462":70905,"_30116":70883,"_20912":118771,"_5":14363,"_27402":118723,"_2946":118772},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3462":70906,"_30116":70906,"_5":14715,"_2946":118774,"_30468":118775,"_20912":118776,"_27402":70906},"Configura y opera el DMS",[49167,117513,51649,118525,118700],[],{"_3462":70907,"_30116":70906,"_20912":118778,"_5":14363,"_27402":70906,"_2946":118779},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3462":70908,"_30116":70906,"_5":30465,"_20912":118781,"_27402":118782,"_2946":116091},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3462":70909,"_30116":70906,"_5":30465,"_20912":118784,"_27402":118785,"_2946":118786},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3462":70910,"_30116":70906,"_5":30465,"_20912":118788,"_27402":118789,"_2946":118790},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3462":70911,"_30116":70906,"_5":30465,"_20912":118792,"_27402":118793,"_2946":118794},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3462":70912,"_30116":70906,"_5":30465,"_20912":118796,"_27402":118797,"_2946":118798},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3462":70913,"_30116":70906,"_5":30465,"_20912":118800,"_27402":118801,"_2946":118802},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3462":70914,"_30116":70906,"_5":30465,"_20912":118804,"_27402":118805,"_2946":118806},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3462":70915,"_30116":70906,"_5":30465,"_20912":118808,"_27402":118809,"_2946":118810},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3462":70916,"_30116":70906,"_5":30465,"_20912":118812,"_27402":118813,"_2946":51944},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3462":70917,"_30116":70906,"_5":30465,"_20912":118815,"_27402":118816,"_2946":51948},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3462":70918,"_30116":70906,"_5":30465,"_20912":118818,"_27402":118819,"_2946":118820},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3462":70919,"_30116":70906,"_5":30465,"_20912":118822,"_27402":118823,"_2946":118824},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3462":70920,"_30116":70906,"_5":30465,"_20912":118826,"_27402":118827,"_2946":118828},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3462":70921,"_30116":70906,"_5":30465,"_20912":118830,"_27402":118831,"_2946":118832},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3462":70922,"_30116":70906,"_5":30465,"_20912":118834,"_27402":118835,"_2946":51968},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3462":70923,"_30116":70906,"_5":30465,"_20912":118837,"_27402":118838,"_2946":118839},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3462":70924,"_30116":70906,"_5":30465,"_20912":118841,"_27402":118842,"_2946":118843},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3462":70925,"_30116":70906,"_5":30465,"_20912":118845,"_27402":118846,"_2946":118847},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3462":70926,"_30116":70906,"_20912":118849,"_5":14363,"_27402":70906,"_2946":118850},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3462":70927,"_30116":70906,"_20912":118852,"_5":14363,"_27402":118782,"_2946":118853},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3462":70928,"_30116":70906,"_20912":118855,"_5":14363,"_27402":118782,"_2946":118856},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3462":70929,"_30116":70906,"_20912":118858,"_5":14363,"_27402":118789,"_2946":118859},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3462":70930,"_30116":70906,"_20912":118861,"_5":14363,"_27402":118793,"_2946":118862},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3462":70931,"_30116":70906,"_20912":118864,"_5":14363,"_27402":118797,"_2946":118865},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3462":70932,"_30116":70906,"_20912":118867,"_5":14363,"_27402":118801,"_2946":118868},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3462":70933,"_30116":70906,"_20912":118870,"_5":14363,"_27402":118805,"_2946":118871},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3462":70934,"_30116":70906,"_20912":118873,"_5":14363,"_27402":118813,"_2946":118874},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3462":70935,"_30116":70906,"_20912":118876,"_5":14363,"_27402":118813,"_2946":118877},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3462":70936,"_30116":70906,"_20912":118879,"_5":14363,"_27402":118816,"_2946":118880},[],"Campo de `settings.enrollment_settings`",{"_3462":70937,"_30116":70906,"_20912":118882,"_5":14363,"_27402":118816,"_2946":118883},[],"Decisión",{"_3462":70938,"_30116":70906,"_20912":118885,"_5":14363,"_27402":118816,"_2946":52019},[],{"_3462":70939,"_30116":70906,"_20912":118887,"_5":14363,"_27402":118816,"_2946":118888},[],"`EST_RFC7030` para estas operaciones.",{"_3462":70940,"_30116":70906,"_20912":118890,"_5":14363,"_27402":118816,"_2946":52025},[],{"_3462":70941,"_30116":70906,"_20912":118892,"_5":14363,"_27402":118816,"_2946":118893},[],"ID de la CA que firmará.",{"_3462":70942,"_30116":70906,"_20912":118895,"_5":14363,"_27402":118816,"_2946":52031},[],{"_3462":70943,"_30116":70906,"_20912":118897,"_5":14363,"_27402":118816,"_2946":118898},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3462":70944,"_30116":70906,"_20912":118900,"_5":14363,"_27402":118816,"_2946":52037},[],{"_3462":70945,"_30116":70906,"_20912":118902,"_5":14363,"_27402":118816,"_2946":118903},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3462":70946,"_30116":70906,"_20912":118905,"_5":14363,"_27402":118816,"_2946":52043},[],{"_3462":70947,"_30116":70906,"_20912":118907,"_5":14363,"_27402":118816,"_2946":118908},[],"Uno de los cuatro modos de autenticación.",{"_3462":70948,"_30116":70906,"_20912":118910,"_5":14363,"_27402":118816,"_2946":118911},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3462":70949,"_30116":70906,"_20912":118913,"_5":14363,"_27402":118819,"_2946":118914},[],"Los bloques son independientes:",{"_3462":70950,"_30116":70906,"_20912":118916,"_5":14363,"_27402":118819,"_2946":118917},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3462":70951,"_30116":70906,"_20912":118919,"_5":14363,"_27402":118819,"_2946":118920},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3462":70952,"_30116":70906,"_20912":118922,"_5":14363,"_27402":118819,"_2946":52061},[],{"_3462":70953,"_30116":70906,"_20912":118924,"_5":14363,"_27402":118819,"_2946":118925},[],"Control aplicado en la operación configurada",{"_3462":70954,"_30116":70906,"_20912":118927,"_5":14363,"_27402":118819,"_2946":52067},[],{"_3462":70955,"_30116":70906,"_20912":118929,"_5":14363,"_27402":118819,"_2946":118930},[],"Validación del certificado presentado.",{"_3462":70956,"_30116":70906,"_20912":118932,"_5":14363,"_27402":118819,"_2946":52073},[],{"_3462":70957,"_30116":70906,"_20912":118934,"_5":14363,"_27402":118819,"_2946":118935},[],"Autorización del webhook configurado.",{"_3462":70958,"_30116":70906,"_20912":118937,"_5":14363,"_27402":118819,"_2946":52079},[],{"_3462":70959,"_30116":70906,"_20912":118939,"_5":14363,"_27402":118819,"_2946":118940},[],"Validación del certificado y, después, aprobación del webhook.",{"_3462":70960,"_30116":70906,"_20912":118942,"_5":14363,"_27402":118819,"_2946":52085},[],{"_3462":70961,"_30116":70906,"_20912":118944,"_5":14363,"_27402":118819,"_2946":118945},[],"Sin autenticación del solicitante por el DMS.",{"_3462":70962,"_30116":70906,"_20912":118947,"_5":14363,"_27402":118819,"_2946":118948},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3462":70963,"_30116":70906,"_20912":118950,"_5":14363,"_27402":118819,"_2946":118951},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3462":70964,"_30116":70906,"_20912":118953,"_5":14363,"_27402":118819,"_2946":118954},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3462":70965,"_30116":70906,"_20912":118956,"_5":14363,"_27402":118819,"_2946":118957},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3462":70966,"_30116":70906,"_20912":118959,"_5":14363,"_27402":118823,"_2946":118960},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3462":70967,"_30116":70906,"_20912":118962,"_5":14363,"_27402":118823,"_2946":118963},[],"Campo de `external_webhook_settings`",{"_3462":70968,"_30116":70906,"_20912":118965,"_5":14363,"_27402":118823,"_2946":118883},[],{"_3462":70969,"_30116":70906,"_20912":118967,"_5":14363,"_27402":118823,"_2946":52111},[],{"_3462":70970,"_30116":70906,"_20912":118969,"_5":14363,"_27402":118823,"_2946":118970},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3462":70971,"_30116":70906,"_20912":118972,"_5":14363,"_27402":118823,"_2946":52117},[],{"_3462":70972,"_30116":70906,"_20912":118974,"_5":14363,"_27402":118823,"_2946":118975},[],"`POST` o `PUT`; `POST` por defecto.",{"_3462":70973,"_30116":70906,"_20912":118977,"_5":14363,"_27402":118823,"_2946":52123},[],{"_3462":70974,"_30116":70906,"_20912":118979,"_5":14363,"_27402":118823,"_2946":118980},[],"Etiqueta usada en los logs del servicio.",{"_3462":70975,"_30116":70906,"_20912":118982,"_5":14363,"_27402":118823,"_2946":52129},[],{"_3462":70976,"_30116":70906,"_20912":118984,"_5":14363,"_27402":118823,"_2946":118985},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3462":70977,"_30116":70906,"_20912":118987,"_5":14363,"_27402":118823,"_2946":52135},[],{"_3462":70978,"_30116":70906,"_20912":118989,"_5":14363,"_27402":118823,"_2946":118990},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3462":70979,"_30116":70906,"_20912":118992,"_5":14363,"_27402":118823,"_2946":52141},[],{"_3462":70980,"_30116":70906,"_20912":118994,"_5":14363,"_27402":118823,"_2946":118995},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3462":70981,"_30116":70906,"_20912":118997,"_5":14363,"_27402":118823,"_2946":52147},[],{"_3462":70982,"_30116":70906,"_20912":118999,"_5":14363,"_27402":118823,"_2946":119000},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3462":70983,"_30116":70906,"_20912":119002,"_5":14363,"_27402":118823,"_2946":52153},[],{"_3462":70984,"_30116":70906,"_20912":119004,"_5":14363,"_27402":118823,"_2946":119005},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3462":70985,"_30116":70906,"_20912":119007,"_5":14363,"_27402":118823,"_2946":52159},[],{"_3462":70986,"_30116":70906,"_20912":119009,"_5":14363,"_27402":118823,"_2946":119010},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3462":70987,"_30116":70906,"_20912":119012,"_5":14363,"_27402":118823,"_2946":52165},[],{"_3462":70988,"_30116":70906,"_20912":119014,"_5":14363,"_27402":118823,"_2946":119015},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3462":70989,"_30116":70906,"_20912":119017,"_5":14363,"_27402":118823,"_2946":119018},[],"Reglas de esa configuración:",{"_3462":70990,"_30116":70906,"_20912":119020,"_5":14363,"_27402":118823,"_2946":119021},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3462":70991,"_30116":70906,"_20912":119023,"_5":14363,"_27402":118823,"_2946":119024},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3462":70992,"_30116":70906,"_20912":119026,"_5":14363,"_27402":118823,"_2946":119027},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3462":70993,"_30116":70906,"_20912":119029,"_5":14363,"_27402":118823,"_2946":119030},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3462":70994,"_30116":70906,"_20912":119032,"_5":14363,"_27402":118823,"_2946":119033},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3462":70995,"_30116":70906,"_20912":119035,"_5":14363,"_27402":118823,"_2946":119036},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3462":70996,"_30116":70906,"_20912":119038,"_5":14363,"_27402":118823,"_2946":119039},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3462":70997,"_30116":70906,"_20912":119041,"_5":14363,"_27402":118823,"_2946":119042},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3462":70998,"_30116":70906,"_20912":119044,"_5":14363,"_27402":118823,"_2946":119045},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3462":70999,"_30116":70906,"_20912":119047,"_5":14363,"_27402":118827,"_2946":119048},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3462":71000,"_30116":70906,"_20912":119050,"_5":14363,"_27402":118831,"_2946":119051},[],"Campo de `settings.reenrollment_settings`",{"_3462":71001,"_30116":70906,"_20912":119053,"_5":14363,"_27402":118831,"_2946":119054},[],"Función",{"_3462":71002,"_30116":70906,"_20912":119056,"_5":14363,"_27402":118831,"_2946":52209},[],{"_3462":71003,"_30116":70906,"_20912":119058,"_5":14363,"_27402":118831,"_2946":119059},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3462":71004,"_30116":70906,"_20912":119061,"_5":14363,"_27402":118831,"_2946":52215},[],{"_3462":71005,"_30116":70906,"_20912":119063,"_5":14363,"_27402":118831,"_2946":119064},[],"Umbral operativo preventivo de monitorización.",{"_3462":71006,"_30116":70906,"_20912":119066,"_5":14363,"_27402":118831,"_2946":52221},[],{"_3462":71007,"_30116":70906,"_20912":119068,"_5":14363,"_27402":118831,"_2946":119069},[],"Umbral operativo crítico de monitorización.",{"_3462":71008,"_30116":70906,"_20912":119071,"_5":14363,"_27402":118831,"_2946":52227},[],{"_3462":71009,"_30116":70906,"_20912":119073,"_5":14363,"_27402":118831,"_2946":119074},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3462":71010,"_30116":70906,"_20912":119076,"_5":14363,"_27402":118831,"_2946":52233},[],{"_3462":71011,"_30116":70906,"_20912":119078,"_5":14363,"_27402":118831,"_2946":119079},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3462":71012,"_30116":70906,"_20912":119081,"_5":14363,"_27402":118831,"_2946":52239},[],{"_3462":71013,"_30116":70906,"_20912":119083,"_5":14363,"_27402":118831,"_2946":119084},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3462":71014,"_30116":70906,"_20912":119086,"_5":14363,"_27402":118831,"_2946":119087},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3462":71015,"_30116":70906,"_20912":119089,"_5":14363,"_27402":118835,"_2946":119090},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3462":71016,"_30116":70906,"_20912":119092,"_5":14363,"_27402":118838,"_2946":116455},[],{"_3462":71017,"_30116":70906,"_20912":119094,"_5":14363,"_27402":118838,"_2946":119095},[],"Qué publica",{"_3462":71018,"_30116":70906,"_20912":119097,"_5":14363,"_27402":118838,"_2946":52256},[],{"_3462":71019,"_30116":70906,"_20912":119099,"_5":14363,"_27402":118838,"_2946":119100},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3462":71020,"_30116":70906,"_20912":119102,"_5":14363,"_27402":118838,"_2946":52262},[],{"_3462":71021,"_30116":70906,"_20912":119104,"_5":14363,"_27402":118838,"_2946":119105},[],"Certificado de la CA emisora seleccionada.",{"_3462":71022,"_30116":70906,"_20912":119107,"_5":14363,"_27402":118838,"_2946":52268},[],{"_3462":71023,"_30116":70906,"_20912":119109,"_5":14363,"_27402":118838,"_2946":119110},[],"Certificados de las CAs elegidas explícitamente.",{"_3462":71024,"_30116":70906,"_20912":119112,"_5":14363,"_27402":118838,"_2946":119113},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3462":71025,"_30116":70906,"_20912":119115,"_5":14363,"_27402":118842,"_2946":119116},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3462":71026,"_30116":70906,"_20912":119118,"_5":14363,"_27402":118842,"_2946":119119},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3462":71027,"_30116":70906,"_20912":119121,"_5":14363,"_27402":118842,"_2946":119122},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3462":71028,"_30116":70906,"_20912":119124,"_5":14363,"_27402":118846,"_2946":119125},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3462":71029,"_30116":71029,"_5":14715,"_2946":119127,"_30468":119128,"_20912":119129,"_27402":71029},"Integra el cliente EST",[49167,117513,51649,118525,118700],[],{"_3462":71030,"_30116":71029,"_20912":119131,"_5":14363,"_27402":71029,"_2946":119132},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3462":71031,"_30116":71029,"_5":30465,"_20912":119134,"_27402":119135,"_2946":116091},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3462":71032,"_30116":71029,"_5":30465,"_20912":119137,"_27402":119138,"_2946":119139},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3462":71033,"_30116":71029,"_5":30465,"_20912":119141,"_27402":119142,"_2946":119143},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3462":71034,"_30116":71029,"_5":30465,"_20912":119145,"_27402":119146,"_2946":119147},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3462":71035,"_30116":71029,"_5":30465,"_20912":119149,"_27402":119150,"_2946":119151},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3462":71036,"_30116":71029,"_5":30465,"_20912":119153,"_27402":119154,"_2946":119155},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3462":71037,"_30116":71029,"_20912":119157,"_5":14363,"_27402":71029,"_2946":119158},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3462":71038,"_30116":71029,"_20912":119160,"_5":14363,"_27402":119135,"_2946":119161},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3462":71039,"_30116":71029,"_20912":119163,"_5":14363,"_27402":119135,"_2946":119164},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3462":71040,"_30116":71029,"_20912":119166,"_5":14363,"_27402":119135,"_2946":119167},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3462":71041,"_30116":71029,"_20912":119169,"_5":14363,"_27402":119138,"_2946":119170},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3462":71042,"_30116":71029,"_20912":119172,"_5":14363,"_27402":119138,"_2946":119173},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3462":71043,"_30116":71029,"_20912":119175,"_5":14363,"_27402":119142,"_2946":119176},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3462":71044,"_30116":71029,"_20912":119178,"_5":14363,"_27402":119142,"_2946":119179},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3462":71045,"_30116":71029,"_20912":119181,"_5":14363,"_27402":119146,"_2946":119182},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3462":71046,"_30116":71029,"_20912":119184,"_5":14363,"_27402":119146,"_2946":119185},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3462":71047,"_30116":71029,"_20912":119187,"_5":14363,"_27402":119150,"_2946":119188},[],"Para el caso de una raíz que emite directamente:",{"_3462":71048,"_30116":71029,"_20912":119190,"_5":14363,"_27402":119150,"_2946":119191},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3462":71049,"_30116":71029,"_20912":119193,"_5":14363,"_27402":119150,"_2946":119194},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3462":71050,"_30116":71029,"_20912":119196,"_5":14363,"_27402":119154,"_2946":119197},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3462":71051,"_30116":71051,"_5":14715,"_2946":119199,"_30468":119200,"_20912":119201,"_27402":71051},"Referencia EST",[49167,117513,51649,118525,118700],[],{"_3462":71052,"_30116":71051,"_20912":119203,"_5":14363,"_27402":71051,"_2946":119204},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3462":71053,"_30116":71051,"_5":30465,"_20912":119206,"_27402":119207,"_2946":119208},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3462":71054,"_30116":71051,"_5":30465,"_20912":119210,"_27402":119211,"_2946":22668},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3462":71055,"_30116":71051,"_5":30465,"_20912":119213,"_27402":119214,"_2946":26017},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3462":71056,"_30116":71051,"_5":30465,"_20912":119216,"_27402":119217,"_2946":26024},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3462":71057,"_30116":71051,"_5":30465,"_20912":119219,"_27402":119220,"_2946":25343},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3462":71058,"_30116":71051,"_5":30465,"_20912":119222,"_27402":119223,"_2946":119224},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3462":71059,"_30116":71051,"_5":30465,"_20912":119226,"_27402":119227,"_2946":119228},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3462":71060,"_30116":71051,"_5":30465,"_20912":119230,"_27402":119231,"_2946":119232},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3462":71061,"_30116":71051,"_20912":119234,"_5":14363,"_27402":71051,"_2946":119235},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3462":71062,"_30116":71051,"_20912":119237,"_5":14363,"_27402":119207,"_2946":119238},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3462":71063,"_30116":71051,"_20912":119240,"_5":14363,"_27402":119207,"_2946":117273},[],{"_3462":71064,"_30116":71051,"_20912":119242,"_5":14363,"_27402":119207,"_2946":119243},[],"Método",{"_3462":71065,"_30116":71051,"_20912":119245,"_5":14363,"_27402":119207,"_2946":119246},[],"Autenticación y condición",{"_3462":71066,"_30116":71051,"_20912":119248,"_5":14363,"_27402":119207,"_2946":52411},[],{"_3462":71067,"_30116":71051,"_20912":119250,"_5":14363,"_27402":119207,"_2946":52414},[],{"_3462":71068,"_30116":71051,"_20912":119252,"_5":14363,"_27402":119207,"_2946":119253},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3462":71069,"_30116":71051,"_20912":119255,"_5":14363,"_27402":119207,"_2946":52420},[],{"_3462":71070,"_30116":71051,"_20912":119257,"_5":14363,"_27402":119207,"_2946":52423},[],{"_3462":71071,"_30116":71051,"_20912":119259,"_5":14363,"_27402":119207,"_2946":119260},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3462":71072,"_30116":71051,"_20912":119262,"_5":14363,"_27402":119207,"_2946":52429},[],{"_3462":71073,"_30116":71051,"_20912":119264,"_5":14363,"_27402":119207,"_2946":52423},[],{"_3462":71074,"_30116":71051,"_20912":119266,"_5":14363,"_27402":119207,"_2946":119267},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3462":71075,"_30116":71051,"_20912":119269,"_5":14363,"_27402":119207,"_2946":52437},[],{"_3462":71076,"_30116":71051,"_20912":119271,"_5":14363,"_27402":119207,"_2946":52423},[],{"_3462":71077,"_30116":71051,"_20912":119273,"_5":14363,"_27402":119207,"_2946":119274},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3462":71078,"_30116":71051,"_20912":119276,"_5":14363,"_27402":119207,"_2946":119277},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3462":71079,"_30116":71051,"_20912":119279,"_5":14363,"_27402":119211,"_2946":119280},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3462":71080,"_30116":71051,"_20912":119282,"_5":14363,"_27402":119211,"_2946":119283},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3462":71081,"_30116":71051,"_20912":119285,"_5":14363,"_27402":119214,"_2946":119286},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3462":71082,"_30116":71051,"_20912":119288,"_5":14363,"_27402":119214,"_2946":119289},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3462":71083,"_30116":71051,"_20912":119291,"_5":14363,"_27402":119217,"_2946":119292},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3462":71084,"_30116":71051,"_20912":119294,"_5":14363,"_27402":119217,"_2946":119295},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3462":71085,"_30116":71051,"_20912":119297,"_5":14363,"_27402":119220,"_2946":119298},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3462":71086,"_30116":71051,"_20912":119300,"_5":14363,"_27402":119220,"_2946":119301},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3462":71087,"_30116":71051,"_20912":119303,"_5":14363,"_27402":119223,"_2946":119304},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3462":71088,"_30116":71051,"_20912":119306,"_5":14363,"_27402":119223,"_2946":119307},[],"Parte",{"_3462":71089,"_30116":71051,"_20912":119309,"_5":14363,"_27402":119223,"_2946":119310},[],"Contenido tras decodificar su Base64",{"_3462":71090,"_30116":71051,"_20912":119312,"_5":14363,"_27402":119223,"_2946":52481},[],{"_3462":71091,"_30116":71051,"_20912":119314,"_5":14363,"_27402":119223,"_2946":119315},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3462":71092,"_30116":71051,"_20912":119317,"_5":14363,"_27402":119223,"_2946":52487},[],{"_3462":71093,"_30116":71051,"_20912":119319,"_5":14363,"_27402":119223,"_2946":119320},[],"PKCS#7 DER con el certificado emitido.",{"_3462":71094,"_30116":71051,"_20912":119322,"_5":14363,"_27402":119223,"_2946":119323},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3462":71095,"_30116":71051,"_20912":119325,"_5":14363,"_27402":119227,"_2946":119326},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3462":71096,"_30116":71051,"_20912":119328,"_5":14363,"_27402":119227,"_2946":119329},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3462":71097,"_30116":71051,"_20912":119331,"_5":14363,"_27402":119227,"_2946":119332},[],"Convierte y comprueba el resultado:",{"_3462":71098,"_30116":71051,"_20912":119334,"_5":14363,"_27402":119227,"_2946":119335},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3462":71099,"_30116":71051,"_20912":119337,"_5":14363,"_27402":119231,"_2946":119338},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3462":71100,"_30116":71051,"_20912":119340,"_5":14363,"_27402":119231,"_2946":119341},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3462":71101,"_30116":71101,"_5":14715,"_2946":118700,"_30468":119343,"_20912":119344,"_27402":71101},[49167,117513,51649,118525,118700],[],{"_3462":71102,"_30116":71101,"_20912":119346,"_5":14363,"_27402":71101,"_2946":119347},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3462":71103,"_30116":71101,"_5":30465,"_20912":119349,"_27402":119350,"_2946":119351},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3462":71104,"_30116":71101,"_5":30465,"_20912":119353,"_27402":119354,"_2946":119355},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3462":71105,"_30116":71101,"_5":30465,"_20912":119357,"_27402":119358,"_2946":119359},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3462":71106,"_30116":71101,"_5":30465,"_20912":119361,"_27402":119362,"_2946":119363},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3462":71107,"_30116":71101,"_20912":119365,"_5":14363,"_27402":71101,"_2946":119366},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3462":71108,"_30116":71101,"_20912":119368,"_5":14363,"_27402":119350,"_2946":119369},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3462":71109,"_30116":71101,"_20912":119371,"_5":14363,"_27402":119350,"_2946":119372},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3462":71110,"_30116":71101,"_20912":119374,"_5":14363,"_27402":119350,"_2946":119375},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3462":71111,"_30116":71101,"_20912":119377,"_5":14363,"_27402":119350,"_2946":119378},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3462":71112,"_30116":71101,"_20912":119380,"_5":14363,"_27402":119350,"_2946":119381},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3462":71113,"_30116":71101,"_20912":119383,"_5":14363,"_27402":119350,"_2946":119384},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3462":71114,"_30116":71101,"_20912":119386,"_5":14363,"_27402":119354,"_2946":119387},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3462":71115,"_30116":71101,"_20912":119389,"_5":14363,"_27402":119354,"_2946":119390},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3462":71116,"_30116":71101,"_20912":119392,"_5":14363,"_27402":119354,"_2946":119393},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3462":71117,"_30116":71101,"_20912":119395,"_5":14363,"_27402":119354,"_2946":119396},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3462":71118,"_30116":71101,"_20912":119398,"_5":14363,"_27402":119358,"_2946":119399},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3462":71119,"_30116":71101,"_20912":119401,"_5":14363,"_27402":119358,"_2946":119402},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3462":71120,"_30116":71101,"_20912":119404,"_5":14363,"_27402":119358,"_2946":119405},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3462":71121,"_30116":71101,"_20912":119407,"_5":14363,"_27402":119358,"_2946":119408},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3462":71122,"_30116":71101,"_20912":119410,"_5":14363,"_27402":119362,"_2946":119411},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3462":71123,"_30116":71101,"_20912":119413,"_5":14363,"_27402":119362,"_2946":119414},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3462":71124,"_30116":71124,"_5":14715,"_2946":119416,"_30468":119417,"_20912":119418,"_27402":71124},"Estrategias de aprovisionamiento",[49167,117513,51649,118525,118700],[],{"_3462":71125,"_30116":71124,"_20912":119420,"_5":14363,"_27402":71124,"_2946":119421},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3462":71126,"_30116":71124,"_5":30465,"_20912":119423,"_27402":119424,"_2946":119425},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3462":71127,"_30116":71124,"_5":30465,"_20912":119427,"_27402":119428,"_2946":119429},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3462":71128,"_30116":71124,"_5":30465,"_20912":119431,"_27402":119432,"_2946":119433},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3462":71129,"_30116":71124,"_5":30465,"_20912":119435,"_27402":119436,"_2946":119437},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3462":71130,"_30116":71124,"_5":30465,"_20912":119439,"_27402":119440,"_2946":119441},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3462":71131,"_30116":71124,"_20912":119443,"_5":14363,"_27402":71124,"_2946":119444},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3462":71132,"_30116":71124,"_20912":119446,"_5":14363,"_27402":119424,"_2946":119447},[],"Recorrido",{"_3462":71133,"_30116":71124,"_20912":119449,"_5":14363,"_27402":119424,"_2946":119450},[],"Cuándo existe el dispositivo",{"_3462":71134,"_30116":71124,"_20912":119452,"_5":14363,"_27402":119424,"_2946":119453},[],"Qué compruebas",{"_3462":71135,"_30116":71124,"_20912":119455,"_5":14363,"_27402":119424,"_2946":119456},[],"Asignación manual",{"_3462":71136,"_30116":71124,"_20912":119458,"_5":14363,"_27402":119424,"_2946":119459},[],"El operador lo crea antes de asociar un certificado.",{"_3462":71137,"_30116":71124,"_20912":119461,"_5":14363,"_27402":119424,"_2946":119462},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3462":71138,"_30116":71124,"_20912":119464,"_5":14363,"_27402":119424,"_2946":119465},[],"EST con `JITP`",{"_3462":71139,"_30116":71124,"_20912":119467,"_5":14363,"_27402":119424,"_2946":119468},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3462":71140,"_30116":71124,"_20912":119470,"_5":14363,"_27402":119424,"_2946":119471},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3462":71141,"_30116":71124,"_20912":119473,"_5":14363,"_27402":119424,"_2946":119474},[],"EST con `PRE_REGISTRATION`",{"_3462":71142,"_30116":71124,"_20912":119476,"_5":14363,"_27402":119424,"_2946":119477},[],"Debe existir antes de `/simpleenroll`.",{"_3462":71143,"_30116":71124,"_20912":119479,"_5":14363,"_27402":119424,"_2946":119480},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3462":71144,"_30116":71124,"_20912":119482,"_5":14363,"_27402":119424,"_2946":119483},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3462":71145,"_30116":71124,"_20912":119485,"_5":14363,"_27402":119424,"_2946":119486},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3462":71146,"_30116":71124,"_20912":119488,"_5":14363,"_27402":119428,"_2946":119489},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3462":71147,"_30116":71124,"_20912":119491,"_5":14363,"_27402":119428,"_2946":119492},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3462":71148,"_30116":71124,"_20912":119494,"_5":14363,"_27402":119428,"_2946":119495},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3462":71149,"_30116":71124,"_20912":119497,"_5":14363,"_27402":119432,"_2946":119498},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3462":71150,"_30116":71124,"_20912":119500,"_5":14363,"_27402":119432,"_2946":119501},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3462":71151,"_30116":71124,"_20912":119503,"_5":14363,"_27402":119432,"_2946":119504},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3462":71152,"_30116":71124,"_20912":119506,"_5":14363,"_27402":119432,"_2946":119507},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3462":71153,"_30116":71124,"_20912":119509,"_5":14363,"_27402":119432,"_2946":119510},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3462":71154,"_30116":71124,"_20912":119512,"_5":14363,"_27402":119432,"_2946":119513},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3462":71155,"_30116":71124,"_20912":119515,"_5":14363,"_27402":119436,"_2946":116455},[],{"_3462":71156,"_30116":71124,"_20912":119517,"_5":14363,"_27402":119436,"_2946":119518},[],"Material que atraviesa EST",{"_3462":71157,"_30116":71124,"_20912":119520,"_5":14363,"_27402":119436,"_2946":119521},[],"Clave generada por el dispositivo",{"_3462":71158,"_30116":71124,"_20912":119523,"_5":14363,"_27402":119436,"_2946":119524},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3462":71159,"_30116":71124,"_20912":119526,"_5":14363,"_27402":119436,"_2946":119527},[],"Clave ya disponible en el dispositivo",{"_3462":71160,"_30116":71124,"_20912":119529,"_5":14363,"_27402":119436,"_2946":119530},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3462":71161,"_30116":71124,"_20912":119532,"_5":14363,"_27402":119436,"_2946":51968},[],{"_3462":71162,"_30116":71124,"_20912":119534,"_5":14363,"_27402":119436,"_2946":119535},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3462":71163,"_30116":71124,"_20912":119537,"_5":14363,"_27402":119436,"_2946":119538},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3462":71164,"_30116":71124,"_20912":119540,"_5":14363,"_27402":119440,"_2946":119541},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3462":71165,"_30116":71165,"_5":14715,"_2946":119543,"_30468":119544,"_20912":119545,"_27402":71165},"Renovación y recuperación",[49167,117513,51649,118525,118700],[],{"_3462":71166,"_30116":71165,"_20912":119547,"_5":14363,"_27402":71165,"_2946":119548},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3462":71167,"_30116":71165,"_5":30465,"_20912":119550,"_27402":119551,"_2946":119552},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3462":71168,"_30116":71165,"_5":30465,"_20912":119554,"_27402":119555,"_2946":119556},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3462":71169,"_30116":71165,"_5":30465,"_20912":119558,"_27402":119559,"_2946":119560},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3462":71170,"_30116":71165,"_5":30465,"_20912":119562,"_27402":119563,"_2946":119564},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3462":71171,"_30116":71165,"_5":30465,"_20912":119566,"_27402":119567,"_2946":119568},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3462":71172,"_30116":71165,"_20912":119570,"_5":14363,"_27402":71165,"_2946":119571},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3462":71173,"_30116":71165,"_20912":119573,"_5":14363,"_27402":119551,"_2946":119574},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3462":71174,"_30116":71165,"_20912":119576,"_5":14363,"_27402":119551,"_2946":119577},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3462":71175,"_30116":71165,"_20912":119579,"_5":14363,"_27402":119551,"_2946":119580},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3462":71176,"_30116":71165,"_20912":119582,"_5":14363,"_27402":119551,"_2946":119583},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3462":71177,"_30116":71165,"_20912":119585,"_5":14363,"_27402":119555,"_2946":119586},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3462":71178,"_30116":71165,"_20912":119588,"_5":14363,"_27402":119555,"_2946":119589},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3462":71179,"_30116":71165,"_20912":119591,"_5":14363,"_27402":119559,"_2946":119592},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3462":71180,"_30116":71165,"_20912":119594,"_5":14363,"_27402":119559,"_2946":119595},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3462":71181,"_30116":71165,"_20912":119597,"_5":14363,"_27402":119559,"_2946":119598},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3462":71182,"_30116":71165,"_20912":119600,"_5":14363,"_27402":119563,"_2946":119601},[],"Situación",{"_3462":71183,"_30116":71165,"_20912":119603,"_5":14363,"_27402":119563,"_2946":119604},[],"Procedimiento",{"_3462":71184,"_30116":71165,"_20912":119606,"_5":14363,"_27402":119563,"_2946":119607},[],"Certificado vigente, fuera de ventana",{"_3462":71185,"_30116":71165,"_20912":119609,"_5":14363,"_27402":119563,"_2946":119610},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3462":71186,"_30116":71165,"_20912":119612,"_5":14363,"_27402":119563,"_2946":119613},[],"Certificado vencido, clave disponible",{"_3462":71187,"_30116":71165,"_20912":119615,"_5":14363,"_27402":119563,"_2946":119616},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3462":71188,"_30116":71165,"_20912":119618,"_5":14363,"_27402":119563,"_2946":119619},[],"Renovación por webhook o `NO_AUTH`",{"_3462":71189,"_30116":71165,"_20912":119621,"_5":14363,"_27402":119563,"_2946":119622},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3462":71190,"_30116":71165,"_20912":119624,"_5":14363,"_27402":119563,"_2946":119625},[],"Clave perdida o inaccesible",{"_3462":71191,"_30116":71165,"_20912":119627,"_5":14363,"_27402":119563,"_2946":119628},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3462":71192,"_30116":71165,"_20912":119630,"_5":14363,"_27402":119563,"_2946":119631},[],"Identidad actual revocada",{"_3462":71193,"_30116":71165,"_20912":119633,"_5":14363,"_27402":119563,"_2946":119634},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3462":71194,"_30116":71165,"_20912":119636,"_5":14363,"_27402":119563,"_2946":119637},[],"Dispositivo sin identidad",{"_3462":71195,"_30116":71165,"_20912":119639,"_5":14363,"_27402":119563,"_2946":119640},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3462":71196,"_30116":71165,"_20912":119642,"_5":14363,"_27402":119563,"_2946":119643},[],"Dispositivo retirado",{"_3462":71197,"_30116":71165,"_20912":119645,"_5":14363,"_27402":119563,"_2946":119646},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3462":71198,"_30116":71165,"_20912":119648,"_5":14363,"_27402":119563,"_2946":119649},[],"Timeout, HTTP 500 o fallo de instalación",{"_3462":71199,"_30116":71165,"_20912":119651,"_5":14363,"_27402":119563,"_2946":119652},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3462":71200,"_30116":71165,"_20912":119654,"_5":14363,"_27402":119567,"_2946":119655},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3462":71201,"_30116":71165,"_20912":119657,"_5":14363,"_27402":119567,"_2946":119658},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3462":71202,"_30116":71202,"_5":14715,"_2946":119660,"_30468":119661,"_20912":119662,"_27402":71202},"Diagnóstico de enrolamiento",[49167,117513,51649,118525,118700],[],{"_3462":71203,"_30116":71202,"_20912":119664,"_5":14363,"_27402":71202,"_2946":119665},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3462":71204,"_30116":71202,"_5":30465,"_20912":119667,"_27402":119668,"_2946":119669},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3462":71205,"_30116":71202,"_5":30465,"_20912":119671,"_27402":119672,"_2946":119673},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3462":71206,"_30116":71202,"_5":30465,"_20912":119675,"_27402":119676,"_2946":119232},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3462":71207,"_30116":71202,"_5":30465,"_20912":119678,"_27402":119679,"_2946":119680},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3462":71208,"_30116":71202,"_20912":119682,"_5":14363,"_27402":71202,"_2946":119683},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3462":71209,"_30116":71202,"_20912":119685,"_5":14363,"_27402":119672,"_2946":119686},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3462":71210,"_30116":71202,"_20912":119688,"_5":14363,"_27402":119672,"_2946":119689},[],"Síntoma o mensaje",{"_3462":71211,"_30116":71202,"_20912":119691,"_5":14363,"_27402":119672,"_2946":119692},[],"Qué revisar",{"_3462":71212,"_30116":71202,"_20912":119694,"_5":14363,"_27402":119672,"_2946":119695},[],"curl rechaza TLS, nombre o emisor",{"_3462":71213,"_30116":71202,"_20912":119697,"_5":14363,"_27402":119672,"_2946":119698},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3462":71214,"_30116":71202,"_20912":119700,"_5":14363,"_27402":119672,"_2946":119701},[],"404 o APS ausente",{"_3462":71215,"_30116":71202,"_20912":119703,"_5":14363,"_27402":119672,"_2946":119704},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3462":71216,"_30116":71202,"_20912":119706,"_5":14363,"_27402":119672,"_2946":119707},[],"400, error de CSR o formato",{"_3462":71217,"_30116":71202,"_20912":119709,"_5":14363,"_27402":119672,"_2946":119710},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3462":71218,"_30116":71202,"_20912":119712,"_5":14363,"_27402":119672,"_2946":119713},[],"Credencial ausente o certificado no válido",{"_3462":71219,"_30116":71202,"_20912":119715,"_5":14363,"_27402":119672,"_2946":119716},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3462":71220,"_30116":71202,"_20912":119718,"_5":14363,"_27402":119672,"_2946":119719},[],"Webhook deniega, expira o responde sin autorización",{"_3462":71221,"_30116":71202,"_20912":119721,"_5":14363,"_27402":119672,"_2946":119722},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3462":71222,"_30116":71202,"_20912":119724,"_5":14363,"_27402":119672,"_2946":52894},[],{"_3462":71223,"_30116":71202,"_20912":119726,"_5":14363,"_27402":119672,"_2946":119727},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3462":71224,"_30116":71202,"_20912":119729,"_5":14363,"_27402":119672,"_2946":52900},[],{"_3462":71225,"_30116":71202,"_20912":119731,"_5":14363,"_27402":119672,"_2946":119732},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3462":71226,"_30116":71202,"_20912":119734,"_5":14363,"_27402":119672,"_2946":52906},[],{"_3462":71227,"_30116":71202,"_20912":119736,"_5":14363,"_27402":119672,"_2946":119737},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3462":71228,"_30116":71202,"_20912":119739,"_5":14363,"_27402":119672,"_2946":52912},[],{"_3462":71229,"_30116":71202,"_20912":119741,"_5":14363,"_27402":119672,"_2946":119742},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3462":71230,"_30116":71202,"_20912":119744,"_5":14363,"_27402":119672,"_2946":52918},[],{"_3462":71231,"_30116":71202,"_20912":119746,"_5":14363,"_27402":119672,"_2946":119747},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3462":71232,"_30116":71202,"_20912":119749,"_5":14363,"_27402":119672,"_2946":119750},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3462":71233,"_30116":71202,"_20912":119752,"_5":14363,"_27402":119672,"_2946":119753},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3462":71234,"_30116":71202,"_20912":119755,"_5":14363,"_27402":119672,"_2946":119756},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3462":71235,"_30116":71202,"_20912":119758,"_5":14363,"_27402":119672,"_2946":119759},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3462":71236,"_30116":71202,"_20912":119761,"_5":14363,"_27402":119672,"_2946":52936},[],{"_3462":71237,"_30116":71202,"_20912":119763,"_5":14363,"_27402":119672,"_2946":119764},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3462":71238,"_30116":71202,"_20912":119766,"_5":14363,"_27402":119672,"_2946":52942},[],{"_3462":71239,"_30116":71202,"_20912":119768,"_5":14363,"_27402":119672,"_2946":119769},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3462":71240,"_30116":71202,"_20912":119771,"_5":14363,"_27402":119672,"_2946":119772},[],"DMS propietario distinto",{"_3462":71241,"_30116":71202,"_20912":119774,"_5":14363,"_27402":119672,"_2946":119775},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3462":71242,"_30116":71202,"_20912":119777,"_5":14363,"_27402":119672,"_2946":52954},[],{"_3462":71243,"_30116":71202,"_20912":119779,"_5":14363,"_27402":119672,"_2946":119780},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3462":71244,"_30116":71202,"_20912":119782,"_5":14363,"_27402":119672,"_2946":52960},[],{"_3462":71245,"_30116":71202,"_20912":119784,"_5":14363,"_27402":119672,"_2946":119785},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3462":71246,"_30116":71202,"_20912":119787,"_5":14363,"_27402":119672,"_2946":119788},[],"Certificado actual revocado",{"_3462":71247,"_30116":71202,"_20912":119790,"_5":14363,"_27402":119672,"_2946":119791},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3462":71248,"_30116":71202,"_20912":119793,"_5":14363,"_27402":119672,"_2946":119794},[],"Error de CA, perfil o firma",{"_3462":71249,"_30116":71202,"_20912":119796,"_5":14363,"_27402":119672,"_2946":119797},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3462":71250,"_30116":71202,"_20912":119799,"_5":14363,"_27402":119672,"_2946":119800},[],"HTTP 200 sin conexión del dispositivo",{"_3462":71251,"_30116":71202,"_20912":119802,"_5":14363,"_27402":119672,"_2946":119803},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3462":71252,"_30116":71202,"_20912":119805,"_5":14363,"_27402":119672,"_2946":119806},[],"Timeout o error después de emitir",{"_3462":71253,"_30116":71202,"_20912":119808,"_5":14363,"_27402":119672,"_2946":119809},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3462":71254,"_30116":71202,"_20912":119811,"_5":14363,"_27402":119676,"_2946":119812},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3462":71255,"_30116":71202,"_20912":119814,"_5":14363,"_27402":119676,"_2946":119815},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3462":71256,"_30116":71202,"_20912":119817,"_5":14363,"_27402":119679,"_2946":119818},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3462":71257,"_30116":71202,"_20912":119820,"_5":14363,"_27402":119679,"_2946":119821},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3462":71258,"_30116":71202,"_20912":119823,"_5":14363,"_27402":119679,"_2946":119824},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3462":71259,"_30116":71202,"_20912":119826,"_5":14363,"_27402":119679,"_2946":119827},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3462":71260,"_30116":71202,"_20912":119829,"_5":14363,"_27402":119679,"_2946":119830},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3462":71261,"_30116":71202,"_20912":119832,"_5":14363,"_27402":119679,"_2946":119833},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3462":71262,"_30116":71202,"_20912":119835,"_5":14363,"_27402":119679,"_2946":119836},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3462":71263,"_30116":71263,"_5":14715,"_2946":119838,"_30468":119839,"_20912":119840,"_27402":71263},"Distribución y actualización de confianza",[49167,117513,51649,118525,118700],[],{"_3462":71264,"_30116":71263,"_20912":119842,"_5":14363,"_27402":71263,"_2946":119843},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3462":71265,"_30116":71263,"_5":30465,"_20912":119845,"_27402":119846,"_2946":119847},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3462":71266,"_30116":71263,"_5":30465,"_20912":119849,"_27402":119850,"_2946":119851},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3462":71267,"_30116":71263,"_5":30465,"_20912":119853,"_27402":119854,"_2946":119855},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3462":71268,"_30116":71263,"_5":30465,"_20912":119857,"_27402":119858,"_2946":119859},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3462":71269,"_30116":71263,"_5":30465,"_20912":119861,"_27402":119862,"_2946":119863},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3462":71270,"_30116":71263,"_20912":119865,"_5":14363,"_27402":71263,"_2946":119866},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3462":71271,"_30116":71263,"_20912":119868,"_5":14363,"_27402":119846,"_2946":119869},[],"Relación",{"_3462":71272,"_30116":71263,"_20912":119871,"_5":14363,"_27402":119846,"_2946":119872},[],"Material que prepara el responsable",{"_3462":71273,"_30116":71263,"_20912":119874,"_5":14363,"_27402":119846,"_2946":119875},[],"Dispositivo → servidor EST",{"_3462":71274,"_30116":71263,"_20912":119877,"_5":14363,"_27402":119846,"_2946":119878},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3462":71275,"_30116":71263,"_20912":119880,"_5":14363,"_27402":119846,"_2946":119881},[],"DMS → solicitante",{"_3462":71276,"_30116":71263,"_20912":119883,"_5":14363,"_27402":119846,"_2946":119884},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3462":71277,"_30116":71263,"_20912":119886,"_5":14363,"_27402":119846,"_2946":119887},[],"Consumidor → dispositivo",{"_3462":71278,"_30116":71263,"_20912":119889,"_5":14363,"_27402":119846,"_2946":119890},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3462":71279,"_30116":71263,"_20912":119892,"_5":14363,"_27402":119846,"_2946":119893},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3462":71280,"_30116":71263,"_20912":119895,"_5":14363,"_27402":119850,"_2946":119896},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3462":71281,"_30116":71263,"_20912":119898,"_5":14363,"_27402":119850,"_2946":119899},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3462":71282,"_30116":71263,"_20912":119901,"_5":14363,"_27402":119854,"_2946":119902},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3462":71283,"_30116":71263,"_20912":119904,"_5":14363,"_27402":119854,"_2946":119905},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3462":71284,"_30116":71263,"_20912":119907,"_5":14363,"_27402":119854,"_2946":119908},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3462":71285,"_30116":71263,"_20912":119910,"_5":14363,"_27402":119854,"_2946":119911},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3462":71286,"_30116":71263,"_20912":119913,"_5":14363,"_27402":119854,"_2946":119914},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3462":71287,"_30116":71263,"_20912":119916,"_5":14363,"_27402":119854,"_2946":119917},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3462":71288,"_30116":71263,"_20912":119919,"_5":14363,"_27402":119858,"_2946":119920},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3462":71289,"_30116":71263,"_20912":119922,"_5":14363,"_27402":119858,"_2946":119923},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3462":71290,"_30116":71263,"_20912":119925,"_5":14363,"_27402":119858,"_2946":119926},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3462":71291,"_30116":71263,"_20912":119928,"_5":14363,"_27402":119862,"_2946":119929},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3462":71292,"_30116":71292,"_5":14715,"_2946":53109,"_30468":119931,"_20912":119933,"_27402":71292},[49167,117513,51649,118525,119932],"Integraciones",[],{"_3462":71293,"_30116":71292,"_20912":119935,"_5":14363,"_27402":71292,"_2946":119936},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3462":71294,"_30116":71292,"_5":30465,"_20912":119938,"_27402":119939,"_2946":119940},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3462":71295,"_30116":71292,"_5":30465,"_20912":119942,"_27402":119943,"_2946":119944},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3462":71296,"_30116":71292,"_5":30465,"_20912":119946,"_27402":119947,"_2946":119948},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3462":71297,"_30116":71292,"_5":30465,"_20912":119950,"_27402":119951,"_2946":119952},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3462":71298,"_30116":71292,"_5":30465,"_20912":119954,"_27402":119955,"_2946":119956},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3462":71299,"_30116":71292,"_5":30465,"_20912":119958,"_27402":119959,"_2946":119960},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3462":71300,"_30116":71292,"_5":30465,"_20912":119962,"_27402":119963,"_2946":119964},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3462":71301,"_30116":71292,"_5":30465,"_20912":119966,"_27402":119967,"_2946":119968},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3462":71302,"_30116":71292,"_5":30465,"_20912":119970,"_27402":119971,"_2946":53151},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3462":71303,"_30116":71292,"_5":30465,"_20912":119973,"_27402":119974,"_2946":53155},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3462":71304,"_30116":71292,"_5":30465,"_20912":119976,"_27402":119977,"_2946":119978},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3462":71305,"_30116":71292,"_5":30465,"_20912":119980,"_27402":119981,"_2946":119982},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3462":71306,"_30116":71292,"_5":30465,"_20912":119984,"_27402":119985,"_2946":119986},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3462":71307,"_30116":71292,"_5":30465,"_20912":119988,"_27402":119989,"_2946":119990},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3462":71308,"_30116":71292,"_5":30465,"_20912":119992,"_27402":119993,"_2946":119994},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3462":71309,"_30116":71292,"_5":30465,"_20912":119996,"_27402":119997,"_2946":119998},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3462":71310,"_30116":71292,"_5":30465,"_20912":120000,"_27402":120001,"_2946":120002},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3462":71311,"_30116":71292,"_5":30465,"_20912":120004,"_27402":120005,"_2946":120006},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3462":71312,"_30116":71292,"_5":30465,"_20912":120008,"_27402":120009,"_2946":120010},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3462":71313,"_30116":71292,"_5":30465,"_20912":120012,"_27402":120013,"_2946":120014},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3462":71314,"_30116":71292,"_5":30465,"_20912":120016,"_27402":120017,"_2946":120018},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3462":71315,"_30116":71292,"_5":30465,"_20912":120020,"_27402":120021,"_2946":120022},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3462":71316,"_30116":71292,"_5":30465,"_20912":120024,"_27402":120025,"_2946":120026},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3462":71317,"_30116":71292,"_5":30465,"_20912":120028,"_27402":120029,"_2946":120030},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3462":71318,"_30116":71292,"_5":30465,"_20912":120032,"_27402":120033,"_2946":120034},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3462":71319,"_30116":71292,"_20912":120036,"_5":14363,"_27402":71292,"_2946":120037},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3462":71320,"_30116":71292,"_20912":120039,"_5":14363,"_27402":71292,"_2946":120040},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3462":71321,"_30116":71292,"_20912":120042,"_5":14363,"_27402":71292,"_2946":120043},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3462":71322,"_30116":71292,"_20912":120045,"_5":14363,"_27402":119939,"_2946":120046},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3462":71323,"_30116":71292,"_20912":120048,"_5":14363,"_27402":119939,"_2946":120049},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3462":71324,"_30116":71292,"_20912":120051,"_5":14363,"_27402":119939,"_2946":120052},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3462":71325,"_30116":71292,"_20912":120054,"_5":14363,"_27402":119939,"_2946":120055},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3462":71326,"_30116":71292,"_20912":120057,"_5":14363,"_27402":119943,"_2946":120058},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3462":71327,"_30116":71292,"_20912":120060,"_5":14363,"_27402":119947,"_2946":120061},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3462":71328,"_30116":71292,"_20912":120063,"_5":14363,"_27402":119947,"_2946":120064},[],"Acción IAM",{"_3462":71329,"_30116":71292,"_20912":120066,"_5":14363,"_27402":119947,"_2946":116461},[],{"_3462":71330,"_30116":71292,"_20912":120068,"_5":14363,"_27402":119947,"_2946":53250},[],{"_3462":71331,"_30116":71292,"_20912":120070,"_5":14363,"_27402":119947,"_2946":120071},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3462":71332,"_30116":71292,"_20912":120073,"_5":14363,"_27402":119947,"_2946":53256},[],{"_3462":71333,"_30116":71292,"_20912":120075,"_5":14363,"_27402":119947,"_2946":120076},[],"Registrar la CA en AWS IoT",{"_3462":71334,"_30116":71292,"_20912":120078,"_5":14363,"_27402":119947,"_2946":53262},[],{"_3462":71335,"_30116":71292,"_20912":120080,"_5":14363,"_27402":119947,"_2946":120081},[],"Consultar el estado del registro de la CA",{"_3462":71336,"_30116":71292,"_20912":120083,"_5":14363,"_27402":119947,"_2946":53268},[],{"_3462":71337,"_30116":71292,"_20912":120085,"_5":14363,"_27402":119947,"_2946":120086},[],"Crear o actualizar Things en IoT Core",{"_3462":71338,"_30116":71292,"_20912":120088,"_5":14363,"_27402":119947,"_2946":53274},[],{"_3462":71339,"_30116":71292,"_20912":120090,"_5":14363,"_27402":119947,"_2946":120091},[],"Aprovisionar Things mediante plantilla",{"_3462":71340,"_30116":71292,"_20912":120093,"_5":14363,"_27402":119947,"_2946":53280},[],{"_3462":71341,"_30116":71292,"_20912":120095,"_5":14363,"_27402":119947,"_2946":120096},[],"Registrar certificados de dispositivo",{"_3462":71342,"_30116":71292,"_20912":120098,"_5":14363,"_27402":119947,"_2946":53286},[],{"_3462":71343,"_30116":71292,"_20912":120100,"_5":14363,"_27402":119947,"_2946":120101},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3462":71344,"_30116":71292,"_20912":120103,"_5":14363,"_27402":119947,"_2946":53292},[],{"_3462":71345,"_30116":71292,"_20912":120105,"_5":14363,"_27402":119947,"_2946":120106},[],"Crear y adjuntar políticas IoT",{"_3462":71346,"_30116":71292,"_20912":120108,"_5":14363,"_27402":119947,"_2946":53298},[],{"_3462":71347,"_30116":71292,"_20912":120110,"_5":14363,"_27402":119947,"_2946":120111},[],"Gestionar grupos de Things",{"_3462":71348,"_30116":71292,"_20912":120113,"_5":14363,"_27402":119947,"_2946":53304},[],{"_3462":71349,"_30116":71292,"_20912":120115,"_5":14363,"_27402":119947,"_2946":120116},[],"Crear plantillas JITP",{"_3462":71350,"_30116":71292,"_20912":120118,"_5":14363,"_27402":119947,"_2946":53310},[],{"_3462":71351,"_30116":71292,"_20912":120120,"_5":14363,"_27402":119947,"_2946":120121},[],"Leer y escribir el Device Shadow",{"_3462":71352,"_30116":71292,"_20912":120123,"_5":14363,"_27402":119947,"_2946":120124},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3462":71353,"_30116":71292,"_20912":120126,"_5":14363,"_27402":119951,"_2946":120127},[],"Parámetro",{"_3462":71354,"_30116":71292,"_20912":120129,"_5":14363,"_27402":119951,"_2946":120130},[],"Tipo",{"_3462":71355,"_30116":71292,"_20912":120132,"_5":14363,"_27402":119951,"_2946":120133},[],"Requerido",{"_3462":71356,"_30116":71292,"_20912":120135,"_5":14363,"_27402":119951,"_2946":120136},[],"Descripción",{"_3462":71357,"_30116":71292,"_20912":120138,"_5":14363,"_27402":119951,"_2946":53331},[],{"_3462":71358,"_30116":71292,"_20912":120140,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71359,"_30116":71292,"_20912":120142,"_5":14363,"_27402":119951,"_2946":120143},[],"Sí",{"_3462":71360,"_30116":71292,"_20912":120145,"_5":14363,"_27402":119951,"_2946":120146},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3462":71361,"_30116":71292,"_20912":120148,"_5":14363,"_27402":119951,"_2946":53342},[],{"_3462":71362,"_30116":71292,"_20912":120150,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71363,"_30116":71292,"_20912":120152,"_5":14363,"_27402":119951,"_2946":120143},[],{"_3462":71364,"_30116":71292,"_20912":120154,"_5":14363,"_27402":119951,"_2946":120155},[],"Región AWS donde opera el conector.",{"_3462":71365,"_30116":71292,"_20912":120157,"_5":14363,"_27402":119951,"_2946":53352},[],{"_3462":71366,"_30116":71292,"_20912":120159,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71367,"_30116":71292,"_20912":120161,"_5":14363,"_27402":119951,"_2946":120143},[],{"_3462":71368,"_30116":71292,"_20912":120163,"_5":14363,"_27402":119951,"_2946":120164},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3462":71369,"_30116":71292,"_20912":120166,"_5":14363,"_27402":119951,"_2946":53362},[],{"_3462":71370,"_30116":71292,"_20912":120168,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71371,"_30116":71292,"_20912":120170,"_5":14363,"_27402":119951,"_2946":120171},[],"Solo con `auth_method=static`",{"_3462":71372,"_30116":71292,"_20912":120173,"_5":14363,"_27402":119951,"_2946":120174},[],"Clave de acceso AWS.",{"_3462":71373,"_30116":71292,"_20912":120176,"_5":14363,"_27402":119951,"_2946":53373},[],{"_3462":71374,"_30116":71292,"_20912":120178,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71375,"_30116":71292,"_20912":120180,"_5":14363,"_27402":119951,"_2946":120171},[],{"_3462":71376,"_30116":71292,"_20912":120182,"_5":14363,"_27402":119951,"_2946":120183},[],"Clave secreta AWS.",{"_3462":71377,"_30116":71292,"_20912":120185,"_5":14363,"_27402":119951,"_2946":53383},[],{"_3462":71378,"_30116":71292,"_20912":120187,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71379,"_30116":71292,"_20912":120189,"_5":14363,"_27402":119951,"_2946":53388},[],{"_3462":71380,"_30116":71292,"_20912":120191,"_5":14363,"_27402":119951,"_2946":120192},[],"Token de sesión (con `auth_method=static`).",{"_3462":71381,"_30116":71292,"_20912":120194,"_5":14363,"_27402":119951,"_2946":53394},[],{"_3462":71382,"_30116":71292,"_20912":120196,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71383,"_30116":71292,"_20912":120198,"_5":14363,"_27402":119951,"_2946":120199},[],"Solo con `auth_method=role`",{"_3462":71384,"_30116":71292,"_20912":120201,"_5":14363,"_27402":119951,"_2946":120202},[],"ARN del rol a asumir.",{"_3462":71385,"_30116":71292,"_20912":120204,"_5":14363,"_27402":119951,"_2946":53405},[],{"_3462":71386,"_30116":71292,"_20912":120206,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71387,"_30116":71292,"_20912":120208,"_5":14363,"_27402":119951,"_2946":53388},[],{"_3462":71388,"_30116":71292,"_20912":120210,"_5":14363,"_27402":119951,"_2946":120211},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3462":71389,"_30116":71292,"_20912":120213,"_5":14363,"_27402":119951,"_2946":53415},[],{"_3462":71390,"_30116":71292,"_20912":120215,"_5":14363,"_27402":119951,"_2946":89617},[],{"_3462":71391,"_30116":71292,"_20912":120217,"_5":14363,"_27402":119951,"_2946":120143},[],{"_3462":71392,"_30116":71292,"_20912":120219,"_5":14363,"_27402":119951,"_2946":120220},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3462":71393,"_30116":71292,"_20912":120222,"_5":14363,"_27402":119951,"_2946":53425},[],{"_3462":71394,"_30116":71292,"_20912":120224,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71395,"_30116":71292,"_20912":120226,"_5":14363,"_27402":119951,"_2946":120143},[],{"_3462":71396,"_30116":71292,"_20912":120228,"_5":14363,"_27402":119951,"_2946":120229},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3462":71397,"_30116":71292,"_20912":120231,"_5":14363,"_27402":119951,"_2946":53435},[],{"_3462":71398,"_30116":71292,"_20912":120233,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71399,"_30116":71292,"_20912":120235,"_5":14363,"_27402":119951,"_2946":120143},[],{"_3462":71400,"_30116":71292,"_20912":120237,"_5":14363,"_27402":119951,"_2946":120238},[],"URL HTTP del Device Manager de Lamassu.",{"_3462":71401,"_30116":71292,"_20912":120240,"_5":14363,"_27402":119951,"_2946":53445},[],{"_3462":71402,"_30116":71292,"_20912":120242,"_5":14363,"_27402":119951,"_2946":24983},[],{"_3462":71403,"_30116":71292,"_20912":120244,"_5":14363,"_27402":119951,"_2946":120143},[],{"_3462":71404,"_30116":71292,"_20912":120246,"_5":14363,"_27402":119951,"_2946":120247},[],"URL HTTP del servicio de CA de Lamassu.",{"_3462":71405,"_30116":71292,"_20912":120249,"_5":14363,"_27402":119955,"_2946":120250},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3462":71406,"_30116":71292,"_20912":120252,"_5":14363,"_27402":119955,"_2946":120253},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3462":71407,"_30116":71292,"_20912":120255,"_5":14363,"_27402":119955,"_2946":120256},[],"Tipo de CloudEvent",{"_3462":71408,"_30116":71292,"_20912":120258,"_5":14363,"_27402":119955,"_2946":120259},[],"Recurso en Lamassu",{"_3462":71409,"_30116":71292,"_20912":120261,"_5":14363,"_27402":119955,"_2946":120262},[],"Recurso AWS",{"_3462":71410,"_30116":71292,"_20912":120264,"_5":14363,"_27402":119955,"_2946":120265},[],"Acciones IAM",{"_3462":71411,"_30116":71292,"_20912":120267,"_5":14363,"_27402":119955,"_2946":120268},[],"Llamadas AWS y efecto",{"_3462":71412,"_30116":71292,"_20912":120270,"_5":14363,"_27402":119955,"_2946":120271},[],"Dónde en esta página",{"_3462":71413,"_30116":71292,"_20912":120273,"_5":14363,"_27402":119955,"_2946":53479},[],{"_3462":71414,"_30116":71292,"_20912":120275,"_5":14363,"_27402":119955,"_2946":53482},[],{"_3462":71415,"_30116":71292,"_20912":120277,"_5":14363,"_27402":119955,"_2946":53485},[],{"_3462":71416,"_30116":71292,"_20912":120279,"_5":14363,"_27402":119955,"_2946":53488},[],{"_3462":71417,"_30116":71292,"_20912":120281,"_5":14363,"_27402":119955,"_2946":120282},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3462":71418,"_30116":71292,"_20912":120284,"_5":14363,"_27402":119955,"_2946":119968},[],{"_3462":71419,"_30116":71292,"_20912":120286,"_5":14363,"_27402":119955,"_2946":53496},[],{"_3462":71420,"_30116":71292,"_20912":120288,"_5":14363,"_27402":119955,"_2946":53499},[],{"_3462":71421,"_30116":71292,"_20912":120290,"_5":14363,"_27402":119955,"_2946":53502},[],{"_3462":71422,"_30116":71292,"_20912":120292,"_5":14363,"_27402":119955,"_2946":53505},[],{"_3462":71423,"_30116":71292,"_20912":120294,"_5":14363,"_27402":119955,"_2946":120295},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3462":71424,"_30116":71292,"_20912":120297,"_5":14363,"_27402":119955,"_2946":119994},[],{"_3462":71425,"_30116":71292,"_20912":120299,"_5":14363,"_27402":119955,"_2946":53513},[],{"_3462":71426,"_30116":71292,"_20912":120301,"_5":14363,"_27402":119955,"_2946":120302},[],"Dispositivo",{"_3462":71427,"_30116":71292,"_20912":120304,"_5":14363,"_27402":119955,"_2946":53519},[],{"_3462":71428,"_30116":71292,"_20912":120306,"_5":14363,"_27402":119955,"_2946":53522},[],{"_3462":71429,"_30116":71292,"_20912":120308,"_5":14363,"_27402":119955,"_2946":120309},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3462":71430,"_30116":71292,"_20912":120311,"_5":14363,"_27402":119955,"_2946":120002},[],{"_3462":71431,"_30116":71292,"_20912":120313,"_5":14363,"_27402":119955,"_2946":53530},[],{"_3462":71432,"_30116":71292,"_20912":120315,"_5":14363,"_27402":119955,"_2946":120316},[],"Certificado",{"_3462":71433,"_30116":71292,"_20912":120318,"_5":14363,"_27402":119955,"_2946":53536},[],{"_3462":71434,"_30116":71292,"_20912":120320,"_5":14363,"_27402":119955,"_2946":120321},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3462":71435,"_30116":71292,"_20912":120323,"_5":14363,"_27402":119955,"_2946":120324},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3462":71436,"_30116":71292,"_20912":120326,"_5":14363,"_27402":119955,"_2946":120014},[],{"_3462":71437,"_30116":71292,"_20912":120328,"_5":14363,"_27402":119955,"_2946":53547},[],{"_3462":71438,"_30116":71292,"_20912":120330,"_5":14363,"_27402":119955,"_2946":120331},[],"Certificado / Dispositivo",{"_3462":71439,"_30116":71292,"_20912":120333,"_5":14363,"_27402":119955,"_2946":53553},[],{"_3462":71440,"_30116":71292,"_20912":120335,"_5":14363,"_27402":119955,"_2946":49563},[],{"_3462":71441,"_30116":71292,"_20912":120337,"_5":14363,"_27402":119955,"_2946":120338},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3462":71442,"_30116":71292,"_20912":120340,"_5":14363,"_27402":119955,"_2946":120022},[],{"_3462":71443,"_30116":71292,"_20912":120342,"_5":14363,"_27402":119959,"_2946":120343},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3462":71444,"_30116":71292,"_20912":120345,"_5":14363,"_27402":119963,"_2946":120346},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3462":71445,"_30116":71292,"_20912":120348,"_5":14363,"_27402":119963,"_2946":120349},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3462":71446,"_30116":71292,"_20912":120351,"_5":14363,"_27402":119967,"_2946":120352},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3462":71447,"_30116":71292,"_20912":120354,"_5":14363,"_27402":119967,"_2946":120355},[],"Transición",{"_3462":71448,"_30116":71292,"_20912":120357,"_5":14363,"_27402":119967,"_2946":120358},[],"Llamadas AWS",{"_3462":71449,"_30116":71292,"_20912":120360,"_5":14363,"_27402":119967,"_2946":120361},[],"`NoRegistrada` → `Solicitada`",{"_3462":71450,"_30116":71292,"_20912":120363,"_5":14363,"_27402":119967,"_2946":120364},[],"ninguna (solo escritura de metadatos)",{"_3462":71451,"_30116":71292,"_20912":120366,"_5":14363,"_27402":119967,"_2946":120367},[],"`Solicitada` → `Registrando`",{"_3462":71452,"_30116":71292,"_20912":120369,"_5":14363,"_27402":119967,"_2946":120370},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3462":71453,"_30116":71292,"_20912":120372,"_5":14363,"_27402":119967,"_2946":120373},[],"`Registrando` → `Completada`",{"_3462":71454,"_30116":71292,"_20912":120375,"_5":14363,"_27402":119967,"_2946":120376},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3462":71455,"_30116":71292,"_20912":120378,"_5":14363,"_27402":119967,"_2946":120379},[],"`Registrando` → `Fallida`",{"_3462":71456,"_30116":71292,"_20912":120381,"_5":14363,"_27402":119967,"_2946":120382},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3462":71457,"_30116":71292,"_20912":120384,"_5":14363,"_27402":119967,"_2946":120385},[],"`Fallida` / `Completada` → `Solicitada`",{"_3462":71458,"_30116":71292,"_20912":120387,"_5":14363,"_27402":119967,"_2946":120388},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3462":71459,"_30116":71292,"_20912":120390,"_5":14363,"_27402":119971,"_2946":120391},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3462":71460,"_30116":71292,"_20912":120393,"_5":14363,"_27402":119971,"_2946":120394},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3462":71461,"_30116":71292,"_20912":120396,"_5":14363,"_27402":119971,"_2946":120397},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3462":71462,"_30116":71292,"_20912":120399,"_5":14363,"_27402":119971,"_2946":120400},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3462":71463,"_30116":71292,"_20912":120402,"_5":14363,"_27402":119971,"_2946":120403},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3462":71464,"_30116":71292,"_20912":120405,"_5":14363,"_27402":119971,"_2946":120406},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3462":71465,"_30116":71292,"_20912":120408,"_5":14363,"_27402":119974,"_2946":120409},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3462":71466,"_30116":71292,"_20912":120411,"_5":14363,"_27402":119977,"_2946":120412},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3462":71467,"_30116":71292,"_20912":120414,"_5":14363,"_27402":119977,"_2946":120415},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3462":71468,"_30116":71292,"_20912":120417,"_5":14363,"_27402":119981,"_2946":120418},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3462":71469,"_30116":71292,"_20912":120420,"_5":14363,"_27402":119985,"_2946":120421},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3462":71470,"_30116":71292,"_20912":120423,"_5":14363,"_27402":119985,"_2946":120424},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3462":71471,"_30116":71292,"_20912":120426,"_5":14363,"_27402":119985,"_2946":120427},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3462":71472,"_30116":71292,"_20912":120429,"_5":14363,"_27402":119985,"_2946":120430},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3462":71473,"_30116":71292,"_20912":120432,"_5":14363,"_27402":119985,"_2946":120433},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3462":71474,"_30116":71292,"_20912":120435,"_5":14363,"_27402":119985,"_2946":120436},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3462":71475,"_30116":71292,"_20912":120438,"_5":14363,"_27402":119989,"_2946":120439},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3462":71476,"_30116":71292,"_20912":120441,"_5":14363,"_27402":119989,"_2946":120442},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3462":71477,"_30116":71292,"_20912":120444,"_5":14363,"_27402":119989,"_2946":120445},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3462":71478,"_30116":71292,"_20912":120447,"_5":14363,"_27402":119989,"_2946":120448},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3462":71479,"_30116":71292,"_20912":120450,"_5":14363,"_27402":119989,"_2946":120451},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3462":71480,"_30116":71292,"_20912":120453,"_5":14363,"_27402":119993,"_2946":120454},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3462":71481,"_30116":71292,"_20912":120456,"_5":14363,"_27402":119993,"_2946":120355},[],{"_3462":71482,"_30116":71292,"_20912":120458,"_5":14363,"_27402":119993,"_2946":120358},[],{"_3462":71483,"_30116":71292,"_20912":120460,"_5":14363,"_27402":119993,"_2946":120461},[],"`SinConfigurar` → `None` / `Auto`",{"_3462":71484,"_30116":71292,"_20912":120463,"_5":14363,"_27402":119993,"_2946":120464},[],"ninguna (solo configuración)",{"_3462":71485,"_30116":71292,"_20912":120466,"_5":14363,"_27402":119993,"_2946":53690},[],{"_3462":71486,"_30116":71292,"_20912":120468,"_5":14363,"_27402":119993,"_2946":120464},[],{"_3462":71487,"_30116":71292,"_20912":120470,"_5":14363,"_27402":119993,"_2946":120471},[],"Cualquiera → `Jitp`",{"_3462":71488,"_30116":71292,"_20912":120473,"_5":14363,"_27402":119993,"_2946":120474},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3462":71489,"_30116":71292,"_20912":120476,"_5":14363,"_27402":119993,"_2946":53701},[],{"_3462":71490,"_30116":71292,"_20912":120478,"_5":14363,"_27402":119993,"_2946":120479},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3462":71491,"_30116":71292,"_20912":120481,"_5":14363,"_27402":119997,"_2946":120482},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3462":71492,"_30116":71292,"_20912":120484,"_5":14363,"_27402":119997,"_2946":120485},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3462":71493,"_30116":71292,"_20912":120487,"_5":14363,"_27402":119997,"_2946":120488},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3462":71494,"_30116":71292,"_20912":120490,"_5":14363,"_27402":120001,"_2946":120491},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3462":71495,"_30116":71292,"_20912":120493,"_5":14363,"_27402":120001,"_2946":120355},[],{"_3462":71496,"_30116":71292,"_20912":120495,"_5":14363,"_27402":120001,"_2946":120358},[],{"_3462":71497,"_30116":71292,"_20912":120497,"_5":14363,"_27402":120001,"_2946":120498},[],"`Ausente` → `Aprovisionado`",{"_3462":71498,"_30116":71292,"_20912":120500,"_5":14363,"_27402":120001,"_2946":120501},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3462":71499,"_30116":71292,"_20912":120503,"_5":14363,"_27402":120001,"_2946":120504},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3462":71500,"_30116":71292,"_20912":120506,"_5":14363,"_27402":120001,"_2946":120507},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3462":71501,"_30116":71292,"_20912":120509,"_5":14363,"_27402":120001,"_2946":120510},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3462":71502,"_30116":71292,"_20912":120512,"_5":14363,"_27402":120005,"_2946":120513},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3462":71503,"_30116":71292,"_20912":120515,"_5":14363,"_27402":120005,"_2946":120516},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3462":71504,"_30116":71292,"_20912":120518,"_5":14363,"_27402":120005,"_2946":120519},[],"Para que el flujo JITP funcione correctamente:",{"_3462":71505,"_30116":71292,"_20912":120521,"_5":14363,"_27402":120005,"_2946":120522},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3462":71506,"_30116":71292,"_20912":120524,"_5":14363,"_27402":120005,"_2946":120525},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3462":71507,"_30116":71292,"_20912":120527,"_5":14363,"_27402":120005,"_2946":120528},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3462":71508,"_30116":71292,"_20912":120530,"_5":14363,"_27402":120005,"_2946":120531},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3462":71509,"_30116":71292,"_20912":120533,"_5":14363,"_27402":120009,"_2946":120534},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3462":71510,"_30116":71292,"_20912":120536,"_5":14363,"_27402":120009,"_2946":120537},[],"Estado en Lamassu",{"_3462":71511,"_30116":71292,"_20912":120539,"_5":14363,"_27402":120009,"_2946":120540},[],"Razón de revocación",{"_3462":71512,"_30116":71292,"_20912":120542,"_5":14363,"_27402":120009,"_2946":120543},[],"Estado en AWS IoT Core",{"_3462":71513,"_30116":71292,"_20912":120545,"_5":14363,"_27402":120009,"_2946":53771},[],{"_3462":71514,"_30116":71292,"_20912":120547,"_5":14363,"_27402":120009,"_2946":120548},[],"Ninguna",{"_3462":71515,"_30116":71292,"_20912":120550,"_5":14363,"_27402":120009,"_2946":53777},[],{"_3462":71516,"_30116":71292,"_20912":120552,"_5":14363,"_27402":120009,"_2946":53780},[],{"_3462":71517,"_30116":71292,"_20912":120554,"_5":14363,"_27402":120009,"_2946":53783},[],{"_3462":71518,"_30116":71292,"_20912":120556,"_5":14363,"_27402":120009,"_2946":53786},[],{"_3462":71519,"_30116":71292,"_20912":120558,"_5":14363,"_27402":120009,"_2946":53780},[],{"_3462":71520,"_30116":71292,"_20912":120560,"_5":14363,"_27402":120009,"_2946":120561},[],"Cualquier otra razón",{"_3462":71521,"_30116":71292,"_20912":120563,"_5":14363,"_27402":120009,"_2946":53794},[],{"_3462":71522,"_30116":71292,"_20912":120565,"_5":14363,"_27402":120009,"_2946":120566},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3462":71523,"_30116":71292,"_20912":120568,"_5":14363,"_27402":120013,"_2946":120569},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3462":71524,"_30116":71292,"_20912":120571,"_5":14363,"_27402":120013,"_2946":120355},[],{"_3462":71525,"_30116":71292,"_20912":120573,"_5":14363,"_27402":120013,"_2946":120358},[],{"_3462":71526,"_30116":71292,"_20912":120575,"_5":14363,"_27402":120013,"_2946":120576},[],"`NoSincronizado` → `Active`",{"_3462":71527,"_30116":71292,"_20912":120578,"_5":14363,"_27402":120013,"_2946":53286},[],{"_3462":71528,"_30116":71292,"_20912":120580,"_5":14363,"_27402":120013,"_2946":53812},[],{"_3462":71529,"_30116":71292,"_20912":120582,"_5":14363,"_27402":120013,"_2946":120583},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3462":71530,"_30116":71292,"_20912":120585,"_5":14363,"_27402":120013,"_2946":53818},[],{"_3462":71531,"_30116":71292,"_20912":120587,"_5":14363,"_27402":120013,"_2946":120583},[],{"_3462":71532,"_30116":71292,"_20912":120589,"_5":14363,"_27402":120013,"_2946":53823},[],{"_3462":71533,"_30116":71292,"_20912":120591,"_5":14363,"_27402":120013,"_2946":53286},[],{"_3462":71534,"_30116":71292,"_20912":120593,"_5":14363,"_27402":120013,"_2946":53828},[],{"_3462":71535,"_30116":71292,"_20912":120595,"_5":14363,"_27402":120013,"_2946":120596},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3462":71536,"_30116":71292,"_20912":120598,"_5":14363,"_27402":120017,"_2946":120599},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3462":71537,"_30116":71292,"_20912":120601,"_5":14363,"_27402":120017,"_2946":120602},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3462":71538,"_30116":71292,"_20912":120604,"_5":14363,"_27402":120017,"_2946":120605},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3462":71539,"_30116":71292,"_20912":120607,"_5":14363,"_27402":120021,"_2946":120608},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3462":71540,"_30116":71292,"_20912":120610,"_5":14363,"_27402":120021,"_2946":120611},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3462":71541,"_30116":71292,"_20912":120613,"_5":14363,"_27402":120025,"_2946":120614},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3462":71542,"_30116":71292,"_20912":120616,"_5":14363,"_27402":120025,"_2946":120617},[],"Existen dos tipos de acciones:",{"_3462":71543,"_30116":71292,"_20912":120619,"_5":14363,"_27402":120025,"_2946":120620},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3462":71544,"_30116":71292,"_20912":120622,"_5":14363,"_27402":120025,"_2946":120623},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3462":71545,"_30116":71292,"_20912":120625,"_5":14363,"_27402":120025,"_2946":120626},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3462":71546,"_30116":71292,"_20912":120628,"_5":14363,"_27402":120029,"_2946":120629},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3462":71547,"_30116":71292,"_20912":120631,"_5":14363,"_27402":120029,"_2946":120632},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3462":71548,"_30116":71292,"_20912":120634,"_5":14363,"_27402":120029,"_2946":120635},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3462":71549,"_30116":71292,"_20912":120637,"_5":14363,"_27402":120033,"_2946":120638},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3462":71550,"_30116":71292,"_20912":120640,"_5":14363,"_27402":120033,"_2946":120641},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3462":71551,"_30116":71292,"_20912":120643,"_5":14363,"_27402":120033,"_2946":120644},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3462":71552,"_30116":71292,"_20912":120646,"_5":14363,"_27402":120033,"_2946":120647},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3462":71553,"_30116":71292,"_20912":120649,"_5":14363,"_27402":120033,"_2946":120650},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3462":71554,"_30116":71292,"_20912":120652,"_5":14363,"_27402":120033,"_2946":120653},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3462":71555,"_30116":71292,"_20912":120655,"_5":14363,"_27402":120033,"_2946":120656},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3462":71556,"_30116":71292,"_20912":120658,"_5":14363,"_27402":120033,"_2946":120659},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3462":71557,"_30116":71292,"_20912":120661,"_5":14363,"_27402":120033,"_2946":120662},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3462":71558,"_30116":71292,"_20912":120664,"_5":14363,"_27402":120033,"_2946":120665},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3462":71559,"_30116":71292,"_20912":120667,"_5":14363,"_27402":120033,"_2946":120668},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3462":71560,"_30116":71292,"_20912":120670,"_5":14363,"_27402":120033,"_2946":120671},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3462":71561,"_30116":71292,"_20912":120673,"_5":14363,"_27402":120033,"_2946":120674},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3462":71562,"_30116":71292,"_20912":120676,"_5":14363,"_27402":120033,"_2946":120677},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3462":71563,"_30116":71292,"_20912":120679,"_5":14363,"_27402":120033,"_2946":120680},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3462":71564,"_30116":71292,"_20912":120682,"_5":14363,"_27402":120033,"_2946":120683},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3462":71565,"_30116":71292,"_20912":120685,"_5":14363,"_27402":120033,"_2946":120686},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3462":71566,"_30116":71292,"_20912":120688,"_5":14363,"_27402":120033,"_2946":120689},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3462":71567,"_30116":71292,"_20912":120691,"_5":14363,"_27402":120033,"_2946":120692},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3462":71568,"_30116":71292,"_20912":120694,"_5":14363,"_27402":120033,"_2946":120695},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3462":71569,"_30116":71292,"_20912":120697,"_5":14363,"_27402":120033,"_2946":120698},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3462":71570,"_30116":71292,"_20912":120700,"_5":14363,"_27402":120033,"_2946":120701},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3462":71571,"_30116":71292,"_20912":120703,"_5":14363,"_27402":120033,"_2946":120704},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3462":71572,"_30116":71292,"_20912":120706,"_5":14363,"_27402":120033,"_2946":120707},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3462":71573,"_30116":71573,"_5":14715,"_2946":51649,"_30468":120709,"_20912":120710,"_27402":71573},[49167,117513,51649],[],{"_3462":71574,"_30116":71573,"_20912":120712,"_5":14363,"_27402":71573,"_2946":120713},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3462":71575,"_30116":71573,"_5":30465,"_20912":120715,"_27402":120716,"_2946":120717},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3462":71576,"_30116":71573,"_5":30465,"_20912":120719,"_27402":120720,"_2946":118525},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3462":71577,"_30116":71573,"_5":30465,"_20912":120722,"_27402":120723,"_2946":118700},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3462":71578,"_30116":71573,"_5":30465,"_20912":120725,"_27402":120726,"_2946":119932},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/overview#integraciones",{"_3462":71579,"_30116":71573,"_5":30465,"_20912":120728,"_27402":120729,"_2946":120730},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3462":71580,"_30116":71573,"_20912":120732,"_5":14363,"_27402":71573,"_2946":120733},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3462":71581,"_30116":71573,"_20912":120735,"_5":14363,"_27402":120716,"_2946":120736},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3462":71582,"_30116":71573,"_20912":120738,"_5":14363,"_27402":120716,"_2946":120739},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3462":71583,"_30116":71573,"_20912":120741,"_5":14363,"_27402":120720,"_2946":120742},[],"Recurso",{"_3462":71584,"_30116":71573,"_20912":120744,"_5":14363,"_27402":120720,"_2946":120745},[],"Qué representa",{"_3462":71585,"_30116":71573,"_20912":120747,"_5":14363,"_27402":120720,"_2946":120748},[],"**Dispositivo**",{"_3462":71586,"_30116":71573,"_20912":120750,"_5":14363,"_27402":120720,"_2946":120751},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3462":71587,"_30116":71573,"_20912":120753,"_5":14363,"_27402":120720,"_2946":120754},[],"**Identidad**",{"_3462":71588,"_30116":71573,"_20912":120756,"_5":14363,"_27402":120720,"_2946":120757},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3462":71589,"_30116":71573,"_20912":120759,"_5":14363,"_27402":120720,"_2946":53995},[],{"_3462":71590,"_30116":71573,"_20912":120761,"_5":14363,"_27402":120720,"_2946":120762},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3462":71591,"_30116":71573,"_20912":120764,"_5":14363,"_27402":120720,"_2946":120765},[],"**Flota**",{"_3462":71592,"_30116":71573,"_20912":120767,"_5":14363,"_27402":120720,"_2946":120768},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3462":71593,"_30116":71573,"_20912":120770,"_5":14363,"_27402":120720,"_2946":120771},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3462":71594,"_30116":71573,"_20912":120773,"_5":14363,"_27402":120720,"_2946":120774},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3462":71595,"_30116":71573,"_20912":120776,"_5":14363,"_27402":120723,"_2946":120777},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3462":71596,"_30116":71573,"_20912":120779,"_5":14363,"_27402":120723,"_2946":120780},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3462":71597,"_30116":71573,"_20912":120782,"_5":14363,"_27402":120723,"_2946":120783},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3462":71598,"_30116":71573,"_20912":120785,"_5":14363,"_27402":120723,"_2946":120786},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3462":71599,"_30116":71573,"_20912":120788,"_5":14363,"_27402":120723,"_2946":120789},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3462":71600,"_30116":71573,"_20912":120791,"_5":14363,"_27402":120723,"_2946":120792},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3462":71601,"_30116":71573,"_20912":120794,"_5":14363,"_27402":120723,"_2946":120795},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3462":71602,"_30116":71573,"_20912":120797,"_5":14363,"_27402":120723,"_2946":120798},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3462":71603,"_30116":71573,"_20912":120800,"_5":14363,"_27402":120726,"_2946":120801},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3462":71604,"_30116":71573,"_20912":120803,"_5":14363,"_27402":120726,"_2946":120804},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3462":71605,"_30116":71573,"_20912":120806,"_5":14363,"_27402":120729,"_2946":120807},[],"Participante",{"_3462":71606,"_30116":71573,"_20912":120809,"_5":14363,"_27402":120729,"_2946":120810},[],"Responsabilidad",{"_3462":71607,"_30116":71573,"_20912":120812,"_5":14363,"_27402":120729,"_2946":120813},[],"Administrador PKI",{"_3462":71608,"_30116":71573,"_20912":120815,"_5":14363,"_27402":120729,"_2946":120816},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3462":71609,"_30116":71573,"_20912":120818,"_5":14363,"_27402":120729,"_2946":120819},[],"Administrador del aprovisionamiento",{"_3462":71610,"_30116":71573,"_20912":120821,"_5":14363,"_27402":120729,"_2946":120822},[],"DMS, admisión, autenticación por operación e inventario.",{"_3462":71611,"_30116":71573,"_20912":120824,"_5":14363,"_27402":120729,"_2946":120825},[],"Integrador del dispositivo",{"_3462":71612,"_30116":71573,"_20912":120827,"_5":14363,"_27402":120729,"_2946":120828},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3462":71613,"_30116":71573,"_20912":120830,"_5":14363,"_27402":120729,"_2946":120831},[],"Integrador del consumidor",{"_3462":71614,"_30116":71573,"_20912":120833,"_5":14363,"_27402":120729,"_2946":120834},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3462":71615,"_30116":71573,"_20912":120836,"_5":14363,"_27402":120729,"_2946":120837},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3462":71616,"_30116":71616,"_5":14715,"_2946":120839,"_30468":120840,"_20912":120842,"_27402":71616},"Enrola y conecta tu primer dispositivo",[49167,117513,51649,120841],"Primeros pasos",[],{"_3462":71617,"_30116":71616,"_20912":120844,"_5":14363,"_27402":71616,"_2946":120845},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3462":71618,"_30116":71616,"_5":30465,"_20912":120847,"_27402":120848,"_2946":116091},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3462":71619,"_30116":71616,"_5":30465,"_20912":120850,"_27402":120851,"_2946":120852},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3462":71620,"_30116":71616,"_5":30465,"_20912":120854,"_27402":120855,"_2946":120856},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3462":71621,"_30116":71616,"_5":30465,"_20912":120858,"_27402":120859,"_2946":120860},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3462":71622,"_30116":71616,"_5":30465,"_20912":120862,"_27402":120863,"_2946":120864},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3462":71623,"_30116":71616,"_5":30465,"_20912":120866,"_27402":120867,"_2946":120868},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3462":71624,"_30116":71616,"_5":30465,"_20912":120870,"_27402":120871,"_2946":120872},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3462":71625,"_30116":71616,"_5":30465,"_20912":120874,"_27402":120875,"_2946":120876},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3462":71626,"_30116":71616,"_20912":120878,"_5":14363,"_27402":71616,"_2946":120879},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3462":71627,"_30116":71616,"_20912":120881,"_5":14363,"_27402":120848,"_2946":120882},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3462":71628,"_30116":71616,"_20912":120884,"_5":14363,"_27402":120848,"_2946":120885},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3462":71629,"_30116":71616,"_20912":120887,"_5":14363,"_27402":120848,"_2946":120888},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3462":71630,"_30116":71616,"_20912":120890,"_5":14363,"_27402":120848,"_2946":120891},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3462":71631,"_30116":71616,"_20912":120893,"_5":14363,"_27402":120848,"_2946":120894},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3462":71632,"_30116":71616,"_20912":120896,"_5":14363,"_27402":120851,"_2946":120897},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3462":71633,"_30116":71616,"_20912":120899,"_5":14363,"_27402":120851,"_2946":120900},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3462":71634,"_30116":71616,"_20912":120902,"_5":14363,"_27402":120855,"_2946":120903},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3462":71635,"_30116":71616,"_20912":120905,"_5":14363,"_27402":120855,"_2946":120906},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3462":71636,"_30116":71616,"_20912":120908,"_5":14363,"_27402":120855,"_2946":120909},[],"Ajuste",{"_3462":71637,"_30116":71616,"_20912":120911,"_5":14363,"_27402":120855,"_2946":120912},[],"Valor de evaluación",{"_3462":71638,"_30116":71616,"_20912":120914,"_5":14363,"_27402":120855,"_2946":54151},[],{"_3462":71639,"_30116":71616,"_20912":120916,"_5":14363,"_27402":120855,"_2946":120917},[],"Raíz emisora de `device-root.pem`.",{"_3462":71640,"_30116":71616,"_20912":120919,"_5":14363,"_27402":120855,"_2946":118828},[],{"_3462":71641,"_30116":71616,"_20912":120921,"_5":14363,"_27402":120855,"_2946":120922},[],"Perfil final de 1 hora que acabas de preparar.",{"_3462":71642,"_30116":71616,"_20912":120924,"_5":14363,"_27402":120855,"_2946":54162},[],{"_3462":71643,"_30116":71616,"_20912":120926,"_5":14363,"_27402":120855,"_2946":54165},[],{"_3462":71644,"_30116":71616,"_20912":120928,"_5":14363,"_27402":120855,"_2946":54168},[],{"_3462":71645,"_30116":71616,"_20912":120930,"_5":14363,"_27402":120855,"_2946":120931},[],"Habilitado.",{"_3462":71646,"_30116":71616,"_20912":120933,"_5":14363,"_27402":120855,"_2946":54174},[],{"_3462":71647,"_30116":71616,"_20912":120935,"_5":14363,"_27402":120855,"_2946":120936},[],"Deshabilitado; el ID debe ser nuevo.",{"_3462":71648,"_30116":71616,"_20912":120938,"_5":14363,"_27402":120855,"_2946":120939},[],"Autenticación inicial",{"_3462":71649,"_30116":71616,"_20912":120941,"_5":14363,"_27402":120855,"_2946":120942},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3462":71650,"_30116":71616,"_20912":120944,"_5":14363,"_27402":120855,"_2946":120945},[],"Autenticación de renovación",{"_3462":71651,"_30116":71616,"_20912":120947,"_5":14363,"_27402":120855,"_2946":120948},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3462":71652,"_30116":71616,"_20912":120950,"_5":14363,"_27402":120855,"_2946":54192},[],{"_3462":71653,"_30116":71616,"_20912":120952,"_5":14363,"_27402":120855,"_2946":120953},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3462":71654,"_30116":71616,"_20912":120955,"_5":14363,"_27402":120855,"_2946":54198},[],{"_3462":71655,"_30116":71616,"_20912":120957,"_5":14363,"_27402":120855,"_2946":120958},[],"1 hora.",{"_3462":71656,"_30116":71616,"_20912":120960,"_5":14363,"_27402":120855,"_2946":54204},[],{"_3462":71657,"_30116":71616,"_20912":120962,"_5":14363,"_27402":120855,"_2946":120963},[],"30 minutos / 10 minutos.",{"_3462":71658,"_30116":71616,"_20912":120965,"_5":14363,"_27402":120855,"_2946":54210},[],{"_3462":71659,"_30116":71616,"_20912":120967,"_5":14363,"_27402":120855,"_2946":120968},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3462":71660,"_30116":71616,"_20912":120970,"_5":14363,"_27402":120855,"_2946":51968},[],{"_3462":71661,"_30116":71616,"_20912":120972,"_5":14363,"_27402":120855,"_2946":120973},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3462":71662,"_30116":71616,"_20912":120975,"_5":14363,"_27402":120855,"_2946":54221},[],{"_3462":71663,"_30116":71616,"_20912":120977,"_5":14363,"_27402":120855,"_2946":120978},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3462":71664,"_30116":71616,"_20912":120980,"_5":14363,"_27402":120855,"_2946":120981},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3462":71665,"_30116":71616,"_20912":120983,"_5":14363,"_27402":120859,"_2946":120984},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3462":71666,"_30116":71616,"_20912":120986,"_5":14363,"_27402":120859,"_2946":120987},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3462":71667,"_30116":71616,"_20912":120989,"_5":14363,"_27402":120863,"_2946":120990},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3462":71668,"_30116":71616,"_20912":120992,"_5":14363,"_27402":120863,"_2946":120993},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3462":71669,"_30116":71616,"_20912":120995,"_5":14363,"_27402":120863,"_2946":120996},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3462":71670,"_30116":71616,"_20912":120998,"_5":14363,"_27402":120867,"_2946":120999},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3462":71671,"_30116":71616,"_20912":121001,"_5":14363,"_27402":120867,"_2946":121002},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3462":71672,"_30116":71616,"_20912":121004,"_5":14363,"_27402":120871,"_2946":121005},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3462":71673,"_30116":71616,"_20912":121007,"_5":14363,"_27402":120871,"_2946":121008},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3462":71674,"_30116":71616,"_20912":121010,"_5":14363,"_27402":120871,"_2946":121011},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3462":71675,"_30116":71616,"_20912":121013,"_5":14363,"_27402":120871,"_2946":121014},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3462":71676,"_30116":71616,"_20912":121016,"_5":14363,"_27402":120871,"_2946":121017},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3462":71677,"_30116":71616,"_20912":121019,"_5":14363,"_27402":120875,"_2946":121020},[],"Comprobación",{"_3462":71678,"_30116":71616,"_20912":121022,"_5":14363,"_27402":120875,"_2946":121023},[],"Resultado esperado",{"_3462":71679,"_30116":71616,"_20912":121025,"_5":14363,"_27402":120875,"_2946":121026},[],"Registro",{"_3462":71680,"_30116":71616,"_20912":121028,"_5":14363,"_27402":120875,"_2946":121029},[],"ID creado automáticamente y DMS correcto.",{"_3462":71681,"_30116":71616,"_20912":121031,"_5":14363,"_27402":120875,"_2946":120316},[],{"_3462":71682,"_30116":71616,"_20912":121033,"_5":14363,"_27402":120875,"_2946":121034},[],"CN, perfil, serie y clave verificados.",{"_3462":71683,"_30116":71616,"_20912":121036,"_5":14363,"_27402":120875,"_2946":121037},[],"Inventario",{"_3462":71684,"_30116":71616,"_20912":121039,"_5":14363,"_27402":120875,"_2946":121040},[],"Serie recibida visible como identidad actual y en el historial.",{"_3462":71685,"_30116":71616,"_20912":121042,"_5":14363,"_27402":120875,"_2946":121043},[],"Consumidor",{"_3462":71686,"_30116":71616,"_20912":121045,"_5":14363,"_27402":120875,"_2946":121046},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3462":71687,"_30116":71616,"_20912":121048,"_5":14363,"_27402":120875,"_2946":121049},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3462":71688,"_30116":71616,"_20912":121051,"_5":14363,"_27402":120875,"_2946":121052},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3462":71689,"_30116":71689,"_5":14715,"_2946":118542,"_30468":121054,"_20912":121055,"_27402":71689},[49167,117513,51649,120841],[],{"_3462":71690,"_30116":71689,"_20912":121057,"_5":14363,"_27402":71689,"_2946":121058},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3462":71691,"_30116":71689,"_5":30465,"_20912":121060,"_27402":121061,"_2946":116091},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3462":71692,"_30116":71689,"_5":30465,"_20912":121063,"_27402":121064,"_2946":121065},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3462":71693,"_30116":71689,"_5":30465,"_20912":121067,"_27402":121068,"_2946":121069},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3462":71694,"_30116":71689,"_5":30465,"_20912":121071,"_27402":121072,"_2946":121073},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3462":71695,"_30116":71689,"_5":30465,"_20912":121075,"_27402":121076,"_2946":121077},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3462":71696,"_30116":71689,"_5":30465,"_20912":121079,"_27402":121080,"_2946":121081},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3462":71697,"_30116":71689,"_5":30465,"_20912":121083,"_27402":121084,"_2946":121023},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3462":71698,"_30116":71689,"_5":30465,"_20912":121086,"_27402":121087,"_2946":121088},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3462":71699,"_30116":71689,"_5":30465,"_20912":121090,"_27402":121091,"_2946":121092},[],"/docs/pr-preview/pr-64/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3462":71700,"_30116":71689,"_20912":121094,"_5":14363,"_27402":71689,"_2946":121095},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3462":71701,"_30116":71689,"_20912":121097,"_5":14363,"_27402":71689,"_2946":121098},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3462":71702,"_30116":71689,"_20912":121100,"_5":14363,"_27402":121061,"_2946":121101},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3462":71703,"_30116":71689,"_20912":121103,"_5":14363,"_27402":121061,"_2946":121104},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3462":71704,"_30116":71689,"_20912":121106,"_5":14363,"_27402":121061,"_2946":121107},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3462":71705,"_30116":71689,"_20912":121109,"_5":14363,"_27402":121061,"_2946":121110},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3462":71706,"_30116":71689,"_20912":121112,"_5":14363,"_27402":121064,"_2946":121113},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3462":71707,"_30116":71689,"_20912":121115,"_5":14363,"_27402":121064,"_2946":121116},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3462":71708,"_30116":71689,"_20912":121118,"_5":14363,"_27402":121064,"_2946":121119},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3462":71709,"_30116":71689,"_20912":121121,"_5":14363,"_27402":121064,"_2946":121122},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3462":71710,"_30116":71689,"_20912":121124,"_5":14363,"_27402":121064,"_2946":121125},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3462":71711,"_30116":71689,"_20912":121127,"_5":14363,"_27402":121064,"_2946":121128},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3462":71712,"_30116":71689,"_20912":121130,"_5":14363,"_27402":121064,"_2946":121131},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3462":71713,"_30116":71689,"_20912":121133,"_5":14363,"_27402":121064,"_2946":121134},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3462":71714,"_30116":71689,"_20912":121136,"_5":14363,"_27402":121068,"_2946":121137},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3462":71715,"_30116":71689,"_20912":121139,"_5":14363,"_27402":121068,"_2946":54386},[],{"_3462":71716,"_30116":71689,"_20912":121141,"_5":14363,"_27402":121068,"_2946":121142},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3462":71717,"_30116":71689,"_20912":121144,"_5":14363,"_27402":121068,"_2946":121145},[],"**Icon** y **Tags**: clasificación opcional.",{"_3462":71718,"_30116":71689,"_20912":121147,"_5":14363,"_27402":121068,"_2946":121148},[],"Confirma el registro.",{"_3462":71719,"_30116":71689,"_20912":121150,"_5":14363,"_27402":121072,"_2946":121151},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3462":71720,"_30116":71689,"_20912":121153,"_5":14363,"_27402":121072,"_2946":121154},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3462":71721,"_30116":71689,"_20912":121156,"_5":14363,"_27402":121076,"_2946":121157},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3462":71722,"_30116":71689,"_20912":121159,"_5":14363,"_27402":121076,"_2946":121160},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3462":71723,"_30116":71689,"_20912":121162,"_5":14363,"_27402":121080,"_2946":121163},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3462":71724,"_30116":71689,"_20912":121165,"_5":14363,"_27402":121080,"_2946":121166},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3462":71725,"_30116":71689,"_20912":121168,"_5":14363,"_27402":121084,"_2946":121020},[],{"_3462":71726,"_30116":71689,"_20912":121170,"_5":14363,"_27402":121084,"_2946":121171},[],"Resultado",{"_3462":71727,"_30116":71689,"_20912":121173,"_5":14363,"_27402":121084,"_2946":120302},[],{"_3462":71728,"_30116":71689,"_20912":121175,"_5":14363,"_27402":121084,"_2946":121176},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3462":71729,"_30116":71689,"_20912":121178,"_5":14363,"_27402":121084,"_2946":121179},[],"Identidad actual",{"_3462":71730,"_30116":71689,"_20912":121181,"_5":14363,"_27402":121084,"_2946":121182},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3462":71731,"_30116":71689,"_20912":121184,"_5":14363,"_27402":121084,"_2946":121185},[],"Historial",{"_3462":71732,"_30116":71689,"_20912":121187,"_5":14363,"_27402":121084,"_2946":121188},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3462":71733,"_30116":71689,"_20912":121190,"_5":14363,"_27402":121084,"_2946":121191},[],"Clave y certificado",{"_3462":71734,"_30116":71689,"_20912":121193,"_5":14363,"_27402":121084,"_2946":121194},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3462":71735,"_30116":71689,"_20912":121196,"_5":14363,"_27402":121087,"_2946":121197},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3462":71736,"_30116":71689,"_20912":121199,"_5":14363,"_27402":121087,"_2946":121200},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3462":71737,"_30116":71689,"_20912":121202,"_5":14363,"_27402":121087,"_2946":121203},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3462":71738,"_30116":71689,"_20912":121205,"_5":14363,"_27402":121087,"_2946":121206},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3462":71739,"_30116":71689,"_20912":121208,"_5":14363,"_27402":121091,"_2946":121209},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3462":71740,"_30116":71689,"_20912":121211,"_5":14363,"_27402":121091,"_2946":121212},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3462":71741,"_30116":71689,"_20912":121214,"_5":14363,"_27402":121091,"_2946":121215},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3462":71742,"_30116":71742,"_5":14715,"_2946":121217,"_30468":121218,"_20912":121219,"_27402":71742},"Plataforma Lamassu IoT",[49167,117513],[],{"_3462":71743,"_30116":71742,"_20912":121221,"_5":14363,"_27402":71742,"_2946":121222},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3462":71744,"_30116":71742,"_5":30465,"_20912":121224,"_27402":121225,"_2946":120717},[],"/docs/pr-preview/pr-64/es/platform/overview#empieza-aquí",{"_3462":71745,"_30116":71742,"_5":30465,"_20912":121227,"_27402":121228,"_2946":121229},[],"/docs/pr-preview/pr-64/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3462":71746,"_30116":71742,"_5":30465,"_20912":121231,"_27402":121232,"_2946":121233},[],"/docs/pr-preview/pr-64/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3462":71747,"_30116":71742,"_5":30465,"_20912":121235,"_27402":121236,"_2946":121237},[],"/docs/pr-preview/pr-64/es/platform/overview#capacidades-principales","Capacidades principales",{"_3462":71748,"_30116":71742,"_5":30465,"_20912":121239,"_27402":121240,"_2946":121241},[],"/docs/pr-preview/pr-64/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3462":71749,"_30116":71742,"_5":30465,"_20912":121243,"_27402":121244,"_2946":121245},[],"/docs/pr-preview/pr-64/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3462":71750,"_30116":71742,"_5":30465,"_20912":121247,"_27402":121248,"_2946":121249},[],"/docs/pr-preview/pr-64/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3462":71751,"_30116":71742,"_5":30465,"_20912":121251,"_27402":121252,"_2946":121253},[],"/docs/pr-preview/pr-64/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3462":71752,"_30116":71742,"_5":30465,"_20912":121255,"_27402":121256,"_2946":121257},[],"/docs/pr-preview/pr-64/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3462":71753,"_30116":71742,"_5":30465,"_20912":121259,"_27402":121260,"_2946":121261},[],"/docs/pr-preview/pr-64/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3462":71754,"_30116":71742,"_5":30465,"_20912":121263,"_27402":121264,"_2946":121265},[],"/docs/pr-preview/pr-64/es/platform/overview#referencia-operativa","Referencia operativa",{"_3462":71755,"_30116":71742,"_20912":121267,"_5":14363,"_27402":71742,"_2946":121268},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3462":71756,"_30116":71742,"_20912":121270,"_5":14363,"_27402":121225,"_2946":121271},[],"Elige el resultado que necesitas obtener:",{"_3462":71757,"_30116":71742,"_20912":121273,"_5":14363,"_27402":121225,"_2946":121274},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3462":71758,"_30116":71742,"_20912":121276,"_5":14363,"_27402":121225,"_2946":121277},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3462":71759,"_30116":71742,"_20912":121279,"_5":14363,"_27402":121225,"_2946":121280},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3462":71760,"_30116":71742,"_20912":121282,"_5":14363,"_27402":121228,"_2946":121283},[],"Bloque",{"_3462":71761,"_30116":71742,"_20912":121285,"_5":14363,"_27402":121228,"_2946":121286},[],"Qué gestionas",{"_3462":71762,"_30116":71742,"_20912":121288,"_5":14363,"_27402":121228,"_2946":121289},[],"Punto de entrada",{"_3462":71763,"_30116":71742,"_20912":121291,"_5":14363,"_27402":121228,"_2946":54539},[],{"_3462":71764,"_30116":71742,"_20912":121293,"_5":14363,"_27402":121228,"_2946":121294},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3462":71765,"_30116":71742,"_20912":121296,"_5":14363,"_27402":121228,"_2946":121297},[],"Visión general de PKI",{"_3462":71766,"_30116":71742,"_20912":121299,"_5":14363,"_27402":121228,"_2946":54548},[],{"_3462":71767,"_30116":71742,"_20912":121301,"_5":14363,"_27402":121228,"_2946":121302},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3462":71768,"_30116":71742,"_20912":121304,"_5":14363,"_27402":121228,"_2946":121305},[],"Visión general de IoT Fleets",{"_3462":71769,"_30116":71742,"_20912":121307,"_5":14363,"_27402":121228,"_2946":121308},[],"**Administración**",{"_3462":71770,"_30116":71742,"_20912":121310,"_5":14363,"_27402":121228,"_2946":121311},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3462":71771,"_30116":71742,"_20912":121313,"_5":14363,"_27402":121228,"_2946":117511},[],{"_3462":71772,"_30116":71742,"_20912":121315,"_5":14363,"_27402":121228,"_2946":121316},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3462":71773,"_30116":71742,"_20912":121318,"_5":14363,"_27402":121232,"_2946":121319},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3462":71774,"_30116":71742,"_20912":121321,"_5":14363,"_27402":121232,"_2946":121322},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3462":71775,"_30116":71742,"_20912":121324,"_5":14363,"_27402":121232,"_2946":121325},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3462":71776,"_30116":71742,"_20912":121327,"_5":14363,"_27402":121232,"_2946":121328},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3462":71777,"_30116":71742,"_20912":121330,"_5":14363,"_27402":121232,"_2946":121331},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3462":71778,"_30116":71742,"_20912":121333,"_5":14363,"_27402":121232,"_2946":121334},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3462":71779,"_30116":71742,"_20912":121336,"_5":14363,"_27402":121240,"_2946":121337},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3462":71780,"_30116":71742,"_20912":121339,"_5":14363,"_27402":121244,"_2946":121340},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3462":71781,"_30116":71742,"_20912":121342,"_5":14363,"_27402":121248,"_2946":121343},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3462":71782,"_30116":71742,"_20912":121345,"_5":14363,"_27402":121252,"_2946":121346},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3462":71783,"_30116":71742,"_20912":121348,"_5":14363,"_27402":121256,"_2946":121349},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3462":71784,"_30116":71742,"_20912":121351,"_5":14363,"_27402":121260,"_2946":121352},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3462":71785,"_30116":71742,"_20912":121354,"_5":14363,"_27402":121264,"_2946":120810},[],{"_3462":71786,"_30116":71742,"_20912":121356,"_5":14363,"_27402":121264,"_2946":121357},[],"Qué prepara o comprueba",{"_3462":71787,"_30116":71742,"_20912":121359,"_5":14363,"_27402":121264,"_2946":120813},[],{"_3462":71788,"_30116":71742,"_20912":121361,"_5":14363,"_27402":121264,"_2946":121362},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3462":71789,"_30116":71742,"_20912":121364,"_5":14363,"_27402":121264,"_2946":121365},[],"Administrador de la flota",{"_3462":71790,"_30116":71742,"_20912":121367,"_5":14363,"_27402":121264,"_2946":121368},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3462":71791,"_30116":71742,"_20912":121370,"_5":14363,"_27402":121264,"_2946":120825},[],{"_3462":71792,"_30116":71742,"_20912":121372,"_5":14363,"_27402":121264,"_2946":121373},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3462":71793,"_30116":71742,"_20912":121375,"_5":14363,"_27402":121264,"_2946":120831},[],{"_3462":71794,"_30116":71742,"_20912":121377,"_5":14363,"_27402":121264,"_2946":121378},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3462":71795,"_30116":71742,"_20912":121380,"_5":14363,"_27402":121264,"_2946":121381},[],"Operador de infraestructura",{"_3462":71796,"_30116":71742,"_20912":121383,"_5":14363,"_27402":121264,"_2946":121384},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3462":71797,"_30116":71742,"_20912":121386,"_5":14363,"_27402":121264,"_2946":121387},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3462":71798,"_30116":71798,"_5":14715,"_2946":121389,"_30468":121390,"_20912":121392,"_27402":71798},"Jerarquía y rotación de CAs",[49167,117513,54640,121391],"Claves, autoridades y certificados",[],{"_3462":71799,"_30116":71798,"_20912":121394,"_5":14363,"_27402":71798,"_2946":121395},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3462":71800,"_30116":71798,"_5":30465,"_20912":121397,"_27402":121398,"_2946":121399},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3462":71801,"_30116":71798,"_5":30465,"_20912":121401,"_27402":121402,"_2946":121403},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3462":71802,"_30116":71798,"_5":30465,"_20912":121405,"_27402":121406,"_2946":121407},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3462":71803,"_30116":71798,"_5":30465,"_20912":121409,"_27402":121410,"_2946":121411},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3462":71804,"_30116":71798,"_5":30465,"_20912":121413,"_27402":121414,"_2946":121415},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3462":71805,"_30116":71798,"_5":30465,"_20912":121417,"_27402":121418,"_2946":121419},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3462":71806,"_30116":71798,"_5":30465,"_20912":121421,"_27402":121422,"_2946":121423},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3462":71807,"_30116":71798,"_5":30465,"_20912":121425,"_27402":121426,"_2946":121427},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3462":71808,"_30116":71798,"_5":30465,"_20912":121429,"_27402":121430,"_2946":121431},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3462":71809,"_30116":71798,"_5":30465,"_20912":121433,"_27402":121434,"_2946":121435},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3462":71810,"_30116":71798,"_5":30465,"_20912":121437,"_27402":121438,"_2946":121439},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3462":71811,"_30116":71798,"_5":30465,"_20912":121441,"_27402":121442,"_2946":121443},[],"/docs/pr-preview/pr-64/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3462":71812,"_30116":71798,"_20912":121445,"_5":14363,"_27402":71798,"_2946":121446},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3462":71813,"_30116":71798,"_20912":121448,"_5":14363,"_27402":71798,"_2946":121449},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3462":71814,"_30116":71798,"_20912":121451,"_5":14363,"_27402":121398,"_2946":121452},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3462":71815,"_30116":71798,"_20912":121454,"_5":14363,"_27402":121398,"_2946":121455},[],"entorno, como producción y preproducción;",{"_3462":71816,"_30116":71798,"_20912":121457,"_5":14363,"_27402":121398,"_2946":121458},[],"propietario o equipo operador;",{"_3462":71817,"_30116":71798,"_20912":121460,"_5":14363,"_27402":121398,"_2946":121461},[],"familia de dispositivos o proceso de fabricación;",{"_3462":71818,"_30116":71798,"_20912":121463,"_5":14363,"_27402":121398,"_2946":121464},[],"región o requisito regulatorio;",{"_3462":71819,"_30116":71798,"_20912":121466,"_5":14363,"_27402":121398,"_2946":121467},[],"motor criptográfico o política de clave;",{"_3462":71820,"_30116":71798,"_20912":121469,"_5":14363,"_27402":121398,"_2946":121470},[],"ventana de mantenimiento y ritmo de renovación.",{"_3462":71821,"_30116":71798,"_20912":121472,"_5":14363,"_27402":121398,"_2946":121473},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3462":71822,"_30116":71798,"_20912":121475,"_5":14363,"_27402":121398,"_2946":121476},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3462":71823,"_30116":71798,"_20912":121478,"_5":14363,"_27402":121402,"_2946":121479},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3462":71824,"_30116":71798,"_20912":121481,"_5":14363,"_27402":121402,"_2946":121482},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3462":71825,"_30116":71798,"_20912":121484,"_5":14363,"_27402":121402,"_2946":121485},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3462":71826,"_30116":71798,"_20912":121487,"_5":14363,"_27402":121402,"_2946":121488},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3462":71827,"_30116":71798,"_20912":121490,"_5":14363,"_27402":121406,"_2946":121491},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3462":71828,"_30116":71798,"_20912":121493,"_5":14363,"_27402":121406,"_2946":121494},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3462":71829,"_30116":71798,"_20912":121496,"_5":14363,"_27402":121406,"_2946":121497},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3462":71830,"_30116":71798,"_20912":121499,"_5":14363,"_27402":121406,"_2946":121500},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3462":71831,"_30116":71798,"_20912":121502,"_5":14363,"_27402":121414,"_2946":121503},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3462":71832,"_30116":71798,"_20912":121505,"_5":14363,"_27402":121418,"_2946":121506},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3462":71833,"_30116":71798,"_20912":121508,"_5":14363,"_27402":121422,"_2946":121509},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3462":71834,"_30116":71798,"_20912":121511,"_5":14363,"_27402":121426,"_2946":121512},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3462":71835,"_30116":71798,"_20912":121514,"_5":14363,"_27402":121430,"_2946":121515},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3462":71836,"_30116":71798,"_20912":121517,"_5":14363,"_27402":121434,"_2946":121518},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3462":71837,"_30116":71798,"_20912":121520,"_5":14363,"_27402":121438,"_2946":121521},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3462":71838,"_30116":71798,"_20912":121523,"_5":14363,"_27402":121438,"_2946":121524},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3462":71839,"_30116":71798,"_20912":121526,"_5":14363,"_27402":121438,"_2946":121527},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3462":71840,"_30116":71798,"_20912":121529,"_5":14363,"_27402":121438,"_2946":121530},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3462":71841,"_30116":71798,"_20912":121532,"_5":14363,"_27402":121442,"_2946":121533},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3462":71842,"_30116":71798,"_20912":121535,"_5":14363,"_27402":121442,"_2946":121536},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3462":71843,"_30116":71798,"_20912":121538,"_5":14363,"_27402":121442,"_2946":121539},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3462":71844,"_30116":71798,"_20912":121541,"_5":14363,"_27402":121442,"_2946":121542},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3462":71845,"_30116":71798,"_20912":121544,"_5":14363,"_27402":121442,"_2946":121545},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3462":71846,"_30116":71798,"_20912":121547,"_5":14363,"_27402":121442,"_2946":121548},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3462":71847,"_30116":71798,"_20912":121550,"_5":14363,"_27402":121442,"_2946":121551},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3462":71848,"_30116":71848,"_5":14715,"_2946":121553,"_30468":121554,"_20912":121555,"_27402":71848},"Autoridades de certificación",[49167,117513,54640,121391],[],{"_3462":71849,"_30116":71848,"_20912":121557,"_5":14363,"_27402":71848,"_2946":121558},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3462":71850,"_30116":71848,"_5":30465,"_20912":121560,"_27402":121561,"_2946":121562},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3462":71851,"_30116":71848,"_5":30465,"_20912":121564,"_27402":121565,"_2946":121566},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3462":71852,"_30116":71848,"_5":30465,"_20912":121568,"_27402":121569,"_2946":116091},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3462":71853,"_30116":71848,"_5":30465,"_20912":121571,"_27402":121572,"_2946":121573},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3462":71854,"_30116":71848,"_5":30465,"_20912":121575,"_27402":121576,"_2946":121577},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3462":71855,"_30116":71848,"_5":30465,"_20912":121579,"_27402":121580,"_2946":121581},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3462":71856,"_30116":71848,"_5":30465,"_20912":121583,"_27402":121584,"_2946":121585},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3462":71857,"_30116":71848,"_5":30465,"_20912":121587,"_27402":121588,"_2946":121589},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3462":71858,"_30116":71848,"_5":30465,"_20912":121591,"_27402":121592,"_2946":121593},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3462":71859,"_30116":71848,"_5":30465,"_20912":121595,"_27402":121596,"_2946":121597},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3462":71860,"_30116":71848,"_5":30465,"_20912":121599,"_27402":121600,"_2946":121601},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3462":71861,"_30116":71848,"_5":30465,"_20912":121603,"_27402":121604,"_2946":121605},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3462":71862,"_30116":71848,"_5":30465,"_20912":121607,"_27402":121608,"_2946":121609},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3462":71863,"_30116":71848,"_5":30465,"_20912":121611,"_27402":121612,"_2946":121613},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3462":71864,"_30116":71848,"_5":30465,"_20912":121615,"_27402":121616,"_2946":121617},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3462":71865,"_30116":71848,"_5":30465,"_20912":121619,"_27402":121620,"_2946":121621},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3462":71866,"_30116":71848,"_5":30465,"_20912":121623,"_27402":121624,"_2946":121625},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3462":71867,"_30116":71848,"_5":30465,"_20912":121627,"_27402":121628,"_2946":121629},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3462":71868,"_30116":71848,"_5":30465,"_20912":121631,"_27402":121632,"_2946":121633},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3462":71869,"_30116":71848,"_5":30465,"_20912":121635,"_27402":121636,"_2946":121637},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3462":71870,"_30116":71848,"_5":30465,"_20912":121639,"_27402":121640,"_2946":121641},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3462":71871,"_30116":71848,"_5":30465,"_20912":121643,"_27402":121644,"_2946":121645},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3462":71872,"_30116":71848,"_5":30465,"_20912":121647,"_27402":121648,"_2946":121649},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3462":71873,"_30116":71848,"_20912":121651,"_5":14363,"_27402":71848,"_2946":121652},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3462":71874,"_30116":71848,"_20912":121654,"_5":14363,"_27402":71848,"_2946":121655},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3462":71875,"_30116":71848,"_20912":121657,"_5":14363,"_27402":71848,"_2946":121658},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3462":71876,"_30116":71848,"_20912":121660,"_5":14363,"_27402":121561,"_2946":121661},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3462":71877,"_30116":71848,"_20912":121663,"_5":14363,"_27402":121561,"_2946":121664},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3462":71878,"_30116":71848,"_20912":121666,"_5":14363,"_27402":121561,"_2946":121667},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3462":71879,"_30116":71848,"_20912":121669,"_5":14363,"_27402":121561,"_2946":121670},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3462":71880,"_30116":71848,"_20912":121672,"_5":14363,"_27402":121561,"_2946":121673},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3462":71881,"_30116":71848,"_20912":121675,"_5":14363,"_27402":121569,"_2946":121676},[],"Decide si la CA será raíz o intermedia.",{"_3462":71882,"_30116":71848,"_20912":121678,"_5":14363,"_27402":121569,"_2946":121679},[],"Elige el motor que custodiará la clave.",{"_3462":71883,"_30116":71848,"_20912":121681,"_5":14363,"_27402":121569,"_2946":121682},[],"Define una validez superior a la de los certificados que emitirá.",{"_3462":71884,"_30116":71848,"_20912":121684,"_5":14363,"_27402":121569,"_2946":121685},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3462":71885,"_30116":71848,"_20912":121687,"_5":14363,"_27402":121572,"_2946":121688},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3462":71886,"_30116":71848,"_20912":121690,"_5":14363,"_27402":121576,"_2946":121691},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3462":71887,"_30116":71848,"_20912":121693,"_5":14363,"_27402":121576,"_2946":121694},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3462":71888,"_30116":71848,"_20912":121696,"_5":14363,"_27402":121580,"_2946":121697},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3462":71889,"_30116":71848,"_20912":121699,"_5":14363,"_27402":121584,"_2946":121700},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3462":71890,"_30116":71848,"_20912":121702,"_5":14363,"_27402":121584,"_2946":121703},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3462":71891,"_30116":71848,"_20912":121705,"_5":14363,"_27402":121584,"_2946":121706},[],"`ST`: estado o provincia.",{"_3462":71892,"_30116":71848,"_20912":121708,"_5":14363,"_27402":121584,"_2946":121709},[],"`L`: localidad.",{"_3462":71893,"_30116":71848,"_20912":121711,"_5":14363,"_27402":121584,"_2946":121712},[],"`O`: organización.",{"_3462":71894,"_30116":71848,"_20912":121714,"_5":14363,"_27402":121584,"_2946":121715},[],"`OU`: unidad organizativa.",{"_3462":71895,"_30116":71848,"_20912":121717,"_5":14363,"_27402":121584,"_2946":121718},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3462":71896,"_30116":71848,"_20912":121720,"_5":14363,"_27402":121588,"_2946":121721},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3462":71897,"_30116":71848,"_20912":121723,"_5":14363,"_27402":121588,"_2946":121724},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3462":71898,"_30116":71848,"_20912":121726,"_5":14363,"_27402":121592,"_2946":121727},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3462":71899,"_30116":71848,"_20912":121729,"_5":14363,"_27402":121592,"_2946":121730},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3462":71900,"_30116":71848,"_20912":121732,"_5":14363,"_27402":121596,"_2946":121733},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3462":71901,"_30116":71848,"_20912":121735,"_5":14363,"_27402":121596,"_2946":121736},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3462":71902,"_30116":71848,"_20912":121738,"_5":14363,"_27402":121600,"_2946":121739},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3462":71903,"_30116":71848,"_20912":121741,"_5":14363,"_27402":121600,"_2946":121742},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3462":71904,"_30116":71848,"_20912":121744,"_5":14363,"_27402":121600,"_2946":121745},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3462":71905,"_30116":71848,"_20912":121747,"_5":14363,"_27402":121604,"_2946":121748},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3462":71906,"_30116":71848,"_20912":121750,"_5":14363,"_27402":121608,"_2946":121751},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3462":71907,"_30116":71848,"_20912":121753,"_5":14363,"_27402":121608,"_2946":121754},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3462":71908,"_30116":71848,"_20912":121756,"_5":14363,"_27402":121612,"_2946":121757},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3462":71909,"_30116":71848,"_20912":121759,"_5":14363,"_27402":121616,"_2946":121760},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3462":71910,"_30116":71848,"_20912":121762,"_5":14363,"_27402":121616,"_2946":121763},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3462":71911,"_30116":71848,"_20912":121765,"_5":14363,"_27402":121620,"_2946":121766},[],"Abre una CA desde el inventario para consultar:",{"_3462":71912,"_30116":71848,"_20912":121768,"_5":14363,"_27402":121620,"_2946":121769},[],"Estado y periodo de validez.",{"_3462":71913,"_30116":71848,"_20912":121771,"_5":14363,"_27402":121620,"_2946":121772},[],"Certificado y cadena en formato PEM.",{"_3462":71914,"_30116":71848,"_20912":121774,"_5":14363,"_27402":121620,"_2946":121775},[],"Número de certificados activos, expirados y revocados.",{"_3462":71915,"_30116":71848,"_20912":121777,"_5":14363,"_27402":121620,"_2946":121778},[],"Certificados emitidos en **Issued Certificates**.",{"_3462":71916,"_30116":71848,"_20912":121780,"_5":14363,"_27402":121620,"_2946":121781},[],"CRL vinculada a la autoridad.",{"_3462":71917,"_30116":71848,"_20912":121783,"_5":14363,"_27402":121620,"_2946":121784},[],"Metadatos y motor criptográfico asociado.",{"_3462":71918,"_30116":71848,"_20912":121786,"_5":14363,"_27402":121620,"_2946":121787},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3462":71919,"_30116":71848,"_20912":121789,"_5":14363,"_27402":121624,"_2946":121790},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3462":71920,"_30116":71848,"_20912":121792,"_5":14363,"_27402":121624,"_2946":121793},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3462":71921,"_30116":71848,"_20912":121795,"_5":14363,"_27402":121624,"_2946":121796},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3462":71922,"_30116":71848,"_20912":121798,"_5":14363,"_27402":121624,"_2946":121799},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3462":71923,"_30116":71848,"_20912":121801,"_5":14363,"_27402":121628,"_2946":121802},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3462":71924,"_30116":71848,"_20912":121804,"_5":14363,"_27402":121632,"_2946":121805},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3462":71925,"_30116":71848,"_20912":121807,"_5":14363,"_27402":121636,"_2946":121808},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3462":71926,"_30116":71848,"_20912":121810,"_5":14363,"_27402":121640,"_2946":121811},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3462":71927,"_30116":71848,"_20912":121813,"_5":14363,"_27402":121644,"_2946":121814},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3462":71928,"_30116":71848,"_20912":121816,"_5":14363,"_27402":121648,"_2946":121817},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3462":71929,"_30116":71848,"_20912":121819,"_5":14363,"_27402":121648,"_2946":121820},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3462":71930,"_30116":71848,"_20912":121822,"_5":14363,"_27402":121648,"_2946":121823},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3462":71931,"_30116":71931,"_5":14715,"_2946":121825,"_30468":121826,"_20912":121827,"_27402":71931},"Perfiles de certificado",[49167,117513,54640,121391],[],{"_3462":71932,"_30116":71931,"_20912":121829,"_5":14363,"_27402":71931,"_2946":121830},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3462":71933,"_30116":71931,"_5":30465,"_20912":121832,"_27402":121833,"_2946":121834},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3462":71934,"_30116":71931,"_5":30465,"_20912":121836,"_27402":121837,"_2946":121838},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#validez","Validez",{"_3462":71935,"_30116":71931,"_5":30465,"_20912":121840,"_27402":121841,"_2946":121842},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3462":71936,"_30116":71931,"_5":30465,"_20912":121844,"_27402":121845,"_2946":121846},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3462":71937,"_30116":71931,"_5":30465,"_20912":121848,"_27402":121849,"_2946":121850},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3462":71938,"_30116":71931,"_5":30465,"_20912":121852,"_27402":121853,"_2946":121854},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3462":71939,"_30116":71931,"_5":30465,"_20912":121856,"_27402":121857,"_2946":121858},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3462":71940,"_30116":71931,"_5":30465,"_20912":121860,"_27402":121861,"_2946":121862},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3462":71941,"_30116":71931,"_5":30465,"_20912":121864,"_27402":121865,"_2946":121866},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3462":71942,"_30116":71931,"_5":30465,"_20912":121868,"_27402":121869,"_2946":121870},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3462":71943,"_30116":71931,"_5":30465,"_20912":121872,"_27402":121873,"_2946":121874},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3462":71944,"_30116":71931,"_5":30465,"_20912":121876,"_27402":121877,"_2946":121878},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3462":71945,"_30116":71931,"_5":30465,"_20912":121880,"_27402":121881,"_2946":121882},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3462":71946,"_30116":71931,"_5":30465,"_20912":121884,"_27402":121885,"_2946":121886},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3462":71947,"_30116":71931,"_5":30465,"_20912":121888,"_27402":121889,"_2946":121890},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3462":71948,"_30116":71931,"_5":30465,"_20912":121892,"_27402":121893,"_2946":121894},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3462":71949,"_30116":71931,"_20912":121896,"_5":14363,"_27402":71931,"_2946":121897},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3462":71950,"_30116":71931,"_20912":121899,"_5":14363,"_27402":71931,"_2946":121900},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3462":71951,"_30116":71931,"_20912":121902,"_5":14363,"_27402":121837,"_2946":121903},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3462":71952,"_30116":71931,"_20912":121905,"_5":14363,"_27402":121837,"_2946":121906},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3462":71953,"_30116":71931,"_20912":121908,"_5":14363,"_27402":121841,"_2946":121909},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3462":71954,"_30116":71931,"_20912":121911,"_5":14363,"_27402":121845,"_2946":121912},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3462":71955,"_30116":71931,"_20912":121914,"_5":14363,"_27402":121845,"_2946":121915},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3462":71956,"_30116":71931,"_20912":121917,"_5":14363,"_27402":121845,"_2946":121918},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3462":71957,"_30116":71931,"_20912":121920,"_5":14363,"_27402":121849,"_2946":121921},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3462":71958,"_30116":71931,"_20912":121923,"_5":14363,"_27402":121853,"_2946":121924},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3462":71959,"_30116":71931,"_20912":121926,"_5":14363,"_27402":121853,"_2946":121927},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3462":71960,"_30116":71931,"_20912":121929,"_5":14363,"_27402":121857,"_2946":121930},[],"La aplicación criptográfica puede:",{"_3462":71961,"_30116":71931,"_20912":121932,"_5":14363,"_27402":121857,"_2946":121933},[],"permitir o bloquear claves RSA;",{"_3462":71962,"_30116":71931,"_20912":121935,"_5":14363,"_27402":121857,"_2946":121936},[],"limitar los tamaños RSA admitidos;",{"_3462":71963,"_30116":71931,"_20912":121938,"_5":14363,"_27402":121857,"_2946":121939},[],"permitir o bloquear claves ECDSA;",{"_3462":71964,"_30116":71931,"_20912":121941,"_5":14363,"_27402":121857,"_2946":121942},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3462":71965,"_30116":71931,"_20912":121944,"_5":14363,"_27402":121857,"_2946":121945},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3462":71966,"_30116":71931,"_20912":121947,"_5":14363,"_27402":121861,"_2946":121948},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3462":71967,"_30116":71931,"_20912":121950,"_5":14363,"_27402":121861,"_2946":117273},[],{"_3462":71968,"_30116":71931,"_20912":121952,"_5":14363,"_27402":121861,"_2946":121953},[],"Primera opción",{"_3462":71969,"_30116":71931,"_20912":121955,"_5":14363,"_27402":121861,"_2946":121956},[],"Segunda opción",{"_3462":71970,"_30116":71931,"_20912":121958,"_5":14363,"_27402":121861,"_2946":121959},[],"Si no hay ninguna",{"_3462":71971,"_30116":71931,"_20912":121961,"_5":14363,"_27402":121861,"_2946":121962},[],"Firma directa con una CA",{"_3462":71972,"_30116":71931,"_20912":121964,"_5":14363,"_27402":121861,"_2946":121965},[],"`issuance_profile` incluido en la solicitud",{"_3462":71973,"_30116":71931,"_20912":121967,"_5":14363,"_27402":121861,"_2946":121968},[],"`issuance_profile_id` de la solicitud",{"_3462":71974,"_30116":71931,"_20912":121970,"_5":14363,"_27402":121861,"_2946":121971},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3462":71975,"_30116":71931,"_20912":121973,"_5":14363,"_27402":121861,"_2946":121974},[],"Emisión mediante DMS",{"_3462":71976,"_30116":71931,"_20912":121976,"_5":14363,"_27402":121861,"_2946":55227},[],{"_3462":71977,"_30116":71931,"_20912":121978,"_5":14363,"_27402":121861,"_2946":121979},[],"`settings.issuance_profile` incluido en el DMS",{"_3462":71978,"_30116":71931,"_20912":121981,"_5":14363,"_27402":121861,"_2946":121982},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3462":71979,"_30116":71931,"_20912":121984,"_5":14363,"_27402":121861,"_2946":121985},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3462":71980,"_30116":71931,"_20912":121987,"_5":14363,"_27402":121861,"_2946":121988},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3462":71981,"_30116":71931,"_20912":121990,"_5":14363,"_27402":121869,"_2946":121991},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3462":71982,"_30116":71931,"_20912":121993,"_5":14363,"_27402":121873,"_2946":121994},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3462":71983,"_30116":71931,"_20912":121996,"_5":14363,"_27402":121877,"_2946":121997},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3462":71984,"_30116":71931,"_20912":121999,"_5":14363,"_27402":121881,"_2946":122000},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3462":71985,"_30116":71931,"_20912":122002,"_5":14363,"_27402":121885,"_2946":122003},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3462":71986,"_30116":71931,"_20912":122005,"_5":14363,"_27402":121885,"_2946":122006},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3462":71987,"_30116":71931,"_20912":122008,"_5":14363,"_27402":121889,"_2946":122009},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3462":71988,"_30116":71931,"_20912":122011,"_5":14363,"_27402":121889,"_2946":122012},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3462":71989,"_30116":71931,"_20912":122014,"_5":14363,"_27402":121889,"_2946":122015},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3462":71990,"_30116":71931,"_20912":122017,"_5":14363,"_27402":121889,"_2946":122018},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3462":71991,"_30116":71931,"_20912":122020,"_5":14363,"_27402":121893,"_2946":122021},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3462":71992,"_30116":71931,"_20912":122023,"_5":14363,"_27402":121893,"_2946":122024},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3462":71993,"_30116":71993,"_5":14715,"_2946":122026,"_30468":122027,"_20912":122029,"_27402":71993},"Validación de certificados",[49167,117513,54640,122028],"Validación",[],{"_3462":71994,"_30116":71993,"_20912":122031,"_5":14363,"_27402":71993,"_2946":122032},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3462":71995,"_30116":71993,"_5":30465,"_20912":122034,"_27402":122035,"_2946":122036},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3462":71996,"_30116":71993,"_5":30465,"_20912":122038,"_27402":122039,"_2946":122040},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3462":71997,"_30116":71993,"_5":30465,"_20912":122042,"_27402":122043,"_2946":122044},[],"/docs/pr-preview/pr-64/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3462":71998,"_30116":71993,"_20912":122046,"_5":14363,"_27402":71993,"_2946":122047},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3462":71999,"_30116":71993,"_20912":122049,"_5":14363,"_27402":122035,"_2946":122050},[],"Verifica estos criterios juntos:",{"_3462":72000,"_30116":71993,"_20912":122052,"_5":14363,"_27402":122035,"_2946":121020},[],{"_3462":72001,"_30116":71993,"_20912":122054,"_5":14363,"_27402":122035,"_2946":122055},[],"Resultado necesario",{"_3462":72002,"_30116":71993,"_20912":122057,"_5":14363,"_27402":122035,"_2946":122058},[],"Cadena y firma",{"_3462":72003,"_30116":71993,"_20912":122060,"_5":14363,"_27402":122035,"_2946":122061},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3462":72004,"_30116":71993,"_20912":122063,"_5":14363,"_27402":122035,"_2946":122064},[],"Fechas",{"_3462":72005,"_30116":71993,"_20912":122066,"_5":14363,"_27402":122035,"_2946":122067},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3462":72006,"_30116":71993,"_20912":122069,"_5":14363,"_27402":122035,"_2946":117183},[],{"_3462":72007,"_30116":71993,"_20912":122071,"_5":14363,"_27402":122035,"_2946":122072},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3462":72008,"_30116":71993,"_20912":122074,"_5":14363,"_27402":122035,"_2946":122075},[],"Uso",{"_3462":72009,"_30116":71993,"_20912":122077,"_5":14363,"_27402":122035,"_2946":122078},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3462":72010,"_30116":71993,"_20912":122080,"_5":14363,"_27402":122035,"_2946":122081},[],"Revocación",{"_3462":72011,"_30116":71993,"_20912":122083,"_5":14363,"_27402":122035,"_2946":122084},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3462":72012,"_30116":71993,"_20912":122086,"_5":14363,"_27402":122035,"_2946":122087},[],"Autorización",{"_3462":72013,"_30116":71993,"_20912":122089,"_5":14363,"_27402":122035,"_2946":122090},[],"La aplicación permite la acción a esa identidad.",{"_3462":72014,"_30116":71993,"_20912":122092,"_5":14363,"_27402":122035,"_2946":122093},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3462":72015,"_30116":71993,"_20912":122095,"_5":14363,"_27402":122039,"_2946":122096},[],"Mecanismo",{"_3462":72016,"_30116":71993,"_20912":122098,"_5":14363,"_27402":122039,"_2946":122099},[],"Cuándo utilizarlo",{"_3462":72017,"_30116":71993,"_20912":122101,"_5":14363,"_27402":122039,"_2946":122102},[],"Qué debes mantener",{"_3462":72018,"_30116":71993,"_20912":122104,"_5":14363,"_27402":122039,"_2946":55355},[],{"_3462":72019,"_30116":71993,"_20912":122106,"_5":14363,"_27402":122039,"_2946":122107},[],"Consulta del estado de un certificado concreto.",{"_3462":72020,"_30116":71993,"_20912":122109,"_5":14363,"_27402":122039,"_2946":122110},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3462":72021,"_30116":71993,"_20912":122112,"_5":14363,"_27402":122039,"_2946":55364},[],{"_3462":72022,"_30116":71993,"_20912":122114,"_5":14363,"_27402":122039,"_2946":122115},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3462":72023,"_30116":71993,"_20912":122117,"_5":14363,"_27402":122039,"_2946":122118},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3462":72024,"_30116":71993,"_20912":122120,"_5":14363,"_27402":122039,"_2946":122121},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3462":72025,"_30116":71993,"_20912":122123,"_5":14363,"_27402":122039,"_2946":122124},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3462":72026,"_30116":71993,"_20912":122126,"_5":14363,"_27402":122043,"_2946":122127},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3462":72027,"_30116":71993,"_20912":122129,"_5":14363,"_27402":122043,"_2946":122130},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3462":72028,"_30116":71993,"_20912":122132,"_5":14363,"_27402":122043,"_2946":122133},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3462":72029,"_30116":71993,"_20912":122135,"_5":14363,"_27402":122043,"_2946":122136},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3462":72030,"_30116":71993,"_20912":122138,"_5":14363,"_27402":122043,"_2946":122139},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3462":72031,"_30116":71993,"_20912":122141,"_5":14363,"_27402":122043,"_2946":122142},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3462":72032,"_30116":71993,"_20912":122144,"_5":14363,"_27402":122043,"_2946":122145},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3462":72033,"_30116":71993,"_20912":122147,"_5":14363,"_27402":122043,"_2946":122148},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3462":72034,"_30116":71993,"_20912":122150,"_5":14363,"_27402":122043,"_2946":122151},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3462":72035,"_30116":72035,"_5":14715,"_2946":122153,"_30468":122154,"_20912":122155,"_27402":72035},"Certificados",[49167,117513,54640,121391],[],{"_3462":72036,"_30116":72035,"_20912":122157,"_5":14363,"_27402":72035,"_2946":122158},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3462":72037,"_30116":72035,"_5":30465,"_20912":122160,"_27402":122161,"_2946":122162},[],"/docs/pr-preview/pr-64/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3462":72038,"_30116":72035,"_5":30465,"_20912":122164,"_27402":122165,"_2946":122166},[],"/docs/pr-preview/pr-64/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3462":72039,"_30116":72035,"_5":30465,"_20912":122168,"_27402":122169,"_2946":122170},[],"/docs/pr-preview/pr-64/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3462":72040,"_30116":72035,"_5":30465,"_20912":122172,"_27402":122173,"_2946":122174},[],"/docs/pr-preview/pr-64/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3462":72041,"_30116":72035,"_5":30465,"_20912":122176,"_27402":122177,"_2946":122178},[],"/docs/pr-preview/pr-64/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3462":72042,"_30116":72035,"_5":30465,"_20912":122180,"_27402":122181,"_2946":122182},[],"/docs/pr-preview/pr-64/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3462":72043,"_30116":72035,"_5":30465,"_20912":122184,"_27402":122185,"_2946":122186},[],"/docs/pr-preview/pr-64/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3462":72044,"_30116":72035,"_5":30465,"_20912":122188,"_27402":122189,"_2946":122190},[],"/docs/pr-preview/pr-64/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3462":72045,"_30116":72035,"_5":30465,"_20912":122192,"_27402":122193,"_2946":122194},[],"/docs/pr-preview/pr-64/es/platform/pki/certificates#continúa","Continúa",{"_3462":72046,"_30116":72035,"_20912":122196,"_5":14363,"_27402":72035,"_2946":122197},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3462":72047,"_30116":72035,"_20912":122199,"_5":14363,"_27402":122161,"_2946":122200},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3462":72048,"_30116":72035,"_20912":122202,"_5":14363,"_27402":122161,"_2946":122203},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3462":72049,"_30116":72035,"_20912":122205,"_5":14363,"_27402":122161,"_2946":122206},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3462":72050,"_30116":72035,"_20912":122208,"_5":14363,"_27402":122161,"_2946":122209},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3462":72051,"_30116":72035,"_20912":122211,"_5":14363,"_27402":122161,"_2946":122212},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3462":72052,"_30116":72035,"_20912":122214,"_5":14363,"_27402":122161,"_2946":122215},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3462":72053,"_30116":72035,"_20912":122217,"_5":14363,"_27402":122161,"_2946":122218},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3462":72054,"_30116":72035,"_20912":122220,"_5":14363,"_27402":122165,"_2946":122221},[],"Descarga el PEM e inspecciónalo:",{"_3462":72055,"_30116":72035,"_20912":122223,"_5":14363,"_27402":122165,"_2946":122224},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3462":72056,"_30116":72035,"_20912":122226,"_5":14363,"_27402":122169,"_2946":122227},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3462":72057,"_30116":72035,"_20912":122229,"_5":14363,"_27402":122169,"_2946":122230},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3462":72058,"_30116":72035,"_20912":122232,"_5":14363,"_27402":122169,"_2946":122233},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3462":72059,"_30116":72035,"_20912":122235,"_5":14363,"_27402":122169,"_2946":122236},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3462":72060,"_30116":72035,"_20912":122238,"_5":14363,"_27402":122169,"_2946":122239},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3462":72061,"_30116":72035,"_20912":122241,"_5":14363,"_27402":122169,"_2946":122242},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3462":72062,"_30116":72035,"_20912":122244,"_5":14363,"_27402":122169,"_2946":122245},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3462":72063,"_30116":72035,"_20912":122247,"_5":14363,"_27402":122173,"_2946":122248},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3462":72064,"_30116":72035,"_20912":122250,"_5":14363,"_27402":122177,"_2946":122251},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3462":72065,"_30116":72035,"_20912":122253,"_5":14363,"_27402":122181,"_2946":122254},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3462":72066,"_30116":72035,"_20912":122256,"_5":14363,"_27402":122185,"_2946":122257},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3462":72067,"_30116":72035,"_20912":122259,"_5":14363,"_27402":122185,"_2946":122260},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3462":72068,"_30116":72035,"_20912":122262,"_5":14363,"_27402":122185,"_2946":122263},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3462":72069,"_30116":72035,"_20912":122265,"_5":14363,"_27402":122189,"_2946":122266},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3462":72070,"_30116":72035,"_20912":122268,"_5":14363,"_27402":122189,"_2946":122269},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3462":72071,"_30116":72035,"_20912":122271,"_5":14363,"_27402":122189,"_2946":122272},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3462":72072,"_30116":72035,"_20912":122274,"_5":14363,"_27402":122193,"_2946":122275},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3462":72073,"_30116":72035,"_20912":122277,"_5":14363,"_27402":122193,"_2946":122278},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3462":72074,"_30116":72074,"_5":14715,"_2946":122280,"_30468":122281,"_20912":122283,"_27402":72074},"Ciclo de vida de un certificado",[49167,117513,54640,122282],"Conceptos",[],{"_3462":72075,"_30116":72074,"_20912":122285,"_5":14363,"_27402":72074,"_2946":122286},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3462":72076,"_30116":72074,"_5":30465,"_20912":122288,"_27402":122289,"_2946":122290},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3462":72077,"_30116":72074,"_5":30465,"_20912":122292,"_27402":122293,"_2946":122294},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3462":72078,"_30116":72074,"_5":30465,"_20912":122296,"_27402":122297,"_2946":122298},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3462":72079,"_30116":72074,"_5":30465,"_20912":122300,"_27402":122301,"_2946":122302},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3462":72080,"_30116":72074,"_5":30465,"_20912":122304,"_27402":122305,"_2946":122306},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3462":72081,"_30116":72074,"_5":30465,"_20912":122308,"_27402":122309,"_2946":122310},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3462":72082,"_30116":72074,"_5":30465,"_20912":122312,"_27402":122313,"_2946":120014},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3462":72083,"_30116":72074,"_5":30465,"_20912":122315,"_27402":122316,"_2946":122317},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3462":72084,"_30116":72074,"_5":30465,"_20912":122319,"_27402":122320,"_2946":122321},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3462":72085,"_30116":72074,"_5":30465,"_20912":122323,"_27402":122324,"_2946":122325},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3462":72086,"_30116":72074,"_20912":122327,"_5":14363,"_27402":72074,"_2946":122328},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3462":72087,"_30116":72074,"_20912":122330,"_5":14363,"_27402":122293,"_2946":122331},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3462":72088,"_30116":72074,"_20912":122333,"_5":14363,"_27402":122297,"_2946":122334},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3462":72089,"_30116":72074,"_20912":122336,"_5":14363,"_27402":122301,"_2946":122337},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3462":72090,"_30116":72074,"_20912":122339,"_5":14363,"_27402":122305,"_2946":122340},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3462":72091,"_30116":72074,"_20912":122342,"_5":14363,"_27402":122309,"_2946":122343},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3462":72092,"_30116":72074,"_20912":122345,"_5":14363,"_27402":122313,"_2946":122346},[],"Lamassu persiste cuatro estados X.509:",{"_3462":72093,"_30116":72074,"_20912":122348,"_5":14363,"_27402":122313,"_2946":122349},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3462":72094,"_30116":72074,"_20912":122351,"_5":14363,"_27402":122313,"_2946":122352},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3462":72095,"_30116":72074,"_20912":122354,"_5":14363,"_27402":122313,"_2946":122355},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3462":72096,"_30116":72074,"_20912":122357,"_5":14363,"_27402":122313,"_2946":122358},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3462":72097,"_30116":72074,"_20912":122360,"_5":14363,"_27402":122313,"_2946":122361},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3462":72098,"_30116":72074,"_20912":122363,"_5":14363,"_27402":122316,"_2946":122364},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3462":72099,"_30116":72074,"_20912":122366,"_5":14363,"_27402":122316,"_2946":122367},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3462":72100,"_30116":72074,"_20912":122369,"_5":14363,"_27402":122316,"_2946":122370},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3462":72101,"_30116":72074,"_20912":122372,"_5":14363,"_27402":122320,"_2946":122373},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3462":72102,"_30116":72074,"_20912":122375,"_5":14363,"_27402":122320,"_2946":122376},[],"Antes de confirmar:",{"_3462":72103,"_30116":72074,"_20912":122378,"_5":14363,"_27402":122320,"_2946":122379},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3462":72104,"_30116":72074,"_20912":122381,"_5":14363,"_27402":122320,"_2946":122382},[],"Distribuye la nueva cadena de confianza.",{"_3462":72105,"_30116":72074,"_20912":122384,"_5":14363,"_27402":122320,"_2946":122385},[],"Reemite las identidades necesarias.",{"_3462":72106,"_30116":72074,"_20912":122387,"_5":14363,"_27402":122320,"_2946":122388},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3462":72107,"_30116":72074,"_20912":122390,"_5":14363,"_27402":122320,"_2946":122391},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3462":72108,"_30116":72074,"_20912":122393,"_5":14363,"_27402":122320,"_2946":122394},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3462":72109,"_30116":72074,"_20912":122396,"_5":14363,"_27402":122324,"_2946":122397},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3462":72110,"_30116":72074,"_20912":122399,"_5":14363,"_27402":122324,"_2946":122400},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3462":72111,"_30116":72074,"_20912":122402,"_5":14363,"_27402":122324,"_2946":122403},[],"Cambios de estado y razones de revocación.",{"_3462":72112,"_30116":72074,"_20912":122405,"_5":14363,"_27402":122324,"_2946":122406},[],"Publicación y vigencia de OCSP y CRLs.",{"_3462":72113,"_30116":72074,"_20912":122408,"_5":14363,"_27402":122324,"_2946":122409},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3462":72114,"_30116":72074,"_20912":122411,"_5":14363,"_27402":122324,"_2946":122412},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3462":72115,"_30116":72115,"_5":14715,"_2946":122414,"_30468":122415,"_20912":122416,"_27402":72115},"Modelo de confianza",[49167,117513,54640,122282],[],{"_3462":72116,"_30116":72115,"_20912":122418,"_5":14363,"_27402":72115,"_2946":122419},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3462":72117,"_30116":72115,"_5":30465,"_20912":122421,"_27402":122422,"_2946":122423},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3462":72118,"_30116":72115,"_5":30465,"_20912":122425,"_27402":122426,"_2946":122427},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3462":72119,"_30116":72115,"_5":30465,"_20912":122429,"_27402":122430,"_2946":122431},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3462":72120,"_30116":72115,"_5":30465,"_20912":122433,"_27402":122434,"_2946":122435},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3462":72121,"_30116":72115,"_5":30465,"_20912":122437,"_27402":122438,"_2946":122439},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3462":72122,"_30116":72115,"_5":30465,"_20912":122441,"_27402":122442,"_2946":122443},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3462":72123,"_30116":72115,"_5":30465,"_20912":122445,"_27402":122446,"_2946":122447},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3462":72124,"_30116":72115,"_5":30465,"_20912":122449,"_27402":122450,"_2946":122451},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3462":72125,"_30116":72115,"_5":30465,"_20912":122453,"_27402":122454,"_2946":122455},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3462":72126,"_30116":72115,"_5":30465,"_20912":122457,"_27402":122458,"_2946":122459},[],"/docs/pr-preview/pr-64/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3462":72127,"_30116":72115,"_20912":122461,"_5":14363,"_27402":72115,"_2946":122462},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3462":72128,"_30116":72115,"_20912":122464,"_5":14363,"_27402":122426,"_2946":122465},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3462":72129,"_30116":72115,"_20912":122467,"_5":14363,"_27402":122430,"_2946":122468},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3462":72130,"_30116":72115,"_20912":122470,"_5":14363,"_27402":122434,"_2946":122471},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3462":72131,"_30116":72115,"_20912":122473,"_5":14363,"_27402":122438,"_2946":122474},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3462":72132,"_30116":72115,"_20912":122476,"_5":14363,"_27402":122442,"_2946":122477},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3462":72133,"_30116":72115,"_20912":122479,"_5":14363,"_27402":122442,"_2946":122480},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3462":72134,"_30116":72115,"_20912":122482,"_5":14363,"_27402":122442,"_2946":122483},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3462":72135,"_30116":72115,"_20912":122485,"_5":14363,"_27402":122442,"_2946":122486},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3462":72136,"_30116":72115,"_20912":122488,"_5":14363,"_27402":122442,"_2946":122489},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3462":72137,"_30116":72115,"_20912":122491,"_5":14363,"_27402":122442,"_2946":122492},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3462":72138,"_30116":72115,"_20912":122494,"_5":14363,"_27402":122446,"_2946":122495},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3462":72139,"_30116":72115,"_20912":122497,"_5":14363,"_27402":122446,"_2946":122498},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3462":72140,"_30116":72115,"_20912":122500,"_5":14363,"_27402":122446,"_2946":122501},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3462":72141,"_30116":72115,"_20912":122503,"_5":14363,"_27402":122446,"_2946":122504},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3462":72142,"_30116":72115,"_20912":122506,"_5":14363,"_27402":122446,"_2946":122507},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3462":72143,"_30116":72115,"_20912":122509,"_5":14363,"_27402":122450,"_2946":122510},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3462":72144,"_30116":72115,"_20912":122512,"_5":14363,"_27402":122450,"_2946":122513},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3462":72145,"_30116":72115,"_20912":122515,"_5":14363,"_27402":122450,"_2946":122516},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3462":72146,"_30116":72115,"_20912":122518,"_5":14363,"_27402":122450,"_2946":122519},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3462":72147,"_30116":72115,"_20912":122521,"_5":14363,"_27402":122450,"_2946":122522},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3462":72148,"_30116":72115,"_20912":122524,"_5":14363,"_27402":122450,"_2946":122525},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3462":72149,"_30116":72115,"_20912":122527,"_5":14363,"_27402":122450,"_2946":122528},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3462":72150,"_30116":72115,"_20912":122530,"_5":14363,"_27402":122454,"_2946":122531},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3462":72151,"_30116":72115,"_20912":122533,"_5":14363,"_27402":122458,"_2946":122534},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3462":72152,"_30116":72115,"_20912":122536,"_5":14363,"_27402":122458,"_2946":122537},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3462":72153,"_30116":72115,"_20912":122539,"_5":14363,"_27402":122458,"_2946":122540},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3462":72154,"_30116":72115,"_20912":122542,"_5":14363,"_27402":122458,"_2946":122543},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3462":72155,"_30116":72115,"_20912":122545,"_5":14363,"_27402":122458,"_2946":122546},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3462":72156,"_30116":72115,"_20912":122548,"_5":14363,"_27402":122458,"_2946":122549},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3462":72157,"_30116":72115,"_20912":122551,"_5":14363,"_27402":122458,"_2946":122552},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3462":72158,"_30116":72158,"_5":14715,"_2946":122554,"_30468":122555,"_20912":122556,"_27402":72158},"Listas de revocación (CRL)",[49167,117513,54640,122028],[],{"_3462":72159,"_30116":72158,"_20912":122558,"_5":14363,"_27402":72158,"_2946":122559},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3462":72160,"_30116":72158,"_5":30465,"_20912":122561,"_27402":122562,"_2946":122563},[],"/docs/pr-preview/pr-64/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3462":72161,"_30116":72158,"_5":30465,"_20912":122565,"_27402":122566,"_2946":122567},[],"/docs/pr-preview/pr-64/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3462":72162,"_30116":72158,"_5":30465,"_20912":122569,"_27402":122570,"_2946":122571},[],"/docs/pr-preview/pr-64/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3462":72163,"_30116":72158,"_5":30465,"_20912":122573,"_27402":122574,"_2946":122575},[],"/docs/pr-preview/pr-64/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3462":72164,"_30116":72158,"_5":30465,"_20912":122577,"_27402":122578,"_2946":122579},[],"/docs/pr-preview/pr-64/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3462":72165,"_30116":72158,"_5":30465,"_20912":122581,"_27402":122582,"_2946":122583},[],"/docs/pr-preview/pr-64/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3462":72166,"_30116":72158,"_5":30465,"_20912":122585,"_27402":122586,"_2946":122587},[],"/docs/pr-preview/pr-64/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3462":72167,"_30116":72158,"_5":30465,"_20912":122589,"_27402":122590,"_2946":122591},[],"/docs/pr-preview/pr-64/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3462":72168,"_30116":72158,"_5":30465,"_20912":122593,"_27402":122594,"_2946":122595},[],"/docs/pr-preview/pr-64/es/platform/pki/crl#referencias","Referencias",{"_3462":72169,"_30116":72158,"_20912":122597,"_5":14363,"_27402":72158,"_2946":122598},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3462":72170,"_30116":72158,"_20912":122600,"_5":14363,"_27402":122562,"_2946":122601},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3462":72171,"_30116":72158,"_20912":122603,"_5":14363,"_27402":122562,"_2946":122604},[],"Campo",{"_3462":72172,"_30116":72158,"_20912":122606,"_5":14363,"_27402":122562,"_2946":119054},[],{"_3462":72173,"_30116":72158,"_20912":122608,"_5":14363,"_27402":122562,"_2946":55862},[],{"_3462":72174,"_30116":72158,"_20912":122610,"_5":14363,"_27402":122562,"_2946":122611},[],"ID de la CA a la que pertenecen los ajustes.",{"_3462":72175,"_30116":72158,"_20912":122613,"_5":14363,"_27402":122562,"_2946":55868},[],{"_3462":72176,"_30116":72158,"_20912":122615,"_5":14363,"_27402":122562,"_2946":122616},[],"Los ajustes `ACTIVE` generan CRLs. Los `ARCHIVED` pertenecen a una CA que ya no existe: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3462":72177,"_30116":72158,"_20912":122618,"_5":14363,"_27402":122562,"_2946":55874},[],{"_3462":72178,"_30116":72158,"_20912":122620,"_5":14363,"_27402":122562,"_2946":122621},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3462":72179,"_30116":72158,"_20912":122623,"_5":14363,"_27402":122562,"_2946":55880},[],{"_3462":72180,"_30116":72158,"_20912":122625,"_5":14363,"_27402":122562,"_2946":122626},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3462":72181,"_30116":72158,"_20912":122628,"_5":14363,"_27402":122562,"_2946":122629},[],"Campo de `crl_options`",{"_3462":72182,"_30116":72158,"_20912":122631,"_5":14363,"_27402":122562,"_2946":119054},[],{"_3462":72183,"_30116":72158,"_20912":122633,"_5":14363,"_27402":122562,"_2946":122634},[],"Valor inicial",{"_3462":72184,"_30116":72158,"_20912":122636,"_5":14363,"_27402":122562,"_2946":55894},[],{"_3462":72185,"_30116":72158,"_20912":122638,"_5":14363,"_27402":122562,"_2946":122639},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3462":72186,"_30116":72158,"_20912":122641,"_5":14363,"_27402":122562,"_2946":122642},[],"7 días.",{"_3462":72187,"_30116":72158,"_20912":122644,"_5":14363,"_27402":122562,"_2946":55903},[],{"_3462":72188,"_30116":72158,"_20912":122646,"_5":14363,"_27402":122562,"_2946":122647},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3462":72189,"_30116":72158,"_20912":122649,"_5":14363,"_27402":122562,"_2946":122650},[],"6 días y 23 horas.",{"_3462":72190,"_30116":72158,"_20912":122652,"_5":14363,"_27402":122562,"_2946":55912},[],{"_3462":72191,"_30116":72158,"_20912":122654,"_5":14363,"_27402":122562,"_2946":122655},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3462":72192,"_30116":72158,"_20912":122657,"_5":14363,"_27402":122562,"_2946":55918},[],{"_3462":72193,"_30116":72158,"_20912":122659,"_5":14363,"_27402":122562,"_2946":55921},[],{"_3462":72194,"_30116":72158,"_20912":122661,"_5":14363,"_27402":122562,"_2946":122662},[],"Número de serie del certificado existente que firma la CRL.",{"_3462":72195,"_30116":72158,"_20912":122664,"_5":14363,"_27402":122562,"_2946":122665},[],"Número de serie del certificado actual de la CA.",{"_3462":72196,"_30116":72158,"_20912":122667,"_5":14363,"_27402":122562,"_2946":122668},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3462":72197,"_30116":72158,"_20912":122670,"_5":14363,"_27402":122562,"_2946":122671},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3462":72198,"_30116":72158,"_20912":122673,"_5":14363,"_27402":122562,"_2946":122674},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3462":72199,"_30116":72158,"_20912":122676,"_5":14363,"_27402":122562,"_2946":122677},[],"Eliminar una CA conserva sus ajustes de CRL, que no pueden borrarse por API. Qué ocurre después depende de cuándo se eliminó la CA:",{"_3462":72200,"_30116":72158,"_20912":122679,"_5":14363,"_27402":122562,"_2946":122680},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3462":72201,"_30116":72158,"_20912":122682,"_5":14363,"_27402":122562,"_2946":122683},[],"Una CA eliminada con 4.0.0 en marcha deja ajustes `ACTIVE`. La última CRL sigue sirviéndose, pero una vez vencida nada la regenera: el trabajo de renovación registra `something went wrong while calculating CRL for CA <ca-id>` en cada ciclo porque ya no puede resolver la CA. Las opciones siguen editándose mientras el firmante no cambie; cambiarlo falla, porque ya no queda ninguna CA con la que coincidir.",{"_3462":72202,"_30116":72158,"_20912":122685,"_5":14363,"_27402":122562,"_2946":122686},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3462":72203,"_30116":72158,"_20912":122688,"_5":14363,"_27402":122562,"_2946":122689},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3462":72204,"_30116":72158,"_20912":122691,"_5":14363,"_27402":122562,"_2946":122692},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3462":72205,"_30116":72158,"_20912":122694,"_5":14363,"_27402":122562,"_2946":122695},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3462":72206,"_30116":72158,"_20912":122697,"_5":14363,"_27402":122566,"_2946":122698},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3462":72207,"_30116":72158,"_20912":122700,"_5":14363,"_27402":122566,"_2946":122701},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3462":72208,"_30116":72158,"_20912":122703,"_5":14363,"_27402":122566,"_2946":122704},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3462":72209,"_30116":72158,"_20912":122706,"_5":14363,"_27402":122566,"_2946":122707},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3462":72210,"_30116":72158,"_20912":122709,"_5":14363,"_27402":122570,"_2946":122710},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3462":72211,"_30116":72158,"_20912":122712,"_5":14363,"_27402":122570,"_2946":122713},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3462":72212,"_30116":72158,"_20912":122715,"_5":14363,"_27402":122570,"_2946":122716},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3462":72213,"_30116":72158,"_20912":122718,"_5":14363,"_27402":122570,"_2946":122719},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3462":72214,"_30116":72158,"_20912":122721,"_5":14363,"_27402":122570,"_2946":122722},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3462":72215,"_30116":72158,"_20912":122724,"_5":14363,"_27402":122570,"_2946":122725},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3462":72216,"_30116":72158,"_20912":122727,"_5":14363,"_27402":122570,"_2946":122728},[],"Los ajustes con `status` `ARCHIVED` se omiten: nada regenera su CRL.",{"_3462":72217,"_30116":72158,"_20912":122730,"_5":14363,"_27402":122570,"_2946":122731},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3462":72218,"_30116":72158,"_20912":122733,"_5":14363,"_27402":122570,"_2946":122734},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3462":72219,"_30116":72158,"_20912":122736,"_5":14363,"_27402":122574,"_2946":122737},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3462":72220,"_30116":72158,"_20912":122739,"_5":14363,"_27402":122574,"_2946":122740},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3462":72221,"_30116":72158,"_20912":122742,"_5":14363,"_27402":122578,"_2946":122743},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3462":72222,"_30116":72158,"_20912":122745,"_5":14363,"_27402":122578,"_2946":122746},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3462":72223,"_30116":72158,"_20912":122748,"_5":14363,"_27402":122578,"_2946":122749},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3462":72224,"_30116":72158,"_20912":122751,"_5":14363,"_27402":122578,"_2946":122752},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3462":72225,"_30116":72158,"_20912":122754,"_5":14363,"_27402":122578,"_2946":122755},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3462":72226,"_30116":72158,"_20912":122757,"_5":14363,"_27402":122582,"_2946":122758},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3462":72227,"_30116":72158,"_20912":122760,"_5":14363,"_27402":122582,"_2946":119243},[],{"_3462":72228,"_30116":72158,"_20912":122762,"_5":14363,"_27402":122582,"_2946":122763},[],"Path relativo",{"_3462":72229,"_30116":72158,"_20912":122765,"_5":14363,"_27402":122582,"_2946":117273},[],{"_3462":72230,"_30116":72158,"_20912":122767,"_5":14363,"_27402":122582,"_2946":56030},[],{"_3462":72231,"_30116":72158,"_20912":122769,"_5":14363,"_27402":122582,"_2946":56033},[],{"_3462":72232,"_30116":72158,"_20912":122771,"_5":14363,"_27402":122582,"_2946":122772},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3462":72233,"_30116":72158,"_20912":122774,"_5":14363,"_27402":122582,"_2946":56030},[],{"_3462":72234,"_30116":72158,"_20912":122776,"_5":14363,"_27402":122582,"_2946":56041},[],{"_3462":72235,"_30116":72158,"_20912":122778,"_5":14363,"_27402":122582,"_2946":122779},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3462":72236,"_30116":72158,"_20912":122781,"_5":14363,"_27402":122582,"_2946":56047},[],{"_3462":72237,"_30116":72158,"_20912":122783,"_5":14363,"_27402":122582,"_2946":56041},[],{"_3462":72238,"_30116":72158,"_20912":122785,"_5":14363,"_27402":122582,"_2946":122786},[],"Sustituir la configuración de CRL de una CA.",{"_3462":72239,"_30116":72158,"_20912":122788,"_5":14363,"_27402":122582,"_2946":122789},[],"Necesitas autenticación y permisos de lectura o actualización de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3462":72240,"_30116":72158,"_20912":122791,"_5":14363,"_27402":122582,"_2946":122792},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3462":72241,"_30116":72158,"_20912":122794,"_5":14363,"_27402":122586,"_2946":122795},[],"Síntoma",{"_3462":72242,"_30116":72158,"_20912":122797,"_5":14363,"_27402":122586,"_2946":122798},[],"Causa",{"_3462":72243,"_30116":72158,"_20912":122800,"_5":14363,"_27402":122586,"_2946":122801},[],"Acción",{"_3462":72244,"_30116":72158,"_20912":122803,"_5":14363,"_27402":122586,"_2946":122804},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3462":72245,"_30116":72158,"_20912":122806,"_5":14363,"_27402":122586,"_2946":122807},[],"Los ajustes no están `ACTIVE`: la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3462":72246,"_30116":72158,"_20912":122809,"_5":14363,"_27402":122586,"_2946":122810},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3462":72247,"_30116":72158,"_20912":122812,"_5":14363,"_27402":122586,"_2946":122813},[],"`PUT` devuelve 400.",{"_3462":72248,"_30116":72158,"_20912":122815,"_5":14363,"_27402":122586,"_2946":122816},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3462":72249,"_30116":72158,"_20912":122818,"_5":14363,"_27402":122586,"_2946":122819},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3462":72250,"_30116":72158,"_20912":122821,"_5":14363,"_27402":122586,"_2946":122822},[],"`PUT` devuelve 404.",{"_3462":72251,"_30116":72158,"_20912":122824,"_5":14363,"_27402":122586,"_2946":122825},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3462":72252,"_30116":72158,"_20912":122827,"_5":14363,"_27402":122586,"_2946":122828},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3462":72253,"_30116":72158,"_20912":122830,"_5":14363,"_27402":122586,"_2946":122831},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3462":72254,"_30116":72158,"_20912":122833,"_5":14363,"_27402":122586,"_2946":122834},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3462":72255,"_30116":72158,"_20912":122836,"_5":14363,"_27402":122586,"_2946":122837},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3462":72256,"_30116":72158,"_20912":122839,"_5":14363,"_27402":122586,"_2946":122840},[],"La CRL no cambia tras revocar un certificado.",{"_3462":72257,"_30116":72158,"_20912":122842,"_5":14363,"_27402":122586,"_2946":122843},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3462":72258,"_30116":72158,"_20912":122845,"_5":14363,"_27402":122586,"_2946":122846},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3462":72259,"_30116":72158,"_20912":122848,"_5":14363,"_27402":122586,"_2946":122849},[],"Un verificador rechaza la CRL por el emisor.",{"_3462":72260,"_30116":72158,"_20912":122851,"_5":14363,"_27402":122586,"_2946":122852},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3462":72261,"_30116":72158,"_20912":122854,"_5":14363,"_27402":122586,"_2946":122855},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3462":72262,"_30116":72158,"_20912":122857,"_5":14363,"_27402":122590,"_2946":122858},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Los ajustes VA de la CA también permiten seleccionar el firmante de la CRL: el selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3462":72263,"_30116":72158,"_20912":122860,"_5":14363,"_27402":122594,"_2946":122861},[],"RFC 5280: perfil X.509 y CRL.",{"_3462":72264,"_30116":72158,"_20912":122863,"_5":14363,"_27402":122594,"_2946":56130},[],{"_3462":72265,"_30116":72158,"_20912":122865,"_5":14363,"_27402":122594,"_2946":56133},[],{"_3462":72266,"_30116":72158,"_20912":122867,"_5":14363,"_27402":122594,"_2946":122868},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3462":72267,"_30116":72158,"_20912":122870,"_5":14363,"_27402":122594,"_2946":122871},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3462":72268,"_30116":72268,"_5":14715,"_2946":122873,"_30468":122874,"_20912":122875,"_27402":72268},"Claves y motores criptográficos",[49167,117513,54640,121391],[],{"_3462":72269,"_30116":72268,"_20912":122877,"_5":14363,"_27402":72268,"_2946":122878},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3462":72270,"_30116":72268,"_5":30465,"_20912":122880,"_27402":122881,"_2946":122882},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3462":72271,"_30116":72268,"_5":30465,"_20912":122884,"_27402":122885,"_2946":122886},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3462":72272,"_30116":72268,"_5":30465,"_20912":122888,"_27402":122889,"_2946":56158},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#file-system",{"_3462":72273,"_30116":72268,"_5":30465,"_20912":122891,"_27402":122892,"_2946":56162},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#hashicorp-vault",{"_3462":72274,"_30116":72268,"_5":30465,"_20912":122894,"_27402":122895,"_2946":56166},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#aws-secrets-manager",{"_3462":72275,"_30116":72268,"_5":30465,"_20912":122897,"_27402":122898,"_2946":56170},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#aws-kms",{"_3462":72276,"_30116":72268,"_5":30465,"_20912":122900,"_27402":122901,"_2946":56174},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#pkcs11",{"_3462":72277,"_30116":72268,"_5":30465,"_20912":122903,"_27402":122904,"_2946":56178},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#azure-key-vault",{"_3462":72278,"_30116":72268,"_5":30465,"_20912":122906,"_27402":122907,"_2946":122908},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3462":72279,"_30116":72268,"_5":30465,"_20912":122910,"_27402":122911,"_2946":122912},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3462":72280,"_30116":72268,"_5":30465,"_20912":122914,"_27402":122915,"_2946":122916},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3462":72281,"_30116":72268,"_5":30465,"_20912":122918,"_27402":122919,"_2946":122920},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3462":72282,"_30116":72268,"_5":30465,"_20912":122922,"_27402":122923,"_2946":122924},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3462":72283,"_30116":72268,"_5":30465,"_20912":122926,"_27402":122927,"_2946":122928},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3462":72284,"_30116":72268,"_5":30465,"_20912":122930,"_27402":122931,"_2946":122932},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3462":72285,"_30116":72268,"_5":30465,"_20912":122934,"_27402":122935,"_2946":56210},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#sign",{"_3462":72286,"_30116":72268,"_5":30465,"_20912":122937,"_27402":122938,"_2946":56214},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#verify",{"_3462":72287,"_30116":72268,"_5":30465,"_20912":122940,"_27402":122941,"_2946":122942},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3462":72288,"_30116":72268,"_5":30465,"_20912":122944,"_27402":122945,"_2946":122946},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3462":72289,"_30116":72268,"_5":30465,"_20912":122948,"_27402":122949,"_2946":122950},[],"/docs/pr-preview/pr-64/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3462":72290,"_30116":72268,"_20912":122952,"_5":14363,"_27402":72268,"_2946":122953},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3462":72291,"_30116":72268,"_20912":122955,"_5":14363,"_27402":72268,"_2946":122956},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3462":72292,"_30116":72268,"_20912":122958,"_5":14363,"_27402":122881,"_2946":122959},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3462":72293,"_30116":72268,"_20912":122961,"_5":14363,"_27402":122881,"_2946":122962},[],"En la práctica, permite:",{"_3462":72294,"_30116":72268,"_20912":122964,"_5":14363,"_27402":122881,"_2946":122965},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3462":72295,"_30116":72268,"_20912":122967,"_5":14363,"_27402":122881,"_2946":122968},[],"Importar claves creadas externamente.",{"_3462":72296,"_30116":72268,"_20912":122970,"_5":14363,"_27402":122881,"_2946":122971},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3462":72297,"_30116":72268,"_20912":122973,"_5":14363,"_27402":122881,"_2946":122974},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3462":72298,"_30116":72268,"_20912":122976,"_5":14363,"_27402":122885,"_2946":122977},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3462":72299,"_30116":72268,"_20912":122979,"_5":14363,"_27402":122885,"_2946":122980},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3462":72300,"_30116":72268,"_20912":122982,"_5":14363,"_27402":122885,"_2946":122983},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3462":72301,"_30116":72268,"_20912":122985,"_5":14363,"_27402":122889,"_2946":122986},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3462":72302,"_30116":72268,"_20912":122988,"_5":14363,"_27402":122892,"_2946":122989},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3462":72303,"_30116":72268,"_20912":122991,"_5":14363,"_27402":122892,"_2946":122992},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3462":72304,"_30116":72268,"_20912":122994,"_5":14363,"_27402":122895,"_2946":122995},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3462":72305,"_30116":72268,"_20912":122997,"_5":14363,"_27402":122898,"_2946":122998},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3462":72306,"_30116":72268,"_20912":123000,"_5":14363,"_27402":122901,"_2946":123001},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3462":72307,"_30116":72268,"_20912":123003,"_5":14363,"_27402":122904,"_2946":123004},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3462":72308,"_30116":72268,"_20912":123006,"_5":14363,"_27402":122904,"_2946":123007},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3462":72309,"_30116":72268,"_20912":123009,"_5":14363,"_27402":122904,"_2946":123010},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3462":72310,"_30116":72268,"_20912":123012,"_5":14363,"_27402":122904,"_2946":123013},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3462":72311,"_30116":72268,"_20912":123015,"_5":14363,"_27402":122907,"_2946":123016},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3462":72312,"_30116":72268,"_20912":123018,"_5":14363,"_27402":122907,"_2946":123019},[],"La tabla incluye los siguientes campos:",{"_3462":72313,"_30116":72268,"_20912":123021,"_5":14363,"_27402":122907,"_2946":123022},[],"**Name**: nombre descriptivo de la clave.",{"_3462":72314,"_30116":72268,"_20912":123024,"_5":14363,"_27402":122907,"_2946":123025},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3462":72315,"_30116":72268,"_20912":123027,"_5":14363,"_27402":122907,"_2946":123028},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3462":72316,"_30116":72268,"_20912":123030,"_5":14363,"_27402":122907,"_2946":123031},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3462":72317,"_30116":72268,"_20912":123033,"_5":14363,"_27402":122907,"_2946":123034},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3462":72318,"_30116":72268,"_20912":123036,"_5":14363,"_27402":122907,"_2946":123037},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3462":72319,"_30116":72268,"_20912":123039,"_5":14363,"_27402":122907,"_2946":123040},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3462":72320,"_30116":72268,"_20912":123042,"_5":14363,"_27402":122907,"_2946":123043},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3462":72321,"_30116":72268,"_20912":123045,"_5":14363,"_27402":122907,"_2946":123046},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3462":72322,"_30116":72268,"_20912":123048,"_5":14363,"_27402":122907,"_2946":123049},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3462":72323,"_30116":72268,"_20912":123051,"_5":14363,"_27402":122907,"_2946":123052},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3462":72324,"_30116":72268,"_20912":123054,"_5":14363,"_27402":122907,"_2946":123055},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3462":72325,"_30116":72268,"_20912":123057,"_5":14363,"_27402":122907,"_2946":123058},[],"**Delete Key** para eliminar la clave del sistema.",{"_3462":72326,"_30116":72268,"_20912":123060,"_5":14363,"_27402":122911,"_2946":123061},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3462":72327,"_30116":72268,"_20912":123063,"_5":14363,"_27402":122915,"_2946":123064},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3462":72328,"_30116":72268,"_20912":123066,"_5":14363,"_27402":122915,"_2946":123067},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3462":72329,"_30116":72268,"_20912":123069,"_5":14363,"_27402":122915,"_2946":123070},[],"**Key Name**: nombre único y descriptivo.",{"_3462":72330,"_30116":72268,"_20912":123072,"_5":14363,"_27402":122915,"_2946":123073},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3462":72331,"_30116":72268,"_20912":123075,"_5":14363,"_27402":122915,"_2946":123076},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3462":72332,"_30116":72268,"_20912":123078,"_5":14363,"_27402":122915,"_2946":123079},[],"**Tags**: metadatos para clasificar la clave.",{"_3462":72333,"_30116":72268,"_20912":123081,"_5":14363,"_27402":122915,"_2946":123082},[],"**Metadata**: información adicional para usos avanzados.",{"_3462":72334,"_30116":72268,"_20912":123084,"_5":14363,"_27402":122919,"_2946":123085},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3462":72335,"_30116":72268,"_20912":123087,"_5":14363,"_27402":122919,"_2946":123088},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3462":72336,"_30116":72268,"_20912":123090,"_5":14363,"_27402":122919,"_2946":123091},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3462":72337,"_30116":72268,"_20912":123093,"_5":14363,"_27402":122919,"_2946":123094},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3462":72338,"_30116":72268,"_20912":123096,"_5":14363,"_27402":122919,"_2946":123097},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3462":72339,"_30116":72268,"_20912":123099,"_5":14363,"_27402":122919,"_2946":123100},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3462":72340,"_30116":72268,"_20912":123102,"_5":14363,"_27402":122919,"_2946":123103},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3462":72341,"_30116":72268,"_20912":123105,"_5":14363,"_27402":122919,"_2946":123106},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3462":72342,"_30116":72268,"_20912":123108,"_5":14363,"_27402":122919,"_2946":123109},[],"**Metadata**: información adicional opcional.",{"_3462":72343,"_30116":72268,"_20912":123111,"_5":14363,"_27402":122919,"_2946":123112},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3462":72344,"_30116":72268,"_20912":123114,"_5":14363,"_27402":122919,"_2946":123115},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3462":72345,"_30116":72268,"_20912":123117,"_5":14363,"_27402":122923,"_2946":123118},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3462":72346,"_30116":72268,"_20912":123120,"_5":14363,"_27402":122927,"_2946":123121},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3462":72347,"_30116":72268,"_20912":123123,"_5":14363,"_27402":122927,"_2946":123124},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3462":72348,"_30116":72268,"_20912":123126,"_5":14363,"_27402":122927,"_2946":123127},[],"**Key Name**: nombre descriptivo.",{"_3462":72349,"_30116":72268,"_20912":123129,"_5":14363,"_27402":122927,"_2946":123130},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3462":72350,"_30116":72268,"_20912":123132,"_5":14363,"_27402":122927,"_2946":123133},[],"**Tags**: etiquetas asociadas.",{"_3462":72351,"_30116":72268,"_20912":123135,"_5":14363,"_27402":122927,"_2946":123136},[],"**Aliases**: nombres alternativos.",{"_3462":72352,"_30116":72268,"_20912":123138,"_5":14363,"_27402":122927,"_2946":123139},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3462":72353,"_30116":72268,"_20912":123141,"_5":14363,"_27402":122927,"_2946":123142},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3462":72354,"_30116":72268,"_20912":123144,"_5":14363,"_27402":122927,"_2946":123145},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3462":72355,"_30116":72268,"_20912":123147,"_5":14363,"_27402":122927,"_2946":123148},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3462":72356,"_30116":72268,"_20912":123150,"_5":14363,"_27402":122931,"_2946":123151},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3462":72357,"_30116":72268,"_20912":123153,"_5":14363,"_27402":122931,"_2946":123154},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3462":72358,"_30116":72268,"_20912":123156,"_5":14363,"_27402":122931,"_2946":123157},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3462":72359,"_30116":72268,"_20912":123159,"_5":14363,"_27402":122935,"_2946":123160},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3462":72360,"_30116":72268,"_20912":123162,"_5":14363,"_27402":122935,"_2946":123163},[],"Campos principales:",{"_3462":72361,"_30116":72268,"_20912":123165,"_5":14363,"_27402":122935,"_2946":123166},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3462":72362,"_30116":72268,"_20912":123168,"_5":14363,"_27402":122935,"_2946":123169},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3462":72363,"_30116":72268,"_20912":123171,"_5":14363,"_27402":122935,"_2946":123172},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3462":72364,"_30116":72268,"_20912":123174,"_5":14363,"_27402":122935,"_2946":123175},[],"**Message**: contenido que se va a firmar.",{"_3462":72365,"_30116":72268,"_20912":123177,"_5":14363,"_27402":122935,"_2946":123178},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3462":72366,"_30116":72268,"_20912":123180,"_5":14363,"_27402":122938,"_2946":123181},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3462":72367,"_30116":72268,"_20912":123183,"_5":14363,"_27402":122938,"_2946":123163},[],{"_3462":72368,"_30116":72268,"_20912":123185,"_5":14363,"_27402":122938,"_2946":123186},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3462":72369,"_30116":72268,"_20912":123188,"_5":14363,"_27402":122938,"_2946":123189},[],"**Message Type**: `Raw` o `Digest`.",{"_3462":72370,"_30116":72268,"_20912":123191,"_5":14363,"_27402":122938,"_2946":123192},[],"**Payload Encoding**: codificación del mensaje.",{"_3462":72371,"_30116":72268,"_20912":123194,"_5":14363,"_27402":122938,"_2946":123195},[],"**Message**: mensaje original o hash.",{"_3462":72372,"_30116":72268,"_20912":123197,"_5":14363,"_27402":122938,"_2946":123198},[],"**Signature**: firma que se desea comprobar.",{"_3462":72373,"_30116":72268,"_20912":123200,"_5":14363,"_27402":122938,"_2946":123201},[],"**Result**: indicador del resultado de la validación.",{"_3462":72374,"_30116":72268,"_20912":123203,"_5":14363,"_27402":122941,"_2946":123204},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3462":72375,"_30116":72268,"_20912":123206,"_5":14363,"_27402":122941,"_2946":123207},[],"Este flujo es útil para:",{"_3462":72376,"_30116":72268,"_20912":123209,"_5":14363,"_27402":122941,"_2946":123210},[],"Solicitar certificados a una CA externa.",{"_3462":72377,"_30116":72268,"_20912":123212,"_5":14363,"_27402":122941,"_2946":123213},[],"Renovar una identidad manteniendo la misma clave.",{"_3462":72378,"_30116":72268,"_20912":123215,"_5":14363,"_27402":122941,"_2946":123216},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3462":72379,"_30116":72268,"_20912":123218,"_5":14363,"_27402":122941,"_2946":123219},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3462":72380,"_30116":72268,"_20912":123221,"_5":14363,"_27402":122941,"_2946":123222},[],"**Organization (O)**: organización o empresa.",{"_3462":72381,"_30116":72268,"_20912":123224,"_5":14363,"_27402":122941,"_2946":123225},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3462":72382,"_30116":72268,"_20912":123227,"_5":14363,"_27402":122941,"_2946":123228},[],"**Country (C)**: código de país de dos letras.",{"_3462":72383,"_30116":72268,"_20912":123230,"_5":14363,"_27402":122941,"_2946":123231},[],"**State / Province (ST)**: estado o provincia.",{"_3462":72384,"_30116":72268,"_20912":123233,"_5":14363,"_27402":122941,"_2946":123234},[],"**Locality (L)**: ciudad o localidad.",{"_3462":72385,"_30116":72268,"_20912":123236,"_5":14363,"_27402":122941,"_2946":123237},[],"**Email Address**: correo de contacto.",{"_3462":72386,"_30116":72268,"_20912":123239,"_5":14363,"_27402":122941,"_2946":123240},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3462":72387,"_30116":72268,"_20912":123242,"_5":14363,"_27402":122941,"_2946":123243},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3462":72388,"_30116":72268,"_20912":123245,"_5":14363,"_27402":122945,"_2946":123246},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3462":72389,"_30116":72268,"_20912":123248,"_5":14363,"_27402":122945,"_2946":123249},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3462":72390,"_30116":72268,"_20912":123251,"_5":14363,"_27402":122949,"_2946":123252},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3462":72391,"_30116":72268,"_20912":123254,"_5":14363,"_27402":122949,"_2946":123255},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3462":72392,"_30116":72392,"_5":14715,"_2946":123257,"_30468":123258,"_20912":123259,"_27402":72392},"Validación online con OCSP",[49167,117513,54640,122028],[],{"_3462":72393,"_30116":72392,"_20912":123261,"_5":14363,"_27402":72392,"_2946":123262},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3462":72394,"_30116":72392,"_5":30465,"_20912":123264,"_27402":123265,"_2946":123266},[],"/docs/pr-preview/pr-64/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3462":72395,"_30116":72392,"_5":30465,"_20912":123268,"_27402":123269,"_2946":123270},[],"/docs/pr-preview/pr-64/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3462":72396,"_30116":72392,"_5":30465,"_20912":123272,"_27402":123273,"_2946":123274},[],"/docs/pr-preview/pr-64/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3462":72397,"_30116":72392,"_5":30465,"_20912":123276,"_27402":123277,"_2946":123278},[],"/docs/pr-preview/pr-64/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3462":72398,"_30116":72392,"_5":30465,"_20912":123280,"_27402":123281,"_2946":123282},[],"/docs/pr-preview/pr-64/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3462":72399,"_30116":72392,"_5":30465,"_20912":123284,"_27402":123285,"_2946":122595},[],"/docs/pr-preview/pr-64/es/platform/pki/ocsp#referencias",{"_3462":72400,"_30116":72392,"_20912":123287,"_5":14363,"_27402":72392,"_2946":123288},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3462":72401,"_30116":72392,"_20912":123290,"_5":14363,"_27402":123265,"_2946":123291},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3462":72402,"_30116":72392,"_20912":123293,"_5":14363,"_27402":123265,"_2946":123294},[],"Estado del registro",{"_3462":72403,"_30116":72392,"_20912":123296,"_5":14363,"_27402":123265,"_2946":123297},[],"Respuesta firmada",{"_3462":72404,"_30116":72392,"_20912":123299,"_5":14363,"_27402":123265,"_2946":53777},[],{"_3462":72405,"_30116":72392,"_20912":123301,"_5":14363,"_27402":123265,"_2946":56578},[],{"_3462":72406,"_30116":72392,"_20912":123303,"_5":14363,"_27402":123265,"_2946":53794},[],{"_3462":72407,"_30116":72392,"_20912":123305,"_5":14363,"_27402":123265,"_2946":123306},[],"`Revoked`, con razón y fecha de revocación.",{"_3462":72408,"_30116":72392,"_20912":123308,"_5":14363,"_27402":123265,"_2946":123309},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3462":72409,"_30116":72392,"_20912":123311,"_5":14363,"_27402":123265,"_2946":123312},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3462":72410,"_30116":72392,"_20912":123314,"_5":14363,"_27402":123265,"_2946":123315},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3462":72411,"_30116":72392,"_20912":123317,"_5":14363,"_27402":123265,"_2946":123318},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3462":72412,"_30116":72392,"_20912":123320,"_5":14363,"_27402":123265,"_2946":123321},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3462":72413,"_30116":72392,"_20912":123323,"_5":14363,"_27402":123269,"_2946":123324},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3462":72414,"_30116":72392,"_20912":123326,"_5":14363,"_27402":123269,"_2946":123327},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3462":72415,"_30116":72392,"_20912":123329,"_5":14363,"_27402":123273,"_2946":123330},[],"El servicio acepta:",{"_3462":72416,"_30116":72392,"_20912":123332,"_5":14363,"_27402":123273,"_2946":119243},[],{"_3462":72417,"_30116":72392,"_20912":123334,"_5":14363,"_27402":123273,"_2946":123335},[],"Ruta del servicio VA",{"_3462":72418,"_30116":72392,"_20912":123337,"_5":14363,"_27402":123273,"_2946":123338},[],"Formato",{"_3462":72419,"_30116":72392,"_20912":123340,"_5":14363,"_27402":123273,"_2946":56618},[],{"_3462":72420,"_30116":72392,"_20912":123342,"_5":14363,"_27402":123273,"_2946":56621},[],{"_3462":72421,"_30116":72392,"_20912":123344,"_5":14363,"_27402":123273,"_2946":123345},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3462":72422,"_30116":72392,"_20912":123347,"_5":14363,"_27402":123273,"_2946":56030},[],{"_3462":72423,"_30116":72392,"_20912":123349,"_5":14363,"_27402":123273,"_2946":56629},[],{"_3462":72424,"_30116":72392,"_20912":123351,"_5":14363,"_27402":123273,"_2946":123352},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3462":72425,"_30116":72392,"_20912":123354,"_5":14363,"_27402":123273,"_2946":123355},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3462":72426,"_30116":72392,"_20912":123357,"_5":14363,"_27402":123277,"_2946":123358},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3462":72427,"_30116":72392,"_20912":123360,"_5":14363,"_27402":123277,"_2946":123361},[],"Genera la solicitud:",{"_3462":72428,"_30116":72392,"_20912":123363,"_5":14363,"_27402":123277,"_2946":123364},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3462":72429,"_30116":72392,"_20912":123366,"_5":14363,"_27402":123277,"_2946":123367},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3462":72430,"_30116":72392,"_20912":123369,"_5":14363,"_27402":123277,"_2946":123370},[],"Verifica el DER recibido:",{"_3462":72431,"_30116":72392,"_20912":123372,"_5":14363,"_27402":123277,"_2946":123373},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3462":72432,"_30116":72392,"_20912":123375,"_5":14363,"_27402":123281,"_2946":123376},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3462":72433,"_30116":72392,"_20912":123378,"_5":14363,"_27402":123281,"_2946":123379},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3462":72434,"_30116":72392,"_20912":123381,"_5":14363,"_27402":123285,"_2946":56662},[],{"_3462":72435,"_30116":72392,"_20912":123383,"_5":14363,"_27402":123285,"_2946":56665},[],{"_3462":72436,"_30116":72392,"_20912":123385,"_5":14363,"_27402":123285,"_2946":123386},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3462":72437,"_30116":72392,"_20912":123388,"_5":14363,"_27402":123285,"_2946":122871},[],{"_3462":72438,"_30116":72438,"_5":14715,"_2946":54640,"_30468":123390,"_20912":123391,"_27402":72438},[49167,117513,54640],[],{"_3462":72439,"_30116":72438,"_20912":123393,"_5":14363,"_27402":72438,"_2946":123394},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3462":72440,"_30116":72438,"_5":30465,"_20912":123396,"_27402":123397,"_2946":120717},[],"/docs/pr-preview/pr-64/es/platform/pki/overview#empieza-aquí",{"_3462":72441,"_30116":72438,"_5":30465,"_20912":123399,"_27402":123400,"_2946":123401},[],"/docs/pr-preview/pr-64/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3462":72442,"_30116":72438,"_5":30465,"_20912":123403,"_27402":123404,"_2946":121237},[],"/docs/pr-preview/pr-64/es/platform/pki/overview#capacidades-principales",{"_3462":72443,"_30116":72438,"_5":30465,"_20912":123406,"_27402":123407,"_2946":121241},[],"/docs/pr-preview/pr-64/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3462":72444,"_30116":72438,"_5":30465,"_20912":123409,"_27402":123410,"_2946":121245},[],"/docs/pr-preview/pr-64/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3462":72445,"_30116":72438,"_5":30465,"_20912":123412,"_27402":123413,"_2946":121249},[],"/docs/pr-preview/pr-64/es/platform/pki/overview#emite-y-controla-certificados",{"_3462":72446,"_30116":72438,"_5":30465,"_20912":123415,"_27402":123416,"_2946":121257},[],"/docs/pr-preview/pr-64/es/platform/pki/overview#publica-el-estado-de-validación",{"_3462":72447,"_30116":72438,"_5":30465,"_20912":123418,"_27402":123419,"_2946":123420},[],"/docs/pr-preview/pr-64/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3462":72448,"_30116":72438,"_5":30465,"_20912":123422,"_27402":123423,"_2946":122194},[],"/docs/pr-preview/pr-64/es/platform/pki/overview#continúa",{"_3462":72449,"_30116":72438,"_20912":123425,"_5":14363,"_27402":72438,"_2946":123426},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3462":72450,"_30116":72438,"_20912":123428,"_5":14363,"_27402":123397,"_2946":123429},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3462":72451,"_30116":72438,"_20912":123431,"_5":14363,"_27402":123397,"_2946":123432},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3462":72452,"_30116":72438,"_20912":123434,"_5":14363,"_27402":123400,"_2946":123435},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3462":72453,"_30116":72438,"_20912":123437,"_5":14363,"_27402":123400,"_2946":123438},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3462":72454,"_30116":72438,"_20912":123440,"_5":14363,"_27402":123400,"_2946":123441},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3462":72455,"_30116":72438,"_20912":123443,"_5":14363,"_27402":123400,"_2946":123444},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3462":72456,"_30116":72438,"_20912":123446,"_5":14363,"_27402":123400,"_2946":123447},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3462":72457,"_30116":72438,"_20912":123449,"_5":14363,"_27402":123407,"_2946":123450},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3462":72458,"_30116":72438,"_20912":123452,"_5":14363,"_27402":123410,"_2946":123453},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3462":72459,"_30116":72438,"_20912":123455,"_5":14363,"_27402":123413,"_2946":123456},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3462":72460,"_30116":72438,"_20912":123458,"_5":14363,"_27402":123416,"_2946":123459},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3462":72461,"_30116":72438,"_20912":123461,"_5":14363,"_27402":123419,"_2946":123462},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3462":72462,"_30116":72438,"_20912":123464,"_5":14363,"_27402":123419,"_2946":123465},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3462":72463,"_30116":72438,"_20912":123467,"_5":14363,"_27402":123419,"_2946":123468},[],"su clave pública corresponda a la clave privada del cliente;",{"_3462":72464,"_30116":72438,"_20912":123470,"_5":14363,"_27402":123419,"_2946":123471},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3462":72465,"_30116":72438,"_20912":123473,"_5":14363,"_27402":123419,"_2946":123474},[],"sus fechas y usos permitan la operación;",{"_3462":72466,"_30116":72438,"_20912":123476,"_5":14363,"_27402":123419,"_2946":123477},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3462":72467,"_30116":72438,"_20912":123479,"_5":14363,"_27402":123419,"_2946":123480},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3462":72468,"_30116":72438,"_20912":123482,"_5":14363,"_27402":123423,"_2946":123483},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3462":72469,"_30116":72438,"_20912":123485,"_5":14363,"_27402":123423,"_2946":123486},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3462":72470,"_30116":72438,"_20912":123488,"_5":14363,"_27402":123423,"_2946":123489},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3462":72471,"_30116":72471,"_5":14715,"_2946":123491,"_30468":123492,"_20912":123493,"_27402":72471},"Crea tu primera CA",[49167,117513,54640,120841],[],{"_3462":72472,"_30116":72471,"_20912":123495,"_5":14363,"_27402":72471,"_2946":123496},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3462":72473,"_30116":72471,"_5":30465,"_20912":123498,"_27402":123499,"_2946":116091},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3462":72474,"_30116":72471,"_5":30465,"_20912":123501,"_27402":123502,"_2946":123503},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3462":72475,"_30116":72471,"_5":30465,"_20912":123505,"_27402":123506,"_2946":123507},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3462":72476,"_30116":72471,"_5":30465,"_20912":123509,"_27402":123510,"_2946":123511},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3462":72477,"_30116":72471,"_5":30465,"_20912":123513,"_27402":123514,"_2946":123515},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3462":72478,"_30116":72471,"_5":30465,"_20912":123517,"_27402":123518,"_2946":123519},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3462":72479,"_30116":72471,"_5":30465,"_20912":123521,"_27402":123522,"_2946":123523},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3462":72480,"_30116":72471,"_5":30465,"_20912":123525,"_27402":123526,"_2946":121088},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3462":72481,"_30116":72471,"_5":30465,"_20912":123528,"_27402":123529,"_2946":116115},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3462":72482,"_30116":72471,"_20912":123531,"_5":14363,"_27402":72471,"_2946":123532},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3462":72483,"_30116":72471,"_20912":123534,"_5":14363,"_27402":123499,"_2946":123535},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3462":72484,"_30116":72471,"_20912":123537,"_5":14363,"_27402":123499,"_2946":123538},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3462":72485,"_30116":72471,"_20912":123540,"_5":14363,"_27402":123499,"_2946":123541},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3462":72486,"_30116":72471,"_20912":123543,"_5":14363,"_27402":123499,"_2946":123544},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3462":72487,"_30116":72471,"_20912":123546,"_5":14363,"_27402":123502,"_2946":123547},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3462":72488,"_30116":72471,"_20912":123549,"_5":14363,"_27402":123502,"_2946":123550},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3462":72489,"_30116":72471,"_20912":123552,"_5":14363,"_27402":123506,"_2946":123553},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3462":72490,"_30116":72471,"_20912":123555,"_5":14363,"_27402":123506,"_2946":123556},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3462":72491,"_30116":72471,"_20912":123558,"_5":14363,"_27402":123510,"_2946":123559},[],"Selecciona **Root CA** y completa:",{"_3462":72492,"_30116":72471,"_20912":123561,"_5":14363,"_27402":123510,"_2946":56844},[],{"_3462":72493,"_30116":72471,"_20912":123563,"_5":14363,"_27402":123510,"_2946":123564},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3462":72494,"_30116":72471,"_20912":123566,"_5":14363,"_27402":123510,"_2946":123567},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3462":72495,"_30116":72471,"_20912":123569,"_5":14363,"_27402":123510,"_2946":123570},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3462":72496,"_30116":72471,"_20912":123572,"_5":14363,"_27402":123510,"_2946":123573},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3462":72497,"_30116":72471,"_20912":123575,"_5":14363,"_27402":123514,"_2946":123576},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3462":72498,"_30116":72471,"_20912":123578,"_5":14363,"_27402":123518,"_2946":123579},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3462":72499,"_30116":72471,"_20912":123581,"_5":14363,"_27402":123518,"_2946":123582},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3462":72500,"_30116":72471,"_20912":123584,"_5":14363,"_27402":123522,"_2946":123585},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3462":72501,"_30116":72471,"_20912":123587,"_5":14363,"_27402":123522,"_2946":123588},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3462":72502,"_30116":72471,"_20912":123590,"_5":14363,"_27402":123522,"_2946":123591},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3462":72503,"_30116":72471,"_20912":123593,"_5":14363,"_27402":123526,"_2946":123594},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3462":72504,"_30116":72471,"_20912":123596,"_5":14363,"_27402":123526,"_2946":123597},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3462":72505,"_30116":72471,"_20912":123599,"_5":14363,"_27402":123526,"_2946":123600},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3462":72506,"_30116":72471,"_20912":123602,"_5":14363,"_27402":123526,"_2946":123603},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3462":72507,"_30116":72471,"_20912":123605,"_5":14363,"_27402":123529,"_2946":123606},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3462":72508,"_30116":72508,"_5":14715,"_2946":123608,"_30468":123609,"_20912":123610,"_27402":72508},"Emite y verifica un certificado",[49167,117513,54640,120841],[],{"_3462":72509,"_30116":72508,"_20912":123612,"_5":14363,"_27402":72508,"_2946":123613},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3462":72510,"_30116":72508,"_5":30465,"_20912":123615,"_27402":123616,"_2946":116091},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3462":72511,"_30116":72508,"_5":30465,"_20912":123618,"_27402":123619,"_2946":123620},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3462":72512,"_30116":72508,"_5":30465,"_20912":123622,"_27402":123623,"_2946":123624},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3462":72513,"_30116":72508,"_5":30465,"_20912":123626,"_27402":123627,"_2946":123628},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3462":72514,"_30116":72508,"_5":30465,"_20912":123630,"_27402":123631,"_2946":123632},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3462":72515,"_30116":72508,"_5":30465,"_20912":123634,"_27402":123635,"_2946":123636},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3462":72516,"_30116":72508,"_5":30465,"_20912":123638,"_27402":123639,"_2946":123640},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3462":72517,"_30116":72508,"_5":30465,"_20912":123642,"_27402":123643,"_2946":123644},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3462":72518,"_30116":72508,"_5":30465,"_20912":123646,"_27402":123647,"_2946":123648},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3462":72519,"_30116":72508,"_5":30465,"_20912":123650,"_27402":123651,"_2946":123652},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3462":72520,"_30116":72508,"_5":30465,"_20912":123654,"_27402":123655,"_2946":121088},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3462":72521,"_30116":72508,"_5":30465,"_20912":123657,"_27402":123658,"_2946":116115},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3462":72522,"_30116":72508,"_20912":123660,"_5":14363,"_27402":72508,"_2946":123661},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3462":72523,"_30116":72508,"_20912":123663,"_5":14363,"_27402":123616,"_2946":123664},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3462":72524,"_30116":72508,"_20912":123666,"_5":14363,"_27402":123616,"_2946":123667},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3462":72525,"_30116":72508,"_20912":123669,"_5":14363,"_27402":123616,"_2946":123670},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3462":72526,"_30116":72508,"_20912":123672,"_5":14363,"_27402":123616,"_2946":123673},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3462":72527,"_30116":72508,"_20912":123675,"_5":14363,"_27402":123616,"_2946":123676},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3462":72528,"_30116":72508,"_20912":123678,"_5":14363,"_27402":123619,"_2946":123679},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3462":72529,"_30116":72508,"_20912":123681,"_5":14363,"_27402":123623,"_2946":123682},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3462":72530,"_30116":72508,"_20912":123684,"_5":14363,"_27402":123623,"_2946":123685},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3462":72531,"_30116":72508,"_20912":123687,"_5":14363,"_27402":123627,"_2946":123688},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3462":72532,"_30116":72508,"_20912":123690,"_5":14363,"_27402":123627,"_2946":123691},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3462":72533,"_30116":72508,"_20912":123693,"_5":14363,"_27402":123631,"_2946":123694},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3462":72534,"_30116":72508,"_20912":123696,"_5":14363,"_27402":123631,"_2946":123697},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3462":72535,"_30116":72508,"_20912":123699,"_5":14363,"_27402":123635,"_2946":123700},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3462":72536,"_30116":72508,"_20912":123702,"_5":14363,"_27402":123639,"_2946":123703},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3462":72537,"_30116":72508,"_20912":123705,"_5":14363,"_27402":123643,"_2946":123706},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3462":72538,"_30116":72508,"_20912":123708,"_5":14363,"_27402":123647,"_2946":123709},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3462":72539,"_30116":72508,"_20912":123711,"_5":14363,"_27402":123647,"_2946":123712},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3462":72540,"_30116":72508,"_20912":123714,"_5":14363,"_27402":123647,"_2946":123715},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3462":72541,"_30116":72508,"_20912":123717,"_5":14363,"_27402":123651,"_2946":123718},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3462":72542,"_30116":72508,"_20912":123720,"_5":14363,"_27402":123651,"_2946":123721},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3462":72543,"_30116":72508,"_20912":123723,"_5":14363,"_27402":123651,"_2946":123724},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3462":72544,"_30116":72508,"_20912":123726,"_5":14363,"_27402":123655,"_2946":121171},[],{"_3462":72545,"_30116":72508,"_20912":123728,"_5":14363,"_27402":123655,"_2946":119692},[],{"_3462":72546,"_30116":72508,"_20912":123730,"_5":14363,"_27402":123655,"_2946":123731},[],"La CA rechaza la emisión",{"_3462":72547,"_30116":72508,"_20912":123733,"_5":14363,"_27402":123655,"_2946":123734},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3462":72548,"_30116":72508,"_20912":123736,"_5":14363,"_27402":123655,"_2946":123737},[],"Sujeto o usos diferentes",{"_3462":72549,"_30116":72508,"_20912":123739,"_5":14363,"_27402":123655,"_2946":123740},[],"Perfil aplicado y valores solicitados.",{"_3462":72550,"_30116":72508,"_20912":123742,"_5":14363,"_27402":123655,"_2946":123743},[],"No se encuentra el emisor",{"_3462":72551,"_30116":72508,"_20912":123745,"_5":14363,"_27402":123655,"_2946":123746},[],"CA descargada y cadena intermedia necesaria.",{"_3462":72552,"_30116":72508,"_20912":123748,"_5":14363,"_27402":123655,"_2946":123749},[],"Falla la vigencia",{"_3462":72553,"_30116":72508,"_20912":123751,"_5":14363,"_27402":123655,"_2946":123752},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3462":72554,"_30116":72508,"_20912":123754,"_5":14363,"_27402":123655,"_2946":123755},[],"Los resúmenes de clave difieren",{"_3462":72555,"_30116":72508,"_20912":123757,"_5":14363,"_27402":123655,"_2946":123758},[],"Archivos de certificado y clave de la misma emisión.",{"_3462":72556,"_30116":72508,"_20912":123760,"_5":14363,"_27402":123655,"_2946":123761},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3462":72557,"_30116":72508,"_20912":123763,"_5":14363,"_27402":123658,"_2946":123764},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3462":72558,"_30116":72508,"_20912":123766,"_5":14363,"_27402":123658,"_2946":123767},[],"Gestionar certificados para inspección, estado y revocación.",{"_3462":72559,"_30116":72508,"_20912":123769,"_5":14363,"_27402":123658,"_2946":123770},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3462":72560,"_30116":72508,"_20912":123772,"_5":14363,"_27402":123658,"_2946":123773},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3462":72561,"_30116":72508,"_20912":123775,"_5":14363,"_27402":123658,"_2946":123776},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3462":72562,"_30116":72562,"_5":14715,"_2946":123778,"_30468":123779,"_20912":123780,"_27402":72562},"Primeros pasos de PKI",[49167,117513,54640,120841],[],{"_3462":72563,"_30116":72562,"_20912":123782,"_5":14363,"_27402":72562,"_2946":123783},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3462":72564,"_30116":72562,"_5":30465,"_20912":123785,"_27402":123786,"_2946":116091},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3462":72565,"_30116":72562,"_5":30465,"_20912":123788,"_27402":123789,"_2946":123790},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3462":72566,"_30116":72562,"_5":30465,"_20912":123792,"_27402":123793,"_2946":121023},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3462":72567,"_30116":72562,"_5":30465,"_20912":123795,"_27402":123796,"_2946":123797},[],"/docs/pr-preview/pr-64/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3462":72568,"_30116":72562,"_20912":123799,"_5":14363,"_27402":72562,"_2946":123800},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3462":72569,"_30116":72562,"_20912":123802,"_5":14363,"_27402":123786,"_2946":123803},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3462":72570,"_30116":72562,"_20912":123805,"_5":14363,"_27402":123786,"_2946":123806},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3462":72571,"_30116":72562,"_20912":123808,"_5":14363,"_27402":123786,"_2946":123809},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3462":72572,"_30116":72562,"_20912":123811,"_5":14363,"_27402":123786,"_2946":123812},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3462":72573,"_30116":72562,"_20912":123814,"_5":14363,"_27402":123786,"_2946":123815},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3462":72574,"_30116":72562,"_20912":123817,"_5":14363,"_27402":123789,"_2946":123818},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3462":72575,"_30116":72562,"_20912":123820,"_5":14363,"_27402":123789,"_2946":123821},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3462":72576,"_30116":72562,"_20912":123823,"_5":14363,"_27402":123789,"_2946":123824},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3462":72577,"_30116":72562,"_20912":123826,"_5":14363,"_27402":123789,"_2946":123827},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3462":72578,"_30116":72562,"_20912":123829,"_5":14363,"_27402":123793,"_2946":123830},[],"Archivo o recurso",{"_3462":72579,"_30116":72562,"_20912":123832,"_5":14363,"_27402":123793,"_2946":121020},[],{"_3462":72580,"_30116":72562,"_20912":123834,"_5":14363,"_27402":123793,"_2946":123835},[],"CA raíz activa y `ca.pem`",{"_3462":72581,"_30116":72562,"_20912":123837,"_5":14363,"_27402":123793,"_2946":123838},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3462":72582,"_30116":72562,"_20912":123840,"_5":14363,"_27402":123793,"_2946":123841},[],"Certificado final y `device.crt`",{"_3462":72583,"_30116":72562,"_20912":123843,"_5":14363,"_27402":123793,"_2946":123844},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3462":72584,"_30116":72562,"_20912":123846,"_5":14363,"_27402":123793,"_2946":123847},[],"Clave privada `device.key`",{"_3462":72585,"_30116":72562,"_20912":123849,"_5":14363,"_27402":123793,"_2946":123850},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3462":72586,"_30116":72562,"_20912":123852,"_5":14363,"_27402":123793,"_2946":123853},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3462":72587,"_30116":72562,"_20912":123855,"_5":14363,"_27402":123796,"_2946":123856},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3462":72588,"_30116":72562,"_20912":123858,"_5":14363,"_27402":123796,"_2946":123859},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3462":72589,"_30116":72562,"_20912":123861,"_5":14363,"_27402":123796,"_2946":123862},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3462":72590,"_30116":72590,"_5":14715,"_2946":123864,"_30468":123865,"_20912":123867,"_27402":72590},"Resolución de problemas PKI",[49167,117513,54640,123866],"Resolución de problemas",[],{"_3462":72591,"_30116":72590,"_20912":123869,"_5":14363,"_27402":72590,"_2946":123870},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3462":72592,"_30116":72590,"_5":30465,"_20912":123872,"_27402":123873,"_2946":123874},[],"/docs/pr-preview/pr-64/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3462":72593,"_30116":72590,"_5":30465,"_20912":123876,"_27402":123877,"_2946":123878},[],"/docs/pr-preview/pr-64/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3462":72594,"_30116":72590,"_5":30465,"_20912":123880,"_27402":123881,"_2946":123882},[],"/docs/pr-preview/pr-64/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3462":72595,"_30116":72590,"_20912":123884,"_5":14363,"_27402":72590,"_2946":123885},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3462":72596,"_30116":72590,"_20912":123887,"_5":14363,"_27402":72590,"_2946":123888},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3462":72597,"_30116":72590,"_20912":123890,"_5":14363,"_27402":123873,"_2946":121020},[],{"_3462":72598,"_30116":72590,"_20912":123892,"_5":14363,"_27402":123873,"_2946":119692},[],{"_3462":72599,"_30116":72590,"_20912":123894,"_5":14363,"_27402":123873,"_2946":116115},[],{"_3462":72600,"_30116":72590,"_20912":123896,"_5":14363,"_27402":123873,"_2946":53482},[],{"_3462":72601,"_30116":72590,"_20912":123898,"_5":14363,"_27402":123873,"_2946":123899},[],"Existe, está activa y sus fechas son utilizables.",{"_3462":72602,"_30116":72590,"_20912":123901,"_5":14363,"_27402":123873,"_2946":123902},[],"Autoridades.",{"_3462":72603,"_30116":72590,"_20912":123904,"_5":14363,"_27402":123873,"_2946":123905},[],"Clave",{"_3462":72604,"_30116":72590,"_20912":123907,"_5":14363,"_27402":123873,"_2946":123908},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3462":72605,"_30116":72590,"_20912":123910,"_5":14363,"_27402":123873,"_2946":123911},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3462":72606,"_30116":72590,"_20912":123913,"_5":14363,"_27402":123873,"_2946":57198},[],{"_3462":72607,"_30116":72590,"_20912":123915,"_5":14363,"_27402":123873,"_2946":123916},[],"PEM correcto y firma verificable.",{"_3462":72608,"_30116":72590,"_20912":123918,"_5":14363,"_27402":123873,"_2946":57204},[],{"_3462":72609,"_30116":72590,"_20912":123920,"_5":14363,"_27402":123873,"_2946":123921},[],"Perfil",{"_3462":72610,"_30116":72590,"_20912":123923,"_5":14363,"_27402":123873,"_2946":123924},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3462":72611,"_30116":72590,"_20912":123926,"_5":14363,"_27402":123873,"_2946":123927},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3462":72612,"_30116":72590,"_20912":123929,"_5":14363,"_27402":123873,"_2946":121171},[],{"_3462":72613,"_30116":72590,"_20912":123931,"_5":14363,"_27402":123873,"_2946":123932},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3462":72614,"_30116":72590,"_20912":123934,"_5":14363,"_27402":123873,"_2946":123935},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3462":72615,"_30116":72590,"_20912":123937,"_5":14363,"_27402":123873,"_2946":123938},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3462":72616,"_30116":72590,"_20912":123940,"_5":14363,"_27402":123873,"_2946":123941},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3462":72617,"_30116":72590,"_20912":123943,"_5":14363,"_27402":123877,"_2946":123944},[],"Revisa cada frontera por separado:",{"_3462":72618,"_30116":72590,"_20912":123946,"_5":14363,"_27402":123877,"_2946":123947},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3462":72619,"_30116":72590,"_20912":123949,"_5":14363,"_27402":123877,"_2946":123950},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3462":72620,"_30116":72590,"_20912":123952,"_5":14363,"_27402":123877,"_2946":123953},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3462":72621,"_30116":72590,"_20912":123955,"_5":14363,"_27402":123877,"_2946":123956},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3462":72622,"_30116":72590,"_20912":123958,"_5":14363,"_27402":123877,"_2946":123959},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3462":72623,"_30116":72590,"_20912":123961,"_5":14363,"_27402":123877,"_2946":123962},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3462":72624,"_30116":72590,"_20912":123964,"_5":14363,"_27402":123881,"_2946":123965},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3462":72625,"_30116":72590,"_20912":123967,"_5":14363,"_27402":123881,"_2946":123968},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3462":72626,"_30116":72626,"_5":14715,"_2946":123970,"_30468":123971,"_20912":123972,"_27402":72626},"Seguridad",[49167],[],{"_3462":72627,"_30116":72626,"_20912":123974,"_5":14363,"_27402":72626,"_2946":123975},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3462":72628,"_30116":72626,"_5":30465,"_20912":123977,"_27402":123978,"_2946":123979},[],"/docs/pr-preview/pr-64/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3462":72629,"_30116":72626,"_5":30465,"_20912":123981,"_27402":123982,"_2946":123983},[],"/docs/pr-preview/pr-64/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3462":72630,"_30116":72626,"_5":30465,"_20912":123985,"_27402":123986,"_2946":123987},[],"/docs/pr-preview/pr-64/es/security#versiones-soportadas","Versiones soportadas",{"_3462":72631,"_30116":72626,"_5":30465,"_20912":123989,"_27402":123990,"_2946":123991},[],"/docs/pr-preview/pr-64/es/security#divulgación-responsable","Divulgación responsable",{"_3462":72632,"_30116":72626,"_20912":123993,"_5":14363,"_27402":72626,"_2946":123994},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3462":72633,"_30116":72626,"_20912":123996,"_5":14363,"_27402":123978,"_2946":123997},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3462":72634,"_30116":72626,"_20912":123999,"_5":14363,"_27402":123978,"_2946":124000},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3462":72635,"_30116":72626,"_20912":124002,"_5":14363,"_27402":123978,"_2946":14988},[],{"_3462":72636,"_30116":72626,"_20912":124004,"_5":14363,"_27402":123978,"_2946":14928},[],{"_3462":72637,"_30116":72626,"_20912":124006,"_5":14363,"_27402":123978,"_2946":14975},[],{"_3462":72638,"_30116":72626,"_20912":124008,"_5":14363,"_27402":123978,"_2946":124009},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3462":72639,"_30116":72626,"_20912":124011,"_5":14363,"_27402":123978,"_2946":124012},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3462":72640,"_30116":72626,"_20912":124014,"_5":14363,"_27402":123982,"_2946":124015},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3462":72641,"_30116":72626,"_20912":124017,"_5":14363,"_27402":123982,"_2946":124018},[],"No incluyas en el reporte:",{"_3462":72642,"_30116":72626,"_20912":124020,"_5":14363,"_27402":123982,"_2946":124021},[],"Credenciales, tokens o claves privadas",{"_3462":72643,"_30116":72626,"_20912":124023,"_5":14363,"_27402":123982,"_2946":124024},[],"Datos de clientes o información identificable de clientes",{"_3462":72644,"_30116":72626,"_20912":124026,"_5":14363,"_27402":123982,"_2946":124027},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3462":72645,"_30116":72626,"_20912":124029,"_5":14363,"_27402":123986,"_2946":124030},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3462":72646,"_30116":72626,"_20912":124032,"_5":14363,"_27402":123986,"_2946":124033},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3462":72647,"_30116":72626,"_20912":124035,"_5":14363,"_27402":123990,"_2946":124036},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3462":72648,"_30116":72626,"_20912":124038,"_5":14363,"_27402":123990,"_2946":124039},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3462":72649,"_30116":72626,"_20912":124041,"_5":14363,"_27402":123990,"_2946":124042},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3462":72650,"_30116":72626,"_20912":124044,"_5":14363,"_27402":123990,"_2946":124045},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3462":72651,"_30116":72626,"_20912":124047,"_5":14363,"_27402":123990,"_2946":124048},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3462":72652,"_30116":72652,"_5":14715,"_2946":124050,"_30468":124051,"_20912":124053,"_27402":72652},"3.8.0 a 4.0.0",[49167,124052],"Actualizaciones",[],{"_3462":72653,"_30116":72652,"_20912":124055,"_5":14363,"_27402":72652,"_2946":124056},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3462":72654,"_30116":72652,"_5":30465,"_20912":124058,"_27402":124059,"_2946":124060},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3462":72655,"_30116":72652,"_5":30465,"_20912":124062,"_27402":124063,"_2946":124064},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3462":72656,"_30116":72652,"_5":30465,"_20912":124066,"_27402":124067,"_2946":124068},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3462":72657,"_30116":72652,"_5":30465,"_20912":124070,"_27402":124071,"_2946":124072},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3462":72658,"_30116":72652,"_5":30465,"_20912":124074,"_27402":124075,"_2946":124076},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3462":72659,"_30116":72652,"_5":30465,"_20912":124078,"_27402":124079,"_2946":124080},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3462":72660,"_30116":72652,"_5":30465,"_20912":124082,"_27402":124083,"_2946":57370},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3462":72661,"_30116":72652,"_5":30465,"_20912":124085,"_27402":124086,"_2946":124087},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3462":72662,"_30116":72652,"_5":30465,"_20912":124089,"_27402":124090,"_2946":124091},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3462":72663,"_30116":72652,"_5":30465,"_20912":124093,"_27402":124094,"_2946":124095},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3462":72664,"_30116":72652,"_5":30465,"_20912":124097,"_27402":124098,"_2946":124099},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3462":72665,"_30116":72652,"_5":30465,"_20912":124101,"_27402":124102,"_2946":124103},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3462":72666,"_30116":72652,"_5":30465,"_20912":124105,"_27402":124106,"_2946":124107},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3462":72667,"_30116":72652,"_5":30465,"_20912":124109,"_27402":124110,"_2946":124111},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3462":72668,"_30116":72652,"_5":30465,"_20912":124113,"_27402":124114,"_2946":124115},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3462":72669,"_30116":72652,"_5":30465,"_20912":124117,"_27402":124118,"_2946":124119},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3462":72670,"_30116":72652,"_5":30465,"_20912":124121,"_27402":124122,"_2946":124123},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3462":72671,"_30116":72652,"_5":30465,"_20912":124125,"_27402":124126,"_2946":124127},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3462":72672,"_30116":72652,"_5":30465,"_20912":124129,"_27402":124130,"_2946":124131},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3462":72673,"_30116":72652,"_5":30465,"_20912":124133,"_27402":124134,"_2946":124135},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3462":72674,"_30116":72652,"_5":30465,"_20912":124137,"_27402":124138,"_2946":124139},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3462":72675,"_30116":72652,"_5":30465,"_20912":124141,"_27402":124142,"_2946":124143},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3462":72676,"_30116":72652,"_5":30465,"_20912":124145,"_27402":124146,"_2946":124147},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3462":72677,"_30116":72652,"_5":30465,"_20912":124149,"_27402":124150,"_2946":124151},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3462":72678,"_30116":72652,"_5":30465,"_20912":124153,"_27402":124154,"_2946":124155},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3462":72679,"_30116":72652,"_5":30465,"_20912":124157,"_27402":124158,"_2946":124159},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3462":72680,"_30116":72652,"_5":30465,"_20912":124161,"_27402":124162,"_2946":124163},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3462":72681,"_30116":72652,"_5":30465,"_20912":124165,"_27402":124166,"_2946":124167},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3462":72682,"_30116":72652,"_5":30465,"_20912":124169,"_27402":124170,"_2946":124171},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3462":72683,"_30116":72652,"_5":30465,"_20912":124173,"_27402":124174,"_2946":124175},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3462":72684,"_30116":72652,"_5":30465,"_20912":124177,"_27402":124178,"_2946":124179},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3462":72685,"_30116":72652,"_5":30465,"_20912":124181,"_27402":124182,"_2946":124183},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3462":72686,"_30116":72652,"_5":30465,"_20912":124185,"_27402":124186,"_2946":124187},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3462":72687,"_30116":72652,"_5":30465,"_20912":124189,"_27402":124190,"_2946":124191},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3462":72688,"_30116":72652,"_5":30465,"_20912":124193,"_27402":124194,"_2946":124195},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3462":72689,"_30116":72652,"_5":30465,"_20912":124197,"_27402":124198,"_2946":124199},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3462":72690,"_30116":72652,"_5":30465,"_20912":124201,"_27402":124202,"_2946":124203},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3462":72691,"_30116":72652,"_5":30465,"_20912":124205,"_27402":124206,"_2946":124207},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3462":72692,"_30116":72652,"_5":30465,"_20912":124209,"_27402":124210,"_2946":124211},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3462":72693,"_30116":72652,"_5":30465,"_20912":124213,"_27402":124214,"_2946":124215},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3462":72694,"_30116":72652,"_5":30465,"_20912":124217,"_27402":124218,"_2946":120034},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3462":72695,"_30116":72652,"_5":30465,"_20912":124220,"_27402":124221,"_2946":124222},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3462":72696,"_30116":72652,"_5":30465,"_20912":124224,"_27402":124225,"_2946":124226},[],"/docs/pr-preview/pr-64/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3462":72697,"_30116":72652,"_20912":124228,"_5":14363,"_27402":72652,"_2946":124229},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3462":72698,"_30116":72652,"_20912":124231,"_5":14363,"_27402":72652,"_2946":124232},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3462":72699,"_30116":72652,"_20912":124234,"_5":14363,"_27402":72652,"_2946":124235},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3462":72700,"_30116":72652,"_20912":124237,"_5":14363,"_27402":72652,"_2946":124238},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3462":72701,"_30116":72652,"_20912":124240,"_5":14363,"_27402":72652,"_2946":124241},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3462":72702,"_30116":72652,"_20912":124243,"_5":14363,"_27402":72652,"_2946":124244},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3462":72703,"_30116":72652,"_20912":124246,"_5":14363,"_27402":72652,"_2946":124247},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3462":72704,"_30116":72652,"_20912":124249,"_5":14363,"_27402":124063,"_2946":124250},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3462":72705,"_30116":72652,"_20912":124252,"_5":14363,"_27402":124063,"_2946":124253},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3462":72706,"_30116":72652,"_20912":124255,"_5":14363,"_27402":124067,"_2946":124256},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3462":72707,"_30116":72652,"_20912":124258,"_5":14363,"_27402":124067,"_2946":124259},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3462":72708,"_30116":72652,"_20912":124261,"_5":14363,"_27402":124071,"_2946":124262},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3462":72709,"_30116":72652,"_20912":124264,"_5":14363,"_27402":124075,"_2946":124265},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3462":72710,"_30116":72652,"_20912":124267,"_5":14363,"_27402":124075,"_2946":124268},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3462":72711,"_30116":72652,"_20912":124270,"_5":14363,"_27402":124075,"_2946":124271},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3462":72712,"_30116":72652,"_20912":124273,"_5":14363,"_27402":124075,"_2946":124274},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3462":72713,"_30116":72652,"_20912":124276,"_5":14363,"_27402":124075,"_2946":124277},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3462":72714,"_30116":72652,"_20912":124279,"_5":14363,"_27402":124079,"_2946":124280},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3462":72715,"_30116":72652,"_20912":124282,"_5":14363,"_27402":124079,"_2946":124283},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3462":72716,"_30116":72652,"_20912":124285,"_5":14363,"_27402":124079,"_2946":124286},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3462":72717,"_30116":72652,"_20912":124288,"_5":14363,"_27402":124079,"_2946":124289},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3462":72718,"_30116":72652,"_20912":124291,"_5":14363,"_27402":124079,"_2946":124292},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3462":72719,"_30116":72652,"_20912":124294,"_5":14363,"_27402":124079,"_2946":124295},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3462":72720,"_30116":72652,"_20912":124297,"_5":14363,"_27402":124083,"_2946":124298},[],"Cambio",{"_3462":72721,"_30116":72652,"_20912":124300,"_5":14363,"_27402":124083,"_2946":124301},[],"A quién afecta",{"_3462":72722,"_30116":72652,"_20912":124303,"_5":14363,"_27402":124083,"_2946":124304},[],"Gravedad",{"_3462":72723,"_30116":72652,"_20912":124306,"_5":14363,"_27402":124083,"_2946":122801},[],{"_3462":72724,"_30116":72652,"_20912":124308,"_5":14363,"_27402":124083,"_2946":124091},[],{"_3462":72725,"_30116":72652,"_20912":124310,"_5":14363,"_27402":124083,"_2946":124311},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3462":72726,"_30116":72652,"_20912":124313,"_5":14363,"_27402":124083,"_2946":124314},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3462":72727,"_30116":72652,"_20912":124316,"_5":14363,"_27402":124083,"_2946":124317},[],"Copiar los datos a los volúmenes nuevos",{"_3462":72728,"_30116":72652,"_20912":124319,"_5":14363,"_27402":124083,"_2946":124095},[],{"_3462":72729,"_30116":72652,"_20912":124321,"_5":14363,"_27402":124083,"_2946":124322},[],"Todas las releases de Helm",{"_3462":72730,"_30116":72652,"_20912":124324,"_5":14363,"_27402":124083,"_2946":124325},[],"Alta: `helm upgrade` falla",{"_3462":72731,"_30116":72652,"_20912":124327,"_5":14363,"_27402":124083,"_2946":124328},[],"Eliminar o renombrar las claves heredadas",{"_3462":72732,"_30116":72652,"_20912":124330,"_5":14363,"_27402":124083,"_2946":124099},[],{"_3462":72733,"_30116":72652,"_20912":124332,"_5":14363,"_27402":124083,"_2946":124333},[],"Todos los despliegues",{"_3462":72734,"_30116":72652,"_20912":124335,"_5":14363,"_27402":124083,"_2946":124336},[],"Alta: sin principal de bootstrap no hay administrador",{"_3462":72735,"_30116":72652,"_20912":124338,"_5":14363,"_27402":124083,"_2946":124339},[],"Configurar `services.authz`",{"_3462":72736,"_30116":72652,"_20912":124341,"_5":14363,"_27402":124083,"_2946":124103},[],{"_3462":72737,"_30116":72652,"_20912":124343,"_5":14363,"_27402":124083,"_2946":124322},[],{"_3462":72738,"_30116":72652,"_20912":124345,"_5":14363,"_27402":124083,"_2946":124346},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3462":72739,"_30116":72652,"_20912":124348,"_5":14363,"_27402":124083,"_2946":124349},[],"Mover JWKS y roles a `services.authz`",{"_3462":72740,"_30116":72652,"_20912":124351,"_5":14363,"_27402":124083,"_2946":124123},[],{"_3462":72741,"_30116":72652,"_20912":124353,"_5":14363,"_27402":124083,"_2946":124354},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3462":72742,"_30116":72652,"_20912":124356,"_5":14363,"_27402":124083,"_2946":124357},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3462":72743,"_30116":72652,"_20912":124359,"_5":14363,"_27402":124083,"_2946":124360},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3462":72744,"_30116":72652,"_20912":124362,"_5":14363,"_27402":124083,"_2946":124127},[],{"_3462":72745,"_30116":72652,"_20912":124364,"_5":14363,"_27402":124083,"_2946":124365},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3462":72746,"_30116":72652,"_20912":124367,"_5":14363,"_27402":124083,"_2946":124368},[],"Alta: el backend ya no arranca con ellos",{"_3462":72747,"_30116":72652,"_20912":124370,"_5":14363,"_27402":124083,"_2946":124371},[],"Pasar a PostgreSQL antes de actualizar",{"_3462":72748,"_30116":72652,"_20912":124373,"_5":14363,"_27402":124083,"_2946":124171},[],{"_3462":72749,"_30116":72652,"_20912":124375,"_5":14363,"_27402":124083,"_2946":124376},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3462":72750,"_30116":72652,"_20912":124378,"_5":14363,"_27402":124083,"_2946":124379},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3462":72751,"_30116":72652,"_20912":124381,"_5":14363,"_27402":124083,"_2946":124382},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3462":72752,"_30116":72652,"_20912":124384,"_5":14363,"_27402":124083,"_2946":124385},[],"Webhooks con referencias a archivos",{"_3462":72753,"_30116":72652,"_20912":124387,"_5":14363,"_27402":124083,"_2946":124388},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3462":72754,"_30116":72652,"_20912":124390,"_5":14363,"_27402":124083,"_2946":124391},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3462":72755,"_30116":72652,"_20912":124393,"_5":14363,"_27402":124083,"_2946":124394},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3462":72756,"_30116":72652,"_20912":124396,"_5":14363,"_27402":124083,"_2946":124107},[],{"_3462":72757,"_30116":72652,"_20912":124398,"_5":14363,"_27402":124083,"_2946":124399},[],"Releases con identidades por servicio o material de claves montado",{"_3462":72758,"_30116":72652,"_20912":124401,"_5":14363,"_27402":124083,"_2946":124402},[],"Media: los servicios no pueden leer sus archivos",{"_3462":72759,"_30116":72652,"_20912":124404,"_5":14363,"_27402":124083,"_2946":124405},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3462":72760,"_30116":72652,"_20912":124407,"_5":14363,"_27402":124083,"_2946":124111},[],{"_3462":72761,"_30116":72652,"_20912":124409,"_5":14363,"_27402":124083,"_2946":124410},[],"Releases que definen `amqp.tls`",{"_3462":72762,"_30116":72652,"_20912":124412,"_5":14363,"_27402":124083,"_2946":124413},[],"Media: los clientes se conectan al puerto equivocado",{"_3462":72763,"_30116":72652,"_20912":124415,"_5":14363,"_27402":124083,"_2946":124416},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3462":72764,"_30116":72652,"_20912":124418,"_5":14363,"_27402":124083,"_2946":124131},[],{"_3462":72765,"_30116":72652,"_20912":124420,"_5":14363,"_27402":124083,"_2946":124421},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3462":72766,"_30116":72652,"_20912":124423,"_5":14363,"_27402":124083,"_2946":124424},[],"Media: las claves de CA quedan sin gestionar",{"_3462":72767,"_30116":72652,"_20912":124426,"_5":14363,"_27402":124083,"_2946":124427},[],"Ejecutar la migración de CA a KMS",{"_3462":72768,"_30116":72652,"_20912":124429,"_5":14363,"_27402":124083,"_2946":124430},[],"Verificación del certificado del receptor",{"_3462":72769,"_30116":72652,"_20912":124432,"_5":14363,"_27402":124083,"_2946":124433},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3462":72770,"_30116":72652,"_20912":124435,"_5":14363,"_27402":124083,"_2946":124436},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3462":72771,"_30116":72652,"_20912":124438,"_5":14363,"_27402":124083,"_2946":124439},[],"Poner `insecure_skip_verify` a `false`",{"_3462":72772,"_30116":72652,"_20912":124441,"_5":14363,"_27402":124083,"_2946":124147},[],{"_3462":72773,"_30116":72652,"_20912":124443,"_5":14363,"_27402":124083,"_2946":124444},[],"Scripts y consolas que editan DMS por API",{"_3462":72774,"_30116":72652,"_20912":124446,"_5":14363,"_27402":124083,"_2946":124447},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3462":72775,"_30116":72652,"_20912":124449,"_5":14363,"_27402":124083,"_2946":124450},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3462":72776,"_30116":72652,"_20912":124452,"_5":14363,"_27402":124083,"_2946":124167},[],{"_3462":72777,"_30116":72652,"_20912":124454,"_5":14363,"_27402":124083,"_2946":124455},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3462":72778,"_30116":72652,"_20912":124457,"_5":14363,"_27402":124083,"_2946":124458},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3462":72779,"_30116":72652,"_20912":124460,"_5":14363,"_27402":124083,"_2946":124461},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3462":72780,"_30116":72652,"_20912":124463,"_5":14363,"_27402":124083,"_2946":124175},[],{"_3462":72781,"_30116":72652,"_20912":124465,"_5":14363,"_27402":124083,"_2946":124466},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3462":72782,"_30116":72652,"_20912":124468,"_5":14363,"_27402":124083,"_2946":124469},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3462":72783,"_30116":72652,"_20912":124471,"_5":14363,"_27402":124083,"_2946":124472},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3462":72784,"_30116":72652,"_20912":124474,"_5":14363,"_27402":124083,"_2946":124163},[],{"_3462":72785,"_30116":72652,"_20912":124476,"_5":14363,"_27402":124083,"_2946":124477},[],"Consumidores que leen el campo `events` del dispositivo",{"_3462":72786,"_30116":72652,"_20912":124479,"_5":14363,"_27402":124083,"_2946":124480},[],"Media: el campo desaparece",{"_3462":72787,"_30116":72652,"_20912":124482,"_5":14363,"_27402":124083,"_2946":124483},[],"Usar los nuevos endpoints de eventos",{"_3462":72788,"_30116":72652,"_20912":124485,"_5":14363,"_27402":124083,"_2946":124183},[],{"_3462":72789,"_30116":72652,"_20912":124487,"_5":14363,"_27402":124083,"_2946":124488},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3462":72790,"_30116":72652,"_20912":124490,"_5":14363,"_27402":124083,"_2946":124491},[],"Media: la migración de la VA aborta",{"_3462":72791,"_30116":72652,"_20912":124493,"_5":14363,"_27402":124083,"_2946":124494},[],"Corregir los roles afectados antes de actualizar",{"_3462":72792,"_30116":72652,"_20912":124496,"_5":14363,"_27402":124083,"_2946":124115},[],{"_3462":72793,"_30116":72652,"_20912":124498,"_5":14363,"_27402":124083,"_2946":124499},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3462":72794,"_30116":72652,"_20912":124501,"_5":14363,"_27402":124083,"_2946":124502},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3462":72795,"_30116":72652,"_20912":124504,"_5":14363,"_27402":124083,"_2946":124505},[],"Actualizar el archivo de values",{"_3462":72796,"_30116":72652,"_20912":124507,"_5":14363,"_27402":124083,"_2946":124155},[],{"_3462":72797,"_30116":72652,"_20912":124509,"_5":14363,"_27402":124083,"_2946":124510},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3462":72798,"_30116":72652,"_20912":124512,"_5":14363,"_27402":124083,"_2946":124513},[],"Baja: prevalece el ID de la URL",{"_3462":72799,"_30116":72652,"_20912":124515,"_5":14363,"_27402":124083,"_2946":124516},[],"Enviar el ID en la URL",{"_3462":72800,"_30116":72652,"_20912":124518,"_5":14363,"_27402":124083,"_2946":124179},[],{"_3462":72801,"_30116":72652,"_20912":124520,"_5":14363,"_27402":124083,"_2946":124521},[],"Clientes que envían un `id` al crear o importar CAs",{"_3462":72802,"_30116":72652,"_20912":124523,"_5":14363,"_27402":124083,"_2946":124524},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3462":72803,"_30116":72652,"_20912":124526,"_5":14363,"_27402":124083,"_2946":124527},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3462":72804,"_30116":72652,"_20912":124529,"_5":14363,"_27402":124083,"_2946":124159},[],{"_3462":72805,"_30116":72652,"_20912":124531,"_5":14363,"_27402":124083,"_2946":124532},[],"Consumidores que comparan el `type` del certificado",{"_3462":72806,"_30116":72652,"_20912":124534,"_5":14363,"_27402":124083,"_2946":124535},[],"Baja: dos valores cambian de nombre",{"_3462":72807,"_30116":72652,"_20912":124537,"_5":14363,"_27402":124083,"_2946":124538},[],"Adaptar los consumidores",{"_3462":72808,"_30116":72652,"_20912":124540,"_5":14363,"_27402":124083,"_2946":124151},[],{"_3462":72809,"_30116":72652,"_20912":124542,"_5":14363,"_27402":124083,"_2946":124543},[],"Cualquier DMS",{"_3462":72810,"_30116":72652,"_20912":124545,"_5":14363,"_27402":124083,"_2946":124546},[],"Baja: solo informativo",{"_3462":72811,"_30116":72652,"_20912":124548,"_5":14363,"_27402":124083,"_2946":124549},[],"Revisar ambos bloques antes de editar",{"_3462":72812,"_30116":72652,"_20912":124551,"_5":14363,"_27402":124090,"_2946":124552},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3462":72813,"_30116":72652,"_20912":124554,"_5":14363,"_27402":124090,"_2946":124555},[],"El paso 4 de la guía de migración copia los datos.",{"_3462":72814,"_30116":72652,"_20912":124557,"_5":14363,"_27402":124094,"_2946":124558},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3462":72815,"_30116":72652,"_20912":124560,"_5":14363,"_27402":124098,"_2946":124561},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3462":72816,"_30116":72652,"_20912":124563,"_5":14363,"_27402":124102,"_2946":124564},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3462":72817,"_30116":72652,"_20912":124566,"_5":14363,"_27402":124106,"_2946":124567},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3462":72818,"_30116":72652,"_20912":124569,"_5":14363,"_27402":124106,"_2946":124570},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3462":72819,"_30116":72652,"_20912":124572,"_5":14363,"_27402":124110,"_2946":124573},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3462":72820,"_30116":72652,"_20912":124575,"_5":14363,"_27402":124114,"_2946":124576},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3462":72821,"_30116":72652,"_20912":124578,"_5":14363,"_27402":124114,"_2946":124579},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3462":72822,"_30116":72652,"_20912":124581,"_5":14363,"_27402":124114,"_2946":124582},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3462":72823,"_30116":72652,"_20912":124584,"_5":14363,"_27402":124114,"_2946":124585},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3462":72824,"_30116":72652,"_20912":124587,"_5":14363,"_27402":124114,"_2946":124588},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3462":72825,"_30116":72652,"_20912":124590,"_5":14363,"_27402":124114,"_2946":124591},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3462":72826,"_30116":72652,"_20912":124593,"_5":14363,"_27402":124122,"_2946":124594},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3462":72827,"_30116":72652,"_20912":124596,"_5":14363,"_27402":124122,"_2946":124597},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3462":72828,"_30116":72652,"_20912":124599,"_5":14363,"_27402":124122,"_2946":124600},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3462":72829,"_30116":72652,"_20912":124602,"_5":14363,"_27402":124122,"_2946":124603},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3462":72830,"_30116":72652,"_20912":124605,"_5":14363,"_27402":124122,"_2946":124606},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3462":72831,"_30116":72652,"_20912":124608,"_5":14363,"_27402":124126,"_2946":124609},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3462":72832,"_30116":72652,"_20912":124611,"_5":14363,"_27402":124130,"_2946":124612},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3462":72833,"_30116":72652,"_20912":124614,"_5":14363,"_27402":124130,"_2946":124615},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3462":72834,"_30116":72652,"_20912":124617,"_5":14363,"_27402":124130,"_2946":124618},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3462":72835,"_30116":72652,"_20912":124620,"_5":14363,"_27402":124130,"_2946":124621},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3462":72836,"_30116":72652,"_20912":124623,"_5":14363,"_27402":124130,"_2946":124624},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3462":72837,"_30116":72652,"_20912":124626,"_5":14363,"_27402":124130,"_2946":124627},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3462":72838,"_30116":72652,"_20912":124629,"_5":14363,"_27402":124130,"_2946":124630},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3462":72839,"_30116":72652,"_20912":124632,"_5":14363,"_27402":124130,"_2946":124633},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3462":72840,"_30116":72652,"_20912":124635,"_5":14363,"_27402":124134,"_2946":124636},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3462":72841,"_30116":72652,"_20912":124638,"_5":14363,"_27402":124142,"_2946":124639},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3462":72842,"_30116":72652,"_20912":124641,"_5":14363,"_27402":124142,"_2946":124642},[],"Campo en 3.8.0",{"_3462":72843,"_30116":72652,"_20912":124644,"_5":14363,"_27402":124142,"_2946":124645},[],"Campo en 4.0.0",{"_3462":72844,"_30116":72652,"_20912":124647,"_5":14363,"_27402":124142,"_2946":57935},[],{"_3462":72845,"_30116":72652,"_20912":124649,"_5":14363,"_27402":124142,"_2946":124650},[],"`insecure_skip_verify` (con el valor negado)",{"_3462":72846,"_30116":72652,"_20912":124652,"_5":14363,"_27402":124142,"_2946":57941},[],{"_3462":72847,"_30116":72652,"_20912":124654,"_5":14363,"_27402":124142,"_2946":57944},[],{"_3462":72848,"_30116":72652,"_20912":124656,"_5":14363,"_27402":124142,"_2946":57947},[],{"_3462":72849,"_30116":72652,"_20912":124658,"_5":14363,"_27402":124142,"_2946":57950},[],{"_3462":72850,"_30116":72652,"_20912":124660,"_5":14363,"_27402":124142,"_2946":57953},[],{"_3462":72851,"_30116":72652,"_20912":124662,"_5":14363,"_27402":124142,"_2946":57956},[],{"_3462":72852,"_30116":72652,"_20912":124664,"_5":14363,"_27402":124142,"_2946":124665},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3462":72853,"_30116":72652,"_20912":124667,"_5":14363,"_27402":124142,"_2946":124668},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3462":72854,"_30116":72652,"_20912":124670,"_5":14363,"_27402":124142,"_2946":124671},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3462":72855,"_30116":72652,"_20912":124673,"_5":14363,"_27402":124146,"_2946":124674},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3462":72856,"_30116":72652,"_20912":124676,"_5":14363,"_27402":124146,"_2946":124677},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3462":72857,"_30116":72652,"_20912":124679,"_5":14363,"_27402":124146,"_2946":124680},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3462":72858,"_30116":72652,"_20912":124682,"_5":14363,"_27402":124150,"_2946":124683},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3462":72859,"_30116":72652,"_20912":124685,"_5":14363,"_27402":124154,"_2946":124686},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3462":72860,"_30116":72652,"_20912":124688,"_5":14363,"_27402":124158,"_2946":124689},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3462":72861,"_30116":72652,"_20912":124691,"_5":14363,"_27402":124162,"_2946":124692},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3462":72862,"_30116":72652,"_20912":124694,"_5":14363,"_27402":124162,"_2946":124695},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3462":72863,"_30116":72652,"_20912":124697,"_5":14363,"_27402":124162,"_2946":124698},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3462":72864,"_30116":72652,"_20912":124700,"_5":14363,"_27402":124162,"_2946":124701},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3462":72865,"_30116":72652,"_20912":124703,"_5":14363,"_27402":124166,"_2946":124704},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3462":72866,"_30116":72652,"_20912":124706,"_5":14363,"_27402":124170,"_2946":124707},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3462":72867,"_30116":72652,"_20912":124709,"_5":14363,"_27402":124170,"_2946":124710},[],"Ruta",{"_3462":72868,"_30116":72652,"_20912":124712,"_5":14363,"_27402":124170,"_2946":117273},[],{"_3462":72869,"_30116":72652,"_20912":124714,"_5":14363,"_27402":124170,"_2946":58009},[],{"_3462":72870,"_30116":72652,"_20912":124716,"_5":14363,"_27402":124170,"_2946":124717},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3462":72871,"_30116":72652,"_20912":124719,"_5":14363,"_27402":124170,"_2946":58015},[],{"_3462":72872,"_30116":72652,"_20912":124721,"_5":14363,"_27402":124170,"_2946":124722},[],"Lee los ajustes de una CA.",{"_3462":72873,"_30116":72652,"_20912":124724,"_5":14363,"_27402":124170,"_2946":58021},[],{"_3462":72874,"_30116":72652,"_20912":124726,"_5":14363,"_27402":124170,"_2946":124727},[],"Sustituye los `crl_options`.",{"_3462":72875,"_30116":72652,"_20912":124729,"_5":14363,"_27402":124170,"_2946":124730},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3462":72876,"_30116":72652,"_20912":124732,"_5":14363,"_27402":124170,"_2946":124733},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3462":72877,"_30116":72652,"_20912":124735,"_5":14363,"_27402":124170,"_2946":124736},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3462":72878,"_30116":72652,"_20912":124738,"_5":14363,"_27402":124170,"_2946":124739},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3462":72879,"_30116":72652,"_20912":124741,"_5":14363,"_27402":124170,"_2946":124742},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3462":72880,"_30116":72652,"_20912":124744,"_5":14363,"_27402":124170,"_2946":124745},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3462":72881,"_30116":72652,"_20912":124747,"_5":14363,"_27402":124170,"_2946":124748},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3462":72882,"_30116":72652,"_20912":124750,"_5":14363,"_27402":124170,"_2946":124751},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3462":72883,"_30116":72652,"_20912":124753,"_5":14363,"_27402":124170,"_2946":124754},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3462":72884,"_30116":72652,"_20912":124756,"_5":14363,"_27402":124170,"_2946":124757},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3462":72885,"_30116":72652,"_20912":124759,"_5":14363,"_27402":124170,"_2946":124760},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3462":72886,"_30116":72652,"_20912":124762,"_5":14363,"_27402":124174,"_2946":124763},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3462":72887,"_30116":72652,"_20912":124765,"_5":14363,"_27402":124178,"_2946":124766},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3462":72888,"_30116":72652,"_20912":124768,"_5":14363,"_27402":124182,"_2946":124769},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3462":72889,"_30116":72652,"_20912":124771,"_5":14363,"_27402":124186,"_2946":124772},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3462":72890,"_30116":72652,"_20912":124774,"_5":14363,"_27402":124190,"_2946":124775},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3462":72891,"_30116":72652,"_20912":124777,"_5":14363,"_27402":124190,"_2946":124778},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3462":72892,"_30116":72652,"_20912":124780,"_5":14363,"_27402":124190,"_2946":124781},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3462":72893,"_30116":72652,"_20912":124783,"_5":14363,"_27402":124190,"_2946":124784},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3462":72894,"_30116":72652,"_20912":124786,"_5":14363,"_27402":124190,"_2946":124787},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3462":72895,"_30116":72652,"_20912":124789,"_5":14363,"_27402":124190,"_2946":124790},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3462":72896,"_30116":72652,"_20912":124792,"_5":14363,"_27402":124194,"_2946":124793},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3462":72897,"_30116":72652,"_20912":124795,"_5":14363,"_27402":124194,"_2946":124796},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3462":72898,"_30116":72652,"_20912":124798,"_5":14363,"_27402":124194,"_2946":124799},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3462":72899,"_30116":72652,"_20912":124801,"_5":14363,"_27402":124194,"_2946":124802},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3462":72900,"_30116":72652,"_20912":124804,"_5":14363,"_27402":124194,"_2946":124805},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3462":72901,"_30116":72652,"_20912":124807,"_5":14363,"_27402":124198,"_2946":124808},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3462":72902,"_30116":72652,"_20912":124810,"_5":14363,"_27402":124198,"_2946":124811},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3462":72903,"_30116":72652,"_20912":124813,"_5":14363,"_27402":124198,"_2946":124814},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3462":72904,"_30116":72652,"_20912":124816,"_5":14363,"_27402":124198,"_2946":124817},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3462":72905,"_30116":72652,"_20912":124819,"_5":14363,"_27402":124198,"_2946":124820},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3462":72906,"_30116":72652,"_20912":124822,"_5":14363,"_27402":124198,"_2946":124823},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3462":72907,"_30116":72652,"_20912":124825,"_5":14363,"_27402":124198,"_2946":124826},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3462":72908,"_30116":72652,"_20912":124828,"_5":14363,"_27402":124198,"_2946":124829},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3462":72909,"_30116":72652,"_20912":124831,"_5":14363,"_27402":124198,"_2946":124832},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3462":72910,"_30116":72652,"_20912":124834,"_5":14363,"_27402":124198,"_2946":124835},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3462":72911,"_30116":72652,"_20912":124837,"_5":14363,"_27402":124198,"_2946":124838},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3462":72912,"_30116":72652,"_20912":124840,"_5":14363,"_27402":124198,"_2946":124841},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3462":72913,"_30116":72652,"_20912":124843,"_5":14363,"_27402":124202,"_2946":124844},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3462":72914,"_30116":72652,"_20912":124846,"_5":14363,"_27402":124202,"_2946":124847},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3462":72915,"_30116":72652,"_20912":124849,"_5":14363,"_27402":124206,"_2946":124850},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3462":72916,"_30116":72652,"_20912":124852,"_5":14363,"_27402":124206,"_2946":124853},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3462":72917,"_30116":72652,"_20912":124855,"_5":14363,"_27402":124206,"_2946":124856},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3462":72918,"_30116":72652,"_20912":124858,"_5":14363,"_27402":124206,"_2946":124859},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3462":72919,"_30116":72652,"_20912":124861,"_5":14363,"_27402":124206,"_2946":124862},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3462":72920,"_30116":72652,"_20912":124864,"_5":14363,"_27402":124206,"_2946":124865},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3462":72921,"_30116":72652,"_20912":124867,"_5":14363,"_27402":124206,"_2946":124868},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3462":72922,"_30116":72652,"_20912":124870,"_5":14363,"_27402":124206,"_2946":124871},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3462":72923,"_30116":72652,"_20912":124873,"_5":14363,"_27402":124206,"_2946":124874},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3462":72924,"_30116":72652,"_20912":124876,"_5":14363,"_27402":124206,"_2946":124877},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3462":72925,"_30116":72652,"_20912":124879,"_5":14363,"_27402":124206,"_2946":124880},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3462":72926,"_30116":72652,"_20912":124882,"_5":14363,"_27402":124210,"_2946":124883},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3462":72927,"_30116":72652,"_20912":124885,"_5":14363,"_27402":124210,"_2946":124886},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3462":72928,"_30116":72652,"_20912":124888,"_5":14363,"_27402":124214,"_2946":124889},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3462":72929,"_30116":72652,"_20912":124891,"_5":14363,"_27402":124214,"_2946":124892},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3462":72930,"_30116":72652,"_20912":124894,"_5":14363,"_27402":124214,"_2946":124895},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3462":72931,"_30116":72652,"_20912":124897,"_5":14363,"_27402":124214,"_2946":124898},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3462":72932,"_30116":72652,"_20912":124900,"_5":14363,"_27402":124214,"_2946":124901},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3462":72933,"_30116":72652,"_20912":124903,"_5":14363,"_27402":124214,"_2946":124904},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3462":72934,"_30116":72652,"_20912":124906,"_5":14363,"_27402":124214,"_2946":124907},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3462":72935,"_30116":72652,"_20912":124909,"_5":14363,"_27402":124214,"_2946":124910},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3462":72936,"_30116":72652,"_20912":124912,"_5":14363,"_27402":124218,"_2946":124913},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3462":72937,"_30116":72652,"_20912":124915,"_5":14363,"_27402":124218,"_2946":124916},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3462":72938,"_30116":72652,"_20912":124918,"_5":14363,"_27402":124218,"_2946":124919},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3462":72939,"_30116":72652,"_20912":124921,"_5":14363,"_27402":124218,"_2946":124922},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3462":72940,"_30116":72652,"_20912":124924,"_5":14363,"_27402":124218,"_2946":124925},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3462":72941,"_30116":72652,"_20912":124927,"_5":14363,"_27402":124218,"_2946":124928},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3462":72942,"_30116":72652,"_20912":124930,"_5":14363,"_27402":124218,"_2946":124931},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3462":72943,"_30116":72652,"_20912":124933,"_5":14363,"_27402":124218,"_2946":124934},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3462":72944,"_30116":72652,"_20912":124936,"_5":14363,"_27402":124218,"_2946":124937},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3462":72945,"_30116":72652,"_20912":124939,"_5":14363,"_27402":124218,"_2946":124940},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3462":72946,"_30116":72652,"_20912":124942,"_5":14363,"_27402":124218,"_2946":124943},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3462":72947,"_30116":72652,"_20912":124945,"_5":14363,"_27402":124221,"_2946":124946},[],"Tras la actualización, comprueba en este orden:",{"_3462":72948,"_30116":72652,"_20912":124948,"_5":14363,"_27402":124221,"_2946":124949},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3462":72949,"_30116":72652,"_20912":124951,"_5":14363,"_27402":124221,"_2946":124952},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3462":72950,"_30116":72652,"_20912":124954,"_5":14363,"_27402":124221,"_2946":124955},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3462":72951,"_30116":72652,"_20912":124957,"_5":14363,"_27402":124221,"_2946":124958},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3462":72952,"_30116":72652,"_20912":124960,"_5":14363,"_27402":124221,"_2946":124961},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3462":72953,"_30116":72652,"_20912":124963,"_5":14363,"_27402":124221,"_2946":124964},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3462":72954,"_30116":72652,"_20912":124966,"_5":14363,"_27402":124221,"_2946":124967},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3462":72955,"_30116":72652,"_20912":124969,"_5":14363,"_27402":124221,"_2946":124970},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3462":72956,"_30116":72652,"_20912":124972,"_5":14363,"_27402":124221,"_2946":124973},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3462":72957,"_30116":72652,"_20912":124975,"_5":14363,"_27402":124221,"_2946":124976},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3462":72958,"_30116":72652,"_20912":124978,"_5":14363,"_27402":124221,"_2946":124979},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3462":72959,"_30116":72652,"_20912":124981,"_5":14363,"_27402":124221,"_2946":124982},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3462":72960,"_30116":72652,"_20912":124984,"_5":14363,"_27402":124221,"_2946":124985},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3462":72961,"_30116":72652,"_20912":124987,"_5":14363,"_27402":124221,"_2946":124988},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3462":72962,"_30116":72652,"_20912":124990,"_5":14363,"_27402":124221,"_2946":124991},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3462":72963,"_30116":72652,"_20912":124993,"_5":14363,"_27402":124225,"_2946":124994},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3462":72964,"_30116":72652,"_20912":124996,"_5":14363,"_27402":124225,"_2946":124997},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3462":72965,"_30116":72652,"_20912":124999,"_5":14363,"_27402":124225,"_2946":125000},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3462":72966,"_30116":72652,"_20912":125002,"_5":14363,"_27402":124225,"_2946":125003},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3462":72967,"_30116":72652,"_20912":125005,"_5":14363,"_27402":124225,"_2946":125006},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58306":125008,"_58308":125009,"_58310":125010,"_58312":125011,"_18124":2981,"_70035":2981},"spanish",[2946,30116,5,27402],{"_2946":24983,"_30116":24983,"_5":24983,"_27402":24983},{"_2946":125012,"_30116":127941,"_5":130870,"_27402":133799},{"_4642":125013,"_58316":125014,"_5":24983},{"_14439":7563,"_14820":11306,"_14839":5959,"_29119":3441,"_14826":6540,"_19844":6173,"_14460":6960,"_14467":13283,"_29061":20329,"_29470":14234,"_29491":6531,"_29095":7017,"_34463":12253,"_29198":20324,"_29535":9849,"_34470":22826,"_34473":5811,"_34476":7000,"_34479":18138,"_29942":3346,"_34484":9369,"_34486":7280,"_29972":5130,"_14835":15797,"_34490":7490,"_34493":5820,"_34495":7633,"_29519":23574,"_29937":4796,"_29985":12169,"_34500":6011,"_34502":3764,"_34504":6985,"_29215":6361,"_34507":5149,"_34509":3805,"_34511":7814,"_34513":7126,"_34515":28642,"_29132":4685,"_34518":4614,"_34520":5051,"_29126":8798,"_29556":11072,"_34524":3586,"_34526":10760,"_34529":5251,"_29172":14401,"_34533":4963,"_29052":18145,"_34536":4948,"_29100":6981,"_34539":11744,"_34541":3727,"_34544":3420,"_14829":3236,"_34547":4705,"_34549":4386,"_34552":7629,"_34554":6571,"_34556":22784,"_34558":7656,"_34560":4953,"_19847":3332,"_34563":7043,"_34565":4049,"_29073":17014,"_29513":3333,"_34569":10475,"_34571":4050,"_34573":7052,"_30002":16843,"_3