:125575,"_40503":125578,"_40505":125581,"_40507":125584,"_40509":125587,"_40512":125590,"_40514":125593,"_40516":125596},{"_3475":70370,"_30304":70370,"_5":14780,"_2958":116639,"_30657":116640,"_20976":116643,"_27536":70370},"Despliega desde AWS Marketplace",[49412,116641,116642],"Despliegue","Otros modelos",[],{"_3475":70371,"_30304":70370,"_20976":116645,"_5":14428,"_27536":70370,"_2958":116646},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3475":70372,"_30304":70370,"_5":30654,"_20976":116648,"_27536":116649,"_2958":116650},[],"/docs/pr-preview/pr-65/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3475":70373,"_30304":70370,"_5":30654,"_20976":116652,"_27536":116653,"_2958":116654},[],"/docs/pr-preview/pr-65/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3475":70374,"_30304":70370,"_5":30654,"_20976":116656,"_27536":116657,"_2958":116658},[],"/docs/pr-preview/pr-65/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3475":70375,"_30304":70370,"_5":30654,"_20976":116660,"_27536":116661,"_2958":116662},[],"/docs/pr-preview/pr-65/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3475":70376,"_30304":70370,"_5":30654,"_20976":116664,"_27536":116665,"_2958":116666},[],"/docs/pr-preview/pr-65/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3475":70377,"_30304":70370,"_5":30654,"_20976":116668,"_27536":116669,"_2958":116670},[],"/docs/pr-preview/pr-65/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3475":70378,"_30304":70370,"_5":30654,"_20976":116672,"_27536":116673,"_2958":116674},[],"/docs/pr-preview/pr-65/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3475":70379,"_30304":70370,"_20976":116676,"_5":14428,"_27536":70370,"_2958":116677},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3475":70380,"_30304":70370,"_20976":116679,"_5":14428,"_27536":116649,"_2958":116680},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3475":70381,"_30304":70370,"_20976":116682,"_5":14428,"_27536":116649,"_2958":116683},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3475":70382,"_30304":70370,"_20976":116685,"_5":14428,"_27536":116649,"_2958":116686},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3475":70383,"_30304":70370,"_20976":116688,"_5":14428,"_27536":116653,"_2958":116689},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3475":70384,"_30304":70370,"_20976":116691,"_5":14428,"_27536":116653,"_2958":116692},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3475":70385,"_30304":70370,"_20976":116694,"_5":14428,"_27536":116653,"_2958":116695},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3475":70386,"_30304":70370,"_20976":116697,"_5":14428,"_27536":116657,"_2958":116698},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3475":70387,"_30304":70370,"_20976":116700,"_5":14428,"_27536":116661,"_2958":116701},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3475":70388,"_30304":70370,"_20976":116703,"_5":14428,"_27536":116665,"_2958":116704},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3475":70389,"_30304":70370,"_20976":116706,"_5":14428,"_27536":116669,"_2958":116707},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3475":70390,"_30304":70370,"_20976":116709,"_5":14428,"_27536":116673,"_2958":116710},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3475":70391,"_30304":70391,"_5":14780,"_2958":116712,"_30657":116713,"_20976":116714,"_27536":70391},"Despliega Lamassu",[49412,116641],[],{"_3475":70392,"_30304":70391,"_20976":116716,"_5":14428,"_27536":70391,"_2958":116717},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3475":70393,"_30304":70391,"_5":30654,"_20976":116719,"_27536":116720,"_2958":116721},[],"/docs/pr-preview/pr-65/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3475":70394,"_30304":70391,"_5":30654,"_20976":116723,"_27536":116724,"_2958":116725},[],"/docs/pr-preview/pr-65/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3475":70395,"_30304":70391,"_5":30654,"_20976":116727,"_27536":116728,"_2958":116729},[],"/docs/pr-preview/pr-65/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3475":70396,"_30304":70391,"_20976":116731,"_5":14428,"_27536":70391,"_2958":116732},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3475":70397,"_30304":70391,"_20976":116734,"_5":14428,"_27536":116720,"_2958":116735},[],"Modelo",{"_3475":70398,"_30304":70391,"_20976":116737,"_5":14428,"_27536":116720,"_2958":116738},[],"Recomendado para",{"_3475":70399,"_30304":70391,"_20976":116740,"_5":14428,"_27536":116720,"_2958":116741},[],"Quién opera la infraestructura",{"_3475":70400,"_30304":70391,"_20976":116743,"_5":14428,"_27536":116720,"_2958":116744},[],"Punto de partida",{"_3475":70401,"_30304":70391,"_20976":116746,"_5":14428,"_27536":116720,"_2958":49519},[],{"_3475":70402,"_30304":70391,"_20976":116748,"_5":14428,"_27536":116720,"_2958":116749},[],"Producción, entornos regulados y despliegues personalizados",{"_3475":70403,"_30304":70391,"_20976":116751,"_5":14428,"_27536":116720,"_2958":116752},[],"Tu equipo",{"_3475":70404,"_30304":70391,"_20976":116754,"_5":14428,"_27536":116720,"_2958":116755},[],"Helm o Fastlane",{"_3475":70405,"_30304":70391,"_20976":116757,"_5":14428,"_27536":116720,"_2958":49531},[],{"_3475":70406,"_30304":70391,"_20976":116759,"_5":14428,"_27536":116720,"_2958":116760},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3475":70407,"_30304":70391,"_20976":116762,"_5":14428,"_27536":116720,"_2958":116752},[],{"_3475":70408,"_30304":70391,"_20976":116764,"_5":14428,"_27536":116720,"_2958":116765},[],"Imagen preconfigurada en EC2",{"_3475":70409,"_30304":70391,"_20976":116767,"_5":14428,"_27536":116720,"_2958":49542},[],{"_3475":70410,"_30304":70391,"_20976":116769,"_5":14428,"_27536":116720,"_2958":116770},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3475":70411,"_30304":70391,"_20976":116772,"_5":14428,"_27536":116720,"_2958":49548},[],{"_3475":70412,"_30304":70391,"_20976":116774,"_5":14428,"_27536":116720,"_2958":116775},[],"Suscripción gestionada",{"_3475":70413,"_30304":70391,"_20976":116777,"_5":14428,"_27536":116720,"_2958":116778},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3475":70414,"_30304":70391,"_20976":116780,"_5":14428,"_27536":116720,"_2958":116781},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3475":70415,"_30304":70391,"_20976":116783,"_5":14428,"_27536":116720,"_2958":116784},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3475":70416,"_30304":70391,"_20976":116786,"_5":14428,"_27536":116724,"_2958":116787},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3475":70417,"_30304":70391,"_20976":116789,"_5":14428,"_27536":116728,"_2958":116790},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3475":70418,"_30304":70418,"_5":14780,"_2958":116792,"_30657":116793,"_20976":116794,"_27536":70418},"Utiliza Lamassu como SaaS",[49412,116641,116642],[],{"_3475":70419,"_30304":70418,"_20976":116796,"_5":14428,"_27536":70418,"_2958":116797},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3475":70420,"_30304":70418,"_5":30654,"_20976":116799,"_27536":116800,"_2958":116801},[],"/docs/pr-preview/pr-65/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3475":70421,"_30304":70418,"_5":30654,"_20976":116803,"_27536":116804,"_2958":116805},[],"/docs/pr-preview/pr-65/es/deployment/saas#planes","Planes",{"_3475":70422,"_30304":70418,"_5":30654,"_20976":116807,"_27536":116808,"_2958":116809},[],"/docs/pr-preview/pr-65/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3475":70423,"_30304":70418,"_20976":116811,"_5":14428,"_27536":70418,"_2958":116812},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3475":70424,"_30304":70418,"_20976":116814,"_5":14428,"_27536":116800,"_2958":116815},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3475":70425,"_30304":70418,"_20976":116817,"_5":14428,"_27536":116800,"_2958":116818},[],"Copias de seguridad automáticas.",{"_3475":70426,"_30304":70418,"_20976":116820,"_5":14428,"_27536":116800,"_2958":116821},[],"Actualizaciones de versión.",{"_3475":70427,"_30304":70418,"_20976":116823,"_5":14428,"_27536":116800,"_2958":116824},[],"Soporte técnico y SLA según el plan contratado.",{"_3475":70428,"_30304":70418,"_20976":116826,"_5":14428,"_27536":116804,"_2958":49603},[],{"_3475":70429,"_30304":70418,"_20976":116828,"_5":14428,"_27536":116804,"_2958":116829},[],"Dispositivos",{"_3475":70430,"_30304":70418,"_20976":116831,"_5":14428,"_27536":116804,"_2958":116832},[],"Soporte",{"_3475":70431,"_30304":70418,"_20976":116834,"_5":14428,"_27536":116804,"_2958":49612},[],{"_3475":70432,"_30304":70418,"_20976":116836,"_5":14428,"_27536":116804,"_2958":49615},[],{"_3475":70433,"_30304":70418,"_20976":116838,"_5":14428,"_27536":116804,"_2958":116839},[],"Hasta 1.000",{"_3475":70434,"_30304":70418,"_20976":116841,"_5":14428,"_27536":116804,"_2958":49621},[],{"_3475":70435,"_30304":70418,"_20976":116843,"_5":14428,"_27536":116804,"_2958":116844},[],"99,5 %",{"_3475":70436,"_30304":70418,"_20976":116846,"_5":14428,"_27536":116804,"_2958":49627},[],{"_3475":70437,"_30304":70418,"_20976":116848,"_5":14428,"_27536":116804,"_2958":116849},[],"Hasta 10.000",{"_3475":70438,"_30304":70418,"_20976":116851,"_5":14428,"_27536":116804,"_2958":116852},[],"Email y chat",{"_3475":70439,"_30304":70418,"_20976":116854,"_5":14428,"_27536":116804,"_2958":116855},[],"99,9 %",{"_3475":70440,"_30304":70418,"_20976":116857,"_5":14428,"_27536":116804,"_2958":49639},[],{"_3475":70441,"_30304":70418,"_20976":116859,"_5":14428,"_27536":116804,"_2958":116860},[],"Ilimitados",{"_3475":70442,"_30304":70418,"_20976":116862,"_5":14428,"_27536":116804,"_2958":116863},[],"Dedicado",{"_3475":70443,"_30304":70418,"_20976":116865,"_5":14428,"_27536":116804,"_2958":116866},[],"99,99 %",{"_3475":70444,"_30304":70418,"_20976":116868,"_5":14428,"_27536":116808,"_2958":116869},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3475":70445,"_30304":70418,"_20976":116871,"_5":14428,"_27536":116808,"_2958":116872},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3475":70446,"_30304":70446,"_5":14780,"_2958":49656,"_30657":116874,"_20976":116876,"_27536":70446},[49412,116641,116875],"Kubernetes autogestionado",[],{"_3475":70447,"_30304":70446,"_20976":116878,"_5":14428,"_27536":70446,"_2958":116879},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3475":70448,"_30304":70446,"_5":30654,"_20976":116881,"_27536":116882,"_2958":116883},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3475":70449,"_30304":70446,"_5":30654,"_20976":116885,"_27536":116886,"_2958":116887},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3475":70450,"_30304":70446,"_5":30654,"_20976":116889,"_27536":116890,"_2958":116891},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3475":70451,"_30304":70446,"_5":30654,"_20976":116893,"_27536":116894,"_2958":116895},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3475":70452,"_30304":70446,"_5":30654,"_20976":116897,"_27536":116898,"_2958":116899},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3475":70453,"_30304":70446,"_5":30654,"_20976":116901,"_27536":116902,"_2958":116903},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3475":70454,"_30304":70446,"_5":30654,"_20976":116905,"_27536":116906,"_2958":116907},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3475":70455,"_30304":70446,"_5":30654,"_20976":116909,"_27536":116910,"_2958":116911},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3475":70456,"_30304":70446,"_5":30654,"_20976":116913,"_27536":116914,"_2958":116915},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3475":70457,"_30304":70446,"_5":30654,"_20976":116917,"_27536":116918,"_2958":116919},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3475":70458,"_30304":70446,"_5":30654,"_20976":116921,"_27536":116922,"_2958":116923},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3475":70459,"_30304":70446,"_20976":116925,"_5":14428,"_27536":116882,"_2958":116926},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3475":70460,"_30304":70446,"_20976":116928,"_5":14428,"_27536":116882,"_2958":116929},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3475":70461,"_30304":70446,"_20976":116931,"_5":14428,"_27536":116886,"_2958":116932},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3475":70462,"_30304":70446,"_20976":116934,"_5":14428,"_27536":116886,"_2958":116935},[],"Fastlane instala o configura",{"_3475":70463,"_30304":70446,"_20976":116937,"_5":14428,"_27536":116886,"_2958":116938},[],"Tú sigues proporcionando",{"_3475":70464,"_30304":70446,"_20976":116940,"_5":14428,"_27536":116886,"_2958":116941},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3475":70465,"_30304":70446,"_20976":116943,"_5":14428,"_27536":116886,"_2958":116944},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3475":70466,"_30304":70446,"_20976":116946,"_5":14428,"_27536":116886,"_2958":116947},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3475":70467,"_30304":70446,"_20976":116949,"_5":14428,"_27536":116886,"_2958":116950},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3475":70468,"_30304":70446,"_20976":116952,"_5":14428,"_27536":116886,"_2958":116953},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3475":70469,"_30304":70446,"_20976":116955,"_5":14428,"_27536":116886,"_2958":116956},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3475":70470,"_30304":70446,"_20976":116958,"_5":14428,"_27536":116886,"_2958":116959},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3475":70471,"_30304":70446,"_20976":116961,"_5":14428,"_27536":116886,"_2958":116962},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3475":70472,"_30304":70446,"_20976":116964,"_5":14428,"_27536":116886,"_2958":116965},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3475":70473,"_30304":70446,"_20976":116967,"_5":14428,"_27536":116890,"_2958":116968},[],"Necesitas:",{"_3475":70474,"_30304":70446,"_20976":116970,"_5":14428,"_27536":116890,"_2958":116971},[],"un clúster Kubernetes existente",{"_3475":70475,"_30304":70446,"_20976":116973,"_5":14428,"_27536":116890,"_2958":116974},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3475":70476,"_30304":70446,"_20976":116976,"_5":14428,"_27536":116890,"_2958":49758},[],{"_3475":70477,"_30304":70446,"_20976":116978,"_5":14428,"_27536":116890,"_2958":23724},[],{"_3475":70478,"_30304":70446,"_20976":116980,"_5":14428,"_27536":116890,"_2958":116981},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3475":70479,"_30304":70446,"_20976":116983,"_5":14428,"_27536":116890,"_2958":116984},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3475":70480,"_30304":70446,"_20976":116986,"_5":14428,"_27536":116890,"_2958":116987},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3475":70481,"_30304":70446,"_20976":116989,"_5":14428,"_27536":116890,"_2958":116990},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3475":70482,"_30304":70446,"_20976":116992,"_5":14428,"_27536":116890,"_2958":116993},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3475":70483,"_30304":70446,"_20976":116995,"_5":14428,"_27536":116894,"_2958":116996},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3475":70484,"_30304":70446,"_20976":116998,"_5":14428,"_27536":116894,"_2958":116999},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3475":70485,"_30304":70446,"_20976":117001,"_5":14428,"_27536":116898,"_2958":117002},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3475":70486,"_30304":70446,"_20976":117004,"_5":14428,"_27536":116898,"_2958":117005},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3475":70487,"_30304":70446,"_20976":117007,"_5":14428,"_27536":116898,"_2958":117008},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3475":70488,"_30304":70446,"_20976":117010,"_5":14428,"_27536":116898,"_2958":117011},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3475":70489,"_30304":70446,"_20976":117013,"_5":14428,"_27536":116902,"_2958":117014},[],"Opción",{"_3475":70490,"_30304":70446,"_20976":117016,"_5":14428,"_27536":116902,"_2958":117017},[],"Valor predeterminado",{"_3475":70491,"_30304":70446,"_20976":117019,"_5":14428,"_27536":116902,"_2958":117020},[],"Propósito",{"_3475":70492,"_30304":70446,"_20976":117022,"_5":14428,"_27536":116902,"_2958":49805},[],{"_3475":70493,"_30304":70446,"_20976":117024,"_5":14428,"_27536":116902,"_2958":49808},[],{"_3475":70494,"_30304":70446,"_20976":117026,"_5":14428,"_27536":116902,"_2958":117027},[],"Muestra la ayuda",{"_3475":70495,"_30304":70446,"_20976":117029,"_5":14428,"_27536":116902,"_2958":49814},[],{"_3475":70496,"_30304":70446,"_20976":117031,"_5":14428,"_27536":116902,"_2958":117032},[],"contexto actual",{"_3475":70497,"_30304":70446,"_20976":117034,"_5":14428,"_27536":116902,"_2958":117035},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3475":70498,"_30304":70446,"_20976":117037,"_5":14428,"_27536":116902,"_2958":49823},[],{"_3475":70499,"_30304":70446,"_20976":117039,"_5":14428,"_27536":116902,"_2958":6570},[],{"_3475":70500,"_30304":70446,"_20976":117041,"_5":14428,"_27536":116902,"_2958":117042},[],"Omite prompts y genera credenciales para las dependencias",{"_3475":70501,"_30304":70446,"_20976":117044,"_5":14428,"_27536":116902,"_2958":49831},[],{"_3475":70502,"_30304":70446,"_20976":117046,"_5":14428,"_27536":116902,"_2958":49834},[],{"_3475":70503,"_30304":70446,"_20976":117048,"_5":14428,"_27536":116902,"_2958":117049},[],"Namespace de la instalación",{"_3475":70504,"_30304":70446,"_20976":117051,"_5":14428,"_27536":116902,"_2958":49840},[],{"_3475":70505,"_30304":70446,"_20976":117053,"_5":14428,"_27536":116902,"_2958":49843},[],{"_3475":70506,"_30304":70446,"_20976":117055,"_5":14428,"_27536":116902,"_2958":117056},[],"Dominio usado por la UI, OIDC y el certificado",{"_3475":70507,"_30304":70446,"_20976":117058,"_5":14428,"_27536":116902,"_2958":49849},[],{"_3475":70508,"_30304":70446,"_20976":117060,"_5":14428,"_27536":116902,"_2958":15120},[],{"_3475":70509,"_30304":70446,"_20976":117062,"_5":14428,"_27536":116902,"_2958":117063},[],"Versión del chart de Lamassu",{"_3475":70510,"_30304":70446,"_20976":117065,"_5":14428,"_27536":116902,"_2958":49857},[],{"_3475":70511,"_30304":70446,"_20976":117067,"_5":14428,"_27536":116902,"_2958":49860},[],{"_3475":70512,"_30304":70446,"_20976":117069,"_5":14428,"_27536":116902,"_2958":117070},[],"Puerto del listener HTTPS",{"_3475":70513,"_30304":70446,"_20976":117072,"_5":14428,"_27536":116902,"_2958":49866},[],{"_3475":70514,"_30304":70446,"_20976":117074,"_5":14428,"_27536":116902,"_2958":49869},[],{"_3475":70515,"_30304":70446,"_20976":117076,"_5":14428,"_27536":116902,"_2958":117077},[],"Puerto del listener HTTP",{"_3475":70516,"_30304":70446,"_20976":117079,"_5":14428,"_27536":116902,"_2958":49875},[],{"_3475":70517,"_30304":70446,"_20976":117081,"_5":14428,"_27536":116902,"_2958":49808},[],{"_3475":70518,"_30304":70446,"_20976":117083,"_5":14428,"_27536":116902,"_2958":117084},[],"Certificado PEM para TLS downstream",{"_3475":70519,"_30304":70446,"_20976":117086,"_5":14428,"_27536":116902,"_2958":49883},[],{"_3475":70520,"_30304":70446,"_20976":117088,"_5":14428,"_27536":116902,"_2958":49808},[],{"_3475":70521,"_30304":70446,"_20976":117090,"_5":14428,"_27536":116902,"_2958":117091},[],"Clave privada PEM para TLS downstream",{"_3475":70522,"_30304":70446,"_20976":117093,"_5":14428,"_27536":116902,"_2958":49891},[],{"_3475":70523,"_30304":70446,"_20976":117095,"_5":14428,"_27536":116902,"_2958":117096},[],"chart del repositorio",{"_3475":70524,"_30304":70446,"_20976":117098,"_5":14428,"_27536":116902,"_2958":117099},[],"Usa un chart local de Lamassu sin empaquetar",{"_3475":70525,"_30304":70446,"_20976":117101,"_5":14428,"_27536":116902,"_2958":49900},[],{"_3475":70526,"_30304":70446,"_20976":117103,"_5":14428,"_27536":116902,"_2958":117104},[],"detección automática",{"_3475":70527,"_30304":70446,"_20976":117106,"_5":14428,"_27536":116902,"_2958":117107},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3475":70528,"_30304":70446,"_20976":117109,"_5":14428,"_27536":116902,"_2958":49908},[],{"_3475":70529,"_30304":70446,"_20976":117111,"_5":14428,"_27536":116902,"_2958":6570},[],{"_3475":70530,"_30304":70446,"_20976":117113,"_5":14428,"_27536":116902,"_2958":117114},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3475":70531,"_30304":70446,"_20976":117116,"_5":14428,"_27536":116902,"_2958":49916},[],{"_3475":70532,"_30304":70446,"_20976":117118,"_5":14428,"_27536":116902,"_2958":6570},[],{"_3475":70533,"_30304":70446,"_20976":117120,"_5":14428,"_27536":116902,"_2958":117121},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3475":70534,"_30304":70446,"_20976":117123,"_5":14428,"_27536":116902,"_2958":49924},[],{"_3475":70535,"_30304":70446,"_20976":117125,"_5":14428,"_27536":116902,"_2958":6570},[],{"_3475":70536,"_30304":70446,"_20976":117127,"_5":14428,"_27536":116902,"_2958":117128},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3475":70537,"_30304":70446,"_20976":117130,"_5":14428,"_27536":116902,"_2958":49932},[],{"_3475":70538,"_30304":70446,"_20976":117132,"_5":14428,"_27536":116902,"_2958":6570},[],{"_3475":70539,"_30304":70446,"_20976":117134,"_5":14428,"_27536":116902,"_2958":117135},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3475":70540,"_30304":70446,"_20976":117137,"_5":14428,"_27536":116902,"_2958":49940},[],{"_3475":70541,"_30304":70446,"_20976":117139,"_5":14428,"_27536":116902,"_2958":49943},[],{"_3475":70542,"_30304":70446,"_20976":117141,"_5":14428,"_27536":116902,"_2958":117142},[],"Usa otro chart local de SoftHSM",{"_3475":70543,"_30304":70446,"_20976":117144,"_5":14428,"_27536":116902,"_2958":117145},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3475":70544,"_30304":70446,"_20976":117147,"_5":14428,"_27536":116906,"_2958":117148},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3475":70545,"_30304":70446,"_20976":117150,"_5":14428,"_27536":116906,"_2958":117151},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3475":70546,"_30304":70446,"_20976":117153,"_5":14428,"_27536":116906,"_2958":117154},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3475":70547,"_30304":70446,"_20976":117156,"_5":14428,"_27536":116906,"_2958":117157},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3475":70548,"_30304":70446,"_20976":117159,"_5":14428,"_27536":116906,"_2958":117160},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3475":70549,"_30304":70446,"_20976":117162,"_5":14428,"_27536":116906,"_2958":117163},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3475":70550,"_30304":70446,"_20976":117165,"_5":14428,"_27536":116910,"_2958":49970},[],{"_3475":70551,"_30304":70446,"_20976":117167,"_5":14428,"_27536":116910,"_2958":117168},[],"valida las herramientas locales y el clúster seleccionado",{"_3475":70552,"_30304":70446,"_20976":117170,"_5":14428,"_27536":116910,"_2958":117171},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3475":70553,"_30304":70446,"_20976":117173,"_5":14428,"_27536":116910,"_2958":117174},[],"crea el namespace",{"_3475":70554,"_30304":70446,"_20976":117176,"_5":14428,"_27536":116910,"_2958":117177},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3475":70555,"_30304":70446,"_20976":117179,"_5":14428,"_27536":116910,"_2958":117180},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3475":70556,"_30304":70446,"_20976":117182,"_5":14428,"_27536":116910,"_2958":117183},[],"instala RabbitMQ",{"_3475":70557,"_30304":70446,"_20976":117185,"_5":14428,"_27536":116910,"_2958":117186},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3475":70558,"_30304":70446,"_20976":117188,"_5":14428,"_27536":116910,"_2958":117189},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3475":70559,"_30304":70446,"_20976":117191,"_5":14428,"_27536":116910,"_2958":117192},[],"carga datos de ejemplo opcionalmente",{"_3475":70560,"_30304":70446,"_20976":117194,"_5":14428,"_27536":116910,"_2958":117195},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3475":70561,"_30304":70446,"_20976":117197,"_5":14428,"_27536":116914,"_2958":117198},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3475":70562,"_30304":70446,"_20976":117200,"_5":14428,"_27536":116914,"_2958":117201},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3475":70563,"_30304":70446,"_20976":117203,"_5":14428,"_27536":116918,"_2958":117204},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3475":70564,"_30304":70446,"_20976":117206,"_5":14428,"_27536":116918,"_2958":117207},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3475":70565,"_30304":70446,"_20976":117209,"_5":14428,"_27536":116918,"_2958":117210},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3475":70566,"_30304":70446,"_20976":117212,"_5":14428,"_27536":116922,"_2958":117213},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3475":70567,"_30304":70567,"_5":14780,"_2958":117215,"_30657":117216,"_20976":117217,"_27536":70567},"Instala con Helm",[49412,116641,116875],[],{"_3475":70568,"_30304":70567,"_20976":117219,"_5":14428,"_27536":70567,"_2958":117220},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3475":70569,"_30304":70567,"_5":30654,"_20976":117222,"_27536":117223,"_2958":117224},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3475":70570,"_30304":70567,"_5":30654,"_20976":117226,"_27536":117227,"_2958":116891},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3475":70571,"_30304":70567,"_5":30654,"_20976":117229,"_27536":117230,"_2958":117231},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3475":70572,"_30304":70567,"_5":30654,"_20976":117233,"_27536":117234,"_2958":117235},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3475":70573,"_30304":70567,"_5":30654,"_20976":117237,"_27536":117238,"_2958":117239},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3475":70574,"_30304":70567,"_5":30654,"_20976":117241,"_27536":117242,"_2958":117243},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3475":70575,"_30304":70567,"_5":30654,"_20976":117245,"_27536":117246,"_2958":117247},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3475":70576,"_30304":70567,"_5":30654,"_20976":117249,"_27536":117250,"_2958":117251},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3475":70577,"_30304":70567,"_5":30654,"_20976":117253,"_27536":117254,"_2958":117255},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3475":70578,"_30304":70567,"_5":30654,"_20976":117257,"_27536":117258,"_2958":117259},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3475":70579,"_30304":70567,"_5":30654,"_20976":117261,"_27536":117262,"_2958":117263},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3475":70580,"_30304":70567,"_20976":117265,"_5":14428,"_27536":117223,"_2958":117266},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3475":70581,"_30304":70567,"_20976":117268,"_5":14428,"_27536":117227,"_2958":117269},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3475":70582,"_30304":70567,"_20976":117271,"_5":14428,"_27536":117227,"_2958":117272},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3475":70583,"_30304":70567,"_20976":117274,"_5":14428,"_27536":117227,"_2958":117275},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3475":70584,"_30304":70567,"_20976":117277,"_5":14428,"_27536":117227,"_2958":117278},[],"un broker RabbitMQ accesible y sus credenciales",{"_3475":70585,"_30304":70567,"_20976":117280,"_5":14428,"_27536":117227,"_2958":117281},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3475":70586,"_30304":70567,"_20976":117283,"_5":14428,"_27536":117227,"_2958":117284},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3475":70587,"_30304":70567,"_20976":117286,"_5":14428,"_27536":117227,"_2958":117287},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3475":70588,"_30304":70567,"_20976":117289,"_5":14428,"_27536":117227,"_2958":117290},[],"una StorageClass y un diseño de tráfico externo",{"_3475":70589,"_30304":70567,"_20976":117292,"_5":14428,"_27536":117227,"_2958":117293},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3475":70590,"_30304":70567,"_20976":117295,"_5":14428,"_27536":117227,"_2958":117296},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3475":70591,"_30304":70567,"_20976":117298,"_5":14428,"_27536":117227,"_2958":117299},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3475":70592,"_30304":70567,"_20976":117301,"_5":14428,"_27536":117230,"_2958":117302},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3475":70593,"_30304":70567,"_20976":117304,"_5":14428,"_27536":117230,"_2958":117305},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3475":70594,"_30304":70567,"_20976":117307,"_5":14428,"_27536":117230,"_2958":117308},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3475":70595,"_30304":70567,"_20976":117310,"_5":14428,"_27536":117234,"_2958":117311},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3475":70596,"_30304":70567,"_20976":117313,"_5":14428,"_27536":117234,"_2958":117314},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3475":70597,"_30304":70567,"_20976":117316,"_5":14428,"_27536":117234,"_2958":117317},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3475":70598,"_30304":70567,"_20976":117319,"_5":14428,"_27536":117234,"_2958":117320},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3475":70599,"_30304":70567,"_20976":117322,"_5":14428,"_27536":117238,"_2958":117323},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3475":70600,"_30304":70567,"_20976":117325,"_5":14428,"_27536":117242,"_2958":117326},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3475":70601,"_30304":70567,"_20976":117328,"_5":14428,"_27536":117242,"_2958":117329},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3475":70602,"_30304":70567,"_20976":117331,"_5":14428,"_27536":117242,"_2958":117332},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3475":70603,"_30304":70567,"_20976":117334,"_5":14428,"_27536":117242,"_2958":117335},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3475":70604,"_30304":70567,"_20976":117337,"_5":14428,"_27536":117242,"_2958":117338},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3475":70605,"_30304":70567,"_20976":117340,"_5":14428,"_27536":117242,"_2958":117341},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3475":70606,"_30304":70567,"_20976":117343,"_5":14428,"_27536":117242,"_2958":117344},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3475":70607,"_30304":70567,"_20976":117346,"_5":14428,"_27536":117246,"_2958":117347},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3475":70608,"_30304":70567,"_20976":117349,"_5":14428,"_27536":117246,"_2958":117350},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3475":70609,"_30304":70567,"_20976":117352,"_5":14428,"_27536":117246,"_2958":117353},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3475":70610,"_30304":70567,"_20976":117355,"_5":14428,"_27536":117246,"_2958":117356},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3475":70611,"_30304":70567,"_20976":117358,"_5":14428,"_27536":117250,"_2958":117359},[],"Para instalar un checkout local:",{"_3475":70612,"_30304":70567,"_20976":117361,"_5":14428,"_27536":117254,"_2958":117362},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3475":70613,"_30304":70567,"_20976":117364,"_5":14428,"_27536":117254,"_2958":117365},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3475":70614,"_30304":70567,"_20976":117367,"_5":14428,"_27536":117258,"_2958":117368},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3475":70615,"_30304":70567,"_20976":117370,"_5":14428,"_27536":117258,"_2958":117371},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3475":70616,"_30304":70567,"_20976":117373,"_5":14428,"_27536":117258,"_2958":117374},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3475":70617,"_30304":70567,"_20976":117376,"_5":14428,"_27536":117258,"_2958":117377},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3475":70618,"_30304":70567,"_20976":117379,"_5":14428,"_27536":117258,"_2958":117380},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3475":70619,"_30304":70567,"_20976":117382,"_5":14428,"_27536":117262,"_2958":117383},[],"Antes de pasar a producción, revisa:",{"_3475":70620,"_30304":70567,"_20976":117385,"_5":14428,"_27536":117262,"_2958":117386},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3475":70621,"_30304":70567,"_20976":117388,"_5":14428,"_27536":117262,"_2958":117389},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3475":70622,"_30304":70567,"_20976":117391,"_5":14428,"_27536":117262,"_2958":117392},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3475":70623,"_30304":70567,"_20976":117394,"_5":14428,"_27536":117262,"_2958":117395},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3475":70624,"_30304":70567,"_20976":117397,"_5":14428,"_27536":117262,"_2958":117398},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3475":70625,"_30304":70567,"_20976":117400,"_5":14428,"_27536":117262,"_2958":117401},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3475":70626,"_30304":70567,"_20976":117403,"_5":14428,"_27536":117262,"_2958":117404},[],"SMTP, observabilidad y entrega de alertas",{"_3475":70627,"_30304":70567,"_20976":117406,"_5":14428,"_27536":117262,"_2958":117407},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3475":70628,"_30304":70567,"_20976":117409,"_5":14428,"_27536":117262,"_2958":117410},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3475":70629,"_30304":70629,"_5":14780,"_2958":117412,"_30657":117413,"_20976":117414,"_27536":70629},"Expón el Gateway",[49412,116641,116875],[],{"_3475":70630,"_30304":70629,"_20976":117416,"_5":14428,"_27536":70629,"_2958":117417},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3475":70631,"_30304":70629,"_5":30654,"_20976":117419,"_27536":117420,"_2958":117421},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3475":70632,"_30304":70629,"_5":30654,"_20976":117423,"_27536":117424,"_2958":117425},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3475":70633,"_30304":70629,"_5":30654,"_20976":117427,"_27536":117428,"_2958":117429},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3475":70634,"_30304":70629,"_5":30654,"_20976":117431,"_27536":117432,"_2958":50238},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#k3s",{"_3475":70635,"_30304":70629,"_5":30654,"_20976":117434,"_27536":117435,"_2958":117436},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3475":70636,"_30304":70629,"_5":30654,"_20976":117438,"_27536":117439,"_2958":117440},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3475":70637,"_30304":70629,"_5":30654,"_20976":117442,"_27536":117443,"_2958":117444},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3475":70638,"_30304":70629,"_5":30654,"_20976":117446,"_27536":117447,"_2958":117448},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3475":70639,"_30304":70629,"_5":30654,"_20976":117450,"_27536":117451,"_2958":117452},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3475":70640,"_30304":70629,"_5":30654,"_20976":117454,"_27536":117455,"_2958":117456},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3475":70641,"_30304":70629,"_5":30654,"_20976":117458,"_27536":117459,"_2958":117460},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3475":70642,"_30304":70629,"_20976":117462,"_5":14428,"_27536":117420,"_2958":117463},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3475":70643,"_30304":70629,"_20976":117465,"_5":14428,"_27536":117420,"_2958":117466},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3475":70644,"_30304":70629,"_20976":117468,"_5":14428,"_27536":117424,"_2958":117469},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3475":70645,"_30304":70629,"_20976":117471,"_5":14428,"_27536":117424,"_2958":117472},[],"Defínelo únicamente cuando:",{"_3475":70646,"_30304":70629,"_20976":117474,"_5":14428,"_27536":117424,"_2958":117475},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3475":70647,"_30304":70629,"_20976":117477,"_5":14428,"_27536":117424,"_2958":117478},[],"esa dirección está asignada a este Gateway",{"_3475":70648,"_30304":70629,"_20976":117480,"_5":14428,"_27536":117424,"_2958":117481},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3475":70649,"_30304":70629,"_20976":117483,"_5":14428,"_27536":117424,"_2958":117484},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3475":70650,"_30304":70629,"_20976":117486,"_5":14428,"_27536":117424,"_2958":117487},[],"No confundas estos valores:",{"_3475":70651,"_30304":70629,"_20976":117489,"_5":14428,"_27536":117424,"_2958":117490},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3475":70652,"_30304":70629,"_20976":117492,"_5":14428,"_27536":117424,"_2958":117493},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3475":70653,"_30304":70629,"_20976":117495,"_5":14428,"_27536":117424,"_2958":117496},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3475":70654,"_30304":70629,"_20976":117498,"_5":14428,"_27536":117428,"_2958":117499},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3475":70655,"_30304":70629,"_20976":117501,"_5":14428,"_27536":117428,"_2958":117502},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3475":70656,"_30304":70629,"_20976":117504,"_5":14428,"_27536":117432,"_2958":117505},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3475":70657,"_30304":70629,"_20976":117507,"_5":14428,"_27536":117432,"_2958":117508},[],"Para el diseño recomendado:",{"_3475":70658,"_30304":70629,"_20976":117510,"_5":14428,"_27536":117432,"_2958":117511},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3475":70659,"_30304":70629,"_20976":117513,"_5":14428,"_27536":117432,"_2958":117514},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3475":70660,"_30304":70629,"_20976":117516,"_5":14428,"_27536":117432,"_2958":117517},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3475":70661,"_30304":70629,"_20976":117519,"_5":14428,"_27536":117432,"_2958":117520},[],"Apunta DNS a la dirección accesible de la VM.",{"_3475":70662,"_30304":70629,"_20976":117522,"_5":14428,"_27536":117432,"_2958":117523},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3475":70663,"_30304":70629,"_20976":117525,"_5":14428,"_27536":117435,"_2958":117526},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3475":70664,"_30304":70629,"_20976":117528,"_5":14428,"_27536":117439,"_2958":117529},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3475":70665,"_30304":70629,"_20976":117531,"_5":14428,"_27536":117439,"_2958":117532},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3475":70666,"_30304":70629,"_20976":117534,"_5":14428,"_27536":117443,"_2958":117535},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3475":70667,"_30304":70629,"_20976":117537,"_5":14428,"_27536":117443,"_2958":117538},[],"Requisito",{"_3475":70668,"_30304":70629,"_20976":117540,"_5":14428,"_27536":117443,"_2958":117541},[],"Diseño recomendado",{"_3475":70669,"_30304":70629,"_20976":117543,"_5":14428,"_27536":117443,"_2958":117544},[],"Consecuencia",{"_3475":70670,"_30304":70629,"_20976":117546,"_5":14428,"_27536":117443,"_2958":117547},[],"Varias URL o servicios de Lamassu",{"_3475":70671,"_30304":70629,"_20976":117549,"_5":14428,"_27536":117443,"_2958":117550},[],"Un Gateway con varias rutas",{"_3475":70672,"_30304":70629,"_20976":117552,"_5":14428,"_27536":117443,"_2958":117553},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3475":70673,"_30304":70629,"_20976":117555,"_5":14428,"_27536":117443,"_2958":117556},[],"Gateways independientes e IP externas distintas",{"_3475":70674,"_30304":70629,"_20976":117558,"_5":14428,"_27536":117443,"_2958":117559},[],"Una VIP por Gateway",{"_3475":70675,"_30304":70629,"_20976":117561,"_5":14428,"_27536":117443,"_2958":117562},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3475":70676,"_30304":70629,"_20976":117564,"_5":14428,"_27536":117443,"_2958":117565},[],"Gateways independientes, un nodo y una IP",{"_3475":70677,"_30304":70629,"_20976":117567,"_5":14428,"_27536":117443,"_2958":117568},[],"Puertos externos diferentes",{"_3475":70678,"_30304":70629,"_20976":117570,"_5":14428,"_27536":117443,"_2958":117571},[],"Los clientes deben indicar puertos no estándar",{"_3475":70679,"_30304":70629,"_20976":117573,"_5":14428,"_27536":117443,"_2958":117574},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3475":70680,"_30304":70629,"_20976":117576,"_5":14428,"_27536":117443,"_2958":117577},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3475":70681,"_30304":70629,"_20976":117579,"_5":14428,"_27536":117443,"_2958":117580},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3475":70682,"_30304":70629,"_20976":117582,"_5":14428,"_27536":117443,"_2958":117583},[],"Recursos Gateway separados pero proxy compartido",{"_3475":70683,"_30304":70629,"_20976":117585,"_5":14428,"_27536":117443,"_2958":117586},[],"Modo merged Gateway de Envoy",{"_3475":70684,"_30304":70629,"_20976":117588,"_5":14428,"_27536":117443,"_2958":117589},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3475":70685,"_30304":70629,"_20976":117591,"_5":14428,"_27536":117443,"_2958":117592},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3475":70686,"_30304":70629,"_20976":117594,"_5":14428,"_27536":117443,"_2958":117595},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3475":70687,"_30304":70629,"_20976":117597,"_5":14428,"_27536":117443,"_2958":117598},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3475":70688,"_30304":70629,"_20976":117600,"_5":14428,"_27536":117443,"_2958":117601},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3475":70689,"_30304":70629,"_20976":117603,"_5":14428,"_27536":117447,"_2958":117604},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3475":70690,"_30304":70629,"_20976":117606,"_5":14428,"_27536":117451,"_2958":117607},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3475":70691,"_30304":70629,"_20976":117609,"_5":14428,"_27536":117451,"_2958":117610},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3475":70692,"_30304":70629,"_20976":117612,"_5":14428,"_27536":117451,"_2958":117613},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3475":70693,"_30304":70629,"_20976":117615,"_5":14428,"_27536":117451,"_2958":117616},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3475":70694,"_30304":70629,"_20976":117618,"_5":14428,"_27536":117451,"_2958":117619},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3475":70695,"_30304":70629,"_20976":117621,"_5":14428,"_27536":117455,"_2958":117622},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3475":70696,"_30304":70629,"_20976":117624,"_5":14428,"_27536":117455,"_2958":117625},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3475":70697,"_30304":70629,"_20976":117627,"_5":14428,"_27536":117459,"_2958":117628},[],"Comprueba, en orden:",{"_3475":70698,"_30304":70629,"_20976":117630,"_5":14428,"_27536":117459,"_2958":117631},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3475":70699,"_30304":70629,"_20976":117633,"_5":14428,"_27536":117459,"_2958":117634},[],"Su estado contiene la dirección esperada.",{"_3475":70700,"_30304":70629,"_20976":117636,"_5":14428,"_27536":117459,"_2958":117637},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3475":70701,"_30304":70629,"_20976":117639,"_5":14428,"_27536":117459,"_2958":117640},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3475":70702,"_30304":70629,"_20976":117642,"_5":14428,"_27536":117459,"_2958":117643},[],"DNS resuelve al endpoint accesible externamente.",{"_3475":70703,"_30304":70629,"_20976":117645,"_5":14428,"_27536":117459,"_2958":117646},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3475":70704,"_30304":70629,"_20976":117648,"_5":14428,"_27536":117459,"_2958":117649},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3475":70705,"_30304":70705,"_5":14780,"_2958":49519,"_30657":117651,"_20976":117652,"_27536":70705},[49412,116641,116875],[],{"_3475":70706,"_30304":70705,"_20976":117654,"_5":14428,"_27536":70705,"_2958":117655},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3475":70707,"_30304":70705,"_5":30654,"_20976":117657,"_27536":117658,"_2958":117659},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3475":70708,"_30304":70705,"_5":30654,"_20976":117661,"_27536":117662,"_2958":117663},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3475":70709,"_30304":70705,"_5":30654,"_20976":117665,"_27536":117666,"_2958":117667},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3475":70710,"_30304":70705,"_5":30654,"_20976":117669,"_27536":117670,"_2958":117671},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3475":70711,"_30304":70705,"_5":30654,"_20976":117673,"_27536":117674,"_2958":117675},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3475":70712,"_30304":70705,"_5":30654,"_20976":117677,"_27536":117678,"_2958":117679},[],"/docs/pr-preview/pr-65/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3475":70713,"_30304":70705,"_20976":117681,"_5":14428,"_27536":117658,"_2958":117682},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3475":70714,"_30304":70705,"_20976":117684,"_5":14428,"_27536":117662,"_2958":117685},[],"Flujo",{"_3475":70715,"_30304":70705,"_20976":117687,"_5":14428,"_27536":117662,"_2958":117688},[],"Úsalo para",{"_3475":70716,"_30304":70705,"_20976":117690,"_5":14428,"_27536":117662,"_2958":117691},[],"Qué instala",{"_3475":70717,"_30304":70705,"_20976":117693,"_5":14428,"_27536":117662,"_2958":50500},[],{"_3475":70718,"_30304":70705,"_20976":117695,"_5":14428,"_27536":117662,"_2958":117696},[],"Producción y entornos controlados",{"_3475":70719,"_30304":70705,"_20976":117698,"_5":14428,"_27536":117662,"_2958":117699},[],"Servicios de Lamassu y recursos de Gateway API",{"_3475":70720,"_30304":70705,"_20976":117701,"_5":14428,"_27536":117662,"_2958":49656},[],{"_3475":70721,"_30304":70705,"_20976":117703,"_5":14428,"_27536":117662,"_2958":117704},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3475":70722,"_30304":70705,"_20976":117706,"_5":14428,"_27536":117662,"_2958":117707},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3475":70723,"_30304":70705,"_20976":117709,"_5":14428,"_27536":117666,"_2958":117710},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3475":70724,"_30304":70705,"_20976":117712,"_5":14428,"_27536":117666,"_2958":117713},[],"Área",{"_3475":70725,"_30304":70705,"_20976":117715,"_5":14428,"_27536":117666,"_2958":117716},[],"El chart de Lamassu proporciona",{"_3475":70726,"_30304":70705,"_20976":117718,"_5":14428,"_27536":117666,"_2958":117719},[],"Tú proporcionas",{"_3475":70727,"_30304":70705,"_20976":117721,"_5":14428,"_27536":117666,"_2958":117722},[],"Aplicaciones Lamassu",{"_3475":70728,"_30304":70705,"_20976":117724,"_5":14428,"_27536":117666,"_2958":117725},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3475":70729,"_30304":70705,"_20976":117727,"_5":14428,"_27536":117666,"_2958":117728},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3475":70730,"_30304":70705,"_20976":117730,"_5":14428,"_27536":117666,"_2958":117731},[],"Datos PostgreSQL",{"_3475":70731,"_30304":70705,"_20976":117733,"_5":14428,"_27536":117666,"_2958":117734},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3475":70732,"_30304":70705,"_20976":117736,"_5":14428,"_27536":117666,"_2958":117737},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3475":70733,"_30304":70705,"_20976":117739,"_5":14428,"_27536":117666,"_2958":117740},[],"Mensajería",{"_3475":70734,"_30304":70705,"_20976":117742,"_5":14428,"_27536":117666,"_2958":117743},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3475":70735,"_30304":70705,"_20976":117745,"_5":14428,"_27536":117666,"_2958":117746},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3475":70736,"_30304":70705,"_20976":117748,"_5":14428,"_27536":117666,"_2958":117749},[],"Identidad",{"_3475":70737,"_30304":70705,"_20976":117751,"_5":14428,"_27536":117666,"_2958":117752},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3475":70738,"_30304":70705,"_20976":117754,"_5":14428,"_27536":117666,"_2958":117755},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3475":70739,"_30304":70705,"_20976":117757,"_5":14428,"_27536":117666,"_2958":117758},[],"Enrutamiento externo",{"_3475":70740,"_30304":70705,"_20976":117760,"_5":14428,"_27536":117666,"_2958":117761},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3475":70741,"_30304":70705,"_20976":117763,"_5":14428,"_27536":117666,"_2958":117764},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3475":70742,"_30304":70705,"_20976":117766,"_5":14428,"_27536":117666,"_2958":50574},[],{"_3475":70743,"_30304":70705,"_20976":117768,"_5":14428,"_27536":117666,"_2958":117769},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3475":70744,"_30304":70705,"_20976":117771,"_5":14428,"_27536":117666,"_2958":117772},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3475":70745,"_30304":70705,"_20976":117774,"_5":14428,"_27536":117666,"_2958":117775},[],"Datos persistentes de la aplicación",{"_3475":70746,"_30304":70705,"_20976":117777,"_5":14428,"_27536":117666,"_2958":117778},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3475":70747,"_30304":70705,"_20976":117780,"_5":14428,"_27536":117666,"_2958":117781},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3475":70748,"_30304":70705,"_20976":117783,"_5":14428,"_27536":117666,"_2958":117784},[],"Integraciones opcionales",{"_3475":70749,"_30304":70705,"_20976":117786,"_5":14428,"_27536":117666,"_2958":117787},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3475":70750,"_30304":70705,"_20976":117789,"_5":14428,"_27536":117666,"_2958":117790},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3475":70751,"_30304":70705,"_20976":117792,"_5":14428,"_27536":117666,"_2958":117793},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3475":70752,"_30304":70705,"_20976":117795,"_5":14428,"_27536":117666,"_2958":117796},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3475":70753,"_30304":70705,"_20976":117798,"_5":14428,"_27536":117670,"_2958":117799},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3475":70754,"_30304":70705,"_20976":117801,"_5":14428,"_27536":117670,"_2958":117802},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3475":70755,"_30304":70705,"_20976":117804,"_5":14428,"_27536":117674,"_2958":117805},[],"Kubernetes 1.24 o posterior",{"_3475":70756,"_30304":70705,"_20976":117807,"_5":14428,"_27536":117674,"_2958":117808},[],"Helm 3.2 o posterior",{"_3475":70757,"_30304":70705,"_20976":117810,"_5":14428,"_27536":117674,"_2958":117811},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3475":70758,"_30304":70705,"_20976":117813,"_5":14428,"_27536":117674,"_2958":117814},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3475":70759,"_30304":70705,"_20976":117816,"_5":14428,"_27536":117674,"_2958":117817},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3475":70760,"_30304":70705,"_20976":117819,"_5":14428,"_27536":117674,"_2958":117820},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3475":70761,"_30304":70705,"_20976":117822,"_5":14428,"_27536":117674,"_2958":117823},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3475":70762,"_30304":70705,"_20976":117825,"_5":14428,"_27536":117678,"_2958":117826},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3475":70763,"_30304":70705,"_20976":117828,"_5":14428,"_27536":117678,"_2958":117829},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3475":70764,"_30304":70705,"_20976":117831,"_5":14428,"_27536":117678,"_2958":117832},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3475":70765,"_30304":70705,"_20976":117834,"_5":14428,"_27536":117678,"_2958":117835},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3475":70766,"_30304":70766,"_5":14780,"_2958":117837,"_30657":117838,"_20976":117840,"_27536":70766},"Resolución de problemas de despliegue",[49412,116641,117839],"Operación",[],{"_3475":70767,"_30304":70766,"_20976":117842,"_5":14428,"_27536":70766,"_2958":117843},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3475":70768,"_30304":70766,"_5":30654,"_20976":117845,"_27536":117846,"_2958":117847},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3475":70769,"_30304":70766,"_5":30654,"_20976":117849,"_27536":117850,"_2958":117851},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3475":70770,"_30304":70766,"_5":30654,"_20976":117853,"_27536":117854,"_2958":117855},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3475":70771,"_30304":70766,"_5":30654,"_20976":117857,"_27536":117858,"_2958":117859},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3475":70772,"_30304":70766,"_5":30654,"_20976":117861,"_27536":117862,"_2958":117863},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3475":70773,"_30304":70766,"_5":30654,"_20976":117865,"_27536":117866,"_2958":117867},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3475":70774,"_30304":70766,"_5":30654,"_20976":117869,"_27536":117870,"_2958":117871},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3475":70775,"_30304":70766,"_5":30654,"_20976":117873,"_27536":117874,"_2958":117875},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3475":70776,"_30304":70766,"_5":30654,"_20976":117877,"_27536":117878,"_2958":117879},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3475":70777,"_30304":70766,"_5":30654,"_20976":117881,"_27536":117882,"_2958":117883},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3475":70778,"_30304":70766,"_5":30654,"_20976":117885,"_27536":117886,"_2958":117887},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3475":70779,"_30304":70766,"_5":30654,"_20976":117889,"_27536":117890,"_2958":117891},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3475":70780,"_30304":70766,"_5":30654,"_20976":117893,"_27536":117894,"_2958":117895},[],"/docs/pr-preview/pr-65/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3475":70781,"_30304":70766,"_20976":117897,"_5":14428,"_27536":70766,"_2958":117898},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3475":70782,"_30304":70766,"_20976":117900,"_5":14428,"_27536":117850,"_2958":117901},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3475":70783,"_30304":70766,"_20976":117903,"_5":14428,"_27536":117854,"_2958":117904},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3475":70784,"_30304":70766,"_20976":117906,"_5":14428,"_27536":117858,"_2958":117907},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3475":70785,"_30304":70766,"_20976":117909,"_5":14428,"_27536":117862,"_2958":117910},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3475":70786,"_30304":70766,"_20976":117912,"_5":14428,"_27536":117866,"_2958":117913},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3475":70787,"_30304":70766,"_20976":117915,"_5":14428,"_27536":117870,"_2958":117916},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3475":70788,"_30304":70766,"_20976":117918,"_5":14428,"_27536":117870,"_2958":117919},[],"Ejecuta también la prueba de conectividad del chart:",{"_3475":70789,"_30304":70766,"_20976":117921,"_5":14428,"_27536":117870,"_2958":117922},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3475":70790,"_30304":70766,"_20976":117924,"_5":14428,"_27536":117870,"_2958":117925},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3475":70791,"_30304":70766,"_20976":117927,"_5":14428,"_27536":117874,"_2958":117928},[],"Si recibes un 401:",{"_3475":70792,"_30304":70766,"_20976":117930,"_5":14428,"_27536":117874,"_2958":117931},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3475":70793,"_30304":70766,"_20976":117933,"_5":14428,"_27536":117874,"_2958":117934},[],"verifica emisor, audiencia y expiración del token;",{"_3475":70794,"_30304":70766,"_20976":117936,"_5":14428,"_27536":117874,"_2958":117937},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3475":70795,"_30304":70766,"_20976":117939,"_5":14428,"_27536":117874,"_2958":117940},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3475":70796,"_30304":70766,"_20976":117942,"_5":14428,"_27536":117874,"_2958":117943},[],"Si el login termina pero las APIs devuelven 403:",{"_3475":70797,"_30304":70766,"_20976":117945,"_5":14428,"_27536":117874,"_2958":117946},[],"inspecciona los claims reales del token;",{"_3475":70798,"_30304":70766,"_20976":117948,"_5":14428,"_27536":117874,"_2958":117949},[],"confirma que coinciden con un principal activo;",{"_3475":70799,"_30304":70766,"_20976":117951,"_5":14428,"_27536":117874,"_2958":117952},[],"revisa las políticas concedidas al principal;",{"_3475":70800,"_30304":70766,"_20976":117954,"_5":14428,"_27536":117874,"_2958":117955},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3475":70801,"_30304":70766,"_20976":117957,"_5":14428,"_27536":117874,"_2958":117958},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3475":70802,"_30304":70766,"_20976":117960,"_5":14428,"_27536":117878,"_2958":117961},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3475":70803,"_30304":70766,"_20976":117963,"_5":14428,"_27536":117878,"_2958":117964},[],"Localiza el pod y Service de authz.",{"_3475":70804,"_30304":70766,"_20976":117966,"_5":14428,"_27536":117878,"_2958":117967},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3475":70805,"_30304":70766,"_20976":117969,"_5":14428,"_27536":117878,"_2958":117970},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3475":70806,"_30304":70766,"_20976":117972,"_5":14428,"_27536":117878,"_2958":117973},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3475":70807,"_30304":70766,"_20976":117975,"_5":14428,"_27536":117878,"_2958":117976},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3475":70808,"_30304":70766,"_20976":117978,"_5":14428,"_27536":117882,"_2958":117979},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3475":70809,"_30304":70766,"_20976":117981,"_5":14428,"_27536":117886,"_2958":117982},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3475":70810,"_30304":70766,"_20976":117984,"_5":14428,"_27536":117886,"_2958":117985},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3475":70811,"_30304":70766,"_20976":117987,"_5":14428,"_27536":117886,"_2958":117988},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3475":70812,"_30304":70766,"_20976":117990,"_5":14428,"_27536":117886,"_2958":117991},[],"volumen persistente sin enlazar;",{"_3475":70813,"_30304":70766,"_20976":117993,"_5":14428,"_27536":117886,"_2958":117994},[],"imagen inaccesible o política de pull incorrecta;",{"_3475":70814,"_30304":70766,"_20976":117996,"_5":14428,"_27536":117886,"_2958":117997},[],"configuración inválida del motor criptográfico;",{"_3475":70815,"_30304":70766,"_20976":117999,"_5":14428,"_27536":117886,"_2958":118000},[],"límites de CPU o memoria demasiado bajos;",{"_3475":70816,"_30304":70766,"_20976":118002,"_5":14428,"_27536":117886,"_2958":118003},[],"migración previa incompleta.",{"_3475":70817,"_30304":70766,"_20976":118005,"_5":14428,"_27536":117886,"_2958":118006},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3475":70818,"_30304":70766,"_20976":118008,"_5":14428,"_27536":117886,"_2958":118009},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3475":70819,"_30304":70766,"_20976":118011,"_5":14428,"_27536":117886,"_2958":118012},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3475":70820,"_30304":70766,"_20976":118014,"_5":14428,"_27536":117890,"_2958":118015},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3475":70821,"_30304":70766,"_20976":118017,"_5":14428,"_27536":117890,"_2958":118018},[],"verifica que esté habilitado en el servicio emisor;",{"_3475":70822,"_30304":70766,"_20976":118020,"_5":14428,"_27536":117890,"_2958":118021},[],"comprueba conectividad y credenciales AMQP;",{"_3475":70823,"_30304":70766,"_20976":118023,"_5":14428,"_27536":117890,"_2958":118024},[],"revisa exchange, routing key, colas y consumidores;",{"_3475":70824,"_30304":70766,"_20976":118026,"_5":14428,"_27536":117890,"_2958":118027},[],"inspecciona dead-letter queues;",{"_3475":70825,"_30304":70766,"_20976":118029,"_5":14428,"_27536":117890,"_2958":118030},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3475":70826,"_30304":70766,"_20976":118032,"_5":14428,"_27536":117890,"_2958":118033},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3475":70827,"_30304":70766,"_20976":118035,"_5":14428,"_27536":117890,"_2958":118036},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3475":70828,"_30304":70766,"_20976":118038,"_5":14428,"_27536":117890,"_2958":118039},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3475":70829,"_30304":70766,"_20976":118041,"_5":14428,"_27536":117890,"_2958":118042},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3475":70830,"_30304":70766,"_20976":118044,"_5":14428,"_27536":117890,"_2958":118045},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3475":70831,"_30304":70766,"_20976":118047,"_5":14428,"_27536":117890,"_2958":118048},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3475":70832,"_30304":70766,"_20976":118050,"_5":14428,"_27536":117890,"_2958":118051},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3475":70833,"_30304":70766,"_20976":118053,"_5":14428,"_27536":117894,"_2958":118054},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3475":70834,"_30304":70766,"_20976":118056,"_5":14428,"_27536":117894,"_2958":118057},[],"Antes de cerrar una incidencia, guarda:",{"_3475":70835,"_30304":70766,"_20976":118059,"_5":14428,"_27536":117894,"_2958":118060},[],"causa confirmada;",{"_3475":70836,"_30304":70766,"_20976":118062,"_5":14428,"_27536":117894,"_2958":118063},[],"alcance temporal y recursos afectados;",{"_3475":70837,"_30304":70766,"_20976":118065,"_5":14428,"_27536":117894,"_2958":118066},[],"comandos o consultas utilizados;",{"_3475":70838,"_30304":70766,"_20976":118068,"_5":14428,"_27536":117894,"_2958":118069},[],"cambio aplicado y forma de revertirlo;",{"_3475":70839,"_30304":70766,"_20976":118071,"_5":14428,"_27536":117894,"_2958":118072},[],"validación desde un consumidor;",{"_3475":70840,"_30304":70766,"_20976":118074,"_5":14428,"_27536":117894,"_2958":118075},[],"acción preventiva y propietario.",{"_3475":70841,"_30304":70841,"_5":14780,"_2958":118077,"_30657":118078,"_20976":118081,"_27536":70841},"Control de acceso",[49412,118079,118080],"Plataforma","Administración",[],{"_3475":70842,"_30304":70841,"_20976":118083,"_5":14428,"_27536":70841,"_2958":118084},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3475":70843,"_30304":70841,"_5":30654,"_20976":118086,"_27536":118087,"_2958":118088},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3475":70844,"_30304":70841,"_5":30654,"_20976":118090,"_27536":118091,"_2958":118092},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3475":70845,"_30304":70841,"_5":30654,"_20976":118094,"_27536":118095,"_2958":118096},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3475":70846,"_30304":70841,"_5":30654,"_20976":118098,"_27536":118099,"_2958":118100},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3475":70847,"_30304":70841,"_5":30654,"_20976":118102,"_27536":118103,"_2958":118104},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3475":70848,"_30304":70841,"_5":30654,"_20976":118106,"_27536":118107,"_2958":118108},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3475":70849,"_30304":70841,"_5":30654,"_20976":118110,"_27536":118111,"_2958":118112},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3475":70850,"_30304":70841,"_5":30654,"_20976":118114,"_27536":118115,"_2958":118116},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3475":70851,"_30304":70841,"_5":30654,"_20976":118118,"_27536":118119,"_2958":118120},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3475":70852,"_30304":70841,"_5":30654,"_20976":118122,"_27536":118123,"_2958":118124},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3475":70853,"_30304":70841,"_5":30654,"_20976":118126,"_27536":118127,"_2958":118128},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3475":70854,"_30304":70841,"_5":30654,"_20976":118130,"_27536":118131,"_2958":118132},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3475":70855,"_30304":70841,"_5":30654,"_20976":118134,"_27536":118135,"_2958":118136},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3475":70856,"_30304":70841,"_5":30654,"_20976":118138,"_27536":118139,"_2958":118140},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3475":70857,"_30304":70841,"_5":30654,"_20976":118142,"_27536":118143,"_2958":118144},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3475":70858,"_30304":70841,"_5":30654,"_20976":118146,"_27536":118147,"_2958":117247},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3475":70859,"_30304":70841,"_5":30654,"_20976":118149,"_27536":118150,"_2958":118151},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3475":70860,"_30304":70841,"_5":30654,"_20976":118153,"_27536":118154,"_2958":118155},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3475":70861,"_30304":70841,"_5":30654,"_20976":118157,"_27536":118158,"_2958":118159},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3475":70862,"_30304":70841,"_5":30654,"_20976":118161,"_27536":118162,"_2958":118163},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3475":70863,"_30304":70841,"_5":30654,"_20976":118165,"_27536":118166,"_2958":118167},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3475":70864,"_30304":70841,"_5":30654,"_20976":118169,"_27536":118170,"_2958":118171},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3475":70865,"_30304":70841,"_5":30654,"_20976":118173,"_27536":118174,"_2958":118175},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3475":70866,"_30304":70841,"_5":30654,"_20976":118177,"_27536":118178,"_2958":118179},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3475":70867,"_30304":70841,"_5":30654,"_20976":118181,"_27536":118182,"_2958":118183},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3475":70868,"_30304":70841,"_5":30654,"_20976":118185,"_27536":118186,"_2958":118187},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3475":70869,"_30304":70841,"_5":30654,"_20976":118189,"_27536":118190,"_2958":118191},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3475":70870,"_30304":70841,"_5":30654,"_20976":118193,"_27536":118194,"_2958":118195},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3475":70871,"_30304":70841,"_5":30654,"_20976":118197,"_27536":118198,"_2958":118199},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3475":70872,"_30304":70841,"_5":30654,"_20976":118201,"_27536":118202,"_2958":118203},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3475":70873,"_30304":70841,"_5":30654,"_20976":118205,"_27536":118206,"_2958":118207},[],"/docs/pr-preview/pr-65/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3475":70874,"_30304":70841,"_20976":118209,"_5":14428,"_27536":70841,"_2958":118210},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3475":70875,"_30304":70841,"_20976":118212,"_5":14428,"_27536":70841,"_2958":118213},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3475":70876,"_30304":70841,"_20976":118215,"_5":14428,"_27536":70841,"_2958":118216},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3475":70877,"_30304":70841,"_20976":118218,"_5":14428,"_27536":118087,"_2958":118219},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3475":70878,"_30304":70841,"_20976":118221,"_5":14428,"_27536":118087,"_2958":118222},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3475":70879,"_30304":70841,"_20976":118224,"_5":14428,"_27536":118087,"_2958":118225},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3475":70880,"_30304":70841,"_20976":118227,"_5":14428,"_27536":118087,"_2958":118228},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3475":70881,"_30304":70841,"_20976":118230,"_5":14428,"_27536":118087,"_2958":118231},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3475":70882,"_30304":70841,"_20976":118233,"_5":14428,"_27536":118087,"_2958":118234},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3475":70883,"_30304":70841,"_20976":118236,"_5":14428,"_27536":118091,"_2958":118237},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3475":70884,"_30304":70841,"_20976":118239,"_5":14428,"_27536":118091,"_2958":118240},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3475":70885,"_30304":70841,"_20976":118242,"_5":14428,"_27536":118095,"_2958":118243},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3475":70886,"_30304":70841,"_20976":118245,"_5":14428,"_27536":118095,"_2958":118246},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3475":70887,"_30304":70841,"_20976":118248,"_5":14428,"_27536":118095,"_2958":118249},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3475":70888,"_30304":70841,"_20976":118251,"_5":14428,"_27536":118095,"_2958":118252},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3475":70889,"_30304":70841,"_20976":118254,"_5":14428,"_27536":118095,"_2958":118255},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3475":70890,"_30304":70841,"_20976":118257,"_5":14428,"_27536":118095,"_2958":118258},[],"Carga por separado las políticas concedidas a cada principal.",{"_3475":70891,"_30304":70841,"_20976":118260,"_5":14428,"_27536":118095,"_2958":118261},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3475":70892,"_30304":70841,"_20976":118263,"_5":14428,"_27536":118095,"_2958":118264},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3475":70893,"_30304":70841,"_20976":118266,"_5":14428,"_27536":118095,"_2958":118267},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3475":70894,"_30304":70841,"_20976":118269,"_5":14428,"_27536":118095,"_2958":118270},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3475":70895,"_30304":70841,"_20976":118272,"_5":14428,"_27536":118095,"_2958":118273},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3475":70896,"_30304":70841,"_20976":118275,"_5":14428,"_27536":118095,"_2958":118276},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3475":70897,"_30304":70841,"_20976":118278,"_5":14428,"_27536":118099,"_2958":118279},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3475":70898,"_30304":70841,"_20976":118281,"_5":14428,"_27536":118099,"_2958":118282},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3475":70899,"_30304":70841,"_20976":118284,"_5":14428,"_27536":118099,"_2958":118285},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3475":70900,"_30304":70841,"_20976":118287,"_5":14428,"_27536":118099,"_2958":118288},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3475":70901,"_30304":70841,"_20976":118290,"_5":14428,"_27536":118099,"_2958":118291},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3475":70902,"_30304":70841,"_20976":118293,"_5":14428,"_27536":118099,"_2958":118294},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3475":70903,"_30304":70841,"_20976":118296,"_5":14428,"_27536":118099,"_2958":118297},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3475":70904,"_30304":70841,"_20976":118299,"_5":14428,"_27536":118099,"_2958":118300},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3475":70905,"_30304":70841,"_20976":118302,"_5":14428,"_27536":118103,"_2958":118303},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3475":70906,"_30304":70841,"_20976":118305,"_5":14428,"_27536":118103,"_2958":118306},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3475":70907,"_30304":70841,"_20976":118308,"_5":14428,"_27536":118103,"_2958":118309},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3475":70908,"_30304":70841,"_20976":118311,"_5":14428,"_27536":118103,"_2958":118312},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3475":70909,"_30304":70841,"_20976":118314,"_5":14428,"_27536":118103,"_2958":118315},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3475":70910,"_30304":70841,"_20976":118317,"_5":14428,"_27536":118103,"_2958":118318},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3475":70911,"_30304":70841,"_20976":118320,"_5":14428,"_27536":118103,"_2958":118321},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3475":70912,"_30304":70841,"_20976":118323,"_5":14428,"_27536":118103,"_2958":118324},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3475":70913,"_30304":70841,"_20976":118326,"_5":14428,"_27536":118103,"_2958":118327},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3475":70914,"_30304":70841,"_20976":118329,"_5":14428,"_27536":118103,"_2958":118330},[],"Las acciones se dividen en dos grupos:",{"_3475":70915,"_30304":70841,"_20976":118332,"_5":14428,"_27536":118103,"_2958":118333},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3475":70916,"_30304":70841,"_20976":118335,"_5":14428,"_27536":118103,"_2958":118336},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3475":70917,"_30304":70841,"_20976":118338,"_5":14428,"_27536":118103,"_2958":118339},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3475":70918,"_30304":70841,"_20976":118341,"_5":14428,"_27536":118107,"_2958":118342},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3475":70919,"_30304":70841,"_20976":118344,"_5":14428,"_27536":118107,"_2958":118345},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3475":70920,"_30304":70841,"_20976":118347,"_5":14428,"_27536":118107,"_2958":118348},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3475":70921,"_30304":70841,"_20976":118350,"_5":14428,"_27536":118111,"_2958":118351},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3475":70922,"_30304":70841,"_20976":118353,"_5":14428,"_27536":118111,"_2958":118354},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3475":70923,"_30304":70841,"_20976":118356,"_5":14428,"_27536":118111,"_2958":118357},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3475":70924,"_30304":70841,"_20976":118359,"_5":14428,"_27536":118111,"_2958":118360},[],"Los operadores implementados son:",{"_3475":70925,"_30304":70841,"_20976":118362,"_5":14428,"_27536":118111,"_2958":118363},[],"`equals`, para igualdad exacta;",{"_3475":70926,"_30304":70841,"_20976":118365,"_5":14428,"_27536":118111,"_2958":118366},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3475":70927,"_30304":70841,"_20976":118368,"_5":14428,"_27536":118111,"_2958":118369},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3475":70928,"_30304":70841,"_20976":118371,"_5":14428,"_27536":118111,"_2958":118372},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3475":70929,"_30304":70841,"_20976":118374,"_5":14428,"_27536":118115,"_2958":118375},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3475":70930,"_30304":70841,"_20976":118377,"_5":14428,"_27536":118115,"_2958":118378},[],"Los modos disponibles son:",{"_3475":70931,"_30304":70841,"_20976":118380,"_5":14428,"_27536":118115,"_2958":118381},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3475":70932,"_30304":70841,"_20976":118383,"_5":14428,"_27536":118115,"_2958":118384},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3475":70933,"_30304":70841,"_20976":118386,"_5":14428,"_27536":118115,"_2958":118387},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3475":70934,"_30304":70841,"_20976":118389,"_5":14428,"_27536":118115,"_2958":118390},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3475":70935,"_30304":70841,"_20976":118392,"_5":14428,"_27536":118115,"_2958":118393},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3475":70936,"_30304":70841,"_20976":118395,"_5":14428,"_27536":118115,"_2958":118396},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3475":70937,"_30304":70841,"_20976":118398,"_5":14428,"_27536":118119,"_2958":118399},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3475":70938,"_30304":70841,"_20976":118401,"_5":14428,"_27536":118119,"_2958":118402},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3475":70939,"_30304":70841,"_20976":118404,"_5":14428,"_27536":118119,"_2958":118405},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3475":70940,"_30304":70841,"_20976":118407,"_5":14428,"_27536":118119,"_2958":118408},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3475":70941,"_30304":70841,"_20976":118410,"_5":14428,"_27536":118127,"_2958":118411},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3475":70942,"_30304":70841,"_20976":118413,"_5":14428,"_27536":118127,"_2958":118414},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3475":70943,"_30304":70841,"_20976":118416,"_5":14428,"_27536":118131,"_2958":118417},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3475":70944,"_30304":70841,"_20976":118419,"_5":14428,"_27536":118131,"_2958":118420},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3475":70945,"_30304":70841,"_20976":118422,"_5":14428,"_27536":118135,"_2958":118423},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3475":70946,"_30304":70841,"_20976":118425,"_5":14428,"_27536":118135,"_2958":118426},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3475":70947,"_30304":70841,"_20976":118428,"_5":14428,"_27536":118135,"_2958":118429},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3475":70948,"_30304":70841,"_20976":118431,"_5":14428,"_27536":118139,"_2958":118432},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3475":70949,"_30304":70841,"_20976":118434,"_5":14428,"_27536":118139,"_2958":118435},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3475":70950,"_30304":70841,"_20976":118437,"_5":14428,"_27536":118139,"_2958":118438},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3475":70951,"_30304":70841,"_20976":118440,"_5":14428,"_27536":118139,"_2958":118441},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3475":70952,"_30304":70841,"_20976":118443,"_5":14428,"_27536":118139,"_2958":118444},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3475":70953,"_30304":70841,"_20976":118446,"_5":14428,"_27536":118139,"_2958":118447},[],"Ten en cuenta que:",{"_3475":70954,"_30304":70841,"_20976":118449,"_5":14428,"_27536":118139,"_2958":118450},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3475":70955,"_30304":70841,"_20976":118452,"_5":14428,"_27536":118139,"_2958":118453},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3475":70956,"_30304":70841,"_20976":118455,"_5":14428,"_27536":118139,"_2958":118456},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3475":70957,"_30304":70841,"_20976":118458,"_5":14428,"_27536":118143,"_2958":118459},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3475":70958,"_30304":70841,"_20976":118461,"_5":14428,"_27536":118143,"_2958":118462},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3475":70959,"_30304":70841,"_20976":118464,"_5":14428,"_27536":118143,"_2958":118465},[],"acceso completo y de solo lectura a KMS;",{"_3475":70960,"_30304":70841,"_20976":118467,"_5":14428,"_27536":118143,"_2958":118468},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3475":70961,"_30304":70841,"_20976":118470,"_5":14428,"_27536":118143,"_2958":118471},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3475":70962,"_30304":70841,"_20976":118473,"_5":14428,"_27536":118143,"_2958":118474},[],"acceso a la interfaz;",{"_3475":70963,"_30304":70841,"_20976":118476,"_5":14428,"_27536":118143,"_2958":118477},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3475":70964,"_30304":70841,"_20976":118479,"_5":14428,"_27536":118143,"_2958":118480},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3475":70965,"_30304":70841,"_20976":118482,"_5":14428,"_27536":118143,"_2958":118483},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3475":70966,"_30304":70841,"_20976":118485,"_5":14428,"_27536":118147,"_2958":118486},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3475":70967,"_30304":70841,"_20976":118488,"_5":14428,"_27536":118147,"_2958":118489},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3475":70968,"_30304":70841,"_20976":118491,"_5":14428,"_27536":118147,"_2958":118492},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3475":70969,"_30304":70841,"_20976":118494,"_5":14428,"_27536":118150,"_2958":118495},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3475":70970,"_30304":70841,"_20976":118497,"_5":14428,"_27536":118154,"_2958":118498},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3475":70971,"_30304":70841,"_20976":118500,"_5":14428,"_27536":118154,"_2958":118501},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3475":70972,"_30304":70841,"_20976":118503,"_5":14428,"_27536":118158,"_2958":118504},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3475":70973,"_30304":70841,"_20976":118506,"_5":14428,"_27536":118162,"_2958":118507},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3475":70974,"_30304":70841,"_20976":118509,"_5":14428,"_27536":118166,"_2958":118510},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3475":70975,"_30304":70841,"_20976":118512,"_5":14428,"_27536":118170,"_2958":118513},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3475":70976,"_30304":70841,"_20976":118515,"_5":14428,"_27536":118170,"_2958":118516},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3475":70977,"_30304":70841,"_20976":118518,"_5":14428,"_27536":118174,"_2958":118519},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3475":70978,"_30304":70841,"_20976":118521,"_5":14428,"_27536":118174,"_2958":118522},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3475":70979,"_30304":70841,"_20976":118524,"_5":14428,"_27536":118174,"_2958":118525},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3475":70980,"_30304":70841,"_20976":118527,"_5":14428,"_27536":118174,"_2958":118528},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3475":70981,"_30304":70841,"_20976":118530,"_5":14428,"_27536":118174,"_2958":118531},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3475":70982,"_30304":70841,"_20976":118533,"_5":14428,"_27536":118174,"_2958":118534},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3475":70983,"_30304":70841,"_20976":118536,"_5":14428,"_27536":118174,"_2958":118537},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3475":70984,"_30304":70841,"_20976":118539,"_5":14428,"_27536":118174,"_2958":118540},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3475":70985,"_30304":70841,"_20976":118542,"_5":14428,"_27536":118178,"_2958":118543},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3475":70986,"_30304":70841,"_20976":118545,"_5":14428,"_27536":118178,"_2958":118546},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3475":70987,"_30304":70841,"_20976":118548,"_5":14428,"_27536":118178,"_2958":118549},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3475":70988,"_30304":70841,"_20976":118551,"_5":14428,"_27536":118182,"_2958":118552},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3475":70989,"_30304":70841,"_20976":118554,"_5":14428,"_27536":118182,"_2958":118555},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3475":70990,"_30304":70841,"_20976":118557,"_5":14428,"_27536":118182,"_2958":118558},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3475":70991,"_30304":70841,"_20976":118560,"_5":14428,"_27536":118182,"_2958":118561},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3475":70992,"_30304":70841,"_20976":118563,"_5":14428,"_27536":118182,"_2958":118564},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3475":70993,"_30304":70841,"_20976":118566,"_5":14428,"_27536":118182,"_2958":118567},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3475":70994,"_30304":70841,"_20976":118569,"_5":14428,"_27536":118182,"_2958":118570},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3475":70995,"_30304":70841,"_20976":118572,"_5":14428,"_27536":118182,"_2958":118573},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3475":70996,"_30304":70841,"_20976":118575,"_5":14428,"_27536":118190,"_2958":118576},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3475":70997,"_30304":70841,"_20976":118578,"_5":14428,"_27536":118194,"_2958":118579},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3475":70998,"_30304":70841,"_20976":118581,"_5":14428,"_27536":118194,"_2958":118582},[],"que exista un principal activo del tipo correcto;",{"_3475":70999,"_30304":70841,"_20976":118584,"_5":14428,"_27536":118194,"_2958":118585},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3475":71000,"_30304":70841,"_20976":118587,"_5":14428,"_27536":118194,"_2958":118588},[],"que todas las condiciones del principal se cumplan;",{"_3475":71001,"_30304":70841,"_20976":118590,"_5":14428,"_27536":118194,"_2958":118591},[],"que el principal tenga concedida la política esperada;",{"_3475":71002,"_30304":70841,"_20976":118593,"_5":14428,"_27536":118194,"_2958":118594},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3475":71003,"_30304":70841,"_20976":118596,"_5":14428,"_27536":118194,"_2958":118597},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3475":71004,"_30304":70841,"_20976":118599,"_5":14428,"_27536":118194,"_2958":118600},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3475":71005,"_30304":70841,"_20976":118602,"_5":14428,"_27536":118198,"_2958":118603},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3475":71006,"_30304":70841,"_20976":118605,"_5":14428,"_27536":118202,"_2958":118606},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3475":71007,"_30304":70841,"_20976":118608,"_5":14428,"_27536":118206,"_2958":118609},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3475":71008,"_30304":70841,"_20976":118611,"_5":14428,"_27536":118206,"_2958":118612},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3475":71009,"_30304":71009,"_5":14780,"_2958":118614,"_30657":118615,"_20976":118616,"_27536":71009},"Alertas y suscripciones",[49412,118079,118080],[],{"_3475":71010,"_30304":71009,"_20976":118618,"_5":14428,"_27536":71009,"_2958":118619},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3475":71011,"_30304":71009,"_5":30654,"_20976":118621,"_27536":118622,"_2958":118623},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3475":71012,"_30304":71009,"_5":30654,"_20976":118625,"_27536":118626,"_2958":118627},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3475":71013,"_30304":71009,"_5":30654,"_20976":118629,"_27536":118630,"_2958":118631},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3475":71014,"_30304":71009,"_5":30654,"_20976":118633,"_27536":118634,"_2958":118635},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3475":71015,"_30304":71009,"_5":30654,"_20976":118637,"_27536":118638,"_2958":118639},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3475":71016,"_30304":71009,"_5":30654,"_20976":118641,"_27536":118642,"_2958":118643},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3475":71017,"_30304":71009,"_5":30654,"_20976":118645,"_27536":118646,"_2958":118647},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3475":71018,"_30304":71009,"_5":30654,"_20976":118649,"_27536":118650,"_2958":118651},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3475":71019,"_30304":71009,"_5":30654,"_20976":118653,"_27536":118654,"_2958":118655},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3475":71020,"_30304":71009,"_5":30654,"_20976":118657,"_27536":118658,"_2958":118659},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3475":71021,"_30304":71009,"_5":30654,"_20976":118661,"_27536":118662,"_2958":118663},[],"/docs/pr-preview/pr-65/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3475":71022,"_30304":71009,"_20976":118665,"_5":14428,"_27536":71009,"_2958":118666},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3475":71023,"_30304":71009,"_20976":118668,"_5":14428,"_27536":118622,"_2958":118669},[],"Un servicio publica un evento de dominio.",{"_3475":71024,"_30304":71009,"_20976":118671,"_5":14428,"_27536":118622,"_2958":118672},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3475":71025,"_30304":71009,"_20976":118674,"_5":14428,"_27536":118622,"_2958":118675},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3475":71026,"_30304":71009,"_20976":118677,"_5":14428,"_27536":118622,"_2958":118678},[],"Lamassu entrega el evento al canal configurado.",{"_3475":71027,"_30304":71009,"_20976":118680,"_5":14428,"_27536":118622,"_2958":118681},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3475":71028,"_30304":71009,"_20976":118683,"_5":14428,"_27536":118626,"_2958":118684},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3475":71029,"_30304":71009,"_20976":118686,"_5":14428,"_27536":118626,"_2958":118687},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3475":71030,"_30304":71009,"_20976":118689,"_5":14428,"_27536":118626,"_2958":118690},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3475":71031,"_30304":71009,"_20976":118692,"_5":14428,"_27536":118626,"_2958":118693},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3475":71032,"_30304":71009,"_20976":118695,"_5":14428,"_27536":118626,"_2958":118696},[],"`apikey_options` necesita `header` y `key`.",{"_3475":71033,"_30304":71009,"_20976":118698,"_5":14428,"_27536":118626,"_2958":118699},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3475":71034,"_30304":71009,"_20976":118701,"_5":14428,"_27536":118626,"_2958":118702},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3475":71035,"_30304":71009,"_20976":118704,"_5":14428,"_27536":118626,"_2958":118705},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3475":71036,"_30304":71009,"_20976":118707,"_5":14428,"_27536":118634,"_2958":118708},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3475":71037,"_30304":71009,"_20976":118710,"_5":14428,"_27536":118638,"_2958":118711},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3475":71038,"_30304":71009,"_20976":118713,"_5":14428,"_27536":118642,"_2958":118714},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3475":71039,"_30304":71009,"_20976":118716,"_5":14428,"_27536":118642,"_2958":118717},[],"**None** notifica todas las instancias del evento.",{"_3475":71040,"_30304":71009,"_20976":118719,"_5":14428,"_27536":118642,"_2958":118720},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3475":71041,"_30304":71009,"_20976":118722,"_5":14428,"_27536":118642,"_2958":118723},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3475":71042,"_30304":71009,"_20976":118725,"_5":14428,"_27536":118642,"_2958":118726},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3475":71043,"_30304":71009,"_20976":118728,"_5":14428,"_27536":118642,"_2958":118729},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3475":71044,"_30304":71009,"_20976":118731,"_5":14428,"_27536":118642,"_2958":118732},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3475":71045,"_30304":71009,"_20976":118734,"_5":14428,"_27536":118646,"_2958":118735},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3475":71046,"_30304":71009,"_20976":118737,"_5":14428,"_27536":118650,"_2958":118738},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3475":71047,"_30304":71009,"_20976":118740,"_5":14428,"_27536":118650,"_2958":118741},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3475":71048,"_30304":71009,"_20976":118743,"_5":14428,"_27536":118650,"_2958":118744},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3475":71049,"_30304":71009,"_20976":118746,"_5":14428,"_27536":118650,"_2958":118747},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3475":71050,"_30304":71009,"_20976":118749,"_5":14428,"_27536":118650,"_2958":118750},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3475":71051,"_30304":71009,"_20976":118752,"_5":14428,"_27536":118650,"_2958":118753},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3475":71052,"_30304":71009,"_20976":118755,"_5":14428,"_27536":118650,"_2958":118756},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3475":71053,"_30304":71009,"_20976":118758,"_5":14428,"_27536":118650,"_2958":118759},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3475":71054,"_30304":71009,"_20976":118761,"_5":14428,"_27536":118654,"_2958":118762},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3475":71055,"_30304":71009,"_20976":118764,"_5":14428,"_27536":118654,"_2958":118765},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3475":71056,"_30304":71009,"_20976":118767,"_5":14428,"_27536":118654,"_2958":118768},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3475":71057,"_30304":71009,"_20976":118770,"_5":14428,"_27536":118654,"_2958":118771},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3475":71058,"_30304":71009,"_20976":118773,"_5":14428,"_27536":118654,"_2958":118774},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3475":71059,"_30304":71009,"_20976":118776,"_5":14428,"_27536":118654,"_2958":118777},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3475":71060,"_30304":71009,"_20976":118779,"_5":14428,"_27536":118654,"_2958":118780},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3475":71061,"_30304":71009,"_20976":118782,"_5":14428,"_27536":118654,"_2958":118783},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3475":71062,"_30304":71009,"_20976":118785,"_5":14428,"_27536":118658,"_2958":118786},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3475":71063,"_30304":71009,"_20976":118788,"_5":14428,"_27536":118658,"_2958":118789},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3475":71064,"_30304":71009,"_20976":118791,"_5":14428,"_27536":118662,"_2958":118792},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3475":71065,"_30304":71009,"_20976":118794,"_5":14428,"_27536":118662,"_2958":118795},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3475":71066,"_30304":71009,"_20976":118797,"_5":14428,"_27536":118662,"_2958":118798},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3475":71067,"_30304":71009,"_20976":118800,"_5":14428,"_27536":118662,"_2958":118801},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3475":71068,"_30304":71009,"_20976":118803,"_5":14428,"_27536":118662,"_2958":118804},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3475":71069,"_30304":71009,"_20976":118806,"_5":14428,"_27536":118662,"_2958":118807},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3475":71070,"_30304":71009,"_20976":118809,"_5":14428,"_27536":118662,"_2958":118810},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3475":71071,"_30304":71009,"_20976":118812,"_5":14428,"_27536":118662,"_2958":118813},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3475":71072,"_30304":71009,"_20976":118815,"_5":14428,"_27536":118662,"_2958":118816},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3475":71073,"_30304":71009,"_20976":118818,"_5":14428,"_27536":118662,"_2958":118819},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3475":71074,"_30304":71074,"_5":14780,"_2958":118821,"_30657":118822,"_20976":118823,"_27536":71074},"Registros de auditoría",[49412,118079,118080],[],{"_3475":71075,"_30304":71074,"_20976":118825,"_5":14428,"_27536":71074,"_2958":118826},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3475":71076,"_30304":71074,"_5":30654,"_20976":118828,"_27536":118829,"_2958":118830},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3475":71077,"_30304":71074,"_5":30654,"_20976":118832,"_27536":118833,"_2958":118834},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3475":71078,"_30304":71074,"_5":30654,"_20976":118836,"_27536":118837,"_2958":118838},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3475":71079,"_30304":71074,"_5":30654,"_20976":118840,"_27536":118841,"_2958":118842},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3475":71080,"_30304":71074,"_5":30654,"_20976":118844,"_27536":118845,"_2958":118846},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3475":71081,"_30304":71074,"_5":30654,"_20976":118848,"_27536":118849,"_2958":118850},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3475":71082,"_30304":71074,"_5":30654,"_20976":118852,"_27536":118853,"_2958":118854},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3475":71083,"_30304":71074,"_5":30654,"_20976":118856,"_27536":118857,"_2958":118858},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3475":71084,"_30304":71074,"_5":30654,"_20976":118860,"_27536":118861,"_2958":118862},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3475":71085,"_30304":71074,"_5":30654,"_20976":118864,"_27536":118865,"_2958":118866},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3475":71086,"_30304":71074,"_5":30654,"_20976":118868,"_27536":118869,"_2958":118870},[],"/docs/pr-preview/pr-65/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3475":71087,"_30304":71074,"_20976":118872,"_5":14428,"_27536":71074,"_2958":118873},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3475":71088,"_30304":71074,"_20976":118875,"_5":14428,"_27536":118829,"_2958":118876},[],"El cuerpo de auditoría incluye:",{"_3475":71089,"_30304":71074,"_20976":118878,"_5":14428,"_27536":118829,"_2958":118879},[],"input: datos recibidos por la operación;",{"_3475":71090,"_30304":71074,"_20976":118881,"_5":14428,"_27536":118829,"_2958":118882},[],"has\\_error: indica si el servicio devolvió un error;",{"_3475":71091,"_30304":71074,"_20976":118884,"_5":14428,"_27536":118829,"_2958":118885},[],"output: resultado producido o mensaje de error;",{"_3475":71092,"_30304":71074,"_20976":118887,"_5":14428,"_27536":118829,"_2958":118888},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3475":71093,"_30304":71074,"_20976":118890,"_5":14428,"_27536":118829,"_2958":118891},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3475":71094,"_30304":71074,"_20976":118893,"_5":14428,"_27536":118829,"_2958":118894},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3475":71095,"_30304":71074,"_20976":118896,"_5":14428,"_27536":118833,"_2958":118897},[],"El backend aplica auditoría a mutaciones de:",{"_3475":71096,"_30304":71074,"_20976":118899,"_5":14428,"_27536":118833,"_2958":118900},[],"autoridades, certificados y perfiles de emisión;",{"_3475":71097,"_30304":71074,"_20976":118902,"_5":14428,"_27536":118833,"_2958":118903},[],"claves y motores KMS;",{"_3475":71098,"_30304":71074,"_20976":118905,"_5":14428,"_27536":118833,"_2958":118906},[],"dispositivos e identidades;",{"_3475":71099,"_30304":71074,"_20976":118908,"_5":14428,"_27536":118833,"_2958":118909},[],"DMS y operaciones de enrolamiento;",{"_3475":71100,"_30304":71074,"_20976":118911,"_5":14428,"_27536":118833,"_2958":118912},[],"funciones de validación y CRL;",{"_3475":71101,"_30304":71074,"_20976":118914,"_5":14428,"_27536":118833,"_2958":118915},[],"principales, políticas y concesiones de autorización.",{"_3475":71102,"_30304":71074,"_20976":118917,"_5":14428,"_27536":118833,"_2958":118918},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3475":71103,"_30304":71074,"_20976":118920,"_5":14428,"_27536":118837,"_2958":118921},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3475":71104,"_30304":71074,"_20976":118923,"_5":14428,"_27536":118837,"_2958":118924},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3475":71105,"_30304":71074,"_20976":118926,"_5":14428,"_27536":118837,"_2958":118927},[],"Diseña el consumidor para:",{"_3475":71106,"_30304":71074,"_20976":118929,"_5":14428,"_27536":118837,"_2958":118930},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3475":71107,"_30304":71074,"_20976":118932,"_5":14428,"_27536":118837,"_2958":118933},[],"conservar el CloudEvent completo sin modificar;",{"_3475":71108,"_30304":71074,"_20976":118935,"_5":14428,"_27536":118837,"_2958":118936},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3475":71109,"_30304":71074,"_20976":118938,"_5":14428,"_27536":118837,"_2958":118939},[],"cifrar en tránsito y en reposo;",{"_3475":71110,"_30304":71074,"_20976":118941,"_5":14428,"_27536":118837,"_2958":118942},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3475":71111,"_30304":71074,"_20976":118944,"_5":14428,"_27536":118837,"_2958":118945},[],"aplicar una política explícita de retención y legal hold;",{"_3475":71112,"_30304":71074,"_20976":118947,"_5":14428,"_27536":118837,"_2958":118948},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3475":71113,"_30304":71074,"_20976":118950,"_5":14428,"_27536":118841,"_2958":118951},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3475":71114,"_30304":71074,"_20976":118953,"_5":14428,"_27536":118841,"_2958":118954},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3475":71115,"_30304":71074,"_20976":118956,"_5":14428,"_27536":118849,"_2958":118957},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3475":71116,"_30304":71074,"_20976":118959,"_5":14428,"_27536":118853,"_2958":118960},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3475":71117,"_30304":71074,"_20976":118962,"_5":14428,"_27536":118857,"_2958":118963},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3475":71118,"_30304":71074,"_20976":118965,"_5":14428,"_27536":118861,"_2958":118966},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3475":71119,"_30304":71074,"_20976":118968,"_5":14428,"_27536":118865,"_2958":118969},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3475":71120,"_30304":71074,"_20976":118971,"_5":14428,"_27536":118869,"_2958":118972},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3475":71121,"_30304":71074,"_20976":118974,"_5":14428,"_27536":118869,"_2958":118975},[],"aparece un evento de auditoría correcto;",{"_3475":71122,"_30304":71074,"_20976":118977,"_5":14428,"_27536":118869,"_2958":118978},[],"el principal coincide con la identidad utilizada;",{"_3475":71123,"_30304":71074,"_20976":118980,"_5":14428,"_27536":118869,"_2958":118981},[],"el consumidor lo persiste una sola vez;",{"_3475":71124,"_30304":71074,"_20976":118983,"_5":14428,"_27536":118869,"_2958":118984},[],"puede recuperarse por recurso, actor y periodo;",{"_3475":71125,"_30304":71074,"_20976":118986,"_5":14428,"_27536":118869,"_2958":118987},[],"una interrupción del consumidor produce una alerta.",{"_3475":71126,"_30304":71074,"_20976":118989,"_5":14428,"_27536":118869,"_2958":118990},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3475":71127,"_30304":71127,"_5":14780,"_2958":118992,"_30657":118993,"_20976":118994,"_27536":71127},"Arquitectura de la plataforma",[49412,118079],[],{"_3475":71128,"_30304":71127,"_20976":118996,"_5":14428,"_27536":71127,"_2958":118997},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3475":71129,"_30304":71127,"_5":30654,"_20976":118999,"_27536":119000,"_2958":119001},[],"/docs/pr-preview/pr-65/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3475":71130,"_30304":71127,"_5":30654,"_20976":119003,"_27536":119004,"_2958":119005},[],"/docs/pr-preview/pr-65/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3475":71131,"_30304":71127,"_5":30654,"_20976":119007,"_27536":119008,"_2958":119009},[],"/docs/pr-preview/pr-65/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3475":71132,"_30304":71127,"_5":30654,"_20976":119011,"_27536":119012,"_2958":119013},[],"/docs/pr-preview/pr-65/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3475":71133,"_30304":71127,"_5":30654,"_20976":119015,"_27536":119016,"_2958":119017},[],"/docs/pr-preview/pr-65/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3475":71134,"_30304":71127,"_20976":119019,"_5":14428,"_27536":71127,"_2958":119020},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3475":71135,"_30304":71127,"_20976":119022,"_5":14428,"_27536":71127,"_2958":119023},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3475":71136,"_30304":71127,"_20976":119025,"_5":14428,"_27536":119000,"_2958":119026},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3475":71137,"_30304":71127,"_20976":119028,"_5":14428,"_27536":119004,"_2958":119029},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3475":71138,"_30304":71127,"_20976":119031,"_5":14428,"_27536":119008,"_2958":119032},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3475":71139,"_30304":71127,"_20976":119034,"_5":14428,"_27536":119012,"_2958":119035},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3475":71140,"_30304":71127,"_20976":119037,"_5":14428,"_27536":119016,"_2958":119038},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3475":71141,"_30304":71141,"_5":14780,"_2958":119040,"_30657":119041,"_20976":119042,"_27536":71141},"Cómo funciona Lamassu",[49412,118079],[],{"_3475":71142,"_30304":71141,"_20976":119044,"_5":14428,"_27536":71141,"_2958":119045},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3475":71143,"_30304":71141,"_5":30654,"_20976":119047,"_27536":119048,"_2958":119049},[],"/docs/pr-preview/pr-65/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3475":71144,"_30304":71141,"_5":30654,"_20976":119051,"_27536":119052,"_2958":119053},[],"/docs/pr-preview/pr-65/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3475":71145,"_30304":71141,"_20976":119055,"_5":14428,"_27536":71141,"_2958":119056},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3475":71146,"_30304":71141,"_20976":119058,"_5":14428,"_27536":119048,"_2958":119059},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3475":71147,"_30304":71141,"_20976":119061,"_5":14428,"_27536":119048,"_2958":119062},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3475":71148,"_30304":71141,"_20976":119064,"_5":14428,"_27536":119048,"_2958":119065},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3475":71149,"_30304":71141,"_20976":119067,"_5":14428,"_27536":119048,"_2958":119068},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3475":71150,"_30304":71141,"_20976":119070,"_5":14428,"_27536":119048,"_2958":119071},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3475":71151,"_30304":71141,"_20976":119073,"_5":14428,"_27536":119052,"_2958":119074},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3475":71152,"_30304":71141,"_20976":119076,"_5":14428,"_27536":119052,"_2958":119077},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3475":71153,"_30304":71141,"_20976":119079,"_5":14428,"_27536":119052,"_2958":119080},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3475":71154,"_30304":71141,"_20976":119082,"_5":14428,"_27536":119052,"_2958":119083},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3475":71155,"_30304":71141,"_20976":119085,"_5":14428,"_27536":119052,"_2958":119086},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3475":71156,"_30304":71141,"_20976":119088,"_5":14428,"_27536":119052,"_2958":119089},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3475":71157,"_30304":71141,"_20976":119091,"_5":14428,"_27536":119052,"_2958":119092},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3475":71158,"_30304":71158,"_5":14780,"_2958":119094,"_30657":119095,"_20976":119096,"_27536":71158},"Dispositivos e identidades",[49412,118079,51904,119094],[],{"_3475":71159,"_30304":71158,"_20976":119098,"_5":14428,"_27536":71158,"_2958":119099},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3475":71160,"_30304":71158,"_5":30654,"_20976":119101,"_27536":119102,"_2958":119103},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3475":71161,"_30304":71158,"_5":30654,"_20976":119105,"_27536":119106,"_2958":119107},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3475":71162,"_30304":71158,"_5":30654,"_20976":119109,"_27536":119110,"_2958":119111},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3475":71163,"_30304":71158,"_5":30654,"_20976":119113,"_27536":119114,"_2958":119115},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3475":71164,"_30304":71158,"_5":30654,"_20976":119117,"_27536":119118,"_2958":119119},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3475":71165,"_30304":71158,"_5":30654,"_20976":119121,"_27536":119122,"_2958":119123},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3475":71166,"_30304":71158,"_5":30654,"_20976":119125,"_27536":119126,"_2958":119127},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3475":71167,"_30304":71158,"_5":30654,"_20976":119129,"_27536":119130,"_2958":119131},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3475":71168,"_30304":71158,"_5":30654,"_20976":119133,"_27536":119134,"_2958":119135},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3475":71169,"_30304":71158,"_5":30654,"_20976":119137,"_27536":119138,"_2958":119139},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3475":71170,"_30304":71158,"_5":30654,"_20976":119141,"_27536":119142,"_2958":119143},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3475":71171,"_30304":71158,"_20976":119145,"_5":14428,"_27536":71158,"_2958":119146},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3475":71172,"_30304":71158,"_20976":119148,"_5":14428,"_27536":71158,"_2958":119149},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3475":71173,"_30304":71158,"_20976":119151,"_5":14428,"_27536":119102,"_2958":119152},[],"Vista operativa",{"_3475":71174,"_30304":71158,"_20976":119154,"_5":14428,"_27536":119102,"_2958":119155},[],"Interpretación",{"_3475":71175,"_30304":71158,"_20976":119157,"_5":14428,"_27536":119102,"_2958":51967},[],{"_3475":71176,"_30304":71158,"_20976":119159,"_5":14428,"_27536":119102,"_2958":119160},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3475":71177,"_30304":71158,"_20976":119162,"_5":14428,"_27536":119102,"_2958":51973},[],{"_3475":71178,"_30304":71158,"_20976":119164,"_5":14428,"_27536":119102,"_2958":119165},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3475":71179,"_30304":71158,"_20976":119167,"_5":14428,"_27536":119102,"_2958":51979},[],{"_3475":71180,"_30304":71158,"_20976":119169,"_5":14428,"_27536":119102,"_2958":119170},[],"La identidad está en la ventana operativa de renovación.",{"_3475":71181,"_30304":71158,"_20976":119172,"_5":14428,"_27536":119102,"_2958":51985},[],{"_3475":71182,"_30304":71158,"_20976":119174,"_5":14428,"_27536":119102,"_2958":119175},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3475":71183,"_30304":71158,"_20976":119177,"_5":14428,"_27536":119102,"_2958":51991},[],{"_3475":71184,"_30304":71158,"_20976":119179,"_5":14428,"_27536":119102,"_2958":119180},[],"La identidad ha vencido.",{"_3475":71185,"_30304":71158,"_20976":119182,"_5":14428,"_27536":119102,"_2958":51997},[],{"_3475":71186,"_30304":71158,"_20976":119184,"_5":14428,"_27536":119102,"_2958":119185},[],"La identidad está marcada como revocada.",{"_3475":71187,"_30304":71158,"_20976":119187,"_5":14428,"_27536":119102,"_2958":52003},[],{"_3475":71188,"_30304":71158,"_20976":119189,"_5":14428,"_27536":119102,"_2958":119190},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3475":71189,"_30304":71158,"_20976":119192,"_5":14428,"_27536":119102,"_2958":119193},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3475":71190,"_30304":71158,"_20976":119195,"_5":14428,"_27536":119106,"_2958":119196},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3475":71191,"_30304":71158,"_20976":119198,"_5":14428,"_27536":119106,"_2958":119199},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3475":71192,"_30304":71158,"_20976":119201,"_5":14428,"_27536":119106,"_2958":119202},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3475":71193,"_30304":71158,"_20976":119204,"_5":14428,"_27536":119106,"_2958":119205},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3475":71194,"_30304":71158,"_20976":119207,"_5":14428,"_27536":119110,"_2958":119208},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3475":71195,"_30304":71158,"_20976":119210,"_5":14428,"_27536":119114,"_2958":119211},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3475":71196,"_30304":71158,"_20976":119213,"_5":14428,"_27536":119118,"_2958":119214},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3475":71197,"_30304":71158,"_20976":119216,"_5":14428,"_27536":119122,"_2958":119217},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3475":71198,"_30304":71158,"_20976":119219,"_5":14428,"_27536":119126,"_2958":119220},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3475":71199,"_30304":71158,"_20976":119222,"_5":14428,"_27536":119126,"_2958":119223},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3475":71200,"_30304":71158,"_20976":119225,"_5":14428,"_27536":119130,"_2958":119226},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3475":71201,"_30304":71158,"_20976":119228,"_5":14428,"_27536":119130,"_2958":119229},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3475":71202,"_30304":71158,"_20976":119231,"_5":14428,"_27536":119130,"_2958":119232},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3475":71203,"_30304":71158,"_20976":119234,"_5":14428,"_27536":119130,"_2958":119235},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3475":71204,"_30304":71158,"_20976":119237,"_5":14428,"_27536":119130,"_2958":119238},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3475":71205,"_30304":71158,"_20976":119240,"_5":14428,"_27536":119130,"_2958":119241},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3475":71206,"_30304":71158,"_20976":119243,"_5":14428,"_27536":119134,"_2958":119244},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3475":71207,"_30304":71158,"_20976":119246,"_5":14428,"_27536":119134,"_2958":119247},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3475":71208,"_30304":71158,"_20976":119249,"_5":14428,"_27536":119138,"_2958":119250},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3475":71209,"_30304":71158,"_20976":119252,"_5":14428,"_27536":119138,"_2958":119253},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3475":71210,"_30304":71158,"_20976":119255,"_5":14428,"_27536":119138,"_2958":119256},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3475":71211,"_30304":71158,"_20976":119258,"_5":14428,"_27536":119138,"_2958":119259},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3475":71212,"_30304":71158,"_20976":119261,"_5":14428,"_27536":119142,"_2958":119262},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3475":71213,"_30304":71158,"_20976":119264,"_5":14428,"_27536":119142,"_2958":119265},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3475":71214,"_30304":71214,"_5":14780,"_2958":119267,"_30657":119268,"_20976":119270,"_27536":71214},"Identidad inicial y autenticación",[49412,118079,51904,119094,119269],"Enrolamiento con PKI",[],{"_3475":71215,"_30304":71214,"_20976":119272,"_5":14428,"_27536":71214,"_2958":119273},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3475":71216,"_30304":71214,"_5":30654,"_20976":119275,"_27536":119276,"_2958":119277},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3475":71217,"_30304":71214,"_5":30654,"_20976":119279,"_27536":119280,"_2958":119281},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3475":71218,"_30304":71214,"_5":30654,"_20976":119283,"_27536":119284,"_2958":119285},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3475":71219,"_30304":71214,"_5":30654,"_20976":119287,"_27536":119288,"_2958":119289},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3475":71220,"_30304":71214,"_5":30654,"_20976":119291,"_27536":119292,"_2958":119293},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3475":71221,"_30304":71214,"_20976":119295,"_5":14428,"_27536":71214,"_2958":119296},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3475":71222,"_30304":71214,"_20976":119298,"_5":14428,"_27536":119276,"_2958":119299},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3475":71223,"_30304":71214,"_20976":119301,"_5":14428,"_27536":119276,"_2958":119302},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3475":71224,"_30304":71214,"_20976":119304,"_5":14428,"_27536":119280,"_2958":119305},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3475":71225,"_30304":71214,"_20976":119307,"_5":14428,"_27536":119280,"_2958":119308},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3475":71226,"_30304":71214,"_20976":119310,"_5":14428,"_27536":119280,"_2958":119311},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3475":71227,"_30304":71214,"_20976":119313,"_5":14428,"_27536":119284,"_2958":119314},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3475":71228,"_30304":71214,"_20976":119316,"_5":14428,"_27536":119284,"_2958":119317},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3475":71229,"_30304":71214,"_20976":119319,"_5":14428,"_27536":119288,"_2958":119320},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3475":71230,"_30304":71214,"_20976":119322,"_5":14428,"_27536":119288,"_2958":119323},[],"Ejemplo de cuerpo:",{"_3475":71231,"_30304":71214,"_20976":119325,"_5":14428,"_27536":119288,"_2958":119326},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3475":71232,"_30304":71214,"_20976":119328,"_5":14428,"_27536":119288,"_2958":119329},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3475":71233,"_30304":71214,"_20976":119331,"_5":14428,"_27536":119288,"_2958":119332},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3475":71234,"_30304":71214,"_20976":119334,"_5":14428,"_27536":119288,"_2958":119335},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3475":71235,"_30304":71214,"_20976":119337,"_5":14428,"_27536":119292,"_2958":119338},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3475":71236,"_30304":71214,"_20976":119340,"_5":14428,"_27536":119292,"_2958":119341},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3475":71237,"_30304":71237,"_5":14780,"_2958":119343,"_30657":119344,"_20976":119345,"_27536":71237},"Configura y opera el DMS",[49412,118079,51904,119094,119269],[],{"_3475":71238,"_30304":71237,"_20976":119347,"_5":14428,"_27536":71237,"_2958":119348},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3475":71239,"_30304":71237,"_5":30654,"_20976":119350,"_27536":119351,"_2958":116650},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3475":71240,"_30304":71237,"_5":30654,"_20976":119353,"_27536":119354,"_2958":119355},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3475":71241,"_30304":71237,"_5":30654,"_20976":119357,"_27536":119358,"_2958":119359},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3475":71242,"_30304":71237,"_5":30654,"_20976":119361,"_27536":119362,"_2958":119363},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3475":71243,"_30304":71237,"_5":30654,"_20976":119365,"_27536":119366,"_2958":119367},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3475":71244,"_30304":71237,"_5":30654,"_20976":119369,"_27536":119370,"_2958":119371},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3475":71245,"_30304":71237,"_5":30654,"_20976":119373,"_27536":119374,"_2958":119375},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3475":71246,"_30304":71237,"_5":30654,"_20976":119377,"_27536":119378,"_2958":119379},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3475":71247,"_30304":71237,"_5":30654,"_20976":119381,"_27536":119382,"_2958":52199},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3475":71248,"_30304":71237,"_5":30654,"_20976":119384,"_27536":119385,"_2958":52203},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3475":71249,"_30304":71237,"_5":30654,"_20976":119387,"_27536":119388,"_2958":119389},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3475":71250,"_30304":71237,"_5":30654,"_20976":119391,"_27536":119392,"_2958":119393},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3475":71251,"_30304":71237,"_5":30654,"_20976":119395,"_27536":119396,"_2958":119397},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3475":71252,"_30304":71237,"_5":30654,"_20976":119399,"_27536":119400,"_2958":119401},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3475":71253,"_30304":71237,"_5":30654,"_20976":119403,"_27536":119404,"_2958":52223},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3475":71254,"_30304":71237,"_5":30654,"_20976":119406,"_27536":119407,"_2958":119408},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3475":71255,"_30304":71237,"_5":30654,"_20976":119410,"_27536":119411,"_2958":119412},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3475":71256,"_30304":71237,"_5":30654,"_20976":119414,"_27536":119415,"_2958":119416},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3475":71257,"_30304":71237,"_20976":119418,"_5":14428,"_27536":71237,"_2958":119419},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3475":71258,"_30304":71237,"_20976":119421,"_5":14428,"_27536":119351,"_2958":119422},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3475":71259,"_30304":71237,"_20976":119424,"_5":14428,"_27536":119351,"_2958":119425},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3475":71260,"_30304":71237,"_20976":119427,"_5":14428,"_27536":119358,"_2958":119428},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3475":71261,"_30304":71237,"_20976":119430,"_5":14428,"_27536":119362,"_2958":119431},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3475":71262,"_30304":71237,"_20976":119433,"_5":14428,"_27536":119366,"_2958":119434},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3475":71263,"_30304":71237,"_20976":119436,"_5":14428,"_27536":119370,"_2958":119437},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3475":71264,"_30304":71237,"_20976":119439,"_5":14428,"_27536":119374,"_2958":119440},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3475":71265,"_30304":71237,"_20976":119442,"_5":14428,"_27536":119382,"_2958":119443},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3475":71266,"_30304":71237,"_20976":119445,"_5":14428,"_27536":119382,"_2958":119446},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3475":71267,"_30304":71237,"_20976":119448,"_5":14428,"_27536":119385,"_2958":119449},[],"Campo de `settings.enrollment_settings`",{"_3475":71268,"_30304":71237,"_20976":119451,"_5":14428,"_27536":119385,"_2958":119452},[],"Decisión",{"_3475":71269,"_30304":71237,"_20976":119454,"_5":14428,"_27536":119385,"_2958":52274},[],{"_3475":71270,"_30304":71237,"_20976":119456,"_5":14428,"_27536":119385,"_2958":119457},[],"`EST_RFC7030` para estas operaciones.",{"_3475":71271,"_30304":71237,"_20976":119459,"_5":14428,"_27536":119385,"_2958":52280},[],{"_3475":71272,"_30304":71237,"_20976":119461,"_5":14428,"_27536":119385,"_2958":119462},[],"ID de la CA que firmará.",{"_3475":71273,"_30304":71237,"_20976":119464,"_5":14428,"_27536":119385,"_2958":52286},[],{"_3475":71274,"_30304":71237,"_20976":119466,"_5":14428,"_27536":119385,"_2958":119467},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3475":71275,"_30304":71237,"_20976":119469,"_5":14428,"_27536":119385,"_2958":52292},[],{"_3475":71276,"_30304":71237,"_20976":119471,"_5":14428,"_27536":119385,"_2958":119472},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3475":71277,"_30304":71237,"_20976":119474,"_5":14428,"_27536":119385,"_2958":52298},[],{"_3475":71278,"_30304":71237,"_20976":119476,"_5":14428,"_27536":119385,"_2958":119477},[],"Uno de los cuatro modos de autenticación.",{"_3475":71279,"_30304":71237,"_20976":119479,"_5":14428,"_27536":119385,"_2958":119480},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3475":71280,"_30304":71237,"_20976":119482,"_5":14428,"_27536":119388,"_2958":119483},[],"Los bloques son independientes:",{"_3475":71281,"_30304":71237,"_20976":119485,"_5":14428,"_27536":119388,"_2958":119486},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3475":71282,"_30304":71237,"_20976":119488,"_5":14428,"_27536":119388,"_2958":119489},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3475":71283,"_30304":71237,"_20976":119491,"_5":14428,"_27536":119388,"_2958":52316},[],{"_3475":71284,"_30304":71237,"_20976":119493,"_5":14428,"_27536":119388,"_2958":119494},[],"Control aplicado en la operación configurada",{"_3475":71285,"_30304":71237,"_20976":119496,"_5":14428,"_27536":119388,"_2958":52322},[],{"_3475":71286,"_30304":71237,"_20976":119498,"_5":14428,"_27536":119388,"_2958":119499},[],"Validación del certificado presentado.",{"_3475":71287,"_30304":71237,"_20976":119501,"_5":14428,"_27536":119388,"_2958":52328},[],{"_3475":71288,"_30304":71237,"_20976":119503,"_5":14428,"_27536":119388,"_2958":119504},[],"Autorización del webhook configurado.",{"_3475":71289,"_30304":71237,"_20976":119506,"_5":14428,"_27536":119388,"_2958":52334},[],{"_3475":71290,"_30304":71237,"_20976":119508,"_5":14428,"_27536":119388,"_2958":119509},[],"Validación del certificado y, después, aprobación del webhook.",{"_3475":71291,"_30304":71237,"_20976":119511,"_5":14428,"_27536":119388,"_2958":52340},[],{"_3475":71292,"_30304":71237,"_20976":119513,"_5":14428,"_27536":119388,"_2958":119514},[],"Sin autenticación del solicitante por el DMS.",{"_3475":71293,"_30304":71237,"_20976":119516,"_5":14428,"_27536":119388,"_2958":119517},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3475":71294,"_30304":71237,"_20976":119519,"_5":14428,"_27536":119388,"_2958":119520},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3475":71295,"_30304":71237,"_20976":119522,"_5":14428,"_27536":119388,"_2958":119523},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3475":71296,"_30304":71237,"_20976":119525,"_5":14428,"_27536":119388,"_2958":119526},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3475":71297,"_30304":71237,"_20976":119528,"_5":14428,"_27536":119392,"_2958":119529},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3475":71298,"_30304":71237,"_20976":119531,"_5":14428,"_27536":119392,"_2958":119532},[],"Campo de `external_webhook_settings`",{"_3475":71299,"_30304":71237,"_20976":119534,"_5":14428,"_27536":119392,"_2958":119452},[],{"_3475":71300,"_30304":71237,"_20976":119536,"_5":14428,"_27536":119392,"_2958":52366},[],{"_3475":71301,"_30304":71237,"_20976":119538,"_5":14428,"_27536":119392,"_2958":119539},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3475":71302,"_30304":71237,"_20976":119541,"_5":14428,"_27536":119392,"_2958":52372},[],{"_3475":71303,"_30304":71237,"_20976":119543,"_5":14428,"_27536":119392,"_2958":119544},[],"`POST` o `PUT`; `POST` por defecto.",{"_3475":71304,"_30304":71237,"_20976":119546,"_5":14428,"_27536":119392,"_2958":52378},[],{"_3475":71305,"_30304":71237,"_20976":119548,"_5":14428,"_27536":119392,"_2958":119549},[],"Etiqueta usada en los logs del servicio.",{"_3475":71306,"_30304":71237,"_20976":119551,"_5":14428,"_27536":119392,"_2958":52384},[],{"_3475":71307,"_30304":71237,"_20976":119553,"_5":14428,"_27536":119392,"_2958":119554},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3475":71308,"_30304":71237,"_20976":119556,"_5":14428,"_27536":119392,"_2958":52390},[],{"_3475":71309,"_30304":71237,"_20976":119558,"_5":14428,"_27536":119392,"_2958":119559},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3475":71310,"_30304":71237,"_20976":119561,"_5":14428,"_27536":119392,"_2958":52396},[],{"_3475":71311,"_30304":71237,"_20976":119563,"_5":14428,"_27536":119392,"_2958":119564},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3475":71312,"_30304":71237,"_20976":119566,"_5":14428,"_27536":119392,"_2958":52402},[],{"_3475":71313,"_30304":71237,"_20976":119568,"_5":14428,"_27536":119392,"_2958":119569},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3475":71314,"_30304":71237,"_20976":119571,"_5":14428,"_27536":119392,"_2958":52408},[],{"_3475":71315,"_30304":71237,"_20976":119573,"_5":14428,"_27536":119392,"_2958":119574},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3475":71316,"_30304":71237,"_20976":119576,"_5":14428,"_27536":119392,"_2958":52414},[],{"_3475":71317,"_30304":71237,"_20976":119578,"_5":14428,"_27536":119392,"_2958":119579},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3475":71318,"_30304":71237,"_20976":119581,"_5":14428,"_27536":119392,"_2958":52420},[],{"_3475":71319,"_30304":71237,"_20976":119583,"_5":14428,"_27536":119392,"_2958":119584},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3475":71320,"_30304":71237,"_20976":119586,"_5":14428,"_27536":119392,"_2958":119587},[],"Reglas de esa configuración:",{"_3475":71321,"_30304":71237,"_20976":119589,"_5":14428,"_27536":119392,"_2958":119590},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3475":71322,"_30304":71237,"_20976":119592,"_5":14428,"_27536":119392,"_2958":119593},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3475":71323,"_30304":71237,"_20976":119595,"_5":14428,"_27536":119392,"_2958":119596},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3475":71324,"_30304":71237,"_20976":119598,"_5":14428,"_27536":119392,"_2958":119599},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3475":71325,"_30304":71237,"_20976":119601,"_5":14428,"_27536":119392,"_2958":119602},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3475":71326,"_30304":71237,"_20976":119604,"_5":14428,"_27536":119392,"_2958":119605},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3475":71327,"_30304":71237,"_20976":119607,"_5":14428,"_27536":119392,"_2958":119608},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3475":71328,"_30304":71237,"_20976":119610,"_5":14428,"_27536":119392,"_2958":119611},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3475":71329,"_30304":71237,"_20976":119613,"_5":14428,"_27536":119392,"_2958":119614},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3475":71330,"_30304":71237,"_20976":119616,"_5":14428,"_27536":119396,"_2958":119617},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3475":71331,"_30304":71237,"_20976":119619,"_5":14428,"_27536":119400,"_2958":119620},[],"Campo de `settings.reenrollment_settings`",{"_3475":71332,"_30304":71237,"_20976":119622,"_5":14428,"_27536":119400,"_2958":119623},[],"Función",{"_3475":71333,"_30304":71237,"_20976":119625,"_5":14428,"_27536":119400,"_2958":52464},[],{"_3475":71334,"_30304":71237,"_20976":119627,"_5":14428,"_27536":119400,"_2958":119628},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3475":71335,"_30304":71237,"_20976":119630,"_5":14428,"_27536":119400,"_2958":52470},[],{"_3475":71336,"_30304":71237,"_20976":119632,"_5":14428,"_27536":119400,"_2958":119633},[],"Umbral operativo preventivo de monitorización.",{"_3475":71337,"_30304":71237,"_20976":119635,"_5":14428,"_27536":119400,"_2958":52476},[],{"_3475":71338,"_30304":71237,"_20976":119637,"_5":14428,"_27536":119400,"_2958":119638},[],"Umbral operativo crítico de monitorización.",{"_3475":71339,"_30304":71237,"_20976":119640,"_5":14428,"_27536":119400,"_2958":52482},[],{"_3475":71340,"_30304":71237,"_20976":119642,"_5":14428,"_27536":119400,"_2958":119643},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3475":71341,"_30304":71237,"_20976":119645,"_5":14428,"_27536":119400,"_2958":52488},[],{"_3475":71342,"_30304":71237,"_20976":119647,"_5":14428,"_27536":119400,"_2958":119648},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3475":71343,"_30304":71237,"_20976":119650,"_5":14428,"_27536":119400,"_2958":52494},[],{"_3475":71344,"_30304":71237,"_20976":119652,"_5":14428,"_27536":119400,"_2958":119653},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3475":71345,"_30304":71237,"_20976":119655,"_5":14428,"_27536":119400,"_2958":119656},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3475":71346,"_30304":71237,"_20976":119658,"_5":14428,"_27536":119404,"_2958":119659},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3475":71347,"_30304":71237,"_20976":119661,"_5":14428,"_27536":119407,"_2958":117014},[],{"_3475":71348,"_30304":71237,"_20976":119663,"_5":14428,"_27536":119407,"_2958":119664},[],"Qué publica",{"_3475":71349,"_30304":71237,"_20976":119666,"_5":14428,"_27536":119407,"_2958":52511},[],{"_3475":71350,"_30304":71237,"_20976":119668,"_5":14428,"_27536":119407,"_2958":119669},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3475":71351,"_30304":71237,"_20976":119671,"_5":14428,"_27536":119407,"_2958":52517},[],{"_3475":71352,"_30304":71237,"_20976":119673,"_5":14428,"_27536":119407,"_2958":119674},[],"Certificado de la CA emisora seleccionada.",{"_3475":71353,"_30304":71237,"_20976":119676,"_5":14428,"_27536":119407,"_2958":52523},[],{"_3475":71354,"_30304":71237,"_20976":119678,"_5":14428,"_27536":119407,"_2958":119679},[],"Certificados de las CAs elegidas explícitamente.",{"_3475":71355,"_30304":71237,"_20976":119681,"_5":14428,"_27536":119407,"_2958":119682},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3475":71356,"_30304":71237,"_20976":119684,"_5":14428,"_27536":119411,"_2958":119685},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3475":71357,"_30304":71237,"_20976":119687,"_5":14428,"_27536":119411,"_2958":119688},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3475":71358,"_30304":71237,"_20976":119690,"_5":14428,"_27536":119411,"_2958":119691},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3475":71359,"_30304":71237,"_20976":119693,"_5":14428,"_27536":119415,"_2958":119694},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3475":71360,"_30304":71360,"_5":14780,"_2958":119696,"_30657":119697,"_20976":119698,"_27536":71360},"Integra el cliente EST",[49412,118079,51904,119094,119269],[],{"_3475":71361,"_30304":71360,"_20976":119700,"_5":14428,"_27536":71360,"_2958":119701},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3475":71362,"_30304":71360,"_5":30654,"_20976":119703,"_27536":119704,"_2958":116650},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3475":71363,"_30304":71360,"_5":30654,"_20976":119706,"_27536":119707,"_2958":119708},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3475":71364,"_30304":71360,"_5":30654,"_20976":119710,"_27536":119711,"_2958":119712},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3475":71365,"_30304":71360,"_5":30654,"_20976":119714,"_27536":119715,"_2958":119716},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3475":71366,"_30304":71360,"_5":30654,"_20976":119718,"_27536":119719,"_2958":119720},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3475":71367,"_30304":71360,"_5":30654,"_20976":119722,"_27536":119723,"_2958":119724},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3475":71368,"_30304":71360,"_20976":119726,"_5":14428,"_27536":71360,"_2958":119727},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3475":71369,"_30304":71360,"_20976":119729,"_5":14428,"_27536":119704,"_2958":119730},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3475":71370,"_30304":71360,"_20976":119732,"_5":14428,"_27536":119704,"_2958":119733},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3475":71371,"_30304":71360,"_20976":119735,"_5":14428,"_27536":119704,"_2958":119736},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3475":71372,"_30304":71360,"_20976":119738,"_5":14428,"_27536":119707,"_2958":119739},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3475":71373,"_30304":71360,"_20976":119741,"_5":14428,"_27536":119707,"_2958":119742},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3475":71374,"_30304":71360,"_20976":119744,"_5":14428,"_27536":119711,"_2958":119745},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3475":71375,"_30304":71360,"_20976":119747,"_5":14428,"_27536":119711,"_2958":119748},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3475":71376,"_30304":71360,"_20976":119750,"_5":14428,"_27536":119715,"_2958":119751},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3475":71377,"_30304":71360,"_20976":119753,"_5":14428,"_27536":119715,"_2958":119754},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3475":71378,"_30304":71360,"_20976":119756,"_5":14428,"_27536":119719,"_2958":119757},[],"Para el caso de una raíz que emite directamente:",{"_3475":71379,"_30304":71360,"_20976":119759,"_5":14428,"_27536":119719,"_2958":119760},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3475":71380,"_30304":71360,"_20976":119762,"_5":14428,"_27536":119719,"_2958":119763},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3475":71381,"_30304":71360,"_20976":119765,"_5":14428,"_27536":119723,"_2958":119766},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3475":71382,"_30304":71382,"_5":14780,"_2958":119768,"_30657":119769,"_20976":119770,"_27536":71382},"Referencia EST",[49412,118079,51904,119094,119269],[],{"_3475":71383,"_30304":71382,"_20976":119772,"_5":14428,"_27536":71382,"_2958":119773},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3475":71384,"_30304":71382,"_5":30654,"_20976":119775,"_27536":119776,"_2958":119777},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3475":71385,"_30304":71382,"_5":30654,"_20976":119779,"_27536":119780,"_2958":22743},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3475":71386,"_30304":71382,"_5":30654,"_20976":119782,"_27536":119783,"_2958":26134},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3475":71387,"_30304":71382,"_5":30654,"_20976":119785,"_27536":119786,"_2958":26141},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3475":71388,"_30304":71382,"_5":30654,"_20976":119788,"_27536":119789,"_2958":25445},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3475":71389,"_30304":71382,"_5":30654,"_20976":119791,"_27536":119792,"_2958":119793},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3475":71390,"_30304":71382,"_5":30654,"_20976":119795,"_27536":119796,"_2958":119797},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3475":71391,"_30304":71382,"_5":30654,"_20976":119799,"_27536":119800,"_2958":119801},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3475":71392,"_30304":71382,"_20976":119803,"_5":14428,"_27536":71382,"_2958":119804},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3475":71393,"_30304":71382,"_20976":119806,"_5":14428,"_27536":119776,"_2958":119807},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3475":71394,"_30304":71382,"_20976":119809,"_5":14428,"_27536":119776,"_2958":117839},[],{"_3475":71395,"_30304":71382,"_20976":119811,"_5":14428,"_27536":119776,"_2958":119812},[],"Método",{"_3475":71396,"_30304":71382,"_20976":119814,"_5":14428,"_27536":119776,"_2958":119815},[],"Autenticación y condición",{"_3475":71397,"_30304":71382,"_20976":119817,"_5":14428,"_27536":119776,"_2958":52666},[],{"_3475":71398,"_30304":71382,"_20976":119819,"_5":14428,"_27536":119776,"_2958":52669},[],{"_3475":71399,"_30304":71382,"_20976":119821,"_5":14428,"_27536":119776,"_2958":119822},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3475":71400,"_30304":71382,"_20976":119824,"_5":14428,"_27536":119776,"_2958":52675},[],{"_3475":71401,"_30304":71382,"_20976":119826,"_5":14428,"_27536":119776,"_2958":52678},[],{"_3475":71402,"_30304":71382,"_20976":119828,"_5":14428,"_27536":119776,"_2958":119829},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3475":71403,"_30304":71382,"_20976":119831,"_5":14428,"_27536":119776,"_2958":52684},[],{"_3475":71404,"_30304":71382,"_20976":119833,"_5":14428,"_27536":119776,"_2958":52678},[],{"_3475":71405,"_30304":71382,"_20976":119835,"_5":14428,"_27536":119776,"_2958":119836},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3475":71406,"_30304":71382,"_20976":119838,"_5":14428,"_27536":119776,"_2958":52692},[],{"_3475":71407,"_30304":71382,"_20976":119840,"_5":14428,"_27536":119776,"_2958":52678},[],{"_3475":71408,"_30304":71382,"_20976":119842,"_5":14428,"_27536":119776,"_2958":119843},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3475":71409,"_30304":71382,"_20976":119845,"_5":14428,"_27536":119776,"_2958":119846},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3475":71410,"_30304":71382,"_20976":119848,"_5":14428,"_27536":119780,"_2958":119849},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3475":71411,"_30304":71382,"_20976":119851,"_5":14428,"_27536":119780,"_2958":119852},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3475":71412,"_30304":71382,"_20976":119854,"_5":14428,"_27536":119783,"_2958":119855},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3475":71413,"_30304":71382,"_20976":119857,"_5":14428,"_27536":119783,"_2958":119858},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3475":71414,"_30304":71382,"_20976":119860,"_5":14428,"_27536":119786,"_2958":119861},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3475":71415,"_30304":71382,"_20976":119863,"_5":14428,"_27536":119786,"_2958":119864},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3475":71416,"_30304":71382,"_20976":119866,"_5":14428,"_27536":119789,"_2958":119867},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3475":71417,"_30304":71382,"_20976":119869,"_5":14428,"_27536":119789,"_2958":119870},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3475":71418,"_30304":71382,"_20976":119872,"_5":14428,"_27536":119792,"_2958":119873},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3475":71419,"_30304":71382,"_20976":119875,"_5":14428,"_27536":119792,"_2958":119876},[],"Parte",{"_3475":71420,"_30304":71382,"_20976":119878,"_5":14428,"_27536":119792,"_2958":119879},[],"Contenido tras decodificar su Base64",{"_3475":71421,"_30304":71382,"_20976":119881,"_5":14428,"_27536":119792,"_2958":52736},[],{"_3475":71422,"_30304":71382,"_20976":119883,"_5":14428,"_27536":119792,"_2958":119884},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3475":71423,"_30304":71382,"_20976":119886,"_5":14428,"_27536":119792,"_2958":52742},[],{"_3475":71424,"_30304":71382,"_20976":119888,"_5":14428,"_27536":119792,"_2958":119889},[],"PKCS#7 DER con el certificado emitido.",{"_3475":71425,"_30304":71382,"_20976":119891,"_5":14428,"_27536":119792,"_2958":119892},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3475":71426,"_30304":71382,"_20976":119894,"_5":14428,"_27536":119796,"_2958":119895},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3475":71427,"_30304":71382,"_20976":119897,"_5":14428,"_27536":119796,"_2958":119898},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3475":71428,"_30304":71382,"_20976":119900,"_5":14428,"_27536":119796,"_2958":119901},[],"Convierte y comprueba el resultado:",{"_3475":71429,"_30304":71382,"_20976":119903,"_5":14428,"_27536":119796,"_2958":119904},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3475":71430,"_30304":71382,"_20976":119906,"_5":14428,"_27536":119800,"_2958":119907},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3475":71431,"_30304":71382,"_20976":119909,"_5":14428,"_27536":119800,"_2958":119910},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3475":71432,"_30304":71432,"_5":14780,"_2958":119269,"_30657":119912,"_20976":119913,"_27536":71432},[49412,118079,51904,119094,119269],[],{"_3475":71433,"_30304":71432,"_20976":119915,"_5":14428,"_27536":71432,"_2958":119916},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3475":71434,"_30304":71432,"_5":30654,"_20976":119918,"_27536":119919,"_2958":119920},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3475":71435,"_30304":71432,"_5":30654,"_20976":119922,"_27536":119923,"_2958":119924},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3475":71436,"_30304":71432,"_5":30654,"_20976":119926,"_27536":119927,"_2958":119928},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3475":71437,"_30304":71432,"_5":30654,"_20976":119930,"_27536":119931,"_2958":119932},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3475":71438,"_30304":71432,"_20976":119934,"_5":14428,"_27536":71432,"_2958":119935},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3475":71439,"_30304":71432,"_20976":119937,"_5":14428,"_27536":119919,"_2958":119938},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3475":71440,"_30304":71432,"_20976":119940,"_5":14428,"_27536":119919,"_2958":119941},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3475":71441,"_30304":71432,"_20976":119943,"_5":14428,"_27536":119919,"_2958":119944},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3475":71442,"_30304":71432,"_20976":119946,"_5":14428,"_27536":119919,"_2958":119947},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3475":71443,"_30304":71432,"_20976":119949,"_5":14428,"_27536":119919,"_2958":119950},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3475":71444,"_30304":71432,"_20976":119952,"_5":14428,"_27536":119919,"_2958":119953},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3475":71445,"_30304":71432,"_20976":119955,"_5":14428,"_27536":119923,"_2958":119956},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3475":71446,"_30304":71432,"_20976":119958,"_5":14428,"_27536":119923,"_2958":119959},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":71447,"_30304":71432,"_20976":119961,"_5":14428,"_27536":119923,"_2958":119962},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3475":71448,"_30304":71432,"_20976":119964,"_5":14428,"_27536":119923,"_2958":119965},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3475":71449,"_30304":71432,"_20976":119967,"_5":14428,"_27536":119927,"_2958":119968},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3475":71450,"_30304":71432,"_20976":119970,"_5":14428,"_27536":119927,"_2958":119971},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3475":71451,"_30304":71432,"_20976":119973,"_5":14428,"_27536":119927,"_2958":119974},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3475":71452,"_30304":71432,"_20976":119976,"_5":14428,"_27536":119927,"_2958":119977},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3475":71453,"_30304":71432,"_20976":119979,"_5":14428,"_27536":119931,"_2958":119980},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3475":71454,"_30304":71432,"_20976":119982,"_5":14428,"_27536":119931,"_2958":119983},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3475":71455,"_30304":71455,"_5":14780,"_2958":119985,"_30657":119986,"_20976":119987,"_27536":71455},"Estrategias de aprovisionamiento",[49412,118079,51904,119094,119269],[],{"_3475":71456,"_30304":71455,"_20976":119989,"_5":14428,"_27536":71455,"_2958":119990},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3475":71457,"_30304":71455,"_5":30654,"_20976":119992,"_27536":119993,"_2958":119994},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3475":71458,"_30304":71455,"_5":30654,"_20976":119996,"_27536":119997,"_2958":119998},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3475":71459,"_30304":71455,"_5":30654,"_20976":120000,"_27536":120001,"_2958":120002},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3475":71460,"_30304":71455,"_5":30654,"_20976":120004,"_27536":120005,"_2958":120006},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3475":71461,"_30304":71455,"_5":30654,"_20976":120008,"_27536":120009,"_2958":120010},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3475":71462,"_30304":71455,"_20976":120012,"_5":14428,"_27536":71455,"_2958":120013},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3475":71463,"_30304":71455,"_20976":120015,"_5":14428,"_27536":119993,"_2958":120016},[],"Recorrido",{"_3475":71464,"_30304":71455,"_20976":120018,"_5":14428,"_27536":119993,"_2958":120019},[],"Cuándo existe el dispositivo",{"_3475":71465,"_30304":71455,"_20976":120021,"_5":14428,"_27536":119993,"_2958":120022},[],"Qué compruebas",{"_3475":71466,"_30304":71455,"_20976":120024,"_5":14428,"_27536":119993,"_2958":120025},[],"Asignación manual",{"_3475":71467,"_30304":71455,"_20976":120027,"_5":14428,"_27536":119993,"_2958":120028},[],"El operador lo crea antes de asociar un certificado.",{"_3475":71468,"_30304":71455,"_20976":120030,"_5":14428,"_27536":119993,"_2958":120031},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3475":71469,"_30304":71455,"_20976":120033,"_5":14428,"_27536":119993,"_2958":120034},[],"EST con `JITP`",{"_3475":71470,"_30304":71455,"_20976":120036,"_5":14428,"_27536":119993,"_2958":120037},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3475":71471,"_30304":71455,"_20976":120039,"_5":14428,"_27536":119993,"_2958":120040},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3475":71472,"_30304":71455,"_20976":120042,"_5":14428,"_27536":119993,"_2958":120043},[],"EST con `PRE_REGISTRATION`",{"_3475":71473,"_30304":71455,"_20976":120045,"_5":14428,"_27536":119993,"_2958":120046},[],"Debe existir antes de `/simpleenroll`.",{"_3475":71474,"_30304":71455,"_20976":120048,"_5":14428,"_27536":119993,"_2958":120049},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3475":71475,"_30304":71455,"_20976":120051,"_5":14428,"_27536":119993,"_2958":120052},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3475":71476,"_30304":71455,"_20976":120054,"_5":14428,"_27536":119993,"_2958":120055},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3475":71477,"_30304":71455,"_20976":120057,"_5":14428,"_27536":119997,"_2958":120058},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3475":71478,"_30304":71455,"_20976":120060,"_5":14428,"_27536":119997,"_2958":120061},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3475":71479,"_30304":71455,"_20976":120063,"_5":14428,"_27536":119997,"_2958":120064},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3475":71480,"_30304":71455,"_20976":120066,"_5":14428,"_27536":120001,"_2958":120067},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3475":71481,"_30304":71455,"_20976":120069,"_5":14428,"_27536":120001,"_2958":120070},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3475":71482,"_30304":71455,"_20976":120072,"_5":14428,"_27536":120001,"_2958":120073},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3475":71483,"_30304":71455,"_20976":120075,"_5":14428,"_27536":120001,"_2958":120076},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3475":71484,"_30304":71455,"_20976":120078,"_5":14428,"_27536":120001,"_2958":120079},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3475":71485,"_30304":71455,"_20976":120081,"_5":14428,"_27536":120001,"_2958":120082},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3475":71486,"_30304":71455,"_20976":120084,"_5":14428,"_27536":120005,"_2958":117014},[],{"_3475":71487,"_30304":71455,"_20976":120086,"_5":14428,"_27536":120005,"_2958":120087},[],"Material que atraviesa EST",{"_3475":71488,"_30304":71455,"_20976":120089,"_5":14428,"_27536":120005,"_2958":120090},[],"Clave generada por el dispositivo",{"_3475":71489,"_30304":71455,"_20976":120092,"_5":14428,"_27536":120005,"_2958":120093},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3475":71490,"_30304":71455,"_20976":120095,"_5":14428,"_27536":120005,"_2958":120096},[],"Clave ya disponible en el dispositivo",{"_3475":71491,"_30304":71455,"_20976":120098,"_5":14428,"_27536":120005,"_2958":120099},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3475":71492,"_30304":71455,"_20976":120101,"_5":14428,"_27536":120005,"_2958":52223},[],{"_3475":71493,"_30304":71455,"_20976":120103,"_5":14428,"_27536":120005,"_2958":120104},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3475":71494,"_30304":71455,"_20976":120106,"_5":14428,"_27536":120005,"_2958":120107},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3475":71495,"_30304":71455,"_20976":120109,"_5":14428,"_27536":120009,"_2958":120110},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3475":71496,"_30304":71496,"_5":14780,"_2958":120112,"_30657":120113,"_20976":120114,"_27536":71496},"Renovación y recuperación",[49412,118079,51904,119094,119269],[],{"_3475":71497,"_30304":71496,"_20976":120116,"_5":14428,"_27536":71496,"_2958":120117},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3475":71498,"_30304":71496,"_5":30654,"_20976":120119,"_27536":120120,"_2958":120121},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3475":71499,"_30304":71496,"_5":30654,"_20976":120123,"_27536":120124,"_2958":120125},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3475":71500,"_30304":71496,"_5":30654,"_20976":120127,"_27536":120128,"_2958":120129},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3475":71501,"_30304":71496,"_5":30654,"_20976":120131,"_27536":120132,"_2958":120133},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3475":71502,"_30304":71496,"_5":30654,"_20976":120135,"_27536":120136,"_2958":120137},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3475":71503,"_30304":71496,"_20976":120139,"_5":14428,"_27536":71496,"_2958":120140},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3475":71504,"_30304":71496,"_20976":120142,"_5":14428,"_27536":120120,"_2958":120143},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3475":71505,"_30304":71496,"_20976":120145,"_5":14428,"_27536":120120,"_2958":120146},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3475":71506,"_30304":71496,"_20976":120148,"_5":14428,"_27536":120120,"_2958":120149},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3475":71507,"_30304":71496,"_20976":120151,"_5":14428,"_27536":120120,"_2958":120152},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3475":71508,"_30304":71496,"_20976":120154,"_5":14428,"_27536":120124,"_2958":120155},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3475":71509,"_30304":71496,"_20976":120157,"_5":14428,"_27536":120124,"_2958":120158},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3475":71510,"_30304":71496,"_20976":120160,"_5":14428,"_27536":120128,"_2958":120161},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3475":71511,"_30304":71496,"_20976":120163,"_5":14428,"_27536":120128,"_2958":120164},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3475":71512,"_30304":71496,"_20976":120166,"_5":14428,"_27536":120128,"_2958":120167},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3475":71513,"_30304":71496,"_20976":120169,"_5":14428,"_27536":120132,"_2958":120170},[],"Situación",{"_3475":71514,"_30304":71496,"_20976":120172,"_5":14428,"_27536":120132,"_2958":120173},[],"Procedimiento",{"_3475":71515,"_30304":71496,"_20976":120175,"_5":14428,"_27536":120132,"_2958":120176},[],"Certificado vigente, fuera de ventana",{"_3475":71516,"_30304":71496,"_20976":120178,"_5":14428,"_27536":120132,"_2958":120179},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3475":71517,"_30304":71496,"_20976":120181,"_5":14428,"_27536":120132,"_2958":120182},[],"Certificado vencido, clave disponible",{"_3475":71518,"_30304":71496,"_20976":120184,"_5":14428,"_27536":120132,"_2958":120185},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3475":71519,"_30304":71496,"_20976":120187,"_5":14428,"_27536":120132,"_2958":120188},[],"Renovación por webhook o `NO_AUTH`",{"_3475":71520,"_30304":71496,"_20976":120190,"_5":14428,"_27536":120132,"_2958":120191},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3475":71521,"_30304":71496,"_20976":120193,"_5":14428,"_27536":120132,"_2958":120194},[],"Clave perdida o inaccesible",{"_3475":71522,"_30304":71496,"_20976":120196,"_5":14428,"_27536":120132,"_2958":120197},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3475":71523,"_30304":71496,"_20976":120199,"_5":14428,"_27536":120132,"_2958":120200},[],"Identidad actual revocada",{"_3475":71524,"_30304":71496,"_20976":120202,"_5":14428,"_27536":120132,"_2958":120203},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3475":71525,"_30304":71496,"_20976":120205,"_5":14428,"_27536":120132,"_2958":120206},[],"Dispositivo sin identidad",{"_3475":71526,"_30304":71496,"_20976":120208,"_5":14428,"_27536":120132,"_2958":120209},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3475":71527,"_30304":71496,"_20976":120211,"_5":14428,"_27536":120132,"_2958":120212},[],"Dispositivo retirado",{"_3475":71528,"_30304":71496,"_20976":120214,"_5":14428,"_27536":120132,"_2958":120215},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3475":71529,"_30304":71496,"_20976":120217,"_5":14428,"_27536":120132,"_2958":120218},[],"Timeout, HTTP 500 o fallo de instalación",{"_3475":71530,"_30304":71496,"_20976":120220,"_5":14428,"_27536":120132,"_2958":120221},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3475":71531,"_30304":71496,"_20976":120223,"_5":14428,"_27536":120136,"_2958":120224},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3475":71532,"_30304":71496,"_20976":120226,"_5":14428,"_27536":120136,"_2958":120227},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3475":71533,"_30304":71533,"_5":14780,"_2958":120229,"_30657":120230,"_20976":120231,"_27536":71533},"Diagnóstico de enrolamiento",[49412,118079,51904,119094,119269],[],{"_3475":71534,"_30304":71533,"_20976":120233,"_5":14428,"_27536":71533,"_2958":120234},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3475":71535,"_30304":71533,"_5":30654,"_20976":120236,"_27536":120237,"_2958":120238},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3475":71536,"_30304":71533,"_5":30654,"_20976":120240,"_27536":120241,"_2958":120242},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3475":71537,"_30304":71533,"_5":30654,"_20976":120244,"_27536":120245,"_2958":119801},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3475":71538,"_30304":71533,"_5":30654,"_20976":120247,"_27536":120248,"_2958":120249},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3475":71539,"_30304":71533,"_20976":120251,"_5":14428,"_27536":71533,"_2958":120252},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3475":71540,"_30304":71533,"_20976":120254,"_5":14428,"_27536":120241,"_2958":120255},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3475":71541,"_30304":71533,"_20976":120257,"_5":14428,"_27536":120241,"_2958":120258},[],"Síntoma o mensaje",{"_3475":71542,"_30304":71533,"_20976":120260,"_5":14428,"_27536":120241,"_2958":120261},[],"Qué revisar",{"_3475":71543,"_30304":71533,"_20976":120263,"_5":14428,"_27536":120241,"_2958":120264},[],"curl rechaza TLS, nombre o emisor",{"_3475":71544,"_30304":71533,"_20976":120266,"_5":14428,"_27536":120241,"_2958":120267},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3475":71545,"_30304":71533,"_20976":120269,"_5":14428,"_27536":120241,"_2958":120270},[],"404 o APS ausente",{"_3475":71546,"_30304":71533,"_20976":120272,"_5":14428,"_27536":120241,"_2958":120273},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3475":71547,"_30304":71533,"_20976":120275,"_5":14428,"_27536":120241,"_2958":120276},[],"400, error de CSR o formato",{"_3475":71548,"_30304":71533,"_20976":120278,"_5":14428,"_27536":120241,"_2958":120279},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3475":71549,"_30304":71533,"_20976":120281,"_5":14428,"_27536":120241,"_2958":120282},[],"Credencial ausente o certificado no válido",{"_3475":71550,"_30304":71533,"_20976":120284,"_5":14428,"_27536":120241,"_2958":120285},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3475":71551,"_30304":71533,"_20976":120287,"_5":14428,"_27536":120241,"_2958":120288},[],"Webhook deniega, expira o responde sin autorización",{"_3475":71552,"_30304":71533,"_20976":120290,"_5":14428,"_27536":120241,"_2958":120291},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3475":71553,"_30304":71533,"_20976":120293,"_5":14428,"_27536":120241,"_2958":53149},[],{"_3475":71554,"_30304":71533,"_20976":120295,"_5":14428,"_27536":120241,"_2958":120296},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3475":71555,"_30304":71533,"_20976":120298,"_5":14428,"_27536":120241,"_2958":53155},[],{"_3475":71556,"_30304":71533,"_20976":120300,"_5":14428,"_27536":120241,"_2958":120301},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3475":71557,"_30304":71533,"_20976":120303,"_5":14428,"_27536":120241,"_2958":53161},[],{"_3475":71558,"_30304":71533,"_20976":120305,"_5":14428,"_27536":120241,"_2958":120306},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3475":71559,"_30304":71533,"_20976":120308,"_5":14428,"_27536":120241,"_2958":53167},[],{"_3475":71560,"_30304":71533,"_20976":120310,"_5":14428,"_27536":120241,"_2958":120311},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3475":71561,"_30304":71533,"_20976":120313,"_5":14428,"_27536":120241,"_2958":53173},[],{"_3475":71562,"_30304":71533,"_20976":120315,"_5":14428,"_27536":120241,"_2958":120316},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3475":71563,"_30304":71533,"_20976":120318,"_5":14428,"_27536":120241,"_2958":120319},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3475":71564,"_30304":71533,"_20976":120321,"_5":14428,"_27536":120241,"_2958":120322},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3475":71565,"_30304":71533,"_20976":120324,"_5":14428,"_27536":120241,"_2958":120325},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3475":71566,"_30304":71533,"_20976":120327,"_5":14428,"_27536":120241,"_2958":120328},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3475":71567,"_30304":71533,"_20976":120330,"_5":14428,"_27536":120241,"_2958":53191},[],{"_3475":71568,"_30304":71533,"_20976":120332,"_5":14428,"_27536":120241,"_2958":120333},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3475":71569,"_30304":71533,"_20976":120335,"_5":14428,"_27536":120241,"_2958":53197},[],{"_3475":71570,"_30304":71533,"_20976":120337,"_5":14428,"_27536":120241,"_2958":120338},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3475":71571,"_30304":71533,"_20976":120340,"_5":14428,"_27536":120241,"_2958":120341},[],"DMS propietario distinto",{"_3475":71572,"_30304":71533,"_20976":120343,"_5":14428,"_27536":120241,"_2958":120344},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3475":71573,"_30304":71533,"_20976":120346,"_5":14428,"_27536":120241,"_2958":53209},[],{"_3475":71574,"_30304":71533,"_20976":120348,"_5":14428,"_27536":120241,"_2958":120349},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3475":71575,"_30304":71533,"_20976":120351,"_5":14428,"_27536":120241,"_2958":53215},[],{"_3475":71576,"_30304":71533,"_20976":120353,"_5":14428,"_27536":120241,"_2958":120354},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3475":71577,"_30304":71533,"_20976":120356,"_5":14428,"_27536":120241,"_2958":120357},[],"Certificado actual revocado",{"_3475":71578,"_30304":71533,"_20976":120359,"_5":14428,"_27536":120241,"_2958":120360},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3475":71579,"_30304":71533,"_20976":120362,"_5":14428,"_27536":120241,"_2958":120363},[],"Error de CA, perfil o firma",{"_3475":71580,"_30304":71533,"_20976":120365,"_5":14428,"_27536":120241,"_2958":120366},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3475":71581,"_30304":71533,"_20976":120368,"_5":14428,"_27536":120241,"_2958":120369},[],"HTTP 200 sin conexión del dispositivo",{"_3475":71582,"_30304":71533,"_20976":120371,"_5":14428,"_27536":120241,"_2958":120372},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3475":71583,"_30304":71533,"_20976":120374,"_5":14428,"_27536":120241,"_2958":120375},[],"Timeout o error después de emitir",{"_3475":71584,"_30304":71533,"_20976":120377,"_5":14428,"_27536":120241,"_2958":120378},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3475":71585,"_30304":71533,"_20976":120380,"_5":14428,"_27536":120245,"_2958":120381},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3475":71586,"_30304":71533,"_20976":120383,"_5":14428,"_27536":120245,"_2958":120384},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3475":71587,"_30304":71533,"_20976":120386,"_5":14428,"_27536":120248,"_2958":120387},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3475":71588,"_30304":71533,"_20976":120389,"_5":14428,"_27536":120248,"_2958":120390},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3475":71589,"_30304":71533,"_20976":120392,"_5":14428,"_27536":120248,"_2958":120393},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3475":71590,"_30304":71533,"_20976":120395,"_5":14428,"_27536":120248,"_2958":120396},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3475":71591,"_30304":71533,"_20976":120398,"_5":14428,"_27536":120248,"_2958":120399},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3475":71592,"_30304":71533,"_20976":120401,"_5":14428,"_27536":120248,"_2958":120402},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3475":71593,"_30304":71533,"_20976":120404,"_5":14428,"_27536":120248,"_2958":120405},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3475":71594,"_30304":71594,"_5":14780,"_2958":120407,"_30657":120408,"_20976":120409,"_27536":71594},"Distribución y actualización de confianza",[49412,118079,51904,119094,119269],[],{"_3475":71595,"_30304":71594,"_20976":120411,"_5":14428,"_27536":71594,"_2958":120412},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3475":71596,"_30304":71594,"_5":30654,"_20976":120414,"_27536":120415,"_2958":120416},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3475":71597,"_30304":71594,"_5":30654,"_20976":120418,"_27536":120419,"_2958":120420},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3475":71598,"_30304":71594,"_5":30654,"_20976":120422,"_27536":120423,"_2958":120424},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3475":71599,"_30304":71594,"_5":30654,"_20976":120426,"_27536":120427,"_2958":120428},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3475":71600,"_30304":71594,"_5":30654,"_20976":120430,"_27536":120431,"_2958":120432},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3475":71601,"_30304":71594,"_20976":120434,"_5":14428,"_27536":71594,"_2958":120435},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3475":71602,"_30304":71594,"_20976":120437,"_5":14428,"_27536":120415,"_2958":120438},[],"Relación",{"_3475":71603,"_30304":71594,"_20976":120440,"_5":14428,"_27536":120415,"_2958":120441},[],"Material que prepara el responsable",{"_3475":71604,"_30304":71594,"_20976":120443,"_5":14428,"_27536":120415,"_2958":120444},[],"Dispositivo → servidor EST",{"_3475":71605,"_30304":71594,"_20976":120446,"_5":14428,"_27536":120415,"_2958":120447},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3475":71606,"_30304":71594,"_20976":120449,"_5":14428,"_27536":120415,"_2958":120450},[],"DMS → solicitante",{"_3475":71607,"_30304":71594,"_20976":120452,"_5":14428,"_27536":120415,"_2958":120453},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3475":71608,"_30304":71594,"_20976":120455,"_5":14428,"_27536":120415,"_2958":120456},[],"Consumidor → dispositivo",{"_3475":71609,"_30304":71594,"_20976":120458,"_5":14428,"_27536":120415,"_2958":120459},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3475":71610,"_30304":71594,"_20976":120461,"_5":14428,"_27536":120415,"_2958":120462},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3475":71611,"_30304":71594,"_20976":120464,"_5":14428,"_27536":120419,"_2958":120465},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3475":71612,"_30304":71594,"_20976":120467,"_5":14428,"_27536":120419,"_2958":120468},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3475":71613,"_30304":71594,"_20976":120470,"_5":14428,"_27536":120423,"_2958":120471},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3475":71614,"_30304":71594,"_20976":120473,"_5":14428,"_27536":120423,"_2958":120474},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3475":71615,"_30304":71594,"_20976":120476,"_5":14428,"_27536":120423,"_2958":120477},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3475":71616,"_30304":71594,"_20976":120479,"_5":14428,"_27536":120423,"_2958":120480},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3475":71617,"_30304":71594,"_20976":120482,"_5":14428,"_27536":120423,"_2958":120483},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3475":71618,"_30304":71594,"_20976":120485,"_5":14428,"_27536":120423,"_2958":120486},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3475":71619,"_30304":71594,"_20976":120488,"_5":14428,"_27536":120427,"_2958":120489},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3475":71620,"_30304":71594,"_20976":120491,"_5":14428,"_27536":120427,"_2958":120492},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3475":71621,"_30304":71594,"_20976":120494,"_5":14428,"_27536":120427,"_2958":120495},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3475":71622,"_30304":71594,"_20976":120497,"_5":14428,"_27536":120431,"_2958":120498},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3475":71623,"_30304":71623,"_5":14780,"_2958":53364,"_30657":120500,"_20976":120502,"_27536":71623},[49412,118079,51904,119094,120501],"Integraciones",[],{"_3475":71624,"_30304":71623,"_20976":120504,"_5":14428,"_27536":71623,"_2958":120505},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3475":71625,"_30304":71623,"_5":30654,"_20976":120507,"_27536":120508,"_2958":120509},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3475":71626,"_30304":71623,"_5":30654,"_20976":120511,"_27536":120512,"_2958":120513},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3475":71627,"_30304":71623,"_5":30654,"_20976":120515,"_27536":120516,"_2958":120517},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3475":71628,"_30304":71623,"_5":30654,"_20976":120519,"_27536":120520,"_2958":120521},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3475":71629,"_30304":71623,"_5":30654,"_20976":120523,"_27536":120524,"_2958":120525},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3475":71630,"_30304":71623,"_5":30654,"_20976":120527,"_27536":120528,"_2958":120529},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3475":71631,"_30304":71623,"_5":30654,"_20976":120531,"_27536":120532,"_2958":120533},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3475":71632,"_30304":71623,"_5":30654,"_20976":120535,"_27536":120536,"_2958":120537},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3475":71633,"_30304":71623,"_5":30654,"_20976":120539,"_27536":120540,"_2958":53406},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3475":71634,"_30304":71623,"_5":30654,"_20976":120542,"_27536":120543,"_2958":53410},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3475":71635,"_30304":71623,"_5":30654,"_20976":120545,"_27536":120546,"_2958":120547},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3475":71636,"_30304":71623,"_5":30654,"_20976":120549,"_27536":120550,"_2958":120551},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3475":71637,"_30304":71623,"_5":30654,"_20976":120553,"_27536":120554,"_2958":120555},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3475":71638,"_30304":71623,"_5":30654,"_20976":120557,"_27536":120558,"_2958":120559},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3475":71639,"_30304":71623,"_5":30654,"_20976":120561,"_27536":120562,"_2958":120563},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3475":71640,"_30304":71623,"_5":30654,"_20976":120565,"_27536":120566,"_2958":120567},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3475":71641,"_30304":71623,"_5":30654,"_20976":120569,"_27536":120570,"_2958":120571},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3475":71642,"_30304":71623,"_5":30654,"_20976":120573,"_27536":120574,"_2958":120575},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3475":71643,"_30304":71623,"_5":30654,"_20976":120577,"_27536":120578,"_2958":120579},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3475":71644,"_30304":71623,"_5":30654,"_20976":120581,"_27536":120582,"_2958":120583},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3475":71645,"_30304":71623,"_5":30654,"_20976":120585,"_27536":120586,"_2958":120587},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3475":71646,"_30304":71623,"_5":30654,"_20976":120589,"_27536":120590,"_2958":120591},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3475":71647,"_30304":71623,"_5":30654,"_20976":120593,"_27536":120594,"_2958":120595},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3475":71648,"_30304":71623,"_5":30654,"_20976":120597,"_27536":120598,"_2958":120599},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3475":71649,"_30304":71623,"_5":30654,"_20976":120601,"_27536":120602,"_2958":120603},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3475":71650,"_30304":71623,"_20976":120605,"_5":14428,"_27536":71623,"_2958":120606},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3475":71651,"_30304":71623,"_20976":120608,"_5":14428,"_27536":71623,"_2958":120609},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3475":71652,"_30304":71623,"_20976":120611,"_5":14428,"_27536":71623,"_2958":120612},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3475":71653,"_30304":71623,"_20976":120614,"_5":14428,"_27536":120508,"_2958":120615},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3475":71654,"_30304":71623,"_20976":120617,"_5":14428,"_27536":120508,"_2958":120618},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3475":71655,"_30304":71623,"_20976":120620,"_5":14428,"_27536":120508,"_2958":120621},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3475":71656,"_30304":71623,"_20976":120623,"_5":14428,"_27536":120508,"_2958":120624},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3475":71657,"_30304":71623,"_20976":120626,"_5":14428,"_27536":120512,"_2958":120627},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3475":71658,"_30304":71623,"_20976":120629,"_5":14428,"_27536":120516,"_2958":120630},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3475":71659,"_30304":71623,"_20976":120632,"_5":14428,"_27536":120516,"_2958":120633},[],"Acción IAM",{"_3475":71660,"_30304":71623,"_20976":120635,"_5":14428,"_27536":120516,"_2958":117020},[],{"_3475":71661,"_30304":71623,"_20976":120637,"_5":14428,"_27536":120516,"_2958":53505},[],{"_3475":71662,"_30304":71623,"_20976":120639,"_5":14428,"_27536":120516,"_2958":120640},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3475":71663,"_30304":71623,"_20976":120642,"_5":14428,"_27536":120516,"_2958":53511},[],{"_3475":71664,"_30304":71623,"_20976":120644,"_5":14428,"_27536":120516,"_2958":120645},[],"Registrar la CA en AWS IoT",{"_3475":71665,"_30304":71623,"_20976":120647,"_5":14428,"_27536":120516,"_2958":53517},[],{"_3475":71666,"_30304":71623,"_20976":120649,"_5":14428,"_27536":120516,"_2958":120650},[],"Consultar el estado del registro de la CA",{"_3475":71667,"_30304":71623,"_20976":120652,"_5":14428,"_27536":120516,"_2958":53523},[],{"_3475":71668,"_30304":71623,"_20976":120654,"_5":14428,"_27536":120516,"_2958":120655},[],"Crear o actualizar Things en IoT Core",{"_3475":71669,"_30304":71623,"_20976":120657,"_5":14428,"_27536":120516,"_2958":53529},[],{"_3475":71670,"_30304":71623,"_20976":120659,"_5":14428,"_27536":120516,"_2958":120660},[],"Aprovisionar Things mediante plantilla",{"_3475":71671,"_30304":71623,"_20976":120662,"_5":14428,"_27536":120516,"_2958":53535},[],{"_3475":71672,"_30304":71623,"_20976":120664,"_5":14428,"_27536":120516,"_2958":120665},[],"Registrar certificados de dispositivo",{"_3475":71673,"_30304":71623,"_20976":120667,"_5":14428,"_27536":120516,"_2958":53541},[],{"_3475":71674,"_30304":71623,"_20976":120669,"_5":14428,"_27536":120516,"_2958":120670},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3475":71675,"_30304":71623,"_20976":120672,"_5":14428,"_27536":120516,"_2958":53547},[],{"_3475":71676,"_30304":71623,"_20976":120674,"_5":14428,"_27536":120516,"_2958":120675},[],"Crear y adjuntar políticas IoT",{"_3475":71677,"_30304":71623,"_20976":120677,"_5":14428,"_27536":120516,"_2958":53553},[],{"_3475":71678,"_30304":71623,"_20976":120679,"_5":14428,"_27536":120516,"_2958":120680},[],"Gestionar grupos de Things",{"_3475":71679,"_30304":71623,"_20976":120682,"_5":14428,"_27536":120516,"_2958":53559},[],{"_3475":71680,"_30304":71623,"_20976":120684,"_5":14428,"_27536":120516,"_2958":120685},[],"Crear plantillas JITP",{"_3475":71681,"_30304":71623,"_20976":120687,"_5":14428,"_27536":120516,"_2958":53565},[],{"_3475":71682,"_30304":71623,"_20976":120689,"_5":14428,"_27536":120516,"_2958":120690},[],"Leer y escribir el Device Shadow",{"_3475":71683,"_30304":71623,"_20976":120692,"_5":14428,"_27536":120516,"_2958":120693},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3475":71684,"_30304":71623,"_20976":120695,"_5":14428,"_27536":120520,"_2958":120696},[],"Parámetro",{"_3475":71685,"_30304":71623,"_20976":120698,"_5":14428,"_27536":120520,"_2958":120699},[],"Tipo",{"_3475":71686,"_30304":71623,"_20976":120701,"_5":14428,"_27536":120520,"_2958":120702},[],"Requerido",{"_3475":71687,"_30304":71623,"_20976":120704,"_5":14428,"_27536":120520,"_2958":120705},[],"Descripción",{"_3475":71688,"_30304":71623,"_20976":120707,"_5":14428,"_27536":120520,"_2958":53586},[],{"_3475":71689,"_30304":71623,"_20976":120709,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71690,"_30304":71623,"_20976":120711,"_5":14428,"_27536":120520,"_2958":120712},[],"Sí",{"_3475":71691,"_30304":71623,"_20976":120714,"_5":14428,"_27536":120520,"_2958":120715},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3475":71692,"_30304":71623,"_20976":120717,"_5":14428,"_27536":120520,"_2958":53597},[],{"_3475":71693,"_30304":71623,"_20976":120719,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71694,"_30304":71623,"_20976":120721,"_5":14428,"_27536":120520,"_2958":120712},[],{"_3475":71695,"_30304":71623,"_20976":120723,"_5":14428,"_27536":120520,"_2958":120724},[],"Región AWS donde opera el conector.",{"_3475":71696,"_30304":71623,"_20976":120726,"_5":14428,"_27536":120520,"_2958":53607},[],{"_3475":71697,"_30304":71623,"_20976":120728,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71698,"_30304":71623,"_20976":120730,"_5":14428,"_27536":120520,"_2958":120712},[],{"_3475":71699,"_30304":71623,"_20976":120732,"_5":14428,"_27536":120520,"_2958":120733},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3475":71700,"_30304":71623,"_20976":120735,"_5":14428,"_27536":120520,"_2958":53617},[],{"_3475":71701,"_30304":71623,"_20976":120737,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71702,"_30304":71623,"_20976":120739,"_5":14428,"_27536":120520,"_2958":120740},[],"Solo con `auth_method=static`",{"_3475":71703,"_30304":71623,"_20976":120742,"_5":14428,"_27536":120520,"_2958":120743},[],"Clave de acceso AWS.",{"_3475":71704,"_30304":71623,"_20976":120745,"_5":14428,"_27536":120520,"_2958":53628},[],{"_3475":71705,"_30304":71623,"_20976":120747,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71706,"_30304":71623,"_20976":120749,"_5":14428,"_27536":120520,"_2958":120740},[],{"_3475":71707,"_30304":71623,"_20976":120751,"_5":14428,"_27536":120520,"_2958":120752},[],"Clave secreta AWS.",{"_3475":71708,"_30304":71623,"_20976":120754,"_5":14428,"_27536":120520,"_2958":53638},[],{"_3475":71709,"_30304":71623,"_20976":120756,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71710,"_30304":71623,"_20976":120758,"_5":14428,"_27536":120520,"_2958":53643},[],{"_3475":71711,"_30304":71623,"_20976":120760,"_5":14428,"_27536":120520,"_2958":120761},[],"Token de sesión (con `auth_method=static`).",{"_3475":71712,"_30304":71623,"_20976":120763,"_5":14428,"_27536":120520,"_2958":53649},[],{"_3475":71713,"_30304":71623,"_20976":120765,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71714,"_30304":71623,"_20976":120767,"_5":14428,"_27536":120520,"_2958":120768},[],"Solo con `auth_method=role`",{"_3475":71715,"_30304":71623,"_20976":120770,"_5":14428,"_27536":120520,"_2958":120771},[],"ARN del rol a asumir.",{"_3475":71716,"_30304":71623,"_20976":120773,"_5":14428,"_27536":120520,"_2958":53660},[],{"_3475":71717,"_30304":71623,"_20976":120775,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71718,"_30304":71623,"_20976":120777,"_5":14428,"_27536":120520,"_2958":53643},[],{"_3475":71719,"_30304":71623,"_20976":120779,"_5":14428,"_27536":120520,"_2958":120780},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3475":71720,"_30304":71623,"_20976":120782,"_5":14428,"_27536":120520,"_2958":53670},[],{"_3475":71721,"_30304":71623,"_20976":120784,"_5":14428,"_27536":120520,"_2958":90050},[],{"_3475":71722,"_30304":71623,"_20976":120786,"_5":14428,"_27536":120520,"_2958":120712},[],{"_3475":71723,"_30304":71623,"_20976":120788,"_5":14428,"_27536":120520,"_2958":120789},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3475":71724,"_30304":71623,"_20976":120791,"_5":14428,"_27536":120520,"_2958":53680},[],{"_3475":71725,"_30304":71623,"_20976":120793,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71726,"_30304":71623,"_20976":120795,"_5":14428,"_27536":120520,"_2958":120712},[],{"_3475":71727,"_30304":71623,"_20976":120797,"_5":14428,"_27536":120520,"_2958":120798},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3475":71728,"_30304":71623,"_20976":120800,"_5":14428,"_27536":120520,"_2958":53690},[],{"_3475":71729,"_30304":71623,"_20976":120802,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71730,"_30304":71623,"_20976":120804,"_5":14428,"_27536":120520,"_2958":120712},[],{"_3475":71731,"_30304":71623,"_20976":120806,"_5":14428,"_27536":120520,"_2958":120807},[],"URL HTTP del Device Manager de Lamassu.",{"_3475":71732,"_30304":71623,"_20976":120809,"_5":14428,"_27536":120520,"_2958":53700},[],{"_3475":71733,"_30304":71623,"_20976":120811,"_5":14428,"_27536":120520,"_2958":25085},[],{"_3475":71734,"_30304":71623,"_20976":120813,"_5":14428,"_27536":120520,"_2958":120712},[],{"_3475":71735,"_30304":71623,"_20976":120815,"_5":14428,"_27536":120520,"_2958":120816},[],"URL HTTP del servicio de CA de Lamassu.",{"_3475":71736,"_30304":71623,"_20976":120818,"_5":14428,"_27536":120524,"_2958":120819},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3475":71737,"_30304":71623,"_20976":120821,"_5":14428,"_27536":120524,"_2958":120822},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3475":71738,"_30304":71623,"_20976":120824,"_5":14428,"_27536":120524,"_2958":120825},[],"Tipo de CloudEvent",{"_3475":71739,"_30304":71623,"_20976":120827,"_5":14428,"_27536":120524,"_2958":120828},[],"Recurso en Lamassu",{"_3475":71740,"_30304":71623,"_20976":120830,"_5":14428,"_27536":120524,"_2958":120831},[],"Recurso AWS",{"_3475":71741,"_30304":71623,"_20976":120833,"_5":14428,"_27536":120524,"_2958":120834},[],"Acciones IAM",{"_3475":71742,"_30304":71623,"_20976":120836,"_5":14428,"_27536":120524,"_2958":120837},[],"Llamadas AWS y efecto",{"_3475":71743,"_30304":71623,"_20976":120839,"_5":14428,"_27536":120524,"_2958":120840},[],"Dónde en esta página",{"_3475":71744,"_30304":71623,"_20976":120842,"_5":14428,"_27536":120524,"_2958":53734},[],{"_3475":71745,"_30304":71623,"_20976":120844,"_5":14428,"_27536":120524,"_2958":53737},[],{"_3475":71746,"_30304":71623,"_20976":120846,"_5":14428,"_27536":120524,"_2958":53740},[],{"_3475":71747,"_30304":71623,"_20976":120848,"_5":14428,"_27536":120524,"_2958":53743},[],{"_3475":71748,"_30304":71623,"_20976":120850,"_5":14428,"_27536":120524,"_2958":120851},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3475":71749,"_30304":71623,"_20976":120853,"_5":14428,"_27536":120524,"_2958":120537},[],{"_3475":71750,"_30304":71623,"_20976":120855,"_5":14428,"_27536":120524,"_2958":53751},[],{"_3475":71751,"_30304":71623,"_20976":120857,"_5":14428,"_27536":120524,"_2958":53754},[],{"_3475":71752,"_30304":71623,"_20976":120859,"_5":14428,"_27536":120524,"_2958":53757},[],{"_3475":71753,"_30304":71623,"_20976":120861,"_5":14428,"_27536":120524,"_2958":53760},[],{"_3475":71754,"_30304":71623,"_20976":120863,"_5":14428,"_27536":120524,"_2958":120864},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3475":71755,"_30304":71623,"_20976":120866,"_5":14428,"_27536":120524,"_2958":120563},[],{"_3475":71756,"_30304":71623,"_20976":120868,"_5":14428,"_27536":120524,"_2958":53768},[],{"_3475":71757,"_30304":71623,"_20976":120870,"_5":14428,"_27536":120524,"_2958":120871},[],"Dispositivo",{"_3475":71758,"_30304":71623,"_20976":120873,"_5":14428,"_27536":120524,"_2958":53774},[],{"_3475":71759,"_30304":71623,"_20976":120875,"_5":14428,"_27536":120524,"_2958":53777},[],{"_3475":71760,"_30304":71623,"_20976":120877,"_5":14428,"_27536":120524,"_2958":120878},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3475":71761,"_30304":71623,"_20976":120880,"_5":14428,"_27536":120524,"_2958":120571},[],{"_3475":71762,"_30304":71623,"_20976":120882,"_5":14428,"_27536":120524,"_2958":53785},[],{"_3475":71763,"_30304":71623,"_20976":120884,"_5":14428,"_27536":120524,"_2958":120885},[],"Certificado",{"_3475":71764,"_30304":71623,"_20976":120887,"_5":14428,"_27536":120524,"_2958":53791},[],{"_3475":71765,"_30304":71623,"_20976":120889,"_5":14428,"_27536":120524,"_2958":120890},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3475":71766,"_30304":71623,"_20976":120892,"_5":14428,"_27536":120524,"_2958":120893},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3475":71767,"_30304":71623,"_20976":120895,"_5":14428,"_27536":120524,"_2958":120583},[],{"_3475":71768,"_30304":71623,"_20976":120897,"_5":14428,"_27536":120524,"_2958":53802},[],{"_3475":71769,"_30304":71623,"_20976":120899,"_5":14428,"_27536":120524,"_2958":120900},[],"Certificado / Dispositivo",{"_3475":71770,"_30304":71623,"_20976":120902,"_5":14428,"_27536":120524,"_2958":53808},[],{"_3475":71771,"_30304":71623,"_20976":120904,"_5":14428,"_27536":120524,"_2958":49808},[],{"_3475":71772,"_30304":71623,"_20976":120906,"_5":14428,"_27536":120524,"_2958":120907},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3475":71773,"_30304":71623,"_20976":120909,"_5":14428,"_27536":120524,"_2958":120591},[],{"_3475":71774,"_30304":71623,"_20976":120911,"_5":14428,"_27536":120528,"_2958":120912},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3475":71775,"_30304":71623,"_20976":120914,"_5":14428,"_27536":120532,"_2958":120915},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3475":71776,"_30304":71623,"_20976":120917,"_5":14428,"_27536":120532,"_2958":120918},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3475":71777,"_30304":71623,"_20976":120920,"_5":14428,"_27536":120536,"_2958":120921},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3475":71778,"_30304":71623,"_20976":120923,"_5":14428,"_27536":120536,"_2958":120924},[],"Transición",{"_3475":71779,"_30304":71623,"_20976":120926,"_5":14428,"_27536":120536,"_2958":120927},[],"Llamadas AWS",{"_3475":71780,"_30304":71623,"_20976":120929,"_5":14428,"_27536":120536,"_2958":120930},[],"`NoRegistrada` → `Solicitada`",{"_3475":71781,"_30304":71623,"_20976":120932,"_5":14428,"_27536":120536,"_2958":120933},[],"ninguna (solo escritura de metadatos)",{"_3475":71782,"_30304":71623,"_20976":120935,"_5":14428,"_27536":120536,"_2958":120936},[],"`Solicitada` → `Registrando`",{"_3475":71783,"_30304":71623,"_20976":120938,"_5":14428,"_27536":120536,"_2958":120939},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3475":71784,"_30304":71623,"_20976":120941,"_5":14428,"_27536":120536,"_2958":120942},[],"`Registrando` → `Completada`",{"_3475":71785,"_30304":71623,"_20976":120944,"_5":14428,"_27536":120536,"_2958":120945},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3475":71786,"_30304":71623,"_20976":120947,"_5":14428,"_27536":120536,"_2958":120948},[],"`Registrando` → `Fallida`",{"_3475":71787,"_30304":71623,"_20976":120950,"_5":14428,"_27536":120536,"_2958":120951},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3475":71788,"_30304":71623,"_20976":120953,"_5":14428,"_27536":120536,"_2958":120954},[],"`Fallida` / `Completada` → `Solicitada`",{"_3475":71789,"_30304":71623,"_20976":120956,"_5":14428,"_27536":120536,"_2958":120957},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3475":71790,"_30304":71623,"_20976":120959,"_5":14428,"_27536":120540,"_2958":120960},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3475":71791,"_30304":71623,"_20976":120962,"_5":14428,"_27536":120540,"_2958":120963},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3475":71792,"_30304":71623,"_20976":120965,"_5":14428,"_27536":120540,"_2958":120966},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3475":71793,"_30304":71623,"_20976":120968,"_5":14428,"_27536":120540,"_2958":120969},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3475":71794,"_30304":71623,"_20976":120971,"_5":14428,"_27536":120540,"_2958":120972},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3475":71795,"_30304":71623,"_20976":120974,"_5":14428,"_27536":120540,"_2958":120975},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3475":71796,"_30304":71623,"_20976":120977,"_5":14428,"_27536":120543,"_2958":120978},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3475":71797,"_30304":71623,"_20976":120980,"_5":14428,"_27536":120546,"_2958":120981},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3475":71798,"_30304":71623,"_20976":120983,"_5":14428,"_27536":120546,"_2958":120984},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3475":71799,"_30304":71623,"_20976":120986,"_5":14428,"_27536":120550,"_2958":120987},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3475":71800,"_30304":71623,"_20976":120989,"_5":14428,"_27536":120554,"_2958":120990},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3475":71801,"_30304":71623,"_20976":120992,"_5":14428,"_27536":120554,"_2958":120993},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3475":71802,"_30304":71623,"_20976":120995,"_5":14428,"_27536":120554,"_2958":120996},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3475":71803,"_30304":71623,"_20976":120998,"_5":14428,"_27536":120554,"_2958":120999},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3475":71804,"_30304":71623,"_20976":121001,"_5":14428,"_27536":120554,"_2958":121002},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3475":71805,"_30304":71623,"_20976":121004,"_5":14428,"_27536":120554,"_2958":121005},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3475":71806,"_30304":71623,"_20976":121007,"_5":14428,"_27536":120558,"_2958":121008},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3475":71807,"_30304":71623,"_20976":121010,"_5":14428,"_27536":120558,"_2958":121011},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3475":71808,"_30304":71623,"_20976":121013,"_5":14428,"_27536":120558,"_2958":121014},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3475":71809,"_30304":71623,"_20976":121016,"_5":14428,"_27536":120558,"_2958":121017},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3475":71810,"_30304":71623,"_20976":121019,"_5":14428,"_27536":120558,"_2958":121020},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3475":71811,"_30304":71623,"_20976":121022,"_5":14428,"_27536":120562,"_2958":121023},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3475":71812,"_30304":71623,"_20976":121025,"_5":14428,"_27536":120562,"_2958":120924},[],{"_3475":71813,"_30304":71623,"_20976":121027,"_5":14428,"_27536":120562,"_2958":120927},[],{"_3475":71814,"_30304":71623,"_20976":121029,"_5":14428,"_27536":120562,"_2958":121030},[],"`SinConfigurar` → `None` / `Auto`",{"_3475":71815,"_30304":71623,"_20976":121032,"_5":14428,"_27536":120562,"_2958":121033},[],"ninguna (solo configuración)",{"_3475":71816,"_30304":71623,"_20976":121035,"_5":14428,"_27536":120562,"_2958":53945},[],{"_3475":71817,"_30304":71623,"_20976":121037,"_5":14428,"_27536":120562,"_2958":121033},[],{"_3475":71818,"_30304":71623,"_20976":121039,"_5":14428,"_27536":120562,"_2958":121040},[],"Cualquiera → `Jitp`",{"_3475":71819,"_30304":71623,"_20976":121042,"_5":14428,"_27536":120562,"_2958":121043},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3475":71820,"_30304":71623,"_20976":121045,"_5":14428,"_27536":120562,"_2958":53956},[],{"_3475":71821,"_30304":71623,"_20976":121047,"_5":14428,"_27536":120562,"_2958":121048},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3475":71822,"_30304":71623,"_20976":121050,"_5":14428,"_27536":120566,"_2958":121051},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3475":71823,"_30304":71623,"_20976":121053,"_5":14428,"_27536":120566,"_2958":121054},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3475":71824,"_30304":71623,"_20976":121056,"_5":14428,"_27536":120566,"_2958":121057},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3475":71825,"_30304":71623,"_20976":121059,"_5":14428,"_27536":120570,"_2958":121060},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3475":71826,"_30304":71623,"_20976":121062,"_5":14428,"_27536":120570,"_2958":120924},[],{"_3475":71827,"_30304":71623,"_20976":121064,"_5":14428,"_27536":120570,"_2958":120927},[],{"_3475":71828,"_30304":71623,"_20976":121066,"_5":14428,"_27536":120570,"_2958":121067},[],"`Ausente` → `Aprovisionado`",{"_3475":71829,"_30304":71623,"_20976":121069,"_5":14428,"_27536":120570,"_2958":121070},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3475":71830,"_30304":71623,"_20976":121072,"_5":14428,"_27536":120570,"_2958":121073},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3475":71831,"_30304":71623,"_20976":121075,"_5":14428,"_27536":120570,"_2958":121076},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3475":71832,"_30304":71623,"_20976":121078,"_5":14428,"_27536":120570,"_2958":121079},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3475":71833,"_30304":71623,"_20976":121081,"_5":14428,"_27536":120574,"_2958":121082},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3475":71834,"_30304":71623,"_20976":121084,"_5":14428,"_27536":120574,"_2958":121085},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3475":71835,"_30304":71623,"_20976":121087,"_5":14428,"_27536":120574,"_2958":121088},[],"Para que el flujo JITP funcione correctamente:",{"_3475":71836,"_30304":71623,"_20976":121090,"_5":14428,"_27536":120574,"_2958":121091},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3475":71837,"_30304":71623,"_20976":121093,"_5":14428,"_27536":120574,"_2958":121094},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3475":71838,"_30304":71623,"_20976":121096,"_5":14428,"_27536":120574,"_2958":121097},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3475":71839,"_30304":71623,"_20976":121099,"_5":14428,"_27536":120574,"_2958":121100},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3475":71840,"_30304":71623,"_20976":121102,"_5":14428,"_27536":120578,"_2958":121103},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3475":71841,"_30304":71623,"_20976":121105,"_5":14428,"_27536":120578,"_2958":121106},[],"Estado en Lamassu",{"_3475":71842,"_30304":71623,"_20976":121108,"_5":14428,"_27536":120578,"_2958":121109},[],"Razón de revocación",{"_3475":71843,"_30304":71623,"_20976":121111,"_5":14428,"_27536":120578,"_2958":121112},[],"Estado en AWS IoT Core",{"_3475":71844,"_30304":71623,"_20976":121114,"_5":14428,"_27536":120578,"_2958":54026},[],{"_3475":71845,"_30304":71623,"_20976":121116,"_5":14428,"_27536":120578,"_2958":121117},[],"Ninguna",{"_3475":71846,"_30304":71623,"_20976":121119,"_5":14428,"_27536":120578,"_2958":54032},[],{"_3475":71847,"_30304":71623,"_20976":121121,"_5":14428,"_27536":120578,"_2958":54035},[],{"_3475":71848,"_30304":71623,"_20976":121123,"_5":14428,"_27536":120578,"_2958":54038},[],{"_3475":71849,"_30304":71623,"_20976":121125,"_5":14428,"_27536":120578,"_2958":54041},[],{"_3475":71850,"_30304":71623,"_20976":121127,"_5":14428,"_27536":120578,"_2958":54035},[],{"_3475":71851,"_30304":71623,"_20976":121129,"_5":14428,"_27536":120578,"_2958":121130},[],"Cualquier otra razón",{"_3475":71852,"_30304":71623,"_20976":121132,"_5":14428,"_27536":120578,"_2958":54049},[],{"_3475":71853,"_30304":71623,"_20976":121134,"_5":14428,"_27536":120578,"_2958":121135},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3475":71854,"_30304":71623,"_20976":121137,"_5":14428,"_27536":120582,"_2958":121138},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3475":71855,"_30304":71623,"_20976":121140,"_5":14428,"_27536":120582,"_2958":120924},[],{"_3475":71856,"_30304":71623,"_20976":121142,"_5":14428,"_27536":120582,"_2958":120927},[],{"_3475":71857,"_30304":71623,"_20976":121144,"_5":14428,"_27536":120582,"_2958":121145},[],"`NoSincronizado` → `Active`",{"_3475":71858,"_30304":71623,"_20976":121147,"_5":14428,"_27536":120582,"_2958":53541},[],{"_3475":71859,"_30304":71623,"_20976":121149,"_5":14428,"_27536":120582,"_2958":54067},[],{"_3475":71860,"_30304":71623,"_20976":121151,"_5":14428,"_27536":120582,"_2958":121152},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3475":71861,"_30304":71623,"_20976":121154,"_5":14428,"_27536":120582,"_2958":54073},[],{"_3475":71862,"_30304":71623,"_20976":121156,"_5":14428,"_27536":120582,"_2958":121152},[],{"_3475":71863,"_30304":71623,"_20976":121158,"_5":14428,"_27536":120582,"_2958":54078},[],{"_3475":71864,"_30304":71623,"_20976":121160,"_5":14428,"_27536":120582,"_2958":53541},[],{"_3475":71865,"_30304":71623,"_20976":121162,"_5":14428,"_27536":120582,"_2958":54083},[],{"_3475":71866,"_30304":71623,"_20976":121164,"_5":14428,"_27536":120582,"_2958":121165},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3475":71867,"_30304":71623,"_20976":121167,"_5":14428,"_27536":120586,"_2958":121168},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3475":71868,"_30304":71623,"_20976":121170,"_5":14428,"_27536":120586,"_2958":121171},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3475":71869,"_30304":71623,"_20976":121173,"_5":14428,"_27536":120586,"_2958":121174},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3475":71870,"_30304":71623,"_20976":121176,"_5":14428,"_27536":120590,"_2958":121177},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3475":71871,"_30304":71623,"_20976":121179,"_5":14428,"_27536":120590,"_2958":121180},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3475":71872,"_30304":71623,"_20976":121182,"_5":14428,"_27536":120594,"_2958":121183},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3475":71873,"_30304":71623,"_20976":121185,"_5":14428,"_27536":120594,"_2958":121186},[],"Existen dos tipos de acciones:",{"_3475":71874,"_30304":71623,"_20976":121188,"_5":14428,"_27536":120594,"_2958":121189},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3475":71875,"_30304":71623,"_20976":121191,"_5":14428,"_27536":120594,"_2958":121192},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3475":71876,"_30304":71623,"_20976":121194,"_5":14428,"_27536":120594,"_2958":121195},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3475":71877,"_30304":71623,"_20976":121197,"_5":14428,"_27536":120598,"_2958":121198},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3475":71878,"_30304":71623,"_20976":121200,"_5":14428,"_27536":120598,"_2958":121201},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3475":71879,"_30304":71623,"_20976":121203,"_5":14428,"_27536":120598,"_2958":121204},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3475":71880,"_30304":71623,"_20976":121206,"_5":14428,"_27536":120602,"_2958":121207},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3475":71881,"_30304":71623,"_20976":121209,"_5":14428,"_27536":120602,"_2958":121210},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3475":71882,"_30304":71623,"_20976":121212,"_5":14428,"_27536":120602,"_2958":121213},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3475":71883,"_30304":71623,"_20976":121215,"_5":14428,"_27536":120602,"_2958":121216},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3475":71884,"_30304":71623,"_20976":121218,"_5":14428,"_27536":120602,"_2958":121219},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3475":71885,"_30304":71623,"_20976":121221,"_5":14428,"_27536":120602,"_2958":121222},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3475":71886,"_30304":71623,"_20976":121224,"_5":14428,"_27536":120602,"_2958":121225},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3475":71887,"_30304":71623,"_20976":121227,"_5":14428,"_27536":120602,"_2958":121228},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3475":71888,"_30304":71623,"_20976":121230,"_5":14428,"_27536":120602,"_2958":121231},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3475":71889,"_30304":71623,"_20976":121233,"_5":14428,"_27536":120602,"_2958":121234},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3475":71890,"_30304":71623,"_20976":121236,"_5":14428,"_27536":120602,"_2958":121237},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3475":71891,"_30304":71623,"_20976":121239,"_5":14428,"_27536":120602,"_2958":121240},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3475":71892,"_30304":71623,"_20976":121242,"_5":14428,"_27536":120602,"_2958":121243},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3475":71893,"_30304":71623,"_20976":121245,"_5":14428,"_27536":120602,"_2958":121246},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3475":71894,"_30304":71623,"_20976":121248,"_5":14428,"_27536":120602,"_2958":121249},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3475":71895,"_30304":71623,"_20976":121251,"_5":14428,"_27536":120602,"_2958":121252},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3475":71896,"_30304":71623,"_20976":121254,"_5":14428,"_27536":120602,"_2958":121255},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3475":71897,"_30304":71623,"_20976":121257,"_5":14428,"_27536":120602,"_2958":121258},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3475":71898,"_30304":71623,"_20976":121260,"_5":14428,"_27536":120602,"_2958":121261},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3475":71899,"_30304":71623,"_20976":121263,"_5":14428,"_27536":120602,"_2958":121264},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3475":71900,"_30304":71623,"_20976":121266,"_5":14428,"_27536":120602,"_2958":121267},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3475":71901,"_30304":71623,"_20976":121269,"_5":14428,"_27536":120602,"_2958":121270},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":71902,"_30304":71623,"_20976":121272,"_5":14428,"_27536":120602,"_2958":121273},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3475":71903,"_30304":71623,"_20976":121275,"_5":14428,"_27536":120602,"_2958":121276},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3475":71904,"_30304":71904,"_5":14780,"_2958":51904,"_30657":121278,"_20976":121279,"_27536":71904},[49412,118079,51904],[],{"_3475":71905,"_30304":71904,"_20976":121281,"_5":14428,"_27536":71904,"_2958":121282},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3475":71906,"_30304":71904,"_5":30654,"_20976":121284,"_27536":121285,"_2958":121286},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3475":71907,"_30304":71904,"_5":30654,"_20976":121288,"_27536":121289,"_2958":119094},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3475":71908,"_30304":71904,"_5":30654,"_20976":121291,"_27536":121292,"_2958":119269},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3475":71909,"_30304":71904,"_5":30654,"_20976":121294,"_27536":121295,"_2958":120501},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/overview#integraciones",{"_3475":71910,"_30304":71904,"_5":30654,"_20976":121297,"_27536":121298,"_2958":121299},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3475":71911,"_30304":71904,"_20976":121301,"_5":14428,"_27536":71904,"_2958":121302},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3475":71912,"_30304":71904,"_20976":121304,"_5":14428,"_27536":121285,"_2958":121305},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3475":71913,"_30304":71904,"_20976":121307,"_5":14428,"_27536":121285,"_2958":121308},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3475":71914,"_30304":71904,"_20976":121310,"_5":14428,"_27536":121289,"_2958":121311},[],"Recurso",{"_3475":71915,"_30304":71904,"_20976":121313,"_5":14428,"_27536":121289,"_2958":121314},[],"Qué representa",{"_3475":71916,"_30304":71904,"_20976":121316,"_5":14428,"_27536":121289,"_2958":121317},[],"**Dispositivo**",{"_3475":71917,"_30304":71904,"_20976":121319,"_5":14428,"_27536":121289,"_2958":121320},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3475":71918,"_30304":71904,"_20976":121322,"_5":14428,"_27536":121289,"_2958":121323},[],"**Identidad**",{"_3475":71919,"_30304":71904,"_20976":121325,"_5":14428,"_27536":121289,"_2958":121326},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3475":71920,"_30304":71904,"_20976":121328,"_5":14428,"_27536":121289,"_2958":54250},[],{"_3475":71921,"_30304":71904,"_20976":121330,"_5":14428,"_27536":121289,"_2958":121331},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3475":71922,"_30304":71904,"_20976":121333,"_5":14428,"_27536":121289,"_2958":121334},[],"**Flota**",{"_3475":71923,"_30304":71904,"_20976":121336,"_5":14428,"_27536":121289,"_2958":121337},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3475":71924,"_30304":71904,"_20976":121339,"_5":14428,"_27536":121289,"_2958":121340},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3475":71925,"_30304":71904,"_20976":121342,"_5":14428,"_27536":121289,"_2958":121343},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3475":71926,"_30304":71904,"_20976":121345,"_5":14428,"_27536":121292,"_2958":121346},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3475":71927,"_30304":71904,"_20976":121348,"_5":14428,"_27536":121292,"_2958":121349},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3475":71928,"_30304":71904,"_20976":121351,"_5":14428,"_27536":121292,"_2958":121352},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3475":71929,"_30304":71904,"_20976":121354,"_5":14428,"_27536":121292,"_2958":121355},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3475":71930,"_30304":71904,"_20976":121357,"_5":14428,"_27536":121292,"_2958":121358},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3475":71931,"_30304":71904,"_20976":121360,"_5":14428,"_27536":121292,"_2958":121361},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3475":71932,"_30304":71904,"_20976":121363,"_5":14428,"_27536":121292,"_2958":121364},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":71933,"_30304":71904,"_20976":121366,"_5":14428,"_27536":121292,"_2958":121367},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3475":71934,"_30304":71904,"_20976":121369,"_5":14428,"_27536":121295,"_2958":121370},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3475":71935,"_30304":71904,"_20976":121372,"_5":14428,"_27536":121295,"_2958":121373},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3475":71936,"_30304":71904,"_20976":121375,"_5":14428,"_27536":121298,"_2958":121376},[],"Participante",{"_3475":71937,"_30304":71904,"_20976":121378,"_5":14428,"_27536":121298,"_2958":121379},[],"Responsabilidad",{"_3475":71938,"_30304":71904,"_20976":121381,"_5":14428,"_27536":121298,"_2958":121382},[],"Administrador PKI",{"_3475":71939,"_30304":71904,"_20976":121384,"_5":14428,"_27536":121298,"_2958":121385},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3475":71940,"_30304":71904,"_20976":121387,"_5":14428,"_27536":121298,"_2958":121388},[],"Administrador del aprovisionamiento",{"_3475":71941,"_30304":71904,"_20976":121390,"_5":14428,"_27536":121298,"_2958":121391},[],"DMS, admisión, autenticación por operación e inventario.",{"_3475":71942,"_30304":71904,"_20976":121393,"_5":14428,"_27536":121298,"_2958":121394},[],"Integrador del dispositivo",{"_3475":71943,"_30304":71904,"_20976":121396,"_5":14428,"_27536":121298,"_2958":121397},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3475":71944,"_30304":71904,"_20976":121399,"_5":14428,"_27536":121298,"_2958":121400},[],"Integrador del consumidor",{"_3475":71945,"_30304":71904,"_20976":121402,"_5":14428,"_27536":121298,"_2958":121403},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3475":71946,"_30304":71904,"_20976":121405,"_5":14428,"_27536":121298,"_2958":121406},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3475":71947,"_30304":71947,"_5":14780,"_2958":121408,"_30657":121409,"_20976":121411,"_27536":71947},"Enrola y conecta tu primer dispositivo",[49412,118079,51904,121410],"Primeros pasos",[],{"_3475":71948,"_30304":71947,"_20976":121413,"_5":14428,"_27536":71947,"_2958":121414},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3475":71949,"_30304":71947,"_5":30654,"_20976":121416,"_27536":121417,"_2958":116650},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3475":71950,"_30304":71947,"_5":30654,"_20976":121419,"_27536":121420,"_2958":121421},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3475":71951,"_30304":71947,"_5":30654,"_20976":121423,"_27536":121424,"_2958":121425},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3475":71952,"_30304":71947,"_5":30654,"_20976":121427,"_27536":121428,"_2958":121429},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3475":71953,"_30304":71947,"_5":30654,"_20976":121431,"_27536":121432,"_2958":121433},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3475":71954,"_30304":71947,"_5":30654,"_20976":121435,"_27536":121436,"_2958":121437},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3475":71955,"_30304":71947,"_5":30654,"_20976":121439,"_27536":121440,"_2958":121441},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3475":71956,"_30304":71947,"_5":30654,"_20976":121443,"_27536":121444,"_2958":121445},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3475":71957,"_30304":71947,"_20976":121447,"_5":14428,"_27536":71947,"_2958":121448},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3475":71958,"_30304":71947,"_20976":121450,"_5":14428,"_27536":121417,"_2958":121451},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3475":71959,"_30304":71947,"_20976":121453,"_5":14428,"_27536":121417,"_2958":121454},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3475":71960,"_30304":71947,"_20976":121456,"_5":14428,"_27536":121417,"_2958":121457},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3475":71961,"_30304":71947,"_20976":121459,"_5":14428,"_27536":121417,"_2958":121460},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3475":71962,"_30304":71947,"_20976":121462,"_5":14428,"_27536":121417,"_2958":121463},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3475":71963,"_30304":71947,"_20976":121465,"_5":14428,"_27536":121420,"_2958":121466},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3475":71964,"_30304":71947,"_20976":121468,"_5":14428,"_27536":121420,"_2958":121469},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3475":71965,"_30304":71947,"_20976":121471,"_5":14428,"_27536":121424,"_2958":121472},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3475":71966,"_30304":71947,"_20976":121474,"_5":14428,"_27536":121424,"_2958":121475},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3475":71967,"_30304":71947,"_20976":121477,"_5":14428,"_27536":121424,"_2958":121478},[],"Ajuste",{"_3475":71968,"_30304":71947,"_20976":121480,"_5":14428,"_27536":121424,"_2958":121481},[],"Valor de evaluación",{"_3475":71969,"_30304":71947,"_20976":121483,"_5":14428,"_27536":121424,"_2958":54406},[],{"_3475":71970,"_30304":71947,"_20976":121485,"_5":14428,"_27536":121424,"_2958":121486},[],"Raíz emisora de `device-root.pem`.",{"_3475":71971,"_30304":71947,"_20976":121488,"_5":14428,"_27536":121424,"_2958":119397},[],{"_3475":71972,"_30304":71947,"_20976":121490,"_5":14428,"_27536":121424,"_2958":121491},[],"Perfil final de 1 hora que acabas de preparar.",{"_3475":71973,"_30304":71947,"_20976":121493,"_5":14428,"_27536":121424,"_2958":54417},[],{"_3475":71974,"_30304":71947,"_20976":121495,"_5":14428,"_27536":121424,"_2958":54420},[],{"_3475":71975,"_30304":71947,"_20976":121497,"_5":14428,"_27536":121424,"_2958":54423},[],{"_3475":71976,"_30304":71947,"_20976":121499,"_5":14428,"_27536":121424,"_2958":121500},[],"Habilitado.",{"_3475":71977,"_30304":71947,"_20976":121502,"_5":14428,"_27536":121424,"_2958":54429},[],{"_3475":71978,"_30304":71947,"_20976":121504,"_5":14428,"_27536":121424,"_2958":121505},[],"Deshabilitado; el ID debe ser nuevo.",{"_3475":71979,"_30304":71947,"_20976":121507,"_5":14428,"_27536":121424,"_2958":121508},[],"Autenticación inicial",{"_3475":71980,"_30304":71947,"_20976":121510,"_5":14428,"_27536":121424,"_2958":121511},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3475":71981,"_30304":71947,"_20976":121513,"_5":14428,"_27536":121424,"_2958":121514},[],"Autenticación de renovación",{"_3475":71982,"_30304":71947,"_20976":121516,"_5":14428,"_27536":121424,"_2958":121517},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3475":71983,"_30304":71947,"_20976":121519,"_5":14428,"_27536":121424,"_2958":54447},[],{"_3475":71984,"_30304":71947,"_20976":121521,"_5":14428,"_27536":121424,"_2958":121522},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3475":71985,"_30304":71947,"_20976":121524,"_5":14428,"_27536":121424,"_2958":54453},[],{"_3475":71986,"_30304":71947,"_20976":121526,"_5":14428,"_27536":121424,"_2958":121527},[],"1 hora.",{"_3475":71987,"_30304":71947,"_20976":121529,"_5":14428,"_27536":121424,"_2958":54459},[],{"_3475":71988,"_30304":71947,"_20976":121531,"_5":14428,"_27536":121424,"_2958":121532},[],"30 minutos / 10 minutos.",{"_3475":71989,"_30304":71947,"_20976":121534,"_5":14428,"_27536":121424,"_2958":54465},[],{"_3475":71990,"_30304":71947,"_20976":121536,"_5":14428,"_27536":121424,"_2958":121537},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3475":71991,"_30304":71947,"_20976":121539,"_5":14428,"_27536":121424,"_2958":52223},[],{"_3475":71992,"_30304":71947,"_20976":121541,"_5":14428,"_27536":121424,"_2958":121542},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3475":71993,"_30304":71947,"_20976":121544,"_5":14428,"_27536":121424,"_2958":54476},[],{"_3475":71994,"_30304":71947,"_20976":121546,"_5":14428,"_27536":121424,"_2958":121547},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3475":71995,"_30304":71947,"_20976":121549,"_5":14428,"_27536":121424,"_2958":121550},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3475":71996,"_30304":71947,"_20976":121552,"_5":14428,"_27536":121428,"_2958":121553},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3475":71997,"_30304":71947,"_20976":121555,"_5":14428,"_27536":121428,"_2958":121556},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3475":71998,"_30304":71947,"_20976":121558,"_5":14428,"_27536":121432,"_2958":121559},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3475":71999,"_30304":71947,"_20976":121561,"_5":14428,"_27536":121432,"_2958":121562},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3475":72000,"_30304":71947,"_20976":121564,"_5":14428,"_27536":121432,"_2958":121565},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3475":72001,"_30304":71947,"_20976":121567,"_5":14428,"_27536":121436,"_2958":121568},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3475":72002,"_30304":71947,"_20976":121570,"_5":14428,"_27536":121436,"_2958":121571},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3475":72003,"_30304":71947,"_20976":121573,"_5":14428,"_27536":121440,"_2958":121574},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3475":72004,"_30304":71947,"_20976":121576,"_5":14428,"_27536":121440,"_2958":121577},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3475":72005,"_30304":71947,"_20976":121579,"_5":14428,"_27536":121440,"_2958":121580},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3475":72006,"_30304":71947,"_20976":121582,"_5":14428,"_27536":121440,"_2958":121583},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3475":72007,"_30304":71947,"_20976":121585,"_5":14428,"_27536":121440,"_2958":121586},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3475":72008,"_30304":71947,"_20976":121588,"_5":14428,"_27536":121444,"_2958":121589},[],"Comprobación",{"_3475":72009,"_30304":71947,"_20976":121591,"_5":14428,"_27536":121444,"_2958":121592},[],"Resultado esperado",{"_3475":72010,"_30304":71947,"_20976":121594,"_5":14428,"_27536":121444,"_2958":121595},[],"Registro",{"_3475":72011,"_30304":71947,"_20976":121597,"_5":14428,"_27536":121444,"_2958":121598},[],"ID creado automáticamente y DMS correcto.",{"_3475":72012,"_30304":71947,"_20976":121600,"_5":14428,"_27536":121444,"_2958":120885},[],{"_3475":72013,"_30304":71947,"_20976":121602,"_5":14428,"_27536":121444,"_2958":121603},[],"CN, perfil, serie y clave verificados.",{"_3475":72014,"_30304":71947,"_20976":121605,"_5":14428,"_27536":121444,"_2958":121606},[],"Inventario",{"_3475":72015,"_30304":71947,"_20976":121608,"_5":14428,"_27536":121444,"_2958":121609},[],"Serie recibida visible como identidad actual y en el historial.",{"_3475":72016,"_30304":71947,"_20976":121611,"_5":14428,"_27536":121444,"_2958":121612},[],"Consumidor",{"_3475":72017,"_30304":71947,"_20976":121614,"_5":14428,"_27536":121444,"_2958":121615},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3475":72018,"_30304":71947,"_20976":121617,"_5":14428,"_27536":121444,"_2958":121618},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3475":72019,"_30304":71947,"_20976":121620,"_5":14428,"_27536":121444,"_2958":121621},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3475":72020,"_30304":72020,"_5":14780,"_2958":119111,"_30657":121623,"_20976":121624,"_27536":72020},[49412,118079,51904,121410],[],{"_3475":72021,"_30304":72020,"_20976":121626,"_5":14428,"_27536":72020,"_2958":121627},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3475":72022,"_30304":72020,"_5":30654,"_20976":121629,"_27536":121630,"_2958":116650},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3475":72023,"_30304":72020,"_5":30654,"_20976":121632,"_27536":121633,"_2958":121634},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3475":72024,"_30304":72020,"_5":30654,"_20976":121636,"_27536":121637,"_2958":121638},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3475":72025,"_30304":72020,"_5":30654,"_20976":121640,"_27536":121641,"_2958":121642},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3475":72026,"_30304":72020,"_5":30654,"_20976":121644,"_27536":121645,"_2958":121646},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3475":72027,"_30304":72020,"_5":30654,"_20976":121648,"_27536":121649,"_2958":121650},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3475":72028,"_30304":72020,"_5":30654,"_20976":121652,"_27536":121653,"_2958":121592},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3475":72029,"_30304":72020,"_5":30654,"_20976":121655,"_27536":121656,"_2958":121657},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3475":72030,"_30304":72020,"_5":30654,"_20976":121659,"_27536":121660,"_2958":121661},[],"/docs/pr-preview/pr-65/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3475":72031,"_30304":72020,"_20976":121663,"_5":14428,"_27536":72020,"_2958":121664},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3475":72032,"_30304":72020,"_20976":121666,"_5":14428,"_27536":72020,"_2958":121667},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3475":72033,"_30304":72020,"_20976":121669,"_5":14428,"_27536":121630,"_2958":121670},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3475":72034,"_30304":72020,"_20976":121672,"_5":14428,"_27536":121630,"_2958":121673},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3475":72035,"_30304":72020,"_20976":121675,"_5":14428,"_27536":121630,"_2958":121676},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3475":72036,"_30304":72020,"_20976":121678,"_5":14428,"_27536":121630,"_2958":121679},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3475":72037,"_30304":72020,"_20976":121681,"_5":14428,"_27536":121633,"_2958":121682},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3475":72038,"_30304":72020,"_20976":121684,"_5":14428,"_27536":121633,"_2958":121685},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3475":72039,"_30304":72020,"_20976":121687,"_5":14428,"_27536":121633,"_2958":121688},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3475":72040,"_30304":72020,"_20976":121690,"_5":14428,"_27536":121633,"_2958":121691},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3475":72041,"_30304":72020,"_20976":121693,"_5":14428,"_27536":121633,"_2958":121694},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3475":72042,"_30304":72020,"_20976":121696,"_5":14428,"_27536":121633,"_2958":121697},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3475":72043,"_30304":72020,"_20976":121699,"_5":14428,"_27536":121633,"_2958":121700},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3475":72044,"_30304":72020,"_20976":121702,"_5":14428,"_27536":121633,"_2958":121703},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3475":72045,"_30304":72020,"_20976":121705,"_5":14428,"_27536":121637,"_2958":121706},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3475":72046,"_30304":72020,"_20976":121708,"_5":14428,"_27536":121637,"_2958":54641},[],{"_3475":72047,"_30304":72020,"_20976":121710,"_5":14428,"_27536":121637,"_2958":121711},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3475":72048,"_30304":72020,"_20976":121713,"_5":14428,"_27536":121637,"_2958":121714},[],"**Icon** y **Tags**: clasificación opcional.",{"_3475":72049,"_30304":72020,"_20976":121716,"_5":14428,"_27536":121637,"_2958":121717},[],"Confirma el registro.",{"_3475":72050,"_30304":72020,"_20976":121719,"_5":14428,"_27536":121641,"_2958":121720},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3475":72051,"_30304":72020,"_20976":121722,"_5":14428,"_27536":121641,"_2958":121723},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3475":72052,"_30304":72020,"_20976":121725,"_5":14428,"_27536":121645,"_2958":121726},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3475":72053,"_30304":72020,"_20976":121728,"_5":14428,"_27536":121645,"_2958":121729},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3475":72054,"_30304":72020,"_20976":121731,"_5":14428,"_27536":121649,"_2958":121732},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3475":72055,"_30304":72020,"_20976":121734,"_5":14428,"_27536":121649,"_2958":121735},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3475":72056,"_30304":72020,"_20976":121737,"_5":14428,"_27536":121653,"_2958":121589},[],{"_3475":72057,"_30304":72020,"_20976":121739,"_5":14428,"_27536":121653,"_2958":121740},[],"Resultado",{"_3475":72058,"_30304":72020,"_20976":121742,"_5":14428,"_27536":121653,"_2958":120871},[],{"_3475":72059,"_30304":72020,"_20976":121744,"_5":14428,"_27536":121653,"_2958":121745},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3475":72060,"_30304":72020,"_20976":121747,"_5":14428,"_27536":121653,"_2958":121748},[],"Identidad actual",{"_3475":72061,"_30304":72020,"_20976":121750,"_5":14428,"_27536":121653,"_2958":121751},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3475":72062,"_30304":72020,"_20976":121753,"_5":14428,"_27536":121653,"_2958":121754},[],"Historial",{"_3475":72063,"_30304":72020,"_20976":121756,"_5":14428,"_27536":121653,"_2958":121757},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3475":72064,"_30304":72020,"_20976":121759,"_5":14428,"_27536":121653,"_2958":121760},[],"Clave y certificado",{"_3475":72065,"_30304":72020,"_20976":121762,"_5":14428,"_27536":121653,"_2958":121763},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3475":72066,"_30304":72020,"_20976":121765,"_5":14428,"_27536":121656,"_2958":121766},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3475":72067,"_30304":72020,"_20976":121768,"_5":14428,"_27536":121656,"_2958":121769},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3475":72068,"_30304":72020,"_20976":121771,"_5":14428,"_27536":121656,"_2958":121772},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3475":72069,"_30304":72020,"_20976":121774,"_5":14428,"_27536":121656,"_2958":121775},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3475":72070,"_30304":72020,"_20976":121777,"_5":14428,"_27536":121660,"_2958":121778},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3475":72071,"_30304":72020,"_20976":121780,"_5":14428,"_27536":121660,"_2958":121781},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3475":72072,"_30304":72020,"_20976":121783,"_5":14428,"_27536":121660,"_2958":121784},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3475":72073,"_30304":72073,"_5":14780,"_2958":121786,"_30657":121787,"_20976":121788,"_27536":72073},"Plataforma Lamassu IoT",[49412,118079],[],{"_3475":72074,"_30304":72073,"_20976":121790,"_5":14428,"_27536":72073,"_2958":121791},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3475":72075,"_30304":72073,"_5":30654,"_20976":121793,"_27536":121794,"_2958":121286},[],"/docs/pr-preview/pr-65/es/platform/overview#empieza-aquí",{"_3475":72076,"_30304":72073,"_5":30654,"_20976":121796,"_27536":121797,"_2958":121798},[],"/docs/pr-preview/pr-65/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3475":72077,"_30304":72073,"_5":30654,"_20976":121800,"_27536":121801,"_2958":121802},[],"/docs/pr-preview/pr-65/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3475":72078,"_30304":72073,"_5":30654,"_20976":121804,"_27536":121805,"_2958":121806},[],"/docs/pr-preview/pr-65/es/platform/overview#capacidades-principales","Capacidades principales",{"_3475":72079,"_30304":72073,"_5":30654,"_20976":121808,"_27536":121809,"_2958":121810},[],"/docs/pr-preview/pr-65/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3475":72080,"_30304":72073,"_5":30654,"_20976":121812,"_27536":121813,"_2958":121814},[],"/docs/pr-preview/pr-65/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3475":72081,"_30304":72073,"_5":30654,"_20976":121816,"_27536":121817,"_2958":121818},[],"/docs/pr-preview/pr-65/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3475":72082,"_30304":72073,"_5":30654,"_20976":121820,"_27536":121821,"_2958":121822},[],"/docs/pr-preview/pr-65/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3475":72083,"_30304":72073,"_5":30654,"_20976":121824,"_27536":121825,"_2958":121826},[],"/docs/pr-preview/pr-65/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3475":72084,"_30304":72073,"_5":30654,"_20976":121828,"_27536":121829,"_2958":121830},[],"/docs/pr-preview/pr-65/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3475":72085,"_30304":72073,"_5":30654,"_20976":121832,"_27536":121833,"_2958":121834},[],"/docs/pr-preview/pr-65/es/platform/overview#referencia-operativa","Referencia operativa",{"_3475":72086,"_30304":72073,"_20976":121836,"_5":14428,"_27536":72073,"_2958":121837},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3475":72087,"_30304":72073,"_20976":121839,"_5":14428,"_27536":121794,"_2958":121840},[],"Elige el resultado que necesitas obtener:",{"_3475":72088,"_30304":72073,"_20976":121842,"_5":14428,"_27536":121794,"_2958":121843},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3475":72089,"_30304":72073,"_20976":121845,"_5":14428,"_27536":121794,"_2958":121846},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3475":72090,"_30304":72073,"_20976":121848,"_5":14428,"_27536":121794,"_2958":121849},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3475":72091,"_30304":72073,"_20976":121851,"_5":14428,"_27536":121797,"_2958":121852},[],"Bloque",{"_3475":72092,"_30304":72073,"_20976":121854,"_5":14428,"_27536":121797,"_2958":121855},[],"Qué gestionas",{"_3475":72093,"_30304":72073,"_20976":121857,"_5":14428,"_27536":121797,"_2958":121858},[],"Punto de entrada",{"_3475":72094,"_30304":72073,"_20976":121860,"_5":14428,"_27536":121797,"_2958":54794},[],{"_3475":72095,"_30304":72073,"_20976":121862,"_5":14428,"_27536":121797,"_2958":121863},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3475":72096,"_30304":72073,"_20976":121865,"_5":14428,"_27536":121797,"_2958":121866},[],"Visión general de PKI",{"_3475":72097,"_30304":72073,"_20976":121868,"_5":14428,"_27536":121797,"_2958":54803},[],{"_3475":72098,"_30304":72073,"_20976":121870,"_5":14428,"_27536":121797,"_2958":121871},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3475":72099,"_30304":72073,"_20976":121873,"_5":14428,"_27536":121797,"_2958":121874},[],"Visión general de IoT Fleets",{"_3475":72100,"_30304":72073,"_20976":121876,"_5":14428,"_27536":121797,"_2958":121877},[],"**Administración**",{"_3475":72101,"_30304":72073,"_20976":121879,"_5":14428,"_27536":121797,"_2958":121880},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3475":72102,"_30304":72073,"_20976":121882,"_5":14428,"_27536":121797,"_2958":118077},[],{"_3475":72103,"_30304":72073,"_20976":121884,"_5":14428,"_27536":121797,"_2958":121885},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3475":72104,"_30304":72073,"_20976":121887,"_5":14428,"_27536":121801,"_2958":121888},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3475":72105,"_30304":72073,"_20976":121890,"_5":14428,"_27536":121801,"_2958":121891},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3475":72106,"_30304":72073,"_20976":121893,"_5":14428,"_27536":121801,"_2958":121894},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3475":72107,"_30304":72073,"_20976":121896,"_5":14428,"_27536":121801,"_2958":121897},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3475":72108,"_30304":72073,"_20976":121899,"_5":14428,"_27536":121801,"_2958":121900},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3475":72109,"_30304":72073,"_20976":121902,"_5":14428,"_27536":121801,"_2958":121903},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3475":72110,"_30304":72073,"_20976":121905,"_5":14428,"_27536":121809,"_2958":121906},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3475":72111,"_30304":72073,"_20976":121908,"_5":14428,"_27536":121813,"_2958":121909},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3475":72112,"_30304":72073,"_20976":121911,"_5":14428,"_27536":121817,"_2958":121912},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3475":72113,"_30304":72073,"_20976":121914,"_5":14428,"_27536":121821,"_2958":121915},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3475":72114,"_30304":72073,"_20976":121917,"_5":14428,"_27536":121825,"_2958":121918},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3475":72115,"_30304":72073,"_20976":121920,"_5":14428,"_27536":121829,"_2958":121921},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3475":72116,"_30304":72073,"_20976":121923,"_5":14428,"_27536":121833,"_2958":121379},[],{"_3475":72117,"_30304":72073,"_20976":121925,"_5":14428,"_27536":121833,"_2958":121926},[],"Qué prepara o comprueba",{"_3475":72118,"_30304":72073,"_20976":121928,"_5":14428,"_27536":121833,"_2958":121382},[],{"_3475":72119,"_30304":72073,"_20976":121930,"_5":14428,"_27536":121833,"_2958":121931},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3475":72120,"_30304":72073,"_20976":121933,"_5":14428,"_27536":121833,"_2958":121934},[],"Administrador de la flota",{"_3475":72121,"_30304":72073,"_20976":121936,"_5":14428,"_27536":121833,"_2958":121937},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3475":72122,"_30304":72073,"_20976":121939,"_5":14428,"_27536":121833,"_2958":121394},[],{"_3475":72123,"_30304":72073,"_20976":121941,"_5":14428,"_27536":121833,"_2958":121942},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3475":72124,"_30304":72073,"_20976":121944,"_5":14428,"_27536":121833,"_2958":121400},[],{"_3475":72125,"_30304":72073,"_20976":121946,"_5":14428,"_27536":121833,"_2958":121947},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3475":72126,"_30304":72073,"_20976":121949,"_5":14428,"_27536":121833,"_2958":121950},[],"Operador de infraestructura",{"_3475":72127,"_30304":72073,"_20976":121952,"_5":14428,"_27536":121833,"_2958":121953},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3475":72128,"_30304":72073,"_20976":121955,"_5":14428,"_27536":121833,"_2958":121956},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3475":72129,"_30304":72129,"_5":14780,"_2958":121958,"_30657":121959,"_20976":121961,"_27536":72129},"Jerarquía y rotación de CAs",[49412,118079,54895,121960],"Claves, autoridades y certificados",[],{"_3475":72130,"_30304":72129,"_20976":121963,"_5":14428,"_27536":72129,"_2958":121964},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3475":72131,"_30304":72129,"_5":30654,"_20976":121966,"_27536":121967,"_2958":121968},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3475":72132,"_30304":72129,"_5":30654,"_20976":121970,"_27536":121971,"_2958":121972},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3475":72133,"_30304":72129,"_5":30654,"_20976":121974,"_27536":121975,"_2958":121976},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3475":72134,"_30304":72129,"_5":30654,"_20976":121978,"_27536":121979,"_2958":121980},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3475":72135,"_30304":72129,"_5":30654,"_20976":121982,"_27536":121983,"_2958":121984},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3475":72136,"_30304":72129,"_5":30654,"_20976":121986,"_27536":121987,"_2958":121988},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3475":72137,"_30304":72129,"_5":30654,"_20976":121990,"_27536":121991,"_2958":121992},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3475":72138,"_30304":72129,"_5":30654,"_20976":121994,"_27536":121995,"_2958":121996},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3475":72139,"_30304":72129,"_5":30654,"_20976":121998,"_27536":121999,"_2958":122000},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3475":72140,"_30304":72129,"_5":30654,"_20976":122002,"_27536":122003,"_2958":122004},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3475":72141,"_30304":72129,"_5":30654,"_20976":122006,"_27536":122007,"_2958":122008},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3475":72142,"_30304":72129,"_5":30654,"_20976":122010,"_27536":122011,"_2958":122012},[],"/docs/pr-preview/pr-65/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3475":72143,"_30304":72129,"_20976":122014,"_5":14428,"_27536":72129,"_2958":122015},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3475":72144,"_30304":72129,"_20976":122017,"_5":14428,"_27536":72129,"_2958":122018},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3475":72145,"_30304":72129,"_20976":122020,"_5":14428,"_27536":121967,"_2958":122021},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3475":72146,"_30304":72129,"_20976":122023,"_5":14428,"_27536":121967,"_2958":122024},[],"entorno, como producción y preproducción;",{"_3475":72147,"_30304":72129,"_20976":122026,"_5":14428,"_27536":121967,"_2958":122027},[],"propietario o equipo operador;",{"_3475":72148,"_30304":72129,"_20976":122029,"_5":14428,"_27536":121967,"_2958":122030},[],"familia de dispositivos o proceso de fabricación;",{"_3475":72149,"_30304":72129,"_20976":122032,"_5":14428,"_27536":121967,"_2958":122033},[],"región o requisito regulatorio;",{"_3475":72150,"_30304":72129,"_20976":122035,"_5":14428,"_27536":121967,"_2958":122036},[],"motor criptográfico o política de clave;",{"_3475":72151,"_30304":72129,"_20976":122038,"_5":14428,"_27536":121967,"_2958":122039},[],"ventana de mantenimiento y ritmo de renovación.",{"_3475":72152,"_30304":72129,"_20976":122041,"_5":14428,"_27536":121967,"_2958":122042},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3475":72153,"_30304":72129,"_20976":122044,"_5":14428,"_27536":121967,"_2958":122045},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3475":72154,"_30304":72129,"_20976":122047,"_5":14428,"_27536":121971,"_2958":122048},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3475":72155,"_30304":72129,"_20976":122050,"_5":14428,"_27536":121971,"_2958":122051},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3475":72156,"_30304":72129,"_20976":122053,"_5":14428,"_27536":121971,"_2958":122054},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3475":72157,"_30304":72129,"_20976":122056,"_5":14428,"_27536":121971,"_2958":122057},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3475":72158,"_30304":72129,"_20976":122059,"_5":14428,"_27536":121975,"_2958":122060},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3475":72159,"_30304":72129,"_20976":122062,"_5":14428,"_27536":121975,"_2958":122063},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3475":72160,"_30304":72129,"_20976":122065,"_5":14428,"_27536":121975,"_2958":122066},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3475":72161,"_30304":72129,"_20976":122068,"_5":14428,"_27536":121975,"_2958":122069},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3475":72162,"_30304":72129,"_20976":122071,"_5":14428,"_27536":121983,"_2958":122072},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3475":72163,"_30304":72129,"_20976":122074,"_5":14428,"_27536":121987,"_2958":122075},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3475":72164,"_30304":72129,"_20976":122077,"_5":14428,"_27536":121991,"_2958":122078},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3475":72165,"_30304":72129,"_20976":122080,"_5":14428,"_27536":121995,"_2958":122081},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3475":72166,"_30304":72129,"_20976":122083,"_5":14428,"_27536":121999,"_2958":122084},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3475":72167,"_30304":72129,"_20976":122086,"_5":14428,"_27536":122003,"_2958":122087},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3475":72168,"_30304":72129,"_20976":122089,"_5":14428,"_27536":122007,"_2958":122090},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3475":72169,"_30304":72129,"_20976":122092,"_5":14428,"_27536":122007,"_2958":122093},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3475":72170,"_30304":72129,"_20976":122095,"_5":14428,"_27536":122007,"_2958":122096},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3475":72171,"_30304":72129,"_20976":122098,"_5":14428,"_27536":122007,"_2958":122099},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3475":72172,"_30304":72129,"_20976":122101,"_5":14428,"_27536":122011,"_2958":122102},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3475":72173,"_30304":72129,"_20976":122104,"_5":14428,"_27536":122011,"_2958":122105},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3475":72174,"_30304":72129,"_20976":122107,"_5":14428,"_27536":122011,"_2958":122108},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3475":72175,"_30304":72129,"_20976":122110,"_5":14428,"_27536":122011,"_2958":122111},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3475":72176,"_30304":72129,"_20976":122113,"_5":14428,"_27536":122011,"_2958":122114},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3475":72177,"_30304":72129,"_20976":122116,"_5":14428,"_27536":122011,"_2958":122117},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3475":72178,"_30304":72129,"_20976":122119,"_5":14428,"_27536":122011,"_2958":122120},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3475":72179,"_30304":72179,"_5":14780,"_2958":122122,"_30657":122123,"_20976":122124,"_27536":72179},"Autoridades de certificación",[49412,118079,54895,121960],[],{"_3475":72180,"_30304":72179,"_20976":122126,"_5":14428,"_27536":72179,"_2958":122127},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3475":72181,"_30304":72179,"_5":30654,"_20976":122129,"_27536":122130,"_2958":122131},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3475":72182,"_30304":72179,"_5":30654,"_20976":122133,"_27536":122134,"_2958":122135},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3475":72183,"_30304":72179,"_5":30654,"_20976":122137,"_27536":122138,"_2958":116650},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3475":72184,"_30304":72179,"_5":30654,"_20976":122140,"_27536":122141,"_2958":122142},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3475":72185,"_30304":72179,"_5":30654,"_20976":122144,"_27536":122145,"_2958":122146},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3475":72186,"_30304":72179,"_5":30654,"_20976":122148,"_27536":122149,"_2958":122150},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3475":72187,"_30304":72179,"_5":30654,"_20976":122152,"_27536":122153,"_2958":122154},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3475":72188,"_30304":72179,"_5":30654,"_20976":122156,"_27536":122157,"_2958":122158},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3475":72189,"_30304":72179,"_5":30654,"_20976":122160,"_27536":122161,"_2958":122162},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3475":72190,"_30304":72179,"_5":30654,"_20976":122164,"_27536":122165,"_2958":122166},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3475":72191,"_30304":72179,"_5":30654,"_20976":122168,"_27536":122169,"_2958":122170},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3475":72192,"_30304":72179,"_5":30654,"_20976":122172,"_27536":122173,"_2958":122174},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3475":72193,"_30304":72179,"_5":30654,"_20976":122176,"_27536":122177,"_2958":122178},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3475":72194,"_30304":72179,"_5":30654,"_20976":122180,"_27536":122181,"_2958":122182},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3475":72195,"_30304":72179,"_5":30654,"_20976":122184,"_27536":122185,"_2958":122186},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3475":72196,"_30304":72179,"_5":30654,"_20976":122188,"_27536":122189,"_2958":122190},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3475":72197,"_30304":72179,"_5":30654,"_20976":122192,"_27536":122193,"_2958":122194},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3475":72198,"_30304":72179,"_5":30654,"_20976":122196,"_27536":122197,"_2958":122198},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3475":72199,"_30304":72179,"_5":30654,"_20976":122200,"_27536":122201,"_2958":122202},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3475":72200,"_30304":72179,"_5":30654,"_20976":122204,"_27536":122205,"_2958":122206},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3475":72201,"_30304":72179,"_5":30654,"_20976":122208,"_27536":122209,"_2958":122210},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3475":72202,"_30304":72179,"_5":30654,"_20976":122212,"_27536":122213,"_2958":122214},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3475":72203,"_30304":72179,"_5":30654,"_20976":122216,"_27536":122217,"_2958":122218},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3475":72204,"_30304":72179,"_20976":122220,"_5":14428,"_27536":72179,"_2958":122221},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3475":72205,"_30304":72179,"_20976":122223,"_5":14428,"_27536":72179,"_2958":122224},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3475":72206,"_30304":72179,"_20976":122226,"_5":14428,"_27536":72179,"_2958":122227},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3475":72207,"_30304":72179,"_20976":122229,"_5":14428,"_27536":122130,"_2958":122230},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3475":72208,"_30304":72179,"_20976":122232,"_5":14428,"_27536":122130,"_2958":122233},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3475":72209,"_30304":72179,"_20976":122235,"_5":14428,"_27536":122130,"_2958":122236},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3475":72210,"_30304":72179,"_20976":122238,"_5":14428,"_27536":122130,"_2958":122239},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3475":72211,"_30304":72179,"_20976":122241,"_5":14428,"_27536":122130,"_2958":122242},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3475":72212,"_30304":72179,"_20976":122244,"_5":14428,"_27536":122138,"_2958":122245},[],"Decide si la CA será raíz o intermedia.",{"_3475":72213,"_30304":72179,"_20976":122247,"_5":14428,"_27536":122138,"_2958":122248},[],"Elige el motor que custodiará la clave.",{"_3475":72214,"_30304":72179,"_20976":122250,"_5":14428,"_27536":122138,"_2958":122251},[],"Define una validez superior a la de los certificados que emitirá.",{"_3475":72215,"_30304":72179,"_20976":122253,"_5":14428,"_27536":122138,"_2958":122254},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3475":72216,"_30304":72179,"_20976":122256,"_5":14428,"_27536":122141,"_2958":122257},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3475":72217,"_30304":72179,"_20976":122259,"_5":14428,"_27536":122145,"_2958":122260},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3475":72218,"_30304":72179,"_20976":122262,"_5":14428,"_27536":122145,"_2958":122263},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3475":72219,"_30304":72179,"_20976":122265,"_5":14428,"_27536":122149,"_2958":122266},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3475":72220,"_30304":72179,"_20976":122268,"_5":14428,"_27536":122153,"_2958":122269},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3475":72221,"_30304":72179,"_20976":122271,"_5":14428,"_27536":122153,"_2958":122272},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3475":72222,"_30304":72179,"_20976":122274,"_5":14428,"_27536":122153,"_2958":122275},[],"`ST`: estado o provincia.",{"_3475":72223,"_30304":72179,"_20976":122277,"_5":14428,"_27536":122153,"_2958":122278},[],"`L`: localidad.",{"_3475":72224,"_30304":72179,"_20976":122280,"_5":14428,"_27536":122153,"_2958":122281},[],"`O`: organización.",{"_3475":72225,"_30304":72179,"_20976":122283,"_5":14428,"_27536":122153,"_2958":122284},[],"`OU`: unidad organizativa.",{"_3475":72226,"_30304":72179,"_20976":122286,"_5":14428,"_27536":122153,"_2958":122287},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3475":72227,"_30304":72179,"_20976":122289,"_5":14428,"_27536":122157,"_2958":122290},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3475":72228,"_30304":72179,"_20976":122292,"_5":14428,"_27536":122157,"_2958":122293},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3475":72229,"_30304":72179,"_20976":122295,"_5":14428,"_27536":122161,"_2958":122296},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3475":72230,"_30304":72179,"_20976":122298,"_5":14428,"_27536":122161,"_2958":122299},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3475":72231,"_30304":72179,"_20976":122301,"_5":14428,"_27536":122165,"_2958":122302},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3475":72232,"_30304":72179,"_20976":122304,"_5":14428,"_27536":122165,"_2958":122305},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3475":72233,"_30304":72179,"_20976":122307,"_5":14428,"_27536":122169,"_2958":122308},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3475":72234,"_30304":72179,"_20976":122310,"_5":14428,"_27536":122169,"_2958":122311},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3475":72235,"_30304":72179,"_20976":122313,"_5":14428,"_27536":122169,"_2958":122314},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3475":72236,"_30304":72179,"_20976":122316,"_5":14428,"_27536":122173,"_2958":122317},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3475":72237,"_30304":72179,"_20976":122319,"_5":14428,"_27536":122177,"_2958":122320},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3475":72238,"_30304":72179,"_20976":122322,"_5":14428,"_27536":122177,"_2958":122323},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3475":72239,"_30304":72179,"_20976":122325,"_5":14428,"_27536":122181,"_2958":122326},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3475":72240,"_30304":72179,"_20976":122328,"_5":14428,"_27536":122185,"_2958":122329},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3475":72241,"_30304":72179,"_20976":122331,"_5":14428,"_27536":122185,"_2958":122332},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3475":72242,"_30304":72179,"_20976":122334,"_5":14428,"_27536":122189,"_2958":122335},[],"Abre una CA desde el inventario para consultar:",{"_3475":72243,"_30304":72179,"_20976":122337,"_5":14428,"_27536":122189,"_2958":122338},[],"Estado y periodo de validez.",{"_3475":72244,"_30304":72179,"_20976":122340,"_5":14428,"_27536":122189,"_2958":122341},[],"Certificado y cadena en formato PEM.",{"_3475":72245,"_30304":72179,"_20976":122343,"_5":14428,"_27536":122189,"_2958":122344},[],"Número de certificados activos, expirados y revocados.",{"_3475":72246,"_30304":72179,"_20976":122346,"_5":14428,"_27536":122189,"_2958":122347},[],"Certificados emitidos en **Issued Certificates**.",{"_3475":72247,"_30304":72179,"_20976":122349,"_5":14428,"_27536":122189,"_2958":122350},[],"CRL vinculada a la autoridad.",{"_3475":72248,"_30304":72179,"_20976":122352,"_5":14428,"_27536":122189,"_2958":122353},[],"Metadatos y motor criptográfico asociado.",{"_3475":72249,"_30304":72179,"_20976":122355,"_5":14428,"_27536":122189,"_2958":122356},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3475":72250,"_30304":72179,"_20976":122358,"_5":14428,"_27536":122193,"_2958":122359},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3475":72251,"_30304":72179,"_20976":122361,"_5":14428,"_27536":122193,"_2958":122362},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3475":72252,"_30304":72179,"_20976":122364,"_5":14428,"_27536":122193,"_2958":122365},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3475":72253,"_30304":72179,"_20976":122367,"_5":14428,"_27536":122193,"_2958":122368},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3475":72254,"_30304":72179,"_20976":122370,"_5":14428,"_27536":122197,"_2958":122371},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3475":72255,"_30304":72179,"_20976":122373,"_5":14428,"_27536":122201,"_2958":122374},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3475":72256,"_30304":72179,"_20976":122376,"_5":14428,"_27536":122205,"_2958":122377},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3475":72257,"_30304":72179,"_20976":122379,"_5":14428,"_27536":122209,"_2958":122380},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3475":72258,"_30304":72179,"_20976":122382,"_5":14428,"_27536":122213,"_2958":122383},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3475":72259,"_30304":72179,"_20976":122385,"_5":14428,"_27536":122217,"_2958":122386},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3475":72260,"_30304":72179,"_20976":122388,"_5":14428,"_27536":122217,"_2958":122389},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3475":72261,"_30304":72179,"_20976":122391,"_5":14428,"_27536":122217,"_2958":122392},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3475":72262,"_30304":72179,"_20976":122394,"_5":14428,"_27536":122217,"_2958":122395},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3475":72263,"_30304":72263,"_5":14780,"_2958":122397,"_30657":122398,"_20976":122399,"_27536":72263},"Perfiles de certificado",[49412,118079,54895,121960],[],{"_3475":72264,"_30304":72263,"_20976":122401,"_5":14428,"_27536":72263,"_2958":122402},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3475":72265,"_30304":72263,"_5":30654,"_20976":122404,"_27536":122405,"_2958":122406},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3475":72266,"_30304":72263,"_5":30654,"_20976":122408,"_27536":122409,"_2958":122410},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#validez","Validez",{"_3475":72267,"_30304":72263,"_5":30654,"_20976":122412,"_27536":122413,"_2958":122414},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3475":72268,"_30304":72263,"_5":30654,"_20976":122416,"_27536":122417,"_2958":122418},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3475":72269,"_30304":72263,"_5":30654,"_20976":122420,"_27536":122421,"_2958":122422},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3475":72270,"_30304":72263,"_5":30654,"_20976":122424,"_27536":122425,"_2958":122426},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3475":72271,"_30304":72263,"_5":30654,"_20976":122428,"_27536":122429,"_2958":122430},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3475":72272,"_30304":72263,"_5":30654,"_20976":122432,"_27536":122433,"_2958":122434},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3475":72273,"_30304":72263,"_5":30654,"_20976":122436,"_27536":122437,"_2958":122438},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3475":72274,"_30304":72263,"_5":30654,"_20976":122440,"_27536":122441,"_2958":122442},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3475":72275,"_30304":72263,"_5":30654,"_20976":122444,"_27536":122445,"_2958":122446},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3475":72276,"_30304":72263,"_5":30654,"_20976":122448,"_27536":122449,"_2958":122450},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3475":72277,"_30304":72263,"_5":30654,"_20976":122452,"_27536":122453,"_2958":122454},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3475":72278,"_30304":72263,"_5":30654,"_20976":122456,"_27536":122457,"_2958":122458},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3475":72279,"_30304":72263,"_5":30654,"_20976":122460,"_27536":122461,"_2958":122462},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3475":72280,"_30304":72263,"_5":30654,"_20976":122464,"_27536":122465,"_2958":122466},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3475":72281,"_30304":72263,"_20976":122468,"_5":14428,"_27536":72263,"_2958":122469},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3475":72282,"_30304":72263,"_20976":122471,"_5":14428,"_27536":72263,"_2958":122472},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3475":72283,"_30304":72263,"_20976":122474,"_5":14428,"_27536":122409,"_2958":122475},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3475":72284,"_30304":72263,"_20976":122477,"_5":14428,"_27536":122409,"_2958":122478},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3475":72285,"_30304":72263,"_20976":122480,"_5":14428,"_27536":122413,"_2958":122481},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3475":72286,"_30304":72263,"_20976":122483,"_5":14428,"_27536":122417,"_2958":122484},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3475":72287,"_30304":72263,"_20976":122486,"_5":14428,"_27536":122417,"_2958":122487},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3475":72288,"_30304":72263,"_20976":122489,"_5":14428,"_27536":122417,"_2958":122490},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3475":72289,"_30304":72263,"_20976":122492,"_5":14428,"_27536":122421,"_2958":122493},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3475":72290,"_30304":72263,"_20976":122495,"_5":14428,"_27536":122425,"_2958":122496},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3475":72291,"_30304":72263,"_20976":122498,"_5":14428,"_27536":122425,"_2958":122499},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3475":72292,"_30304":72263,"_20976":122501,"_5":14428,"_27536":122429,"_2958":122502},[],"La aplicación criptográfica puede:",{"_3475":72293,"_30304":72263,"_20976":122504,"_5":14428,"_27536":122429,"_2958":122505},[],"permitir o bloquear claves RSA;",{"_3475":72294,"_30304":72263,"_20976":122507,"_5":14428,"_27536":122429,"_2958":122508},[],"limitar los tamaños RSA admitidos;",{"_3475":72295,"_30304":72263,"_20976":122510,"_5":14428,"_27536":122429,"_2958":122511},[],"permitir o bloquear claves ECDSA;",{"_3475":72296,"_30304":72263,"_20976":122513,"_5":14428,"_27536":122429,"_2958":122514},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3475":72297,"_30304":72263,"_20976":122516,"_5":14428,"_27536":122429,"_2958":122517},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3475":72298,"_30304":72263,"_20976":122519,"_5":14428,"_27536":122433,"_2958":122520},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3475":72299,"_30304":72263,"_20976":122522,"_5":14428,"_27536":122433,"_2958":117839},[],{"_3475":72300,"_30304":72263,"_20976":122524,"_5":14428,"_27536":122433,"_2958":122525},[],"Primera opción",{"_3475":72301,"_30304":72263,"_20976":122527,"_5":14428,"_27536":122433,"_2958":122528},[],"Segunda opción",{"_3475":72302,"_30304":72263,"_20976":122530,"_5":14428,"_27536":122433,"_2958":122531},[],"Si no hay ninguna",{"_3475":72303,"_30304":72263,"_20976":122533,"_5":14428,"_27536":122433,"_2958":122534},[],"Firma directa con una CA",{"_3475":72304,"_30304":72263,"_20976":122536,"_5":14428,"_27536":122433,"_2958":122537},[],"`issuance_profile` incluido en la solicitud",{"_3475":72305,"_30304":72263,"_20976":122539,"_5":14428,"_27536":122433,"_2958":122540},[],"`issuance_profile_id` de la solicitud",{"_3475":72306,"_30304":72263,"_20976":122542,"_5":14428,"_27536":122433,"_2958":122543},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3475":72307,"_30304":72263,"_20976":122545,"_5":14428,"_27536":122433,"_2958":122546},[],"Emisión mediante DMS",{"_3475":72308,"_30304":72263,"_20976":122548,"_5":14428,"_27536":122433,"_2958":55485},[],{"_3475":72309,"_30304":72263,"_20976":122550,"_5":14428,"_27536":122433,"_2958":122551},[],"`settings.issuance_profile` incluido en el DMS",{"_3475":72310,"_30304":72263,"_20976":122553,"_5":14428,"_27536":122433,"_2958":122554},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3475":72311,"_30304":72263,"_20976":122556,"_5":14428,"_27536":122433,"_2958":122557},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3475":72312,"_30304":72263,"_20976":122559,"_5":14428,"_27536":122433,"_2958":122560},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3475":72313,"_30304":72263,"_20976":122562,"_5":14428,"_27536":122441,"_2958":122563},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3475":72314,"_30304":72263,"_20976":122565,"_5":14428,"_27536":122445,"_2958":122566},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3475":72315,"_30304":72263,"_20976":122568,"_5":14428,"_27536":122449,"_2958":122569},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3475":72316,"_30304":72263,"_20976":122571,"_5":14428,"_27536":122453,"_2958":122572},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3475":72317,"_30304":72263,"_20976":122574,"_5":14428,"_27536":122457,"_2958":122575},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3475":72318,"_30304":72263,"_20976":122577,"_5":14428,"_27536":122457,"_2958":122578},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3475":72319,"_30304":72263,"_20976":122580,"_5":14428,"_27536":122461,"_2958":122581},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3475":72320,"_30304":72263,"_20976":122583,"_5":14428,"_27536":122461,"_2958":122584},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3475":72321,"_30304":72263,"_20976":122586,"_5":14428,"_27536":122461,"_2958":122587},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3475":72322,"_30304":72263,"_20976":122589,"_5":14428,"_27536":122461,"_2958":122590},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3475":72323,"_30304":72263,"_20976":122592,"_5":14428,"_27536":122465,"_2958":122593},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3475":72324,"_30304":72263,"_20976":122595,"_5":14428,"_27536":122465,"_2958":122596},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3475":72325,"_30304":72325,"_5":14780,"_2958":122598,"_30657":122599,"_20976":122601,"_27536":72325},"Validación de certificados",[49412,118079,54895,122600],"Validación",[],{"_3475":72326,"_30304":72325,"_20976":122603,"_5":14428,"_27536":72325,"_2958":122604},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3475":72327,"_30304":72325,"_5":30654,"_20976":122606,"_27536":122607,"_2958":122608},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3475":72328,"_30304":72325,"_5":30654,"_20976":122610,"_27536":122611,"_2958":122612},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3475":72329,"_30304":72325,"_5":30654,"_20976":122614,"_27536":122615,"_2958":122616},[],"/docs/pr-preview/pr-65/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3475":72330,"_30304":72325,"_20976":122618,"_5":14428,"_27536":72325,"_2958":122619},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3475":72331,"_30304":72325,"_20976":122621,"_5":14428,"_27536":122607,"_2958":122622},[],"Verifica estos criterios juntos:",{"_3475":72332,"_30304":72325,"_20976":122624,"_5":14428,"_27536":122607,"_2958":121589},[],{"_3475":72333,"_30304":72325,"_20976":122626,"_5":14428,"_27536":122607,"_2958":122627},[],"Resultado necesario",{"_3475":72334,"_30304":72325,"_20976":122629,"_5":14428,"_27536":122607,"_2958":122630},[],"Cadena y firma",{"_3475":72335,"_30304":72325,"_20976":122632,"_5":14428,"_27536":122607,"_2958":122633},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3475":72336,"_30304":72325,"_20976":122635,"_5":14428,"_27536":122607,"_2958":122636},[],"Fechas",{"_3475":72337,"_30304":72325,"_20976":122638,"_5":14428,"_27536":122607,"_2958":122639},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3475":72338,"_30304":72325,"_20976":122641,"_5":14428,"_27536":122607,"_2958":117749},[],{"_3475":72339,"_30304":72325,"_20976":122643,"_5":14428,"_27536":122607,"_2958":122644},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3475":72340,"_30304":72325,"_20976":122646,"_5":14428,"_27536":122607,"_2958":122647},[],"Uso",{"_3475":72341,"_30304":72325,"_20976":122649,"_5":14428,"_27536":122607,"_2958":122650},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3475":72342,"_30304":72325,"_20976":122652,"_5":14428,"_27536":122607,"_2958":122653},[],"Revocación",{"_3475":72343,"_30304":72325,"_20976":122655,"_5":14428,"_27536":122607,"_2958":122656},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3475":72344,"_30304":72325,"_20976":122658,"_5":14428,"_27536":122607,"_2958":122659},[],"Autorización",{"_3475":72345,"_30304":72325,"_20976":122661,"_5":14428,"_27536":122607,"_2958":122662},[],"La aplicación permite la acción a esa identidad.",{"_3475":72346,"_30304":72325,"_20976":122664,"_5":14428,"_27536":122607,"_2958":122665},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3475":72347,"_30304":72325,"_20976":122667,"_5":14428,"_27536":122611,"_2958":122668},[],"Mecanismo",{"_3475":72348,"_30304":72325,"_20976":122670,"_5":14428,"_27536":122611,"_2958":122671},[],"Cuándo utilizarlo",{"_3475":72349,"_30304":72325,"_20976":122673,"_5":14428,"_27536":122611,"_2958":122674},[],"Qué debes mantener",{"_3475":72350,"_30304":72325,"_20976":122676,"_5":14428,"_27536":122611,"_2958":55613},[],{"_3475":72351,"_30304":72325,"_20976":122678,"_5":14428,"_27536":122611,"_2958":122679},[],"Consulta del estado de un certificado concreto.",{"_3475":72352,"_30304":72325,"_20976":122681,"_5":14428,"_27536":122611,"_2958":122682},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3475":72353,"_30304":72325,"_20976":122684,"_5":14428,"_27536":122611,"_2958":55622},[],{"_3475":72354,"_30304":72325,"_20976":122686,"_5":14428,"_27536":122611,"_2958":122687},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3475":72355,"_30304":72325,"_20976":122689,"_5":14428,"_27536":122611,"_2958":122690},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3475":72356,"_30304":72325,"_20976":122692,"_5":14428,"_27536":122611,"_2958":122693},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3475":72357,"_30304":72325,"_20976":122695,"_5":14428,"_27536":122611,"_2958":122696},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3475":72358,"_30304":72325,"_20976":122698,"_5":14428,"_27536":122615,"_2958":122699},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3475":72359,"_30304":72325,"_20976":122701,"_5":14428,"_27536":122615,"_2958":122702},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3475":72360,"_30304":72325,"_20976":122704,"_5":14428,"_27536":122615,"_2958":122705},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3475":72361,"_30304":72325,"_20976":122707,"_5":14428,"_27536":122615,"_2958":122708},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3475":72362,"_30304":72325,"_20976":122710,"_5":14428,"_27536":122615,"_2958":122711},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3475":72363,"_30304":72325,"_20976":122713,"_5":14428,"_27536":122615,"_2958":122714},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3475":72364,"_30304":72325,"_20976":122716,"_5":14428,"_27536":122615,"_2958":122717},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3475":72365,"_30304":72325,"_20976":122719,"_5":14428,"_27536":122615,"_2958":122720},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":72366,"_30304":72325,"_20976":122722,"_5":14428,"_27536":122615,"_2958":122723},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3475":72367,"_30304":72367,"_5":14780,"_2958":122725,"_30657":122726,"_20976":122727,"_27536":72367},"Certificados",[49412,118079,54895,121960],[],{"_3475":72368,"_30304":72367,"_20976":122729,"_5":14428,"_27536":72367,"_2958":122730},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3475":72369,"_30304":72367,"_5":30654,"_20976":122732,"_27536":122733,"_2958":122734},[],"/docs/pr-preview/pr-65/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3475":72370,"_30304":72367,"_5":30654,"_20976":122736,"_27536":122737,"_2958":122738},[],"/docs/pr-preview/pr-65/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3475":72371,"_30304":72367,"_5":30654,"_20976":122740,"_27536":122741,"_2958":122742},[],"/docs/pr-preview/pr-65/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3475":72372,"_30304":72367,"_5":30654,"_20976":122744,"_27536":122745,"_2958":122746},[],"/docs/pr-preview/pr-65/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3475":72373,"_30304":72367,"_5":30654,"_20976":122748,"_27536":122749,"_2958":122750},[],"/docs/pr-preview/pr-65/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3475":72374,"_30304":72367,"_5":30654,"_20976":122752,"_27536":122753,"_2958":122754},[],"/docs/pr-preview/pr-65/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3475":72375,"_30304":72367,"_5":30654,"_20976":122756,"_27536":122757,"_2958":122758},[],"/docs/pr-preview/pr-65/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3475":72376,"_30304":72367,"_5":30654,"_20976":122760,"_27536":122761,"_2958":122762},[],"/docs/pr-preview/pr-65/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3475":72377,"_30304":72367,"_5":30654,"_20976":122764,"_27536":122765,"_2958":122766},[],"/docs/pr-preview/pr-65/es/platform/pki/certificates#continúa","Continúa",{"_3475":72378,"_30304":72367,"_20976":122768,"_5":14428,"_27536":72367,"_2958":122769},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3475":72379,"_30304":72367,"_20976":122771,"_5":14428,"_27536":122733,"_2958":122772},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3475":72380,"_30304":72367,"_20976":122774,"_5":14428,"_27536":122733,"_2958":122775},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3475":72381,"_30304":72367,"_20976":122777,"_5":14428,"_27536":122733,"_2958":122778},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3475":72382,"_30304":72367,"_20976":122780,"_5":14428,"_27536":122733,"_2958":122781},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3475":72383,"_30304":72367,"_20976":122783,"_5":14428,"_27536":122733,"_2958":122784},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3475":72384,"_30304":72367,"_20976":122786,"_5":14428,"_27536":122733,"_2958":122787},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3475":72385,"_30304":72367,"_20976":122789,"_5":14428,"_27536":122733,"_2958":122790},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3475":72386,"_30304":72367,"_20976":122792,"_5":14428,"_27536":122737,"_2958":122793},[],"Descarga el PEM e inspecciónalo:",{"_3475":72387,"_30304":72367,"_20976":122795,"_5":14428,"_27536":122737,"_2958":122796},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3475":72388,"_30304":72367,"_20976":122798,"_5":14428,"_27536":122741,"_2958":122799},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3475":72389,"_30304":72367,"_20976":122801,"_5":14428,"_27536":122741,"_2958":122802},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3475":72390,"_30304":72367,"_20976":122804,"_5":14428,"_27536":122741,"_2958":122805},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3475":72391,"_30304":72367,"_20976":122807,"_5":14428,"_27536":122741,"_2958":122808},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3475":72392,"_30304":72367,"_20976":122810,"_5":14428,"_27536":122741,"_2958":122811},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3475":72393,"_30304":72367,"_20976":122813,"_5":14428,"_27536":122741,"_2958":122814},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3475":72394,"_30304":72367,"_20976":122816,"_5":14428,"_27536":122741,"_2958":122817},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3475":72395,"_30304":72367,"_20976":122819,"_5":14428,"_27536":122745,"_2958":122820},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3475":72396,"_30304":72367,"_20976":122822,"_5":14428,"_27536":122749,"_2958":122823},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3475":72397,"_30304":72367,"_20976":122825,"_5":14428,"_27536":122753,"_2958":122826},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3475":72398,"_30304":72367,"_20976":122828,"_5":14428,"_27536":122757,"_2958":122829},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3475":72399,"_30304":72367,"_20976":122831,"_5":14428,"_27536":122757,"_2958":122832},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3475":72400,"_30304":72367,"_20976":122834,"_5":14428,"_27536":122757,"_2958":122835},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3475":72401,"_30304":72367,"_20976":122837,"_5":14428,"_27536":122761,"_2958":122838},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3475":72402,"_30304":72367,"_20976":122840,"_5":14428,"_27536":122761,"_2958":122841},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3475":72403,"_30304":72367,"_20976":122843,"_5":14428,"_27536":122761,"_2958":122844},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3475":72404,"_30304":72367,"_20976":122846,"_5":14428,"_27536":122765,"_2958":122847},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":72405,"_30304":72367,"_20976":122849,"_5":14428,"_27536":122765,"_2958":122850},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3475":72406,"_30304":72406,"_5":14780,"_2958":122852,"_30657":122853,"_20976":122855,"_27536":72406},"Ciclo de vida de un certificado",[49412,118079,54895,122854],"Conceptos",[],{"_3475":72407,"_30304":72406,"_20976":122857,"_5":14428,"_27536":72406,"_2958":122858},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3475":72408,"_30304":72406,"_5":30654,"_20976":122860,"_27536":122861,"_2958":122862},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3475":72409,"_30304":72406,"_5":30654,"_20976":122864,"_27536":122865,"_2958":122866},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3475":72410,"_30304":72406,"_5":30654,"_20976":122868,"_27536":122869,"_2958":122870},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3475":72411,"_30304":72406,"_5":30654,"_20976":122872,"_27536":122873,"_2958":122874},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3475":72412,"_30304":72406,"_5":30654,"_20976":122876,"_27536":122877,"_2958":122878},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3475":72413,"_30304":72406,"_5":30654,"_20976":122880,"_27536":122881,"_2958":122882},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3475":72414,"_30304":72406,"_5":30654,"_20976":122884,"_27536":122885,"_2958":120583},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3475":72415,"_30304":72406,"_5":30654,"_20976":122887,"_27536":122888,"_2958":122889},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3475":72416,"_30304":72406,"_5":30654,"_20976":122891,"_27536":122892,"_2958":122893},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3475":72417,"_30304":72406,"_5":30654,"_20976":122895,"_27536":122896,"_2958":122897},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3475":72418,"_30304":72406,"_20976":122899,"_5":14428,"_27536":72406,"_2958":122900},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3475":72419,"_30304":72406,"_20976":122902,"_5":14428,"_27536":122865,"_2958":122903},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3475":72420,"_30304":72406,"_20976":122905,"_5":14428,"_27536":122869,"_2958":122906},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3475":72421,"_30304":72406,"_20976":122908,"_5":14428,"_27536":122873,"_2958":122909},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3475":72422,"_30304":72406,"_20976":122911,"_5":14428,"_27536":122877,"_2958":122912},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3475":72423,"_30304":72406,"_20976":122914,"_5":14428,"_27536":122881,"_2958":122915},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3475":72424,"_30304":72406,"_20976":122917,"_5":14428,"_27536":122885,"_2958":122918},[],"Lamassu persiste cuatro estados X.509:",{"_3475":72425,"_30304":72406,"_20976":122920,"_5":14428,"_27536":122885,"_2958":122921},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3475":72426,"_30304":72406,"_20976":122923,"_5":14428,"_27536":122885,"_2958":122924},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3475":72427,"_30304":72406,"_20976":122926,"_5":14428,"_27536":122885,"_2958":122927},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3475":72428,"_30304":72406,"_20976":122929,"_5":14428,"_27536":122885,"_2958":122930},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3475":72429,"_30304":72406,"_20976":122932,"_5":14428,"_27536":122885,"_2958":122933},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3475":72430,"_30304":72406,"_20976":122935,"_5":14428,"_27536":122888,"_2958":122936},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3475":72431,"_30304":72406,"_20976":122938,"_5":14428,"_27536":122888,"_2958":122939},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3475":72432,"_30304":72406,"_20976":122941,"_5":14428,"_27536":122888,"_2958":122942},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3475":72433,"_30304":72406,"_20976":122944,"_5":14428,"_27536":122892,"_2958":122945},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3475":72434,"_30304":72406,"_20976":122947,"_5":14428,"_27536":122892,"_2958":122948},[],"Antes de confirmar:",{"_3475":72435,"_30304":72406,"_20976":122950,"_5":14428,"_27536":122892,"_2958":122951},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3475":72436,"_30304":72406,"_20976":122953,"_5":14428,"_27536":122892,"_2958":122954},[],"Distribuye la nueva cadena de confianza.",{"_3475":72437,"_30304":72406,"_20976":122956,"_5":14428,"_27536":122892,"_2958":122957},[],"Reemite las identidades necesarias.",{"_3475":72438,"_30304":72406,"_20976":122959,"_5":14428,"_27536":122892,"_2958":122960},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3475":72439,"_30304":72406,"_20976":122962,"_5":14428,"_27536":122892,"_2958":122963},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3475":72440,"_30304":72406,"_20976":122965,"_5":14428,"_27536":122892,"_2958":122966},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3475":72441,"_30304":72406,"_20976":122968,"_5":14428,"_27536":122896,"_2958":122969},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3475":72442,"_30304":72406,"_20976":122971,"_5":14428,"_27536":122896,"_2958":122972},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3475":72443,"_30304":72406,"_20976":122974,"_5":14428,"_27536":122896,"_2958":122975},[],"Cambios de estado y razones de revocación.",{"_3475":72444,"_30304":72406,"_20976":122977,"_5":14428,"_27536":122896,"_2958":122978},[],"Publicación y vigencia de OCSP y CRLs.",{"_3475":72445,"_30304":72406,"_20976":122980,"_5":14428,"_27536":122896,"_2958":122981},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3475":72446,"_30304":72406,"_20976":122983,"_5":14428,"_27536":122896,"_2958":122984},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3475":72447,"_30304":72447,"_5":14780,"_2958":122986,"_30657":122987,"_20976":122988,"_27536":72447},"Modelo de confianza",[49412,118079,54895,122854],[],{"_3475":72448,"_30304":72447,"_20976":122990,"_5":14428,"_27536":72447,"_2958":122991},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3475":72449,"_30304":72447,"_5":30654,"_20976":122993,"_27536":122994,"_2958":122995},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3475":72450,"_30304":72447,"_5":30654,"_20976":122997,"_27536":122998,"_2958":122999},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3475":72451,"_30304":72447,"_5":30654,"_20976":123001,"_27536":123002,"_2958":123003},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3475":72452,"_30304":72447,"_5":30654,"_20976":123005,"_27536":123006,"_2958":123007},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3475":72453,"_30304":72447,"_5":30654,"_20976":123009,"_27536":123010,"_2958":123011},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3475":72454,"_30304":72447,"_5":30654,"_20976":123013,"_27536":123014,"_2958":123015},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3475":72455,"_30304":72447,"_5":30654,"_20976":123017,"_27536":123018,"_2958":123019},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3475":72456,"_30304":72447,"_5":30654,"_20976":123021,"_27536":123022,"_2958":123023},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3475":72457,"_30304":72447,"_5":30654,"_20976":123025,"_27536":123026,"_2958":123027},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3475":72458,"_30304":72447,"_5":30654,"_20976":123029,"_27536":123030,"_2958":123031},[],"/docs/pr-preview/pr-65/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3475":72459,"_30304":72447,"_20976":123033,"_5":14428,"_27536":72447,"_2958":123034},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3475":72460,"_30304":72447,"_20976":123036,"_5":14428,"_27536":122998,"_2958":123037},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3475":72461,"_30304":72447,"_20976":123039,"_5":14428,"_27536":123002,"_2958":123040},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3475":72462,"_30304":72447,"_20976":123042,"_5":14428,"_27536":123006,"_2958":123043},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3475":72463,"_30304":72447,"_20976":123045,"_5":14428,"_27536":123010,"_2958":123046},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3475":72464,"_30304":72447,"_20976":123048,"_5":14428,"_27536":123014,"_2958":123049},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3475":72465,"_30304":72447,"_20976":123051,"_5":14428,"_27536":123014,"_2958":123052},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3475":72466,"_30304":72447,"_20976":123054,"_5":14428,"_27536":123014,"_2958":123055},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3475":72467,"_30304":72447,"_20976":123057,"_5":14428,"_27536":123014,"_2958":123058},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3475":72468,"_30304":72447,"_20976":123060,"_5":14428,"_27536":123014,"_2958":123061},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3475":72469,"_30304":72447,"_20976":123063,"_5":14428,"_27536":123014,"_2958":123064},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3475":72470,"_30304":72447,"_20976":123066,"_5":14428,"_27536":123018,"_2958":123067},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3475":72471,"_30304":72447,"_20976":123069,"_5":14428,"_27536":123018,"_2958":123070},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3475":72472,"_30304":72447,"_20976":123072,"_5":14428,"_27536":123018,"_2958":123073},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3475":72473,"_30304":72447,"_20976":123075,"_5":14428,"_27536":123018,"_2958":123076},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3475":72474,"_30304":72447,"_20976":123078,"_5":14428,"_27536":123018,"_2958":123079},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3475":72475,"_30304":72447,"_20976":123081,"_5":14428,"_27536":123022,"_2958":123082},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3475":72476,"_30304":72447,"_20976":123084,"_5":14428,"_27536":123022,"_2958":123085},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3475":72477,"_30304":72447,"_20976":123087,"_5":14428,"_27536":123022,"_2958":123088},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3475":72478,"_30304":72447,"_20976":123090,"_5":14428,"_27536":123022,"_2958":123091},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3475":72479,"_30304":72447,"_20976":123093,"_5":14428,"_27536":123022,"_2958":123094},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3475":72480,"_30304":72447,"_20976":123096,"_5":14428,"_27536":123022,"_2958":123097},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3475":72481,"_30304":72447,"_20976":123099,"_5":14428,"_27536":123022,"_2958":123100},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3475":72482,"_30304":72447,"_20976":123102,"_5":14428,"_27536":123026,"_2958":123103},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3475":72483,"_30304":72447,"_20976":123105,"_5":14428,"_27536":123030,"_2958":123106},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3475":72484,"_30304":72447,"_20976":123108,"_5":14428,"_27536":123030,"_2958":123109},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3475":72485,"_30304":72447,"_20976":123111,"_5":14428,"_27536":123030,"_2958":123112},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3475":72486,"_30304":72447,"_20976":123114,"_5":14428,"_27536":123030,"_2958":123115},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3475":72487,"_30304":72447,"_20976":123117,"_5":14428,"_27536":123030,"_2958":123118},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3475":72488,"_30304":72447,"_20976":123120,"_5":14428,"_27536":123030,"_2958":123121},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3475":72489,"_30304":72447,"_20976":123123,"_5":14428,"_27536":123030,"_2958":123124},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3475":72490,"_30304":72490,"_5":14780,"_2958":123126,"_30657":123127,"_20976":123128,"_27536":72490},"Listas de revocación (CRL)",[49412,118079,54895,122600],[],{"_3475":72491,"_30304":72490,"_20976":123130,"_5":14428,"_27536":72490,"_2958":123131},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3475":72492,"_30304":72490,"_5":30654,"_20976":123133,"_27536":123134,"_2958":123135},[],"/docs/pr-preview/pr-65/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3475":72493,"_30304":72490,"_5":30654,"_20976":123137,"_27536":123138,"_2958":123139},[],"/docs/pr-preview/pr-65/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3475":72494,"_30304":72490,"_5":30654,"_20976":123141,"_27536":123142,"_2958":123143},[],"/docs/pr-preview/pr-65/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3475":72495,"_30304":72490,"_5":30654,"_20976":123145,"_27536":123146,"_2958":123147},[],"/docs/pr-preview/pr-65/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3475":72496,"_30304":72490,"_5":30654,"_20976":123149,"_27536":123150,"_2958":123151},[],"/docs/pr-preview/pr-65/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3475":72497,"_30304":72490,"_5":30654,"_20976":123153,"_27536":123154,"_2958":123155},[],"/docs/pr-preview/pr-65/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3475":72498,"_30304":72490,"_5":30654,"_20976":123157,"_27536":123158,"_2958":123159},[],"/docs/pr-preview/pr-65/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3475":72499,"_30304":72490,"_5":30654,"_20976":123161,"_27536":123162,"_2958":123163},[],"/docs/pr-preview/pr-65/es/platform/pki/crl#referencias","Referencias",{"_3475":72500,"_30304":72490,"_20976":123165,"_5":14428,"_27536":72490,"_2958":123166},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3475":72501,"_30304":72490,"_20976":123168,"_5":14428,"_27536":123134,"_2958":123169},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3475":72502,"_30304":72490,"_20976":123171,"_5":14428,"_27536":123134,"_2958":123172},[],"Campo",{"_3475":72503,"_30304":72490,"_20976":123174,"_5":14428,"_27536":123134,"_2958":119623},[],{"_3475":72504,"_30304":72490,"_20976":123176,"_5":14428,"_27536":123134,"_2958":56116},[],{"_3475":72505,"_30304":72490,"_20976":123178,"_5":14428,"_27536":123134,"_2958":123179},[],"ID de la CA a la que pertenecen los ajustes.",{"_3475":72506,"_30304":72490,"_20976":123181,"_5":14428,"_27536":123134,"_2958":56122},[],{"_3475":72507,"_30304":72490,"_20976":123183,"_5":14428,"_27536":123134,"_2958":123184},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3475":72508,"_30304":72490,"_20976":123186,"_5":14428,"_27536":123134,"_2958":56128},[],{"_3475":72509,"_30304":72490,"_20976":123188,"_5":14428,"_27536":123134,"_2958":123189},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3475":72510,"_30304":72490,"_20976":123191,"_5":14428,"_27536":123134,"_2958":56134},[],{"_3475":72511,"_30304":72490,"_20976":123193,"_5":14428,"_27536":123134,"_2958":123194},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3475":72512,"_30304":72490,"_20976":123196,"_5":14428,"_27536":123134,"_2958":123197},[],"Campo de `crl_options`",{"_3475":72513,"_30304":72490,"_20976":123199,"_5":14428,"_27536":123134,"_2958":119623},[],{"_3475":72514,"_30304":72490,"_20976":123201,"_5":14428,"_27536":123134,"_2958":123202},[],"Valor inicial",{"_3475":72515,"_30304":72490,"_20976":123204,"_5":14428,"_27536":123134,"_2958":56148},[],{"_3475":72516,"_30304":72490,"_20976":123206,"_5":14428,"_27536":123134,"_2958":123207},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3475":72517,"_30304":72490,"_20976":123209,"_5":14428,"_27536":123134,"_2958":123210},[],"7 días.",{"_3475":72518,"_30304":72490,"_20976":123212,"_5":14428,"_27536":123134,"_2958":56157},[],{"_3475":72519,"_30304":72490,"_20976":123214,"_5":14428,"_27536":123134,"_2958":123215},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3475":72520,"_30304":72490,"_20976":123217,"_5":14428,"_27536":123134,"_2958":123218},[],"6 días y 23 horas.",{"_3475":72521,"_30304":72490,"_20976":123220,"_5":14428,"_27536":123134,"_2958":56166},[],{"_3475":72522,"_30304":72490,"_20976":123222,"_5":14428,"_27536":123134,"_2958":123223},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3475":72523,"_30304":72490,"_20976":123225,"_5":14428,"_27536":123134,"_2958":56172},[],{"_3475":72524,"_30304":72490,"_20976":123227,"_5":14428,"_27536":123134,"_2958":56175},[],{"_3475":72525,"_30304":72490,"_20976":123229,"_5":14428,"_27536":123134,"_2958":123230},[],"Número de serie del certificado existente que firma la CRL.",{"_3475":72526,"_30304":72490,"_20976":123232,"_5":14428,"_27536":123134,"_2958":123233},[],"Número de serie del certificado actual de la CA.",{"_3475":72527,"_30304":72490,"_20976":123235,"_5":14428,"_27536":123134,"_2958":123236},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3475":72528,"_30304":72490,"_20976":123238,"_5":14428,"_27536":123134,"_2958":123239},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3475":72529,"_30304":72490,"_20976":123241,"_5":14428,"_27536":123134,"_2958":123242},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3475":72530,"_30304":72490,"_20976":123244,"_5":14428,"_27536":123134,"_2958":123245},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3475":72531,"_30304":72490,"_20976":123247,"_5":14428,"_27536":123134,"_2958":123248},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3475":72532,"_30304":72490,"_20976":123250,"_5":14428,"_27536":123134,"_2958":123251},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3475":72533,"_30304":72490,"_20976":123253,"_5":14428,"_27536":123134,"_2958":123254},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3475":72534,"_30304":72490,"_20976":123256,"_5":14428,"_27536":123134,"_2958":123257},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3475":72535,"_30304":72490,"_20976":123259,"_5":14428,"_27536":123134,"_2958":123260},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3475":72536,"_30304":72490,"_20976":123262,"_5":14428,"_27536":123134,"_2958":123263},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3475":72537,"_30304":72490,"_20976":123265,"_5":14428,"_27536":123134,"_2958":123266},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3475":72538,"_30304":72490,"_20976":123268,"_5":14428,"_27536":123138,"_2958":123269},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3475":72539,"_30304":72490,"_20976":123271,"_5":14428,"_27536":123138,"_2958":123272},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3475":72540,"_30304":72490,"_20976":123274,"_5":14428,"_27536":123138,"_2958":123275},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3475":72541,"_30304":72490,"_20976":123277,"_5":14428,"_27536":123138,"_2958":123278},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3475":72542,"_30304":72490,"_20976":123280,"_5":14428,"_27536":123142,"_2958":123281},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3475":72543,"_30304":72490,"_20976":123283,"_5":14428,"_27536":123142,"_2958":123284},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3475":72544,"_30304":72490,"_20976":123286,"_5":14428,"_27536":123142,"_2958":123287},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3475":72545,"_30304":72490,"_20976":123289,"_5":14428,"_27536":123142,"_2958":123290},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3475":72546,"_30304":72490,"_20976":123292,"_5":14428,"_27536":123142,"_2958":123293},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3475":72547,"_30304":72490,"_20976":123295,"_5":14428,"_27536":123142,"_2958":123296},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3475":72548,"_30304":72490,"_20976":123298,"_5":14428,"_27536":123142,"_2958":123299},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3475":72549,"_30304":72490,"_20976":123301,"_5":14428,"_27536":123142,"_2958":123302},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3475":72550,"_30304":72490,"_20976":123304,"_5":14428,"_27536":123142,"_2958":123305},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3475":72551,"_30304":72490,"_20976":123307,"_5":14428,"_27536":123146,"_2958":123308},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3475":72552,"_30304":72490,"_20976":123310,"_5":14428,"_27536":123146,"_2958":123311},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3475":72553,"_30304":72490,"_20976":123313,"_5":14428,"_27536":123150,"_2958":123314},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3475":72554,"_30304":72490,"_20976":123316,"_5":14428,"_27536":123150,"_2958":123317},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3475":72555,"_30304":72490,"_20976":123319,"_5":14428,"_27536":123150,"_2958":123320},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3475":72556,"_30304":72490,"_20976":123322,"_5":14428,"_27536":123150,"_2958":123323},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3475":72557,"_30304":72490,"_20976":123325,"_5":14428,"_27536":123150,"_2958":123326},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3475":72558,"_30304":72490,"_20976":123328,"_5":14428,"_27536":123154,"_2958":123329},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3475":72559,"_30304":72490,"_20976":123331,"_5":14428,"_27536":123154,"_2958":119812},[],{"_3475":72560,"_30304":72490,"_20976":123333,"_5":14428,"_27536":123154,"_2958":123334},[],"Path relativo",{"_3475":72561,"_30304":72490,"_20976":123336,"_5":14428,"_27536":123154,"_2958":117839},[],{"_3475":72562,"_30304":72490,"_20976":123338,"_5":14428,"_27536":123154,"_2958":56287},[],{"_3475":72563,"_30304":72490,"_20976":123340,"_5":14428,"_27536":123154,"_2958":56290},[],{"_3475":72564,"_30304":72490,"_20976":123342,"_5":14428,"_27536":123154,"_2958":123343},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3475":72565,"_30304":72490,"_20976":123345,"_5":14428,"_27536":123154,"_2958":56287},[],{"_3475":72566,"_30304":72490,"_20976":123347,"_5":14428,"_27536":123154,"_2958":56298},[],{"_3475":72567,"_30304":72490,"_20976":123349,"_5":14428,"_27536":123154,"_2958":123350},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3475":72568,"_30304":72490,"_20976":123352,"_5":14428,"_27536":123154,"_2958":56304},[],{"_3475":72569,"_30304":72490,"_20976":123354,"_5":14428,"_27536":123154,"_2958":56298},[],{"_3475":72570,"_30304":72490,"_20976":123356,"_5":14428,"_27536":123154,"_2958":123357},[],"Sustituir la configuración de CRL de una CA.",{"_3475":72571,"_30304":72490,"_20976":123359,"_5":14428,"_27536":123154,"_2958":56312},[],{"_3475":72572,"_30304":72490,"_20976":123361,"_5":14428,"_27536":123154,"_2958":56298},[],{"_3475":72573,"_30304":72490,"_20976":123363,"_5":14428,"_27536":123154,"_2958":123364},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3475":72574,"_30304":72490,"_20976":123366,"_5":14428,"_27536":123154,"_2958":123367},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3475":72575,"_30304":72490,"_20976":123369,"_5":14428,"_27536":123154,"_2958":123370},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3475":72576,"_30304":72490,"_20976":123372,"_5":14428,"_27536":123154,"_2958":123373},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3475":72577,"_30304":72490,"_20976":123375,"_5":14428,"_27536":123158,"_2958":123376},[],"Síntoma",{"_3475":72578,"_30304":72490,"_20976":123378,"_5":14428,"_27536":123158,"_2958":123379},[],"Causa",{"_3475":72579,"_30304":72490,"_20976":123381,"_5":14428,"_27536":123158,"_2958":123382},[],"Acción",{"_3475":72580,"_30304":72490,"_20976":123384,"_5":14428,"_27536":123158,"_2958":123385},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3475":72581,"_30304":72490,"_20976":123387,"_5":14428,"_27536":123158,"_2958":123388},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3475":72582,"_30304":72490,"_20976":123390,"_5":14428,"_27536":123158,"_2958":123391},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3475":72583,"_30304":72490,"_20976":123393,"_5":14428,"_27536":123158,"_2958":123394},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3475":72584,"_30304":72490,"_20976":123396,"_5":14428,"_27536":123158,"_2958":123397},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3475":72585,"_30304":72490,"_20976":123399,"_5":14428,"_27536":123158,"_2958":123400},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3475":72586,"_30304":72490,"_20976":123402,"_5":14428,"_27536":123158,"_2958":123403},[],"`PUT` devuelve 400.",{"_3475":72587,"_30304":72490,"_20976":123405,"_5":14428,"_27536":123158,"_2958":123406},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3475":72588,"_30304":72490,"_20976":123408,"_5":14428,"_27536":123158,"_2958":123409},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3475":72589,"_30304":72490,"_20976":123411,"_5":14428,"_27536":123158,"_2958":123412},[],"`PUT` devuelve 404.",{"_3475":72590,"_30304":72490,"_20976":123414,"_5":14428,"_27536":123158,"_2958":123415},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3475":72591,"_30304":72490,"_20976":123417,"_5":14428,"_27536":123158,"_2958":123418},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3475":72592,"_30304":72490,"_20976":123420,"_5":14428,"_27536":123158,"_2958":123421},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3475":72593,"_30304":72490,"_20976":123423,"_5":14428,"_27536":123158,"_2958":123424},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3475":72594,"_30304":72490,"_20976":123426,"_5":14428,"_27536":123158,"_2958":123427},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3475":72595,"_30304":72490,"_20976":123429,"_5":14428,"_27536":123158,"_2958":123430},[],"La CRL no cambia tras revocar un certificado.",{"_3475":72596,"_30304":72490,"_20976":123432,"_5":14428,"_27536":123158,"_2958":123433},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3475":72597,"_30304":72490,"_20976":123435,"_5":14428,"_27536":123158,"_2958":123436},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3475":72598,"_30304":72490,"_20976":123438,"_5":14428,"_27536":123158,"_2958":123439},[],"Un verificador rechaza la CRL por el emisor.",{"_3475":72599,"_30304":72490,"_20976":123441,"_5":14428,"_27536":123158,"_2958":123442},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3475":72600,"_30304":72490,"_20976":123444,"_5":14428,"_27536":123158,"_2958":123445},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3475":72601,"_30304":72490,"_20976":123447,"_5":14428,"_27536":123162,"_2958":123448},[],"RFC 5280: perfil X.509 y CRL.",{"_3475":72602,"_30304":72490,"_20976":123450,"_5":14428,"_27536":123162,"_2958":56404},[],{"_3475":72603,"_30304":72490,"_20976":123452,"_5":14428,"_27536":123162,"_2958":56407},[],{"_3475":72604,"_30304":72490,"_20976":123454,"_5":14428,"_27536":123162,"_2958":123455},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":72605,"_30304":72490,"_20976":123457,"_5":14428,"_27536":123162,"_2958":123458},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3475":72606,"_30304":72606,"_5":14780,"_2958":123460,"_30657":123461,"_20976":123462,"_27536":72606},"Claves y motores criptográficos",[49412,118079,54895,121960],[],{"_3475":72607,"_30304":72606,"_20976":123464,"_5":14428,"_27536":72606,"_2958":123465},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3475":72608,"_30304":72606,"_5":30654,"_20976":123467,"_27536":123468,"_2958":123469},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3475":72609,"_30304":72606,"_5":30654,"_20976":123471,"_27536":123472,"_2958":123473},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3475":72610,"_30304":72606,"_5":30654,"_20976":123475,"_27536":123476,"_2958":56432},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#file-system",{"_3475":72611,"_30304":72606,"_5":30654,"_20976":123478,"_27536":123479,"_2958":56436},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#hashicorp-vault",{"_3475":72612,"_30304":72606,"_5":30654,"_20976":123481,"_27536":123482,"_2958":56440},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#aws-secrets-manager",{"_3475":72613,"_30304":72606,"_5":30654,"_20976":123484,"_27536":123485,"_2958":56444},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#aws-kms",{"_3475":72614,"_30304":72606,"_5":30654,"_20976":123487,"_27536":123488,"_2958":56448},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#pkcs11",{"_3475":72615,"_30304":72606,"_5":30654,"_20976":123490,"_27536":123491,"_2958":56452},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#azure-key-vault",{"_3475":72616,"_30304":72606,"_5":30654,"_20976":123493,"_27536":123494,"_2958":123495},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3475":72617,"_30304":72606,"_5":30654,"_20976":123497,"_27536":123498,"_2958":123499},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3475":72618,"_30304":72606,"_5":30654,"_20976":123501,"_27536":123502,"_2958":123503},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3475":72619,"_30304":72606,"_5":30654,"_20976":123505,"_27536":123506,"_2958":123507},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3475":72620,"_30304":72606,"_5":30654,"_20976":123509,"_27536":123510,"_2958":123511},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3475":72621,"_30304":72606,"_5":30654,"_20976":123513,"_27536":123514,"_2958":123515},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3475":72622,"_30304":72606,"_5":30654,"_20976":123517,"_27536":123518,"_2958":123519},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3475":72623,"_30304":72606,"_5":30654,"_20976":123521,"_27536":123522,"_2958":56484},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#sign",{"_3475":72624,"_30304":72606,"_5":30654,"_20976":123524,"_27536":123525,"_2958":56488},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#verify",{"_3475":72625,"_30304":72606,"_5":30654,"_20976":123527,"_27536":123528,"_2958":123529},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3475":72626,"_30304":72606,"_5":30654,"_20976":123531,"_27536":123532,"_2958":123533},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3475":72627,"_30304":72606,"_5":30654,"_20976":123535,"_27536":123536,"_2958":123537},[],"/docs/pr-preview/pr-65/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3475":72628,"_30304":72606,"_20976":123539,"_5":14428,"_27536":72606,"_2958":123540},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3475":72629,"_30304":72606,"_20976":123542,"_5":14428,"_27536":72606,"_2958":123543},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3475":72630,"_30304":72606,"_20976":123545,"_5":14428,"_27536":123468,"_2958":123546},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3475":72631,"_30304":72606,"_20976":123548,"_5":14428,"_27536":123468,"_2958":123549},[],"En la práctica, permite:",{"_3475":72632,"_30304":72606,"_20976":123551,"_5":14428,"_27536":123468,"_2958":123552},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3475":72633,"_30304":72606,"_20976":123554,"_5":14428,"_27536":123468,"_2958":123555},[],"Importar claves creadas externamente.",{"_3475":72634,"_30304":72606,"_20976":123557,"_5":14428,"_27536":123468,"_2958":123558},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3475":72635,"_30304":72606,"_20976":123560,"_5":14428,"_27536":123468,"_2958":123561},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3475":72636,"_30304":72606,"_20976":123563,"_5":14428,"_27536":123472,"_2958":123564},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3475":72637,"_30304":72606,"_20976":123566,"_5":14428,"_27536":123472,"_2958":123567},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3475":72638,"_30304":72606,"_20976":123569,"_5":14428,"_27536":123472,"_2958":123570},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3475":72639,"_30304":72606,"_20976":123572,"_5":14428,"_27536":123476,"_2958":123573},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3475":72640,"_30304":72606,"_20976":123575,"_5":14428,"_27536":123479,"_2958":123576},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3475":72641,"_30304":72606,"_20976":123578,"_5":14428,"_27536":123479,"_2958":123579},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3475":72642,"_30304":72606,"_20976":123581,"_5":14428,"_27536":123482,"_2958":123582},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3475":72643,"_30304":72606,"_20976":123584,"_5":14428,"_27536":123485,"_2958":123585},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3475":72644,"_30304":72606,"_20976":123587,"_5":14428,"_27536":123488,"_2958":123588},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3475":72645,"_30304":72606,"_20976":123590,"_5":14428,"_27536":123491,"_2958":123591},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3475":72646,"_30304":72606,"_20976":123593,"_5":14428,"_27536":123491,"_2958":123594},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3475":72647,"_30304":72606,"_20976":123596,"_5":14428,"_27536":123491,"_2958":123597},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3475":72648,"_30304":72606,"_20976":123599,"_5":14428,"_27536":123491,"_2958":123600},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3475":72649,"_30304":72606,"_20976":123602,"_5":14428,"_27536":123494,"_2958":123603},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3475":72650,"_30304":72606,"_20976":123605,"_5":14428,"_27536":123494,"_2958":123606},[],"La tabla incluye los siguientes campos:",{"_3475":72651,"_30304":72606,"_20976":123608,"_5":14428,"_27536":123494,"_2958":123609},[],"**Name**: nombre descriptivo de la clave.",{"_3475":72652,"_30304":72606,"_20976":123611,"_5":14428,"_27536":123494,"_2958":123612},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3475":72653,"_30304":72606,"_20976":123614,"_5":14428,"_27536":123494,"_2958":123615},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3475":72654,"_30304":72606,"_20976":123617,"_5":14428,"_27536":123494,"_2958":123618},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3475":72655,"_30304":72606,"_20976":123620,"_5":14428,"_27536":123494,"_2958":123621},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3475":72656,"_30304":72606,"_20976":123623,"_5":14428,"_27536":123494,"_2958":123624},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3475":72657,"_30304":72606,"_20976":123626,"_5":14428,"_27536":123494,"_2958":123627},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3475":72658,"_30304":72606,"_20976":123629,"_5":14428,"_27536":123494,"_2958":123630},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3475":72659,"_30304":72606,"_20976":123632,"_5":14428,"_27536":123494,"_2958":123633},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3475":72660,"_30304":72606,"_20976":123635,"_5":14428,"_27536":123494,"_2958":123636},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3475":72661,"_30304":72606,"_20976":123638,"_5":14428,"_27536":123494,"_2958":123639},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3475":72662,"_30304":72606,"_20976":123641,"_5":14428,"_27536":123494,"_2958":123642},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3475":72663,"_30304":72606,"_20976":123644,"_5":14428,"_27536":123494,"_2958":123645},[],"**Delete Key** para eliminar la clave del sistema.",{"_3475":72664,"_30304":72606,"_20976":123647,"_5":14428,"_27536":123498,"_2958":123648},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3475":72665,"_30304":72606,"_20976":123650,"_5":14428,"_27536":123502,"_2958":123651},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3475":72666,"_30304":72606,"_20976":123653,"_5":14428,"_27536":123502,"_2958":123654},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3475":72667,"_30304":72606,"_20976":123656,"_5":14428,"_27536":123502,"_2958":123657},[],"**Key Name**: nombre único y descriptivo.",{"_3475":72668,"_30304":72606,"_20976":123659,"_5":14428,"_27536":123502,"_2958":123660},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3475":72669,"_30304":72606,"_20976":123662,"_5":14428,"_27536":123502,"_2958":123663},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3475":72670,"_30304":72606,"_20976":123665,"_5":14428,"_27536":123502,"_2958":123666},[],"**Tags**: metadatos para clasificar la clave.",{"_3475":72671,"_30304":72606,"_20976":123668,"_5":14428,"_27536":123502,"_2958":123669},[],"**Metadata**: información adicional para usos avanzados.",{"_3475":72672,"_30304":72606,"_20976":123671,"_5":14428,"_27536":123506,"_2958":123672},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3475":72673,"_30304":72606,"_20976":123674,"_5":14428,"_27536":123506,"_2958":123675},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3475":72674,"_30304":72606,"_20976":123677,"_5":14428,"_27536":123506,"_2958":123678},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3475":72675,"_30304":72606,"_20976":123680,"_5":14428,"_27536":123506,"_2958":123681},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3475":72676,"_30304":72606,"_20976":123683,"_5":14428,"_27536":123506,"_2958":123684},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3475":72677,"_30304":72606,"_20976":123686,"_5":14428,"_27536":123506,"_2958":123687},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3475":72678,"_30304":72606,"_20976":123689,"_5":14428,"_27536":123506,"_2958":123690},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3475":72679,"_30304":72606,"_20976":123692,"_5":14428,"_27536":123506,"_2958":123693},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3475":72680,"_30304":72606,"_20976":123695,"_5":14428,"_27536":123506,"_2958":123696},[],"**Metadata**: información adicional opcional.",{"_3475":72681,"_30304":72606,"_20976":123698,"_5":14428,"_27536":123506,"_2958":123699},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3475":72682,"_30304":72606,"_20976":123701,"_5":14428,"_27536":123506,"_2958":123702},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3475":72683,"_30304":72606,"_20976":123704,"_5":14428,"_27536":123510,"_2958":123705},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3475":72684,"_30304":72606,"_20976":123707,"_5":14428,"_27536":123514,"_2958":123708},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3475":72685,"_30304":72606,"_20976":123710,"_5":14428,"_27536":123514,"_2958":123711},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3475":72686,"_30304":72606,"_20976":123713,"_5":14428,"_27536":123514,"_2958":123714},[],"**Key Name**: nombre descriptivo.",{"_3475":72687,"_30304":72606,"_20976":123716,"_5":14428,"_27536":123514,"_2958":123717},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3475":72688,"_30304":72606,"_20976":123719,"_5":14428,"_27536":123514,"_2958":123720},[],"**Tags**: etiquetas asociadas.",{"_3475":72689,"_30304":72606,"_20976":123722,"_5":14428,"_27536":123514,"_2958":123723},[],"**Aliases**: nombres alternativos.",{"_3475":72690,"_30304":72606,"_20976":123725,"_5":14428,"_27536":123514,"_2958":123726},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3475":72691,"_30304":72606,"_20976":123728,"_5":14428,"_27536":123514,"_2958":123729},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3475":72692,"_30304":72606,"_20976":123731,"_5":14428,"_27536":123514,"_2958":123732},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3475":72693,"_30304":72606,"_20976":123734,"_5":14428,"_27536":123514,"_2958":123735},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3475":72694,"_30304":72606,"_20976":123737,"_5":14428,"_27536":123518,"_2958":123738},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3475":72695,"_30304":72606,"_20976":123740,"_5":14428,"_27536":123518,"_2958":123741},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3475":72696,"_30304":72606,"_20976":123743,"_5":14428,"_27536":123518,"_2958":123744},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3475":72697,"_30304":72606,"_20976":123746,"_5":14428,"_27536":123522,"_2958":123747},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3475":72698,"_30304":72606,"_20976":123749,"_5":14428,"_27536":123522,"_2958":123750},[],"Campos principales:",{"_3475":72699,"_30304":72606,"_20976":123752,"_5":14428,"_27536":123522,"_2958":123753},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3475":72700,"_30304":72606,"_20976":123755,"_5":14428,"_27536":123522,"_2958":123756},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3475":72701,"_30304":72606,"_20976":123758,"_5":14428,"_27536":123522,"_2958":123759},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3475":72702,"_30304":72606,"_20976":123761,"_5":14428,"_27536":123522,"_2958":123762},[],"**Message**: contenido que se va a firmar.",{"_3475":72703,"_30304":72606,"_20976":123764,"_5":14428,"_27536":123522,"_2958":123765},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3475":72704,"_30304":72606,"_20976":123767,"_5":14428,"_27536":123525,"_2958":123768},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3475":72705,"_30304":72606,"_20976":123770,"_5":14428,"_27536":123525,"_2958":123750},[],{"_3475":72706,"_30304":72606,"_20976":123772,"_5":14428,"_27536":123525,"_2958":123773},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3475":72707,"_30304":72606,"_20976":123775,"_5":14428,"_27536":123525,"_2958":123776},[],"**Message Type**: `Raw` o `Digest`.",{"_3475":72708,"_30304":72606,"_20976":123778,"_5":14428,"_27536":123525,"_2958":123779},[],"**Payload Encoding**: codificación del mensaje.",{"_3475":72709,"_30304":72606,"_20976":123781,"_5":14428,"_27536":123525,"_2958":123782},[],"**Message**: mensaje original o hash.",{"_3475":72710,"_30304":72606,"_20976":123784,"_5":14428,"_27536":123525,"_2958":123785},[],"**Signature**: firma que se desea comprobar.",{"_3475":72711,"_30304":72606,"_20976":123787,"_5":14428,"_27536":123525,"_2958":123788},[],"**Result**: indicador del resultado de la validación.",{"_3475":72712,"_30304":72606,"_20976":123790,"_5":14428,"_27536":123528,"_2958":123791},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3475":72713,"_30304":72606,"_20976":123793,"_5":14428,"_27536":123528,"_2958":123794},[],"Este flujo es útil para:",{"_3475":72714,"_30304":72606,"_20976":123796,"_5":14428,"_27536":123528,"_2958":123797},[],"Solicitar certificados a una CA externa.",{"_3475":72715,"_30304":72606,"_20976":123799,"_5":14428,"_27536":123528,"_2958":123800},[],"Renovar una identidad manteniendo la misma clave.",{"_3475":72716,"_30304":72606,"_20976":123802,"_5":14428,"_27536":123528,"_2958":123803},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3475":72717,"_30304":72606,"_20976":123805,"_5":14428,"_27536":123528,"_2958":123806},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3475":72718,"_30304":72606,"_20976":123808,"_5":14428,"_27536":123528,"_2958":123809},[],"**Organization (O)**: organización o empresa.",{"_3475":72719,"_30304":72606,"_20976":123811,"_5":14428,"_27536":123528,"_2958":123812},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3475":72720,"_30304":72606,"_20976":123814,"_5":14428,"_27536":123528,"_2958":123815},[],"**Country (C)**: código de país de dos letras.",{"_3475":72721,"_30304":72606,"_20976":123817,"_5":14428,"_27536":123528,"_2958":123818},[],"**State / Province (ST)**: estado o provincia.",{"_3475":72722,"_30304":72606,"_20976":123820,"_5":14428,"_27536":123528,"_2958":123821},[],"**Locality (L)**: ciudad o localidad.",{"_3475":72723,"_30304":72606,"_20976":123823,"_5":14428,"_27536":123528,"_2958":123824},[],"**Email Address**: correo de contacto.",{"_3475":72724,"_30304":72606,"_20976":123826,"_5":14428,"_27536":123528,"_2958":123827},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3475":72725,"_30304":72606,"_20976":123829,"_5":14428,"_27536":123528,"_2958":123830},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3475":72726,"_30304":72606,"_20976":123832,"_5":14428,"_27536":123532,"_2958":123833},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3475":72727,"_30304":72606,"_20976":123835,"_5":14428,"_27536":123532,"_2958":123836},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3475":72728,"_30304":72606,"_20976":123838,"_5":14428,"_27536":123536,"_2958":123839},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3475":72729,"_30304":72606,"_20976":123841,"_5":14428,"_27536":123536,"_2958":123842},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3475":72730,"_30304":72730,"_5":14780,"_2958":123844,"_30657":123845,"_20976":123846,"_27536":72730},"Validación online con OCSP",[49412,118079,54895,122600],[],{"_3475":72731,"_30304":72730,"_20976":123848,"_5":14428,"_27536":72730,"_2958":123849},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3475":72732,"_30304":72730,"_5":30654,"_20976":123851,"_27536":123852,"_2958":123853},[],"/docs/pr-preview/pr-65/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3475":72733,"_30304":72730,"_5":30654,"_20976":123855,"_27536":123856,"_2958":123857},[],"/docs/pr-preview/pr-65/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3475":72734,"_30304":72730,"_5":30654,"_20976":123859,"_27536":123860,"_2958":123861},[],"/docs/pr-preview/pr-65/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3475":72735,"_30304":72730,"_5":30654,"_20976":123863,"_27536":123864,"_2958":123865},[],"/docs/pr-preview/pr-65/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3475":72736,"_30304":72730,"_5":30654,"_20976":123867,"_27536":123868,"_2958":123869},[],"/docs/pr-preview/pr-65/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3475":72737,"_30304":72730,"_5":30654,"_20976":123871,"_27536":123872,"_2958":123163},[],"/docs/pr-preview/pr-65/es/platform/pki/ocsp#referencias",{"_3475":72738,"_30304":72730,"_20976":123874,"_5":14428,"_27536":72730,"_2958":123875},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3475":72739,"_30304":72730,"_20976":123877,"_5":14428,"_27536":123852,"_2958":123878},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3475":72740,"_30304":72730,"_20976":123880,"_5":14428,"_27536":123852,"_2958":123881},[],"Estado del registro",{"_3475":72741,"_30304":72730,"_20976":123883,"_5":14428,"_27536":123852,"_2958":123884},[],"Respuesta firmada",{"_3475":72742,"_30304":72730,"_20976":123886,"_5":14428,"_27536":123852,"_2958":54032},[],{"_3475":72743,"_30304":72730,"_20976":123888,"_5":14428,"_27536":123852,"_2958":56852},[],{"_3475":72744,"_30304":72730,"_20976":123890,"_5":14428,"_27536":123852,"_2958":54049},[],{"_3475":72745,"_30304":72730,"_20976":123892,"_5":14428,"_27536":123852,"_2958":123893},[],"`Revoked`, con razón y fecha de revocación.",{"_3475":72746,"_30304":72730,"_20976":123895,"_5":14428,"_27536":123852,"_2958":123896},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3475":72747,"_30304":72730,"_20976":123898,"_5":14428,"_27536":123852,"_2958":123899},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3475":72748,"_30304":72730,"_20976":123901,"_5":14428,"_27536":123852,"_2958":123902},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3475":72749,"_30304":72730,"_20976":123904,"_5":14428,"_27536":123852,"_2958":123905},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3475":72750,"_30304":72730,"_20976":123907,"_5":14428,"_27536":123852,"_2958":123908},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3475":72751,"_30304":72730,"_20976":123910,"_5":14428,"_27536":123856,"_2958":123911},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3475":72752,"_30304":72730,"_20976":123913,"_5":14428,"_27536":123856,"_2958":123914},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3475":72753,"_30304":72730,"_20976":123916,"_5":14428,"_27536":123860,"_2958":123917},[],"El servicio acepta:",{"_3475":72754,"_30304":72730,"_20976":123919,"_5":14428,"_27536":123860,"_2958":119812},[],{"_3475":72755,"_30304":72730,"_20976":123921,"_5":14428,"_27536":123860,"_2958":123922},[],"Ruta del servicio VA",{"_3475":72756,"_30304":72730,"_20976":123924,"_5":14428,"_27536":123860,"_2958":123925},[],"Formato",{"_3475":72757,"_30304":72730,"_20976":123927,"_5":14428,"_27536":123860,"_2958":56892},[],{"_3475":72758,"_30304":72730,"_20976":123929,"_5":14428,"_27536":123860,"_2958":56895},[],{"_3475":72759,"_30304":72730,"_20976":123931,"_5":14428,"_27536":123860,"_2958":123932},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3475":72760,"_30304":72730,"_20976":123934,"_5":14428,"_27536":123860,"_2958":56287},[],{"_3475":72761,"_30304":72730,"_20976":123936,"_5":14428,"_27536":123860,"_2958":56903},[],{"_3475":72762,"_30304":72730,"_20976":123938,"_5":14428,"_27536":123860,"_2958":123939},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3475":72763,"_30304":72730,"_20976":123941,"_5":14428,"_27536":123860,"_2958":123942},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3475":72764,"_30304":72730,"_20976":123944,"_5":14428,"_27536":123864,"_2958":123945},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3475":72765,"_30304":72730,"_20976":123947,"_5":14428,"_27536":123864,"_2958":123948},[],"Genera la solicitud:",{"_3475":72766,"_30304":72730,"_20976":123950,"_5":14428,"_27536":123864,"_2958":123951},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3475":72767,"_30304":72730,"_20976":123953,"_5":14428,"_27536":123864,"_2958":123954},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3475":72768,"_30304":72730,"_20976":123956,"_5":14428,"_27536":123864,"_2958":123957},[],"Verifica el DER recibido:",{"_3475":72769,"_30304":72730,"_20976":123959,"_5":14428,"_27536":123864,"_2958":123960},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3475":72770,"_30304":72730,"_20976":123962,"_5":14428,"_27536":123868,"_2958":123963},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3475":72771,"_30304":72730,"_20976":123965,"_5":14428,"_27536":123868,"_2958":123966},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3475":72772,"_30304":72730,"_20976":123968,"_5":14428,"_27536":123872,"_2958":56936},[],{"_3475":72773,"_30304":72730,"_20976":123970,"_5":14428,"_27536":123872,"_2958":56939},[],{"_3475":72774,"_30304":72730,"_20976":123972,"_5":14428,"_27536":123872,"_2958":123973},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3475":72775,"_30304":72730,"_20976":123975,"_5":14428,"_27536":123872,"_2958":123458},[],{"_3475":72776,"_30304":72776,"_5":14780,"_2958":54895,"_30657":123977,"_20976":123978,"_27536":72776},[49412,118079,54895],[],{"_3475":72777,"_30304":72776,"_20976":123980,"_5":14428,"_27536":72776,"_2958":123981},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3475":72778,"_30304":72776,"_5":30654,"_20976":123983,"_27536":123984,"_2958":121286},[],"/docs/pr-preview/pr-65/es/platform/pki/overview#empieza-aquí",{"_3475":72779,"_30304":72776,"_5":30654,"_20976":123986,"_27536":123987,"_2958":123988},[],"/docs/pr-preview/pr-65/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3475":72780,"_30304":72776,"_5":30654,"_20976":123990,"_27536":123991,"_2958":121806},[],"/docs/pr-preview/pr-65/es/platform/pki/overview#capacidades-principales",{"_3475":72781,"_30304":72776,"_5":30654,"_20976":123993,"_27536":123994,"_2958":121810},[],"/docs/pr-preview/pr-65/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3475":72782,"_30304":72776,"_5":30654,"_20976":123996,"_27536":123997,"_2958":121814},[],"/docs/pr-preview/pr-65/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3475":72783,"_30304":72776,"_5":30654,"_20976":123999,"_27536":124000,"_2958":121818},[],"/docs/pr-preview/pr-65/es/platform/pki/overview#emite-y-controla-certificados",{"_3475":72784,"_30304":72776,"_5":30654,"_20976":124002,"_27536":124003,"_2958":121826},[],"/docs/pr-preview/pr-65/es/platform/pki/overview#publica-el-estado-de-validación",{"_3475":72785,"_30304":72776,"_5":30654,"_20976":124005,"_27536":124006,"_2958":124007},[],"/docs/pr-preview/pr-65/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3475":72786,"_30304":72776,"_5":30654,"_20976":124009,"_27536":124010,"_2958":122766},[],"/docs/pr-preview/pr-65/es/platform/pki/overview#continúa",{"_3475":72787,"_30304":72776,"_20976":124012,"_5":14428,"_27536":72776,"_2958":124013},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3475":72788,"_30304":72776,"_20976":124015,"_5":14428,"_27536":123984,"_2958":124016},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3475":72789,"_30304":72776,"_20976":124018,"_5":14428,"_27536":123984,"_2958":124019},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3475":72790,"_30304":72776,"_20976":124021,"_5":14428,"_27536":123987,"_2958":124022},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3475":72791,"_30304":72776,"_20976":124024,"_5":14428,"_27536":123987,"_2958":124025},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3475":72792,"_30304":72776,"_20976":124027,"_5":14428,"_27536":123987,"_2958":124028},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3475":72793,"_30304":72776,"_20976":124030,"_5":14428,"_27536":123987,"_2958":124031},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3475":72794,"_30304":72776,"_20976":124033,"_5":14428,"_27536":123987,"_2958":124034},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3475":72795,"_30304":72776,"_20976":124036,"_5":14428,"_27536":123994,"_2958":124037},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3475":72796,"_30304":72776,"_20976":124039,"_5":14428,"_27536":123997,"_2958":124040},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3475":72797,"_30304":72776,"_20976":124042,"_5":14428,"_27536":124000,"_2958":124043},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3475":72798,"_30304":72776,"_20976":124045,"_5":14428,"_27536":124003,"_2958":124046},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3475":72799,"_30304":72776,"_20976":124048,"_5":14428,"_27536":124006,"_2958":124049},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3475":72800,"_30304":72776,"_20976":124051,"_5":14428,"_27536":124006,"_2958":124052},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3475":72801,"_30304":72776,"_20976":124054,"_5":14428,"_27536":124006,"_2958":124055},[],"su clave pública corresponda a la clave privada del cliente;",{"_3475":72802,"_30304":72776,"_20976":124057,"_5":14428,"_27536":124006,"_2958":124058},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3475":72803,"_30304":72776,"_20976":124060,"_5":14428,"_27536":124006,"_2958":124061},[],"sus fechas y usos permitan la operación;",{"_3475":72804,"_30304":72776,"_20976":124063,"_5":14428,"_27536":124006,"_2958":124064},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3475":72805,"_30304":72776,"_20976":124066,"_5":14428,"_27536":124006,"_2958":124067},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3475":72806,"_30304":72776,"_20976":124069,"_5":14428,"_27536":124010,"_2958":124070},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3475":72807,"_30304":72776,"_20976":124072,"_5":14428,"_27536":124010,"_2958":124073},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3475":72808,"_30304":72776,"_20976":124075,"_5":14428,"_27536":124010,"_2958":124076},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3475":72809,"_30304":72809,"_5":14780,"_2958":124078,"_30657":124079,"_20976":124080,"_27536":72809},"Crea tu primera CA",[49412,118079,54895,121410],[],{"_3475":72810,"_30304":72809,"_20976":124082,"_5":14428,"_27536":72809,"_2958":124083},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3475":72811,"_30304":72809,"_5":30654,"_20976":124085,"_27536":124086,"_2958":116650},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3475":72812,"_30304":72809,"_5":30654,"_20976":124088,"_27536":124089,"_2958":124090},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3475":72813,"_30304":72809,"_5":30654,"_20976":124092,"_27536":124093,"_2958":124094},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3475":72814,"_30304":72809,"_5":30654,"_20976":124096,"_27536":124097,"_2958":124098},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3475":72815,"_30304":72809,"_5":30654,"_20976":124100,"_27536":124101,"_2958":124102},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3475":72816,"_30304":72809,"_5":30654,"_20976":124104,"_27536":124105,"_2958":124106},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3475":72817,"_30304":72809,"_5":30654,"_20976":124108,"_27536":124109,"_2958":124110},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3475":72818,"_30304":72809,"_5":30654,"_20976":124112,"_27536":124113,"_2958":121657},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3475":72819,"_30304":72809,"_5":30654,"_20976":124115,"_27536":124116,"_2958":116674},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3475":72820,"_30304":72809,"_20976":124118,"_5":14428,"_27536":72809,"_2958":124119},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3475":72821,"_30304":72809,"_20976":124121,"_5":14428,"_27536":124086,"_2958":124122},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3475":72822,"_30304":72809,"_20976":124124,"_5":14428,"_27536":124086,"_2958":124125},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3475":72823,"_30304":72809,"_20976":124127,"_5":14428,"_27536":124086,"_2958":124128},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3475":72824,"_30304":72809,"_20976":124130,"_5":14428,"_27536":124086,"_2958":124131},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3475":72825,"_30304":72809,"_20976":124133,"_5":14428,"_27536":124089,"_2958":124134},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3475":72826,"_30304":72809,"_20976":124136,"_5":14428,"_27536":124089,"_2958":124137},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3475":72827,"_30304":72809,"_20976":124139,"_5":14428,"_27536":124093,"_2958":124140},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3475":72828,"_30304":72809,"_20976":124142,"_5":14428,"_27536":124093,"_2958":124143},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3475":72829,"_30304":72809,"_20976":124145,"_5":14428,"_27536":124097,"_2958":124146},[],"Selecciona **Root CA** y completa:",{"_3475":72830,"_30304":72809,"_20976":124148,"_5":14428,"_27536":124097,"_2958":57118},[],{"_3475":72831,"_30304":72809,"_20976":124150,"_5":14428,"_27536":124097,"_2958":124151},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3475":72832,"_30304":72809,"_20976":124153,"_5":14428,"_27536":124097,"_2958":124154},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3475":72833,"_30304":72809,"_20976":124156,"_5":14428,"_27536":124097,"_2958":124157},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3475":72834,"_30304":72809,"_20976":124159,"_5":14428,"_27536":124097,"_2958":124160},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3475":72835,"_30304":72809,"_20976":124162,"_5":14428,"_27536":124101,"_2958":124163},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3475":72836,"_30304":72809,"_20976":124165,"_5":14428,"_27536":124105,"_2958":124166},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3475":72837,"_30304":72809,"_20976":124168,"_5":14428,"_27536":124105,"_2958":124169},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3475":72838,"_30304":72809,"_20976":124171,"_5":14428,"_27536":124109,"_2958":124172},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3475":72839,"_30304":72809,"_20976":124174,"_5":14428,"_27536":124109,"_2958":124175},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3475":72840,"_30304":72809,"_20976":124177,"_5":14428,"_27536":124109,"_2958":124178},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3475":72841,"_30304":72809,"_20976":124180,"_5":14428,"_27536":124113,"_2958":124181},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3475":72842,"_30304":72809,"_20976":124183,"_5":14428,"_27536":124113,"_2958":124184},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3475":72843,"_30304":72809,"_20976":124186,"_5":14428,"_27536":124113,"_2958":124187},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3475":72844,"_30304":72809,"_20976":124189,"_5":14428,"_27536":124113,"_2958":124190},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3475":72845,"_30304":72809,"_20976":124192,"_5":14428,"_27536":124116,"_2958":124193},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3475":72846,"_30304":72846,"_5":14780,"_2958":124195,"_30657":124196,"_20976":124197,"_27536":72846},"Emite y verifica un certificado",[49412,118079,54895,121410],[],{"_3475":72847,"_30304":72846,"_20976":124199,"_5":14428,"_27536":72846,"_2958":124200},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3475":72848,"_30304":72846,"_5":30654,"_20976":124202,"_27536":124203,"_2958":116650},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3475":72849,"_30304":72846,"_5":30654,"_20976":124205,"_27536":124206,"_2958":124207},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3475":72850,"_30304":72846,"_5":30654,"_20976":124209,"_27536":124210,"_2958":124211},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3475":72851,"_30304":72846,"_5":30654,"_20976":124213,"_27536":124214,"_2958":124215},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3475":72852,"_30304":72846,"_5":30654,"_20976":124217,"_27536":124218,"_2958":124219},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3475":72853,"_30304":72846,"_5":30654,"_20976":124221,"_27536":124222,"_2958":124223},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3475":72854,"_30304":72846,"_5":30654,"_20976":124225,"_27536":124226,"_2958":124227},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3475":72855,"_30304":72846,"_5":30654,"_20976":124229,"_27536":124230,"_2958":124231},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3475":72856,"_30304":72846,"_5":30654,"_20976":124233,"_27536":124234,"_2958":124235},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3475":72857,"_30304":72846,"_5":30654,"_20976":124237,"_27536":124238,"_2958":124239},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3475":72858,"_30304":72846,"_5":30654,"_20976":124241,"_27536":124242,"_2958":121657},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3475":72859,"_30304":72846,"_5":30654,"_20976":124244,"_27536":124245,"_2958":116674},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3475":72860,"_30304":72846,"_20976":124247,"_5":14428,"_27536":72846,"_2958":124248},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3475":72861,"_30304":72846,"_20976":124250,"_5":14428,"_27536":124203,"_2958":124251},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3475":72862,"_30304":72846,"_20976":124253,"_5":14428,"_27536":124203,"_2958":124254},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3475":72863,"_30304":72846,"_20976":124256,"_5":14428,"_27536":124203,"_2958":124257},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3475":72864,"_30304":72846,"_20976":124259,"_5":14428,"_27536":124203,"_2958":124260},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3475":72865,"_30304":72846,"_20976":124262,"_5":14428,"_27536":124203,"_2958":124263},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3475":72866,"_30304":72846,"_20976":124265,"_5":14428,"_27536":124206,"_2958":124266},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3475":72867,"_30304":72846,"_20976":124268,"_5":14428,"_27536":124210,"_2958":124269},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3475":72868,"_30304":72846,"_20976":124271,"_5":14428,"_27536":124210,"_2958":124272},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3475":72869,"_30304":72846,"_20976":124274,"_5":14428,"_27536":124214,"_2958":124275},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3475":72870,"_30304":72846,"_20976":124277,"_5":14428,"_27536":124214,"_2958":124278},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3475":72871,"_30304":72846,"_20976":124280,"_5":14428,"_27536":124218,"_2958":124281},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3475":72872,"_30304":72846,"_20976":124283,"_5":14428,"_27536":124218,"_2958":124284},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3475":72873,"_30304":72846,"_20976":124286,"_5":14428,"_27536":124222,"_2958":124287},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3475":72874,"_30304":72846,"_20976":124289,"_5":14428,"_27536":124226,"_2958":124290},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3475":72875,"_30304":72846,"_20976":124292,"_5":14428,"_27536":124230,"_2958":124293},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3475":72876,"_30304":72846,"_20976":124295,"_5":14428,"_27536":124234,"_2958":124296},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3475":72877,"_30304":72846,"_20976":124298,"_5":14428,"_27536":124234,"_2958":124299},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3475":72878,"_30304":72846,"_20976":124301,"_5":14428,"_27536":124234,"_2958":124302},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3475":72879,"_30304":72846,"_20976":124304,"_5":14428,"_27536":124238,"_2958":124305},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3475":72880,"_30304":72846,"_20976":124307,"_5":14428,"_27536":124238,"_2958":124308},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3475":72881,"_30304":72846,"_20976":124310,"_5":14428,"_27536":124238,"_2958":124311},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3475":72882,"_30304":72846,"_20976":124313,"_5":14428,"_27536":124242,"_2958":121740},[],{"_3475":72883,"_30304":72846,"_20976":124315,"_5":14428,"_27536":124242,"_2958":120261},[],{"_3475":72884,"_30304":72846,"_20976":124317,"_5":14428,"_27536":124242,"_2958":124318},[],"La CA rechaza la emisión",{"_3475":72885,"_30304":72846,"_20976":124320,"_5":14428,"_27536":124242,"_2958":124321},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3475":72886,"_30304":72846,"_20976":124323,"_5":14428,"_27536":124242,"_2958":124324},[],"Sujeto o usos diferentes",{"_3475":72887,"_30304":72846,"_20976":124326,"_5":14428,"_27536":124242,"_2958":124327},[],"Perfil aplicado y valores solicitados.",{"_3475":72888,"_30304":72846,"_20976":124329,"_5":14428,"_27536":124242,"_2958":124330},[],"No se encuentra el emisor",{"_3475":72889,"_30304":72846,"_20976":124332,"_5":14428,"_27536":124242,"_2958":124333},[],"CA descargada y cadena intermedia necesaria.",{"_3475":72890,"_30304":72846,"_20976":124335,"_5":14428,"_27536":124242,"_2958":124336},[],"Falla la vigencia",{"_3475":72891,"_30304":72846,"_20976":124338,"_5":14428,"_27536":124242,"_2958":124339},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3475":72892,"_30304":72846,"_20976":124341,"_5":14428,"_27536":124242,"_2958":124342},[],"Los resúmenes de clave difieren",{"_3475":72893,"_30304":72846,"_20976":124344,"_5":14428,"_27536":124242,"_2958":124345},[],"Archivos de certificado y clave de la misma emisión.",{"_3475":72894,"_30304":72846,"_20976":124347,"_5":14428,"_27536":124242,"_2958":124348},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3475":72895,"_30304":72846,"_20976":124350,"_5":14428,"_27536":124245,"_2958":124351},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3475":72896,"_30304":72846,"_20976":124353,"_5":14428,"_27536":124245,"_2958":124354},[],"Gestionar certificados para inspección, estado y revocación.",{"_3475":72897,"_30304":72846,"_20976":124356,"_5":14428,"_27536":124245,"_2958":124357},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3475":72898,"_30304":72846,"_20976":124359,"_5":14428,"_27536":124245,"_2958":124360},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3475":72899,"_30304":72846,"_20976":124362,"_5":14428,"_27536":124245,"_2958":124363},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3475":72900,"_30304":72900,"_5":14780,"_2958":124365,"_30657":124366,"_20976":124367,"_27536":72900},"Primeros pasos de PKI",[49412,118079,54895,121410],[],{"_3475":72901,"_30304":72900,"_20976":124369,"_5":14428,"_27536":72900,"_2958":124370},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3475":72902,"_30304":72900,"_5":30654,"_20976":124372,"_27536":124373,"_2958":116650},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3475":72903,"_30304":72900,"_5":30654,"_20976":124375,"_27536":124376,"_2958":124377},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3475":72904,"_30304":72900,"_5":30654,"_20976":124379,"_27536":124380,"_2958":121592},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3475":72905,"_30304":72900,"_5":30654,"_20976":124382,"_27536":124383,"_2958":124384},[],"/docs/pr-preview/pr-65/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3475":72906,"_30304":72900,"_20976":124386,"_5":14428,"_27536":72900,"_2958":124387},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3475":72907,"_30304":72900,"_20976":124389,"_5":14428,"_27536":124373,"_2958":124390},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3475":72908,"_30304":72900,"_20976":124392,"_5":14428,"_27536":124373,"_2958":124393},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3475":72909,"_30304":72900,"_20976":124395,"_5":14428,"_27536":124373,"_2958":124396},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3475":72910,"_30304":72900,"_20976":124398,"_5":14428,"_27536":124373,"_2958":124399},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3475":72911,"_30304":72900,"_20976":124401,"_5":14428,"_27536":124373,"_2958":124402},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3475":72912,"_30304":72900,"_20976":124404,"_5":14428,"_27536":124376,"_2958":124405},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3475":72913,"_30304":72900,"_20976":124407,"_5":14428,"_27536":124376,"_2958":124408},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3475":72914,"_30304":72900,"_20976":124410,"_5":14428,"_27536":124376,"_2958":124411},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3475":72915,"_30304":72900,"_20976":124413,"_5":14428,"_27536":124376,"_2958":124414},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3475":72916,"_30304":72900,"_20976":124416,"_5":14428,"_27536":124380,"_2958":124417},[],"Archivo o recurso",{"_3475":72917,"_30304":72900,"_20976":124419,"_5":14428,"_27536":124380,"_2958":121589},[],{"_3475":72918,"_30304":72900,"_20976":124421,"_5":14428,"_27536":124380,"_2958":124422},[],"CA raíz activa y `ca.pem`",{"_3475":72919,"_30304":72900,"_20976":124424,"_5":14428,"_27536":124380,"_2958":124425},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3475":72920,"_30304":72900,"_20976":124427,"_5":14428,"_27536":124380,"_2958":124428},[],"Certificado final y `device.crt`",{"_3475":72921,"_30304":72900,"_20976":124430,"_5":14428,"_27536":124380,"_2958":124431},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3475":72922,"_30304":72900,"_20976":124433,"_5":14428,"_27536":124380,"_2958":124434},[],"Clave privada `device.key`",{"_3475":72923,"_30304":72900,"_20976":124436,"_5":14428,"_27536":124380,"_2958":124437},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3475":72924,"_30304":72900,"_20976":124439,"_5":14428,"_27536":124380,"_2958":124440},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3475":72925,"_30304":72900,"_20976":124442,"_5":14428,"_27536":124383,"_2958":124443},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3475":72926,"_30304":72900,"_20976":124445,"_5":14428,"_27536":124383,"_2958":124446},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3475":72927,"_30304":72900,"_20976":124448,"_5":14428,"_27536":124383,"_2958":124449},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3475":72928,"_30304":72928,"_5":14780,"_2958":124451,"_30657":124452,"_20976":124454,"_27536":72928},"Resolución de problemas PKI",[49412,118079,54895,124453],"Resolución de problemas",[],{"_3475":72929,"_30304":72928,"_20976":124456,"_5":14428,"_27536":72928,"_2958":124457},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3475":72930,"_30304":72928,"_5":30654,"_20976":124459,"_27536":124460,"_2958":124461},[],"/docs/pr-preview/pr-65/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3475":72931,"_30304":72928,"_5":30654,"_20976":124463,"_27536":124464,"_2958":124465},[],"/docs/pr-preview/pr-65/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3475":72932,"_30304":72928,"_5":30654,"_20976":124467,"_27536":124468,"_2958":124469},[],"/docs/pr-preview/pr-65/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3475":72933,"_30304":72928,"_20976":124471,"_5":14428,"_27536":72928,"_2958":124472},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3475":72934,"_30304":72928,"_20976":124474,"_5":14428,"_27536":72928,"_2958":124475},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3475":72935,"_30304":72928,"_20976":124477,"_5":14428,"_27536":124460,"_2958":121589},[],{"_3475":72936,"_30304":72928,"_20976":124479,"_5":14428,"_27536":124460,"_2958":120261},[],{"_3475":72937,"_30304":72928,"_20976":124481,"_5":14428,"_27536":124460,"_2958":116674},[],{"_3475":72938,"_30304":72928,"_20976":124483,"_5":14428,"_27536":124460,"_2958":53737},[],{"_3475":72939,"_30304":72928,"_20976":124485,"_5":14428,"_27536":124460,"_2958":124486},[],"Existe, está activa y sus fechas son utilizables.",{"_3475":72940,"_30304":72928,"_20976":124488,"_5":14428,"_27536":124460,"_2958":124489},[],"Autoridades.",{"_3475":72941,"_30304":72928,"_20976":124491,"_5":14428,"_27536":124460,"_2958":124492},[],"Clave",{"_3475":72942,"_30304":72928,"_20976":124494,"_5":14428,"_27536":124460,"_2958":124495},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3475":72943,"_30304":72928,"_20976":124497,"_5":14428,"_27536":124460,"_2958":124498},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3475":72944,"_30304":72928,"_20976":124500,"_5":14428,"_27536":124460,"_2958":57472},[],{"_3475":72945,"_30304":72928,"_20976":124502,"_5":14428,"_27536":124460,"_2958":124503},[],"PEM correcto y firma verificable.",{"_3475":72946,"_30304":72928,"_20976":124505,"_5":14428,"_27536":124460,"_2958":57478},[],{"_3475":72947,"_30304":72928,"_20976":124507,"_5":14428,"_27536":124460,"_2958":124508},[],"Perfil",{"_3475":72948,"_30304":72928,"_20976":124510,"_5":14428,"_27536":124460,"_2958":124511},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3475":72949,"_30304":72928,"_20976":124513,"_5":14428,"_27536":124460,"_2958":124514},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3475":72950,"_30304":72928,"_20976":124516,"_5":14428,"_27536":124460,"_2958":121740},[],{"_3475":72951,"_30304":72928,"_20976":124518,"_5":14428,"_27536":124460,"_2958":124519},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3475":72952,"_30304":72928,"_20976":124521,"_5":14428,"_27536":124460,"_2958":124522},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3475":72953,"_30304":72928,"_20976":124524,"_5":14428,"_27536":124460,"_2958":124525},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3475":72954,"_30304":72928,"_20976":124527,"_5":14428,"_27536":124460,"_2958":124528},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3475":72955,"_30304":72928,"_20976":124530,"_5":14428,"_27536":124464,"_2958":124531},[],"Revisa cada frontera por separado:",{"_3475":72956,"_30304":72928,"_20976":124533,"_5":14428,"_27536":124464,"_2958":124534},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3475":72957,"_30304":72928,"_20976":124536,"_5":14428,"_27536":124464,"_2958":124537},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3475":72958,"_30304":72928,"_20976":124539,"_5":14428,"_27536":124464,"_2958":124540},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3475":72959,"_30304":72928,"_20976":124542,"_5":14428,"_27536":124464,"_2958":124543},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3475":72960,"_30304":72928,"_20976":124545,"_5":14428,"_27536":124464,"_2958":124546},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3475":72961,"_30304":72928,"_20976":124548,"_5":14428,"_27536":124464,"_2958":124549},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3475":72962,"_30304":72928,"_20976":124551,"_5":14428,"_27536":124468,"_2958":124552},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3475":72963,"_30304":72928,"_20976":124554,"_5":14428,"_27536":124468,"_2958":124555},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3475":72964,"_30304":72964,"_5":14780,"_2958":124557,"_30657":124558,"_20976":124559,"_27536":72964},"Seguridad",[49412],[],{"_3475":72965,"_30304":72964,"_20976":124561,"_5":14428,"_27536":72964,"_2958":124562},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3475":72966,"_30304":72964,"_5":30654,"_20976":124564,"_27536":124565,"_2958":124566},[],"/docs/pr-preview/pr-65/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3475":72967,"_30304":72964,"_5":30654,"_20976":124568,"_27536":124569,"_2958":124570},[],"/docs/pr-preview/pr-65/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3475":72968,"_30304":72964,"_5":30654,"_20976":124572,"_27536":124573,"_2958":124574},[],"/docs/pr-preview/pr-65/es/security#versiones-soportadas","Versiones soportadas",{"_3475":72969,"_30304":72964,"_5":30654,"_20976":124576,"_27536":124577,"_2958":124578},[],"/docs/pr-preview/pr-65/es/security#divulgación-responsable","Divulgación responsable",{"_3475":72970,"_30304":72964,"_20976":124580,"_5":14428,"_27536":72964,"_2958":124581},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3475":72971,"_30304":72964,"_20976":124583,"_5":14428,"_27536":124565,"_2958":124584},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3475":72972,"_30304":72964,"_20976":124586,"_5":14428,"_27536":124565,"_2958":124587},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3475":72973,"_30304":72964,"_20976":124589,"_5":14428,"_27536":124565,"_2958":15047},[],{"_3475":72974,"_30304":72964,"_20976":124591,"_5":14428,"_27536":124565,"_2958":14987},[],{"_3475":72975,"_30304":72964,"_20976":124593,"_5":14428,"_27536":124565,"_2958":15034},[],{"_3475":72976,"_30304":72964,"_20976":124595,"_5":14428,"_27536":124565,"_2958":124596},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3475":72977,"_30304":72964,"_20976":124598,"_5":14428,"_27536":124565,"_2958":124599},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3475":72978,"_30304":72964,"_20976":124601,"_5":14428,"_27536":124569,"_2958":124602},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3475":72979,"_30304":72964,"_20976":124604,"_5":14428,"_27536":124569,"_2958":124605},[],"No incluyas en el reporte:",{"_3475":72980,"_30304":72964,"_20976":124607,"_5":14428,"_27536":124569,"_2958":124608},[],"Credenciales, tokens o claves privadas",{"_3475":72981,"_30304":72964,"_20976":124610,"_5":14428,"_27536":124569,"_2958":124611},[],"Datos de clientes o información identificable de clientes",{"_3475":72982,"_30304":72964,"_20976":124613,"_5":14428,"_27536":124569,"_2958":124614},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3475":72983,"_30304":72964,"_20976":124616,"_5":14428,"_27536":124573,"_2958":124617},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3475":72984,"_30304":72964,"_20976":124619,"_5":14428,"_27536":124573,"_2958":124620},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3475":72985,"_30304":72964,"_20976":124622,"_5":14428,"_27536":124577,"_2958":124623},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3475":72986,"_30304":72964,"_20976":124625,"_5":14428,"_27536":124577,"_2958":124626},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3475":72987,"_30304":72964,"_20976":124628,"_5":14428,"_27536":124577,"_2958":124629},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3475":72988,"_30304":72964,"_20976":124631,"_5":14428,"_27536":124577,"_2958":124632},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3475":72989,"_30304":72964,"_20976":124634,"_5":14428,"_27536":124577,"_2958":124635},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3475":72990,"_30304":72990,"_5":14780,"_2958":124637,"_30657":124638,"_20976":124640,"_27536":72990},"3.8.0 a 4.0.0",[49412,124639],"Actualizaciones",[],{"_3475":72991,"_30304":72990,"_20976":124642,"_5":14428,"_27536":72990,"_2958":124643},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3475":72992,"_30304":72990,"_5":30654,"_20976":124645,"_27536":124646,"_2958":124647},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3475":72993,"_30304":72990,"_5":30654,"_20976":124649,"_27536":124650,"_2958":124651},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3475":72994,"_30304":72990,"_5":30654,"_20976":124653,"_27536":124654,"_2958":124655},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3475":72995,"_30304":72990,"_5":30654,"_20976":124657,"_27536":124658,"_2958":124659},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3475":72996,"_30304":72990,"_5":30654,"_20976":124661,"_27536":124662,"_2958":124663},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3475":72997,"_30304":72990,"_5":30654,"_20976":124665,"_27536":124666,"_2958":124667},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3475":72998,"_30304":72990,"_5":30654,"_20976":124669,"_27536":124670,"_2958":57644},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3475":72999,"_30304":72990,"_5":30654,"_20976":124672,"_27536":124673,"_2958":124674},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3475":73000,"_30304":72990,"_5":30654,"_20976":124676,"_27536":124677,"_2958":124678},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3475":73001,"_30304":72990,"_5":30654,"_20976":124680,"_27536":124681,"_2958":124682},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3475":73002,"_30304":72990,"_5":30654,"_20976":124684,"_27536":124685,"_2958":124686},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3475":73003,"_30304":72990,"_5":30654,"_20976":124688,"_27536":124689,"_2958":124690},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3475":73004,"_30304":72990,"_5":30654,"_20976":124692,"_27536":124693,"_2958":124694},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3475":73005,"_30304":72990,"_5":30654,"_20976":124696,"_27536":124697,"_2958":124698},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3475":73006,"_30304":72990,"_5":30654,"_20976":124700,"_27536":124701,"_2958":124702},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3475":73007,"_30304":72990,"_5":30654,"_20976":124704,"_27536":124705,"_2958":124706},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3475":73008,"_30304":72990,"_5":30654,"_20976":124708,"_27536":124709,"_2958":124710},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3475":73009,"_30304":72990,"_5":30654,"_20976":124712,"_27536":124713,"_2958":124714},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3475":73010,"_30304":72990,"_5":30654,"_20976":124716,"_27536":124717,"_2958":124718},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3475":73011,"_30304":72990,"_5":30654,"_20976":124720,"_27536":124721,"_2958":124722},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3475":73012,"_30304":72990,"_5":30654,"_20976":124724,"_27536":124725,"_2958":124726},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3475":73013,"_30304":72990,"_5":30654,"_20976":124728,"_27536":124729,"_2958":124730},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3475":73014,"_30304":72990,"_5":30654,"_20976":124732,"_27536":124733,"_2958":124734},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3475":73015,"_30304":72990,"_5":30654,"_20976":124736,"_27536":124737,"_2958":124738},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3475":73016,"_30304":72990,"_5":30654,"_20976":124740,"_27536":124741,"_2958":124742},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3475":73017,"_30304":72990,"_5":30654,"_20976":124744,"_27536":124745,"_2958":124746},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3475":73018,"_30304":72990,"_5":30654,"_20976":124748,"_27536":124749,"_2958":124750},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3475":73019,"_30304":72990,"_5":30654,"_20976":124752,"_27536":124753,"_2958":124754},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3475":73020,"_30304":72990,"_5":30654,"_20976":124756,"_27536":124757,"_2958":124758},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3475":73021,"_30304":72990,"_5":30654,"_20976":124760,"_27536":124761,"_2958":124762},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3475":73022,"_30304":72990,"_5":30654,"_20976":124764,"_27536":124765,"_2958":124766},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3475":73023,"_30304":72990,"_5":30654,"_20976":124768,"_27536":124769,"_2958":124770},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3475":73024,"_30304":72990,"_5":30654,"_20976":124772,"_27536":124773,"_2958":124774},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3475":73025,"_30304":72990,"_5":30654,"_20976":124776,"_27536":124777,"_2958":124778},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3475":73026,"_30304":72990,"_5":30654,"_20976":124780,"_27536":124781,"_2958":124782},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3475":73027,"_30304":72990,"_5":30654,"_20976":124784,"_27536":124785,"_2958":124786},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3475":73028,"_30304":72990,"_5":30654,"_20976":124788,"_27536":124789,"_2958":124790},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3475":73029,"_30304":72990,"_5":30654,"_20976":124792,"_27536":124793,"_2958":124794},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3475":73030,"_30304":72990,"_5":30654,"_20976":124796,"_27536":124797,"_2958":124798},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3475":73031,"_30304":72990,"_5":30654,"_20976":124800,"_27536":124801,"_2958":124802},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3475":73032,"_30304":72990,"_5":30654,"_20976":124804,"_27536":124805,"_2958":120603},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3475":73033,"_30304":72990,"_5":30654,"_20976":124807,"_27536":124808,"_2958":124809},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3475":73034,"_30304":72990,"_5":30654,"_20976":124811,"_27536":124812,"_2958":124813},[],"/docs/pr-preview/pr-65/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3475":73035,"_30304":72990,"_20976":124815,"_5":14428,"_27536":72990,"_2958":124816},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3475":73036,"_30304":72990,"_20976":124818,"_5":14428,"_27536":72990,"_2958":124819},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3475":73037,"_30304":72990,"_20976":124821,"_5":14428,"_27536":72990,"_2958":124822},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3475":73038,"_30304":72990,"_20976":124824,"_5":14428,"_27536":72990,"_2958":124825},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3475":73039,"_30304":72990,"_20976":124827,"_5":14428,"_27536":72990,"_2958":124828},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3475":73040,"_30304":72990,"_20976":124830,"_5":14428,"_27536":72990,"_2958":124831},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3475":73041,"_30304":72990,"_20976":124833,"_5":14428,"_27536":72990,"_2958":124834},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3475":73042,"_30304":72990,"_20976":124836,"_5":14428,"_27536":124650,"_2958":124837},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3475":73043,"_30304":72990,"_20976":124839,"_5":14428,"_27536":124650,"_2958":124840},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3475":73044,"_30304":72990,"_20976":124842,"_5":14428,"_27536":124654,"_2958":124843},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3475":73045,"_30304":72990,"_20976":124845,"_5":14428,"_27536":124654,"_2958":124846},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3475":73046,"_30304":72990,"_20976":124848,"_5":14428,"_27536":124658,"_2958":124849},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3475":73047,"_30304":72990,"_20976":124851,"_5":14428,"_27536":124662,"_2958":124852},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3475":73048,"_30304":72990,"_20976":124854,"_5":14428,"_27536":124662,"_2958":124855},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3475":73049,"_30304":72990,"_20976":124857,"_5":14428,"_27536":124662,"_2958":124858},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3475":73050,"_30304":72990,"_20976":124860,"_5":14428,"_27536":124662,"_2958":124861},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3475":73051,"_30304":72990,"_20976":124863,"_5":14428,"_27536":124662,"_2958":124864},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3475":73052,"_30304":72990,"_20976":124866,"_5":14428,"_27536":124666,"_2958":124867},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3475":73053,"_30304":72990,"_20976":124869,"_5":14428,"_27536":124666,"_2958":124870},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3475":73054,"_30304":72990,"_20976":124872,"_5":14428,"_27536":124666,"_2958":124873},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3475":73055,"_30304":72990,"_20976":124875,"_5":14428,"_27536":124666,"_2958":124876},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3475":73056,"_30304":72990,"_20976":124878,"_5":14428,"_27536":124666,"_2958":124879},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3475":73057,"_30304":72990,"_20976":124881,"_5":14428,"_27536":124666,"_2958":124882},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3475":73058,"_30304":72990,"_20976":124884,"_5":14428,"_27536":124670,"_2958":124885},[],"Cambio",{"_3475":73059,"_30304":72990,"_20976":124887,"_5":14428,"_27536":124670,"_2958":124888},[],"A quién afecta",{"_3475":73060,"_30304":72990,"_20976":124890,"_5":14428,"_27536":124670,"_2958":124891},[],"Gravedad",{"_3475":73061,"_30304":72990,"_20976":124893,"_5":14428,"_27536":124670,"_2958":123382},[],{"_3475":73062,"_30304":72990,"_20976":124895,"_5":14428,"_27536":124670,"_2958":124678},[],{"_3475":73063,"_30304":72990,"_20976":124897,"_5":14428,"_27536":124670,"_2958":124898},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3475":73064,"_30304":72990,"_20976":124900,"_5":14428,"_27536":124670,"_2958":124901},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3475":73065,"_30304":72990,"_20976":124903,"_5":14428,"_27536":124670,"_2958":124904},[],"Copiar los datos a los volúmenes nuevos",{"_3475":73066,"_30304":72990,"_20976":124906,"_5":14428,"_27536":124670,"_2958":124682},[],{"_3475":73067,"_30304":72990,"_20976":124908,"_5":14428,"_27536":124670,"_2958":124909},[],"Todas las releases de Helm",{"_3475":73068,"_30304":72990,"_20976":124911,"_5":14428,"_27536":124670,"_2958":124912},[],"Alta: `helm upgrade` falla",{"_3475":73069,"_30304":72990,"_20976":124914,"_5":14428,"_27536":124670,"_2958":124915},[],"Eliminar o renombrar las claves heredadas",{"_3475":73070,"_30304":72990,"_20976":124917,"_5":14428,"_27536":124670,"_2958":124686},[],{"_3475":73071,"_30304":72990,"_20976":124919,"_5":14428,"_27536":124670,"_2958":124920},[],"Todos los despliegues",{"_3475":73072,"_30304":72990,"_20976":124922,"_5":14428,"_27536":124670,"_2958":124923},[],"Alta: sin principal de bootstrap no hay administrador",{"_3475":73073,"_30304":72990,"_20976":124925,"_5":14428,"_27536":124670,"_2958":124926},[],"Configurar `services.authz`",{"_3475":73074,"_30304":72990,"_20976":124928,"_5":14428,"_27536":124670,"_2958":124690},[],{"_3475":73075,"_30304":72990,"_20976":124930,"_5":14428,"_27536":124670,"_2958":124909},[],{"_3475":73076,"_30304":72990,"_20976":124932,"_5":14428,"_27536":124670,"_2958":124933},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3475":73077,"_30304":72990,"_20976":124935,"_5":14428,"_27536":124670,"_2958":124936},[],"Mover JWKS y roles a `services.authz`",{"_3475":73078,"_30304":72990,"_20976":124938,"_5":14428,"_27536":124670,"_2958":124710},[],{"_3475":73079,"_30304":72990,"_20976":124940,"_5":14428,"_27536":124670,"_2958":124941},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3475":73080,"_30304":72990,"_20976":124943,"_5":14428,"_27536":124670,"_2958":124944},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3475":73081,"_30304":72990,"_20976":124946,"_5":14428,"_27536":124670,"_2958":124947},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3475":73082,"_30304":72990,"_20976":124949,"_5":14428,"_27536":124670,"_2958":124714},[],{"_3475":73083,"_30304":72990,"_20976":124951,"_5":14428,"_27536":124670,"_2958":124952},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3475":73084,"_30304":72990,"_20976":124954,"_5":14428,"_27536":124670,"_2958":124955},[],"Alta: el backend ya no arranca con ellos",{"_3475":73085,"_30304":72990,"_20976":124957,"_5":14428,"_27536":124670,"_2958":124958},[],"Pasar a PostgreSQL antes de actualizar",{"_3475":73086,"_30304":72990,"_20976":124960,"_5":14428,"_27536":124670,"_2958":124758},[],{"_3475":73087,"_30304":72990,"_20976":124962,"_5":14428,"_27536":124670,"_2958":124963},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3475":73088,"_30304":72990,"_20976":124965,"_5":14428,"_27536":124670,"_2958":124966},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3475":73089,"_30304":72990,"_20976":124968,"_5":14428,"_27536":124670,"_2958":124969},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3475":73090,"_30304":72990,"_20976":124971,"_5":14428,"_27536":124670,"_2958":124972},[],"Webhooks con referencias a archivos",{"_3475":73091,"_30304":72990,"_20976":124974,"_5":14428,"_27536":124670,"_2958":124975},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3475":73092,"_30304":72990,"_20976":124977,"_5":14428,"_27536":124670,"_2958":124978},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3475":73093,"_30304":72990,"_20976":124980,"_5":14428,"_27536":124670,"_2958":124981},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3475":73094,"_30304":72990,"_20976":124983,"_5":14428,"_27536":124670,"_2958":124694},[],{"_3475":73095,"_30304":72990,"_20976":124985,"_5":14428,"_27536":124670,"_2958":124986},[],"Releases con identidades por servicio o material de claves montado",{"_3475":73096,"_30304":72990,"_20976":124988,"_5":14428,"_27536":124670,"_2958":124989},[],"Media: los servicios no pueden leer sus archivos",{"_3475":73097,"_30304":72990,"_20976":124991,"_5":14428,"_27536":124670,"_2958":124992},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3475":73098,"_30304":72990,"_20976":124994,"_5":14428,"_27536":124670,"_2958":124698},[],{"_3475":73099,"_30304":72990,"_20976":124996,"_5":14428,"_27536":124670,"_2958":124997},[],"Releases que definen `amqp.tls`",{"_3475":73100,"_30304":72990,"_20976":124999,"_5":14428,"_27536":124670,"_2958":125000},[],"Media: los clientes se conectan al puerto equivocado",{"_3475":73101,"_30304":72990,"_20976":125002,"_5":14428,"_27536":124670,"_2958":125003},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3475":73102,"_30304":72990,"_20976":125005,"_5":14428,"_27536":124670,"_2958":124718},[],{"_3475":73103,"_30304":72990,"_20976":125007,"_5":14428,"_27536":124670,"_2958":125008},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3475":73104,"_30304":72990,"_20976":125010,"_5":14428,"_27536":124670,"_2958":125011},[],"Media: las claves de CA quedan sin gestionar",{"_3475":73105,"_30304":72990,"_20976":125013,"_5":14428,"_27536":124670,"_2958":125014},[],"Ejecutar la migración de CA a KMS",{"_3475":73106,"_30304":72990,"_20976":125016,"_5":14428,"_27536":124670,"_2958":125017},[],"Verificación del certificado del receptor",{"_3475":73107,"_30304":72990,"_20976":125019,"_5":14428,"_27536":124670,"_2958":125020},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3475":73108,"_30304":72990,"_20976":125022,"_5":14428,"_27536":124670,"_2958":125023},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3475":73109,"_30304":72990,"_20976":125025,"_5":14428,"_27536":124670,"_2958":125026},[],"Poner `insecure_skip_verify` a `false`",{"_3475":73110,"_30304":72990,"_20976":125028,"_5":14428,"_27536":124670,"_2958":124734},[],{"_3475":73111,"_30304":72990,"_20976":125030,"_5":14428,"_27536":124670,"_2958":125031},[],"Scripts y consolas que editan DMS por API",{"_3475":73112,"_30304":72990,"_20976":125033,"_5":14428,"_27536":124670,"_2958":125034},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3475":73113,"_30304":72990,"_20976":125036,"_5":14428,"_27536":124670,"_2958":125037},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3475":73114,"_30304":72990,"_20976":125039,"_5":14428,"_27536":124670,"_2958":124754},[],{"_3475":73115,"_30304":72990,"_20976":125041,"_5":14428,"_27536":124670,"_2958":125042},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3475":73116,"_30304":72990,"_20976":125044,"_5":14428,"_27536":124670,"_2958":125045},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3475":73117,"_30304":72990,"_20976":125047,"_5":14428,"_27536":124670,"_2958":125048},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3475":73118,"_30304":72990,"_20976":125050,"_5":14428,"_27536":124670,"_2958":124762},[],{"_3475":73119,"_30304":72990,"_20976":125052,"_5":14428,"_27536":124670,"_2958":125053},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3475":73120,"_30304":72990,"_20976":125055,"_5":14428,"_27536":124670,"_2958":125056},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3475":73121,"_30304":72990,"_20976":125058,"_5":14428,"_27536":124670,"_2958":125059},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3475":73122,"_30304":72990,"_20976":125061,"_5":14428,"_27536":124670,"_2958":124750},[],{"_3475":73123,"_30304":72990,"_20976":125063,"_5":14428,"_27536":124670,"_2958":125064},[],"Consumidores que leen el campo `events` del dispositivo",{"_3475":73124,"_30304":72990,"_20976":125066,"_5":14428,"_27536":124670,"_2958":125067},[],"Media: el campo desaparece",{"_3475":73125,"_30304":72990,"_20976":125069,"_5":14428,"_27536":124670,"_2958":125070},[],"Usar los nuevos endpoints de eventos",{"_3475":73126,"_30304":72990,"_20976":125072,"_5":14428,"_27536":124670,"_2958":124770},[],{"_3475":73127,"_30304":72990,"_20976":125074,"_5":14428,"_27536":124670,"_2958":125075},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3475":73128,"_30304":72990,"_20976":125077,"_5":14428,"_27536":124670,"_2958":125078},[],"Media: la migración de la VA aborta",{"_3475":73129,"_30304":72990,"_20976":125080,"_5":14428,"_27536":124670,"_2958":125081},[],"Corregir los roles afectados antes de actualizar",{"_3475":73130,"_30304":72990,"_20976":125083,"_5":14428,"_27536":124670,"_2958":124702},[],{"_3475":73131,"_30304":72990,"_20976":125085,"_5":14428,"_27536":124670,"_2958":125086},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3475":73132,"_30304":72990,"_20976":125088,"_5":14428,"_27536":124670,"_2958":125089},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3475":73133,"_30304":72990,"_20976":125091,"_5":14428,"_27536":124670,"_2958":125092},[],"Actualizar el archivo de values",{"_3475":73134,"_30304":72990,"_20976":125094,"_5":14428,"_27536":124670,"_2958":124742},[],{"_3475":73135,"_30304":72990,"_20976":125096,"_5":14428,"_27536":124670,"_2958":125097},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3475":73136,"_30304":72990,"_20976":125099,"_5":14428,"_27536":124670,"_2958":125100},[],"Baja: prevalece el ID de la URL",{"_3475":73137,"_30304":72990,"_20976":125102,"_5":14428,"_27536":124670,"_2958":125103},[],"Enviar el ID en la URL",{"_3475":73138,"_30304":72990,"_20976":125105,"_5":14428,"_27536":124670,"_2958":124766},[],{"_3475":73139,"_30304":72990,"_20976":125107,"_5":14428,"_27536":124670,"_2958":125108},[],"Clientes que envían un `id` al crear o importar CAs",{"_3475":73140,"_30304":72990,"_20976":125110,"_5":14428,"_27536":124670,"_2958":125111},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3475":73141,"_30304":72990,"_20976":125113,"_5":14428,"_27536":124670,"_2958":125114},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3475":73142,"_30304":72990,"_20976":125116,"_5":14428,"_27536":124670,"_2958":124746},[],{"_3475":73143,"_30304":72990,"_20976":125118,"_5":14428,"_27536":124670,"_2958":125119},[],"Consumidores que comparan el `type` del certificado",{"_3475":73144,"_30304":72990,"_20976":125121,"_5":14428,"_27536":124670,"_2958":125122},[],"Baja: dos valores cambian de nombre",{"_3475":73145,"_30304":72990,"_20976":125124,"_5":14428,"_27536":124670,"_2958":125125},[],"Adaptar los consumidores",{"_3475":73146,"_30304":72990,"_20976":125127,"_5":14428,"_27536":124670,"_2958":124738},[],{"_3475":73147,"_30304":72990,"_20976":125129,"_5":14428,"_27536":124670,"_2958":125130},[],"Cualquier DMS",{"_3475":73148,"_30304":72990,"_20976":125132,"_5":14428,"_27536":124670,"_2958":125133},[],"Baja: solo informativo",{"_3475":73149,"_30304":72990,"_20976":125135,"_5":14428,"_27536":124670,"_2958":125136},[],"Revisar ambos bloques antes de editar",{"_3475":73150,"_30304":72990,"_20976":125138,"_5":14428,"_27536":124677,"_2958":125139},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3475":73151,"_30304":72990,"_20976":125141,"_5":14428,"_27536":124677,"_2958":125142},[],"El paso 4 de la guía de migración copia los datos.",{"_3475":73152,"_30304":72990,"_20976":125144,"_5":14428,"_27536":124681,"_2958":125145},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3475":73153,"_30304":72990,"_20976":125147,"_5":14428,"_27536":124685,"_2958":125148},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3475":73154,"_30304":72990,"_20976":125150,"_5":14428,"_27536":124689,"_2958":125151},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3475":73155,"_30304":72990,"_20976":125153,"_5":14428,"_27536":124693,"_2958":125154},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3475":73156,"_30304":72990,"_20976":125156,"_5":14428,"_27536":124693,"_2958":125157},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3475":73157,"_30304":72990,"_20976":125159,"_5":14428,"_27536":124697,"_2958":125160},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3475":73158,"_30304":72990,"_20976":125162,"_5":14428,"_27536":124701,"_2958":125163},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3475":73159,"_30304":72990,"_20976":125165,"_5":14428,"_27536":124701,"_2958":125166},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3475":73160,"_30304":72990,"_20976":125168,"_5":14428,"_27536":124701,"_2958":125169},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3475":73161,"_30304":72990,"_20976":125171,"_5":14428,"_27536":124701,"_2958":125172},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3475":73162,"_30304":72990,"_20976":125174,"_5":14428,"_27536":124701,"_2958":125175},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3475":73163,"_30304":72990,"_20976":125177,"_5":14428,"_27536":124701,"_2958":125178},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3475":73164,"_30304":72990,"_20976":125180,"_5":14428,"_27536":124709,"_2958":125181},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3475":73165,"_30304":72990,"_20976":125183,"_5":14428,"_27536":124709,"_2958":125184},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3475":73166,"_30304":72990,"_20976":125186,"_5":14428,"_27536":124709,"_2958":125187},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3475":73167,"_30304":72990,"_20976":125189,"_5":14428,"_27536":124709,"_2958":125190},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3475":73168,"_30304":72990,"_20976":125192,"_5":14428,"_27536":124709,"_2958":125193},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3475":73169,"_30304":72990,"_20976":125195,"_5":14428,"_27536":124713,"_2958":125196},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3475":73170,"_30304":72990,"_20976":125198,"_5":14428,"_27536":124717,"_2958":125199},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3475":73171,"_30304":72990,"_20976":125201,"_5":14428,"_27536":124717,"_2958":125202},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3475":73172,"_30304":72990,"_20976":125204,"_5":14428,"_27536":124717,"_2958":125205},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3475":73173,"_30304":72990,"_20976":125207,"_5":14428,"_27536":124717,"_2958":125208},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3475":73174,"_30304":72990,"_20976":125210,"_5":14428,"_27536":124717,"_2958":125211},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3475":73175,"_30304":72990,"_20976":125213,"_5":14428,"_27536":124717,"_2958":125214},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3475":73176,"_30304":72990,"_20976":125216,"_5":14428,"_27536":124717,"_2958":125217},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3475":73177,"_30304":72990,"_20976":125219,"_5":14428,"_27536":124717,"_2958":125220},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3475":73178,"_30304":72990,"_20976":125222,"_5":14428,"_27536":124721,"_2958":125223},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3475":73179,"_30304":72990,"_20976":125225,"_5":14428,"_27536":124729,"_2958":125226},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3475":73180,"_30304":72990,"_20976":125228,"_5":14428,"_27536":124729,"_2958":125229},[],"Campo en 3.8.0",{"_3475":73181,"_30304":72990,"_20976":125231,"_5":14428,"_27536":124729,"_2958":125232},[],"Campo en 4.0.0",{"_3475":73182,"_30304":72990,"_20976":125234,"_5":14428,"_27536":124729,"_2958":58209},[],{"_3475":73183,"_30304":72990,"_20976":125236,"_5":14428,"_27536":124729,"_2958":125237},[],"`insecure_skip_verify` (con el valor negado)",{"_3475":73184,"_30304":72990,"_20976":125239,"_5":14428,"_27536":124729,"_2958":58215},[],{"_3475":73185,"_30304":72990,"_20976":125241,"_5":14428,"_27536":124729,"_2958":58218},[],{"_3475":73186,"_30304":72990,"_20976":125243,"_5":14428,"_27536":124729,"_2958":58221},[],{"_3475":73187,"_30304":72990,"_20976":125245,"_5":14428,"_27536":124729,"_2958":58224},[],{"_3475":73188,"_30304":72990,"_20976":125247,"_5":14428,"_27536":124729,"_2958":58227},[],{"_3475":73189,"_30304":72990,"_20976":125249,"_5":14428,"_27536":124729,"_2958":58230},[],{"_3475":73190,"_30304":72990,"_20976":125251,"_5":14428,"_27536":124729,"_2958":125252},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3475":73191,"_30304":72990,"_20976":125254,"_5":14428,"_27536":124729,"_2958":125255},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3475":73192,"_30304":72990,"_20976":125257,"_5":14428,"_27536":124729,"_2958":125258},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3475":73193,"_30304":72990,"_20976":125260,"_5":14428,"_27536":124733,"_2958":125261},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3475":73194,"_30304":72990,"_20976":125263,"_5":14428,"_27536":124733,"_2958":125264},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3475":73195,"_30304":72990,"_20976":125266,"_5":14428,"_27536":124733,"_2958":125267},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3475":73196,"_30304":72990,"_20976":125269,"_5":14428,"_27536":124737,"_2958":125270},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3475":73197,"_30304":72990,"_20976":125272,"_5":14428,"_27536":124741,"_2958":125273},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3475":73198,"_30304":72990,"_20976":125275,"_5":14428,"_27536":124745,"_2958":125276},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3475":73199,"_30304":72990,"_20976":125278,"_5":14428,"_27536":124749,"_2958":125279},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3475":73200,"_30304":72990,"_20976":125281,"_5":14428,"_27536":124749,"_2958":125282},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3475":73201,"_30304":72990,"_20976":125284,"_5":14428,"_27536":124749,"_2958":125285},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3475":73202,"_30304":72990,"_20976":125287,"_5":14428,"_27536":124749,"_2958":125288},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3475":73203,"_30304":72990,"_20976":125290,"_5":14428,"_27536":124753,"_2958":125291},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3475":73204,"_30304":72990,"_20976":125293,"_5":14428,"_27536":124757,"_2958":125294},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3475":73205,"_30304":72990,"_20976":125296,"_5":14428,"_27536":124757,"_2958":125297},[],"Ruta",{"_3475":73206,"_30304":72990,"_20976":125299,"_5":14428,"_27536":124757,"_2958":117839},[],{"_3475":73207,"_30304":72990,"_20976":125301,"_5":14428,"_27536":124757,"_2958":58283},[],{"_3475":73208,"_30304":72990,"_20976":125303,"_5":14428,"_27536":124757,"_2958":125304},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3475":73209,"_30304":72990,"_20976":125306,"_5":14428,"_27536":124757,"_2958":58289},[],{"_3475":73210,"_30304":72990,"_20976":125308,"_5":14428,"_27536":124757,"_2958":125309},[],"Lee los ajustes de una CA.",{"_3475":73211,"_30304":72990,"_20976":125311,"_5":14428,"_27536":124757,"_2958":58295},[],{"_3475":73212,"_30304":72990,"_20976":125313,"_5":14428,"_27536":124757,"_2958":125314},[],"Sustituye los `crl_options`.",{"_3475":73213,"_30304":72990,"_20976":125316,"_5":14428,"_27536":124757,"_2958":58301},[],{"_3475":73214,"_30304":72990,"_20976":125318,"_5":14428,"_27536":124757,"_2958":125319},[],"Elimina los ajustes archivados de una CA.",{"_3475":73215,"_30304":72990,"_20976":125321,"_5":14428,"_27536":124757,"_2958":125322},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3475":73216,"_30304":72990,"_20976":125324,"_5":14428,"_27536":124757,"_2958":125325},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3475":73217,"_30304":72990,"_20976":125327,"_5":14428,"_27536":124757,"_2958":125328},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3475":73218,"_30304":72990,"_20976":125330,"_5":14428,"_27536":124757,"_2958":125331},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3475":73219,"_30304":72990,"_20976":125333,"_5":14428,"_27536":124757,"_2958":125334},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3475":73220,"_30304":72990,"_20976":125336,"_5":14428,"_27536":124757,"_2958":125337},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3475":73221,"_30304":72990,"_20976":125339,"_5":14428,"_27536":124757,"_2958":125340},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3475":73222,"_30304":72990,"_20976":125342,"_5":14428,"_27536":124757,"_2958":125343},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3475":73223,"_30304":72990,"_20976":125345,"_5":14428,"_27536":124757,"_2958":125346},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3475":73224,"_30304":72990,"_20976":125348,"_5":14428,"_27536":124757,"_2958":125349},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3475":73225,"_30304":72990,"_20976":125351,"_5":14428,"_27536":124757,"_2958":125352},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3475":73226,"_30304":72990,"_20976":125354,"_5":14428,"_27536":124761,"_2958":125355},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3475":73227,"_30304":72990,"_20976":125357,"_5":14428,"_27536":124765,"_2958":125358},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3475":73228,"_30304":72990,"_20976":125360,"_5":14428,"_27536":124769,"_2958":125361},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3475":73229,"_30304":72990,"_20976":125363,"_5":14428,"_27536":124773,"_2958":125364},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3475":73230,"_30304":72990,"_20976":125366,"_5":14428,"_27536":124777,"_2958":125367},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3475":73231,"_30304":72990,"_20976":125369,"_5":14428,"_27536":124777,"_2958":125370},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3475":73232,"_30304":72990,"_20976":125372,"_5":14428,"_27536":124777,"_2958":125373},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3475":73233,"_30304":72990,"_20976":125375,"_5":14428,"_27536":124777,"_2958":125376},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3475":73234,"_30304":72990,"_20976":125378,"_5":14428,"_27536":124777,"_2958":125379},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3475":73235,"_30304":72990,"_20976":125381,"_5":14428,"_27536":124777,"_2958":125382},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3475":73236,"_30304":72990,"_20976":125384,"_5":14428,"_27536":124781,"_2958":125385},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3475":73237,"_30304":72990,"_20976":125387,"_5":14428,"_27536":124781,"_2958":125388},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3475":73238,"_30304":72990,"_20976":125390,"_5":14428,"_27536":124781,"_2958":125391},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3475":73239,"_30304":72990,"_20976":125393,"_5":14428,"_27536":124781,"_2958":125394},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3475":73240,"_30304":72990,"_20976":125396,"_5":14428,"_27536":124781,"_2958":125397},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3475":73241,"_30304":72990,"_20976":125399,"_5":14428,"_27536":124785,"_2958":125400},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3475":73242,"_30304":72990,"_20976":125402,"_5":14428,"_27536":124785,"_2958":125403},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3475":73243,"_30304":72990,"_20976":125405,"_5":14428,"_27536":124785,"_2958":125406},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3475":73244,"_30304":72990,"_20976":125408,"_5":14428,"_27536":124785,"_2958":125409},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3475":73245,"_30304":72990,"_20976":125411,"_5":14428,"_27536":124785,"_2958":125412},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3475":73246,"_30304":72990,"_20976":125414,"_5":14428,"_27536":124785,"_2958":125415},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3475":73247,"_30304":72990,"_20976":125417,"_5":14428,"_27536":124785,"_2958":125418},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3475":73248,"_30304":72990,"_20976":125420,"_5":14428,"_27536":124785,"_2958":125421},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3475":73249,"_30304":72990,"_20976":125423,"_5":14428,"_27536":124785,"_2958":125424},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3475":73250,"_30304":72990,"_20976":125426,"_5":14428,"_27536":124785,"_2958":125427},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3475":73251,"_30304":72990,"_20976":125429,"_5":14428,"_27536":124785,"_2958":125430},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3475":73252,"_30304":72990,"_20976":125432,"_5":14428,"_27536":124785,"_2958":125433},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3475":73253,"_30304":72990,"_20976":125435,"_5":14428,"_27536":124789,"_2958":125436},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3475":73254,"_30304":72990,"_20976":125438,"_5":14428,"_27536":124789,"_2958":125439},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3475":73255,"_30304":72990,"_20976":125441,"_5":14428,"_27536":124793,"_2958":125442},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3475":73256,"_30304":72990,"_20976":125444,"_5":14428,"_27536":124793,"_2958":125445},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3475":73257,"_30304":72990,"_20976":125447,"_5":14428,"_27536":124793,"_2958":125448},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3475":73258,"_30304":72990,"_20976":125450,"_5":14428,"_27536":124793,"_2958":125451},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3475":73259,"_30304":72990,"_20976":125453,"_5":14428,"_27536":124793,"_2958":125454},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3475":73260,"_30304":72990,"_20976":125456,"_5":14428,"_27536":124793,"_2958":125457},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3475":73261,"_30304":72990,"_20976":125459,"_5":14428,"_27536":124793,"_2958":125460},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3475":73262,"_30304":72990,"_20976":125462,"_5":14428,"_27536":124793,"_2958":125463},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3475":73263,"_30304":72990,"_20976":125465,"_5":14428,"_27536":124793,"_2958":125466},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3475":73264,"_30304":72990,"_20976":125468,"_5":14428,"_27536":124793,"_2958":125469},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3475":73265,"_30304":72990,"_20976":125471,"_5":14428,"_27536":124793,"_2958":125472},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3475":73266,"_30304":72990,"_20976":125474,"_5":14428,"_27536":124797,"_2958":125475},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3475":73267,"_30304":72990,"_20976":125477,"_5":14428,"_27536":124797,"_2958":125478},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3475":73268,"_30304":72990,"_20976":125480,"_5":14428,"_27536":124801,"_2958":125481},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3475":73269,"_30304":72990,"_20976":125483,"_5":14428,"_27536":124801,"_2958":125484},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3475":73270,"_30304":72990,"_20976":125486,"_5":14428,"_27536":124801,"_2958":125487},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3475":73271,"_30304":72990,"_20976":125489,"_5":14428,"_27536":124801,"_2958":125490},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3475":73272,"_30304":72990,"_20976":125492,"_5":14428,"_27536":124801,"_2958":125493},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3475":73273,"_30304":72990,"_20976":125495,"_5":14428,"_27536":124801,"_2958":125496},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3475":73274,"_30304":72990,"_20976":125498,"_5":14428,"_27536":124801,"_2958":125499},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3475":73275,"_30304":72990,"_20976":125501,"_5":14428,"_27536":124801,"_2958":125502},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3475":73276,"_30304":72990,"_20976":125504,"_5":14428,"_27536":124805,"_2958":125505},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3475":73277,"_30304":72990,"_20976":125507,"_5":14428,"_27536":124805,"_2958":125508},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3475":73278,"_30304":72990,"_20976":125510,"_5":14428,"_27536":124805,"_2958":125511},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3475":73279,"_30304":72990,"_20976":125513,"_5":14428,"_27536":124805,"_2958":125514},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3475":73280,"_30304":72990,"_20976":125516,"_5":14428,"_27536":124805,"_2958":125517},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3475":73281,"_30304":72990,"_20976":125519,"_5":14428,"_27536":124805,"_2958":125520},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3475":73282,"_30304":72990,"_20976":125522,"_5":14428,"_27536":124805,"_2958":125523},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3475":73283,"_30304":72990,"_20976":125525,"_5":14428,"_27536":124805,"_2958":125526},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3475":73284,"_30304":72990,"_20976":125528,"_5":14428,"_27536":124805,"_2958":125529},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3475":73285,"_30304":72990,"_20976":125531,"_5":14428,"_27536":124805,"_2958":125532},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3475":73286,"_30304":72990,"_20976":125534,"_5":14428,"_27536":124805,"_2958":125535},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3475":73287,"_30304":72990,"_20976":125537,"_5":14428,"_27536":124808,"_2958":125538},[],"Tras la actualización, comprueba en este orden:",{"_3475":73288,"_30304":72990,"_20976":125540,"_5":14428,"_27536":124808,"_2958":125541},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3475":73289,"_30304":72990,"_20976":125543,"_5":14428,"_27536":124808,"_2958":125544},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3475":73290,"_30304":72990,"_20976":125546,"_5":14428,"_27536":124808,"_2958":125547},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3475":73291,"_30304":72990,"_20976":125549,"_5":14428,"_27536":124808,"_2958":125550},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3475":73292,"_30304":72990,"_20976":125552,"_5":14428,"_27536":124808,"_2958":125553},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3475":73293,"_30304":72990,"_20976":125555,"_5":14428,"_27536":124808,"_2958":125556},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3475":73294,"_30304":72990,"_20976":125558,"_5":14428,"_27536":124808,"_2958":125559},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3475":73295,"_30304":72990,"_20976":125561,"_5":14428,"_27536":124808,"_2958":125562},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3475":73296,"_30304":72990,"_20976":125564,"_5":14428,"_27536":124808,"_2958":125565},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3475":73297,"_30304":72990,"_20976":125567,"_5":14428,"_27536":124808,"_2958":125568},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3475":73298,"_30304":72990,"_20976":125570,"_5":14428,"_27536":124808,"_2958":125571},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3475":73299,"_30304":72990,"_20976":125573,"_5":14428,"_27536":124808,"_2958":125574},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3475":73300,"_30304":72990,"_20976":125576,"_5":14428,"_27536":124808,"_2958":125577},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3475":73301,"_30304":72990,"_20976":125579,"_5":14428,"_27536":124808,"_2958":125580},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3475":73302,"_30304":72990,"_20976":125582,"_5":14428,"_27536":124808,"_2958":125583},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3475":73303,"_30304":72990,"_20976":125585,"_5":14428,"_27536":124812,"_2958":125586},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3475":73304,"_30304":72990,"_20976":125588,"_5":14428,"_27536":124812,"_2958":125589},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3475":73305,"_30304":72990,"_20976":125591,"_5":14428,"_27536":124812,"_2958":125592},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3475":73306,"_30304":72990,"_20976":125594,"_5":14428,"_27536":124812,"_2958":125595},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3475":73307,"_30304":72990,"_20976":125597,"_5":14428,"_27536":124812,"_2958":125598},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58586":125600,"_58588":125601,"_58590":125602,"_58592":125603,"_18188":2993,"_70363":2993},"spanish",[2958,30304,5,27536],{"_2958":25085,"_30304":25085,"_5":25085,"_27536":25085},{"_2958":125604,"_30304":128545,"_5":131486,"_27536":134427},{"_4667":125605,"_58596":125606,"_5":25085},{"_14504":7327,"_14879":7328,"_14898":4066,"_29307":3663,"_14885":4396,"_19908":9097,"_14525":16761,"_14532":17408,"_29249":9124,"_29658":5849,"_29679":6578,"_29283":17274,"_34646":5188,"_29386":20388,"_29723":9909,"_34653":22901,"_34656":4728,"_34659":7048,"_34662":8697,"_30130":6996,"_34667":5458,"_34669":17270,"_30160":15838,"_1