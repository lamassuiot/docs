95,"_40392":58398,"_40394":58401,"_40396":58404,"_40398":58407,"_40400":58410,"_40402":58413,"_40404":58416,"_40406":58419,"_40408":58422,"_40410":58425,"_40412":58428,"_40414":58431,"_40417":58434,"_40419":58437,"_40421":58440,"_40423":58443,"_40425":58446,"_40427":58449,"_40429":58452,"_40431":58455,"_40433":58458,"_40435":58461,"_40437":58464,"_40439":58467,"_40441":58470,"_40443":58473,"_40446":58476,"_40448":58479,"_40450":58482,"_40452":58485,"_40454":58488,"_40456":58491,"_40459":58494,"_40461":58497,"_40463":58500,"_40465":58503,"_40467":58506,"_40469":58509,"_40471":58512,"_40473":58515,"_40475":58518,"_40477":58521,"_40479":58524,"_40481":58527,"_40483":58530,"_40485":58533,"_40487":58536,"_40489":58539,"_40491":58542,"_40493":58545,"_40495":58548,"_40497":58551,"_40499":58554,"_40501":58557,"_40503":58560,"_40505":58563,"_40507":58566,"_40509":58569,"_40512":58572,"_40514":58575,"_40516":58578,"_40518":58581},{"_3475":15,"_30304":15,"_5":14780,"_2958":49410,"_30657":49411,"_20976":49415,"_27536":15},"Deploy from AWS Marketplace",[49412,49413,49414],"Docs","Deployment","Other models",[],{"_3475":16,"_30304":15,"_20976":49417,"_5":14428,"_27536":15,"_2958":49418},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3475":17,"_30304":15,"_5":30654,"_20976":49420,"_27536":49421,"_2958":49422},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3475":18,"_30304":15,"_5":30654,"_20976":49424,"_27536":49425,"_2958":49426},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3475":19,"_30304":15,"_5":30654,"_20976":49428,"_27536":49429,"_2958":49430},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3475":20,"_30304":15,"_5":30654,"_20976":49432,"_27536":49433,"_2958":49434},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3475":21,"_30304":15,"_5":30654,"_20976":49436,"_27536":49437,"_2958":49438},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3475":22,"_30304":15,"_5":30654,"_20976":49440,"_27536":49441,"_2958":49442},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3475":23,"_30304":15,"_5":30654,"_20976":49444,"_27536":49445,"_2958":49446},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#next-step","Next step",{"_3475":24,"_30304":15,"_20976":49448,"_5":14428,"_27536":15,"_2958":49449},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3475":25,"_30304":15,"_20976":49451,"_5":14428,"_27536":49421,"_2958":49452},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3475":26,"_30304":15,"_20976":49454,"_5":14428,"_27536":49421,"_2958":49455},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3475":27,"_30304":15,"_20976":49457,"_5":14428,"_27536":49421,"_2958":49458},[],"A security group allowing the necessary endpoints.",{"_3475":28,"_30304":15,"_20976":49460,"_5":14428,"_27536":49425,"_2958":49461},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3475":29,"_30304":15,"_20976":49463,"_5":14428,"_27536":49425,"_2958":49464},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3475":30,"_30304":15,"_20976":49466,"_5":14428,"_27536":49425,"_2958":49467},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3475":31,"_30304":15,"_20976":49469,"_5":14428,"_27536":49429,"_2958":49470},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3475":32,"_30304":15,"_20976":49472,"_5":14428,"_27536":49433,"_2958":49473},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3475":33,"_30304":15,"_20976":49475,"_5":14428,"_27536":49437,"_2958":49476},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3475":34,"_30304":15,"_20976":49478,"_5":14428,"_27536":49441,"_2958":49479},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3475":35,"_30304":15,"_20976":49481,"_5":14428,"_27536":49445,"_2958":49482},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3475":36,"_30304":36,"_5":14780,"_2958":49484,"_30657":49485,"_20976":49486,"_27536":36},"Deploy Lamassu",[49412,49413],[],{"_3475":37,"_30304":36,"_20976":49488,"_5":14428,"_27536":36,"_2958":49489},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3475":38,"_30304":36,"_5":30654,"_20976":49491,"_27536":49492,"_2958":49493},[],"/docs/pr-preview/pr-65/deployment/overview#choose-a-model","Choose a model",{"_3475":39,"_30304":36,"_5":30654,"_20976":49495,"_27536":49496,"_2958":49497},[],"/docs/pr-preview/pr-65/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3475":40,"_30304":36,"_5":30654,"_20976":49499,"_27536":49500,"_2958":49501},[],"/docs/pr-preview/pr-65/deployment/overview#after-deployment","After deployment",{"_3475":41,"_30304":36,"_20976":49503,"_5":14428,"_27536":36,"_2958":49504},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3475":42,"_30304":36,"_20976":49506,"_5":14428,"_27536":49492,"_2958":49507},[],"Model",{"_3475":43,"_30304":36,"_20976":49509,"_5":14428,"_27536":49492,"_2958":49510},[],"Recommended for",{"_3475":44,"_30304":36,"_20976":49512,"_5":14428,"_27536":49492,"_2958":49513},[],"Who operates the infrastructure",{"_3475":45,"_30304":36,"_20976":49515,"_5":14428,"_27536":49492,"_2958":49516},[],"Starting point",{"_3475":46,"_30304":36,"_20976":49518,"_5":14428,"_27536":49492,"_2958":49519},[],"Kubernetes self-managed",{"_3475":47,"_30304":36,"_20976":49521,"_5":14428,"_27536":49492,"_2958":49522},[],"Production, regulated environments and custom deployments",{"_3475":48,"_30304":36,"_20976":49524,"_5":14428,"_27536":49492,"_2958":49525},[],"Your team",{"_3475":49,"_30304":36,"_20976":49527,"_5":14428,"_27536":49492,"_2958":49528},[],"Helm or Fastlane",{"_3475":50,"_30304":36,"_20976":49530,"_5":14428,"_27536":49492,"_2958":49531},[],"AWS Marketplace",{"_3475":51,"_30304":36,"_20976":49533,"_5":14428,"_27536":49492,"_2958":49534},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3475":52,"_30304":36,"_20976":49536,"_5":14428,"_27536":49492,"_2958":49525},[],{"_3475":53,"_30304":36,"_20976":49538,"_5":14428,"_27536":49492,"_2958":49539},[],"Preconfigured image on EC2",{"_3475":54,"_30304":36,"_20976":49541,"_5":14428,"_27536":49492,"_2958":49542},[],"SaaS",{"_3475":55,"_30304":36,"_20976":49544,"_5":14428,"_27536":49492,"_2958":49545},[],"Teams that want to use the platform without operating it",{"_3475":56,"_30304":36,"_20976":49547,"_5":14428,"_27536":49492,"_2958":49548},[],"Lamassu",{"_3475":57,"_30304":36,"_20976":49550,"_5":14428,"_27536":49492,"_2958":49551},[],"Managed subscription",{"_3475":58,"_30304":36,"_20976":49553,"_5":14428,"_27536":49492,"_2958":49554},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3475":59,"_30304":36,"_20976":49556,"_5":14428,"_27536":49492,"_2958":49557},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3475":60,"_30304":36,"_20976":49559,"_5":14428,"_27536":49492,"_2958":49560},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3475":61,"_30304":36,"_20976":49562,"_5":14428,"_27536":49496,"_2958":49563},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3475":62,"_30304":36,"_20976":49565,"_5":14428,"_27536":49500,"_2958":49566},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3475":63,"_30304":63,"_5":14780,"_2958":49568,"_30657":49569,"_20976":49570,"_27536":63},"Use Lamassu as SaaS",[49412,49413,49414],[],{"_3475":64,"_30304":63,"_20976":49572,"_5":14428,"_27536":63,"_2958":49573},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3475":65,"_30304":63,"_5":30654,"_20976":49575,"_27536":49576,"_2958":49577},[],"/docs/pr-preview/pr-65/deployment/saas#what-the-service-manages","What the service manages",{"_3475":66,"_30304":63,"_5":30654,"_20976":49579,"_27536":49580,"_2958":49581},[],"/docs/pr-preview/pr-65/deployment/saas#plans","Plans",{"_3475":67,"_30304":63,"_5":30654,"_20976":49583,"_27536":49584,"_2958":49585},[],"/docs/pr-preview/pr-65/deployment/saas#request-access","Request access",{"_3475":68,"_30304":63,"_20976":49587,"_5":14428,"_27536":63,"_2958":49588},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3475":69,"_30304":63,"_20976":49590,"_5":14428,"_27536":49576,"_2958":49591},[],"Platform availability and maintenance.",{"_3475":70,"_30304":63,"_20976":49593,"_5":14428,"_27536":49576,"_2958":49594},[],"Automatic backups.",{"_3475":71,"_30304":63,"_20976":49596,"_5":14428,"_27536":49576,"_2958":49597},[],"Version upgrades.",{"_3475":72,"_30304":63,"_20976":49599,"_5":14428,"_27536":49576,"_2958":49600},[],"Technical support and SLA according to your plan.",{"_3475":73,"_30304":63,"_20976":49602,"_5":14428,"_27536":49580,"_2958":49603},[],"Plan",{"_3475":74,"_30304":63,"_20976":49605,"_5":14428,"_27536":49580,"_2958":49606},[],"Devices",{"_3475":75,"_30304":63,"_20976":49608,"_5":14428,"_27536":49580,"_2958":49609},[],"Support",{"_3475":76,"_30304":63,"_20976":49611,"_5":14428,"_27536":49580,"_2958":49612},[],"SLA",{"_3475":77,"_30304":63,"_20976":49614,"_5":14428,"_27536":49580,"_2958":49615},[],"Starter",{"_3475":78,"_30304":63,"_20976":49617,"_5":14428,"_27536":49580,"_2958":49618},[],"Up to 1,000",{"_3475":79,"_30304":63,"_20976":49620,"_5":14428,"_27536":49580,"_2958":49621},[],"Email",{"_3475":80,"_30304":63,"_20976":49623,"_5":14428,"_27536":49580,"_2958":49624},[],"99.5 %",{"_3475":81,"_30304":63,"_20976":49626,"_5":14428,"_27536":49580,"_2958":49627},[],"Professional",{"_3475":82,"_30304":63,"_20976":49629,"_5":14428,"_27536":49580,"_2958":49630},[],"Up to 10,000",{"_3475":83,"_30304":63,"_20976":49632,"_5":14428,"_27536":49580,"_2958":49633},[],"Email and chat",{"_3475":84,"_30304":63,"_20976":49635,"_5":14428,"_27536":49580,"_2958":49636},[],"99.9 %",{"_3475":85,"_30304":63,"_20976":49638,"_5":14428,"_27536":49580,"_2958":49639},[],"Enterprise",{"_3475":86,"_30304":63,"_20976":49641,"_5":14428,"_27536":49580,"_2958":49642},[],"Unlimited",{"_3475":87,"_30304":63,"_20976":49644,"_5":14428,"_27536":49580,"_2958":49645},[],"Dedicated",{"_3475":88,"_30304":63,"_20976":49647,"_5":14428,"_27536":49580,"_2958":49648},[],"99.99 %",{"_3475":89,"_30304":63,"_20976":49650,"_5":14428,"_27536":49584,"_2958":49651},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3475":90,"_30304":63,"_20976":49653,"_5":14428,"_27536":49584,"_2958":49654},[],"When you receive your instance's credentials, continue with Get started.",{"_3475":91,"_30304":91,"_5":14780,"_2958":49656,"_30657":49657,"_20976":49658,"_27536":91},"Fastlane",[49412,49413,49519],[],{"_3475":92,"_30304":91,"_20976":49660,"_5":14428,"_27536":91,"_2958":49661},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3475":93,"_30304":91,"_5":30654,"_20976":49663,"_27536":49664,"_2958":49665},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3475":94,"_30304":91,"_5":30654,"_20976":49667,"_27536":49668,"_2958":49669},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3475":95,"_30304":91,"_5":30654,"_20976":49671,"_27536":49672,"_2958":49422},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#before-you-begin",{"_3475":96,"_30304":91,"_5":30654,"_20976":49674,"_27536":49675,"_2958":49676},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3475":97,"_30304":91,"_5":30654,"_20976":49678,"_27536":49679,"_2958":49680},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3475":98,"_30304":91,"_5":30654,"_20976":49682,"_27536":49683,"_2958":49684},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3475":99,"_30304":91,"_5":30654,"_20976":49686,"_27536":49687,"_2958":49688},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3475":100,"_30304":91,"_5":30654,"_20976":49690,"_27536":49691,"_2958":49692},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3475":101,"_30304":91,"_5":30654,"_20976":49694,"_27536":49695,"_2958":49696},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3475":102,"_30304":91,"_5":30654,"_20976":49698,"_27536":49699,"_2958":49700},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3475":103,"_30304":91,"_5":30654,"_20976":49702,"_27536":49703,"_2958":49704},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3475":104,"_30304":91,"_20976":49706,"_5":14428,"_27536":49664,"_2958":49707},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3475":105,"_30304":91,"_20976":49709,"_5":14428,"_27536":49664,"_2958":49710},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3475":106,"_30304":91,"_20976":49712,"_5":14428,"_27536":49668,"_2958":49713},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3475":107,"_30304":91,"_20976":49715,"_5":14428,"_27536":49668,"_2958":49716},[],"Fastlane installs or configures",{"_3475":108,"_30304":91,"_20976":49718,"_5":14428,"_27536":49668,"_2958":49719},[],"You still provide",{"_3475":109,"_30304":91,"_20976":49721,"_5":14428,"_27536":49668,"_2958":49722},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3475":110,"_30304":91,"_20976":49724,"_5":14428,"_27536":49668,"_2958":49725},[],"The Kubernetes cluster, nodes and persistent storage",{"_3475":111,"_30304":91,"_20976":49727,"_5":14428,"_27536":49668,"_2958":49728},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3475":112,"_30304":91,"_20976":49730,"_5":14428,"_27536":49668,"_2958":49731},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3475":113,"_30304":91,"_20976":49733,"_5":14428,"_27536":49668,"_2958":49734},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3475":114,"_30304":91,"_20976":49736,"_5":14428,"_27536":49668,"_2958":49737},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3475":115,"_30304":91,"_20976":49739,"_5":14428,"_27536":49668,"_2958":49740},[],"Optional observability and lab HSM components",{"_3475":116,"_30304":91,"_20976":49742,"_5":14428,"_27536":49668,"_2958":49743},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3475":117,"_30304":91,"_20976":49745,"_5":14428,"_27536":49668,"_2958":49746},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3475":118,"_30304":91,"_20976":49748,"_5":14428,"_27536":49672,"_2958":49749},[],"You need:",{"_3475":119,"_30304":91,"_20976":49751,"_5":14428,"_27536":49672,"_2958":49752},[],"an existing Kubernetes cluster",{"_3475":120,"_30304":91,"_20976":49754,"_5":14428,"_27536":49672,"_2958":49755},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3475":121,"_30304":91,"_20976":49757,"_5":14428,"_27536":49672,"_2958":49758},[],"`yq`",{"_3475":122,"_30304":91,"_20976":49760,"_5":14428,"_27536":49672,"_2958":23724},[],{"_3475":123,"_30304":91,"_20976":49762,"_5":14428,"_27536":49672,"_2958":49763},[],"`jq` only when using `--sample-data` or `--development`",{"_3475":124,"_30304":91,"_20976":49765,"_5":14428,"_27536":49672,"_2958":49766},[],"`ssh-keygen` only when using `--with-hsm`",{"_3475":125,"_30304":91,"_20976":49768,"_5":14428,"_27536":49672,"_2958":49769},[],"free external ports 80 and 443 on a single-node K3s host",{"_3475":126,"_30304":91,"_20976":49771,"_5":14428,"_27536":49672,"_2958":49772},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3475":127,"_30304":91,"_20976":49774,"_5":14428,"_27536":49672,"_2958":49775},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3475":128,"_30304":91,"_20976":49777,"_5":14428,"_27536":49675,"_2958":49778},[],"Run the script from a clone of the Helm repository:",{"_3475":129,"_30304":91,"_20976":49780,"_5":14428,"_27536":49675,"_2958":49781},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3475":130,"_30304":91,"_20976":49783,"_5":14428,"_27536":49679,"_2958":49784},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3475":131,"_30304":91,"_20976":49786,"_5":14428,"_27536":49679,"_2958":49787},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3475":132,"_30304":91,"_20976":49789,"_5":14428,"_27536":49679,"_2958":49790},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3475":133,"_30304":91,"_20976":49792,"_5":14428,"_27536":49679,"_2958":49793},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3475":134,"_30304":91,"_20976":49795,"_5":14428,"_27536":49683,"_2958":49796},[],"Option",{"_3475":135,"_30304":91,"_20976":49798,"_5":14428,"_27536":49683,"_2958":49799},[],"Default",{"_3475":136,"_30304":91,"_20976":49801,"_5":14428,"_27536":49683,"_2958":49802},[],"Purpose",{"_3475":137,"_30304":91,"_20976":49804,"_5":14428,"_27536":49683,"_2958":49805},[],"`-h`, `--help`",{"_3475":138,"_30304":91,"_20976":49807,"_5":14428,"_27536":49683,"_2958":49808},[],"—",{"_3475":139,"_30304":91,"_20976":49810,"_5":14428,"_27536":49683,"_2958":49811},[],"Show help",{"_3475":140,"_30304":91,"_20976":49813,"_5":14428,"_27536":49683,"_2958":49814},[],"`-c`, `--context`",{"_3475":141,"_30304":91,"_20976":49816,"_5":14428,"_27536":49683,"_2958":49817},[],"current context",{"_3475":142,"_30304":91,"_20976":49819,"_5":14428,"_27536":49683,"_2958":49820},[],"Select the kubeconfig context for kubectl and Helm",{"_3475":143,"_30304":91,"_20976":49822,"_5":14428,"_27536":49683,"_2958":49823},[],"`-n`, `--non-interactive`",{"_3475":144,"_30304":91,"_20976":49825,"_5":14428,"_27536":49683,"_2958":6570},[],{"_3475":145,"_30304":91,"_20976":49827,"_5":14428,"_27536":49683,"_2958":49828},[],"Skip prompts and generate dependency credentials",{"_3475":146,"_30304":91,"_20976":49830,"_5":14428,"_27536":49683,"_2958":49831},[],"`-ns`, `--namespace`",{"_3475":147,"_30304":91,"_20976":49833,"_5":14428,"_27536":49683,"_2958":49834},[],"`lamassu-dev`",{"_3475":148,"_30304":91,"_20976":49836,"_5":14428,"_27536":49683,"_2958":49837},[],"Namespace for the installation",{"_3475":149,"_30304":91,"_20976":49839,"_5":14428,"_27536":49683,"_2958":49840},[],"`-d`, `--domain`",{"_3475":150,"_30304":91,"_20976":49842,"_5":14428,"_27536":49683,"_2958":49843},[],"`dev.lamassu.io`",{"_3475":151,"_30304":91,"_20976":49845,"_5":14428,"_27536":49683,"_2958":49846},[],"Domain used by the UI, OIDC and certificate",{"_3475":152,"_30304":91,"_20976":49848,"_5":14428,"_27536":49683,"_2958":49849},[],"`-v`, `--version`",{"_3475":153,"_30304":91,"_20976":49851,"_5":14428,"_27536":49683,"_2958":15120},[],{"_3475":154,"_30304":91,"_20976":49853,"_5":14428,"_27536":49683,"_2958":49854},[],"Lamassu chart version",{"_3475":155,"_30304":91,"_20976":49856,"_5":14428,"_27536":49683,"_2958":49857},[],"`--https-port`",{"_3475":156,"_30304":91,"_20976":49859,"_5":14428,"_27536":49683,"_2958":49860},[],"`443`",{"_3475":157,"_30304":91,"_20976":49862,"_5":14428,"_27536":49683,"_2958":49863},[],"Gateway HTTPS listener port",{"_3475":158,"_30304":91,"_20976":49865,"_5":14428,"_27536":49683,"_2958":49866},[],"`--http-port`",{"_3475":159,"_30304":91,"_20976":49868,"_5":14428,"_27536":49683,"_2958":49869},[],"`80`",{"_3475":160,"_30304":91,"_20976":49871,"_5":14428,"_27536":49683,"_2958":49872},[],"Gateway HTTP listener port",{"_3475":161,"_30304":91,"_20976":49874,"_5":14428,"_27536":49683,"_2958":49875},[],"`--tls-crt`",{"_3475":162,"_30304":91,"_20976":49877,"_5":14428,"_27536":49683,"_2958":49808},[],{"_3475":163,"_30304":91,"_20976":49879,"_5":14428,"_27536":49683,"_2958":49880},[],"PEM certificate for downstream TLS",{"_3475":164,"_30304":91,"_20976":49882,"_5":14428,"_27536":49683,"_2958":49883},[],"`--tls-key`",{"_3475":165,"_30304":91,"_20976":49885,"_5":14428,"_27536":49683,"_2958":49808},[],{"_3475":166,"_30304":91,"_20976":49887,"_5":14428,"_27536":49683,"_2958":49888},[],"PEM private key for downstream TLS",{"_3475":167,"_30304":91,"_20976":49890,"_5":14428,"_27536":49683,"_2958":49891},[],"`-l`, `--local-chart-path`",{"_3475":168,"_30304":91,"_20976":49893,"_5":14428,"_27536":49683,"_2958":49894},[],"repository chart",{"_3475":169,"_30304":91,"_20976":49896,"_5":14428,"_27536":49683,"_2958":49897},[],"Use an unpacked local Lamassu chart",{"_3475":170,"_30304":91,"_20976":49899,"_5":14428,"_27536":49683,"_2958":49900},[],"`-ip`, `--gateway-ip`",{"_3475":171,"_30304":91,"_20976":49902,"_5":14428,"_27536":49683,"_2958":8779},[],{"_3475":172,"_30304":91,"_20976":49904,"_5":14428,"_27536":49683,"_2958":49905},[],"Override the address written to `gateway.addresses`",{"_3475":173,"_30304":91,"_20976":49907,"_5":14428,"_27536":49683,"_2958":49908},[],"`--otel`",{"_3475":174,"_30304":91,"_20976":49910,"_5":14428,"_27536":49683,"_2958":6570},[],{"_3475":175,"_30304":91,"_20976":49912,"_5":14428,"_27536":49683,"_2958":49913},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3475":176,"_30304":91,"_20976":49915,"_5":14428,"_27536":49683,"_2958":49916},[],"`--development`",{"_3475":177,"_30304":91,"_20976":49918,"_5":14428,"_27536":49683,"_2958":6570},[],{"_3475":178,"_30304":91,"_20976":49920,"_5":14428,"_27536":49683,"_2958":49921},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3475":179,"_30304":91,"_20976":49923,"_5":14428,"_27536":49683,"_2958":49924},[],"`--sample-data`",{"_3475":180,"_30304":91,"_20976":49926,"_5":14428,"_27536":49683,"_2958":6570},[],{"_3475":181,"_30304":91,"_20976":49928,"_5":14428,"_27536":49683,"_2958":49929},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3475":182,"_30304":91,"_20976":49931,"_5":14428,"_27536":49683,"_2958":49932},[],"`--with-hsm`",{"_3475":183,"_30304":91,"_20976":49934,"_5":14428,"_27536":49683,"_2958":6570},[],{"_3475":184,"_30304":91,"_20976":49936,"_5":14428,"_27536":49683,"_2958":49937},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3475":185,"_30304":91,"_20976":49939,"_5":14428,"_27536":49683,"_2958":49940},[],"`--softhsm-chart-path`",{"_3475":186,"_30304":91,"_20976":49942,"_5":14428,"_27536":49683,"_2958":49943},[],"`./charts/softhsm`",{"_3475":187,"_30304":91,"_20976":49945,"_5":14428,"_27536":49683,"_2958":49946},[],"Use a different local SoftHSM chart",{"_3475":188,"_30304":91,"_20976":49948,"_5":14428,"_27536":49683,"_2958":49949},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3475":189,"_30304":91,"_20976":49951,"_5":14428,"_27536":49687,"_2958":49952},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3475":190,"_30304":91,"_20976":49954,"_5":14428,"_27536":49687,"_2958":49955},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3475":191,"_30304":91,"_20976":49957,"_5":14428,"_27536":49687,"_2958":49958},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3475":192,"_30304":91,"_20976":49960,"_5":14428,"_27536":49687,"_2958":49961},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3475":193,"_30304":91,"_20976":49963,"_5":14428,"_27536":49687,"_2958":49964},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3475":194,"_30304":91,"_20976":49966,"_5":14428,"_27536":49687,"_2958":49967},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3475":195,"_30304":91,"_20976":49969,"_5":14428,"_27536":49691,"_2958":49970},[],"Fastlane:",{"_3475":196,"_30304":91,"_20976":49972,"_5":14428,"_27536":49691,"_2958":49973},[],"validates local tools and the selected cluster",{"_3475":197,"_30304":91,"_20976":49975,"_5":14428,"_27536":49691,"_2958":49976},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3475":198,"_30304":91,"_20976":49978,"_5":14428,"_27536":49691,"_2958":49979},[],"creates the namespace",{"_3475":199,"_30304":91,"_20976":49981,"_5":14428,"_27536":49691,"_2958":49982},[],"installs PostgreSQL and creates the required databases",{"_3475":200,"_30304":91,"_20976":49984,"_5":14428,"_27536":49691,"_2958":49985},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3475":201,"_30304":91,"_20976":49987,"_5":14428,"_27536":49691,"_2958":49988},[],"installs RabbitMQ",{"_3475":202,"_30304":91,"_20976":49990,"_5":14428,"_27536":49691,"_2958":49991},[],"optionally installs observability and lab HSM components",{"_3475":203,"_30304":91,"_20976":49993,"_5":14428,"_27536":49691,"_2958":49994},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3475":204,"_30304":91,"_20976":49996,"_5":14428,"_27536":49691,"_2958":49997},[],"optionally loads sample data",{"_3475":205,"_30304":91,"_20976":49999,"_5":14428,"_27536":49691,"_2958":50000},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3475":206,"_30304":91,"_20976":50002,"_5":14428,"_27536":49695,"_2958":50003},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3475":207,"_30304":91,"_20976":50005,"_5":14428,"_27536":49695,"_2958":50006},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3475":208,"_30304":91,"_20976":50008,"_5":14428,"_27536":49699,"_2958":50009},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3475":209,"_30304":91,"_20976":50011,"_5":14428,"_27536":49699,"_2958":50012},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3475":210,"_30304":91,"_20976":50014,"_5":14428,"_27536":49699,"_2958":50015},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3475":211,"_30304":91,"_20976":50017,"_5":14428,"_27536":49703,"_2958":50018},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3475":212,"_30304":212,"_5":14780,"_2958":50020,"_30657":50021,"_20976":50022,"_27536":212},"Install with Helm",[49412,49413,49519],[],{"_3475":213,"_30304":212,"_20976":50024,"_5":14428,"_27536":212,"_2958":50025},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3475":214,"_30304":212,"_5":30654,"_20976":50027,"_27536":50028,"_2958":50029},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3475":215,"_30304":212,"_5":30654,"_20976":50031,"_27536":50032,"_2958":49422},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#before-you-begin",{"_3475":216,"_30304":212,"_5":30654,"_20976":50034,"_27536":50035,"_2958":50036},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3475":217,"_30304":212,"_5":30654,"_20976":50038,"_27536":50039,"_2958":50040},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3475":218,"_30304":212,"_5":30654,"_20976":50042,"_27536":50043,"_2958":50044},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3475":219,"_30304":212,"_5":30654,"_20976":50046,"_27536":50047,"_2958":50048},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3475":220,"_30304":212,"_5":30654,"_20976":50050,"_27536":50051,"_2958":50052},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3475":221,"_30304":212,"_5":30654,"_20976":50054,"_27536":50055,"_2958":50056},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3475":222,"_30304":212,"_5":30654,"_20976":50058,"_27536":50059,"_2958":50060},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3475":223,"_30304":212,"_5":30654,"_20976":50062,"_27536":50063,"_2958":50064},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3475":224,"_30304":212,"_5":30654,"_20976":50066,"_27536":50067,"_2958":50068},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3475":225,"_30304":212,"_20976":50070,"_5":14428,"_27536":50028,"_2958":50071},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3475":226,"_30304":212,"_20976":50073,"_5":14428,"_27536":50032,"_2958":50074},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3475":227,"_30304":212,"_20976":50076,"_5":14428,"_27536":50032,"_2958":50077},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3475":228,"_30304":212,"_20976":50079,"_5":14428,"_27536":50032,"_2958":50080},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3475":229,"_30304":212,"_20976":50082,"_5":14428,"_27536":50032,"_2958":50083},[],"a reachable RabbitMQ broker and credentials",{"_3475":230,"_30304":212,"_20976":50085,"_5":14428,"_27536":50032,"_2958":50086},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3475":231,"_30304":212,"_20976":50088,"_5":14428,"_27536":50032,"_2958":50089},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3475":232,"_30304":212,"_20976":50091,"_5":14428,"_27536":50032,"_2958":50092},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3475":233,"_30304":212,"_20976":50094,"_5":14428,"_27536":50032,"_2958":50095},[],"a StorageClass and an external traffic design",{"_3475":234,"_30304":212,"_20976":50097,"_5":14428,"_27536":50032,"_2958":50098},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3475":235,"_30304":212,"_20976":50100,"_5":14428,"_27536":50032,"_2958":50101},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3475":236,"_30304":212,"_20976":50103,"_5":14428,"_27536":50032,"_2958":50104},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3475":237,"_30304":212,"_20976":50106,"_5":14428,"_27536":50035,"_2958":50107},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3475":238,"_30304":212,"_20976":50109,"_5":14428,"_27536":50035,"_2958":50110},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3475":239,"_30304":212,"_20976":50112,"_5":14428,"_27536":50035,"_2958":50113},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3475":240,"_30304":212,"_20976":50115,"_5":14428,"_27536":50039,"_2958":50116},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3475":241,"_30304":212,"_20976":50118,"_5":14428,"_27536":50039,"_2958":50119},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3475":242,"_30304":212,"_20976":50121,"_5":14428,"_27536":50039,"_2958":50122},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3475":243,"_30304":212,"_20976":50124,"_5":14428,"_27536":50039,"_2958":50125},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3475":244,"_30304":212,"_20976":50127,"_5":14428,"_27536":50043,"_2958":50128},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3475":245,"_30304":212,"_20976":50130,"_5":14428,"_27536":50047,"_2958":50131},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3475":246,"_30304":212,"_20976":50133,"_5":14428,"_27536":50047,"_2958":50134},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3475":247,"_30304":212,"_20976":50136,"_5":14428,"_27536":50047,"_2958":50137},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3475":248,"_30304":212,"_20976":50139,"_5":14428,"_27536":50047,"_2958":50140},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3475":249,"_30304":212,"_20976":50142,"_5":14428,"_27536":50047,"_2958":50143},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3475":250,"_30304":212,"_20976":50145,"_5":14428,"_27536":50047,"_2958":50146},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3475":251,"_30304":212,"_20976":50148,"_5":14428,"_27536":50047,"_2958":50149},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3475":252,"_30304":212,"_20976":50151,"_5":14428,"_27536":50051,"_2958":50152},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3475":253,"_30304":212,"_20976":50154,"_5":14428,"_27536":50051,"_2958":50155},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3475":254,"_30304":212,"_20976":50157,"_5":14428,"_27536":50051,"_2958":50158},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3475":255,"_30304":212,"_20976":50160,"_5":14428,"_27536":50051,"_2958":50161},[],"See Access control for the principal and policy model.",{"_3475":256,"_30304":212,"_20976":50163,"_5":14428,"_27536":50055,"_2958":50164},[],"To install a local checkout instead:",{"_3475":257,"_30304":212,"_20976":50166,"_5":14428,"_27536":50059,"_2958":50167},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3475":258,"_30304":212,"_20976":50169,"_5":14428,"_27536":50059,"_2958":50170},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3475":259,"_30304":212,"_20976":50172,"_5":14428,"_27536":50063,"_2958":50173},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3475":260,"_30304":212,"_20976":50175,"_5":14428,"_27536":50063,"_2958":50176},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3475":261,"_30304":212,"_20976":50178,"_5":14428,"_27536":50063,"_2958":50179},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3475":262,"_30304":212,"_20976":50181,"_5":14428,"_27536":50063,"_2958":50182},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3475":263,"_30304":212,"_20976":50184,"_5":14428,"_27536":50063,"_2958":50185},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3475":264,"_30304":212,"_20976":50187,"_5":14428,"_27536":50067,"_2958":50188},[],"Before going live, review:",{"_3475":265,"_30304":212,"_20976":50190,"_5":14428,"_27536":50067,"_2958":50191},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3475":266,"_30304":212,"_20976":50193,"_5":14428,"_27536":50067,"_2958":50194},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3475":267,"_30304":212,"_20976":50196,"_5":14428,"_27536":50067,"_2958":50197},[],"shared VA storage before increasing VA replicas",{"_3475":268,"_30304":212,"_20976":50199,"_5":14428,"_27536":50067,"_2958":50200},[],"managed OIDC roles and removal of evaluation credentials",{"_3475":269,"_30304":212,"_20976":50202,"_5":14428,"_27536":50067,"_2958":50203},[],"a trusted TLS issuer or externally managed certificate",{"_3475":270,"_30304":212,"_20976":50205,"_5":14428,"_27536":50067,"_2958":50206},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3475":271,"_30304":212,"_20976":50208,"_5":14428,"_27536":50067,"_2958":50209},[],"SMTP, observability and alert delivery",{"_3475":272,"_30304":212,"_20976":50211,"_5":14428,"_27536":50067,"_2958":50212},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3475":273,"_30304":212,"_20976":50214,"_5":14428,"_27536":50067,"_2958":50215},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3475":274,"_30304":274,"_5":14780,"_2958":50217,"_30657":50218,"_20976":50219,"_27536":274},"Expose the Gateway",[49412,49413,49519],[],{"_3475":275,"_30304":274,"_20976":50221,"_5":14428,"_27536":274,"_2958":50222},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3475":276,"_30304":274,"_5":30654,"_20976":50224,"_27536":50225,"_2958":50226},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3475":277,"_30304":274,"_5":30654,"_20976":50228,"_27536":50229,"_2958":50230},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3475":278,"_30304":274,"_5":30654,"_20976":50232,"_27536":50233,"_2958":50234},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3475":279,"_30304":274,"_5":30654,"_20976":50236,"_27536":50237,"_2958":50238},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#k3s","K3s",{"_3475":280,"_30304":274,"_5":30654,"_20976":50240,"_27536":50241,"_2958":50242},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3475":281,"_30304":274,"_5":30654,"_20976":50244,"_27536":50245,"_2958":50246},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3475":282,"_30304":274,"_5":30654,"_20976":50248,"_27536":50249,"_2958":50250},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3475":283,"_30304":274,"_5":30654,"_20976":50252,"_27536":50253,"_2958":50254},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3475":284,"_30304":274,"_5":30654,"_20976":50256,"_27536":50257,"_2958":50258},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3475":285,"_30304":274,"_5":30654,"_20976":50260,"_27536":50261,"_2958":50262},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3475":286,"_30304":274,"_5":30654,"_20976":50264,"_27536":50265,"_2958":50266},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3475":287,"_30304":274,"_20976":50268,"_5":14428,"_27536":50225,"_2958":50269},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3475":288,"_30304":274,"_20976":50271,"_5":14428,"_27536":50225,"_2958":50272},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3475":289,"_30304":274,"_20976":50274,"_5":14428,"_27536":50229,"_2958":50275},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3475":290,"_30304":274,"_20976":50277,"_5":14428,"_27536":50229,"_2958":50278},[],"Set it only when:",{"_3475":291,"_30304":274,"_20976":50280,"_5":14428,"_27536":50229,"_2958":50281},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3475":292,"_30304":274,"_20976":50283,"_5":14428,"_27536":50229,"_2958":50284},[],"that address is allocated to this Gateway",{"_3475":293,"_30304":274,"_20976":50286,"_5":14428,"_27536":50229,"_2958":50287},[],"the surrounding network already routes traffic for it to the cluster",{"_3475":294,"_30304":274,"_20976":50289,"_5":14428,"_27536":50229,"_2958":50290},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3475":295,"_30304":274,"_20976":50292,"_5":14428,"_27536":50229,"_2958":50293},[],"Keep these two settings separate:",{"_3475":296,"_30304":274,"_20976":50295,"_5":14428,"_27536":50229,"_2958":50296},[],"`gateway.addresses` requests an address for the Gateway.",{"_3475":297,"_30304":274,"_20976":50298,"_5":14428,"_27536":50229,"_2958":50299},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3475":298,"_30304":274,"_20976":50301,"_5":14428,"_27536":50229,"_2958":50302},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3475":299,"_30304":274,"_20976":50304,"_5":14428,"_27536":50233,"_2958":50305},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3475":300,"_30304":274,"_20976":50307,"_5":14428,"_27536":50233,"_2958":50308},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3475":301,"_30304":274,"_20976":50310,"_5":14428,"_27536":50237,"_2958":50311},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3475":302,"_30304":274,"_20976":50313,"_5":14428,"_27536":50237,"_2958":50314},[],"For the recommended design:",{"_3475":303,"_30304":274,"_20976":50316,"_5":14428,"_27536":50237,"_2958":50317},[],"Use only one externally exposed Lamassu Gateway.",{"_3475":304,"_30304":274,"_20976":50319,"_5":14428,"_27536":50237,"_2958":50320},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3475":305,"_30304":274,"_20976":50322,"_5":14428,"_27536":50237,"_2958":50323},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3475":306,"_30304":274,"_20976":50325,"_5":14428,"_27536":50237,"_2958":50326},[],"Point DNS at the VM's reachable address.",{"_3475":307,"_30304":274,"_20976":50328,"_5":14428,"_27536":50237,"_2958":50329},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3475":308,"_30304":274,"_20976":50331,"_5":14428,"_27536":50241,"_2958":50332},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3475":309,"_30304":274,"_20976":50334,"_5":14428,"_27536":50245,"_2958":50335},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3475":310,"_30304":274,"_20976":50337,"_5":14428,"_27536":50245,"_2958":50338},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3475":311,"_30304":274,"_20976":50340,"_5":14428,"_27536":50249,"_2958":50341},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3475":312,"_30304":274,"_20976":50343,"_5":14428,"_27536":50249,"_2958":50344},[],"Requirement",{"_3475":313,"_30304":274,"_20976":50346,"_5":14428,"_27536":50249,"_2958":50347},[],"Recommended design",{"_3475":314,"_30304":274,"_20976":50349,"_5":14428,"_27536":50249,"_2958":50350},[],"Consequence",{"_3475":315,"_30304":274,"_20976":50352,"_5":14428,"_27536":50249,"_2958":50353},[],"Several Lamassu URLs or services",{"_3475":316,"_30304":274,"_20976":50355,"_5":14428,"_27536":50249,"_2958":50356},[],"One Gateway with multiple routes",{"_3475":317,"_30304":274,"_20976":50358,"_5":14428,"_27536":50249,"_2958":50359},[],"One IP and one proxy fleet; this is the chart default",{"_3475":318,"_30304":274,"_20976":50361,"_5":14428,"_27536":50249,"_2958":50362},[],"Independent Gateways and separate external IPs",{"_3475":319,"_30304":274,"_20976":50364,"_5":14428,"_27536":50249,"_2958":50365},[],"One VIP per Gateway",{"_3475":320,"_30304":274,"_20976":50367,"_5":14428,"_27536":50249,"_2958":50368},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3475":321,"_30304":274,"_20976":50370,"_5":14428,"_27536":50249,"_2958":50371},[],"Independent Gateways on one node and one IP",{"_3475":322,"_30304":274,"_20976":50373,"_5":14428,"_27536":50249,"_2958":50374},[],"Use different external ports",{"_3475":323,"_30304":274,"_20976":50376,"_5":14428,"_27536":50249,"_2958":50377},[],"Clients must include non-standard ports",{"_3475":324,"_30304":274,"_20976":50379,"_5":14428,"_27536":50249,"_2958":50380},[],"Separate TLS/mTLS termination behind one IP",{"_3475":325,"_30304":274,"_20976":50382,"_5":14428,"_27536":50249,"_2958":50383},[],"Front-door SNI routing to internal Gateways",{"_3475":326,"_30304":274,"_20976":50385,"_5":14428,"_27536":50249,"_2958":50386},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3475":327,"_30304":274,"_20976":50388,"_5":14428,"_27536":50249,"_2958":50389},[],"Separate Gateway resources but shared proxy infrastructure",{"_3475":328,"_30304":274,"_20976":50391,"_5":14428,"_27536":50249,"_2958":50392},[],"Envoy merged-Gateway mode",{"_3475":329,"_30304":274,"_20976":50394,"_5":14428,"_27536":50249,"_2958":50395},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3475":330,"_30304":274,"_20976":50397,"_5":14428,"_27536":50249,"_2958":50398},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3475":331,"_30304":274,"_20976":50400,"_5":14428,"_27536":50249,"_2958":50401},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3475":332,"_30304":274,"_20976":50403,"_5":14428,"_27536":50249,"_2958":50404},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3475":333,"_30304":274,"_20976":50406,"_5":14428,"_27536":50249,"_2958":50407},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3475":334,"_30304":274,"_20976":50409,"_5":14428,"_27536":50253,"_2958":50410},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3475":335,"_30304":274,"_20976":50412,"_5":14428,"_27536":50257,"_2958":50413},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3475":336,"_30304":274,"_20976":50415,"_5":14428,"_27536":50257,"_2958":50416},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3475":337,"_30304":274,"_20976":50418,"_5":14428,"_27536":50257,"_2958":50419},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3475":338,"_30304":274,"_20976":50421,"_5":14428,"_27536":50257,"_2958":50422},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3475":339,"_30304":274,"_20976":50424,"_5":14428,"_27536":50257,"_2958":50425},[],"If none of those are possible, use different external ports or change the external network design.",{"_3475":340,"_30304":274,"_20976":50427,"_5":14428,"_27536":50261,"_2958":50428},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3475":341,"_30304":274,"_20976":50430,"_5":14428,"_27536":50261,"_2958":50431},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3475":342,"_30304":274,"_20976":50433,"_5":14428,"_27536":50265,"_2958":50434},[],"Check, in order:",{"_3475":343,"_30304":274,"_20976":50436,"_5":14428,"_27536":50265,"_2958":50437},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3475":344,"_30304":274,"_20976":50439,"_5":14428,"_27536":50265,"_2958":50440},[],"Its status contains the expected address.",{"_3475":345,"_30304":274,"_20976":50442,"_5":14428,"_27536":50265,"_2958":50443},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3475":346,"_30304":274,"_20976":50445,"_5":14428,"_27536":50265,"_2958":50446},[],"Port 443 reaches that address from the client network.",{"_3475":347,"_30304":274,"_20976":50448,"_5":14428,"_27536":50265,"_2958":50449},[],"DNS resolves to the externally reachable endpoint.",{"_3475":348,"_30304":274,"_20976":50451,"_5":14428,"_27536":50265,"_2958":50452},[],"The certificate contains the DNS name or IP used by the client.",{"_3475":349,"_30304":274,"_20976":50454,"_5":14428,"_27536":50265,"_2958":50455},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3475":350,"_30304":350,"_5":14780,"_2958":49519,"_30657":50457,"_20976":50458,"_27536":350},[49412,49413,49519],[],{"_3475":351,"_30304":350,"_20976":50460,"_5":14428,"_27536":350,"_2958":50461},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3475":352,"_30304":350,"_5":30654,"_20976":50463,"_27536":50464,"_2958":50465},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3475":353,"_30304":350,"_5":30654,"_20976":50467,"_27536":50468,"_2958":50469},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3475":354,"_30304":350,"_5":30654,"_20976":50471,"_27536":50472,"_2958":50473},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3475":355,"_30304":350,"_5":30654,"_20976":50475,"_27536":50476,"_2958":50477},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3475":356,"_30304":350,"_5":30654,"_20976":50479,"_27536":50480,"_2958":50481},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3475":357,"_30304":350,"_5":30654,"_20976":50483,"_27536":50484,"_2958":50485},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3475":358,"_30304":350,"_20976":50487,"_5":14428,"_27536":50464,"_2958":50488},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3475":359,"_30304":350,"_20976":50490,"_5":14428,"_27536":50468,"_2958":50491},[],"Workflow",{"_3475":360,"_30304":350,"_20976":50493,"_5":14428,"_27536":50468,"_2958":50494},[],"Use it for",{"_3475":361,"_30304":350,"_20976":50496,"_5":14428,"_27536":50468,"_2958":50497},[],"What it installs",{"_3475":362,"_30304":350,"_20976":50499,"_5":14428,"_27536":50468,"_2958":50500},[],"Helm",{"_3475":363,"_30304":350,"_20976":50502,"_5":14428,"_27536":50468,"_2958":50503},[],"Production and controlled environments",{"_3475":364,"_30304":350,"_20976":50505,"_5":14428,"_27536":50468,"_2958":50506},[],"Lamassu services and Gateway API resources",{"_3475":365,"_30304":350,"_20976":50508,"_5":14428,"_27536":50468,"_2958":49656},[],{"_3475":366,"_30304":350,"_20976":50510,"_5":14428,"_27536":50468,"_2958":50511},[],"Evaluation, demos, CI and small lab clusters",{"_3475":367,"_30304":350,"_20976":50513,"_5":14428,"_27536":50468,"_2958":50514},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3475":368,"_30304":350,"_20976":50516,"_5":14428,"_27536":50472,"_2958":50517},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3475":369,"_30304":350,"_20976":50519,"_5":14428,"_27536":50472,"_2958":50520},[],"Area",{"_3475":370,"_30304":350,"_20976":50522,"_5":14428,"_27536":50472,"_2958":50523},[],"The Lamassu chart provides",{"_3475":371,"_30304":350,"_20976":50525,"_5":14428,"_27536":50472,"_2958":50526},[],"You provide",{"_3475":372,"_30304":350,"_20976":50528,"_5":14428,"_27536":50472,"_2958":50529},[],"Lamassu applications",{"_3475":373,"_30304":350,"_20976":50531,"_5":14428,"_27536":50472,"_2958":50532},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3475":374,"_30304":350,"_20976":50534,"_5":14428,"_27536":50472,"_2958":50535},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3475":375,"_30304":350,"_20976":50537,"_5":14428,"_27536":50472,"_2958":50538},[],"PostgreSQL data",{"_3475":376,"_30304":350,"_20976":50540,"_5":14428,"_27536":50472,"_2958":50541},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3475":377,"_30304":350,"_20976":50543,"_5":14428,"_27536":50472,"_2958":50544},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3475":378,"_30304":350,"_20976":50546,"_5":14428,"_27536":50472,"_2958":50547},[],"Messaging",{"_3475":379,"_30304":350,"_20976":50549,"_5":14428,"_27536":50472,"_2958":50550},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3475":380,"_30304":350,"_20976":50552,"_5":14428,"_27536":50472,"_2958":50553},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3475":381,"_30304":350,"_20976":50555,"_5":14428,"_27536":50472,"_2958":50556},[],"Identity",{"_3475":382,"_30304":350,"_20976":50558,"_5":14428,"_27536":50472,"_2958":50559},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3475":383,"_30304":350,"_20976":50561,"_5":14428,"_27536":50472,"_2958":50562},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3475":384,"_30304":350,"_20976":50564,"_5":14428,"_27536":50472,"_2958":50565},[],"External routing",{"_3475":385,"_30304":350,"_20976":50567,"_5":14428,"_27536":50472,"_2958":50568},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3475":386,"_30304":350,"_20976":50570,"_5":14428,"_27536":50472,"_2958":50571},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3475":387,"_30304":350,"_20976":50573,"_5":14428,"_27536":50472,"_2958":50574},[],"TLS",{"_3475":388,"_30304":350,"_20976":50576,"_5":14428,"_27536":50472,"_2958":50577},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3475":389,"_30304":350,"_20976":50579,"_5":14428,"_27536":50472,"_2958":50580},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3475":390,"_30304":350,"_20976":50582,"_5":14428,"_27536":50472,"_2958":50583},[],"Persistent application data",{"_3475":391,"_30304":350,"_20976":50585,"_5":14428,"_27536":50472,"_2958":50586},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3475":392,"_30304":350,"_20976":50588,"_5":14428,"_27536":50472,"_2958":50589},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3475":393,"_30304":350,"_20976":50591,"_5":14428,"_27536":50472,"_2958":50592},[],"Optional integrations",{"_3475":394,"_30304":350,"_20976":50594,"_5":14428,"_27536":50472,"_2958":50595},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3475":395,"_30304":350,"_20976":50597,"_5":14428,"_27536":50472,"_2958":50598},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3475":396,"_30304":350,"_20976":50600,"_5":14428,"_27536":50472,"_2958":50601},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3475":397,"_30304":350,"_20976":50603,"_5":14428,"_27536":50472,"_2958":50604},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3475":398,"_30304":350,"_20976":50606,"_5":14428,"_27536":50476,"_2958":50607},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3475":399,"_30304":350,"_20976":50609,"_5":14428,"_27536":50476,"_2958":50610},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3475":400,"_30304":350,"_20976":50612,"_5":14428,"_27536":50480,"_2958":50613},[],"Kubernetes 1.24 or newer",{"_3475":401,"_30304":350,"_20976":50615,"_5":14428,"_27536":50480,"_2958":50616},[],"Helm 3.2 or newer",{"_3475":402,"_30304":350,"_20976":50618,"_5":14428,"_27536":50480,"_2958":50619},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3475":403,"_30304":350,"_20976":50621,"_5":14428,"_27536":50480,"_2958":50622},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3475":404,"_30304":350,"_20976":50624,"_5":14428,"_27536":50480,"_2958":50625},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3475":405,"_30304":350,"_20976":50627,"_5":14428,"_27536":50480,"_2958":50628},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3475":406,"_30304":350,"_20976":50630,"_5":14428,"_27536":50480,"_2958":50631},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3475":407,"_30304":350,"_20976":50633,"_5":14428,"_27536":50484,"_2958":50634},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3475":408,"_30304":350,"_20976":50636,"_5":14428,"_27536":50484,"_2958":50637},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3475":409,"_30304":350,"_20976":50639,"_5":14428,"_27536":50484,"_2958":50640},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3475":410,"_30304":350,"_20976":50642,"_5":14428,"_27536":50484,"_2958":50643},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3475":411,"_30304":411,"_5":14780,"_2958":50645,"_30657":50646,"_20976":50648,"_27536":411},"Deployment troubleshooting",[49412,49413,50647],"Operations",[],{"_3475":412,"_30304":411,"_20976":50650,"_5":14428,"_27536":411,"_2958":50651},[],"Diagnose access, service health and infrastructure dependencies.",{"_3475":413,"_30304":411,"_5":30654,"_20976":50653,"_27536":50654,"_2958":50655},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3475":414,"_30304":411,"_5":30654,"_20976":50657,"_27536":50658,"_2958":50659},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3475":415,"_30304":411,"_5":30654,"_20976":50661,"_27536":50662,"_2958":50663},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3475":416,"_30304":411,"_5":30654,"_20976":50665,"_27536":50666,"_2958":50667},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3475":417,"_30304":411,"_5":30654,"_20976":50669,"_27536":50670,"_2958":50671},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3475":418,"_30304":411,"_5":30654,"_20976":50673,"_27536":50674,"_2958":50675},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3475":419,"_30304":411,"_5":30654,"_20976":50677,"_27536":50678,"_2958":50679},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3475":420,"_30304":411,"_5":30654,"_20976":50681,"_27536":50682,"_2958":50683},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3475":421,"_30304":411,"_5":30654,"_20976":50685,"_27536":50686,"_2958":50687},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3475":422,"_30304":411,"_5":30654,"_20976":50689,"_27536":50690,"_2958":50691},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3475":423,"_30304":411,"_5":30654,"_20976":50693,"_27536":50694,"_2958":50695},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3475":424,"_30304":411,"_5":30654,"_20976":50697,"_27536":50698,"_2958":50699},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3475":425,"_30304":411,"_5":30654,"_20976":50701,"_27536":50702,"_2958":50703},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#observability","Observability",{"_3475":426,"_30304":411,"_20976":50705,"_5":14428,"_27536":411,"_2958":50706},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3475":427,"_30304":411,"_20976":50708,"_5":14428,"_27536":50658,"_2958":50709},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3475":428,"_30304":411,"_20976":50711,"_5":14428,"_27536":50662,"_2958":50712},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3475":429,"_30304":411,"_20976":50714,"_5":14428,"_27536":50666,"_2958":50715},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3475":430,"_30304":411,"_20976":50717,"_5":14428,"_27536":50670,"_2958":50718},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3475":431,"_30304":411,"_20976":50720,"_5":14428,"_27536":50674,"_2958":50721},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3475":432,"_30304":411,"_20976":50723,"_5":14428,"_27536":50678,"_2958":50724},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3475":433,"_30304":411,"_20976":50726,"_5":14428,"_27536":50678,"_2958":50727},[],"Also run the chart's connectivity test:",{"_3475":434,"_30304":411,"_20976":50729,"_5":14428,"_27536":50678,"_2958":50730},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3475":435,"_30304":411,"_20976":50732,"_5":14428,"_27536":50678,"_2958":50733},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3475":436,"_30304":411,"_20976":50735,"_5":14428,"_27536":50682,"_2958":50736},[],"If you receive a 401:",{"_3475":437,"_30304":411,"_20976":50738,"_5":14428,"_27536":50682,"_2958":50739},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3475":438,"_30304":411,"_20976":50741,"_5":14428,"_27536":50682,"_2958":50742},[],"verify issuer, audience and expiration of the token;",{"_3475":439,"_30304":411,"_20976":50744,"_5":14428,"_27536":50682,"_2958":50745},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3475":440,"_30304":411,"_20976":50747,"_5":14428,"_27536":50682,"_2958":50748},[],"check that the provider's public and internal routes point to the same realm.",{"_3475":441,"_30304":411,"_20976":50750,"_5":14428,"_27536":50682,"_2958":50751},[],"If login succeeds but the APIs return 403:",{"_3475":442,"_30304":411,"_20976":50753,"_5":14428,"_27536":50682,"_2958":50754},[],"inspect the token's real claims;",{"_3475":443,"_30304":411,"_20976":50756,"_5":14428,"_27536":50682,"_2958":50757},[],"confirm they match an active principal;",{"_3475":444,"_30304":411,"_20976":50759,"_5":14428,"_27536":50682,"_2958":50760},[],"review the policies granted to that principal;",{"_3475":445,"_30304":411,"_20976":50762,"_5":14428,"_27536":50682,"_2958":50763},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3475":446,"_30304":411,"_20976":50765,"_5":14428,"_27536":50682,"_2958":50766},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3475":447,"_30304":411,"_20976":50768,"_5":14428,"_27536":50686,"_2958":50769},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3475":448,"_30304":411,"_20976":50771,"_5":14428,"_27536":50686,"_2958":50772},[],"Locate the authz pod and Service.",{"_3475":449,"_30304":411,"_20976":50774,"_5":14428,"_27536":50686,"_2958":50775},[],"Check /health, logs and its database connection.",{"_3475":450,"_30304":411,"_20976":50777,"_5":14428,"_27536":50686,"_2958":50778},[],"Verify the DNS and port configured in externalAuthorization.",{"_3475":451,"_30304":411,"_20976":50780,"_5":14428,"_27536":50686,"_2958":50781},[],"Check the check route is /v1/ext\\_authz/check.",{"_3475":452,"_30304":411,"_20976":50783,"_5":14428,"_27536":50686,"_2958":50784},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3475":453,"_30304":411,"_20976":50786,"_5":14428,"_27536":50690,"_2958":50787},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3475":454,"_30304":411,"_20976":50789,"_5":14428,"_27536":50694,"_2958":50790},[],"Review kubectl describe pod first. Common causes are:",{"_3475":455,"_30304":411,"_20976":50792,"_5":14428,"_27536":50694,"_2958":50793},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3475":456,"_30304":411,"_20976":50795,"_5":14428,"_27536":50694,"_2958":50796},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3475":457,"_30304":411,"_20976":50798,"_5":14428,"_27536":50694,"_2958":50799},[],"unbound persistent volume;",{"_3475":458,"_30304":411,"_20976":50801,"_5":14428,"_27536":50694,"_2958":50802},[],"inaccessible image or incorrect pull policy;",{"_3475":459,"_30304":411,"_20976":50804,"_5":14428,"_27536":50694,"_2958":50805},[],"invalid cryptographic engine configuration;",{"_3475":460,"_30304":411,"_20976":50807,"_5":14428,"_27536":50694,"_2958":50808},[],"CPU or memory limits set too low;",{"_3475":461,"_30304":411,"_20976":50810,"_5":14428,"_27536":50694,"_2958":50811},[],"an incomplete prior migration.",{"_3475":462,"_30304":411,"_20976":50813,"_5":14428,"_27536":50694,"_2958":50814},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3475":463,"_30304":411,"_20976":50816,"_5":14428,"_27536":50694,"_2958":50817},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3475":464,"_30304":411,"_20976":50819,"_5":14428,"_27536":50694,"_2958":50820},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3475":465,"_30304":411,"_20976":50822,"_5":14428,"_27536":50698,"_2958":50823},[],"Domain and audit events depend on the bus publisher:",{"_3475":466,"_30304":411,"_20976":50825,"_5":14428,"_27536":50698,"_2958":50826},[],"verify it is enabled in the emitting service;",{"_3475":467,"_30304":411,"_20976":50828,"_5":14428,"_27536":50698,"_2958":50829},[],"check AMQP connectivity and credentials;",{"_3475":468,"_30304":411,"_20976":50831,"_5":14428,"_27536":50698,"_2958":50832},[],"review exchange, routing key, queues and consumers;",{"_3475":469,"_30304":411,"_20976":50834,"_5":14428,"_27536":50698,"_2958":50835},[],"inspect dead-letter queues;",{"_3475":470,"_30304":411,"_20976":50837,"_5":14428,"_27536":50698,"_2958":50838},[],"alert on orphan durable queues and backlog growth.",{"_3475":471,"_30304":411,"_20976":50840,"_5":14428,"_27536":50698,"_2958":50841},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3475":472,"_30304":411,"_20976":50843,"_5":14428,"_27536":50698,"_2958":50844},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3475":473,"_30304":411,"_20976":50846,"_5":14428,"_27536":50698,"_2958":50847},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3475":474,"_30304":411,"_20976":50849,"_5":14428,"_27536":50698,"_2958":50850},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3475":475,"_30304":411,"_20976":50852,"_5":14428,"_27536":50698,"_2958":50853},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3475":476,"_30304":411,"_20976":50855,"_5":14428,"_27536":50698,"_2958":50856},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3475":477,"_30304":411,"_20976":50858,"_5":14428,"_27536":50698,"_2958":50859},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3475":478,"_30304":411,"_20976":50861,"_5":14428,"_27536":50702,"_2958":50862},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3475":479,"_30304":411,"_20976":50864,"_5":14428,"_27536":50702,"_2958":50865},[],"Before closing an incident, record:",{"_3475":480,"_30304":411,"_20976":50867,"_5":14428,"_27536":50702,"_2958":50868},[],"the confirmed cause;",{"_3475":481,"_30304":411,"_20976":50870,"_5":14428,"_27536":50702,"_2958":50871},[],"the time scope and affected resources;",{"_3475":482,"_30304":411,"_20976":50873,"_5":14428,"_27536":50702,"_2958":50874},[],"the commands or queries used;",{"_3475":483,"_30304":411,"_20976":50876,"_5":14428,"_27536":50702,"_2958":50877},[],"the applied change and how to revert it;",{"_3475":484,"_30304":411,"_20976":50879,"_5":14428,"_27536":50702,"_2958":50880},[],"validation from a consumer;",{"_3475":485,"_30304":411,"_20976":50882,"_5":14428,"_27536":50702,"_2958":50883},[],"the preventive action and its owner.",{"_3475":486,"_30304":486,"_5":14780,"_2958":50885,"_30657":50886,"_20976":50889,"_27536":486},"Access control",[49412,50887,50888],"Platform","Administration",[],{"_3475":487,"_30304":486,"_20976":50891,"_5":14428,"_27536":486,"_2958":50892},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3475":488,"_30304":486,"_5":30654,"_20976":50894,"_27536":50895,"_2958":50896},[],"/docs/pr-preview/pr-65/platform/administration/access-control#essential-concepts","Essential concepts",{"_3475":489,"_30304":486,"_5":30654,"_20976":50898,"_27536":50899,"_2958":50900},[],"/docs/pr-preview/pr-65/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3475":490,"_30304":486,"_5":30654,"_20976":50902,"_27536":50903,"_2958":50904},[],"/docs/pr-preview/pr-65/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3475":491,"_30304":486,"_5":30654,"_20976":50906,"_27536":50907,"_2958":50908},[],"/docs/pr-preview/pr-65/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3475":492,"_30304":486,"_5":30654,"_20976":50910,"_27536":50911,"_2958":50912},[],"/docs/pr-preview/pr-65/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3475":493,"_30304":486,"_5":30654,"_20976":50914,"_27536":50915,"_2958":50916},[],"/docs/pr-preview/pr-65/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3475":494,"_30304":486,"_5":30654,"_20976":50918,"_27536":50919,"_2958":50920},[],"/docs/pr-preview/pr-65/platform/administration/access-control#oidc-principals","OIDC principals",{"_3475":495,"_30304":486,"_5":30654,"_20976":50922,"_27536":50923,"_2958":50924},[],"/docs/pr-preview/pr-65/platform/administration/access-control#x509-principals","X.509 principals",{"_3475":496,"_30304":486,"_5":30654,"_20976":50926,"_27536":50927,"_2958":50928},[],"/docs/pr-preview/pr-65/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3475":497,"_30304":486,"_5":30654,"_20976":50930,"_27536":50931,"_2958":50932},[],"/docs/pr-preview/pr-65/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3475":498,"_30304":486,"_5":30654,"_20976":50934,"_27536":50935,"_2958":50936},[],"/docs/pr-preview/pr-65/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3475":499,"_30304":486,"_5":30654,"_20976":50938,"_27536":50939,"_2958":50940},[],"/docs/pr-preview/pr-65/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3475":500,"_30304":486,"_5":30654,"_20976":50942,"_27536":50943,"_2958":50944},[],"/docs/pr-preview/pr-65/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3475":501,"_30304":486,"_5":30654,"_20976":50946,"_27536":50947,"_2958":50948},[],"/docs/pr-preview/pr-65/platform/administration/access-control#http-rules","HTTP rules",{"_3475":502,"_30304":486,"_5":30654,"_20976":50950,"_27536":50951,"_2958":50952},[],"/docs/pr-preview/pr-65/platform/administration/access-control#included-policies","Included policies",{"_3475":503,"_30304":486,"_5":30654,"_20976":50954,"_27536":50955,"_2958":50052},[],"/docs/pr-preview/pr-65/platform/administration/access-control#provision-the-first-administrator",{"_3475":504,"_30304":486,"_5":30654,"_20976":50957,"_27536":50958,"_2958":50959},[],"/docs/pr-preview/pr-65/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3475":505,"_30304":486,"_5":30654,"_20976":50961,"_27536":50962,"_2958":50963},[],"/docs/pr-preview/pr-65/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3475":506,"_30304":486,"_5":30654,"_20976":50965,"_27536":50966,"_2958":50967},[],"/docs/pr-preview/pr-65/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3475":507,"_30304":486,"_5":30654,"_20976":50969,"_27536":50970,"_2958":50971},[],"/docs/pr-preview/pr-65/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3475":508,"_30304":486,"_5":30654,"_20976":50973,"_27536":50974,"_2958":50975},[],"/docs/pr-preview/pr-65/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3475":509,"_30304":486,"_5":30654,"_20976":50977,"_27536":50978,"_2958":50979},[],"/docs/pr-preview/pr-65/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3475":510,"_30304":486,"_5":30654,"_20976":50981,"_27536":50982,"_2958":50983},[],"/docs/pr-preview/pr-65/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3475":511,"_30304":486,"_5":30654,"_20976":50985,"_27536":50986,"_2958":50987},[],"/docs/pr-preview/pr-65/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3475":512,"_30304":486,"_5":30654,"_20976":50989,"_27536":50990,"_2958":50991},[],"/docs/pr-preview/pr-65/platform/administration/access-control#operational-checklist","Operational checklist",{"_3475":513,"_30304":486,"_5":30654,"_20976":50993,"_27536":50994,"_2958":50995},[],"/docs/pr-preview/pr-65/platform/administration/access-control#diagnostics","Diagnostics",{"_3475":514,"_30304":486,"_5":30654,"_20976":50997,"_27536":50998,"_2958":50999},[],"/docs/pr-preview/pr-65/platform/administration/access-control#the-response-is-401","The response is 401",{"_3475":515,"_30304":486,"_5":30654,"_20976":51001,"_27536":51002,"_2958":51003},[],"/docs/pr-preview/pr-65/platform/administration/access-control#the-response-is-403","The response is 403",{"_3475":516,"_30304":486,"_5":30654,"_20976":51005,"_27536":51006,"_2958":51007},[],"/docs/pr-preview/pr-65/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3475":517,"_30304":486,"_5":30654,"_20976":51009,"_27536":51010,"_2958":51011},[],"/docs/pr-preview/pr-65/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3475":518,"_30304":486,"_5":30654,"_20976":51013,"_27536":51014,"_2958":51015},[],"/docs/pr-preview/pr-65/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3475":519,"_30304":486,"_20976":51017,"_5":14428,"_27536":486,"_2958":51018},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3475":520,"_30304":486,"_20976":51020,"_5":14428,"_27536":486,"_2958":51021},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3475":521,"_30304":486,"_20976":51023,"_5":14428,"_27536":486,"_2958":51024},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3475":522,"_30304":486,"_20976":51026,"_5":14428,"_27536":50895,"_2958":51027},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3475":523,"_30304":486,"_20976":51029,"_5":14428,"_27536":50895,"_2958":51030},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3475":524,"_30304":486,"_20976":51032,"_5":14428,"_27536":50895,"_2958":51033},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3475":525,"_30304":486,"_20976":51035,"_5":14428,"_27536":50895,"_2958":51036},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3475":526,"_30304":486,"_20976":51038,"_5":14428,"_27536":50895,"_2958":51039},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3475":527,"_30304":486,"_20976":51041,"_5":14428,"_27536":50895,"_2958":51042},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3475":528,"_30304":486,"_20976":51044,"_5":14428,"_27536":50899,"_2958":51045},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3475":529,"_30304":486,"_20976":51047,"_5":14428,"_27536":50899,"_2958":51048},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3475":530,"_30304":486,"_20976":51050,"_5":14428,"_27536":50903,"_2958":51051},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3475":531,"_30304":486,"_20976":51053,"_5":14428,"_27536":50903,"_2958":51054},[],"The decision is made **before forwarding the request to the service**:",{"_3475":532,"_30304":486,"_20976":51056,"_5":14428,"_27536":50903,"_2958":51057},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3475":533,"_30304":486,"_20976":51059,"_5":14428,"_27536":50903,"_2958":51060},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3475":534,"_30304":486,"_20976":51062,"_5":14428,"_27536":50903,"_2958":51063},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3475":535,"_30304":486,"_20976":51065,"_5":14428,"_27536":50903,"_2958":51066},[],"It separately loads the policies granted to each principal.",{"_3475":536,"_30304":486,"_20976":51068,"_5":14428,"_27536":50903,"_2958":51069},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3475":537,"_30304":486,"_20976":51071,"_5":14428,"_27536":50903,"_2958":51072},[],"`authz` looks for an HTTP rule granting that action.",{"_3475":538,"_30304":486,"_20976":51074,"_5":14428,"_27536":50903,"_2958":51075},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3475":539,"_30304":486,"_20976":51077,"_5":14428,"_27536":50903,"_2958":51078},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3475":540,"_30304":486,"_20976":51080,"_5":14428,"_27536":50903,"_2958":51081},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3475":541,"_30304":486,"_20976":51083,"_5":14428,"_27536":50903,"_2958":51084},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3475":542,"_30304":486,"_20976":51086,"_5":14428,"_27536":50907,"_2958":51087},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3475":543,"_30304":486,"_20976":51089,"_5":14428,"_27536":50907,"_2958":51090},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3475":544,"_30304":486,"_20976":51092,"_5":14428,"_27536":50907,"_2958":51093},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3475":545,"_30304":486,"_20976":51095,"_5":14428,"_27536":50907,"_2958":51096},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3475":546,"_30304":486,"_20976":51098,"_5":14428,"_27536":50907,"_2958":51099},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3475":547,"_30304":486,"_20976":51101,"_5":14428,"_27536":50907,"_2958":51102},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3475":548,"_30304":486,"_20976":51104,"_5":14428,"_27536":50907,"_2958":51105},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3475":549,"_30304":486,"_20976":51107,"_5":14428,"_27536":50907,"_2958":51108},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3475":550,"_30304":486,"_20976":51110,"_5":14428,"_27536":50911,"_2958":51111},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3475":551,"_30304":486,"_20976":51113,"_5":14428,"_27536":50911,"_2958":51114},[],"The decision is made with the domain operation context:",{"_3475":552,"_30304":486,"_20976":51116,"_5":14428,"_27536":50911,"_2958":51117},[],"The middleware extracts the credential and resolves the matching principals.",{"_3475":553,"_30304":486,"_20976":51119,"_5":14428,"_27536":50911,"_2958":51120},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3475":554,"_30304":486,"_20976":51122,"_5":14428,"_27536":50911,"_2958":51123},[],"`authz` gathers the entity rules of the granted policies.",{"_3475":555,"_30304":486,"_20976":51125,"_5":14428,"_27536":50911,"_2958":51126},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3475":556,"_30304":486,"_20976":51128,"_5":14428,"_27536":50911,"_2958":51129},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3475":557,"_30304":486,"_20976":51131,"_5":14428,"_27536":50911,"_2958":51132},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3475":558,"_30304":486,"_20976":51134,"_5":14428,"_27536":50911,"_2958":51135},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3475":559,"_30304":486,"_20976":51137,"_5":14428,"_27536":50911,"_2958":51138},[],"Actions fall into two groups:",{"_3475":560,"_30304":486,"_20976":51140,"_5":14428,"_27536":50911,"_2958":51141},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3475":561,"_30304":486,"_20976":51143,"_5":14428,"_27536":50911,"_2958":51144},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3475":562,"_30304":486,"_20976":51146,"_5":14428,"_27536":50911,"_2958":51147},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3475":563,"_30304":486,"_20976":51149,"_5":14428,"_27536":50915,"_2958":51150},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3475":564,"_30304":486,"_20976":51152,"_5":14428,"_27536":50915,"_2958":51153},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3475":565,"_30304":486,"_20976":51155,"_5":14428,"_27536":50915,"_2958":51156},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3475":566,"_30304":486,"_20976":51158,"_5":14428,"_27536":50919,"_2958":51159},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3475":567,"_30304":486,"_20976":51161,"_5":14428,"_27536":50919,"_2958":51162},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3475":568,"_30304":486,"_20976":51164,"_5":14428,"_27536":50919,"_2958":51165},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3475":569,"_30304":486,"_20976":51167,"_5":14428,"_27536":50919,"_2958":51168},[],"The implemented operators are:",{"_3475":570,"_30304":486,"_20976":51170,"_5":14428,"_27536":50919,"_2958":51171},[],"`equals`, for exact equality;",{"_3475":571,"_30304":486,"_20976":51173,"_5":14428,"_27536":50919,"_2958":51174},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3475":572,"_30304":486,"_20976":51176,"_5":14428,"_27536":50919,"_2958":51177},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3475":573,"_30304":486,"_20976":51179,"_5":14428,"_27536":50919,"_2958":51180},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3475":574,"_30304":486,"_20976":51182,"_5":14428,"_27536":50923,"_2958":51183},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3475":575,"_30304":486,"_20976":51185,"_5":14428,"_27536":50923,"_2958":51186},[],"The available modes are:",{"_3475":576,"_30304":486,"_20976":51188,"_5":14428,"_27536":50923,"_2958":51189},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3475":577,"_30304":486,"_20976":51191,"_5":14428,"_27536":50923,"_2958":51192},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3475":578,"_30304":486,"_20976":51194,"_5":14428,"_27536":50923,"_2958":51195},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3475":579,"_30304":486,"_20976":51197,"_5":14428,"_27536":50923,"_2958":51198},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3475":580,"_30304":486,"_20976":51200,"_5":14428,"_27536":50923,"_2958":51201},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3475":581,"_30304":486,"_20976":51203,"_5":14428,"_27536":50923,"_2958":51204},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3475":582,"_30304":486,"_20976":51206,"_5":14428,"_27536":50927,"_2958":51207},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3475":583,"_30304":486,"_20976":51209,"_5":14428,"_27536":50927,"_2958":51210},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3475":584,"_30304":486,"_20976":51212,"_5":14428,"_27536":50927,"_2958":51213},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3475":585,"_30304":486,"_20976":51215,"_5":14428,"_27536":50927,"_2958":51216},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3475":586,"_30304":486,"_20976":51218,"_5":14428,"_27536":50935,"_2958":51219},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3475":587,"_30304":486,"_20976":51221,"_5":14428,"_27536":50935,"_2958":51222},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3475":588,"_30304":486,"_20976":51224,"_5":14428,"_27536":50939,"_2958":51225},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3475":589,"_30304":486,"_20976":51227,"_5":14428,"_27536":50939,"_2958":51228},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3475":590,"_30304":486,"_20976":51230,"_5":14428,"_27536":50943,"_2958":51231},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3475":591,"_30304":486,"_20976":51233,"_5":14428,"_27536":50943,"_2958":51234},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3475":592,"_30304":486,"_20976":51236,"_5":14428,"_27536":50943,"_2958":51237},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3475":593,"_30304":486,"_20976":51239,"_5":14428,"_27536":50947,"_2958":51240},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3475":594,"_30304":486,"_20976":51242,"_5":14428,"_27536":50947,"_2958":51243},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3475":595,"_30304":486,"_20976":51245,"_5":14428,"_27536":50947,"_2958":51246},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3475":596,"_30304":486,"_20976":51248,"_5":14428,"_27536":50947,"_2958":51249},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3475":597,"_30304":486,"_20976":51251,"_5":14428,"_27536":50947,"_2958":51252},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3475":598,"_30304":486,"_20976":51254,"_5":14428,"_27536":50947,"_2958":51255},[],"Note that:",{"_3475":599,"_30304":486,"_20976":51257,"_5":14428,"_27536":50947,"_2958":51258},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3475":600,"_30304":486,"_20976":51260,"_5":14428,"_27536":50947,"_2958":51261},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3475":601,"_30304":486,"_20976":51263,"_5":14428,"_27536":50947,"_2958":51264},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3475":602,"_30304":486,"_20976":51266,"_5":14428,"_27536":50951,"_2958":51267},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3475":603,"_30304":486,"_20976":51269,"_5":14428,"_27536":50951,"_2958":51270},[],"full and read-only access to certificates and authorities;",{"_3475":604,"_30304":486,"_20976":51272,"_5":14428,"_27536":50951,"_2958":51273},[],"full and read-only access to the KMS;",{"_3475":605,"_30304":486,"_20976":51275,"_5":14428,"_27536":50951,"_2958":51276},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3475":606,"_30304":486,"_20976":51278,"_5":14428,"_27536":50951,"_2958":51279},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3475":607,"_30304":486,"_20976":51281,"_5":14428,"_27536":50951,"_2958":51282},[],"console access;",{"_3475":608,"_30304":486,"_20976":51284,"_5":14428,"_27536":50951,"_2958":51285},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3475":609,"_30304":486,"_20976":51287,"_5":14428,"_27536":50951,"_2958":51288},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3475":610,"_30304":486,"_20976":51290,"_5":14428,"_27536":50951,"_2958":51291},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3475":611,"_30304":486,"_20976":51293,"_5":14428,"_27536":50955,"_2958":51294},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3475":612,"_30304":486,"_20976":51296,"_5":14428,"_27536":50955,"_2958":51297},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3475":613,"_30304":486,"_20976":51299,"_5":14428,"_27536":50955,"_2958":51300},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3475":614,"_30304":486,"_20976":51302,"_5":14428,"_27536":50958,"_2958":51303},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3475":615,"_30304":486,"_20976":51305,"_5":14428,"_27536":50962,"_2958":51306},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3475":616,"_30304":486,"_20976":51308,"_5":14428,"_27536":50962,"_2958":51309},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3475":617,"_30304":486,"_20976":51311,"_5":14428,"_27536":50966,"_2958":51312},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3475":618,"_30304":486,"_20976":51314,"_5":14428,"_27536":50970,"_2958":51315},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3475":619,"_30304":486,"_20976":51317,"_5":14428,"_27536":50974,"_2958":51318},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3475":620,"_30304":486,"_20976":51320,"_5":14428,"_27536":50978,"_2958":51321},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3475":621,"_30304":486,"_20976":51323,"_5":14428,"_27536":50978,"_2958":51324},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3475":622,"_30304":486,"_20976":51326,"_5":14428,"_27536":50982,"_2958":51327},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3475":623,"_30304":486,"_20976":51329,"_5":14428,"_27536":50982,"_2958":51330},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3475":624,"_30304":486,"_20976":51332,"_5":14428,"_27536":50982,"_2958":51333},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3475":625,"_30304":486,"_20976":51335,"_5":14428,"_27536":50982,"_2958":51336},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3475":626,"_30304":486,"_20976":51338,"_5":14428,"_27536":50982,"_2958":51339},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3475":627,"_30304":486,"_20976":51341,"_5":14428,"_27536":50982,"_2958":51342},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3475":628,"_30304":486,"_20976":51344,"_5":14428,"_27536":50982,"_2958":51345},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3475":629,"_30304":486,"_20976":51347,"_5":14428,"_27536":50982,"_2958":51348},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3475":630,"_30304":486,"_20976":51350,"_5":14428,"_27536":50986,"_2958":51351},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3475":631,"_30304":486,"_20976":51353,"_5":14428,"_27536":50986,"_2958":51354},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3475":632,"_30304":486,"_20976":51356,"_5":14428,"_27536":50986,"_2958":51357},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3475":633,"_30304":486,"_20976":51359,"_5":14428,"_27536":50990,"_2958":51360},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3475":634,"_30304":486,"_20976":51362,"_5":14428,"_27536":50990,"_2958":51363},[],"Use groups or stable roles for people and independent identities for automations.",{"_3475":635,"_30304":486,"_20976":51365,"_5":14428,"_27536":50990,"_2958":51366},[],"Keep at least two recovery administrators and test their access periodically.",{"_3475":636,"_30304":486,"_20976":51368,"_5":14428,"_27536":50990,"_2958":51369},[],"Review active principals, their matches and their grants after IdP changes.",{"_3475":637,"_30304":486,"_20976":51371,"_5":14428,"_27536":50990,"_2958":51372},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3475":638,"_30304":486,"_20976":51374,"_5":14428,"_27536":50990,"_2958":51375},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3475":639,"_30304":486,"_20976":51377,"_5":14428,"_27536":50990,"_2958":51378},[],"Always test one allowed and one denied operation for each role.",{"_3475":640,"_30304":486,"_20976":51380,"_5":14428,"_27536":50990,"_2958":51381},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3475":641,"_30304":486,"_20976":51383,"_5":14428,"_27536":50998,"_2958":51384},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3475":642,"_30304":486,"_20976":51386,"_5":14428,"_27536":51002,"_2958":51387},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3475":643,"_30304":486,"_20976":51389,"_5":14428,"_27536":51002,"_2958":51390},[],"that an active principal of the correct type exists;",{"_3475":644,"_30304":486,"_20976":51392,"_5":14428,"_27536":51002,"_2958":51393},[],"that the claim paths and values match the real token exactly;",{"_3475":645,"_30304":486,"_20976":51395,"_5":14428,"_27536":51002,"_2958":51396},[],"that all of the principal's conditions hold;",{"_3475":646,"_30304":486,"_20976":51398,"_5":14428,"_27536":51002,"_2958":51399},[],"that the principal has the expected policy granted;",{"_3475":647,"_30304":486,"_20976":51401,"_5":14428,"_27536":51002,"_2958":51402},[],"that the policy includes the action and the requested resource type or route;",{"_3475":648,"_30304":486,"_20976":51404,"_5":14428,"_27536":51002,"_2958":51405},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3475":649,"_30304":486,"_20976":51407,"_5":14428,"_27536":51002,"_2958":51408},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3475":650,"_30304":486,"_20976":51410,"_5":14428,"_27536":51006,"_2958":51411},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3475":651,"_30304":486,"_20976":51413,"_5":14428,"_27536":51010,"_2958":51414},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3475":652,"_30304":486,"_20976":51416,"_5":14428,"_27536":51014,"_2958":51417},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3475":653,"_30304":486,"_20976":51419,"_5":14428,"_27536":51014,"_2958":51420},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3475":654,"_30304":654,"_5":14780,"_2958":51422,"_30657":51423,"_20976":51424,"_27536":654},"Alerts and subscriptions",[49412,50887,50888],[],{"_3475":655,"_30304":654,"_20976":51426,"_5":14428,"_27536":654,"_2958":51427},[],"Send PKI events to people and external systems.",{"_3475":656,"_30304":654,"_5":30654,"_20976":51429,"_27536":51430,"_2958":51431},[],"/docs/pr-preview/pr-65/platform/administration/alerts#how-it-works","How it works",{"_3475":657,"_30304":654,"_5":30654,"_20976":51433,"_27536":51434,"_2958":51435},[],"/docs/pr-preview/pr-65/platform/administration/alerts#available-channels","Available channels",{"_3475":658,"_30304":654,"_5":30654,"_20976":51437,"_27536":51438,"_2958":51439},[],"/docs/pr-preview/pr-65/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3475":659,"_30304":654,"_5":30654,"_20976":51441,"_27536":51442,"_2958":51443},[],"/docs/pr-preview/pr-65/platform/administration/alerts#choose-the-event","Choose the event",{"_3475":660,"_30304":654,"_5":30654,"_20976":51445,"_27536":51446,"_2958":51447},[],"/docs/pr-preview/pr-65/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3475":661,"_30304":654,"_5":30654,"_20976":51449,"_27536":51450,"_2958":51451},[],"/docs/pr-preview/pr-65/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3475":662,"_30304":654,"_5":30654,"_20976":51453,"_27536":51454,"_2958":51455},[],"/docs/pr-preview/pr-65/platform/administration/alerts#review-and-activate","Review and activate",{"_3475":663,"_30304":654,"_5":30654,"_20976":51457,"_27536":51458,"_2958":51459},[],"/docs/pr-preview/pr-65/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3475":664,"_30304":654,"_5":30654,"_20976":51461,"_27536":51462,"_2958":51463},[],"/docs/pr-preview/pr-65/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3475":665,"_30304":654,"_5":30654,"_20976":51465,"_27536":51466,"_2958":51467},[],"/docs/pr-preview/pr-65/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3475":666,"_30304":654,"_5":30654,"_20976":51469,"_27536":51470,"_2958":51471},[],"/docs/pr-preview/pr-65/platform/administration/alerts#event-families","Event families",{"_3475":667,"_30304":654,"_20976":51473,"_5":14428,"_27536":654,"_2958":51474},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3475":668,"_30304":654,"_20976":51476,"_5":14428,"_27536":51430,"_2958":51477},[],"A service publishes a domain event.",{"_3475":669,"_30304":654,"_20976":51479,"_5":14428,"_27536":51430,"_2958":51480},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3475":670,"_30304":654,"_20976":51482,"_5":14428,"_27536":51430,"_2958":51483},[],"Each subscription's filter decides whether it should be notified.",{"_3475":671,"_30304":654,"_20976":51485,"_5":14428,"_27536":51430,"_2958":51486},[],"Lamassu delivers the event to the configured channel.",{"_3475":672,"_30304":654,"_20976":51488,"_5":14428,"_27536":51430,"_2958":51489},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3475":673,"_30304":654,"_20976":51491,"_5":14428,"_27536":51434,"_2958":51492},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3475":674,"_30304":654,"_20976":51494,"_5":14428,"_27536":51434,"_2958":51495},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3475":675,"_30304":654,"_20976":51497,"_5":14428,"_27536":51434,"_2958":51498},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3475":676,"_30304":654,"_20976":51500,"_5":14428,"_27536":51434,"_2958":51501},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3475":677,"_30304":654,"_20976":51503,"_5":14428,"_27536":51434,"_2958":51504},[],"`apikey_options` requires `header` and `key`.",{"_3475":678,"_30304":654,"_20976":51506,"_5":14428,"_27536":51434,"_2958":51507},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3475":679,"_30304":654,"_20976":51509,"_5":14428,"_27536":51434,"_2958":51510},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3475":680,"_30304":654,"_20976":51512,"_5":14428,"_27536":51434,"_2958":51513},[],"The alerts API reference documents the full `http_client` schema.",{"_3475":681,"_30304":654,"_20976":51515,"_5":14428,"_27536":51442,"_2958":51516},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3475":682,"_30304":654,"_20976":51518,"_5":14428,"_27536":51446,"_2958":51519},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3475":683,"_30304":654,"_20976":51521,"_5":14428,"_27536":51450,"_2958":51522},[],"Add a filter if you don't want to receive every instance of the event.",{"_3475":684,"_30304":654,"_20976":51524,"_5":14428,"_27536":51450,"_2958":51525},[],"**None** notifies all instances of the event.",{"_3475":685,"_30304":654,"_20976":51527,"_5":14428,"_27536":51450,"_2958":51528},[],"**JSON Path** evaluates one or more specific fields.",{"_3475":686,"_30304":654,"_20976":51530,"_5":14428,"_27536":51450,"_2958":51531},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3475":687,"_30304":654,"_20976":51533,"_5":14428,"_27536":51450,"_2958":51534},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3475":688,"_30304":654,"_20976":51536,"_5":14428,"_27536":51450,"_2958":51537},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3475":689,"_30304":654,"_20976":51539,"_5":14428,"_27536":51450,"_2958":51540},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3475":690,"_30304":654,"_20976":51542,"_5":14428,"_27536":51454,"_2958":51543},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3475":691,"_30304":654,"_20976":51545,"_5":14428,"_27536":51458,"_2958":51546},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3475":692,"_30304":654,"_20976":51548,"_5":14428,"_27536":51458,"_2958":51549},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3475":693,"_30304":654,"_20976":51551,"_5":14428,"_27536":51458,"_2958":51552},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3475":694,"_30304":654,"_20976":51554,"_5":14428,"_27536":51458,"_2958":51555},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3475":695,"_30304":654,"_20976":51557,"_5":14428,"_27536":51458,"_2958":51558},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3475":696,"_30304":654,"_20976":51560,"_5":14428,"_27536":51458,"_2958":51561},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3475":697,"_30304":654,"_20976":51563,"_5":14428,"_27536":51458,"_2958":51564},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3475":698,"_30304":654,"_20976":51566,"_5":14428,"_27536":51458,"_2958":51567},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3475":699,"_30304":654,"_20976":51569,"_5":14428,"_27536":51462,"_2958":51570},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3475":700,"_30304":654,"_20976":51572,"_5":14428,"_27536":51462,"_2958":51573},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3475":701,"_30304":654,"_20976":51575,"_5":14428,"_27536":51462,"_2958":51576},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3475":702,"_30304":654,"_20976":51578,"_5":14428,"_27536":51462,"_2958":51579},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3475":703,"_30304":654,"_20976":51581,"_5":14428,"_27536":51462,"_2958":51582},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3475":704,"_30304":654,"_20976":51584,"_5":14428,"_27536":51462,"_2958":51585},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3475":705,"_30304":654,"_20976":51587,"_5":14428,"_27536":51462,"_2958":51588},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3475":706,"_30304":654,"_20976":51590,"_5":14428,"_27536":51462,"_2958":51591},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3475":707,"_30304":654,"_20976":51593,"_5":14428,"_27536":51466,"_2958":51594},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3475":708,"_30304":654,"_20976":51596,"_5":14428,"_27536":51466,"_2958":51597},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3475":709,"_30304":654,"_20976":51599,"_5":14428,"_27536":51470,"_2958":51600},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3475":710,"_30304":654,"_20976":51602,"_5":14428,"_27536":51470,"_2958":51603},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3475":711,"_30304":654,"_20976":51605,"_5":14428,"_27536":51470,"_2958":51606},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3475":712,"_30304":654,"_20976":51608,"_5":14428,"_27536":51470,"_2958":51609},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3475":713,"_30304":654,"_20976":51611,"_5":14428,"_27536":51470,"_2958":51612},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3475":714,"_30304":654,"_20976":51614,"_5":14428,"_27536":51470,"_2958":51615},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3475":715,"_30304":654,"_20976":51617,"_5":14428,"_27536":51470,"_2958":51618},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3475":716,"_30304":654,"_20976":51620,"_5":14428,"_27536":51470,"_2958":51621},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3475":717,"_30304":654,"_20976":51623,"_5":14428,"_27536":51470,"_2958":51624},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3475":718,"_30304":654,"_20976":51626,"_5":14428,"_27536":51470,"_2958":51627},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3475":719,"_30304":719,"_5":14780,"_2958":51629,"_30657":51630,"_20976":51631,"_27536":719},"Audit logs",[49412,50887,50888],[],{"_3475":720,"_30304":719,"_20976":51633,"_5":14428,"_27536":719,"_2958":51634},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3475":721,"_30304":719,"_5":30654,"_20976":51636,"_27536":51637,"_2958":51638},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3475":722,"_30304":719,"_5":30654,"_20976":51640,"_27536":51641,"_2958":51642},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#coverage","Coverage",{"_3475":723,"_30304":719,"_5":30654,"_20976":51644,"_27536":51645,"_2958":51646},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3475":724,"_30304":719,"_5":30654,"_20976":51648,"_27536":51649,"_2958":51650},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3475":725,"_30304":719,"_5":30654,"_20976":51652,"_27536":51653,"_2958":51654},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3475":726,"_30304":719,"_5":30654,"_20976":51656,"_27536":51657,"_2958":51658},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3475":727,"_30304":719,"_5":30654,"_20976":51660,"_27536":51661,"_2958":51662},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3475":728,"_30304":719,"_5":30654,"_20976":51664,"_27536":51665,"_2958":51666},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3475":729,"_30304":719,"_5":30654,"_20976":51668,"_27536":51669,"_2958":51670},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3475":730,"_30304":719,"_5":30654,"_20976":51672,"_27536":51673,"_2958":51674},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3475":731,"_30304":719,"_5":30654,"_20976":51676,"_27536":51677,"_2958":51678},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3475":732,"_30304":719,"_20976":51680,"_5":14428,"_27536":719,"_2958":51681},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3475":733,"_30304":719,"_20976":51683,"_5":14428,"_27536":51637,"_2958":51684},[],"The audit body includes:",{"_3475":734,"_30304":719,"_20976":51686,"_5":14428,"_27536":51637,"_2958":51687},[],"input: data received by the operation;",{"_3475":735,"_30304":719,"_20976":51689,"_5":14428,"_27536":51637,"_2958":51690},[],"has\\_error: whether the service returned an error;",{"_3475":736,"_30304":719,"_20976":51692,"_5":14428,"_27536":51637,"_2958":51693},[],"output: produced result or error message;",{"_3475":737,"_30304":719,"_20976":51695,"_5":14428,"_27536":51637,"_2958":51696},[],"principals: identifiers of the principals that matched the request.",{"_3475":738,"_30304":719,"_20976":51698,"_5":14428,"_27536":51637,"_2958":51699},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3475":739,"_30304":719,"_20976":51701,"_5":14428,"_27536":51637,"_2958":51702},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3475":740,"_30304":719,"_20976":51704,"_5":14428,"_27536":51641,"_2958":51705},[],"The backend applies auditing to mutations of:",{"_3475":741,"_30304":719,"_20976":51707,"_5":14428,"_27536":51641,"_2958":51708},[],"authorities, certificates and issuance profiles;",{"_3475":742,"_30304":719,"_20976":51710,"_5":14428,"_27536":51641,"_2958":51711},[],"keys and KMS engines;",{"_3475":743,"_30304":719,"_20976":51713,"_5":14428,"_27536":51641,"_2958":51714},[],"devices and identities;",{"_3475":744,"_30304":719,"_20976":51716,"_5":14428,"_27536":51641,"_2958":51717},[],"DMSs and enrollment operations;",{"_3475":745,"_30304":719,"_20976":51719,"_5":14428,"_27536":51641,"_2958":51720},[],"validation functions and CRL;",{"_3475":746,"_30304":719,"_20976":51722,"_5":14428,"_27536":51641,"_2958":51723},[],"principals, policies and authorization grants.",{"_3475":747,"_30304":719,"_20976":51725,"_5":14428,"_27536":51641,"_2958":51726},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3475":748,"_30304":719,"_20976":51728,"_5":14428,"_27536":51645,"_2958":51729},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3475":749,"_30304":719,"_20976":51731,"_5":14428,"_27536":51645,"_2958":51732},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3475":750,"_30304":719,"_20976":51734,"_5":14428,"_27536":51645,"_2958":51735},[],"Design the consumer to:",{"_3475":751,"_30304":719,"_20976":51737,"_5":14428,"_27536":51645,"_2958":51738},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3475":752,"_30304":719,"_20976":51740,"_5":14428,"_27536":51645,"_2958":51741},[],"keep the complete CloudEvent unmodified;",{"_3475":753,"_30304":719,"_20976":51743,"_5":14428,"_27536":51645,"_2958":51744},[],"record the ingestion time and detect duplicates by ID;",{"_3475":754,"_30304":719,"_20976":51746,"_5":14428,"_27536":51645,"_2958":51747},[],"encrypt in transit and at rest;",{"_3475":755,"_30304":719,"_20976":51749,"_5":14428,"_27536":51645,"_2958":51750},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3475":756,"_30304":719,"_20976":51752,"_5":14428,"_27536":51645,"_2958":51753},[],"apply an explicit retention and legal hold policy;",{"_3475":757,"_30304":719,"_20976":51755,"_5":14428,"_27536":51645,"_2958":51756},[],"alert if it stops consuming or the pending queue grows.",{"_3475":758,"_30304":719,"_20976":51758,"_5":14428,"_27536":51649,"_2958":51759},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3475":759,"_30304":719,"_20976":51761,"_5":14428,"_27536":51649,"_2958":51762},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3475":760,"_30304":719,"_20976":51764,"_5":14428,"_27536":51657,"_2958":51765},[],"Start from the reported time and normalize every source to UTC.",{"_3475":761,"_30304":719,"_20976":51767,"_5":14428,"_27536":51661,"_2958":51768},[],"Filter by event type, service source and resource identifier.",{"_3475":762,"_30304":719,"_20976":51770,"_5":14428,"_27536":51665,"_2958":51771},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3475":763,"_30304":719,"_20976":51773,"_5":14428,"_27536":51669,"_2958":51774},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3475":764,"_30304":719,"_20976":51776,"_5":14428,"_27536":51673,"_2958":51777},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3475":765,"_30304":719,"_20976":51779,"_5":14428,"_27536":51677,"_2958":51780},[],"Generate a controlled mutation in a test environment and check that:",{"_3475":766,"_30304":719,"_20976":51782,"_5":14428,"_27536":51677,"_2958":51783},[],"a successful audit event appears;",{"_3475":767,"_30304":719,"_20976":51785,"_5":14428,"_27536":51677,"_2958":51786},[],"the principal matches the identity used;",{"_3475":768,"_30304":719,"_20976":51788,"_5":14428,"_27536":51677,"_2958":51789},[],"the consumer persists it exactly once;",{"_3475":769,"_30304":719,"_20976":51791,"_5":14428,"_27536":51677,"_2958":51792},[],"it can be retrieved by resource, actor and period;",{"_3475":770,"_30304":719,"_20976":51794,"_5":14428,"_27536":51677,"_2958":51795},[],"a consumer outage raises an alert.",{"_3475":771,"_30304":719,"_20976":51797,"_5":14428,"_27536":51677,"_2958":51798},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3475":772,"_30304":772,"_5":14780,"_2958":51800,"_30657":51801,"_20976":51802,"_27536":772},"Platform architecture",[49412,50887],[],{"_3475":773,"_30304":772,"_20976":51804,"_5":14428,"_27536":772,"_2958":51805},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3475":774,"_30304":772,"_5":30654,"_20976":51807,"_27536":51808,"_2958":51809},[],"/docs/pr-preview/pr-65/platform/concepts/architecture#control-plane","Control plane",{"_3475":775,"_30304":772,"_5":30654,"_20976":51811,"_27536":51812,"_2958":51813},[],"/docs/pr-preview/pr-65/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3475":776,"_30304":772,"_5":30654,"_20976":51815,"_27536":51816,"_2958":51817},[],"/docs/pr-preview/pr-65/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3475":777,"_30304":772,"_5":30654,"_20976":51819,"_27536":51820,"_2958":51821},[],"/docs/pr-preview/pr-65/platform/concepts/architecture#status-and-validation","Status and validation",{"_3475":778,"_30304":772,"_5":30654,"_20976":51823,"_27536":51824,"_2958":51825},[],"/docs/pr-preview/pr-65/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3475":779,"_30304":772,"_20976":51827,"_5":14428,"_27536":772,"_2958":51828},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3475":780,"_30304":772,"_20976":51830,"_5":14428,"_27536":772,"_2958":51831},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3475":781,"_30304":772,"_20976":51833,"_5":14428,"_27536":51808,"_2958":51834},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3475":782,"_30304":772,"_20976":51836,"_5":14428,"_27536":51812,"_2958":51837},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3475":783,"_30304":772,"_20976":51839,"_5":14428,"_27536":51816,"_2958":51840},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3475":784,"_30304":772,"_20976":51842,"_5":14428,"_27536":51820,"_2958":51843},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3475":785,"_30304":772,"_20976":51845,"_5":14428,"_27536":51824,"_2958":51846},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3475":786,"_30304":786,"_5":14780,"_2958":51848,"_30657":51849,"_20976":51850,"_27536":786},"How Lamassu works",[49412,50887],[],{"_3475":787,"_30304":786,"_20976":51852,"_5":14428,"_27536":786,"_2958":51853},[],"The mental model of trust, keys, certificates and devices.",{"_3475":788,"_30304":786,"_5":30654,"_20976":51855,"_27536":51856,"_2958":51857},[],"/docs/pr-preview/pr-65/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3475":789,"_30304":786,"_5":30654,"_20976":51859,"_27536":51860,"_2958":51861},[],"/docs/pr-preview/pr-65/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3475":790,"_30304":786,"_20976":51863,"_5":14428,"_27536":786,"_2958":51864},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3475":791,"_30304":786,"_20976":51866,"_5":14428,"_27536":51856,"_2958":51867},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3475":792,"_30304":786,"_20976":51869,"_5":14428,"_27536":51856,"_2958":51870},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3475":793,"_30304":786,"_20976":51872,"_5":14428,"_27536":51856,"_2958":51873},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3475":794,"_30304":786,"_20976":51875,"_5":14428,"_27536":51856,"_2958":51876},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3475":795,"_30304":786,"_20976":51878,"_5":14428,"_27536":51856,"_2958":51879},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3475":796,"_30304":786,"_20976":51881,"_5":14428,"_27536":51860,"_2958":51882},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3475":797,"_30304":786,"_20976":51884,"_5":14428,"_27536":51860,"_2958":51885},[],"A DMS relates that CA to an enrollment policy.",{"_3475":798,"_30304":786,"_20976":51887,"_5":14428,"_27536":51860,"_2958":51888},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3475":799,"_30304":786,"_20976":51890,"_5":14428,"_27536":51860,"_2958":51891},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3475":800,"_30304":786,"_20976":51893,"_5":14428,"_27536":51860,"_2958":51894},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3475":801,"_30304":786,"_20976":51896,"_5":14428,"_27536":51860,"_2958":51897},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3475":802,"_30304":786,"_20976":51899,"_5":14428,"_27536":51860,"_2958":51900},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3475":803,"_30304":803,"_5":14780,"_2958":51902,"_30657":51903,"_20976":51905,"_27536":803},"Devices and identities",[49412,50887,51904,51902],"IoT Fleets",[],{"_3475":804,"_30304":803,"_20976":51907,"_5":14428,"_27536":803,"_2958":51908},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3475":805,"_30304":803,"_5":30654,"_20976":51910,"_27536":51911,"_2958":51912},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#device-states","Device states",{"_3475":806,"_30304":803,"_5":30654,"_20976":51914,"_27536":51915,"_2958":51916},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3475":807,"_30304":803,"_5":30654,"_20976":51918,"_27536":51919,"_2958":51920},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3475":808,"_30304":803,"_5":30654,"_20976":51922,"_27536":51923,"_2958":51924},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3475":809,"_30304":803,"_5":30654,"_20976":51926,"_27536":51927,"_2958":51928},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3475":810,"_30304":803,"_5":30654,"_20976":51930,"_27536":51931,"_2958":51932},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3475":811,"_30304":803,"_5":30654,"_20976":51934,"_27536":51935,"_2958":51936},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3475":812,"_30304":803,"_5":30654,"_20976":51938,"_27536":51939,"_2958":51940},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3475":813,"_30304":803,"_5":30654,"_20976":51942,"_27536":51943,"_2958":51944},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3475":814,"_30304":803,"_5":30654,"_20976":51946,"_27536":51947,"_2958":51948},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3475":815,"_30304":803,"_5":30654,"_20976":51950,"_27536":51951,"_2958":51952},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3475":816,"_30304":803,"_20976":51954,"_5":14428,"_27536":803,"_2958":51955},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3475":817,"_30304":803,"_20976":51957,"_5":14428,"_27536":803,"_2958":51958},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3475":818,"_30304":803,"_20976":51960,"_5":14428,"_27536":51911,"_2958":51961},[],"Operational view",{"_3475":819,"_30304":803,"_20976":51963,"_5":14428,"_27536":51911,"_2958":51964},[],"Meaning",{"_3475":820,"_30304":803,"_20976":51966,"_5":14428,"_27536":51911,"_2958":51967},[],"**No Identity**",{"_3475":821,"_30304":803,"_20976":51969,"_5":14428,"_27536":51911,"_2958":51970},[],"A record exists without an associated identity.",{"_3475":822,"_30304":803,"_20976":51972,"_5":14428,"_27536":51911,"_2958":51973},[],"**Active**",{"_3475":823,"_30304":803,"_20976":51975,"_5":14428,"_27536":51911,"_2958":51976},[],"The slot is active; also check certificate dates, status and usages.",{"_3475":824,"_30304":803,"_20976":51978,"_5":14428,"_27536":51911,"_2958":51979},[],"**Renewal Pending**",{"_3475":825,"_30304":803,"_20976":51981,"_5":14428,"_27536":51911,"_2958":51982},[],"The identity is in the operational renewal window.",{"_3475":826,"_30304":803,"_20976":51984,"_5":14428,"_27536":51911,"_2958":51985},[],"**Expiring Soon**",{"_3475":827,"_30304":803,"_20976":51987,"_5":14428,"_27536":51911,"_2958":51988},[],"Expiration is approaching according to configured thresholds.",{"_3475":828,"_30304":803,"_20976":51990,"_5":14428,"_27536":51911,"_2958":51991},[],"**Expired**",{"_3475":829,"_30304":803,"_20976":51993,"_5":14428,"_27536":51911,"_2958":51994},[],"The identity has expired.",{"_3475":830,"_30304":803,"_20976":51996,"_5":14428,"_27536":51911,"_2958":51997},[],"**Revoked**",{"_3475":831,"_30304":803,"_20976":51999,"_5":14428,"_27536":51911,"_2958":52000},[],"The identity is marked revoked.",{"_3475":832,"_30304":803,"_20976":52002,"_5":14428,"_27536":51911,"_2958":52003},[],"**Decommissioned**",{"_3475":833,"_30304":803,"_20976":52005,"_5":14428,"_27536":51911,"_2958":52006},[],"The record is retired and ordinary updates do not restore operation.",{"_3475":834,"_30304":803,"_20976":52008,"_5":14428,"_27536":51911,"_2958":52009},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3475":835,"_30304":803,"_20976":52011,"_5":14428,"_27536":51915,"_2958":52012},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3475":836,"_30304":803,"_20976":52014,"_5":14428,"_27536":51915,"_2958":52015},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3475":837,"_30304":803,"_20976":52017,"_5":14428,"_27536":51915,"_2958":52018},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3475":838,"_30304":803,"_20976":52020,"_5":14428,"_27536":51915,"_2958":52021},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3475":839,"_30304":803,"_20976":52023,"_5":14428,"_27536":51919,"_2958":52024},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3475":840,"_30304":803,"_20976":52026,"_5":14428,"_27536":51923,"_2958":52027},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3475":841,"_30304":803,"_20976":52029,"_5":14428,"_27536":51927,"_2958":52030},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3475":842,"_30304":803,"_20976":52032,"_5":14428,"_27536":51931,"_2958":52033},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3475":843,"_30304":803,"_20976":52035,"_5":14428,"_27536":51935,"_2958":52036},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3475":844,"_30304":803,"_20976":52038,"_5":14428,"_27536":51935,"_2958":52039},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3475":845,"_30304":803,"_20976":52041,"_5":14428,"_27536":51939,"_2958":52042},[],"From **No Identity**, use **Assign Identity**:",{"_3475":846,"_30304":803,"_20976":52044,"_5":14428,"_27536":51939,"_2958":52045},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3475":847,"_30304":803,"_20976":52047,"_5":14428,"_27536":51939,"_2958":52048},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3475":848,"_30304":803,"_20976":52050,"_5":14428,"_27536":51939,"_2958":52051},[],"Confirm and read the serial, active version and history again.",{"_3475":849,"_30304":803,"_20976":52053,"_5":14428,"_27536":51939,"_2958":52054},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3475":850,"_30304":803,"_20976":52056,"_5":14428,"_27536":51939,"_2958":52057},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3475":851,"_30304":803,"_20976":52059,"_5":14428,"_27536":51943,"_2958":52060},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3475":852,"_30304":803,"_20976":52062,"_5":14428,"_27536":51943,"_2958":52063},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3475":853,"_30304":803,"_20976":52065,"_5":14428,"_27536":51947,"_2958":52066},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3475":854,"_30304":803,"_20976":52068,"_5":14428,"_27536":51947,"_2958":52069},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3475":855,"_30304":803,"_20976":52071,"_5":14428,"_27536":51947,"_2958":52072},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3475":856,"_30304":803,"_20976":52074,"_5":14428,"_27536":51947,"_2958":52075},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3475":857,"_30304":803,"_20976":52077,"_5":14428,"_27536":51951,"_2958":52078},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3475":858,"_30304":803,"_20976":52080,"_5":14428,"_27536":51951,"_2958":52081},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3475":859,"_30304":859,"_5":14780,"_2958":52083,"_30657":52084,"_20976":52086,"_27536":859},"Bootstrap identity and authentication",[49412,50887,51904,51902,52085],"Enrollment with PKI",[],{"_3475":860,"_30304":859,"_20976":52088,"_5":14428,"_27536":859,"_2958":52089},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3475":861,"_30304":859,"_5":30654,"_20976":52091,"_27536":52092,"_2958":52093},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3475":862,"_30304":859,"_5":30654,"_20976":52095,"_27536":52096,"_2958":52097},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3475":863,"_30304":859,"_5":30654,"_20976":52099,"_27536":52100,"_2958":52101},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3475":864,"_30304":859,"_5":30654,"_20976":52103,"_27536":52104,"_2958":52105},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3475":865,"_30304":859,"_5":30654,"_20976":52107,"_27536":52108,"_2958":52109},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3475":866,"_30304":859,"_20976":52111,"_5":14428,"_27536":859,"_2958":52112},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3475":867,"_30304":859,"_20976":52114,"_5":14428,"_27536":52092,"_2958":52115},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3475":868,"_30304":859,"_20976":52117,"_5":14428,"_27536":52092,"_2958":52118},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3475":869,"_30304":859,"_20976":52120,"_5":14428,"_27536":52096,"_2958":52121},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3475":870,"_30304":859,"_20976":52123,"_5":14428,"_27536":52096,"_2958":52124},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3475":871,"_30304":859,"_20976":52126,"_5":14428,"_27536":52096,"_2958":52127},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3475":872,"_30304":859,"_20976":52129,"_5":14428,"_27536":52100,"_2958":52130},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3475":873,"_30304":859,"_20976":52132,"_5":14428,"_27536":52100,"_2958":52133},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3475":874,"_30304":859,"_20976":52135,"_5":14428,"_27536":52104,"_2958":52136},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3475":875,"_30304":859,"_20976":52138,"_5":14428,"_27536":52104,"_2958":52139},[],"Example body:",{"_3475":876,"_30304":859,"_20976":52141,"_5":14428,"_27536":52104,"_2958":52142},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3475":877,"_30304":859,"_20976":52144,"_5":14428,"_27536":52104,"_2958":52145},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3475":878,"_30304":859,"_20976":52147,"_5":14428,"_27536":52104,"_2958":52148},[],"Continuation requires a successful HTTP response and JSON:",{"_3475":879,"_30304":859,"_20976":52150,"_5":14428,"_27536":52104,"_2958":52151},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3475":880,"_30304":859,"_20976":52153,"_5":14428,"_27536":52108,"_2958":52154},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3475":881,"_30304":859,"_20976":52156,"_5":14428,"_27536":52108,"_2958":52157},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3475":882,"_30304":882,"_5":14780,"_2958":52159,"_30657":52160,"_20976":52161,"_27536":882},"Configure and operate the DMS",[49412,50887,51904,51902,52085],[],{"_3475":883,"_30304":882,"_20976":52163,"_5":14428,"_27536":882,"_2958":52164},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3475":884,"_30304":882,"_5":30654,"_20976":52166,"_27536":52167,"_2958":49422},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3475":885,"_30304":882,"_5":30654,"_20976":52169,"_27536":52170,"_2958":52171},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3475":886,"_30304":882,"_5":30654,"_20976":52173,"_27536":52174,"_2958":52175},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3475":887,"_30304":882,"_5":30654,"_20976":52177,"_27536":52178,"_2958":52179},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3475":888,"_30304":882,"_5":30654,"_20976":52181,"_27536":52182,"_2958":52183},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3475":889,"_30304":882,"_5":30654,"_20976":52185,"_27536":52186,"_2958":52187},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3475":890,"_30304":882,"_5":30654,"_20976":52189,"_27536":52190,"_2958":52191},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3475":891,"_30304":882,"_5":30654,"_20976":52193,"_27536":52194,"_2958":52195},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3475":892,"_30304":882,"_5":30654,"_20976":52197,"_27536":52198,"_2958":52199},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3475":893,"_30304":882,"_5":30654,"_20976":52201,"_27536":52202,"_2958":52203},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3475":894,"_30304":882,"_5":30654,"_20976":52205,"_27536":52206,"_2958":52207},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3475":895,"_30304":882,"_5":30654,"_20976":52209,"_27536":52210,"_2958":52211},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3475":896,"_30304":882,"_5":30654,"_20976":52213,"_27536":52214,"_2958":52215},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3475":897,"_30304":882,"_5":30654,"_20976":52217,"_27536":52218,"_2958":52219},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3475":898,"_30304":882,"_5":30654,"_20976":52221,"_27536":52222,"_2958":52223},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3475":899,"_30304":882,"_5":30654,"_20976":52225,"_27536":52226,"_2958":52227},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3475":900,"_30304":882,"_5":30654,"_20976":52229,"_27536":52230,"_2958":52231},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3475":901,"_30304":882,"_5":30654,"_20976":52233,"_27536":52234,"_2958":52235},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3475":902,"_30304":882,"_20976":52237,"_5":14428,"_27536":882,"_2958":52238},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3475":903,"_30304":882,"_20976":52240,"_5":14428,"_27536":52167,"_2958":52241},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3475":904,"_30304":882,"_20976":52243,"_5":14428,"_27536":52167,"_2958":52244},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3475":905,"_30304":882,"_20976":52246,"_5":14428,"_27536":52174,"_2958":52247},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3475":906,"_30304":882,"_20976":52249,"_5":14428,"_27536":52178,"_2958":52250},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3475":907,"_30304":882,"_20976":52252,"_5":14428,"_27536":52182,"_2958":52253},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3475":908,"_30304":882,"_20976":52255,"_5":14428,"_27536":52186,"_2958":52256},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3475":909,"_30304":882,"_20976":52258,"_5":14428,"_27536":52190,"_2958":52259},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3475":910,"_30304":882,"_20976":52261,"_5":14428,"_27536":52198,"_2958":52262},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3475":911,"_30304":882,"_20976":52264,"_5":14428,"_27536":52198,"_2958":52265},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3475":912,"_30304":882,"_20976":52267,"_5":14428,"_27536":52202,"_2958":52268},[],"`settings.enrollment_settings` field",{"_3475":913,"_30304":882,"_20976":52270,"_5":14428,"_27536":52202,"_2958":52271},[],"Decision",{"_3475":914,"_30304":882,"_20976":52273,"_5":14428,"_27536":52202,"_2958":52274},[],"`protocol`",{"_3475":915,"_30304":882,"_20976":52276,"_5":14428,"_27536":52202,"_2958":52277},[],"`EST_RFC7030` for these operations.",{"_3475":916,"_30304":882,"_20976":52279,"_5":14428,"_27536":52202,"_2958":52280},[],"`enrollment_ca`",{"_3475":917,"_30304":882,"_20976":52282,"_5":14428,"_27536":52202,"_2958":52283},[],"ID of the signing CA.",{"_3475":918,"_30304":882,"_20976":52285,"_5":14428,"_27536":52202,"_2958":52286},[],"`verify_csr_signature`",{"_3475":919,"_30304":882,"_20976":52288,"_5":14428,"_27536":52202,"_2958":52289},[],"Keep `true` to verify CSR key possession.",{"_3475":920,"_30304":882,"_20976":52291,"_5":14428,"_27536":52202,"_2958":52292},[],"`enable_replaceable_enrollment`",{"_3475":921,"_30304":882,"_20976":52294,"_5":14428,"_27536":52202,"_2958":52295},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3475":922,"_30304":882,"_20976":52297,"_5":14428,"_27536":52202,"_2958":52298},[],"`est_rfc7030_settings.auth_mode`",{"_3475":923,"_30304":882,"_20976":52300,"_5":14428,"_27536":52202,"_2958":52301},[],"One of the four authentication modes.",{"_3475":924,"_30304":882,"_20976":52303,"_5":14428,"_27536":52202,"_2958":52304},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3475":925,"_30304":882,"_20976":52306,"_5":14428,"_27536":52206,"_2958":52307},[],"The blocks are independent:",{"_3475":926,"_30304":882,"_20976":52309,"_5":14428,"_27536":52206,"_2958":52310},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3475":927,"_30304":882,"_20976":52312,"_5":14428,"_27536":52206,"_2958":52313},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3475":928,"_30304":882,"_20976":52315,"_5":14428,"_27536":52206,"_2958":52316},[],"`auth_mode`",{"_3475":929,"_30304":882,"_20976":52318,"_5":14428,"_27536":52206,"_2958":52319},[],"Control applied in the configured operation",{"_3475":930,"_30304":882,"_20976":52321,"_5":14428,"_27536":52206,"_2958":52322},[],"`CLIENT_CERTIFICATE`",{"_3475":931,"_30304":882,"_20976":52324,"_5":14428,"_27536":52206,"_2958":52325},[],"Presented certificate validation.",{"_3475":932,"_30304":882,"_20976":52327,"_5":14428,"_27536":52206,"_2958":52328},[],"`EXTERNAL_WEBHOOK`",{"_3475":933,"_30304":882,"_20976":52330,"_5":14428,"_27536":52206,"_2958":52331},[],"Configured webhook authorization.",{"_3475":934,"_30304":882,"_20976":52333,"_5":14428,"_27536":52206,"_2958":52334},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3475":935,"_30304":882,"_20976":52336,"_5":14428,"_27536":52206,"_2958":52337},[],"Certificate validation followed by webhook approval.",{"_3475":936,"_30304":882,"_20976":52339,"_5":14428,"_27536":52206,"_2958":52340},[],"`NO_AUTH`",{"_3475":937,"_30304":882,"_20976":52342,"_5":14428,"_27536":52206,"_2958":52343},[],"No DMS requester authentication.",{"_3475":938,"_30304":882,"_20976":52345,"_5":14428,"_27536":52206,"_2958":52346},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3475":939,"_30304":882,"_20976":52348,"_5":14428,"_27536":52206,"_2958":52349},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3475":940,"_30304":882,"_20976":52351,"_5":14428,"_27536":52206,"_2958":52352},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3475":941,"_30304":882,"_20976":52354,"_5":14428,"_27536":52206,"_2958":52355},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3475":942,"_30304":882,"_20976":52357,"_5":14428,"_27536":52210,"_2958":52358},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3475":943,"_30304":882,"_20976":52360,"_5":14428,"_27536":52210,"_2958":52361},[],"`external_webhook_settings` field",{"_3475":944,"_30304":882,"_20976":52363,"_5":14428,"_27536":52210,"_2958":52271},[],{"_3475":945,"_30304":882,"_20976":52365,"_5":14428,"_27536":52210,"_2958":52366},[],"`url`",{"_3475":946,"_30304":882,"_20976":52368,"_5":14428,"_27536":52210,"_2958":52369},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3475":947,"_30304":882,"_20976":52371,"_5":14428,"_27536":52210,"_2958":52372},[],"`method`",{"_3475":948,"_30304":882,"_20976":52374,"_5":14428,"_27536":52210,"_2958":52375},[],"`POST` or `PUT`; `POST` by default.",{"_3475":949,"_30304":882,"_20976":52377,"_5":14428,"_27536":52210,"_2958":52378},[],"`name`",{"_3475":950,"_30304":882,"_20976":52380,"_5":14428,"_27536":52210,"_2958":52381},[],"Label used in service logs.",{"_3475":951,"_30304":882,"_20976":52383,"_5":14428,"_27536":52210,"_2958":52384},[],"`config.auth_mode`",{"_3475":952,"_30304":882,"_20976":52386,"_5":14428,"_27536":52210,"_2958":52387},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3475":953,"_30304":882,"_20976":52389,"_5":14428,"_27536":52210,"_2958":52390},[],"`config.log_level`",{"_3475":954,"_30304":882,"_20976":52392,"_5":14428,"_27536":52210,"_2958":52393},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3475":955,"_30304":882,"_20976":52395,"_5":14428,"_27536":52210,"_2958":52396},[],"`config.apikey_options`",{"_3475":956,"_30304":882,"_20976":52398,"_5":14428,"_27536":52210,"_2958":52399},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3475":957,"_30304":882,"_20976":52401,"_5":14428,"_27536":52210,"_2958":52402},[],"`config.jwt_options`",{"_3475":958,"_30304":882,"_20976":52404,"_5":14428,"_27536":52210,"_2958":52405},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3475":959,"_30304":882,"_20976":52407,"_5":14428,"_27536":52210,"_2958":52408},[],"`config.mtls_options`",{"_3475":960,"_30304":882,"_20976":52410,"_5":14428,"_27536":52210,"_2958":52411},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3475":961,"_30304":882,"_20976":52413,"_5":14428,"_27536":52210,"_2958":52414},[],"`config.insecure_skip_verify`",{"_3475":962,"_30304":882,"_20976":52416,"_5":14428,"_27536":52210,"_2958":52417},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3475":963,"_30304":882,"_20976":52419,"_5":14428,"_27536":52210,"_2958":52420},[],"`config.call_timeout`",{"_3475":964,"_30304":882,"_20976":52422,"_5":14428,"_27536":52210,"_2958":52423},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3475":965,"_30304":882,"_20976":52425,"_5":14428,"_27536":52210,"_2958":52426},[],"Rules for that configuration:",{"_3475":966,"_30304":882,"_20976":52428,"_5":14428,"_27536":52210,"_2958":52429},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3475":967,"_30304":882,"_20976":52431,"_5":14428,"_27536":52210,"_2958":52432},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3475":968,"_30304":882,"_20976":52434,"_5":14428,"_27536":52210,"_2958":52435},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3475":969,"_30304":882,"_20976":52437,"_5":14428,"_27536":52210,"_2958":52438},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3475":970,"_30304":882,"_20976":52440,"_5":14428,"_27536":52210,"_2958":52441},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3475":971,"_30304":882,"_20976":52443,"_5":14428,"_27536":52210,"_2958":52444},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3475":972,"_30304":882,"_20976":52446,"_5":14428,"_27536":52210,"_2958":52447},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3475":973,"_30304":882,"_20976":52449,"_5":14428,"_27536":52210,"_2958":52450},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3475":974,"_30304":882,"_20976":52452,"_5":14428,"_27536":52210,"_2958":52453},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3475":975,"_30304":882,"_20976":52455,"_5":14428,"_27536":52214,"_2958":52456},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3475":976,"_30304":882,"_20976":52458,"_5":14428,"_27536":52218,"_2958":52459},[],"`settings.reenrollment_settings` field",{"_3475":977,"_30304":882,"_20976":52461,"_5":14428,"_27536":52218,"_2958":49802},[],{"_3475":978,"_30304":882,"_20976":52463,"_5":14428,"_27536":52218,"_2958":52464},[],"`reenrollment_delta`",{"_3475":979,"_30304":882,"_20976":52466,"_5":14428,"_27536":52218,"_2958":52467},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3475":980,"_30304":882,"_20976":52469,"_5":14428,"_27536":52218,"_2958":52470},[],"`preventive_delta`",{"_3475":981,"_30304":882,"_20976":52472,"_5":14428,"_27536":52218,"_2958":52473},[],"Preventive operational monitoring threshold.",{"_3475":982,"_30304":882,"_20976":52475,"_5":14428,"_27536":52218,"_2958":52476},[],"`critical_delta`",{"_3475":983,"_30304":882,"_20976":52478,"_5":14428,"_27536":52218,"_2958":52479},[],"Critical operational monitoring threshold.",{"_3475":984,"_30304":882,"_20976":52481,"_5":14428,"_27536":52218,"_2958":52482},[],"`enable_expired_renewal`",{"_3475":985,"_30304":882,"_20976":52484,"_5":14428,"_27536":52218,"_2958":52485},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3475":986,"_30304":882,"_20976":52487,"_5":14428,"_27536":52218,"_2958":52488},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3475":987,"_30304":882,"_20976":52490,"_5":14428,"_27536":52218,"_2958":52491},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3475":988,"_30304":882,"_20976":52493,"_5":14428,"_27536":52218,"_2958":52494},[],"`revoke_on_reenrollment`",{"_3475":989,"_30304":882,"_20976":52496,"_5":14428,"_27536":52218,"_2958":52497},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3475":990,"_30304":882,"_20976":52499,"_5":14428,"_27536":52218,"_2958":52500},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3475":991,"_30304":882,"_20976":52502,"_5":14428,"_27536":52222,"_2958":52503},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3475":992,"_30304":882,"_20976":52505,"_5":14428,"_27536":52226,"_2958":49796},[],{"_3475":993,"_30304":882,"_20976":52507,"_5":14428,"_27536":52226,"_2958":52508},[],"Published material",{"_3475":994,"_30304":882,"_20976":52510,"_5":14428,"_27536":52226,"_2958":52511},[],"**Include Lamassu System CA**",{"_3475":995,"_30304":882,"_20976":52513,"_5":14428,"_27536":52226,"_2958":52514},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3475":996,"_30304":882,"_20976":52516,"_5":14428,"_27536":52226,"_2958":52517},[],"**Include Enrollment CA**",{"_3475":997,"_30304":882,"_20976":52519,"_5":14428,"_27536":52226,"_2958":52520},[],"Selected issuing CA certificate.",{"_3475":998,"_30304":882,"_20976":52522,"_5":14428,"_27536":52226,"_2958":52523},[],"**Managed CAs**",{"_3475":999,"_30304":882,"_20976":52525,"_5":14428,"_27536":52226,"_2958":52526},[],"Explicitly selected CA certificates.",{"_3475":1000,"_30304":882,"_20976":52528,"_5":14428,"_27536":52226,"_2958":52529},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3475":1001,"_30304":882,"_20976":52531,"_5":14428,"_27536":52230,"_2958":52532},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3475":1002,"_30304":882,"_20976":52534,"_5":14428,"_27536":52230,"_2958":52535},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3475":1003,"_30304":882,"_20976":52537,"_5":14428,"_27536":52230,"_2958":52538},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3475":1004,"_30304":882,"_20976":52540,"_5":14428,"_27536":52234,"_2958":52541},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3475":1005,"_30304":1005,"_5":14780,"_2958":52543,"_30657":52544,"_20976":52545,"_27536":1005},"Integrate the EST client",[49412,50887,51904,51902,52085],[],{"_3475":1006,"_30304":1005,"_20976":52547,"_5":14428,"_27536":1005,"_2958":52548},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3475":1007,"_30304":1005,"_5":30654,"_20976":52550,"_27536":52551,"_2958":49422},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3475":1008,"_30304":1005,"_5":30654,"_20976":52553,"_27536":52554,"_2958":52555},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3475":1009,"_30304":1005,"_5":30654,"_20976":52557,"_27536":52558,"_2958":52559},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3475":1010,"_30304":1005,"_5":30654,"_20976":52561,"_27536":52562,"_2958":52563},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3475":1011,"_30304":1005,"_5":30654,"_20976":52565,"_27536":52566,"_2958":52567},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3475":1012,"_30304":1005,"_5":30654,"_20976":52569,"_27536":52570,"_2958":52571},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3475":1013,"_30304":1005,"_20976":52573,"_5":14428,"_27536":1005,"_2958":52574},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3475":1014,"_30304":1005,"_20976":52576,"_5":14428,"_27536":52551,"_2958":52577},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3475":1015,"_30304":1005,"_20976":52579,"_5":14428,"_27536":52551,"_2958":52580},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3475":1016,"_30304":1005,"_20976":52582,"_5":14428,"_27536":52551,"_2958":52583},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3475":1017,"_30304":1005,"_20976":52585,"_5":14428,"_27536":52554,"_2958":52586},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3475":1018,"_30304":1005,"_20976":52588,"_5":14428,"_27536":52554,"_2958":52589},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3475":1019,"_30304":1005,"_20976":52591,"_5":14428,"_27536":52558,"_2958":52592},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3475":1020,"_30304":1005,"_20976":52594,"_5":14428,"_27536":52558,"_2958":52595},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3475":1021,"_30304":1005,"_20976":52597,"_5":14428,"_27536":52562,"_2958":52598},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3475":1022,"_30304":1005,"_20976":52600,"_5":14428,"_27536":52562,"_2958":52601},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3475":1023,"_30304":1005,"_20976":52603,"_5":14428,"_27536":52566,"_2958":52604},[],"For a root that issues directly:",{"_3475":1024,"_30304":1005,"_20976":52606,"_5":14428,"_27536":52566,"_2958":52607},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3475":1025,"_30304":1005,"_20976":52609,"_5":14428,"_27536":52566,"_2958":52610},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3475":1026,"_30304":1005,"_20976":52612,"_5":14428,"_27536":52570,"_2958":52613},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3475":1027,"_30304":1027,"_5":14780,"_2958":52615,"_30657":52616,"_20976":52617,"_27536":1027},"EST reference",[49412,50887,51904,51902,52085],[],{"_3475":1028,"_30304":1027,"_20976":52619,"_5":14428,"_27536":1027,"_2958":52620},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3475":1029,"_30304":1027,"_5":30654,"_20976":52622,"_27536":52623,"_2958":52624},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3475":1030,"_30304":1027,"_5":30654,"_20976":52626,"_27536":52627,"_2958":22743},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3475":1031,"_30304":1027,"_5":30654,"_20976":52629,"_27536":52630,"_2958":26134},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3475":1032,"_30304":1027,"_5":30654,"_20976":52632,"_27536":52633,"_2958":26141},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3475":1033,"_30304":1027,"_5":30654,"_20976":52635,"_27536":52636,"_2958":25445},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3475":1034,"_30304":1027,"_5":30654,"_20976":52638,"_27536":52639,"_2958":52640},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3475":1035,"_30304":1027,"_5":30654,"_20976":52642,"_27536":52643,"_2958":52644},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3475":1036,"_30304":1027,"_5":30654,"_20976":52646,"_27536":52647,"_2958":52648},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3475":1037,"_30304":1027,"_20976":52650,"_5":14428,"_27536":1027,"_2958":52651},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3475":1038,"_30304":1027,"_20976":52653,"_5":14428,"_27536":52623,"_2958":52654},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3475":1039,"_30304":1027,"_20976":52656,"_5":14428,"_27536":52623,"_2958":52657},[],"Operation",{"_3475":1040,"_30304":1027,"_20976":52659,"_5":14428,"_27536":52623,"_2958":52660},[],"Method",{"_3475":1041,"_30304":1027,"_20976":52662,"_5":14428,"_27536":52623,"_2958":52663},[],"Authentication and condition",{"_3475":1042,"_30304":1027,"_20976":52665,"_5":14428,"_27536":52623,"_2958":52666},[],"`/cacerts`",{"_3475":1043,"_30304":1027,"_20976":52668,"_5":14428,"_27536":52623,"_2958":52669},[],"GET",{"_3475":1044,"_30304":1027,"_20976":52671,"_5":14428,"_27536":52623,"_2958":52672},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3475":1045,"_30304":1027,"_20976":52674,"_5":14428,"_27536":52623,"_2958":52675},[],"`/simpleenroll`",{"_3475":1046,"_30304":1027,"_20976":52677,"_5":14428,"_27536":52623,"_2958":52678},[],"POST",{"_3475":1047,"_30304":1027,"_20976":52680,"_5":14428,"_27536":52623,"_2958":52681},[],"Initial authentication and DMS registration/replacement policy.",{"_3475":1048,"_30304":1027,"_20976":52683,"_5":14428,"_27536":52623,"_2958":52684},[],"`/simplereenroll`",{"_3475":1049,"_30304":1027,"_20976":52686,"_5":14428,"_27536":52623,"_2958":52678},[],{"_3475":1050,"_30304":1027,"_20976":52688,"_5":14428,"_27536":52623,"_2958":52689},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3475":1051,"_30304":1027,"_20976":52691,"_5":14428,"_27536":52623,"_2958":52692},[],"`/serverkeygen`",{"_3475":1052,"_30304":1027,"_20976":52694,"_5":14428,"_27536":52623,"_2958":52678},[],{"_3475":1053,"_30304":1027,"_20976":52696,"_5":14428,"_27536":52623,"_2958":52697},[],"Initial authentication and admission; server generation enabled.",{"_3475":1054,"_30304":1027,"_20976":52699,"_5":14428,"_27536":52623,"_2958":52700},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3475":1055,"_30304":1027,"_20976":52702,"_5":14428,"_27536":52627,"_2958":52703},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3475":1056,"_30304":1027,"_20976":52705,"_5":14428,"_27536":52627,"_2958":52706},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3475":1057,"_30304":1027,"_20976":52708,"_5":14428,"_27536":52630,"_2958":52709},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3475":1058,"_30304":1027,"_20976":52711,"_5":14428,"_27536":52630,"_2958":52712},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3475":1059,"_30304":1027,"_20976":52714,"_5":14428,"_27536":52633,"_2958":52715},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3475":1060,"_30304":1027,"_20976":52717,"_5":14428,"_27536":52633,"_2958":52718},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3475":1061,"_30304":1027,"_20976":52720,"_5":14428,"_27536":52636,"_2958":52721},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3475":1062,"_30304":1027,"_20976":52723,"_5":14428,"_27536":52636,"_2958":52724},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3475":1063,"_30304":1027,"_20976":52726,"_5":14428,"_27536":52639,"_2958":52727},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3475":1064,"_30304":1027,"_20976":52729,"_5":14428,"_27536":52639,"_2958":52730},[],"Part",{"_3475":1065,"_30304":1027,"_20976":52732,"_5":14428,"_27536":52639,"_2958":52733},[],"Content after decoding its Base64",{"_3475":1066,"_30304":1027,"_20976":52735,"_5":14428,"_27536":52639,"_2958":52736},[],"`application/pkcs8`",{"_3475":1067,"_30304":1027,"_20976":52738,"_5":14428,"_27536":52639,"_2958":52739},[],"Unencrypted DER PKCS#8 private key.",{"_3475":1068,"_30304":1027,"_20976":52741,"_5":14428,"_27536":52639,"_2958":52742},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3475":1069,"_30304":1027,"_20976":52744,"_5":14428,"_27536":52639,"_2958":52745},[],"DER PKCS#7 containing the issued certificate.",{"_3475":1070,"_30304":1027,"_20976":52747,"_5":14428,"_27536":52639,"_2958":52748},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3475":1071,"_30304":1027,"_20976":52750,"_5":14428,"_27536":52643,"_2958":52751},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3475":1072,"_30304":1027,"_20976":52753,"_5":14428,"_27536":52643,"_2958":52754},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3475":1073,"_30304":1027,"_20976":52756,"_5":14428,"_27536":52643,"_2958":52757},[],"Convert and check the result:",{"_3475":1074,"_30304":1027,"_20976":52759,"_5":14428,"_27536":52643,"_2958":52760},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3475":1075,"_30304":1027,"_20976":52762,"_5":14428,"_27536":52647,"_2958":52763},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3475":1076,"_30304":1027,"_20976":52765,"_5":14428,"_27536":52647,"_2958":52766},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3475":1077,"_30304":1077,"_5":14780,"_2958":52085,"_30657":52768,"_20976":52769,"_27536":1077},[49412,50887,51904,51902,52085],[],{"_3475":1078,"_30304":1077,"_20976":52771,"_5":14428,"_27536":1077,"_2958":52772},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3475":1079,"_30304":1077,"_5":30654,"_20976":52774,"_27536":52775,"_2958":52776},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3475":1080,"_30304":1077,"_5":30654,"_20976":52778,"_27536":52779,"_2958":52780},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3475":1081,"_30304":1077,"_5":30654,"_20976":52782,"_27536":52783,"_2958":52784},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3475":1082,"_30304":1077,"_5":30654,"_20976":52786,"_27536":52787,"_2958":52788},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3475":1083,"_30304":1077,"_20976":52790,"_5":14428,"_27536":1077,"_2958":52791},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3475":1084,"_30304":1077,"_20976":52793,"_5":14428,"_27536":52775,"_2958":52794},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3475":1085,"_30304":1077,"_20976":52796,"_5":14428,"_27536":52775,"_2958":52797},[],"The integrator installs initial EST server trust and an admission credential.",{"_3475":1086,"_30304":1077,"_20976":52799,"_5":14428,"_27536":52775,"_2958":52800},[],"The client requests an identity for its `Device ID` through EST.",{"_3475":1087,"_30304":1077,"_20976":52802,"_5":14428,"_27536":52775,"_2958":52803},[],"Certificate, device binding and key/certificate installation are checked.",{"_3475":1088,"_30304":1077,"_20976":52805,"_5":14428,"_27536":52775,"_2958":52806},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3475":1089,"_30304":1077,"_20976":52808,"_5":14428,"_27536":52775,"_2958":52809},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3475":1090,"_30304":1077,"_20976":52811,"_5":14428,"_27536":52779,"_2958":52812},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3475":1091,"_30304":1077,"_20976":52814,"_5":14428,"_27536":52779,"_2958":52815},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":1092,"_30304":1077,"_20976":52817,"_5":14428,"_27536":52779,"_2958":52818},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3475":1093,"_30304":1077,"_20976":52820,"_5":14428,"_27536":52779,"_2958":52821},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3475":1094,"_30304":1077,"_20976":52823,"_5":14428,"_27536":52783,"_2958":52824},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3475":1095,"_30304":1077,"_20976":52826,"_5":14428,"_27536":52783,"_2958":52827},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3475":1096,"_30304":1077,"_20976":52829,"_5":14428,"_27536":52783,"_2958":52830},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3475":1097,"_30304":1077,"_20976":52832,"_5":14428,"_27536":52783,"_2958":52833},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3475":1098,"_30304":1077,"_20976":52835,"_5":14428,"_27536":52787,"_2958":52836},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3475":1099,"_30304":1077,"_20976":52838,"_5":14428,"_27536":52787,"_2958":52839},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3475":1100,"_30304":1100,"_5":14780,"_2958":52841,"_30657":52842,"_20976":52843,"_27536":1100},"Provisioning strategies",[49412,50887,51904,51902,52085],[],{"_3475":1101,"_30304":1100,"_20976":52845,"_5":14428,"_27536":1100,"_2958":52846},[],"Choose device registration, identity authorization and key generation.",{"_3475":1102,"_30304":1100,"_5":30654,"_20976":52848,"_27536":52849,"_2958":52850},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3475":1103,"_30304":1100,"_5":30654,"_20976":52852,"_27536":52853,"_2958":52854},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3475":1104,"_30304":1100,"_5":30654,"_20976":52856,"_27536":52857,"_2958":52858},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3475":1105,"_30304":1100,"_5":30654,"_20976":52860,"_27536":52861,"_2958":52862},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3475":1106,"_30304":1100,"_5":30654,"_20976":52864,"_27536":52865,"_2958":52866},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3475":1107,"_30304":1100,"_20976":52868,"_5":14428,"_27536":1100,"_2958":52869},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3475":1108,"_30304":1100,"_20976":52871,"_5":14428,"_27536":52849,"_2958":52872},[],"Path",{"_3475":1109,"_30304":1100,"_20976":52874,"_5":14428,"_27536":52849,"_2958":52875},[],"When the device exists",{"_3475":1110,"_30304":1100,"_20976":52877,"_5":14428,"_27536":52849,"_2958":52878},[],"What to check",{"_3475":1111,"_30304":1100,"_20976":52880,"_5":14428,"_27536":52849,"_2958":52881},[],"Manual assignment",{"_3475":1112,"_30304":1100,"_20976":52883,"_5":14428,"_27536":52849,"_2958":52884},[],"An operator creates it before associating a certificate.",{"_3475":1113,"_30304":1100,"_20976":52886,"_5":14428,"_27536":52849,"_2958":52887},[],"ID, owning DMS, certificate CN and bound serial.",{"_3475":1114,"_30304":1100,"_20976":52889,"_5":14428,"_27536":52849,"_2958":52890},[],"EST with `JITP`",{"_3475":1115,"_30304":1100,"_20976":52892,"_5":14428,"_27536":52849,"_2958":52893},[],"Created for an unknown CN during `/simpleenroll`.",{"_3475":1116,"_30304":1100,"_20976":52895,"_5":14428,"_27536":52849,"_2958":52896},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3475":1117,"_30304":1100,"_20976":52898,"_5":14428,"_27536":52849,"_2958":52899},[],"EST with `PRE_REGISTRATION`",{"_3475":1118,"_30304":1100,"_20976":52901,"_5":14428,"_27536":52849,"_2958":52902},[],"Must exist before `/simpleenroll`.",{"_3475":1119,"_30304":1100,"_20976":52904,"_5":14428,"_27536":52849,"_2958":52905},[],"Approved record, same DMS and replacement conditions for your version.",{"_3475":1120,"_30304":1100,"_20976":52907,"_5":14428,"_27536":52849,"_2958":52908},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3475":1121,"_30304":1100,"_20976":52910,"_5":14428,"_27536":52849,"_2958":52911},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3475":1122,"_30304":1100,"_20976":52913,"_5":14428,"_27536":52853,"_2958":52914},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3475":1123,"_30304":1100,"_20976":52916,"_5":14428,"_27536":52853,"_2958":52917},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3475":1124,"_30304":1100,"_20976":52919,"_5":14428,"_27536":52853,"_2958":52920},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3475":1125,"_30304":1100,"_20976":52922,"_5":14428,"_27536":52857,"_2958":52923},[],"Decide initial enrollment and re-enrollment separately:",{"_3475":1126,"_30304":1100,"_20976":52925,"_5":14428,"_27536":52857,"_2958":52926},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3475":1127,"_30304":1100,"_20976":52928,"_5":14428,"_27536":52857,"_2958":52929},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3475":1128,"_30304":1100,"_20976":52931,"_5":14428,"_27536":52857,"_2958":52932},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3475":1129,"_30304":1100,"_20976":52934,"_5":14428,"_27536":52857,"_2958":52935},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3475":1130,"_30304":1100,"_20976":52937,"_5":14428,"_27536":52857,"_2958":52938},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3475":1131,"_30304":1100,"_20976":52940,"_5":14428,"_27536":52861,"_2958":49796},[],{"_3475":1132,"_30304":1100,"_20976":52942,"_5":14428,"_27536":52861,"_2958":52943},[],"Material crossing EST",{"_3475":1133,"_30304":1100,"_20976":52945,"_5":14428,"_27536":52861,"_2958":52946},[],"Device-generated key",{"_3475":1134,"_30304":1100,"_20976":52948,"_5":14428,"_27536":52861,"_2958":52949},[],"Public CSR and certificate; the key stays on the client.",{"_3475":1135,"_30304":1100,"_20976":52951,"_5":14428,"_27536":52861,"_2958":52952},[],"Existing device key",{"_3475":1136,"_30304":1100,"_20976":52954,"_5":14428,"_27536":52861,"_2958":52955},[],"CSR signed with that key and a new certificate.",{"_3475":1137,"_30304":1100,"_20976":52957,"_5":14428,"_27536":52861,"_2958":52223},[],{"_3475":1138,"_30304":1100,"_20976":52959,"_5":14428,"_27536":52861,"_2958":52960},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3475":1139,"_30304":1100,"_20976":52962,"_5":14428,"_27536":52861,"_2958":52963},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3475":1140,"_30304":1100,"_20976":52965,"_5":14428,"_27536":52865,"_2958":52966},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3475":1141,"_30304":1141,"_5":14780,"_2958":52968,"_30657":52969,"_20976":52970,"_27536":1141},"Renewal and recovery",[49412,50887,51904,51902,52085],[],{"_3475":1142,"_30304":1141,"_20976":52972,"_5":14428,"_27536":1141,"_2958":52973},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3475":1143,"_30304":1141,"_5":30654,"_20976":52975,"_27536":52976,"_2958":52977},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3475":1144,"_30304":1141,"_5":30654,"_20976":52979,"_27536":52980,"_2958":52981},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3475":1145,"_30304":1141,"_5":30654,"_20976":52983,"_27536":52984,"_2958":52985},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3475":1146,"_30304":1141,"_5":30654,"_20976":52987,"_27536":52988,"_2958":52989},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3475":1147,"_30304":1141,"_5":30654,"_20976":52991,"_27536":52992,"_2958":52993},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3475":1148,"_30304":1141,"_20976":52995,"_5":14428,"_27536":1141,"_2958":52996},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3475":1149,"_30304":1141,"_20976":52998,"_5":14428,"_27536":52976,"_2958":52999},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3475":1150,"_30304":1141,"_20976":53001,"_5":14428,"_27536":52976,"_2958":53002},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3475":1151,"_30304":1141,"_20976":53004,"_5":14428,"_27536":52976,"_2958":53005},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3475":1152,"_30304":1141,"_20976":53007,"_5":14428,"_27536":52976,"_2958":53008},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3475":1153,"_30304":1141,"_20976":53010,"_5":14428,"_27536":52980,"_2958":53011},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3475":1154,"_30304":1141,"_20976":53013,"_5":14428,"_27536":52980,"_2958":53014},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3475":1155,"_30304":1141,"_20976":53016,"_5":14428,"_27536":52984,"_2958":53017},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3475":1156,"_30304":1141,"_20976":53019,"_5":14428,"_27536":52984,"_2958":53020},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3475":1157,"_30304":1141,"_20976":53022,"_5":14428,"_27536":52984,"_2958":53023},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3475":1158,"_30304":1141,"_20976":53025,"_5":14428,"_27536":52988,"_2958":53026},[],"Situation",{"_3475":1159,"_30304":1141,"_20976":53028,"_5":14428,"_27536":52988,"_2958":53029},[],"Procedure",{"_3475":1160,"_30304":1141,"_20976":53031,"_5":14428,"_27536":52988,"_2958":53032},[],"Valid certificate, outside the window",{"_3475":1161,"_30304":1141,"_20976":53034,"_5":14428,"_27536":52988,"_2958":53035},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3475":1162,"_30304":1141,"_20976":53037,"_5":14428,"_27536":52988,"_2958":53038},[],"Expired certificate, key available",{"_3475":1163,"_30304":1141,"_20976":53040,"_5":14428,"_27536":52988,"_2958":53041},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3475":1164,"_30304":1141,"_20976":53043,"_5":14428,"_27536":52988,"_2958":53044},[],"Renewal through webhook or `NO_AUTH`",{"_3475":1165,"_30304":1141,"_20976":53046,"_5":14428,"_27536":52988,"_2958":53047},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3475":1166,"_30304":1141,"_20976":53049,"_5":14428,"_27536":52988,"_2958":53050},[],"Lost or inaccessible key",{"_3475":1167,"_30304":1141,"_20976":53052,"_5":14428,"_27536":52988,"_2958":53053},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3475":1168,"_30304":1141,"_20976":53055,"_5":14428,"_27536":52988,"_2958":53056},[],"Current identity revoked",{"_3475":1169,"_30304":1141,"_20976":53058,"_5":14428,"_27536":52988,"_2958":53059},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3475":1170,"_30304":1141,"_20976":53061,"_5":14428,"_27536":52988,"_2958":53062},[],"Device without an identity",{"_3475":1171,"_30304":1141,"_20976":53064,"_5":14428,"_27536":52988,"_2958":53065},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3475":1172,"_30304":1141,"_20976":53067,"_5":14428,"_27536":52988,"_2958":53068},[],"Retired device",{"_3475":1173,"_30304":1141,"_20976":53070,"_5":14428,"_27536":52988,"_2958":53071},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3475":1174,"_30304":1141,"_20976":53073,"_5":14428,"_27536":52988,"_2958":53074},[],"Timeout, HTTP 500 or installation failure",{"_3475":1175,"_30304":1141,"_20976":53076,"_5":14428,"_27536":52988,"_2958":53077},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3475":1176,"_30304":1141,"_20976":53079,"_5":14428,"_27536":52992,"_2958":53080},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3475":1177,"_30304":1141,"_20976":53082,"_5":14428,"_27536":52992,"_2958":53083},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3475":1178,"_30304":1178,"_5":14780,"_2958":53085,"_30657":53086,"_20976":53087,"_27536":1178},"Enrollment troubleshooting",[49412,50887,51904,51902,52085],[],{"_3475":1179,"_30304":1178,"_20976":53089,"_5":14428,"_27536":1178,"_2958":53090},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3475":1180,"_30304":1178,"_5":30654,"_20976":53092,"_27536":53093,"_2958":53094},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3475":1181,"_30304":1178,"_5":30654,"_20976":53096,"_27536":53097,"_2958":53098},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3475":1182,"_30304":1178,"_5":30654,"_20976":53100,"_27536":53101,"_2958":52648},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3475":1183,"_30304":1178,"_5":30654,"_20976":53103,"_27536":53104,"_2958":53105},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3475":1184,"_30304":1178,"_20976":53107,"_5":14428,"_27536":1178,"_2958":53108},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3475":1185,"_30304":1178,"_20976":53110,"_5":14428,"_27536":53097,"_2958":53111},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3475":1186,"_30304":1178,"_20976":53113,"_5":14428,"_27536":53097,"_2958":53114},[],"Symptom or message",{"_3475":1187,"_30304":1178,"_20976":53116,"_5":14428,"_27536":53097,"_2958":52878},[],{"_3475":1188,"_30304":1178,"_20976":53118,"_5":14428,"_27536":53097,"_2958":53119},[],"curl rejects TLS, name or issuer",{"_3475":1189,"_30304":1178,"_20976":53121,"_5":14428,"_27536":53097,"_2958":53122},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3475":1190,"_30304":1178,"_20976":53124,"_5":14428,"_27536":53097,"_2958":53125},[],"404 or missing APS",{"_3475":1191,"_30304":1178,"_20976":53127,"_5":14428,"_27536":53097,"_2958":53128},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3475":1192,"_30304":1178,"_20976":53130,"_5":14428,"_27536":53097,"_2958":53131},[],"400, CSR or format error",{"_3475":1193,"_30304":1178,"_20976":53133,"_5":14428,"_27536":53097,"_2958":53134},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3475":1194,"_30304":1178,"_20976":53136,"_5":14428,"_27536":53097,"_2958":53137},[],"Missing credential or invalid certificate",{"_3475":1195,"_30304":1178,"_20976":53139,"_5":14428,"_27536":53097,"_2958":53140},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3475":1196,"_30304":1178,"_20976":53142,"_5":14428,"_27536":53097,"_2958":53143},[],"Webhook denies, times out or responds without authorization",{"_3475":1197,"_30304":1178,"_20976":53145,"_5":14428,"_27536":53097,"_2958":53146},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3475":1198,"_30304":1178,"_20976":53148,"_5":14428,"_27536":53097,"_2958":53149},[],"`unexpected status code: <n>: redirects are not followed`",{"_3475":1199,"_30304":1178,"_20976":53151,"_5":14428,"_27536":53097,"_2958":53152},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3475":1200,"_30304":1178,"_20976":53154,"_5":14428,"_27536":53097,"_2958":53155},[],"`webhook response exceeds 1048576 bytes`",{"_3475":1201,"_30304":1178,"_20976":53157,"_5":14428,"_27536":53097,"_2958":53158},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3475":1202,"_30304":1178,"_20976":53160,"_5":14428,"_27536":53097,"_2958":53161},[],"`webhook config must not reference files`",{"_3475":1203,"_30304":1178,"_20976":53163,"_5":14428,"_27536":53097,"_2958":53164},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3475":1204,"_30304":1178,"_20976":53166,"_5":14428,"_27536":53097,"_2958":53167},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3475":1205,"_30304":1178,"_20976":53169,"_5":14428,"_27536":53097,"_2958":53170},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3475":1206,"_30304":1178,"_20976":53172,"_5":14428,"_27536":53097,"_2958":53173},[],"`webhook mTLS certificate and key are invalid: …`",{"_3475":1207,"_30304":1178,"_20976":53175,"_5":14428,"_27536":53097,"_2958":53176},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3475":1208,"_30304":1178,"_20976":53178,"_5":14428,"_27536":53097,"_2958":53179},[],"400 `struct validation error` creating or updating a DMS",{"_3475":1209,"_30304":1178,"_20976":53181,"_5":14428,"_27536":53097,"_2958":53182},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3475":1210,"_30304":1178,"_20976":53184,"_5":14428,"_27536":53097,"_2958":53185},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3475":1211,"_30304":1178,"_20976":53187,"_5":14428,"_27536":53097,"_2958":53188},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3475":1212,"_30304":1178,"_20976":53190,"_5":14428,"_27536":53097,"_2958":53191},[],"`device not preregistered`",{"_3475":1213,"_30304":1178,"_20976":53193,"_5":14428,"_27536":53097,"_2958":53194},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3475":1214,"_30304":1178,"_20976":53196,"_5":14428,"_27536":53097,"_2958":53197},[],"`forbiddenNewEnrollment`",{"_3475":1215,"_30304":1178,"_20976":53199,"_5":14428,"_27536":53097,"_2958":53200},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3475":1216,"_30304":1178,"_20976":53202,"_5":14428,"_27536":53097,"_2958":53203},[],"Different owning DMS",{"_3475":1217,"_30304":1178,"_20976":53205,"_5":14428,"_27536":53097,"_2958":53206},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3475":1218,"_30304":1178,"_20976":53208,"_5":14428,"_27536":53097,"_2958":53209},[],"`invalid RawSubject bytes`",{"_3475":1219,"_30304":1178,"_20976":53211,"_5":14428,"_27536":53097,"_2958":53212},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3475":1220,"_30304":1178,"_20976":53214,"_5":14428,"_27536":53097,"_2958":53215},[],"`invalid reenroll window`",{"_3475":1221,"_30304":1178,"_20976":53217,"_5":14428,"_27536":53097,"_2958":53218},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3475":1222,"_30304":1178,"_20976":53220,"_5":14428,"_27536":53097,"_2958":53221},[],"Current certificate revoked",{"_3475":1223,"_30304":1178,"_20976":53223,"_5":14428,"_27536":53097,"_2958":53224},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3475":1224,"_30304":1178,"_20976":53226,"_5":14428,"_27536":53097,"_2958":53227},[],"CA, profile or signing error",{"_3475":1225,"_30304":1178,"_20976":53229,"_5":14428,"_27536":53097,"_2958":53230},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3475":1226,"_30304":1178,"_20976":53232,"_5":14428,"_27536":53097,"_2958":53233},[],"HTTP 200 without a device connection",{"_3475":1227,"_30304":1178,"_20976":53235,"_5":14428,"_27536":53097,"_2958":53236},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3475":1228,"_30304":1178,"_20976":53238,"_5":14428,"_27536":53097,"_2958":53239},[],"Timeout or error after issuance",{"_3475":1229,"_30304":1178,"_20976":53241,"_5":14428,"_27536":53097,"_2958":53242},[],"New certificates, current slot and previous identity's state before retrying.",{"_3475":1230,"_30304":1178,"_20976":53244,"_5":14428,"_27536":53101,"_2958":53245},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3475":1231,"_30304":1178,"_20976":53247,"_5":14428,"_27536":53101,"_2958":53248},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3475":1232,"_30304":1178,"_20976":53250,"_5":14428,"_27536":53104,"_2958":53251},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3475":1233,"_30304":1178,"_20976":53253,"_5":14428,"_27536":53104,"_2958":53254},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3475":1234,"_30304":1178,"_20976":53256,"_5":14428,"_27536":53104,"_2958":53257},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3475":1235,"_30304":1178,"_20976":53259,"_5":14428,"_27536":53104,"_2958":53260},[],"Make one request, save headers/body and query the device and certificates.",{"_3475":1236,"_30304":1178,"_20976":53262,"_5":14428,"_27536":53104,"_2958":53263},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3475":1237,"_30304":1178,"_20976":53265,"_5":14428,"_27536":53104,"_2958":53266},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3475":1238,"_30304":1178,"_20976":53268,"_5":14428,"_27536":53104,"_2958":53269},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3475":1239,"_30304":1239,"_5":14780,"_2958":53271,"_30657":53272,"_20976":53273,"_27536":1239},"Trust distribution and updates",[49412,50887,51904,51902,52085],[],{"_3475":1240,"_30304":1239,"_20976":53275,"_5":14428,"_27536":1239,"_2958":53276},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3475":1241,"_30304":1239,"_5":30654,"_20976":53278,"_27536":53279,"_2958":53280},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3475":1242,"_30304":1239,"_5":30654,"_20976":53282,"_27536":53283,"_2958":53284},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3475":1243,"_30304":1239,"_5":30654,"_20976":53286,"_27536":53287,"_2958":53288},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3475":1244,"_30304":1239,"_5":30654,"_20976":53290,"_27536":53291,"_2958":53292},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3475":1245,"_30304":1239,"_5":30654,"_20976":53294,"_27536":53295,"_2958":53296},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3475":1246,"_30304":1239,"_20976":53298,"_5":14428,"_27536":1239,"_2958":53299},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3475":1247,"_30304":1239,"_20976":53301,"_5":14428,"_27536":53279,"_2958":53302},[],"Relationship",{"_3475":1248,"_30304":1239,"_20976":53304,"_5":14428,"_27536":53279,"_2958":53305},[],"Material prepared by its owner",{"_3475":1249,"_30304":1239,"_20976":53307,"_5":14428,"_27536":53279,"_2958":53308},[],"Device → EST server",{"_3475":1250,"_30304":1239,"_20976":53310,"_5":14428,"_27536":53279,"_2958":53311},[],"Previously verified server root, chain or pin and TLS name.",{"_3475":1251,"_30304":1239,"_20976":53313,"_5":14428,"_27536":53279,"_2958":53314},[],"DMS → requester",{"_3475":1252,"_30304":1239,"_20976":53316,"_5":14428,"_27536":53279,"_2958":53317},[],"CAs and rules authorizing initial or renewal credentials.",{"_3475":1253,"_30304":1239,"_20976":53319,"_5":14428,"_27536":53279,"_2958":53320},[],"Consumer → device",{"_3475":1254,"_30304":1239,"_20976":53322,"_5":14428,"_27536":53279,"_2958":53323},[],"Operational identity roots, intermediates, validation and permissions.",{"_3475":1255,"_30304":1239,"_20976":53325,"_5":14428,"_27536":53279,"_2958":53326},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3475":1256,"_30304":1239,"_20976":53328,"_5":14428,"_27536":53283,"_2958":53329},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3475":1257,"_30304":1239,"_20976":53331,"_5":14428,"_27536":53283,"_2958":53332},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3475":1258,"_30304":1239,"_20976":53334,"_5":14428,"_27536":53287,"_2958":53335},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3475":1259,"_30304":1239,"_20976":53337,"_5":14428,"_27536":53287,"_2958":53338},[],"Select policy-approved roots as anchors.",{"_3475":1260,"_30304":1239,"_20976":53340,"_5":14428,"_27536":53287,"_2958":53341},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3475":1261,"_30304":1239,"_20976":53343,"_5":14428,"_27536":53287,"_2958":53344},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3475":1262,"_30304":1239,"_20976":53346,"_5":14428,"_27536":53287,"_2958":53347},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3475":1263,"_30304":1239,"_20976":53349,"_5":14428,"_27536":53287,"_2958":53350},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3475":1264,"_30304":1239,"_20976":53352,"_5":14428,"_27536":53291,"_2958":53353},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3475":1265,"_30304":1239,"_20976":53355,"_5":14428,"_27536":53291,"_2958":53356},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3475":1266,"_30304":1239,"_20976":53358,"_5":14428,"_27536":53291,"_2958":53359},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3475":1267,"_30304":1239,"_20976":53361,"_5":14428,"_27536":53295,"_2958":53362},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3475":1268,"_30304":1268,"_5":14780,"_2958":53364,"_30657":53365,"_20976":53367,"_27536":1268},"AWS IoT Core",[49412,50887,51904,51902,53366],"Integrations",[],{"_3475":1269,"_30304":1268,"_20976":53369,"_5":14428,"_27536":1268,"_2958":53370},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3475":1270,"_30304":1268,"_5":30654,"_20976":53372,"_27536":53373,"_2958":53374},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3475":1271,"_30304":1268,"_5":30654,"_20976":53376,"_27536":53377,"_2958":53378},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3475":1272,"_30304":1268,"_5":30654,"_20976":53380,"_27536":53381,"_2958":53382},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3475":1273,"_30304":1268,"_5":30654,"_20976":53384,"_27536":53385,"_2958":53386},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3475":1274,"_30304":1268,"_5":30654,"_20976":53388,"_27536":53389,"_2958":53390},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3475":1275,"_30304":1268,"_5":30654,"_20976":53392,"_27536":53393,"_2958":53394},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3475":1276,"_30304":1268,"_5":30654,"_20976":53396,"_27536":53397,"_2958":53398},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3475":1277,"_30304":1268,"_5":30654,"_20976":53400,"_27536":53401,"_2958":53402},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3475":1278,"_30304":1268,"_5":30654,"_20976":53404,"_27536":53405,"_2958":53406},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3475":1279,"_30304":1268,"_5":30654,"_20976":53408,"_27536":53409,"_2958":53410},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3475":1280,"_30304":1268,"_5":30654,"_20976":53412,"_27536":53413,"_2958":53414},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3475":1281,"_30304":1268,"_5":30654,"_20976":53416,"_27536":53417,"_2958":53418},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3475":1282,"_30304":1268,"_5":30654,"_20976":53420,"_27536":53421,"_2958":53422},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3475":1283,"_30304":1268,"_5":30654,"_20976":53424,"_27536":53425,"_2958":53426},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3475":1284,"_30304":1268,"_5":30654,"_20976":53428,"_27536":53429,"_2958":53430},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3475":1285,"_30304":1268,"_5":30654,"_20976":53432,"_27536":53433,"_2958":53434},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3475":1286,"_30304":1268,"_5":30654,"_20976":53436,"_27536":53437,"_2958":53438},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3475":1287,"_30304":1268,"_5":30654,"_20976":53440,"_27536":53441,"_2958":53442},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3475":1288,"_30304":1268,"_5":30654,"_20976":53444,"_27536":53445,"_2958":53446},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3475":1289,"_30304":1268,"_5":30654,"_20976":53448,"_27536":53449,"_2958":53450},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3475":1290,"_30304":1268,"_5":30654,"_20976":53452,"_27536":53453,"_2958":53454},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3475":1291,"_30304":1268,"_5":30654,"_20976":53456,"_27536":53457,"_2958":53458},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3475":1292,"_30304":1268,"_5":30654,"_20976":53460,"_27536":53461,"_2958":53462},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3475":1293,"_30304":1268,"_5":30654,"_20976":53464,"_27536":53465,"_2958":53466},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3475":1294,"_30304":1268,"_5":30654,"_20976":53468,"_27536":53469,"_2958":53470},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3475":1295,"_30304":1268,"_20976":53472,"_5":14428,"_27536":1268,"_2958":53473},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3475":1296,"_30304":1268,"_20976":53475,"_5":14428,"_27536":1268,"_2958":53476},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3475":1297,"_30304":1268,"_20976":53478,"_5":14428,"_27536":1268,"_2958":53479},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3475":1298,"_30304":1268,"_20976":53481,"_5":14428,"_27536":53373,"_2958":53482},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3475":1299,"_30304":1268,"_20976":53484,"_5":14428,"_27536":53373,"_2958":53485},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3475":1300,"_30304":1268,"_20976":53487,"_5":14428,"_27536":53373,"_2958":53488},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3475":1301,"_30304":1268,"_20976":53490,"_5":14428,"_27536":53373,"_2958":53491},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3475":1302,"_30304":1268,"_20976":53493,"_5":14428,"_27536":53377,"_2958":53494},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3475":1303,"_30304":1268,"_20976":53496,"_5":14428,"_27536":53381,"_2958":53497},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3475":1304,"_30304":1268,"_20976":53499,"_5":14428,"_27536":53381,"_2958":53500},[],"IAM action",{"_3475":1305,"_30304":1268,"_20976":53502,"_5":14428,"_27536":53381,"_2958":49802},[],{"_3475":1306,"_30304":1268,"_20976":53504,"_5":14428,"_27536":53381,"_2958":53505},[],"`iot:GetRegistrationCode`",{"_3475":1307,"_30304":1268,"_20976":53507,"_5":14428,"_27536":53381,"_2958":53508},[],"Obtain the verification code for CA registration in the Primary Account",{"_3475":1308,"_30304":1268,"_20976":53510,"_5":14428,"_27536":53381,"_2958":53511},[],"`iot:RegisterCACertificate`",{"_3475":1309,"_30304":1268,"_20976":53513,"_5":14428,"_27536":53381,"_2958":53514},[],"Register the CA in AWS IoT",{"_3475":1310,"_30304":1268,"_20976":53516,"_5":14428,"_27536":53381,"_2958":53517},[],"`iot:DescribeCACertificate`",{"_3475":1311,"_30304":1268,"_20976":53519,"_5":14428,"_27536":53381,"_2958":53520},[],"Check the CA registration status",{"_3475":1312,"_30304":1268,"_20976":53522,"_5":14428,"_27536":53381,"_2958":53523},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3475":1313,"_30304":1268,"_20976":53525,"_5":14428,"_27536":53381,"_2958":53526},[],"Create or update Things in IoT Core",{"_3475":1314,"_30304":1268,"_20976":53528,"_5":14428,"_27536":53381,"_2958":53529},[],"`iot:RegisterThing`",{"_3475":1315,"_30304":1268,"_20976":53531,"_5":14428,"_27536":53381,"_2958":53532},[],"Provision Things through a template",{"_3475":1316,"_30304":1268,"_20976":53534,"_5":14428,"_27536":53381,"_2958":53535},[],"`iot:RegisterCertificate`",{"_3475":1317,"_30304":1268,"_20976":53537,"_5":14428,"_27536":53381,"_2958":53538},[],"Register device certificates",{"_3475":1318,"_30304":1268,"_20976":53540,"_5":14428,"_27536":53381,"_2958":53541},[],"`iot:UpdateCertificate`",{"_3475":1319,"_30304":1268,"_20976":53543,"_5":14428,"_27536":53381,"_2958":53544},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3475":1320,"_30304":1268,"_20976":53546,"_5":14428,"_27536":53381,"_2958":53547},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3475":1321,"_30304":1268,"_20976":53549,"_5":14428,"_27536":53381,"_2958":53550},[],"Create and attach IoT policies",{"_3475":1322,"_30304":1268,"_20976":53552,"_5":14428,"_27536":53381,"_2958":53553},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3475":1323,"_30304":1268,"_20976":53555,"_5":14428,"_27536":53381,"_2958":53556},[],"Manage Thing groups",{"_3475":1324,"_30304":1268,"_20976":53558,"_5":14428,"_27536":53381,"_2958":53559},[],"`iot:CreateProvisioningTemplate`",{"_3475":1325,"_30304":1268,"_20976":53561,"_5":14428,"_27536":53381,"_2958":53562},[],"Create JITP templates",{"_3475":1326,"_30304":1268,"_20976":53564,"_5":14428,"_27536":53381,"_2958":53565},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3475":1327,"_30304":1268,"_20976":53567,"_5":14428,"_27536":53381,"_2958":53568},[],"Read and write the Device Shadow",{"_3475":1328,"_30304":1268,"_20976":53570,"_5":14428,"_27536":53381,"_2958":53571},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3475":1329,"_30304":1268,"_20976":53573,"_5":14428,"_27536":53385,"_2958":53574},[],"Parameter",{"_3475":1330,"_30304":1268,"_20976":53576,"_5":14428,"_27536":53385,"_2958":53577},[],"Type",{"_3475":1331,"_30304":1268,"_20976":53579,"_5":14428,"_27536":53385,"_2958":53580},[],"Required",{"_3475":1332,"_30304":1268,"_20976":53582,"_5":14428,"_27536":53385,"_2958":53583},[],"Description",{"_3475":1333,"_30304":1268,"_20976":53585,"_5":14428,"_27536":53385,"_2958":53586},[],"`connector_id`",{"_3475":1334,"_30304":1268,"_20976":53588,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1335,"_30304":1268,"_20976":53590,"_5":14428,"_27536":53385,"_2958":53591},[],"Yes",{"_3475":1336,"_30304":1268,"_20976":53593,"_5":14428,"_27536":53385,"_2958":53594},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3475":1337,"_30304":1268,"_20976":53596,"_5":14428,"_27536":53385,"_2958":53597},[],"`aws_config.region`",{"_3475":1338,"_30304":1268,"_20976":53599,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1339,"_30304":1268,"_20976":53601,"_5":14428,"_27536":53385,"_2958":53591},[],{"_3475":1340,"_30304":1268,"_20976":53603,"_5":14428,"_27536":53385,"_2958":53604},[],"AWS region where the connector operates.",{"_3475":1341,"_30304":1268,"_20976":53606,"_5":14428,"_27536":53385,"_2958":53607},[],"`aws_config.auth_method`",{"_3475":1342,"_30304":1268,"_20976":53609,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1343,"_30304":1268,"_20976":53611,"_5":14428,"_27536":53385,"_2958":53591},[],{"_3475":1344,"_30304":1268,"_20976":53613,"_5":14428,"_27536":53385,"_2958":53614},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3475":1345,"_30304":1268,"_20976":53616,"_5":14428,"_27536":53385,"_2958":53617},[],"`aws_config.access_key_id`",{"_3475":1346,"_30304":1268,"_20976":53619,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1347,"_30304":1268,"_20976":53621,"_5":14428,"_27536":53385,"_2958":53622},[],"Only with `auth_method=static`",{"_3475":1348,"_30304":1268,"_20976":53624,"_5":14428,"_27536":53385,"_2958":53625},[],"AWS access key.",{"_3475":1349,"_30304":1268,"_20976":53627,"_5":14428,"_27536":53385,"_2958":53628},[],"`aws_config.secret_access_key`",{"_3475":1350,"_30304":1268,"_20976":53630,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1351,"_30304":1268,"_20976":53632,"_5":14428,"_27536":53385,"_2958":53622},[],{"_3475":1352,"_30304":1268,"_20976":53634,"_5":14428,"_27536":53385,"_2958":53635},[],"AWS secret key.",{"_3475":1353,"_30304":1268,"_20976":53637,"_5":14428,"_27536":53385,"_2958":53638},[],"`aws_config.session_token`",{"_3475":1354,"_30304":1268,"_20976":53640,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1355,"_30304":1268,"_20976":53642,"_5":14428,"_27536":53385,"_2958":53643},[],"No",{"_3475":1356,"_30304":1268,"_20976":53645,"_5":14428,"_27536":53385,"_2958":53646},[],"Session token (with `auth_method=static`).",{"_3475":1357,"_30304":1268,"_20976":53648,"_5":14428,"_27536":53385,"_2958":53649},[],"`aws_config.role_arn`",{"_3475":1358,"_30304":1268,"_20976":53651,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1359,"_30304":1268,"_20976":53653,"_5":14428,"_27536":53385,"_2958":53654},[],"Only with `auth_method=role`",{"_3475":1360,"_30304":1268,"_20976":53656,"_5":14428,"_27536":53385,"_2958":53657},[],"ARN of the role to assume.",{"_3475":1361,"_30304":1268,"_20976":53659,"_5":14428,"_27536":53385,"_2958":53660},[],"`aws_config.endpoint_url`",{"_3475":1362,"_30304":1268,"_20976":53662,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1363,"_30304":1268,"_20976":53664,"_5":14428,"_27536":53385,"_2958":53643},[],{"_3475":1364,"_30304":1268,"_20976":53666,"_5":14428,"_27536":53385,"_2958":53667},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3475":1365,"_30304":1268,"_20976":53669,"_5":14428,"_27536":53385,"_2958":53670},[],"`subscriber_event_bus`",{"_3475":1366,"_30304":1268,"_20976":53672,"_5":14428,"_27536":53385,"_2958":17666},[],{"_3475":1367,"_30304":1268,"_20976":53674,"_5":14428,"_27536":53385,"_2958":53591},[],{"_3475":1368,"_30304":1268,"_20976":53676,"_5":14428,"_27536":53385,"_2958":53677},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3475":1369,"_30304":1268,"_20976":53679,"_5":14428,"_27536":53385,"_2958":53680},[],"`dms_manager_client`",{"_3475":1370,"_30304":1268,"_20976":53682,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1371,"_30304":1268,"_20976":53684,"_5":14428,"_27536":53385,"_2958":53591},[],{"_3475":1372,"_30304":1268,"_20976":53686,"_5":14428,"_27536":53385,"_2958":53687},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3475":1373,"_30304":1268,"_20976":53689,"_5":14428,"_27536":53385,"_2958":53690},[],"`device_manager_client`",{"_3475":1374,"_30304":1268,"_20976":53692,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1375,"_30304":1268,"_20976":53694,"_5":14428,"_27536":53385,"_2958":53591},[],{"_3475":1376,"_30304":1268,"_20976":53696,"_5":14428,"_27536":53385,"_2958":53697},[],"HTTP URL of Lamassu's Device Manager.",{"_3475":1377,"_30304":1268,"_20976":53699,"_5":14428,"_27536":53385,"_2958":53700},[],"`ca_client`",{"_3475":1378,"_30304":1268,"_20976":53702,"_5":14428,"_27536":53385,"_2958":25085},[],{"_3475":1379,"_30304":1268,"_20976":53704,"_5":14428,"_27536":53385,"_2958":53591},[],{"_3475":1380,"_30304":1268,"_20976":53706,"_5":14428,"_27536":53385,"_2958":53707},[],"HTTP URL of Lamassu's CA service.",{"_3475":1381,"_30304":1268,"_20976":53709,"_5":14428,"_27536":53389,"_2958":53710},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3475":1382,"_30304":1268,"_20976":53712,"_5":14428,"_27536":53389,"_2958":53713},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3475":1383,"_30304":1268,"_20976":53715,"_5":14428,"_27536":53389,"_2958":53716},[],"CloudEvent type",{"_3475":1384,"_30304":1268,"_20976":53718,"_5":14428,"_27536":53389,"_2958":53719},[],"Lamassu resource",{"_3475":1385,"_30304":1268,"_20976":53721,"_5":14428,"_27536":53389,"_2958":53722},[],"AWS Resource",{"_3475":1386,"_30304":1268,"_20976":53724,"_5":14428,"_27536":53389,"_2958":53725},[],"IAM actions",{"_3475":1387,"_30304":1268,"_20976":53727,"_5":14428,"_27536":53389,"_2958":53728},[],"AWS calls and effect",{"_3475":1388,"_30304":1268,"_20976":53730,"_5":14428,"_27536":53389,"_2958":53731},[],"Where in this page",{"_3475":1389,"_30304":1268,"_20976":53733,"_5":14428,"_27536":53389,"_2958":53734},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3475":1390,"_30304":1268,"_20976":53736,"_5":14428,"_27536":53389,"_2958":53737},[],"CA",{"_3475":1391,"_30304":1268,"_20976":53739,"_5":14428,"_27536":53389,"_2958":53740},[],"`IoTCore/CACertificate`",{"_3475":1392,"_30304":1268,"_20976":53742,"_5":14428,"_27536":53389,"_2958":53743},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3475":1393,"_30304":1268,"_20976":53745,"_5":14428,"_27536":53389,"_2958":53746},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3475":1394,"_30304":1268,"_20976":53748,"_5":14428,"_27536":53389,"_2958":53402},[],{"_3475":1395,"_30304":1268,"_20976":53750,"_5":14428,"_27536":53389,"_2958":53751},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3475":1396,"_30304":1268,"_20976":53753,"_5":14428,"_27536":53389,"_2958":53754},[],"DMS",{"_3475":1397,"_30304":1268,"_20976":53756,"_5":14428,"_27536":53389,"_2958":53757},[],"`IoTCore/ProvisioningTemplate`",{"_3475":1398,"_30304":1268,"_20976":53759,"_5":14428,"_27536":53389,"_2958":53760},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3475":1399,"_30304":1268,"_20976":53762,"_5":14428,"_27536":53389,"_2958":53763},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3475":1400,"_30304":1268,"_20976":53765,"_5":14428,"_27536":53389,"_2958":53430},[],{"_3475":1401,"_30304":1268,"_20976":53767,"_5":14428,"_27536":53389,"_2958":53768},[],"`EventBindDeviceIdentityKey`",{"_3475":1402,"_30304":1268,"_20976":53770,"_5":14428,"_27536":53389,"_2958":53771},[],"Device",{"_3475":1403,"_30304":1268,"_20976":53773,"_5":14428,"_27536":53389,"_2958":53774},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3475":1404,"_30304":1268,"_20976":53776,"_5":14428,"_27536":53389,"_2958":53777},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3475":1405,"_30304":1268,"_20976":53779,"_5":14428,"_27536":53389,"_2958":53780},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3475":1406,"_30304":1268,"_20976":53782,"_5":14428,"_27536":53389,"_2958":53438},[],{"_3475":1407,"_30304":1268,"_20976":53784,"_5":14428,"_27536":53389,"_2958":53785},[],"`EventUpdateCertificateStatusKey`",{"_3475":1408,"_30304":1268,"_20976":53787,"_5":14428,"_27536":53389,"_2958":53788},[],"Certificate",{"_3475":1409,"_30304":1268,"_20976":53790,"_5":14428,"_27536":53389,"_2958":53791},[],"`IoTCore/Certificate`",{"_3475":1410,"_30304":1268,"_20976":53793,"_5":14428,"_27536":53389,"_2958":53794},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3475":1411,"_30304":1268,"_20976":53796,"_5":14428,"_27536":53389,"_2958":53797},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3475":1412,"_30304":1268,"_20976":53799,"_5":14428,"_27536":53389,"_2958":53450},[],{"_3475":1413,"_30304":1268,"_20976":53801,"_5":14428,"_27536":53389,"_2958":53802},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3475":1414,"_30304":1268,"_20976":53804,"_5":14428,"_27536":53389,"_2958":53805},[],"Certificate / Device",{"_3475":1415,"_30304":1268,"_20976":53807,"_5":14428,"_27536":53389,"_2958":53808},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3475":1416,"_30304":1268,"_20976":53810,"_5":14428,"_27536":53389,"_2958":49808},[],{"_3475":1417,"_30304":1268,"_20976":53812,"_5":14428,"_27536":53389,"_2958":53813},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3475":1418,"_30304":1268,"_20976":53815,"_5":14428,"_27536":53389,"_2958":53458},[],{"_3475":1419,"_30304":1268,"_20976":53817,"_5":14428,"_27536":53393,"_2958":53818},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3475":1420,"_30304":1268,"_20976":53820,"_5":14428,"_27536":53397,"_2958":53821},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3475":1421,"_30304":1268,"_20976":53823,"_5":14428,"_27536":53397,"_2958":53824},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3475":1422,"_30304":1268,"_20976":53826,"_5":14428,"_27536":53401,"_2958":53827},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3475":1423,"_30304":1268,"_20976":53829,"_5":14428,"_27536":53401,"_2958":53830},[],"Transition",{"_3475":1424,"_30304":1268,"_20976":53832,"_5":14428,"_27536":53401,"_2958":53833},[],"AWS calls",{"_3475":1425,"_30304":1268,"_20976":53835,"_5":14428,"_27536":53401,"_2958":53836},[],"`NotRegistered` → `Requested`",{"_3475":1426,"_30304":1268,"_20976":53838,"_5":14428,"_27536":53401,"_2958":53839},[],"none (metadata write only)",{"_3475":1427,"_30304":1268,"_20976":53841,"_5":14428,"_27536":53401,"_2958":53842},[],"`Requested` → `Registering`",{"_3475":1428,"_30304":1268,"_20976":53844,"_5":14428,"_27536":53401,"_2958":53845},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3475":1429,"_30304":1268,"_20976":53847,"_5":14428,"_27536":53401,"_2958":53848},[],"`Registering` → `Succeeded`",{"_3475":1430,"_30304":1268,"_20976":53850,"_5":14428,"_27536":53401,"_2958":53851},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3475":1431,"_30304":1268,"_20976":53853,"_5":14428,"_27536":53401,"_2958":53854},[],"`Registering` → `Failed`",{"_3475":1432,"_30304":1268,"_20976":53856,"_5":14428,"_27536":53401,"_2958":53857},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3475":1433,"_30304":1268,"_20976":53859,"_5":14428,"_27536":53401,"_2958":53860},[],"`Failed` / `Succeeded` → `Requested`",{"_3475":1434,"_30304":1268,"_20976":53862,"_5":14428,"_27536":53401,"_2958":53863},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3475":1435,"_30304":1268,"_20976":53865,"_5":14428,"_27536":53405,"_2958":53866},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3475":1436,"_30304":1268,"_20976":53868,"_5":14428,"_27536":53405,"_2958":53869},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3475":1437,"_30304":1268,"_20976":53871,"_5":14428,"_27536":53405,"_2958":53872},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3475":1438,"_30304":1268,"_20976":53874,"_5":14428,"_27536":53405,"_2958":53875},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3475":1439,"_30304":1268,"_20976":53877,"_5":14428,"_27536":53405,"_2958":53878},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3475":1440,"_30304":1268,"_20976":53880,"_5":14428,"_27536":53405,"_2958":53881},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3475":1441,"_30304":1268,"_20976":53883,"_5":14428,"_27536":53409,"_2958":53884},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3475":1442,"_30304":1268,"_20976":53886,"_5":14428,"_27536":53413,"_2958":53887},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3475":1443,"_30304":1268,"_20976":53889,"_5":14428,"_27536":53413,"_2958":53890},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3475":1444,"_30304":1268,"_20976":53892,"_5":14428,"_27536":53417,"_2958":53893},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3475":1445,"_30304":1268,"_20976":53895,"_5":14428,"_27536":53421,"_2958":53896},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3475":1446,"_30304":1268,"_20976":53898,"_5":14428,"_27536":53421,"_2958":53899},[],"Creates or updates the IoT policies configured in the DMS.",{"_3475":1447,"_30304":1268,"_20976":53901,"_5":14428,"_27536":53421,"_2958":53902},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3475":1448,"_30304":1268,"_20976":53904,"_5":14428,"_27536":53421,"_2958":53905},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3475":1449,"_30304":1268,"_20976":53907,"_5":14428,"_27536":53421,"_2958":53908},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3475":1450,"_30304":1268,"_20976":53910,"_5":14428,"_27536":53421,"_2958":53911},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3475":1451,"_30304":1268,"_20976":53913,"_5":14428,"_27536":53421,"_2958":53914},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3475":1452,"_30304":1268,"_20976":53916,"_5":14428,"_27536":53425,"_2958":53917},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3475":1453,"_30304":1268,"_20976":53919,"_5":14428,"_27536":53425,"_2958":53920},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3475":1454,"_30304":1268,"_20976":53922,"_5":14428,"_27536":53425,"_2958":53923},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3475":1455,"_30304":1268,"_20976":53925,"_5":14428,"_27536":53425,"_2958":53926},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3475":1456,"_30304":1268,"_20976":53928,"_5":14428,"_27536":53425,"_2958":53929},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3475":1457,"_30304":1268,"_20976":53931,"_5":14428,"_27536":53429,"_2958":53932},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3475":1458,"_30304":1268,"_20976":53934,"_5":14428,"_27536":53429,"_2958":53830},[],{"_3475":1459,"_30304":1268,"_20976":53936,"_5":14428,"_27536":53429,"_2958":53833},[],{"_3475":1460,"_30304":1268,"_20976":53938,"_5":14428,"_27536":53429,"_2958":53939},[],"`Unconfigured` → `None` / `Auto`",{"_3475":1461,"_30304":1268,"_20976":53941,"_5":14428,"_27536":53429,"_2958":53942},[],"none (configuration only)",{"_3475":1462,"_30304":1268,"_20976":53944,"_5":14428,"_27536":53429,"_2958":53945},[],"`None` ↔ `Auto`",{"_3475":1463,"_30304":1268,"_20976":53947,"_5":14428,"_27536":53429,"_2958":53942},[],{"_3475":1464,"_30304":1268,"_20976":53949,"_5":14428,"_27536":53429,"_2958":53950},[],"Any → `Jitp`",{"_3475":1465,"_30304":1268,"_20976":53952,"_5":14428,"_27536":53429,"_2958":53953},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3475":1466,"_30304":1268,"_20976":53955,"_5":14428,"_27536":53429,"_2958":53956},[],"`Jitp` → `None` / `Auto`",{"_3475":1467,"_30304":1268,"_20976":53958,"_5":14428,"_27536":53429,"_2958":53959},[],"none (the template stays in the AWS account)",{"_3475":1468,"_30304":1268,"_20976":53961,"_5":14428,"_27536":53433,"_2958":53962},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3475":1469,"_30304":1268,"_20976":53964,"_5":14428,"_27536":53433,"_2958":53965},[],"The full flow from the device's perspective is:",{"_3475":1470,"_30304":1268,"_20976":53967,"_5":14428,"_27536":53433,"_2958":53968},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3475":1471,"_30304":1268,"_20976":53970,"_5":14428,"_27536":53437,"_2958":53971},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3475":1472,"_30304":1268,"_20976":53973,"_5":14428,"_27536":53437,"_2958":53830},[],{"_3475":1473,"_30304":1268,"_20976":53975,"_5":14428,"_27536":53437,"_2958":53833},[],{"_3475":1474,"_30304":1268,"_20976":53977,"_5":14428,"_27536":53437,"_2958":53978},[],"`Absent` → `Provisioned`",{"_3475":1475,"_30304":1268,"_20976":53980,"_5":14428,"_27536":53437,"_2958":53981},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3475":1476,"_30304":1268,"_20976":53983,"_5":14428,"_27536":53437,"_2958":53984},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3475":1477,"_30304":1268,"_20976":53986,"_5":14428,"_27536":53437,"_2958":53987},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3475":1478,"_30304":1268,"_20976":53989,"_5":14428,"_27536":53437,"_2958":53990},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3475":1479,"_30304":1268,"_20976":53992,"_5":14428,"_27536":53441,"_2958":53993},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3475":1480,"_30304":1268,"_20976":53995,"_5":14428,"_27536":53441,"_2958":53996},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3475":1481,"_30304":1268,"_20976":53998,"_5":14428,"_27536":53441,"_2958":53999},[],"For the JITP flow to work correctly:",{"_3475":1482,"_30304":1268,"_20976":54001,"_5":14428,"_27536":53441,"_2958":54002},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3475":1483,"_30304":1268,"_20976":54004,"_5":14428,"_27536":53441,"_2958":54005},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3475":1484,"_30304":1268,"_20976":54007,"_5":14428,"_27536":53441,"_2958":54008},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3475":1485,"_30304":1268,"_20976":54010,"_5":14428,"_27536":53441,"_2958":54011},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3475":1486,"_30304":1268,"_20976":54013,"_5":14428,"_27536":53445,"_2958":54014},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3475":1487,"_30304":1268,"_20976":54016,"_5":14428,"_27536":53445,"_2958":54017},[],"Status in Lamassu",{"_3475":1488,"_30304":1268,"_20976":54019,"_5":14428,"_27536":53445,"_2958":54020},[],"Revocation reason",{"_3475":1489,"_30304":1268,"_20976":54022,"_5":14428,"_27536":53445,"_2958":54023},[],"Status in AWS IoT Core",{"_3475":1490,"_30304":1268,"_20976":54025,"_5":14428,"_27536":53445,"_2958":54026},[],"`Active`",{"_3475":1491,"_30304":1268,"_20976":54028,"_5":14428,"_27536":53445,"_2958":54029},[],"None",{"_3475":1492,"_30304":1268,"_20976":54031,"_5":14428,"_27536":53445,"_2958":54032},[],"`ACTIVE`",{"_3475":1493,"_30304":1268,"_20976":54034,"_5":14428,"_27536":53445,"_2958":54035},[],"`Revoked`",{"_3475":1494,"_30304":1268,"_20976":54037,"_5":14428,"_27536":53445,"_2958":54038},[],"`certificateHold`",{"_3475":1495,"_30304":1268,"_20976":54040,"_5":14428,"_27536":53445,"_2958":54041},[],"`INACTIVE`",{"_3475":1496,"_30304":1268,"_20976":54043,"_5":14428,"_27536":53445,"_2958":54035},[],{"_3475":1497,"_30304":1268,"_20976":54045,"_5":14428,"_27536":53445,"_2958":54046},[],"Any other reason",{"_3475":1498,"_30304":1268,"_20976":54048,"_5":14428,"_27536":53445,"_2958":54049},[],"`REVOKED`",{"_3475":1499,"_30304":1268,"_20976":54051,"_5":14428,"_27536":53445,"_2958":54052},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3475":1500,"_30304":1268,"_20976":54054,"_5":14428,"_27536":53449,"_2958":54055},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3475":1501,"_30304":1268,"_20976":54057,"_5":14428,"_27536":53449,"_2958":53830},[],{"_3475":1502,"_30304":1268,"_20976":54059,"_5":14428,"_27536":53449,"_2958":53833},[],{"_3475":1503,"_30304":1268,"_20976":54061,"_5":14428,"_27536":53449,"_2958":54062},[],"`NotSynced` → `Active`",{"_3475":1504,"_30304":1268,"_20976":54064,"_5":14428,"_27536":53449,"_2958":53541},[],{"_3475":1505,"_30304":1268,"_20976":54066,"_5":14428,"_27536":53449,"_2958":54067},[],"`Active` → `Inactive`",{"_3475":1506,"_30304":1268,"_20976":54069,"_5":14428,"_27536":53449,"_2958":54070},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3475":1507,"_30304":1268,"_20976":54072,"_5":14428,"_27536":53449,"_2958":54073},[],"`Active` → `Revoked`",{"_3475":1508,"_30304":1268,"_20976":54075,"_5":14428,"_27536":53449,"_2958":54070},[],{"_3475":1509,"_30304":1268,"_20976":54077,"_5":14428,"_27536":53449,"_2958":54078},[],"`Inactive` / `Revoked` → `Active`",{"_3475":1510,"_30304":1268,"_20976":54080,"_5":14428,"_27536":53449,"_2958":53541},[],{"_3475":1511,"_30304":1268,"_20976":54082,"_5":14428,"_27536":53449,"_2958":54083},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3475":1512,"_30304":1268,"_20976":54085,"_5":14428,"_27536":53449,"_2958":54086},[],"none (these states are not synced to AWS)",{"_3475":1513,"_30304":1268,"_20976":54088,"_5":14428,"_27536":53453,"_2958":54089},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3475":1514,"_30304":1268,"_20976":54091,"_5":14428,"_27536":53453,"_2958":54092},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3475":1515,"_30304":1268,"_20976":54094,"_5":14428,"_27536":53453,"_2958":54095},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3475":1516,"_30304":1268,"_20976":54097,"_5":14428,"_27536":53457,"_2958":54098},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3475":1517,"_30304":1268,"_20976":54100,"_5":14428,"_27536":53457,"_2958":54101},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3475":1518,"_30304":1268,"_20976":54103,"_5":14428,"_27536":53461,"_2958":54104},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3475":1519,"_30304":1268,"_20976":54106,"_5":14428,"_27536":53461,"_2958":54107},[],"There are two action types:",{"_3475":1520,"_30304":1268,"_20976":54109,"_5":14428,"_27536":53461,"_2958":54110},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3475":1521,"_30304":1268,"_20976":54112,"_5":14428,"_27536":53461,"_2958":54113},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3475":1522,"_30304":1268,"_20976":54115,"_5":14428,"_27536":53461,"_2958":54116},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3475":1523,"_30304":1268,"_20976":54118,"_5":14428,"_27536":53465,"_2958":54119},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3475":1524,"_30304":1268,"_20976":54121,"_5":14428,"_27536":53465,"_2958":54122},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3475":1525,"_30304":1268,"_20976":54124,"_5":14428,"_27536":53465,"_2958":54125},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3475":1526,"_30304":1268,"_20976":54127,"_5":14428,"_27536":53469,"_2958":54128},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3475":1527,"_30304":1268,"_20976":54130,"_5":14428,"_27536":53469,"_2958":54131},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3475":1528,"_30304":1268,"_20976":54133,"_5":14428,"_27536":53469,"_2958":54134},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3475":1529,"_30304":1268,"_20976":54136,"_5":14428,"_27536":53469,"_2958":54137},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3475":1530,"_30304":1268,"_20976":54139,"_5":14428,"_27536":53469,"_2958":54140},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3475":1531,"_30304":1268,"_20976":54142,"_5":14428,"_27536":53469,"_2958":54143},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3475":1532,"_30304":1268,"_20976":54145,"_5":14428,"_27536":53469,"_2958":54146},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3475":1533,"_30304":1268,"_20976":54148,"_5":14428,"_27536":53469,"_2958":54149},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3475":1534,"_30304":1268,"_20976":54151,"_5":14428,"_27536":53469,"_2958":54152},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3475":1535,"_30304":1268,"_20976":54154,"_5":14428,"_27536":53469,"_2958":54155},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3475":1536,"_30304":1268,"_20976":54157,"_5":14428,"_27536":53469,"_2958":54158},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3475":1537,"_30304":1268,"_20976":54160,"_5":14428,"_27536":53469,"_2958":54161},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3475":1538,"_30304":1268,"_20976":54163,"_5":14428,"_27536":53469,"_2958":54164},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3475":1539,"_30304":1268,"_20976":54166,"_5":14428,"_27536":53469,"_2958":54167},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3475":1540,"_30304":1268,"_20976":54169,"_5":14428,"_27536":53469,"_2958":54170},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3475":1541,"_30304":1268,"_20976":54172,"_5":14428,"_27536":53469,"_2958":54173},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3475":1542,"_30304":1268,"_20976":54175,"_5":14428,"_27536":53469,"_2958":54176},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3475":1543,"_30304":1268,"_20976":54178,"_5":14428,"_27536":53469,"_2958":54179},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3475":1544,"_30304":1268,"_20976":54181,"_5":14428,"_27536":53469,"_2958":54182},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3475":1545,"_30304":1268,"_20976":54184,"_5":14428,"_27536":53469,"_2958":54185},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3475":1546,"_30304":1268,"_20976":54187,"_5":14428,"_27536":53469,"_2958":54188},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3475":1547,"_30304":1268,"_20976":54190,"_5":14428,"_27536":53469,"_2958":54191},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":1548,"_30304":1268,"_20976":54193,"_5":14428,"_27536":53469,"_2958":54194},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3475":1549,"_30304":1268,"_20976":54196,"_5":14428,"_27536":53469,"_2958":54197},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3475":1550,"_30304":1550,"_5":14780,"_2958":51904,"_30657":54199,"_20976":54200,"_27536":1550},[49412,50887,51904],[],{"_3475":1551,"_30304":1550,"_20976":54202,"_5":14428,"_27536":1550,"_2958":54203},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3475":1552,"_30304":1550,"_5":30654,"_20976":54205,"_27536":54206,"_2958":54207},[],"/docs/pr-preview/pr-65/platform/iot-fleets/overview#start-here","Start here",{"_3475":1553,"_30304":1550,"_5":30654,"_20976":54209,"_27536":54210,"_2958":51902},[],"/docs/pr-preview/pr-65/platform/iot-fleets/overview#devices-and-identities",{"_3475":1554,"_30304":1550,"_5":30654,"_20976":54212,"_27536":54213,"_2958":52085},[],"/docs/pr-preview/pr-65/platform/iot-fleets/overview#enrollment-with-pki",{"_3475":1555,"_30304":1550,"_5":30654,"_20976":54215,"_27536":54216,"_2958":53366},[],"/docs/pr-preview/pr-65/platform/iot-fleets/overview#integrations",{"_3475":1556,"_30304":1550,"_5":30654,"_20976":54218,"_27536":54219,"_2958":54220},[],"/docs/pr-preview/pr-65/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3475":1557,"_30304":1550,"_20976":54222,"_5":14428,"_27536":1550,"_2958":54223},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3475":1558,"_30304":1550,"_20976":54225,"_5":14428,"_27536":54206,"_2958":54226},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3475":1559,"_30304":1550,"_20976":54228,"_5":14428,"_27536":54206,"_2958":54229},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3475":1560,"_30304":1550,"_20976":54231,"_5":14428,"_27536":54210,"_2958":54232},[],"Resource",{"_3475":1561,"_30304":1550,"_20976":54234,"_5":14428,"_27536":54210,"_2958":54235},[],"What it represents",{"_3475":1562,"_30304":1550,"_20976":54237,"_5":14428,"_27536":54210,"_2958":54238},[],"**Device**",{"_3475":1563,"_30304":1550,"_20976":54240,"_5":14428,"_27536":54210,"_2958":54241},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3475":1564,"_30304":1550,"_20976":54243,"_5":14428,"_27536":54210,"_2958":54244},[],"**Identity**",{"_3475":1565,"_30304":1550,"_20976":54246,"_5":14428,"_27536":54210,"_2958":54247},[],"The device's association with its certificates: an active version and a history.",{"_3475":1566,"_30304":1550,"_20976":54249,"_5":14428,"_27536":54210,"_2958":54250},[],"**DMS**",{"_3475":1567,"_30304":1550,"_20976":54252,"_5":14428,"_27536":54210,"_2958":54253},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3475":1568,"_30304":1550,"_20976":54255,"_5":14428,"_27536":54210,"_2958":54256},[],"**Fleet**",{"_3475":1569,"_30304":1550,"_20976":54258,"_5":14428,"_27536":54210,"_2958":54259},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3475":1570,"_30304":1550,"_20976":54261,"_5":14428,"_27536":54210,"_2958":54262},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3475":1571,"_30304":1550,"_20976":54264,"_5":14428,"_27536":54210,"_2958":54265},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3475":1572,"_30304":1550,"_20976":54267,"_5":14428,"_27536":54213,"_2958":54268},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3475":1573,"_30304":1550,"_20976":54270,"_5":14428,"_27536":54213,"_2958":54271},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3475":1574,"_30304":1550,"_20976":54273,"_5":14428,"_27536":54213,"_2958":54274},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3475":1575,"_30304":1550,"_20976":54276,"_5":14428,"_27536":54213,"_2958":54277},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3475":1576,"_30304":1550,"_20976":54279,"_5":14428,"_27536":54213,"_2958":54280},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3475":1577,"_30304":1550,"_20976":54282,"_5":14428,"_27536":54213,"_2958":54283},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3475":1578,"_30304":1550,"_20976":54285,"_5":14428,"_27536":54213,"_2958":54286},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":1579,"_30304":1550,"_20976":54288,"_5":14428,"_27536":54213,"_2958":54289},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3475":1580,"_30304":1550,"_20976":54291,"_5":14428,"_27536":54216,"_2958":54292},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3475":1581,"_30304":1550,"_20976":54294,"_5":14428,"_27536":54216,"_2958":54295},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3475":1582,"_30304":1550,"_20976":54297,"_5":14428,"_27536":54219,"_2958":54298},[],"Participant",{"_3475":1583,"_30304":1550,"_20976":54300,"_5":14428,"_27536":54219,"_2958":54301},[],"Responsibility",{"_3475":1584,"_30304":1550,"_20976":54303,"_5":14428,"_27536":54219,"_2958":54304},[],"PKI administrator",{"_3475":1585,"_30304":1550,"_20976":54306,"_5":14428,"_27536":54219,"_2958":54307},[],"CA, issuance profile, chain and revocation publication.",{"_3475":1586,"_30304":1550,"_20976":54309,"_5":14428,"_27536":54219,"_2958":54310},[],"Provisioning administrator",{"_3475":1587,"_30304":1550,"_20976":54312,"_5":14428,"_27536":54219,"_2958":54313},[],"DMS, admission, authentication per operation and inventory.",{"_3475":1588,"_30304":1550,"_20976":54315,"_5":14428,"_27536":54219,"_2958":54316},[],"Device integrator",{"_3475":1589,"_30304":1550,"_20976":54318,"_5":14428,"_27536":54219,"_2958":54319},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3475":1590,"_30304":1550,"_20976":54321,"_5":14428,"_27536":54219,"_2958":54322},[],"Consumer integrator",{"_3475":1591,"_30304":1550,"_20976":54324,"_5":14428,"_27536":54219,"_2958":54325},[],"Trusted issuers, validation and device permissions in the destination.",{"_3475":1592,"_30304":1550,"_20976":54327,"_5":14428,"_27536":54219,"_2958":54328},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3475":1593,"_30304":1593,"_5":14780,"_2958":54330,"_30657":54331,"_20976":54333,"_27536":1593},"Enroll and connect your first device",[49412,50887,51904,54332],"Getting started",[],{"_3475":1594,"_30304":1593,"_20976":54335,"_5":14428,"_27536":1593,"_2958":54336},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3475":1595,"_30304":1593,"_5":30654,"_20976":54338,"_27536":54339,"_2958":49422},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3475":1596,"_30304":1593,"_5":30654,"_20976":54341,"_27536":54342,"_2958":54343},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3475":1597,"_30304":1593,"_5":30654,"_20976":54345,"_27536":54346,"_2958":54347},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3475":1598,"_30304":1593,"_5":30654,"_20976":54349,"_27536":54350,"_2958":54351},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3475":1599,"_30304":1593,"_5":30654,"_20976":54353,"_27536":54354,"_2958":54355},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3475":1600,"_30304":1593,"_5":30654,"_20976":54357,"_27536":54358,"_2958":54359},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3475":1601,"_30304":1593,"_5":30654,"_20976":54361,"_27536":54362,"_2958":54363},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3475":1602,"_30304":1593,"_5":30654,"_20976":54365,"_27536":54366,"_2958":54367},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3475":1603,"_30304":1593,"_20976":54369,"_5":14428,"_27536":1593,"_2958":54370},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3475":1604,"_30304":1593,"_20976":54372,"_5":14428,"_27536":54339,"_2958":54373},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3475":1605,"_30304":1593,"_20976":54375,"_5":14428,"_27536":54339,"_2958":54376},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3475":1606,"_30304":1593,"_20976":54378,"_5":14428,"_27536":54339,"_2958":54379},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3475":1607,"_30304":1593,"_20976":54381,"_5":14428,"_27536":54339,"_2958":54382},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3475":1608,"_30304":1593,"_20976":54384,"_5":14428,"_27536":54339,"_2958":54385},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3475":1609,"_30304":1593,"_20976":54387,"_5":14428,"_27536":54342,"_2958":54388},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3475":1610,"_30304":1593,"_20976":54390,"_5":14428,"_27536":54342,"_2958":54391},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3475":1611,"_30304":1593,"_20976":54393,"_5":14428,"_27536":54346,"_2958":54394},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3475":1612,"_30304":1593,"_20976":54396,"_5":14428,"_27536":54346,"_2958":54397},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3475":1613,"_30304":1593,"_20976":54399,"_5":14428,"_27536":54346,"_2958":54400},[],"Setting",{"_3475":1614,"_30304":1593,"_20976":54402,"_5":14428,"_27536":54346,"_2958":54403},[],"Evaluation value",{"_3475":1615,"_30304":1593,"_20976":54405,"_5":14428,"_27536":54346,"_2958":54406},[],"Enrollment CA",{"_3475":1616,"_30304":1593,"_20976":54408,"_5":14428,"_27536":54346,"_2958":54409},[],"Issuing root from `device-root.pem`.",{"_3475":1617,"_30304":1593,"_20976":54411,"_5":14428,"_27536":54346,"_2958":52215},[],{"_3475":1618,"_30304":1593,"_20976":54413,"_5":14428,"_27536":54346,"_2958":54414},[],"The 1-hour leaf profile you just prepared.",{"_3475":1619,"_30304":1593,"_20976":54416,"_5":14428,"_27536":54346,"_2958":54417},[],"Protocol / Registration Mode",{"_3475":1620,"_30304":1593,"_20976":54419,"_5":14428,"_27536":54346,"_2958":54420},[],"`EST_RFC7030` / `JITP`.",{"_3475":1621,"_30304":1593,"_20976":54422,"_5":14428,"_27536":54346,"_2958":54423},[],"Verify CSR Signature",{"_3475":1622,"_30304":1593,"_20976":54425,"_5":14428,"_27536":54346,"_2958":54426},[],"Enabled.",{"_3475":1623,"_30304":1593,"_20976":54428,"_5":14428,"_27536":54346,"_2958":54429},[],"Enable Replaceable Enrollment",{"_3475":1624,"_30304":1593,"_20976":54431,"_5":14428,"_27536":54346,"_2958":54432},[],"Disabled; the ID must be new.",{"_3475":1625,"_30304":1593,"_20976":54434,"_5":14428,"_27536":54346,"_2958":54435},[],"Initial authentication",{"_3475":1626,"_30304":1593,"_20976":54437,"_5":14428,"_27536":54346,"_2958":54438},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3475":1627,"_30304":1593,"_20976":54440,"_5":14428,"_27536":54346,"_2958":54441},[],"Renewal authentication",{"_3475":1628,"_30304":1593,"_20976":54443,"_5":14428,"_27536":54346,"_2958":54444},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3475":1629,"_30304":1593,"_20976":54446,"_5":14428,"_27536":54346,"_2958":54447},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3475":1630,"_30304":1593,"_20976":54449,"_5":14428,"_27536":54346,"_2958":54450},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3475":1631,"_30304":1593,"_20976":54452,"_5":14428,"_27536":54346,"_2958":54453},[],"Re-enrollment Delta",{"_3475":1632,"_30304":1593,"_20976":54455,"_5":14428,"_27536":54346,"_2958":54456},[],"1 hour.",{"_3475":1633,"_30304":1593,"_20976":54458,"_5":14428,"_27536":54346,"_2958":54459},[],"Preventive / Critical Delta",{"_3475":1634,"_30304":1593,"_20976":54461,"_5":14428,"_27536":54346,"_2958":54462},[],"30 minutes / 10 minutes.",{"_3475":1635,"_30304":1593,"_20976":54464,"_5":14428,"_27536":54346,"_2958":54465},[],"Revoke on Re-enrollment",{"_3475":1636,"_30304":1593,"_20976":54467,"_5":14428,"_27536":54346,"_2958":54468},[],"Disabled to test the successor before retiring the previous identity.",{"_3475":1637,"_30304":1593,"_20976":54470,"_5":14428,"_27536":54346,"_2958":52223},[],{"_3475":1638,"_30304":1593,"_20976":54472,"_5":14428,"_27536":54346,"_2958":54473},[],"Disabled; the operational key is generated in the client.",{"_3475":1639,"_30304":1593,"_20976":54475,"_5":14428,"_27536":54346,"_2958":54476},[],"CA Distribution",{"_3475":1640,"_30304":1593,"_20976":54478,"_5":14428,"_27536":54346,"_2958":54479},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3475":1641,"_30304":1593,"_20976":54481,"_5":14428,"_27536":54346,"_2958":54482},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3475":1642,"_30304":1593,"_20976":54484,"_5":14428,"_27536":54350,"_2958":54485},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3475":1643,"_30304":1593,"_20976":54487,"_5":14428,"_27536":54350,"_2958":54488},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3475":1644,"_30304":1593,"_20976":54490,"_5":14428,"_27536":54354,"_2958":54491},[],"Generate a new key and CSR with the selected identifier:",{"_3475":1645,"_30304":1593,"_20976":54493,"_5":14428,"_27536":54354,"_2958":54494},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3475":1646,"_30304":1593,"_20976":54496,"_5":14428,"_27536":54354,"_2958":54497},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3475":1647,"_30304":1593,"_20976":54499,"_5":14428,"_27536":54358,"_2958":54500},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3475":1648,"_30304":1593,"_20976":54502,"_5":14428,"_27536":54358,"_2958":54503},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3475":1649,"_30304":1593,"_20976":54505,"_5":14428,"_27536":54362,"_2958":54506},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3475":1650,"_30304":1593,"_20976":54508,"_5":14428,"_27536":54362,"_2958":54509},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3475":1651,"_30304":1593,"_20976":54511,"_5":14428,"_27536":54362,"_2958":54512},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3475":1652,"_30304":1593,"_20976":54514,"_5":14428,"_27536":54362,"_2958":54515},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3475":1653,"_30304":1593,"_20976":54517,"_5":14428,"_27536":54362,"_2958":54518},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3475":1654,"_30304":1593,"_20976":54520,"_5":14428,"_27536":54366,"_2958":54521},[],"Check",{"_3475":1655,"_30304":1593,"_20976":54523,"_5":14428,"_27536":54366,"_2958":54524},[],"Expected result",{"_3475":1656,"_30304":1593,"_20976":54526,"_5":14428,"_27536":54366,"_2958":54527},[],"Registration",{"_3475":1657,"_30304":1593,"_20976":54529,"_5":14428,"_27536":54366,"_2958":54530},[],"ID created automatically and correct DMS.",{"_3475":1658,"_30304":1593,"_20976":54532,"_5":14428,"_27536":54366,"_2958":53788},[],{"_3475":1659,"_30304":1593,"_20976":54534,"_5":14428,"_27536":54366,"_2958":54535},[],"CN, profile, serial and key verified.",{"_3475":1660,"_30304":1593,"_20976":54537,"_5":14428,"_27536":54366,"_2958":54538},[],"Inventory",{"_3475":1661,"_30304":1593,"_20976":54540,"_5":14428,"_27536":54366,"_2958":54541},[],"Received serial visible as the current identity and in history.",{"_3475":1662,"_30304":1593,"_20976":54543,"_5":14428,"_27536":54366,"_2958":54544},[],"Consumer",{"_3475":1663,"_30304":1593,"_20976":54546,"_5":14428,"_27536":54366,"_2958":54547},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3475":1664,"_30304":1593,"_20976":54549,"_5":14428,"_27536":54366,"_2958":54550},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3475":1665,"_30304":1593,"_20976":54552,"_5":14428,"_27536":54366,"_2958":54553},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3475":1666,"_30304":1666,"_5":14780,"_2958":51920,"_30657":54555,"_20976":54556,"_27536":1666},[49412,50887,51904,54332],[],{"_3475":1667,"_30304":1666,"_20976":54558,"_5":14428,"_27536":1666,"_2958":54559},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3475":1668,"_30304":1666,"_5":30654,"_20976":54561,"_27536":54562,"_2958":49422},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3475":1669,"_30304":1666,"_5":30654,"_20976":54564,"_27536":54565,"_2958":54566},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3475":1670,"_30304":1666,"_5":30654,"_20976":54568,"_27536":54569,"_2958":54570},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3475":1671,"_30304":1666,"_5":30654,"_20976":54572,"_27536":54573,"_2958":54574},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3475":1672,"_30304":1666,"_5":30654,"_20976":54576,"_27536":54577,"_2958":54578},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3475":1673,"_30304":1666,"_5":30654,"_20976":54580,"_27536":54581,"_2958":54582},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3475":1674,"_30304":1666,"_5":30654,"_20976":54584,"_27536":54585,"_2958":54524},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3475":1675,"_30304":1666,"_5":30654,"_20976":54587,"_27536":54588,"_2958":54589},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3475":1676,"_30304":1666,"_5":30654,"_20976":54591,"_27536":54592,"_2958":54593},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3475":1677,"_30304":1666,"_20976":54595,"_5":14428,"_27536":1666,"_2958":54596},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3475":1678,"_30304":1666,"_20976":54598,"_5":14428,"_27536":1666,"_2958":54599},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3475":1679,"_30304":1666,"_20976":54601,"_5":14428,"_27536":54562,"_2958":54602},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3475":1680,"_30304":1666,"_20976":54604,"_5":14428,"_27536":54562,"_2958":54605},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3475":1681,"_30304":1666,"_20976":54607,"_5":14428,"_27536":54562,"_2958":54608},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3475":1682,"_30304":1666,"_20976":54610,"_5":14428,"_27536":54562,"_2958":54611},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3475":1683,"_30304":1666,"_20976":54613,"_5":14428,"_27536":54565,"_2958":54614},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3475":1684,"_30304":1666,"_20976":54616,"_5":14428,"_27536":54565,"_2958":54617},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3475":1685,"_30304":1666,"_20976":54619,"_5":14428,"_27536":54565,"_2958":54620},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3475":1686,"_30304":1666,"_20976":54622,"_5":14428,"_27536":54565,"_2958":54623},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3475":1687,"_30304":1666,"_20976":54625,"_5":14428,"_27536":54565,"_2958":54626},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3475":1688,"_30304":1666,"_20976":54628,"_5":14428,"_27536":54565,"_2958":54629},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3475":1689,"_30304":1666,"_20976":54631,"_5":14428,"_27536":54565,"_2958":54632},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3475":1690,"_30304":1666,"_20976":54634,"_5":14428,"_27536":54565,"_2958":54635},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3475":1691,"_30304":1666,"_20976":54637,"_5":14428,"_27536":54569,"_2958":54638},[],"Open **Managed Devices** and the registration action. Complete:",{"_3475":1692,"_30304":1666,"_20976":54640,"_5":14428,"_27536":54569,"_2958":54641},[],"**Device ID**: `device-001`.",{"_3475":1693,"_30304":1666,"_20976":54643,"_5":14428,"_27536":54569,"_2958":54644},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3475":1694,"_30304":1666,"_20976":54646,"_5":14428,"_27536":54569,"_2958":54647},[],"**Icon** and **Tags**: optional classification.",{"_3475":1695,"_30304":1666,"_20976":54649,"_5":14428,"_27536":54569,"_2958":54650},[],"Confirm registration.",{"_3475":1696,"_30304":1666,"_20976":54652,"_5":14428,"_27536":54573,"_2958":54653},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3475":1697,"_30304":1666,"_20976":54655,"_5":14428,"_27536":54573,"_2958":54656},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3475":1698,"_30304":1666,"_20976":54658,"_5":14428,"_27536":54577,"_2958":54659},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3475":1699,"_30304":1666,"_20976":54661,"_5":14428,"_27536":54577,"_2958":54662},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3475":1700,"_30304":1666,"_20976":54664,"_5":14428,"_27536":54581,"_2958":54665},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3475":1701,"_30304":1666,"_20976":54667,"_5":14428,"_27536":54581,"_2958":54668},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3475":1702,"_30304":1666,"_20976":54670,"_5":14428,"_27536":54585,"_2958":54521},[],{"_3475":1703,"_30304":1666,"_20976":54672,"_5":14428,"_27536":54585,"_2958":54673},[],"Result",{"_3475":1704,"_30304":1666,"_20976":54675,"_5":14428,"_27536":54585,"_2958":53771},[],{"_3475":1705,"_30304":1666,"_20976":54677,"_5":14428,"_27536":54585,"_2958":54678},[],"`device-001` appears in inventory with the expected DMS.",{"_3475":1706,"_30304":1666,"_20976":54680,"_5":14428,"_27536":54585,"_2958":54681},[],"Current identity",{"_3475":1707,"_30304":1666,"_20976":54683,"_5":14428,"_27536":54585,"_2958":54684},[],"The associated certificate matches the one you verified in PKI.",{"_3475":1708,"_30304":1666,"_20976":54686,"_5":14428,"_27536":54585,"_2958":54687},[],"History",{"_3475":1709,"_30304":1666,"_20976":54689,"_5":14428,"_27536":54585,"_2958":54690},[],"The associated issuance appears with its serial number and dates.",{"_3475":1710,"_30304":1666,"_20976":54692,"_5":14428,"_27536":54585,"_2958":54693},[],"Key and certificate",{"_3475":1711,"_30304":1666,"_20976":54695,"_5":14428,"_27536":54585,"_2958":54696},[],"You have the verified pair ready to install on the device.",{"_3475":1712,"_30304":1666,"_20976":54698,"_5":14428,"_27536":54588,"_2958":54699},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3475":1713,"_30304":1666,"_20976":54701,"_5":14428,"_27536":54588,"_2958":54702},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3475":1714,"_30304":1666,"_20976":54704,"_5":14428,"_27536":54588,"_2958":54705},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3475":1715,"_30304":1666,"_20976":54707,"_5":14428,"_27536":54588,"_2958":54708},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3475":1716,"_30304":1666,"_20976":54710,"_5":14428,"_27536":54592,"_2958":54711},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3475":1717,"_30304":1666,"_20976":54713,"_5":14428,"_27536":54592,"_2958":54714},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3475":1718,"_30304":1666,"_20976":54716,"_5":14428,"_27536":54592,"_2958":54717},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3475":1719,"_30304":1719,"_5":14780,"_2958":54719,"_30657":54720,"_20976":54721,"_27536":1719},"Lamassu IoT Platform",[49412,50887],[],{"_3475":1720,"_30304":1719,"_20976":54723,"_5":14428,"_27536":1719,"_2958":54724},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3475":1721,"_30304":1719,"_5":30654,"_20976":54726,"_27536":54727,"_2958":54207},[],"/docs/pr-preview/pr-65/platform/overview#start-here",{"_3475":1722,"_30304":1719,"_5":30654,"_20976":54729,"_27536":54730,"_2958":54731},[],"/docs/pr-preview/pr-65/platform/overview#choose-your-path","Choose your path",{"_3475":1723,"_30304":1719,"_5":30654,"_20976":54733,"_27536":54734,"_2958":54735},[],"/docs/pr-preview/pr-65/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3475":1724,"_30304":1719,"_5":30654,"_20976":54737,"_27536":54738,"_2958":54739},[],"/docs/pr-preview/pr-65/platform/overview#core-capabilities","Core capabilities",{"_3475":1725,"_30304":1719,"_5":30654,"_20976":54741,"_27536":54742,"_2958":54743},[],"/docs/pr-preview/pr-65/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3475":1726,"_30304":1719,"_5":30654,"_20976":54745,"_27536":54746,"_2958":54747},[],"/docs/pr-preview/pr-65/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3475":1727,"_30304":1719,"_5":30654,"_20976":54749,"_27536":54750,"_2958":54751},[],"/docs/pr-preview/pr-65/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3475":1728,"_30304":1719,"_5":30654,"_20976":54753,"_27536":54754,"_2958":54755},[],"/docs/pr-preview/pr-65/platform/overview#automate-device-identities","Automate device identities",{"_3475":1729,"_30304":1719,"_5":30654,"_20976":54757,"_27536":54758,"_2958":54759},[],"/docs/pr-preview/pr-65/platform/overview#publish-validation-status","Publish validation status",{"_3475":1730,"_30304":1719,"_5":30654,"_20976":54761,"_27536":54762,"_2958":54763},[],"/docs/pr-preview/pr-65/platform/overview#react-to-events","React to events",{"_3475":1731,"_30304":1719,"_5":30654,"_20976":54765,"_27536":54766,"_2958":54767},[],"/docs/pr-preview/pr-65/platform/overview#operational-reference","Operational reference",{"_3475":1732,"_30304":1719,"_20976":54769,"_5":14428,"_27536":1719,"_2958":54770},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3475":1733,"_30304":1719,"_20976":54772,"_5":14428,"_27536":54727,"_2958":54773},[],"Choose the result you need:",{"_3475":1734,"_30304":1719,"_20976":54775,"_5":14428,"_27536":54727,"_2958":54776},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3475":1735,"_30304":1719,"_20976":54778,"_5":14428,"_27536":54727,"_2958":54779},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3475":1736,"_30304":1719,"_20976":54781,"_5":14428,"_27536":54727,"_2958":54782},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3475":1737,"_30304":1719,"_20976":54784,"_5":14428,"_27536":54730,"_2958":54785},[],"Section",{"_3475":1738,"_30304":1719,"_20976":54787,"_5":14428,"_27536":54730,"_2958":54788},[],"What you manage",{"_3475":1739,"_30304":1719,"_20976":54790,"_5":14428,"_27536":54730,"_2958":54791},[],"Entry point",{"_3475":1740,"_30304":1719,"_20976":54793,"_5":14428,"_27536":54730,"_2958":54794},[],"**PKI**",{"_3475":1741,"_30304":1719,"_20976":54796,"_5":14428,"_27536":54730,"_2958":54797},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3475":1742,"_30304":1719,"_20976":54799,"_5":14428,"_27536":54730,"_2958":54800},[],"PKI overview",{"_3475":1743,"_30304":1719,"_20976":54802,"_5":14428,"_27536":54730,"_2958":54803},[],"**IoT Fleets**",{"_3475":1744,"_30304":1719,"_20976":54805,"_5":14428,"_27536":54730,"_2958":54806},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3475":1745,"_30304":1719,"_20976":54808,"_5":14428,"_27536":54730,"_2958":54809},[],"IoT Fleets overview",{"_3475":1746,"_30304":1719,"_20976":54811,"_5":14428,"_27536":54730,"_2958":54812},[],"**Administration**",{"_3475":1747,"_30304":1719,"_20976":54814,"_5":14428,"_27536":54730,"_2958":54815},[],"Operator permissions, audit and event subscriptions.",{"_3475":1748,"_30304":1719,"_20976":54817,"_5":14428,"_27536":54730,"_2958":50885},[],{"_3475":1749,"_30304":1719,"_20976":54819,"_5":14428,"_27536":54730,"_2958":54820},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3475":1750,"_30304":1719,"_20976":54822,"_5":14428,"_27536":54734,"_2958":54823},[],"An identity's journey connects four responsibilities:",{"_3475":1751,"_30304":1719,"_20976":54825,"_5":14428,"_27536":54734,"_2958":54826},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3475":1752,"_30304":1719,"_20976":54828,"_5":14428,"_27536":54734,"_2958":54829},[],"The provisioning administrator configures the DMS and initial trust.",{"_3475":1753,"_30304":1719,"_20976":54831,"_5":14428,"_27536":54734,"_2958":54832},[],"The device client requests a certificate and installs it with the matching key.",{"_3475":1754,"_30304":1719,"_20976":54834,"_5":14428,"_27536":54734,"_2958":54835},[],"The consumer validates the identity and applies its access permissions.",{"_3475":1755,"_30304":1719,"_20976":54837,"_5":14428,"_27536":54734,"_2958":54838},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3475":1756,"_30304":1719,"_20976":54840,"_5":14428,"_27536":54742,"_2958":54841},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3475":1757,"_30304":1719,"_20976":54843,"_5":14428,"_27536":54746,"_2958":54844},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3475":1758,"_30304":1719,"_20976":54846,"_5":14428,"_27536":54750,"_2958":54847},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3475":1759,"_30304":1719,"_20976":54849,"_5":14428,"_27536":54754,"_2958":54850},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3475":1760,"_30304":1719,"_20976":54852,"_5":14428,"_27536":54758,"_2958":54853},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3475":1761,"_30304":1719,"_20976":54855,"_5":14428,"_27536":54762,"_2958":54856},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3475":1762,"_30304":1719,"_20976":54858,"_5":14428,"_27536":54766,"_2958":54301},[],{"_3475":1763,"_30304":1719,"_20976":54860,"_5":14428,"_27536":54766,"_2958":54861},[],"What it prepares or checks",{"_3475":1764,"_30304":1719,"_20976":54863,"_5":14428,"_27536":54766,"_2958":54304},[],{"_3475":1765,"_30304":1719,"_20976":54865,"_5":14428,"_27536":54766,"_2958":54866},[],"Key custody, CA hierarchy, profiles and validation.",{"_3475":1766,"_30304":1719,"_20976":54868,"_5":14428,"_27536":54766,"_2958":54869},[],"Fleet administrator",{"_3475":1767,"_30304":1719,"_20976":54871,"_5":14428,"_27536":54766,"_2958":54872},[],"DMS, device admission, renewal policy and inventory.",{"_3475":1768,"_30304":1719,"_20976":54874,"_5":14428,"_27536":54766,"_2958":54316},[],{"_3475":1769,"_30304":1719,"_20976":54876,"_5":14428,"_27536":54766,"_2958":54877},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3475":1770,"_30304":1719,"_20976":54879,"_5":14428,"_27536":54766,"_2958":54322},[],{"_3475":1771,"_30304":1719,"_20976":54881,"_5":14428,"_27536":54766,"_2958":54882},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3475":1772,"_30304":1719,"_20976":54884,"_5":14428,"_27536":54766,"_2958":54885},[],"Infrastructure operator",{"_3475":1773,"_30304":1719,"_20976":54887,"_5":14428,"_27536":54766,"_2958":54888},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3475":1774,"_30304":1719,"_20976":54890,"_5":14428,"_27536":54766,"_2958":54891},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3475":1775,"_30304":1775,"_5":14780,"_2958":54893,"_30657":54894,"_20976":54897,"_27536":1775},"CA hierarchy and rotation",[49412,50887,54895,54896],"PKI","Keys, authorities and certificates",[],{"_3475":1776,"_30304":1775,"_20976":54899,"_5":14428,"_27536":1775,"_2958":54900},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3475":1777,"_30304":1775,"_5":30654,"_20976":54902,"_27536":54903,"_2958":54904},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3475":1778,"_30304":1775,"_5":30654,"_20976":54906,"_27536":54907,"_2958":54908},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3475":1779,"_30304":1775,"_5":30654,"_20976":54910,"_27536":54911,"_2958":54912},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3475":1780,"_30304":1775,"_5":30654,"_20976":54914,"_27536":54915,"_2958":54916},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3475":1781,"_30304":1775,"_5":30654,"_20976":54918,"_27536":54919,"_2958":54920},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3475":1782,"_30304":1775,"_5":30654,"_20976":54922,"_27536":54923,"_2958":54924},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3475":1783,"_30304":1775,"_5":30654,"_20976":54926,"_27536":54927,"_2958":54928},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3475":1784,"_30304":1775,"_5":30654,"_20976":54930,"_27536":54931,"_2958":54932},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3475":1785,"_30304":1775,"_5":30654,"_20976":54934,"_27536":54935,"_2958":54936},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3475":1786,"_30304":1775,"_5":30654,"_20976":54938,"_27536":54939,"_2958":54940},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3475":1787,"_30304":1775,"_5":30654,"_20976":54942,"_27536":54943,"_2958":54944},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3475":1788,"_30304":1775,"_5":30654,"_20976":54946,"_27536":54947,"_2958":54948},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3475":1789,"_30304":1775,"_20976":54950,"_5":14428,"_27536":1775,"_2958":54951},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3475":1790,"_30304":1775,"_20976":54953,"_5":14428,"_27536":1775,"_2958":54954},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3475":1791,"_30304":1775,"_20976":54956,"_5":14428,"_27536":54903,"_2958":54957},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3475":1792,"_30304":1775,"_20976":54959,"_5":14428,"_27536":54903,"_2958":54960},[],"environment, such as production and preproduction;",{"_3475":1793,"_30304":1775,"_20976":54962,"_5":14428,"_27536":54903,"_2958":54963},[],"owner or operating team;",{"_3475":1794,"_30304":1775,"_20976":54965,"_5":14428,"_27536":54903,"_2958":54966},[],"device family or manufacturing process;",{"_3475":1795,"_30304":1775,"_20976":54968,"_5":14428,"_27536":54903,"_2958":54969},[],"region or regulatory requirement;",{"_3475":1796,"_30304":1775,"_20976":54971,"_5":14428,"_27536":54903,"_2958":54972},[],"cryptographic engine or key policy;",{"_3475":1797,"_30304":1775,"_20976":54974,"_5":14428,"_27536":54903,"_2958":54975},[],"maintenance window and renewal cadence.",{"_3475":1798,"_30304":1775,"_20976":54977,"_5":14428,"_27536":54903,"_2958":54978},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3475":1799,"_30304":1775,"_20976":54980,"_5":14428,"_27536":54903,"_2958":54981},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3475":1800,"_30304":1775,"_20976":54983,"_5":14428,"_27536":54907,"_2958":54984},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3475":1801,"_30304":1775,"_20976":54986,"_5":14428,"_27536":54907,"_2958":54987},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3475":1802,"_30304":1775,"_20976":54989,"_5":14428,"_27536":54907,"_2958":54990},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3475":1803,"_30304":1775,"_20976":54992,"_5":14428,"_27536":54907,"_2958":54993},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3475":1804,"_30304":1775,"_20976":54995,"_5":14428,"_27536":54911,"_2958":54996},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3475":1805,"_30304":1775,"_20976":54998,"_5":14428,"_27536":54911,"_2958":54999},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3475":1806,"_30304":1775,"_20976":55001,"_5":14428,"_27536":54911,"_2958":55002},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3475":1807,"_30304":1775,"_20976":55004,"_5":14428,"_27536":54911,"_2958":55005},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3475":1808,"_30304":1775,"_20976":55007,"_5":14428,"_27536":54919,"_2958":55008},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3475":1809,"_30304":1775,"_20976":55010,"_5":14428,"_27536":54923,"_2958":55011},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3475":1810,"_30304":1775,"_20976":55013,"_5":14428,"_27536":54927,"_2958":55014},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3475":1811,"_30304":1775,"_20976":55016,"_5":14428,"_27536":54931,"_2958":55017},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3475":1812,"_30304":1775,"_20976":55019,"_5":14428,"_27536":54935,"_2958":55020},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3475":1813,"_30304":1775,"_20976":55022,"_5":14428,"_27536":54939,"_2958":55023},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3475":1814,"_30304":1775,"_20976":55025,"_5":14428,"_27536":54943,"_2958":55026},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3475":1815,"_30304":1775,"_20976":55028,"_5":14428,"_27536":54943,"_2958":55029},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3475":1816,"_30304":1775,"_20976":55031,"_5":14428,"_27536":54943,"_2958":55032},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3475":1817,"_30304":1775,"_20976":55034,"_5":14428,"_27536":54943,"_2958":55035},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3475":1818,"_30304":1775,"_20976":55037,"_5":14428,"_27536":54947,"_2958":55038},[],"The new chain ends in an anchor installed by the consumer.",{"_3475":1819,"_30304":1775,"_20976":55040,"_5":14428,"_27536":54947,"_2958":55041},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3475":1820,"_30304":1775,"_20976":55043,"_5":14428,"_27536":54947,"_2958":55044},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3475":1821,"_30304":1775,"_20976":55046,"_5":14428,"_27536":54947,"_2958":55047},[],"Re-enrollment accepts the old identity during the planned period.",{"_3475":1822,"_30304":1775,"_20976":55049,"_5":14428,"_27536":54947,"_2958":55050},[],"OCSP and CRL respond for the authorities that remain active.",{"_3475":1823,"_30304":1775,"_20976":55052,"_5":14428,"_27536":54947,"_2958":55053},[],"No DMS is left accidentally issuing from the old CA.",{"_3475":1824,"_30304":1775,"_20976":55055,"_5":14428,"_27536":54947,"_2958":55056},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3475":1825,"_30304":1825,"_5":14780,"_2958":55058,"_30657":55059,"_20976":55060,"_27536":1825},"Certification authorities",[49412,50887,54895,54896],[],{"_3475":1826,"_30304":1825,"_20976":55062,"_5":14428,"_27536":1825,"_2958":55063},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3475":1827,"_30304":1825,"_5":30654,"_20976":55065,"_27536":55066,"_2958":55067},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3475":1828,"_30304":1825,"_5":30654,"_20976":55069,"_27536":55070,"_2958":55071},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3475":1829,"_30304":1825,"_5":30654,"_20976":55073,"_27536":55074,"_2958":49422},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#before-you-begin",{"_3475":1830,"_30304":1825,"_5":30654,"_20976":55076,"_27536":55077,"_2958":55078},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3475":1831,"_30304":1825,"_5":30654,"_20976":55080,"_27536":55081,"_2958":55082},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3475":1832,"_30304":1825,"_5":30654,"_20976":55084,"_27536":55085,"_2958":55086},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3475":1833,"_30304":1825,"_5":30654,"_20976":55088,"_27536":55089,"_2958":55090},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3475":1834,"_30304":1825,"_5":30654,"_20976":55092,"_27536":55093,"_2958":55094},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3475":1835,"_30304":1825,"_5":30654,"_20976":55096,"_27536":55097,"_2958":55098},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3475":1836,"_30304":1825,"_5":30654,"_20976":55100,"_27536":55101,"_2958":55102},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3475":1837,"_30304":1825,"_5":30654,"_20976":55104,"_27536":55105,"_2958":55106},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3475":1838,"_30304":1825,"_5":30654,"_20976":55108,"_27536":55109,"_2958":55110},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3475":1839,"_30304":1825,"_5":30654,"_20976":55112,"_27536":55113,"_2958":55114},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3475":1840,"_30304":1825,"_5":30654,"_20976":55116,"_27536":55117,"_2958":55118},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3475":1841,"_30304":1825,"_5":30654,"_20976":55120,"_27536":55121,"_2958":55122},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3475":1842,"_30304":1825,"_5":30654,"_20976":55124,"_27536":55125,"_2958":55126},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3475":1843,"_30304":1825,"_5":30654,"_20976":55128,"_27536":55129,"_2958":55130},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3475":1844,"_30304":1825,"_5":30654,"_20976":55132,"_27536":55133,"_2958":55134},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3475":1845,"_30304":1825,"_5":30654,"_20976":55136,"_27536":55137,"_2958":55138},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3475":1846,"_30304":1825,"_5":30654,"_20976":55140,"_27536":55141,"_2958":55142},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3475":1847,"_30304":1825,"_5":30654,"_20976":55144,"_27536":55145,"_2958":55146},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3475":1848,"_30304":1825,"_5":30654,"_20976":55148,"_27536":55149,"_2958":55150},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3475":1849,"_30304":1825,"_5":30654,"_20976":55152,"_27536":55153,"_2958":55154},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3475":1850,"_30304":1825,"_20976":55156,"_5":14428,"_27536":1825,"_2958":55157},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3475":1851,"_30304":1825,"_20976":55159,"_5":14428,"_27536":1825,"_2958":55160},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3475":1852,"_30304":1825,"_20976":55162,"_5":14428,"_27536":1825,"_2958":55163},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3475":1853,"_30304":1825,"_20976":55165,"_5":14428,"_27536":55066,"_2958":55166},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3475":1854,"_30304":1825,"_20976":55168,"_5":14428,"_27536":55066,"_2958":55169},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3475":1855,"_30304":1825,"_20976":55171,"_5":14428,"_27536":55066,"_2958":55172},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3475":1856,"_30304":1825,"_20976":55174,"_5":14428,"_27536":55066,"_2958":55175},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3475":1857,"_30304":1825,"_20976":55177,"_5":14428,"_27536":55066,"_2958":55178},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3475":1858,"_30304":1825,"_20976":55180,"_5":14428,"_27536":55074,"_2958":55181},[],"Decide whether the CA will be a root or an intermediate.",{"_3475":1859,"_30304":1825,"_20976":55183,"_5":14428,"_27536":55074,"_2958":55184},[],"Choose the engine that will keep the key.",{"_3475":1860,"_30304":1825,"_20976":55186,"_5":14428,"_27536":55074,"_2958":55187},[],"Define a validity longer than that of the certificates it will issue.",{"_3475":1861,"_30304":1825,"_20976":55189,"_5":14428,"_27536":55074,"_2958":55190},[],"For an intermediate CA, make sure the parent CA is active.",{"_3475":1862,"_30304":1825,"_20976":55192,"_5":14428,"_27536":55077,"_2958":55193},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3475":1863,"_30304":1825,"_20976":55195,"_5":14428,"_27536":55081,"_2958":55196},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3475":1864,"_30304":1825,"_20976":55198,"_5":14428,"_27536":55081,"_2958":55199},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3475":1865,"_30304":1825,"_20976":55201,"_5":14428,"_27536":55085,"_2958":55202},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3475":1866,"_30304":1825,"_20976":55204,"_5":14428,"_27536":55089,"_2958":55205},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3475":1867,"_30304":1825,"_20976":55207,"_5":14428,"_27536":55089,"_2958":55208},[],"`C`: two-letter ISO 3166-1 country code.",{"_3475":1868,"_30304":1825,"_20976":55210,"_5":14428,"_27536":55089,"_2958":55211},[],"`ST`: state or province.",{"_3475":1869,"_30304":1825,"_20976":55213,"_5":14428,"_27536":55089,"_2958":55214},[],"`L`: locality.",{"_3475":1870,"_30304":1825,"_20976":55216,"_5":14428,"_27536":55089,"_2958":55217},[],"`O`: organization.",{"_3475":1871,"_30304":1825,"_20976":55219,"_5":14428,"_27536":55089,"_2958":55220},[],"`OU`: organizational unit.",{"_3475":1872,"_30304":1825,"_20976":55222,"_5":14428,"_27536":55089,"_2958":55223},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3475":1873,"_30304":1825,"_20976":55225,"_5":14428,"_27536":55093,"_2958":55226},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3475":1874,"_30304":1825,"_20976":55228,"_5":14428,"_27536":55093,"_2958":55229},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3475":1875,"_30304":1825,"_20976":55231,"_5":14428,"_27536":55097,"_2958":55232},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3475":1876,"_30304":1825,"_20976":55234,"_5":14428,"_27536":55097,"_2958":55235},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3475":1877,"_30304":1825,"_20976":55237,"_5":14428,"_27536":55101,"_2958":55238},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3475":1878,"_30304":1825,"_20976":55240,"_5":14428,"_27536":55101,"_2958":55241},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3475":1879,"_30304":1825,"_20976":55243,"_5":14428,"_27536":55105,"_2958":55244},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3475":1880,"_30304":1825,"_20976":55246,"_5":14428,"_27536":55105,"_2958":55247},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3475":1881,"_30304":1825,"_20976":55249,"_5":14428,"_27536":55105,"_2958":55250},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3475":1882,"_30304":1825,"_20976":55252,"_5":14428,"_27536":55109,"_2958":55253},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3475":1883,"_30304":1825,"_20976":55255,"_5":14428,"_27536":55113,"_2958":55256},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3475":1884,"_30304":1825,"_20976":55258,"_5":14428,"_27536":55113,"_2958":55259},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3475":1885,"_30304":1825,"_20976":55261,"_5":14428,"_27536":55117,"_2958":55262},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3475":1886,"_30304":1825,"_20976":55264,"_5":14428,"_27536":55121,"_2958":55265},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3475":1887,"_30304":1825,"_20976":55267,"_5":14428,"_27536":55121,"_2958":55268},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3475":1888,"_30304":1825,"_20976":55270,"_5":14428,"_27536":55125,"_2958":55271},[],"Open a CA from the inventory to review:",{"_3475":1889,"_30304":1825,"_20976":55273,"_5":14428,"_27536":55125,"_2958":55274},[],"Status and validity period.",{"_3475":1890,"_30304":1825,"_20976":55276,"_5":14428,"_27536":55125,"_2958":55277},[],"Certificate and chain in PEM format.",{"_3475":1891,"_30304":1825,"_20976":55279,"_5":14428,"_27536":55125,"_2958":55280},[],"Number of active, expired and revoked certificates.",{"_3475":1892,"_30304":1825,"_20976":55282,"_5":14428,"_27536":55125,"_2958":55283},[],"Certificates issued in **Issued Certificates**.",{"_3475":1893,"_30304":1825,"_20976":55285,"_5":14428,"_27536":55125,"_2958":55286},[],"The CRL linked to the authority.",{"_3475":1894,"_30304":1825,"_20976":55288,"_5":14428,"_27536":55125,"_2958":55289},[],"Metadata and the associated cryptographic engine.",{"_3475":1895,"_30304":1825,"_20976":55291,"_5":14428,"_27536":55125,"_2958":55292},[],"You can filter the inventory by name, status and CA type.",{"_3475":1896,"_30304":1825,"_20976":55294,"_5":14428,"_27536":55129,"_2958":55295},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3475":1897,"_30304":1825,"_20976":55297,"_5":14428,"_27536":55129,"_2958":55298},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3475":1898,"_30304":1825,"_20976":55300,"_5":14428,"_27536":55129,"_2958":55301},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3475":1899,"_30304":1825,"_20976":55303,"_5":14428,"_27536":55129,"_2958":55304},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3475":1900,"_30304":1825,"_20976":55306,"_5":14428,"_27536":55133,"_2958":55307},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3475":1901,"_30304":1825,"_20976":55309,"_5":14428,"_27536":55137,"_2958":55310},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3475":1902,"_30304":1825,"_20976":55312,"_5":14428,"_27536":55141,"_2958":55313},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3475":1903,"_30304":1825,"_20976":55315,"_5":14428,"_27536":55145,"_2958":55316},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3475":1904,"_30304":1825,"_20976":55318,"_5":14428,"_27536":55149,"_2958":55319},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3475":1905,"_30304":1825,"_20976":55321,"_5":14428,"_27536":55153,"_2958":55322},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3475":1906,"_30304":1825,"_20976":55324,"_5":14428,"_27536":55153,"_2958":55325},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3475":1907,"_30304":1825,"_20976":55327,"_5":14428,"_27536":55153,"_2958":55328},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3475":1908,"_30304":1825,"_20976":55330,"_5":14428,"_27536":55153,"_2958":55331},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3475":1909,"_30304":1909,"_5":14780,"_2958":55333,"_30657":55334,"_20976":55335,"_27536":1909},"Certificate profiles",[49412,50887,54895,54896],[],{"_3475":1910,"_30304":1909,"_20976":55337,"_5":14428,"_27536":1909,"_2958":55338},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3475":1911,"_30304":1909,"_5":30654,"_20976":55340,"_27536":55341,"_2958":55342},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3475":1912,"_30304":1909,"_5":30654,"_20976":55344,"_27536":55345,"_2958":55346},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#validity","Validity",{"_3475":1913,"_30304":1909,"_5":30654,"_20976":55348,"_27536":55349,"_2958":55350},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3475":1914,"_30304":1909,"_5":30654,"_20976":55352,"_27536":55353,"_2958":55354},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3475":1915,"_30304":1909,"_5":30654,"_20976":55356,"_27536":55357,"_2958":55358},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#subject","Subject",{"_3475":1916,"_30304":1909,"_5":30654,"_20976":55360,"_27536":55361,"_2958":55362},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3475":1917,"_30304":1909,"_5":30654,"_20976":55364,"_27536":55365,"_2958":55366},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3475":1918,"_30304":1909,"_5":30654,"_20976":55368,"_27536":55369,"_2958":55370},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3475":1919,"_30304":1909,"_5":30654,"_20976":55372,"_27536":55373,"_2958":55374},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3475":1920,"_30304":1909,"_5":30654,"_20976":55376,"_27536":55377,"_2958":55378},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3475":1921,"_30304":1909,"_5":30654,"_20976":55380,"_27536":55381,"_2958":55382},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3475":1922,"_30304":1909,"_5":30654,"_20976":55384,"_27536":55385,"_2958":55386},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3475":1923,"_30304":1909,"_5":30654,"_20976":55388,"_27536":55389,"_2958":55390},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3475":1924,"_30304":1909,"_5":30654,"_20976":55392,"_27536":55393,"_2958":55394},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3475":1925,"_30304":1909,"_5":30654,"_20976":55396,"_27536":55397,"_2958":55398},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#design-examples","Design examples",{"_3475":1926,"_30304":1909,"_5":30654,"_20976":55400,"_27536":55401,"_2958":55402},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3475":1927,"_30304":1909,"_20976":55404,"_5":14428,"_27536":1909,"_2958":55405},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3475":1928,"_30304":1909,"_20976":55407,"_5":14428,"_27536":1909,"_2958":55408},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3475":1929,"_30304":1909,"_20976":55410,"_5":14428,"_27536":55345,"_2958":55411},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3475":1930,"_30304":1909,"_20976":55413,"_5":14428,"_27536":55345,"_2958":55414},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3475":1931,"_30304":1909,"_20976":55416,"_5":14428,"_27536":55349,"_2958":55417},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3475":1932,"_30304":1909,"_20976":55419,"_5":14428,"_27536":55353,"_2958":55420},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3475":1933,"_30304":1909,"_20976":55422,"_5":14428,"_27536":55353,"_2958":55423},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3475":1934,"_30304":1909,"_20976":55425,"_5":14428,"_27536":55353,"_2958":55426},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3475":1935,"_30304":1909,"_20976":55428,"_5":14428,"_27536":55357,"_2958":55429},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3475":1936,"_30304":1909,"_20976":55431,"_5":14428,"_27536":55361,"_2958":55432},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3475":1937,"_30304":1909,"_20976":55434,"_5":14428,"_27536":55361,"_2958":55435},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3475":1938,"_30304":1909,"_20976":55437,"_5":14428,"_27536":55365,"_2958":55438},[],"The cryptographic enforcement can:",{"_3475":1939,"_30304":1909,"_20976":55440,"_5":14428,"_27536":55365,"_2958":55441},[],"allow or block RSA keys;",{"_3475":1940,"_30304":1909,"_20976":55443,"_5":14428,"_27536":55365,"_2958":55444},[],"limit the supported RSA sizes;",{"_3475":1941,"_30304":1909,"_20976":55446,"_5":14428,"_27536":55365,"_2958":55447},[],"allow or block ECDSA keys;",{"_3475":1942,"_30304":1909,"_20976":55449,"_5":14428,"_27536":55365,"_2958":55450},[],"limit the supported ECDSA sizes or curves.",{"_3475":1943,"_30304":1909,"_20976":55452,"_5":14428,"_27536":55365,"_2958":55453},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3475":1944,"_30304":1909,"_20976":55455,"_5":14428,"_27536":55369,"_2958":55456},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3475":1945,"_30304":1909,"_20976":55458,"_5":14428,"_27536":55369,"_2958":52657},[],{"_3475":1946,"_30304":1909,"_20976":55460,"_5":14428,"_27536":55369,"_2958":55461},[],"First choice",{"_3475":1947,"_30304":1909,"_20976":55463,"_5":14428,"_27536":55369,"_2958":55464},[],"Second choice",{"_3475":1948,"_30304":1909,"_20976":55466,"_5":14428,"_27536":55369,"_2958":55467},[],"If neither is supplied",{"_3475":1949,"_30304":1909,"_20976":55469,"_5":14428,"_27536":55369,"_2958":55470},[],"Direct signing with a CA",{"_3475":1950,"_30304":1909,"_20976":55472,"_5":14428,"_27536":55369,"_2958":55473},[],"`issuance_profile` embedded in the request",{"_3475":1951,"_30304":1909,"_20976":55475,"_5":14428,"_27536":55369,"_2958":55476},[],"Request `issuance_profile_id`",{"_3475":1952,"_30304":1909,"_20976":55478,"_5":14428,"_27536":55369,"_2958":55479},[],"CA default profile (`profile_id`).",{"_3475":1953,"_30304":1909,"_20976":55481,"_5":14428,"_27536":55369,"_2958":55482},[],"Issuance through a DMS",{"_3475":1954,"_30304":1909,"_20976":55484,"_5":14428,"_27536":55369,"_2958":55485},[],"`settings.issuance_profile_id`",{"_3475":1955,"_30304":1909,"_20976":55487,"_5":14428,"_27536":55369,"_2958":55488},[],"`settings.issuance_profile` embedded in the DMS",{"_3475":1956,"_30304":1909,"_20976":55490,"_5":14428,"_27536":55369,"_2958":55491},[],"Enrollment CA default profile.",{"_3475":1957,"_30304":1909,"_20976":55493,"_5":14428,"_27536":55369,"_2958":55494},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3475":1958,"_30304":1909,"_20976":55496,"_5":14428,"_27536":55369,"_2958":55497},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3475":1959,"_30304":1909,"_20976":55499,"_5":14428,"_27536":55377,"_2958":55500},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3475":1960,"_30304":1909,"_20976":55502,"_5":14428,"_27536":55381,"_2958":55503},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3475":1961,"_30304":1909,"_20976":55505,"_5":14428,"_27536":55385,"_2958":55506},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3475":1962,"_30304":1909,"_20976":55508,"_5":14428,"_27536":55389,"_2958":55509},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3475":1963,"_30304":1909,"_20976":55511,"_5":14428,"_27536":55393,"_2958":55512},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3475":1964,"_30304":1909,"_20976":55514,"_5":14428,"_27536":55393,"_2958":55515},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3475":1965,"_30304":1909,"_20976":55517,"_5":14428,"_27536":55397,"_2958":55518},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3475":1966,"_30304":1909,"_20976":55520,"_5":14428,"_27536":55397,"_2958":55521},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3475":1967,"_30304":1909,"_20976":55523,"_5":14428,"_27536":55397,"_2958":55524},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3475":1968,"_30304":1909,"_20976":55526,"_5":14428,"_27536":55397,"_2958":55527},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3475":1969,"_30304":1909,"_20976":55529,"_5":14428,"_27536":55401,"_2958":55530},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3475":1970,"_30304":1909,"_20976":55532,"_5":14428,"_27536":55401,"_2958":55533},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3475":1971,"_30304":1971,"_5":14780,"_2958":55535,"_30657":55536,"_20976":55538,"_27536":1971},"Certificate validation",[49412,50887,54895,55537],"Validation",[],{"_3475":1972,"_30304":1971,"_20976":55540,"_5":14428,"_27536":1971,"_2958":55541},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3475":1973,"_30304":1971,"_5":30654,"_20976":55543,"_27536":55544,"_2958":55545},[],"/docs/pr-preview/pr-65/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3475":1974,"_30304":1971,"_5":30654,"_20976":55547,"_27536":55548,"_2958":55549},[],"/docs/pr-preview/pr-65/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3475":1975,"_30304":1971,"_5":30654,"_20976":55551,"_27536":55552,"_2958":55553},[],"/docs/pr-preview/pr-65/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3475":1976,"_30304":1971,"_20976":55555,"_5":14428,"_27536":1971,"_2958":55556},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3475":1977,"_30304":1971,"_20976":55558,"_5":14428,"_27536":55544,"_2958":55559},[],"Verify these criteria together:",{"_3475":1978,"_30304":1971,"_20976":55561,"_5":14428,"_27536":55544,"_2958":54521},[],{"_3475":1979,"_30304":1971,"_20976":55563,"_5":14428,"_27536":55544,"_2958":55564},[],"Required result",{"_3475":1980,"_30304":1971,"_20976":55566,"_5":14428,"_27536":55544,"_2958":55567},[],"Chain and signature",{"_3475":1981,"_30304":1971,"_20976":55569,"_5":14428,"_27536":55544,"_2958":55570},[],"Valid chain to a root deliberately installed in the consumer.",{"_3475":1982,"_30304":1971,"_20976":55572,"_5":14428,"_27536":55544,"_2958":55573},[],"Dates",{"_3475":1983,"_30304":1971,"_20976":55575,"_5":14428,"_27536":55544,"_2958":55576},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3475":1984,"_30304":1971,"_20976":55578,"_5":14428,"_27536":55544,"_2958":50556},[],{"_3475":1985,"_30304":1971,"_20976":55580,"_5":14428,"_27536":55544,"_2958":55581},[],"Name, SAN or identifier matches the expected peer.",{"_3475":1986,"_30304":1971,"_20976":55583,"_5":14428,"_27536":55544,"_2958":49802},[],{"_3475":1987,"_30304":1971,"_20976":55585,"_5":14428,"_27536":55544,"_2958":55586},[],"KU, EKU and constraints permit the specific operation.",{"_3475":1988,"_30304":1971,"_20976":55588,"_5":14428,"_27536":55544,"_2958":55589},[],"Revocation",{"_3475":1989,"_30304":1971,"_20976":55591,"_5":14428,"_27536":55544,"_2958":55592},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3475":1990,"_30304":1971,"_20976":55594,"_5":14428,"_27536":55544,"_2958":55595},[],"Authorization",{"_3475":1991,"_30304":1971,"_20976":55597,"_5":14428,"_27536":55544,"_2958":55598},[],"The application permits that identity to perform the action.",{"_3475":1992,"_30304":1971,"_20976":55600,"_5":14428,"_27536":55544,"_2958":55601},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3475":1993,"_30304":1971,"_20976":55603,"_5":14428,"_27536":55548,"_2958":55604},[],"Mechanism",{"_3475":1994,"_30304":1971,"_20976":55606,"_5":14428,"_27536":55548,"_2958":55607},[],"When to use it",{"_3475":1995,"_30304":1971,"_20976":55609,"_5":14428,"_27536":55548,"_2958":55610},[],"What you must maintain",{"_3475":1996,"_30304":1971,"_20976":55612,"_5":14428,"_27536":55548,"_2958":55613},[],"OCSP",{"_3475":1997,"_30304":1971,"_20976":55615,"_5":14428,"_27536":55548,"_2958":55616},[],"Status query for a specific certificate.",{"_3475":1998,"_30304":1971,"_20976":55618,"_5":14428,"_27536":55548,"_2958":55619},[],"Responder access, signature verification and cache/freshness policy.",{"_3475":1999,"_30304":1971,"_20976":55621,"_5":14428,"_27536":55548,"_2958":55622},[],"CRL",{"_3475":2000,"_30304":1971,"_20976":55624,"_5":14428,"_27536":55548,"_2958":55625},[],"Local checks for many certificates or offline operation.",{"_3475":2001,"_30304":1971,"_20976":55627,"_5":14428,"_27536":55548,"_2958":55628},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3475":2002,"_30304":1971,"_20976":55630,"_5":14428,"_27536":55548,"_2958":55631},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3475":2003,"_30304":1971,"_20976":55633,"_5":14428,"_27536":55548,"_2958":55634},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3475":2004,"_30304":1971,"_20976":55636,"_5":14428,"_27536":55552,"_2958":55637},[],"Accept a current, authorized certificate with a known chain.",{"_3475":2005,"_30304":1971,"_20976":55639,"_5":14428,"_27536":55552,"_2958":55640},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3475":2006,"_30304":1971,"_20976":55642,"_5":14428,"_27536":55552,"_2958":55643},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3475":2007,"_30304":1971,"_20976":55645,"_5":14428,"_27536":55552,"_2958":55646},[],"Check that a new connection with that identity is rejected.",{"_3475":2008,"_30304":1971,"_20976":55648,"_5":14428,"_27536":55552,"_2958":55649},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3475":2009,"_30304":1971,"_20976":55651,"_5":14428,"_27536":55552,"_2958":55652},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3475":2010,"_30304":1971,"_20976":55654,"_5":14428,"_27536":55552,"_2958":55655},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3475":2011,"_30304":1971,"_20976":55657,"_5":14428,"_27536":55552,"_2958":55658},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":2012,"_30304":1971,"_20976":55660,"_5":14428,"_27536":55552,"_2958":55661},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3475":2013,"_30304":2013,"_5":14780,"_2958":55663,"_30657":55664,"_20976":55665,"_27536":2013},"Certificates",[49412,50887,54895,54896],[],{"_3475":2014,"_30304":2013,"_20976":55667,"_5":14428,"_27536":2013,"_2958":55668},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3475":2015,"_30304":2013,"_5":30654,"_20976":55670,"_27536":55671,"_2958":55672},[],"/docs/pr-preview/pr-65/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3475":2016,"_30304":2013,"_5":30654,"_20976":55674,"_27536":55675,"_2958":55676},[],"/docs/pr-preview/pr-65/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3475":2017,"_30304":2013,"_5":30654,"_20976":55678,"_27536":55679,"_2958":55680},[],"/docs/pr-preview/pr-65/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3475":2018,"_30304":2013,"_5":30654,"_20976":55682,"_27536":55683,"_2958":55684},[],"/docs/pr-preview/pr-65/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3475":2019,"_30304":2013,"_5":30654,"_20976":55686,"_27536":55687,"_2958":55688},[],"/docs/pr-preview/pr-65/platform/pki/certificates#open-the-action","Open the action",{"_3475":2020,"_30304":2013,"_5":30654,"_20976":55690,"_27536":55691,"_2958":55692},[],"/docs/pr-preview/pr-65/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3475":2021,"_30304":2013,"_5":30654,"_20976":55694,"_27536":55695,"_2958":55696},[],"/docs/pr-preview/pr-65/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3475":2022,"_30304":2013,"_5":30654,"_20976":55698,"_27536":55699,"_2958":55700},[],"/docs/pr-preview/pr-65/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3475":2023,"_30304":2013,"_5":30654,"_20976":55702,"_27536":55703,"_2958":55704},[],"/docs/pr-preview/pr-65/platform/pki/certificates#continue","Continue",{"_3475":2024,"_30304":2013,"_20976":55706,"_5":14428,"_27536":2013,"_2958":55707},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3475":2025,"_30304":2013,"_20976":55709,"_5":14428,"_27536":55671,"_2958":55710},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3475":2026,"_30304":2013,"_20976":55712,"_5":14428,"_27536":55671,"_2958":55713},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3475":2027,"_30304":2013,"_20976":55715,"_5":14428,"_27536":55671,"_2958":55716},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3475":2028,"_30304":2013,"_20976":55718,"_5":14428,"_27536":55671,"_2958":55719},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3475":2029,"_30304":2013,"_20976":55721,"_5":14428,"_27536":55671,"_2958":55722},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3475":2030,"_30304":2013,"_20976":55724,"_5":14428,"_27536":55671,"_2958":55725},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3475":2031,"_30304":2013,"_20976":55727,"_5":14428,"_27536":55671,"_2958":55728},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3475":2032,"_30304":2013,"_20976":55730,"_5":14428,"_27536":55675,"_2958":55731},[],"Download the PEM and inspect it:",{"_3475":2033,"_30304":2013,"_20976":55733,"_5":14428,"_27536":55675,"_2958":55734},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3475":2034,"_30304":2013,"_20976":55736,"_5":14428,"_27536":55679,"_2958":55737},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3475":2035,"_30304":2013,"_20976":55739,"_5":14428,"_27536":55679,"_2958":55740},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3475":2036,"_30304":2013,"_20976":55742,"_5":14428,"_27536":55679,"_2958":55743},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3475":2037,"_30304":2013,"_20976":55745,"_5":14428,"_27536":55679,"_2958":55746},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3475":2038,"_30304":2013,"_20976":55748,"_5":14428,"_27536":55679,"_2958":55749},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3475":2039,"_30304":2013,"_20976":55751,"_5":14428,"_27536":55679,"_2958":55752},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3475":2040,"_30304":2013,"_20976":55754,"_5":14428,"_27536":55679,"_2958":55755},[],"For browser key generation, follow Issue your first certificate.",{"_3475":2041,"_30304":2013,"_20976":55757,"_5":14428,"_27536":55683,"_2958":55758},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3475":2042,"_30304":2013,"_20976":55760,"_5":14428,"_27536":55687,"_2958":55761},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3475":2043,"_30304":2013,"_20976":55763,"_5":14428,"_27536":55691,"_2958":55764},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3475":2044,"_30304":2013,"_20976":55766,"_5":14428,"_27536":55695,"_2958":55767},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3475":2045,"_30304":2013,"_20976":55769,"_5":14428,"_27536":55695,"_2958":55770},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3475":2046,"_30304":2013,"_20976":55772,"_5":14428,"_27536":55695,"_2958":55773},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3475":2047,"_30304":2013,"_20976":55775,"_5":14428,"_27536":55699,"_2958":55776},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3475":2048,"_30304":2013,"_20976":55778,"_5":14428,"_27536":55699,"_2958":55779},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3475":2049,"_30304":2013,"_20976":55781,"_5":14428,"_27536":55699,"_2958":55782},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3475":2050,"_30304":2013,"_20976":55784,"_5":14428,"_27536":55703,"_2958":55785},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":2051,"_30304":2013,"_20976":55787,"_5":14428,"_27536":55703,"_2958":55788},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3475":2052,"_30304":2052,"_5":14780,"_2958":55790,"_30657":55791,"_20976":55793,"_27536":2052},"Certificate lifecycle",[49412,50887,54895,55792],"Concepts",[],{"_3475":2053,"_30304":2052,"_20976":55795,"_5":14428,"_27536":2052,"_2958":55796},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3475":2054,"_30304":2052,"_5":30654,"_20976":55798,"_27536":55799,"_2958":55800},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3475":2055,"_30304":2052,"_5":30654,"_20976":55802,"_27536":55803,"_2958":55804},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3475":2056,"_30304":2052,"_5":30654,"_20976":55806,"_27536":55807,"_2958":55808},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3475":2057,"_30304":2052,"_5":30654,"_20976":55810,"_27536":55811,"_2958":55812},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3475":2058,"_30304":2052,"_5":30654,"_20976":55814,"_27536":55815,"_2958":55816},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3475":2059,"_30304":2052,"_5":30654,"_20976":55818,"_27536":55819,"_2958":55820},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3475":2060,"_30304":2052,"_5":30654,"_20976":55822,"_27536":55823,"_2958":55824},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3475":2061,"_30304":2052,"_5":30654,"_20976":55826,"_27536":55827,"_2958":55828},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3475":2062,"_30304":2052,"_5":30654,"_20976":55830,"_27536":55831,"_2958":55832},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3475":2063,"_30304":2052,"_5":30654,"_20976":55834,"_27536":55835,"_2958":55836},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3475":2064,"_30304":2052,"_20976":55838,"_5":14428,"_27536":2052,"_2958":55839},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3475":2065,"_30304":2052,"_20976":55841,"_5":14428,"_27536":55803,"_2958":55842},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3475":2066,"_30304":2052,"_20976":55844,"_5":14428,"_27536":55807,"_2958":55845},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3475":2067,"_30304":2052,"_20976":55847,"_5":14428,"_27536":55811,"_2958":55848},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3475":2068,"_30304":2052,"_20976":55850,"_5":14428,"_27536":55815,"_2958":55851},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3475":2069,"_30304":2052,"_20976":55853,"_5":14428,"_27536":55819,"_2958":55854},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3475":2070,"_30304":2052,"_20976":55856,"_5":14428,"_27536":55823,"_2958":55857},[],"Lamassu persists four X.509 states:",{"_3475":2071,"_30304":2052,"_20976":55859,"_5":14428,"_27536":55823,"_2958":55860},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3475":2072,"_30304":2052,"_20976":55862,"_5":14428,"_27536":55823,"_2958":55863},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3475":2073,"_30304":2052,"_20976":55865,"_5":14428,"_27536":55823,"_2958":55866},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3475":2074,"_30304":2052,"_20976":55868,"_5":14428,"_27536":55823,"_2958":55869},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3475":2075,"_30304":2052,"_20976":55871,"_5":14428,"_27536":55823,"_2958":55872},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3475":2076,"_30304":2052,"_20976":55874,"_5":14428,"_27536":55827,"_2958":55875},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3475":2077,"_30304":2052,"_20976":55877,"_5":14428,"_27536":55827,"_2958":55878},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3475":2078,"_30304":2052,"_20976":55880,"_5":14428,"_27536":55827,"_2958":55881},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3475":2079,"_30304":2052,"_20976":55883,"_5":14428,"_27536":55831,"_2958":55884},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3475":2080,"_30304":2052,"_20976":55886,"_5":14428,"_27536":55831,"_2958":55887},[],"Before confirming:",{"_3475":2081,"_30304":2052,"_20976":55889,"_5":14428,"_27536":55831,"_2958":55890},[],"Identify DMSs, devices and services that trust that chain.",{"_3475":2082,"_30304":2052,"_20976":55892,"_5":14428,"_27536":55831,"_2958":55893},[],"Distribute the new chain of trust.",{"_3475":2083,"_30304":2052,"_20976":55895,"_5":14428,"_27536":55831,"_2958":55896},[],"Reissue the necessary identities.",{"_3475":2084,"_30304":2052,"_20976":55898,"_5":14428,"_27536":55831,"_2958":55899},[],"Check OCSP and CRL from a real consumer.",{"_3475":2085,"_30304":2052,"_20976":55901,"_5":14428,"_27536":55831,"_2958":55902},[],"Revoke the old CA once no legitimate traffic remains.",{"_3475":2086,"_30304":2052,"_20976":55904,"_5":14428,"_27536":55831,"_2958":55905},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3475":2087,"_30304":2052,"_20976":55907,"_5":14428,"_27536":55835,"_2958":55908},[],"Certificates entering the preventive or critical renewal window.",{"_3475":2088,"_30304":2052,"_20976":55910,"_5":14428,"_27536":55835,"_2958":55911},[],"Repeated enrollment or re-enrollment failures.",{"_3475":2089,"_30304":2052,"_20976":55913,"_5":14428,"_27536":55835,"_2958":55914},[],"Status changes and revocation reasons.",{"_3475":2090,"_30304":2052,"_20976":55916,"_5":14428,"_27536":55835,"_2958":55917},[],"OCSP and CRL publication and validity.",{"_3475":2091,"_30304":2052,"_20976":55919,"_5":14428,"_27536":55835,"_2958":55920},[],"Dependencies still presenting a replaced certificate.",{"_3475":2092,"_30304":2052,"_20976":55922,"_5":14428,"_27536":55835,"_2958":55923},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3475":2093,"_30304":2093,"_5":14780,"_2958":55925,"_30657":55926,"_20976":55927,"_27536":2093},"Trust model",[49412,50887,54895,55792],[],{"_3475":2094,"_30304":2093,"_20976":55929,"_5":14428,"_27536":2093,"_2958":55930},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3475":2095,"_30304":2093,"_5":30654,"_20976":55932,"_27536":55933,"_2958":55934},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3475":2096,"_30304":2093,"_5":30654,"_20976":55936,"_27536":55937,"_2958":55938},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3475":2097,"_30304":2093,"_5":30654,"_20976":55940,"_27536":55941,"_2958":55942},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3475":2098,"_30304":2093,"_5":30654,"_20976":55944,"_27536":55945,"_2958":55946},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3475":2099,"_30304":2093,"_5":30654,"_20976":55948,"_27536":55949,"_2958":55950},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3475":2100,"_30304":2093,"_5":30654,"_20976":55952,"_27536":55953,"_2958":55954},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3475":2101,"_30304":2093,"_5":30654,"_20976":55956,"_27536":55957,"_2958":55958},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3475":2102,"_30304":2093,"_5":30654,"_20976":55960,"_27536":55961,"_2958":55962},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3475":2103,"_30304":2093,"_5":30654,"_20976":55964,"_27536":55965,"_2958":55966},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3475":2104,"_30304":2093,"_5":30654,"_20976":55968,"_27536":55969,"_2958":55970},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3475":2105,"_30304":2093,"_20976":55972,"_5":14428,"_27536":2093,"_2958":55973},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3475":2106,"_30304":2093,"_20976":55975,"_5":14428,"_27536":55937,"_2958":55976},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3475":2107,"_30304":2093,"_20976":55978,"_5":14428,"_27536":55941,"_2958":55979},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3475":2108,"_30304":2093,"_20976":55981,"_5":14428,"_27536":55945,"_2958":55982},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3475":2109,"_30304":2093,"_20976":55984,"_5":14428,"_27536":55949,"_2958":55985},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3475":2110,"_30304":2093,"_20976":55987,"_5":14428,"_27536":55953,"_2958":55988},[],"The device proves it can enroll according to the DMS policy.",{"_3475":2111,"_30304":2093,"_20976":55990,"_5":14428,"_27536":55953,"_2958":55991},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3475":2112,"_30304":2093,"_20976":55993,"_5":14428,"_27536":55953,"_2958":55994},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3475":2113,"_30304":2093,"_20976":55996,"_5":14428,"_27536":55953,"_2958":55997},[],"The device installs the certificate and the chain it needs.",{"_3475":2114,"_30304":2093,"_20976":55999,"_5":14428,"_27536":55953,"_2958":56000},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3475":2115,"_30304":2093,"_20976":56002,"_5":14428,"_27536":55953,"_2958":56003},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3475":2116,"_30304":2093,"_20976":56005,"_5":14428,"_27536":55957,"_2958":56006},[],"A DMS relates three sets that are worth designing separately:",{"_3475":2117,"_30304":2093,"_20976":56008,"_5":14428,"_27536":55957,"_2958":56009},[],"**Enrollment CA:** signs the new identities.",{"_3475":2118,"_30304":2093,"_20976":56011,"_5":14428,"_27536":55957,"_2958":56012},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3475":2119,"_30304":2093,"_20976":56014,"_5":14428,"_27536":55957,"_2958":56015},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3475":2120,"_30304":2093,"_20976":56017,"_5":14428,"_27536":55957,"_2958":56018},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3475":2121,"_30304":2093,"_20976":56020,"_5":14428,"_27536":55961,"_2958":56021},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3475":2122,"_30304":2093,"_20976":56023,"_5":14428,"_27536":55961,"_2958":56024},[],"that the current date is between `Not Before` and `Not After`;",{"_3475":2123,"_30304":2093,"_20976":56026,"_5":14428,"_27536":55961,"_2958":56027},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3475":2124,"_30304":2093,"_20976":56029,"_5":14428,"_27536":55961,"_2958":56030},[],"that names, SANs and subject match the expected identity;",{"_3475":2125,"_30304":2093,"_20976":56032,"_5":14428,"_27536":55961,"_2958":56033},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3475":2126,"_30304":2093,"_20976":56035,"_5":14428,"_27536":55961,"_2958":56036},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3475":2127,"_30304":2093,"_20976":56038,"_5":14428,"_27536":55961,"_2958":56039},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3475":2128,"_30304":2093,"_20976":56041,"_5":14428,"_27536":55965,"_2958":56042},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3475":2129,"_30304":2093,"_20976":56044,"_5":14428,"_27536":55969,"_2958":56045},[],"Keep the root out of daily operations, or with very restricted access.",{"_3475":2130,"_30304":2093,"_20976":56047,"_5":14428,"_27536":55969,"_2958":56048},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3475":2131,"_30304":2093,"_20976":56050,"_5":14428,"_27536":55969,"_2958":56051},[],"Assign explicit profiles to every use case.",{"_3475":2132,"_30304":2093,"_20976":56053,"_5":14428,"_27536":55969,"_2958":56054},[],"Distribute the new trust before starting a rotation.",{"_3475":2133,"_30304":2093,"_20976":56056,"_5":14428,"_27536":55969,"_2958":56057},[],"Keep enough overlap to renew a disconnected fleet.",{"_3475":2134,"_30304":2093,"_20976":56059,"_5":14428,"_27536":55969,"_2958":56060},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3475":2135,"_30304":2093,"_20976":56062,"_5":14428,"_27536":55969,"_2958":56063},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3475":2136,"_30304":2136,"_5":14780,"_2958":56065,"_30657":56066,"_20976":56067,"_27536":2136},"Revocation lists (CRL)",[49412,50887,54895,55537],[],{"_3475":2137,"_30304":2136,"_20976":56069,"_5":14428,"_27536":2136,"_2958":56070},[],"Generate and distribute signed lists to validate certificates offline.",{"_3475":2138,"_30304":2136,"_5":30654,"_20976":56072,"_27536":56073,"_2958":56074},[],"/docs/pr-preview/pr-65/platform/pki/crl#crl-settings","CRL settings",{"_3475":2139,"_30304":2136,"_5":30654,"_20976":56076,"_27536":56077,"_2958":56078},[],"/docs/pr-preview/pr-65/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3475":2140,"_30304":2136,"_5":30654,"_20976":56080,"_27536":56081,"_2958":56082},[],"/docs/pr-preview/pr-65/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3475":2141,"_30304":2136,"_5":30654,"_20976":56084,"_27536":56085,"_2958":56086},[],"/docs/pr-preview/pr-65/platform/pki/crl#crl-contents","CRL contents",{"_3475":2142,"_30304":2136,"_5":30654,"_20976":56088,"_27536":56089,"_2958":56090},[],"/docs/pr-preview/pr-65/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3475":2143,"_30304":2136,"_5":30654,"_20976":56092,"_27536":56093,"_2958":56094},[],"/docs/pr-preview/pr-65/platform/pki/crl#crl-settings-api","CRL settings API",{"_3475":2144,"_30304":2136,"_5":30654,"_20976":56096,"_27536":56097,"_2958":56098},[],"/docs/pr-preview/pr-65/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3475":2145,"_30304":2136,"_5":30654,"_20976":56100,"_27536":56101,"_2958":56102},[],"/docs/pr-preview/pr-65/platform/pki/crl#references","References",{"_3475":2146,"_30304":2136,"_20976":56104,"_5":14428,"_27536":2136,"_2958":56105},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3475":2147,"_30304":2136,"_20976":56107,"_5":14428,"_27536":56073,"_2958":56108},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3475":2148,"_30304":2136,"_20976":56110,"_5":14428,"_27536":56073,"_2958":56111},[],"Field",{"_3475":2149,"_30304":2136,"_20976":56113,"_5":14428,"_27536":56073,"_2958":49802},[],{"_3475":2150,"_30304":2136,"_20976":56115,"_5":14428,"_27536":56073,"_2958":56116},[],"`ca_id`",{"_3475":2151,"_30304":2136,"_20976":56118,"_5":14428,"_27536":56073,"_2958":56119},[],"ID of the CA the settings belong to.",{"_3475":2152,"_30304":2136,"_20976":56121,"_5":14428,"_27536":56073,"_2958":56122},[],"`status`",{"_3475":2153,"_30304":2136,"_20976":56124,"_5":14428,"_27536":56073,"_2958":56125},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3475":2154,"_30304":2136,"_20976":56127,"_5":14428,"_27536":56073,"_2958":56128},[],"`legacy_ski`",{"_3475":2155,"_30304":2136,"_20976":56130,"_5":14428,"_27536":56073,"_2958":56131},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3475":2156,"_30304":2136,"_20976":56133,"_5":14428,"_27536":56073,"_2958":56134},[],"`latest_crl`",{"_3475":2157,"_30304":2136,"_20976":56136,"_5":14428,"_27536":56073,"_2958":56137},[],"Version, validity start and end of the last published list. Read-only.",{"_3475":2158,"_30304":2136,"_20976":56139,"_5":14428,"_27536":56073,"_2958":56140},[],"`crl_options` field",{"_3475":2159,"_30304":2136,"_20976":56142,"_5":14428,"_27536":56073,"_2958":49802},[],{"_3475":2160,"_30304":2136,"_20976":56144,"_5":14428,"_27536":56073,"_2958":56145},[],"Initial value",{"_3475":2161,"_30304":2136,"_20976":56147,"_5":14428,"_27536":56073,"_2958":56148},[],"`validity`",{"_3475":2162,"_30304":2136,"_20976":56150,"_5":14428,"_27536":56073,"_2958":56151},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3475":2163,"_30304":2136,"_20976":56153,"_5":14428,"_27536":56073,"_2958":56154},[],"7 days.",{"_3475":2164,"_30304":2136,"_20976":56156,"_5":14428,"_27536":56073,"_2958":56157},[],"`refresh_interval`",{"_3475":2165,"_30304":2136,"_20976":56159,"_5":14428,"_27536":56073,"_2958":56160},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3475":2166,"_30304":2136,"_20976":56162,"_5":14428,"_27536":56073,"_2958":56163},[],"6 days and 23 hours.",{"_3475":2167,"_30304":2136,"_20976":56165,"_5":14428,"_27536":56073,"_2958":56166},[],"`regenerate_on_revoke`",{"_3475":2168,"_30304":2136,"_20976":56168,"_5":14428,"_27536":56073,"_2958":56169},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3475":2169,"_30304":2136,"_20976":56171,"_5":14428,"_27536":56073,"_2958":56172},[],"`true`.",{"_3475":2170,"_30304":2136,"_20976":56174,"_5":14428,"_27536":56073,"_2958":56175},[],"`signer_serial_number`",{"_3475":2171,"_30304":2136,"_20976":56177,"_5":14428,"_27536":56073,"_2958":56178},[],"Serial number of the existing certificate that signs the CRL.",{"_3475":2172,"_30304":2136,"_20976":56180,"_5":14428,"_27536":56073,"_2958":56181},[],"Serial number of the CA’s current certificate.",{"_3475":2173,"_30304":2136,"_20976":56183,"_5":14428,"_27536":56073,"_2958":56184},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3475":2174,"_30304":2136,"_20976":56186,"_5":14428,"_27536":56073,"_2958":56187},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3475":2175,"_30304":2136,"_20976":56189,"_5":14428,"_27536":56073,"_2958":56190},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3475":2176,"_30304":2136,"_20976":56192,"_5":14428,"_27536":56073,"_2958":56193},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3475":2177,"_30304":2136,"_20976":56195,"_5":14428,"_27536":56073,"_2958":56196},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3475":2178,"_30304":2136,"_20976":56198,"_5":14428,"_27536":56073,"_2958":56199},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3475":2179,"_30304":2136,"_20976":56201,"_5":14428,"_27536":56073,"_2958":56202},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3475":2180,"_30304":2136,"_20976":56204,"_5":14428,"_27536":56073,"_2958":56205},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3475":2181,"_30304":2136,"_20976":56207,"_5":14428,"_27536":56073,"_2958":56208},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3475":2182,"_30304":2136,"_20976":56210,"_5":14428,"_27536":56073,"_2958":56211},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3475":2183,"_30304":2136,"_20976":56213,"_5":14428,"_27536":56073,"_2958":56214},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3475":2184,"_30304":2136,"_20976":56216,"_5":14428,"_27536":56077,"_2958":56217},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3475":2185,"_30304":2136,"_20976":56219,"_5":14428,"_27536":56077,"_2958":56220},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3475":2186,"_30304":2136,"_20976":56222,"_5":14428,"_27536":56077,"_2958":56223},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3475":2187,"_30304":2136,"_20976":56225,"_5":14428,"_27536":56077,"_2958":56226},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3475":2188,"_30304":2136,"_20976":56228,"_5":14428,"_27536":56081,"_2958":56229},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3475":2189,"_30304":2136,"_20976":56231,"_5":14428,"_27536":56081,"_2958":56232},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3475":2190,"_30304":2136,"_20976":56234,"_5":14428,"_27536":56081,"_2958":56235},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3475":2191,"_30304":2136,"_20976":56237,"_5":14428,"_27536":56081,"_2958":56238},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3475":2192,"_30304":2136,"_20976":56240,"_5":14428,"_27536":56081,"_2958":56241},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3475":2193,"_30304":2136,"_20976":56243,"_5":14428,"_27536":56081,"_2958":56244},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3475":2194,"_30304":2136,"_20976":56246,"_5":14428,"_27536":56081,"_2958":56247},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3475":2195,"_30304":2136,"_20976":56249,"_5":14428,"_27536":56081,"_2958":56250},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3475":2196,"_30304":2136,"_20976":56252,"_5":14428,"_27536":56081,"_2958":56253},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3475":2197,"_30304":2136,"_20976":56255,"_5":14428,"_27536":56085,"_2958":56256},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3475":2198,"_30304":2136,"_20976":56258,"_5":14428,"_27536":56085,"_2958":56259},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3475":2199,"_30304":2136,"_20976":56261,"_5":14428,"_27536":56089,"_2958":56262},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3475":2200,"_30304":2136,"_20976":56264,"_5":14428,"_27536":56089,"_2958":56265},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3475":2201,"_30304":2136,"_20976":56267,"_5":14428,"_27536":56089,"_2958":56268},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3475":2202,"_30304":2136,"_20976":56270,"_5":14428,"_27536":56089,"_2958":56271},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3475":2203,"_30304":2136,"_20976":56273,"_5":14428,"_27536":56089,"_2958":56274},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3475":2204,"_30304":2136,"_20976":56276,"_5":14428,"_27536":56093,"_2958":56277},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3475":2205,"_30304":2136,"_20976":56279,"_5":14428,"_27536":56093,"_2958":52660},[],{"_3475":2206,"_30304":2136,"_20976":56281,"_5":14428,"_27536":56093,"_2958":56282},[],"Relative path",{"_3475":2207,"_30304":2136,"_20976":56284,"_5":14428,"_27536":56093,"_2958":52657},[],{"_3475":2208,"_30304":2136,"_20976":56286,"_5":14428,"_27536":56093,"_2958":56287},[],"`GET`",{"_3475":2209,"_30304":2136,"_20976":56289,"_5":14428,"_27536":56093,"_2958":56290},[],"`/v1/crl-settings`",{"_3475":2210,"_30304":2136,"_20976":56292,"_5":14428,"_27536":56093,"_2958":56293},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3475":2211,"_30304":2136,"_20976":56295,"_5":14428,"_27536":56093,"_2958":56287},[],{"_3475":2212,"_30304":2136,"_20976":56297,"_5":14428,"_27536":56093,"_2958":56298},[],"`/v1/crl-settings/{ca-id}`",{"_3475":2213,"_30304":2136,"_20976":56300,"_5":14428,"_27536":56093,"_2958":56301},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3475":2214,"_30304":2136,"_20976":56303,"_5":14428,"_27536":56093,"_2958":56304},[],"`PUT`",{"_3475":2215,"_30304":2136,"_20976":56306,"_5":14428,"_27536":56093,"_2958":56298},[],{"_3475":2216,"_30304":2136,"_20976":56308,"_5":14428,"_27536":56093,"_2958":56309},[],"Replace the CRL configuration of a CA.",{"_3475":2217,"_30304":2136,"_20976":56311,"_5":14428,"_27536":56093,"_2958":56312},[],"`DELETE`",{"_3475":2218,"_30304":2136,"_20976":56314,"_5":14428,"_27536":56093,"_2958":56298},[],{"_3475":2219,"_30304":2136,"_20976":56316,"_5":14428,"_27536":56093,"_2958":56317},[],"Remove the archived CRL settings of a CA.",{"_3475":2220,"_30304":2136,"_20976":56319,"_5":14428,"_27536":56093,"_2958":56320},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3475":2221,"_30304":2136,"_20976":56322,"_5":14428,"_27536":56093,"_2958":56323},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3475":2222,"_30304":2136,"_20976":56325,"_5":14428,"_27536":56093,"_2958":56326},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3475":2223,"_30304":2136,"_20976":56328,"_5":14428,"_27536":56097,"_2958":56329},[],"Symptom",{"_3475":2224,"_30304":2136,"_20976":56331,"_5":14428,"_27536":56097,"_2958":56332},[],"Cause",{"_3475":2225,"_30304":2136,"_20976":56334,"_5":14428,"_27536":56097,"_2958":56335},[],"Action",{"_3475":2226,"_30304":2136,"_20976":56337,"_5":14428,"_27536":56097,"_2958":56338},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3475":2227,"_30304":2136,"_20976":56340,"_5":14428,"_27536":56097,"_2958":56341},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3475":2228,"_30304":2136,"_20976":56343,"_5":14428,"_27536":56097,"_2958":56344},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3475":2229,"_30304":2136,"_20976":56346,"_5":14428,"_27536":56097,"_2958":56347},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3475":2230,"_30304":2136,"_20976":56349,"_5":14428,"_27536":56097,"_2958":56350},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3475":2231,"_30304":2136,"_20976":56352,"_5":14428,"_27536":56097,"_2958":56353},[],"Delete the CA first; deleting it archives its settings.",{"_3475":2232,"_30304":2136,"_20976":56355,"_5":14428,"_27536":56097,"_2958":56356},[],"`PUT` returns 400.",{"_3475":2233,"_30304":2136,"_20976":56358,"_5":14428,"_27536":56097,"_2958":56359},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3475":2234,"_30304":2136,"_20976":56361,"_5":14428,"_27536":56097,"_2958":56362},[],"Set the serial number of a valid certificate of that CA.",{"_3475":2235,"_30304":2136,"_20976":56364,"_5":14428,"_27536":56097,"_2958":56365},[],"`PUT` returns 404.",{"_3475":2236,"_30304":2136,"_20976":56367,"_5":14428,"_27536":56097,"_2958":56368},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3475":2237,"_30304":2136,"_20976":56370,"_5":14428,"_27536":56097,"_2958":56371},[],"Check the CA ID and the signer serial number.",{"_3475":2238,"_30304":2136,"_20976":56373,"_5":14428,"_27536":56097,"_2958":56374},[],"`PUT` returns 400 from a 3.x client.",{"_3475":2239,"_30304":2136,"_20976":56376,"_5":14428,"_27536":56097,"_2958":56377},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3475":2240,"_30304":2136,"_20976":56379,"_5":14428,"_27536":56097,"_2958":56380},[],"Update the client to send the new field.",{"_3475":2241,"_30304":2136,"_20976":56382,"_5":14428,"_27536":56097,"_2958":56383},[],"The CRL does not change after revoking a certificate.",{"_3475":2242,"_30304":2136,"_20976":56385,"_5":14428,"_27536":56097,"_2958":56386},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3475":2243,"_30304":2136,"_20976":56388,"_5":14428,"_27536":56097,"_2958":56389},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3475":2244,"_30304":2136,"_20976":56391,"_5":14428,"_27536":56097,"_2958":56392},[],"A verifier rejects the CRL because of the issuer.",{"_3475":2245,"_30304":2136,"_20976":56394,"_5":14428,"_27536":56097,"_2958":56395},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3475":2246,"_30304":2136,"_20976":56397,"_5":14428,"_27536":56097,"_2958":56398},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3475":2247,"_30304":2136,"_20976":56400,"_5":14428,"_27536":56101,"_2958":56401},[],"RFC 5280: X.509 and CRL profile.",{"_3475":2248,"_30304":2136,"_20976":56403,"_5":14428,"_27536":56101,"_2958":56404},[],"OpenSSL: openssl-crl.",{"_3475":2249,"_30304":2136,"_20976":56406,"_5":14428,"_27536":56101,"_2958":56407},[],"OpenSSL: openssl-verify.",{"_3475":2250,"_30304":2136,"_20976":56409,"_5":14428,"_27536":56101,"_2958":56410},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":2251,"_30304":2136,"_20976":56412,"_5":14428,"_27536":56101,"_2958":56413},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3475":2252,"_30304":2252,"_5":14780,"_2958":56415,"_30657":56416,"_20976":56417,"_27536":2252},"Keys and cryptographic engines",[49412,50887,54895,54896],[],{"_3475":2253,"_30304":2252,"_20976":56419,"_5":14428,"_27536":2252,"_2958":56420},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3475":2254,"_30304":2252,"_5":30654,"_20976":56422,"_27536":56423,"_2958":56424},[],"/docs/pr-preview/pr-65/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3475":2255,"_30304":2252,"_5":30654,"_20976":56426,"_27536":56427,"_2958":56428},[],"/docs/pr-preview/pr-65/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3475":2256,"_30304":2252,"_5":30654,"_20976":56430,"_27536":56431,"_2958":56432},[],"/docs/pr-preview/pr-65/platform/pki/key-management#file-system","File System",{"_3475":2257,"_30304":2252,"_5":30654,"_20976":56434,"_27536":56435,"_2958":56436},[],"/docs/pr-preview/pr-65/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3475":2258,"_30304":2252,"_5":30654,"_20976":56438,"_27536":56439,"_2958":56440},[],"/docs/pr-preview/pr-65/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3475":2259,"_30304":2252,"_5":30654,"_20976":56442,"_27536":56443,"_2958":56444},[],"/docs/pr-preview/pr-65/platform/pki/key-management#aws-kms","AWS KMS",{"_3475":2260,"_30304":2252,"_5":30654,"_20976":56446,"_27536":56447,"_2958":56448},[],"/docs/pr-preview/pr-65/platform/pki/key-management#pkcs11","PKCS#11",{"_3475":2261,"_30304":2252,"_5":30654,"_20976":56450,"_27536":56451,"_2958":56452},[],"/docs/pr-preview/pr-65/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3475":2262,"_30304":2252,"_5":30654,"_20976":56454,"_27536":56455,"_2958":56456},[],"/docs/pr-preview/pr-65/platform/pki/key-management#key-inventory","Key inventory",{"_3475":2263,"_30304":2252,"_5":30654,"_20976":56458,"_27536":56459,"_2958":56460},[],"/docs/pr-preview/pr-65/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3475":2264,"_30304":2252,"_5":30654,"_20976":56462,"_27536":56463,"_2958":56464},[],"/docs/pr-preview/pr-65/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3475":2265,"_30304":2252,"_5":30654,"_20976":56466,"_27536":56467,"_2958":56468},[],"/docs/pr-preview/pr-65/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3475":2266,"_30304":2252,"_5":30654,"_20976":56470,"_27536":56471,"_2958":56472},[],"/docs/pr-preview/pr-65/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3475":2267,"_30304":2252,"_5":30654,"_20976":56474,"_27536":56475,"_2958":56476},[],"/docs/pr-preview/pr-65/platform/pki/key-management#view-details","View details",{"_3475":2268,"_30304":2252,"_5":30654,"_20976":56478,"_27536":56479,"_2958":56480},[],"/docs/pr-preview/pr-65/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3475":2269,"_30304":2252,"_5":30654,"_20976":56482,"_27536":56483,"_2958":56484},[],"/docs/pr-preview/pr-65/platform/pki/key-management#sign","Sign",{"_3475":2270,"_30304":2252,"_5":30654,"_20976":56486,"_27536":56487,"_2958":56488},[],"/docs/pr-preview/pr-65/platform/pki/key-management#verify","Verify",{"_3475":2271,"_30304":2252,"_5":30654,"_20976":56490,"_27536":56491,"_2958":56492},[],"/docs/pr-preview/pr-65/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3475":2272,"_30304":2252,"_5":30654,"_20976":56494,"_27536":56495,"_2958":56496},[],"/docs/pr-preview/pr-65/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3475":2273,"_30304":2252,"_5":30654,"_20976":56498,"_27536":56499,"_2958":56500},[],"/docs/pr-preview/pr-65/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3475":2274,"_30304":2252,"_20976":56502,"_5":14428,"_27536":2252,"_2958":56503},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3475":2275,"_30304":2252,"_20976":56505,"_5":14428,"_27536":2252,"_2958":56506},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3475":2276,"_30304":2252,"_20976":56508,"_5":14428,"_27536":56423,"_2958":56509},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3475":2277,"_30304":2252,"_20976":56511,"_5":14428,"_27536":56423,"_2958":56512},[],"In practice, it lets you:",{"_3475":2278,"_30304":2252,"_20976":56514,"_5":14428,"_27536":56423,"_2958":56515},[],"Generate new key pairs from Lamassu IoT.",{"_3475":2279,"_30304":2252,"_20976":56517,"_5":14428,"_27536":56423,"_2958":56518},[],"Import keys created externally.",{"_3475":2280,"_30304":2252,"_20976":56520,"_5":14428,"_27536":56423,"_2958":56521},[],"Delegate custody and cryptographic operations to external engines.",{"_3475":2281,"_30304":2252,"_20976":56523,"_5":14428,"_27536":56423,"_2958":56524},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3475":2282,"_30304":2252,"_20976":56526,"_5":14428,"_27536":56427,"_2958":56527},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3475":2283,"_30304":2252,"_20976":56529,"_5":14428,"_27536":56427,"_2958":56530},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3475":2284,"_30304":2252,"_20976":56532,"_5":14428,"_27536":56427,"_2958":56533},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3475":2285,"_30304":2252,"_20976":56535,"_5":14428,"_27536":56431,"_2958":56536},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3475":2286,"_30304":2252,"_20976":56538,"_5":14428,"_27536":56435,"_2958":56539},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3475":2287,"_30304":2252,"_20976":56541,"_5":14428,"_27536":56435,"_2958":56542},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3475":2288,"_30304":2252,"_20976":56544,"_5":14428,"_27536":56439,"_2958":56545},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3475":2289,"_30304":2252,"_20976":56547,"_5":14428,"_27536":56443,"_2958":56548},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3475":2290,"_30304":2252,"_20976":56550,"_5":14428,"_27536":56447,"_2958":56551},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3475":2291,"_30304":2252,"_20976":56553,"_5":14428,"_27536":56451,"_2958":56554},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3475":2292,"_30304":2252,"_20976":56556,"_5":14428,"_27536":56451,"_2958":56557},[],"Lamassu shows the enabled engines in the console.",{"_3475":2293,"_30304":2252,"_20976":56559,"_5":14428,"_27536":56451,"_2958":56560},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3475":2294,"_30304":2252,"_20976":56562,"_5":14428,"_27536":56451,"_2958":56563},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3475":2295,"_30304":2252,"_20976":56565,"_5":14428,"_27536":56455,"_2958":56566},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3475":2296,"_30304":2252,"_20976":56568,"_5":14428,"_27536":56455,"_2958":56569},[],"The table includes the following fields:",{"_3475":2297,"_30304":2252,"_20976":56571,"_5":14428,"_27536":56455,"_2958":56572},[],"**Name**: descriptive name of the key.",{"_3475":2298,"_30304":2252,"_20976":56574,"_5":14428,"_27536":56455,"_2958":56575},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3475":2299,"_30304":2252,"_20976":56577,"_5":14428,"_27536":56455,"_2958":56578},[],"**Strength**: visual indicator of cryptographic strength.",{"_3475":2300,"_30304":2252,"_20976":56580,"_5":14428,"_27536":56455,"_2958":56581},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3475":2301,"_30304":2252,"_20976":56583,"_5":14428,"_27536":56455,"_2958":56584},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3475":2302,"_30304":2252,"_20976":56586,"_5":14428,"_27536":56455,"_2958":56587},[],"**Aliases**: alternative names associated with the key.",{"_3475":2303,"_30304":2252,"_20976":56589,"_5":14428,"_27536":56455,"_2958":56590},[],"**Tags**: labels for classification and search.",{"_3475":2304,"_30304":2252,"_20976":56592,"_5":14428,"_27536":56455,"_2958":56593},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3475":2305,"_30304":2252,"_20976":56595,"_5":14428,"_27536":56455,"_2958":56596},[],"From this view you also reach the most common actions:",{"_3475":2306,"_30304":2252,"_20976":56598,"_5":14428,"_27536":56455,"_2958":56599},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3475":2307,"_30304":2252,"_20976":56601,"_5":14428,"_27536":56455,"_2958":56602},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3475":2308,"_30304":2252,"_20976":56604,"_5":14428,"_27536":56455,"_2958":56605},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3475":2309,"_30304":2252,"_20976":56607,"_5":14428,"_27536":56455,"_2958":56608},[],"**Delete Key** to remove the key from the system.",{"_3475":2310,"_30304":2252,"_20976":56610,"_5":14428,"_27536":56459,"_2958":56611},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3475":2311,"_30304":2252,"_20976":56613,"_5":14428,"_27536":56463,"_2958":56614},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3475":2312,"_30304":2252,"_20976":56616,"_5":14428,"_27536":56463,"_2958":56617},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3475":2313,"_30304":2252,"_20976":56619,"_5":14428,"_27536":56463,"_2958":56620},[],"**Key Name**: unique and descriptive name.",{"_3475":2314,"_30304":2252,"_20976":56622,"_5":14428,"_27536":56463,"_2958":56623},[],"**Crypto Engine**: engine that will keep the key.",{"_3475":2315,"_30304":2252,"_20976":56625,"_5":14428,"_27536":56463,"_2958":56626},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3475":2316,"_30304":2252,"_20976":56628,"_5":14428,"_27536":56463,"_2958":56629},[],"**Tags**: metadata to classify the key.",{"_3475":2317,"_30304":2252,"_20976":56631,"_5":14428,"_27536":56463,"_2958":56632},[],"**Metadata**: additional information for advanced uses.",{"_3475":2318,"_30304":2252,"_20976":56634,"_5":14428,"_27536":56467,"_2958":56635},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3475":2319,"_30304":2252,"_20976":56637,"_5":14428,"_27536":56467,"_2958":56638},[],"When you have an exportable private key and the destination engine supports import.",{"_3475":2320,"_30304":2252,"_20976":56640,"_5":14428,"_27536":56467,"_2958":56641},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3475":2321,"_30304":2252,"_20976":56643,"_5":14428,"_27536":56467,"_2958":56644},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3475":2322,"_30304":2252,"_20976":56646,"_5":14428,"_27536":56467,"_2958":56647},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3475":2323,"_30304":2252,"_20976":56649,"_5":14428,"_27536":56467,"_2958":56650},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3475":2324,"_30304":2252,"_20976":56652,"_5":14428,"_27536":56467,"_2958":56653},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3475":2325,"_30304":2252,"_20976":56655,"_5":14428,"_27536":56467,"_2958":56656},[],"**Tags**: labels for organization and search.",{"_3475":2326,"_30304":2252,"_20976":56658,"_5":14428,"_27536":56467,"_2958":56659},[],"**Metadata**: additional optional information.",{"_3475":2327,"_30304":2252,"_20976":56661,"_5":14428,"_27536":56467,"_2958":56662},[],"**Private Key (PEM)**: private key in PEM format.",{"_3475":2328,"_30304":2252,"_20976":56664,"_5":14428,"_27536":56467,"_2958":56665},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3475":2329,"_30304":2252,"_20976":56667,"_5":14428,"_27536":56471,"_2958":56668},[],"Each registered key has a detail view and several operational actions.",{"_3475":2330,"_30304":2252,"_20976":56670,"_5":14428,"_27536":56475,"_2958":56671},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3475":2331,"_30304":2252,"_20976":56673,"_5":14428,"_27536":56475,"_2958":56674},[],"The **Overview** tab shows, among others, these fields:",{"_3475":2332,"_30304":2252,"_20976":56676,"_5":14428,"_27536":56475,"_2958":56677},[],"**Key Name**: descriptive name.",{"_3475":2333,"_30304":2252,"_20976":56679,"_5":14428,"_27536":56475,"_2958":56680},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3475":2334,"_30304":2252,"_20976":56682,"_5":14428,"_27536":56475,"_2958":56683},[],"**Tags**: associated labels.",{"_3475":2335,"_30304":2252,"_20976":56685,"_5":14428,"_27536":56475,"_2958":56686},[],"**Aliases**: alternative names.",{"_3475":2336,"_30304":2252,"_20976":56688,"_5":14428,"_27536":56475,"_2958":56689},[],"**Crypto Engine**: engine where the key resides.",{"_3475":2337,"_30304":2252,"_20976":56691,"_5":14428,"_27536":56475,"_2958":56692},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3475":2338,"_30304":2252,"_20976":56694,"_5":14428,"_27536":56475,"_2958":56695},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3475":2339,"_30304":2252,"_20976":56697,"_5":14428,"_27536":56475,"_2958":56698},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3475":2340,"_30304":2252,"_20976":56700,"_5":14428,"_27536":56479,"_2958":56701},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3475":2341,"_30304":2252,"_20976":56703,"_5":14428,"_27536":56479,"_2958":56704},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3475":2342,"_30304":2252,"_20976":56706,"_5":14428,"_27536":56479,"_2958":56707},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3475":2343,"_30304":2252,"_20976":56709,"_5":14428,"_27536":56483,"_2958":56710},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3475":2344,"_30304":2252,"_20976":56712,"_5":14428,"_27536":56483,"_2958":56713},[],"Main fields:",{"_3475":2345,"_30304":2252,"_20976":56715,"_5":14428,"_27536":56483,"_2958":56716},[],"**Algorithm**: signing algorithm available for the key type.",{"_3475":2346,"_30304":2252,"_20976":56718,"_5":14428,"_27536":56483,"_2958":56719},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3475":2347,"_30304":2252,"_20976":56721,"_5":14428,"_27536":56483,"_2958":56722},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3475":2348,"_30304":2252,"_20976":56724,"_5":14428,"_27536":56483,"_2958":56725},[],"**Message**: content to sign.",{"_3475":2349,"_30304":2252,"_20976":56727,"_5":14428,"_27536":56483,"_2958":56728},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3475":2350,"_30304":2252,"_20976":56730,"_5":14428,"_27536":56487,"_2958":56731},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3475":2351,"_30304":2252,"_20976":56733,"_5":14428,"_27536":56487,"_2958":56713},[],{"_3475":2352,"_30304":2252,"_20976":56735,"_5":14428,"_27536":56487,"_2958":56736},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3475":2353,"_30304":2252,"_20976":56738,"_5":14428,"_27536":56487,"_2958":56739},[],"**Message Type**: `Raw` or `Digest`.",{"_3475":2354,"_30304":2252,"_20976":56741,"_5":14428,"_27536":56487,"_2958":56742},[],"**Payload Encoding**: encoding of the message.",{"_3475":2355,"_30304":2252,"_20976":56744,"_5":14428,"_27536":56487,"_2958":56745},[],"**Message**: original message or hash.",{"_3475":2356,"_30304":2252,"_20976":56747,"_5":14428,"_27536":56487,"_2958":56748},[],"**Signature**: signature to check.",{"_3475":2357,"_30304":2252,"_20976":56750,"_5":14428,"_27536":56487,"_2958":56751},[],"**Result**: indicator of the validation result.",{"_3475":2358,"_30304":2252,"_20976":56753,"_5":14428,"_27536":56491,"_2958":56754},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3475":2359,"_30304":2252,"_20976":56756,"_5":14428,"_27536":56491,"_2958":56757},[],"This flow is useful for:",{"_3475":2360,"_30304":2252,"_20976":56759,"_5":14428,"_27536":56491,"_2958":56760},[],"Requesting certificates from an external CA.",{"_3475":2361,"_30304":2252,"_20976":56762,"_5":14428,"_27536":56491,"_2958":56763},[],"Renewing an identity while keeping the same key.",{"_3475":2362,"_30304":2252,"_20976":56765,"_5":14428,"_27536":56491,"_2958":56766},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3475":2363,"_30304":2252,"_20976":56768,"_5":14428,"_27536":56491,"_2958":56769},[],"**Common Name (CN)**: main name of the identity.",{"_3475":2364,"_30304":2252,"_20976":56771,"_5":14428,"_27536":56491,"_2958":56772},[],"**Organization (O)**: organization or company.",{"_3475":2365,"_30304":2252,"_20976":56774,"_5":14428,"_27536":56491,"_2958":56775},[],"**Organizational Unit (OU)**: department or unit.",{"_3475":2366,"_30304":2252,"_20976":56777,"_5":14428,"_27536":56491,"_2958":56778},[],"**Country (C)**: two-letter country code.",{"_3475":2367,"_30304":2252,"_20976":56780,"_5":14428,"_27536":56491,"_2958":56781},[],"**State / Province (ST)**: state or province.",{"_3475":2368,"_30304":2252,"_20976":56783,"_5":14428,"_27536":56491,"_2958":56784},[],"**Locality (L)**: city or locality.",{"_3475":2369,"_30304":2252,"_20976":56786,"_5":14428,"_27536":56491,"_2958":56787},[],"**Email Address**: contact email.",{"_3475":2370,"_30304":2252,"_20976":56789,"_5":14428,"_27536":56491,"_2958":56790},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3475":2371,"_30304":2252,"_20976":56792,"_5":14428,"_27536":56491,"_2958":56793},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3475":2372,"_30304":2252,"_20976":56795,"_5":14428,"_27536":56495,"_2958":56796},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3475":2373,"_30304":2252,"_20976":56798,"_5":14428,"_27536":56495,"_2958":56799},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3475":2374,"_30304":2252,"_20976":56801,"_5":14428,"_27536":56499,"_2958":56802},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3475":2375,"_30304":2252,"_20976":56804,"_5":14428,"_27536":56499,"_2958":56805},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3475":2376,"_30304":2376,"_5":14780,"_2958":56807,"_30657":56808,"_20976":56809,"_27536":2376},"Online validation with OCSP",[49412,50887,54895,55537],[],{"_3475":2377,"_30304":2376,"_20976":56811,"_5":14428,"_27536":2376,"_2958":56812},[],"Query signed status and verify the responder’s response.",{"_3475":2378,"_30304":2376,"_5":30654,"_20976":56814,"_27536":56815,"_2958":56816},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3475":2379,"_30304":2376,"_5":30654,"_20976":56818,"_27536":56819,"_2958":56820},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3475":2380,"_30304":2376,"_5":30654,"_20976":56822,"_27536":56823,"_2958":56824},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3475":2381,"_30304":2376,"_5":30654,"_20976":56826,"_27536":56827,"_2958":56828},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3475":2382,"_30304":2376,"_5":30654,"_20976":56830,"_27536":56831,"_2958":56832},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3475":2383,"_30304":2376,"_5":30654,"_20976":56834,"_27536":56835,"_2958":56102},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#references",{"_3475":2384,"_30304":2376,"_20976":56837,"_5":14428,"_27536":2376,"_2958":56838},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3475":2385,"_30304":2376,"_20976":56840,"_5":14428,"_27536":56815,"_2958":56841},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3475":2386,"_30304":2376,"_20976":56843,"_5":14428,"_27536":56815,"_2958":56844},[],"Record status",{"_3475":2387,"_30304":2376,"_20976":56846,"_5":14428,"_27536":56815,"_2958":56847},[],"Signed response",{"_3475":2388,"_30304":2376,"_20976":56849,"_5":14428,"_27536":56815,"_2958":54032},[],{"_3475":2389,"_30304":2376,"_20976":56851,"_5":14428,"_27536":56815,"_2958":56852},[],"`Good`.",{"_3475":2390,"_30304":2376,"_20976":56854,"_5":14428,"_27536":56815,"_2958":54049},[],{"_3475":2391,"_30304":2376,"_20976":56856,"_5":14428,"_27536":56815,"_2958":56857},[],"`Revoked`, with revocation reason and timestamp.",{"_3475":2392,"_30304":2376,"_20976":56859,"_5":14428,"_27536":56815,"_2958":56860},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3475":2393,"_30304":2376,"_20976":56862,"_5":14428,"_27536":56815,"_2958":56863},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3475":2394,"_30304":2376,"_20976":56865,"_5":14428,"_27536":56815,"_2958":56866},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3475":2395,"_30304":2376,"_20976":56868,"_5":14428,"_27536":56815,"_2958":56869},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3475":2396,"_30304":2376,"_20976":56871,"_5":14428,"_27536":56815,"_2958":56872},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3475":2397,"_30304":2376,"_20976":56874,"_5":14428,"_27536":56819,"_2958":56875},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3475":2398,"_30304":2376,"_20976":56877,"_5":14428,"_27536":56819,"_2958":56878},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3475":2399,"_30304":2376,"_20976":56880,"_5":14428,"_27536":56823,"_2958":56881},[],"The service accepts:",{"_3475":2400,"_30304":2376,"_20976":56883,"_5":14428,"_27536":56823,"_2958":52660},[],{"_3475":2401,"_30304":2376,"_20976":56885,"_5":14428,"_27536":56823,"_2958":56886},[],"VA service path",{"_3475":2402,"_30304":2376,"_20976":56888,"_5":14428,"_27536":56823,"_2958":56889},[],"Format",{"_3475":2403,"_30304":2376,"_20976":56891,"_5":14428,"_27536":56823,"_2958":56892},[],"`POST`",{"_3475":2404,"_30304":2376,"_20976":56894,"_5":14428,"_27536":56823,"_2958":56895},[],"`/ocsp`",{"_3475":2405,"_30304":2376,"_20976":56897,"_5":14428,"_27536":56823,"_2958":56898},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3475":2406,"_30304":2376,"_20976":56900,"_5":14428,"_27536":56823,"_2958":56287},[],{"_3475":2407,"_30304":2376,"_20976":56902,"_5":14428,"_27536":56823,"_2958":56903},[],"`/ocsp/{ocsp_request}`",{"_3475":2408,"_30304":2376,"_20976":56905,"_5":14428,"_27536":56823,"_2958":56906},[],"DER request encoded using padded URL Base64.",{"_3475":2409,"_30304":2376,"_20976":56908,"_5":14428,"_27536":56823,"_2958":56909},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3475":2410,"_30304":2376,"_20976":56911,"_5":14428,"_27536":56827,"_2958":56912},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3475":2411,"_30304":2376,"_20976":56914,"_5":14428,"_27536":56827,"_2958":56915},[],"Generate the request:",{"_3475":2412,"_30304":2376,"_20976":56917,"_5":14428,"_27536":56827,"_2958":56918},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3475":2413,"_30304":2376,"_20976":56920,"_5":14428,"_27536":56827,"_2958":56921},[],"Replace the example URL with the inspected endpoint:",{"_3475":2414,"_30304":2376,"_20976":56923,"_5":14428,"_27536":56827,"_2958":56924},[],"Verify the returned DER:",{"_3475":2415,"_30304":2376,"_20976":56926,"_5":14428,"_27536":56827,"_2958":56927},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3475":2416,"_30304":2376,"_20976":56929,"_5":14428,"_27536":56831,"_2958":56930},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3475":2417,"_30304":2376,"_20976":56932,"_5":14428,"_27536":56831,"_2958":56933},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3475":2418,"_30304":2376,"_20976":56935,"_5":14428,"_27536":56835,"_2958":56936},[],"RFC 6960: OCSP.",{"_3475":2419,"_30304":2376,"_20976":56938,"_5":14428,"_27536":56835,"_2958":56939},[],"OpenSSL: openssl-ocsp.",{"_3475":2420,"_30304":2376,"_20976":56941,"_5":14428,"_27536":56835,"_2958":56942},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3475":2421,"_30304":2376,"_20976":56944,"_5":14428,"_27536":56835,"_2958":56413},[],{"_3475":2422,"_30304":2422,"_5":14780,"_2958":54895,"_30657":56946,"_20976":56947,"_27536":2422},[49412,50887,54895],[],{"_3475":2423,"_30304":2422,"_20976":56949,"_5":14428,"_27536":2422,"_2958":56950},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3475":2424,"_30304":2422,"_5":30654,"_20976":56952,"_27536":56953,"_2958":54207},[],"/docs/pr-preview/pr-65/platform/pki/overview#start-here",{"_3475":2425,"_30304":2422,"_5":30654,"_20976":56955,"_27536":56956,"_2958":56957},[],"/docs/pr-preview/pr-65/platform/pki/overview#what-you-need","What you need",{"_3475":2426,"_30304":2422,"_5":30654,"_20976":56959,"_27536":56960,"_2958":54739},[],"/docs/pr-preview/pr-65/platform/pki/overview#core-capabilities",{"_3475":2427,"_30304":2422,"_5":30654,"_20976":56962,"_27536":56963,"_2958":54743},[],"/docs/pr-preview/pr-65/platform/pki/overview#build-your-trust-hierarchy",{"_3475":2428,"_30304":2422,"_5":30654,"_20976":56965,"_27536":56966,"_2958":54747},[],"/docs/pr-preview/pr-65/platform/pki/overview#protect-cryptographic-keys",{"_3475":2429,"_30304":2422,"_5":30654,"_20976":56968,"_27536":56969,"_2958":54751},[],"/docs/pr-preview/pr-65/platform/pki/overview#issue-and-control-certificates",{"_3475":2430,"_30304":2422,"_5":30654,"_20976":56971,"_27536":56972,"_2958":54759},[],"/docs/pr-preview/pr-65/platform/pki/overview#publish-validation-status",{"_3475":2431,"_30304":2422,"_5":30654,"_20976":56974,"_27536":56975,"_2958":56976},[],"/docs/pr-preview/pr-65/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3475":2432,"_30304":2422,"_5":30654,"_20976":56978,"_27536":56979,"_2958":55704},[],"/docs/pr-preview/pr-65/platform/pki/overview#continue",{"_3475":2433,"_30304":2422,"_20976":56981,"_5":14428,"_27536":2422,"_2958":56982},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3475":2434,"_30304":2422,"_20976":56984,"_5":14428,"_27536":56953,"_2958":56985},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3475":2435,"_30304":2422,"_20976":56987,"_5":14428,"_27536":56953,"_2958":56988},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3475":2436,"_30304":2422,"_20976":56990,"_5":14428,"_27536":56956,"_2958":56991},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3475":2437,"_30304":2422,"_20976":56993,"_5":14428,"_27536":56956,"_2958":56994},[],"An available cryptographic engine to keep the authority's key.",{"_3475":2438,"_30304":2422,"_20976":56996,"_5":14428,"_27536":56956,"_2958":56997},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3475":2439,"_30304":2422,"_20976":56999,"_5":14428,"_27536":56956,"_2958":57000},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3475":2440,"_30304":2422,"_20976":57002,"_5":14428,"_27536":56956,"_2958":57003},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3475":2441,"_30304":2422,"_20976":57005,"_5":14428,"_27536":56963,"_2958":57006},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3475":2442,"_30304":2422,"_20976":57008,"_5":14428,"_27536":56966,"_2958":57009},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3475":2443,"_30304":2422,"_20976":57011,"_5":14428,"_27536":56969,"_2958":57012},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3475":2444,"_30304":2422,"_20976":57014,"_5":14428,"_27536":56972,"_2958":57015},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3475":2445,"_30304":2422,"_20976":57017,"_5":14428,"_27536":56975,"_2958":57018},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3475":2446,"_30304":2422,"_20976":57020,"_5":14428,"_27536":56975,"_2958":57021},[],"its subject and extensions identify the expected client;",{"_3475":2447,"_30304":2422,"_20976":57023,"_5":14428,"_27536":56975,"_2958":57024},[],"its public key matches the client's private key;",{"_3475":2448,"_30304":2422,"_20976":57026,"_5":14428,"_27536":56975,"_2958":57027},[],"its chain reaches a root trusted by the consumer;",{"_3475":2449,"_30304":2422,"_20976":57029,"_5":14428,"_27536":56975,"_2958":57030},[],"its dates and usages allow the operation;",{"_3475":2450,"_30304":2422,"_20976":57032,"_5":14428,"_27536":56975,"_2958":57033},[],"the consumer applies revocation checks and authorization.",{"_3475":2451,"_30304":2422,"_20976":57035,"_5":14428,"_27536":56975,"_2958":57036},[],"The issuance path includes the first independent checks.",{"_3475":2452,"_30304":2422,"_20976":57038,"_5":14428,"_27536":56979,"_2958":57039},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3475":2453,"_30304":2422,"_20976":57041,"_5":14428,"_27536":56979,"_2958":57042},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3475":2454,"_30304":2422,"_20976":57044,"_5":14428,"_27536":56979,"_2958":57045},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3475":2455,"_30304":2455,"_5":14780,"_2958":57047,"_30657":57048,"_20976":57049,"_27536":2455},"Create your first CA",[49412,50887,54895,54332],[],{"_3475":2456,"_30304":2455,"_20976":57051,"_5":14428,"_27536":2455,"_2958":57052},[],"Create an evaluation root and check its certificate before issuing.",{"_3475":2457,"_30304":2455,"_5":30654,"_20976":57054,"_27536":57055,"_2958":49422},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3475":2458,"_30304":2455,"_5":30654,"_20976":57057,"_27536":57058,"_2958":57059},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3475":2459,"_30304":2455,"_5":30654,"_20976":57061,"_27536":57062,"_2958":57063},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3475":2460,"_30304":2455,"_5":30654,"_20976":57065,"_27536":57066,"_2958":57067},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3475":2461,"_30304":2455,"_5":30654,"_20976":57069,"_27536":57070,"_2958":57071},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3475":2462,"_30304":2455,"_5":30654,"_20976":57073,"_27536":57074,"_2958":57075},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3475":2463,"_30304":2455,"_5":30654,"_20976":57077,"_27536":57078,"_2958":57079},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3475":2464,"_30304":2455,"_5":30654,"_20976":57081,"_27536":57082,"_2958":54589},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3475":2465,"_30304":2455,"_5":30654,"_20976":57084,"_27536":57085,"_2958":49446},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3475":2466,"_30304":2455,"_20976":57087,"_5":14428,"_27536":2455,"_2958":57088},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3475":2467,"_30304":2455,"_20976":57090,"_5":14428,"_27536":57055,"_2958":57091},[],"Console access and permission to create keys and authorities.",{"_3475":2468,"_30304":2455,"_20976":57093,"_5":14428,"_27536":57055,"_2958":57094},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3475":2469,"_30304":2455,"_20976":57096,"_5":14428,"_27536":57055,"_2958":57097},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3475":2470,"_30304":2455,"_20976":57099,"_5":14428,"_27536":57055,"_2958":57100},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3475":2471,"_30304":2455,"_20976":57102,"_5":14428,"_27536":57058,"_2958":57103},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3475":2472,"_30304":2455,"_20976":57105,"_5":14428,"_27536":57058,"_2958":57106},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3475":2473,"_30304":2455,"_20976":57108,"_5":14428,"_27536":57062,"_2958":57109},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3475":2474,"_30304":2455,"_20976":57111,"_5":14428,"_27536":57062,"_2958":57112},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3475":2475,"_30304":2455,"_20976":57114,"_5":14428,"_27536":57066,"_2958":57115},[],"Select **Root CA** and complete:",{"_3475":2476,"_30304":2455,"_20976":57117,"_5":14428,"_27536":57066,"_2958":57118},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3475":2477,"_30304":2455,"_20976":57120,"_5":14428,"_27536":57066,"_2958":57121},[],"**Subject**: organization and country details for your evaluation.",{"_3475":2478,"_30304":2455,"_20976":57123,"_5":14428,"_27536":57066,"_2958":57124},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3475":2479,"_30304":2455,"_20976":57126,"_5":14428,"_27536":57066,"_2958":57127},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3475":2480,"_30304":2455,"_20976":57129,"_5":14428,"_27536":57066,"_2958":57130},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3475":2481,"_30304":2455,"_20976":57132,"_5":14428,"_27536":57070,"_2958":57133},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3475":2482,"_30304":2455,"_20976":57135,"_5":14428,"_27536":57074,"_2958":57136},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3475":2483,"_30304":2455,"_20976":57138,"_5":14428,"_27536":57074,"_2958":57139},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3475":2484,"_30304":2455,"_20976":57141,"_5":14428,"_27536":57078,"_2958":57142},[],"Run from the directory where you saved `ca.pem`:",{"_3475":2485,"_30304":2455,"_20976":57144,"_5":14428,"_27536":57078,"_2958":57145},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3475":2486,"_30304":2455,"_20976":57147,"_5":14428,"_27536":57078,"_2958":57148},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3475":2487,"_30304":2455,"_20976":57150,"_5":14428,"_27536":57082,"_2958":57151},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3475":2488,"_30304":2455,"_20976":57153,"_5":14428,"_27536":57082,"_2958":57154},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3475":2489,"_30304":2455,"_20976":57156,"_5":14428,"_27536":57082,"_2958":57157},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3475":2490,"_30304":2455,"_20976":57159,"_5":14428,"_27536":57082,"_2958":57160},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3475":2491,"_30304":2455,"_20976":57162,"_5":14428,"_27536":57085,"_2958":57163},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3475":2492,"_30304":2492,"_5":14780,"_2958":57165,"_30657":57166,"_20976":57167,"_27536":2492},"Issue and verify a certificate",[49412,50887,54895,54332],[],{"_3475":2493,"_30304":2492,"_20976":57169,"_5":14428,"_27536":2492,"_2958":57170},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3475":2494,"_30304":2492,"_5":30654,"_20976":57172,"_27536":57173,"_2958":49422},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3475":2495,"_30304":2492,"_5":30654,"_20976":57175,"_27536":57176,"_2958":57177},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3475":2496,"_30304":2492,"_5":30654,"_20976":57179,"_27536":57180,"_2958":57181},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3475":2497,"_30304":2492,"_5":30654,"_20976":57183,"_27536":57184,"_2958":57185},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3475":2498,"_30304":2492,"_5":30654,"_20976":57187,"_27536":57188,"_2958":57189},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3475":2499,"_30304":2492,"_5":30654,"_20976":57191,"_27536":57192,"_2958":57193},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3475":2500,"_30304":2492,"_5":30654,"_20976":57195,"_27536":57196,"_2958":57197},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3475":2501,"_30304":2492,"_5":30654,"_20976":57199,"_27536":57200,"_2958":57201},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3475":2502,"_30304":2492,"_5":30654,"_20976":57203,"_27536":57204,"_2958":57205},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3475":2503,"_30304":2492,"_5":30654,"_20976":57207,"_27536":57208,"_2958":57209},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3475":2504,"_30304":2492,"_5":30654,"_20976":57211,"_27536":57212,"_2958":54589},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3475":2505,"_30304":2492,"_5":30654,"_20976":57214,"_27536":57215,"_2958":49446},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#next-step",{"_3475":2506,"_30304":2492,"_20976":57217,"_5":14428,"_27536":2492,"_2958":57218},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3475":2507,"_30304":2492,"_20976":57220,"_5":14428,"_27536":57173,"_2958":57221},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3475":2508,"_30304":2492,"_20976":57223,"_5":14428,"_27536":57173,"_2958":57224},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3475":2509,"_30304":2492,"_20976":57226,"_5":14428,"_27536":57173,"_2958":57227},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3475":2510,"_30304":2492,"_20976":57229,"_5":14428,"_27536":57173,"_2958":57230},[],"A client identifier: here we use `device-001`.",{"_3475":2511,"_30304":2492,"_20976":57232,"_5":14428,"_27536":57173,"_2958":57233},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3475":2512,"_30304":2492,"_20976":57235,"_5":14428,"_27536":57176,"_2958":57236},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3475":2513,"_30304":2492,"_20976":57238,"_5":14428,"_27536":57180,"_2958":57239},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3475":2514,"_30304":2492,"_20976":57241,"_5":14428,"_27536":57180,"_2958":57242},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3475":2515,"_30304":2492,"_20976":57244,"_5":14428,"_27536":57184,"_2958":57245},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3475":2516,"_30304":2492,"_20976":57247,"_5":14428,"_27536":57184,"_2958":57248},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3475":2517,"_30304":2492,"_20976":57250,"_5":14428,"_27536":57188,"_2958":57251},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3475":2518,"_30304":2492,"_20976":57253,"_5":14428,"_27536":57188,"_2958":57254},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3475":2519,"_30304":2492,"_20976":57256,"_5":14428,"_27536":57192,"_2958":57257},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3475":2520,"_30304":2492,"_20976":57259,"_5":14428,"_27536":57196,"_2958":57260},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3475":2521,"_30304":2492,"_20976":57262,"_5":14428,"_27536":57200,"_2958":57263},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3475":2522,"_30304":2492,"_20976":57265,"_5":14428,"_27536":57204,"_2958":57266},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3475":2523,"_30304":2492,"_20976":57268,"_5":14428,"_27536":57204,"_2958":57269},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3475":2524,"_30304":2492,"_20976":57271,"_5":14428,"_27536":57204,"_2958":57272},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3475":2525,"_30304":2492,"_20976":57274,"_5":14428,"_27536":57208,"_2958":57275},[],"In Bash, compare the two public-key digests:",{"_3475":2526,"_30304":2492,"_20976":57277,"_5":14428,"_27536":57208,"_2958":57278},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3475":2527,"_30304":2492,"_20976":57280,"_5":14428,"_27536":57208,"_2958":57281},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3475":2528,"_30304":2492,"_20976":57283,"_5":14428,"_27536":57212,"_2958":54673},[],{"_3475":2529,"_30304":2492,"_20976":57285,"_5":14428,"_27536":57212,"_2958":57286},[],"What to review",{"_3475":2530,"_30304":2492,"_20976":57288,"_5":14428,"_27536":57212,"_2958":57289},[],"The CA rejects issuance",{"_3475":2531,"_30304":2492,"_20976":57291,"_5":14428,"_27536":57212,"_2958":57292},[],"Permissions, CA state and key, algorithm and profile.",{"_3475":2532,"_30304":2492,"_20976":57294,"_5":14428,"_27536":57212,"_2958":57295},[],"Different subject or usages",{"_3475":2533,"_30304":2492,"_20976":57297,"_5":14428,"_27536":57212,"_2958":57298},[],"Applied profile and requested values.",{"_3475":2534,"_30304":2492,"_20976":57300,"_5":14428,"_27536":57212,"_2958":57301},[],"Issuer cannot be found",{"_3475":2535,"_30304":2492,"_20976":57303,"_5":14428,"_27536":57212,"_2958":57304},[],"Downloaded CA and required intermediate chain.",{"_3475":2536,"_30304":2492,"_20976":57306,"_5":14428,"_27536":57212,"_2958":57307},[],"Validity fails",{"_3475":2537,"_30304":2492,"_20976":57309,"_5":14428,"_27536":57212,"_2958":57310},[],"Certificate and CA dates, and the computer's clock.",{"_3475":2538,"_30304":2492,"_20976":57312,"_5":14428,"_27536":57212,"_2958":57313},[],"Public-key digests differ",{"_3475":2539,"_30304":2492,"_20976":57315,"_5":14428,"_27536":57212,"_2958":57316},[],"Certificate and key files from the same issuance.",{"_3475":2540,"_30304":2492,"_20976":57318,"_5":14428,"_27536":57212,"_2958":57319},[],"See PKI diagnostics to narrow an issuance failure.",{"_3475":2541,"_30304":2492,"_20976":57321,"_5":14428,"_27536":57215,"_2958":57322},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3475":2542,"_30304":2492,"_20976":57324,"_5":14428,"_27536":57215,"_2958":57325},[],"Manage certificates for inspection, status and revocation.",{"_3475":2543,"_30304":2492,"_20976":57327,"_5":14428,"_27536":57215,"_2958":57328},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3475":2544,"_30304":2492,"_20976":57330,"_5":14428,"_27536":57215,"_2958":57331},[],"Prepare EST for the device to request its next identities.",{"_3475":2545,"_30304":2492,"_20976":57333,"_5":14428,"_27536":57215,"_2958":57334},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3475":2546,"_30304":2546,"_5":14780,"_2958":57336,"_30657":57337,"_20976":57338,"_27536":2546},"PKI getting started",[49412,50887,54895,54332],[],{"_3475":2547,"_30304":2546,"_20976":57340,"_5":14428,"_27536":2546,"_2958":57341},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3475":2548,"_30304":2546,"_5":30654,"_20976":57343,"_27536":57344,"_2958":49422},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/overview#before-you-begin",{"_3475":2549,"_30304":2546,"_5":30654,"_20976":57346,"_27536":57347,"_2958":57348},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3475":2550,"_30304":2546,"_5":30654,"_20976":57350,"_27536":57351,"_2958":54524},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/overview#expected-result",{"_3475":2551,"_30304":2546,"_5":30654,"_20976":57353,"_27536":57354,"_2958":57355},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3475":2552,"_30304":2546,"_20976":57357,"_5":14428,"_27536":2546,"_2958":57358},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3475":2553,"_30304":2546,"_20976":57360,"_5":14428,"_27536":57344,"_2958":57361},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3475":2554,"_30304":2546,"_20976":57363,"_5":14428,"_27536":57344,"_2958":57364},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3475":2555,"_30304":2546,"_20976":57366,"_5":14428,"_27536":57344,"_2958":57367},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3475":2556,"_30304":2546,"_20976":57369,"_5":14428,"_27536":57344,"_2958":57370},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3475":2557,"_30304":2546,"_20976":57372,"_5":14428,"_27536":57344,"_2958":57373},[],"A working directory with restricted access for the downloaded key.",{"_3475":2558,"_30304":2546,"_20976":57375,"_5":14428,"_27536":57347,"_2958":57376},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3475":2559,"_30304":2546,"_20976":57378,"_5":14428,"_27536":57347,"_2958":57379},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3475":2560,"_30304":2546,"_20976":57381,"_5":14428,"_27536":57347,"_2958":57382},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3475":2561,"_30304":2546,"_20976":57384,"_5":14428,"_27536":57347,"_2958":57385},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3475":2562,"_30304":2546,"_20976":57387,"_5":14428,"_27536":57351,"_2958":57388},[],"File or resource",{"_3475":2563,"_30304":2546,"_20976":57390,"_5":14428,"_27536":57351,"_2958":54521},[],{"_3475":2564,"_30304":2546,"_20976":57392,"_5":14428,"_27536":57351,"_2958":57393},[],"Active root CA and `ca.pem`",{"_3475":2565,"_30304":2546,"_20976":57395,"_5":14428,"_27536":57351,"_2958":57396},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3475":2566,"_30304":2546,"_20976":57398,"_5":14428,"_27536":57351,"_2958":57399},[],"End-entity certificate and `device.crt`",{"_3475":2567,"_30304":2546,"_20976":57401,"_5":14428,"_27536":57351,"_2958":57402},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3475":2568,"_30304":2546,"_20976":57404,"_5":14428,"_27536":57351,"_2958":57405},[],"Private key `device.key`",{"_3475":2569,"_30304":2546,"_20976":57407,"_5":14428,"_27536":57351,"_2958":57408},[],"Its public key matches the one included in `device.crt`.",{"_3475":2570,"_30304":2546,"_20976":57410,"_5":14428,"_27536":57351,"_2958":57411},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3475":2571,"_30304":2546,"_20976":57413,"_5":14428,"_27536":57354,"_2958":57414},[],"To operate certificates, continue with Certificates and Validation.",{"_3475":2572,"_30304":2546,"_20976":57416,"_5":14428,"_27536":57354,"_2958":57417},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3475":2573,"_30304":2546,"_20976":57419,"_5":14428,"_27536":57354,"_2958":57420},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3475":2574,"_30304":2574,"_5":14780,"_2958":57422,"_30657":57423,"_20976":57424,"_27536":2574},"PKI troubleshooting",[49412,50887,54895,53470],[],{"_3475":2575,"_30304":2574,"_20976":57426,"_5":14428,"_27536":2574,"_2958":57427},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3475":2576,"_30304":2574,"_5":30654,"_20976":57429,"_27536":57430,"_2958":57431},[],"/docs/pr-preview/pr-65/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3475":2577,"_30304":2574,"_5":30654,"_20976":57433,"_27536":57434,"_2958":57435},[],"/docs/pr-preview/pr-65/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3475":2578,"_30304":2574,"_5":30654,"_20976":57437,"_27536":57438,"_2958":57439},[],"/docs/pr-preview/pr-65/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3475":2579,"_30304":2574,"_20976":57441,"_5":14428,"_27536":2574,"_2958":57442},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3475":2580,"_30304":2574,"_20976":57444,"_5":14428,"_27536":2574,"_2958":57445},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3475":2581,"_30304":2574,"_20976":57447,"_5":14428,"_27536":57430,"_2958":54521},[],{"_3475":2582,"_30304":2574,"_20976":57449,"_5":14428,"_27536":57430,"_2958":57450},[],"What to inspect",{"_3475":2583,"_30304":2574,"_20976":57452,"_5":14428,"_27536":57430,"_2958":49446},[],{"_3475":2584,"_30304":2574,"_20976":57454,"_5":14428,"_27536":57430,"_2958":53737},[],{"_3475":2585,"_30304":2574,"_20976":57456,"_5":14428,"_27536":57430,"_2958":57457},[],"Exists, is active and has usable dates.",{"_3475":2586,"_30304":2574,"_20976":57459,"_5":14428,"_27536":57430,"_2958":57460},[],"Authorities.",{"_3475":2587,"_30304":2574,"_20976":57462,"_5":14428,"_27536":57430,"_2958":57463},[],"Key",{"_3475":2588,"_30304":2574,"_20976":57465,"_5":14428,"_27536":57430,"_2958":57466},[],"The record has a usable private key and the engine can sign.",{"_3475":2589,"_30304":2574,"_20976":57468,"_5":14428,"_27536":57430,"_2958":57469},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3475":2590,"_30304":2574,"_20976":57471,"_5":14428,"_27536":57430,"_2958":57472},[],"CSR",{"_3475":2591,"_30304":2574,"_20976":57474,"_5":14428,"_27536":57430,"_2958":57475},[],"Correct PEM and verifiable signature.",{"_3475":2592,"_30304":2574,"_20976":57477,"_5":14428,"_27536":57430,"_2958":57478},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3475":2593,"_30304":2574,"_20976":57480,"_5":14428,"_27536":57430,"_2958":57481},[],"Profile",{"_3475":2594,"_30304":2574,"_20976":57483,"_5":14428,"_27536":57430,"_2958":57484},[],"Selected source, existing ID, allowed algorithm and size.",{"_3475":2595,"_30304":2574,"_20976":57486,"_5":14428,"_27536":57430,"_2958":57487},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3475":2596,"_30304":2574,"_20976":57489,"_5":14428,"_27536":57430,"_2958":54673},[],{"_3475":2597,"_30304":2574,"_20976":57491,"_5":14428,"_27536":57430,"_2958":57492},[],"Appropriate subject, SAN, usages and dates.",{"_3475":2598,"_30304":2574,"_20976":57494,"_5":14428,"_27536":57430,"_2958":57495},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3475":2599,"_30304":2574,"_20976":57497,"_5":14428,"_27536":57430,"_2958":57498},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3475":2600,"_30304":2574,"_20976":57500,"_5":14428,"_27536":57430,"_2958":57501},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3475":2601,"_30304":2574,"_20976":57503,"_5":14428,"_27536":57434,"_2958":57504},[],"Check each boundary independently:",{"_3475":2602,"_30304":2574,"_20976":57506,"_5":14428,"_27536":57434,"_2958":57507},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3475":2603,"_30304":2574,"_20976":57509,"_5":14428,"_27536":57434,"_2958":57510},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3475":2604,"_30304":2574,"_20976":57512,"_5":14428,"_27536":57434,"_2958":57513},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3475":2605,"_30304":2574,"_20976":57515,"_5":14428,"_27536":57434,"_2958":57516},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3475":2606,"_30304":2574,"_20976":57518,"_5":14428,"_27536":57434,"_2958":57519},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3475":2607,"_30304":2574,"_20976":57521,"_5":14428,"_27536":57434,"_2958":57522},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3475":2608,"_30304":2574,"_20976":57524,"_5":14428,"_27536":57438,"_2958":57525},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3475":2609,"_30304":2574,"_20976":57527,"_5":14428,"_27536":57438,"_2958":57528},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3475":2610,"_30304":2610,"_5":14780,"_2958":57530,"_30657":57531,"_20976":57532,"_27536":2610},"Security",[49412],[],{"_3475":2611,"_30304":2610,"_20976":57534,"_5":14428,"_27536":2610,"_2958":57535},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3475":2612,"_30304":2610,"_5":30654,"_20976":57537,"_27536":57538,"_2958":57539},[],"/docs/pr-preview/pr-65/security#report-a-vulnerability","Report a vulnerability",{"_3475":2613,"_30304":2610,"_5":30654,"_20976":57541,"_27536":57542,"_2958":57543},[],"/docs/pr-preview/pr-65/security#what-to-include-in-a-report","What to include in a report",{"_3475":2614,"_30304":2610,"_5":30654,"_20976":57545,"_27536":57546,"_2958":57547},[],"/docs/pr-preview/pr-65/security#supported-versions","Supported versions",{"_3475":2615,"_30304":2610,"_5":30654,"_20976":57549,"_27536":57550,"_2958":57551},[],"/docs/pr-preview/pr-65/security#responsible-disclosure","Responsible disclosure",{"_3475":2616,"_30304":2610,"_20976":57553,"_5":14428,"_27536":2610,"_2958":57554},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3475":2617,"_30304":2610,"_20976":57556,"_5":14428,"_27536":57538,"_2958":57557},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3475":2618,"_30304":2610,"_20976":57559,"_5":14428,"_27536":57538,"_2958":57560},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3475":2619,"_30304":2610,"_20976":57562,"_5":14428,"_27536":57538,"_2958":15047},[],{"_3475":2620,"_30304":2610,"_20976":57564,"_5":14428,"_27536":57538,"_2958":14987},[],{"_3475":2621,"_30304":2610,"_20976":57566,"_5":14428,"_27536":57538,"_2958":15034},[],{"_3475":2622,"_30304":2610,"_20976":57568,"_5":14428,"_27536":57538,"_2958":57569},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3475":2623,"_30304":2610,"_20976":57571,"_5":14428,"_27536":57538,"_2958":57572},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3475":2624,"_30304":2610,"_20976":57574,"_5":14428,"_27536":57542,"_2958":57575},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3475":2625,"_30304":2610,"_20976":57577,"_5":14428,"_27536":57542,"_2958":57578},[],"Do not include in the report:",{"_3475":2626,"_30304":2610,"_20976":57580,"_5":14428,"_27536":57542,"_2958":57581},[],"Credentials, tokens, or private keys",{"_3475":2627,"_30304":2610,"_20976":57583,"_5":14428,"_27536":57542,"_2958":57584},[],"Customer data or customer-identifiable information",{"_3475":2628,"_30304":2610,"_20976":57586,"_5":14428,"_27536":57542,"_2958":57587},[],"Confidential architecture or internal infrastructure details",{"_3475":2629,"_30304":2610,"_20976":57589,"_5":14428,"_27536":57546,"_2958":57590},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3475":2630,"_30304":2610,"_20976":57592,"_5":14428,"_27536":57546,"_2958":57593},[],"For upgrade guidance, see Upgrades.",{"_3475":2631,"_30304":2610,"_20976":57595,"_5":14428,"_27536":57550,"_2958":57596},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3475":2632,"_30304":2610,"_20976":57598,"_5":14428,"_27536":57550,"_2958":57599},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3475":2633,"_30304":2610,"_20976":57601,"_5":14428,"_27536":57550,"_2958":57602},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3475":2634,"_30304":2610,"_20976":57604,"_5":14428,"_27536":57550,"_2958":57605},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3475":2635,"_30304":2610,"_20976":57607,"_5":14428,"_27536":57550,"_2958":57608},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3475":2636,"_30304":2636,"_5":14780,"_2958":57610,"_30657":57611,"_20976":57613,"_27536":2636},"3.8.0 to 4.0.0",[49412,57612],"Upgrades",[],{"_3475":2637,"_30304":2636,"_20976":57615,"_5":14428,"_27536":2636,"_2958":57616},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3475":2638,"_30304":2636,"_5":30654,"_20976":57618,"_27536":57619,"_2958":57620},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3475":2639,"_30304":2636,"_5":30654,"_20976":57622,"_27536":57623,"_2958":57624},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3475":2640,"_30304":2636,"_5":30654,"_20976":57626,"_27536":57627,"_2958":57628},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3475":2641,"_30304":2636,"_5":30654,"_20976":57630,"_27536":57631,"_2958":57632},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3475":2642,"_30304":2636,"_5":30654,"_20976":57634,"_27536":57635,"_2958":57636},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3475":2643,"_30304":2636,"_5":30654,"_20976":57638,"_27536":57639,"_2958":57640},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3475":2644,"_30304":2636,"_5":30654,"_20976":57642,"_27536":57643,"_2958":57644},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3475":2645,"_30304":2636,"_5":30654,"_20976":57646,"_27536":57647,"_2958":57648},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3475":2646,"_30304":2636,"_5":30654,"_20976":57650,"_27536":57651,"_2958":57652},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3475":2647,"_30304":2636,"_5":30654,"_20976":57654,"_27536":57655,"_2958":57656},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3475":2648,"_30304":2636,"_5":30654,"_20976":57658,"_27536":57659,"_2958":57660},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3475":2649,"_30304":2636,"_5":30654,"_20976":57662,"_27536":57663,"_2958":57664},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3475":2650,"_30304":2636,"_5":30654,"_20976":57666,"_27536":57667,"_2958":57668},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3475":2651,"_30304":2636,"_5":30654,"_20976":57670,"_27536":57671,"_2958":57672},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3475":2652,"_30304":2636,"_5":30654,"_20976":57674,"_27536":57675,"_2958":57676},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3475":2653,"_30304":2636,"_5":30654,"_20976":57678,"_27536":57679,"_2958":57680},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3475":2654,"_30304":2636,"_5":30654,"_20976":57682,"_27536":57683,"_2958":57684},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3475":2655,"_30304":2636,"_5":30654,"_20976":57686,"_27536":57687,"_2958":57688},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3475":2656,"_30304":2636,"_5":30654,"_20976":57690,"_27536":57691,"_2958":57692},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3475":2657,"_30304":2636,"_5":30654,"_20976":57694,"_27536":57695,"_2958":57696},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3475":2658,"_30304":2636,"_5":30654,"_20976":57698,"_27536":57699,"_2958":57700},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3475":2659,"_30304":2636,"_5":30654,"_20976":57702,"_27536":57703,"_2958":57704},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3475":2660,"_30304":2636,"_5":30654,"_20976":57706,"_27536":57707,"_2958":57708},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3475":2661,"_30304":2636,"_5":30654,"_20976":57710,"_27536":57711,"_2958":57712},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3475":2662,"_30304":2636,"_5":30654,"_20976":57714,"_27536":57715,"_2958":57716},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3475":2663,"_30304":2636,"_5":30654,"_20976":57718,"_27536":57719,"_2958":57720},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3475":2664,"_30304":2636,"_5":30654,"_20976":57722,"_27536":57723,"_2958":57724},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3475":2665,"_30304":2636,"_5":30654,"_20976":57726,"_27536":57727,"_2958":57728},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3475":2666,"_30304":2636,"_5":30654,"_20976":57730,"_27536":57731,"_2958":57732},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3475":2667,"_30304":2636,"_5":30654,"_20976":57734,"_27536":57735,"_2958":57736},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3475":2668,"_30304":2636,"_5":30654,"_20976":57738,"_27536":57739,"_2958":57740},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3475":2669,"_30304":2636,"_5":30654,"_20976":57742,"_27536":57743,"_2958":57744},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3475":2670,"_30304":2636,"_5":30654,"_20976":57746,"_27536":57747,"_2958":57748},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3475":2671,"_30304":2636,"_5":30654,"_20976":57750,"_27536":57751,"_2958":57752},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3475":2672,"_30304":2636,"_5":30654,"_20976":57754,"_27536":57755,"_2958":57756},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3475":2673,"_30304":2636,"_5":30654,"_20976":57758,"_27536":57759,"_2958":57760},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3475":2674,"_30304":2636,"_5":30654,"_20976":57762,"_27536":57763,"_2958":57764},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3475":2675,"_30304":2636,"_5":30654,"_20976":57766,"_27536":57767,"_2958":57768},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3475":2676,"_30304":2636,"_5":30654,"_20976":57770,"_27536":57771,"_2958":57772},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3475":2677,"_30304":2636,"_5":30654,"_20976":57774,"_27536":57775,"_2958":57776},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3475":2678,"_30304":2636,"_5":30654,"_20976":57778,"_27536":57779,"_2958":53470},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3475":2679,"_30304":2636,"_5":30654,"_20976":57781,"_27536":57782,"_2958":57783},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3475":2680,"_30304":2636,"_5":30654,"_20976":57785,"_27536":57786,"_2958":57787},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3475":2681,"_30304":2636,"_20976":57789,"_5":14428,"_27536":2636,"_2958":57790},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3475":2682,"_30304":2636,"_20976":57792,"_5":14428,"_27536":2636,"_2958":57793},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3475":2683,"_30304":2636,"_20976":57795,"_5":14428,"_27536":2636,"_2958":57796},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3475":2684,"_30304":2636,"_20976":57798,"_5":14428,"_27536":2636,"_2958":57799},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3475":2685,"_30304":2636,"_20976":57801,"_5":14428,"_27536":2636,"_2958":57802},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3475":2686,"_30304":2636,"_20976":57804,"_5":14428,"_27536":2636,"_2958":57805},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3475":2687,"_30304":2636,"_20976":57807,"_5":14428,"_27536":2636,"_2958":57808},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3475":2688,"_30304":2636,"_20976":57810,"_5":14428,"_27536":57623,"_2958":57811},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3475":2689,"_30304":2636,"_20976":57813,"_5":14428,"_27536":57623,"_2958":57814},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3475":2690,"_30304":2636,"_20976":57816,"_5":14428,"_27536":57627,"_2958":57817},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3475":2691,"_30304":2636,"_20976":57819,"_5":14428,"_27536":57627,"_2958":57820},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3475":2692,"_30304":2636,"_20976":57822,"_5":14428,"_27536":57631,"_2958":57823},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3475":2693,"_30304":2636,"_20976":57825,"_5":14428,"_27536":57635,"_2958":57826},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3475":2694,"_30304":2636,"_20976":57828,"_5":14428,"_27536":57635,"_2958":57829},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3475":2695,"_30304":2636,"_20976":57831,"_5":14428,"_27536":57635,"_2958":57832},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3475":2696,"_30304":2636,"_20976":57834,"_5":14428,"_27536":57635,"_2958":57835},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3475":2697,"_30304":2636,"_20976":57837,"_5":14428,"_27536":57635,"_2958":57838},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3475":2698,"_30304":2636,"_20976":57840,"_5":14428,"_27536":57639,"_2958":57841},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3475":2699,"_30304":2636,"_20976":57843,"_5":14428,"_27536":57639,"_2958":57844},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3475":2700,"_30304":2636,"_20976":57846,"_5":14428,"_27536":57639,"_2958":57847},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3475":2701,"_30304":2636,"_20976":57849,"_5":14428,"_27536":57639,"_2958":57850},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3475":2702,"_30304":2636,"_20976":57852,"_5":14428,"_27536":57639,"_2958":57853},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3475":2703,"_30304":2636,"_20976":57855,"_5":14428,"_27536":57639,"_2958":57856},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3475":2704,"_30304":2636,"_20976":57858,"_5":14428,"_27536":57643,"_2958":57859},[],"Change",{"_3475":2705,"_30304":2636,"_20976":57861,"_5":14428,"_27536":57643,"_2958":57862},[],"Who is affected",{"_3475":2706,"_30304":2636,"_20976":57864,"_5":14428,"_27536":57643,"_2958":57865},[],"Severity",{"_3475":2707,"_30304":2636,"_20976":57867,"_5":14428,"_27536":57643,"_2958":56335},[],{"_3475":2708,"_30304":2636,"_20976":57869,"_5":14428,"_27536":57643,"_2958":57652},[],{"_3475":2709,"_30304":2636,"_20976":57871,"_5":14428,"_27536":57643,"_2958":57872},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3475":2710,"_30304":2636,"_20976":57874,"_5":14428,"_27536":57643,"_2958":57875},[],"High: KMS and VA start on empty volumes",{"_3475":2711,"_30304":2636,"_20976":57877,"_5":14428,"_27536":57643,"_2958":57878},[],"Copy the data into the new volumes",{"_3475":2712,"_30304":2636,"_20976":57880,"_5":14428,"_27536":57643,"_2958":57656},[],{"_3475":2713,"_30304":2636,"_20976":57882,"_5":14428,"_27536":57643,"_2958":57883},[],"Every Helm release",{"_3475":2714,"_30304":2636,"_20976":57885,"_5":14428,"_27536":57643,"_2958":57886},[],"High: `helm upgrade` fails",{"_3475":2715,"_30304":2636,"_20976":57888,"_5":14428,"_27536":57643,"_2958":57889},[],"Remove or rename legacy keys",{"_3475":2716,"_30304":2636,"_20976":57891,"_5":14428,"_27536":57643,"_2958":57660},[],{"_3475":2717,"_30304":2636,"_20976":57893,"_5":14428,"_27536":57643,"_2958":57894},[],"Every deployment",{"_3475":2718,"_30304":2636,"_20976":57896,"_5":14428,"_27536":57643,"_2958":57897},[],"High: without a bootstrap principal there is no administrator",{"_3475":2719,"_30304":2636,"_20976":57899,"_5":14428,"_27536":57643,"_2958":57900},[],"Configure `services.authz`",{"_3475":2720,"_30304":2636,"_20976":57902,"_5":14428,"_27536":57643,"_2958":57664},[],{"_3475":2721,"_30304":2636,"_20976":57904,"_5":14428,"_27536":57643,"_2958":57883},[],{"_3475":2722,"_30304":2636,"_20976":57906,"_5":14428,"_27536":57643,"_2958":57907},[],"High: `helm upgrade` fails on the old keys",{"_3475":2723,"_30304":2636,"_20976":57909,"_5":14428,"_27536":57643,"_2958":57910},[],"Move JWKS and roles into `services.authz`",{"_3475":2724,"_30304":2636,"_20976":57912,"_5":14428,"_27536":57643,"_2958":57684},[],{"_3475":2725,"_30304":2636,"_20976":57914,"_5":14428,"_27536":57643,"_2958":57915},[],"3.8.0 deployments with per-service databases",{"_3475":2726,"_30304":2636,"_20976":57917,"_5":14428,"_27536":57643,"_2958":57918},[],"High: services find no data, or a migration aborts",{"_3475":2727,"_30304":2636,"_20976":57920,"_5":14428,"_27536":57643,"_2958":57921},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3475":2728,"_30304":2636,"_20976":57923,"_5":14428,"_27536":57643,"_2958":57688},[],{"_3475":2729,"_30304":2636,"_20976":57925,"_5":14428,"_27536":57643,"_2958":57926},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3475":2730,"_30304":2636,"_20976":57928,"_5":14428,"_27536":57643,"_2958":57929},[],"High: the backend no longer starts with them",{"_3475":2731,"_30304":2636,"_20976":57931,"_5":14428,"_27536":57643,"_2958":57932},[],"Move to PostgreSQL before upgrading",{"_3475":2732,"_30304":2636,"_20976":57934,"_5":14428,"_27536":57643,"_2958":57732},[],{"_3475":2733,"_30304":2636,"_20976":57936,"_5":14428,"_27536":57643,"_2958":57937},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3475":2734,"_30304":2636,"_20976":57939,"_5":14428,"_27536":57643,"_2958":57940},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3475":2735,"_30304":2636,"_20976":57942,"_5":14428,"_27536":57643,"_2958":57943},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3475":2736,"_30304":2636,"_20976":57945,"_5":14428,"_27536":57643,"_2958":57946},[],"Webhooks with file references",{"_3475":2737,"_30304":2636,"_20976":57948,"_5":14428,"_27536":57643,"_2958":57949},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3475":2738,"_30304":2636,"_20976":57951,"_5":14428,"_27536":57643,"_2958":57952},[],"High: enrollments calling the webhook fail",{"_3475":2739,"_30304":2636,"_20976":57954,"_5":14428,"_27536":57643,"_2958":57955},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3475":2740,"_30304":2636,"_20976":57957,"_5":14428,"_27536":57643,"_2958":57668},[],{"_3475":2741,"_30304":2636,"_20976":57959,"_5":14428,"_27536":57643,"_2958":57960},[],"Releases with per-service identity overrides or mounted key material",{"_3475":2742,"_30304":2636,"_20976":57962,"_5":14428,"_27536":57643,"_2958":57963},[],"Medium: services cannot read their files",{"_3475":2743,"_30304":2636,"_20976":57965,"_5":14428,"_27536":57643,"_2958":57966},[],"Remove the overrides and fix volume ownership",{"_3475":2744,"_30304":2636,"_20976":57968,"_5":14428,"_27536":57643,"_2958":57672},[],{"_3475":2745,"_30304":2636,"_20976":57970,"_5":14428,"_27536":57643,"_2958":57971},[],"Releases that set `amqp.tls`",{"_3475":2746,"_30304":2636,"_20976":57973,"_5":14428,"_27536":57643,"_2958":57974},[],"Medium: clients connect to the wrong port",{"_3475":2747,"_30304":2636,"_20976":57976,"_5":14428,"_27536":57643,"_2958":57977},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3475":2748,"_30304":2636,"_20976":57979,"_5":14428,"_27536":57643,"_2958":57692},[],{"_3475":2749,"_30304":2636,"_20976":57981,"_5":14428,"_27536":57643,"_2958":57982},[],"Installations whose CA keys predate the KMS",{"_3475":2750,"_30304":2636,"_20976":57984,"_5":14428,"_27536":57643,"_2958":57985},[],"Medium: CA keys stay unmanaged",{"_3475":2751,"_30304":2636,"_20976":57987,"_5":14428,"_27536":57643,"_2958":57988},[],"Run the CA-to-KMS migration",{"_3475":2752,"_30304":2636,"_20976":57990,"_5":14428,"_27536":57643,"_2958":57991},[],"Receiver certificate verification",{"_3475":2753,"_30304":2636,"_20976":57993,"_5":14428,"_27536":57643,"_2958":57994},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3475":2754,"_30304":2636,"_20976":57996,"_5":14428,"_27536":57643,"_2958":57997},[],"Medium: credentials go to an unverified receiver",{"_3475":2755,"_30304":2636,"_20976":57999,"_5":14428,"_27536":57643,"_2958":58000},[],"Set `insecure_skip_verify` to `false`",{"_3475":2756,"_30304":2636,"_20976":58002,"_5":14428,"_27536":57643,"_2958":57708},[],{"_3475":2757,"_30304":2636,"_20976":58004,"_5":14428,"_27536":57643,"_2958":58005},[],"Scripts and consoles that edit DMSs through the API",{"_3475":2758,"_30304":2636,"_20976":58007,"_5":14428,"_27536":57643,"_2958":58008},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3475":2759,"_30304":2636,"_20976":58010,"_5":14428,"_27536":57643,"_2958":58011},[],"Read the DMS before editing and use the new field",{"_3475":2760,"_30304":2636,"_20976":58013,"_5":14428,"_27536":57643,"_2958":57728},[],{"_3475":2761,"_30304":2636,"_20976":58015,"_5":14428,"_27536":57643,"_2958":58016},[],"Clients that create or update CRL settings through the API",{"_3475":2762,"_30304":2636,"_20976":58018,"_5":14428,"_27536":57643,"_2958":58019},[],"Medium: requests with the old field return an error",{"_3475":2763,"_30304":2636,"_20976":58021,"_5":14428,"_27536":57643,"_2958":58022},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3475":2764,"_30304":2636,"_20976":58024,"_5":14428,"_27536":57643,"_2958":57736},[],{"_3475":2765,"_30304":2636,"_20976":58026,"_5":14428,"_27536":57643,"_2958":58027},[],"Alert subscriptions and consumers of the VA events",{"_3475":2766,"_30304":2636,"_20976":58029,"_5":14428,"_27536":57643,"_2958":58030},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3475":2767,"_30304":2636,"_20976":58032,"_5":14428,"_27536":57643,"_2958":58033},[],"Review conditions filtering on the old event payload or subject",{"_3475":2768,"_30304":2636,"_20976":58035,"_5":14428,"_27536":57643,"_2958":57724},[],{"_3475":2769,"_30304":2636,"_20976":58037,"_5":14428,"_27536":57643,"_2958":58038},[],"Consumers that read the device `events` field",{"_3475":2770,"_30304":2636,"_20976":58040,"_5":14428,"_27536":57643,"_2958":58041},[],"Medium: the field disappears",{"_3475":2771,"_30304":2636,"_20976":58043,"_5":14428,"_27536":57643,"_2958":58044},[],"Use the new event endpoints",{"_3475":2772,"_30304":2636,"_20976":58046,"_5":14428,"_27536":57643,"_2958":57744},[],{"_3475":2773,"_30304":2636,"_20976":58048,"_5":14428,"_27536":57643,"_2958":58049},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3475":2774,"_30304":2636,"_20976":58051,"_5":14428,"_27536":57643,"_2958":58052},[],"Medium: the VA migration aborts",{"_3475":2775,"_30304":2636,"_20976":58054,"_5":14428,"_27536":57643,"_2958":58055},[],"Fix the affected roles before upgrading",{"_3475":2776,"_30304":2636,"_20976":58057,"_5":14428,"_27536":57643,"_2958":57676},[],{"_3475":2777,"_30304":2636,"_20976":58059,"_5":14428,"_27536":57643,"_2958":58060},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3475":2778,"_30304":2636,"_20976":58062,"_5":14428,"_27536":57643,"_2958":58063},[],"Low to medium: validation errors or changed defaults",{"_3475":2779,"_30304":2636,"_20976":58065,"_5":14428,"_27536":57643,"_2958":58066},[],"Update the values file",{"_3475":2780,"_30304":2636,"_20976":58068,"_5":14428,"_27536":57643,"_2958":57716},[],{"_3475":2781,"_30304":2636,"_20976":58070,"_5":14428,"_27536":57643,"_2958":58071},[],"Clients that send the DMS ID in the update body",{"_3475":2782,"_30304":2636,"_20976":58073,"_5":14428,"_27536":57643,"_2958":58074},[],"Low: the ID in the URL wins",{"_3475":2783,"_30304":2636,"_20976":58076,"_5":14428,"_27536":57643,"_2958":58077},[],"Send the ID in the URL",{"_3475":2784,"_30304":2636,"_20976":58079,"_5":14428,"_27536":57643,"_2958":57740},[],{"_3475":2785,"_30304":2636,"_20976":58081,"_5":14428,"_27536":57643,"_2958":58082},[],"Clients that send an `id` when creating or importing CAs",{"_3475":2786,"_30304":2636,"_20976":58084,"_5":14428,"_27536":57643,"_2958":58085},[],"Low: the ID in the body is ignored, and the field is removed",{"_3475":2787,"_30304":2636,"_20976":58087,"_5":14428,"_27536":57643,"_2958":58088},[],"Let the backend assign the ID and use the returned one",{"_3475":2788,"_30304":2636,"_20976":58090,"_5":14428,"_27536":57643,"_2958":57720},[],{"_3475":2789,"_30304":2636,"_20976":58092,"_5":14428,"_27536":57643,"_2958":58093},[],"Consumers that match on certificate `type`",{"_3475":2790,"_30304":2636,"_20976":58095,"_5":14428,"_27536":57643,"_2958":58096},[],"Low: two values are renamed",{"_3475":2791,"_30304":2636,"_20976":58098,"_5":14428,"_27536":57643,"_2958":58099},[],"Adapt consumers",{"_3475":2792,"_30304":2636,"_20976":58101,"_5":14428,"_27536":57643,"_2958":57712},[],{"_3475":2793,"_30304":2636,"_20976":58103,"_5":14428,"_27536":57643,"_2958":58104},[],"Any DMS",{"_3475":2794,"_30304":2636,"_20976":58106,"_5":14428,"_27536":57643,"_2958":58107},[],"Low: informational",{"_3475":2795,"_30304":2636,"_20976":58109,"_5":14428,"_27536":57643,"_2958":58110},[],"Read both blocks before editing",{"_3475":2796,"_30304":2636,"_20976":58112,"_5":14428,"_27536":57651,"_2958":58113},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3475":2797,"_30304":2636,"_20976":58115,"_5":14428,"_27536":57651,"_2958":58116},[],"Step 4 of the migration guide copies the data.",{"_3475":2798,"_30304":2636,"_20976":58118,"_5":14428,"_27536":57655,"_2958":58119},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3475":2799,"_30304":2636,"_20976":58121,"_5":14428,"_27536":57659,"_2958":58122},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3475":2800,"_30304":2636,"_20976":58124,"_5":14428,"_27536":57663,"_2958":58125},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3475":2801,"_30304":2636,"_20976":58127,"_5":14428,"_27536":57667,"_2958":58128},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3475":2802,"_30304":2636,"_20976":58130,"_5":14428,"_27536":57667,"_2958":58131},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3475":2803,"_30304":2636,"_20976":58133,"_5":14428,"_27536":57671,"_2958":58134},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3475":2804,"_30304":2636,"_20976":58136,"_5":14428,"_27536":57675,"_2958":58137},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3475":2805,"_30304":2636,"_20976":58139,"_5":14428,"_27536":57675,"_2958":58140},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3475":2806,"_30304":2636,"_20976":58142,"_5":14428,"_27536":57675,"_2958":58143},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3475":2807,"_30304":2636,"_20976":58145,"_5":14428,"_27536":57675,"_2958":58146},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3475":2808,"_30304":2636,"_20976":58148,"_5":14428,"_27536":57675,"_2958":58149},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3475":2809,"_30304":2636,"_20976":58151,"_5":14428,"_27536":57675,"_2958":58152},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3475":2810,"_30304":2636,"_20976":58154,"_5":14428,"_27536":57683,"_2958":58155},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3475":2811,"_30304":2636,"_20976":58157,"_5":14428,"_27536":57683,"_2958":58158},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3475":2812,"_30304":2636,"_20976":58160,"_5":14428,"_27536":57683,"_2958":58161},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3475":2813,"_30304":2636,"_20976":58163,"_5":14428,"_27536":57683,"_2958":58164},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3475":2814,"_30304":2636,"_20976":58166,"_5":14428,"_27536":57683,"_2958":58167},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3475":2815,"_30304":2636,"_20976":58169,"_5":14428,"_27536":57687,"_2958":58170},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3475":2816,"_30304":2636,"_20976":58172,"_5":14428,"_27536":57691,"_2958":58173},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3475":2817,"_30304":2636,"_20976":58175,"_5":14428,"_27536":57691,"_2958":58176},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3475":2818,"_30304":2636,"_20976":58178,"_5":14428,"_27536":57691,"_2958":58179},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3475":2819,"_30304":2636,"_20976":58181,"_5":14428,"_27536":57691,"_2958":58182},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3475":2820,"_30304":2636,"_20976":58184,"_5":14428,"_27536":57691,"_2958":58185},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3475":2821,"_30304":2636,"_20976":58187,"_5":14428,"_27536":57691,"_2958":58188},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3475":2822,"_30304":2636,"_20976":58190,"_5":14428,"_27536":57691,"_2958":58191},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3475":2823,"_30304":2636,"_20976":58193,"_5":14428,"_27536":57691,"_2958":58194},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3475":2824,"_30304":2636,"_20976":58196,"_5":14428,"_27536":57695,"_2958":58197},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3475":2825,"_30304":2636,"_20976":58199,"_5":14428,"_27536":57703,"_2958":58200},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3475":2826,"_30304":2636,"_20976":58202,"_5":14428,"_27536":57703,"_2958":58203},[],"Field in 3.8.0",{"_3475":2827,"_30304":2636,"_20976":58205,"_5":14428,"_27536":57703,"_2958":58206},[],"Field in 4.0.0",{"_3475":2828,"_30304":2636,"_20976":58208,"_5":14428,"_27536":57703,"_2958":58209},[],"`validate_server_cert`",{"_3475":2829,"_30304":2636,"_20976":58211,"_5":14428,"_27536":57703,"_2958":58212},[],"`insecure_skip_verify` (value negated)",{"_3475":2830,"_30304":2636,"_20976":58214,"_5":14428,"_27536":57703,"_2958":58215},[],"`oidc`",{"_3475":2831,"_30304":2636,"_20976":58217,"_5":14428,"_27536":57703,"_2958":58218},[],"`jwt_options`",{"_3475":2832,"_30304":2636,"_20976":58220,"_5":14428,"_27536":57703,"_2958":58221},[],"`apikey`",{"_3475":2833,"_30304":2636,"_20976":58223,"_5":14428,"_27536":57703,"_2958":58224},[],"`apikey_options`",{"_3475":2834,"_30304":2636,"_20976":58226,"_5":14428,"_27536":57703,"_2958":58227},[],"`mtls`",{"_3475":2835,"_30304":2636,"_20976":58229,"_5":14428,"_27536":57703,"_2958":58230},[],"`mtls_options`",{"_3475":2836,"_30304":2636,"_20976":58232,"_5":14428,"_27536":57703,"_2958":58233},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3475":2837,"_30304":2636,"_20976":58235,"_5":14428,"_27536":57703,"_2958":58236},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3475":2838,"_30304":2636,"_20976":58238,"_5":14428,"_27536":57703,"_2958":58239},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3475":2839,"_30304":2636,"_20976":58241,"_5":14428,"_27536":57707,"_2958":58242},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3475":2840,"_30304":2636,"_20976":58244,"_5":14428,"_27536":57707,"_2958":58245},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3475":2841,"_30304":2636,"_20976":58247,"_5":14428,"_27536":57707,"_2958":58248},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3475":2842,"_30304":2636,"_20976":58250,"_5":14428,"_27536":57711,"_2958":58251},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3475":2843,"_30304":2636,"_20976":58253,"_5":14428,"_27536":57715,"_2958":58254},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3475":2844,"_30304":2636,"_20976":58256,"_5":14428,"_27536":57719,"_2958":58257},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3475":2845,"_30304":2636,"_20976":58259,"_5":14428,"_27536":57723,"_2958":58260},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3475":2846,"_30304":2636,"_20976":58262,"_5":14428,"_27536":57723,"_2958":58263},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3475":2847,"_30304":2636,"_20976":58265,"_5":14428,"_27536":57723,"_2958":58266},[],"`POST /v1/devices/:id/events` creates an event.",{"_3475":2848,"_30304":2636,"_20976":58268,"_5":14428,"_27536":57723,"_2958":58269},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3475":2849,"_30304":2636,"_20976":58271,"_5":14428,"_27536":57727,"_2958":58272},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3475":2850,"_30304":2636,"_20976":58274,"_5":14428,"_27536":57731,"_2958":58275},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3475":2851,"_30304":2636,"_20976":58277,"_5":14428,"_27536":57731,"_2958":58278},[],"Route",{"_3475":2852,"_30304":2636,"_20976":58280,"_5":14428,"_27536":57731,"_2958":52657},[],{"_3475":2853,"_30304":2636,"_20976":58282,"_5":14428,"_27536":57731,"_2958":58283},[],"`GET /v1/crl-settings`",{"_3475":2854,"_30304":2636,"_20976":58285,"_5":14428,"_27536":57731,"_2958":58286},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3475":2855,"_30304":2636,"_20976":58288,"_5":14428,"_27536":57731,"_2958":58289},[],"`GET /v1/crl-settings/{ca-id}`",{"_3475":2856,"_30304":2636,"_20976":58291,"_5":14428,"_27536":57731,"_2958":58292},[],"Reads the settings of a CA.",{"_3475":2857,"_30304":2636,"_20976":58294,"_5":14428,"_27536":57731,"_2958":58295},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3475":2858,"_30304":2636,"_20976":58297,"_5":14428,"_27536":57731,"_2958":58298},[],"Replaces `crl_options`.",{"_3475":2859,"_30304":2636,"_20976":58300,"_5":14428,"_27536":57731,"_2958":58301},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3475":2860,"_30304":2636,"_20976":58303,"_5":14428,"_27536":57731,"_2958":58304},[],"Removes the archived settings of a CA.",{"_3475":2861,"_30304":2636,"_20976":58306,"_5":14428,"_27536":57731,"_2958":58307},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3475":2862,"_30304":2636,"_20976":58309,"_5":14428,"_27536":57731,"_2958":58310},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3475":2863,"_30304":2636,"_20976":58312,"_5":14428,"_27536":57731,"_2958":58313},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3475":2864,"_30304":2636,"_20976":58315,"_5":14428,"_27536":57731,"_2958":58316},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3475":2865,"_30304":2636,"_20976":58318,"_5":14428,"_27536":57731,"_2958":58319},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3475":2866,"_30304":2636,"_20976":58321,"_5":14428,"_27536":57731,"_2958":58322},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3475":2867,"_30304":2636,"_20976":58324,"_5":14428,"_27536":57731,"_2958":58325},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3475":2868,"_30304":2636,"_20976":58327,"_5":14428,"_27536":57731,"_2958":58328},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3475":2869,"_30304":2636,"_20976":58330,"_5":14428,"_27536":57731,"_2958":58331},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3475":2870,"_30304":2636,"_20976":58333,"_5":14428,"_27536":57731,"_2958":58334},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3475":2871,"_30304":2636,"_20976":58336,"_5":14428,"_27536":57731,"_2958":58337},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3475":2872,"_30304":2636,"_20976":58339,"_5":14428,"_27536":57735,"_2958":58340},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3475":2873,"_30304":2636,"_20976":58342,"_5":14428,"_27536":57739,"_2958":58343},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3475":2874,"_30304":2636,"_20976":58345,"_5":14428,"_27536":57743,"_2958":58346},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3475":2875,"_30304":2636,"_20976":58348,"_5":14428,"_27536":57747,"_2958":58349},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3475":2876,"_30304":2636,"_20976":58351,"_5":14428,"_27536":57751,"_2958":58352},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3475":2877,"_30304":2636,"_20976":58354,"_5":14428,"_27536":57751,"_2958":58355},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3475":2878,"_30304":2636,"_20976":58357,"_5":14428,"_27536":57751,"_2958":58358},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3475":2879,"_30304":2636,"_20976":58360,"_5":14428,"_27536":57751,"_2958":58361},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3475":2880,"_30304":2636,"_20976":58363,"_5":14428,"_27536":57751,"_2958":58364},[],"Record the names of your local-storage PVCs:",{"_3475":2881,"_30304":2636,"_20976":58366,"_5":14428,"_27536":57751,"_2958":58367},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3475":2882,"_30304":2636,"_20976":58369,"_5":14428,"_27536":57755,"_2958":58370},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3475":2883,"_30304":2636,"_20976":58372,"_5":14428,"_27536":57755,"_2958":58373},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3475":2884,"_30304":2636,"_20976":58375,"_5":14428,"_27536":57755,"_2958":58376},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3475":2885,"_30304":2636,"_20976":58378,"_5":14428,"_27536":57755,"_2958":58379},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3475":2886,"_30304":2636,"_20976":58381,"_5":14428,"_27536":57755,"_2958":58382},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3475":2887,"_30304":2636,"_20976":58384,"_5":14428,"_27536":57759,"_2958":58385},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3475":2888,"_30304":2636,"_20976":58387,"_5":14428,"_27536":57759,"_2958":58388},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3475":2889,"_30304":2636,"_20976":58390,"_5":14428,"_27536":57759,"_2958":58391},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3475":2890,"_30304":2636,"_20976":58393,"_5":14428,"_27536":57759,"_2958":58394},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3475":2891,"_30304":2636,"_20976":58396,"_5":14428,"_27536":57759,"_2958":58397},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3475":2892,"_30304":2636,"_20976":58399,"_5":14428,"_27536":57759,"_2958":58400},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3475":2893,"_30304":2636,"_20976":58402,"_5":14428,"_27536":57759,"_2958":58403},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3475":2894,"_30304":2636,"_20976":58405,"_5":14428,"_27536":57759,"_2958":58406},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3475":2895,"_30304":2636,"_20976":58408,"_5":14428,"_27536":57759,"_2958":58409},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3475":2896,"_30304":2636,"_20976":58411,"_5":14428,"_27536":57759,"_2958":58412},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3475":2897,"_30304":2636,"_20976":58414,"_5":14428,"_27536":57759,"_2958":58415},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3475":2898,"_30304":2636,"_20976":58417,"_5":14428,"_27536":57759,"_2958":58418},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3475":2899,"_30304":2636,"_20976":58420,"_5":14428,"_27536":57763,"_2958":58421},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3475":2900,"_30304":2636,"_20976":58423,"_5":14428,"_27536":57763,"_2958":58424},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3475":2901,"_30304":2636,"_20976":58426,"_5":14428,"_27536":57767,"_2958":58427},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3475":2902,"_30304":2636,"_20976":58429,"_5":14428,"_27536":57767,"_2958":58430},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3475":2903,"_30304":2636,"_20976":58432,"_5":14428,"_27536":57767,"_2958":58433},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3475":2904,"_30304":2636,"_20976":58435,"_5":14428,"_27536":57767,"_2958":58436},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3475":2905,"_30304":2636,"_20976":58438,"_5":14428,"_27536":57767,"_2958":58439},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3475":2906,"_30304":2636,"_20976":58441,"_5":14428,"_27536":57767,"_2958":58442},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3475":2907,"_30304":2636,"_20976":58444,"_5":14428,"_27536":57767,"_2958":58445},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3475":2908,"_30304":2636,"_20976":58447,"_5":14428,"_27536":57767,"_2958":58448},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3475":2909,"_30304":2636,"_20976":58450,"_5":14428,"_27536":57767,"_2958":58451},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3475":2910,"_30304":2636,"_20976":58453,"_5":14428,"_27536":57767,"_2958":58454},[],"**Remove the helper and restore the recorded replica counts:**",{"_3475":2911,"_30304":2636,"_20976":58456,"_5":14428,"_27536":57767,"_2958":58457},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3475":2912,"_30304":2636,"_20976":58459,"_5":14428,"_27536":57771,"_2958":58460},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3475":2913,"_30304":2636,"_20976":58462,"_5":14428,"_27536":57771,"_2958":58463},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3475":2914,"_30304":2636,"_20976":58465,"_5":14428,"_27536":57775,"_2958":58466},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3475":2915,"_30304":2636,"_20976":58468,"_5":14428,"_27536":57775,"_2958":58469},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3475":2916,"_30304":2636,"_20976":58471,"_5":14428,"_27536":57775,"_2958":58472},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3475":2917,"_30304":2636,"_20976":58474,"_5":14428,"_27536":57775,"_2958":58475},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3475":2918,"_30304":2636,"_20976":58477,"_5":14428,"_27536":57775,"_2958":58478},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3475":2919,"_30304":2636,"_20976":58480,"_5":14428,"_27536":57775,"_2958":58481},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3475":2920,"_30304":2636,"_20976":58483,"_5":14428,"_27536":57775,"_2958":58484},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3475":2921,"_30304":2636,"_20976":58486,"_5":14428,"_27536":57775,"_2958":58487},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3475":2922,"_30304":2636,"_20976":58489,"_5":14428,"_27536":57779,"_2958":58490},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3475":2923,"_30304":2636,"_20976":58492,"_5":14428,"_27536":57779,"_2958":58493},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3475":2924,"_30304":2636,"_20976":58495,"_5":14428,"_27536":57779,"_2958":58496},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3475":2925,"_30304":2636,"_20976":58498,"_5":14428,"_27536":57779,"_2958":58499},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3475":2926,"_30304":2636,"_20976":58501,"_5":14428,"_27536":57779,"_2958":58502},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3475":2927,"_30304":2636,"_20976":58504,"_5":14428,"_27536":57779,"_2958":58505},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3475":2928,"_30304":2636,"_20976":58507,"_5":14428,"_27536":57779,"_2958":58508},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3475":2929,"_30304":2636,"_20976":58510,"_5":14428,"_27536":57779,"_2958":58511},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3475":2930,"_30304":2636,"_20976":58513,"_5":14428,"_27536":57779,"_2958":58514},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3475":2931,"_30304":2636,"_20976":58516,"_5":14428,"_27536":57779,"_2958":58517},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3475":2932,"_30304":2636,"_20976":58519,"_5":14428,"_27536":57779,"_2958":58520},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3475":2933,"_30304":2636,"_20976":58522,"_5":14428,"_27536":57782,"_2958":58523},[],"After the upgrade, check in this order:",{"_3475":2934,"_30304":2636,"_20976":58525,"_5":14428,"_27536":57782,"_2958":58526},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3475":2935,"_30304":2636,"_20976":58528,"_5":14428,"_27536":57782,"_2958":58529},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3475":2936,"_30304":2636,"_20976":58531,"_5":14428,"_27536":57782,"_2958":58532},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3475":2937,"_30304":2636,"_20976":58534,"_5":14428,"_27536":57782,"_2958":58535},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3475":2938,"_30304":2636,"_20976":58537,"_5":14428,"_27536":57782,"_2958":58538},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3475":2939,"_30304":2636,"_20976":58540,"_5":14428,"_27536":57782,"_2958":58541},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3475":2940,"_30304":2636,"_20976":58543,"_5":14428,"_27536":57782,"_2958":58544},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3475":2941,"_30304":2636,"_20976":58546,"_5":14428,"_27536":57782,"_2958":58547},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3475":2942,"_30304":2636,"_20976":58549,"_5":14428,"_27536":57782,"_2958":58550},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3475":2943,"_30304":2636,"_20976":58552,"_5":14428,"_27536":57782,"_2958":58553},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3475":2944,"_30304":2636,"_20976":58555,"_5":14428,"_27536":57782,"_2958":58556},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3475":2945,"_30304":2636,"_20976":58558,"_5":14428,"_27536":57782,"_2958":58559},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3475":2946,"_30304":2636,"_20976":58561,"_5":14428,"_27536":57782,"_2958":58562},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3475":2947,"_30304":2636,"_20976":58564,"_5":14428,"_27536":57782,"_2958":58565},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3475":2948,"_30304":2636,"_20976":58567,"_5":14428,"_27536":57782,"_2958":58568},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3475":2949,"_30304":2636,"_20976":58570,"_5":14428,"_27536":57786,"_2958":58571},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3475":2950,"_30304":2636,"_20976":58573,"_5":14428,"_27536":57786,"_2958":58574},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3475":2951,"_30304":2636,"_20976":58576,"_5":14428,"_27536":57786,"_2958":58577},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3475":2952,"_30304":2636,"_20976":58579,"_5":14428,"_27536":57786,"_2958":58580},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3475":2953,"_30304":2636,"_20976":58582,"_5":14428,"_27536":57786,"_2958":58583},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58586":58587,"_58588":58589,"_58590":58591,"_58592":58593,"_18188":2993,"_70363":2993},"language","english","sortableProperties",[2958,30304,5,27536],"sortablePropertiesWithTypes",{"_2958":25085,"_30304":25085,"_5":25085,"_27536":25085},"sorts",{"_2958":58594,"_30304":61537,"_5":64479,"_27536":67421},{"_4667":58595,"_58596":58597,"_5":25085},{"_14504":6984,"_14879":4407,"_14898":3213,"_29307":3656,"_14885":5851,"_19908":14350,"_14525":14468,"_14532":3657,"_29249":4696,"_29658":7282,"_29679":5339,"_29283":4732,"_34646":5979,"_29386":7540,"_29723":4958,"_34653":4809,"_34656":10179,"_34659":4672,"_34662":4470,"_30130":6527,"_34667":4625,"_34669":7607,"_30160":4597,"_14894":18213,"_34673":3339,"_34676":4508,"_34678":6218,"_29707":6997,"_30125":5062,"_30173":5008,"_34683":7679,"_34685":3349,"_34687":4772,"_29403":3058,"_34690":6732,"_34692":7588,"_34694":7305,"_34696":3665,"_34698":4305,"_29320":4424,"_34701":17983,"_34703":3444,"_29314":3037,"_29744":3419,"_34707":7230,"_34709":4108,"_34712":7710,"_29360":6164,"_34716":5188,"_29240":4742,"_34719":11923,"_29288":5181,"_34722":7018,"_34724":24884,"_34727":5182,"_14888":7585,"_34730":9065,"_34732":7037,"_34735":10510,"_34737":4631,"_34739":6039,"_34741":3826,"_34743":11247,"_19911":5203,"_30363":3275,"_34747":7425,"_29261":3658,"_29701":7529,"_34751":7509,"_34753":8592,"_34755":4750,"_30190":12520,"_3475