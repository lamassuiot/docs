0":58415,"_40422":58418,"_40424":58421,"_40426":58424,"_40428":58427,"_40430":58430,"_40432":58433,"_40434":58436,"_40436":58439,"_40438":58442,"_40440":58445,"_40442":58448,"_40444":58451,"_40447":58454,"_40449":58457,"_40451":58460,"_40453":58463,"_40455":58466,"_40457":58469,"_40459":58472,"_40461":58475,"_40463":58478,"_40465":58481,"_40467":58484,"_40470":58487,"_40472":58490,"_40474":58493,"_40476":58496,"_40478":58498,"_40480":58501,"_40482":58504,"_40484":58507,"_40486":58510,"_40488":58513,"_40490":58516,"_40492":58519,"_40494":58522,"_40496":58525,"_40499":58528,"_40502":58531,"_40504":58534,"_40506":58537,"_40508":58540,"_40510":58543,"_40512":58546,"_40514":58549,"_40516":58552,"_40519":58555,"_40522":58558,"_40524":58561,"_40526":58564,"_40528":58567,"_40530":58570,"_40532":58573,"_40534":58576,"_40536":58579,"_40538":58582,"_40540":58585,"_40542":58588,"_40544":58591,"_40546":58594,"_40548":58597,"_40550":58600,"_40552":58603,"_40554":58606,"_40556":58609,"_40558":58612,"_40560":58615,"_40562":58618,"_40564":58621,"_40566":58624,"_40568":58627,"_40570":58630,"_40572":58633,"_40574":58636,"_40576":58639,"_40578":58642,"_40580":58645,"_40582":58648,"_40585":58651,"_40587":58654,"_40589":58657,"_40591":58660,"_40593":58663,"_40595":58666,"_40597":58669,"_40599":58672,"_40601":58675,"_40603":58678,"_40605":58681,"_40607":58684,"_40609":58687,"_40611":58690,"_40614":58693,"_40616":58696,"_40618":58699,"_40620":58702,"_40622":58705,"_40624":58708,"_40627":58711,"_40629":58714,"_40631":58717,"_40633":58720,"_40635":58723,"_40637":58726,"_40639":58729,"_40641":58732,"_40643":58735,"_40645":58738,"_40647":58741,"_40649":58744,"_40651":58747,"_40653":58750,"_40655":58753,"_40657":58756,"_40659":58759,"_40661":58762,"_40663":58765,"_40665":58768,"_40667":58771,"_40669":58774,"_40671":58777,"_40673":58780,"_40675":58783,"_40677":58786,"_40680":58789,"_40682":58792,"_40684":58795,"_40686":58798},{"_3483":15,"_30444":15,"_5":14831,"_2966":49602,"_30797":49603,"_21068":49607,"_27672":15},"Deploy from AWS Marketplace",[49604,49605,49606],"Docs","Deployment","Other models",[],{"_3483":16,"_30444":15,"_21068":49609,"_5":14479,"_27672":15,"_2966":49610},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3483":17,"_30444":15,"_5":30794,"_21068":49612,"_27672":49613,"_2966":49614},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3483":18,"_30444":15,"_5":30794,"_21068":49616,"_27672":49617,"_2966":49618},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3483":19,"_30444":15,"_5":30794,"_21068":49620,"_27672":49621,"_2966":49622},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3483":20,"_30444":15,"_5":30794,"_21068":49624,"_27672":49625,"_2966":49626},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3483":21,"_30444":15,"_5":30794,"_21068":49628,"_27672":49629,"_2966":49630},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3483":22,"_30444":15,"_5":30794,"_21068":49632,"_27672":49633,"_2966":49634},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3483":23,"_30444":15,"_5":30794,"_21068":49636,"_27672":49637,"_2966":49638},[],"/docs/pr-preview/pr-65/deployment/aws-marketplace#next-step","Next step",{"_3483":24,"_30444":15,"_21068":49640,"_5":14479,"_27672":15,"_2966":49641},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3483":25,"_30444":15,"_21068":49643,"_5":14479,"_27672":49613,"_2966":49644},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3483":26,"_30444":15,"_21068":49646,"_5":14479,"_27672":49613,"_2966":49647},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3483":27,"_30444":15,"_21068":49649,"_5":14479,"_27672":49613,"_2966":49650},[],"A security group allowing the necessary endpoints.",{"_3483":28,"_30444":15,"_21068":49652,"_5":14479,"_27672":49617,"_2966":49653},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3483":29,"_30444":15,"_21068":49655,"_5":14479,"_27672":49617,"_2966":49656},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3483":30,"_30444":15,"_21068":49658,"_5":14479,"_27672":49617,"_2966":49659},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3483":31,"_30444":15,"_21068":49661,"_5":14479,"_27672":49621,"_2966":49662},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3483":32,"_30444":15,"_21068":49664,"_5":14479,"_27672":49625,"_2966":49665},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3483":33,"_30444":15,"_21068":49667,"_5":14479,"_27672":49629,"_2966":49668},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3483":34,"_30444":15,"_21068":49670,"_5":14479,"_27672":49633,"_2966":49671},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3483":35,"_30444":15,"_21068":49673,"_5":14479,"_27672":49637,"_2966":49674},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3483":36,"_30444":36,"_5":14831,"_2966":49676,"_30797":49677,"_21068":49678,"_27672":36},"Deploy Lamassu",[49604,49605],[],{"_3483":37,"_30444":36,"_21068":49680,"_5":14479,"_27672":36,"_2966":49681},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3483":38,"_30444":36,"_5":30794,"_21068":49683,"_27672":49684,"_2966":49685},[],"/docs/pr-preview/pr-65/deployment/overview#choose-a-model","Choose a model",{"_3483":39,"_30444":36,"_5":30794,"_21068":49687,"_27672":49688,"_2966":49689},[],"/docs/pr-preview/pr-65/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3483":40,"_30444":36,"_5":30794,"_21068":49691,"_27672":49692,"_2966":49693},[],"/docs/pr-preview/pr-65/deployment/overview#after-deployment","After deployment",{"_3483":41,"_30444":36,"_21068":49695,"_5":14479,"_27672":36,"_2966":49696},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3483":42,"_30444":36,"_21068":49698,"_5":14479,"_27672":49684,"_2966":49699},[],"Model",{"_3483":43,"_30444":36,"_21068":49701,"_5":14479,"_27672":49684,"_2966":49702},[],"Recommended for",{"_3483":44,"_30444":36,"_21068":49704,"_5":14479,"_27672":49684,"_2966":49705},[],"Who operates the infrastructure",{"_3483":45,"_30444":36,"_21068":49707,"_5":14479,"_27672":49684,"_2966":49708},[],"Starting point",{"_3483":46,"_30444":36,"_21068":49710,"_5":14479,"_27672":49684,"_2966":49711},[],"Kubernetes self-managed",{"_3483":47,"_30444":36,"_21068":49713,"_5":14479,"_27672":49684,"_2966":49714},[],"Production, regulated environments and custom deployments",{"_3483":48,"_30444":36,"_21068":49716,"_5":14479,"_27672":49684,"_2966":49717},[],"Your team",{"_3483":49,"_30444":36,"_21068":49719,"_5":14479,"_27672":49684,"_2966":49720},[],"Helm or Fastlane",{"_3483":50,"_30444":36,"_21068":49722,"_5":14479,"_27672":49684,"_2966":49723},[],"AWS Marketplace",{"_3483":51,"_30444":36,"_21068":49725,"_5":14479,"_27672":49684,"_2966":49726},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3483":52,"_30444":36,"_21068":49728,"_5":14479,"_27672":49684,"_2966":49717},[],{"_3483":53,"_30444":36,"_21068":49730,"_5":14479,"_27672":49684,"_2966":49731},[],"Preconfigured image on EC2",{"_3483":54,"_30444":36,"_21068":49733,"_5":14479,"_27672":49684,"_2966":49734},[],"SaaS",{"_3483":55,"_30444":36,"_21068":49736,"_5":14479,"_27672":49684,"_2966":49737},[],"Teams that want to use the platform without operating it",{"_3483":56,"_30444":36,"_21068":49739,"_5":14479,"_27672":49684,"_2966":49740},[],"Lamassu",{"_3483":57,"_30444":36,"_21068":49742,"_5":14479,"_27672":49684,"_2966":49743},[],"Managed subscription",{"_3483":58,"_30444":36,"_21068":49745,"_5":14479,"_27672":49684,"_2966":49746},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3483":59,"_30444":36,"_21068":49748,"_5":14479,"_27672":49684,"_2966":49749},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3483":60,"_30444":36,"_21068":49751,"_5":14479,"_27672":49684,"_2966":49752},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3483":61,"_30444":36,"_21068":49754,"_5":14479,"_27672":49688,"_2966":49755},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3483":62,"_30444":36,"_21068":49757,"_5":14479,"_27672":49692,"_2966":49758},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3483":63,"_30444":63,"_5":14831,"_2966":49760,"_30797":49761,"_21068":49762,"_27672":63},"Use Lamassu as SaaS",[49604,49605,49606],[],{"_3483":64,"_30444":63,"_21068":49764,"_5":14479,"_27672":63,"_2966":49765},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3483":65,"_30444":63,"_5":30794,"_21068":49767,"_27672":49768,"_2966":49769},[],"/docs/pr-preview/pr-65/deployment/saas#what-the-service-manages","What the service manages",{"_3483":66,"_30444":63,"_5":30794,"_21068":49771,"_27672":49772,"_2966":49773},[],"/docs/pr-preview/pr-65/deployment/saas#plans","Plans",{"_3483":67,"_30444":63,"_5":30794,"_21068":49775,"_27672":49776,"_2966":49777},[],"/docs/pr-preview/pr-65/deployment/saas#request-access","Request access",{"_3483":68,"_30444":63,"_21068":49779,"_5":14479,"_27672":63,"_2966":49780},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3483":69,"_30444":63,"_21068":49782,"_5":14479,"_27672":49768,"_2966":49783},[],"Platform availability and maintenance.",{"_3483":70,"_30444":63,"_21068":49785,"_5":14479,"_27672":49768,"_2966":49786},[],"Automatic backups.",{"_3483":71,"_30444":63,"_21068":49788,"_5":14479,"_27672":49768,"_2966":49789},[],"Version upgrades.",{"_3483":72,"_30444":63,"_21068":49791,"_5":14479,"_27672":49768,"_2966":49792},[],"Technical support and SLA according to your plan.",{"_3483":73,"_30444":63,"_21068":49794,"_5":14479,"_27672":49772,"_2966":49795},[],"Plan",{"_3483":74,"_30444":63,"_21068":49797,"_5":14479,"_27672":49772,"_2966":49798},[],"Devices",{"_3483":75,"_30444":63,"_21068":49800,"_5":14479,"_27672":49772,"_2966":49801},[],"Support",{"_3483":76,"_30444":63,"_21068":49803,"_5":14479,"_27672":49772,"_2966":49804},[],"SLA",{"_3483":77,"_30444":63,"_21068":49806,"_5":14479,"_27672":49772,"_2966":49807},[],"Starter",{"_3483":78,"_30444":63,"_21068":49809,"_5":14479,"_27672":49772,"_2966":49810},[],"Up to 1,000",{"_3483":79,"_30444":63,"_21068":49812,"_5":14479,"_27672":49772,"_2966":49813},[],"Email",{"_3483":80,"_30444":63,"_21068":49815,"_5":14479,"_27672":49772,"_2966":49816},[],"99.5 %",{"_3483":81,"_30444":63,"_21068":49818,"_5":14479,"_27672":49772,"_2966":49819},[],"Professional",{"_3483":82,"_30444":63,"_21068":49821,"_5":14479,"_27672":49772,"_2966":49822},[],"Up to 10,000",{"_3483":83,"_30444":63,"_21068":49824,"_5":14479,"_27672":49772,"_2966":49825},[],"Email and chat",{"_3483":84,"_30444":63,"_21068":49827,"_5":14479,"_27672":49772,"_2966":49828},[],"99.9 %",{"_3483":85,"_30444":63,"_21068":49830,"_5":14479,"_27672":49772,"_2966":49831},[],"Enterprise",{"_3483":86,"_30444":63,"_21068":49833,"_5":14479,"_27672":49772,"_2966":49834},[],"Unlimited",{"_3483":87,"_30444":63,"_21068":49836,"_5":14479,"_27672":49772,"_2966":49837},[],"Dedicated",{"_3483":88,"_30444":63,"_21068":49839,"_5":14479,"_27672":49772,"_2966":49840},[],"99.99 %",{"_3483":89,"_30444":63,"_21068":49842,"_5":14479,"_27672":49776,"_2966":49843},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3483":90,"_30444":63,"_21068":49845,"_5":14479,"_27672":49776,"_2966":49846},[],"When you receive your instance's credentials, continue with Get started.",{"_3483":91,"_30444":91,"_5":14831,"_2966":49848,"_30797":49849,"_21068":49850,"_27672":91},"Fastlane",[49604,49605,49711],[],{"_3483":92,"_30444":91,"_21068":49852,"_5":14479,"_27672":91,"_2966":49853},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3483":93,"_30444":91,"_5":30794,"_21068":49855,"_27672":49856,"_2966":49857},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3483":94,"_30444":91,"_5":30794,"_21068":49859,"_27672":49860,"_2966":49861},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3483":95,"_30444":91,"_5":30794,"_21068":49863,"_27672":49864,"_2966":49614},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#before-you-begin",{"_3483":96,"_30444":91,"_5":30794,"_21068":49866,"_27672":49867,"_2966":49868},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3483":97,"_30444":91,"_5":30794,"_21068":49870,"_27672":49871,"_2966":49872},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3483":98,"_30444":91,"_5":30794,"_21068":49874,"_27672":49875,"_2966":49876},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3483":99,"_30444":91,"_5":30794,"_21068":49878,"_27672":49879,"_2966":49880},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3483":100,"_30444":91,"_5":30794,"_21068":49882,"_27672":49883,"_2966":49884},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3483":101,"_30444":91,"_5":30794,"_21068":49886,"_27672":49887,"_2966":49888},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3483":102,"_30444":91,"_5":30794,"_21068":49890,"_27672":49891,"_2966":49892},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3483":103,"_30444":91,"_5":30794,"_21068":49894,"_27672":49895,"_2966":49896},[],"/docs/pr-preview/pr-65/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3483":104,"_30444":91,"_21068":49898,"_5":14479,"_27672":49856,"_2966":49899},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3483":105,"_30444":91,"_21068":49901,"_5":14479,"_27672":49856,"_2966":49902},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3483":106,"_30444":91,"_21068":49904,"_5":14479,"_27672":49860,"_2966":49905},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3483":107,"_30444":91,"_21068":49907,"_5":14479,"_27672":49860,"_2966":49908},[],"Fastlane installs or configures",{"_3483":108,"_30444":91,"_21068":49910,"_5":14479,"_27672":49860,"_2966":49911},[],"You still provide",{"_3483":109,"_30444":91,"_21068":49913,"_5":14479,"_27672":49860,"_2966":49914},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3483":110,"_30444":91,"_21068":49916,"_5":14479,"_27672":49860,"_2966":49917},[],"The Kubernetes cluster, nodes and persistent storage",{"_3483":111,"_30444":91,"_21068":49919,"_5":14479,"_27672":49860,"_2966":49920},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3483":112,"_30444":91,"_21068":49922,"_5":14479,"_27672":49860,"_2966":49923},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3483":113,"_30444":91,"_21068":49925,"_5":14479,"_27672":49860,"_2966":49926},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3483":114,"_30444":91,"_21068":49928,"_5":14479,"_27672":49860,"_2966":49929},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3483":115,"_30444":91,"_21068":49931,"_5":14479,"_27672":49860,"_2966":49932},[],"Optional observability and lab HSM components",{"_3483":116,"_30444":91,"_21068":49934,"_5":14479,"_27672":49860,"_2966":49935},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3483":117,"_30444":91,"_21068":49937,"_5":14479,"_27672":49860,"_2966":49938},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3483":118,"_30444":91,"_21068":49940,"_5":14479,"_27672":49864,"_2966":49941},[],"You need:",{"_3483":119,"_30444":91,"_21068":49943,"_5":14479,"_27672":49864,"_2966":49944},[],"an existing Kubernetes cluster",{"_3483":120,"_30444":91,"_21068":49946,"_5":14479,"_27672":49864,"_2966":49947},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3483":121,"_30444":91,"_21068":49949,"_5":14479,"_27672":49864,"_2966":49950},[],"`yq`",{"_3483":122,"_30444":91,"_21068":49952,"_5":14479,"_27672":49864,"_2966":23824},[],{"_3483":123,"_30444":91,"_21068":49954,"_5":14479,"_27672":49864,"_2966":49955},[],"`jq` only when using `--sample-data` or `--development`",{"_3483":124,"_30444":91,"_21068":49957,"_5":14479,"_27672":49864,"_2966":49958},[],"`ssh-keygen` only when using `--with-hsm`",{"_3483":125,"_30444":91,"_21068":49960,"_5":14479,"_27672":49864,"_2966":49961},[],"free external ports 80 and 443 on a single-node K3s host",{"_3483":126,"_30444":91,"_21068":49963,"_5":14479,"_27672":49864,"_2966":49964},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3483":127,"_30444":91,"_21068":49966,"_5":14479,"_27672":49864,"_2966":49967},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3483":128,"_30444":91,"_21068":49969,"_5":14479,"_27672":49867,"_2966":49970},[],"Run the script from a clone of the Helm repository:",{"_3483":129,"_30444":91,"_21068":49972,"_5":14479,"_27672":49867,"_2966":49973},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3483":130,"_30444":91,"_21068":49975,"_5":14479,"_27672":49871,"_2966":49976},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3483":131,"_30444":91,"_21068":49978,"_5":14479,"_27672":49871,"_2966":49979},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3483":132,"_30444":91,"_21068":49981,"_5":14479,"_27672":49871,"_2966":49982},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3483":133,"_30444":91,"_21068":49984,"_5":14479,"_27672":49871,"_2966":49985},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3483":134,"_30444":91,"_21068":49987,"_5":14479,"_27672":49875,"_2966":49988},[],"Option",{"_3483":135,"_30444":91,"_21068":49990,"_5":14479,"_27672":49875,"_2966":49991},[],"Default",{"_3483":136,"_30444":91,"_21068":49993,"_5":14479,"_27672":49875,"_2966":49994},[],"Purpose",{"_3483":137,"_30444":91,"_21068":49996,"_5":14479,"_27672":49875,"_2966":49997},[],"`-h`, `--help`",{"_3483":138,"_30444":91,"_21068":49999,"_5":14479,"_27672":49875,"_2966":50000},[],"—",{"_3483":139,"_30444":91,"_21068":50002,"_5":14479,"_27672":49875,"_2966":50003},[],"Show help",{"_3483":140,"_30444":91,"_21068":50005,"_5":14479,"_27672":49875,"_2966":50006},[],"`-c`, `--context`",{"_3483":141,"_30444":91,"_21068":50008,"_5":14479,"_27672":49875,"_2966":50009},[],"current context",{"_3483":142,"_30444":91,"_21068":50011,"_5":14479,"_27672":49875,"_2966":50012},[],"Select the kubeconfig context for kubectl and Helm",{"_3483":143,"_30444":91,"_21068":50014,"_5":14479,"_27672":49875,"_2966":50015},[],"`-n`, `--non-interactive`",{"_3483":144,"_30444":91,"_21068":50017,"_5":14479,"_27672":49875,"_2966":6610},[],{"_3483":145,"_30444":91,"_21068":50019,"_5":14479,"_27672":49875,"_2966":50020},[],"Skip prompts and generate dependency credentials",{"_3483":146,"_30444":91,"_21068":50022,"_5":14479,"_27672":49875,"_2966":50023},[],"`-ns`, `--namespace`",{"_3483":147,"_30444":91,"_21068":50025,"_5":14479,"_27672":49875,"_2966":50026},[],"`lamassu-dev`",{"_3483":148,"_30444":91,"_21068":50028,"_5":14479,"_27672":49875,"_2966":50029},[],"Namespace for the installation",{"_3483":149,"_30444":91,"_21068":50031,"_5":14479,"_27672":49875,"_2966":50032},[],"`-d`, `--domain`",{"_3483":150,"_30444":91,"_21068":50034,"_5":14479,"_27672":49875,"_2966":50035},[],"`dev.lamassu.io`",{"_3483":151,"_30444":91,"_21068":50037,"_5":14479,"_27672":49875,"_2966":50038},[],"Domain used by the UI, OIDC and certificate",{"_3483":152,"_30444":91,"_21068":50040,"_5":14479,"_27672":49875,"_2966":50041},[],"`-v`, `--version`",{"_3483":153,"_30444":91,"_21068":50043,"_5":14479,"_27672":49875,"_2966":15183},[],{"_3483":154,"_30444":91,"_21068":50045,"_5":14479,"_27672":49875,"_2966":50046},[],"Lamassu chart version",{"_3483":155,"_30444":91,"_21068":50048,"_5":14479,"_27672":49875,"_2966":50049},[],"`--https-port`",{"_3483":156,"_30444":91,"_21068":50051,"_5":14479,"_27672":49875,"_2966":50052},[],"`443`",{"_3483":157,"_30444":91,"_21068":50054,"_5":14479,"_27672":49875,"_2966":50055},[],"Gateway HTTPS listener port",{"_3483":158,"_30444":91,"_21068":50057,"_5":14479,"_27672":49875,"_2966":50058},[],"`--http-port`",{"_3483":159,"_30444":91,"_21068":50060,"_5":14479,"_27672":49875,"_2966":50061},[],"`80`",{"_3483":160,"_30444":91,"_21068":50063,"_5":14479,"_27672":49875,"_2966":50064},[],"Gateway HTTP listener port",{"_3483":161,"_30444":91,"_21068":50066,"_5":14479,"_27672":49875,"_2966":50067},[],"`--tls-crt`",{"_3483":162,"_30444":91,"_21068":50069,"_5":14479,"_27672":49875,"_2966":50000},[],{"_3483":163,"_30444":91,"_21068":50071,"_5":14479,"_27672":49875,"_2966":50072},[],"PEM certificate for downstream TLS",{"_3483":164,"_30444":91,"_21068":50074,"_5":14479,"_27672":49875,"_2966":50075},[],"`--tls-key`",{"_3483":165,"_30444":91,"_21068":50077,"_5":14479,"_27672":49875,"_2966":50000},[],{"_3483":166,"_30444":91,"_21068":50079,"_5":14479,"_27672":49875,"_2966":50080},[],"PEM private key for downstream TLS",{"_3483":167,"_30444":91,"_21068":50082,"_5":14479,"_27672":49875,"_2966":50083},[],"`-l`, `--local-chart-path`",{"_3483":168,"_30444":91,"_21068":50085,"_5":14479,"_27672":49875,"_2966":50086},[],"repository chart",{"_3483":169,"_30444":91,"_21068":50088,"_5":14479,"_27672":49875,"_2966":50089},[],"Use an unpacked local Lamassu chart",{"_3483":170,"_30444":91,"_21068":50091,"_5":14479,"_27672":49875,"_2966":50092},[],"`-ip`, `--gateway-ip`",{"_3483":171,"_30444":91,"_21068":50094,"_5":14479,"_27672":49875,"_2966":8820},[],{"_3483":172,"_30444":91,"_21068":50096,"_5":14479,"_27672":49875,"_2966":50097},[],"Override the address written to `gateway.addresses`",{"_3483":173,"_30444":91,"_21068":50099,"_5":14479,"_27672":49875,"_2966":50100},[],"`--otel`",{"_3483":174,"_30444":91,"_21068":50102,"_5":14479,"_27672":49875,"_2966":6610},[],{"_3483":175,"_30444":91,"_21068":50104,"_5":14479,"_27672":49875,"_2966":50105},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3483":176,"_30444":91,"_21068":50107,"_5":14479,"_27672":49875,"_2966":50108},[],"`--development`",{"_3483":177,"_30444":91,"_21068":50110,"_5":14479,"_27672":49875,"_2966":6610},[],{"_3483":178,"_30444":91,"_21068":50112,"_5":14479,"_27672":49875,"_2966":50113},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3483":179,"_30444":91,"_21068":50115,"_5":14479,"_27672":49875,"_2966":50116},[],"`--sample-data`",{"_3483":180,"_30444":91,"_21068":50118,"_5":14479,"_27672":49875,"_2966":6610},[],{"_3483":181,"_30444":91,"_21068":50120,"_5":14479,"_27672":49875,"_2966":50121},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3483":182,"_30444":91,"_21068":50123,"_5":14479,"_27672":49875,"_2966":50124},[],"`--with-hsm`",{"_3483":183,"_30444":91,"_21068":50126,"_5":14479,"_27672":49875,"_2966":6610},[],{"_3483":184,"_30444":91,"_21068":50128,"_5":14479,"_27672":49875,"_2966":50129},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3483":185,"_30444":91,"_21068":50131,"_5":14479,"_27672":49875,"_2966":50132},[],"`--softhsm-chart-path`",{"_3483":186,"_30444":91,"_21068":50134,"_5":14479,"_27672":49875,"_2966":50135},[],"`./charts/softhsm`",{"_3483":187,"_30444":91,"_21068":50137,"_5":14479,"_27672":49875,"_2966":50138},[],"Use a different local SoftHSM chart",{"_3483":188,"_30444":91,"_21068":50140,"_5":14479,"_27672":49875,"_2966":50141},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3483":189,"_30444":91,"_21068":50143,"_5":14479,"_27672":49879,"_2966":50144},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3483":190,"_30444":91,"_21068":50146,"_5":14479,"_27672":49879,"_2966":50147},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3483":191,"_30444":91,"_21068":50149,"_5":14479,"_27672":49879,"_2966":50150},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3483":192,"_30444":91,"_21068":50152,"_5":14479,"_27672":49879,"_2966":50153},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3483":193,"_30444":91,"_21068":50155,"_5":14479,"_27672":49879,"_2966":50156},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3483":194,"_30444":91,"_21068":50158,"_5":14479,"_27672":49879,"_2966":50159},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3483":195,"_30444":91,"_21068":50161,"_5":14479,"_27672":49883,"_2966":50162},[],"Fastlane:",{"_3483":196,"_30444":91,"_21068":50164,"_5":14479,"_27672":49883,"_2966":50165},[],"validates local tools and the selected cluster",{"_3483":197,"_30444":91,"_21068":50167,"_5":14479,"_27672":49883,"_2966":50168},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3483":198,"_30444":91,"_21068":50170,"_5":14479,"_27672":49883,"_2966":50171},[],"creates the namespace",{"_3483":199,"_30444":91,"_21068":50173,"_5":14479,"_27672":49883,"_2966":50174},[],"installs PostgreSQL and creates the required databases",{"_3483":200,"_30444":91,"_21068":50176,"_5":14479,"_27672":49883,"_2966":50177},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3483":201,"_30444":91,"_21068":50179,"_5":14479,"_27672":49883,"_2966":50180},[],"installs RabbitMQ",{"_3483":202,"_30444":91,"_21068":50182,"_5":14479,"_27672":49883,"_2966":50183},[],"optionally installs observability and lab HSM components",{"_3483":203,"_30444":91,"_21068":50185,"_5":14479,"_27672":49883,"_2966":50186},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3483":204,"_30444":91,"_21068":50188,"_5":14479,"_27672":49883,"_2966":50189},[],"optionally loads sample data",{"_3483":205,"_30444":91,"_21068":50191,"_5":14479,"_27672":49883,"_2966":50192},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3483":206,"_30444":91,"_21068":50194,"_5":14479,"_27672":49887,"_2966":50195},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3483":207,"_30444":91,"_21068":50197,"_5":14479,"_27672":49887,"_2966":50198},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3483":208,"_30444":91,"_21068":50200,"_5":14479,"_27672":49891,"_2966":50201},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3483":209,"_30444":91,"_21068":50203,"_5":14479,"_27672":49891,"_2966":50204},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3483":210,"_30444":91,"_21068":50206,"_5":14479,"_27672":49891,"_2966":50207},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3483":211,"_30444":91,"_21068":50209,"_5":14479,"_27672":49895,"_2966":50210},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3483":212,"_30444":212,"_5":14831,"_2966":50212,"_30797":50213,"_21068":50214,"_27672":212},"Install with Helm",[49604,49605,49711],[],{"_3483":213,"_30444":212,"_21068":50216,"_5":14479,"_27672":212,"_2966":50217},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3483":214,"_30444":212,"_5":30794,"_21068":50219,"_27672":50220,"_2966":50221},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3483":215,"_30444":212,"_5":30794,"_21068":50223,"_27672":50224,"_2966":49614},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#before-you-begin",{"_3483":216,"_30444":212,"_5":30794,"_21068":50226,"_27672":50227,"_2966":50228},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3483":217,"_30444":212,"_5":30794,"_21068":50230,"_27672":50231,"_2966":50232},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3483":218,"_30444":212,"_5":30794,"_21068":50234,"_27672":50235,"_2966":50236},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3483":219,"_30444":212,"_5":30794,"_21068":50238,"_27672":50239,"_2966":50240},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3483":220,"_30444":212,"_5":30794,"_21068":50242,"_27672":50243,"_2966":50244},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3483":221,"_30444":212,"_5":30794,"_21068":50246,"_27672":50247,"_2966":50248},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3483":222,"_30444":212,"_5":30794,"_21068":50250,"_27672":50251,"_2966":50252},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3483":223,"_30444":212,"_5":30794,"_21068":50254,"_27672":50255,"_2966":50256},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3483":224,"_30444":212,"_5":30794,"_21068":50258,"_27672":50259,"_2966":50260},[],"/docs/pr-preview/pr-65/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3483":225,"_30444":212,"_21068":50262,"_5":14479,"_27672":50220,"_2966":50263},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3483":226,"_30444":212,"_21068":50265,"_5":14479,"_27672":50224,"_2966":50266},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3483":227,"_30444":212,"_21068":50268,"_5":14479,"_27672":50224,"_2966":50269},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3483":228,"_30444":212,"_21068":50271,"_5":14479,"_27672":50224,"_2966":50272},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3483":229,"_30444":212,"_21068":50274,"_5":14479,"_27672":50224,"_2966":50275},[],"a reachable RabbitMQ broker and credentials",{"_3483":230,"_30444":212,"_21068":50277,"_5":14479,"_27672":50224,"_2966":50278},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3483":231,"_30444":212,"_21068":50280,"_5":14479,"_27672":50224,"_2966":50281},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3483":232,"_30444":212,"_21068":50283,"_5":14479,"_27672":50224,"_2966":50284},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3483":233,"_30444":212,"_21068":50286,"_5":14479,"_27672":50224,"_2966":50287},[],"a StorageClass and an external traffic design",{"_3483":234,"_30444":212,"_21068":50289,"_5":14479,"_27672":50224,"_2966":50290},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3483":235,"_30444":212,"_21068":50292,"_5":14479,"_27672":50224,"_2966":50293},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3483":236,"_30444":212,"_21068":50295,"_5":14479,"_27672":50224,"_2966":50296},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3483":237,"_30444":212,"_21068":50298,"_5":14479,"_27672":50227,"_2966":50299},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3483":238,"_30444":212,"_21068":50301,"_5":14479,"_27672":50227,"_2966":50302},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3483":239,"_30444":212,"_21068":50304,"_5":14479,"_27672":50227,"_2966":50305},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3483":240,"_30444":212,"_21068":50307,"_5":14479,"_27672":50231,"_2966":50308},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3483":241,"_30444":212,"_21068":50310,"_5":14479,"_27672":50231,"_2966":50311},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3483":242,"_30444":212,"_21068":50313,"_5":14479,"_27672":50231,"_2966":50314},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3483":243,"_30444":212,"_21068":50316,"_5":14479,"_27672":50231,"_2966":50317},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3483":244,"_30444":212,"_21068":50319,"_5":14479,"_27672":50235,"_2966":50320},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3483":245,"_30444":212,"_21068":50322,"_5":14479,"_27672":50239,"_2966":50323},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3483":246,"_30444":212,"_21068":50325,"_5":14479,"_27672":50239,"_2966":50326},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3483":247,"_30444":212,"_21068":50328,"_5":14479,"_27672":50239,"_2966":50329},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3483":248,"_30444":212,"_21068":50331,"_5":14479,"_27672":50239,"_2966":50332},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3483":249,"_30444":212,"_21068":50334,"_5":14479,"_27672":50239,"_2966":50335},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3483":250,"_30444":212,"_21068":50337,"_5":14479,"_27672":50239,"_2966":50338},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3483":251,"_30444":212,"_21068":50340,"_5":14479,"_27672":50239,"_2966":50341},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3483":252,"_30444":212,"_21068":50343,"_5":14479,"_27672":50243,"_2966":50344},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3483":253,"_30444":212,"_21068":50346,"_5":14479,"_27672":50243,"_2966":50347},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3483":254,"_30444":212,"_21068":50349,"_5":14479,"_27672":50243,"_2966":50350},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3483":255,"_30444":212,"_21068":50352,"_5":14479,"_27672":50243,"_2966":50353},[],"See Access control for the principal and policy model.",{"_3483":256,"_30444":212,"_21068":50355,"_5":14479,"_27672":50247,"_2966":50356},[],"To install a local checkout instead:",{"_3483":257,"_30444":212,"_21068":50358,"_5":14479,"_27672":50251,"_2966":50359},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3483":258,"_30444":212,"_21068":50361,"_5":14479,"_27672":50251,"_2966":50362},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3483":259,"_30444":212,"_21068":50364,"_5":14479,"_27672":50255,"_2966":50365},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3483":260,"_30444":212,"_21068":50367,"_5":14479,"_27672":50255,"_2966":50368},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3483":261,"_30444":212,"_21068":50370,"_5":14479,"_27672":50255,"_2966":50371},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3483":262,"_30444":212,"_21068":50373,"_5":14479,"_27672":50255,"_2966":50374},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3483":263,"_30444":212,"_21068":50376,"_5":14479,"_27672":50255,"_2966":50377},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3483":264,"_30444":212,"_21068":50379,"_5":14479,"_27672":50259,"_2966":50380},[],"Before going live, review:",{"_3483":265,"_30444":212,"_21068":50382,"_5":14479,"_27672":50259,"_2966":50383},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3483":266,"_30444":212,"_21068":50385,"_5":14479,"_27672":50259,"_2966":50386},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3483":267,"_30444":212,"_21068":50388,"_5":14479,"_27672":50259,"_2966":50389},[],"shared VA storage before increasing VA replicas",{"_3483":268,"_30444":212,"_21068":50391,"_5":14479,"_27672":50259,"_2966":50392},[],"managed OIDC roles and removal of evaluation credentials",{"_3483":269,"_30444":212,"_21068":50394,"_5":14479,"_27672":50259,"_2966":50395},[],"a trusted TLS issuer or externally managed certificate",{"_3483":270,"_30444":212,"_21068":50397,"_5":14479,"_27672":50259,"_2966":50398},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3483":271,"_30444":212,"_21068":50400,"_5":14479,"_27672":50259,"_2966":50401},[],"SMTP, observability and alert delivery",{"_3483":272,"_30444":212,"_21068":50403,"_5":14479,"_27672":50259,"_2966":50404},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3483":273,"_30444":212,"_21068":50406,"_5":14479,"_27672":50259,"_2966":50407},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3483":274,"_30444":274,"_5":14831,"_2966":50409,"_30797":50410,"_21068":50411,"_27672":274},"Expose the Gateway",[49604,49605,49711],[],{"_3483":275,"_30444":274,"_21068":50413,"_5":14479,"_27672":274,"_2966":50414},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3483":276,"_30444":274,"_5":30794,"_21068":50416,"_27672":50417,"_2966":50418},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3483":277,"_30444":274,"_5":30794,"_21068":50420,"_27672":50421,"_2966":50422},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3483":278,"_30444":274,"_5":30794,"_21068":50424,"_27672":50425,"_2966":50426},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3483":279,"_30444":274,"_5":30794,"_21068":50428,"_27672":50429,"_2966":50430},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#k3s","K3s",{"_3483":280,"_30444":274,"_5":30794,"_21068":50432,"_27672":50433,"_2966":50434},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3483":281,"_30444":274,"_5":30794,"_21068":50436,"_27672":50437,"_2966":50438},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3483":282,"_30444":274,"_5":30794,"_21068":50440,"_27672":50441,"_2966":50442},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3483":283,"_30444":274,"_5":30794,"_21068":50444,"_27672":50445,"_2966":50446},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3483":284,"_30444":274,"_5":30794,"_21068":50448,"_27672":50449,"_2966":50450},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3483":285,"_30444":274,"_5":30794,"_21068":50452,"_27672":50453,"_2966":50454},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3483":286,"_30444":274,"_5":30794,"_21068":50456,"_27672":50457,"_2966":50458},[],"/docs/pr-preview/pr-65/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3483":287,"_30444":274,"_21068":50460,"_5":14479,"_27672":50417,"_2966":50461},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3483":288,"_30444":274,"_21068":50463,"_5":14479,"_27672":50417,"_2966":50464},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3483":289,"_30444":274,"_21068":50466,"_5":14479,"_27672":50421,"_2966":50467},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3483":290,"_30444":274,"_21068":50469,"_5":14479,"_27672":50421,"_2966":50470},[],"Set it only when:",{"_3483":291,"_30444":274,"_21068":50472,"_5":14479,"_27672":50421,"_2966":50473},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3483":292,"_30444":274,"_21068":50475,"_5":14479,"_27672":50421,"_2966":50476},[],"that address is allocated to this Gateway",{"_3483":293,"_30444":274,"_21068":50478,"_5":14479,"_27672":50421,"_2966":50479},[],"the surrounding network already routes traffic for it to the cluster",{"_3483":294,"_30444":274,"_21068":50481,"_5":14479,"_27672":50421,"_2966":50482},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3483":295,"_30444":274,"_21068":50484,"_5":14479,"_27672":50421,"_2966":50485},[],"Keep these two settings separate:",{"_3483":296,"_30444":274,"_21068":50487,"_5":14479,"_27672":50421,"_2966":50488},[],"`gateway.addresses` requests an address for the Gateway.",{"_3483":297,"_30444":274,"_21068":50490,"_5":14479,"_27672":50421,"_2966":50491},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3483":298,"_30444":274,"_21068":50493,"_5":14479,"_27672":50421,"_2966":50494},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3483":299,"_30444":274,"_21068":50496,"_5":14479,"_27672":50425,"_2966":50497},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3483":300,"_30444":274,"_21068":50499,"_5":14479,"_27672":50425,"_2966":50500},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3483":301,"_30444":274,"_21068":50502,"_5":14479,"_27672":50429,"_2966":50503},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3483":302,"_30444":274,"_21068":50505,"_5":14479,"_27672":50429,"_2966":50506},[],"For the recommended design:",{"_3483":303,"_30444":274,"_21068":50508,"_5":14479,"_27672":50429,"_2966":50509},[],"Use only one externally exposed Lamassu Gateway.",{"_3483":304,"_30444":274,"_21068":50511,"_5":14479,"_27672":50429,"_2966":50512},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3483":305,"_30444":274,"_21068":50514,"_5":14479,"_27672":50429,"_2966":50515},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3483":306,"_30444":274,"_21068":50517,"_5":14479,"_27672":50429,"_2966":50518},[],"Point DNS at the VM's reachable address.",{"_3483":307,"_30444":274,"_21068":50520,"_5":14479,"_27672":50429,"_2966":50521},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3483":308,"_30444":274,"_21068":50523,"_5":14479,"_27672":50433,"_2966":50524},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3483":309,"_30444":274,"_21068":50526,"_5":14479,"_27672":50437,"_2966":50527},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3483":310,"_30444":274,"_21068":50529,"_5":14479,"_27672":50437,"_2966":50530},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3483":311,"_30444":274,"_21068":50532,"_5":14479,"_27672":50441,"_2966":50533},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3483":312,"_30444":274,"_21068":50535,"_5":14479,"_27672":50441,"_2966":50536},[],"Requirement",{"_3483":313,"_30444":274,"_21068":50538,"_5":14479,"_27672":50441,"_2966":50539},[],"Recommended design",{"_3483":314,"_30444":274,"_21068":50541,"_5":14479,"_27672":50441,"_2966":50542},[],"Consequence",{"_3483":315,"_30444":274,"_21068":50544,"_5":14479,"_27672":50441,"_2966":50545},[],"Several Lamassu URLs or services",{"_3483":316,"_30444":274,"_21068":50547,"_5":14479,"_27672":50441,"_2966":50548},[],"One Gateway with multiple routes",{"_3483":317,"_30444":274,"_21068":50550,"_5":14479,"_27672":50441,"_2966":50551},[],"One IP and one proxy fleet; this is the chart default",{"_3483":318,"_30444":274,"_21068":50553,"_5":14479,"_27672":50441,"_2966":50554},[],"Independent Gateways and separate external IPs",{"_3483":319,"_30444":274,"_21068":50556,"_5":14479,"_27672":50441,"_2966":50557},[],"One VIP per Gateway",{"_3483":320,"_30444":274,"_21068":50559,"_5":14479,"_27672":50441,"_2966":50560},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3483":321,"_30444":274,"_21068":50562,"_5":14479,"_27672":50441,"_2966":50563},[],"Independent Gateways on one node and one IP",{"_3483":322,"_30444":274,"_21068":50565,"_5":14479,"_27672":50441,"_2966":50566},[],"Use different external ports",{"_3483":323,"_30444":274,"_21068":50568,"_5":14479,"_27672":50441,"_2966":50569},[],"Clients must include non-standard ports",{"_3483":324,"_30444":274,"_21068":50571,"_5":14479,"_27672":50441,"_2966":50572},[],"Separate TLS/mTLS termination behind one IP",{"_3483":325,"_30444":274,"_21068":50574,"_5":14479,"_27672":50441,"_2966":50575},[],"Front-door SNI routing to internal Gateways",{"_3483":326,"_30444":274,"_21068":50577,"_5":14479,"_27672":50441,"_2966":50578},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3483":327,"_30444":274,"_21068":50580,"_5":14479,"_27672":50441,"_2966":50581},[],"Separate Gateway resources but shared proxy infrastructure",{"_3483":328,"_30444":274,"_21068":50583,"_5":14479,"_27672":50441,"_2966":50584},[],"Envoy merged-Gateway mode",{"_3483":329,"_30444":274,"_21068":50586,"_5":14479,"_27672":50441,"_2966":50587},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3483":330,"_30444":274,"_21068":50589,"_5":14479,"_27672":50441,"_2966":50590},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3483":331,"_30444":274,"_21068":50592,"_5":14479,"_27672":50441,"_2966":50593},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3483":332,"_30444":274,"_21068":50595,"_5":14479,"_27672":50441,"_2966":50596},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3483":333,"_30444":274,"_21068":50598,"_5":14479,"_27672":50441,"_2966":50599},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3483":334,"_30444":274,"_21068":50601,"_5":14479,"_27672":50445,"_2966":50602},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3483":335,"_30444":274,"_21068":50604,"_5":14479,"_27672":50449,"_2966":50605},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3483":336,"_30444":274,"_21068":50607,"_5":14479,"_27672":50449,"_2966":50608},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3483":337,"_30444":274,"_21068":50610,"_5":14479,"_27672":50449,"_2966":50611},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3483":338,"_30444":274,"_21068":50613,"_5":14479,"_27672":50449,"_2966":50614},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3483":339,"_30444":274,"_21068":50616,"_5":14479,"_27672":50449,"_2966":50617},[],"If none of those are possible, use different external ports or change the external network design.",{"_3483":340,"_30444":274,"_21068":50619,"_5":14479,"_27672":50453,"_2966":50620},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3483":341,"_30444":274,"_21068":50622,"_5":14479,"_27672":50453,"_2966":50623},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3483":342,"_30444":274,"_21068":50625,"_5":14479,"_27672":50457,"_2966":50626},[],"Check, in order:",{"_3483":343,"_30444":274,"_21068":50628,"_5":14479,"_27672":50457,"_2966":50629},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3483":344,"_30444":274,"_21068":50631,"_5":14479,"_27672":50457,"_2966":50632},[],"Its status contains the expected address.",{"_3483":345,"_30444":274,"_21068":50634,"_5":14479,"_27672":50457,"_2966":50635},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3483":346,"_30444":274,"_21068":50637,"_5":14479,"_27672":50457,"_2966":50638},[],"Port 443 reaches that address from the client network.",{"_3483":347,"_30444":274,"_21068":50640,"_5":14479,"_27672":50457,"_2966":50641},[],"DNS resolves to the externally reachable endpoint.",{"_3483":348,"_30444":274,"_21068":50643,"_5":14479,"_27672":50457,"_2966":50644},[],"The certificate contains the DNS name or IP used by the client.",{"_3483":349,"_30444":274,"_21068":50646,"_5":14479,"_27672":50457,"_2966":50647},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3483":350,"_30444":350,"_5":14831,"_2966":49711,"_30797":50649,"_21068":50650,"_27672":350},[49604,49605,49711],[],{"_3483":351,"_30444":350,"_21068":50652,"_5":14479,"_27672":350,"_2966":50653},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3483":352,"_30444":350,"_5":30794,"_21068":50655,"_27672":50656,"_2966":50657},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3483":353,"_30444":350,"_5":30794,"_21068":50659,"_27672":50660,"_2966":50661},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3483":354,"_30444":350,"_5":30794,"_21068":50663,"_27672":50664,"_2966":50665},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3483":355,"_30444":350,"_5":30794,"_21068":50667,"_27672":50668,"_2966":50669},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3483":356,"_30444":350,"_5":30794,"_21068":50671,"_27672":50672,"_2966":50673},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3483":357,"_30444":350,"_5":30794,"_21068":50675,"_27672":50676,"_2966":50677},[],"/docs/pr-preview/pr-65/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3483":358,"_30444":350,"_21068":50679,"_5":14479,"_27672":50656,"_2966":50680},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3483":359,"_30444":350,"_21068":50682,"_5":14479,"_27672":50660,"_2966":50683},[],"Workflow",{"_3483":360,"_30444":350,"_21068":50685,"_5":14479,"_27672":50660,"_2966":50686},[],"Use it for",{"_3483":361,"_30444":350,"_21068":50688,"_5":14479,"_27672":50660,"_2966":50689},[],"What it installs",{"_3483":362,"_30444":350,"_21068":50691,"_5":14479,"_27672":50660,"_2966":50692},[],"Helm",{"_3483":363,"_30444":350,"_21068":50694,"_5":14479,"_27672":50660,"_2966":50695},[],"Production and controlled environments",{"_3483":364,"_30444":350,"_21068":50697,"_5":14479,"_27672":50660,"_2966":50698},[],"Lamassu services and Gateway API resources",{"_3483":365,"_30444":350,"_21068":50700,"_5":14479,"_27672":50660,"_2966":49848},[],{"_3483":366,"_30444":350,"_21068":50702,"_5":14479,"_27672":50660,"_2966":50703},[],"Evaluation, demos, CI and small lab clusters",{"_3483":367,"_30444":350,"_21068":50705,"_5":14479,"_27672":50660,"_2966":50706},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3483":368,"_30444":350,"_21068":50708,"_5":14479,"_27672":50664,"_2966":50709},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3483":369,"_30444":350,"_21068":50711,"_5":14479,"_27672":50664,"_2966":50712},[],"Area",{"_3483":370,"_30444":350,"_21068":50714,"_5":14479,"_27672":50664,"_2966":50715},[],"The Lamassu chart provides",{"_3483":371,"_30444":350,"_21068":50717,"_5":14479,"_27672":50664,"_2966":50718},[],"You provide",{"_3483":372,"_30444":350,"_21068":50720,"_5":14479,"_27672":50664,"_2966":50721},[],"Lamassu applications",{"_3483":373,"_30444":350,"_21068":50723,"_5":14479,"_27672":50664,"_2966":50724},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3483":374,"_30444":350,"_21068":50726,"_5":14479,"_27672":50664,"_2966":50727},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3483":375,"_30444":350,"_21068":50729,"_5":14479,"_27672":50664,"_2966":50730},[],"PostgreSQL data",{"_3483":376,"_30444":350,"_21068":50732,"_5":14479,"_27672":50664,"_2966":50733},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3483":377,"_30444":350,"_21068":50735,"_5":14479,"_27672":50664,"_2966":50736},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3483":378,"_30444":350,"_21068":50738,"_5":14479,"_27672":50664,"_2966":50739},[],"Messaging",{"_3483":379,"_30444":350,"_21068":50741,"_5":14479,"_27672":50664,"_2966":50742},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3483":380,"_30444":350,"_21068":50744,"_5":14479,"_27672":50664,"_2966":50745},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3483":381,"_30444":350,"_21068":50747,"_5":14479,"_27672":50664,"_2966":50748},[],"Identity",{"_3483":382,"_30444":350,"_21068":50750,"_5":14479,"_27672":50664,"_2966":50751},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3483":383,"_30444":350,"_21068":50753,"_5":14479,"_27672":50664,"_2966":50754},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3483":384,"_30444":350,"_21068":50756,"_5":14479,"_27672":50664,"_2966":50757},[],"External routing",{"_3483":385,"_30444":350,"_21068":50759,"_5":14479,"_27672":50664,"_2966":50760},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3483":386,"_30444":350,"_21068":50762,"_5":14479,"_27672":50664,"_2966":50763},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3483":387,"_30444":350,"_21068":50765,"_5":14479,"_27672":50664,"_2966":50766},[],"TLS",{"_3483":388,"_30444":350,"_21068":50768,"_5":14479,"_27672":50664,"_2966":50769},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3483":389,"_30444":350,"_21068":50771,"_5":14479,"_27672":50664,"_2966":50772},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3483":390,"_30444":350,"_21068":50774,"_5":14479,"_27672":50664,"_2966":50775},[],"Persistent application data",{"_3483":391,"_30444":350,"_21068":50777,"_5":14479,"_27672":50664,"_2966":50778},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3483":392,"_30444":350,"_21068":50780,"_5":14479,"_27672":50664,"_2966":50781},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3483":393,"_30444":350,"_21068":50783,"_5":14479,"_27672":50664,"_2966":50784},[],"Optional integrations",{"_3483":394,"_30444":350,"_21068":50786,"_5":14479,"_27672":50664,"_2966":50787},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3483":395,"_30444":350,"_21068":50789,"_5":14479,"_27672":50664,"_2966":50790},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3483":396,"_30444":350,"_21068":50792,"_5":14479,"_27672":50664,"_2966":50793},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3483":397,"_30444":350,"_21068":50795,"_5":14479,"_27672":50664,"_2966":50796},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3483":398,"_30444":350,"_21068":50798,"_5":14479,"_27672":50668,"_2966":50799},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3483":399,"_30444":350,"_21068":50801,"_5":14479,"_27672":50668,"_2966":50802},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3483":400,"_30444":350,"_21068":50804,"_5":14479,"_27672":50672,"_2966":50805},[],"Kubernetes 1.24 or newer",{"_3483":401,"_30444":350,"_21068":50807,"_5":14479,"_27672":50672,"_2966":50808},[],"Helm 3.2 or newer",{"_3483":402,"_30444":350,"_21068":50810,"_5":14479,"_27672":50672,"_2966":50811},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3483":403,"_30444":350,"_21068":50813,"_5":14479,"_27672":50672,"_2966":50814},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3483":404,"_30444":350,"_21068":50816,"_5":14479,"_27672":50672,"_2966":50817},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3483":405,"_30444":350,"_21068":50819,"_5":14479,"_27672":50672,"_2966":50820},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3483":406,"_30444":350,"_21068":50822,"_5":14479,"_27672":50672,"_2966":50823},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3483":407,"_30444":350,"_21068":50825,"_5":14479,"_27672":50676,"_2966":50826},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3483":408,"_30444":350,"_21068":50828,"_5":14479,"_27672":50676,"_2966":50829},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3483":409,"_30444":350,"_21068":50831,"_5":14479,"_27672":50676,"_2966":50832},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3483":410,"_30444":350,"_21068":50834,"_5":14479,"_27672":50676,"_2966":50835},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3483":411,"_30444":411,"_5":14831,"_2966":50837,"_30797":50838,"_21068":50840,"_27672":411},"Deployment troubleshooting",[49604,49605,50839],"Operations",[],{"_3483":412,"_30444":411,"_21068":50842,"_5":14479,"_27672":411,"_2966":50843},[],"Diagnose access, service health and infrastructure dependencies.",{"_3483":413,"_30444":411,"_5":30794,"_21068":50845,"_27672":50846,"_2966":50847},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3483":414,"_30444":411,"_5":30794,"_21068":50849,"_27672":50850,"_2966":50851},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3483":415,"_30444":411,"_5":30794,"_21068":50853,"_27672":50854,"_2966":50855},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3483":416,"_30444":411,"_5":30794,"_21068":50857,"_27672":50858,"_2966":50859},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3483":417,"_30444":411,"_5":30794,"_21068":50861,"_27672":50862,"_2966":50863},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3483":418,"_30444":411,"_5":30794,"_21068":50865,"_27672":50866,"_2966":50867},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3483":419,"_30444":411,"_5":30794,"_21068":50869,"_27672":50870,"_2966":50871},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3483":420,"_30444":411,"_5":30794,"_21068":50873,"_27672":50874,"_2966":50875},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3483":421,"_30444":411,"_5":30794,"_21068":50877,"_27672":50878,"_2966":50879},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3483":422,"_30444":411,"_5":30794,"_21068":50881,"_27672":50882,"_2966":50883},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3483":423,"_30444":411,"_5":30794,"_21068":50885,"_27672":50886,"_2966":50887},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3483":424,"_30444":411,"_5":30794,"_21068":50889,"_27672":50890,"_2966":50891},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3483":425,"_30444":411,"_5":30794,"_21068":50893,"_27672":50894,"_2966":50895},[],"/docs/pr-preview/pr-65/deployment/troubleshooting#observability","Observability",{"_3483":426,"_30444":411,"_21068":50897,"_5":14479,"_27672":411,"_2966":50898},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3483":427,"_30444":411,"_21068":50900,"_5":14479,"_27672":50850,"_2966":50901},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3483":428,"_30444":411,"_21068":50903,"_5":14479,"_27672":50854,"_2966":50904},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3483":429,"_30444":411,"_21068":50906,"_5":14479,"_27672":50858,"_2966":50907},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3483":430,"_30444":411,"_21068":50909,"_5":14479,"_27672":50862,"_2966":50910},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3483":431,"_30444":411,"_21068":50912,"_5":14479,"_27672":50866,"_2966":50913},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3483":432,"_30444":411,"_21068":50915,"_5":14479,"_27672":50870,"_2966":50916},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3483":433,"_30444":411,"_21068":50918,"_5":14479,"_27672":50870,"_2966":50919},[],"Also run the chart's connectivity test:",{"_3483":434,"_30444":411,"_21068":50921,"_5":14479,"_27672":50870,"_2966":50922},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3483":435,"_30444":411,"_21068":50924,"_5":14479,"_27672":50870,"_2966":50925},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3483":436,"_30444":411,"_21068":50927,"_5":14479,"_27672":50874,"_2966":50928},[],"If you receive a 401:",{"_3483":437,"_30444":411,"_21068":50930,"_5":14479,"_27672":50874,"_2966":50931},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3483":438,"_30444":411,"_21068":50933,"_5":14479,"_27672":50874,"_2966":50934},[],"verify issuer, audience and expiration of the token;",{"_3483":439,"_30444":411,"_21068":50936,"_5":14479,"_27672":50874,"_2966":50937},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3483":440,"_30444":411,"_21068":50939,"_5":14479,"_27672":50874,"_2966":50940},[],"check that the provider's public and internal routes point to the same realm.",{"_3483":441,"_30444":411,"_21068":50942,"_5":14479,"_27672":50874,"_2966":50943},[],"If login succeeds but the APIs return 403:",{"_3483":442,"_30444":411,"_21068":50945,"_5":14479,"_27672":50874,"_2966":50946},[],"inspect the token's real claims;",{"_3483":443,"_30444":411,"_21068":50948,"_5":14479,"_27672":50874,"_2966":50949},[],"confirm they match an active principal;",{"_3483":444,"_30444":411,"_21068":50951,"_5":14479,"_27672":50874,"_2966":50952},[],"review the policies granted to that principal;",{"_3483":445,"_30444":411,"_21068":50954,"_5":14479,"_27672":50874,"_2966":50955},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3483":446,"_30444":411,"_21068":50957,"_5":14479,"_27672":50874,"_2966":50958},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3483":447,"_30444":411,"_21068":50960,"_5":14479,"_27672":50878,"_2966":50961},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3483":448,"_30444":411,"_21068":50963,"_5":14479,"_27672":50878,"_2966":50964},[],"Locate the authz pod and Service.",{"_3483":449,"_30444":411,"_21068":50966,"_5":14479,"_27672":50878,"_2966":50967},[],"Check /health, logs and its database connection.",{"_3483":450,"_30444":411,"_21068":50969,"_5":14479,"_27672":50878,"_2966":50970},[],"Verify the DNS and port configured in externalAuthorization.",{"_3483":451,"_30444":411,"_21068":50972,"_5":14479,"_27672":50878,"_2966":50973},[],"Check the check route is /v1/ext\\_authz/check.",{"_3483":452,"_30444":411,"_21068":50975,"_5":14479,"_27672":50878,"_2966":50976},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3483":453,"_30444":411,"_21068":50978,"_5":14479,"_27672":50882,"_2966":50979},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3483":454,"_30444":411,"_21068":50981,"_5":14479,"_27672":50886,"_2966":50982},[],"Review kubectl describe pod first. Common causes are:",{"_3483":455,"_30444":411,"_21068":50984,"_5":14479,"_27672":50886,"_2966":50985},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3483":456,"_30444":411,"_21068":50987,"_5":14479,"_27672":50886,"_2966":50988},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3483":457,"_30444":411,"_21068":50990,"_5":14479,"_27672":50886,"_2966":50991},[],"unbound persistent volume;",{"_3483":458,"_30444":411,"_21068":50993,"_5":14479,"_27672":50886,"_2966":50994},[],"inaccessible image or incorrect pull policy;",{"_3483":459,"_30444":411,"_21068":50996,"_5":14479,"_27672":50886,"_2966":50997},[],"invalid cryptographic engine configuration;",{"_3483":460,"_30444":411,"_21068":50999,"_5":14479,"_27672":50886,"_2966":51000},[],"CPU or memory limits set too low;",{"_3483":461,"_30444":411,"_21068":51002,"_5":14479,"_27672":50886,"_2966":51003},[],"an incomplete prior migration.",{"_3483":462,"_30444":411,"_21068":51005,"_5":14479,"_27672":50886,"_2966":51006},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3483":463,"_30444":411,"_21068":51008,"_5":14479,"_27672":50886,"_2966":51009},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3483":464,"_30444":411,"_21068":51011,"_5":14479,"_27672":50886,"_2966":51012},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3483":465,"_30444":411,"_21068":51014,"_5":14479,"_27672":50890,"_2966":51015},[],"Domain and audit events depend on the bus publisher:",{"_3483":466,"_30444":411,"_21068":51017,"_5":14479,"_27672":50890,"_2966":51018},[],"verify it is enabled in the emitting service;",{"_3483":467,"_30444":411,"_21068":51020,"_5":14479,"_27672":50890,"_2966":51021},[],"check AMQP connectivity and credentials;",{"_3483":468,"_30444":411,"_21068":51023,"_5":14479,"_27672":50890,"_2966":51024},[],"review exchange, routing key, queues and consumers;",{"_3483":469,"_30444":411,"_21068":51026,"_5":14479,"_27672":50890,"_2966":51027},[],"inspect dead-letter queues;",{"_3483":470,"_30444":411,"_21068":51029,"_5":14479,"_27672":50890,"_2966":51030},[],"alert on orphan durable queues and backlog growth.",{"_3483":471,"_30444":411,"_21068":51032,"_5":14479,"_27672":50890,"_2966":51033},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3483":472,"_30444":411,"_21068":51035,"_5":14479,"_27672":50890,"_2966":51036},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3483":473,"_30444":411,"_21068":51038,"_5":14479,"_27672":50890,"_2966":51039},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3483":474,"_30444":411,"_21068":51041,"_5":14479,"_27672":50890,"_2966":51042},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3483":475,"_30444":411,"_21068":51044,"_5":14479,"_27672":50890,"_2966":51045},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3483":476,"_30444":411,"_21068":51047,"_5":14479,"_27672":50890,"_2966":51048},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3483":477,"_30444":411,"_21068":51050,"_5":14479,"_27672":50890,"_2966":51051},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3483":478,"_30444":411,"_21068":51053,"_5":14479,"_27672":50894,"_2966":51054},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3483":479,"_30444":411,"_21068":51056,"_5":14479,"_27672":50894,"_2966":51057},[],"Before closing an incident, record:",{"_3483":480,"_30444":411,"_21068":51059,"_5":14479,"_27672":50894,"_2966":51060},[],"the confirmed cause;",{"_3483":481,"_30444":411,"_21068":51062,"_5":14479,"_27672":50894,"_2966":51063},[],"the time scope and affected resources;",{"_3483":482,"_30444":411,"_21068":51065,"_5":14479,"_27672":50894,"_2966":51066},[],"the commands or queries used;",{"_3483":483,"_30444":411,"_21068":51068,"_5":14479,"_27672":50894,"_2966":51069},[],"the applied change and how to revert it;",{"_3483":484,"_30444":411,"_21068":51071,"_5":14479,"_27672":50894,"_2966":51072},[],"validation from a consumer;",{"_3483":485,"_30444":411,"_21068":51074,"_5":14479,"_27672":50894,"_2966":51075},[],"the preventive action and its owner.",{"_3483":486,"_30444":486,"_5":14831,"_2966":51077,"_30797":51078,"_21068":51081,"_27672":486},"Access control",[49604,51079,51080],"Platform","Administration",[],{"_3483":487,"_30444":486,"_21068":51083,"_5":14479,"_27672":486,"_2966":51084},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3483":488,"_30444":486,"_5":30794,"_21068":51086,"_27672":51087,"_2966":51088},[],"/docs/pr-preview/pr-65/platform/administration/access-control#essential-concepts","Essential concepts",{"_3483":489,"_30444":486,"_5":30794,"_21068":51090,"_27672":51091,"_2966":51092},[],"/docs/pr-preview/pr-65/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3483":490,"_30444":486,"_5":30794,"_21068":51094,"_27672":51095,"_2966":51096},[],"/docs/pr-preview/pr-65/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3483":491,"_30444":486,"_5":30794,"_21068":51098,"_27672":51099,"_2966":51100},[],"/docs/pr-preview/pr-65/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3483":492,"_30444":486,"_5":30794,"_21068":51102,"_27672":51103,"_2966":51104},[],"/docs/pr-preview/pr-65/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3483":493,"_30444":486,"_5":30794,"_21068":51106,"_27672":51107,"_2966":51108},[],"/docs/pr-preview/pr-65/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3483":494,"_30444":486,"_5":30794,"_21068":51110,"_27672":51111,"_2966":51112},[],"/docs/pr-preview/pr-65/platform/administration/access-control#oidc-principals","OIDC principals",{"_3483":495,"_30444":486,"_5":30794,"_21068":51114,"_27672":51115,"_2966":51116},[],"/docs/pr-preview/pr-65/platform/administration/access-control#x509-principals","X.509 principals",{"_3483":496,"_30444":486,"_5":30794,"_21068":51118,"_27672":51119,"_2966":51120},[],"/docs/pr-preview/pr-65/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3483":497,"_30444":486,"_5":30794,"_21068":51122,"_27672":51123,"_2966":51124},[],"/docs/pr-preview/pr-65/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3483":498,"_30444":486,"_5":30794,"_21068":51126,"_27672":51127,"_2966":51128},[],"/docs/pr-preview/pr-65/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3483":499,"_30444":486,"_5":30794,"_21068":51130,"_27672":51131,"_2966":51132},[],"/docs/pr-preview/pr-65/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3483":500,"_30444":486,"_5":30794,"_21068":51134,"_27672":51135,"_2966":51136},[],"/docs/pr-preview/pr-65/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3483":501,"_30444":486,"_5":30794,"_21068":51138,"_27672":51139,"_2966":51140},[],"/docs/pr-preview/pr-65/platform/administration/access-control#http-rules","HTTP rules",{"_3483":502,"_30444":486,"_5":30794,"_21068":51142,"_27672":51143,"_2966":51144},[],"/docs/pr-preview/pr-65/platform/administration/access-control#included-policies","Included policies",{"_3483":503,"_30444":486,"_5":30794,"_21068":51146,"_27672":51147,"_2966":50244},[],"/docs/pr-preview/pr-65/platform/administration/access-control#provision-the-first-administrator",{"_3483":504,"_30444":486,"_5":30794,"_21068":51149,"_27672":51150,"_2966":51151},[],"/docs/pr-preview/pr-65/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3483":505,"_30444":486,"_5":30794,"_21068":51153,"_27672":51154,"_2966":51155},[],"/docs/pr-preview/pr-65/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3483":506,"_30444":486,"_5":30794,"_21068":51157,"_27672":51158,"_2966":51159},[],"/docs/pr-preview/pr-65/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3483":507,"_30444":486,"_5":30794,"_21068":51161,"_27672":51162,"_2966":51163},[],"/docs/pr-preview/pr-65/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3483":508,"_30444":486,"_5":30794,"_21068":51165,"_27672":51166,"_2966":51167},[],"/docs/pr-preview/pr-65/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3483":509,"_30444":486,"_5":30794,"_21068":51169,"_27672":51170,"_2966":51171},[],"/docs/pr-preview/pr-65/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3483":510,"_30444":486,"_5":30794,"_21068":51173,"_27672":51174,"_2966":51175},[],"/docs/pr-preview/pr-65/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3483":511,"_30444":486,"_5":30794,"_21068":51177,"_27672":51178,"_2966":51179},[],"/docs/pr-preview/pr-65/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3483":512,"_30444":486,"_5":30794,"_21068":51181,"_27672":51182,"_2966":51183},[],"/docs/pr-preview/pr-65/platform/administration/access-control#operational-checklist","Operational checklist",{"_3483":513,"_30444":486,"_5":30794,"_21068":51185,"_27672":51186,"_2966":51187},[],"/docs/pr-preview/pr-65/platform/administration/access-control#diagnostics","Diagnostics",{"_3483":514,"_30444":486,"_5":30794,"_21068":51189,"_27672":51190,"_2966":51191},[],"/docs/pr-preview/pr-65/platform/administration/access-control#the-response-is-401","The response is 401",{"_3483":515,"_30444":486,"_5":30794,"_21068":51193,"_27672":51194,"_2966":51195},[],"/docs/pr-preview/pr-65/platform/administration/access-control#the-response-is-403","The response is 403",{"_3483":516,"_30444":486,"_5":30794,"_21068":51197,"_27672":51198,"_2966":51199},[],"/docs/pr-preview/pr-65/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3483":517,"_30444":486,"_5":30794,"_21068":51201,"_27672":51202,"_2966":51203},[],"/docs/pr-preview/pr-65/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3483":518,"_30444":486,"_5":30794,"_21068":51205,"_27672":51206,"_2966":51207},[],"/docs/pr-preview/pr-65/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3483":519,"_30444":486,"_21068":51209,"_5":14479,"_27672":486,"_2966":51210},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3483":520,"_30444":486,"_21068":51212,"_5":14479,"_27672":486,"_2966":51213},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3483":521,"_30444":486,"_21068":51215,"_5":14479,"_27672":486,"_2966":51216},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3483":522,"_30444":486,"_21068":51218,"_5":14479,"_27672":51087,"_2966":51219},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3483":523,"_30444":486,"_21068":51221,"_5":14479,"_27672":51087,"_2966":51222},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3483":524,"_30444":486,"_21068":51224,"_5":14479,"_27672":51087,"_2966":51225},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3483":525,"_30444":486,"_21068":51227,"_5":14479,"_27672":51087,"_2966":51228},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3483":526,"_30444":486,"_21068":51230,"_5":14479,"_27672":51087,"_2966":51231},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3483":527,"_30444":486,"_21068":51233,"_5":14479,"_27672":51087,"_2966":51234},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3483":528,"_30444":486,"_21068":51236,"_5":14479,"_27672":51091,"_2966":51237},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3483":529,"_30444":486,"_21068":51239,"_5":14479,"_27672":51091,"_2966":51240},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3483":530,"_30444":486,"_21068":51242,"_5":14479,"_27672":51095,"_2966":51243},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3483":531,"_30444":486,"_21068":51245,"_5":14479,"_27672":51095,"_2966":51246},[],"The decision is made **before forwarding the request to the service**:",{"_3483":532,"_30444":486,"_21068":51248,"_5":14479,"_27672":51095,"_2966":51249},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3483":533,"_30444":486,"_21068":51251,"_5":14479,"_27672":51095,"_2966":51252},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3483":534,"_30444":486,"_21068":51254,"_5":14479,"_27672":51095,"_2966":51255},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3483":535,"_30444":486,"_21068":51257,"_5":14479,"_27672":51095,"_2966":51258},[],"It separately loads the policies granted to each principal.",{"_3483":536,"_30444":486,"_21068":51260,"_5":14479,"_27672":51095,"_2966":51261},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3483":537,"_30444":486,"_21068":51263,"_5":14479,"_27672":51095,"_2966":51264},[],"`authz` looks for an HTTP rule granting that action.",{"_3483":538,"_30444":486,"_21068":51266,"_5":14479,"_27672":51095,"_2966":51267},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3483":539,"_30444":486,"_21068":51269,"_5":14479,"_27672":51095,"_2966":51270},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3483":540,"_30444":486,"_21068":51272,"_5":14479,"_27672":51095,"_2966":51273},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3483":541,"_30444":486,"_21068":51275,"_5":14479,"_27672":51095,"_2966":51276},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3483":542,"_30444":486,"_21068":51278,"_5":14479,"_27672":51099,"_2966":51279},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3483":543,"_30444":486,"_21068":51281,"_5":14479,"_27672":51099,"_2966":51282},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3483":544,"_30444":486,"_21068":51284,"_5":14479,"_27672":51099,"_2966":51285},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3483":545,"_30444":486,"_21068":51287,"_5":14479,"_27672":51099,"_2966":51288},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3483":546,"_30444":486,"_21068":51290,"_5":14479,"_27672":51099,"_2966":51291},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3483":547,"_30444":486,"_21068":51293,"_5":14479,"_27672":51099,"_2966":51294},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3483":548,"_30444":486,"_21068":51296,"_5":14479,"_27672":51099,"_2966":51297},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3483":549,"_30444":486,"_21068":51299,"_5":14479,"_27672":51099,"_2966":51300},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3483":550,"_30444":486,"_21068":51302,"_5":14479,"_27672":51103,"_2966":51303},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3483":551,"_30444":486,"_21068":51305,"_5":14479,"_27672":51103,"_2966":51306},[],"The decision is made with the domain operation context:",{"_3483":552,"_30444":486,"_21068":51308,"_5":14479,"_27672":51103,"_2966":51309},[],"The middleware extracts the credential and resolves the matching principals.",{"_3483":553,"_30444":486,"_21068":51311,"_5":14479,"_27672":51103,"_2966":51312},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3483":554,"_30444":486,"_21068":51314,"_5":14479,"_27672":51103,"_2966":51315},[],"`authz` gathers the entity rules of the granted policies.",{"_3483":555,"_30444":486,"_21068":51317,"_5":14479,"_27672":51103,"_2966":51318},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3483":556,"_30444":486,"_21068":51320,"_5":14479,"_27672":51103,"_2966":51321},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3483":557,"_30444":486,"_21068":51323,"_5":14479,"_27672":51103,"_2966":51324},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3483":558,"_30444":486,"_21068":51326,"_5":14479,"_27672":51103,"_2966":51327},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3483":559,"_30444":486,"_21068":51329,"_5":14479,"_27672":51103,"_2966":51330},[],"Actions fall into two groups:",{"_3483":560,"_30444":486,"_21068":51332,"_5":14479,"_27672":51103,"_2966":51333},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3483":561,"_30444":486,"_21068":51335,"_5":14479,"_27672":51103,"_2966":51336},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3483":562,"_30444":486,"_21068":51338,"_5":14479,"_27672":51103,"_2966":51339},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3483":563,"_30444":486,"_21068":51341,"_5":14479,"_27672":51107,"_2966":51342},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3483":564,"_30444":486,"_21068":51344,"_5":14479,"_27672":51107,"_2966":51345},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3483":565,"_30444":486,"_21068":51347,"_5":14479,"_27672":51107,"_2966":51348},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3483":566,"_30444":486,"_21068":51350,"_5":14479,"_27672":51111,"_2966":51351},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3483":567,"_30444":486,"_21068":51353,"_5":14479,"_27672":51111,"_2966":51354},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3483":568,"_30444":486,"_21068":51356,"_5":14479,"_27672":51111,"_2966":51357},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3483":569,"_30444":486,"_21068":51359,"_5":14479,"_27672":51111,"_2966":51360},[],"The implemented operators are:",{"_3483":570,"_30444":486,"_21068":51362,"_5":14479,"_27672":51111,"_2966":51363},[],"`equals`, for exact equality;",{"_3483":571,"_30444":486,"_21068":51365,"_5":14479,"_27672":51111,"_2966":51366},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3483":572,"_30444":486,"_21068":51368,"_5":14479,"_27672":51111,"_2966":51369},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3483":573,"_30444":486,"_21068":51371,"_5":14479,"_27672":51111,"_2966":51372},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3483":574,"_30444":486,"_21068":51374,"_5":14479,"_27672":51115,"_2966":51375},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3483":575,"_30444":486,"_21068":51377,"_5":14479,"_27672":51115,"_2966":51378},[],"The available modes are:",{"_3483":576,"_30444":486,"_21068":51380,"_5":14479,"_27672":51115,"_2966":51381},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3483":577,"_30444":486,"_21068":51383,"_5":14479,"_27672":51115,"_2966":51384},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3483":578,"_30444":486,"_21068":51386,"_5":14479,"_27672":51115,"_2966":51387},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3483":579,"_30444":486,"_21068":51389,"_5":14479,"_27672":51115,"_2966":51390},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3483":580,"_30444":486,"_21068":51392,"_5":14479,"_27672":51115,"_2966":51393},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3483":581,"_30444":486,"_21068":51395,"_5":14479,"_27672":51115,"_2966":51396},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3483":582,"_30444":486,"_21068":51398,"_5":14479,"_27672":51119,"_2966":51399},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3483":583,"_30444":486,"_21068":51401,"_5":14479,"_27672":51119,"_2966":51402},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3483":584,"_30444":486,"_21068":51404,"_5":14479,"_27672":51119,"_2966":51405},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3483":585,"_30444":486,"_21068":51407,"_5":14479,"_27672":51119,"_2966":51408},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3483":586,"_30444":486,"_21068":51410,"_5":14479,"_27672":51127,"_2966":51411},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3483":587,"_30444":486,"_21068":51413,"_5":14479,"_27672":51127,"_2966":51414},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3483":588,"_30444":486,"_21068":51416,"_5":14479,"_27672":51131,"_2966":51417},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3483":589,"_30444":486,"_21068":51419,"_5":14479,"_27672":51131,"_2966":51420},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3483":590,"_30444":486,"_21068":51422,"_5":14479,"_27672":51135,"_2966":51423},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3483":591,"_30444":486,"_21068":51425,"_5":14479,"_27672":51135,"_2966":51426},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3483":592,"_30444":486,"_21068":51428,"_5":14479,"_27672":51135,"_2966":51429},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3483":593,"_30444":486,"_21068":51431,"_5":14479,"_27672":51139,"_2966":51432},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3483":594,"_30444":486,"_21068":51434,"_5":14479,"_27672":51139,"_2966":51435},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3483":595,"_30444":486,"_21068":51437,"_5":14479,"_27672":51139,"_2966":51438},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3483":596,"_30444":486,"_21068":51440,"_5":14479,"_27672":51139,"_2966":51441},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3483":597,"_30444":486,"_21068":51443,"_5":14479,"_27672":51139,"_2966":51444},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3483":598,"_30444":486,"_21068":51446,"_5":14479,"_27672":51139,"_2966":51447},[],"Note that:",{"_3483":599,"_30444":486,"_21068":51449,"_5":14479,"_27672":51139,"_2966":51450},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3483":600,"_30444":486,"_21068":51452,"_5":14479,"_27672":51139,"_2966":51453},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3483":601,"_30444":486,"_21068":51455,"_5":14479,"_27672":51139,"_2966":51456},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3483":602,"_30444":486,"_21068":51458,"_5":14479,"_27672":51143,"_2966":51459},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3483":603,"_30444":486,"_21068":51461,"_5":14479,"_27672":51143,"_2966":51462},[],"full and read-only access to certificates and authorities;",{"_3483":604,"_30444":486,"_21068":51464,"_5":14479,"_27672":51143,"_2966":51465},[],"full and read-only access to the KMS;",{"_3483":605,"_30444":486,"_21068":51467,"_5":14479,"_27672":51143,"_2966":51468},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3483":606,"_30444":486,"_21068":51470,"_5":14479,"_27672":51143,"_2966":51471},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3483":607,"_30444":486,"_21068":51473,"_5":14479,"_27672":51143,"_2966":51474},[],"console access;",{"_3483":608,"_30444":486,"_21068":51476,"_5":14479,"_27672":51143,"_2966":51477},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3483":609,"_30444":486,"_21068":51479,"_5":14479,"_27672":51143,"_2966":51480},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3483":610,"_30444":486,"_21068":51482,"_5":14479,"_27672":51143,"_2966":51483},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3483":611,"_30444":486,"_21068":51485,"_5":14479,"_27672":51147,"_2966":51486},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3483":612,"_30444":486,"_21068":51488,"_5":14479,"_27672":51147,"_2966":51489},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3483":613,"_30444":486,"_21068":51491,"_5":14479,"_27672":51147,"_2966":51492},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3483":614,"_30444":486,"_21068":51494,"_5":14479,"_27672":51150,"_2966":51495},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3483":615,"_30444":486,"_21068":51497,"_5":14479,"_27672":51154,"_2966":51498},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3483":616,"_30444":486,"_21068":51500,"_5":14479,"_27672":51154,"_2966":51501},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3483":617,"_30444":486,"_21068":51503,"_5":14479,"_27672":51158,"_2966":51504},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3483":618,"_30444":486,"_21068":51506,"_5":14479,"_27672":51162,"_2966":51507},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3483":619,"_30444":486,"_21068":51509,"_5":14479,"_27672":51166,"_2966":51510},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3483":620,"_30444":486,"_21068":51512,"_5":14479,"_27672":51170,"_2966":51513},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3483":621,"_30444":486,"_21068":51515,"_5":14479,"_27672":51170,"_2966":51516},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3483":622,"_30444":486,"_21068":51518,"_5":14479,"_27672":51174,"_2966":51519},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3483":623,"_30444":486,"_21068":51521,"_5":14479,"_27672":51174,"_2966":51522},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3483":624,"_30444":486,"_21068":51524,"_5":14479,"_27672":51174,"_2966":51525},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3483":625,"_30444":486,"_21068":51527,"_5":14479,"_27672":51174,"_2966":51528},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3483":626,"_30444":486,"_21068":51530,"_5":14479,"_27672":51174,"_2966":51531},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3483":627,"_30444":486,"_21068":51533,"_5":14479,"_27672":51174,"_2966":51534},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3483":628,"_30444":486,"_21068":51536,"_5":14479,"_27672":51174,"_2966":51537},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3483":629,"_30444":486,"_21068":51539,"_5":14479,"_27672":51174,"_2966":51540},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3483":630,"_30444":486,"_21068":51542,"_5":14479,"_27672":51178,"_2966":51543},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3483":631,"_30444":486,"_21068":51545,"_5":14479,"_27672":51178,"_2966":51546},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3483":632,"_30444":486,"_21068":51548,"_5":14479,"_27672":51178,"_2966":51549},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3483":633,"_30444":486,"_21068":51551,"_5":14479,"_27672":51182,"_2966":51552},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3483":634,"_30444":486,"_21068":51554,"_5":14479,"_27672":51182,"_2966":51555},[],"Use groups or stable roles for people and independent identities for automations.",{"_3483":635,"_30444":486,"_21068":51557,"_5":14479,"_27672":51182,"_2966":51558},[],"Keep at least two recovery administrators and test their access periodically.",{"_3483":636,"_30444":486,"_21068":51560,"_5":14479,"_27672":51182,"_2966":51561},[],"Review active principals, their matches and their grants after IdP changes.",{"_3483":637,"_30444":486,"_21068":51563,"_5":14479,"_27672":51182,"_2966":51564},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3483":638,"_30444":486,"_21068":51566,"_5":14479,"_27672":51182,"_2966":51567},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3483":639,"_30444":486,"_21068":51569,"_5":14479,"_27672":51182,"_2966":51570},[],"Always test one allowed and one denied operation for each role.",{"_3483":640,"_30444":486,"_21068":51572,"_5":14479,"_27672":51182,"_2966":51573},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3483":641,"_30444":486,"_21068":51575,"_5":14479,"_27672":51190,"_2966":51576},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3483":642,"_30444":486,"_21068":51578,"_5":14479,"_27672":51194,"_2966":51579},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3483":643,"_30444":486,"_21068":51581,"_5":14479,"_27672":51194,"_2966":51582},[],"that an active principal of the correct type exists;",{"_3483":644,"_30444":486,"_21068":51584,"_5":14479,"_27672":51194,"_2966":51585},[],"that the claim paths and values match the real token exactly;",{"_3483":645,"_30444":486,"_21068":51587,"_5":14479,"_27672":51194,"_2966":51588},[],"that all of the principal's conditions hold;",{"_3483":646,"_30444":486,"_21068":51590,"_5":14479,"_27672":51194,"_2966":51591},[],"that the principal has the expected policy granted;",{"_3483":647,"_30444":486,"_21068":51593,"_5":14479,"_27672":51194,"_2966":51594},[],"that the policy includes the action and the requested resource type or route;",{"_3483":648,"_30444":486,"_21068":51596,"_5":14479,"_27672":51194,"_2966":51597},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3483":649,"_30444":486,"_21068":51599,"_5":14479,"_27672":51194,"_2966":51600},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3483":650,"_30444":486,"_21068":51602,"_5":14479,"_27672":51198,"_2966":51603},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3483":651,"_30444":486,"_21068":51605,"_5":14479,"_27672":51202,"_2966":51606},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3483":652,"_30444":486,"_21068":51608,"_5":14479,"_27672":51206,"_2966":51609},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3483":653,"_30444":486,"_21068":51611,"_5":14479,"_27672":51206,"_2966":51612},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3483":654,"_30444":654,"_5":14831,"_2966":51614,"_30797":51615,"_21068":51616,"_27672":654},"Alerts and subscriptions",[49604,51079,51080],[],{"_3483":655,"_30444":654,"_21068":51618,"_5":14479,"_27672":654,"_2966":51619},[],"Send PKI events to people and external systems.",{"_3483":656,"_30444":654,"_5":30794,"_21068":51621,"_27672":51622,"_2966":51623},[],"/docs/pr-preview/pr-65/platform/administration/alerts#how-it-works","How it works",{"_3483":657,"_30444":654,"_5":30794,"_21068":51625,"_27672":51626,"_2966":51627},[],"/docs/pr-preview/pr-65/platform/administration/alerts#available-channels","Available channels",{"_3483":658,"_30444":654,"_5":30794,"_21068":51629,"_27672":51630,"_2966":51631},[],"/docs/pr-preview/pr-65/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3483":659,"_30444":654,"_5":30794,"_21068":51633,"_27672":51634,"_2966":51635},[],"/docs/pr-preview/pr-65/platform/administration/alerts#choose-the-event","Choose the event",{"_3483":660,"_30444":654,"_5":30794,"_21068":51637,"_27672":51638,"_2966":51639},[],"/docs/pr-preview/pr-65/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3483":661,"_30444":654,"_5":30794,"_21068":51641,"_27672":51642,"_2966":51643},[],"/docs/pr-preview/pr-65/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3483":662,"_30444":654,"_5":30794,"_21068":51645,"_27672":51646,"_2966":51647},[],"/docs/pr-preview/pr-65/platform/administration/alerts#review-and-activate","Review and activate",{"_3483":663,"_30444":654,"_5":30794,"_21068":51649,"_27672":51650,"_2966":51651},[],"/docs/pr-preview/pr-65/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3483":664,"_30444":654,"_5":30794,"_21068":51653,"_27672":51654,"_2966":51655},[],"/docs/pr-preview/pr-65/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3483":665,"_30444":654,"_5":30794,"_21068":51657,"_27672":51658,"_2966":51659},[],"/docs/pr-preview/pr-65/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3483":666,"_30444":654,"_5":30794,"_21068":51661,"_27672":51662,"_2966":51663},[],"/docs/pr-preview/pr-65/platform/administration/alerts#event-families","Event families",{"_3483":667,"_30444":654,"_21068":51665,"_5":14479,"_27672":654,"_2966":51666},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3483":668,"_30444":654,"_21068":51668,"_5":14479,"_27672":51622,"_2966":51669},[],"A service publishes a domain event.",{"_3483":669,"_30444":654,"_21068":51671,"_5":14479,"_27672":51622,"_2966":51672},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3483":670,"_30444":654,"_21068":51674,"_5":14479,"_27672":51622,"_2966":51675},[],"Each subscription's filter decides whether it should be notified.",{"_3483":671,"_30444":654,"_21068":51677,"_5":14479,"_27672":51622,"_2966":51678},[],"Lamassu delivers the event to the configured channel.",{"_3483":672,"_30444":654,"_21068":51680,"_5":14479,"_27672":51622,"_2966":51681},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3483":673,"_30444":654,"_21068":51683,"_5":14479,"_27672":51626,"_2966":51684},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3483":674,"_30444":654,"_21068":51686,"_5":14479,"_27672":51626,"_2966":51687},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3483":675,"_30444":654,"_21068":51689,"_5":14479,"_27672":51626,"_2966":51690},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3483":676,"_30444":654,"_21068":51692,"_5":14479,"_27672":51626,"_2966":51693},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3483":677,"_30444":654,"_21068":51695,"_5":14479,"_27672":51626,"_2966":51696},[],"`apikey_options` requires `header` and `key`.",{"_3483":678,"_30444":654,"_21068":51698,"_5":14479,"_27672":51626,"_2966":51699},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3483":679,"_30444":654,"_21068":51701,"_5":14479,"_27672":51626,"_2966":51702},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3483":680,"_30444":654,"_21068":51704,"_5":14479,"_27672":51626,"_2966":51705},[],"The alerts API reference documents the full `http_client` schema.",{"_3483":681,"_30444":654,"_21068":51707,"_5":14479,"_27672":51634,"_2966":51708},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3483":682,"_30444":654,"_21068":51710,"_5":14479,"_27672":51638,"_2966":51711},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3483":683,"_30444":654,"_21068":51713,"_5":14479,"_27672":51642,"_2966":51714},[],"Add a filter if you don't want to receive every instance of the event.",{"_3483":684,"_30444":654,"_21068":51716,"_5":14479,"_27672":51642,"_2966":51717},[],"**None** notifies all instances of the event.",{"_3483":685,"_30444":654,"_21068":51719,"_5":14479,"_27672":51642,"_2966":51720},[],"**JSON Path** evaluates one or more specific fields.",{"_3483":686,"_30444":654,"_21068":51722,"_5":14479,"_27672":51642,"_2966":51723},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3483":687,"_30444":654,"_21068":51725,"_5":14479,"_27672":51642,"_2966":51726},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3483":688,"_30444":654,"_21068":51728,"_5":14479,"_27672":51642,"_2966":51729},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3483":689,"_30444":654,"_21068":51731,"_5":14479,"_27672":51642,"_2966":51732},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3483":690,"_30444":654,"_21068":51734,"_5":14479,"_27672":51646,"_2966":51735},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3483":691,"_30444":654,"_21068":51737,"_5":14479,"_27672":51650,"_2966":51738},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3483":692,"_30444":654,"_21068":51740,"_5":14479,"_27672":51650,"_2966":51741},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3483":693,"_30444":654,"_21068":51743,"_5":14479,"_27672":51650,"_2966":51744},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3483":694,"_30444":654,"_21068":51746,"_5":14479,"_27672":51650,"_2966":51747},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3483":695,"_30444":654,"_21068":51749,"_5":14479,"_27672":51650,"_2966":51750},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3483":696,"_30444":654,"_21068":51752,"_5":14479,"_27672":51650,"_2966":51753},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3483":697,"_30444":654,"_21068":51755,"_5":14479,"_27672":51650,"_2966":51756},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3483":698,"_30444":654,"_21068":51758,"_5":14479,"_27672":51650,"_2966":51759},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3483":699,"_30444":654,"_21068":51761,"_5":14479,"_27672":51654,"_2966":51762},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3483":700,"_30444":654,"_21068":51764,"_5":14479,"_27672":51654,"_2966":51765},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3483":701,"_30444":654,"_21068":51767,"_5":14479,"_27672":51654,"_2966":51768},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3483":702,"_30444":654,"_21068":51770,"_5":14479,"_27672":51654,"_2966":51771},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3483":703,"_30444":654,"_21068":51773,"_5":14479,"_27672":51654,"_2966":51774},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3483":704,"_30444":654,"_21068":51776,"_5":14479,"_27672":51654,"_2966":51777},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3483":705,"_30444":654,"_21068":51779,"_5":14479,"_27672":51654,"_2966":51780},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3483":706,"_30444":654,"_21068":51782,"_5":14479,"_27672":51654,"_2966":51783},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3483":707,"_30444":654,"_21068":51785,"_5":14479,"_27672":51658,"_2966":51786},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3483":708,"_30444":654,"_21068":51788,"_5":14479,"_27672":51658,"_2966":51789},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3483":709,"_30444":654,"_21068":51791,"_5":14479,"_27672":51662,"_2966":51792},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3483":710,"_30444":654,"_21068":51794,"_5":14479,"_27672":51662,"_2966":51795},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3483":711,"_30444":654,"_21068":51797,"_5":14479,"_27672":51662,"_2966":51798},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3483":712,"_30444":654,"_21068":51800,"_5":14479,"_27672":51662,"_2966":51801},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3483":713,"_30444":654,"_21068":51803,"_5":14479,"_27672":51662,"_2966":51804},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3483":714,"_30444":654,"_21068":51806,"_5":14479,"_27672":51662,"_2966":51807},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3483":715,"_30444":654,"_21068":51809,"_5":14479,"_27672":51662,"_2966":51810},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3483":716,"_30444":654,"_21068":51812,"_5":14479,"_27672":51662,"_2966":51813},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3483":717,"_30444":654,"_21068":51815,"_5":14479,"_27672":51662,"_2966":51816},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3483":718,"_30444":654,"_21068":51818,"_5":14479,"_27672":51662,"_2966":51819},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3483":719,"_30444":719,"_5":14831,"_2966":51821,"_30797":51822,"_21068":51823,"_27672":719},"Audit logs",[49604,51079,51080],[],{"_3483":720,"_30444":719,"_21068":51825,"_5":14479,"_27672":719,"_2966":51826},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3483":721,"_30444":719,"_5":30794,"_21068":51828,"_27672":51829,"_2966":51830},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3483":722,"_30444":719,"_5":30794,"_21068":51832,"_27672":51833,"_2966":51834},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#coverage","Coverage",{"_3483":723,"_30444":719,"_5":30794,"_21068":51836,"_27672":51837,"_2966":51838},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3483":724,"_30444":719,"_5":30794,"_21068":51840,"_27672":51841,"_2966":51842},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3483":725,"_30444":719,"_5":30794,"_21068":51844,"_27672":51845,"_2966":51846},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3483":726,"_30444":719,"_5":30794,"_21068":51848,"_27672":51849,"_2966":51850},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3483":727,"_30444":719,"_5":30794,"_21068":51852,"_27672":51853,"_2966":51854},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3483":728,"_30444":719,"_5":30794,"_21068":51856,"_27672":51857,"_2966":51858},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3483":729,"_30444":719,"_5":30794,"_21068":51860,"_27672":51861,"_2966":51862},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3483":730,"_30444":719,"_5":30794,"_21068":51864,"_27672":51865,"_2966":51866},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3483":731,"_30444":719,"_5":30794,"_21068":51868,"_27672":51869,"_2966":51870},[],"/docs/pr-preview/pr-65/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3483":732,"_30444":719,"_21068":51872,"_5":14479,"_27672":719,"_2966":51873},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3483":733,"_30444":719,"_21068":51875,"_5":14479,"_27672":51829,"_2966":51876},[],"The audit body includes:",{"_3483":734,"_30444":719,"_21068":51878,"_5":14479,"_27672":51829,"_2966":51879},[],"input: data received by the operation;",{"_3483":735,"_30444":719,"_21068":51881,"_5":14479,"_27672":51829,"_2966":51882},[],"has\\_error: whether the service returned an error;",{"_3483":736,"_30444":719,"_21068":51884,"_5":14479,"_27672":51829,"_2966":51885},[],"output: produced result or error message;",{"_3483":737,"_30444":719,"_21068":51887,"_5":14479,"_27672":51829,"_2966":51888},[],"principals: identifiers of the principals that matched the request.",{"_3483":738,"_30444":719,"_21068":51890,"_5":14479,"_27672":51829,"_2966":51891},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3483":739,"_30444":719,"_21068":51893,"_5":14479,"_27672":51829,"_2966":51894},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3483":740,"_30444":719,"_21068":51896,"_5":14479,"_27672":51833,"_2966":51897},[],"The backend applies auditing to mutations of:",{"_3483":741,"_30444":719,"_21068":51899,"_5":14479,"_27672":51833,"_2966":51900},[],"authorities, certificates and issuance profiles;",{"_3483":742,"_30444":719,"_21068":51902,"_5":14479,"_27672":51833,"_2966":51903},[],"keys and KMS engines;",{"_3483":743,"_30444":719,"_21068":51905,"_5":14479,"_27672":51833,"_2966":51906},[],"devices and identities;",{"_3483":744,"_30444":719,"_21068":51908,"_5":14479,"_27672":51833,"_2966":51909},[],"DMSs and enrollment operations;",{"_3483":745,"_30444":719,"_21068":51911,"_5":14479,"_27672":51833,"_2966":51912},[],"validation functions and CRL;",{"_3483":746,"_30444":719,"_21068":51914,"_5":14479,"_27672":51833,"_2966":51915},[],"principals, policies and authorization grants.",{"_3483":747,"_30444":719,"_21068":51917,"_5":14479,"_27672":51833,"_2966":51918},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3483":748,"_30444":719,"_21068":51920,"_5":14479,"_27672":51837,"_2966":51921},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3483":749,"_30444":719,"_21068":51923,"_5":14479,"_27672":51837,"_2966":51924},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3483":750,"_30444":719,"_21068":51926,"_5":14479,"_27672":51837,"_2966":51927},[],"Design the consumer to:",{"_3483":751,"_30444":719,"_21068":51929,"_5":14479,"_27672":51837,"_2966":51930},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3483":752,"_30444":719,"_21068":51932,"_5":14479,"_27672":51837,"_2966":51933},[],"keep the complete CloudEvent unmodified;",{"_3483":753,"_30444":719,"_21068":51935,"_5":14479,"_27672":51837,"_2966":51936},[],"record the ingestion time and detect duplicates by ID;",{"_3483":754,"_30444":719,"_21068":51938,"_5":14479,"_27672":51837,"_2966":51939},[],"encrypt in transit and at rest;",{"_3483":755,"_30444":719,"_21068":51941,"_5":14479,"_27672":51837,"_2966":51942},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3483":756,"_30444":719,"_21068":51944,"_5":14479,"_27672":51837,"_2966":51945},[],"apply an explicit retention and legal hold policy;",{"_3483":757,"_30444":719,"_21068":51947,"_5":14479,"_27672":51837,"_2966":51948},[],"alert if it stops consuming or the pending queue grows.",{"_3483":758,"_30444":719,"_21068":51950,"_5":14479,"_27672":51841,"_2966":51951},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3483":759,"_30444":719,"_21068":51953,"_5":14479,"_27672":51841,"_2966":51954},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3483":760,"_30444":719,"_21068":51956,"_5":14479,"_27672":51849,"_2966":51957},[],"Start from the reported time and normalize every source to UTC.",{"_3483":761,"_30444":719,"_21068":51959,"_5":14479,"_27672":51853,"_2966":51960},[],"Filter by event type, service source and resource identifier.",{"_3483":762,"_30444":719,"_21068":51962,"_5":14479,"_27672":51857,"_2966":51963},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3483":763,"_30444":719,"_21068":51965,"_5":14479,"_27672":51861,"_2966":51966},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3483":764,"_30444":719,"_21068":51968,"_5":14479,"_27672":51865,"_2966":51969},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3483":765,"_30444":719,"_21068":51971,"_5":14479,"_27672":51869,"_2966":51972},[],"Generate a controlled mutation in a test environment and check that:",{"_3483":766,"_30444":719,"_21068":51974,"_5":14479,"_27672":51869,"_2966":51975},[],"a successful audit event appears;",{"_3483":767,"_30444":719,"_21068":51977,"_5":14479,"_27672":51869,"_2966":51978},[],"the principal matches the identity used;",{"_3483":768,"_30444":719,"_21068":51980,"_5":14479,"_27672":51869,"_2966":51981},[],"the consumer persists it exactly once;",{"_3483":769,"_30444":719,"_21068":51983,"_5":14479,"_27672":51869,"_2966":51984},[],"it can be retrieved by resource, actor and period;",{"_3483":770,"_30444":719,"_21068":51986,"_5":14479,"_27672":51869,"_2966":51987},[],"a consumer outage raises an alert.",{"_3483":771,"_30444":719,"_21068":51989,"_5":14479,"_27672":51869,"_2966":51990},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3483":772,"_30444":772,"_5":14831,"_2966":51992,"_30797":51993,"_21068":51994,"_27672":772},"Platform architecture",[49604,51079],[],{"_3483":773,"_30444":772,"_21068":51996,"_5":14479,"_27672":772,"_2966":51997},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3483":774,"_30444":772,"_5":30794,"_21068":51999,"_27672":52000,"_2966":52001},[],"/docs/pr-preview/pr-65/platform/concepts/architecture#control-plane","Control plane",{"_3483":775,"_30444":772,"_5":30794,"_21068":52003,"_27672":52004,"_2966":52005},[],"/docs/pr-preview/pr-65/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3483":776,"_30444":772,"_5":30794,"_21068":52007,"_27672":52008,"_2966":52009},[],"/docs/pr-preview/pr-65/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3483":777,"_30444":772,"_5":30794,"_21068":52011,"_27672":52012,"_2966":52013},[],"/docs/pr-preview/pr-65/platform/concepts/architecture#status-and-validation","Status and validation",{"_3483":778,"_30444":772,"_5":30794,"_21068":52015,"_27672":52016,"_2966":52017},[],"/docs/pr-preview/pr-65/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3483":779,"_30444":772,"_21068":52019,"_5":14479,"_27672":772,"_2966":52020},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3483":780,"_30444":772,"_21068":52022,"_5":14479,"_27672":772,"_2966":52023},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3483":781,"_30444":772,"_21068":52025,"_5":14479,"_27672":52000,"_2966":52026},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3483":782,"_30444":772,"_21068":52028,"_5":14479,"_27672":52004,"_2966":52029},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3483":783,"_30444":772,"_21068":52031,"_5":14479,"_27672":52008,"_2966":52032},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3483":784,"_30444":772,"_21068":52034,"_5":14479,"_27672":52012,"_2966":52035},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3483":785,"_30444":772,"_21068":52037,"_5":14479,"_27672":52016,"_2966":52038},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3483":786,"_30444":786,"_5":14831,"_2966":52040,"_30797":52041,"_21068":52042,"_27672":786},"How Lamassu works",[49604,51079],[],{"_3483":787,"_30444":786,"_21068":52044,"_5":14479,"_27672":786,"_2966":52045},[],"The mental model of trust, keys, certificates and devices.",{"_3483":788,"_30444":786,"_5":30794,"_21068":52047,"_27672":52048,"_2966":52049},[],"/docs/pr-preview/pr-65/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3483":789,"_30444":786,"_5":30794,"_21068":52051,"_27672":52052,"_2966":52053},[],"/docs/pr-preview/pr-65/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3483":790,"_30444":786,"_21068":52055,"_5":14479,"_27672":786,"_2966":52056},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3483":791,"_30444":786,"_21068":52058,"_5":14479,"_27672":52048,"_2966":52059},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3483":792,"_30444":786,"_21068":52061,"_5":14479,"_27672":52048,"_2966":52062},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3483":793,"_30444":786,"_21068":52064,"_5":14479,"_27672":52048,"_2966":52065},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3483":794,"_30444":786,"_21068":52067,"_5":14479,"_27672":52048,"_2966":52068},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3483":795,"_30444":786,"_21068":52070,"_5":14479,"_27672":52048,"_2966":52071},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3483":796,"_30444":786,"_21068":52073,"_5":14479,"_27672":52052,"_2966":52074},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3483":797,"_30444":786,"_21068":52076,"_5":14479,"_27672":52052,"_2966":52077},[],"A DMS relates that CA to an enrollment policy.",{"_3483":798,"_30444":786,"_21068":52079,"_5":14479,"_27672":52052,"_2966":52080},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3483":799,"_30444":786,"_21068":52082,"_5":14479,"_27672":52052,"_2966":52083},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3483":800,"_30444":786,"_21068":52085,"_5":14479,"_27672":52052,"_2966":52086},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3483":801,"_30444":786,"_21068":52088,"_5":14479,"_27672":52052,"_2966":52089},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3483":802,"_30444":786,"_21068":52091,"_5":14479,"_27672":52052,"_2966":52092},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3483":803,"_30444":803,"_5":14831,"_2966":52094,"_30797":52095,"_21068":52097,"_27672":803},"Devices and identities",[49604,51079,52096,52094],"IoT Fleets",[],{"_3483":804,"_30444":803,"_21068":52099,"_5":14479,"_27672":803,"_2966":52100},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3483":805,"_30444":803,"_5":30794,"_21068":52102,"_27672":52103,"_2966":52104},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#device-states","Device states",{"_3483":806,"_30444":803,"_5":30794,"_21068":52106,"_27672":52107,"_2966":52108},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3483":807,"_30444":803,"_5":30794,"_21068":52110,"_27672":52111,"_2966":52112},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3483":808,"_30444":803,"_5":30794,"_21068":52114,"_27672":52115,"_2966":52116},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3483":809,"_30444":803,"_5":30794,"_21068":52118,"_27672":52119,"_2966":52120},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3483":810,"_30444":803,"_5":30794,"_21068":52122,"_27672":52123,"_2966":52124},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3483":811,"_30444":803,"_5":30794,"_21068":52126,"_27672":52127,"_2966":52128},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3483":812,"_30444":803,"_5":30794,"_21068":52130,"_27672":52131,"_2966":52132},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3483":813,"_30444":803,"_5":30794,"_21068":52134,"_27672":52135,"_2966":52136},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3483":814,"_30444":803,"_5":30794,"_21068":52138,"_27672":52139,"_2966":52140},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3483":815,"_30444":803,"_5":30794,"_21068":52142,"_27672":52143,"_2966":52144},[],"/docs/pr-preview/pr-65/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3483":816,"_30444":803,"_21068":52146,"_5":14479,"_27672":803,"_2966":52147},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3483":817,"_30444":803,"_21068":52149,"_5":14479,"_27672":803,"_2966":52150},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3483":818,"_30444":803,"_21068":52152,"_5":14479,"_27672":52103,"_2966":52153},[],"Operational view",{"_3483":819,"_30444":803,"_21068":52155,"_5":14479,"_27672":52103,"_2966":52156},[],"Meaning",{"_3483":820,"_30444":803,"_21068":52158,"_5":14479,"_27672":52103,"_2966":52159},[],"**No Identity**",{"_3483":821,"_30444":803,"_21068":52161,"_5":14479,"_27672":52103,"_2966":52162},[],"A record exists without an associated identity.",{"_3483":822,"_30444":803,"_21068":52164,"_5":14479,"_27672":52103,"_2966":52165},[],"**Active**",{"_3483":823,"_30444":803,"_21068":52167,"_5":14479,"_27672":52103,"_2966":52168},[],"The slot is active; also check certificate dates, status and usages.",{"_3483":824,"_30444":803,"_21068":52170,"_5":14479,"_27672":52103,"_2966":52171},[],"**Renewal Pending**",{"_3483":825,"_30444":803,"_21068":52173,"_5":14479,"_27672":52103,"_2966":52174},[],"The identity is in the operational renewal window.",{"_3483":826,"_30444":803,"_21068":52176,"_5":14479,"_27672":52103,"_2966":52177},[],"**Expiring Soon**",{"_3483":827,"_30444":803,"_21068":52179,"_5":14479,"_27672":52103,"_2966":52180},[],"Expiration is approaching according to configured thresholds.",{"_3483":828,"_30444":803,"_21068":52182,"_5":14479,"_27672":52103,"_2966":52183},[],"**Expired**",{"_3483":829,"_30444":803,"_21068":52185,"_5":14479,"_27672":52103,"_2966":52186},[],"The identity has expired.",{"_3483":830,"_30444":803,"_21068":52188,"_5":14479,"_27672":52103,"_2966":52189},[],"**Revoked**",{"_3483":831,"_30444":803,"_21068":52191,"_5":14479,"_27672":52103,"_2966":52192},[],"The identity is marked revoked.",{"_3483":832,"_30444":803,"_21068":52194,"_5":14479,"_27672":52103,"_2966":52195},[],"**Decommissioned**",{"_3483":833,"_30444":803,"_21068":52197,"_5":14479,"_27672":52103,"_2966":52198},[],"The record is retired and ordinary updates do not restore operation.",{"_3483":834,"_30444":803,"_21068":52200,"_5":14479,"_27672":52103,"_2966":52201},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3483":835,"_30444":803,"_21068":52203,"_5":14479,"_27672":52107,"_2966":52204},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3483":836,"_30444":803,"_21068":52206,"_5":14479,"_27672":52107,"_2966":52207},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3483":837,"_30444":803,"_21068":52209,"_5":14479,"_27672":52107,"_2966":52210},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3483":838,"_30444":803,"_21068":52212,"_5":14479,"_27672":52107,"_2966":52213},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3483":839,"_30444":803,"_21068":52215,"_5":14479,"_27672":52111,"_2966":52216},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3483":840,"_30444":803,"_21068":52218,"_5":14479,"_27672":52115,"_2966":52219},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3483":841,"_30444":803,"_21068":52221,"_5":14479,"_27672":52119,"_2966":52222},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3483":842,"_30444":803,"_21068":52224,"_5":14479,"_27672":52123,"_2966":52225},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3483":843,"_30444":803,"_21068":52227,"_5":14479,"_27672":52127,"_2966":52228},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3483":844,"_30444":803,"_21068":52230,"_5":14479,"_27672":52127,"_2966":52231},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3483":845,"_30444":803,"_21068":52233,"_5":14479,"_27672":52131,"_2966":52234},[],"From **No Identity**, use **Assign Identity**:",{"_3483":846,"_30444":803,"_21068":52236,"_5":14479,"_27672":52131,"_2966":52237},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3483":847,"_30444":803,"_21068":52239,"_5":14479,"_27672":52131,"_2966":52240},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3483":848,"_30444":803,"_21068":52242,"_5":14479,"_27672":52131,"_2966":52243},[],"Confirm and read the serial, active version and history again.",{"_3483":849,"_30444":803,"_21068":52245,"_5":14479,"_27672":52131,"_2966":52246},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3483":850,"_30444":803,"_21068":52248,"_5":14479,"_27672":52131,"_2966":52249},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3483":851,"_30444":803,"_21068":52251,"_5":14479,"_27672":52135,"_2966":52252},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3483":852,"_30444":803,"_21068":52254,"_5":14479,"_27672":52135,"_2966":52255},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3483":853,"_30444":803,"_21068":52257,"_5":14479,"_27672":52139,"_2966":52258},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3483":854,"_30444":803,"_21068":52260,"_5":14479,"_27672":52139,"_2966":52261},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3483":855,"_30444":803,"_21068":52263,"_5":14479,"_27672":52139,"_2966":52264},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3483":856,"_30444":803,"_21068":52266,"_5":14479,"_27672":52139,"_2966":52267},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3483":857,"_30444":803,"_21068":52269,"_5":14479,"_27672":52143,"_2966":52270},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3483":858,"_30444":803,"_21068":52272,"_5":14479,"_27672":52143,"_2966":52273},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3483":859,"_30444":859,"_5":14831,"_2966":52275,"_30797":52276,"_21068":52278,"_27672":859},"Bootstrap identity and authentication",[49604,51079,52096,52094,52277],"Enrollment with PKI",[],{"_3483":860,"_30444":859,"_21068":52280,"_5":14479,"_27672":859,"_2966":52281},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3483":861,"_30444":859,"_5":30794,"_21068":52283,"_27672":52284,"_2966":52285},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3483":862,"_30444":859,"_5":30794,"_21068":52287,"_27672":52288,"_2966":52289},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3483":863,"_30444":859,"_5":30794,"_21068":52291,"_27672":52292,"_2966":52293},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3483":864,"_30444":859,"_5":30794,"_21068":52295,"_27672":52296,"_2966":52297},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3483":865,"_30444":859,"_5":30794,"_21068":52299,"_27672":52300,"_2966":52301},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3483":866,"_30444":859,"_21068":52303,"_5":14479,"_27672":859,"_2966":52304},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3483":867,"_30444":859,"_21068":52306,"_5":14479,"_27672":52284,"_2966":52307},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3483":868,"_30444":859,"_21068":52309,"_5":14479,"_27672":52284,"_2966":52310},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3483":869,"_30444":859,"_21068":52312,"_5":14479,"_27672":52288,"_2966":52313},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3483":870,"_30444":859,"_21068":52315,"_5":14479,"_27672":52288,"_2966":52316},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3483":871,"_30444":859,"_21068":52318,"_5":14479,"_27672":52288,"_2966":52319},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3483":872,"_30444":859,"_21068":52321,"_5":14479,"_27672":52292,"_2966":52322},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3483":873,"_30444":859,"_21068":52324,"_5":14479,"_27672":52292,"_2966":52325},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3483":874,"_30444":859,"_21068":52327,"_5":14479,"_27672":52296,"_2966":52328},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3483":875,"_30444":859,"_21068":52330,"_5":14479,"_27672":52296,"_2966":52331},[],"Example body:",{"_3483":876,"_30444":859,"_21068":52333,"_5":14479,"_27672":52296,"_2966":52334},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3483":877,"_30444":859,"_21068":52336,"_5":14479,"_27672":52296,"_2966":52337},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3483":878,"_30444":859,"_21068":52339,"_5":14479,"_27672":52296,"_2966":52340},[],"Continuation requires a successful HTTP response and JSON:",{"_3483":879,"_30444":859,"_21068":52342,"_5":14479,"_27672":52296,"_2966":52343},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3483":880,"_30444":859,"_21068":52345,"_5":14479,"_27672":52300,"_2966":52346},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3483":881,"_30444":859,"_21068":52348,"_5":14479,"_27672":52300,"_2966":52349},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3483":882,"_30444":882,"_5":14831,"_2966":52351,"_30797":52352,"_21068":52353,"_27672":882},"Configure and operate the DMS",[49604,51079,52096,52094,52277],[],{"_3483":883,"_30444":882,"_21068":52355,"_5":14479,"_27672":882,"_2966":52356},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3483":884,"_30444":882,"_5":30794,"_21068":52358,"_27672":52359,"_2966":49614},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3483":885,"_30444":882,"_5":30794,"_21068":52361,"_27672":52362,"_2966":52363},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3483":886,"_30444":882,"_5":30794,"_21068":52365,"_27672":52366,"_2966":52367},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3483":887,"_30444":882,"_5":30794,"_21068":52369,"_27672":52370,"_2966":52371},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3483":888,"_30444":882,"_5":30794,"_21068":52373,"_27672":52374,"_2966":52375},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3483":889,"_30444":882,"_5":30794,"_21068":52377,"_27672":52378,"_2966":52379},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3483":890,"_30444":882,"_5":30794,"_21068":52381,"_27672":52382,"_2966":52383},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3483":891,"_30444":882,"_5":30794,"_21068":52385,"_27672":52386,"_2966":52387},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3483":892,"_30444":882,"_5":30794,"_21068":52389,"_27672":52390,"_2966":52391},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3483":893,"_30444":882,"_5":30794,"_21068":52393,"_27672":52394,"_2966":52395},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3483":894,"_30444":882,"_5":30794,"_21068":52397,"_27672":52398,"_2966":52399},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3483":895,"_30444":882,"_5":30794,"_21068":52401,"_27672":52402,"_2966":52403},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3483":896,"_30444":882,"_5":30794,"_21068":52405,"_27672":52406,"_2966":52407},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3483":897,"_30444":882,"_5":30794,"_21068":52409,"_27672":52410,"_2966":52411},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3483":898,"_30444":882,"_5":30794,"_21068":52413,"_27672":52414,"_2966":52415},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3483":899,"_30444":882,"_5":30794,"_21068":52417,"_27672":52418,"_2966":52419},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3483":900,"_30444":882,"_5":30794,"_21068":52421,"_27672":52422,"_2966":52423},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3483":901,"_30444":882,"_5":30794,"_21068":52425,"_27672":52426,"_2966":52427},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3483":902,"_30444":882,"_21068":52429,"_5":14479,"_27672":882,"_2966":52430},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3483":903,"_30444":882,"_21068":52432,"_5":14479,"_27672":52359,"_2966":52433},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3483":904,"_30444":882,"_21068":52435,"_5":14479,"_27672":52359,"_2966":52436},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3483":905,"_30444":882,"_21068":52438,"_5":14479,"_27672":52366,"_2966":52439},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3483":906,"_30444":882,"_21068":52441,"_5":14479,"_27672":52370,"_2966":52442},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3483":907,"_30444":882,"_21068":52444,"_5":14479,"_27672":52374,"_2966":52445},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3483":908,"_30444":882,"_21068":52447,"_5":14479,"_27672":52378,"_2966":52448},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3483":909,"_30444":882,"_21068":52450,"_5":14479,"_27672":52382,"_2966":52451},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3483":910,"_30444":882,"_21068":52453,"_5":14479,"_27672":52390,"_2966":52454},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3483":911,"_30444":882,"_21068":52456,"_5":14479,"_27672":52390,"_2966":52457},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3483":912,"_30444":882,"_21068":52459,"_5":14479,"_27672":52394,"_2966":52460},[],"`settings.enrollment_settings` field",{"_3483":913,"_30444":882,"_21068":52462,"_5":14479,"_27672":52394,"_2966":52463},[],"Decision",{"_3483":914,"_30444":882,"_21068":52465,"_5":14479,"_27672":52394,"_2966":52466},[],"`protocol`",{"_3483":915,"_30444":882,"_21068":52468,"_5":14479,"_27672":52394,"_2966":52469},[],"`EST_RFC7030` for these operations.",{"_3483":916,"_30444":882,"_21068":52471,"_5":14479,"_27672":52394,"_2966":52472},[],"`enrollment_ca`",{"_3483":917,"_30444":882,"_21068":52474,"_5":14479,"_27672":52394,"_2966":52475},[],"ID of the signing CA.",{"_3483":918,"_30444":882,"_21068":52477,"_5":14479,"_27672":52394,"_2966":52478},[],"`verify_csr_signature`",{"_3483":919,"_30444":882,"_21068":52480,"_5":14479,"_27672":52394,"_2966":52481},[],"Keep `true` to verify CSR key possession.",{"_3483":920,"_30444":882,"_21068":52483,"_5":14479,"_27672":52394,"_2966":52484},[],"`enable_replaceable_enrollment`",{"_3483":921,"_30444":882,"_21068":52486,"_5":14479,"_27672":52394,"_2966":52487},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3483":922,"_30444":882,"_21068":52489,"_5":14479,"_27672":52394,"_2966":52490},[],"`est_rfc7030_settings.auth_mode`",{"_3483":923,"_30444":882,"_21068":52492,"_5":14479,"_27672":52394,"_2966":52493},[],"One of the four authentication modes.",{"_3483":924,"_30444":882,"_21068":52495,"_5":14479,"_27672":52394,"_2966":52496},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3483":925,"_30444":882,"_21068":52498,"_5":14479,"_27672":52398,"_2966":52499},[],"The blocks are independent:",{"_3483":926,"_30444":882,"_21068":52501,"_5":14479,"_27672":52398,"_2966":52502},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3483":927,"_30444":882,"_21068":52504,"_5":14479,"_27672":52398,"_2966":52505},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3483":928,"_30444":882,"_21068":52507,"_5":14479,"_27672":52398,"_2966":52508},[],"`auth_mode`",{"_3483":929,"_30444":882,"_21068":52510,"_5":14479,"_27672":52398,"_2966":52511},[],"Control applied in the configured operation",{"_3483":930,"_30444":882,"_21068":52513,"_5":14479,"_27672":52398,"_2966":52514},[],"`CLIENT_CERTIFICATE`",{"_3483":931,"_30444":882,"_21068":52516,"_5":14479,"_27672":52398,"_2966":52517},[],"Presented certificate validation.",{"_3483":932,"_30444":882,"_21068":52519,"_5":14479,"_27672":52398,"_2966":52520},[],"`EXTERNAL_WEBHOOK`",{"_3483":933,"_30444":882,"_21068":52522,"_5":14479,"_27672":52398,"_2966":52523},[],"Configured webhook authorization.",{"_3483":934,"_30444":882,"_21068":52525,"_5":14479,"_27672":52398,"_2966":52526},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3483":935,"_30444":882,"_21068":52528,"_5":14479,"_27672":52398,"_2966":52529},[],"Certificate validation followed by webhook approval.",{"_3483":936,"_30444":882,"_21068":52531,"_5":14479,"_27672":52398,"_2966":52532},[],"`NO_AUTH`",{"_3483":937,"_30444":882,"_21068":52534,"_5":14479,"_27672":52398,"_2966":52535},[],"No DMS requester authentication.",{"_3483":938,"_30444":882,"_21068":52537,"_5":14479,"_27672":52398,"_2966":52538},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3483":939,"_30444":882,"_21068":52540,"_5":14479,"_27672":52398,"_2966":52541},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3483":940,"_30444":882,"_21068":52543,"_5":14479,"_27672":52398,"_2966":52544},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3483":941,"_30444":882,"_21068":52546,"_5":14479,"_27672":52398,"_2966":52547},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3483":942,"_30444":882,"_21068":52549,"_5":14479,"_27672":52402,"_2966":52550},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3483":943,"_30444":882,"_21068":52552,"_5":14479,"_27672":52402,"_2966":52553},[],"`external_webhook_settings` field",{"_3483":944,"_30444":882,"_21068":52555,"_5":14479,"_27672":52402,"_2966":52463},[],{"_3483":945,"_30444":882,"_21068":52557,"_5":14479,"_27672":52402,"_2966":52558},[],"`url`",{"_3483":946,"_30444":882,"_21068":52560,"_5":14479,"_27672":52402,"_2966":52561},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3483":947,"_30444":882,"_21068":52563,"_5":14479,"_27672":52402,"_2966":52564},[],"`method`",{"_3483":948,"_30444":882,"_21068":52566,"_5":14479,"_27672":52402,"_2966":52567},[],"`POST` or `PUT`; `POST` by default.",{"_3483":949,"_30444":882,"_21068":52569,"_5":14479,"_27672":52402,"_2966":52570},[],"`name`",{"_3483":950,"_30444":882,"_21068":52572,"_5":14479,"_27672":52402,"_2966":52573},[],"Label used in service logs.",{"_3483":951,"_30444":882,"_21068":52575,"_5":14479,"_27672":52402,"_2966":52576},[],"`config.auth_mode`",{"_3483":952,"_30444":882,"_21068":52578,"_5":14479,"_27672":52402,"_2966":52579},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3483":953,"_30444":882,"_21068":52581,"_5":14479,"_27672":52402,"_2966":52582},[],"`config.log_level`",{"_3483":954,"_30444":882,"_21068":52584,"_5":14479,"_27672":52402,"_2966":52585},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3483":955,"_30444":882,"_21068":52587,"_5":14479,"_27672":52402,"_2966":52588},[],"`config.apikey_options`",{"_3483":956,"_30444":882,"_21068":52590,"_5":14479,"_27672":52402,"_2966":52591},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3483":957,"_30444":882,"_21068":52593,"_5":14479,"_27672":52402,"_2966":52594},[],"`config.jwt_options`",{"_3483":958,"_30444":882,"_21068":52596,"_5":14479,"_27672":52402,"_2966":52597},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3483":959,"_30444":882,"_21068":52599,"_5":14479,"_27672":52402,"_2966":52600},[],"`config.mtls_options`",{"_3483":960,"_30444":882,"_21068":52602,"_5":14479,"_27672":52402,"_2966":52603},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3483":961,"_30444":882,"_21068":52605,"_5":14479,"_27672":52402,"_2966":52606},[],"`config.insecure_skip_verify`",{"_3483":962,"_30444":882,"_21068":52608,"_5":14479,"_27672":52402,"_2966":52609},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3483":963,"_30444":882,"_21068":52611,"_5":14479,"_27672":52402,"_2966":52612},[],"`config.call_timeout`",{"_3483":964,"_30444":882,"_21068":52614,"_5":14479,"_27672":52402,"_2966":52615},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3483":965,"_30444":882,"_21068":52617,"_5":14479,"_27672":52402,"_2966":52618},[],"Rules for that configuration:",{"_3483":966,"_30444":882,"_21068":52620,"_5":14479,"_27672":52402,"_2966":52621},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3483":967,"_30444":882,"_21068":52623,"_5":14479,"_27672":52402,"_2966":52624},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3483":968,"_30444":882,"_21068":52626,"_5":14479,"_27672":52402,"_2966":52627},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3483":969,"_30444":882,"_21068":52629,"_5":14479,"_27672":52402,"_2966":52630},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3483":970,"_30444":882,"_21068":52632,"_5":14479,"_27672":52402,"_2966":52633},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3483":971,"_30444":882,"_21068":52635,"_5":14479,"_27672":52402,"_2966":52636},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3483":972,"_30444":882,"_21068":52638,"_5":14479,"_27672":52402,"_2966":52639},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3483":973,"_30444":882,"_21068":52641,"_5":14479,"_27672":52402,"_2966":52642},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3483":974,"_30444":882,"_21068":52644,"_5":14479,"_27672":52402,"_2966":52645},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3483":975,"_30444":882,"_21068":52647,"_5":14479,"_27672":52406,"_2966":52648},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3483":976,"_30444":882,"_21068":52650,"_5":14479,"_27672":52410,"_2966":52651},[],"`settings.reenrollment_settings` field",{"_3483":977,"_30444":882,"_21068":52653,"_5":14479,"_27672":52410,"_2966":49994},[],{"_3483":978,"_30444":882,"_21068":52655,"_5":14479,"_27672":52410,"_2966":52656},[],"`reenrollment_delta`",{"_3483":979,"_30444":882,"_21068":52658,"_5":14479,"_27672":52410,"_2966":52659},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3483":980,"_30444":882,"_21068":52661,"_5":14479,"_27672":52410,"_2966":52662},[],"`preventive_delta`",{"_3483":981,"_30444":882,"_21068":52664,"_5":14479,"_27672":52410,"_2966":52665},[],"Preventive operational monitoring threshold.",{"_3483":982,"_30444":882,"_21068":52667,"_5":14479,"_27672":52410,"_2966":52668},[],"`critical_delta`",{"_3483":983,"_30444":882,"_21068":52670,"_5":14479,"_27672":52410,"_2966":52671},[],"Critical operational monitoring threshold.",{"_3483":984,"_30444":882,"_21068":52673,"_5":14479,"_27672":52410,"_2966":52674},[],"`enable_expired_renewal`",{"_3483":985,"_30444":882,"_21068":52676,"_5":14479,"_27672":52410,"_2966":52677},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3483":986,"_30444":882,"_21068":52679,"_5":14479,"_27672":52410,"_2966":52680},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3483":987,"_30444":882,"_21068":52682,"_5":14479,"_27672":52410,"_2966":52683},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3483":988,"_30444":882,"_21068":52685,"_5":14479,"_27672":52410,"_2966":52686},[],"`revoke_on_reenrollment`",{"_3483":989,"_30444":882,"_21068":52688,"_5":14479,"_27672":52410,"_2966":52689},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3483":990,"_30444":882,"_21068":52691,"_5":14479,"_27672":52410,"_2966":52692},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3483":991,"_30444":882,"_21068":52694,"_5":14479,"_27672":52414,"_2966":52695},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3483":992,"_30444":882,"_21068":52697,"_5":14479,"_27672":52418,"_2966":49988},[],{"_3483":993,"_30444":882,"_21068":52699,"_5":14479,"_27672":52418,"_2966":52700},[],"Published material",{"_3483":994,"_30444":882,"_21068":52702,"_5":14479,"_27672":52418,"_2966":52703},[],"**Include Lamassu System CA**",{"_3483":995,"_30444":882,"_21068":52705,"_5":14479,"_27672":52418,"_2966":52706},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3483":996,"_30444":882,"_21068":52708,"_5":14479,"_27672":52418,"_2966":52709},[],"**Include Enrollment CA**",{"_3483":997,"_30444":882,"_21068":52711,"_5":14479,"_27672":52418,"_2966":52712},[],"Selected issuing CA certificate.",{"_3483":998,"_30444":882,"_21068":52714,"_5":14479,"_27672":52418,"_2966":52715},[],"**Managed CAs**",{"_3483":999,"_30444":882,"_21068":52717,"_5":14479,"_27672":52418,"_2966":52718},[],"Explicitly selected CA certificates.",{"_3483":1000,"_30444":882,"_21068":52720,"_5":14479,"_27672":52418,"_2966":52721},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3483":1001,"_30444":882,"_21068":52723,"_5":14479,"_27672":52422,"_2966":52724},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3483":1002,"_30444":882,"_21068":52726,"_5":14479,"_27672":52422,"_2966":52727},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3483":1003,"_30444":882,"_21068":52729,"_5":14479,"_27672":52422,"_2966":52730},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3483":1004,"_30444":882,"_21068":52732,"_5":14479,"_27672":52426,"_2966":52733},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3483":1005,"_30444":1005,"_5":14831,"_2966":52735,"_30797":52736,"_21068":52737,"_27672":1005},"Integrate the EST client",[49604,51079,52096,52094,52277],[],{"_3483":1006,"_30444":1005,"_21068":52739,"_5":14479,"_27672":1005,"_2966":52740},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3483":1007,"_30444":1005,"_5":30794,"_21068":52742,"_27672":52743,"_2966":49614},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3483":1008,"_30444":1005,"_5":30794,"_21068":52745,"_27672":52746,"_2966":52747},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3483":1009,"_30444":1005,"_5":30794,"_21068":52749,"_27672":52750,"_2966":52751},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3483":1010,"_30444":1005,"_5":30794,"_21068":52753,"_27672":52754,"_2966":52755},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3483":1011,"_30444":1005,"_5":30794,"_21068":52757,"_27672":52758,"_2966":52759},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3483":1012,"_30444":1005,"_5":30794,"_21068":52761,"_27672":52762,"_2966":52763},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3483":1013,"_30444":1005,"_21068":52765,"_5":14479,"_27672":1005,"_2966":52766},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3483":1014,"_30444":1005,"_21068":52768,"_5":14479,"_27672":52743,"_2966":52769},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3483":1015,"_30444":1005,"_21068":52771,"_5":14479,"_27672":52743,"_2966":52772},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3483":1016,"_30444":1005,"_21068":52774,"_5":14479,"_27672":52743,"_2966":52775},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3483":1017,"_30444":1005,"_21068":52777,"_5":14479,"_27672":52746,"_2966":52778},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3483":1018,"_30444":1005,"_21068":52780,"_5":14479,"_27672":52746,"_2966":52781},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3483":1019,"_30444":1005,"_21068":52783,"_5":14479,"_27672":52750,"_2966":52784},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3483":1020,"_30444":1005,"_21068":52786,"_5":14479,"_27672":52750,"_2966":52787},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3483":1021,"_30444":1005,"_21068":52789,"_5":14479,"_27672":52754,"_2966":52790},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3483":1022,"_30444":1005,"_21068":52792,"_5":14479,"_27672":52754,"_2966":52793},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3483":1023,"_30444":1005,"_21068":52795,"_5":14479,"_27672":52758,"_2966":52796},[],"For a root that issues directly:",{"_3483":1024,"_30444":1005,"_21068":52798,"_5":14479,"_27672":52758,"_2966":52799},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3483":1025,"_30444":1005,"_21068":52801,"_5":14479,"_27672":52758,"_2966":52802},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3483":1026,"_30444":1005,"_21068":52804,"_5":14479,"_27672":52762,"_2966":52805},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3483":1027,"_30444":1027,"_5":14831,"_2966":52807,"_30797":52808,"_21068":52809,"_27672":1027},"EST reference",[49604,51079,52096,52094,52277],[],{"_3483":1028,"_30444":1027,"_21068":52811,"_5":14479,"_27672":1027,"_2966":52812},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3483":1029,"_30444":1027,"_5":30794,"_21068":52814,"_27672":52815,"_2966":52816},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3483":1030,"_30444":1027,"_5":30794,"_21068":52818,"_27672":52819,"_2966":22829},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3483":1031,"_30444":1027,"_5":30794,"_21068":52821,"_27672":52822,"_2966":26250},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3483":1032,"_30444":1027,"_5":30794,"_21068":52824,"_27672":52825,"_2966":26257},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3483":1033,"_30444":1027,"_5":30794,"_21068":52827,"_27672":52828,"_2966":25555},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3483":1034,"_30444":1027,"_5":30794,"_21068":52830,"_27672":52831,"_2966":52832},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3483":1035,"_30444":1027,"_5":30794,"_21068":52834,"_27672":52835,"_2966":52836},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3483":1036,"_30444":1027,"_5":30794,"_21068":52838,"_27672":52839,"_2966":52840},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3483":1037,"_30444":1027,"_21068":52842,"_5":14479,"_27672":1027,"_2966":52843},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3483":1038,"_30444":1027,"_21068":52845,"_5":14479,"_27672":52815,"_2966":52846},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3483":1039,"_30444":1027,"_21068":52848,"_5":14479,"_27672":52815,"_2966":52849},[],"Operation",{"_3483":1040,"_30444":1027,"_21068":52851,"_5":14479,"_27672":52815,"_2966":52852},[],"Method",{"_3483":1041,"_30444":1027,"_21068":52854,"_5":14479,"_27672":52815,"_2966":52855},[],"Authentication and condition",{"_3483":1042,"_30444":1027,"_21068":52857,"_5":14479,"_27672":52815,"_2966":52858},[],"`/cacerts`",{"_3483":1043,"_30444":1027,"_21068":52860,"_5":14479,"_27672":52815,"_2966":52861},[],"GET",{"_3483":1044,"_30444":1027,"_21068":52863,"_5":14479,"_27672":52815,"_2966":52864},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3483":1045,"_30444":1027,"_21068":52866,"_5":14479,"_27672":52815,"_2966":52867},[],"`/simpleenroll`",{"_3483":1046,"_30444":1027,"_21068":52869,"_5":14479,"_27672":52815,"_2966":52870},[],"POST",{"_3483":1047,"_30444":1027,"_21068":52872,"_5":14479,"_27672":52815,"_2966":52873},[],"Initial authentication and DMS registration/replacement policy.",{"_3483":1048,"_30444":1027,"_21068":52875,"_5":14479,"_27672":52815,"_2966":52876},[],"`/simplereenroll`",{"_3483":1049,"_30444":1027,"_21068":52878,"_5":14479,"_27672":52815,"_2966":52870},[],{"_3483":1050,"_30444":1027,"_21068":52880,"_5":14479,"_27672":52815,"_2966":52881},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3483":1051,"_30444":1027,"_21068":52883,"_5":14479,"_27672":52815,"_2966":52884},[],"`/serverkeygen`",{"_3483":1052,"_30444":1027,"_21068":52886,"_5":14479,"_27672":52815,"_2966":52870},[],{"_3483":1053,"_30444":1027,"_21068":52888,"_5":14479,"_27672":52815,"_2966":52889},[],"Initial authentication and admission; server generation enabled.",{"_3483":1054,"_30444":1027,"_21068":52891,"_5":14479,"_27672":52815,"_2966":52892},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3483":1055,"_30444":1027,"_21068":52894,"_5":14479,"_27672":52819,"_2966":52895},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3483":1056,"_30444":1027,"_21068":52897,"_5":14479,"_27672":52819,"_2966":52898},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3483":1057,"_30444":1027,"_21068":52900,"_5":14479,"_27672":52822,"_2966":52901},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3483":1058,"_30444":1027,"_21068":52903,"_5":14479,"_27672":52822,"_2966":52904},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3483":1059,"_30444":1027,"_21068":52906,"_5":14479,"_27672":52825,"_2966":52907},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3483":1060,"_30444":1027,"_21068":52909,"_5":14479,"_27672":52825,"_2966":52910},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3483":1061,"_30444":1027,"_21068":52912,"_5":14479,"_27672":52828,"_2966":52913},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3483":1062,"_30444":1027,"_21068":52915,"_5":14479,"_27672":52828,"_2966":52916},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3483":1063,"_30444":1027,"_21068":52918,"_5":14479,"_27672":52831,"_2966":52919},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3483":1064,"_30444":1027,"_21068":52921,"_5":14479,"_27672":52831,"_2966":52922},[],"Part",{"_3483":1065,"_30444":1027,"_21068":52924,"_5":14479,"_27672":52831,"_2966":52925},[],"Content after decoding its Base64",{"_3483":1066,"_30444":1027,"_21068":52927,"_5":14479,"_27672":52831,"_2966":52928},[],"`application/pkcs8`",{"_3483":1067,"_30444":1027,"_21068":52930,"_5":14479,"_27672":52831,"_2966":52931},[],"Unencrypted DER PKCS#8 private key.",{"_3483":1068,"_30444":1027,"_21068":52933,"_5":14479,"_27672":52831,"_2966":52934},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3483":1069,"_30444":1027,"_21068":52936,"_5":14479,"_27672":52831,"_2966":52937},[],"DER PKCS#7 containing the issued certificate.",{"_3483":1070,"_30444":1027,"_21068":52939,"_5":14479,"_27672":52831,"_2966":52940},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3483":1071,"_30444":1027,"_21068":52942,"_5":14479,"_27672":52835,"_2966":52943},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3483":1072,"_30444":1027,"_21068":52945,"_5":14479,"_27672":52835,"_2966":52946},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3483":1073,"_30444":1027,"_21068":52948,"_5":14479,"_27672":52835,"_2966":52949},[],"Convert and check the result:",{"_3483":1074,"_30444":1027,"_21068":52951,"_5":14479,"_27672":52835,"_2966":52952},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3483":1075,"_30444":1027,"_21068":52954,"_5":14479,"_27672":52839,"_2966":52955},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3483":1076,"_30444":1027,"_21068":52957,"_5":14479,"_27672":52839,"_2966":52958},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3483":1077,"_30444":1077,"_5":14831,"_2966":52277,"_30797":52960,"_21068":52961,"_27672":1077},[49604,51079,52096,52094,52277],[],{"_3483":1078,"_30444":1077,"_21068":52963,"_5":14479,"_27672":1077,"_2966":52964},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3483":1079,"_30444":1077,"_5":30794,"_21068":52966,"_27672":52967,"_2966":52968},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3483":1080,"_30444":1077,"_5":30794,"_21068":52970,"_27672":52971,"_2966":52972},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3483":1081,"_30444":1077,"_5":30794,"_21068":52974,"_27672":52975,"_2966":52976},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3483":1082,"_30444":1077,"_5":30794,"_21068":52978,"_27672":52979,"_2966":52980},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3483":1083,"_30444":1077,"_21068":52982,"_5":14479,"_27672":1077,"_2966":52983},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3483":1084,"_30444":1077,"_21068":52985,"_5":14479,"_27672":52967,"_2966":52986},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3483":1085,"_30444":1077,"_21068":52988,"_5":14479,"_27672":52967,"_2966":52989},[],"The integrator installs initial EST server trust and an admission credential.",{"_3483":1086,"_30444":1077,"_21068":52991,"_5":14479,"_27672":52967,"_2966":52992},[],"The client requests an identity for its `Device ID` through EST.",{"_3483":1087,"_30444":1077,"_21068":52994,"_5":14479,"_27672":52967,"_2966":52995},[],"Certificate, device binding and key/certificate installation are checked.",{"_3483":1088,"_30444":1077,"_21068":52997,"_5":14479,"_27672":52967,"_2966":52998},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3483":1089,"_30444":1077,"_21068":53000,"_5":14479,"_27672":52967,"_2966":53001},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3483":1090,"_30444":1077,"_21068":53003,"_5":14479,"_27672":52971,"_2966":53004},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3483":1091,"_30444":1077,"_21068":53006,"_5":14479,"_27672":52971,"_2966":53007},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3483":1092,"_30444":1077,"_21068":53009,"_5":14479,"_27672":52971,"_2966":53010},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3483":1093,"_30444":1077,"_21068":53012,"_5":14479,"_27672":52971,"_2966":53013},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3483":1094,"_30444":1077,"_21068":53015,"_5":14479,"_27672":52975,"_2966":53016},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3483":1095,"_30444":1077,"_21068":53018,"_5":14479,"_27672":52975,"_2966":53019},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3483":1096,"_30444":1077,"_21068":53021,"_5":14479,"_27672":52975,"_2966":53022},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3483":1097,"_30444":1077,"_21068":53024,"_5":14479,"_27672":52975,"_2966":53025},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3483":1098,"_30444":1077,"_21068":53027,"_5":14479,"_27672":52979,"_2966":53028},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3483":1099,"_30444":1077,"_21068":53030,"_5":14479,"_27672":52979,"_2966":53031},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3483":1100,"_30444":1100,"_5":14831,"_2966":53033,"_30797":53034,"_21068":53035,"_27672":1100},"Provisioning strategies",[49604,51079,52096,52094,52277],[],{"_3483":1101,"_30444":1100,"_21068":53037,"_5":14479,"_27672":1100,"_2966":53038},[],"Choose device registration, identity authorization and key generation.",{"_3483":1102,"_30444":1100,"_5":30794,"_21068":53040,"_27672":53041,"_2966":53042},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3483":1103,"_30444":1100,"_5":30794,"_21068":53044,"_27672":53045,"_2966":53046},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3483":1104,"_30444":1100,"_5":30794,"_21068":53048,"_27672":53049,"_2966":53050},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3483":1105,"_30444":1100,"_5":30794,"_21068":53052,"_27672":53053,"_2966":53054},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3483":1106,"_30444":1100,"_5":30794,"_21068":53056,"_27672":53057,"_2966":53058},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3483":1107,"_30444":1100,"_21068":53060,"_5":14479,"_27672":1100,"_2966":53061},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3483":1108,"_30444":1100,"_21068":53063,"_5":14479,"_27672":53041,"_2966":53064},[],"Path",{"_3483":1109,"_30444":1100,"_21068":53066,"_5":14479,"_27672":53041,"_2966":53067},[],"When the device exists",{"_3483":1110,"_30444":1100,"_21068":53069,"_5":14479,"_27672":53041,"_2966":53070},[],"What to check",{"_3483":1111,"_30444":1100,"_21068":53072,"_5":14479,"_27672":53041,"_2966":53073},[],"Manual assignment",{"_3483":1112,"_30444":1100,"_21068":53075,"_5":14479,"_27672":53041,"_2966":53076},[],"An operator creates it before associating a certificate.",{"_3483":1113,"_30444":1100,"_21068":53078,"_5":14479,"_27672":53041,"_2966":53079},[],"ID, owning DMS, certificate CN and bound serial.",{"_3483":1114,"_30444":1100,"_21068":53081,"_5":14479,"_27672":53041,"_2966":53082},[],"EST with `JITP`",{"_3483":1115,"_30444":1100,"_21068":53084,"_5":14479,"_27672":53041,"_2966":53085},[],"Created for an unknown CN during `/simpleenroll`.",{"_3483":1116,"_30444":1100,"_21068":53087,"_5":14479,"_27672":53041,"_2966":53088},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3483":1117,"_30444":1100,"_21068":53090,"_5":14479,"_27672":53041,"_2966":53091},[],"EST with `PRE_REGISTRATION`",{"_3483":1118,"_30444":1100,"_21068":53093,"_5":14479,"_27672":53041,"_2966":53094},[],"Must exist before `/simpleenroll`.",{"_3483":1119,"_30444":1100,"_21068":53096,"_5":14479,"_27672":53041,"_2966":53097},[],"Approved record, same DMS and replacement conditions for your version.",{"_3483":1120,"_30444":1100,"_21068":53099,"_5":14479,"_27672":53041,"_2966":53100},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3483":1121,"_30444":1100,"_21068":53102,"_5":14479,"_27672":53041,"_2966":53103},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3483":1122,"_30444":1100,"_21068":53105,"_5":14479,"_27672":53045,"_2966":53106},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3483":1123,"_30444":1100,"_21068":53108,"_5":14479,"_27672":53045,"_2966":53109},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3483":1124,"_30444":1100,"_21068":53111,"_5":14479,"_27672":53045,"_2966":53112},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3483":1125,"_30444":1100,"_21068":53114,"_5":14479,"_27672":53049,"_2966":53115},[],"Decide initial enrollment and re-enrollment separately:",{"_3483":1126,"_30444":1100,"_21068":53117,"_5":14479,"_27672":53049,"_2966":53118},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3483":1127,"_30444":1100,"_21068":53120,"_5":14479,"_27672":53049,"_2966":53121},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3483":1128,"_30444":1100,"_21068":53123,"_5":14479,"_27672":53049,"_2966":53124},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3483":1129,"_30444":1100,"_21068":53126,"_5":14479,"_27672":53049,"_2966":53127},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3483":1130,"_30444":1100,"_21068":53129,"_5":14479,"_27672":53049,"_2966":53130},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3483":1131,"_30444":1100,"_21068":53132,"_5":14479,"_27672":53053,"_2966":49988},[],{"_3483":1132,"_30444":1100,"_21068":53134,"_5":14479,"_27672":53053,"_2966":53135},[],"Material crossing EST",{"_3483":1133,"_30444":1100,"_21068":53137,"_5":14479,"_27672":53053,"_2966":53138},[],"Device-generated key",{"_3483":1134,"_30444":1100,"_21068":53140,"_5":14479,"_27672":53053,"_2966":53141},[],"Public CSR and certificate; the key stays on the client.",{"_3483":1135,"_30444":1100,"_21068":53143,"_5":14479,"_27672":53053,"_2966":53144},[],"Existing device key",{"_3483":1136,"_30444":1100,"_21068":53146,"_5":14479,"_27672":53053,"_2966":53147},[],"CSR signed with that key and a new certificate.",{"_3483":1137,"_30444":1100,"_21068":53149,"_5":14479,"_27672":53053,"_2966":52415},[],{"_3483":1138,"_30444":1100,"_21068":53151,"_5":14479,"_27672":53053,"_2966":53152},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3483":1139,"_30444":1100,"_21068":53154,"_5":14479,"_27672":53053,"_2966":53155},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3483":1140,"_30444":1100,"_21068":53157,"_5":14479,"_27672":53057,"_2966":53158},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3483":1141,"_30444":1141,"_5":14831,"_2966":53160,"_30797":53161,"_21068":53162,"_27672":1141},"Renewal and recovery",[49604,51079,52096,52094,52277],[],{"_3483":1142,"_30444":1141,"_21068":53164,"_5":14479,"_27672":1141,"_2966":53165},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3483":1143,"_30444":1141,"_5":30794,"_21068":53167,"_27672":53168,"_2966":53169},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3483":1144,"_30444":1141,"_5":30794,"_21068":53171,"_27672":53172,"_2966":53173},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3483":1145,"_30444":1141,"_5":30794,"_21068":53175,"_27672":53176,"_2966":53177},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3483":1146,"_30444":1141,"_5":30794,"_21068":53179,"_27672":53180,"_2966":53181},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3483":1147,"_30444":1141,"_5":30794,"_21068":53183,"_27672":53184,"_2966":53185},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3483":1148,"_30444":1141,"_21068":53187,"_5":14479,"_27672":1141,"_2966":53188},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3483":1149,"_30444":1141,"_21068":53190,"_5":14479,"_27672":53168,"_2966":53191},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3483":1150,"_30444":1141,"_21068":53193,"_5":14479,"_27672":53168,"_2966":53194},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3483":1151,"_30444":1141,"_21068":53196,"_5":14479,"_27672":53168,"_2966":53197},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3483":1152,"_30444":1141,"_21068":53199,"_5":14479,"_27672":53168,"_2966":53200},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3483":1153,"_30444":1141,"_21068":53202,"_5":14479,"_27672":53172,"_2966":53203},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3483":1154,"_30444":1141,"_21068":53205,"_5":14479,"_27672":53172,"_2966":53206},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3483":1155,"_30444":1141,"_21068":53208,"_5":14479,"_27672":53176,"_2966":53209},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3483":1156,"_30444":1141,"_21068":53211,"_5":14479,"_27672":53176,"_2966":53212},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3483":1157,"_30444":1141,"_21068":53214,"_5":14479,"_27672":53176,"_2966":53215},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3483":1158,"_30444":1141,"_21068":53217,"_5":14479,"_27672":53180,"_2966":53218},[],"Situation",{"_3483":1159,"_30444":1141,"_21068":53220,"_5":14479,"_27672":53180,"_2966":53221},[],"Procedure",{"_3483":1160,"_30444":1141,"_21068":53223,"_5":14479,"_27672":53180,"_2966":53224},[],"Valid certificate, outside the window",{"_3483":1161,"_30444":1141,"_21068":53226,"_5":14479,"_27672":53180,"_2966":53227},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3483":1162,"_30444":1141,"_21068":53229,"_5":14479,"_27672":53180,"_2966":53230},[],"Expired certificate, key available",{"_3483":1163,"_30444":1141,"_21068":53232,"_5":14479,"_27672":53180,"_2966":53233},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3483":1164,"_30444":1141,"_21068":53235,"_5":14479,"_27672":53180,"_2966":53236},[],"Renewal through webhook or `NO_AUTH`",{"_3483":1165,"_30444":1141,"_21068":53238,"_5":14479,"_27672":53180,"_2966":53239},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3483":1166,"_30444":1141,"_21068":53241,"_5":14479,"_27672":53180,"_2966":53242},[],"Lost or inaccessible key",{"_3483":1167,"_30444":1141,"_21068":53244,"_5":14479,"_27672":53180,"_2966":53245},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3483":1168,"_30444":1141,"_21068":53247,"_5":14479,"_27672":53180,"_2966":53248},[],"Current identity revoked",{"_3483":1169,"_30444":1141,"_21068":53250,"_5":14479,"_27672":53180,"_2966":53251},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3483":1170,"_30444":1141,"_21068":53253,"_5":14479,"_27672":53180,"_2966":53254},[],"Device without an identity",{"_3483":1171,"_30444":1141,"_21068":53256,"_5":14479,"_27672":53180,"_2966":53257},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3483":1172,"_30444":1141,"_21068":53259,"_5":14479,"_27672":53180,"_2966":53260},[],"Retired device",{"_3483":1173,"_30444":1141,"_21068":53262,"_5":14479,"_27672":53180,"_2966":53263},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3483":1174,"_30444":1141,"_21068":53265,"_5":14479,"_27672":53180,"_2966":53266},[],"Timeout, HTTP 500 or installation failure",{"_3483":1175,"_30444":1141,"_21068":53268,"_5":14479,"_27672":53180,"_2966":53269},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3483":1176,"_30444":1141,"_21068":53271,"_5":14479,"_27672":53184,"_2966":53272},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3483":1177,"_30444":1141,"_21068":53274,"_5":14479,"_27672":53184,"_2966":53275},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3483":1178,"_30444":1178,"_5":14831,"_2966":53277,"_30797":53278,"_21068":53279,"_27672":1178},"Enrollment troubleshooting",[49604,51079,52096,52094,52277],[],{"_3483":1179,"_30444":1178,"_21068":53281,"_5":14479,"_27672":1178,"_2966":53282},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3483":1180,"_30444":1178,"_5":30794,"_21068":53284,"_27672":53285,"_2966":53286},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3483":1181,"_30444":1178,"_5":30794,"_21068":53288,"_27672":53289,"_2966":53290},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3483":1182,"_30444":1178,"_5":30794,"_21068":53292,"_27672":53293,"_2966":52840},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3483":1183,"_30444":1178,"_5":30794,"_21068":53295,"_27672":53296,"_2966":53297},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3483":1184,"_30444":1178,"_21068":53299,"_5":14479,"_27672":1178,"_2966":53300},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3483":1185,"_30444":1178,"_21068":53302,"_5":14479,"_27672":53289,"_2966":53303},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3483":1186,"_30444":1178,"_21068":53305,"_5":14479,"_27672":53289,"_2966":53306},[],"Symptom or message",{"_3483":1187,"_30444":1178,"_21068":53308,"_5":14479,"_27672":53289,"_2966":53070},[],{"_3483":1188,"_30444":1178,"_21068":53310,"_5":14479,"_27672":53289,"_2966":53311},[],"curl rejects TLS, name or issuer",{"_3483":1189,"_30444":1178,"_21068":53313,"_5":14479,"_27672":53289,"_2966":53314},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3483":1190,"_30444":1178,"_21068":53316,"_5":14479,"_27672":53289,"_2966":53317},[],"404 or missing APS",{"_3483":1191,"_30444":1178,"_21068":53319,"_5":14479,"_27672":53289,"_2966":53320},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3483":1192,"_30444":1178,"_21068":53322,"_5":14479,"_27672":53289,"_2966":53323},[],"400, CSR or format error",{"_3483":1193,"_30444":1178,"_21068":53325,"_5":14479,"_27672":53289,"_2966":53326},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3483":1194,"_30444":1178,"_21068":53328,"_5":14479,"_27672":53289,"_2966":53329},[],"Missing credential or invalid certificate",{"_3483":1195,"_30444":1178,"_21068":53331,"_5":14479,"_27672":53289,"_2966":53332},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3483":1196,"_30444":1178,"_21068":53334,"_5":14479,"_27672":53289,"_2966":53335},[],"Webhook denies, times out or responds without authorization",{"_3483":1197,"_30444":1178,"_21068":53337,"_5":14479,"_27672":53289,"_2966":53338},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3483":1198,"_30444":1178,"_21068":53340,"_5":14479,"_27672":53289,"_2966":53341},[],"`unexpected status code: <n>: redirects are not followed`",{"_3483":1199,"_30444":1178,"_21068":53343,"_5":14479,"_27672":53289,"_2966":53344},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3483":1200,"_30444":1178,"_21068":53346,"_5":14479,"_27672":53289,"_2966":53347},[],"`webhook response exceeds 1048576 bytes`",{"_3483":1201,"_30444":1178,"_21068":53349,"_5":14479,"_27672":53289,"_2966":53350},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3483":1202,"_30444":1178,"_21068":53352,"_5":14479,"_27672":53289,"_2966":53353},[],"`webhook config must not reference files`",{"_3483":1203,"_30444":1178,"_21068":53355,"_5":14479,"_27672":53289,"_2966":53356},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3483":1204,"_30444":1178,"_21068":53358,"_5":14479,"_27672":53289,"_2966":53359},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3483":1205,"_30444":1178,"_21068":53361,"_5":14479,"_27672":53289,"_2966":53362},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3483":1206,"_30444":1178,"_21068":53364,"_5":14479,"_27672":53289,"_2966":53365},[],"`webhook mTLS certificate and key are invalid: …`",{"_3483":1207,"_30444":1178,"_21068":53367,"_5":14479,"_27672":53289,"_2966":53368},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3483":1208,"_30444":1178,"_21068":53370,"_5":14479,"_27672":53289,"_2966":53371},[],"400 `struct validation error` creating or updating a DMS",{"_3483":1209,"_30444":1178,"_21068":53373,"_5":14479,"_27672":53289,"_2966":53374},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3483":1210,"_30444":1178,"_21068":53376,"_5":14479,"_27672":53289,"_2966":53377},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3483":1211,"_30444":1178,"_21068":53379,"_5":14479,"_27672":53289,"_2966":53380},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3483":1212,"_30444":1178,"_21068":53382,"_5":14479,"_27672":53289,"_2966":53383},[],"`device not preregistered`",{"_3483":1213,"_30444":1178,"_21068":53385,"_5":14479,"_27672":53289,"_2966":53386},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3483":1214,"_30444":1178,"_21068":53388,"_5":14479,"_27672":53289,"_2966":53389},[],"`forbiddenNewEnrollment`",{"_3483":1215,"_30444":1178,"_21068":53391,"_5":14479,"_27672":53289,"_2966":53392},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3483":1216,"_30444":1178,"_21068":53394,"_5":14479,"_27672":53289,"_2966":53395},[],"Different owning DMS",{"_3483":1217,"_30444":1178,"_21068":53397,"_5":14479,"_27672":53289,"_2966":53398},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3483":1218,"_30444":1178,"_21068":53400,"_5":14479,"_27672":53289,"_2966":53401},[],"`invalid RawSubject bytes`",{"_3483":1219,"_30444":1178,"_21068":53403,"_5":14479,"_27672":53289,"_2966":53404},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3483":1220,"_30444":1178,"_21068":53406,"_5":14479,"_27672":53289,"_2966":53407},[],"`invalid reenroll window`",{"_3483":1221,"_30444":1178,"_21068":53409,"_5":14479,"_27672":53289,"_2966":53410},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3483":1222,"_30444":1178,"_21068":53412,"_5":14479,"_27672":53289,"_2966":53413},[],"Current certificate revoked",{"_3483":1223,"_30444":1178,"_21068":53415,"_5":14479,"_27672":53289,"_2966":53416},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3483":1224,"_30444":1178,"_21068":53418,"_5":14479,"_27672":53289,"_2966":53419},[],"CA, profile or signing error",{"_3483":1225,"_30444":1178,"_21068":53421,"_5":14479,"_27672":53289,"_2966":53422},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3483":1226,"_30444":1178,"_21068":53424,"_5":14479,"_27672":53289,"_2966":53425},[],"HTTP 200 without a device connection",{"_3483":1227,"_30444":1178,"_21068":53427,"_5":14479,"_27672":53289,"_2966":53428},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3483":1228,"_30444":1178,"_21068":53430,"_5":14479,"_27672":53289,"_2966":53431},[],"Timeout or error after issuance",{"_3483":1229,"_30444":1178,"_21068":53433,"_5":14479,"_27672":53289,"_2966":53434},[],"New certificates, current slot and previous identity's state before retrying.",{"_3483":1230,"_30444":1178,"_21068":53436,"_5":14479,"_27672":53293,"_2966":53437},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3483":1231,"_30444":1178,"_21068":53439,"_5":14479,"_27672":53293,"_2966":53440},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3483":1232,"_30444":1178,"_21068":53442,"_5":14479,"_27672":53296,"_2966":53443},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3483":1233,"_30444":1178,"_21068":53445,"_5":14479,"_27672":53296,"_2966":53446},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3483":1234,"_30444":1178,"_21068":53448,"_5":14479,"_27672":53296,"_2966":53449},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3483":1235,"_30444":1178,"_21068":53451,"_5":14479,"_27672":53296,"_2966":53452},[],"Make one request, save headers/body and query the device and certificates.",{"_3483":1236,"_30444":1178,"_21068":53454,"_5":14479,"_27672":53296,"_2966":53455},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3483":1237,"_30444":1178,"_21068":53457,"_5":14479,"_27672":53296,"_2966":53458},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3483":1238,"_30444":1178,"_21068":53460,"_5":14479,"_27672":53296,"_2966":53461},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3483":1239,"_30444":1239,"_5":14831,"_2966":53463,"_30797":53464,"_21068":53465,"_27672":1239},"Trust distribution and updates",[49604,51079,52096,52094,52277],[],{"_3483":1240,"_30444":1239,"_21068":53467,"_5":14479,"_27672":1239,"_2966":53468},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3483":1241,"_30444":1239,"_5":30794,"_21068":53470,"_27672":53471,"_2966":53472},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3483":1242,"_30444":1239,"_5":30794,"_21068":53474,"_27672":53475,"_2966":53476},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3483":1243,"_30444":1239,"_5":30794,"_21068":53478,"_27672":53479,"_2966":53480},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3483":1244,"_30444":1239,"_5":30794,"_21068":53482,"_27672":53483,"_2966":53484},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3483":1245,"_30444":1239,"_5":30794,"_21068":53486,"_27672":53487,"_2966":53488},[],"/docs/pr-preview/pr-65/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3483":1246,"_30444":1239,"_21068":53490,"_5":14479,"_27672":1239,"_2966":53491},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3483":1247,"_30444":1239,"_21068":53493,"_5":14479,"_27672":53471,"_2966":53494},[],"Relationship",{"_3483":1248,"_30444":1239,"_21068":53496,"_5":14479,"_27672":53471,"_2966":53497},[],"Material prepared by its owner",{"_3483":1249,"_30444":1239,"_21068":53499,"_5":14479,"_27672":53471,"_2966":53500},[],"Device → EST server",{"_3483":1250,"_30444":1239,"_21068":53502,"_5":14479,"_27672":53471,"_2966":53503},[],"Previously verified server root, chain or pin and TLS name.",{"_3483":1251,"_30444":1239,"_21068":53505,"_5":14479,"_27672":53471,"_2966":53506},[],"DMS → requester",{"_3483":1252,"_30444":1239,"_21068":53508,"_5":14479,"_27672":53471,"_2966":53509},[],"CAs and rules authorizing initial or renewal credentials.",{"_3483":1253,"_30444":1239,"_21068":53511,"_5":14479,"_27672":53471,"_2966":53512},[],"Consumer → device",{"_3483":1254,"_30444":1239,"_21068":53514,"_5":14479,"_27672":53471,"_2966":53515},[],"Operational identity roots, intermediates, validation and permissions.",{"_3483":1255,"_30444":1239,"_21068":53517,"_5":14479,"_27672":53471,"_2966":53518},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3483":1256,"_30444":1239,"_21068":53520,"_5":14479,"_27672":53475,"_2966":53521},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3483":1257,"_30444":1239,"_21068":53523,"_5":14479,"_27672":53475,"_2966":53524},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3483":1258,"_30444":1239,"_21068":53526,"_5":14479,"_27672":53479,"_2966":53527},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3483":1259,"_30444":1239,"_21068":53529,"_5":14479,"_27672":53479,"_2966":53530},[],"Select policy-approved roots as anchors.",{"_3483":1260,"_30444":1239,"_21068":53532,"_5":14479,"_27672":53479,"_2966":53533},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3483":1261,"_30444":1239,"_21068":53535,"_5":14479,"_27672":53479,"_2966":53536},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3483":1262,"_30444":1239,"_21068":53538,"_5":14479,"_27672":53479,"_2966":53539},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3483":1263,"_30444":1239,"_21068":53541,"_5":14479,"_27672":53479,"_2966":53542},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3483":1264,"_30444":1239,"_21068":53544,"_5":14479,"_27672":53483,"_2966":53545},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3483":1265,"_30444":1239,"_21068":53547,"_5":14479,"_27672":53483,"_2966":53548},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3483":1266,"_30444":1239,"_21068":53550,"_5":14479,"_27672":53483,"_2966":53551},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3483":1267,"_30444":1239,"_21068":53553,"_5":14479,"_27672":53487,"_2966":53554},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3483":1268,"_30444":1268,"_5":14831,"_2966":53556,"_30797":53557,"_21068":53559,"_27672":1268},"AWS IoT Core",[49604,51079,52096,52094,53558],"Integrations",[],{"_3483":1269,"_30444":1268,"_21068":53561,"_5":14479,"_27672":1268,"_2966":53562},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3483":1270,"_30444":1268,"_5":30794,"_21068":53564,"_27672":53565,"_2966":53566},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3483":1271,"_30444":1268,"_5":30794,"_21068":53568,"_27672":53569,"_2966":53570},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3483":1272,"_30444":1268,"_5":30794,"_21068":53572,"_27672":53573,"_2966":53574},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3483":1273,"_30444":1268,"_5":30794,"_21068":53576,"_27672":53577,"_2966":53578},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3483":1274,"_30444":1268,"_5":30794,"_21068":53580,"_27672":53581,"_2966":53582},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3483":1275,"_30444":1268,"_5":30794,"_21068":53584,"_27672":53585,"_2966":53586},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3483":1276,"_30444":1268,"_5":30794,"_21068":53588,"_27672":53589,"_2966":53590},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3483":1277,"_30444":1268,"_5":30794,"_21068":53592,"_27672":53593,"_2966":53594},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3483":1278,"_30444":1268,"_5":30794,"_21068":53596,"_27672":53597,"_2966":53598},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3483":1279,"_30444":1268,"_5":30794,"_21068":53600,"_27672":53601,"_2966":53602},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3483":1280,"_30444":1268,"_5":30794,"_21068":53604,"_27672":53605,"_2966":53606},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3483":1281,"_30444":1268,"_5":30794,"_21068":53608,"_27672":53609,"_2966":53610},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3483":1282,"_30444":1268,"_5":30794,"_21068":53612,"_27672":53613,"_2966":53614},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3483":1283,"_30444":1268,"_5":30794,"_21068":53616,"_27672":53617,"_2966":53618},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3483":1284,"_30444":1268,"_5":30794,"_21068":53620,"_27672":53621,"_2966":53622},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3483":1285,"_30444":1268,"_5":30794,"_21068":53624,"_27672":53625,"_2966":53626},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3483":1286,"_30444":1268,"_5":30794,"_21068":53628,"_27672":53629,"_2966":53630},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3483":1287,"_30444":1268,"_5":30794,"_21068":53632,"_27672":53633,"_2966":53634},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3483":1288,"_30444":1268,"_5":30794,"_21068":53636,"_27672":53637,"_2966":53638},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3483":1289,"_30444":1268,"_5":30794,"_21068":53640,"_27672":53641,"_2966":53642},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3483":1290,"_30444":1268,"_5":30794,"_21068":53644,"_27672":53645,"_2966":53646},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3483":1291,"_30444":1268,"_5":30794,"_21068":53648,"_27672":53649,"_2966":53650},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3483":1292,"_30444":1268,"_5":30794,"_21068":53652,"_27672":53653,"_2966":53654},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3483":1293,"_30444":1268,"_5":30794,"_21068":53656,"_27672":53657,"_2966":53658},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3483":1294,"_30444":1268,"_5":30794,"_21068":53660,"_27672":53661,"_2966":53662},[],"/docs/pr-preview/pr-65/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3483":1295,"_30444":1268,"_21068":53664,"_5":14479,"_27672":1268,"_2966":53665},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3483":1296,"_30444":1268,"_21068":53667,"_5":14479,"_27672":1268,"_2966":53668},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3483":1297,"_30444":1268,"_21068":53670,"_5":14479,"_27672":1268,"_2966":53671},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3483":1298,"_30444":1268,"_21068":53673,"_5":14479,"_27672":53565,"_2966":53674},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3483":1299,"_30444":1268,"_21068":53676,"_5":14479,"_27672":53565,"_2966":53677},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3483":1300,"_30444":1268,"_21068":53679,"_5":14479,"_27672":53565,"_2966":53680},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3483":1301,"_30444":1268,"_21068":53682,"_5":14479,"_27672":53565,"_2966":53683},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3483":1302,"_30444":1268,"_21068":53685,"_5":14479,"_27672":53569,"_2966":53686},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3483":1303,"_30444":1268,"_21068":53688,"_5":14479,"_27672":53573,"_2966":53689},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3483":1304,"_30444":1268,"_21068":53691,"_5":14479,"_27672":53573,"_2966":53692},[],"IAM action",{"_3483":1305,"_30444":1268,"_21068":53694,"_5":14479,"_27672":53573,"_2966":49994},[],{"_3483":1306,"_30444":1268,"_21068":53696,"_5":14479,"_27672":53573,"_2966":53697},[],"`iot:GetRegistrationCode`",{"_3483":1307,"_30444":1268,"_21068":53699,"_5":14479,"_27672":53573,"_2966":53700},[],"Obtain the verification code for CA registration in the Primary Account",{"_3483":1308,"_30444":1268,"_21068":53702,"_5":14479,"_27672":53573,"_2966":53703},[],"`iot:RegisterCACertificate`",{"_3483":1309,"_30444":1268,"_21068":53705,"_5":14479,"_27672":53573,"_2966":53706},[],"Register the CA in AWS IoT",{"_3483":1310,"_30444":1268,"_21068":53708,"_5":14479,"_27672":53573,"_2966":53709},[],"`iot:DescribeCACertificate`",{"_3483":1311,"_30444":1268,"_21068":53711,"_5":14479,"_27672":53573,"_2966":53712},[],"Check the CA registration status",{"_3483":1312,"_30444":1268,"_21068":53714,"_5":14479,"_27672":53573,"_2966":53715},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3483":1313,"_30444":1268,"_21068":53717,"_5":14479,"_27672":53573,"_2966":53718},[],"Create or update Things in IoT Core",{"_3483":1314,"_30444":1268,"_21068":53720,"_5":14479,"_27672":53573,"_2966":53721},[],"`iot:RegisterThing`",{"_3483":1315,"_30444":1268,"_21068":53723,"_5":14479,"_27672":53573,"_2966":53724},[],"Provision Things through a template",{"_3483":1316,"_30444":1268,"_21068":53726,"_5":14479,"_27672":53573,"_2966":53727},[],"`iot:RegisterCertificate`",{"_3483":1317,"_30444":1268,"_21068":53729,"_5":14479,"_27672":53573,"_2966":53730},[],"Register device certificates",{"_3483":1318,"_30444":1268,"_21068":53732,"_5":14479,"_27672":53573,"_2966":53733},[],"`iot:UpdateCertificate`",{"_3483":1319,"_30444":1268,"_21068":53735,"_5":14479,"_27672":53573,"_2966":53736},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3483":1320,"_30444":1268,"_21068":53738,"_5":14479,"_27672":53573,"_2966":53739},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3483":1321,"_30444":1268,"_21068":53741,"_5":14479,"_27672":53573,"_2966":53742},[],"Create and attach IoT policies",{"_3483":1322,"_30444":1268,"_21068":53744,"_5":14479,"_27672":53573,"_2966":53745},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3483":1323,"_30444":1268,"_21068":53747,"_5":14479,"_27672":53573,"_2966":53748},[],"Manage Thing groups",{"_3483":1324,"_30444":1268,"_21068":53750,"_5":14479,"_27672":53573,"_2966":53751},[],"`iot:CreateProvisioningTemplate`",{"_3483":1325,"_30444":1268,"_21068":53753,"_5":14479,"_27672":53573,"_2966":53754},[],"Create JITP templates",{"_3483":1326,"_30444":1268,"_21068":53756,"_5":14479,"_27672":53573,"_2966":53757},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3483":1327,"_30444":1268,"_21068":53759,"_5":14479,"_27672":53573,"_2966":53760},[],"Read and write the Device Shadow",{"_3483":1328,"_30444":1268,"_21068":53762,"_5":14479,"_27672":53573,"_2966":53763},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3483":1329,"_30444":1268,"_21068":53765,"_5":14479,"_27672":53577,"_2966":53766},[],"Parameter",{"_3483":1330,"_30444":1268,"_21068":53768,"_5":14479,"_27672":53577,"_2966":53769},[],"Type",{"_3483":1331,"_30444":1268,"_21068":53771,"_5":14479,"_27672":53577,"_2966":53772},[],"Required",{"_3483":1332,"_30444":1268,"_21068":53774,"_5":14479,"_27672":53577,"_2966":53775},[],"Description",{"_3483":1333,"_30444":1268,"_21068":53777,"_5":14479,"_27672":53577,"_2966":53778},[],"`connector_id`",{"_3483":1334,"_30444":1268,"_21068":53780,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1335,"_30444":1268,"_21068":53782,"_5":14479,"_27672":53577,"_2966":53783},[],"Yes",{"_3483":1336,"_30444":1268,"_21068":53785,"_5":14479,"_27672":53577,"_2966":53786},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3483":1337,"_30444":1268,"_21068":53788,"_5":14479,"_27672":53577,"_2966":53789},[],"`aws_config.region`",{"_3483":1338,"_30444":1268,"_21068":53791,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1339,"_30444":1268,"_21068":53793,"_5":14479,"_27672":53577,"_2966":53783},[],{"_3483":1340,"_30444":1268,"_21068":53795,"_5":14479,"_27672":53577,"_2966":53796},[],"AWS region where the connector operates.",{"_3483":1341,"_30444":1268,"_21068":53798,"_5":14479,"_27672":53577,"_2966":53799},[],"`aws_config.auth_method`",{"_3483":1342,"_30444":1268,"_21068":53801,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1343,"_30444":1268,"_21068":53803,"_5":14479,"_27672":53577,"_2966":53783},[],{"_3483":1344,"_30444":1268,"_21068":53805,"_5":14479,"_27672":53577,"_2966":53806},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3483":1345,"_30444":1268,"_21068":53808,"_5":14479,"_27672":53577,"_2966":53809},[],"`aws_config.access_key_id`",{"_3483":1346,"_30444":1268,"_21068":53811,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1347,"_30444":1268,"_21068":53813,"_5":14479,"_27672":53577,"_2966":53814},[],"Only with `auth_method=static`",{"_3483":1348,"_30444":1268,"_21068":53816,"_5":14479,"_27672":53577,"_2966":53817},[],"AWS access key.",{"_3483":1349,"_30444":1268,"_21068":53819,"_5":14479,"_27672":53577,"_2966":53820},[],"`aws_config.secret_access_key`",{"_3483":1350,"_30444":1268,"_21068":53822,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1351,"_30444":1268,"_21068":53824,"_5":14479,"_27672":53577,"_2966":53814},[],{"_3483":1352,"_30444":1268,"_21068":53826,"_5":14479,"_27672":53577,"_2966":53827},[],"AWS secret key.",{"_3483":1353,"_30444":1268,"_21068":53829,"_5":14479,"_27672":53577,"_2966":53830},[],"`aws_config.session_token`",{"_3483":1354,"_30444":1268,"_21068":53832,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1355,"_30444":1268,"_21068":53834,"_5":14479,"_27672":53577,"_2966":53835},[],"No",{"_3483":1356,"_30444":1268,"_21068":53837,"_5":14479,"_27672":53577,"_2966":53838},[],"Session token (with `auth_method=static`).",{"_3483":1357,"_30444":1268,"_21068":53840,"_5":14479,"_27672":53577,"_2966":53841},[],"`aws_config.role_arn`",{"_3483":1358,"_30444":1268,"_21068":53843,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1359,"_30444":1268,"_21068":53845,"_5":14479,"_27672":53577,"_2966":53846},[],"Only with `auth_method=role`",{"_3483":1360,"_30444":1268,"_21068":53848,"_5":14479,"_27672":53577,"_2966":53849},[],"ARN of the role to assume.",{"_3483":1361,"_30444":1268,"_21068":53851,"_5":14479,"_27672":53577,"_2966":53852},[],"`aws_config.endpoint_url`",{"_3483":1362,"_30444":1268,"_21068":53854,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1363,"_30444":1268,"_21068":53856,"_5":14479,"_27672":53577,"_2966":53835},[],{"_3483":1364,"_30444":1268,"_21068":53858,"_5":14479,"_27672":53577,"_2966":53859},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3483":1365,"_30444":1268,"_21068":53861,"_5":14479,"_27672":53577,"_2966":53862},[],"`subscriber_event_bus`",{"_3483":1366,"_30444":1268,"_21068":53864,"_5":14479,"_27672":53577,"_2966":17746},[],{"_3483":1367,"_30444":1268,"_21068":53866,"_5":14479,"_27672":53577,"_2966":53783},[],{"_3483":1368,"_30444":1268,"_21068":53868,"_5":14479,"_27672":53577,"_2966":53869},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3483":1369,"_30444":1268,"_21068":53871,"_5":14479,"_27672":53577,"_2966":53872},[],"`dms_manager_client`",{"_3483":1370,"_30444":1268,"_21068":53874,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1371,"_30444":1268,"_21068":53876,"_5":14479,"_27672":53577,"_2966":53783},[],{"_3483":1372,"_30444":1268,"_21068":53878,"_5":14479,"_27672":53577,"_2966":53879},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3483":1373,"_30444":1268,"_21068":53881,"_5":14479,"_27672":53577,"_2966":53882},[],"`device_manager_client`",{"_3483":1374,"_30444":1268,"_21068":53884,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1375,"_30444":1268,"_21068":53886,"_5":14479,"_27672":53577,"_2966":53783},[],{"_3483":1376,"_30444":1268,"_21068":53888,"_5":14479,"_27672":53577,"_2966":53889},[],"HTTP URL of Lamassu's Device Manager.",{"_3483":1377,"_30444":1268,"_21068":53891,"_5":14479,"_27672":53577,"_2966":53892},[],"`ca_client`",{"_3483":1378,"_30444":1268,"_21068":53894,"_5":14479,"_27672":53577,"_2966":25195},[],{"_3483":1379,"_30444":1268,"_21068":53896,"_5":14479,"_27672":53577,"_2966":53783},[],{"_3483":1380,"_30444":1268,"_21068":53898,"_5":14479,"_27672":53577,"_2966":53899},[],"HTTP URL of Lamassu's CA service.",{"_3483":1381,"_30444":1268,"_21068":53901,"_5":14479,"_27672":53581,"_2966":53902},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3483":1382,"_30444":1268,"_21068":53904,"_5":14479,"_27672":53581,"_2966":53905},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3483":1383,"_30444":1268,"_21068":53907,"_5":14479,"_27672":53581,"_2966":53908},[],"CloudEvent type",{"_3483":1384,"_30444":1268,"_21068":53910,"_5":14479,"_27672":53581,"_2966":53911},[],"Lamassu resource",{"_3483":1385,"_30444":1268,"_21068":53913,"_5":14479,"_27672":53581,"_2966":53914},[],"AWS Resource",{"_3483":1386,"_30444":1268,"_21068":53916,"_5":14479,"_27672":53581,"_2966":53917},[],"IAM actions",{"_3483":1387,"_30444":1268,"_21068":53919,"_5":14479,"_27672":53581,"_2966":53920},[],"AWS calls and effect",{"_3483":1388,"_30444":1268,"_21068":53922,"_5":14479,"_27672":53581,"_2966":53923},[],"Where in this page",{"_3483":1389,"_30444":1268,"_21068":53925,"_5":14479,"_27672":53581,"_2966":53926},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3483":1390,"_30444":1268,"_21068":53928,"_5":14479,"_27672":53581,"_2966":53929},[],"CA",{"_3483":1391,"_30444":1268,"_21068":53931,"_5":14479,"_27672":53581,"_2966":53932},[],"`IoTCore/CACertificate`",{"_3483":1392,"_30444":1268,"_21068":53934,"_5":14479,"_27672":53581,"_2966":53935},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3483":1393,"_30444":1268,"_21068":53937,"_5":14479,"_27672":53581,"_2966":53938},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3483":1394,"_30444":1268,"_21068":53940,"_5":14479,"_27672":53581,"_2966":53594},[],{"_3483":1395,"_30444":1268,"_21068":53942,"_5":14479,"_27672":53581,"_2966":53943},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3483":1396,"_30444":1268,"_21068":53945,"_5":14479,"_27672":53581,"_2966":53946},[],"DMS",{"_3483":1397,"_30444":1268,"_21068":53948,"_5":14479,"_27672":53581,"_2966":53949},[],"`IoTCore/ProvisioningTemplate`",{"_3483":1398,"_30444":1268,"_21068":53951,"_5":14479,"_27672":53581,"_2966":53952},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3483":1399,"_30444":1268,"_21068":53954,"_5":14479,"_27672":53581,"_2966":53955},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3483":1400,"_30444":1268,"_21068":53957,"_5":14479,"_27672":53581,"_2966":53622},[],{"_3483":1401,"_30444":1268,"_21068":53959,"_5":14479,"_27672":53581,"_2966":53960},[],"`EventBindDeviceIdentityKey`",{"_3483":1402,"_30444":1268,"_21068":53962,"_5":14479,"_27672":53581,"_2966":53963},[],"Device",{"_3483":1403,"_30444":1268,"_21068":53965,"_5":14479,"_27672":53581,"_2966":53966},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3483":1404,"_30444":1268,"_21068":53968,"_5":14479,"_27672":53581,"_2966":53969},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3483":1405,"_30444":1268,"_21068":53971,"_5":14479,"_27672":53581,"_2966":53972},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3483":1406,"_30444":1268,"_21068":53974,"_5":14479,"_27672":53581,"_2966":53630},[],{"_3483":1407,"_30444":1268,"_21068":53976,"_5":14479,"_27672":53581,"_2966":53977},[],"`EventUpdateCertificateStatusKey`",{"_3483":1408,"_30444":1268,"_21068":53979,"_5":14479,"_27672":53581,"_2966":53980},[],"Certificate",{"_3483":1409,"_30444":1268,"_21068":53982,"_5":14479,"_27672":53581,"_2966":53983},[],"`IoTCore/Certificate`",{"_3483":1410,"_30444":1268,"_21068":53985,"_5":14479,"_27672":53581,"_2966":53986},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3483":1411,"_30444":1268,"_21068":53988,"_5":14479,"_27672":53581,"_2966":53989},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3483":1412,"_30444":1268,"_21068":53991,"_5":14479,"_27672":53581,"_2966":53642},[],{"_3483":1413,"_30444":1268,"_21068":53993,"_5":14479,"_27672":53581,"_2966":53994},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3483":1414,"_30444":1268,"_21068":53996,"_5":14479,"_27672":53581,"_2966":53997},[],"Certificate / Device",{"_3483":1415,"_30444":1268,"_21068":53999,"_5":14479,"_27672":53581,"_2966":54000},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3483":1416,"_30444":1268,"_21068":54002,"_5":14479,"_27672":53581,"_2966":50000},[],{"_3483":1417,"_30444":1268,"_21068":54004,"_5":14479,"_27672":53581,"_2966":54005},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3483":1418,"_30444":1268,"_21068":54007,"_5":14479,"_27672":53581,"_2966":53650},[],{"_3483":1419,"_30444":1268,"_21068":54009,"_5":14479,"_27672":53585,"_2966":54010},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3483":1420,"_30444":1268,"_21068":54012,"_5":14479,"_27672":53589,"_2966":54013},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3483":1421,"_30444":1268,"_21068":54015,"_5":14479,"_27672":53589,"_2966":54016},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3483":1422,"_30444":1268,"_21068":54018,"_5":14479,"_27672":53593,"_2966":54019},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3483":1423,"_30444":1268,"_21068":54021,"_5":14479,"_27672":53593,"_2966":54022},[],"Transition",{"_3483":1424,"_30444":1268,"_21068":54024,"_5":14479,"_27672":53593,"_2966":54025},[],"AWS calls",{"_3483":1425,"_30444":1268,"_21068":54027,"_5":14479,"_27672":53593,"_2966":54028},[],"`NotRegistered` → `Requested`",{"_3483":1426,"_30444":1268,"_21068":54030,"_5":14479,"_27672":53593,"_2966":54031},[],"none (metadata write only)",{"_3483":1427,"_30444":1268,"_21068":54033,"_5":14479,"_27672":53593,"_2966":54034},[],"`Requested` → `Registering`",{"_3483":1428,"_30444":1268,"_21068":54036,"_5":14479,"_27672":53593,"_2966":54037},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3483":1429,"_30444":1268,"_21068":54039,"_5":14479,"_27672":53593,"_2966":54040},[],"`Registering` → `Succeeded`",{"_3483":1430,"_30444":1268,"_21068":54042,"_5":14479,"_27672":53593,"_2966":54043},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3483":1431,"_30444":1268,"_21068":54045,"_5":14479,"_27672":53593,"_2966":54046},[],"`Registering` → `Failed`",{"_3483":1432,"_30444":1268,"_21068":54048,"_5":14479,"_27672":53593,"_2966":54049},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3483":1433,"_30444":1268,"_21068":54051,"_5":14479,"_27672":53593,"_2966":54052},[],"`Failed` / `Succeeded` → `Requested`",{"_3483":1434,"_30444":1268,"_21068":54054,"_5":14479,"_27672":53593,"_2966":54055},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3483":1435,"_30444":1268,"_21068":54057,"_5":14479,"_27672":53597,"_2966":54058},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3483":1436,"_30444":1268,"_21068":54060,"_5":14479,"_27672":53597,"_2966":54061},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3483":1437,"_30444":1268,"_21068":54063,"_5":14479,"_27672":53597,"_2966":54064},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3483":1438,"_30444":1268,"_21068":54066,"_5":14479,"_27672":53597,"_2966":54067},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3483":1439,"_30444":1268,"_21068":54069,"_5":14479,"_27672":53597,"_2966":54070},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3483":1440,"_30444":1268,"_21068":54072,"_5":14479,"_27672":53597,"_2966":54073},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3483":1441,"_30444":1268,"_21068":54075,"_5":14479,"_27672":53601,"_2966":54076},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3483":1442,"_30444":1268,"_21068":54078,"_5":14479,"_27672":53605,"_2966":54079},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3483":1443,"_30444":1268,"_21068":54081,"_5":14479,"_27672":53605,"_2966":54082},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3483":1444,"_30444":1268,"_21068":54084,"_5":14479,"_27672":53609,"_2966":54085},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3483":1445,"_30444":1268,"_21068":54087,"_5":14479,"_27672":53613,"_2966":54088},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3483":1446,"_30444":1268,"_21068":54090,"_5":14479,"_27672":53613,"_2966":54091},[],"Creates or updates the IoT policies configured in the DMS.",{"_3483":1447,"_30444":1268,"_21068":54093,"_5":14479,"_27672":53613,"_2966":54094},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3483":1448,"_30444":1268,"_21068":54096,"_5":14479,"_27672":53613,"_2966":54097},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3483":1449,"_30444":1268,"_21068":54099,"_5":14479,"_27672":53613,"_2966":54100},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3483":1450,"_30444":1268,"_21068":54102,"_5":14479,"_27672":53613,"_2966":54103},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3483":1451,"_30444":1268,"_21068":54105,"_5":14479,"_27672":53613,"_2966":54106},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3483":1452,"_30444":1268,"_21068":54108,"_5":14479,"_27672":53617,"_2966":54109},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3483":1453,"_30444":1268,"_21068":54111,"_5":14479,"_27672":53617,"_2966":54112},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3483":1454,"_30444":1268,"_21068":54114,"_5":14479,"_27672":53617,"_2966":54115},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3483":1455,"_30444":1268,"_21068":54117,"_5":14479,"_27672":53617,"_2966":54118},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3483":1456,"_30444":1268,"_21068":54120,"_5":14479,"_27672":53617,"_2966":54121},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3483":1457,"_30444":1268,"_21068":54123,"_5":14479,"_27672":53621,"_2966":54124},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3483":1458,"_30444":1268,"_21068":54126,"_5":14479,"_27672":53621,"_2966":54022},[],{"_3483":1459,"_30444":1268,"_21068":54128,"_5":14479,"_27672":53621,"_2966":54025},[],{"_3483":1460,"_30444":1268,"_21068":54130,"_5":14479,"_27672":53621,"_2966":54131},[],"`Unconfigured` → `None` / `Auto`",{"_3483":1461,"_30444":1268,"_21068":54133,"_5":14479,"_27672":53621,"_2966":54134},[],"none (configuration only)",{"_3483":1462,"_30444":1268,"_21068":54136,"_5":14479,"_27672":53621,"_2966":54137},[],"`None` ↔ `Auto`",{"_3483":1463,"_30444":1268,"_21068":54139,"_5":14479,"_27672":53621,"_2966":54134},[],{"_3483":1464,"_30444":1268,"_21068":54141,"_5":14479,"_27672":53621,"_2966":54142},[],"Any → `Jitp`",{"_3483":1465,"_30444":1268,"_21068":54144,"_5":14479,"_27672":53621,"_2966":54145},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3483":1466,"_30444":1268,"_21068":54147,"_5":14479,"_27672":53621,"_2966":54148},[],"`Jitp` → `None` / `Auto`",{"_3483":1467,"_30444":1268,"_21068":54150,"_5":14479,"_27672":53621,"_2966":54151},[],"none (the template stays in the AWS account)",{"_3483":1468,"_30444":1268,"_21068":54153,"_5":14479,"_27672":53625,"_2966":54154},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3483":1469,"_30444":1268,"_21068":54156,"_5":14479,"_27672":53625,"_2966":54157},[],"The full flow from the device's perspective is:",{"_3483":1470,"_30444":1268,"_21068":54159,"_5":14479,"_27672":53625,"_2966":54160},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3483":1471,"_30444":1268,"_21068":54162,"_5":14479,"_27672":53629,"_2966":54163},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3483":1472,"_30444":1268,"_21068":54165,"_5":14479,"_27672":53629,"_2966":54022},[],{"_3483":1473,"_30444":1268,"_21068":54167,"_5":14479,"_27672":53629,"_2966":54025},[],{"_3483":1474,"_30444":1268,"_21068":54169,"_5":14479,"_27672":53629,"_2966":54170},[],"`Absent` → `Provisioned`",{"_3483":1475,"_30444":1268,"_21068":54172,"_5":14479,"_27672":53629,"_2966":54173},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3483":1476,"_30444":1268,"_21068":54175,"_5":14479,"_27672":53629,"_2966":54176},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3483":1477,"_30444":1268,"_21068":54178,"_5":14479,"_27672":53629,"_2966":54179},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3483":1478,"_30444":1268,"_21068":54181,"_5":14479,"_27672":53629,"_2966":54182},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3483":1479,"_30444":1268,"_21068":54184,"_5":14479,"_27672":53633,"_2966":54185},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3483":1480,"_30444":1268,"_21068":54187,"_5":14479,"_27672":53633,"_2966":54188},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3483":1481,"_30444":1268,"_21068":54190,"_5":14479,"_27672":53633,"_2966":54191},[],"For the JITP flow to work correctly:",{"_3483":1482,"_30444":1268,"_21068":54193,"_5":14479,"_27672":53633,"_2966":54194},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3483":1483,"_30444":1268,"_21068":54196,"_5":14479,"_27672":53633,"_2966":54197},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3483":1484,"_30444":1268,"_21068":54199,"_5":14479,"_27672":53633,"_2966":54200},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3483":1485,"_30444":1268,"_21068":54202,"_5":14479,"_27672":53633,"_2966":54203},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3483":1486,"_30444":1268,"_21068":54205,"_5":14479,"_27672":53637,"_2966":54206},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3483":1487,"_30444":1268,"_21068":54208,"_5":14479,"_27672":53637,"_2966":54209},[],"Status in Lamassu",{"_3483":1488,"_30444":1268,"_21068":54211,"_5":14479,"_27672":53637,"_2966":54212},[],"Revocation reason",{"_3483":1489,"_30444":1268,"_21068":54214,"_5":14479,"_27672":53637,"_2966":54215},[],"Status in AWS IoT Core",{"_3483":1490,"_30444":1268,"_21068":54217,"_5":14479,"_27672":53637,"_2966":54218},[],"`Active`",{"_3483":1491,"_30444":1268,"_21068":54220,"_5":14479,"_27672":53637,"_2966":54221},[],"None",{"_3483":1492,"_30444":1268,"_21068":54223,"_5":14479,"_27672":53637,"_2966":54224},[],"`ACTIVE`",{"_3483":1493,"_30444":1268,"_21068":54226,"_5":14479,"_27672":53637,"_2966":54227},[],"`Revoked`",{"_3483":1494,"_30444":1268,"_21068":54229,"_5":14479,"_27672":53637,"_2966":54230},[],"`certificateHold`",{"_3483":1495,"_30444":1268,"_21068":54232,"_5":14479,"_27672":53637,"_2966":54233},[],"`INACTIVE`",{"_3483":1496,"_30444":1268,"_21068":54235,"_5":14479,"_27672":53637,"_2966":54227},[],{"_3483":1497,"_30444":1268,"_21068":54237,"_5":14479,"_27672":53637,"_2966":54238},[],"Any other reason",{"_3483":1498,"_30444":1268,"_21068":54240,"_5":14479,"_27672":53637,"_2966":54241},[],"`REVOKED`",{"_3483":1499,"_30444":1268,"_21068":54243,"_5":14479,"_27672":53637,"_2966":54244},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3483":1500,"_30444":1268,"_21068":54246,"_5":14479,"_27672":53641,"_2966":54247},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3483":1501,"_30444":1268,"_21068":54249,"_5":14479,"_27672":53641,"_2966":54022},[],{"_3483":1502,"_30444":1268,"_21068":54251,"_5":14479,"_27672":53641,"_2966":54025},[],{"_3483":1503,"_30444":1268,"_21068":54253,"_5":14479,"_27672":53641,"_2966":54254},[],"`NotSynced` → `Active`",{"_3483":1504,"_30444":1268,"_21068":54256,"_5":14479,"_27672":53641,"_2966":53733},[],{"_3483":1505,"_30444":1268,"_21068":54258,"_5":14479,"_27672":53641,"_2966":54259},[],"`Active` → `Inactive`",{"_3483":1506,"_30444":1268,"_21068":54261,"_5":14479,"_27672":53641,"_2966":54262},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3483":1507,"_30444":1268,"_21068":54264,"_5":14479,"_27672":53641,"_2966":54265},[],"`Active` → `Revoked`",{"_3483":1508,"_30444":1268,"_21068":54267,"_5":14479,"_27672":53641,"_2966":54262},[],{"_3483":1509,"_30444":1268,"_21068":54269,"_5":14479,"_27672":53641,"_2966":54270},[],"`Inactive` / `Revoked` → `Active`",{"_3483":1510,"_30444":1268,"_21068":54272,"_5":14479,"_27672":53641,"_2966":53733},[],{"_3483":1511,"_30444":1268,"_21068":54274,"_5":14479,"_27672":53641,"_2966":54275},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3483":1512,"_30444":1268,"_21068":54277,"_5":14479,"_27672":53641,"_2966":54278},[],"none (these states are not synced to AWS)",{"_3483":1513,"_30444":1268,"_21068":54280,"_5":14479,"_27672":53645,"_2966":54281},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3483":1514,"_30444":1268,"_21068":54283,"_5":14479,"_27672":53645,"_2966":54284},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3483":1515,"_30444":1268,"_21068":54286,"_5":14479,"_27672":53645,"_2966":54287},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3483":1516,"_30444":1268,"_21068":54289,"_5":14479,"_27672":53649,"_2966":54290},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3483":1517,"_30444":1268,"_21068":54292,"_5":14479,"_27672":53649,"_2966":54293},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3483":1518,"_30444":1268,"_21068":54295,"_5":14479,"_27672":53653,"_2966":54296},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3483":1519,"_30444":1268,"_21068":54298,"_5":14479,"_27672":53653,"_2966":54299},[],"There are two action types:",{"_3483":1520,"_30444":1268,"_21068":54301,"_5":14479,"_27672":53653,"_2966":54302},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3483":1521,"_30444":1268,"_21068":54304,"_5":14479,"_27672":53653,"_2966":54305},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3483":1522,"_30444":1268,"_21068":54307,"_5":14479,"_27672":53653,"_2966":54308},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3483":1523,"_30444":1268,"_21068":54310,"_5":14479,"_27672":53657,"_2966":54311},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3483":1524,"_30444":1268,"_21068":54313,"_5":14479,"_27672":53657,"_2966":54314},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3483":1525,"_30444":1268,"_21068":54316,"_5":14479,"_27672":53657,"_2966":54317},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3483":1526,"_30444":1268,"_21068":54319,"_5":14479,"_27672":53661,"_2966":54320},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3483":1527,"_30444":1268,"_21068":54322,"_5":14479,"_27672":53661,"_2966":54323},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3483":1528,"_30444":1268,"_21068":54325,"_5":14479,"_27672":53661,"_2966":54326},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3483":1529,"_30444":1268,"_21068":54328,"_5":14479,"_27672":53661,"_2966":54329},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3483":1530,"_30444":1268,"_21068":54331,"_5":14479,"_27672":53661,"_2966":54332},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3483":1531,"_30444":1268,"_21068":54334,"_5":14479,"_27672":53661,"_2966":54335},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3483":1532,"_30444":1268,"_21068":54337,"_5":14479,"_27672":53661,"_2966":54338},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3483":1533,"_30444":1268,"_21068":54340,"_5":14479,"_27672":53661,"_2966":54341},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3483":1534,"_30444":1268,"_21068":54343,"_5":14479,"_27672":53661,"_2966":54344},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3483":1535,"_30444":1268,"_21068":54346,"_5":14479,"_27672":53661,"_2966":54347},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3483":1536,"_30444":1268,"_21068":54349,"_5":14479,"_27672":53661,"_2966":54350},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3483":1537,"_30444":1268,"_21068":54352,"_5":14479,"_27672":53661,"_2966":54353},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3483":1538,"_30444":1268,"_21068":54355,"_5":14479,"_27672":53661,"_2966":54356},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3483":1539,"_30444":1268,"_21068":54358,"_5":14479,"_27672":53661,"_2966":54359},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3483":1540,"_30444":1268,"_21068":54361,"_5":14479,"_27672":53661,"_2966":54362},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3483":1541,"_30444":1268,"_21068":54364,"_5":14479,"_27672":53661,"_2966":54365},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3483":1542,"_30444":1268,"_21068":54367,"_5":14479,"_27672":53661,"_2966":54368},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3483":1543,"_30444":1268,"_21068":54370,"_5":14479,"_27672":53661,"_2966":54371},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3483":1544,"_30444":1268,"_21068":54373,"_5":14479,"_27672":53661,"_2966":54374},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3483":1545,"_30444":1268,"_21068":54376,"_5":14479,"_27672":53661,"_2966":54377},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3483":1546,"_30444":1268,"_21068":54379,"_5":14479,"_27672":53661,"_2966":54380},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3483":1547,"_30444":1268,"_21068":54382,"_5":14479,"_27672":53661,"_2966":54383},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3483":1548,"_30444":1268,"_21068":54385,"_5":14479,"_27672":53661,"_2966":54386},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3483":1549,"_30444":1268,"_21068":54388,"_5":14479,"_27672":53661,"_2966":54389},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3483":1550,"_30444":1550,"_5":14831,"_2966":52096,"_30797":54391,"_21068":54392,"_27672":1550},[49604,51079,52096],[],{"_3483":1551,"_30444":1550,"_21068":54394,"_5":14479,"_27672":1550,"_2966":54395},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3483":1552,"_30444":1550,"_5":30794,"_21068":54397,"_27672":54398,"_2966":54399},[],"/docs/pr-preview/pr-65/platform/iot-fleets/overview#start-here","Start here",{"_3483":1553,"_30444":1550,"_5":30794,"_21068":54401,"_27672":54402,"_2966":52094},[],"/docs/pr-preview/pr-65/platform/iot-fleets/overview#devices-and-identities",{"_3483":1554,"_30444":1550,"_5":30794,"_21068":54404,"_27672":54405,"_2966":52277},[],"/docs/pr-preview/pr-65/platform/iot-fleets/overview#enrollment-with-pki",{"_3483":1555,"_30444":1550,"_5":30794,"_21068":54407,"_27672":54408,"_2966":53558},[],"/docs/pr-preview/pr-65/platform/iot-fleets/overview#integrations",{"_3483":1556,"_30444":1550,"_5":30794,"_21068":54410,"_27672":54411,"_2966":54412},[],"/docs/pr-preview/pr-65/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3483":1557,"_30444":1550,"_21068":54414,"_5":14479,"_27672":1550,"_2966":54415},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3483":1558,"_30444":1550,"_21068":54417,"_5":14479,"_27672":54398,"_2966":54418},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3483":1559,"_30444":1550,"_21068":54420,"_5":14479,"_27672":54398,"_2966":54421},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3483":1560,"_30444":1550,"_21068":54423,"_5":14479,"_27672":54402,"_2966":54424},[],"Resource",{"_3483":1561,"_30444":1550,"_21068":54426,"_5":14479,"_27672":54402,"_2966":54427},[],"What it represents",{"_3483":1562,"_30444":1550,"_21068":54429,"_5":14479,"_27672":54402,"_2966":54430},[],"**Device**",{"_3483":1563,"_30444":1550,"_21068":54432,"_5":14479,"_27672":54402,"_2966":54433},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3483":1564,"_30444":1550,"_21068":54435,"_5":14479,"_27672":54402,"_2966":54436},[],"**Identity**",{"_3483":1565,"_30444":1550,"_21068":54438,"_5":14479,"_27672":54402,"_2966":54439},[],"The device's association with its certificates: an active version and a history.",{"_3483":1566,"_30444":1550,"_21068":54441,"_5":14479,"_27672":54402,"_2966":54442},[],"**DMS**",{"_3483":1567,"_30444":1550,"_21068":54444,"_5":14479,"_27672":54402,"_2966":54445},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3483":1568,"_30444":1550,"_21068":54447,"_5":14479,"_27672":54402,"_2966":54448},[],"**Fleet**",{"_3483":1569,"_30444":1550,"_21068":54450,"_5":14479,"_27672":54402,"_2966":54451},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3483":1570,"_30444":1550,"_21068":54453,"_5":14479,"_27672":54402,"_2966":54454},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3483":1571,"_30444":1550,"_21068":54456,"_5":14479,"_27672":54402,"_2966":54457},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3483":1572,"_30444":1550,"_21068":54459,"_5":14479,"_27672":54405,"_2966":54460},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3483":1573,"_30444":1550,"_21068":54462,"_5":14479,"_27672":54405,"_2966":54463},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3483":1574,"_30444":1550,"_21068":54465,"_5":14479,"_27672":54405,"_2966":54466},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3483":1575,"_30444":1550,"_21068":54468,"_5":14479,"_27672":54405,"_2966":54469},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3483":1576,"_30444":1550,"_21068":54471,"_5":14479,"_27672":54405,"_2966":54472},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3483":1577,"_30444":1550,"_21068":54474,"_5":14479,"_27672":54405,"_2966":54475},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3483":1578,"_30444":1550,"_21068":54477,"_5":14479,"_27672":54405,"_2966":54478},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3483":1579,"_30444":1550,"_21068":54480,"_5":14479,"_27672":54405,"_2966":54481},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3483":1580,"_30444":1550,"_21068":54483,"_5":14479,"_27672":54408,"_2966":54484},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3483":1581,"_30444":1550,"_21068":54486,"_5":14479,"_27672":54408,"_2966":54487},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3483":1582,"_30444":1550,"_21068":54489,"_5":14479,"_27672":54411,"_2966":54490},[],"Participant",{"_3483":1583,"_30444":1550,"_21068":54492,"_5":14479,"_27672":54411,"_2966":54493},[],"Responsibility",{"_3483":1584,"_30444":1550,"_21068":54495,"_5":14479,"_27672":54411,"_2966":54496},[],"PKI administrator",{"_3483":1585,"_30444":1550,"_21068":54498,"_5":14479,"_27672":54411,"_2966":54499},[],"CA, issuance profile, chain and revocation publication.",{"_3483":1586,"_30444":1550,"_21068":54501,"_5":14479,"_27672":54411,"_2966":54502},[],"Provisioning administrator",{"_3483":1587,"_30444":1550,"_21068":54504,"_5":14479,"_27672":54411,"_2966":54505},[],"DMS, admission, authentication per operation and inventory.",{"_3483":1588,"_30444":1550,"_21068":54507,"_5":14479,"_27672":54411,"_2966":54508},[],"Device integrator",{"_3483":1589,"_30444":1550,"_21068":54510,"_5":14479,"_27672":54411,"_2966":54511},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3483":1590,"_30444":1550,"_21068":54513,"_5":14479,"_27672":54411,"_2966":54514},[],"Consumer integrator",{"_3483":1591,"_30444":1550,"_21068":54516,"_5":14479,"_27672":54411,"_2966":54517},[],"Trusted issuers, validation and device permissions in the destination.",{"_3483":1592,"_30444":1550,"_21068":54519,"_5":14479,"_27672":54411,"_2966":54520},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3483":1593,"_30444":1593,"_5":14831,"_2966":54522,"_30797":54523,"_21068":54525,"_27672":1593},"Enroll and connect your first device",[49604,51079,52096,54524],"Getting started",[],{"_3483":1594,"_30444":1593,"_21068":54527,"_5":14479,"_27672":1593,"_2966":54528},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3483":1595,"_30444":1593,"_5":30794,"_21068":54530,"_27672":54531,"_2966":49614},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3483":1596,"_30444":1593,"_5":30794,"_21068":54533,"_27672":54534,"_2966":54535},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3483":1597,"_30444":1593,"_5":30794,"_21068":54537,"_27672":54538,"_2966":54539},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3483":1598,"_30444":1593,"_5":30794,"_21068":54541,"_27672":54542,"_2966":54543},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3483":1599,"_30444":1593,"_5":30794,"_21068":54545,"_27672":54546,"_2966":54547},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3483":1600,"_30444":1593,"_5":30794,"_21068":54549,"_27672":54550,"_2966":54551},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3483":1601,"_30444":1593,"_5":30794,"_21068":54553,"_27672":54554,"_2966":54555},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3483":1602,"_30444":1593,"_5":30794,"_21068":54557,"_27672":54558,"_2966":54559},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3483":1603,"_30444":1593,"_21068":54561,"_5":14479,"_27672":1593,"_2966":54562},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3483":1604,"_30444":1593,"_21068":54564,"_5":14479,"_27672":54531,"_2966":54565},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3483":1605,"_30444":1593,"_21068":54567,"_5":14479,"_27672":54531,"_2966":54568},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3483":1606,"_30444":1593,"_21068":54570,"_5":14479,"_27672":54531,"_2966":54571},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3483":1607,"_30444":1593,"_21068":54573,"_5":14479,"_27672":54531,"_2966":54574},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3483":1608,"_30444":1593,"_21068":54576,"_5":14479,"_27672":54531,"_2966":54577},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3483":1609,"_30444":1593,"_21068":54579,"_5":14479,"_27672":54534,"_2966":54580},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3483":1610,"_30444":1593,"_21068":54582,"_5":14479,"_27672":54534,"_2966":54583},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3483":1611,"_30444":1593,"_21068":54585,"_5":14479,"_27672":54538,"_2966":54586},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3483":1612,"_30444":1593,"_21068":54588,"_5":14479,"_27672":54538,"_2966":54589},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3483":1613,"_30444":1593,"_21068":54591,"_5":14479,"_27672":54538,"_2966":54592},[],"Setting",{"_3483":1614,"_30444":1593,"_21068":54594,"_5":14479,"_27672":54538,"_2966":54595},[],"Evaluation value",{"_3483":1615,"_30444":1593,"_21068":54597,"_5":14479,"_27672":54538,"_2966":54598},[],"Enrollment CA",{"_3483":1616,"_30444":1593,"_21068":54600,"_5":14479,"_27672":54538,"_2966":54601},[],"Issuing root from `device-root.pem`.",{"_3483":1617,"_30444":1593,"_21068":54603,"_5":14479,"_27672":54538,"_2966":52407},[],{"_3483":1618,"_30444":1593,"_21068":54605,"_5":14479,"_27672":54538,"_2966":54606},[],"The 1-hour leaf profile you just prepared.",{"_3483":1619,"_30444":1593,"_21068":54608,"_5":14479,"_27672":54538,"_2966":54609},[],"Protocol / Registration Mode",{"_3483":1620,"_30444":1593,"_21068":54611,"_5":14479,"_27672":54538,"_2966":54612},[],"`EST_RFC7030` / `JITP`.",{"_3483":1621,"_30444":1593,"_21068":54614,"_5":14479,"_27672":54538,"_2966":54615},[],"Verify CSR Signature",{"_3483":1622,"_30444":1593,"_21068":54617,"_5":14479,"_27672":54538,"_2966":54618},[],"Enabled.",{"_3483":1623,"_30444":1593,"_21068":54620,"_5":14479,"_27672":54538,"_2966":54621},[],"Enable Replaceable Enrollment",{"_3483":1624,"_30444":1593,"_21068":54623,"_5":14479,"_27672":54538,"_2966":54624},[],"Disabled; the ID must be new.",{"_3483":1625,"_30444":1593,"_21068":54626,"_5":14479,"_27672":54538,"_2966":54627},[],"Initial authentication",{"_3483":1626,"_30444":1593,"_21068":54629,"_5":14479,"_27672":54538,"_2966":54630},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3483":1627,"_30444":1593,"_21068":54632,"_5":14479,"_27672":54538,"_2966":54633},[],"Renewal authentication",{"_3483":1628,"_30444":1593,"_21068":54635,"_5":14479,"_27672":54538,"_2966":54636},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3483":1629,"_30444":1593,"_21068":54638,"_5":14479,"_27672":54538,"_2966":54639},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3483":1630,"_30444":1593,"_21068":54641,"_5":14479,"_27672":54538,"_2966":54642},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3483":1631,"_30444":1593,"_21068":54644,"_5":14479,"_27672":54538,"_2966":54645},[],"Re-enrollment Delta",{"_3483":1632,"_30444":1593,"_21068":54647,"_5":14479,"_27672":54538,"_2966":54648},[],"1 hour.",{"_3483":1633,"_30444":1593,"_21068":54650,"_5":14479,"_27672":54538,"_2966":54651},[],"Preventive / Critical Delta",{"_3483":1634,"_30444":1593,"_21068":54653,"_5":14479,"_27672":54538,"_2966":54654},[],"30 minutes / 10 minutes.",{"_3483":1635,"_30444":1593,"_21068":54656,"_5":14479,"_27672":54538,"_2966":54657},[],"Revoke on Re-enrollment",{"_3483":1636,"_30444":1593,"_21068":54659,"_5":14479,"_27672":54538,"_2966":54660},[],"Disabled to test the successor before retiring the previous identity.",{"_3483":1637,"_30444":1593,"_21068":54662,"_5":14479,"_27672":54538,"_2966":52415},[],{"_3483":1638,"_30444":1593,"_21068":54664,"_5":14479,"_27672":54538,"_2966":54665},[],"Disabled; the operational key is generated in the client.",{"_3483":1639,"_30444":1593,"_21068":54667,"_5":14479,"_27672":54538,"_2966":54668},[],"CA Distribution",{"_3483":1640,"_30444":1593,"_21068":54670,"_5":14479,"_27672":54538,"_2966":54671},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3483":1641,"_30444":1593,"_21068":54673,"_5":14479,"_27672":54538,"_2966":54674},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3483":1642,"_30444":1593,"_21068":54676,"_5":14479,"_27672":54542,"_2966":54677},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3483":1643,"_30444":1593,"_21068":54679,"_5":14479,"_27672":54542,"_2966":54680},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3483":1644,"_30444":1593,"_21068":54682,"_5":14479,"_27672":54546,"_2966":54683},[],"Generate a new key and CSR with the selected identifier:",{"_3483":1645,"_30444":1593,"_21068":54685,"_5":14479,"_27672":54546,"_2966":54686},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3483":1646,"_30444":1593,"_21068":54688,"_5":14479,"_27672":54546,"_2966":54689},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3483":1647,"_30444":1593,"_21068":54691,"_5":14479,"_27672":54550,"_2966":54692},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3483":1648,"_30444":1593,"_21068":54694,"_5":14479,"_27672":54550,"_2966":54695},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3483":1649,"_30444":1593,"_21068":54697,"_5":14479,"_27672":54554,"_2966":54698},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3483":1650,"_30444":1593,"_21068":54700,"_5":14479,"_27672":54554,"_2966":54701},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3483":1651,"_30444":1593,"_21068":54703,"_5":14479,"_27672":54554,"_2966":54704},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3483":1652,"_30444":1593,"_21068":54706,"_5":14479,"_27672":54554,"_2966":54707},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3483":1653,"_30444":1593,"_21068":54709,"_5":14479,"_27672":54554,"_2966":54710},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3483":1654,"_30444":1593,"_21068":54712,"_5":14479,"_27672":54558,"_2966":54713},[],"Check",{"_3483":1655,"_30444":1593,"_21068":54715,"_5":14479,"_27672":54558,"_2966":54716},[],"Expected result",{"_3483":1656,"_30444":1593,"_21068":54718,"_5":14479,"_27672":54558,"_2966":54719},[],"Registration",{"_3483":1657,"_30444":1593,"_21068":54721,"_5":14479,"_27672":54558,"_2966":54722},[],"ID created automatically and correct DMS.",{"_3483":1658,"_30444":1593,"_21068":54724,"_5":14479,"_27672":54558,"_2966":53980},[],{"_3483":1659,"_30444":1593,"_21068":54726,"_5":14479,"_27672":54558,"_2966":54727},[],"CN, profile, serial and key verified.",{"_3483":1660,"_30444":1593,"_21068":54729,"_5":14479,"_27672":54558,"_2966":54730},[],"Inventory",{"_3483":1661,"_30444":1593,"_21068":54732,"_5":14479,"_27672":54558,"_2966":54733},[],"Received serial visible as the current identity and in history.",{"_3483":1662,"_30444":1593,"_21068":54735,"_5":14479,"_27672":54558,"_2966":54736},[],"Consumer",{"_3483":1663,"_30444":1593,"_21068":54738,"_5":14479,"_27672":54558,"_2966":54739},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3483":1664,"_30444":1593,"_21068":54741,"_5":14479,"_27672":54558,"_2966":54742},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3483":1665,"_30444":1593,"_21068":54744,"_5":14479,"_27672":54558,"_2966":54745},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3483":1666,"_30444":1666,"_5":14831,"_2966":52112,"_30797":54747,"_21068":54748,"_27672":1666},[49604,51079,52096,54524],[],{"_3483":1667,"_30444":1666,"_21068":54750,"_5":14479,"_27672":1666,"_2966":54751},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3483":1668,"_30444":1666,"_5":30794,"_21068":54753,"_27672":54754,"_2966":49614},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3483":1669,"_30444":1666,"_5":30794,"_21068":54756,"_27672":54757,"_2966":54758},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3483":1670,"_30444":1666,"_5":30794,"_21068":54760,"_27672":54761,"_2966":54762},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3483":1671,"_30444":1666,"_5":30794,"_21068":54764,"_27672":54765,"_2966":54766},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3483":1672,"_30444":1666,"_5":30794,"_21068":54768,"_27672":54769,"_2966":54770},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3483":1673,"_30444":1666,"_5":30794,"_21068":54772,"_27672":54773,"_2966":54774},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3483":1674,"_30444":1666,"_5":30794,"_21068":54776,"_27672":54777,"_2966":54716},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3483":1675,"_30444":1666,"_5":30794,"_21068":54779,"_27672":54780,"_2966":54781},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3483":1676,"_30444":1666,"_5":30794,"_21068":54783,"_27672":54784,"_2966":54785},[],"/docs/pr-preview/pr-65/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3483":1677,"_30444":1666,"_21068":54787,"_5":14479,"_27672":1666,"_2966":54788},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3483":1678,"_30444":1666,"_21068":54790,"_5":14479,"_27672":1666,"_2966":54791},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3483":1679,"_30444":1666,"_21068":54793,"_5":14479,"_27672":54754,"_2966":54794},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3483":1680,"_30444":1666,"_21068":54796,"_5":14479,"_27672":54754,"_2966":54797},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3483":1681,"_30444":1666,"_21068":54799,"_5":14479,"_27672":54754,"_2966":54800},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3483":1682,"_30444":1666,"_21068":54802,"_5":14479,"_27672":54754,"_2966":54803},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3483":1683,"_30444":1666,"_21068":54805,"_5":14479,"_27672":54757,"_2966":54806},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3483":1684,"_30444":1666,"_21068":54808,"_5":14479,"_27672":54757,"_2966":54809},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3483":1685,"_30444":1666,"_21068":54811,"_5":14479,"_27672":54757,"_2966":54812},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3483":1686,"_30444":1666,"_21068":54814,"_5":14479,"_27672":54757,"_2966":54815},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3483":1687,"_30444":1666,"_21068":54817,"_5":14479,"_27672":54757,"_2966":54818},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3483":1688,"_30444":1666,"_21068":54820,"_5":14479,"_27672":54757,"_2966":54821},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3483":1689,"_30444":1666,"_21068":54823,"_5":14479,"_27672":54757,"_2966":54824},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3483":1690,"_30444":1666,"_21068":54826,"_5":14479,"_27672":54757,"_2966":54827},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3483":1691,"_30444":1666,"_21068":54829,"_5":14479,"_27672":54761,"_2966":54830},[],"Open **Managed Devices** and the registration action. Complete:",{"_3483":1692,"_30444":1666,"_21068":54832,"_5":14479,"_27672":54761,"_2966":54833},[],"**Device ID**: `device-001`.",{"_3483":1693,"_30444":1666,"_21068":54835,"_5":14479,"_27672":54761,"_2966":54836},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3483":1694,"_30444":1666,"_21068":54838,"_5":14479,"_27672":54761,"_2966":54839},[],"**Icon** and **Tags**: optional classification.",{"_3483":1695,"_30444":1666,"_21068":54841,"_5":14479,"_27672":54761,"_2966":54842},[],"Confirm registration.",{"_3483":1696,"_30444":1666,"_21068":54844,"_5":14479,"_27672":54765,"_2966":54845},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3483":1697,"_30444":1666,"_21068":54847,"_5":14479,"_27672":54765,"_2966":54848},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3483":1698,"_30444":1666,"_21068":54850,"_5":14479,"_27672":54769,"_2966":54851},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3483":1699,"_30444":1666,"_21068":54853,"_5":14479,"_27672":54769,"_2966":54854},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3483":1700,"_30444":1666,"_21068":54856,"_5":14479,"_27672":54773,"_2966":54857},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3483":1701,"_30444":1666,"_21068":54859,"_5":14479,"_27672":54773,"_2966":54860},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3483":1702,"_30444":1666,"_21068":54862,"_5":14479,"_27672":54777,"_2966":54713},[],{"_3483":1703,"_30444":1666,"_21068":54864,"_5":14479,"_27672":54777,"_2966":54865},[],"Result",{"_3483":1704,"_30444":1666,"_21068":54867,"_5":14479,"_27672":54777,"_2966":53963},[],{"_3483":1705,"_30444":1666,"_21068":54869,"_5":14479,"_27672":54777,"_2966":54870},[],"`device-001` appears in inventory with the expected DMS.",{"_3483":1706,"_30444":1666,"_21068":54872,"_5":14479,"_27672":54777,"_2966":54873},[],"Current identity",{"_3483":1707,"_30444":1666,"_21068":54875,"_5":14479,"_27672":54777,"_2966":54876},[],"The associated certificate matches the one you verified in PKI.",{"_3483":1708,"_30444":1666,"_21068":54878,"_5":14479,"_27672":54777,"_2966":54879},[],"History",{"_3483":1709,"_30444":1666,"_21068":54881,"_5":14479,"_27672":54777,"_2966":54882},[],"The associated issuance appears with its serial number and dates.",{"_3483":1710,"_30444":1666,"_21068":54884,"_5":14479,"_27672":54777,"_2966":54885},[],"Key and certificate",{"_3483":1711,"_30444":1666,"_21068":54887,"_5":14479,"_27672":54777,"_2966":54888},[],"You have the verified pair ready to install on the device.",{"_3483":1712,"_30444":1666,"_21068":54890,"_5":14479,"_27672":54780,"_2966":54891},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3483":1713,"_30444":1666,"_21068":54893,"_5":14479,"_27672":54780,"_2966":54894},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3483":1714,"_30444":1666,"_21068":54896,"_5":14479,"_27672":54780,"_2966":54897},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3483":1715,"_30444":1666,"_21068":54899,"_5":14479,"_27672":54780,"_2966":54900},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3483":1716,"_30444":1666,"_21068":54902,"_5":14479,"_27672":54784,"_2966":54903},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3483":1717,"_30444":1666,"_21068":54905,"_5":14479,"_27672":54784,"_2966":54906},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3483":1718,"_30444":1666,"_21068":54908,"_5":14479,"_27672":54784,"_2966":54909},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3483":1719,"_30444":1719,"_5":14831,"_2966":54911,"_30797":54912,"_21068":54913,"_27672":1719},"Lamassu IoT Platform",[49604,51079],[],{"_3483":1720,"_30444":1719,"_21068":54915,"_5":14479,"_27672":1719,"_2966":54916},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3483":1721,"_30444":1719,"_5":30794,"_21068":54918,"_27672":54919,"_2966":54399},[],"/docs/pr-preview/pr-65/platform/overview#start-here",{"_3483":1722,"_30444":1719,"_5":30794,"_21068":54921,"_27672":54922,"_2966":54923},[],"/docs/pr-preview/pr-65/platform/overview#choose-your-path","Choose your path",{"_3483":1723,"_30444":1719,"_5":30794,"_21068":54925,"_27672":54926,"_2966":54927},[],"/docs/pr-preview/pr-65/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3483":1724,"_30444":1719,"_5":30794,"_21068":54929,"_27672":54930,"_2966":54931},[],"/docs/pr-preview/pr-65/platform/overview#core-capabilities","Core capabilities",{"_3483":1725,"_30444":1719,"_5":30794,"_21068":54933,"_27672":54934,"_2966":54935},[],"/docs/pr-preview/pr-65/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3483":1726,"_30444":1719,"_5":30794,"_21068":54937,"_27672":54938,"_2966":54939},[],"/docs/pr-preview/pr-65/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3483":1727,"_30444":1719,"_5":30794,"_21068":54941,"_27672":54942,"_2966":54943},[],"/docs/pr-preview/pr-65/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3483":1728,"_30444":1719,"_5":30794,"_21068":54945,"_27672":54946,"_2966":54947},[],"/docs/pr-preview/pr-65/platform/overview#automate-device-identities","Automate device identities",{"_3483":1729,"_30444":1719,"_5":30794,"_21068":54949,"_27672":54950,"_2966":54951},[],"/docs/pr-preview/pr-65/platform/overview#publish-validation-status","Publish validation status",{"_3483":1730,"_30444":1719,"_5":30794,"_21068":54953,"_27672":54954,"_2966":54955},[],"/docs/pr-preview/pr-65/platform/overview#react-to-events","React to events",{"_3483":1731,"_30444":1719,"_5":30794,"_21068":54957,"_27672":54958,"_2966":54959},[],"/docs/pr-preview/pr-65/platform/overview#operational-reference","Operational reference",{"_3483":1732,"_30444":1719,"_21068":54961,"_5":14479,"_27672":1719,"_2966":54962},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3483":1733,"_30444":1719,"_21068":54964,"_5":14479,"_27672":54919,"_2966":54965},[],"Choose the result you need:",{"_3483":1734,"_30444":1719,"_21068":54967,"_5":14479,"_27672":54919,"_2966":54968},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3483":1735,"_30444":1719,"_21068":54970,"_5":14479,"_27672":54919,"_2966":54971},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3483":1736,"_30444":1719,"_21068":54973,"_5":14479,"_27672":54919,"_2966":54974},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3483":1737,"_30444":1719,"_21068":54976,"_5":14479,"_27672":54922,"_2966":54977},[],"Section",{"_3483":1738,"_30444":1719,"_21068":54979,"_5":14479,"_27672":54922,"_2966":54980},[],"What you manage",{"_3483":1739,"_30444":1719,"_21068":54982,"_5":14479,"_27672":54922,"_2966":54983},[],"Entry point",{"_3483":1740,"_30444":1719,"_21068":54985,"_5":14479,"_27672":54922,"_2966":54986},[],"**PKI**",{"_3483":1741,"_30444":1719,"_21068":54988,"_5":14479,"_27672":54922,"_2966":54989},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3483":1742,"_30444":1719,"_21068":54991,"_5":14479,"_27672":54922,"_2966":54992},[],"PKI overview",{"_3483":1743,"_30444":1719,"_21068":54994,"_5":14479,"_27672":54922,"_2966":54995},[],"**IoT Fleets**",{"_3483":1744,"_30444":1719,"_21068":54997,"_5":14479,"_27672":54922,"_2966":54998},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3483":1745,"_30444":1719,"_21068":55000,"_5":14479,"_27672":54922,"_2966":55001},[],"IoT Fleets overview",{"_3483":1746,"_30444":1719,"_21068":55003,"_5":14479,"_27672":54922,"_2966":55004},[],"**Administration**",{"_3483":1747,"_30444":1719,"_21068":55006,"_5":14479,"_27672":54922,"_2966":55007},[],"Operator permissions, audit and event subscriptions.",{"_3483":1748,"_30444":1719,"_21068":55009,"_5":14479,"_27672":54922,"_2966":51077},[],{"_3483":1749,"_30444":1719,"_21068":55011,"_5":14479,"_27672":54922,"_2966":55012},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3483":1750,"_30444":1719,"_21068":55014,"_5":14479,"_27672":54926,"_2966":55015},[],"An identity's journey connects four responsibilities:",{"_3483":1751,"_30444":1719,"_21068":55017,"_5":14479,"_27672":54926,"_2966":55018},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3483":1752,"_30444":1719,"_21068":55020,"_5":14479,"_27672":54926,"_2966":55021},[],"The provisioning administrator configures the DMS and initial trust.",{"_3483":1753,"_30444":1719,"_21068":55023,"_5":14479,"_27672":54926,"_2966":55024},[],"The device client requests a certificate and installs it with the matching key.",{"_3483":1754,"_30444":1719,"_21068":55026,"_5":14479,"_27672":54926,"_2966":55027},[],"The consumer validates the identity and applies its access permissions.",{"_3483":1755,"_30444":1719,"_21068":55029,"_5":14479,"_27672":54926,"_2966":55030},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3483":1756,"_30444":1719,"_21068":55032,"_5":14479,"_27672":54934,"_2966":55033},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3483":1757,"_30444":1719,"_21068":55035,"_5":14479,"_27672":54938,"_2966":55036},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3483":1758,"_30444":1719,"_21068":55038,"_5":14479,"_27672":54942,"_2966":55039},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3483":1759,"_30444":1719,"_21068":55041,"_5":14479,"_27672":54946,"_2966":55042},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3483":1760,"_30444":1719,"_21068":55044,"_5":14479,"_27672":54950,"_2966":55045},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3483":1761,"_30444":1719,"_21068":55047,"_5":14479,"_27672":54954,"_2966":55048},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3483":1762,"_30444":1719,"_21068":55050,"_5":14479,"_27672":54958,"_2966":54493},[],{"_3483":1763,"_30444":1719,"_21068":55052,"_5":14479,"_27672":54958,"_2966":55053},[],"What it prepares or checks",{"_3483":1764,"_30444":1719,"_21068":55055,"_5":14479,"_27672":54958,"_2966":54496},[],{"_3483":1765,"_30444":1719,"_21068":55057,"_5":14479,"_27672":54958,"_2966":55058},[],"Key custody, CA hierarchy, profiles and validation.",{"_3483":1766,"_30444":1719,"_21068":55060,"_5":14479,"_27672":54958,"_2966":55061},[],"Fleet administrator",{"_3483":1767,"_30444":1719,"_21068":55063,"_5":14479,"_27672":54958,"_2966":55064},[],"DMS, device admission, renewal policy and inventory.",{"_3483":1768,"_30444":1719,"_21068":55066,"_5":14479,"_27672":54958,"_2966":54508},[],{"_3483":1769,"_30444":1719,"_21068":55068,"_5":14479,"_27672":54958,"_2966":55069},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3483":1770,"_30444":1719,"_21068":55071,"_5":14479,"_27672":54958,"_2966":54514},[],{"_3483":1771,"_30444":1719,"_21068":55073,"_5":14479,"_27672":54958,"_2966":55074},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3483":1772,"_30444":1719,"_21068":55076,"_5":14479,"_27672":54958,"_2966":55077},[],"Infrastructure operator",{"_3483":1773,"_30444":1719,"_21068":55079,"_5":14479,"_27672":54958,"_2966":55080},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3483":1774,"_30444":1719,"_21068":55082,"_5":14479,"_27672":54958,"_2966":55083},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3483":1775,"_30444":1775,"_5":14831,"_2966":55085,"_30797":55086,"_21068":55089,"_27672":1775},"CA hierarchy and rotation",[49604,51079,55087,55088],"PKI","Keys, authorities and certificates",[],{"_3483":1776,"_30444":1775,"_21068":55091,"_5":14479,"_27672":1775,"_2966":55092},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3483":1777,"_30444":1775,"_5":30794,"_21068":55094,"_27672":55095,"_2966":55096},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3483":1778,"_30444":1775,"_5":30794,"_21068":55098,"_27672":55099,"_2966":55100},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3483":1779,"_30444":1775,"_5":30794,"_21068":55102,"_27672":55103,"_2966":55104},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3483":1780,"_30444":1775,"_5":30794,"_21068":55106,"_27672":55107,"_2966":55108},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3483":1781,"_30444":1775,"_5":30794,"_21068":55110,"_27672":55111,"_2966":55112},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3483":1782,"_30444":1775,"_5":30794,"_21068":55114,"_27672":55115,"_2966":55116},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3483":1783,"_30444":1775,"_5":30794,"_21068":55118,"_27672":55119,"_2966":55120},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3483":1784,"_30444":1775,"_5":30794,"_21068":55122,"_27672":55123,"_2966":55124},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3483":1785,"_30444":1775,"_5":30794,"_21068":55126,"_27672":55127,"_2966":55128},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3483":1786,"_30444":1775,"_5":30794,"_21068":55130,"_27672":55131,"_2966":55132},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3483":1787,"_30444":1775,"_5":30794,"_21068":55134,"_27672":55135,"_2966":55136},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3483":1788,"_30444":1775,"_5":30794,"_21068":55138,"_27672":55139,"_2966":55140},[],"/docs/pr-preview/pr-65/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3483":1789,"_30444":1775,"_21068":55142,"_5":14479,"_27672":1775,"_2966":55143},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3483":1790,"_30444":1775,"_21068":55145,"_5":14479,"_27672":1775,"_2966":55146},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3483":1791,"_30444":1775,"_21068":55148,"_5":14479,"_27672":55095,"_2966":55149},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3483":1792,"_30444":1775,"_21068":55151,"_5":14479,"_27672":55095,"_2966":55152},[],"environment, such as production and preproduction;",{"_3483":1793,"_30444":1775,"_21068":55154,"_5":14479,"_27672":55095,"_2966":55155},[],"owner or operating team;",{"_3483":1794,"_30444":1775,"_21068":55157,"_5":14479,"_27672":55095,"_2966":55158},[],"device family or manufacturing process;",{"_3483":1795,"_30444":1775,"_21068":55160,"_5":14479,"_27672":55095,"_2966":55161},[],"region or regulatory requirement;",{"_3483":1796,"_30444":1775,"_21068":55163,"_5":14479,"_27672":55095,"_2966":55164},[],"cryptographic engine or key policy;",{"_3483":1797,"_30444":1775,"_21068":55166,"_5":14479,"_27672":55095,"_2966":55167},[],"maintenance window and renewal cadence.",{"_3483":1798,"_30444":1775,"_21068":55169,"_5":14479,"_27672":55095,"_2966":55170},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3483":1799,"_30444":1775,"_21068":55172,"_5":14479,"_27672":55095,"_2966":55173},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3483":1800,"_30444":1775,"_21068":55175,"_5":14479,"_27672":55099,"_2966":55176},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3483":1801,"_30444":1775,"_21068":55178,"_5":14479,"_27672":55099,"_2966":55179},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3483":1802,"_30444":1775,"_21068":55181,"_5":14479,"_27672":55099,"_2966":55182},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3483":1803,"_30444":1775,"_21068":55184,"_5":14479,"_27672":55099,"_2966":55185},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3483":1804,"_30444":1775,"_21068":55187,"_5":14479,"_27672":55103,"_2966":55188},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3483":1805,"_30444":1775,"_21068":55190,"_5":14479,"_27672":55103,"_2966":55191},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3483":1806,"_30444":1775,"_21068":55193,"_5":14479,"_27672":55103,"_2966":55194},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3483":1807,"_30444":1775,"_21068":55196,"_5":14479,"_27672":55103,"_2966":55197},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3483":1808,"_30444":1775,"_21068":55199,"_5":14479,"_27672":55111,"_2966":55200},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3483":1809,"_30444":1775,"_21068":55202,"_5":14479,"_27672":55115,"_2966":55203},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3483":1810,"_30444":1775,"_21068":55205,"_5":14479,"_27672":55119,"_2966":55206},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3483":1811,"_30444":1775,"_21068":55208,"_5":14479,"_27672":55123,"_2966":55209},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3483":1812,"_30444":1775,"_21068":55211,"_5":14479,"_27672":55127,"_2966":55212},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3483":1813,"_30444":1775,"_21068":55214,"_5":14479,"_27672":55131,"_2966":55215},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3483":1814,"_30444":1775,"_21068":55217,"_5":14479,"_27672":55135,"_2966":55218},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3483":1815,"_30444":1775,"_21068":55220,"_5":14479,"_27672":55135,"_2966":55221},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3483":1816,"_30444":1775,"_21068":55223,"_5":14479,"_27672":55135,"_2966":55224},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3483":1817,"_30444":1775,"_21068":55226,"_5":14479,"_27672":55135,"_2966":55227},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3483":1818,"_30444":1775,"_21068":55229,"_5":14479,"_27672":55139,"_2966":55230},[],"The new chain ends in an anchor installed by the consumer.",{"_3483":1819,"_30444":1775,"_21068":55232,"_5":14479,"_27672":55139,"_2966":55233},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3483":1820,"_30444":1775,"_21068":55235,"_5":14479,"_27672":55139,"_2966":55236},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3483":1821,"_30444":1775,"_21068":55238,"_5":14479,"_27672":55139,"_2966":55239},[],"Re-enrollment accepts the old identity during the planned period.",{"_3483":1822,"_30444":1775,"_21068":55241,"_5":14479,"_27672":55139,"_2966":55242},[],"OCSP and CRL respond for the authorities that remain active.",{"_3483":1823,"_30444":1775,"_21068":55244,"_5":14479,"_27672":55139,"_2966":55245},[],"No DMS is left accidentally issuing from the old CA.",{"_3483":1824,"_30444":1775,"_21068":55247,"_5":14479,"_27672":55139,"_2966":55248},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3483":1825,"_30444":1825,"_5":14831,"_2966":55250,"_30797":55251,"_21068":55252,"_27672":1825},"Certification authorities",[49604,51079,55087,55088],[],{"_3483":1826,"_30444":1825,"_21068":55254,"_5":14479,"_27672":1825,"_2966":55255},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3483":1827,"_30444":1825,"_5":30794,"_21068":55257,"_27672":55258,"_2966":55259},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3483":1828,"_30444":1825,"_5":30794,"_21068":55261,"_27672":55262,"_2966":55263},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3483":1829,"_30444":1825,"_5":30794,"_21068":55265,"_27672":55266,"_2966":49614},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#before-you-begin",{"_3483":1830,"_30444":1825,"_5":30794,"_21068":55268,"_27672":55269,"_2966":55270},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3483":1831,"_30444":1825,"_5":30794,"_21068":55272,"_27672":55273,"_2966":55274},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3483":1832,"_30444":1825,"_5":30794,"_21068":55276,"_27672":55277,"_2966":55278},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3483":1833,"_30444":1825,"_5":30794,"_21068":55280,"_27672":55281,"_2966":55282},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3483":1834,"_30444":1825,"_5":30794,"_21068":55284,"_27672":55285,"_2966":55286},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3483":1835,"_30444":1825,"_5":30794,"_21068":55288,"_27672":55289,"_2966":55290},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3483":1836,"_30444":1825,"_5":30794,"_21068":55292,"_27672":55293,"_2966":55294},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3483":1837,"_30444":1825,"_5":30794,"_21068":55296,"_27672":55297,"_2966":55298},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3483":1838,"_30444":1825,"_5":30794,"_21068":55300,"_27672":55301,"_2966":55302},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3483":1839,"_30444":1825,"_5":30794,"_21068":55304,"_27672":55305,"_2966":55306},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3483":1840,"_30444":1825,"_5":30794,"_21068":55308,"_27672":55309,"_2966":55310},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3483":1841,"_30444":1825,"_5":30794,"_21068":55312,"_27672":55313,"_2966":55314},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3483":1842,"_30444":1825,"_5":30794,"_21068":55316,"_27672":55317,"_2966":55318},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3483":1843,"_30444":1825,"_5":30794,"_21068":55320,"_27672":55321,"_2966":55322},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3483":1844,"_30444":1825,"_5":30794,"_21068":55324,"_27672":55325,"_2966":55326},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3483":1845,"_30444":1825,"_5":30794,"_21068":55328,"_27672":55329,"_2966":55330},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3483":1846,"_30444":1825,"_5":30794,"_21068":55332,"_27672":55333,"_2966":55334},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3483":1847,"_30444":1825,"_5":30794,"_21068":55336,"_27672":55337,"_2966":55338},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3483":1848,"_30444":1825,"_5":30794,"_21068":55340,"_27672":55341,"_2966":55342},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3483":1849,"_30444":1825,"_5":30794,"_21068":55344,"_27672":55345,"_2966":55346},[],"/docs/pr-preview/pr-65/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3483":1850,"_30444":1825,"_21068":55348,"_5":14479,"_27672":1825,"_2966":55349},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3483":1851,"_30444":1825,"_21068":55351,"_5":14479,"_27672":1825,"_2966":55352},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3483":1852,"_30444":1825,"_21068":55354,"_5":14479,"_27672":1825,"_2966":55355},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3483":1853,"_30444":1825,"_21068":55357,"_5":14479,"_27672":55258,"_2966":55358},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3483":1854,"_30444":1825,"_21068":55360,"_5":14479,"_27672":55258,"_2966":55361},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3483":1855,"_30444":1825,"_21068":55363,"_5":14479,"_27672":55258,"_2966":55364},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3483":1856,"_30444":1825,"_21068":55366,"_5":14479,"_27672":55258,"_2966":55367},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3483":1857,"_30444":1825,"_21068":55369,"_5":14479,"_27672":55258,"_2966":55370},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3483":1858,"_30444":1825,"_21068":55372,"_5":14479,"_27672":55266,"_2966":55373},[],"Decide whether the CA will be a root or an intermediate.",{"_3483":1859,"_30444":1825,"_21068":55375,"_5":14479,"_27672":55266,"_2966":55376},[],"Choose the engine that will keep the key.",{"_3483":1860,"_30444":1825,"_21068":55378,"_5":14479,"_27672":55266,"_2966":55379},[],"Define a validity longer than that of the certificates it will issue.",{"_3483":1861,"_30444":1825,"_21068":55381,"_5":14479,"_27672":55266,"_2966":55382},[],"For an intermediate CA, make sure the parent CA is active.",{"_3483":1862,"_30444":1825,"_21068":55384,"_5":14479,"_27672":55269,"_2966":55385},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3483":1863,"_30444":1825,"_21068":55387,"_5":14479,"_27672":55273,"_2966":55388},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3483":1864,"_30444":1825,"_21068":55390,"_5":14479,"_27672":55273,"_2966":55391},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3483":1865,"_30444":1825,"_21068":55393,"_5":14479,"_27672":55277,"_2966":55394},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3483":1866,"_30444":1825,"_21068":55396,"_5":14479,"_27672":55281,"_2966":55397},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3483":1867,"_30444":1825,"_21068":55399,"_5":14479,"_27672":55281,"_2966":55400},[],"`C`: two-letter ISO 3166-1 country code.",{"_3483":1868,"_30444":1825,"_21068":55402,"_5":14479,"_27672":55281,"_2966":55403},[],"`ST`: state or province.",{"_3483":1869,"_30444":1825,"_21068":55405,"_5":14479,"_27672":55281,"_2966":55406},[],"`L`: locality.",{"_3483":1870,"_30444":1825,"_21068":55408,"_5":14479,"_27672":55281,"_2966":55409},[],"`O`: organization.",{"_3483":1871,"_30444":1825,"_21068":55411,"_5":14479,"_27672":55281,"_2966":55412},[],"`OU`: organizational unit.",{"_3483":1872,"_30444":1825,"_21068":55414,"_5":14479,"_27672":55281,"_2966":55415},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3483":1873,"_30444":1825,"_21068":55417,"_5":14479,"_27672":55285,"_2966":55418},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3483":1874,"_30444":1825,"_21068":55420,"_5":14479,"_27672":55285,"_2966":55421},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3483":1875,"_30444":1825,"_21068":55423,"_5":14479,"_27672":55289,"_2966":55424},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3483":1876,"_30444":1825,"_21068":55426,"_5":14479,"_27672":55289,"_2966":55427},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3483":1877,"_30444":1825,"_21068":55429,"_5":14479,"_27672":55293,"_2966":55430},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3483":1878,"_30444":1825,"_21068":55432,"_5":14479,"_27672":55293,"_2966":55433},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3483":1879,"_30444":1825,"_21068":55435,"_5":14479,"_27672":55297,"_2966":55436},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3483":1880,"_30444":1825,"_21068":55438,"_5":14479,"_27672":55297,"_2966":55439},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3483":1881,"_30444":1825,"_21068":55441,"_5":14479,"_27672":55297,"_2966":55442},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3483":1882,"_30444":1825,"_21068":55444,"_5":14479,"_27672":55301,"_2966":55445},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3483":1883,"_30444":1825,"_21068":55447,"_5":14479,"_27672":55305,"_2966":55448},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3483":1884,"_30444":1825,"_21068":55450,"_5":14479,"_27672":55305,"_2966":55451},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3483":1885,"_30444":1825,"_21068":55453,"_5":14479,"_27672":55309,"_2966":55454},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3483":1886,"_30444":1825,"_21068":55456,"_5":14479,"_27672":55313,"_2966":55457},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3483":1887,"_30444":1825,"_21068":55459,"_5":14479,"_27672":55313,"_2966":55460},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3483":1888,"_30444":1825,"_21068":55462,"_5":14479,"_27672":55317,"_2966":55463},[],"Open a CA from the inventory to review:",{"_3483":1889,"_30444":1825,"_21068":55465,"_5":14479,"_27672":55317,"_2966":55466},[],"Status and validity period.",{"_3483":1890,"_30444":1825,"_21068":55468,"_5":14479,"_27672":55317,"_2966":55469},[],"Certificate and chain in PEM format.",{"_3483":1891,"_30444":1825,"_21068":55471,"_5":14479,"_27672":55317,"_2966":55472},[],"Number of active, expired and revoked certificates.",{"_3483":1892,"_30444":1825,"_21068":55474,"_5":14479,"_27672":55317,"_2966":55475},[],"Certificates issued in **Issued Certificates**.",{"_3483":1893,"_30444":1825,"_21068":55477,"_5":14479,"_27672":55317,"_2966":55478},[],"The CRL linked to the authority.",{"_3483":1894,"_30444":1825,"_21068":55480,"_5":14479,"_27672":55317,"_2966":55481},[],"Metadata and the associated cryptographic engine.",{"_3483":1895,"_30444":1825,"_21068":55483,"_5":14479,"_27672":55317,"_2966":55484},[],"You can filter the inventory by name, status and CA type.",{"_3483":1896,"_30444":1825,"_21068":55486,"_5":14479,"_27672":55321,"_2966":55487},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3483":1897,"_30444":1825,"_21068":55489,"_5":14479,"_27672":55321,"_2966":55490},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3483":1898,"_30444":1825,"_21068":55492,"_5":14479,"_27672":55321,"_2966":55493},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3483":1899,"_30444":1825,"_21068":55495,"_5":14479,"_27672":55321,"_2966":55496},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3483":1900,"_30444":1825,"_21068":55498,"_5":14479,"_27672":55325,"_2966":55499},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3483":1901,"_30444":1825,"_21068":55501,"_5":14479,"_27672":55329,"_2966":55502},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3483":1902,"_30444":1825,"_21068":55504,"_5":14479,"_27672":55333,"_2966":55505},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3483":1903,"_30444":1825,"_21068":55507,"_5":14479,"_27672":55337,"_2966":55508},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3483":1904,"_30444":1825,"_21068":55510,"_5":14479,"_27672":55341,"_2966":55511},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3483":1905,"_30444":1825,"_21068":55513,"_5":14479,"_27672":55345,"_2966":55514},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3483":1906,"_30444":1825,"_21068":55516,"_5":14479,"_27672":55345,"_2966":55517},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which it does within about an hour after the CA is revoked, so retry in a few seconds. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3483":1907,"_30444":1825,"_21068":55519,"_5":14479,"_27672":55345,"_2966":55520},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them afterwards with the delete endpoint of the CRL settings API. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3483":1908,"_30444":1825,"_21068":55522,"_5":14479,"_27672":55345,"_2966":55523},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3483":1909,"_30444":1909,"_5":14831,"_2966":55525,"_30797":55526,"_21068":55527,"_27672":1909},"Certificate profiles",[49604,51079,55087,55088],[],{"_3483":1910,"_30444":1909,"_21068":55529,"_5":14479,"_27672":1909,"_2966":55530},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3483":1911,"_30444":1909,"_5":30794,"_21068":55532,"_27672":55533,"_2966":55534},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3483":1912,"_30444":1909,"_5":30794,"_21068":55536,"_27672":55537,"_2966":55538},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#validity","Validity",{"_3483":1913,"_30444":1909,"_5":30794,"_21068":55540,"_27672":55541,"_2966":55542},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3483":1914,"_30444":1909,"_5":30794,"_21068":55544,"_27672":55545,"_2966":55546},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3483":1915,"_30444":1909,"_5":30794,"_21068":55548,"_27672":55549,"_2966":55550},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#subject","Subject",{"_3483":1916,"_30444":1909,"_5":30794,"_21068":55552,"_27672":55553,"_2966":55554},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3483":1917,"_30444":1909,"_5":30794,"_21068":55556,"_27672":55557,"_2966":55558},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3483":1918,"_30444":1909,"_5":30794,"_21068":55560,"_27672":55561,"_2966":55562},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3483":1919,"_30444":1909,"_5":30794,"_21068":55564,"_27672":55565,"_2966":55566},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3483":1920,"_30444":1909,"_5":30794,"_21068":55568,"_27672":55569,"_2966":55570},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3483":1921,"_30444":1909,"_5":30794,"_21068":55572,"_27672":55573,"_2966":55574},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3483":1922,"_30444":1909,"_5":30794,"_21068":55576,"_27672":55577,"_2966":55578},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3483":1923,"_30444":1909,"_5":30794,"_21068":55580,"_27672":55581,"_2966":55582},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3483":1924,"_30444":1909,"_5":30794,"_21068":55584,"_27672":55585,"_2966":55586},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3483":1925,"_30444":1909,"_5":30794,"_21068":55588,"_27672":55589,"_2966":55590},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#design-examples","Design examples",{"_3483":1926,"_30444":1909,"_5":30794,"_21068":55592,"_27672":55593,"_2966":55594},[],"/docs/pr-preview/pr-65/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3483":1927,"_30444":1909,"_21068":55596,"_5":14479,"_27672":1909,"_2966":55597},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3483":1928,"_30444":1909,"_21068":55599,"_5":14479,"_27672":1909,"_2966":55600},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3483":1929,"_30444":1909,"_21068":55602,"_5":14479,"_27672":55537,"_2966":55603},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3483":1930,"_30444":1909,"_21068":55605,"_5":14479,"_27672":55537,"_2966":55606},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3483":1931,"_30444":1909,"_21068":55608,"_5":14479,"_27672":55541,"_2966":55609},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3483":1932,"_30444":1909,"_21068":55611,"_5":14479,"_27672":55545,"_2966":55612},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3483":1933,"_30444":1909,"_21068":55614,"_5":14479,"_27672":55545,"_2966":55615},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3483":1934,"_30444":1909,"_21068":55617,"_5":14479,"_27672":55545,"_2966":55618},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3483":1935,"_30444":1909,"_21068":55620,"_5":14479,"_27672":55549,"_2966":55621},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3483":1936,"_30444":1909,"_21068":55623,"_5":14479,"_27672":55553,"_2966":55624},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3483":1937,"_30444":1909,"_21068":55626,"_5":14479,"_27672":55553,"_2966":55627},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3483":1938,"_30444":1909,"_21068":55629,"_5":14479,"_27672":55557,"_2966":55630},[],"The cryptographic enforcement can:",{"_3483":1939,"_30444":1909,"_21068":55632,"_5":14479,"_27672":55557,"_2966":55633},[],"allow or block RSA keys;",{"_3483":1940,"_30444":1909,"_21068":55635,"_5":14479,"_27672":55557,"_2966":55636},[],"limit the supported RSA sizes;",{"_3483":1941,"_30444":1909,"_21068":55638,"_5":14479,"_27672":55557,"_2966":55639},[],"allow or block ECDSA keys;",{"_3483":1942,"_30444":1909,"_21068":55641,"_5":14479,"_27672":55557,"_2966":55642},[],"limit the supported ECDSA sizes or curves.",{"_3483":1943,"_30444":1909,"_21068":55644,"_5":14479,"_27672":55557,"_2966":55645},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3483":1944,"_30444":1909,"_21068":55647,"_5":14479,"_27672":55561,"_2966":55648},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3483":1945,"_30444":1909,"_21068":55650,"_5":14479,"_27672":55561,"_2966":52849},[],{"_3483":1946,"_30444":1909,"_21068":55652,"_5":14479,"_27672":55561,"_2966":55653},[],"First choice",{"_3483":1947,"_30444":1909,"_21068":55655,"_5":14479,"_27672":55561,"_2966":55656},[],"Second choice",{"_3483":1948,"_30444":1909,"_21068":55658,"_5":14479,"_27672":55561,"_2966":55659},[],"If neither is supplied",{"_3483":1949,"_30444":1909,"_21068":55661,"_5":14479,"_27672":55561,"_2966":55662},[],"Direct signing with a CA",{"_3483":1950,"_30444":1909,"_21068":55664,"_5":14479,"_27672":55561,"_2966":55665},[],"`issuance_profile` embedded in the request",{"_3483":1951,"_30444":1909,"_21068":55667,"_5":14479,"_27672":55561,"_2966":55668},[],"Request `issuance_profile_id`",{"_3483":1952,"_30444":1909,"_21068":55670,"_5":14479,"_27672":55561,"_2966":55671},[],"CA default profile (`profile_id`).",{"_3483":1953,"_30444":1909,"_21068":55673,"_5":14479,"_27672":55561,"_2966":55674},[],"Issuance through a DMS",{"_3483":1954,"_30444":1909,"_21068":55676,"_5":14479,"_27672":55561,"_2966":55677},[],"`settings.issuance_profile_id`",{"_3483":1955,"_30444":1909,"_21068":55679,"_5":14479,"_27672":55561,"_2966":55680},[],"`settings.issuance_profile` embedded in the DMS",{"_3483":1956,"_30444":1909,"_21068":55682,"_5":14479,"_27672":55561,"_2966":55683},[],"Enrollment CA default profile.",{"_3483":1957,"_30444":1909,"_21068":55685,"_5":14479,"_27672":55561,"_2966":55686},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3483":1958,"_30444":1909,"_21068":55688,"_5":14479,"_27672":55561,"_2966":55689},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3483":1959,"_30444":1909,"_21068":55691,"_5":14479,"_27672":55569,"_2966":55692},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3483":1960,"_30444":1909,"_21068":55694,"_5":14479,"_27672":55573,"_2966":55695},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3483":1961,"_30444":1909,"_21068":55697,"_5":14479,"_27672":55577,"_2966":55698},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3483":1962,"_30444":1909,"_21068":55700,"_5":14479,"_27672":55581,"_2966":55701},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3483":1963,"_30444":1909,"_21068":55703,"_5":14479,"_27672":55585,"_2966":55704},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3483":1964,"_30444":1909,"_21068":55706,"_5":14479,"_27672":55585,"_2966":55707},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3483":1965,"_30444":1909,"_21068":55709,"_5":14479,"_27672":55589,"_2966":55710},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3483":1966,"_30444":1909,"_21068":55712,"_5":14479,"_27672":55589,"_2966":55713},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3483":1967,"_30444":1909,"_21068":55715,"_5":14479,"_27672":55589,"_2966":55716},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3483":1968,"_30444":1909,"_21068":55718,"_5":14479,"_27672":55589,"_2966":55719},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3483":1969,"_30444":1909,"_21068":55721,"_5":14479,"_27672":55593,"_2966":55722},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3483":1970,"_30444":1909,"_21068":55724,"_5":14479,"_27672":55593,"_2966":55725},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3483":1971,"_30444":1971,"_5":14831,"_2966":55727,"_30797":55728,"_21068":55730,"_27672":1971},"Certificate validation",[49604,51079,55087,55729],"Validation",[],{"_3483":1972,"_30444":1971,"_21068":55732,"_5":14479,"_27672":1971,"_2966":55733},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3483":1973,"_30444":1971,"_5":30794,"_21068":55735,"_27672":55736,"_2966":55737},[],"/docs/pr-preview/pr-65/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3483":1974,"_30444":1971,"_5":30794,"_21068":55739,"_27672":55740,"_2966":55741},[],"/docs/pr-preview/pr-65/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3483":1975,"_30444":1971,"_5":30794,"_21068":55743,"_27672":55744,"_2966":55745},[],"/docs/pr-preview/pr-65/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3483":1976,"_30444":1971,"_21068":55747,"_5":14479,"_27672":1971,"_2966":55748},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3483":1977,"_30444":1971,"_21068":55750,"_5":14479,"_27672":55736,"_2966":55751},[],"Verify these criteria together:",{"_3483":1978,"_30444":1971,"_21068":55753,"_5":14479,"_27672":55736,"_2966":54713},[],{"_3483":1979,"_30444":1971,"_21068":55755,"_5":14479,"_27672":55736,"_2966":55756},[],"Required result",{"_3483":1980,"_30444":1971,"_21068":55758,"_5":14479,"_27672":55736,"_2966":55759},[],"Chain and signature",{"_3483":1981,"_30444":1971,"_21068":55761,"_5":14479,"_27672":55736,"_2966":55762},[],"Valid chain to a root deliberately installed in the consumer.",{"_3483":1982,"_30444":1971,"_21068":55764,"_5":14479,"_27672":55736,"_2966":55765},[],"Dates",{"_3483":1983,"_30444":1971,"_21068":55767,"_5":14479,"_27672":55736,"_2966":55768},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3483":1984,"_30444":1971,"_21068":55770,"_5":14479,"_27672":55736,"_2966":50748},[],{"_3483":1985,"_30444":1971,"_21068":55772,"_5":14479,"_27672":55736,"_2966":55773},[],"Name, SAN or identifier matches the expected peer.",{"_3483":1986,"_30444":1971,"_21068":55775,"_5":14479,"_27672":55736,"_2966":49994},[],{"_3483":1987,"_30444":1971,"_21068":55777,"_5":14479,"_27672":55736,"_2966":55778},[],"KU, EKU and constraints permit the specific operation.",{"_3483":1988,"_30444":1971,"_21068":55780,"_5":14479,"_27672":55736,"_2966":55781},[],"Revocation",{"_3483":1989,"_30444":1971,"_21068":55783,"_5":14479,"_27672":55736,"_2966":55784},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3483":1990,"_30444":1971,"_21068":55786,"_5":14479,"_27672":55736,"_2966":55787},[],"Authorization",{"_3483":1991,"_30444":1971,"_21068":55789,"_5":14479,"_27672":55736,"_2966":55790},[],"The application permits that identity to perform the action.",{"_3483":1992,"_30444":1971,"_21068":55792,"_5":14479,"_27672":55736,"_2966":55793},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3483":1993,"_30444":1971,"_21068":55795,"_5":14479,"_27672":55740,"_2966":55796},[],"Mechanism",{"_3483":1994,"_30444":1971,"_21068":55798,"_5":14479,"_27672":55740,"_2966":55799},[],"When to use it",{"_3483":1995,"_30444":1971,"_21068":55801,"_5":14479,"_27672":55740,"_2966":55802},[],"What you must maintain",{"_3483":1996,"_30444":1971,"_21068":55804,"_5":14479,"_27672":55740,"_2966":55805},[],"OCSP",{"_3483":1997,"_30444":1971,"_21068":55807,"_5":14479,"_27672":55740,"_2966":55808},[],"Status query for a specific certificate.",{"_3483":1998,"_30444":1971,"_21068":55810,"_5":14479,"_27672":55740,"_2966":55811},[],"Responder access, signature verification and cache/freshness policy.",{"_3483":1999,"_30444":1971,"_21068":55813,"_5":14479,"_27672":55740,"_2966":55814},[],"CRL",{"_3483":2000,"_30444":1971,"_21068":55816,"_5":14479,"_27672":55740,"_2966":55817},[],"Local checks for many certificates or offline operation.",{"_3483":2001,"_30444":1971,"_21068":55819,"_5":14479,"_27672":55740,"_2966":55820},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3483":2002,"_30444":1971,"_21068":55822,"_5":14479,"_27672":55740,"_2966":55823},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3483":2003,"_30444":1971,"_21068":55825,"_5":14479,"_27672":55740,"_2966":55826},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3483":2004,"_30444":1971,"_21068":55828,"_5":14479,"_27672":55744,"_2966":55829},[],"Accept a current, authorized certificate with a known chain.",{"_3483":2005,"_30444":1971,"_21068":55831,"_5":14479,"_27672":55744,"_2966":55832},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3483":2006,"_30444":1971,"_21068":55834,"_5":14479,"_27672":55744,"_2966":55835},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3483":2007,"_30444":1971,"_21068":55837,"_5":14479,"_27672":55744,"_2966":55838},[],"Check that a new connection with that identity is rejected.",{"_3483":2008,"_30444":1971,"_21068":55840,"_5":14479,"_27672":55744,"_2966":55841},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3483":2009,"_30444":1971,"_21068":55843,"_5":14479,"_27672":55744,"_2966":55844},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3483":2010,"_30444":1971,"_21068":55846,"_5":14479,"_27672":55744,"_2966":55847},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3483":2011,"_30444":1971,"_21068":55849,"_5":14479,"_27672":55744,"_2966":55850},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3483":2012,"_30444":1971,"_21068":55852,"_5":14479,"_27672":55744,"_2966":55853},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3483":2013,"_30444":2013,"_5":14831,"_2966":55855,"_30797":55856,"_21068":55857,"_27672":2013},"Certificates",[49604,51079,55087,55088],[],{"_3483":2014,"_30444":2013,"_21068":55859,"_5":14479,"_27672":2013,"_2966":55860},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3483":2015,"_30444":2013,"_5":30794,"_21068":55862,"_27672":55863,"_2966":55864},[],"/docs/pr-preview/pr-65/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3483":2016,"_30444":2013,"_5":30794,"_21068":55866,"_27672":55867,"_2966":55868},[],"/docs/pr-preview/pr-65/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3483":2017,"_30444":2013,"_5":30794,"_21068":55870,"_27672":55871,"_2966":55872},[],"/docs/pr-preview/pr-65/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3483":2018,"_30444":2013,"_5":30794,"_21068":55874,"_27672":55875,"_2966":55876},[],"/docs/pr-preview/pr-65/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3483":2019,"_30444":2013,"_5":30794,"_21068":55878,"_27672":55879,"_2966":55880},[],"/docs/pr-preview/pr-65/platform/pki/certificates#open-the-action","Open the action",{"_3483":2020,"_30444":2013,"_5":30794,"_21068":55882,"_27672":55883,"_2966":55884},[],"/docs/pr-preview/pr-65/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3483":2021,"_30444":2013,"_5":30794,"_21068":55886,"_27672":55887,"_2966":55888},[],"/docs/pr-preview/pr-65/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3483":2022,"_30444":2013,"_5":30794,"_21068":55890,"_27672":55891,"_2966":55892},[],"/docs/pr-preview/pr-65/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3483":2023,"_30444":2013,"_5":30794,"_21068":55894,"_27672":55895,"_2966":55896},[],"/docs/pr-preview/pr-65/platform/pki/certificates#continue","Continue",{"_3483":2024,"_30444":2013,"_21068":55898,"_5":14479,"_27672":2013,"_2966":55899},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3483":2025,"_30444":2013,"_21068":55901,"_5":14479,"_27672":55863,"_2966":55902},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3483":2026,"_30444":2013,"_21068":55904,"_5":14479,"_27672":55863,"_2966":55905},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3483":2027,"_30444":2013,"_21068":55907,"_5":14479,"_27672":55863,"_2966":55908},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3483":2028,"_30444":2013,"_21068":55910,"_5":14479,"_27672":55863,"_2966":55911},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3483":2029,"_30444":2013,"_21068":55913,"_5":14479,"_27672":55863,"_2966":55914},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3483":2030,"_30444":2013,"_21068":55916,"_5":14479,"_27672":55863,"_2966":55917},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3483":2031,"_30444":2013,"_21068":55919,"_5":14479,"_27672":55863,"_2966":55920},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3483":2032,"_30444":2013,"_21068":55922,"_5":14479,"_27672":55867,"_2966":55923},[],"Download the PEM and inspect it:",{"_3483":2033,"_30444":2013,"_21068":55925,"_5":14479,"_27672":55867,"_2966":55926},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3483":2034,"_30444":2013,"_21068":55928,"_5":14479,"_27672":55871,"_2966":55929},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3483":2035,"_30444":2013,"_21068":55931,"_5":14479,"_27672":55871,"_2966":55932},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3483":2036,"_30444":2013,"_21068":55934,"_5":14479,"_27672":55871,"_2966":55935},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3483":2037,"_30444":2013,"_21068":55937,"_5":14479,"_27672":55871,"_2966":55938},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3483":2038,"_30444":2013,"_21068":55940,"_5":14479,"_27672":55871,"_2966":55941},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3483":2039,"_30444":2013,"_21068":55943,"_5":14479,"_27672":55871,"_2966":55944},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3483":2040,"_30444":2013,"_21068":55946,"_5":14479,"_27672":55871,"_2966":55947},[],"For browser key generation, follow Issue your first certificate.",{"_3483":2041,"_30444":2013,"_21068":55949,"_5":14479,"_27672":55875,"_2966":55950},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3483":2042,"_30444":2013,"_21068":55952,"_5":14479,"_27672":55879,"_2966":55953},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3483":2043,"_30444":2013,"_21068":55955,"_5":14479,"_27672":55883,"_2966":55956},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3483":2044,"_30444":2013,"_21068":55958,"_5":14479,"_27672":55887,"_2966":55959},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3483":2045,"_30444":2013,"_21068":55961,"_5":14479,"_27672":55887,"_2966":55962},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3483":2046,"_30444":2013,"_21068":55964,"_5":14479,"_27672":55887,"_2966":55965},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3483":2047,"_30444":2013,"_21068":55967,"_5":14479,"_27672":55891,"_2966":55968},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3483":2048,"_30444":2013,"_21068":55970,"_5":14479,"_27672":55891,"_2966":55971},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3483":2049,"_30444":2013,"_21068":55973,"_5":14479,"_27672":55891,"_2966":55974},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3483":2050,"_30444":2013,"_21068":55976,"_5":14479,"_27672":55895,"_2966":55977},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3483":2051,"_30444":2013,"_21068":55979,"_5":14479,"_27672":55895,"_2966":55980},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3483":2052,"_30444":2052,"_5":14831,"_2966":55982,"_30797":55983,"_21068":55985,"_27672":2052},"Certificate lifecycle",[49604,51079,55087,55984],"Concepts",[],{"_3483":2053,"_30444":2052,"_21068":55987,"_5":14479,"_27672":2052,"_2966":55988},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3483":2054,"_30444":2052,"_5":30794,"_21068":55990,"_27672":55991,"_2966":55992},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3483":2055,"_30444":2052,"_5":30794,"_21068":55994,"_27672":55995,"_2966":55996},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3483":2056,"_30444":2052,"_5":30794,"_21068":55998,"_27672":55999,"_2966":56000},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3483":2057,"_30444":2052,"_5":30794,"_21068":56002,"_27672":56003,"_2966":56004},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3483":2058,"_30444":2052,"_5":30794,"_21068":56006,"_27672":56007,"_2966":56008},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3483":2059,"_30444":2052,"_5":30794,"_21068":56010,"_27672":56011,"_2966":56012},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3483":2060,"_30444":2052,"_5":30794,"_21068":56014,"_27672":56015,"_2966":56016},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3483":2061,"_30444":2052,"_5":30794,"_21068":56018,"_27672":56019,"_2966":56020},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3483":2062,"_30444":2052,"_5":30794,"_21068":56022,"_27672":56023,"_2966":56024},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3483":2063,"_30444":2052,"_5":30794,"_21068":56026,"_27672":56027,"_2966":56028},[],"/docs/pr-preview/pr-65/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3483":2064,"_30444":2052,"_21068":56030,"_5":14479,"_27672":2052,"_2966":56031},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3483":2065,"_30444":2052,"_21068":56033,"_5":14479,"_27672":55995,"_2966":56034},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3483":2066,"_30444":2052,"_21068":56036,"_5":14479,"_27672":55999,"_2966":56037},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3483":2067,"_30444":2052,"_21068":56039,"_5":14479,"_27672":56003,"_2966":56040},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3483":2068,"_30444":2052,"_21068":56042,"_5":14479,"_27672":56007,"_2966":56043},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3483":2069,"_30444":2052,"_21068":56045,"_5":14479,"_27672":56011,"_2966":56046},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3483":2070,"_30444":2052,"_21068":56048,"_5":14479,"_27672":56015,"_2966":56049},[],"Lamassu persists four X.509 states:",{"_3483":2071,"_30444":2052,"_21068":56051,"_5":14479,"_27672":56015,"_2966":56052},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3483":2072,"_30444":2052,"_21068":56054,"_5":14479,"_27672":56015,"_2966":56055},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3483":2073,"_30444":2052,"_21068":56057,"_5":14479,"_27672":56015,"_2966":56058},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3483":2074,"_30444":2052,"_21068":56060,"_5":14479,"_27672":56015,"_2966":56061},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3483":2075,"_30444":2052,"_21068":56063,"_5":14479,"_27672":56015,"_2966":56064},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3483":2076,"_30444":2052,"_21068":56066,"_5":14479,"_27672":56019,"_2966":56067},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3483":2077,"_30444":2052,"_21068":56069,"_5":14479,"_27672":56019,"_2966":56070},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3483":2078,"_30444":2052,"_21068":56072,"_5":14479,"_27672":56019,"_2966":56073},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3483":2079,"_30444":2052,"_21068":56075,"_5":14479,"_27672":56023,"_2966":56076},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3483":2080,"_30444":2052,"_21068":56078,"_5":14479,"_27672":56023,"_2966":56079},[],"Before confirming:",{"_3483":2081,"_30444":2052,"_21068":56081,"_5":14479,"_27672":56023,"_2966":56082},[],"Identify DMSs, devices and services that trust that chain.",{"_3483":2082,"_30444":2052,"_21068":56084,"_5":14479,"_27672":56023,"_2966":56085},[],"Distribute the new chain of trust.",{"_3483":2083,"_30444":2052,"_21068":56087,"_5":14479,"_27672":56023,"_2966":56088},[],"Reissue the necessary identities.",{"_3483":2084,"_30444":2052,"_21068":56090,"_5":14479,"_27672":56023,"_2966":56091},[],"Check OCSP and CRL from a real consumer.",{"_3483":2085,"_30444":2052,"_21068":56093,"_5":14479,"_27672":56023,"_2966":56094},[],"Revoke the old CA once no legitimate traffic remains.",{"_3483":2086,"_30444":2052,"_21068":56096,"_5":14479,"_27672":56023,"_2966":56097},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3483":2087,"_30444":2052,"_21068":56099,"_5":14479,"_27672":56027,"_2966":56100},[],"Certificates entering the preventive or critical renewal window.",{"_3483":2088,"_30444":2052,"_21068":56102,"_5":14479,"_27672":56027,"_2966":56103},[],"Repeated enrollment or re-enrollment failures.",{"_3483":2089,"_30444":2052,"_21068":56105,"_5":14479,"_27672":56027,"_2966":56106},[],"Status changes and revocation reasons.",{"_3483":2090,"_30444":2052,"_21068":56108,"_5":14479,"_27672":56027,"_2966":56109},[],"OCSP and CRL publication and validity.",{"_3483":2091,"_30444":2052,"_21068":56111,"_5":14479,"_27672":56027,"_2966":56112},[],"Dependencies still presenting a replaced certificate.",{"_3483":2092,"_30444":2052,"_21068":56114,"_5":14479,"_27672":56027,"_2966":56115},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3483":2093,"_30444":2093,"_5":14831,"_2966":56117,"_30797":56118,"_21068":56119,"_27672":2093},"Trust model",[49604,51079,55087,55984],[],{"_3483":2094,"_30444":2093,"_21068":56121,"_5":14479,"_27672":2093,"_2966":56122},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3483":2095,"_30444":2093,"_5":30794,"_21068":56124,"_27672":56125,"_2966":56126},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3483":2096,"_30444":2093,"_5":30794,"_21068":56128,"_27672":56129,"_2966":56130},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3483":2097,"_30444":2093,"_5":30794,"_21068":56132,"_27672":56133,"_2966":56134},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3483":2098,"_30444":2093,"_5":30794,"_21068":56136,"_27672":56137,"_2966":56138},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3483":2099,"_30444":2093,"_5":30794,"_21068":56140,"_27672":56141,"_2966":56142},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3483":2100,"_30444":2093,"_5":30794,"_21068":56144,"_27672":56145,"_2966":56146},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3483":2101,"_30444":2093,"_5":30794,"_21068":56148,"_27672":56149,"_2966":56150},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3483":2102,"_30444":2093,"_5":30794,"_21068":56152,"_27672":56153,"_2966":56154},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3483":2103,"_30444":2093,"_5":30794,"_21068":56156,"_27672":56157,"_2966":56158},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3483":2104,"_30444":2093,"_5":30794,"_21068":56160,"_27672":56161,"_2966":56162},[],"/docs/pr-preview/pr-65/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3483":2105,"_30444":2093,"_21068":56164,"_5":14479,"_27672":2093,"_2966":56165},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3483":2106,"_30444":2093,"_21068":56167,"_5":14479,"_27672":56129,"_2966":56168},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3483":2107,"_30444":2093,"_21068":56170,"_5":14479,"_27672":56133,"_2966":56171},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3483":2108,"_30444":2093,"_21068":56173,"_5":14479,"_27672":56137,"_2966":56174},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3483":2109,"_30444":2093,"_21068":56176,"_5":14479,"_27672":56141,"_2966":56177},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3483":2110,"_30444":2093,"_21068":56179,"_5":14479,"_27672":56145,"_2966":56180},[],"The device proves it can enroll according to the DMS policy.",{"_3483":2111,"_30444":2093,"_21068":56182,"_5":14479,"_27672":56145,"_2966":56183},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3483":2112,"_30444":2093,"_21068":56185,"_5":14479,"_27672":56145,"_2966":56186},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3483":2113,"_30444":2093,"_21068":56188,"_5":14479,"_27672":56145,"_2966":56189},[],"The device installs the certificate and the chain it needs.",{"_3483":2114,"_30444":2093,"_21068":56191,"_5":14479,"_27672":56145,"_2966":56192},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3483":2115,"_30444":2093,"_21068":56194,"_5":14479,"_27672":56145,"_2966":56195},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3483":2116,"_30444":2093,"_21068":56197,"_5":14479,"_27672":56149,"_2966":56198},[],"A DMS relates three sets that are worth designing separately:",{"_3483":2117,"_30444":2093,"_21068":56200,"_5":14479,"_27672":56149,"_2966":56201},[],"**Enrollment CA:** signs the new identities.",{"_3483":2118,"_30444":2093,"_21068":56203,"_5":14479,"_27672":56149,"_2966":56204},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3483":2119,"_30444":2093,"_21068":56206,"_5":14479,"_27672":56149,"_2966":56207},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3483":2120,"_30444":2093,"_21068":56209,"_5":14479,"_27672":56149,"_2966":56210},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3483":2121,"_30444":2093,"_21068":56212,"_5":14479,"_27672":56153,"_2966":56213},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3483":2122,"_30444":2093,"_21068":56215,"_5":14479,"_27672":56153,"_2966":56216},[],"that the current date is between `Not Before` and `Not After`;",{"_3483":2123,"_30444":2093,"_21068":56218,"_5":14479,"_27672":56153,"_2966":56219},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3483":2124,"_30444":2093,"_21068":56221,"_5":14479,"_27672":56153,"_2966":56222},[],"that names, SANs and subject match the expected identity;",{"_3483":2125,"_30444":2093,"_21068":56224,"_5":14479,"_27672":56153,"_2966":56225},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3483":2126,"_30444":2093,"_21068":56227,"_5":14479,"_27672":56153,"_2966":56228},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3483":2127,"_30444":2093,"_21068":56230,"_5":14479,"_27672":56153,"_2966":56231},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3483":2128,"_30444":2093,"_21068":56233,"_5":14479,"_27672":56157,"_2966":56234},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3483":2129,"_30444":2093,"_21068":56236,"_5":14479,"_27672":56161,"_2966":56237},[],"Keep the root out of daily operations, or with very restricted access.",{"_3483":2130,"_30444":2093,"_21068":56239,"_5":14479,"_27672":56161,"_2966":56240},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3483":2131,"_30444":2093,"_21068":56242,"_5":14479,"_27672":56161,"_2966":56243},[],"Assign explicit profiles to every use case.",{"_3483":2132,"_30444":2093,"_21068":56245,"_5":14479,"_27672":56161,"_2966":56246},[],"Distribute the new trust before starting a rotation.",{"_3483":2133,"_30444":2093,"_21068":56248,"_5":14479,"_27672":56161,"_2966":56249},[],"Keep enough overlap to renew a disconnected fleet.",{"_3483":2134,"_30444":2093,"_21068":56251,"_5":14479,"_27672":56161,"_2966":56252},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3483":2135,"_30444":2093,"_21068":56254,"_5":14479,"_27672":56161,"_2966":56255},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3483":2136,"_30444":2136,"_5":14831,"_2966":56257,"_30797":56258,"_21068":56259,"_27672":2136},"Revocation lists (CRL)",[49604,51079,55087,55729],[],{"_3483":2137,"_30444":2136,"_21068":56261,"_5":14479,"_27672":2136,"_2966":56262},[],"Generate and distribute signed lists to validate certificates offline.",{"_3483":2138,"_30444":2136,"_5":30794,"_21068":56264,"_27672":56265,"_2966":56266},[],"/docs/pr-preview/pr-65/platform/pki/crl#crl-settings","CRL settings",{"_3483":2139,"_30444":2136,"_5":30794,"_21068":56268,"_27672":56269,"_2966":56270},[],"/docs/pr-preview/pr-65/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3483":2140,"_30444":2136,"_5":30794,"_21068":56272,"_27672":56273,"_2966":56274},[],"/docs/pr-preview/pr-65/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3483":2141,"_30444":2136,"_5":30794,"_21068":56276,"_27672":56277,"_2966":56278},[],"/docs/pr-preview/pr-65/platform/pki/crl#crl-contents","CRL contents",{"_3483":2142,"_30444":2136,"_5":30794,"_21068":56280,"_27672":56281,"_2966":56282},[],"/docs/pr-preview/pr-65/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3483":2143,"_30444":2136,"_5":30794,"_21068":56284,"_27672":56285,"_2966":56286},[],"/docs/pr-preview/pr-65/platform/pki/crl#crl-settings-api","CRL settings API",{"_3483":2144,"_30444":2136,"_5":30794,"_21068":56288,"_27672":56289,"_2966":56290},[],"/docs/pr-preview/pr-65/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3483":2145,"_30444":2136,"_5":30794,"_21068":56292,"_27672":56293,"_2966":56294},[],"/docs/pr-preview/pr-65/platform/pki/crl#from-the-interface","From the interface",{"_3483":2146,"_30444":2136,"_5":30794,"_21068":56296,"_27672":56297,"_2966":56298},[],"/docs/pr-preview/pr-65/platform/pki/crl#references","References",{"_3483":2147,"_30444":2136,"_21068":56300,"_5":14479,"_27672":2136,"_2966":56301},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3483":2148,"_30444":2136,"_21068":56303,"_5":14479,"_27672":56265,"_2966":56304},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3483":2149,"_30444":2136,"_21068":56306,"_5":14479,"_27672":56265,"_2966":56307},[],"Field",{"_3483":2150,"_30444":2136,"_21068":56309,"_5":14479,"_27672":56265,"_2966":49994},[],{"_3483":2151,"_30444":2136,"_21068":56311,"_5":14479,"_27672":56265,"_2966":56312},[],"`ca_id`",{"_3483":2152,"_30444":2136,"_21068":56314,"_5":14479,"_27672":56265,"_2966":56315},[],"ID of the CA the settings belong to.",{"_3483":2153,"_30444":2136,"_21068":56317,"_5":14479,"_27672":56265,"_2966":56318},[],"`status`",{"_3483":2154,"_30444":2136,"_21068":56320,"_5":14479,"_27672":56265,"_2966":56321},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3483":2155,"_30444":2136,"_21068":56323,"_5":14479,"_27672":56265,"_2966":56324},[],"`legacy_ski`",{"_3483":2156,"_30444":2136,"_21068":56326,"_5":14479,"_27672":56265,"_2966":56327},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3483":2157,"_30444":2136,"_21068":56329,"_5":14479,"_27672":56265,"_2966":56330},[],"`latest_crl`",{"_3483":2158,"_30444":2136,"_21068":56332,"_5":14479,"_27672":56265,"_2966":56333},[],"Version, validity start and end of the last published list. Read-only.",{"_3483":2159,"_30444":2136,"_21068":56335,"_5":14479,"_27672":56265,"_2966":56336},[],"`crl_options` field",{"_3483":2160,"_30444":2136,"_21068":56338,"_5":14479,"_27672":56265,"_2966":49994},[],{"_3483":2161,"_30444":2136,"_21068":56340,"_5":14479,"_27672":56265,"_2966":56341},[],"Initial value",{"_3483":2162,"_30444":2136,"_21068":56343,"_5":14479,"_27672":56265,"_2966":56344},[],"`validity`",{"_3483":2163,"_30444":2136,"_21068":56346,"_5":14479,"_27672":56265,"_2966":56347},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3483":2164,"_30444":2136,"_21068":56349,"_5":14479,"_27672":56265,"_2966":56350},[],"7 days.",{"_3483":2165,"_30444":2136,"_21068":56352,"_5":14479,"_27672":56265,"_2966":56353},[],"`refresh_interval`",{"_3483":2166,"_30444":2136,"_21068":56355,"_5":14479,"_27672":56265,"_2966":56356},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3483":2167,"_30444":2136,"_21068":56358,"_5":14479,"_27672":56265,"_2966":56359},[],"6 days and 23 hours.",{"_3483":2168,"_30444":2136,"_21068":56361,"_5":14479,"_27672":56265,"_2966":56362},[],"`regenerate_on_revoke`",{"_3483":2169,"_30444":2136,"_21068":56364,"_5":14479,"_27672":56265,"_2966":56365},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3483":2170,"_30444":2136,"_21068":56367,"_5":14479,"_27672":56265,"_2966":56368},[],"`true`.",{"_3483":2171,"_30444":2136,"_21068":56370,"_5":14479,"_27672":56265,"_2966":56371},[],"`signer_serial_number`",{"_3483":2172,"_30444":2136,"_21068":56373,"_5":14479,"_27672":56265,"_2966":56374},[],"Serial number of the existing certificate that signs the CRL.",{"_3483":2173,"_30444":2136,"_21068":56376,"_5":14479,"_27672":56265,"_2966":56377},[],"Serial number of the CA’s current certificate.",{"_3483":2174,"_30444":2136,"_21068":56379,"_5":14479,"_27672":56265,"_2966":56380},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3483":2175,"_30444":2136,"_21068":56382,"_5":14479,"_27672":56265,"_2966":56383},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3483":2176,"_30444":2136,"_21068":56385,"_5":14479,"_27672":56265,"_2966":56386},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3483":2177,"_30444":2136,"_21068":56388,"_5":14479,"_27672":56265,"_2966":56389},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3483":2178,"_30444":2136,"_21068":56391,"_5":14479,"_27672":56265,"_2966":56392},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API (see CRL settings API). What happens to them depends on how the CA ended:",{"_3483":2179,"_30444":2136,"_21068":56394,"_5":14479,"_27672":56265,"_2966":56395},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3483":2180,"_30444":2136,"_21068":56397,"_5":14479,"_27672":56265,"_2966":56398},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3483":2181,"_30444":2136,"_21068":56400,"_5":14479,"_27672":56265,"_2966":56401},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3483":2182,"_30444":2136,"_21068":56403,"_5":14479,"_27672":56265,"_2966":56404},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3483":2183,"_30444":2136,"_21068":56406,"_5":14479,"_27672":56265,"_2966":56407},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3483":2184,"_30444":2136,"_21068":56409,"_5":14479,"_27672":56265,"_2966":56410},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3483":2185,"_30444":2136,"_21068":56412,"_5":14479,"_27672":56269,"_2966":56413},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3483":2186,"_30444":2136,"_21068":56415,"_5":14479,"_27672":56269,"_2966":56416},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3483":2187,"_30444":2136,"_21068":56418,"_5":14479,"_27672":56269,"_2966":56419},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3483":2188,"_30444":2136,"_21068":56421,"_5":14479,"_27672":56269,"_2966":56422},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3483":2189,"_30444":2136,"_21068":56424,"_5":14479,"_27672":56273,"_2966":56425},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3483":2190,"_30444":2136,"_21068":56427,"_5":14479,"_27672":56273,"_2966":56428},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3483":2191,"_30444":2136,"_21068":56430,"_5":14479,"_27672":56273,"_2966":56431},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3483":2192,"_30444":2136,"_21068":56433,"_5":14479,"_27672":56273,"_2966":56434},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3483":2193,"_30444":2136,"_21068":56436,"_5":14479,"_27672":56273,"_2966":56437},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3483":2194,"_30444":2136,"_21068":56439,"_5":14479,"_27672":56273,"_2966":56440},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3483":2195,"_30444":2136,"_21068":56442,"_5":14479,"_27672":56273,"_2966":56443},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3483":2196,"_30444":2136,"_21068":56445,"_5":14479,"_27672":56273,"_2966":56446},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3483":2197,"_30444":2136,"_21068":56448,"_5":14479,"_27672":56273,"_2966":56449},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3483":2198,"_30444":2136,"_21068":56451,"_5":14479,"_27672":56277,"_2966":56452},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3483":2199,"_30444":2136,"_21068":56454,"_5":14479,"_27672":56277,"_2966":56455},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3483":2200,"_30444":2136,"_21068":56457,"_5":14479,"_27672":56281,"_2966":56458},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3483":2201,"_30444":2136,"_21068":56460,"_5":14479,"_27672":56281,"_2966":56461},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3483":2202,"_30444":2136,"_21068":56463,"_5":14479,"_27672":56281,"_2966":56464},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3483":2203,"_30444":2136,"_21068":56466,"_5":14479,"_27672":56281,"_2966":56467},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3483":2204,"_30444":2136,"_21068":56469,"_5":14479,"_27672":56281,"_2966":56470},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3483":2205,"_30444":2136,"_21068":56472,"_5":14479,"_27672":56285,"_2966":56473},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3483":2206,"_30444":2136,"_21068":56475,"_5":14479,"_27672":56285,"_2966":52852},[],{"_3483":2207,"_30444":2136,"_21068":56477,"_5":14479,"_27672":56285,"_2966":56478},[],"Relative path",{"_3483":2208,"_30444":2136,"_21068":56480,"_5":14479,"_27672":56285,"_2966":52849},[],{"_3483":2209,"_30444":2136,"_21068":56482,"_5":14479,"_27672":56285,"_2966":56483},[],"`GET`",{"_3483":2210,"_30444":2136,"_21068":56485,"_5":14479,"_27672":56285,"_2966":56486},[],"`/v1/crl-settings`",{"_3483":2211,"_30444":2136,"_21068":56488,"_5":14479,"_27672":56285,"_2966":56489},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3483":2212,"_30444":2136,"_21068":56491,"_5":14479,"_27672":56285,"_2966":56483},[],{"_3483":2213,"_30444":2136,"_21068":56493,"_5":14479,"_27672":56285,"_2966":56494},[],"`/v1/crl-settings/{ca-id}`",{"_3483":2214,"_30444":2136,"_21068":56496,"_5":14479,"_27672":56285,"_2966":56497},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3483":2215,"_30444":2136,"_21068":56499,"_5":14479,"_27672":56285,"_2966":56500},[],"`PUT`",{"_3483":2216,"_30444":2136,"_21068":56502,"_5":14479,"_27672":56285,"_2966":56494},[],{"_3483":2217,"_30444":2136,"_21068":56504,"_5":14479,"_27672":56285,"_2966":56505},[],"Replace the CRL configuration of a CA.",{"_3483":2218,"_30444":2136,"_21068":56507,"_5":14479,"_27672":56285,"_2966":56508},[],"`DELETE`",{"_3483":2219,"_30444":2136,"_21068":56510,"_5":14479,"_27672":56285,"_2966":56494},[],{"_3483":2220,"_30444":2136,"_21068":56512,"_5":14479,"_27672":56285,"_2966":56513},[],"Remove the archived CRL settings of a CA.",{"_3483":2221,"_30444":2136,"_21068":56515,"_5":14479,"_27672":56285,"_2966":56516},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3483":2222,"_30444":2136,"_21068":56518,"_5":14479,"_27672":56285,"_2966":56519},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint stops serving the CA’s list, although the published CRL files remain in the bucket.",{"_3483":2223,"_30444":2136,"_21068":56521,"_5":14479,"_27672":56285,"_2966":56522},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3483":2224,"_30444":2136,"_21068":56524,"_5":14479,"_27672":56289,"_2966":56525},[],"Symptom",{"_3483":2225,"_30444":2136,"_21068":56527,"_5":14479,"_27672":56289,"_2966":56528},[],"Cause",{"_3483":2226,"_30444":2136,"_21068":56530,"_5":14479,"_27672":56289,"_2966":56531},[],"Action",{"_3483":2227,"_30444":2136,"_21068":56533,"_5":14479,"_27672":56289,"_2966":56534},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3483":2228,"_30444":2136,"_21068":56536,"_5":14479,"_27672":56289,"_2966":56537},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3483":2229,"_30444":2136,"_21068":56539,"_5":14479,"_27672":56289,"_2966":56540},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3483":2230,"_30444":2136,"_21068":56542,"_5":14479,"_27672":56289,"_2966":56543},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3483":2231,"_30444":2136,"_21068":56545,"_5":14479,"_27672":56289,"_2966":56546},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3483":2232,"_30444":2136,"_21068":56548,"_5":14479,"_27672":56289,"_2966":56549},[],"Delete the CA first; deleting it archives its settings.",{"_3483":2233,"_30444":2136,"_21068":56551,"_5":14479,"_27672":56289,"_2966":56552},[],"`PUT` returns 400.",{"_3483":2234,"_30444":2136,"_21068":56554,"_5":14479,"_27672":56289,"_2966":56555},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3483":2235,"_30444":2136,"_21068":56557,"_5":14479,"_27672":56289,"_2966":56558},[],"Set the serial number of a valid certificate of that CA.",{"_3483":2236,"_30444":2136,"_21068":56560,"_5":14479,"_27672":56289,"_2966":56561},[],"`PUT` returns 404.",{"_3483":2237,"_30444":2136,"_21068":56563,"_5":14479,"_27672":56289,"_2966":56564},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3483":2238,"_30444":2136,"_21068":56566,"_5":14479,"_27672":56289,"_2966":56567},[],"Check the CA ID and the signer serial number.",{"_3483":2239,"_30444":2136,"_21068":56569,"_5":14479,"_27672":56289,"_2966":56570},[],"`PUT` returns 400 from a 3.x client.",{"_3483":2240,"_30444":2136,"_21068":56572,"_5":14479,"_27672":56289,"_2966":56573},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3483":2241,"_30444":2136,"_21068":56575,"_5":14479,"_27672":56289,"_2966":56576},[],"Update the client to send the new field.",{"_3483":2242,"_30444":2136,"_21068":56578,"_5":14479,"_27672":56289,"_2966":56579},[],"The CRL does not change after revoking a certificate.",{"_3483":2243,"_30444":2136,"_21068":56581,"_5":14479,"_27672":56289,"_2966":56582},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3483":2244,"_30444":2136,"_21068":56584,"_5":14479,"_27672":56289,"_2966":56585},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3483":2245,"_30444":2136,"_21068":56587,"_5":14479,"_27672":56289,"_2966":56588},[],"A verifier rejects the CRL because of the issuer.",{"_3483":2246,"_30444":2136,"_21068":56590,"_5":14479,"_27672":56289,"_2966":56591},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3483":2247,"_30444":2136,"_21068":56593,"_5":14479,"_27672":56289,"_2966":56594},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3483":2248,"_30444":2136,"_21068":56596,"_5":14479,"_27672":56293,"_2966":56597},[],"A CA’s CRL settings are edited in the **Validation Authority** tab of the CA view and on the console’s **Verification Authorities** page. Both read and update them by CA ID at `/v1/crl-settings/{ca-id}`, which requires a 4.0.0 backend.",{"_3483":2249,"_30444":2136,"_21068":56599,"_5":14479,"_27672":56293,"_2966":56600},[],"If the backend has no settings for a CA yet, the tab shows a **No CRL Settings** panel stating that CRL settings are created when the CA is and may still be initializing, with a **Retry** button. While the settings load, it shows &#x2A;*Loading CRL Settings...**; a failed fetch shows **Error Loading CRL Settings**, also with a **Retry** button. The 404 row of Common CRL settings errors lists when a CA can have no settings.",{"_3483":2250,"_30444":2136,"_21068":56602,"_5":14479,"_27672":56293,"_2966":56603},[],"Settings whose CA was deleted before the 4.0.0 upgrade are `ARCHIVED`: the interface shows them read-only inside a warning alert, and the Verification Authorities page marks the CA with an **Archived** badge. Their last CRL is still served but never regenerated, and the settings cannot be edited — see Cases in which the settings can no longer be edited. Settings migrated from the SKI-keyed model show a note with their legacy CRL URL `/crl/<legacy-ski>`, which still resolves to this CA’s list.",{"_3483":2251,"_30444":2136,"_21068":56605,"_5":14479,"_27672":56293,"_2966":56606},[],"The **CRL Refresh Interval** field accepts `0`. An info alert then explains that no new CRL is generated just because time has passed — one is only generated shortly before the current one expires — and, with **Regenerate CRL Immediately on Revocation** off, that revocations are not published until then. The Verification Authorities summary shows **Disabled** for a refresh interval of `0`; the semantics are described in Periodic and automatic regeneration. The **CRL Max Validity / Cache Duration** field still requires a positive duration and rejects `0`.",{"_3483":2252,"_30444":2136,"_21068":56608,"_5":14479,"_27672":56293,"_2966":56609},[],"Editing is forgiving: a field shows its error only after you leave it. **Save CRL Settings** is always clickable; if any field is invalid when you save, the interface marks all of them, shows the errors and focuses the first invalid field instead of keeping the button disabled.",{"_3483":2253,"_30444":2136,"_21068":56611,"_5":14479,"_27672":56293,"_2966":56612},[],"The selected signer appears as a card with its issuer (the full DN in a tooltip on hover and keyboard focus, and the issuer name links to its CA when its record is available), its expiry, key algorithm, usage chips and serial number, under the footer **CRL signer — Signs the CRLs of this CA**. The certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer’s certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`.",{"_3483":2254,"_30444":2136,"_21068":56614,"_5":14479,"_27672":56293,"_2966":56615},[],"The CA view lets you inspect and download the available list; the downloaded file is named `<ca-id>.crl`. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3483":2255,"_30444":2136,"_21068":56617,"_5":14479,"_27672":56297,"_2966":56618},[],"RFC 5280: X.509 and CRL profile.",{"_3483":2256,"_30444":2136,"_21068":56620,"_5":14479,"_27672":56297,"_2966":56621},[],"OpenSSL: openssl-crl.",{"_3483":2257,"_30444":2136,"_21068":56623,"_5":14479,"_27672":56297,"_2966":56624},[],"OpenSSL: openssl-verify.",{"_3483":2258,"_30444":2136,"_21068":56626,"_5":14479,"_27672":56297,"_2966":56627},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3483":2259,"_30444":2136,"_21068":56629,"_5":14479,"_27672":56297,"_2966":56630},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3483":2260,"_30444":2260,"_5":14831,"_2966":56632,"_30797":56633,"_21068":56634,"_27672":2260},"Keys and cryptographic engines",[49604,51079,55087,55088],[],{"_3483":2261,"_30444":2260,"_21068":56636,"_5":14479,"_27672":2260,"_2966":56637},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3483":2262,"_30444":2260,"_5":30794,"_21068":56639,"_27672":56640,"_2966":56641},[],"/docs/pr-preview/pr-65/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3483":2263,"_30444":2260,"_5":30794,"_21068":56643,"_27672":56644,"_2966":56645},[],"/docs/pr-preview/pr-65/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3483":2264,"_30444":2260,"_5":30794,"_21068":56647,"_27672":56648,"_2966":56649},[],"/docs/pr-preview/pr-65/platform/pki/key-management#file-system","File System",{"_3483":2265,"_30444":2260,"_5":30794,"_21068":56651,"_27672":56652,"_2966":56653},[],"/docs/pr-preview/pr-65/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3483":2266,"_30444":2260,"_5":30794,"_21068":56655,"_27672":56656,"_2966":56657},[],"/docs/pr-preview/pr-65/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3483":2267,"_30444":2260,"_5":30794,"_21068":56659,"_27672":56660,"_2966":56661},[],"/docs/pr-preview/pr-65/platform/pki/key-management#aws-kms","AWS KMS",{"_3483":2268,"_30444":2260,"_5":30794,"_21068":56663,"_27672":56664,"_2966":56665},[],"/docs/pr-preview/pr-65/platform/pki/key-management#pkcs11","PKCS#11",{"_3483":2269,"_30444":2260,"_5":30794,"_21068":56667,"_27672":56668,"_2966":56669},[],"/docs/pr-preview/pr-65/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3483":2270,"_30444":2260,"_5":30794,"_21068":56671,"_27672":56672,"_2966":56673},[],"/docs/pr-preview/pr-65/platform/pki/key-management#key-inventory","Key inventory",{"_3483":2271,"_30444":2260,"_5":30794,"_21068":56675,"_27672":56676,"_2966":56677},[],"/docs/pr-preview/pr-65/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3483":2272,"_30444":2260,"_5":30794,"_21068":56679,"_27672":56680,"_2966":56681},[],"/docs/pr-preview/pr-65/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3483":2273,"_30444":2260,"_5":30794,"_21068":56683,"_27672":56684,"_2966":56685},[],"/docs/pr-preview/pr-65/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3483":2274,"_30444":2260,"_5":30794,"_21068":56687,"_27672":56688,"_2966":56689},[],"/docs/pr-preview/pr-65/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3483":2275,"_30444":2260,"_5":30794,"_21068":56691,"_27672":56692,"_2966":56693},[],"/docs/pr-preview/pr-65/platform/pki/key-management#view-details","View details",{"_3483":2276,"_30444":2260,"_5":30794,"_21068":56695,"_27672":56696,"_2966":56697},[],"/docs/pr-preview/pr-65/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3483":2277,"_30444":2260,"_5":30794,"_21068":56699,"_27672":56700,"_2966":56701},[],"/docs/pr-preview/pr-65/platform/pki/key-management#sign","Sign",{"_3483":2278,"_30444":2260,"_5":30794,"_21068":56703,"_27672":56704,"_2966":56705},[],"/docs/pr-preview/pr-65/platform/pki/key-management#verify","Verify",{"_3483":2279,"_30444":2260,"_5":30794,"_21068":56707,"_27672":56708,"_2966":56709},[],"/docs/pr-preview/pr-65/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3483":2280,"_30444":2260,"_5":30794,"_21068":56711,"_27672":56712,"_2966":56713},[],"/docs/pr-preview/pr-65/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3483":2281,"_30444":2260,"_5":30794,"_21068":56715,"_27672":56716,"_2966":56717},[],"/docs/pr-preview/pr-65/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3483":2282,"_30444":2260,"_21068":56719,"_5":14479,"_27672":2260,"_2966":56720},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3483":2283,"_30444":2260,"_21068":56722,"_5":14479,"_27672":2260,"_2966":56723},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3483":2284,"_30444":2260,"_21068":56725,"_5":14479,"_27672":56640,"_2966":56726},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3483":2285,"_30444":2260,"_21068":56728,"_5":14479,"_27672":56640,"_2966":56729},[],"In practice, it lets you:",{"_3483":2286,"_30444":2260,"_21068":56731,"_5":14479,"_27672":56640,"_2966":56732},[],"Generate new key pairs from Lamassu IoT.",{"_3483":2287,"_30444":2260,"_21068":56734,"_5":14479,"_27672":56640,"_2966":56735},[],"Import keys created externally.",{"_3483":2288,"_30444":2260,"_21068":56737,"_5":14479,"_27672":56640,"_2966":56738},[],"Delegate custody and cryptographic operations to external engines.",{"_3483":2289,"_30444":2260,"_21068":56740,"_5":14479,"_27672":56640,"_2966":56741},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3483":2290,"_30444":2260,"_21068":56743,"_5":14479,"_27672":56644,"_2966":56744},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3483":2291,"_30444":2260,"_21068":56746,"_5":14479,"_27672":56644,"_2966":56747},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3483":2292,"_30444":2260,"_21068":56749,"_5":14479,"_27672":56644,"_2966":56750},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3483":2293,"_30444":2260,"_21068":56752,"_5":14479,"_27672":56648,"_2966":56753},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3483":2294,"_30444":2260,"_21068":56755,"_5":14479,"_27672":56652,"_2966":56756},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3483":2295,"_30444":2260,"_21068":56758,"_5":14479,"_27672":56652,"_2966":56759},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3483":2296,"_30444":2260,"_21068":56761,"_5":14479,"_27672":56656,"_2966":56762},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3483":2297,"_30444":2260,"_21068":56764,"_5":14479,"_27672":56660,"_2966":56765},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3483":2298,"_30444":2260,"_21068":56767,"_5":14479,"_27672":56664,"_2966":56768},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3483":2299,"_30444":2260,"_21068":56770,"_5":14479,"_27672":56668,"_2966":56771},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3483":2300,"_30444":2260,"_21068":56773,"_5":14479,"_27672":56668,"_2966":56774},[],"Lamassu shows the enabled engines in the console.",{"_3483":2301,"_30444":2260,"_21068":56776,"_5":14479,"_27672":56668,"_2966":56777},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3483":2302,"_30444":2260,"_21068":56779,"_5":14479,"_27672":56668,"_2966":56780},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3483":2303,"_30444":2260,"_21068":56782,"_5":14479,"_27672":56672,"_2966":56783},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3483":2304,"_30444":2260,"_21068":56785,"_5":14479,"_27672":56672,"_2966":56786},[],"The table includes the following fields:",{"_3483":2305,"_30444":2260,"_21068":56788,"_5":14479,"_27672":56672,"_2966":56789},[],"**Name**: descriptive name of the key.",{"_3483":2306,"_30444":2260,"_21068":56791,"_5":14479,"_27672":56672,"_2966":56792},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3483":2307,"_30444":2260,"_21068":56794,"_5":14479,"_27672":56672,"_2966":56795},[],"**Strength**: visual indicator of cryptographic strength.",{"_3483":2308,"_30444":2260,"_21068":56797,"_5":14479,"_27672":56672,"_2966":56798},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3483":2309,"_30444":2260,"_21068":56800,"_5":14479,"_27672":56672,"_2966":56801},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3483":2310,"_30444":2260,"_21068":56803,"_5":14479,"_27672":56672,"_2966":56804},[],"**Aliases**: alternative names associated with the key.",{"_3483":2311,"_30444":2260,"_21068":56806,"_5":14479,"_27672":56672,"_2966":56807},[],"**Tags**: labels for classification and search.",{"_3483":2312,"_30444":2260,"_21068":56809,"_5":14479,"_27672":56672,"_2966":56810},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3483":2313,"_30444":2260,"_21068":56812,"_5":14479,"_27672":56672,"_2966":56813},[],"From this view you also reach the most common actions:",{"_3483":2314,"_30444":2260,"_21068":56815,"_5":14479,"_27672":56672,"_2966":56816},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3483":2315,"_30444":2260,"_21068":56818,"_5":14479,"_27672":56672,"_2966":56819},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3483":2316,"_30444":2260,"_21068":56821,"_5":14479,"_27672":56672,"_2966":56822},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3483":2317,"_30444":2260,"_21068":56824,"_5":14479,"_27672":56672,"_2966":56825},[],"**Delete Key** to remove the key from the system.",{"_3483":2318,"_30444":2260,"_21068":56827,"_5":14479,"_27672":56676,"_2966":56828},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3483":2319,"_30444":2260,"_21068":56830,"_5":14479,"_27672":56680,"_2966":56831},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3483":2320,"_30444":2260,"_21068":56833,"_5":14479,"_27672":56680,"_2966":56834},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3483":2321,"_30444":2260,"_21068":56836,"_5":14479,"_27672":56680,"_2966":56837},[],"**Key Name**: unique and descriptive name.",{"_3483":2322,"_30444":2260,"_21068":56839,"_5":14479,"_27672":56680,"_2966":56840},[],"**Crypto Engine**: engine that will keep the key.",{"_3483":2323,"_30444":2260,"_21068":56842,"_5":14479,"_27672":56680,"_2966":56843},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3483":2324,"_30444":2260,"_21068":56845,"_5":14479,"_27672":56680,"_2966":56846},[],"**Tags**: metadata to classify the key.",{"_3483":2325,"_30444":2260,"_21068":56848,"_5":14479,"_27672":56680,"_2966":56849},[],"**Metadata**: additional information for advanced uses.",{"_3483":2326,"_30444":2260,"_21068":56851,"_5":14479,"_27672":56684,"_2966":56852},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3483":2327,"_30444":2260,"_21068":56854,"_5":14479,"_27672":56684,"_2966":56855},[],"When you have an exportable private key and the destination engine supports import.",{"_3483":2328,"_30444":2260,"_21068":56857,"_5":14479,"_27672":56684,"_2966":56858},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3483":2329,"_30444":2260,"_21068":56860,"_5":14479,"_27672":56684,"_2966":56861},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3483":2330,"_30444":2260,"_21068":56863,"_5":14479,"_27672":56684,"_2966":56864},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3483":2331,"_30444":2260,"_21068":56866,"_5":14479,"_27672":56684,"_2966":56867},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3483":2332,"_30444":2260,"_21068":56869,"_5":14479,"_27672":56684,"_2966":56870},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3483":2333,"_30444":2260,"_21068":56872,"_5":14479,"_27672":56684,"_2966":56873},[],"**Tags**: labels for organization and search.",{"_3483":2334,"_30444":2260,"_21068":56875,"_5":14479,"_27672":56684,"_2966":56876},[],"**Metadata**: additional optional information.",{"_3483":2335,"_30444":2260,"_21068":56878,"_5":14479,"_27672":56684,"_2966":56879},[],"**Private Key (PEM)**: private key in PEM format.",{"_3483":2336,"_30444":2260,"_21068":56881,"_5":14479,"_27672":56684,"_2966":56882},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3483":2337,"_30444":2260,"_21068":56884,"_5":14479,"_27672":56688,"_2966":56885},[],"Each registered key has a detail view and several operational actions.",{"_3483":2338,"_30444":2260,"_21068":56887,"_5":14479,"_27672":56692,"_2966":56888},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3483":2339,"_30444":2260,"_21068":56890,"_5":14479,"_27672":56692,"_2966":56891},[],"The **Overview** tab shows, among others, these fields:",{"_3483":2340,"_30444":2260,"_21068":56893,"_5":14479,"_27672":56692,"_2966":56894},[],"**Key Name**: descriptive name.",{"_3483":2341,"_30444":2260,"_21068":56896,"_5":14479,"_27672":56692,"_2966":56897},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3483":2342,"_30444":2260,"_21068":56899,"_5":14479,"_27672":56692,"_2966":56900},[],"**Tags**: associated labels.",{"_3483":2343,"_30444":2260,"_21068":56902,"_5":14479,"_27672":56692,"_2966":56903},[],"**Aliases**: alternative names.",{"_3483":2344,"_30444":2260,"_21068":56905,"_5":14479,"_27672":56692,"_2966":56906},[],"**Crypto Engine**: engine where the key resides.",{"_3483":2345,"_30444":2260,"_21068":56908,"_5":14479,"_27672":56692,"_2966":56909},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3483":2346,"_30444":2260,"_21068":56911,"_5":14479,"_27672":56692,"_2966":56912},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3483":2347,"_30444":2260,"_21068":56914,"_5":14479,"_27672":56692,"_2966":56915},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3483":2348,"_30444":2260,"_21068":56917,"_5":14479,"_27672":56696,"_2966":56918},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3483":2349,"_30444":2260,"_21068":56920,"_5":14479,"_27672":56696,"_2966":56921},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3483":2350,"_30444":2260,"_21068":56923,"_5":14479,"_27672":56696,"_2966":56924},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3483":2351,"_30444":2260,"_21068":56926,"_5":14479,"_27672":56700,"_2966":56927},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3483":2352,"_30444":2260,"_21068":56929,"_5":14479,"_27672":56700,"_2966":56930},[],"Main fields:",{"_3483":2353,"_30444":2260,"_21068":56932,"_5":14479,"_27672":56700,"_2966":56933},[],"**Algorithm**: signing algorithm available for the key type.",{"_3483":2354,"_30444":2260,"_21068":56935,"_5":14479,"_27672":56700,"_2966":56936},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3483":2355,"_30444":2260,"_21068":56938,"_5":14479,"_27672":56700,"_2966":56939},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3483":2356,"_30444":2260,"_21068":56941,"_5":14479,"_27672":56700,"_2966":56942},[],"**Message**: content to sign.",{"_3483":2357,"_30444":2260,"_21068":56944,"_5":14479,"_27672":56700,"_2966":56945},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3483":2358,"_30444":2260,"_21068":56947,"_5":14479,"_27672":56704,"_2966":56948},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3483":2359,"_30444":2260,"_21068":56950,"_5":14479,"_27672":56704,"_2966":56930},[],{"_3483":2360,"_30444":2260,"_21068":56952,"_5":14479,"_27672":56704,"_2966":56953},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3483":2361,"_30444":2260,"_21068":56955,"_5":14479,"_27672":56704,"_2966":56956},[],"**Message Type**: `Raw` or `Digest`.",{"_3483":2362,"_30444":2260,"_21068":56958,"_5":14479,"_27672":56704,"_2966":56959},[],"**Payload Encoding**: encoding of the message.",{"_3483":2363,"_30444":2260,"_21068":56961,"_5":14479,"_27672":56704,"_2966":56962},[],"**Message**: original message or hash.",{"_3483":2364,"_30444":2260,"_21068":56964,"_5":14479,"_27672":56704,"_2966":56965},[],"**Signature**: signature to check.",{"_3483":2365,"_30444":2260,"_21068":56967,"_5":14479,"_27672":56704,"_2966":56968},[],"**Result**: indicator of the validation result.",{"_3483":2366,"_30444":2260,"_21068":56970,"_5":14479,"_27672":56708,"_2966":56971},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3483":2367,"_30444":2260,"_21068":56973,"_5":14479,"_27672":56708,"_2966":56974},[],"This flow is useful for:",{"_3483":2368,"_30444":2260,"_21068":56976,"_5":14479,"_27672":56708,"_2966":56977},[],"Requesting certificates from an external CA.",{"_3483":2369,"_30444":2260,"_21068":56979,"_5":14479,"_27672":56708,"_2966":56980},[],"Renewing an identity while keeping the same key.",{"_3483":2370,"_30444":2260,"_21068":56982,"_5":14479,"_27672":56708,"_2966":56983},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3483":2371,"_30444":2260,"_21068":56985,"_5":14479,"_27672":56708,"_2966":56986},[],"**Common Name (CN)**: main name of the identity.",{"_3483":2372,"_30444":2260,"_21068":56988,"_5":14479,"_27672":56708,"_2966":56989},[],"**Organization (O)**: organization or company.",{"_3483":2373,"_30444":2260,"_21068":56991,"_5":14479,"_27672":56708,"_2966":56992},[],"**Organizational Unit (OU)**: department or unit.",{"_3483":2374,"_30444":2260,"_21068":56994,"_5":14479,"_27672":56708,"_2966":56995},[],"**Country (C)**: two-letter country code.",{"_3483":2375,"_30444":2260,"_21068":56997,"_5":14479,"_27672":56708,"_2966":56998},[],"**State / Province (ST)**: state or province.",{"_3483":2376,"_30444":2260,"_21068":57000,"_5":14479,"_27672":56708,"_2966":57001},[],"**Locality (L)**: city or locality.",{"_3483":2377,"_30444":2260,"_21068":57003,"_5":14479,"_27672":56708,"_2966":57004},[],"**Email Address**: contact email.",{"_3483":2378,"_30444":2260,"_21068":57006,"_5":14479,"_27672":56708,"_2966":57007},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3483":2379,"_30444":2260,"_21068":57009,"_5":14479,"_27672":56708,"_2966":57010},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3483":2380,"_30444":2260,"_21068":57012,"_5":14479,"_27672":56712,"_2966":57013},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3483":2381,"_30444":2260,"_21068":57015,"_5":14479,"_27672":56712,"_2966":57016},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3483":2382,"_30444":2260,"_21068":57018,"_5":14479,"_27672":56716,"_2966":57019},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3483":2383,"_30444":2260,"_21068":57021,"_5":14479,"_27672":56716,"_2966":57022},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3483":2384,"_30444":2384,"_5":14831,"_2966":57024,"_30797":57025,"_21068":57026,"_27672":2384},"Online validation with OCSP",[49604,51079,55087,55729],[],{"_3483":2385,"_30444":2384,"_21068":57028,"_5":14479,"_27672":2384,"_2966":57029},[],"Query signed status and verify the responder’s response.",{"_3483":2386,"_30444":2384,"_5":30794,"_21068":57031,"_27672":57032,"_2966":57033},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3483":2387,"_30444":2384,"_5":30794,"_21068":57035,"_27672":57036,"_2966":57037},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3483":2388,"_30444":2384,"_5":30794,"_21068":57039,"_27672":57040,"_2966":57041},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3483":2389,"_30444":2384,"_5":30794,"_21068":57043,"_27672":57044,"_2966":57045},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3483":2390,"_30444":2384,"_5":30794,"_21068":57047,"_27672":57048,"_2966":57049},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3483":2391,"_30444":2384,"_5":30794,"_21068":57051,"_27672":57052,"_2966":56298},[],"/docs/pr-preview/pr-65/platform/pki/ocsp#references",{"_3483":2392,"_30444":2384,"_21068":57054,"_5":14479,"_27672":2384,"_2966":57055},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3483":2393,"_30444":2384,"_21068":57057,"_5":14479,"_27672":57032,"_2966":57058},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3483":2394,"_30444":2384,"_21068":57060,"_5":14479,"_27672":57032,"_2966":57061},[],"Record status",{"_3483":2395,"_30444":2384,"_21068":57063,"_5":14479,"_27672":57032,"_2966":57064},[],"Signed response",{"_3483":2396,"_30444":2384,"_21068":57066,"_5":14479,"_27672":57032,"_2966":54224},[],{"_3483":2397,"_30444":2384,"_21068":57068,"_5":14479,"_27672":57032,"_2966":57069},[],"`Good`.",{"_3483":2398,"_30444":2384,"_21068":57071,"_5":14479,"_27672":57032,"_2966":54241},[],{"_3483":2399,"_30444":2384,"_21068":57073,"_5":14479,"_27672":57032,"_2966":57074},[],"`Revoked`, with revocation reason and timestamp.",{"_3483":2400,"_30444":2384,"_21068":57076,"_5":14479,"_27672":57032,"_2966":57077},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3483":2401,"_30444":2384,"_21068":57079,"_5":14479,"_27672":57032,"_2966":57080},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3483":2402,"_30444":2384,"_21068":57082,"_5":14479,"_27672":57032,"_2966":57083},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3483":2403,"_30444":2384,"_21068":57085,"_5":14479,"_27672":57032,"_2966":57086},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3483":2404,"_30444":2384,"_21068":57088,"_5":14479,"_27672":57032,"_2966":57089},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3483":2405,"_30444":2384,"_21068":57091,"_5":14479,"_27672":57036,"_2966":57092},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3483":2406,"_30444":2384,"_21068":57094,"_5":14479,"_27672":57036,"_2966":57095},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3483":2407,"_30444":2384,"_21068":57097,"_5":14479,"_27672":57040,"_2966":57098},[],"The service accepts:",{"_3483":2408,"_30444":2384,"_21068":57100,"_5":14479,"_27672":57040,"_2966":52852},[],{"_3483":2409,"_30444":2384,"_21068":57102,"_5":14479,"_27672":57040,"_2966":57103},[],"VA service path",{"_3483":2410,"_30444":2384,"_21068":57105,"_5":14479,"_27672":57040,"_2966":57106},[],"Format",{"_3483":2411,"_30444":2384,"_21068":57108,"_5":14479,"_27672":57040,"_2966":57109},[],"`POST`",{"_3483":2412,"_30444":2384,"_21068":57111,"_5":14479,"_27672":57040,"_2966":57112},[],"`/ocsp`",{"_3483":2413,"_30444":2384,"_21068":57114,"_5":14479,"_27672":57040,"_2966":57115},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3483":2414,"_30444":2384,"_21068":57117,"_5":14479,"_27672":57040,"_2966":56483},[],{"_3483":2415,"_30444":2384,"_21068":57119,"_5":14479,"_27672":57040,"_2966":57120},[],"`/ocsp/{ocsp_request}`",{"_3483":2416,"_30444":2384,"_21068":57122,"_5":14479,"_27672":57040,"_2966":57123},[],"DER request encoded using padded URL Base64.",{"_3483":2417,"_30444":2384,"_21068":57125,"_5":14479,"_27672":57040,"_2966":57126},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3483":2418,"_30444":2384,"_21068":57128,"_5":14479,"_27672":57044,"_2966":57129},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3483":2419,"_30444":2384,"_21068":57131,"_5":14479,"_27672":57044,"_2966":57132},[],"Generate the request:",{"_3483":2420,"_30444":2384,"_21068":57134,"_5":14479,"_27672":57044,"_2966":57135},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3483":2421,"_30444":2384,"_21068":57137,"_5":14479,"_27672":57044,"_2966":57138},[],"Replace the example URL with the inspected endpoint:",{"_3483":2422,"_30444":2384,"_21068":57140,"_5":14479,"_27672":57044,"_2966":57141},[],"Verify the returned DER:",{"_3483":2423,"_30444":2384,"_21068":57143,"_5":14479,"_27672":57044,"_2966":57144},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3483":2424,"_30444":2384,"_21068":57146,"_5":14479,"_27672":57048,"_2966":57147},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3483":2425,"_30444":2384,"_21068":57149,"_5":14479,"_27672":57048,"_2966":57150},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3483":2426,"_30444":2384,"_21068":57152,"_5":14479,"_27672":57052,"_2966":57153},[],"RFC 6960: OCSP.",{"_3483":2427,"_30444":2384,"_21068":57155,"_5":14479,"_27672":57052,"_2966":57156},[],"OpenSSL: openssl-ocsp.",{"_3483":2428,"_30444":2384,"_21068":57158,"_5":14479,"_27672":57052,"_2966":57159},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3483":2429,"_30444":2384,"_21068":57161,"_5":14479,"_27672":57052,"_2966":56630},[],{"_3483":2430,"_30444":2430,"_5":14831,"_2966":55087,"_30797":57163,"_21068":57164,"_27672":2430},[49604,51079,55087],[],{"_3483":2431,"_30444":2430,"_21068":57166,"_5":14479,"_27672":2430,"_2966":57167},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3483":2432,"_30444":2430,"_5":30794,"_21068":57169,"_27672":57170,"_2966":54399},[],"/docs/pr-preview/pr-65/platform/pki/overview#start-here",{"_3483":2433,"_30444":2430,"_5":30794,"_21068":57172,"_27672":57173,"_2966":57174},[],"/docs/pr-preview/pr-65/platform/pki/overview#what-you-need","What you need",{"_3483":2434,"_30444":2430,"_5":30794,"_21068":57176,"_27672":57177,"_2966":54931},[],"/docs/pr-preview/pr-65/platform/pki/overview#core-capabilities",{"_3483":2435,"_30444":2430,"_5":30794,"_21068":57179,"_27672":57180,"_2966":54935},[],"/docs/pr-preview/pr-65/platform/pki/overview#build-your-trust-hierarchy",{"_3483":2436,"_30444":2430,"_5":30794,"_21068":57182,"_27672":57183,"_2966":54939},[],"/docs/pr-preview/pr-65/platform/pki/overview#protect-cryptographic-keys",{"_3483":2437,"_30444":2430,"_5":30794,"_21068":57185,"_27672":57186,"_2966":54943},[],"/docs/pr-preview/pr-65/platform/pki/overview#issue-and-control-certificates",{"_3483":2438,"_30444":2430,"_5":30794,"_21068":57188,"_27672":57189,"_2966":54951},[],"/docs/pr-preview/pr-65/platform/pki/overview#publish-validation-status",{"_3483":2439,"_30444":2430,"_5":30794,"_21068":57191,"_27672":57192,"_2966":57193},[],"/docs/pr-preview/pr-65/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3483":2440,"_30444":2430,"_5":30794,"_21068":57195,"_27672":57196,"_2966":55896},[],"/docs/pr-preview/pr-65/platform/pki/overview#continue",{"_3483":2441,"_30444":2430,"_21068":57198,"_5":14479,"_27672":2430,"_2966":57199},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3483":2442,"_30444":2430,"_21068":57201,"_5":14479,"_27672":57170,"_2966":57202},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3483":2443,"_30444":2430,"_21068":57204,"_5":14479,"_27672":57170,"_2966":57205},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3483":2444,"_30444":2430,"_21068":57207,"_5":14479,"_27672":57173,"_2966":57208},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3483":2445,"_30444":2430,"_21068":57210,"_5":14479,"_27672":57173,"_2966":57211},[],"An available cryptographic engine to keep the authority's key.",{"_3483":2446,"_30444":2430,"_21068":57213,"_5":14479,"_27672":57173,"_2966":57214},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3483":2447,"_30444":2430,"_21068":57216,"_5":14479,"_27672":57173,"_2966":57217},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3483":2448,"_30444":2430,"_21068":57219,"_5":14479,"_27672":57173,"_2966":57220},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3483":2449,"_30444":2430,"_21068":57222,"_5":14479,"_27672":57180,"_2966":57223},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3483":2450,"_30444":2430,"_21068":57225,"_5":14479,"_27672":57183,"_2966":57226},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3483":2451,"_30444":2430,"_21068":57228,"_5":14479,"_27672":57186,"_2966":57229},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3483":2452,"_30444":2430,"_21068":57231,"_5":14479,"_27672":57189,"_2966":57232},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3483":2453,"_30444":2430,"_21068":57234,"_5":14479,"_27672":57192,"_2966":57235},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3483":2454,"_30444":2430,"_21068":57237,"_5":14479,"_27672":57192,"_2966":57238},[],"its subject and extensions identify the expected client;",{"_3483":2455,"_30444":2430,"_21068":57240,"_5":14479,"_27672":57192,"_2966":57241},[],"its public key matches the client's private key;",{"_3483":2456,"_30444":2430,"_21068":57243,"_5":14479,"_27672":57192,"_2966":57244},[],"its chain reaches a root trusted by the consumer;",{"_3483":2457,"_30444":2430,"_21068":57246,"_5":14479,"_27672":57192,"_2966":57247},[],"its dates and usages allow the operation;",{"_3483":2458,"_30444":2430,"_21068":57249,"_5":14479,"_27672":57192,"_2966":57250},[],"the consumer applies revocation checks and authorization.",{"_3483":2459,"_30444":2430,"_21068":57252,"_5":14479,"_27672":57192,"_2966":57253},[],"The issuance path includes the first independent checks.",{"_3483":2460,"_30444":2430,"_21068":57255,"_5":14479,"_27672":57196,"_2966":57256},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3483":2461,"_30444":2430,"_21068":57258,"_5":14479,"_27672":57196,"_2966":57259},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3483":2462,"_30444":2430,"_21068":57261,"_5":14479,"_27672":57196,"_2966":57262},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3483":2463,"_30444":2463,"_5":14831,"_2966":57264,"_30797":57265,"_21068":57266,"_27672":2463},"Create your first CA",[49604,51079,55087,54524],[],{"_3483":2464,"_30444":2463,"_21068":57268,"_5":14479,"_27672":2463,"_2966":57269},[],"Create an evaluation root and check its certificate before issuing.",{"_3483":2465,"_30444":2463,"_5":30794,"_21068":57271,"_27672":57272,"_2966":49614},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3483":2466,"_30444":2463,"_5":30794,"_21068":57274,"_27672":57275,"_2966":57276},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3483":2467,"_30444":2463,"_5":30794,"_21068":57278,"_27672":57279,"_2966":57280},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3483":2468,"_30444":2463,"_5":30794,"_21068":57282,"_27672":57283,"_2966":57284},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3483":2469,"_30444":2463,"_5":30794,"_21068":57286,"_27672":57287,"_2966":57288},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3483":2470,"_30444":2463,"_5":30794,"_21068":57290,"_27672":57291,"_2966":57292},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3483":2471,"_30444":2463,"_5":30794,"_21068":57294,"_27672":57295,"_2966":57296},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3483":2472,"_30444":2463,"_5":30794,"_21068":57298,"_27672":57299,"_2966":54781},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3483":2473,"_30444":2463,"_5":30794,"_21068":57301,"_27672":57302,"_2966":49638},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3483":2474,"_30444":2463,"_21068":57304,"_5":14479,"_27672":2463,"_2966":57305},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3483":2475,"_30444":2463,"_21068":57307,"_5":14479,"_27672":57272,"_2966":57308},[],"Console access and permission to create keys and authorities.",{"_3483":2476,"_30444":2463,"_21068":57310,"_5":14479,"_27672":57272,"_2966":57311},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3483":2477,"_30444":2463,"_21068":57313,"_5":14479,"_27672":57272,"_2966":57314},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3483":2478,"_30444":2463,"_21068":57316,"_5":14479,"_27672":57272,"_2966":57317},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3483":2479,"_30444":2463,"_21068":57319,"_5":14479,"_27672":57275,"_2966":57320},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3483":2480,"_30444":2463,"_21068":57322,"_5":14479,"_27672":57275,"_2966":57323},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3483":2481,"_30444":2463,"_21068":57325,"_5":14479,"_27672":57279,"_2966":57326},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3483":2482,"_30444":2463,"_21068":57328,"_5":14479,"_27672":57279,"_2966":57329},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3483":2483,"_30444":2463,"_21068":57331,"_5":14479,"_27672":57283,"_2966":57332},[],"Select **Root CA** and complete:",{"_3483":2484,"_30444":2463,"_21068":57334,"_5":14479,"_27672":57283,"_2966":57335},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3483":2485,"_30444":2463,"_21068":57337,"_5":14479,"_27672":57283,"_2966":57338},[],"**Subject**: organization and country details for your evaluation.",{"_3483":2486,"_30444":2463,"_21068":57340,"_5":14479,"_27672":57283,"_2966":57341},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3483":2487,"_30444":2463,"_21068":57343,"_5":14479,"_27672":57283,"_2966":57344},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3483":2488,"_30444":2463,"_21068":57346,"_5":14479,"_27672":57283,"_2966":57347},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3483":2489,"_30444":2463,"_21068":57349,"_5":14479,"_27672":57287,"_2966":57350},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3483":2490,"_30444":2463,"_21068":57352,"_5":14479,"_27672":57291,"_2966":57353},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3483":2491,"_30444":2463,"_21068":57355,"_5":14479,"_27672":57291,"_2966":57356},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3483":2492,"_30444":2463,"_21068":57358,"_5":14479,"_27672":57295,"_2966":57359},[],"Run from the directory where you saved `ca.pem`:",{"_3483":2493,"_30444":2463,"_21068":57361,"_5":14479,"_27672":57295,"_2966":57362},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3483":2494,"_30444":2463,"_21068":57364,"_5":14479,"_27672":57295,"_2966":57365},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3483":2495,"_30444":2463,"_21068":57367,"_5":14479,"_27672":57299,"_2966":57368},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3483":2496,"_30444":2463,"_21068":57370,"_5":14479,"_27672":57299,"_2966":57371},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3483":2497,"_30444":2463,"_21068":57373,"_5":14479,"_27672":57299,"_2966":57374},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3483":2498,"_30444":2463,"_21068":57376,"_5":14479,"_27672":57299,"_2966":57377},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3483":2499,"_30444":2463,"_21068":57379,"_5":14479,"_27672":57302,"_2966":57380},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3483":2500,"_30444":2500,"_5":14831,"_2966":57382,"_30797":57383,"_21068":57384,"_27672":2500},"Issue and verify a certificate",[49604,51079,55087,54524],[],{"_3483":2501,"_30444":2500,"_21068":57386,"_5":14479,"_27672":2500,"_2966":57387},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3483":2502,"_30444":2500,"_5":30794,"_21068":57389,"_27672":57390,"_2966":49614},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3483":2503,"_30444":2500,"_5":30794,"_21068":57392,"_27672":57393,"_2966":57394},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3483":2504,"_30444":2500,"_5":30794,"_21068":57396,"_27672":57397,"_2966":57398},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3483":2505,"_30444":2500,"_5":30794,"_21068":57400,"_27672":57401,"_2966":57402},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3483":2506,"_30444":2500,"_5":30794,"_21068":57404,"_27672":57405,"_2966":57406},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3483":2507,"_30444":2500,"_5":30794,"_21068":57408,"_27672":57409,"_2966":57410},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3483":2508,"_30444":2500,"_5":30794,"_21068":57412,"_27672":57413,"_2966":57414},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3483":2509,"_30444":2500,"_5":30794,"_21068":57416,"_27672":57417,"_2966":57418},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3483":2510,"_30444":2500,"_5":30794,"_21068":57420,"_27672":57421,"_2966":57422},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3483":2511,"_30444":2500,"_5":30794,"_21068":57424,"_27672":57425,"_2966":57426},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3483":2512,"_30444":2500,"_5":30794,"_21068":57428,"_27672":57429,"_2966":54781},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3483":2513,"_30444":2500,"_5":30794,"_21068":57431,"_27672":57432,"_2966":49638},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/issue-certificate#next-step",{"_3483":2514,"_30444":2500,"_21068":57434,"_5":14479,"_27672":2500,"_2966":57435},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3483":2515,"_30444":2500,"_21068":57437,"_5":14479,"_27672":57390,"_2966":57438},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3483":2516,"_30444":2500,"_21068":57440,"_5":14479,"_27672":57390,"_2966":57441},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3483":2517,"_30444":2500,"_21068":57443,"_5":14479,"_27672":57390,"_2966":57444},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3483":2518,"_30444":2500,"_21068":57446,"_5":14479,"_27672":57390,"_2966":57447},[],"A client identifier: here we use `device-001`.",{"_3483":2519,"_30444":2500,"_21068":57449,"_5":14479,"_27672":57390,"_2966":57450},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3483":2520,"_30444":2500,"_21068":57452,"_5":14479,"_27672":57393,"_2966":57453},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3483":2521,"_30444":2500,"_21068":57455,"_5":14479,"_27672":57397,"_2966":57456},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3483":2522,"_30444":2500,"_21068":57458,"_5":14479,"_27672":57397,"_2966":57459},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3483":2523,"_30444":2500,"_21068":57461,"_5":14479,"_27672":57401,"_2966":57462},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3483":2524,"_30444":2500,"_21068":57464,"_5":14479,"_27672":57401,"_2966":57465},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3483":2525,"_30444":2500,"_21068":57467,"_5":14479,"_27672":57405,"_2966":57468},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3483":2526,"_30444":2500,"_21068":57470,"_5":14479,"_27672":57405,"_2966":57471},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3483":2527,"_30444":2500,"_21068":57473,"_5":14479,"_27672":57409,"_2966":57474},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3483":2528,"_30444":2500,"_21068":57476,"_5":14479,"_27672":57413,"_2966":57477},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3483":2529,"_30444":2500,"_21068":57479,"_5":14479,"_27672":57417,"_2966":57480},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3483":2530,"_30444":2500,"_21068":57482,"_5":14479,"_27672":57421,"_2966":57483},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3483":2531,"_30444":2500,"_21068":57485,"_5":14479,"_27672":57421,"_2966":57486},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3483":2532,"_30444":2500,"_21068":57488,"_5":14479,"_27672":57421,"_2966":57489},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3483":2533,"_30444":2500,"_21068":57491,"_5":14479,"_27672":57425,"_2966":57492},[],"In Bash, compare the two public-key digests:",{"_3483":2534,"_30444":2500,"_21068":57494,"_5":14479,"_27672":57425,"_2966":57495},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3483":2535,"_30444":2500,"_21068":57497,"_5":14479,"_27672":57425,"_2966":57498},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3483":2536,"_30444":2500,"_21068":57500,"_5":14479,"_27672":57429,"_2966":54865},[],{"_3483":2537,"_30444":2500,"_21068":57502,"_5":14479,"_27672":57429,"_2966":57503},[],"What to review",{"_3483":2538,"_30444":2500,"_21068":57505,"_5":14479,"_27672":57429,"_2966":57506},[],"The CA rejects issuance",{"_3483":2539,"_30444":2500,"_21068":57508,"_5":14479,"_27672":57429,"_2966":57509},[],"Permissions, CA state and key, algorithm and profile.",{"_3483":2540,"_30444":2500,"_21068":57511,"_5":14479,"_27672":57429,"_2966":57512},[],"Different subject or usages",{"_3483":2541,"_30444":2500,"_21068":57514,"_5":14479,"_27672":57429,"_2966":57515},[],"Applied profile and requested values.",{"_3483":2542,"_30444":2500,"_21068":57517,"_5":14479,"_27672":57429,"_2966":57518},[],"Issuer cannot be found",{"_3483":2543,"_30444":2500,"_21068":57520,"_5":14479,"_27672":57429,"_2966":57521},[],"Downloaded CA and required intermediate chain.",{"_3483":2544,"_30444":2500,"_21068":57523,"_5":14479,"_27672":57429,"_2966":57524},[],"Validity fails",{"_3483":2545,"_30444":2500,"_21068":57526,"_5":14479,"_27672":57429,"_2966":57527},[],"Certificate and CA dates, and the computer's clock.",{"_3483":2546,"_30444":2500,"_21068":57529,"_5":14479,"_27672":57429,"_2966":57530},[],"Public-key digests differ",{"_3483":2547,"_30444":2500,"_21068":57532,"_5":14479,"_27672":57429,"_2966":57533},[],"Certificate and key files from the same issuance.",{"_3483":2548,"_30444":2500,"_21068":57535,"_5":14479,"_27672":57429,"_2966":57536},[],"See PKI diagnostics to narrow an issuance failure.",{"_3483":2549,"_30444":2500,"_21068":57538,"_5":14479,"_27672":57432,"_2966":57539},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3483":2550,"_30444":2500,"_21068":57541,"_5":14479,"_27672":57432,"_2966":57542},[],"Manage certificates for inspection, status and revocation.",{"_3483":2551,"_30444":2500,"_21068":57544,"_5":14479,"_27672":57432,"_2966":57545},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3483":2552,"_30444":2500,"_21068":57547,"_5":14479,"_27672":57432,"_2966":57548},[],"Prepare EST for the device to request its next identities.",{"_3483":2553,"_30444":2500,"_21068":57550,"_5":14479,"_27672":57432,"_2966":57551},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3483":2554,"_30444":2554,"_5":14831,"_2966":57553,"_30797":57554,"_21068":57555,"_27672":2554},"PKI getting started",[49604,51079,55087,54524],[],{"_3483":2555,"_30444":2554,"_21068":57557,"_5":14479,"_27672":2554,"_2966":57558},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3483":2556,"_30444":2554,"_5":30794,"_21068":57560,"_27672":57561,"_2966":49614},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/overview#before-you-begin",{"_3483":2557,"_30444":2554,"_5":30794,"_21068":57563,"_27672":57564,"_2966":57565},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3483":2558,"_30444":2554,"_5":30794,"_21068":57567,"_27672":57568,"_2966":54716},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/overview#expected-result",{"_3483":2559,"_30444":2554,"_5":30794,"_21068":57570,"_27672":57571,"_2966":57572},[],"/docs/pr-preview/pr-65/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3483":2560,"_30444":2554,"_21068":57574,"_5":14479,"_27672":2554,"_2966":57575},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3483":2561,"_30444":2554,"_21068":57577,"_5":14479,"_27672":57561,"_2966":57578},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3483":2562,"_30444":2554,"_21068":57580,"_5":14479,"_27672":57561,"_2966":57581},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3483":2563,"_30444":2554,"_21068":57583,"_5":14479,"_27672":57561,"_2966":57584},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3483":2564,"_30444":2554,"_21068":57586,"_5":14479,"_27672":57561,"_2966":57587},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3483":2565,"_30444":2554,"_21068":57589,"_5":14479,"_27672":57561,"_2966":57590},[],"A working directory with restricted access for the downloaded key.",{"_3483":2566,"_30444":2554,"_21068":57592,"_5":14479,"_27672":57564,"_2966":57593},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3483":2567,"_30444":2554,"_21068":57595,"_5":14479,"_27672":57564,"_2966":57596},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3483":2568,"_30444":2554,"_21068":57598,"_5":14479,"_27672":57564,"_2966":57599},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3483":2569,"_30444":2554,"_21068":57601,"_5":14479,"_27672":57564,"_2966":57602},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3483":2570,"_30444":2554,"_21068":57604,"_5":14479,"_27672":57568,"_2966":57605},[],"File or resource",{"_3483":2571,"_30444":2554,"_21068":57607,"_5":14479,"_27672":57568,"_2966":54713},[],{"_3483":2572,"_30444":2554,"_21068":57609,"_5":14479,"_27672":57568,"_2966":57610},[],"Active root CA and `ca.pem`",{"_3483":2573,"_30444":2554,"_21068":57612,"_5":14479,"_27672":57568,"_2966":57613},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3483":2574,"_30444":2554,"_21068":57615,"_5":14479,"_27672":57568,"_2966":57616},[],"End-entity certificate and `device.crt`",{"_3483":2575,"_30444":2554,"_21068":57618,"_5":14479,"_27672":57568,"_2966":57619},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3483":2576,"_30444":2554,"_21068":57621,"_5":14479,"_27672":57568,"_2966":57622},[],"Private key `device.key`",{"_3483":2577,"_30444":2554,"_21068":57624,"_5":14479,"_27672":57568,"_2966":57625},[],"Its public key matches the one included in `device.crt`.",{"_3483":2578,"_30444":2554,"_21068":57627,"_5":14479,"_27672":57568,"_2966":57628},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3483":2579,"_30444":2554,"_21068":57630,"_5":14479,"_27672":57571,"_2966":57631},[],"To operate certificates, continue with Certificates and Validation.",{"_3483":2580,"_30444":2554,"_21068":57633,"_5":14479,"_27672":57571,"_2966":57634},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3483":2581,"_30444":2554,"_21068":57636,"_5":14479,"_27672":57571,"_2966":57637},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3483":2582,"_30444":2582,"_5":14831,"_2966":57639,"_30797":57640,"_21068":57641,"_27672":2582},"PKI troubleshooting",[49604,51079,55087,53662],[],{"_3483":2583,"_30444":2582,"_21068":57643,"_5":14479,"_27672":2582,"_2966":57644},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3483":2584,"_30444":2582,"_5":30794,"_21068":57646,"_27672":57647,"_2966":57648},[],"/docs/pr-preview/pr-65/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3483":2585,"_30444":2582,"_5":30794,"_21068":57650,"_27672":57651,"_2966":57652},[],"/docs/pr-preview/pr-65/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3483":2586,"_30444":2582,"_5":30794,"_21068":57654,"_27672":57655,"_2966":57656},[],"/docs/pr-preview/pr-65/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3483":2587,"_30444":2582,"_21068":57658,"_5":14479,"_27672":2582,"_2966":57659},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3483":2588,"_30444":2582,"_21068":57661,"_5":14479,"_27672":2582,"_2966":57662},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3483":2589,"_30444":2582,"_21068":57664,"_5":14479,"_27672":57647,"_2966":54713},[],{"_3483":2590,"_30444":2582,"_21068":57666,"_5":14479,"_27672":57647,"_2966":57667},[],"What to inspect",{"_3483":2591,"_30444":2582,"_21068":57669,"_5":14479,"_27672":57647,"_2966":49638},[],{"_3483":2592,"_30444":2582,"_21068":57671,"_5":14479,"_27672":57647,"_2966":53929},[],{"_3483":2593,"_30444":2582,"_21068":57673,"_5":14479,"_27672":57647,"_2966":57674},[],"Exists, is active and has usable dates.",{"_3483":2594,"_30444":2582,"_21068":57676,"_5":14479,"_27672":57647,"_2966":57677},[],"Authorities.",{"_3483":2595,"_30444":2582,"_21068":57679,"_5":14479,"_27672":57647,"_2966":57680},[],"Key",{"_3483":2596,"_30444":2582,"_21068":57682,"_5":14479,"_27672":57647,"_2966":57683},[],"The record has a usable private key and the engine can sign.",{"_3483":2597,"_30444":2582,"_21068":57685,"_5":14479,"_27672":57647,"_2966":57686},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3483":2598,"_30444":2582,"_21068":57688,"_5":14479,"_27672":57647,"_2966":57689},[],"CSR",{"_3483":2599,"_30444":2582,"_21068":57691,"_5":14479,"_27672":57647,"_2966":57692},[],"Correct PEM and verifiable signature.",{"_3483":2600,"_30444":2582,"_21068":57694,"_5":14479,"_27672":57647,"_2966":57695},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3483":2601,"_30444":2582,"_21068":57697,"_5":14479,"_27672":57647,"_2966":57698},[],"Profile",{"_3483":2602,"_30444":2582,"_21068":57700,"_5":14479,"_27672":57647,"_2966":57701},[],"Selected source, existing ID, allowed algorithm and size.",{"_3483":2603,"_30444":2582,"_21068":57703,"_5":14479,"_27672":57647,"_2966":57704},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3483":2604,"_30444":2582,"_21068":57706,"_5":14479,"_27672":57647,"_2966":54865},[],{"_3483":2605,"_30444":2582,"_21068":57708,"_5":14479,"_27672":57647,"_2966":57709},[],"Appropriate subject, SAN, usages and dates.",{"_3483":2606,"_30444":2582,"_21068":57711,"_5":14479,"_27672":57647,"_2966":57712},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3483":2607,"_30444":2582,"_21068":57714,"_5":14479,"_27672":57647,"_2966":57715},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3483":2608,"_30444":2582,"_21068":57717,"_5":14479,"_27672":57647,"_2966":57718},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3483":2609,"_30444":2582,"_21068":57720,"_5":14479,"_27672":57651,"_2966":57721},[],"Check each boundary independently:",{"_3483":2610,"_30444":2582,"_21068":57723,"_5":14479,"_27672":57651,"_2966":57724},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3483":2611,"_30444":2582,"_21068":57726,"_5":14479,"_27672":57651,"_2966":57727},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3483":2612,"_30444":2582,"_21068":57729,"_5":14479,"_27672":57651,"_2966":57730},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3483":2613,"_30444":2582,"_21068":57732,"_5":14479,"_27672":57651,"_2966":57733},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3483":2614,"_30444":2582,"_21068":57735,"_5":14479,"_27672":57651,"_2966":57736},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3483":2615,"_30444":2582,"_21068":57738,"_5":14479,"_27672":57651,"_2966":57739},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3483":2616,"_30444":2582,"_21068":57741,"_5":14479,"_27672":57655,"_2966":57742},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3483":2617,"_30444":2582,"_21068":57744,"_5":14479,"_27672":57655,"_2966":57745},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3483":2618,"_30444":2618,"_5":14831,"_2966":57747,"_30797":57748,"_21068":57749,"_27672":2618},"Security",[49604],[],{"_3483":2619,"_30444":2618,"_21068":57751,"_5":14479,"_27672":2618,"_2966":57752},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3483":2620,"_30444":2618,"_5":30794,"_21068":57754,"_27672":57755,"_2966":57756},[],"/docs/pr-preview/pr-65/security#report-a-vulnerability","Report a vulnerability",{"_3483":2621,"_30444":2618,"_5":30794,"_21068":57758,"_27672":57759,"_2966":57760},[],"/docs/pr-preview/pr-65/security#what-to-include-in-a-report","What to include in a report",{"_3483":2622,"_30444":2618,"_5":30794,"_21068":57762,"_27672":57763,"_2966":57764},[],"/docs/pr-preview/pr-65/security#supported-versions","Supported versions",{"_3483":2623,"_30444":2618,"_5":30794,"_21068":57766,"_27672":57767,"_2966":57768},[],"/docs/pr-preview/pr-65/security#responsible-disclosure","Responsible disclosure",{"_3483":2624,"_30444":2618,"_21068":57770,"_5":14479,"_27672":2618,"_2966":57771},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3483":2625,"_30444":2618,"_21068":57773,"_5":14479,"_27672":57755,"_2966":57774},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3483":2626,"_30444":2618,"_21068":57776,"_5":14479,"_27672":57755,"_2966":57777},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3483":2627,"_30444":2618,"_21068":57779,"_5":14479,"_27672":57755,"_2966":15110},[],{"_3483":2628,"_30444":2618,"_21068":57781,"_5":14479,"_27672":57755,"_2966":15050},[],{"_3483":2629,"_30444":2618,"_21068":57783,"_5":14479,"_27672":57755,"_2966":15097},[],{"_3483":2630,"_30444":2618,"_21068":57785,"_5":14479,"_27672":57755,"_2966":57786},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3483":2631,"_30444":2618,"_21068":57788,"_5":14479,"_27672":57755,"_2966":57789},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3483":2632,"_30444":2618,"_21068":57791,"_5":14479,"_27672":57759,"_2966":57792},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3483":2633,"_30444":2618,"_21068":57794,"_5":14479,"_27672":57759,"_2966":57795},[],"Do not include in the report:",{"_3483":2634,"_30444":2618,"_21068":57797,"_5":14479,"_27672":57759,"_2966":57798},[],"Credentials, tokens, or private keys",{"_3483":2635,"_30444":2618,"_21068":57800,"_5":14479,"_27672":57759,"_2966":57801},[],"Customer data or customer-identifiable information",{"_3483":2636,"_30444":2618,"_21068":57803,"_5":14479,"_27672":57759,"_2966":57804},[],"Confidential architecture or internal infrastructure details",{"_3483":2637,"_30444":2618,"_21068":57806,"_5":14479,"_27672":57763,"_2966":57807},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3483":2638,"_30444":2618,"_21068":57809,"_5":14479,"_27672":57763,"_2966":57810},[],"For upgrade guidance, see Upgrades.",{"_3483":2639,"_30444":2618,"_21068":57812,"_5":14479,"_27672":57767,"_2966":57813},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3483":2640,"_30444":2618,"_21068":57815,"_5":14479,"_27672":57767,"_2966":57816},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3483":2641,"_30444":2618,"_21068":57818,"_5":14479,"_27672":57767,"_2966":57819},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3483":2642,"_30444":2618,"_21068":57821,"_5":14479,"_27672":57767,"_2966":57822},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3483":2643,"_30444":2618,"_21068":57824,"_5":14479,"_27672":57767,"_2966":57825},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3483":2644,"_30444":2644,"_5":14831,"_2966":57827,"_30797":57828,"_21068":57830,"_27672":2644},"3.8.0 to 4.0.0",[49604,57829],"Upgrades",[],{"_3483":2645,"_30444":2644,"_21068":57832,"_5":14479,"_27672":2644,"_2966":57833},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3483":2646,"_30444":2644,"_5":30794,"_21068":57835,"_27672":57836,"_2966":57837},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3483":2647,"_30444":2644,"_5":30794,"_21068":57839,"_27672":57840,"_2966":57841},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3483":2648,"_30444":2644,"_5":30794,"_21068":57843,"_27672":57844,"_2966":57845},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3483":2649,"_30444":2644,"_5":30794,"_21068":57847,"_27672":57848,"_2966":57849},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3483":2650,"_30444":2644,"_5":30794,"_21068":57851,"_27672":57852,"_2966":57853},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3483":2651,"_30444":2644,"_5":30794,"_21068":57855,"_27672":57856,"_2966":57857},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3483":2652,"_30444":2644,"_5":30794,"_21068":57859,"_27672":57860,"_2966":57861},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3483":2653,"_30444":2644,"_5":30794,"_21068":57863,"_27672":57864,"_2966":57865},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3483":2654,"_30444":2644,"_5":30794,"_21068":57867,"_27672":57868,"_2966":57869},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3483":2655,"_30444":2644,"_5":30794,"_21068":57871,"_27672":57872,"_2966":57873},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3483":2656,"_30444":2644,"_5":30794,"_21068":57875,"_27672":57876,"_2966":57877},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3483":2657,"_30444":2644,"_5":30794,"_21068":57879,"_27672":57880,"_2966":57881},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3483":2658,"_30444":2644,"_5":30794,"_21068":57883,"_27672":57884,"_2966":57885},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3483":2659,"_30444":2644,"_5":30794,"_21068":57887,"_27672":57888,"_2966":57889},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3483":2660,"_30444":2644,"_5":30794,"_21068":57891,"_27672":57892,"_2966":57893},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3483":2661,"_30444":2644,"_5":30794,"_21068":57895,"_27672":57896,"_2966":57897},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3483":2662,"_30444":2644,"_5":30794,"_21068":57899,"_27672":57900,"_2966":57901},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3483":2663,"_30444":2644,"_5":30794,"_21068":57903,"_27672":57904,"_2966":57905},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3483":2664,"_30444":2644,"_5":30794,"_21068":57907,"_27672":57908,"_2966":57909},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3483":2665,"_30444":2644,"_5":30794,"_21068":57911,"_27672":57912,"_2966":57913},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3483":2666,"_30444":2644,"_5":30794,"_21068":57915,"_27672":57916,"_2966":57917},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3483":2667,"_30444":2644,"_5":30794,"_21068":57919,"_27672":57920,"_2966":57921},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3483":2668,"_30444":2644,"_5":30794,"_21068":57923,"_27672":57924,"_2966":57925},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3483":2669,"_30444":2644,"_5":30794,"_21068":57927,"_27672":57928,"_2966":57929},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3483":2670,"_30444":2644,"_5":30794,"_21068":57931,"_27672":57932,"_2966":57933},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3483":2671,"_30444":2644,"_5":30794,"_21068":57935,"_27672":57936,"_2966":57937},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3483":2672,"_30444":2644,"_5":30794,"_21068":57939,"_27672":57940,"_2966":57941},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3483":2673,"_30444":2644,"_5":30794,"_21068":57943,"_27672":57944,"_2966":57945},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3483":2674,"_30444":2644,"_5":30794,"_21068":57947,"_27672":57948,"_2966":57949},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3483":2675,"_30444":2644,"_5":30794,"_21068":57951,"_27672":57952,"_2966":57953},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3483":2676,"_30444":2644,"_5":30794,"_21068":57955,"_27672":57956,"_2966":57957},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3483":2677,"_30444":2644,"_5":30794,"_21068":57959,"_27672":57960,"_2966":57961},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3483":2678,"_30444":2644,"_5":30794,"_21068":57963,"_27672":57964,"_2966":57965},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3483":2679,"_30444":2644,"_5":30794,"_21068":57967,"_27672":57968,"_2966":57969},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3483":2680,"_30444":2644,"_5":30794,"_21068":57971,"_27672":57972,"_2966":57973},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3483":2681,"_30444":2644,"_5":30794,"_21068":57975,"_27672":57976,"_2966":57977},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3483":2682,"_30444":2644,"_5":30794,"_21068":57979,"_27672":57980,"_2966":57981},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3483":2683,"_30444":2644,"_5":30794,"_21068":57983,"_27672":57984,"_2966":57985},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3483":2684,"_30444":2644,"_5":30794,"_21068":57987,"_27672":57988,"_2966":57989},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3483":2685,"_30444":2644,"_5":30794,"_21068":57991,"_27672":57992,"_2966":57993},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3483":2686,"_30444":2644,"_5":30794,"_21068":57995,"_27672":57996,"_2966":53662},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3483":2687,"_30444":2644,"_5":30794,"_21068":57998,"_27672":57999,"_2966":58000},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3483":2688,"_30444":2644,"_5":30794,"_21068":58002,"_27672":58003,"_2966":58004},[],"/docs/pr-preview/pr-65/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3483":2689,"_30444":2644,"_21068":58006,"_5":14479,"_27672":2644,"_2966":58007},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3483":2690,"_30444":2644,"_21068":58009,"_5":14479,"_27672":2644,"_2966":58010},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3483":2691,"_30444":2644,"_21068":58012,"_5":14479,"_27672":2644,"_2966":58013},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3483":2692,"_30444":2644,"_21068":58015,"_5":14479,"_27672":2644,"_2966":58016},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3483":2693,"_30444":2644,"_21068":58018,"_5":14479,"_27672":2644,"_2966":58019},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3483":2694,"_30444":2644,"_21068":58021,"_5":14479,"_27672":2644,"_2966":58022},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3483":2695,"_30444":2644,"_21068":58024,"_5":14479,"_27672":2644,"_2966":58025},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3483":2696,"_30444":2644,"_21068":58027,"_5":14479,"_27672":57840,"_2966":58028},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3483":2697,"_30444":2644,"_21068":58030,"_5":14479,"_27672":57840,"_2966":58031},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3483":2698,"_30444":2644,"_21068":58033,"_5":14479,"_27672":57844,"_2966":58034},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3483":2699,"_30444":2644,"_21068":58036,"_5":14479,"_27672":57844,"_2966":58037},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3483":2700,"_30444":2644,"_21068":58039,"_5":14479,"_27672":57848,"_2966":58040},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3483":2701,"_30444":2644,"_21068":58042,"_5":14479,"_27672":57852,"_2966":58043},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3483":2702,"_30444":2644,"_21068":58045,"_5":14479,"_27672":57852,"_2966":58046},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3483":2703,"_30444":2644,"_21068":58048,"_5":14479,"_27672":57852,"_2966":58049},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3483":2704,"_30444":2644,"_21068":58051,"_5":14479,"_27672":57852,"_2966":58052},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3483":2705,"_30444":2644,"_21068":58054,"_5":14479,"_27672":57852,"_2966":58055},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3483":2706,"_30444":2644,"_21068":58057,"_5":14479,"_27672":57856,"_2966":58058},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3483":2707,"_30444":2644,"_21068":58060,"_5":14479,"_27672":57856,"_2966":58061},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3483":2708,"_30444":2644,"_21068":58063,"_5":14479,"_27672":57856,"_2966":58064},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3483":2709,"_30444":2644,"_21068":58066,"_5":14479,"_27672":57856,"_2966":58067},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3483":2710,"_30444":2644,"_21068":58069,"_5":14479,"_27672":57856,"_2966":58070},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3483":2711,"_30444":2644,"_21068":58072,"_5":14479,"_27672":57856,"_2966":58073},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3483":2712,"_30444":2644,"_21068":58075,"_5":14479,"_27672":57860,"_2966":58076},[],"Change",{"_3483":2713,"_30444":2644,"_21068":58078,"_5":14479,"_27672":57860,"_2966":58079},[],"Who is affected",{"_3483":2714,"_30444":2644,"_21068":58081,"_5":14479,"_27672":57860,"_2966":58082},[],"Severity",{"_3483":2715,"_30444":2644,"_21068":58084,"_5":14479,"_27672":57860,"_2966":56531},[],{"_3483":2716,"_30444":2644,"_21068":58086,"_5":14479,"_27672":57860,"_2966":57869},[],{"_3483":2717,"_30444":2644,"_21068":58088,"_5":14479,"_27672":57860,"_2966":58089},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3483":2718,"_30444":2644,"_21068":58091,"_5":14479,"_27672":57860,"_2966":58092},[],"High: KMS and VA start on empty volumes",{"_3483":2719,"_30444":2644,"_21068":58094,"_5":14479,"_27672":57860,"_2966":58095},[],"Copy the data into the new volumes",{"_3483":2720,"_30444":2644,"_21068":58097,"_5":14479,"_27672":57860,"_2966":57873},[],{"_3483":2721,"_30444":2644,"_21068":58099,"_5":14479,"_27672":57860,"_2966":58100},[],"Every Helm release",{"_3483":2722,"_30444":2644,"_21068":58102,"_5":14479,"_27672":57860,"_2966":58103},[],"High: `helm upgrade` fails",{"_3483":2723,"_30444":2644,"_21068":58105,"_5":14479,"_27672":57860,"_2966":58106},[],"Remove or rename legacy keys",{"_3483":2724,"_30444":2644,"_21068":58108,"_5":14479,"_27672":57860,"_2966":57877},[],{"_3483":2725,"_30444":2644,"_21068":58110,"_5":14479,"_27672":57860,"_2966":58111},[],"Every deployment",{"_3483":2726,"_30444":2644,"_21068":58113,"_5":14479,"_27672":57860,"_2966":58114},[],"High: without a bootstrap principal there is no administrator",{"_3483":2727,"_30444":2644,"_21068":58116,"_5":14479,"_27672":57860,"_2966":58117},[],"Configure `services.authz`",{"_3483":2728,"_30444":2644,"_21068":58119,"_5":14479,"_27672":57860,"_2966":57881},[],{"_3483":2729,"_30444":2644,"_21068":58121,"_5":14479,"_27672":57860,"_2966":58100},[],{"_3483":2730,"_30444":2644,"_21068":58123,"_5":14479,"_27672":57860,"_2966":58124},[],"High: `helm upgrade` fails on the old keys",{"_3483":2731,"_30444":2644,"_21068":58126,"_5":14479,"_27672":57860,"_2966":58127},[],"Move JWKS and roles into `services.authz`",{"_3483":2732,"_30444":2644,"_21068":58129,"_5":14479,"_27672":57860,"_2966":57901},[],{"_3483":2733,"_30444":2644,"_21068":58131,"_5":14479,"_27672":57860,"_2966":58132},[],"3.8.0 deployments with per-service databases",{"_3483":2734,"_30444":2644,"_21068":58134,"_5":14479,"_27672":57860,"_2966":58135},[],"High: services find no data, or a migration aborts",{"_3483":2735,"_30444":2644,"_21068":58137,"_5":14479,"_27672":57860,"_2966":58138},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3483":2736,"_30444":2644,"_21068":58140,"_5":14479,"_27672":57860,"_2966":57905},[],{"_3483":2737,"_30444":2644,"_21068":58142,"_5":14479,"_27672":57860,"_2966":58143},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3483":2738,"_30444":2644,"_21068":58145,"_5":14479,"_27672":57860,"_2966":58146},[],"High: the backend no longer starts with them",{"_3483":2739,"_30444":2644,"_21068":58148,"_5":14479,"_27672":57860,"_2966":58149},[],"Move to PostgreSQL before upgrading",{"_3483":2740,"_30444":2644,"_21068":58151,"_5":14479,"_27672":57860,"_2966":57949},[],{"_3483":2741,"_30444":2644,"_21068":58153,"_5":14479,"_27672":57860,"_2966":58154},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3483":2742,"_30444":2644,"_21068":58156,"_5":14479,"_27672":57860,"_2966":58157},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3483":2743,"_30444":2644,"_21068":58159,"_5":14479,"_27672":57860,"_2966":58160},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3483":2744,"_30444":2644,"_21068":58162,"_5":14479,"_27672":57860,"_2966":58163},[],"Webhooks with file references",{"_3483":2745,"_30444":2644,"_21068":58165,"_5":14479,"_27672":57860,"_2966":58166},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3483":2746,"_30444":2644,"_21068":58168,"_5":14479,"_27672":57860,"_2966":58169},[],"High: enrollments calling the webhook fail",{"_3483":2747,"_30444":2644,"_21068":58171,"_5":14479,"_27672":57860,"_2966":58172},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3483":2748,"_30444":2644,"_21068":58174,"_5":14479,"_27672":57860,"_2966":57885},[],{"_3483":2749,"_30444":2644,"_21068":58176,"_5":14479,"_27672":57860,"_2966":58177},[],"Releases with per-service identity overrides or mounted key material",{"_3483":2750,"_30444":2644,"_21068":58179,"_5":14479,"_27672":57860,"_2966":58180},[],"Medium: services cannot read their files",{"_3483":2751,"_30444":2644,"_21068":58182,"_5":14479,"_27672":57860,"_2966":58183},[],"Remove the overrides and fix volume ownership",{"_3483":2752,"_30444":2644,"_21068":58185,"_5":14479,"_27672":57860,"_2966":57889},[],{"_3483":2753,"_30444":2644,"_21068":58187,"_5":14479,"_27672":57860,"_2966":58188},[],"Releases that set `amqp.tls`",{"_3483":2754,"_30444":2644,"_21068":58190,"_5":14479,"_27672":57860,"_2966":58191},[],"Medium: clients connect to the wrong port",{"_3483":2755,"_30444":2644,"_21068":58193,"_5":14479,"_27672":57860,"_2966":58194},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3483":2756,"_30444":2644,"_21068":58196,"_5":14479,"_27672":57860,"_2966":57909},[],{"_3483":2757,"_30444":2644,"_21068":58198,"_5":14479,"_27672":57860,"_2966":58199},[],"Installations whose CA keys predate the KMS",{"_3483":2758,"_30444":2644,"_21068":58201,"_5":14479,"_27672":57860,"_2966":58202},[],"Medium: CA keys stay unmanaged",{"_3483":2759,"_30444":2644,"_21068":58204,"_5":14479,"_27672":57860,"_2966":58205},[],"Run the CA-to-KMS migration",{"_3483":2760,"_30444":2644,"_21068":58207,"_5":14479,"_27672":57860,"_2966":58208},[],"Receiver certificate verification",{"_3483":2761,"_30444":2644,"_21068":58210,"_5":14479,"_27672":57860,"_2966":58211},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3483":2762,"_30444":2644,"_21068":58213,"_5":14479,"_27672":57860,"_2966":58214},[],"Medium: credentials go to an unverified receiver",{"_3483":2763,"_30444":2644,"_21068":58216,"_5":14479,"_27672":57860,"_2966":58217},[],"Set `insecure_skip_verify` to `false`",{"_3483":2764,"_30444":2644,"_21068":58219,"_5":14479,"_27672":57860,"_2966":57925},[],{"_3483":2765,"_30444":2644,"_21068":58221,"_5":14479,"_27672":57860,"_2966":58222},[],"Scripts and consoles that edit DMSs through the API",{"_3483":2766,"_30444":2644,"_21068":58224,"_5":14479,"_27672":57860,"_2966":58225},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3483":2767,"_30444":2644,"_21068":58227,"_5":14479,"_27672":57860,"_2966":58228},[],"Read the DMS before editing and use the new field",{"_3483":2768,"_30444":2644,"_21068":58230,"_5":14479,"_27672":57860,"_2966":57945},[],{"_3483":2769,"_30444":2644,"_21068":58232,"_5":14479,"_27672":57860,"_2966":58233},[],"Clients that create or update CRL settings through the API",{"_3483":2770,"_30444":2644,"_21068":58235,"_5":14479,"_27672":57860,"_2966":58236},[],"Medium: requests with the old field return an error",{"_3483":2771,"_30444":2644,"_21068":58238,"_5":14479,"_27672":57860,"_2966":58239},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3483":2772,"_30444":2644,"_21068":58241,"_5":14479,"_27672":57860,"_2966":57953},[],{"_3483":2773,"_30444":2644,"_21068":58243,"_5":14479,"_27672":57860,"_2966":58244},[],"Alert subscriptions and consumers of the VA events",{"_3483":2774,"_30444":2644,"_21068":58246,"_5":14479,"_27672":57860,"_2966":58247},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3483":2775,"_30444":2644,"_21068":58249,"_5":14479,"_27672":57860,"_2966":58250},[],"Review conditions filtering on the old event payload or subject",{"_3483":2776,"_30444":2644,"_21068":58252,"_5":14479,"_27672":57860,"_2966":57941},[],{"_3483":2777,"_30444":2644,"_21068":58254,"_5":14479,"_27672":57860,"_2966":58255},[],"Consumers that read the device `events` field",{"_3483":2778,"_30444":2644,"_21068":58257,"_5":14479,"_27672":57860,"_2966":58258},[],"Medium: the field disappears",{"_3483":2779,"_30444":2644,"_21068":58260,"_5":14479,"_27672":57860,"_2966":58261},[],"Use the new event endpoints",{"_3483":2780,"_30444":2644,"_21068":58263,"_5":14479,"_27672":57860,"_2966":57961},[],{"_3483":2781,"_30444":2644,"_21068":58265,"_5":14479,"_27672":57860,"_2966":58266},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3483":2782,"_30444":2644,"_21068":58268,"_5":14479,"_27672":57860,"_2966":58269},[],"Medium: the VA migration aborts",{"_3483":2783,"_30444":2644,"_21068":58271,"_5":14479,"_27672":57860,"_2966":58272},[],"Fix the affected roles before upgrading",{"_3483":2784,"_30444":2644,"_21068":58274,"_5":14479,"_27672":57860,"_2966":57893},[],{"_3483":2785,"_30444":2644,"_21068":58276,"_5":14479,"_27672":57860,"_2966":58277},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3483":2786,"_30444":2644,"_21068":58279,"_5":14479,"_27672":57860,"_2966":58280},[],"Low to medium: validation errors or changed defaults",{"_3483":2787,"_30444":2644,"_21068":58282,"_5":14479,"_27672":57860,"_2966":58283},[],"Update the values file",{"_3483":2788,"_30444":2644,"_21068":58285,"_5":14479,"_27672":57860,"_2966":57933},[],{"_3483":2789,"_30444":2644,"_21068":58287,"_5":14479,"_27672":57860,"_2966":58288},[],"Clients that send the DMS ID in the update body",{"_3483":2790,"_30444":2644,"_21068":58290,"_5":14479,"_27672":57860,"_2966":58291},[],"Low: the ID in the URL wins",{"_3483":2791,"_30444":2644,"_21068":58293,"_5":14479,"_27672":57860,"_2966":58294},[],"Send the ID in the URL",{"_3483":2792,"_30444":2644,"_21068":58296,"_5":14479,"_27672":57860,"_2966":57957},[],{"_3483":2793,"_30444":2644,"_21068":58298,"_5":14479,"_27672":57860,"_2966":58299},[],"Clients that send an `id` when creating or importing CAs",{"_3483":2794,"_30444":2644,"_21068":58301,"_5":14479,"_27672":57860,"_2966":58302},[],"Low: the ID in the body is ignored, and the field is removed",{"_3483":2795,"_30444":2644,"_21068":58304,"_5":14479,"_27672":57860,"_2966":58305},[],"Let the backend assign the ID and use the returned one",{"_3483":2796,"_30444":2644,"_21068":58307,"_5":14479,"_27672":57860,"_2966":57937},[],{"_3483":2797,"_30444":2644,"_21068":58309,"_5":14479,"_27672":57860,"_2966":58310},[],"Consumers that match on certificate `type`",{"_3483":2798,"_30444":2644,"_21068":58312,"_5":14479,"_27672":57860,"_2966":58313},[],"Low: two values are renamed",{"_3483":2799,"_30444":2644,"_21068":58315,"_5":14479,"_27672":57860,"_2966":58316},[],"Adapt consumers",{"_3483":2800,"_30444":2644,"_21068":58318,"_5":14479,"_27672":57860,"_2966":57929},[],{"_3483":2801,"_30444":2644,"_21068":58320,"_5":14479,"_27672":57860,"_2966":58321},[],"Any DMS",{"_3483":2802,"_30444":2644,"_21068":58323,"_5":14479,"_27672":57860,"_2966":58324},[],"Low: informational",{"_3483":2803,"_30444":2644,"_21068":58326,"_5":14479,"_27672":57860,"_2966":58327},[],"Read both blocks before editing",{"_3483":2804,"_30444":2644,"_21068":58329,"_5":14479,"_27672":57868,"_2966":58330},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3483":2805,"_30444":2644,"_21068":58332,"_5":14479,"_27672":57868,"_2966":58333},[],"Step 4 of the migration guide copies the data.",{"_3483":2806,"_30444":2644,"_21068":58335,"_5":14479,"_27672":57872,"_2966":58336},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3483":2807,"_30444":2644,"_21068":58338,"_5":14479,"_27672":57876,"_2966":58339},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3483":2808,"_30444":2644,"_21068":58341,"_5":14479,"_27672":57880,"_2966":58342},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3483":2809,"_30444":2644,"_21068":58344,"_5":14479,"_27672":57884,"_2966":58345},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3483":2810,"_30444":2644,"_21068":58347,"_5":14479,"_27672":57884,"_2966":58348},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3483":2811,"_30444":2644,"_21068":58350,"_5":14479,"_27672":57888,"_2966":58351},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3483":2812,"_30444":2644,"_21068":58353,"_5":14479,"_27672":57892,"_2966":58354},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3483":2813,"_30444":2644,"_21068":58356,"_5":14479,"_27672":57892,"_2966":58357},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3483":2814,"_30444":2644,"_21068":58359,"_5":14479,"_27672":57892,"_2966":58360},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3483":2815,"_30444":2644,"_21068":58362,"_5":14479,"_27672":57892,"_2966":58363},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3483":2816,"_30444":2644,"_21068":58365,"_5":14479,"_27672":57892,"_2966":58366},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3483":2817,"_30444":2644,"_21068":58368,"_5":14479,"_27672":57892,"_2966":58369},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3483":2818,"_30444":2644,"_21068":58371,"_5":14479,"_27672":57900,"_2966":58372},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3483":2819,"_30444":2644,"_21068":58374,"_5":14479,"_27672":57900,"_2966":58375},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3483":2820,"_30444":2644,"_21068":58377,"_5":14479,"_27672":57900,"_2966":58378},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3483":2821,"_30444":2644,"_21068":58380,"_5":14479,"_27672":57900,"_2966":58381},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3483":2822,"_30444":2644,"_21068":58383,"_5":14479,"_27672":57900,"_2966":58384},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3483":2823,"_30444":2644,"_21068":58386,"_5":14479,"_27672":57904,"_2966":58387},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3483":2824,"_30444":2644,"_21068":58389,"_5":14479,"_27672":57908,"_2966":58390},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3483":2825,"_30444":2644,"_21068":58392,"_5":14479,"_27672":57908,"_2966":58393},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3483":2826,"_30444":2644,"_21068":58395,"_5":14479,"_27672":57908,"_2966":58396},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3483":2827,"_30444":2644,"_21068":58398,"_5":14479,"_27672":57908,"_2966":58399},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3483":2828,"_30444":2644,"_21068":58401,"_5":14479,"_27672":57908,"_2966":58402},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3483":2829,"_30444":2644,"_21068":58404,"_5":14479,"_27672":57908,"_2966":58405},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3483":2830,"_30444":2644,"_21068":58407,"_5":14479,"_27672":57908,"_2966":58408},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3483":2831,"_30444":2644,"_21068":58410,"_5":14479,"_27672":57908,"_2966":58411},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3483":2832,"_30444":2644,"_21068":58413,"_5":14479,"_27672":57912,"_2966":58414},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3483":2833,"_30444":2644,"_21068":58416,"_5":14479,"_27672":57920,"_2966":58417},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3483":2834,"_30444":2644,"_21068":58419,"_5":14479,"_27672":57920,"_2966":58420},[],"Field in 3.8.0",{"_3483":2835,"_30444":2644,"_21068":58422,"_5":14479,"_27672":57920,"_2966":58423},[],"Field in 4.0.0",{"_3483":2836,"_30444":2644,"_21068":58425,"_5":14479,"_27672":57920,"_2966":58426},[],"`validate_server_cert`",{"_3483":2837,"_30444":2644,"_21068":58428,"_5":14479,"_27672":57920,"_2966":58429},[],"`insecure_skip_verify` (value negated)",{"_3483":2838,"_30444":2644,"_21068":58431,"_5":14479,"_27672":57920,"_2966":58432},[],"`oidc`",{"_3483":2839,"_30444":2644,"_21068":58434,"_5":14479,"_27672":57920,"_2966":58435},[],"`jwt_options`",{"_3483":2840,"_30444":2644,"_21068":58437,"_5":14479,"_27672":57920,"_2966":58438},[],"`apikey`",{"_3483":2841,"_30444":2644,"_21068":58440,"_5":14479,"_27672":57920,"_2966":58441},[],"`apikey_options`",{"_3483":2842,"_30444":2644,"_21068":58443,"_5":14479,"_27672":57920,"_2966":58444},[],"`mtls`",{"_3483":2843,"_30444":2644,"_21068":58446,"_5":14479,"_27672":57920,"_2966":58447},[],"`mtls_options`",{"_3483":2844,"_30444":2644,"_21068":58449,"_5":14479,"_27672":57920,"_2966":58450},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3483":2845,"_30444":2644,"_21068":58452,"_5":14479,"_27672":57920,"_2966":58453},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3483":2846,"_30444":2644,"_21068":58455,"_5":14479,"_27672":57920,"_2966":58456},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3483":2847,"_30444":2644,"_21068":58458,"_5":14479,"_27672":57924,"_2966":58459},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3483":2848,"_30444":2644,"_21068":58461,"_5":14479,"_27672":57924,"_2966":58462},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3483":2849,"_30444":2644,"_21068":58464,"_5":14479,"_27672":57924,"_2966":58465},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3483":2850,"_30444":2644,"_21068":58467,"_5":14479,"_27672":57928,"_2966":58468},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3483":2851,"_30444":2644,"_21068":58470,"_5":14479,"_27672":57932,"_2966":58471},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3483":2852,"_30444":2644,"_21068":58473,"_5":14479,"_27672":57936,"_2966":58474},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3483":2853,"_30444":2644,"_21068":58476,"_5":14479,"_27672":57940,"_2966":58477},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3483":2854,"_30444":2644,"_21068":58479,"_5":14479,"_27672":57940,"_2966":58480},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3483":2855,"_30444":2644,"_21068":58482,"_5":14479,"_27672":57940,"_2966":58483},[],"`POST /v1/devices/:id/events` creates an event.",{"_3483":2856,"_30444":2644,"_21068":58485,"_5":14479,"_27672":57940,"_2966":58486},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3483":2857,"_30444":2644,"_21068":58488,"_5":14479,"_27672":57944,"_2966":58489},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3483":2858,"_30444":2644,"_21068":58491,"_5":14479,"_27672":57948,"_2966":58492},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3483":2859,"_30444":2644,"_21068":58494,"_5":14479,"_27672":57948,"_2966":58495},[],"Route",{"_3483":2860,"_30444":2644,"_21068":58497,"_5":14479,"_27672":57948,"_2966":52849},[],{"_3483":2861,"_30444":2644,"_21068":58499,"_5":14479,"_27672":57948,"_2966":58500},[],"`GET /v1/crl-settings`",{"_3483":2862,"_30444":2644,"_21068":58502,"_5":14479,"_27672":57948,"_2966":58503},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3483":2863,"_30444":2644,"_21068":58505,"_5":14479,"_27672":57948,"_2966":58506},[],"`GET /v1/crl-settings/{ca-id}`",{"_3483":2864,"_30444":2644,"_21068":58508,"_5":14479,"_27672":57948,"_2966":58509},[],"Reads the settings of a CA.",{"_3483":2865,"_30444":2644,"_21068":58511,"_5":14479,"_27672":57948,"_2966":58512},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3483":2866,"_30444":2644,"_21068":58514,"_5":14479,"_27672":57948,"_2966":58515},[],"Replaces `crl_options`.",{"_3483":2867,"_30444":2644,"_21068":58517,"_5":14479,"_27672":57948,"_2966":58518},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3483":2868,"_30444":2644,"_21068":58520,"_5":14479,"_27672":57948,"_2966":58521},[],"Removes the archived settings of a CA.",{"_3483":2869,"_30444":2644,"_21068":58523,"_5":14479,"_27672":57948,"_2966":58524},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3483":2870,"_30444":2644,"_21068":58526,"_5":14479,"_27672":57948,"_2966":58527},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3483":2871,"_30444":2644,"_21068":58529,"_5":14479,"_27672":57948,"_2966":58530},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3483":2872,"_30444":2644,"_21068":58532,"_5":14479,"_27672":57948,"_2966":58533},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3483":2873,"_30444":2644,"_21068":58535,"_5":14479,"_27672":57948,"_2966":58536},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3483":2874,"_30444":2644,"_21068":58538,"_5":14479,"_27672":57948,"_2966":58539},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3483":2875,"_30444":2644,"_21068":58541,"_5":14479,"_27672":57948,"_2966":58542},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3483":2876,"_30444":2644,"_21068":58544,"_5":14479,"_27672":57948,"_2966":58545},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3483":2877,"_30444":2644,"_21068":58547,"_5":14479,"_27672":57948,"_2966":58548},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3483":2878,"_30444":2644,"_21068":58550,"_5":14479,"_27672":57948,"_2966":58551},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3483":2879,"_30444":2644,"_21068":58553,"_5":14479,"_27672":57948,"_2966":58554},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3483":2880,"_30444":2644,"_21068":58556,"_5":14479,"_27672":57952,"_2966":58557},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3483":2881,"_30444":2644,"_21068":58559,"_5":14479,"_27672":57956,"_2966":58560},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3483":2882,"_30444":2644,"_21068":58562,"_5":14479,"_27672":57960,"_2966":58563},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3483":2883,"_30444":2644,"_21068":58565,"_5":14479,"_27672":57964,"_2966":58566},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3483":2884,"_30444":2644,"_21068":58568,"_5":14479,"_27672":57968,"_2966":58569},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3483":2885,"_30444":2644,"_21068":58571,"_5":14479,"_27672":57968,"_2966":58572},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3483":2886,"_30444":2644,"_21068":58574,"_5":14479,"_27672":57968,"_2966":58575},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3483":2887,"_30444":2644,"_21068":58577,"_5":14479,"_27672":57968,"_2966":58578},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3483":2888,"_30444":2644,"_21068":58580,"_5":14479,"_27672":57968,"_2966":58581},[],"Record the names of your local-storage PVCs:",{"_3483":2889,"_30444":2644,"_21068":58583,"_5":14479,"_27672":57968,"_2966":58584},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3483":2890,"_30444":2644,"_21068":58586,"_5":14479,"_27672":57972,"_2966":58587},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3483":2891,"_30444":2644,"_21068":58589,"_5":14479,"_27672":57972,"_2966":58590},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3483":2892,"_30444":2644,"_21068":58592,"_5":14479,"_27672":57972,"_2966":58593},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3483":2893,"_30444":2644,"_21068":58595,"_5":14479,"_27672":57972,"_2966":58596},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3483":2894,"_30444":2644,"_21068":58598,"_5":14479,"_27672":57972,"_2966":58599},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3483":2895,"_30444":2644,"_21068":58601,"_5":14479,"_27672":57976,"_2966":58602},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3483":2896,"_30444":2644,"_21068":58604,"_5":14479,"_27672":57976,"_2966":58605},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3483":2897,"_30444":2644,"_21068":58607,"_5":14479,"_27672":57976,"_2966":58608},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3483":2898,"_30444":2644,"_21068":58610,"_5":14479,"_27672":57976,"_2966":58611},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3483":2899,"_30444":2644,"_21068":58613,"_5":14479,"_27672":57976,"_2966":58614},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3483":2900,"_30444":2644,"_21068":58616,"_5":14479,"_27672":57976,"_2966":58617},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3483":2901,"_30444":2644,"_21068":58619,"_5":14479,"_27672":57976,"_2966":58620},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3483":2902,"_30444":2644,"_21068":58622,"_5":14479,"_27672":57976,"_2966":58623},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3483":2903,"_30444":2644,"_21068":58625,"_5":14479,"_27672":57976,"_2966":58626},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3483":2904,"_30444":2644,"_21068":58628,"_5":14479,"_27672":57976,"_2966":58629},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3483":2905,"_30444":2644,"_21068":58631,"_5":14479,"_27672":57976,"_2966":58632},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3483":2906,"_30444":2644,"_21068":58634,"_5":14479,"_27672":57976,"_2966":58635},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3483":2907,"_30444":2644,"_21068":58637,"_5":14479,"_27672":57980,"_2966":58638},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3483":2908,"_30444":2644,"_21068":58640,"_5":14479,"_27672":57980,"_2966":58641},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3483":2909,"_30444":2644,"_21068":58643,"_5":14479,"_27672":57984,"_2966":58644},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3483":2910,"_30444":2644,"_21068":58646,"_5":14479,"_27672":57984,"_2966":58647},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3483":2911,"_30444":2644,"_21068":58649,"_5":14479,"_27672":57984,"_2966":58650},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3483":2912,"_30444":2644,"_21068":58652,"_5":14479,"_27672":57984,"_2966":58653},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3483":2913,"_30444":2644,"_21068":58655,"_5":14479,"_27672":57984,"_2966":58656},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3483":2914,"_30444":2644,"_21068":58658,"_5":14479,"_27672":57984,"_2966":58659},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3483":2915,"_30444":2644,"_21068":58661,"_5":14479,"_27672":57984,"_2966":58662},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3483":2916,"_30444":2644,"_21068":58664,"_5":14479,"_27672":57984,"_2966":58665},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3483":2917,"_30444":2644,"_21068":58667,"_5":14479,"_27672":57984,"_2966":58668},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3483":2918,"_30444":2644,"_21068":58670,"_5":14479,"_27672":57984,"_2966":58671},[],"**Remove the helper and restore the recorded replica counts:**",{"_3483":2919,"_30444":2644,"_21068":58673,"_5":14479,"_27672":57984,"_2966":58674},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3483":2920,"_30444":2644,"_21068":58676,"_5":14479,"_27672":57988,"_2966":58677},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3483":2921,"_30444":2644,"_21068":58679,"_5":14479,"_27672":57988,"_2966":58680},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3483":2922,"_30444":2644,"_21068":58682,"_5":14479,"_27672":57992,"_2966":58683},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3483":2923,"_30444":2644,"_21068":58685,"_5":14479,"_27672":57992,"_2966":58686},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3483":2924,"_30444":2644,"_21068":58688,"_5":14479,"_27672":57992,"_2966":58689},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3483":2925,"_30444":2644,"_21068":58691,"_5":14479,"_27672":57992,"_2966":58692},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3483":2926,"_30444":2644,"_21068":58694,"_5":14479,"_27672":57992,"_2966":58695},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3483":2927,"_30444":2644,"_21068":58697,"_5":14479,"_27672":57992,"_2966":58698},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3483":2928,"_30444":2644,"_21068":58700,"_5":14479,"_27672":57992,"_2966":58701},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3483":2929,"_30444":2644,"_21068":58703,"_5":14479,"_27672":57992,"_2966":58704},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3483":2930,"_30444":2644,"_21068":58706,"_5":14479,"_27672":57996,"_2966":58707},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3483":2931,"_30444":2644,"_21068":58709,"_5":14479,"_27672":57996,"_2966":58710},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3483":2932,"_30444":2644,"_21068":58712,"_5":14479,"_27672":57996,"_2966":58713},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3483":2933,"_30444":2644,"_21068":58715,"_5":14479,"_27672":57996,"_2966":58716},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3483":2934,"_30444":2644,"_21068":58718,"_5":14479,"_27672":57996,"_2966":58719},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3483":2935,"_30444":2644,"_21068":58721,"_5":14479,"_27672":57996,"_2966":58722},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3483":2936,"_30444":2644,"_21068":58724,"_5":14479,"_27672":57996,"_2966":58725},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3483":2937,"_30444":2644,"_21068":58727,"_5":14479,"_27672":57996,"_2966":58728},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3483":2938,"_30444":2644,"_21068":58730,"_5":14479,"_27672":57996,"_2966":58731},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3483":2939,"_30444":2644,"_21068":58733,"_5":14479,"_27672":57996,"_2966":58734},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3483":2940,"_30444":2644,"_21068":58736,"_5":14479,"_27672":57996,"_2966":58737},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3483":2941,"_30444":2644,"_21068":58739,"_5":14479,"_27672":57999,"_2966":58740},[],"After the upgrade, check in this order:",{"_3483":2942,"_30444":2644,"_21068":58742,"_5":14479,"_27672":57999,"_2966":58743},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3483":2943,"_30444":2644,"_21068":58745,"_5":14479,"_27672":57999,"_2966":58746},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3483":2944,"_30444":2644,"_21068":58748,"_5":14479,"_27672":57999,"_2966":58749},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3483":2945,"_30444":2644,"_21068":58751,"_5":14479,"_27672":57999,"_2966":58752},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3483":2946,"_30444":2644,"_21068":58754,"_5":14479,"_27672":57999,"_2966":58755},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3483":2947,"_30444":2644,"_21068":58757,"_5":14479,"_27672":57999,"_2966":58758},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3483":2948,"_30444":2644,"_21068":58760,"_5":14479,"_27672":57999,"_2966":58761},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3483":2949,"_30444":2644,"_21068":58763,"_5":14479,"_27672":57999,"_2966":58764},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3483":2950,"_30444":2644,"_21068":58766,"_5":14479,"_27672":57999,"_2966":58767},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3483":2951,"_30444":2644,"_21068":58769,"_5":14479,"_27672":57999,"_2966":58770},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3483":2952,"_30444":2644,"_21068":58772,"_5":14479,"_27672":57999,"_2966":58773},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3483":2953,"_30444":2644,"_21068":58775,"_5":14479,"_27672":57999,"_2966":58776},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3483":2954,"_30444":2644,"_21068":58778,"_5":14479,"_27672":57999,"_2966":58779},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3483":2955,"_30444":2644,"_21068":58781,"_5":14479,"_27672":57999,"_2966":58782},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3483":2956,"_30444":2644,"_21068":58784,"_5":14479,"_27672":57999,"_2966":58785},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3483":2957,"_30444":2644,"_21068":58787,"_5":14479,"_27672":58003,"_2966":58788},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3483":2958,"_30444":2644,"_21068":58790,"_5":14479,"_27672":58003,"_2966":58791},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3483":2959,"_30444":2644,"_21068":58793,"_5":14479,"_27672":58003,"_2966":58794},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3483":2960,"_30444":2644,"_21068":58796,"_5":14479,"_27672":58003,"_2966":58797},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3483":2961,"_30444":2644,"_21068":58799,"_5":14479,"_27672":58003,"_2966":58800},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58803":58804,"_58805":58806,"_58807":58808,"_58809":58810,"_18268":3001,"_70612":3001},"language","english","sortableProperties",[2966,30444,5,27672],"sortablePropertiesWithTypes",{"_2966":25195,"_30444":25195,"_5":25195,"_27672":25195},"sorts",{"_2966":58811,"_30444":61762,"_5":64712,"_27672":67662},{"_4679":58812,"_58813":58814,"_5":25195},{"_14555":7648,"_14942":26893,"_14961":3222,"_29447":14755,"_14948":15942,"_19988":12545,"_14576":3454,"_14583":9463,"_29389":6032,"_29798":7565,"_29819":12923,"_29423":4745,"_34797":4830,"_29526":7581,"_29863":4970,"_34804":4820,"_34807":11754,"_34810":7715,"_34813":13220,"_30270":3138,"_34818":3258,"_34820":4314,"_30300":4752,"_14957":5149,"_34824":3349,"_34827":7617,"_34829":6252,"_29847":7554,"_30265":4789,"_30313":5020,"_34834":8493,"_34836":3358,"_34838":4878,"_29543":3066,"_34841":6025,"_34843":4748,"_34845":5168,"_34847":3673,"_34849":7696,"_29460":4435,"_34852":7722,"_34854":11067,"_29454":7682,"_29884":3427,"_34858":7271,"_34860":4118,"_34863":7751,"_29500":6035,"_34867":5204,"_29380":3439,"_34870":11974,"_29428":4780,"_34873":9087,"_34875":20098,"_34878":3458,"_14951":4629,"_34881":9106,"_34883":11230,"_34886":16867,"_34888":3276,"_34890":7979,"_34892":10226,"_34894":6122,"_19991":5219,"_30503":4648,"_34898":7466,"_29401":6482,"_29841":7