292,"_30605":71287,"_5":30961,"_21201":118034,"_27821":118035,"_3006":118036},[],"/docs/pr-preview/pr-66/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3550":71293,"_30605":71287,"_5":30961,"_21201":118038,"_27821":118039,"_3006":118040},[],"/docs/pr-preview/pr-66/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3550":71294,"_30605":71287,"_5":30961,"_21201":118042,"_27821":118043,"_3006":118044},[],"/docs/pr-preview/pr-66/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3550":71295,"_30605":71287,"_5":30961,"_21201":118046,"_27821":118047,"_3006":118048},[],"/docs/pr-preview/pr-66/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3550":71296,"_30605":71287,"_21201":118050,"_5":14582,"_27821":71287,"_3006":118051},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3550":71297,"_30605":71287,"_21201":118053,"_5":14582,"_27821":118023,"_3006":118054},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3550":71298,"_30605":71287,"_21201":118056,"_5":14582,"_27821":118023,"_3006":118057},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3550":71299,"_30605":71287,"_21201":118059,"_5":14582,"_27821":118023,"_3006":118060},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3550":71300,"_30605":71287,"_21201":118062,"_5":14582,"_27821":118027,"_3006":118063},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3550":71301,"_30605":71287,"_21201":118065,"_5":14582,"_27821":118027,"_3006":118066},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3550":71302,"_30605":71287,"_21201":118068,"_5":14582,"_27821":118027,"_3006":118069},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3550":71303,"_30605":71287,"_21201":118071,"_5":14582,"_27821":118031,"_3006":118072},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3550":71304,"_30605":71287,"_21201":118074,"_5":14582,"_27821":118035,"_3006":118075},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3550":71305,"_30605":71287,"_21201":118077,"_5":14582,"_27821":118039,"_3006":118078},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3550":71306,"_30605":71287,"_21201":118080,"_5":14582,"_27821":118043,"_3006":118081},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3550":71307,"_30605":71287,"_21201":118083,"_5":14582,"_27821":118047,"_3006":118084},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3550":71308,"_30605":71308,"_5":14934,"_3006":118086,"_30964":118087,"_21201":118088,"_27821":71308},"Despliega Lamassu",[49995,118015],[],{"_3550":71309,"_30605":71308,"_21201":118090,"_5":14582,"_27821":71308,"_3006":118091},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3550":71310,"_30605":71308,"_5":30961,"_21201":118093,"_27821":118094,"_3006":118095},[],"/docs/pr-preview/pr-66/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3550":71311,"_30605":71308,"_5":30961,"_21201":118097,"_27821":118098,"_3006":118099},[],"/docs/pr-preview/pr-66/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3550":71312,"_30605":71308,"_5":30961,"_21201":118101,"_27821":118102,"_3006":118103},[],"/docs/pr-preview/pr-66/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3550":71313,"_30605":71308,"_21201":118105,"_5":14582,"_27821":71308,"_3006":118106},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3550":71314,"_30605":71308,"_21201":118108,"_5":14582,"_27821":118094,"_3006":118109},[],"Modelo",{"_3550":71315,"_30605":71308,"_21201":118111,"_5":14582,"_27821":118094,"_3006":118112},[],"Recomendado para",{"_3550":71316,"_30605":71308,"_21201":118114,"_5":14582,"_27821":118094,"_3006":118115},[],"Quién opera la infraestructura",{"_3550":71317,"_30605":71308,"_21201":118117,"_5":14582,"_27821":118094,"_3006":118118},[],"Punto de partida",{"_3550":71318,"_30605":71308,"_21201":118120,"_5":14582,"_27821":118094,"_3006":50102},[],{"_3550":71319,"_30605":71308,"_21201":118122,"_5":14582,"_27821":118094,"_3006":118123},[],"Producción, entornos regulados y despliegues personalizados",{"_3550":71320,"_30605":71308,"_21201":118125,"_5":14582,"_27821":118094,"_3006":118126},[],"Tu equipo",{"_3550":71321,"_30605":71308,"_21201":118128,"_5":14582,"_27821":118094,"_3006":118129},[],"Helm o Fastlane",{"_3550":71322,"_30605":71308,"_21201":118131,"_5":14582,"_27821":118094,"_3006":50114},[],{"_3550":71323,"_30605":71308,"_21201":118133,"_5":14582,"_27821":118094,"_3006":118134},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3550":71324,"_30605":71308,"_21201":118136,"_5":14582,"_27821":118094,"_3006":118126},[],{"_3550":71325,"_30605":71308,"_21201":118138,"_5":14582,"_27821":118094,"_3006":118139},[],"Imagen preconfigurada en EC2",{"_3550":71326,"_30605":71308,"_21201":118141,"_5":14582,"_27821":118094,"_3006":50125},[],{"_3550":71327,"_30605":71308,"_21201":118143,"_5":14582,"_27821":118094,"_3006":118144},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3550":71328,"_30605":71308,"_21201":118146,"_5":14582,"_27821":118094,"_3006":50131},[],{"_3550":71329,"_30605":71308,"_21201":118148,"_5":14582,"_27821":118094,"_3006":118149},[],"Suscripción gestionada",{"_3550":71330,"_30605":71308,"_21201":118151,"_5":14582,"_27821":118094,"_3006":118152},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3550":71331,"_30605":71308,"_21201":118154,"_5":14582,"_27821":118094,"_3006":118155},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3550":71332,"_30605":71308,"_21201":118157,"_5":14582,"_27821":118094,"_3006":118158},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3550":71333,"_30605":71308,"_21201":118160,"_5":14582,"_27821":118098,"_3006":118161},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3550":71334,"_30605":71308,"_21201":118163,"_5":14582,"_27821":118102,"_3006":118164},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3550":71335,"_30605":71335,"_5":14934,"_3006":118166,"_30964":118167,"_21201":118168,"_27821":71335},"Utiliza Lamassu como SaaS",[49995,118015,118016],[],{"_3550":71336,"_30605":71335,"_21201":118170,"_5":14582,"_27821":71335,"_3006":118171},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3550":71337,"_30605":71335,"_5":30961,"_21201":118173,"_27821":118174,"_3006":118175},[],"/docs/pr-preview/pr-66/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3550":71338,"_30605":71335,"_5":30961,"_21201":118177,"_27821":118178,"_3006":118179},[],"/docs/pr-preview/pr-66/es/deployment/saas#planes","Planes",{"_3550":71339,"_30605":71335,"_5":30961,"_21201":118181,"_27821":118182,"_3006":118183},[],"/docs/pr-preview/pr-66/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3550":71340,"_30605":71335,"_21201":118185,"_5":14582,"_27821":71335,"_3006":118186},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3550":71341,"_30605":71335,"_21201":118188,"_5":14582,"_27821":118174,"_3006":118189},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3550":71342,"_30605":71335,"_21201":118191,"_5":14582,"_27821":118174,"_3006":118192},[],"Copias de seguridad automáticas.",{"_3550":71343,"_30605":71335,"_21201":118194,"_5":14582,"_27821":118174,"_3006":118195},[],"Actualizaciones de versión.",{"_3550":71344,"_30605":71335,"_21201":118197,"_5":14582,"_27821":118174,"_3006":118198},[],"Soporte técnico y SLA según el plan contratado.",{"_3550":71345,"_30605":71335,"_21201":118200,"_5":14582,"_27821":118178,"_3006":50186},[],{"_3550":71346,"_30605":71335,"_21201":118202,"_5":14582,"_27821":118178,"_3006":118203},[],"Dispositivos",{"_3550":71347,"_30605":71335,"_21201":118205,"_5":14582,"_27821":118178,"_3006":118206},[],"Soporte",{"_3550":71348,"_30605":71335,"_21201":118208,"_5":14582,"_27821":118178,"_3006":50195},[],{"_3550":71349,"_30605":71335,"_21201":118210,"_5":14582,"_27821":118178,"_3006":50198},[],{"_3550":71350,"_30605":71335,"_21201":118212,"_5":14582,"_27821":118178,"_3006":118213},[],"Hasta 1.000",{"_3550":71351,"_30605":71335,"_21201":118215,"_5":14582,"_27821":118178,"_3006":50204},[],{"_3550":71352,"_30605":71335,"_21201":118217,"_5":14582,"_27821":118178,"_3006":118218},[],"99,5 %",{"_3550":71353,"_30605":71335,"_21201":118220,"_5":14582,"_27821":118178,"_3006":50210},[],{"_3550":71354,"_30605":71335,"_21201":118222,"_5":14582,"_27821":118178,"_3006":118223},[],"Hasta 10.000",{"_3550":71355,"_30605":71335,"_21201":118225,"_5":14582,"_27821":118178,"_3006":118226},[],"Email y chat",{"_3550":71356,"_30605":71335,"_21201":118228,"_5":14582,"_27821":118178,"_3006":118229},[],"99,9 %",{"_3550":71357,"_30605":71335,"_21201":118231,"_5":14582,"_27821":118178,"_3006":50222},[],{"_3550":71358,"_30605":71335,"_21201":118233,"_5":14582,"_27821":118178,"_3006":118234},[],"Ilimitados",{"_3550":71359,"_30605":71335,"_21201":118236,"_5":14582,"_27821":118178,"_3006":118237},[],"Dedicado",{"_3550":71360,"_30605":71335,"_21201":118239,"_5":14582,"_27821":118178,"_3006":118240},[],"99,99 %",{"_3550":71361,"_30605":71335,"_21201":118242,"_5":14582,"_27821":118182,"_3006":118243},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3550":71362,"_30605":71335,"_21201":118245,"_5":14582,"_27821":118182,"_3006":118246},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3550":71363,"_30605":71363,"_5":14934,"_3006":50239,"_30964":118248,"_21201":118250,"_27821":71363},[49995,118015,118249],"Kubernetes autogestionado",[],{"_3550":71364,"_30605":71363,"_21201":118252,"_5":14582,"_27821":71363,"_3006":118253},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3550":71365,"_30605":71363,"_5":30961,"_21201":118255,"_27821":118256,"_3006":118257},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3550":71366,"_30605":71363,"_5":30961,"_21201":118259,"_27821":118260,"_3006":118261},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3550":71367,"_30605":71363,"_5":30961,"_21201":118263,"_27821":118264,"_3006":118265},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3550":71368,"_30605":71363,"_5":30961,"_21201":118267,"_27821":118268,"_3006":118269},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3550":71369,"_30605":71363,"_5":30961,"_21201":118271,"_27821":118272,"_3006":118273},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3550":71370,"_30605":71363,"_5":30961,"_21201":118275,"_27821":118276,"_3006":118277},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3550":71371,"_30605":71363,"_5":30961,"_21201":118279,"_27821":118280,"_3006":118281},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3550":71372,"_30605":71363,"_5":30961,"_21201":118283,"_27821":118284,"_3006":118285},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3550":71373,"_30605":71363,"_5":30961,"_21201":118287,"_27821":118288,"_3006":118289},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3550":71374,"_30605":71363,"_5":30961,"_21201":118291,"_27821":118292,"_3006":118293},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3550":71375,"_30605":71363,"_5":30961,"_21201":118295,"_27821":118296,"_3006":118297},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3550":71376,"_30605":71363,"_21201":118299,"_5":14582,"_27821":118256,"_3006":118300},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3550":71377,"_30605":71363,"_21201":118302,"_5":14582,"_27821":118256,"_3006":118303},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3550":71378,"_30605":71363,"_21201":118305,"_5":14582,"_27821":118260,"_3006":118306},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3550":71379,"_30605":71363,"_21201":118308,"_5":14582,"_27821":118260,"_3006":118309},[],"Fastlane instala o configura",{"_3550":71380,"_30605":71363,"_21201":118311,"_5":14582,"_27821":118260,"_3006":118312},[],"Tú sigues proporcionando",{"_3550":71381,"_30605":71363,"_21201":118314,"_5":14582,"_27821":118260,"_3006":118315},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3550":71382,"_30605":71363,"_21201":118317,"_5":14582,"_27821":118260,"_3006":118318},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3550":71383,"_30605":71363,"_21201":118320,"_5":14582,"_27821":118260,"_3006":118321},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3550":71384,"_30605":71363,"_21201":118323,"_5":14582,"_27821":118260,"_3006":118324},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3550":71385,"_30605":71363,"_21201":118326,"_5":14582,"_27821":118260,"_3006":118327},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3550":71386,"_30605":71363,"_21201":118329,"_5":14582,"_27821":118260,"_3006":118330},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3550":71387,"_30605":71363,"_21201":118332,"_5":14582,"_27821":118260,"_3006":118333},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3550":71388,"_30605":71363,"_21201":118335,"_5":14582,"_27821":118260,"_3006":118336},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3550":71389,"_30605":71363,"_21201":118338,"_5":14582,"_27821":118260,"_3006":118339},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3550":71390,"_30605":71363,"_21201":118341,"_5":14582,"_27821":118264,"_3006":118342},[],"Necesitas:",{"_3550":71391,"_30605":71363,"_21201":118344,"_5":14582,"_27821":118264,"_3006":118345},[],"un clúster Kubernetes existente",{"_3550":71392,"_30605":71363,"_21201":118347,"_5":14582,"_27821":118264,"_3006":118348},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3550":71393,"_30605":71363,"_21201":118350,"_5":14582,"_27821":118264,"_3006":50341},[],{"_3550":71394,"_30605":71363,"_21201":118352,"_5":14582,"_27821":118264,"_3006":23959},[],{"_3550":71395,"_30605":71363,"_21201":118354,"_5":14582,"_27821":118264,"_3006":118355},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3550":71396,"_30605":71363,"_21201":118357,"_5":14582,"_27821":118264,"_3006":118358},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3550":71397,"_30605":71363,"_21201":118360,"_5":14582,"_27821":118264,"_3006":118361},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3550":71398,"_30605":71363,"_21201":118363,"_5":14582,"_27821":118264,"_3006":118364},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3550":71399,"_30605":71363,"_21201":118366,"_5":14582,"_27821":118264,"_3006":118367},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3550":71400,"_30605":71363,"_21201":118369,"_5":14582,"_27821":118268,"_3006":118370},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3550":71401,"_30605":71363,"_21201":118372,"_5":14582,"_27821":118268,"_3006":118373},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3550":71402,"_30605":71363,"_21201":118375,"_5":14582,"_27821":118272,"_3006":118376},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3550":71403,"_30605":71363,"_21201":118378,"_5":14582,"_27821":118272,"_3006":118379},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3550":71404,"_30605":71363,"_21201":118381,"_5":14582,"_27821":118272,"_3006":118382},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3550":71405,"_30605":71363,"_21201":118384,"_5":14582,"_27821":118272,"_3006":118385},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3550":71406,"_30605":71363,"_21201":118387,"_5":14582,"_27821":118276,"_3006":118388},[],"Opción",{"_3550":71407,"_30605":71363,"_21201":118390,"_5":14582,"_27821":118276,"_3006":118391},[],"Valor predeterminado",{"_3550":71408,"_30605":71363,"_21201":118393,"_5":14582,"_27821":118276,"_3006":118394},[],"Propósito",{"_3550":71409,"_30605":71363,"_21201":118396,"_5":14582,"_27821":118276,"_3006":50388},[],{"_3550":71410,"_30605":71363,"_21201":118398,"_5":14582,"_27821":118276,"_3006":50391},[],{"_3550":71411,"_30605":71363,"_21201":118400,"_5":14582,"_27821":118276,"_3006":118401},[],"Muestra la ayuda",{"_3550":71412,"_30605":71363,"_21201":118403,"_5":14582,"_27821":118276,"_3006":50397},[],{"_3550":71413,"_30605":71363,"_21201":118405,"_5":14582,"_27821":118276,"_3006":118406},[],"contexto actual",{"_3550":71414,"_30605":71363,"_21201":118408,"_5":14582,"_27821":118276,"_3006":118409},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3550":71415,"_30605":71363,"_21201":118411,"_5":14582,"_27821":118276,"_3006":50406},[],{"_3550":71416,"_30605":71363,"_21201":118413,"_5":14582,"_27821":118276,"_3006":6671},[],{"_3550":71417,"_30605":71363,"_21201":118415,"_5":14582,"_27821":118276,"_3006":118416},[],"Omite prompts y genera credenciales para las dependencias",{"_3550":71418,"_30605":71363,"_21201":118418,"_5":14582,"_27821":118276,"_3006":50414},[],{"_3550":71419,"_30605":71363,"_21201":118420,"_5":14582,"_27821":118276,"_3006":50417},[],{"_3550":71420,"_30605":71363,"_21201":118422,"_5":14582,"_27821":118276,"_3006":118423},[],"Namespace de la instalación",{"_3550":71421,"_30605":71363,"_21201":118425,"_5":14582,"_27821":118276,"_3006":50423},[],{"_3550":71422,"_30605":71363,"_21201":118427,"_5":14582,"_27821":118276,"_3006":50426},[],{"_3550":71423,"_30605":71363,"_21201":118429,"_5":14582,"_27821":118276,"_3006":118430},[],"Dominio usado por la UI, OIDC y el certificado",{"_3550":71424,"_30605":71363,"_21201":118432,"_5":14582,"_27821":118276,"_3006":50432},[],{"_3550":71425,"_30605":71363,"_21201":118434,"_5":14582,"_27821":118276,"_3006":15274},[],{"_3550":71426,"_30605":71363,"_21201":118436,"_5":14582,"_27821":118276,"_3006":118437},[],"Versión del chart de Lamassu",{"_3550":71427,"_30605":71363,"_21201":118439,"_5":14582,"_27821":118276,"_3006":50440},[],{"_3550":71428,"_30605":71363,"_21201":118441,"_5":14582,"_27821":118276,"_3006":50443},[],{"_3550":71429,"_30605":71363,"_21201":118443,"_5":14582,"_27821":118276,"_3006":118444},[],"Puerto del listener HTTPS",{"_3550":71430,"_30605":71363,"_21201":118446,"_5":14582,"_27821":118276,"_3006":50449},[],{"_3550":71431,"_30605":71363,"_21201":118448,"_5":14582,"_27821":118276,"_3006":50452},[],{"_3550":71432,"_30605":71363,"_21201":118450,"_5":14582,"_27821":118276,"_3006":118451},[],"Puerto del listener HTTP",{"_3550":71433,"_30605":71363,"_21201":118453,"_5":14582,"_27821":118276,"_3006":50458},[],{"_3550":71434,"_30605":71363,"_21201":118455,"_5":14582,"_27821":118276,"_3006":50391},[],{"_3550":71435,"_30605":71363,"_21201":118457,"_5":14582,"_27821":118276,"_3006":118458},[],"Certificado PEM para TLS downstream",{"_3550":71436,"_30605":71363,"_21201":118460,"_5":14582,"_27821":118276,"_3006":50466},[],{"_3550":71437,"_30605":71363,"_21201":118462,"_5":14582,"_27821":118276,"_3006":50391},[],{"_3550":71438,"_30605":71363,"_21201":118464,"_5":14582,"_27821":118276,"_3006":118465},[],"Clave privada PEM para TLS downstream",{"_3550":71439,"_30605":71363,"_21201":118467,"_5":14582,"_27821":118276,"_3006":50474},[],{"_3550":71440,"_30605":71363,"_21201":118469,"_5":14582,"_27821":118276,"_3006":118470},[],"chart del repositorio",{"_3550":71441,"_30605":71363,"_21201":118472,"_5":14582,"_27821":118276,"_3006":118473},[],"Usa un chart local de Lamassu sin empaquetar",{"_3550":71442,"_30605":71363,"_21201":118475,"_5":14582,"_27821":118276,"_3006":50483},[],{"_3550":71443,"_30605":71363,"_21201":118477,"_5":14582,"_27821":118276,"_3006":118478},[],"detección automática",{"_3550":71444,"_30605":71363,"_21201":118480,"_5":14582,"_27821":118276,"_3006":118481},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3550":71445,"_30605":71363,"_21201":118483,"_5":14582,"_27821":118276,"_3006":50491},[],{"_3550":71446,"_30605":71363,"_21201":118485,"_5":14582,"_27821":118276,"_3006":6671},[],{"_3550":71447,"_30605":71363,"_21201":118487,"_5":14582,"_27821":118276,"_3006":118488},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3550":71448,"_30605":71363,"_21201":118490,"_5":14582,"_27821":118276,"_3006":50499},[],{"_3550":71449,"_30605":71363,"_21201":118492,"_5":14582,"_27821":118276,"_3006":6671},[],{"_3550":71450,"_30605":71363,"_21201":118494,"_5":14582,"_27821":118276,"_3006":118495},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3550":71451,"_30605":71363,"_21201":118497,"_5":14582,"_27821":118276,"_3006":50507},[],{"_3550":71452,"_30605":71363,"_21201":118499,"_5":14582,"_27821":118276,"_3006":6671},[],{"_3550":71453,"_30605":71363,"_21201":118501,"_5":14582,"_27821":118276,"_3006":118502},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3550":71454,"_30605":71363,"_21201":118504,"_5":14582,"_27821":118276,"_3006":50515},[],{"_3550":71455,"_30605":71363,"_21201":118506,"_5":14582,"_27821":118276,"_3006":6671},[],{"_3550":71456,"_30605":71363,"_21201":118508,"_5":14582,"_27821":118276,"_3006":118509},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3550":71457,"_30605":71363,"_21201":118511,"_5":14582,"_27821":118276,"_3006":50523},[],{"_3550":71458,"_30605":71363,"_21201":118513,"_5":14582,"_27821":118276,"_3006":50526},[],{"_3550":71459,"_30605":71363,"_21201":118515,"_5":14582,"_27821":118276,"_3006":118516},[],"Usa otro chart local de SoftHSM",{"_3550":71460,"_30605":71363,"_21201":118518,"_5":14582,"_27821":118276,"_3006":118519},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3550":71461,"_30605":71363,"_21201":118521,"_5":14582,"_27821":118280,"_3006":118522},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3550":71462,"_30605":71363,"_21201":118524,"_5":14582,"_27821":118280,"_3006":118525},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3550":71463,"_30605":71363,"_21201":118527,"_5":14582,"_27821":118280,"_3006":118528},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3550":71464,"_30605":71363,"_21201":118530,"_5":14582,"_27821":118280,"_3006":118531},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3550":71465,"_30605":71363,"_21201":118533,"_5":14582,"_27821":118280,"_3006":118534},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3550":71466,"_30605":71363,"_21201":118536,"_5":14582,"_27821":118280,"_3006":118537},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3550":71467,"_30605":71363,"_21201":118539,"_5":14582,"_27821":118284,"_3006":50553},[],{"_3550":71468,"_30605":71363,"_21201":118541,"_5":14582,"_27821":118284,"_3006":118542},[],"valida las herramientas locales y el clúster seleccionado",{"_3550":71469,"_30605":71363,"_21201":118544,"_5":14582,"_27821":118284,"_3006":118545},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3550":71470,"_30605":71363,"_21201":118547,"_5":14582,"_27821":118284,"_3006":118548},[],"crea el namespace",{"_3550":71471,"_30605":71363,"_21201":118550,"_5":14582,"_27821":118284,"_3006":118551},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3550":71472,"_30605":71363,"_21201":118553,"_5":14582,"_27821":118284,"_3006":118554},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3550":71473,"_30605":71363,"_21201":118556,"_5":14582,"_27821":118284,"_3006":118557},[],"instala RabbitMQ",{"_3550":71474,"_30605":71363,"_21201":118559,"_5":14582,"_27821":118284,"_3006":118560},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3550":71475,"_30605":71363,"_21201":118562,"_5":14582,"_27821":118284,"_3006":118563},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3550":71476,"_30605":71363,"_21201":118565,"_5":14582,"_27821":118284,"_3006":118566},[],"carga datos de ejemplo opcionalmente",{"_3550":71477,"_30605":71363,"_21201":118568,"_5":14582,"_27821":118284,"_3006":118569},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3550":71478,"_30605":71363,"_21201":118571,"_5":14582,"_27821":118288,"_3006":118572},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3550":71479,"_30605":71363,"_21201":118574,"_5":14582,"_27821":118288,"_3006":118575},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3550":71480,"_30605":71363,"_21201":118577,"_5":14582,"_27821":118292,"_3006":118578},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3550":71481,"_30605":71363,"_21201":118580,"_5":14582,"_27821":118292,"_3006":118581},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3550":71482,"_30605":71363,"_21201":118583,"_5":14582,"_27821":118292,"_3006":118584},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3550":71483,"_30605":71363,"_21201":118586,"_5":14582,"_27821":118296,"_3006":118587},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3550":71484,"_30605":71484,"_5":14934,"_3006":118589,"_30964":118590,"_21201":118591,"_27821":71484},"Instala con Helm",[49995,118015,118249],[],{"_3550":71485,"_30605":71484,"_21201":118593,"_5":14582,"_27821":71484,"_3006":118594},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3550":71486,"_30605":71484,"_5":30961,"_21201":118596,"_27821":118597,"_3006":118598},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3550":71487,"_30605":71484,"_5":30961,"_21201":118600,"_27821":118601,"_3006":118265},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3550":71488,"_30605":71484,"_5":30961,"_21201":118603,"_27821":118604,"_3006":118605},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3550":71489,"_30605":71484,"_5":30961,"_21201":118607,"_27821":118608,"_3006":118609},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3550":71490,"_30605":71484,"_5":30961,"_21201":118611,"_27821":118612,"_3006":118613},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3550":71491,"_30605":71484,"_5":30961,"_21201":118615,"_27821":118616,"_3006":118617},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3550":71492,"_30605":71484,"_5":30961,"_21201":118619,"_27821":118620,"_3006":118621},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3550":71493,"_30605":71484,"_5":30961,"_21201":118623,"_27821":118624,"_3006":118625},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3550":71494,"_30605":71484,"_5":30961,"_21201":118627,"_27821":118628,"_3006":118629},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3550":71495,"_30605":71484,"_5":30961,"_21201":118631,"_27821":118632,"_3006":118633},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3550":71496,"_30605":71484,"_5":30961,"_21201":118635,"_27821":118636,"_3006":118637},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3550":71497,"_30605":71484,"_21201":118639,"_5":14582,"_27821":118597,"_3006":118640},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3550":71498,"_30605":71484,"_21201":118642,"_5":14582,"_27821":118601,"_3006":118643},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3550":71499,"_30605":71484,"_21201":118645,"_5":14582,"_27821":118601,"_3006":118646},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3550":71500,"_30605":71484,"_21201":118648,"_5":14582,"_27821":118601,"_3006":118649},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3550":71501,"_30605":71484,"_21201":118651,"_5":14582,"_27821":118601,"_3006":118652},[],"un broker RabbitMQ accesible y sus credenciales",{"_3550":71502,"_30605":71484,"_21201":118654,"_5":14582,"_27821":118601,"_3006":118655},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3550":71503,"_30605":71484,"_21201":118657,"_5":14582,"_27821":118601,"_3006":118658},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3550":71504,"_30605":71484,"_21201":118660,"_5":14582,"_27821":118601,"_3006":118661},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3550":71505,"_30605":71484,"_21201":118663,"_5":14582,"_27821":118601,"_3006":118664},[],"una StorageClass y un diseño de tráfico externo",{"_3550":71506,"_30605":71484,"_21201":118666,"_5":14582,"_27821":118601,"_3006":118667},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3550":71507,"_30605":71484,"_21201":118669,"_5":14582,"_27821":118601,"_3006":118670},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3550":71508,"_30605":71484,"_21201":118672,"_5":14582,"_27821":118601,"_3006":118673},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3550":71509,"_30605":71484,"_21201":118675,"_5":14582,"_27821":118604,"_3006":118676},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3550":71510,"_30605":71484,"_21201":118678,"_5":14582,"_27821":118604,"_3006":118679},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3550":71511,"_30605":71484,"_21201":118681,"_5":14582,"_27821":118604,"_3006":118682},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3550":71512,"_30605":71484,"_21201":118684,"_5":14582,"_27821":118608,"_3006":118685},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3550":71513,"_30605":71484,"_21201":118687,"_5":14582,"_27821":118608,"_3006":118688},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3550":71514,"_30605":71484,"_21201":118690,"_5":14582,"_27821":118608,"_3006":118691},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3550":71515,"_30605":71484,"_21201":118693,"_5":14582,"_27821":118608,"_3006":118694},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3550":71516,"_30605":71484,"_21201":118696,"_5":14582,"_27821":118612,"_3006":118697},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3550":71517,"_30605":71484,"_21201":118699,"_5":14582,"_27821":118616,"_3006":118700},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3550":71518,"_30605":71484,"_21201":118702,"_5":14582,"_27821":118616,"_3006":118703},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3550":71519,"_30605":71484,"_21201":118705,"_5":14582,"_27821":118616,"_3006":118706},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3550":71520,"_30605":71484,"_21201":118708,"_5":14582,"_27821":118616,"_3006":118709},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3550":71521,"_30605":71484,"_21201":118711,"_5":14582,"_27821":118616,"_3006":118712},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3550":71522,"_30605":71484,"_21201":118714,"_5":14582,"_27821":118616,"_3006":118715},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3550":71523,"_30605":71484,"_21201":118717,"_5":14582,"_27821":118616,"_3006":118718},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3550":71524,"_30605":71484,"_21201":118720,"_5":14582,"_27821":118620,"_3006":118721},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3550":71525,"_30605":71484,"_21201":118723,"_5":14582,"_27821":118620,"_3006":118724},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3550":71526,"_30605":71484,"_21201":118726,"_5":14582,"_27821":118620,"_3006":118727},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3550":71527,"_30605":71484,"_21201":118729,"_5":14582,"_27821":118620,"_3006":118730},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3550":71528,"_30605":71484,"_21201":118732,"_5":14582,"_27821":118624,"_3006":118733},[],"Para instalar un checkout local:",{"_3550":71529,"_30605":71484,"_21201":118735,"_5":14582,"_27821":118628,"_3006":118736},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3550":71530,"_30605":71484,"_21201":118738,"_5":14582,"_27821":118628,"_3006":118739},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3550":71531,"_30605":71484,"_21201":118741,"_5":14582,"_27821":118632,"_3006":118742},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3550":71532,"_30605":71484,"_21201":118744,"_5":14582,"_27821":118632,"_3006":118745},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3550":71533,"_30605":71484,"_21201":118747,"_5":14582,"_27821":118632,"_3006":118748},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3550":71534,"_30605":71484,"_21201":118750,"_5":14582,"_27821":118632,"_3006":118751},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3550":71535,"_30605":71484,"_21201":118753,"_5":14582,"_27821":118632,"_3006":118754},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3550":71536,"_30605":71484,"_21201":118756,"_5":14582,"_27821":118636,"_3006":118757},[],"Antes de pasar a producción, revisa:",{"_3550":71537,"_30605":71484,"_21201":118759,"_5":14582,"_27821":118636,"_3006":118760},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3550":71538,"_30605":71484,"_21201":118762,"_5":14582,"_27821":118636,"_3006":118763},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3550":71539,"_30605":71484,"_21201":118765,"_5":14582,"_27821":118636,"_3006":118766},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3550":71540,"_30605":71484,"_21201":118768,"_5":14582,"_27821":118636,"_3006":118769},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3550":71541,"_30605":71484,"_21201":118771,"_5":14582,"_27821":118636,"_3006":118772},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3550":71542,"_30605":71484,"_21201":118774,"_5":14582,"_27821":118636,"_3006":118775},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3550":71543,"_30605":71484,"_21201":118777,"_5":14582,"_27821":118636,"_3006":118778},[],"SMTP, observabilidad y entrega de alertas",{"_3550":71544,"_30605":71484,"_21201":118780,"_5":14582,"_27821":118636,"_3006":118781},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3550":71545,"_30605":71484,"_21201":118783,"_5":14582,"_27821":118636,"_3006":118784},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3550":71546,"_30605":71546,"_5":14934,"_3006":118786,"_30964":118787,"_21201":118788,"_27821":71546},"Expón el Gateway",[49995,118015,118249],[],{"_3550":71547,"_30605":71546,"_21201":118790,"_5":14582,"_27821":71546,"_3006":118791},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3550":71548,"_30605":71546,"_5":30961,"_21201":118793,"_27821":118794,"_3006":118795},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3550":71549,"_30605":71546,"_5":30961,"_21201":118797,"_27821":118798,"_3006":118799},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3550":71550,"_30605":71546,"_5":30961,"_21201":118801,"_27821":118802,"_3006":118803},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3550":71551,"_30605":71546,"_5":30961,"_21201":118805,"_27821":118806,"_3006":50821},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#k3s",{"_3550":71552,"_30605":71546,"_5":30961,"_21201":118808,"_27821":118809,"_3006":118810},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3550":71553,"_30605":71546,"_5":30961,"_21201":118812,"_27821":118813,"_3006":118814},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3550":71554,"_30605":71546,"_5":30961,"_21201":118816,"_27821":118817,"_3006":118818},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3550":71555,"_30605":71546,"_5":30961,"_21201":118820,"_27821":118821,"_3006":118822},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3550":71556,"_30605":71546,"_5":30961,"_21201":118824,"_27821":118825,"_3006":118826},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3550":71557,"_30605":71546,"_5":30961,"_21201":118828,"_27821":118829,"_3006":118830},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3550":71558,"_30605":71546,"_5":30961,"_21201":118832,"_27821":118833,"_3006":118834},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3550":71559,"_30605":71546,"_21201":118836,"_5":14582,"_27821":118794,"_3006":118837},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3550":71560,"_30605":71546,"_21201":118839,"_5":14582,"_27821":118794,"_3006":118840},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3550":71561,"_30605":71546,"_21201":118842,"_5":14582,"_27821":118798,"_3006":118843},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3550":71562,"_30605":71546,"_21201":118845,"_5":14582,"_27821":118798,"_3006":118846},[],"Defínelo únicamente cuando:",{"_3550":71563,"_30605":71546,"_21201":118848,"_5":14582,"_27821":118798,"_3006":118849},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3550":71564,"_30605":71546,"_21201":118851,"_5":14582,"_27821":118798,"_3006":118852},[],"esa dirección está asignada a este Gateway",{"_3550":71565,"_30605":71546,"_21201":118854,"_5":14582,"_27821":118798,"_3006":118855},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3550":71566,"_30605":71546,"_21201":118857,"_5":14582,"_27821":118798,"_3006":118858},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3550":71567,"_30605":71546,"_21201":118860,"_5":14582,"_27821":118798,"_3006":118861},[],"No confundas estos valores:",{"_3550":71568,"_30605":71546,"_21201":118863,"_5":14582,"_27821":118798,"_3006":118864},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3550":71569,"_30605":71546,"_21201":118866,"_5":14582,"_27821":118798,"_3006":118867},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3550":71570,"_30605":71546,"_21201":118869,"_5":14582,"_27821":118798,"_3006":118870},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3550":71571,"_30605":71546,"_21201":118872,"_5":14582,"_27821":118802,"_3006":118873},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3550":71572,"_30605":71546,"_21201":118875,"_5":14582,"_27821":118802,"_3006":118876},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3550":71573,"_30605":71546,"_21201":118878,"_5":14582,"_27821":118806,"_3006":118879},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3550":71574,"_30605":71546,"_21201":118881,"_5":14582,"_27821":118806,"_3006":118882},[],"Para el diseño recomendado:",{"_3550":71575,"_30605":71546,"_21201":118884,"_5":14582,"_27821":118806,"_3006":118885},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3550":71576,"_30605":71546,"_21201":118887,"_5":14582,"_27821":118806,"_3006":118888},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3550":71577,"_30605":71546,"_21201":118890,"_5":14582,"_27821":118806,"_3006":118891},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3550":71578,"_30605":71546,"_21201":118893,"_5":14582,"_27821":118806,"_3006":118894},[],"Apunta DNS a la dirección accesible de la VM.",{"_3550":71579,"_30605":71546,"_21201":118896,"_5":14582,"_27821":118806,"_3006":118897},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3550":71580,"_30605":71546,"_21201":118899,"_5":14582,"_27821":118809,"_3006":118900},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3550":71581,"_30605":71546,"_21201":118902,"_5":14582,"_27821":118813,"_3006":118903},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3550":71582,"_30605":71546,"_21201":118905,"_5":14582,"_27821":118813,"_3006":118906},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3550":71583,"_30605":71546,"_21201":118908,"_5":14582,"_27821":118817,"_3006":118909},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3550":71584,"_30605":71546,"_21201":118911,"_5":14582,"_27821":118817,"_3006":118912},[],"Requisito",{"_3550":71585,"_30605":71546,"_21201":118914,"_5":14582,"_27821":118817,"_3006":118915},[],"Diseño recomendado",{"_3550":71586,"_30605":71546,"_21201":118917,"_5":14582,"_27821":118817,"_3006":118918},[],"Consecuencia",{"_3550":71587,"_30605":71546,"_21201":118920,"_5":14582,"_27821":118817,"_3006":118921},[],"Varias URL o servicios de Lamassu",{"_3550":71588,"_30605":71546,"_21201":118923,"_5":14582,"_27821":118817,"_3006":118924},[],"Un Gateway con varias rutas",{"_3550":71589,"_30605":71546,"_21201":118926,"_5":14582,"_27821":118817,"_3006":118927},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3550":71590,"_30605":71546,"_21201":118929,"_5":14582,"_27821":118817,"_3006":118930},[],"Gateways independientes e IP externas distintas",{"_3550":71591,"_30605":71546,"_21201":118932,"_5":14582,"_27821":118817,"_3006":118933},[],"Una VIP por Gateway",{"_3550":71592,"_30605":71546,"_21201":118935,"_5":14582,"_27821":118817,"_3006":118936},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3550":71593,"_30605":71546,"_21201":118938,"_5":14582,"_27821":118817,"_3006":118939},[],"Gateways independientes, un nodo y una IP",{"_3550":71594,"_30605":71546,"_21201":118941,"_5":14582,"_27821":118817,"_3006":118942},[],"Puertos externos diferentes",{"_3550":71595,"_30605":71546,"_21201":118944,"_5":14582,"_27821":118817,"_3006":118945},[],"Los clientes deben indicar puertos no estándar",{"_3550":71596,"_30605":71546,"_21201":118947,"_5":14582,"_27821":118817,"_3006":118948},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3550":71597,"_30605":71546,"_21201":118950,"_5":14582,"_27821":118817,"_3006":118951},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3550":71598,"_30605":71546,"_21201":118953,"_5":14582,"_27821":118817,"_3006":118954},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3550":71599,"_30605":71546,"_21201":118956,"_5":14582,"_27821":118817,"_3006":118957},[],"Recursos Gateway separados pero proxy compartido",{"_3550":71600,"_30605":71546,"_21201":118959,"_5":14582,"_27821":118817,"_3006":118960},[],"Modo merged Gateway de Envoy",{"_3550":71601,"_30605":71546,"_21201":118962,"_5":14582,"_27821":118817,"_3006":118963},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3550":71602,"_30605":71546,"_21201":118965,"_5":14582,"_27821":118817,"_3006":118966},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3550":71603,"_30605":71546,"_21201":118968,"_5":14582,"_27821":118817,"_3006":118969},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3550":71604,"_30605":71546,"_21201":118971,"_5":14582,"_27821":118817,"_3006":118972},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3550":71605,"_30605":71546,"_21201":118974,"_5":14582,"_27821":118817,"_3006":118975},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3550":71606,"_30605":71546,"_21201":118977,"_5":14582,"_27821":118821,"_3006":118978},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3550":71607,"_30605":71546,"_21201":118980,"_5":14582,"_27821":118825,"_3006":118981},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3550":71608,"_30605":71546,"_21201":118983,"_5":14582,"_27821":118825,"_3006":118984},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3550":71609,"_30605":71546,"_21201":118986,"_5":14582,"_27821":118825,"_3006":118987},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3550":71610,"_30605":71546,"_21201":118989,"_5":14582,"_27821":118825,"_3006":118990},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3550":71611,"_30605":71546,"_21201":118992,"_5":14582,"_27821":118825,"_3006":118993},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3550":71612,"_30605":71546,"_21201":118995,"_5":14582,"_27821":118829,"_3006":118996},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3550":71613,"_30605":71546,"_21201":118998,"_5":14582,"_27821":118829,"_3006":118999},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3550":71614,"_30605":71546,"_21201":119001,"_5":14582,"_27821":118833,"_3006":119002},[],"Comprueba, en orden:",{"_3550":71615,"_30605":71546,"_21201":119004,"_5":14582,"_27821":118833,"_3006":119005},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3550":71616,"_30605":71546,"_21201":119007,"_5":14582,"_27821":118833,"_3006":119008},[],"Su estado contiene la dirección esperada.",{"_3550":71617,"_30605":71546,"_21201":119010,"_5":14582,"_27821":118833,"_3006":119011},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3550":71618,"_30605":71546,"_21201":119013,"_5":14582,"_27821":118833,"_3006":119014},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3550":71619,"_30605":71546,"_21201":119016,"_5":14582,"_27821":118833,"_3006":119017},[],"DNS resuelve al endpoint accesible externamente.",{"_3550":71620,"_30605":71546,"_21201":119019,"_5":14582,"_27821":118833,"_3006":119020},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3550":71621,"_30605":71546,"_21201":119022,"_5":14582,"_27821":118833,"_3006":119023},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3550":71622,"_30605":71622,"_5":14934,"_3006":50102,"_30964":119025,"_21201":119026,"_27821":71622},[49995,118015,118249],[],{"_3550":71623,"_30605":71622,"_21201":119028,"_5":14582,"_27821":71622,"_3006":119029},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3550":71624,"_30605":71622,"_5":30961,"_21201":119031,"_27821":119032,"_3006":119033},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3550":71625,"_30605":71622,"_5":30961,"_21201":119035,"_27821":119036,"_3006":119037},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3550":71626,"_30605":71622,"_5":30961,"_21201":119039,"_27821":119040,"_3006":119041},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3550":71627,"_30605":71622,"_5":30961,"_21201":119043,"_27821":119044,"_3006":119045},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3550":71628,"_30605":71622,"_5":30961,"_21201":119047,"_27821":119048,"_3006":119049},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3550":71629,"_30605":71622,"_5":30961,"_21201":119051,"_27821":119052,"_3006":119053},[],"/docs/pr-preview/pr-66/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3550":71630,"_30605":71622,"_21201":119055,"_5":14582,"_27821":119032,"_3006":119056},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3550":71631,"_30605":71622,"_21201":119058,"_5":14582,"_27821":119036,"_3006":119059},[],"Flujo",{"_3550":71632,"_30605":71622,"_21201":119061,"_5":14582,"_27821":119036,"_3006":119062},[],"Úsalo para",{"_3550":71633,"_30605":71622,"_21201":119064,"_5":14582,"_27821":119036,"_3006":119065},[],"Qué instala",{"_3550":71634,"_30605":71622,"_21201":119067,"_5":14582,"_27821":119036,"_3006":51083},[],{"_3550":71635,"_30605":71622,"_21201":119069,"_5":14582,"_27821":119036,"_3006":119070},[],"Producción y entornos controlados",{"_3550":71636,"_30605":71622,"_21201":119072,"_5":14582,"_27821":119036,"_3006":119073},[],"Servicios de Lamassu y recursos de Gateway API",{"_3550":71637,"_30605":71622,"_21201":119075,"_5":14582,"_27821":119036,"_3006":50239},[],{"_3550":71638,"_30605":71622,"_21201":119077,"_5":14582,"_27821":119036,"_3006":119078},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3550":71639,"_30605":71622,"_21201":119080,"_5":14582,"_27821":119036,"_3006":119081},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3550":71640,"_30605":71622,"_21201":119083,"_5":14582,"_27821":119040,"_3006":119084},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3550":71641,"_30605":71622,"_21201":119086,"_5":14582,"_27821":119040,"_3006":119087},[],"Área",{"_3550":71642,"_30605":71622,"_21201":119089,"_5":14582,"_27821":119040,"_3006":119090},[],"El chart de Lamassu proporciona",{"_3550":71643,"_30605":71622,"_21201":119092,"_5":14582,"_27821":119040,"_3006":119093},[],"Tú proporcionas",{"_3550":71644,"_30605":71622,"_21201":119095,"_5":14582,"_27821":119040,"_3006":119096},[],"Aplicaciones Lamassu",{"_3550":71645,"_30605":71622,"_21201":119098,"_5":14582,"_27821":119040,"_3006":119099},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3550":71646,"_30605":71622,"_21201":119101,"_5":14582,"_27821":119040,"_3006":119102},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3550":71647,"_30605":71622,"_21201":119104,"_5":14582,"_27821":119040,"_3006":119105},[],"Datos PostgreSQL",{"_3550":71648,"_30605":71622,"_21201":119107,"_5":14582,"_27821":119040,"_3006":119108},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3550":71649,"_30605":71622,"_21201":119110,"_5":14582,"_27821":119040,"_3006":119111},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3550":71650,"_30605":71622,"_21201":119113,"_5":14582,"_27821":119040,"_3006":119114},[],"Mensajería",{"_3550":71651,"_30605":71622,"_21201":119116,"_5":14582,"_27821":119040,"_3006":119117},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3550":71652,"_30605":71622,"_21201":119119,"_5":14582,"_27821":119040,"_3006":119120},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3550":71653,"_30605":71622,"_21201":119122,"_5":14582,"_27821":119040,"_3006":119123},[],"Identidad",{"_3550":71654,"_30605":71622,"_21201":119125,"_5":14582,"_27821":119040,"_3006":119126},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3550":71655,"_30605":71622,"_21201":119128,"_5":14582,"_27821":119040,"_3006":119129},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3550":71656,"_30605":71622,"_21201":119131,"_5":14582,"_27821":119040,"_3006":119132},[],"Enrutamiento externo",{"_3550":71657,"_30605":71622,"_21201":119134,"_5":14582,"_27821":119040,"_3006":119135},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3550":71658,"_30605":71622,"_21201":119137,"_5":14582,"_27821":119040,"_3006":119138},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3550":71659,"_30605":71622,"_21201":119140,"_5":14582,"_27821":119040,"_3006":51157},[],{"_3550":71660,"_30605":71622,"_21201":119142,"_5":14582,"_27821":119040,"_3006":119143},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3550":71661,"_30605":71622,"_21201":119145,"_5":14582,"_27821":119040,"_3006":119146},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3550":71662,"_30605":71622,"_21201":119148,"_5":14582,"_27821":119040,"_3006":119149},[],"Datos persistentes de la aplicación",{"_3550":71663,"_30605":71622,"_21201":119151,"_5":14582,"_27821":119040,"_3006":119152},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3550":71664,"_30605":71622,"_21201":119154,"_5":14582,"_27821":119040,"_3006":119155},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3550":71665,"_30605":71622,"_21201":119157,"_5":14582,"_27821":119040,"_3006":119158},[],"Integraciones opcionales",{"_3550":71666,"_30605":71622,"_21201":119160,"_5":14582,"_27821":119040,"_3006":119161},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3550":71667,"_30605":71622,"_21201":119163,"_5":14582,"_27821":119040,"_3006":119164},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3550":71668,"_30605":71622,"_21201":119166,"_5":14582,"_27821":119040,"_3006":119167},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3550":71669,"_30605":71622,"_21201":119169,"_5":14582,"_27821":119040,"_3006":119170},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3550":71670,"_30605":71622,"_21201":119172,"_5":14582,"_27821":119044,"_3006":119173},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3550":71671,"_30605":71622,"_21201":119175,"_5":14582,"_27821":119044,"_3006":119176},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3550":71672,"_30605":71622,"_21201":119178,"_5":14582,"_27821":119048,"_3006":119179},[],"Kubernetes 1.24 o posterior",{"_3550":71673,"_30605":71622,"_21201":119181,"_5":14582,"_27821":119048,"_3006":119182},[],"Helm 3.2 o posterior",{"_3550":71674,"_30605":71622,"_21201":119184,"_5":14582,"_27821":119048,"_3006":119185},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3550":71675,"_30605":71622,"_21201":119187,"_5":14582,"_27821":119048,"_3006":119188},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3550":71676,"_30605":71622,"_21201":119190,"_5":14582,"_27821":119048,"_3006":119191},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3550":71677,"_30605":71622,"_21201":119193,"_5":14582,"_27821":119048,"_3006":119194},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3550":71678,"_30605":71622,"_21201":119196,"_5":14582,"_27821":119048,"_3006":119197},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3550":71679,"_30605":71622,"_21201":119199,"_5":14582,"_27821":119052,"_3006":119200},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3550":71680,"_30605":71622,"_21201":119202,"_5":14582,"_27821":119052,"_3006":119203},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3550":71681,"_30605":71622,"_21201":119205,"_5":14582,"_27821":119052,"_3006":119206},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3550":71682,"_30605":71622,"_21201":119208,"_5":14582,"_27821":119052,"_3006":119209},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3550":71683,"_30605":71683,"_5":14934,"_3006":119211,"_30964":119212,"_21201":119214,"_27821":71683},"Resolución de problemas de despliegue",[49995,118015,119213],"Operación",[],{"_3550":71684,"_30605":71683,"_21201":119216,"_5":14582,"_27821":71683,"_3006":119217},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3550":71685,"_30605":71683,"_5":30961,"_21201":119219,"_27821":119220,"_3006":119221},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3550":71686,"_30605":71683,"_5":30961,"_21201":119223,"_27821":119224,"_3006":119225},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3550":71687,"_30605":71683,"_5":30961,"_21201":119227,"_27821":119228,"_3006":119229},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3550":71688,"_30605":71683,"_5":30961,"_21201":119231,"_27821":119232,"_3006":119233},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3550":71689,"_30605":71683,"_5":30961,"_21201":119235,"_27821":119236,"_3006":119237},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3550":71690,"_30605":71683,"_5":30961,"_21201":119239,"_27821":119240,"_3006":119241},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3550":71691,"_30605":71683,"_5":30961,"_21201":119243,"_27821":119244,"_3006":119245},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3550":71692,"_30605":71683,"_5":30961,"_21201":119247,"_27821":119248,"_3006":119249},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3550":71693,"_30605":71683,"_5":30961,"_21201":119251,"_27821":119252,"_3006":119253},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3550":71694,"_30605":71683,"_5":30961,"_21201":119255,"_27821":119256,"_3006":119257},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3550":71695,"_30605":71683,"_5":30961,"_21201":119259,"_27821":119260,"_3006":119261},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3550":71696,"_30605":71683,"_5":30961,"_21201":119263,"_27821":119264,"_3006":119265},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3550":71697,"_30605":71683,"_5":30961,"_21201":119267,"_27821":119268,"_3006":119269},[],"/docs/pr-preview/pr-66/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3550":71698,"_30605":71683,"_21201":119271,"_5":14582,"_27821":71683,"_3006":119272},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3550":71699,"_30605":71683,"_21201":119274,"_5":14582,"_27821":119224,"_3006":119275},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3550":71700,"_30605":71683,"_21201":119277,"_5":14582,"_27821":119228,"_3006":119278},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3550":71701,"_30605":71683,"_21201":119280,"_5":14582,"_27821":119232,"_3006":119281},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3550":71702,"_30605":71683,"_21201":119283,"_5":14582,"_27821":119236,"_3006":119284},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3550":71703,"_30605":71683,"_21201":119286,"_5":14582,"_27821":119240,"_3006":119287},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3550":71704,"_30605":71683,"_21201":119289,"_5":14582,"_27821":119244,"_3006":119290},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3550":71705,"_30605":71683,"_21201":119292,"_5":14582,"_27821":119244,"_3006":119293},[],"Ejecuta también la prueba de conectividad del chart:",{"_3550":71706,"_30605":71683,"_21201":119295,"_5":14582,"_27821":119244,"_3006":119296},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3550":71707,"_30605":71683,"_21201":119298,"_5":14582,"_27821":119244,"_3006":119299},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3550":71708,"_30605":71683,"_21201":119301,"_5":14582,"_27821":119248,"_3006":119302},[],"Si recibes un 401:",{"_3550":71709,"_30605":71683,"_21201":119304,"_5":14582,"_27821":119248,"_3006":119305},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3550":71710,"_30605":71683,"_21201":119307,"_5":14582,"_27821":119248,"_3006":119308},[],"verifica emisor, audiencia y expiración del token;",{"_3550":71711,"_30605":71683,"_21201":119310,"_5":14582,"_27821":119248,"_3006":119311},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3550":71712,"_30605":71683,"_21201":119313,"_5":14582,"_27821":119248,"_3006":119314},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3550":71713,"_30605":71683,"_21201":119316,"_5":14582,"_27821":119248,"_3006":119317},[],"Si el login termina pero las APIs devuelven 403:",{"_3550":71714,"_30605":71683,"_21201":119319,"_5":14582,"_27821":119248,"_3006":119320},[],"inspecciona los claims reales del token;",{"_3550":71715,"_30605":71683,"_21201":119322,"_5":14582,"_27821":119248,"_3006":119323},[],"confirma que coinciden con un principal activo;",{"_3550":71716,"_30605":71683,"_21201":119325,"_5":14582,"_27821":119248,"_3006":119326},[],"revisa las políticas concedidas al principal;",{"_3550":71717,"_30605":71683,"_21201":119328,"_5":14582,"_27821":119248,"_3006":119329},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3550":71718,"_30605":71683,"_21201":119331,"_5":14582,"_27821":119248,"_3006":119332},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3550":71719,"_30605":71683,"_21201":119334,"_5":14582,"_27821":119252,"_3006":119335},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3550":71720,"_30605":71683,"_21201":119337,"_5":14582,"_27821":119252,"_3006":119338},[],"Localiza el pod y Service de authz.",{"_3550":71721,"_30605":71683,"_21201":119340,"_5":14582,"_27821":119252,"_3006":119341},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3550":71722,"_30605":71683,"_21201":119343,"_5":14582,"_27821":119252,"_3006":119344},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3550":71723,"_30605":71683,"_21201":119346,"_5":14582,"_27821":119252,"_3006":119347},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3550":71724,"_30605":71683,"_21201":119349,"_5":14582,"_27821":119252,"_3006":119350},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3550":71725,"_30605":71683,"_21201":119352,"_5":14582,"_27821":119256,"_3006":119353},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3550":71726,"_30605":71683,"_21201":119355,"_5":14582,"_27821":119260,"_3006":119356},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3550":71727,"_30605":71683,"_21201":119358,"_5":14582,"_27821":119260,"_3006":119359},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3550":71728,"_30605":71683,"_21201":119361,"_5":14582,"_27821":119260,"_3006":119362},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3550":71729,"_30605":71683,"_21201":119364,"_5":14582,"_27821":119260,"_3006":119365},[],"volumen persistente sin enlazar;",{"_3550":71730,"_30605":71683,"_21201":119367,"_5":14582,"_27821":119260,"_3006":119368},[],"imagen inaccesible o política de pull incorrecta;",{"_3550":71731,"_30605":71683,"_21201":119370,"_5":14582,"_27821":119260,"_3006":119371},[],"configuración inválida del motor criptográfico;",{"_3550":71732,"_30605":71683,"_21201":119373,"_5":14582,"_27821":119260,"_3006":119374},[],"límites de CPU o memoria demasiado bajos;",{"_3550":71733,"_30605":71683,"_21201":119376,"_5":14582,"_27821":119260,"_3006":119377},[],"migración previa incompleta.",{"_3550":71734,"_30605":71683,"_21201":119379,"_5":14582,"_27821":119260,"_3006":119380},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3550":71735,"_30605":71683,"_21201":119382,"_5":14582,"_27821":119260,"_3006":119383},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3550":71736,"_30605":71683,"_21201":119385,"_5":14582,"_27821":119260,"_3006":119386},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3550":71737,"_30605":71683,"_21201":119388,"_5":14582,"_27821":119264,"_3006":119389},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3550":71738,"_30605":71683,"_21201":119391,"_5":14582,"_27821":119264,"_3006":119392},[],"verifica que esté habilitado en el servicio emisor;",{"_3550":71739,"_30605":71683,"_21201":119394,"_5":14582,"_27821":119264,"_3006":119395},[],"comprueba conectividad y credenciales AMQP;",{"_3550":71740,"_30605":71683,"_21201":119397,"_5":14582,"_27821":119264,"_3006":119398},[],"revisa exchange, routing key, colas y consumidores;",{"_3550":71741,"_30605":71683,"_21201":119400,"_5":14582,"_27821":119264,"_3006":119401},[],"inspecciona dead-letter queues;",{"_3550":71742,"_30605":71683,"_21201":119403,"_5":14582,"_27821":119264,"_3006":119404},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3550":71743,"_30605":71683,"_21201":119406,"_5":14582,"_27821":119264,"_3006":119407},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3550":71744,"_30605":71683,"_21201":119409,"_5":14582,"_27821":119264,"_3006":119410},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3550":71745,"_30605":71683,"_21201":119412,"_5":14582,"_27821":119264,"_3006":119413},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3550":71746,"_30605":71683,"_21201":119415,"_5":14582,"_27821":119264,"_3006":119416},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3550":71747,"_30605":71683,"_21201":119418,"_5":14582,"_27821":119264,"_3006":119419},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3550":71748,"_30605":71683,"_21201":119421,"_5":14582,"_27821":119264,"_3006":119422},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3550":71749,"_30605":71683,"_21201":119424,"_5":14582,"_27821":119264,"_3006":119425},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3550":71750,"_30605":71683,"_21201":119427,"_5":14582,"_27821":119268,"_3006":119428},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3550":71751,"_30605":71683,"_21201":119430,"_5":14582,"_27821":119268,"_3006":119431},[],"Antes de cerrar una incidencia, guarda:",{"_3550":71752,"_30605":71683,"_21201":119433,"_5":14582,"_27821":119268,"_3006":119434},[],"causa confirmada;",{"_3550":71753,"_30605":71683,"_21201":119436,"_5":14582,"_27821":119268,"_3006":119437},[],"alcance temporal y recursos afectados;",{"_3550":71754,"_30605":71683,"_21201":119439,"_5":14582,"_27821":119268,"_3006":119440},[],"comandos o consultas utilizados;",{"_3550":71755,"_30605":71683,"_21201":119442,"_5":14582,"_27821":119268,"_3006":119443},[],"cambio aplicado y forma de revertirlo;",{"_3550":71756,"_30605":71683,"_21201":119445,"_5":14582,"_27821":119268,"_3006":119446},[],"validación desde un consumidor;",{"_3550":71757,"_30605":71683,"_21201":119448,"_5":14582,"_27821":119268,"_3006":119449},[],"acción preventiva y propietario.",{"_3550":71758,"_30605":71758,"_5":14934,"_3006":119451,"_30964":119452,"_21201":119456,"_27821":71758},"Modelo de datos",[49995,119453,119454,119455],"Plataforma","Administración","Control de acceso",[],{"_3550":71759,"_30605":71758,"_21201":119458,"_5":14582,"_27821":71758,"_3006":119459},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3550":71760,"_30605":71758,"_5":30961,"_21201":119461,"_27821":119462,"_3006":119463},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3550":71761,"_30605":71758,"_5":30961,"_21201":119465,"_27821":119466,"_3006":119467},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3550":71762,"_30605":71758,"_21201":119469,"_5":14582,"_27821":71758,"_3006":119470},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3550":71763,"_30605":71758,"_21201":119472,"_5":14582,"_27821":119462,"_3006":119473},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3550":71764,"_30605":71758,"_21201":119475,"_5":14582,"_27821":119462,"_3006":119476},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3550":71765,"_30605":71758,"_21201":119478,"_5":14582,"_27821":119462,"_3006":119479},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3550":71766,"_30605":71758,"_21201":119481,"_5":14582,"_27821":119466,"_3006":119482},[],"Entidad (`schema_name.entity_type`)",{"_3550":71767,"_30605":71758,"_21201":119484,"_5":14582,"_27821":119466,"_3006":119485},[],"Tabla (`table_name`)",{"_3550":71768,"_30605":71758,"_21201":119487,"_5":14582,"_27821":119466,"_3006":119488},[],"Clave (`primary_key`)",{"_3550":71769,"_30605":71758,"_21201":119490,"_5":14582,"_27821":119466,"_3006":51508},[],{"_3550":71770,"_30605":71758,"_21201":119492,"_5":14582,"_27821":119466,"_3006":51511},[],{"_3550":71771,"_30605":71758,"_21201":119494,"_5":14582,"_27821":119466,"_3006":51514},[],{"_3550":71772,"_30605":71758,"_21201":119496,"_5":14582,"_27821":119466,"_3006":51517},[],{"_3550":71773,"_30605":71758,"_21201":119498,"_5":14582,"_27821":119466,"_3006":51520},[],{"_3550":71774,"_30605":71758,"_21201":119500,"_5":14582,"_27821":119466,"_3006":51523},[],{"_3550":71775,"_30605":71758,"_21201":119502,"_5":14582,"_27821":119466,"_3006":51526},[],{"_3550":71776,"_30605":71758,"_21201":119504,"_5":14582,"_27821":119466,"_3006":51529},[],{"_3550":71777,"_30605":71758,"_21201":119506,"_5":14582,"_27821":119466,"_3006":51523},[],{"_3550":71778,"_30605":71758,"_21201":119508,"_5":14582,"_27821":119466,"_3006":51534},[],{"_3550":71779,"_30605":71758,"_21201":119510,"_5":14582,"_27821":119466,"_3006":51537},[],{"_3550":71780,"_30605":71758,"_21201":119512,"_5":14582,"_27821":119466,"_3006":51540},[],{"_3550":71781,"_30605":71758,"_21201":119514,"_5":14582,"_27821":119466,"_3006":51543},[],{"_3550":71782,"_30605":71758,"_21201":119516,"_5":14582,"_27821":119466,"_3006":51546},[],{"_3550":71783,"_30605":71758,"_21201":119518,"_5":14582,"_27821":119466,"_3006":51523},[],{"_3550":71784,"_30605":71758,"_21201":119520,"_5":14582,"_27821":119466,"_3006":51551},[],{"_3550":71785,"_30605":71758,"_21201":119522,"_5":14582,"_27821":119466,"_3006":51554},[],{"_3550":71786,"_30605":71758,"_21201":119524,"_5":14582,"_27821":119466,"_3006":51523},[],{"_3550":71787,"_30605":71758,"_21201":119526,"_5":14582,"_27821":119466,"_3006":51559},[],{"_3550":71788,"_30605":71758,"_21201":119528,"_5":14582,"_27821":119466,"_3006":51562},[],{"_3550":71789,"_30605":71758,"_21201":119530,"_5":14582,"_27821":119466,"_3006":51523},[],{"_3550":71790,"_30605":71758,"_21201":119532,"_5":14582,"_27821":119466,"_3006":51567},[],{"_3550":71791,"_30605":71758,"_21201":119534,"_5":14582,"_27821":119466,"_3006":51570},[],{"_3550":71792,"_30605":71758,"_21201":119536,"_5":14582,"_27821":119466,"_3006":51523},[],{"_3550":71793,"_30605":71758,"_21201":119538,"_5":14582,"_27821":119466,"_3006":51575},[],{"_3550":71794,"_30605":71758,"_21201":119540,"_5":14582,"_27821":119466,"_3006":51578},[],{"_3550":71795,"_30605":71758,"_21201":119542,"_5":14582,"_27821":119466,"_3006":51581},[],{"_3550":71796,"_30605":71758,"_21201":119544,"_5":14582,"_27821":119466,"_3006":51584},[],{"_3550":71797,"_30605":71758,"_21201":119546,"_5":14582,"_27821":119466,"_3006":51587},[],{"_3550":71798,"_30605":71758,"_21201":119548,"_5":14582,"_27821":119466,"_3006":51590},[],{"_3550":71799,"_30605":71758,"_21201":119550,"_5":14582,"_27821":119466,"_3006":119551},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3550":71800,"_30605":71758,"_21201":119553,"_5":14582,"_27821":119466,"_3006":119554},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3550":71801,"_30605":71758,"_21201":119556,"_5":14582,"_27821":119466,"_3006":119557},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3550":71802,"_30605":71802,"_5":14934,"_3006":119559,"_30964":119560,"_21201":119561,"_27821":71802},"Visión general del control de acceso",[49995,119453,119454,119455],[],{"_3550":71803,"_30605":71802,"_21201":119563,"_5":14582,"_27821":71802,"_3006":119564},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3550":71804,"_30605":71802,"_5":30961,"_21201":119566,"_27821":119567,"_3006":119568},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3550":71805,"_30605":71802,"_5":30961,"_21201":119570,"_27821":119571,"_3006":119572},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3550":71806,"_30605":71802,"_5":30961,"_21201":119574,"_27821":119575,"_3006":119576},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3550":71807,"_30605":71802,"_5":30961,"_21201":119578,"_27821":119579,"_3006":119580},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3550":71808,"_30605":71802,"_5":30961,"_21201":119582,"_27821":119583,"_3006":119584},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3550":71809,"_30605":71802,"_5":30961,"_21201":119586,"_27821":119587,"_3006":119588},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3550":71810,"_30605":71802,"_5":30961,"_21201":119590,"_27821":119591,"_3006":119592},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3550":71811,"_30605":71802,"_5":30961,"_21201":119594,"_27821":119595,"_3006":119596},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3550":71812,"_30605":71802,"_5":30961,"_21201":119598,"_27821":119599,"_3006":119600},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3550":71813,"_30605":71802,"_5":30961,"_21201":119602,"_27821":119603,"_3006":119604},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3550":71814,"_30605":71802,"_5":30961,"_21201":119606,"_27821":119607,"_3006":119608},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3550":71815,"_30605":71802,"_5":30961,"_21201":119610,"_27821":119611,"_3006":119612},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3550":71816,"_30605":71802,"_5":30961,"_21201":119614,"_27821":119615,"_3006":119616},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3550":71817,"_30605":71802,"_5":30961,"_21201":119618,"_27821":119619,"_3006":119620},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3550":71818,"_30605":71802,"_5":30961,"_21201":119622,"_27821":119623,"_3006":119624},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3550":71819,"_30605":71802,"_5":30961,"_21201":119626,"_27821":119627,"_3006":118621},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3550":71820,"_30605":71802,"_5":30961,"_21201":119629,"_27821":119630,"_3006":119631},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3550":71821,"_30605":71802,"_5":30961,"_21201":119633,"_27821":119634,"_3006":119635},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3550":71822,"_30605":71802,"_5":30961,"_21201":119637,"_27821":119638,"_3006":119639},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3550":71823,"_30605":71802,"_5":30961,"_21201":119641,"_27821":119642,"_3006":119643},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3550":71824,"_30605":71802,"_5":30961,"_21201":119645,"_27821":119646,"_3006":119647},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3550":71825,"_30605":71802,"_5":30961,"_21201":119649,"_27821":119650,"_3006":119651},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3550":71826,"_30605":71802,"_5":30961,"_21201":119653,"_27821":119654,"_3006":119655},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3550":71827,"_30605":71802,"_5":30961,"_21201":119657,"_27821":119658,"_3006":119659},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3550":71828,"_30605":71802,"_5":30961,"_21201":119661,"_27821":119662,"_3006":119663},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3550":71829,"_30605":71802,"_5":30961,"_21201":119665,"_27821":119666,"_3006":119667},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3550":71830,"_30605":71802,"_5":30961,"_21201":119669,"_27821":119670,"_3006":119671},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3550":71831,"_30605":71802,"_5":30961,"_21201":119673,"_27821":119674,"_3006":119675},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3550":71832,"_30605":71802,"_5":30961,"_21201":119677,"_27821":119678,"_3006":119679},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3550":71833,"_30605":71802,"_5":30961,"_21201":119681,"_27821":119682,"_3006":119683},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3550":71834,"_30605":71802,"_5":30961,"_21201":119685,"_27821":119686,"_3006":119687},[],"/docs/pr-preview/pr-66/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3550":71835,"_30605":71802,"_21201":119689,"_5":14582,"_27821":71802,"_3006":119690},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3550":71836,"_30605":71802,"_21201":119692,"_5":14582,"_27821":71802,"_3006":119693},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3550":71837,"_30605":71802,"_21201":119695,"_5":14582,"_27821":71802,"_3006":119696},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3550":71838,"_30605":71802,"_21201":119698,"_5":14582,"_27821":119567,"_3006":119699},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3550":71839,"_30605":71802,"_21201":119701,"_5":14582,"_27821":119567,"_3006":119702},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3550":71840,"_30605":71802,"_21201":119704,"_5":14582,"_27821":119567,"_3006":119705},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3550":71841,"_30605":71802,"_21201":119707,"_5":14582,"_27821":119567,"_3006":119708},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3550":71842,"_30605":71802,"_21201":119710,"_5":14582,"_27821":119567,"_3006":119711},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3550":71843,"_30605":71802,"_21201":119713,"_5":14582,"_27821":119567,"_3006":119714},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3550":71844,"_30605":71802,"_21201":119716,"_5":14582,"_27821":119571,"_3006":119717},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3550":71845,"_30605":71802,"_21201":119719,"_5":14582,"_27821":119571,"_3006":119720},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3550":71846,"_30605":71802,"_21201":119722,"_5":14582,"_27821":119575,"_3006":119723},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3550":71847,"_30605":71802,"_21201":119725,"_5":14582,"_27821":119575,"_3006":119726},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3550":71848,"_30605":71802,"_21201":119728,"_5":14582,"_27821":119575,"_3006":119729},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3550":71849,"_30605":71802,"_21201":119731,"_5":14582,"_27821":119575,"_3006":119732},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3550":71850,"_30605":71802,"_21201":119734,"_5":14582,"_27821":119575,"_3006":119735},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3550":71851,"_30605":71802,"_21201":119737,"_5":14582,"_27821":119575,"_3006":119738},[],"Carga por separado las políticas concedidas a cada principal.",{"_3550":71852,"_30605":71802,"_21201":119740,"_5":14582,"_27821":119575,"_3006":119741},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3550":71853,"_30605":71802,"_21201":119743,"_5":14582,"_27821":119575,"_3006":119744},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3550":71854,"_30605":71802,"_21201":119746,"_5":14582,"_27821":119575,"_3006":119747},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3550":71855,"_30605":71802,"_21201":119749,"_5":14582,"_27821":119575,"_3006":119750},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3550":71856,"_30605":71802,"_21201":119752,"_5":14582,"_27821":119575,"_3006":119753},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3550":71857,"_30605":71802,"_21201":119755,"_5":14582,"_27821":119575,"_3006":119756},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3550":71858,"_30605":71802,"_21201":119758,"_5":14582,"_27821":119579,"_3006":119759},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3550":71859,"_30605":71802,"_21201":119761,"_5":14582,"_27821":119579,"_3006":119762},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3550":71860,"_30605":71802,"_21201":119764,"_5":14582,"_27821":119579,"_3006":119765},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3550":71861,"_30605":71802,"_21201":119767,"_5":14582,"_27821":119579,"_3006":119768},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3550":71862,"_30605":71802,"_21201":119770,"_5":14582,"_27821":119579,"_3006":119771},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3550":71863,"_30605":71802,"_21201":119773,"_5":14582,"_27821":119579,"_3006":119774},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3550":71864,"_30605":71802,"_21201":119776,"_5":14582,"_27821":119579,"_3006":119777},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3550":71865,"_30605":71802,"_21201":119779,"_5":14582,"_27821":119579,"_3006":119780},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3550":71866,"_30605":71802,"_21201":119782,"_5":14582,"_27821":119583,"_3006":119783},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3550":71867,"_30605":71802,"_21201":119785,"_5":14582,"_27821":119583,"_3006":119786},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3550":71868,"_30605":71802,"_21201":119788,"_5":14582,"_27821":119583,"_3006":119789},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3550":71869,"_30605":71802,"_21201":119791,"_5":14582,"_27821":119583,"_3006":119792},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3550":71870,"_30605":71802,"_21201":119794,"_5":14582,"_27821":119583,"_3006":119795},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3550":71871,"_30605":71802,"_21201":119797,"_5":14582,"_27821":119583,"_3006":119798},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3550":71872,"_30605":71802,"_21201":119800,"_5":14582,"_27821":119583,"_3006":119801},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3550":71873,"_30605":71802,"_21201":119803,"_5":14582,"_27821":119583,"_3006":119804},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3550":71874,"_30605":71802,"_21201":119806,"_5":14582,"_27821":119583,"_3006":119807},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3550":71875,"_30605":71802,"_21201":119809,"_5":14582,"_27821":119583,"_3006":119810},[],"Las acciones se dividen en dos grupos:",{"_3550":71876,"_30605":71802,"_21201":119812,"_5":14582,"_27821":119583,"_3006":119813},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3550":71877,"_30605":71802,"_21201":119815,"_5":14582,"_27821":119583,"_3006":119816},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3550":71878,"_30605":71802,"_21201":119818,"_5":14582,"_27821":119583,"_3006":119819},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3550":71879,"_30605":71802,"_21201":119821,"_5":14582,"_27821":119587,"_3006":119822},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3550":71880,"_30605":71802,"_21201":119824,"_5":14582,"_27821":119587,"_3006":119825},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3550":71881,"_30605":71802,"_21201":119827,"_5":14582,"_27821":119587,"_3006":119828},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3550":71882,"_30605":71802,"_21201":119830,"_5":14582,"_27821":119591,"_3006":119831},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3550":71883,"_30605":71802,"_21201":119833,"_5":14582,"_27821":119591,"_3006":119834},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3550":71884,"_30605":71802,"_21201":119836,"_5":14582,"_27821":119591,"_3006":119837},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3550":71885,"_30605":71802,"_21201":119839,"_5":14582,"_27821":119591,"_3006":119840},[],"Los operadores implementados son:",{"_3550":71886,"_30605":71802,"_21201":119842,"_5":14582,"_27821":119591,"_3006":119843},[],"`equals`, para igualdad exacta;",{"_3550":71887,"_30605":71802,"_21201":119845,"_5":14582,"_27821":119591,"_3006":119846},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3550":71888,"_30605":71802,"_21201":119848,"_5":14582,"_27821":119591,"_3006":119849},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3550":71889,"_30605":71802,"_21201":119851,"_5":14582,"_27821":119591,"_3006":119852},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3550":71890,"_30605":71802,"_21201":119854,"_5":14582,"_27821":119595,"_3006":119855},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3550":71891,"_30605":71802,"_21201":119857,"_5":14582,"_27821":119595,"_3006":119858},[],"Los modos disponibles son:",{"_3550":71892,"_30605":71802,"_21201":119860,"_5":14582,"_27821":119595,"_3006":119861},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3550":71893,"_30605":71802,"_21201":119863,"_5":14582,"_27821":119595,"_3006":119864},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3550":71894,"_30605":71802,"_21201":119866,"_5":14582,"_27821":119595,"_3006":119867},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3550":71895,"_30605":71802,"_21201":119869,"_5":14582,"_27821":119595,"_3006":119870},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3550":71896,"_30605":71802,"_21201":119872,"_5":14582,"_27821":119595,"_3006":119873},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3550":71897,"_30605":71802,"_21201":119875,"_5":14582,"_27821":119595,"_3006":119876},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3550":71898,"_30605":71802,"_21201":119878,"_5":14582,"_27821":119599,"_3006":119879},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3550":71899,"_30605":71802,"_21201":119881,"_5":14582,"_27821":119599,"_3006":119882},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3550":71900,"_30605":71802,"_21201":119884,"_5":14582,"_27821":119599,"_3006":119885},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3550":71901,"_30605":71802,"_21201":119887,"_5":14582,"_27821":119599,"_3006":119888},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3550":71902,"_30605":71802,"_21201":119890,"_5":14582,"_27821":119607,"_3006":119891},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3550":71903,"_30605":71802,"_21201":119893,"_5":14582,"_27821":119607,"_3006":119894},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3550":71904,"_30605":71802,"_21201":119896,"_5":14582,"_27821":119611,"_3006":119897},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3550":71905,"_30605":71802,"_21201":119899,"_5":14582,"_27821":119611,"_3006":119900},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3550":71906,"_30605":71802,"_21201":119902,"_5":14582,"_27821":119611,"_3006":119903},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3550":71907,"_30605":71802,"_21201":119905,"_5":14582,"_27821":119611,"_3006":119906},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3550":71908,"_30605":71802,"_21201":119908,"_5":14582,"_27821":119611,"_3006":119909},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3550":71909,"_30605":71802,"_21201":119911,"_5":14582,"_27821":119615,"_3006":119912},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3550":71910,"_30605":71802,"_21201":119914,"_5":14582,"_27821":119615,"_3006":119915},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3550":71911,"_30605":71802,"_21201":119917,"_5":14582,"_27821":119615,"_3006":119918},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3550":71912,"_30605":71802,"_21201":119920,"_5":14582,"_27821":119619,"_3006":119921},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3550":71913,"_30605":71802,"_21201":119923,"_5":14582,"_27821":119619,"_3006":119924},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3550":71914,"_30605":71802,"_21201":119926,"_5":14582,"_27821":119619,"_3006":119927},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3550":71915,"_30605":71802,"_21201":119929,"_5":14582,"_27821":119619,"_3006":119930},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3550":71916,"_30605":71802,"_21201":119932,"_5":14582,"_27821":119619,"_3006":119933},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3550":71917,"_30605":71802,"_21201":119935,"_5":14582,"_27821":119619,"_3006":119936},[],"Ten en cuenta que:",{"_3550":71918,"_30605":71802,"_21201":119938,"_5":14582,"_27821":119619,"_3006":119939},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3550":71919,"_30605":71802,"_21201":119941,"_5":14582,"_27821":119619,"_3006":119942},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3550":71920,"_30605":71802,"_21201":119944,"_5":14582,"_27821":119619,"_3006":119945},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3550":71921,"_30605":71802,"_21201":119947,"_5":14582,"_27821":119623,"_3006":119948},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3550":71922,"_30605":71802,"_21201":119950,"_5":14582,"_27821":119623,"_3006":119951},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3550":71923,"_30605":71802,"_21201":119953,"_5":14582,"_27821":119623,"_3006":119954},[],"acceso completo y de solo lectura a KMS;",{"_3550":71924,"_30605":71802,"_21201":119956,"_5":14582,"_27821":119623,"_3006":119957},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3550":71925,"_30605":71802,"_21201":119959,"_5":14582,"_27821":119623,"_3006":119960},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3550":71926,"_30605":71802,"_21201":119962,"_5":14582,"_27821":119623,"_3006":119963},[],"acceso a la interfaz;",{"_3550":71927,"_30605":71802,"_21201":119965,"_5":14582,"_27821":119623,"_3006":119966},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3550":71928,"_30605":71802,"_21201":119968,"_5":14582,"_27821":119623,"_3006":119969},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3550":71929,"_30605":71802,"_21201":119971,"_5":14582,"_27821":119623,"_3006":119972},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3550":71930,"_30605":71802,"_21201":119974,"_5":14582,"_27821":119627,"_3006":119975},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3550":71931,"_30605":71802,"_21201":119977,"_5":14582,"_27821":119627,"_3006":119978},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3550":71932,"_30605":71802,"_21201":119980,"_5":14582,"_27821":119627,"_3006":119981},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3550":71933,"_30605":71802,"_21201":119983,"_5":14582,"_27821":119630,"_3006":119984},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3550":71934,"_30605":71802,"_21201":119986,"_5":14582,"_27821":119634,"_3006":119987},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3550":71935,"_30605":71802,"_21201":119989,"_5":14582,"_27821":119634,"_3006":119990},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3550":71936,"_30605":71802,"_21201":119992,"_5":14582,"_27821":119638,"_3006":119993},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3550":71937,"_30605":71802,"_21201":119995,"_5":14582,"_27821":119642,"_3006":119996},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3550":71938,"_30605":71802,"_21201":119998,"_5":14582,"_27821":119646,"_3006":119999},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3550":71939,"_30605":71802,"_21201":120001,"_5":14582,"_27821":119650,"_3006":120002},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3550":71940,"_30605":71802,"_21201":120004,"_5":14582,"_27821":119650,"_3006":120005},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3550":71941,"_30605":71802,"_21201":120007,"_5":14582,"_27821":119654,"_3006":120008},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3550":71942,"_30605":71802,"_21201":120010,"_5":14582,"_27821":119654,"_3006":120011},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3550":71943,"_30605":71802,"_21201":120013,"_5":14582,"_27821":119654,"_3006":120014},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3550":71944,"_30605":71802,"_21201":120016,"_5":14582,"_27821":119654,"_3006":120017},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3550":71945,"_30605":71802,"_21201":120019,"_5":14582,"_27821":119654,"_3006":120020},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3550":71946,"_30605":71802,"_21201":120022,"_5":14582,"_27821":119654,"_3006":120023},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3550":71947,"_30605":71802,"_21201":120025,"_5":14582,"_27821":119654,"_3006":120026},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3550":71948,"_30605":71802,"_21201":120028,"_5":14582,"_27821":119654,"_3006":120029},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3550":71949,"_30605":71802,"_21201":120031,"_5":14582,"_27821":119658,"_3006":120032},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3550":71950,"_30605":71802,"_21201":120034,"_5":14582,"_27821":119658,"_3006":120035},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3550":71951,"_30605":71802,"_21201":120037,"_5":14582,"_27821":119658,"_3006":120038},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3550":71952,"_30605":71802,"_21201":120040,"_5":14582,"_27821":119662,"_3006":120041},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3550":71953,"_30605":71802,"_21201":120043,"_5":14582,"_27821":119662,"_3006":120044},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3550":71954,"_30605":71802,"_21201":120046,"_5":14582,"_27821":119662,"_3006":120047},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3550":71955,"_30605":71802,"_21201":120049,"_5":14582,"_27821":119662,"_3006":120050},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3550":71956,"_30605":71802,"_21201":120052,"_5":14582,"_27821":119662,"_3006":120053},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3550":71957,"_30605":71802,"_21201":120055,"_5":14582,"_27821":119662,"_3006":120056},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3550":71958,"_30605":71802,"_21201":120058,"_5":14582,"_27821":119662,"_3006":120059},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3550":71959,"_30605":71802,"_21201":120061,"_5":14582,"_27821":119662,"_3006":120062},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3550":71960,"_30605":71802,"_21201":120064,"_5":14582,"_27821":119670,"_3006":120065},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3550":71961,"_30605":71802,"_21201":120067,"_5":14582,"_27821":119674,"_3006":120068},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3550":71962,"_30605":71802,"_21201":120070,"_5":14582,"_27821":119674,"_3006":120071},[],"que exista un principal activo del tipo correcto;",{"_3550":71963,"_30605":71802,"_21201":120073,"_5":14582,"_27821":119674,"_3006":120074},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3550":71964,"_30605":71802,"_21201":120076,"_5":14582,"_27821":119674,"_3006":120077},[],"que todas las condiciones del principal se cumplan;",{"_3550":71965,"_30605":71802,"_21201":120079,"_5":14582,"_27821":119674,"_3006":120080},[],"que el principal tenga concedida la política esperada;",{"_3550":71966,"_30605":71802,"_21201":120082,"_5":14582,"_27821":119674,"_3006":120083},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3550":71967,"_30605":71802,"_21201":120085,"_5":14582,"_27821":119674,"_3006":120086},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3550":71968,"_30605":71802,"_21201":120088,"_5":14582,"_27821":119674,"_3006":120089},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3550":71969,"_30605":71802,"_21201":120091,"_5":14582,"_27821":119674,"_3006":120092},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3550":71970,"_30605":71802,"_21201":120094,"_5":14582,"_27821":119678,"_3006":120095},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3550":71971,"_30605":71802,"_21201":120097,"_5":14582,"_27821":119682,"_3006":120098},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3550":71972,"_30605":71802,"_21201":120100,"_5":14582,"_27821":119686,"_3006":120101},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3550":71973,"_30605":71802,"_21201":120103,"_5":14582,"_27821":119686,"_3006":120104},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3550":71974,"_30605":71974,"_5":14934,"_3006":120106,"_30964":120107,"_21201":120108,"_27821":71974},"Alertas y suscripciones",[49995,119453,119454],[],{"_3550":71975,"_30605":71974,"_21201":120110,"_5":14582,"_27821":71974,"_3006":120111},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3550":71976,"_30605":71974,"_5":30961,"_21201":120113,"_27821":120114,"_3006":120115},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3550":71977,"_30605":71974,"_5":30961,"_21201":120117,"_27821":120118,"_3006":120119},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3550":71978,"_30605":71974,"_5":30961,"_21201":120121,"_27821":120122,"_3006":120123},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3550":71979,"_30605":71974,"_5":30961,"_21201":120125,"_27821":120126,"_3006":120127},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3550":71980,"_30605":71974,"_5":30961,"_21201":120129,"_27821":120130,"_3006":120131},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3550":71981,"_30605":71974,"_5":30961,"_21201":120133,"_27821":120134,"_3006":120135},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3550":71982,"_30605":71974,"_5":30961,"_21201":120137,"_27821":120138,"_3006":120139},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3550":71983,"_30605":71974,"_5":30961,"_21201":120141,"_27821":120142,"_3006":120143},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3550":71984,"_30605":71974,"_5":30961,"_21201":120145,"_27821":120146,"_3006":120147},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3550":71985,"_30605":71974,"_5":30961,"_21201":120149,"_27821":120150,"_3006":120151},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3550":71986,"_30605":71974,"_5":30961,"_21201":120153,"_27821":120154,"_3006":120155},[],"/docs/pr-preview/pr-66/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3550":71987,"_30605":71974,"_21201":120157,"_5":14582,"_27821":71974,"_3006":120158},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3550":71988,"_30605":71974,"_21201":120160,"_5":14582,"_27821":120114,"_3006":120161},[],"Un servicio publica un evento de dominio.",{"_3550":71989,"_30605":71974,"_21201":120163,"_5":14582,"_27821":120114,"_3006":120164},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3550":71990,"_30605":71974,"_21201":120166,"_5":14582,"_27821":120114,"_3006":120167},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3550":71991,"_30605":71974,"_21201":120169,"_5":14582,"_27821":120114,"_3006":120170},[],"Lamassu entrega el evento al canal configurado.",{"_3550":71992,"_30605":71974,"_21201":120172,"_5":14582,"_27821":120114,"_3006":120173},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3550":71993,"_30605":71974,"_21201":120175,"_5":14582,"_27821":120118,"_3006":120176},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3550":71994,"_30605":71974,"_21201":120178,"_5":14582,"_27821":120118,"_3006":120179},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3550":71995,"_30605":71974,"_21201":120181,"_5":14582,"_27821":120118,"_3006":120182},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3550":71996,"_30605":71974,"_21201":120184,"_5":14582,"_27821":120118,"_3006":120185},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3550":71997,"_30605":71974,"_21201":120187,"_5":14582,"_27821":120118,"_3006":120188},[],"`apikey_options` necesita `header` y `key`.",{"_3550":71998,"_30605":71974,"_21201":120190,"_5":14582,"_27821":120118,"_3006":120191},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3550":71999,"_30605":71974,"_21201":120193,"_5":14582,"_27821":120118,"_3006":120194},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3550":72000,"_30605":71974,"_21201":120196,"_5":14582,"_27821":120118,"_3006":120197},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3550":72001,"_30605":71974,"_21201":120199,"_5":14582,"_27821":120126,"_3006":120200},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3550":72002,"_30605":71974,"_21201":120202,"_5":14582,"_27821":120130,"_3006":120203},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3550":72003,"_30605":71974,"_21201":120205,"_5":14582,"_27821":120134,"_3006":120206},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3550":72004,"_30605":71974,"_21201":120208,"_5":14582,"_27821":120134,"_3006":120209},[],"**None** notifica todas las instancias del evento.",{"_3550":72005,"_30605":71974,"_21201":120211,"_5":14582,"_27821":120134,"_3006":120212},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3550":72006,"_30605":71974,"_21201":120214,"_5":14582,"_27821":120134,"_3006":120215},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3550":72007,"_30605":71974,"_21201":120217,"_5":14582,"_27821":120134,"_3006":120218},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3550":72008,"_30605":71974,"_21201":120220,"_5":14582,"_27821":120134,"_3006":120221},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3550":72009,"_30605":71974,"_21201":120223,"_5":14582,"_27821":120134,"_3006":120224},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3550":72010,"_30605":71974,"_21201":120226,"_5":14582,"_27821":120138,"_3006":120227},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3550":72011,"_30605":71974,"_21201":120229,"_5":14582,"_27821":120142,"_3006":120230},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3550":72012,"_30605":71974,"_21201":120232,"_5":14582,"_27821":120142,"_3006":120233},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3550":72013,"_30605":71974,"_21201":120235,"_5":14582,"_27821":120142,"_3006":120236},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3550":72014,"_30605":71974,"_21201":120238,"_5":14582,"_27821":120142,"_3006":120239},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3550":72015,"_30605":71974,"_21201":120241,"_5":14582,"_27821":120142,"_3006":120242},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3550":72016,"_30605":71974,"_21201":120244,"_5":14582,"_27821":120142,"_3006":120245},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3550":72017,"_30605":71974,"_21201":120247,"_5":14582,"_27821":120142,"_3006":120248},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3550":72018,"_30605":71974,"_21201":120250,"_5":14582,"_27821":120142,"_3006":120251},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3550":72019,"_30605":71974,"_21201":120253,"_5":14582,"_27821":120146,"_3006":120254},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3550":72020,"_30605":71974,"_21201":120256,"_5":14582,"_27821":120146,"_3006":120257},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3550":72021,"_30605":71974,"_21201":120259,"_5":14582,"_27821":120146,"_3006":120260},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3550":72022,"_30605":71974,"_21201":120262,"_5":14582,"_27821":120146,"_3006":120263},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3550":72023,"_30605":71974,"_21201":120265,"_5":14582,"_27821":120146,"_3006":120266},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3550":72024,"_30605":71974,"_21201":120268,"_5":14582,"_27821":120146,"_3006":120269},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3550":72025,"_30605":71974,"_21201":120271,"_5":14582,"_27821":120146,"_3006":120272},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3550":72026,"_30605":71974,"_21201":120274,"_5":14582,"_27821":120146,"_3006":120275},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3550":72027,"_30605":71974,"_21201":120277,"_5":14582,"_27821":120150,"_3006":120278},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3550":72028,"_30605":71974,"_21201":120280,"_5":14582,"_27821":120150,"_3006":120281},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3550":72029,"_30605":71974,"_21201":120283,"_5":14582,"_27821":120154,"_3006":120284},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3550":72030,"_30605":71974,"_21201":120286,"_5":14582,"_27821":120154,"_3006":120287},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3550":72031,"_30605":71974,"_21201":120289,"_5":14582,"_27821":120154,"_3006":120290},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3550":72032,"_30605":71974,"_21201":120292,"_5":14582,"_27821":120154,"_3006":120293},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3550":72033,"_30605":71974,"_21201":120295,"_5":14582,"_27821":120154,"_3006":120296},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3550":72034,"_30605":71974,"_21201":120298,"_5":14582,"_27821":120154,"_3006":120299},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3550":72035,"_30605":71974,"_21201":120301,"_5":14582,"_27821":120154,"_3006":120302},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3550":72036,"_30605":71974,"_21201":120304,"_5":14582,"_27821":120154,"_3006":120305},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3550":72037,"_30605":71974,"_21201":120307,"_5":14582,"_27821":120154,"_3006":120308},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3550":72038,"_30605":71974,"_21201":120310,"_5":14582,"_27821":120154,"_3006":120311},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3550":72039,"_30605":72039,"_5":14934,"_3006":120313,"_30964":120314,"_21201":120315,"_27821":72039},"Registros de auditoría",[49995,119453,119454],[],{"_3550":72040,"_30605":72039,"_21201":120317,"_5":14582,"_27821":72039,"_3006":120318},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3550":72041,"_30605":72039,"_5":30961,"_21201":120320,"_27821":120321,"_3006":120322},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3550":72042,"_30605":72039,"_5":30961,"_21201":120324,"_27821":120325,"_3006":120326},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3550":72043,"_30605":72039,"_5":30961,"_21201":120328,"_27821":120329,"_3006":120330},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3550":72044,"_30605":72039,"_5":30961,"_21201":120332,"_27821":120333,"_3006":120334},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3550":72045,"_30605":72039,"_5":30961,"_21201":120336,"_27821":120337,"_3006":120338},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3550":72046,"_30605":72039,"_5":30961,"_21201":120340,"_27821":120341,"_3006":120342},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3550":72047,"_30605":72039,"_5":30961,"_21201":120344,"_27821":120345,"_3006":120346},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3550":72048,"_30605":72039,"_5":30961,"_21201":120348,"_27821":120349,"_3006":120350},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3550":72049,"_30605":72039,"_5":30961,"_21201":120352,"_27821":120353,"_3006":120354},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3550":72050,"_30605":72039,"_5":30961,"_21201":120356,"_27821":120357,"_3006":120358},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3550":72051,"_30605":72039,"_5":30961,"_21201":120360,"_27821":120361,"_3006":120362},[],"/docs/pr-preview/pr-66/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3550":72052,"_30605":72039,"_21201":120364,"_5":14582,"_27821":72039,"_3006":120365},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3550":72053,"_30605":72039,"_21201":120367,"_5":14582,"_27821":120321,"_3006":120368},[],"El cuerpo de auditoría incluye:",{"_3550":72054,"_30605":72039,"_21201":120370,"_5":14582,"_27821":120321,"_3006":120371},[],"input: datos recibidos por la operación;",{"_3550":72055,"_30605":72039,"_21201":120373,"_5":14582,"_27821":120321,"_3006":120374},[],"has\\_error: indica si el servicio devolvió un error;",{"_3550":72056,"_30605":72039,"_21201":120376,"_5":14582,"_27821":120321,"_3006":120377},[],"output: resultado producido o mensaje de error;",{"_3550":72057,"_30605":72039,"_21201":120379,"_5":14582,"_27821":120321,"_3006":120380},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3550":72058,"_30605":72039,"_21201":120382,"_5":14582,"_27821":120321,"_3006":120383},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3550":72059,"_30605":72039,"_21201":120385,"_5":14582,"_27821":120321,"_3006":120386},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3550":72060,"_30605":72039,"_21201":120388,"_5":14582,"_27821":120325,"_3006":120389},[],"El backend aplica auditoría a mutaciones de:",{"_3550":72061,"_30605":72039,"_21201":120391,"_5":14582,"_27821":120325,"_3006":120392},[],"autoridades, certificados y perfiles de emisión;",{"_3550":72062,"_30605":72039,"_21201":120394,"_5":14582,"_27821":120325,"_3006":120395},[],"claves y motores KMS;",{"_3550":72063,"_30605":72039,"_21201":120397,"_5":14582,"_27821":120325,"_3006":120398},[],"dispositivos e identidades;",{"_3550":72064,"_30605":72039,"_21201":120400,"_5":14582,"_27821":120325,"_3006":120401},[],"DMS y operaciones de enrolamiento;",{"_3550":72065,"_30605":72039,"_21201":120403,"_5":14582,"_27821":120325,"_3006":120404},[],"funciones de validación y CRL;",{"_3550":72066,"_30605":72039,"_21201":120406,"_5":14582,"_27821":120325,"_3006":120407},[],"principales, políticas y concesiones de autorización.",{"_3550":72067,"_30605":72039,"_21201":120409,"_5":14582,"_27821":120325,"_3006":120410},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3550":72068,"_30605":72039,"_21201":120412,"_5":14582,"_27821":120329,"_3006":120413},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3550":72069,"_30605":72039,"_21201":120415,"_5":14582,"_27821":120329,"_3006":120416},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3550":72070,"_30605":72039,"_21201":120418,"_5":14582,"_27821":120329,"_3006":120419},[],"Diseña el consumidor para:",{"_3550":72071,"_30605":72039,"_21201":120421,"_5":14582,"_27821":120329,"_3006":120422},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3550":72072,"_30605":72039,"_21201":120424,"_5":14582,"_27821":120329,"_3006":120425},[],"conservar el CloudEvent completo sin modificar;",{"_3550":72073,"_30605":72039,"_21201":120427,"_5":14582,"_27821":120329,"_3006":120428},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3550":72074,"_30605":72039,"_21201":120430,"_5":14582,"_27821":120329,"_3006":120431},[],"cifrar en tránsito y en reposo;",{"_3550":72075,"_30605":72039,"_21201":120433,"_5":14582,"_27821":120329,"_3006":120434},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3550":72076,"_30605":72039,"_21201":120436,"_5":14582,"_27821":120329,"_3006":120437},[],"aplicar una política explícita de retención y legal hold;",{"_3550":72077,"_30605":72039,"_21201":120439,"_5":14582,"_27821":120329,"_3006":120440},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3550":72078,"_30605":72039,"_21201":120442,"_5":14582,"_27821":120333,"_3006":120443},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3550":72079,"_30605":72039,"_21201":120445,"_5":14582,"_27821":120333,"_3006":120446},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3550":72080,"_30605":72039,"_21201":120448,"_5":14582,"_27821":120341,"_3006":120449},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3550":72081,"_30605":72039,"_21201":120451,"_5":14582,"_27821":120345,"_3006":120452},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3550":72082,"_30605":72039,"_21201":120454,"_5":14582,"_27821":120349,"_3006":120455},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3550":72083,"_30605":72039,"_21201":120457,"_5":14582,"_27821":120353,"_3006":120458},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3550":72084,"_30605":72039,"_21201":120460,"_5":14582,"_27821":120357,"_3006":120461},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3550":72085,"_30605":72039,"_21201":120463,"_5":14582,"_27821":120361,"_3006":120464},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3550":72086,"_30605":72039,"_21201":120466,"_5":14582,"_27821":120361,"_3006":120467},[],"aparece un evento de auditoría correcto;",{"_3550":72087,"_30605":72039,"_21201":120469,"_5":14582,"_27821":120361,"_3006":120470},[],"el principal coincide con la identidad utilizada;",{"_3550":72088,"_30605":72039,"_21201":120472,"_5":14582,"_27821":120361,"_3006":120473},[],"el consumidor lo persiste una sola vez;",{"_3550":72089,"_30605":72039,"_21201":120475,"_5":14582,"_27821":120361,"_3006":120476},[],"puede recuperarse por recurso, actor y periodo;",{"_3550":72090,"_30605":72039,"_21201":120478,"_5":14582,"_27821":120361,"_3006":120479},[],"una interrupción del consumidor produce una alerta.",{"_3550":72091,"_30605":72039,"_21201":120481,"_5":14582,"_27821":120361,"_3006":120482},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3550":72092,"_30605":72092,"_5":14934,"_3006":120484,"_30964":120485,"_21201":120486,"_27821":72092},"Arquitectura de la plataforma",[49995,119453],[],{"_3550":72093,"_30605":72092,"_21201":120488,"_5":14582,"_27821":72092,"_3006":120489},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3550":72094,"_30605":72092,"_5":30961,"_21201":120491,"_27821":120492,"_3006":120493},[],"/docs/pr-preview/pr-66/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3550":72095,"_30605":72092,"_5":30961,"_21201":120495,"_27821":120496,"_3006":120497},[],"/docs/pr-preview/pr-66/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3550":72096,"_30605":72092,"_5":30961,"_21201":120499,"_27821":120500,"_3006":120501},[],"/docs/pr-preview/pr-66/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3550":72097,"_30605":72092,"_5":30961,"_21201":120503,"_27821":120504,"_3006":120505},[],"/docs/pr-preview/pr-66/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3550":72098,"_30605":72092,"_5":30961,"_21201":120507,"_27821":120508,"_3006":120509},[],"/docs/pr-preview/pr-66/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3550":72099,"_30605":72092,"_21201":120511,"_5":14582,"_27821":72092,"_3006":120512},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3550":72100,"_30605":72092,"_21201":120514,"_5":14582,"_27821":72092,"_3006":120515},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3550":72101,"_30605":72092,"_21201":120517,"_5":14582,"_27821":120492,"_3006":120518},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3550":72102,"_30605":72092,"_21201":120520,"_5":14582,"_27821":120496,"_3006":120521},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3550":72103,"_30605":72092,"_21201":120523,"_5":14582,"_27821":120500,"_3006":120524},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3550":72104,"_30605":72092,"_21201":120526,"_5":14582,"_27821":120504,"_3006":120527},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3550":72105,"_30605":72092,"_21201":120529,"_5":14582,"_27821":120508,"_3006":120530},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3550":72106,"_30605":72106,"_5":14934,"_3006":120532,"_30964":120533,"_21201":120534,"_27821":72106},"Cómo funciona Lamassu",[49995,119453],[],{"_3550":72107,"_30605":72106,"_21201":120536,"_5":14582,"_27821":72106,"_3006":120537},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3550":72108,"_30605":72106,"_5":30961,"_21201":120539,"_27821":120540,"_3006":120541},[],"/docs/pr-preview/pr-66/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3550":72109,"_30605":72106,"_5":30961,"_21201":120543,"_27821":120544,"_3006":120545},[],"/docs/pr-preview/pr-66/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3550":72110,"_30605":72106,"_21201":120547,"_5":14582,"_27821":72106,"_3006":120548},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3550":72111,"_30605":72106,"_21201":120550,"_5":14582,"_27821":120540,"_3006":120551},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3550":72112,"_30605":72106,"_21201":120553,"_5":14582,"_27821":120540,"_3006":120554},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3550":72113,"_30605":72106,"_21201":120556,"_5":14582,"_27821":120540,"_3006":120557},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3550":72114,"_30605":72106,"_21201":120559,"_5":14582,"_27821":120540,"_3006":120560},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3550":72115,"_30605":72106,"_21201":120562,"_5":14582,"_27821":120540,"_3006":120563},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3550":72116,"_30605":72106,"_21201":120565,"_5":14582,"_27821":120544,"_3006":120566},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3550":72117,"_30605":72106,"_21201":120568,"_5":14582,"_27821":120544,"_3006":120569},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3550":72118,"_30605":72106,"_21201":120571,"_5":14582,"_27821":120544,"_3006":120572},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3550":72119,"_30605":72106,"_21201":120574,"_5":14582,"_27821":120544,"_3006":120575},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3550":72120,"_30605":72106,"_21201":120577,"_5":14582,"_27821":120544,"_3006":120578},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3550":72121,"_30605":72106,"_21201":120580,"_5":14582,"_27821":120544,"_3006":120581},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3550":72122,"_30605":72106,"_21201":120583,"_5":14582,"_27821":120544,"_3006":120584},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3550":72123,"_30605":72123,"_5":14934,"_3006":120586,"_30964":120587,"_21201":120588,"_27821":72123},"Dispositivos e identidades",[49995,119453,52630,120586],[],{"_3550":72124,"_30605":72123,"_21201":120590,"_5":14582,"_27821":72123,"_3006":120591},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3550":72125,"_30605":72123,"_5":30961,"_21201":120593,"_27821":120594,"_3006":120595},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3550":72126,"_30605":72123,"_5":30961,"_21201":120597,"_27821":120598,"_3006":120599},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3550":72127,"_30605":72123,"_5":30961,"_21201":120601,"_27821":120602,"_3006":120603},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3550":72128,"_30605":72123,"_5":30961,"_21201":120605,"_27821":120606,"_3006":120607},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3550":72129,"_30605":72123,"_5":30961,"_21201":120609,"_27821":120610,"_3006":120611},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3550":72130,"_30605":72123,"_5":30961,"_21201":120613,"_27821":120614,"_3006":120615},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3550":72131,"_30605":72123,"_5":30961,"_21201":120617,"_27821":120618,"_3006":120619},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3550":72132,"_30605":72123,"_5":30961,"_21201":120621,"_27821":120622,"_3006":120623},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3550":72133,"_30605":72123,"_5":30961,"_21201":120625,"_27821":120626,"_3006":120627},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3550":72134,"_30605":72123,"_5":30961,"_21201":120629,"_27821":120630,"_3006":120631},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3550":72135,"_30605":72123,"_5":30961,"_21201":120633,"_27821":120634,"_3006":120635},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3550":72136,"_30605":72123,"_21201":120637,"_5":14582,"_27821":72123,"_3006":120638},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3550":72137,"_30605":72123,"_21201":120640,"_5":14582,"_27821":72123,"_3006":120641},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3550":72138,"_30605":72123,"_21201":120643,"_5":14582,"_27821":120594,"_3006":120644},[],"Vista operativa",{"_3550":72139,"_30605":72123,"_21201":120646,"_5":14582,"_27821":120594,"_3006":120647},[],"Interpretación",{"_3550":72140,"_30605":72123,"_21201":120649,"_5":14582,"_27821":120594,"_3006":52693},[],{"_3550":72141,"_30605":72123,"_21201":120651,"_5":14582,"_27821":120594,"_3006":120652},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3550":72142,"_30605":72123,"_21201":120654,"_5":14582,"_27821":120594,"_3006":52699},[],{"_3550":72143,"_30605":72123,"_21201":120656,"_5":14582,"_27821":120594,"_3006":120657},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3550":72144,"_30605":72123,"_21201":120659,"_5":14582,"_27821":120594,"_3006":52705},[],{"_3550":72145,"_30605":72123,"_21201":120661,"_5":14582,"_27821":120594,"_3006":120662},[],"La identidad está en la ventana operativa de renovación.",{"_3550":72146,"_30605":72123,"_21201":120664,"_5":14582,"_27821":120594,"_3006":52711},[],{"_3550":72147,"_30605":72123,"_21201":120666,"_5":14582,"_27821":120594,"_3006":120667},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3550":72148,"_30605":72123,"_21201":120669,"_5":14582,"_27821":120594,"_3006":52717},[],{"_3550":72149,"_30605":72123,"_21201":120671,"_5":14582,"_27821":120594,"_3006":120672},[],"La identidad ha vencido.",{"_3550":72150,"_30605":72123,"_21201":120674,"_5":14582,"_27821":120594,"_3006":52723},[],{"_3550":72151,"_30605":72123,"_21201":120676,"_5":14582,"_27821":120594,"_3006":120677},[],"La identidad está marcada como revocada.",{"_3550":72152,"_30605":72123,"_21201":120679,"_5":14582,"_27821":120594,"_3006":52729},[],{"_3550":72153,"_30605":72123,"_21201":120681,"_5":14582,"_27821":120594,"_3006":120682},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3550":72154,"_30605":72123,"_21201":120684,"_5":14582,"_27821":120594,"_3006":120685},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3550":72155,"_30605":72123,"_21201":120687,"_5":14582,"_27821":120598,"_3006":120688},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3550":72156,"_30605":72123,"_21201":120690,"_5":14582,"_27821":120598,"_3006":120691},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3550":72157,"_30605":72123,"_21201":120693,"_5":14582,"_27821":120598,"_3006":120694},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3550":72158,"_30605":72123,"_21201":120696,"_5":14582,"_27821":120598,"_3006":120697},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3550":72159,"_30605":72123,"_21201":120699,"_5":14582,"_27821":120602,"_3006":120700},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3550":72160,"_30605":72123,"_21201":120702,"_5":14582,"_27821":120606,"_3006":120703},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3550":72161,"_30605":72123,"_21201":120705,"_5":14582,"_27821":120610,"_3006":120706},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3550":72162,"_30605":72123,"_21201":120708,"_5":14582,"_27821":120614,"_3006":120709},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3550":72163,"_30605":72123,"_21201":120711,"_5":14582,"_27821":120618,"_3006":120712},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3550":72164,"_30605":72123,"_21201":120714,"_5":14582,"_27821":120618,"_3006":120715},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3550":72165,"_30605":72123,"_21201":120717,"_5":14582,"_27821":120622,"_3006":120718},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3550":72166,"_30605":72123,"_21201":120720,"_5":14582,"_27821":120622,"_3006":120721},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3550":72167,"_30605":72123,"_21201":120723,"_5":14582,"_27821":120622,"_3006":120724},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3550":72168,"_30605":72123,"_21201":120726,"_5":14582,"_27821":120622,"_3006":120727},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3550":72169,"_30605":72123,"_21201":120729,"_5":14582,"_27821":120622,"_3006":120730},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3550":72170,"_30605":72123,"_21201":120732,"_5":14582,"_27821":120622,"_3006":120733},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3550":72171,"_30605":72123,"_21201":120735,"_5":14582,"_27821":120626,"_3006":120736},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3550":72172,"_30605":72123,"_21201":120738,"_5":14582,"_27821":120626,"_3006":120739},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3550":72173,"_30605":72123,"_21201":120741,"_5":14582,"_27821":120630,"_3006":120742},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3550":72174,"_30605":72123,"_21201":120744,"_5":14582,"_27821":120630,"_3006":120745},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3550":72175,"_30605":72123,"_21201":120747,"_5":14582,"_27821":120630,"_3006":120748},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3550":72176,"_30605":72123,"_21201":120750,"_5":14582,"_27821":120630,"_3006":120751},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3550":72177,"_30605":72123,"_21201":120753,"_5":14582,"_27821":120634,"_3006":120754},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3550":72178,"_30605":72123,"_21201":120756,"_5":14582,"_27821":120634,"_3006":120757},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3550":72179,"_30605":72179,"_5":14934,"_3006":120759,"_30964":120760,"_21201":120762,"_27821":72179},"Identidad inicial y autenticación",[49995,119453,52630,120586,120761],"Enrolamiento con PKI",[],{"_3550":72180,"_30605":72179,"_21201":120764,"_5":14582,"_27821":72179,"_3006":120765},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3550":72181,"_30605":72179,"_5":30961,"_21201":120767,"_27821":120768,"_3006":120769},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3550":72182,"_30605":72179,"_5":30961,"_21201":120771,"_27821":120772,"_3006":120773},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3550":72183,"_30605":72179,"_5":30961,"_21201":120775,"_27821":120776,"_3006":120777},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3550":72184,"_30605":72179,"_5":30961,"_21201":120779,"_27821":120780,"_3006":120781},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3550":72185,"_30605":72179,"_5":30961,"_21201":120783,"_27821":120784,"_3006":120785},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3550":72186,"_30605":72179,"_21201":120787,"_5":14582,"_27821":72179,"_3006":120788},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3550":72187,"_30605":72179,"_21201":120790,"_5":14582,"_27821":120768,"_3006":120791},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3550":72188,"_30605":72179,"_21201":120793,"_5":14582,"_27821":120768,"_3006":120794},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3550":72189,"_30605":72179,"_21201":120796,"_5":14582,"_27821":120772,"_3006":120797},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3550":72190,"_30605":72179,"_21201":120799,"_5":14582,"_27821":120772,"_3006":120800},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3550":72191,"_30605":72179,"_21201":120802,"_5":14582,"_27821":120772,"_3006":120803},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3550":72192,"_30605":72179,"_21201":120805,"_5":14582,"_27821":120776,"_3006":120806},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3550":72193,"_30605":72179,"_21201":120808,"_5":14582,"_27821":120776,"_3006":120809},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3550":72194,"_30605":72179,"_21201":120811,"_5":14582,"_27821":120780,"_3006":120812},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3550":72195,"_30605":72179,"_21201":120814,"_5":14582,"_27821":120780,"_3006":120815},[],"Ejemplo de cuerpo:",{"_3550":72196,"_30605":72179,"_21201":120817,"_5":14582,"_27821":120780,"_3006":120818},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3550":72197,"_30605":72179,"_21201":120820,"_5":14582,"_27821":120780,"_3006":120821},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3550":72198,"_30605":72179,"_21201":120823,"_5":14582,"_27821":120780,"_3006":120824},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3550":72199,"_30605":72179,"_21201":120826,"_5":14582,"_27821":120780,"_3006":120827},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3550":72200,"_30605":72179,"_21201":120829,"_5":14582,"_27821":120784,"_3006":120830},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3550":72201,"_30605":72179,"_21201":120832,"_5":14582,"_27821":120784,"_3006":120833},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3550":72202,"_30605":72202,"_5":14934,"_3006":120835,"_30964":120836,"_21201":120837,"_27821":72202},"Configura y opera el DMS",[49995,119453,52630,120586,120761],[],{"_3550":72203,"_30605":72202,"_21201":120839,"_5":14582,"_27821":72202,"_3006":120840},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3550":72204,"_30605":72202,"_5":30961,"_21201":120842,"_27821":120843,"_3006":118024},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3550":72205,"_30605":72202,"_5":30961,"_21201":120845,"_27821":120846,"_3006":120847},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3550":72206,"_30605":72202,"_5":30961,"_21201":120849,"_27821":120850,"_3006":120851},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3550":72207,"_30605":72202,"_5":30961,"_21201":120853,"_27821":120854,"_3006":120855},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3550":72208,"_30605":72202,"_5":30961,"_21201":120857,"_27821":120858,"_3006":120859},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3550":72209,"_30605":72202,"_5":30961,"_21201":120861,"_27821":120862,"_3006":120863},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3550":72210,"_30605":72202,"_5":30961,"_21201":120865,"_27821":120866,"_3006":120867},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3550":72211,"_30605":72202,"_5":30961,"_21201":120869,"_27821":120870,"_3006":120871},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3550":72212,"_30605":72202,"_5":30961,"_21201":120873,"_27821":120874,"_3006":52925},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3550":72213,"_30605":72202,"_5":30961,"_21201":120876,"_27821":120877,"_3006":52929},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3550":72214,"_30605":72202,"_5":30961,"_21201":120879,"_27821":120880,"_3006":120881},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3550":72215,"_30605":72202,"_5":30961,"_21201":120883,"_27821":120884,"_3006":120885},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3550":72216,"_30605":72202,"_5":30961,"_21201":120887,"_27821":120888,"_3006":120889},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3550":72217,"_30605":72202,"_5":30961,"_21201":120891,"_27821":120892,"_3006":120893},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3550":72218,"_30605":72202,"_5":30961,"_21201":120895,"_27821":120896,"_3006":52949},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3550":72219,"_30605":72202,"_5":30961,"_21201":120898,"_27821":120899,"_3006":120900},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3550":72220,"_30605":72202,"_5":30961,"_21201":120902,"_27821":120903,"_3006":120904},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3550":72221,"_30605":72202,"_5":30961,"_21201":120906,"_27821":120907,"_3006":120908},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3550":72222,"_30605":72202,"_21201":120910,"_5":14582,"_27821":72202,"_3006":120911},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3550":72223,"_30605":72202,"_21201":120913,"_5":14582,"_27821":120843,"_3006":120914},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3550":72224,"_30605":72202,"_21201":120916,"_5":14582,"_27821":120843,"_3006":120917},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3550":72225,"_30605":72202,"_21201":120919,"_5":14582,"_27821":120850,"_3006":120920},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3550":72226,"_30605":72202,"_21201":120922,"_5":14582,"_27821":120854,"_3006":120923},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3550":72227,"_30605":72202,"_21201":120925,"_5":14582,"_27821":120858,"_3006":120926},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3550":72228,"_30605":72202,"_21201":120928,"_5":14582,"_27821":120862,"_3006":120929},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3550":72229,"_30605":72202,"_21201":120931,"_5":14582,"_27821":120866,"_3006":120932},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3550":72230,"_30605":72202,"_21201":120934,"_5":14582,"_27821":120874,"_3006":120935},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3550":72231,"_30605":72202,"_21201":120937,"_5":14582,"_27821":120874,"_3006":120938},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3550":72232,"_30605":72202,"_21201":120940,"_5":14582,"_27821":120877,"_3006":120941},[],"Campo de `settings.enrollment_settings`",{"_3550":72233,"_30605":72202,"_21201":120943,"_5":14582,"_27821":120877,"_3006":120944},[],"Decisión",{"_3550":72234,"_30605":72202,"_21201":120946,"_5":14582,"_27821":120877,"_3006":53000},[],{"_3550":72235,"_30605":72202,"_21201":120948,"_5":14582,"_27821":120877,"_3006":120949},[],"`EST_RFC7030` para estas operaciones.",{"_3550":72236,"_30605":72202,"_21201":120951,"_5":14582,"_27821":120877,"_3006":53006},[],{"_3550":72237,"_30605":72202,"_21201":120953,"_5":14582,"_27821":120877,"_3006":120954},[],"ID de la CA que firmará.",{"_3550":72238,"_30605":72202,"_21201":120956,"_5":14582,"_27821":120877,"_3006":53012},[],{"_3550":72239,"_30605":72202,"_21201":120958,"_5":14582,"_27821":120877,"_3006":120959},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3550":72240,"_30605":72202,"_21201":120961,"_5":14582,"_27821":120877,"_3006":53018},[],{"_3550":72241,"_30605":72202,"_21201":120963,"_5":14582,"_27821":120877,"_3006":120964},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3550":72242,"_30605":72202,"_21201":120966,"_5":14582,"_27821":120877,"_3006":53024},[],{"_3550":72243,"_30605":72202,"_21201":120968,"_5":14582,"_27821":120877,"_3006":120969},[],"Uno de los cuatro modos de autenticación.",{"_3550":72244,"_30605":72202,"_21201":120971,"_5":14582,"_27821":120877,"_3006":120972},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3550":72245,"_30605":72202,"_21201":120974,"_5":14582,"_27821":120880,"_3006":120975},[],"Los bloques son independientes:",{"_3550":72246,"_30605":72202,"_21201":120977,"_5":14582,"_27821":120880,"_3006":120978},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3550":72247,"_30605":72202,"_21201":120980,"_5":14582,"_27821":120880,"_3006":120981},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3550":72248,"_30605":72202,"_21201":120983,"_5":14582,"_27821":120880,"_3006":53042},[],{"_3550":72249,"_30605":72202,"_21201":120985,"_5":14582,"_27821":120880,"_3006":120986},[],"Control aplicado en la operación configurada",{"_3550":72250,"_30605":72202,"_21201":120988,"_5":14582,"_27821":120880,"_3006":53048},[],{"_3550":72251,"_30605":72202,"_21201":120990,"_5":14582,"_27821":120880,"_3006":120991},[],"Validación del certificado presentado.",{"_3550":72252,"_30605":72202,"_21201":120993,"_5":14582,"_27821":120880,"_3006":53054},[],{"_3550":72253,"_30605":72202,"_21201":120995,"_5":14582,"_27821":120880,"_3006":120996},[],"Autorización del webhook configurado.",{"_3550":72254,"_30605":72202,"_21201":120998,"_5":14582,"_27821":120880,"_3006":53060},[],{"_3550":72255,"_30605":72202,"_21201":121000,"_5":14582,"_27821":120880,"_3006":121001},[],"Validación del certificado y, después, aprobación del webhook.",{"_3550":72256,"_30605":72202,"_21201":121003,"_5":14582,"_27821":120880,"_3006":53066},[],{"_3550":72257,"_30605":72202,"_21201":121005,"_5":14582,"_27821":120880,"_3006":121006},[],"Sin autenticación del solicitante por el DMS.",{"_3550":72258,"_30605":72202,"_21201":121008,"_5":14582,"_27821":120880,"_3006":121009},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3550":72259,"_30605":72202,"_21201":121011,"_5":14582,"_27821":120880,"_3006":121012},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3550":72260,"_30605":72202,"_21201":121014,"_5":14582,"_27821":120880,"_3006":121015},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3550":72261,"_30605":72202,"_21201":121017,"_5":14582,"_27821":120880,"_3006":121018},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3550":72262,"_30605":72202,"_21201":121020,"_5":14582,"_27821":120884,"_3006":121021},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3550":72263,"_30605":72202,"_21201":121023,"_5":14582,"_27821":120884,"_3006":121024},[],"Campo de `external_webhook_settings`",{"_3550":72264,"_30605":72202,"_21201":121026,"_5":14582,"_27821":120884,"_3006":120944},[],{"_3550":72265,"_30605":72202,"_21201":121028,"_5":14582,"_27821":120884,"_3006":53092},[],{"_3550":72266,"_30605":72202,"_21201":121030,"_5":14582,"_27821":120884,"_3006":121031},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3550":72267,"_30605":72202,"_21201":121033,"_5":14582,"_27821":120884,"_3006":53098},[],{"_3550":72268,"_30605":72202,"_21201":121035,"_5":14582,"_27821":120884,"_3006":121036},[],"`POST` o `PUT`; `POST` por defecto.",{"_3550":72269,"_30605":72202,"_21201":121038,"_5":14582,"_27821":120884,"_3006":53104},[],{"_3550":72270,"_30605":72202,"_21201":121040,"_5":14582,"_27821":120884,"_3006":121041},[],"Etiqueta usada en los logs del servicio.",{"_3550":72271,"_30605":72202,"_21201":121043,"_5":14582,"_27821":120884,"_3006":53110},[],{"_3550":72272,"_30605":72202,"_21201":121045,"_5":14582,"_27821":120884,"_3006":121046},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3550":72273,"_30605":72202,"_21201":121048,"_5":14582,"_27821":120884,"_3006":53116},[],{"_3550":72274,"_30605":72202,"_21201":121050,"_5":14582,"_27821":120884,"_3006":121051},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3550":72275,"_30605":72202,"_21201":121053,"_5":14582,"_27821":120884,"_3006":53122},[],{"_3550":72276,"_30605":72202,"_21201":121055,"_5":14582,"_27821":120884,"_3006":121056},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3550":72277,"_30605":72202,"_21201":121058,"_5":14582,"_27821":120884,"_3006":53128},[],{"_3550":72278,"_30605":72202,"_21201":121060,"_5":14582,"_27821":120884,"_3006":121061},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3550":72279,"_30605":72202,"_21201":121063,"_5":14582,"_27821":120884,"_3006":53134},[],{"_3550":72280,"_30605":72202,"_21201":121065,"_5":14582,"_27821":120884,"_3006":121066},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3550":72281,"_30605":72202,"_21201":121068,"_5":14582,"_27821":120884,"_3006":53140},[],{"_3550":72282,"_30605":72202,"_21201":121070,"_5":14582,"_27821":120884,"_3006":121071},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3550":72283,"_30605":72202,"_21201":121073,"_5":14582,"_27821":120884,"_3006":53146},[],{"_3550":72284,"_30605":72202,"_21201":121075,"_5":14582,"_27821":120884,"_3006":121076},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3550":72285,"_30605":72202,"_21201":121078,"_5":14582,"_27821":120884,"_3006":121079},[],"Reglas de esa configuración:",{"_3550":72286,"_30605":72202,"_21201":121081,"_5":14582,"_27821":120884,"_3006":121082},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3550":72287,"_30605":72202,"_21201":121084,"_5":14582,"_27821":120884,"_3006":121085},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3550":72288,"_30605":72202,"_21201":121087,"_5":14582,"_27821":120884,"_3006":121088},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3550":72289,"_30605":72202,"_21201":121090,"_5":14582,"_27821":120884,"_3006":121091},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3550":72290,"_30605":72202,"_21201":121093,"_5":14582,"_27821":120884,"_3006":121094},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3550":72291,"_30605":72202,"_21201":121096,"_5":14582,"_27821":120884,"_3006":121097},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3550":72292,"_30605":72202,"_21201":121099,"_5":14582,"_27821":120884,"_3006":121100},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3550":72293,"_30605":72202,"_21201":121102,"_5":14582,"_27821":120884,"_3006":121103},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3550":72294,"_30605":72202,"_21201":121105,"_5":14582,"_27821":120884,"_3006":121106},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3550":72295,"_30605":72202,"_21201":121108,"_5":14582,"_27821":120888,"_3006":121109},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3550":72296,"_30605":72202,"_21201":121111,"_5":14582,"_27821":120892,"_3006":121112},[],"Campo de `settings.reenrollment_settings`",{"_3550":72297,"_30605":72202,"_21201":121114,"_5":14582,"_27821":120892,"_3006":121115},[],"Función",{"_3550":72298,"_30605":72202,"_21201":121117,"_5":14582,"_27821":120892,"_3006":53190},[],{"_3550":72299,"_30605":72202,"_21201":121119,"_5":14582,"_27821":120892,"_3006":121120},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3550":72300,"_30605":72202,"_21201":121122,"_5":14582,"_27821":120892,"_3006":53196},[],{"_3550":72301,"_30605":72202,"_21201":121124,"_5":14582,"_27821":120892,"_3006":121125},[],"Umbral operativo preventivo de monitorización.",{"_3550":72302,"_30605":72202,"_21201":121127,"_5":14582,"_27821":120892,"_3006":53202},[],{"_3550":72303,"_30605":72202,"_21201":121129,"_5":14582,"_27821":120892,"_3006":121130},[],"Umbral operativo crítico de monitorización.",{"_3550":72304,"_30605":72202,"_21201":121132,"_5":14582,"_27821":120892,"_3006":53208},[],{"_3550":72305,"_30605":72202,"_21201":121134,"_5":14582,"_27821":120892,"_3006":121135},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3550":72306,"_30605":72202,"_21201":121137,"_5":14582,"_27821":120892,"_3006":53214},[],{"_3550":72307,"_30605":72202,"_21201":121139,"_5":14582,"_27821":120892,"_3006":121140},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3550":72308,"_30605":72202,"_21201":121142,"_5":14582,"_27821":120892,"_3006":53220},[],{"_3550":72309,"_30605":72202,"_21201":121144,"_5":14582,"_27821":120892,"_3006":121145},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3550":72310,"_30605":72202,"_21201":121147,"_5":14582,"_27821":120892,"_3006":121148},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3550":72311,"_30605":72202,"_21201":121150,"_5":14582,"_27821":120896,"_3006":121151},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3550":72312,"_30605":72202,"_21201":121153,"_5":14582,"_27821":120899,"_3006":118388},[],{"_3550":72313,"_30605":72202,"_21201":121155,"_5":14582,"_27821":120899,"_3006":121156},[],"Qué publica",{"_3550":72314,"_30605":72202,"_21201":121158,"_5":14582,"_27821":120899,"_3006":53237},[],{"_3550":72315,"_30605":72202,"_21201":121160,"_5":14582,"_27821":120899,"_3006":121161},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3550":72316,"_30605":72202,"_21201":121163,"_5":14582,"_27821":120899,"_3006":53243},[],{"_3550":72317,"_30605":72202,"_21201":121165,"_5":14582,"_27821":120899,"_3006":121166},[],"Certificado de la CA emisora seleccionada.",{"_3550":72318,"_30605":72202,"_21201":121168,"_5":14582,"_27821":120899,"_3006":53249},[],{"_3550":72319,"_30605":72202,"_21201":121170,"_5":14582,"_27821":120899,"_3006":121171},[],"Certificados de las CAs elegidas explícitamente.",{"_3550":72320,"_30605":72202,"_21201":121173,"_5":14582,"_27821":120899,"_3006":121174},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3550":72321,"_30605":72202,"_21201":121176,"_5":14582,"_27821":120903,"_3006":121177},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3550":72322,"_30605":72202,"_21201":121179,"_5":14582,"_27821":120903,"_3006":121180},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3550":72323,"_30605":72202,"_21201":121182,"_5":14582,"_27821":120903,"_3006":121183},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3550":72324,"_30605":72202,"_21201":121185,"_5":14582,"_27821":120907,"_3006":121186},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3550":72325,"_30605":72325,"_5":14934,"_3006":121188,"_30964":121189,"_21201":121190,"_27821":72325},"Integra el cliente EST",[49995,119453,52630,120586,120761],[],{"_3550":72326,"_30605":72325,"_21201":121192,"_5":14582,"_27821":72325,"_3006":121193},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3550":72327,"_30605":72325,"_5":30961,"_21201":121195,"_27821":121196,"_3006":118024},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3550":72328,"_30605":72325,"_5":30961,"_21201":121198,"_27821":121199,"_3006":121200},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3550":72329,"_30605":72325,"_5":30961,"_21201":121202,"_27821":121203,"_3006":121204},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3550":72330,"_30605":72325,"_5":30961,"_21201":121206,"_27821":121207,"_3006":121208},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3550":72331,"_30605":72325,"_5":30961,"_21201":121210,"_27821":121211,"_3006":121212},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3550":72332,"_30605":72325,"_5":30961,"_21201":121214,"_27821":121215,"_3006":121216},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3550":72333,"_30605":72325,"_21201":121218,"_5":14582,"_27821":72325,"_3006":121219},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3550":72334,"_30605":72325,"_21201":121221,"_5":14582,"_27821":121196,"_3006":121222},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3550":72335,"_30605":72325,"_21201":121224,"_5":14582,"_27821":121196,"_3006":121225},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3550":72336,"_30605":72325,"_21201":121227,"_5":14582,"_27821":121196,"_3006":121228},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3550":72337,"_30605":72325,"_21201":121230,"_5":14582,"_27821":121199,"_3006":121231},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3550":72338,"_30605":72325,"_21201":121233,"_5":14582,"_27821":121199,"_3006":121234},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3550":72339,"_30605":72325,"_21201":121236,"_5":14582,"_27821":121203,"_3006":121237},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3550":72340,"_30605":72325,"_21201":121239,"_5":14582,"_27821":121203,"_3006":121240},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3550":72341,"_30605":72325,"_21201":121242,"_5":14582,"_27821":121207,"_3006":121243},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3550":72342,"_30605":72325,"_21201":121245,"_5":14582,"_27821":121207,"_3006":121246},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3550":72343,"_30605":72325,"_21201":121248,"_5":14582,"_27821":121211,"_3006":121249},[],"Para el caso de una raíz que emite directamente:",{"_3550":72344,"_30605":72325,"_21201":121251,"_5":14582,"_27821":121211,"_3006":121252},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3550":72345,"_30605":72325,"_21201":121254,"_5":14582,"_27821":121211,"_3006":121255},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3550":72346,"_30605":72325,"_21201":121257,"_5":14582,"_27821":121215,"_3006":121258},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3550":72347,"_30605":72347,"_5":14934,"_3006":121260,"_30964":121261,"_21201":121262,"_27821":72347},"Referencia EST",[49995,119453,52630,120586,120761],[],{"_3550":72348,"_30605":72347,"_21201":121264,"_5":14582,"_27821":72347,"_3006":121265},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3550":72349,"_30605":72347,"_5":30961,"_21201":121267,"_27821":121268,"_3006":121269},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3550":72350,"_30605":72347,"_5":30961,"_21201":121271,"_27821":121272,"_3006":22976},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3550":72351,"_30605":72347,"_5":30961,"_21201":121274,"_27821":121275,"_3006":26393},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3550":72352,"_30605":72347,"_5":30961,"_21201":121277,"_27821":121278,"_3006":26400},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3550":72353,"_30605":72347,"_5":30961,"_21201":121280,"_27821":121281,"_3006":25686},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3550":72354,"_30605":72347,"_5":30961,"_21201":121283,"_27821":121284,"_3006":121285},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3550":72355,"_30605":72347,"_5":30961,"_21201":121287,"_27821":121288,"_3006":121289},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3550":72356,"_30605":72347,"_5":30961,"_21201":121291,"_27821":121292,"_3006":121293},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3550":72357,"_30605":72347,"_21201":121295,"_5":14582,"_27821":72347,"_3006":121296},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3550":72358,"_30605":72347,"_21201":121298,"_5":14582,"_27821":121268,"_3006":121299},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3550":72359,"_30605":72347,"_21201":121301,"_5":14582,"_27821":121268,"_3006":119213},[],{"_3550":72360,"_30605":72347,"_21201":121303,"_5":14582,"_27821":121268,"_3006":121304},[],"Método",{"_3550":72361,"_30605":72347,"_21201":121306,"_5":14582,"_27821":121268,"_3006":121307},[],"Autenticación y condición",{"_3550":72362,"_30605":72347,"_21201":121309,"_5":14582,"_27821":121268,"_3006":53392},[],{"_3550":72363,"_30605":72347,"_21201":121311,"_5":14582,"_27821":121268,"_3006":53395},[],{"_3550":72364,"_30605":72347,"_21201":121313,"_5":14582,"_27821":121268,"_3006":121314},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3550":72365,"_30605":72347,"_21201":121316,"_5":14582,"_27821":121268,"_3006":53401},[],{"_3550":72366,"_30605":72347,"_21201":121318,"_5":14582,"_27821":121268,"_3006":53404},[],{"_3550":72367,"_30605":72347,"_21201":121320,"_5":14582,"_27821":121268,"_3006":121321},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3550":72368,"_30605":72347,"_21201":121323,"_5":14582,"_27821":121268,"_3006":53410},[],{"_3550":72369,"_30605":72347,"_21201":121325,"_5":14582,"_27821":121268,"_3006":53404},[],{"_3550":72370,"_30605":72347,"_21201":121327,"_5":14582,"_27821":121268,"_3006":121328},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3550":72371,"_30605":72347,"_21201":121330,"_5":14582,"_27821":121268,"_3006":53418},[],{"_3550":72372,"_30605":72347,"_21201":121332,"_5":14582,"_27821":121268,"_3006":53404},[],{"_3550":72373,"_30605":72347,"_21201":121334,"_5":14582,"_27821":121268,"_3006":121335},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3550":72374,"_30605":72347,"_21201":121337,"_5":14582,"_27821":121268,"_3006":121338},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3550":72375,"_30605":72347,"_21201":121340,"_5":14582,"_27821":121272,"_3006":121341},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3550":72376,"_30605":72347,"_21201":121343,"_5":14582,"_27821":121272,"_3006":121344},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3550":72377,"_30605":72347,"_21201":121346,"_5":14582,"_27821":121275,"_3006":121347},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3550":72378,"_30605":72347,"_21201":121349,"_5":14582,"_27821":121275,"_3006":121350},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3550":72379,"_30605":72347,"_21201":121352,"_5":14582,"_27821":121278,"_3006":121353},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3550":72380,"_30605":72347,"_21201":121355,"_5":14582,"_27821":121278,"_3006":121356},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3550":72381,"_30605":72347,"_21201":121358,"_5":14582,"_27821":121281,"_3006":121359},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3550":72382,"_30605":72347,"_21201":121361,"_5":14582,"_27821":121281,"_3006":121362},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3550":72383,"_30605":72347,"_21201":121364,"_5":14582,"_27821":121284,"_3006":121365},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3550":72384,"_30605":72347,"_21201":121367,"_5":14582,"_27821":121284,"_3006":121368},[],"Parte",{"_3550":72385,"_30605":72347,"_21201":121370,"_5":14582,"_27821":121284,"_3006":121371},[],"Contenido tras decodificar su Base64",{"_3550":72386,"_30605":72347,"_21201":121373,"_5":14582,"_27821":121284,"_3006":53462},[],{"_3550":72387,"_30605":72347,"_21201":121375,"_5":14582,"_27821":121284,"_3006":121376},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3550":72388,"_30605":72347,"_21201":121378,"_5":14582,"_27821":121284,"_3006":53468},[],{"_3550":72389,"_30605":72347,"_21201":121380,"_5":14582,"_27821":121284,"_3006":121381},[],"PKCS#7 DER con el certificado emitido.",{"_3550":72390,"_30605":72347,"_21201":121383,"_5":14582,"_27821":121284,"_3006":121384},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3550":72391,"_30605":72347,"_21201":121386,"_5":14582,"_27821":121288,"_3006":121387},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3550":72392,"_30605":72347,"_21201":121389,"_5":14582,"_27821":121288,"_3006":121390},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3550":72393,"_30605":72347,"_21201":121392,"_5":14582,"_27821":121288,"_3006":121393},[],"Convierte y comprueba el resultado:",{"_3550":72394,"_30605":72347,"_21201":121395,"_5":14582,"_27821":121288,"_3006":121396},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3550":72395,"_30605":72347,"_21201":121398,"_5":14582,"_27821":121292,"_3006":121399},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3550":72396,"_30605":72347,"_21201":121401,"_5":14582,"_27821":121292,"_3006":121402},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3550":72397,"_30605":72397,"_5":14934,"_3006":120761,"_30964":121404,"_21201":121405,"_27821":72397},[49995,119453,52630,120586,120761],[],{"_3550":72398,"_30605":72397,"_21201":121407,"_5":14582,"_27821":72397,"_3006":121408},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3550":72399,"_30605":72397,"_5":30961,"_21201":121410,"_27821":121411,"_3006":121412},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3550":72400,"_30605":72397,"_5":30961,"_21201":121414,"_27821":121415,"_3006":121416},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3550":72401,"_30605":72397,"_5":30961,"_21201":121418,"_27821":121419,"_3006":121420},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3550":72402,"_30605":72397,"_5":30961,"_21201":121422,"_27821":121423,"_3006":121424},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3550":72403,"_30605":72397,"_21201":121426,"_5":14582,"_27821":72397,"_3006":121427},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3550":72404,"_30605":72397,"_21201":121429,"_5":14582,"_27821":121411,"_3006":121430},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3550":72405,"_30605":72397,"_21201":121432,"_5":14582,"_27821":121411,"_3006":121433},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3550":72406,"_30605":72397,"_21201":121435,"_5":14582,"_27821":121411,"_3006":121436},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3550":72407,"_30605":72397,"_21201":121438,"_5":14582,"_27821":121411,"_3006":121439},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3550":72408,"_30605":72397,"_21201":121441,"_5":14582,"_27821":121411,"_3006":121442},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3550":72409,"_30605":72397,"_21201":121444,"_5":14582,"_27821":121411,"_3006":121445},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3550":72410,"_30605":72397,"_21201":121447,"_5":14582,"_27821":121415,"_3006":121448},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3550":72411,"_30605":72397,"_21201":121450,"_5":14582,"_27821":121415,"_3006":121451},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3550":72412,"_30605":72397,"_21201":121453,"_5":14582,"_27821":121415,"_3006":121454},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3550":72413,"_30605":72397,"_21201":121456,"_5":14582,"_27821":121415,"_3006":121457},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3550":72414,"_30605":72397,"_21201":121459,"_5":14582,"_27821":121419,"_3006":121460},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3550":72415,"_30605":72397,"_21201":121462,"_5":14582,"_27821":121419,"_3006":121463},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3550":72416,"_30605":72397,"_21201":121465,"_5":14582,"_27821":121419,"_3006":121466},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3550":72417,"_30605":72397,"_21201":121468,"_5":14582,"_27821":121419,"_3006":121469},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3550":72418,"_30605":72397,"_21201":121471,"_5":14582,"_27821":121423,"_3006":121472},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3550":72419,"_30605":72397,"_21201":121474,"_5":14582,"_27821":121423,"_3006":121475},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3550":72420,"_30605":72420,"_5":14934,"_3006":121477,"_30964":121478,"_21201":121479,"_27821":72420},"Estrategias de aprovisionamiento",[49995,119453,52630,120586,120761],[],{"_3550":72421,"_30605":72420,"_21201":121481,"_5":14582,"_27821":72420,"_3006":121482},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3550":72422,"_30605":72420,"_5":30961,"_21201":121484,"_27821":121485,"_3006":121486},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3550":72423,"_30605":72420,"_5":30961,"_21201":121488,"_27821":121489,"_3006":121490},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3550":72424,"_30605":72420,"_5":30961,"_21201":121492,"_27821":121493,"_3006":121494},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3550":72425,"_30605":72420,"_5":30961,"_21201":121496,"_27821":121497,"_3006":121498},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3550":72426,"_30605":72420,"_5":30961,"_21201":121500,"_27821":121501,"_3006":121502},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3550":72427,"_30605":72420,"_21201":121504,"_5":14582,"_27821":72420,"_3006":121505},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3550":72428,"_30605":72420,"_21201":121507,"_5":14582,"_27821":121485,"_3006":121508},[],"Recorrido",{"_3550":72429,"_30605":72420,"_21201":121510,"_5":14582,"_27821":121485,"_3006":121511},[],"Cuándo existe el dispositivo",{"_3550":72430,"_30605":72420,"_21201":121513,"_5":14582,"_27821":121485,"_3006":121514},[],"Qué compruebas",{"_3550":72431,"_30605":72420,"_21201":121516,"_5":14582,"_27821":121485,"_3006":121517},[],"Asignación manual",{"_3550":72432,"_30605":72420,"_21201":121519,"_5":14582,"_27821":121485,"_3006":121520},[],"El operador lo crea antes de asociar un certificado.",{"_3550":72433,"_30605":72420,"_21201":121522,"_5":14582,"_27821":121485,"_3006":121523},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3550":72434,"_30605":72420,"_21201":121525,"_5":14582,"_27821":121485,"_3006":121526},[],"EST con `JITP`",{"_3550":72435,"_30605":72420,"_21201":121528,"_5":14582,"_27821":121485,"_3006":121529},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3550":72436,"_30605":72420,"_21201":121531,"_5":14582,"_27821":121485,"_3006":121532},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3550":72437,"_30605":72420,"_21201":121534,"_5":14582,"_27821":121485,"_3006":121535},[],"EST con `PRE_REGISTRATION`",{"_3550":72438,"_30605":72420,"_21201":121537,"_5":14582,"_27821":121485,"_3006":121538},[],"Debe existir antes de `/simpleenroll`.",{"_3550":72439,"_30605":72420,"_21201":121540,"_5":14582,"_27821":121485,"_3006":121541},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3550":72440,"_30605":72420,"_21201":121543,"_5":14582,"_27821":121485,"_3006":121544},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3550":72441,"_30605":72420,"_21201":121546,"_5":14582,"_27821":121485,"_3006":121547},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3550":72442,"_30605":72420,"_21201":121549,"_5":14582,"_27821":121489,"_3006":121550},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3550":72443,"_30605":72420,"_21201":121552,"_5":14582,"_27821":121489,"_3006":121553},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3550":72444,"_30605":72420,"_21201":121555,"_5":14582,"_27821":121489,"_3006":121556},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3550":72445,"_30605":72420,"_21201":121558,"_5":14582,"_27821":121493,"_3006":121559},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3550":72446,"_30605":72420,"_21201":121561,"_5":14582,"_27821":121493,"_3006":121562},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3550":72447,"_30605":72420,"_21201":121564,"_5":14582,"_27821":121493,"_3006":121565},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3550":72448,"_30605":72420,"_21201":121567,"_5":14582,"_27821":121493,"_3006":121568},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3550":72449,"_30605":72420,"_21201":121570,"_5":14582,"_27821":121493,"_3006":121571},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3550":72450,"_30605":72420,"_21201":121573,"_5":14582,"_27821":121493,"_3006":121574},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3550":72451,"_30605":72420,"_21201":121576,"_5":14582,"_27821":121497,"_3006":118388},[],{"_3550":72452,"_30605":72420,"_21201":121578,"_5":14582,"_27821":121497,"_3006":121579},[],"Material que atraviesa EST",{"_3550":72453,"_30605":72420,"_21201":121581,"_5":14582,"_27821":121497,"_3006":121582},[],"Clave generada por el dispositivo",{"_3550":72454,"_30605":72420,"_21201":121584,"_5":14582,"_27821":121497,"_3006":121585},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3550":72455,"_30605":72420,"_21201":121587,"_5":14582,"_27821":121497,"_3006":121588},[],"Clave ya disponible en el dispositivo",{"_3550":72456,"_30605":72420,"_21201":121590,"_5":14582,"_27821":121497,"_3006":121591},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3550":72457,"_30605":72420,"_21201":121593,"_5":14582,"_27821":121497,"_3006":52949},[],{"_3550":72458,"_30605":72420,"_21201":121595,"_5":14582,"_27821":121497,"_3006":121596},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3550":72459,"_30605":72420,"_21201":121598,"_5":14582,"_27821":121497,"_3006":121599},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3550":72460,"_30605":72420,"_21201":121601,"_5":14582,"_27821":121501,"_3006":121602},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3550":72461,"_30605":72461,"_5":14934,"_3006":121604,"_30964":121605,"_21201":121606,"_27821":72461},"Renovación y recuperación",[49995,119453,52630,120586,120761],[],{"_3550":72462,"_30605":72461,"_21201":121608,"_5":14582,"_27821":72461,"_3006":121609},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3550":72463,"_30605":72461,"_5":30961,"_21201":121611,"_27821":121612,"_3006":121613},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3550":72464,"_30605":72461,"_5":30961,"_21201":121615,"_27821":121616,"_3006":121617},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3550":72465,"_30605":72461,"_5":30961,"_21201":121619,"_27821":121620,"_3006":121621},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3550":72466,"_30605":72461,"_5":30961,"_21201":121623,"_27821":121624,"_3006":121625},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3550":72467,"_30605":72461,"_5":30961,"_21201":121627,"_27821":121628,"_3006":121629},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3550":72468,"_30605":72461,"_21201":121631,"_5":14582,"_27821":72461,"_3006":121632},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3550":72469,"_30605":72461,"_21201":121634,"_5":14582,"_27821":121612,"_3006":121635},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3550":72470,"_30605":72461,"_21201":121637,"_5":14582,"_27821":121612,"_3006":121638},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3550":72471,"_30605":72461,"_21201":121640,"_5":14582,"_27821":121612,"_3006":121641},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3550":72472,"_30605":72461,"_21201":121643,"_5":14582,"_27821":121612,"_3006":121644},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3550":72473,"_30605":72461,"_21201":121646,"_5":14582,"_27821":121616,"_3006":121647},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3550":72474,"_30605":72461,"_21201":121649,"_5":14582,"_27821":121616,"_3006":121650},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3550":72475,"_30605":72461,"_21201":121652,"_5":14582,"_27821":121620,"_3006":121653},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3550":72476,"_30605":72461,"_21201":121655,"_5":14582,"_27821":121620,"_3006":121656},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3550":72477,"_30605":72461,"_21201":121658,"_5":14582,"_27821":121620,"_3006":121659},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3550":72478,"_30605":72461,"_21201":121661,"_5":14582,"_27821":121624,"_3006":121662},[],"Situación",{"_3550":72479,"_30605":72461,"_21201":121664,"_5":14582,"_27821":121624,"_3006":121665},[],"Procedimiento",{"_3550":72480,"_30605":72461,"_21201":121667,"_5":14582,"_27821":121624,"_3006":121668},[],"Certificado vigente, fuera de ventana",{"_3550":72481,"_30605":72461,"_21201":121670,"_5":14582,"_27821":121624,"_3006":121671},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3550":72482,"_30605":72461,"_21201":121673,"_5":14582,"_27821":121624,"_3006":121674},[],"Certificado vencido, clave disponible",{"_3550":72483,"_30605":72461,"_21201":121676,"_5":14582,"_27821":121624,"_3006":121677},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3550":72484,"_30605":72461,"_21201":121679,"_5":14582,"_27821":121624,"_3006":121680},[],"Renovación por webhook o `NO_AUTH`",{"_3550":72485,"_30605":72461,"_21201":121682,"_5":14582,"_27821":121624,"_3006":121683},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3550":72486,"_30605":72461,"_21201":121685,"_5":14582,"_27821":121624,"_3006":121686},[],"Clave perdida o inaccesible",{"_3550":72487,"_30605":72461,"_21201":121688,"_5":14582,"_27821":121624,"_3006":121689},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3550":72488,"_30605":72461,"_21201":121691,"_5":14582,"_27821":121624,"_3006":121692},[],"Identidad actual revocada",{"_3550":72489,"_30605":72461,"_21201":121694,"_5":14582,"_27821":121624,"_3006":121695},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3550":72490,"_30605":72461,"_21201":121697,"_5":14582,"_27821":121624,"_3006":121698},[],"Dispositivo sin identidad",{"_3550":72491,"_30605":72461,"_21201":121700,"_5":14582,"_27821":121624,"_3006":121701},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3550":72492,"_30605":72461,"_21201":121703,"_5":14582,"_27821":121624,"_3006":121704},[],"Dispositivo retirado",{"_3550":72493,"_30605":72461,"_21201":121706,"_5":14582,"_27821":121624,"_3006":121707},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3550":72494,"_30605":72461,"_21201":121709,"_5":14582,"_27821":121624,"_3006":121710},[],"Timeout, HTTP 500 o fallo de instalación",{"_3550":72495,"_30605":72461,"_21201":121712,"_5":14582,"_27821":121624,"_3006":121713},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3550":72496,"_30605":72461,"_21201":121715,"_5":14582,"_27821":121628,"_3006":121716},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3550":72497,"_30605":72461,"_21201":121718,"_5":14582,"_27821":121628,"_3006":121719},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3550":72498,"_30605":72498,"_5":14934,"_3006":121721,"_30964":121722,"_21201":121723,"_27821":72498},"Diagnóstico de enrolamiento",[49995,119453,52630,120586,120761],[],{"_3550":72499,"_30605":72498,"_21201":121725,"_5":14582,"_27821":72498,"_3006":121726},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3550":72500,"_30605":72498,"_5":30961,"_21201":121728,"_27821":121729,"_3006":121730},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3550":72501,"_30605":72498,"_5":30961,"_21201":121732,"_27821":121733,"_3006":121734},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3550":72502,"_30605":72498,"_5":30961,"_21201":121736,"_27821":121737,"_3006":121293},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3550":72503,"_30605":72498,"_5":30961,"_21201":121739,"_27821":121740,"_3006":121741},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3550":72504,"_30605":72498,"_21201":121743,"_5":14582,"_27821":72498,"_3006":121744},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3550":72505,"_30605":72498,"_21201":121746,"_5":14582,"_27821":121733,"_3006":121747},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3550":72506,"_30605":72498,"_21201":121749,"_5":14582,"_27821":121733,"_3006":121750},[],"Síntoma o mensaje",{"_3550":72507,"_30605":72498,"_21201":121752,"_5":14582,"_27821":121733,"_3006":121753},[],"Qué revisar",{"_3550":72508,"_30605":72498,"_21201":121755,"_5":14582,"_27821":121733,"_3006":121756},[],"curl rechaza TLS, nombre o emisor",{"_3550":72509,"_30605":72498,"_21201":121758,"_5":14582,"_27821":121733,"_3006":121759},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3550":72510,"_30605":72498,"_21201":121761,"_5":14582,"_27821":121733,"_3006":121762},[],"404 o APS ausente",{"_3550":72511,"_30605":72498,"_21201":121764,"_5":14582,"_27821":121733,"_3006":121765},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3550":72512,"_30605":72498,"_21201":121767,"_5":14582,"_27821":121733,"_3006":121768},[],"400, error de CSR o formato",{"_3550":72513,"_30605":72498,"_21201":121770,"_5":14582,"_27821":121733,"_3006":121771},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3550":72514,"_30605":72498,"_21201":121773,"_5":14582,"_27821":121733,"_3006":121774},[],"Credencial ausente o certificado no válido",{"_3550":72515,"_30605":72498,"_21201":121776,"_5":14582,"_27821":121733,"_3006":121777},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3550":72516,"_30605":72498,"_21201":121779,"_5":14582,"_27821":121733,"_3006":121780},[],"Webhook deniega, expira o responde sin autorización",{"_3550":72517,"_30605":72498,"_21201":121782,"_5":14582,"_27821":121733,"_3006":121783},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3550":72518,"_30605":72498,"_21201":121785,"_5":14582,"_27821":121733,"_3006":53875},[],{"_3550":72519,"_30605":72498,"_21201":121787,"_5":14582,"_27821":121733,"_3006":121788},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3550":72520,"_30605":72498,"_21201":121790,"_5":14582,"_27821":121733,"_3006":53881},[],{"_3550":72521,"_30605":72498,"_21201":121792,"_5":14582,"_27821":121733,"_3006":121793},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3550":72522,"_30605":72498,"_21201":121795,"_5":14582,"_27821":121733,"_3006":53887},[],{"_3550":72523,"_30605":72498,"_21201":121797,"_5":14582,"_27821":121733,"_3006":121798},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3550":72524,"_30605":72498,"_21201":121800,"_5":14582,"_27821":121733,"_3006":53893},[],{"_3550":72525,"_30605":72498,"_21201":121802,"_5":14582,"_27821":121733,"_3006":121803},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3550":72526,"_30605":72498,"_21201":121805,"_5":14582,"_27821":121733,"_3006":53899},[],{"_3550":72527,"_30605":72498,"_21201":121807,"_5":14582,"_27821":121733,"_3006":121808},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3550":72528,"_30605":72498,"_21201":121810,"_5":14582,"_27821":121733,"_3006":121811},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3550":72529,"_30605":72498,"_21201":121813,"_5":14582,"_27821":121733,"_3006":121814},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3550":72530,"_30605":72498,"_21201":121816,"_5":14582,"_27821":121733,"_3006":121817},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3550":72531,"_30605":72498,"_21201":121819,"_5":14582,"_27821":121733,"_3006":121820},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3550":72532,"_30605":72498,"_21201":121822,"_5":14582,"_27821":121733,"_3006":53917},[],{"_3550":72533,"_30605":72498,"_21201":121824,"_5":14582,"_27821":121733,"_3006":121825},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3550":72534,"_30605":72498,"_21201":121827,"_5":14582,"_27821":121733,"_3006":53923},[],{"_3550":72535,"_30605":72498,"_21201":121829,"_5":14582,"_27821":121733,"_3006":121830},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3550":72536,"_30605":72498,"_21201":121832,"_5":14582,"_27821":121733,"_3006":121833},[],"DMS propietario distinto",{"_3550":72537,"_30605":72498,"_21201":121835,"_5":14582,"_27821":121733,"_3006":121836},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3550":72538,"_30605":72498,"_21201":121838,"_5":14582,"_27821":121733,"_3006":53935},[],{"_3550":72539,"_30605":72498,"_21201":121840,"_5":14582,"_27821":121733,"_3006":121841},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3550":72540,"_30605":72498,"_21201":121843,"_5":14582,"_27821":121733,"_3006":53941},[],{"_3550":72541,"_30605":72498,"_21201":121845,"_5":14582,"_27821":121733,"_3006":121846},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3550":72542,"_30605":72498,"_21201":121848,"_5":14582,"_27821":121733,"_3006":121849},[],"Certificado actual revocado",{"_3550":72543,"_30605":72498,"_21201":121851,"_5":14582,"_27821":121733,"_3006":121852},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3550":72544,"_30605":72498,"_21201":121854,"_5":14582,"_27821":121733,"_3006":121855},[],"Error de CA, perfil o firma",{"_3550":72545,"_30605":72498,"_21201":121857,"_5":14582,"_27821":121733,"_3006":121858},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3550":72546,"_30605":72498,"_21201":121860,"_5":14582,"_27821":121733,"_3006":121861},[],"HTTP 200 sin conexión del dispositivo",{"_3550":72547,"_30605":72498,"_21201":121863,"_5":14582,"_27821":121733,"_3006":121864},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3550":72548,"_30605":72498,"_21201":121866,"_5":14582,"_27821":121733,"_3006":121867},[],"Timeout o error después de emitir",{"_3550":72549,"_30605":72498,"_21201":121869,"_5":14582,"_27821":121733,"_3006":121870},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3550":72550,"_30605":72498,"_21201":121872,"_5":14582,"_27821":121737,"_3006":121873},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3550":72551,"_30605":72498,"_21201":121875,"_5":14582,"_27821":121737,"_3006":121876},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3550":72552,"_30605":72498,"_21201":121878,"_5":14582,"_27821":121740,"_3006":121879},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3550":72553,"_30605":72498,"_21201":121881,"_5":14582,"_27821":121740,"_3006":121882},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3550":72554,"_30605":72498,"_21201":121884,"_5":14582,"_27821":121740,"_3006":121885},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3550":72555,"_30605":72498,"_21201":121887,"_5":14582,"_27821":121740,"_3006":121888},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3550":72556,"_30605":72498,"_21201":121890,"_5":14582,"_27821":121740,"_3006":121891},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3550":72557,"_30605":72498,"_21201":121893,"_5":14582,"_27821":121740,"_3006":121894},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3550":72558,"_30605":72498,"_21201":121896,"_5":14582,"_27821":121740,"_3006":121897},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3550":72559,"_30605":72559,"_5":14934,"_3006":121899,"_30964":121900,"_21201":121901,"_27821":72559},"Distribución y actualización de confianza",[49995,119453,52630,120586,120761],[],{"_3550":72560,"_30605":72559,"_21201":121903,"_5":14582,"_27821":72559,"_3006":121904},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3550":72561,"_30605":72559,"_5":30961,"_21201":121906,"_27821":121907,"_3006":121908},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3550":72562,"_30605":72559,"_5":30961,"_21201":121910,"_27821":121911,"_3006":121912},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3550":72563,"_30605":72559,"_5":30961,"_21201":121914,"_27821":121915,"_3006":121916},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3550":72564,"_30605":72559,"_5":30961,"_21201":121918,"_27821":121919,"_3006":121920},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3550":72565,"_30605":72559,"_5":30961,"_21201":121922,"_27821":121923,"_3006":121924},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3550":72566,"_30605":72559,"_21201":121926,"_5":14582,"_27821":72559,"_3006":121927},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3550":72567,"_30605":72559,"_21201":121929,"_5":14582,"_27821":121907,"_3006":121930},[],"Relación",{"_3550":72568,"_30605":72559,"_21201":121932,"_5":14582,"_27821":121907,"_3006":121933},[],"Material que prepara el responsable",{"_3550":72569,"_30605":72559,"_21201":121935,"_5":14582,"_27821":121907,"_3006":121936},[],"Dispositivo → servidor EST",{"_3550":72570,"_30605":72559,"_21201":121938,"_5":14582,"_27821":121907,"_3006":121939},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3550":72571,"_30605":72559,"_21201":121941,"_5":14582,"_27821":121907,"_3006":121942},[],"DMS → solicitante",{"_3550":72572,"_30605":72559,"_21201":121944,"_5":14582,"_27821":121907,"_3006":121945},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3550":72573,"_30605":72559,"_21201":121947,"_5":14582,"_27821":121907,"_3006":121948},[],"Consumidor → dispositivo",{"_3550":72574,"_30605":72559,"_21201":121950,"_5":14582,"_27821":121907,"_3006":121951},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3550":72575,"_30605":72559,"_21201":121953,"_5":14582,"_27821":121907,"_3006":121954},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3550":72576,"_30605":72559,"_21201":121956,"_5":14582,"_27821":121911,"_3006":121957},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3550":72577,"_30605":72559,"_21201":121959,"_5":14582,"_27821":121911,"_3006":121960},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3550":72578,"_30605":72559,"_21201":121962,"_5":14582,"_27821":121915,"_3006":121963},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3550":72579,"_30605":72559,"_21201":121965,"_5":14582,"_27821":121915,"_3006":121966},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3550":72580,"_30605":72559,"_21201":121968,"_5":14582,"_27821":121915,"_3006":121969},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3550":72581,"_30605":72559,"_21201":121971,"_5":14582,"_27821":121915,"_3006":121972},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3550":72582,"_30605":72559,"_21201":121974,"_5":14582,"_27821":121915,"_3006":121975},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3550":72583,"_30605":72559,"_21201":121977,"_5":14582,"_27821":121915,"_3006":121978},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3550":72584,"_30605":72559,"_21201":121980,"_5":14582,"_27821":121919,"_3006":121981},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3550":72585,"_30605":72559,"_21201":121983,"_5":14582,"_27821":121919,"_3006":121984},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3550":72586,"_30605":72559,"_21201":121986,"_5":14582,"_27821":121919,"_3006":121987},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3550":72587,"_30605":72559,"_21201":121989,"_5":14582,"_27821":121923,"_3006":121990},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3550":72588,"_30605":72588,"_5":14934,"_3006":54090,"_30964":121992,"_21201":121994,"_27821":72588},[49995,119453,52630,120586,121993],"Integraciones",[],{"_3550":72589,"_30605":72588,"_21201":121996,"_5":14582,"_27821":72588,"_3006":121997},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3550":72590,"_30605":72588,"_5":30961,"_21201":121999,"_27821":122000,"_3006":122001},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3550":72591,"_30605":72588,"_5":30961,"_21201":122003,"_27821":122004,"_3006":122005},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3550":72592,"_30605":72588,"_5":30961,"_21201":122007,"_27821":122008,"_3006":122009},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3550":72593,"_30605":72588,"_5":30961,"_21201":122011,"_27821":122012,"_3006":122013},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3550":72594,"_30605":72588,"_5":30961,"_21201":122015,"_27821":122016,"_3006":122017},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3550":72595,"_30605":72588,"_5":30961,"_21201":122019,"_27821":122020,"_3006":122021},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3550":72596,"_30605":72588,"_5":30961,"_21201":122023,"_27821":122024,"_3006":122025},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3550":72597,"_30605":72588,"_5":30961,"_21201":122027,"_27821":122028,"_3006":122029},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3550":72598,"_30605":72588,"_5":30961,"_21201":122031,"_27821":122032,"_3006":54132},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3550":72599,"_30605":72588,"_5":30961,"_21201":122034,"_27821":122035,"_3006":54136},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3550":72600,"_30605":72588,"_5":30961,"_21201":122037,"_27821":122038,"_3006":122039},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3550":72601,"_30605":72588,"_5":30961,"_21201":122041,"_27821":122042,"_3006":122043},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3550":72602,"_30605":72588,"_5":30961,"_21201":122045,"_27821":122046,"_3006":122047},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3550":72603,"_30605":72588,"_5":30961,"_21201":122049,"_27821":122050,"_3006":122051},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3550":72604,"_30605":72588,"_5":30961,"_21201":122053,"_27821":122054,"_3006":122055},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3550":72605,"_30605":72588,"_5":30961,"_21201":122057,"_27821":122058,"_3006":122059},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3550":72606,"_30605":72588,"_5":30961,"_21201":122061,"_27821":122062,"_3006":122063},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3550":72607,"_30605":72588,"_5":30961,"_21201":122065,"_27821":122066,"_3006":122067},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3550":72608,"_30605":72588,"_5":30961,"_21201":122069,"_27821":122070,"_3006":122071},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3550":72609,"_30605":72588,"_5":30961,"_21201":122073,"_27821":122074,"_3006":122075},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3550":72610,"_30605":72588,"_5":30961,"_21201":122077,"_27821":122078,"_3006":122079},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3550":72611,"_30605":72588,"_5":30961,"_21201":122081,"_27821":122082,"_3006":122083},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3550":72612,"_30605":72588,"_5":30961,"_21201":122085,"_27821":122086,"_3006":122087},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3550":72613,"_30605":72588,"_5":30961,"_21201":122089,"_27821":122090,"_3006":122091},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3550":72614,"_30605":72588,"_5":30961,"_21201":122093,"_27821":122094,"_3006":122095},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3550":72615,"_30605":72588,"_21201":122097,"_5":14582,"_27821":72588,"_3006":122098},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3550":72616,"_30605":72588,"_21201":122100,"_5":14582,"_27821":72588,"_3006":122101},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3550":72617,"_30605":72588,"_21201":122103,"_5":14582,"_27821":72588,"_3006":122104},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3550":72618,"_30605":72588,"_21201":122106,"_5":14582,"_27821":122000,"_3006":122107},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3550":72619,"_30605":72588,"_21201":122109,"_5":14582,"_27821":122000,"_3006":122110},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3550":72620,"_30605":72588,"_21201":122112,"_5":14582,"_27821":122000,"_3006":122113},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3550":72621,"_30605":72588,"_21201":122115,"_5":14582,"_27821":122000,"_3006":122116},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3550":72622,"_30605":72588,"_21201":122118,"_5":14582,"_27821":122004,"_3006":122119},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3550":72623,"_30605":72588,"_21201":122121,"_5":14582,"_27821":122008,"_3006":122122},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3550":72624,"_30605":72588,"_21201":122124,"_5":14582,"_27821":122008,"_3006":122125},[],"Acción IAM",{"_3550":72625,"_30605":72588,"_21201":122127,"_5":14582,"_27821":122008,"_3006":118394},[],{"_3550":72626,"_30605":72588,"_21201":122129,"_5":14582,"_27821":122008,"_3006":54231},[],{"_3550":72627,"_30605":72588,"_21201":122131,"_5":14582,"_27821":122008,"_3006":122132},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3550":72628,"_30605":72588,"_21201":122134,"_5":14582,"_27821":122008,"_3006":54237},[],{"_3550":72629,"_30605":72588,"_21201":122136,"_5":14582,"_27821":122008,"_3006":122137},[],"Registrar la CA en AWS IoT",{"_3550":72630,"_30605":72588,"_21201":122139,"_5":14582,"_27821":122008,"_3006":54243},[],{"_3550":72631,"_30605":72588,"_21201":122141,"_5":14582,"_27821":122008,"_3006":122142},[],"Consultar el estado del registro de la CA",{"_3550":72632,"_30605":72588,"_21201":122144,"_5":14582,"_27821":122008,"_3006":54249},[],{"_3550":72633,"_30605":72588,"_21201":122146,"_5":14582,"_27821":122008,"_3006":122147},[],"Crear o actualizar Things en IoT Core",{"_3550":72634,"_30605":72588,"_21201":122149,"_5":14582,"_27821":122008,"_3006":54255},[],{"_3550":72635,"_30605":72588,"_21201":122151,"_5":14582,"_27821":122008,"_3006":122152},[],"Aprovisionar Things mediante plantilla",{"_3550":72636,"_30605":72588,"_21201":122154,"_5":14582,"_27821":122008,"_3006":54261},[],{"_3550":72637,"_30605":72588,"_21201":122156,"_5":14582,"_27821":122008,"_3006":122157},[],"Registrar certificados de dispositivo",{"_3550":72638,"_30605":72588,"_21201":122159,"_5":14582,"_27821":122008,"_3006":54267},[],{"_3550":72639,"_30605":72588,"_21201":122161,"_5":14582,"_27821":122008,"_3006":122162},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3550":72640,"_30605":72588,"_21201":122164,"_5":14582,"_27821":122008,"_3006":54273},[],{"_3550":72641,"_30605":72588,"_21201":122166,"_5":14582,"_27821":122008,"_3006":122167},[],"Crear y adjuntar políticas IoT",{"_3550":72642,"_30605":72588,"_21201":122169,"_5":14582,"_27821":122008,"_3006":54279},[],{"_3550":72643,"_30605":72588,"_21201":122171,"_5":14582,"_27821":122008,"_3006":122172},[],"Gestionar grupos de Things",{"_3550":72644,"_30605":72588,"_21201":122174,"_5":14582,"_27821":122008,"_3006":54285},[],{"_3550":72645,"_30605":72588,"_21201":122176,"_5":14582,"_27821":122008,"_3006":122177},[],"Crear plantillas JITP",{"_3550":72646,"_30605":72588,"_21201":122179,"_5":14582,"_27821":122008,"_3006":54291},[],{"_3550":72647,"_30605":72588,"_21201":122181,"_5":14582,"_27821":122008,"_3006":122182},[],"Leer y escribir el Device Shadow",{"_3550":72648,"_30605":72588,"_21201":122184,"_5":14582,"_27821":122008,"_3006":122185},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3550":72649,"_30605":72588,"_21201":122187,"_5":14582,"_27821":122012,"_3006":122188},[],"Parámetro",{"_3550":72650,"_30605":72588,"_21201":122190,"_5":14582,"_27821":122012,"_3006":122191},[],"Tipo",{"_3550":72651,"_30605":72588,"_21201":122193,"_5":14582,"_27821":122012,"_3006":122194},[],"Requerido",{"_3550":72652,"_30605":72588,"_21201":122196,"_5":14582,"_27821":122012,"_3006":122197},[],"Descripción",{"_3550":72653,"_30605":72588,"_21201":122199,"_5":14582,"_27821":122012,"_3006":54312},[],{"_3550":72654,"_30605":72588,"_21201":122201,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72655,"_30605":72588,"_21201":122203,"_5":14582,"_27821":122012,"_3006":122204},[],"Sí",{"_3550":72656,"_30605":72588,"_21201":122206,"_5":14582,"_27821":122012,"_3006":122207},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3550":72657,"_30605":72588,"_21201":122209,"_5":14582,"_27821":122012,"_3006":54323},[],{"_3550":72658,"_30605":72588,"_21201":122211,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72659,"_30605":72588,"_21201":122213,"_5":14582,"_27821":122012,"_3006":122204},[],{"_3550":72660,"_30605":72588,"_21201":122215,"_5":14582,"_27821":122012,"_3006":122216},[],"Región AWS donde opera el conector.",{"_3550":72661,"_30605":72588,"_21201":122218,"_5":14582,"_27821":122012,"_3006":54333},[],{"_3550":72662,"_30605":72588,"_21201":122220,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72663,"_30605":72588,"_21201":122222,"_5":14582,"_27821":122012,"_3006":122204},[],{"_3550":72664,"_30605":72588,"_21201":122224,"_5":14582,"_27821":122012,"_3006":122225},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3550":72665,"_30605":72588,"_21201":122227,"_5":14582,"_27821":122012,"_3006":54343},[],{"_3550":72666,"_30605":72588,"_21201":122229,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72667,"_30605":72588,"_21201":122231,"_5":14582,"_27821":122012,"_3006":122232},[],"Solo con `auth_method=static`",{"_3550":72668,"_30605":72588,"_21201":122234,"_5":14582,"_27821":122012,"_3006":122235},[],"Clave de acceso AWS.",{"_3550":72669,"_30605":72588,"_21201":122237,"_5":14582,"_27821":122012,"_3006":54354},[],{"_3550":72670,"_30605":72588,"_21201":122239,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72671,"_30605":72588,"_21201":122241,"_5":14582,"_27821":122012,"_3006":122232},[],{"_3550":72672,"_30605":72588,"_21201":122243,"_5":14582,"_27821":122012,"_3006":122244},[],"Clave secreta AWS.",{"_3550":72673,"_30605":72588,"_21201":122246,"_5":14582,"_27821":122012,"_3006":54364},[],{"_3550":72674,"_30605":72588,"_21201":122248,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72675,"_30605":72588,"_21201":122250,"_5":14582,"_27821":122012,"_3006":54369},[],{"_3550":72676,"_30605":72588,"_21201":122252,"_5":14582,"_27821":122012,"_3006":122253},[],"Token de sesión (con `auth_method=static`).",{"_3550":72677,"_30605":72588,"_21201":122255,"_5":14582,"_27821":122012,"_3006":54375},[],{"_3550":72678,"_30605":72588,"_21201":122257,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72679,"_30605":72588,"_21201":122259,"_5":14582,"_27821":122012,"_3006":122260},[],"Solo con `auth_method=role`",{"_3550":72680,"_30605":72588,"_21201":122262,"_5":14582,"_27821":122012,"_3006":122263},[],"ARN del rol a asumir.",{"_3550":72681,"_30605":72588,"_21201":122265,"_5":14582,"_27821":122012,"_3006":54386},[],{"_3550":72682,"_30605":72588,"_21201":122267,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72683,"_30605":72588,"_21201":122269,"_5":14582,"_27821":122012,"_3006":54369},[],{"_3550":72684,"_30605":72588,"_21201":122271,"_5":14582,"_27821":122012,"_3006":122272},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3550":72685,"_30605":72588,"_21201":122274,"_5":14582,"_27821":122012,"_3006":54396},[],{"_3550":72686,"_30605":72588,"_21201":122276,"_5":14582,"_27821":122012,"_3006":91119},[],{"_3550":72687,"_30605":72588,"_21201":122278,"_5":14582,"_27821":122012,"_3006":122204},[],{"_3550":72688,"_30605":72588,"_21201":122280,"_5":14582,"_27821":122012,"_3006":122281},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3550":72689,"_30605":72588,"_21201":122283,"_5":14582,"_27821":122012,"_3006":54406},[],{"_3550":72690,"_30605":72588,"_21201":122285,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72691,"_30605":72588,"_21201":122287,"_5":14582,"_27821":122012,"_3006":122204},[],{"_3550":72692,"_30605":72588,"_21201":122289,"_5":14582,"_27821":122012,"_3006":122290},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3550":72693,"_30605":72588,"_21201":122292,"_5":14582,"_27821":122012,"_3006":54416},[],{"_3550":72694,"_30605":72588,"_21201":122294,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72695,"_30605":72588,"_21201":122296,"_5":14582,"_27821":122012,"_3006":122204},[],{"_3550":72696,"_30605":72588,"_21201":122298,"_5":14582,"_27821":122012,"_3006":122299},[],"URL HTTP del Device Manager de Lamassu.",{"_3550":72697,"_30605":72588,"_21201":122301,"_5":14582,"_27821":122012,"_3006":54426},[],{"_3550":72698,"_30605":72588,"_21201":122303,"_5":14582,"_27821":122012,"_3006":25326},[],{"_3550":72699,"_30605":72588,"_21201":122305,"_5":14582,"_27821":122012,"_3006":122204},[],{"_3550":72700,"_30605":72588,"_21201":122307,"_5":14582,"_27821":122012,"_3006":122308},[],"URL HTTP del servicio de CA de Lamassu.",{"_3550":72701,"_30605":72588,"_21201":122310,"_5":14582,"_27821":122016,"_3006":122311},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3550":72702,"_30605":72588,"_21201":122313,"_5":14582,"_27821":122016,"_3006":122314},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3550":72703,"_30605":72588,"_21201":122316,"_5":14582,"_27821":122016,"_3006":122317},[],"Tipo de CloudEvent",{"_3550":72704,"_30605":72588,"_21201":122319,"_5":14582,"_27821":122016,"_3006":122320},[],"Recurso en Lamassu",{"_3550":72705,"_30605":72588,"_21201":122322,"_5":14582,"_27821":122016,"_3006":122323},[],"Recurso AWS",{"_3550":72706,"_30605":72588,"_21201":122325,"_5":14582,"_27821":122016,"_3006":122326},[],"Acciones IAM",{"_3550":72707,"_30605":72588,"_21201":122328,"_5":14582,"_27821":122016,"_3006":122329},[],"Llamadas AWS y efecto",{"_3550":72708,"_30605":72588,"_21201":122331,"_5":14582,"_27821":122016,"_3006":122332},[],"Dónde en esta página",{"_3550":72709,"_30605":72588,"_21201":122334,"_5":14582,"_27821":122016,"_3006":54460},[],{"_3550":72710,"_30605":72588,"_21201":122336,"_5":14582,"_27821":122016,"_3006":54463},[],{"_3550":72711,"_30605":72588,"_21201":122338,"_5":14582,"_27821":122016,"_3006":54466},[],{"_3550":72712,"_30605":72588,"_21201":122340,"_5":14582,"_27821":122016,"_3006":54469},[],{"_3550":72713,"_30605":72588,"_21201":122342,"_5":14582,"_27821":122016,"_3006":122343},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3550":72714,"_30605":72588,"_21201":122345,"_5":14582,"_27821":122016,"_3006":122029},[],{"_3550":72715,"_30605":72588,"_21201":122347,"_5":14582,"_27821":122016,"_3006":54477},[],{"_3550":72716,"_30605":72588,"_21201":122349,"_5":14582,"_27821":122016,"_3006":54480},[],{"_3550":72717,"_30605":72588,"_21201":122351,"_5":14582,"_27821":122016,"_3006":54483},[],{"_3550":72718,"_30605":72588,"_21201":122353,"_5":14582,"_27821":122016,"_3006":54486},[],{"_3550":72719,"_30605":72588,"_21201":122355,"_5":14582,"_27821":122016,"_3006":122356},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3550":72720,"_30605":72588,"_21201":122358,"_5":14582,"_27821":122016,"_3006":122055},[],{"_3550":72721,"_30605":72588,"_21201":122360,"_5":14582,"_27821":122016,"_3006":54494},[],{"_3550":72722,"_30605":72588,"_21201":122362,"_5":14582,"_27821":122016,"_3006":122363},[],"Dispositivo",{"_3550":72723,"_30605":72588,"_21201":122365,"_5":14582,"_27821":122016,"_3006":54500},[],{"_3550":72724,"_30605":72588,"_21201":122367,"_5":14582,"_27821":122016,"_3006":54503},[],{"_3550":72725,"_30605":72588,"_21201":122369,"_5":14582,"_27821":122016,"_3006":122370},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3550":72726,"_30605":72588,"_21201":122372,"_5":14582,"_27821":122016,"_3006":122063},[],{"_3550":72727,"_30605":72588,"_21201":122374,"_5":14582,"_27821":122016,"_3006":54511},[],{"_3550":72728,"_30605":72588,"_21201":122376,"_5":14582,"_27821":122016,"_3006":122377},[],"Certificado",{"_3550":72729,"_30605":72588,"_21201":122379,"_5":14582,"_27821":122016,"_3006":54517},[],{"_3550":72730,"_30605":72588,"_21201":122381,"_5":14582,"_27821":122016,"_3006":122382},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3550":72731,"_30605":72588,"_21201":122384,"_5":14582,"_27821":122016,"_3006":122385},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3550":72732,"_30605":72588,"_21201":122387,"_5":14582,"_27821":122016,"_3006":122075},[],{"_3550":72733,"_30605":72588,"_21201":122389,"_5":14582,"_27821":122016,"_3006":54528},[],{"_3550":72734,"_30605":72588,"_21201":122391,"_5":14582,"_27821":122016,"_3006":122392},[],"Certificado / Dispositivo",{"_3550":72735,"_30605":72588,"_21201":122394,"_5":14582,"_27821":122016,"_3006":54534},[],{"_3550":72736,"_30605":72588,"_21201":122396,"_5":14582,"_27821":122016,"_3006":50391},[],{"_3550":72737,"_30605":72588,"_21201":122398,"_5":14582,"_27821":122016,"_3006":122399},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3550":72738,"_30605":72588,"_21201":122401,"_5":14582,"_27821":122016,"_3006":122083},[],{"_3550":72739,"_30605":72588,"_21201":122403,"_5":14582,"_27821":122020,"_3006":122404},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3550":72740,"_30605":72588,"_21201":122406,"_5":14582,"_27821":122024,"_3006":122407},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3550":72741,"_30605":72588,"_21201":122409,"_5":14582,"_27821":122024,"_3006":122410},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3550":72742,"_30605":72588,"_21201":122412,"_5":14582,"_27821":122028,"_3006":122413},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3550":72743,"_30605":72588,"_21201":122415,"_5":14582,"_27821":122028,"_3006":122416},[],"Transición",{"_3550":72744,"_30605":72588,"_21201":122418,"_5":14582,"_27821":122028,"_3006":122419},[],"Llamadas AWS",{"_3550":72745,"_30605":72588,"_21201":122421,"_5":14582,"_27821":122028,"_3006":122422},[],"`NoRegistrada` → `Solicitada`",{"_3550":72746,"_30605":72588,"_21201":122424,"_5":14582,"_27821":122028,"_3006":122425},[],"ninguna (solo escritura de metadatos)",{"_3550":72747,"_30605":72588,"_21201":122427,"_5":14582,"_27821":122028,"_3006":122428},[],"`Solicitada` → `Registrando`",{"_3550":72748,"_30605":72588,"_21201":122430,"_5":14582,"_27821":122028,"_3006":122431},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3550":72749,"_30605":72588,"_21201":122433,"_5":14582,"_27821":122028,"_3006":122434},[],"`Registrando` → `Completada`",{"_3550":72750,"_30605":72588,"_21201":122436,"_5":14582,"_27821":122028,"_3006":122437},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3550":72751,"_30605":72588,"_21201":122439,"_5":14582,"_27821":122028,"_3006":122440},[],"`Registrando` → `Fallida`",{"_3550":72752,"_30605":72588,"_21201":122442,"_5":14582,"_27821":122028,"_3006":122443},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3550":72753,"_30605":72588,"_21201":122445,"_5":14582,"_27821":122028,"_3006":122446},[],"`Fallida` / `Completada` → `Solicitada`",{"_3550":72754,"_30605":72588,"_21201":122448,"_5":14582,"_27821":122028,"_3006":122449},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3550":72755,"_30605":72588,"_21201":122451,"_5":14582,"_27821":122032,"_3006":122452},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3550":72756,"_30605":72588,"_21201":122454,"_5":14582,"_27821":122032,"_3006":122455},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3550":72757,"_30605":72588,"_21201":122457,"_5":14582,"_27821":122032,"_3006":122458},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3550":72758,"_30605":72588,"_21201":122460,"_5":14582,"_27821":122032,"_3006":122461},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3550":72759,"_30605":72588,"_21201":122463,"_5":14582,"_27821":122032,"_3006":122464},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3550":72760,"_30605":72588,"_21201":122466,"_5":14582,"_27821":122032,"_3006":122467},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3550":72761,"_30605":72588,"_21201":122469,"_5":14582,"_27821":122035,"_3006":122470},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3550":72762,"_30605":72588,"_21201":122472,"_5":14582,"_27821":122038,"_3006":122473},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3550":72763,"_30605":72588,"_21201":122475,"_5":14582,"_27821":122038,"_3006":122476},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3550":72764,"_30605":72588,"_21201":122478,"_5":14582,"_27821":122042,"_3006":122479},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3550":72765,"_30605":72588,"_21201":122481,"_5":14582,"_27821":122046,"_3006":122482},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3550":72766,"_30605":72588,"_21201":122484,"_5":14582,"_27821":122046,"_3006":122485},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3550":72767,"_30605":72588,"_21201":122487,"_5":14582,"_27821":122046,"_3006":122488},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3550":72768,"_30605":72588,"_21201":122490,"_5":14582,"_27821":122046,"_3006":122491},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3550":72769,"_30605":72588,"_21201":122493,"_5":14582,"_27821":122046,"_3006":122494},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3550":72770,"_30605":72588,"_21201":122496,"_5":14582,"_27821":122046,"_3006":122497},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3550":72771,"_30605":72588,"_21201":122499,"_5":14582,"_27821":122050,"_3006":122500},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3550":72772,"_30605":72588,"_21201":122502,"_5":14582,"_27821":122050,"_3006":122503},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3550":72773,"_30605":72588,"_21201":122505,"_5":14582,"_27821":122050,"_3006":122506},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3550":72774,"_30605":72588,"_21201":122508,"_5":14582,"_27821":122050,"_3006":122509},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3550":72775,"_30605":72588,"_21201":122511,"_5":14582,"_27821":122050,"_3006":122512},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3550":72776,"_30605":72588,"_21201":122514,"_5":14582,"_27821":122054,"_3006":122515},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3550":72777,"_30605":72588,"_21201":122517,"_5":14582,"_27821":122054,"_3006":122416},[],{"_3550":72778,"_30605":72588,"_21201":122519,"_5":14582,"_27821":122054,"_3006":122419},[],{"_3550":72779,"_30605":72588,"_21201":122521,"_5":14582,"_27821":122054,"_3006":122522},[],"`SinConfigurar` → `None` / `Auto`",{"_3550":72780,"_30605":72588,"_21201":122524,"_5":14582,"_27821":122054,"_3006":122525},[],"ninguna (solo configuración)",{"_3550":72781,"_30605":72588,"_21201":122527,"_5":14582,"_27821":122054,"_3006":54671},[],{"_3550":72782,"_30605":72588,"_21201":122529,"_5":14582,"_27821":122054,"_3006":122525},[],{"_3550":72783,"_30605":72588,"_21201":122531,"_5":14582,"_27821":122054,"_3006":122532},[],"Cualquiera → `Jitp`",{"_3550":72784,"_30605":72588,"_21201":122534,"_5":14582,"_27821":122054,"_3006":122535},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3550":72785,"_30605":72588,"_21201":122537,"_5":14582,"_27821":122054,"_3006":54682},[],{"_3550":72786,"_30605":72588,"_21201":122539,"_5":14582,"_27821":122054,"_3006":122540},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3550":72787,"_30605":72588,"_21201":122542,"_5":14582,"_27821":122058,"_3006":122543},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3550":72788,"_30605":72588,"_21201":122545,"_5":14582,"_27821":122058,"_3006":122546},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3550":72789,"_30605":72588,"_21201":122548,"_5":14582,"_27821":122058,"_3006":122549},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3550":72790,"_30605":72588,"_21201":122551,"_5":14582,"_27821":122062,"_3006":122552},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3550":72791,"_30605":72588,"_21201":122554,"_5":14582,"_27821":122062,"_3006":122416},[],{"_3550":72792,"_30605":72588,"_21201":122556,"_5":14582,"_27821":122062,"_3006":122419},[],{"_3550":72793,"_30605":72588,"_21201":122558,"_5":14582,"_27821":122062,"_3006":122559},[],"`Ausente` → `Aprovisionado`",{"_3550":72794,"_30605":72588,"_21201":122561,"_5":14582,"_27821":122062,"_3006":122562},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3550":72795,"_30605":72588,"_21201":122564,"_5":14582,"_27821":122062,"_3006":122565},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3550":72796,"_30605":72588,"_21201":122567,"_5":14582,"_27821":122062,"_3006":122568},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3550":72797,"_30605":72588,"_21201":122570,"_5":14582,"_27821":122062,"_3006":122571},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3550":72798,"_30605":72588,"_21201":122573,"_5":14582,"_27821":122066,"_3006":122574},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3550":72799,"_30605":72588,"_21201":122576,"_5":14582,"_27821":122066,"_3006":122577},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3550":72800,"_30605":72588,"_21201":122579,"_5":14582,"_27821":122066,"_3006":122580},[],"Para que el flujo JITP funcione correctamente:",{"_3550":72801,"_30605":72588,"_21201":122582,"_5":14582,"_27821":122066,"_3006":122583},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3550":72802,"_30605":72588,"_21201":122585,"_5":14582,"_27821":122066,"_3006":122586},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3550":72803,"_30605":72588,"_21201":122588,"_5":14582,"_27821":122066,"_3006":122589},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3550":72804,"_30605":72588,"_21201":122591,"_5":14582,"_27821":122066,"_3006":122592},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3550":72805,"_30605":72588,"_21201":122594,"_5":14582,"_27821":122070,"_3006":122595},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3550":72806,"_30605":72588,"_21201":122597,"_5":14582,"_27821":122070,"_3006":122598},[],"Estado en Lamassu",{"_3550":72807,"_30605":72588,"_21201":122600,"_5":14582,"_27821":122070,"_3006":122601},[],"Razón de revocación",{"_3550":72808,"_30605":72588,"_21201":122603,"_5":14582,"_27821":122070,"_3006":122604},[],"Estado en AWS IoT Core",{"_3550":72809,"_30605":72588,"_21201":122606,"_5":14582,"_27821":122070,"_3006":54752},[],{"_3550":72810,"_30605":72588,"_21201":122608,"_5":14582,"_27821":122070,"_3006":122609},[],"Ninguna",{"_3550":72811,"_30605":72588,"_21201":122611,"_5":14582,"_27821":122070,"_3006":54758},[],{"_3550":72812,"_30605":72588,"_21201":122613,"_5":14582,"_27821":122070,"_3006":54761},[],{"_3550":72813,"_30605":72588,"_21201":122615,"_5":14582,"_27821":122070,"_3006":54764},[],{"_3550":72814,"_30605":72588,"_21201":122617,"_5":14582,"_27821":122070,"_3006":54767},[],{"_3550":72815,"_30605":72588,"_21201":122619,"_5":14582,"_27821":122070,"_3006":54761},[],{"_3550":72816,"_30605":72588,"_21201":122621,"_5":14582,"_27821":122070,"_3006":122622},[],"Cualquier otra razón",{"_3550":72817,"_30605":72588,"_21201":122624,"_5":14582,"_27821":122070,"_3006":54775},[],{"_3550":72818,"_30605":72588,"_21201":122626,"_5":14582,"_27821":122070,"_3006":122627},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3550":72819,"_30605":72588,"_21201":122629,"_5":14582,"_27821":122074,"_3006":122630},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3550":72820,"_30605":72588,"_21201":122632,"_5":14582,"_27821":122074,"_3006":122416},[],{"_3550":72821,"_30605":72588,"_21201":122634,"_5":14582,"_27821":122074,"_3006":122419},[],{"_3550":72822,"_30605":72588,"_21201":122636,"_5":14582,"_27821":122074,"_3006":122637},[],"`NoSincronizado` → `Active`",{"_3550":72823,"_30605":72588,"_21201":122639,"_5":14582,"_27821":122074,"_3006":54267},[],{"_3550":72824,"_30605":72588,"_21201":122641,"_5":14582,"_27821":122074,"_3006":54793},[],{"_3550":72825,"_30605":72588,"_21201":122643,"_5":14582,"_27821":122074,"_3006":122644},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3550":72826,"_30605":72588,"_21201":122646,"_5":14582,"_27821":122074,"_3006":54799},[],{"_3550":72827,"_30605":72588,"_21201":122648,"_5":14582,"_27821":122074,"_3006":122644},[],{"_3550":72828,"_30605":72588,"_21201":122650,"_5":14582,"_27821":122074,"_3006":54804},[],{"_3550":72829,"_30605":72588,"_21201":122652,"_5":14582,"_27821":122074,"_3006":54267},[],{"_3550":72830,"_30605":72588,"_21201":122654,"_5":14582,"_27821":122074,"_3006":54809},[],{"_3550":72831,"_30605":72588,"_21201":122656,"_5":14582,"_27821":122074,"_3006":122657},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3550":72832,"_30605":72588,"_21201":122659,"_5":14582,"_27821":122078,"_3006":122660},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3550":72833,"_30605":72588,"_21201":122662,"_5":14582,"_27821":122078,"_3006":122663},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3550":72834,"_30605":72588,"_21201":122665,"_5":14582,"_27821":122078,"_3006":122666},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3550":72835,"_30605":72588,"_21201":122668,"_5":14582,"_27821":122082,"_3006":122669},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3550":72836,"_30605":72588,"_21201":122671,"_5":14582,"_27821":122082,"_3006":122672},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3550":72837,"_30605":72588,"_21201":122674,"_5":14582,"_27821":122086,"_3006":122675},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3550":72838,"_30605":72588,"_21201":122677,"_5":14582,"_27821":122086,"_3006":122678},[],"Existen dos tipos de acciones:",{"_3550":72839,"_30605":72588,"_21201":122680,"_5":14582,"_27821":122086,"_3006":122681},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3550":72840,"_30605":72588,"_21201":122683,"_5":14582,"_27821":122086,"_3006":122684},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3550":72841,"_30605":72588,"_21201":122686,"_5":14582,"_27821":122086,"_3006":122687},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3550":72842,"_30605":72588,"_21201":122689,"_5":14582,"_27821":122090,"_3006":122690},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3550":72843,"_30605":72588,"_21201":122692,"_5":14582,"_27821":122090,"_3006":122693},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3550":72844,"_30605":72588,"_21201":122695,"_5":14582,"_27821":122090,"_3006":122696},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3550":72845,"_30605":72588,"_21201":122698,"_5":14582,"_27821":122094,"_3006":122699},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3550":72846,"_30605":72588,"_21201":122701,"_5":14582,"_27821":122094,"_3006":122702},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3550":72847,"_30605":72588,"_21201":122704,"_5":14582,"_27821":122094,"_3006":122705},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3550":72848,"_30605":72588,"_21201":122707,"_5":14582,"_27821":122094,"_3006":122708},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3550":72849,"_30605":72588,"_21201":122710,"_5":14582,"_27821":122094,"_3006":122711},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3550":72850,"_30605":72588,"_21201":122713,"_5":14582,"_27821":122094,"_3006":122714},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3550":72851,"_30605":72588,"_21201":122716,"_5":14582,"_27821":122094,"_3006":122717},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3550":72852,"_30605":72588,"_21201":122719,"_5":14582,"_27821":122094,"_3006":122720},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3550":72853,"_30605":72588,"_21201":122722,"_5":14582,"_27821":122094,"_3006":122723},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3550":72854,"_30605":72588,"_21201":122725,"_5":14582,"_27821":122094,"_3006":122726},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3550":72855,"_30605":72588,"_21201":122728,"_5":14582,"_27821":122094,"_3006":122729},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3550":72856,"_30605":72588,"_21201":122731,"_5":14582,"_27821":122094,"_3006":122732},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3550":72857,"_30605":72588,"_21201":122734,"_5":14582,"_27821":122094,"_3006":122735},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3550":72858,"_30605":72588,"_21201":122737,"_5":14582,"_27821":122094,"_3006":122738},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3550":72859,"_30605":72588,"_21201":122740,"_5":14582,"_27821":122094,"_3006":122741},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3550":72860,"_30605":72588,"_21201":122743,"_5":14582,"_27821":122094,"_3006":122744},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3550":72861,"_30605":72588,"_21201":122746,"_5":14582,"_27821":122094,"_3006":122747},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3550":72862,"_30605":72588,"_21201":122749,"_5":14582,"_27821":122094,"_3006":122750},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3550":72863,"_30605":72588,"_21201":122752,"_5":14582,"_27821":122094,"_3006":122753},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3550":72864,"_30605":72588,"_21201":122755,"_5":14582,"_27821":122094,"_3006":122756},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3550":72865,"_30605":72588,"_21201":122758,"_5":14582,"_27821":122094,"_3006":122759},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3550":72866,"_30605":72588,"_21201":122761,"_5":14582,"_27821":122094,"_3006":122762},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3550":72867,"_30605":72588,"_21201":122764,"_5":14582,"_27821":122094,"_3006":122765},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3550":72868,"_30605":72588,"_21201":122767,"_5":14582,"_27821":122094,"_3006":122768},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3550":72869,"_30605":72869,"_5":14934,"_3006":52630,"_30964":122770,"_21201":122771,"_27821":72869},[49995,119453,52630],[],{"_3550":72870,"_30605":72869,"_21201":122773,"_5":14582,"_27821":72869,"_3006":122774},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3550":72871,"_30605":72869,"_5":30961,"_21201":122776,"_27821":122777,"_3006":122778},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3550":72872,"_30605":72869,"_5":30961,"_21201":122780,"_27821":122781,"_3006":120586},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3550":72873,"_30605":72869,"_5":30961,"_21201":122783,"_27821":122784,"_3006":120761},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3550":72874,"_30605":72869,"_5":30961,"_21201":122786,"_27821":122787,"_3006":121993},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/overview#integraciones",{"_3550":72875,"_30605":72869,"_5":30961,"_21201":122789,"_27821":122790,"_3006":122791},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3550":72876,"_30605":72869,"_21201":122793,"_5":14582,"_27821":72869,"_3006":122794},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3550":72877,"_30605":72869,"_21201":122796,"_5":14582,"_27821":122777,"_3006":122797},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3550":72878,"_30605":72869,"_21201":122799,"_5":14582,"_27821":122777,"_3006":122800},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3550":72879,"_30605":72869,"_21201":122802,"_5":14582,"_27821":122781,"_3006":122803},[],"Recurso",{"_3550":72880,"_30605":72869,"_21201":122805,"_5":14582,"_27821":122781,"_3006":122806},[],"Qué representa",{"_3550":72881,"_30605":72869,"_21201":122808,"_5":14582,"_27821":122781,"_3006":122809},[],"**Dispositivo**",{"_3550":72882,"_30605":72869,"_21201":122811,"_5":14582,"_27821":122781,"_3006":122812},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3550":72883,"_30605":72869,"_21201":122814,"_5":14582,"_27821":122781,"_3006":122815},[],"**Identidad**",{"_3550":72884,"_30605":72869,"_21201":122817,"_5":14582,"_27821":122781,"_3006":122818},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3550":72885,"_30605":72869,"_21201":122820,"_5":14582,"_27821":122781,"_3006":54976},[],{"_3550":72886,"_30605":72869,"_21201":122822,"_5":14582,"_27821":122781,"_3006":122823},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3550":72887,"_30605":72869,"_21201":122825,"_5":14582,"_27821":122781,"_3006":122826},[],"**Flota**",{"_3550":72888,"_30605":72869,"_21201":122828,"_5":14582,"_27821":122781,"_3006":122829},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3550":72889,"_30605":72869,"_21201":122831,"_5":14582,"_27821":122781,"_3006":122832},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3550":72890,"_30605":72869,"_21201":122834,"_5":14582,"_27821":122781,"_3006":122835},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3550":72891,"_30605":72869,"_21201":122837,"_5":14582,"_27821":122784,"_3006":122838},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3550":72892,"_30605":72869,"_21201":122840,"_5":14582,"_27821":122784,"_3006":122841},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3550":72893,"_30605":72869,"_21201":122843,"_5":14582,"_27821":122784,"_3006":122844},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3550":72894,"_30605":72869,"_21201":122846,"_5":14582,"_27821":122784,"_3006":122847},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3550":72895,"_30605":72869,"_21201":122849,"_5":14582,"_27821":122784,"_3006":122850},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3550":72896,"_30605":72869,"_21201":122852,"_5":14582,"_27821":122784,"_3006":122853},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3550":72897,"_30605":72869,"_21201":122855,"_5":14582,"_27821":122784,"_3006":122856},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3550":72898,"_30605":72869,"_21201":122858,"_5":14582,"_27821":122784,"_3006":122859},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3550":72899,"_30605":72869,"_21201":122861,"_5":14582,"_27821":122787,"_3006":122862},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3550":72900,"_30605":72869,"_21201":122864,"_5":14582,"_27821":122787,"_3006":122865},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3550":72901,"_30605":72869,"_21201":122867,"_5":14582,"_27821":122790,"_3006":122868},[],"Participante",{"_3550":72902,"_30605":72869,"_21201":122870,"_5":14582,"_27821":122790,"_3006":122871},[],"Responsabilidad",{"_3550":72903,"_30605":72869,"_21201":122873,"_5":14582,"_27821":122790,"_3006":122874},[],"Administrador PKI",{"_3550":72904,"_30605":72869,"_21201":122876,"_5":14582,"_27821":122790,"_3006":122877},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3550":72905,"_30605":72869,"_21201":122879,"_5":14582,"_27821":122790,"_3006":122880},[],"Administrador del aprovisionamiento",{"_3550":72906,"_30605":72869,"_21201":122882,"_5":14582,"_27821":122790,"_3006":122883},[],"DMS, admisión, autenticación por operación e inventario.",{"_3550":72907,"_30605":72869,"_21201":122885,"_5":14582,"_27821":122790,"_3006":122886},[],"Integrador del dispositivo",{"_3550":72908,"_30605":72869,"_21201":122888,"_5":14582,"_27821":122790,"_3006":122889},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3550":72909,"_30605":72869,"_21201":122891,"_5":14582,"_27821":122790,"_3006":122892},[],"Integrador del consumidor",{"_3550":72910,"_30605":72869,"_21201":122894,"_5":14582,"_27821":122790,"_3006":122895},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3550":72911,"_30605":72869,"_21201":122897,"_5":14582,"_27821":122790,"_3006":122898},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3550":72912,"_30605":72912,"_5":14934,"_3006":122900,"_30964":122901,"_21201":122903,"_27821":72912},"Enrola y conecta tu primer dispositivo",[49995,119453,52630,122902],"Primeros pasos",[],{"_3550":72913,"_30605":72912,"_21201":122905,"_5":14582,"_27821":72912,"_3006":122906},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3550":72914,"_30605":72912,"_5":30961,"_21201":122908,"_27821":122909,"_3006":118024},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3550":72915,"_30605":72912,"_5":30961,"_21201":122911,"_27821":122912,"_3006":122913},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3550":72916,"_30605":72912,"_5":30961,"_21201":122915,"_27821":122916,"_3006":122917},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3550":72917,"_30605":72912,"_5":30961,"_21201":122919,"_27821":122920,"_3006":122921},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3550":72918,"_30605":72912,"_5":30961,"_21201":122923,"_27821":122924,"_3006":122925},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3550":72919,"_30605":72912,"_5":30961,"_21201":122927,"_27821":122928,"_3006":122929},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3550":72920,"_30605":72912,"_5":30961,"_21201":122931,"_27821":122932,"_3006":122933},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3550":72921,"_30605":72912,"_5":30961,"_21201":122935,"_27821":122936,"_3006":122937},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3550":72922,"_30605":72912,"_21201":122939,"_5":14582,"_27821":72912,"_3006":122940},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3550":72923,"_30605":72912,"_21201":122942,"_5":14582,"_27821":122909,"_3006":122943},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3550":72924,"_30605":72912,"_21201":122945,"_5":14582,"_27821":122909,"_3006":122946},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3550":72925,"_30605":72912,"_21201":122948,"_5":14582,"_27821":122909,"_3006":122949},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3550":72926,"_30605":72912,"_21201":122951,"_5":14582,"_27821":122909,"_3006":122952},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3550":72927,"_30605":72912,"_21201":122954,"_5":14582,"_27821":122909,"_3006":122955},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3550":72928,"_30605":72912,"_21201":122957,"_5":14582,"_27821":122912,"_3006":122958},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3550":72929,"_30605":72912,"_21201":122960,"_5":14582,"_27821":122912,"_3006":122961},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3550":72930,"_30605":72912,"_21201":122963,"_5":14582,"_27821":122916,"_3006":122964},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3550":72931,"_30605":72912,"_21201":122966,"_5":14582,"_27821":122916,"_3006":122967},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3550":72932,"_30605":72912,"_21201":122969,"_5":14582,"_27821":122916,"_3006":122970},[],"Ajuste",{"_3550":72933,"_30605":72912,"_21201":122972,"_5":14582,"_27821":122916,"_3006":122973},[],"Valor de evaluación",{"_3550":72934,"_30605":72912,"_21201":122975,"_5":14582,"_27821":122916,"_3006":55132},[],{"_3550":72935,"_30605":72912,"_21201":122977,"_5":14582,"_27821":122916,"_3006":122978},[],"Raíz emisora de `device-root.pem`.",{"_3550":72936,"_30605":72912,"_21201":122980,"_5":14582,"_27821":122916,"_3006":120889},[],{"_3550":72937,"_30605":72912,"_21201":122982,"_5":14582,"_27821":122916,"_3006":122983},[],"Perfil final de 1 hora que acabas de preparar.",{"_3550":72938,"_30605":72912,"_21201":122985,"_5":14582,"_27821":122916,"_3006":55143},[],{"_3550":72939,"_30605":72912,"_21201":122987,"_5":14582,"_27821":122916,"_3006":55146},[],{"_3550":72940,"_30605":72912,"_21201":122989,"_5":14582,"_27821":122916,"_3006":55149},[],{"_3550":72941,"_30605":72912,"_21201":122991,"_5":14582,"_27821":122916,"_3006":122992},[],"Habilitado.",{"_3550":72942,"_30605":72912,"_21201":122994,"_5":14582,"_27821":122916,"_3006":55155},[],{"_3550":72943,"_30605":72912,"_21201":122996,"_5":14582,"_27821":122916,"_3006":122997},[],"Deshabilitado; el ID debe ser nuevo.",{"_3550":72944,"_30605":72912,"_21201":122999,"_5":14582,"_27821":122916,"_3006":123000},[],"Autenticación inicial",{"_3550":72945,"_30605":72912,"_21201":123002,"_5":14582,"_27821":122916,"_3006":123003},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3550":72946,"_30605":72912,"_21201":123005,"_5":14582,"_27821":122916,"_3006":123006},[],"Autenticación de renovación",{"_3550":72947,"_30605":72912,"_21201":123008,"_5":14582,"_27821":122916,"_3006":123009},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3550":72948,"_30605":72912,"_21201":123011,"_5":14582,"_27821":122916,"_3006":55173},[],{"_3550":72949,"_30605":72912,"_21201":123013,"_5":14582,"_27821":122916,"_3006":123014},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3550":72950,"_30605":72912,"_21201":123016,"_5":14582,"_27821":122916,"_3006":55179},[],{"_3550":72951,"_30605":72912,"_21201":123018,"_5":14582,"_27821":122916,"_3006":123019},[],"1 hora.",{"_3550":72952,"_30605":72912,"_21201":123021,"_5":14582,"_27821":122916,"_3006":55185},[],{"_3550":72953,"_30605":72912,"_21201":123023,"_5":14582,"_27821":122916,"_3006":123024},[],"30 minutos / 10 minutos.",{"_3550":72954,"_30605":72912,"_21201":123026,"_5":14582,"_27821":122916,"_3006":55191},[],{"_3550":72955,"_30605":72912,"_21201":123028,"_5":14582,"_27821":122916,"_3006":123029},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3550":72956,"_30605":72912,"_21201":123031,"_5":14582,"_27821":122916,"_3006":52949},[],{"_3550":72957,"_30605":72912,"_21201":123033,"_5":14582,"_27821":122916,"_3006":123034},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3550":72958,"_30605":72912,"_21201":123036,"_5":14582,"_27821":122916,"_3006":55202},[],{"_3550":72959,"_30605":72912,"_21201":123038,"_5":14582,"_27821":122916,"_3006":123039},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3550":72960,"_30605":72912,"_21201":123041,"_5":14582,"_27821":122916,"_3006":123042},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3550":72961,"_30605":72912,"_21201":123044,"_5":14582,"_27821":122920,"_3006":123045},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3550":72962,"_30605":72912,"_21201":123047,"_5":14582,"_27821":122920,"_3006":123048},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3550":72963,"_30605":72912,"_21201":123050,"_5":14582,"_27821":122924,"_3006":123051},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3550":72964,"_30605":72912,"_21201":123053,"_5":14582,"_27821":122924,"_3006":123054},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3550":72965,"_30605":72912,"_21201":123056,"_5":14582,"_27821":122924,"_3006":123057},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3550":72966,"_30605":72912,"_21201":123059,"_5":14582,"_27821":122928,"_3006":123060},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3550":72967,"_30605":72912,"_21201":123062,"_5":14582,"_27821":122928,"_3006":123063},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3550":72968,"_30605":72912,"_21201":123065,"_5":14582,"_27821":122932,"_3006":123066},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3550":72969,"_30605":72912,"_21201":123068,"_5":14582,"_27821":122932,"_3006":123069},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3550":72970,"_30605":72912,"_21201":123071,"_5":14582,"_27821":122932,"_3006":123072},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3550":72971,"_30605":72912,"_21201":123074,"_5":14582,"_27821":122932,"_3006":123075},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3550":72972,"_30605":72912,"_21201":123077,"_5":14582,"_27821":122932,"_3006":123078},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3550":72973,"_30605":72912,"_21201":123080,"_5":14582,"_27821":122936,"_3006":123081},[],"Comprobación",{"_3550":72974,"_30605":72912,"_21201":123083,"_5":14582,"_27821":122936,"_3006":123084},[],"Resultado esperado",{"_3550":72975,"_30605":72912,"_21201":123086,"_5":14582,"_27821":122936,"_3006":123087},[],"Registro",{"_3550":72976,"_30605":72912,"_21201":123089,"_5":14582,"_27821":122936,"_3006":123090},[],"ID creado automáticamente y DMS correcto.",{"_3550":72977,"_30605":72912,"_21201":123092,"_5":14582,"_27821":122936,"_3006":122377},[],{"_3550":72978,"_30605":72912,"_21201":123094,"_5":14582,"_27821":122936,"_3006":123095},[],"CN, perfil, serie y clave verificados.",{"_3550":72979,"_30605":72912,"_21201":123097,"_5":14582,"_27821":122936,"_3006":123098},[],"Inventario",{"_3550":72980,"_30605":72912,"_21201":123100,"_5":14582,"_27821":122936,"_3006":123101},[],"Serie recibida visible como identidad actual y en el historial.",{"_3550":72981,"_30605":72912,"_21201":123103,"_5":14582,"_27821":122936,"_3006":123104},[],"Consumidor",{"_3550":72982,"_30605":72912,"_21201":123106,"_5":14582,"_27821":122936,"_3006":123107},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3550":72983,"_30605":72912,"_21201":123109,"_5":14582,"_27821":122936,"_3006":123110},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3550":72984,"_30605":72912,"_21201":123112,"_5":14582,"_27821":122936,"_3006":123113},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3550":72985,"_30605":72985,"_5":14934,"_3006":120603,"_30964":123115,"_21201":123116,"_27821":72985},[49995,119453,52630,122902],[],{"_3550":72986,"_30605":72985,"_21201":123118,"_5":14582,"_27821":72985,"_3006":123119},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3550":72987,"_30605":72985,"_5":30961,"_21201":123121,"_27821":123122,"_3006":118024},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3550":72988,"_30605":72985,"_5":30961,"_21201":123124,"_27821":123125,"_3006":123126},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3550":72989,"_30605":72985,"_5":30961,"_21201":123128,"_27821":123129,"_3006":123130},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3550":72990,"_30605":72985,"_5":30961,"_21201":123132,"_27821":123133,"_3006":123134},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3550":72991,"_30605":72985,"_5":30961,"_21201":123136,"_27821":123137,"_3006":123138},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3550":72992,"_30605":72985,"_5":30961,"_21201":123140,"_27821":123141,"_3006":123142},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3550":72993,"_30605":72985,"_5":30961,"_21201":123144,"_27821":123145,"_3006":123084},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3550":72994,"_30605":72985,"_5":30961,"_21201":123147,"_27821":123148,"_3006":123149},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3550":72995,"_30605":72985,"_5":30961,"_21201":123151,"_27821":123152,"_3006":123153},[],"/docs/pr-preview/pr-66/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3550":72996,"_30605":72985,"_21201":123155,"_5":14582,"_27821":72985,"_3006":123156},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3550":72997,"_30605":72985,"_21201":123158,"_5":14582,"_27821":72985,"_3006":123159},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3550":72998,"_30605":72985,"_21201":123161,"_5":14582,"_27821":123122,"_3006":123162},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3550":72999,"_30605":72985,"_21201":123164,"_5":14582,"_27821":123122,"_3006":123165},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3550":73000,"_30605":72985,"_21201":123167,"_5":14582,"_27821":123122,"_3006":123168},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3550":73001,"_30605":72985,"_21201":123170,"_5":14582,"_27821":123122,"_3006":123171},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3550":73002,"_30605":72985,"_21201":123173,"_5":14582,"_27821":123125,"_3006":123174},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3550":73003,"_30605":72985,"_21201":123176,"_5":14582,"_27821":123125,"_3006":123177},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3550":73004,"_30605":72985,"_21201":123179,"_5":14582,"_27821":123125,"_3006":123180},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3550":73005,"_30605":72985,"_21201":123182,"_5":14582,"_27821":123125,"_3006":123183},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3550":73006,"_30605":72985,"_21201":123185,"_5":14582,"_27821":123125,"_3006":123186},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3550":73007,"_30605":72985,"_21201":123188,"_5":14582,"_27821":123125,"_3006":123189},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3550":73008,"_30605":72985,"_21201":123191,"_5":14582,"_27821":123125,"_3006":123192},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3550":73009,"_30605":72985,"_21201":123194,"_5":14582,"_27821":123125,"_3006":123195},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3550":73010,"_30605":72985,"_21201":123197,"_5":14582,"_27821":123129,"_3006":123198},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3550":73011,"_30605":72985,"_21201":123200,"_5":14582,"_27821":123129,"_3006":55367},[],{"_3550":73012,"_30605":72985,"_21201":123202,"_5":14582,"_27821":123129,"_3006":123203},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3550":73013,"_30605":72985,"_21201":123205,"_5":14582,"_27821":123129,"_3006":123206},[],"**Icon** y **Tags**: clasificación opcional.",{"_3550":73014,"_30605":72985,"_21201":123208,"_5":14582,"_27821":123129,"_3006":123209},[],"Confirma el registro.",{"_3550":73015,"_30605":72985,"_21201":123211,"_5":14582,"_27821":123133,"_3006":123212},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3550":73016,"_30605":72985,"_21201":123214,"_5":14582,"_27821":123133,"_3006":123215},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3550":73017,"_30605":72985,"_21201":123217,"_5":14582,"_27821":123137,"_3006":123218},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3550":73018,"_30605":72985,"_21201":123220,"_5":14582,"_27821":123137,"_3006":123221},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3550":73019,"_30605":72985,"_21201":123223,"_5":14582,"_27821":123141,"_3006":123224},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3550":73020,"_30605":72985,"_21201":123226,"_5":14582,"_27821":123141,"_3006":123227},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3550":73021,"_30605":72985,"_21201":123229,"_5":14582,"_27821":123145,"_3006":123081},[],{"_3550":73022,"_30605":72985,"_21201":123231,"_5":14582,"_27821":123145,"_3006":123232},[],"Resultado",{"_3550":73023,"_30605":72985,"_21201":123234,"_5":14582,"_27821":123145,"_3006":122363},[],{"_3550":73024,"_30605":72985,"_21201":123236,"_5":14582,"_27821":123145,"_3006":123237},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3550":73025,"_30605":72985,"_21201":123239,"_5":14582,"_27821":123145,"_3006":123240},[],"Identidad actual",{"_3550":73026,"_30605":72985,"_21201":123242,"_5":14582,"_27821":123145,"_3006":123243},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3550":73027,"_30605":72985,"_21201":123245,"_5":14582,"_27821":123145,"_3006":123246},[],"Historial",{"_3550":73028,"_30605":72985,"_21201":123248,"_5":14582,"_27821":123145,"_3006":123249},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3550":73029,"_30605":72985,"_21201":123251,"_5":14582,"_27821":123145,"_3006":123252},[],"Clave y certificado",{"_3550":73030,"_30605":72985,"_21201":123254,"_5":14582,"_27821":123145,"_3006":123255},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3550":73031,"_30605":72985,"_21201":123257,"_5":14582,"_27821":123148,"_3006":123258},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3550":73032,"_30605":72985,"_21201":123260,"_5":14582,"_27821":123148,"_3006":123261},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3550":73033,"_30605":72985,"_21201":123263,"_5":14582,"_27821":123148,"_3006":123264},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3550":73034,"_30605":72985,"_21201":123266,"_5":14582,"_27821":123148,"_3006":123267},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3550":73035,"_30605":72985,"_21201":123269,"_5":14582,"_27821":123152,"_3006":123270},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3550":73036,"_30605":72985,"_21201":123272,"_5":14582,"_27821":123152,"_3006":123273},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3550":73037,"_30605":72985,"_21201":123275,"_5":14582,"_27821":123152,"_3006":123276},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3550":73038,"_30605":73038,"_5":14934,"_3006":123278,"_30964":123279,"_21201":123280,"_27821":73038},"Plataforma Lamassu IoT",[49995,119453],[],{"_3550":73039,"_30605":73038,"_21201":123282,"_5":14582,"_27821":73038,"_3006":123283},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3550":73040,"_30605":73038,"_5":30961,"_21201":123285,"_27821":123286,"_3006":122778},[],"/docs/pr-preview/pr-66/es/platform/overview#empieza-aquí",{"_3550":73041,"_30605":73038,"_5":30961,"_21201":123288,"_27821":123289,"_3006":123290},[],"/docs/pr-preview/pr-66/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3550":73042,"_30605":73038,"_5":30961,"_21201":123292,"_27821":123293,"_3006":123294},[],"/docs/pr-preview/pr-66/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3550":73043,"_30605":73038,"_5":30961,"_21201":123296,"_27821":123297,"_3006":123298},[],"/docs/pr-preview/pr-66/es/platform/overview#capacidades-principales","Capacidades principales",{"_3550":73044,"_30605":73038,"_5":30961,"_21201":123300,"_27821":123301,"_3006":123302},[],"/docs/pr-preview/pr-66/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3550":73045,"_30605":73038,"_5":30961,"_21201":123304,"_27821":123305,"_3006":123306},[],"/docs/pr-preview/pr-66/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3550":73046,"_30605":73038,"_5":30961,"_21201":123308,"_27821":123309,"_3006":123310},[],"/docs/pr-preview/pr-66/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3550":73047,"_30605":73038,"_5":30961,"_21201":123312,"_27821":123313,"_3006":123314},[],"/docs/pr-preview/pr-66/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3550":73048,"_30605":73038,"_5":30961,"_21201":123316,"_27821":123317,"_3006":123318},[],"/docs/pr-preview/pr-66/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3550":73049,"_30605":73038,"_5":30961,"_21201":123320,"_27821":123321,"_3006":123322},[],"/docs/pr-preview/pr-66/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3550":73050,"_30605":73038,"_5":30961,"_21201":123324,"_27821":123325,"_3006":123326},[],"/docs/pr-preview/pr-66/es/platform/overview#referencia-operativa","Referencia operativa",{"_3550":73051,"_30605":73038,"_21201":123328,"_5":14582,"_27821":73038,"_3006":123329},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3550":73052,"_30605":73038,"_21201":123331,"_5":14582,"_27821":123286,"_3006":123332},[],"Elige el resultado que necesitas obtener:",{"_3550":73053,"_30605":73038,"_21201":123334,"_5":14582,"_27821":123286,"_3006":123335},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3550":73054,"_30605":73038,"_21201":123337,"_5":14582,"_27821":123286,"_3006":123338},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3550":73055,"_30605":73038,"_21201":123340,"_5":14582,"_27821":123286,"_3006":123341},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3550":73056,"_30605":73038,"_21201":123343,"_5":14582,"_27821":123289,"_3006":123344},[],"Bloque",{"_3550":73057,"_30605":73038,"_21201":123346,"_5":14582,"_27821":123289,"_3006":123347},[],"Qué gestionas",{"_3550":73058,"_30605":73038,"_21201":123349,"_5":14582,"_27821":123289,"_3006":123350},[],"Punto de entrada",{"_3550":73059,"_30605":73038,"_21201":123352,"_5":14582,"_27821":123289,"_3006":55520},[],{"_3550":73060,"_30605":73038,"_21201":123354,"_5":14582,"_27821":123289,"_3006":123355},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3550":73061,"_30605":73038,"_21201":123357,"_5":14582,"_27821":123289,"_3006":123358},[],"Visión general de PKI",{"_3550":73062,"_30605":73038,"_21201":123360,"_5":14582,"_27821":123289,"_3006":55529},[],{"_3550":73063,"_30605":73038,"_21201":123362,"_5":14582,"_27821":123289,"_3006":123363},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3550":73064,"_30605":73038,"_21201":123365,"_5":14582,"_27821":123289,"_3006":123366},[],"Visión general de IoT Fleets",{"_3550":73065,"_30605":73038,"_21201":123368,"_5":14582,"_27821":123289,"_3006":123369},[],"**Administración**",{"_3550":73066,"_30605":73038,"_21201":123371,"_5":14582,"_27821":123289,"_3006":123372},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3550":73067,"_30605":73038,"_21201":123374,"_5":14582,"_27821":123289,"_3006":119455},[],{"_3550":73068,"_30605":73038,"_21201":123376,"_5":14582,"_27821":123289,"_3006":123377},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3550":73069,"_30605":73038,"_21201":123379,"_5":14582,"_27821":123293,"_3006":123380},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3550":73070,"_30605":73038,"_21201":123382,"_5":14582,"_27821":123293,"_3006":123383},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3550":73071,"_30605":73038,"_21201":123385,"_5":14582,"_27821":123293,"_3006":123386},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3550":73072,"_30605":73038,"_21201":123388,"_5":14582,"_27821":123293,"_3006":123389},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3550":73073,"_30605":73038,"_21201":123391,"_5":14582,"_27821":123293,"_3006":123392},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3550":73074,"_30605":73038,"_21201":123394,"_5":14582,"_27821":123293,"_3006":123395},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3550":73075,"_30605":73038,"_21201":123397,"_5":14582,"_27821":123301,"_3006":123398},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3550":73076,"_30605":73038,"_21201":123400,"_5":14582,"_27821":123305,"_3006":123401},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3550":73077,"_30605":73038,"_21201":123403,"_5":14582,"_27821":123309,"_3006":123404},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3550":73078,"_30605":73038,"_21201":123406,"_5":14582,"_27821":123313,"_3006":123407},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3550":73079,"_30605":73038,"_21201":123409,"_5":14582,"_27821":123317,"_3006":123410},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3550":73080,"_30605":73038,"_21201":123412,"_5":14582,"_27821":123321,"_3006":123413},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3550":73081,"_30605":73038,"_21201":123415,"_5":14582,"_27821":123325,"_3006":122871},[],{"_3550":73082,"_30605":73038,"_21201":123417,"_5":14582,"_27821":123325,"_3006":123418},[],"Qué prepara o comprueba",{"_3550":73083,"_30605":73038,"_21201":123420,"_5":14582,"_27821":123325,"_3006":122874},[],{"_3550":73084,"_30605":73038,"_21201":123422,"_5":14582,"_27821":123325,"_3006":123423},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3550":73085,"_30605":73038,"_21201":123425,"_5":14582,"_27821":123325,"_3006":123426},[],"Administrador de la flota",{"_3550":73086,"_30605":73038,"_21201":123428,"_5":14582,"_27821":123325,"_3006":123429},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3550":73087,"_30605":73038,"_21201":123431,"_5":14582,"_27821":123325,"_3006":122886},[],{"_3550":73088,"_30605":73038,"_21201":123433,"_5":14582,"_27821":123325,"_3006":123434},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3550":73089,"_30605":73038,"_21201":123436,"_5":14582,"_27821":123325,"_3006":122892},[],{"_3550":73090,"_30605":73038,"_21201":123438,"_5":14582,"_27821":123325,"_3006":123439},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3550":73091,"_30605":73038,"_21201":123441,"_5":14582,"_27821":123325,"_3006":123442},[],"Operador de infraestructura",{"_3550":73092,"_30605":73038,"_21201":123444,"_5":14582,"_27821":123325,"_3006":123445},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3550":73093,"_30605":73038,"_21201":123447,"_5":14582,"_27821":123325,"_3006":123448},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3550":73094,"_30605":73094,"_5":14934,"_3006":123450,"_30964":123451,"_21201":123453,"_27821":73094},"Jerarquía y rotación de CAs",[49995,119453,55621,123452],"Claves, autoridades y certificados",[],{"_3550":73095,"_30605":73094,"_21201":123455,"_5":14582,"_27821":73094,"_3006":123456},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3550":73096,"_30605":73094,"_5":30961,"_21201":123458,"_27821":123459,"_3006":123460},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3550":73097,"_30605":73094,"_5":30961,"_21201":123462,"_27821":123463,"_3006":123464},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3550":73098,"_30605":73094,"_5":30961,"_21201":123466,"_27821":123467,"_3006":123468},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3550":73099,"_30605":73094,"_5":30961,"_21201":123470,"_27821":123471,"_3006":123472},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3550":73100,"_30605":73094,"_5":30961,"_21201":123474,"_27821":123475,"_3006":123476},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3550":73101,"_30605":73094,"_5":30961,"_21201":123478,"_27821":123479,"_3006":123480},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3550":73102,"_30605":73094,"_5":30961,"_21201":123482,"_27821":123483,"_3006":123484},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3550":73103,"_30605":73094,"_5":30961,"_21201":123486,"_27821":123487,"_3006":123488},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3550":73104,"_30605":73094,"_5":30961,"_21201":123490,"_27821":123491,"_3006":123492},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3550":73105,"_30605":73094,"_5":30961,"_21201":123494,"_27821":123495,"_3006":123496},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3550":73106,"_30605":73094,"_5":30961,"_21201":123498,"_27821":123499,"_3006":123500},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3550":73107,"_30605":73094,"_5":30961,"_21201":123502,"_27821":123503,"_3006":123504},[],"/docs/pr-preview/pr-66/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3550":73108,"_30605":73094,"_21201":123506,"_5":14582,"_27821":73094,"_3006":123507},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3550":73109,"_30605":73094,"_21201":123509,"_5":14582,"_27821":73094,"_3006":123510},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3550":73110,"_30605":73094,"_21201":123512,"_5":14582,"_27821":123459,"_3006":123513},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3550":73111,"_30605":73094,"_21201":123515,"_5":14582,"_27821":123459,"_3006":123516},[],"entorno, como producción y preproducción;",{"_3550":73112,"_30605":73094,"_21201":123518,"_5":14582,"_27821":123459,"_3006":123519},[],"propietario o equipo operador;",{"_3550":73113,"_30605":73094,"_21201":123521,"_5":14582,"_27821":123459,"_3006":123522},[],"familia de dispositivos o proceso de fabricación;",{"_3550":73114,"_30605":73094,"_21201":123524,"_5":14582,"_27821":123459,"_3006":123525},[],"región o requisito regulatorio;",{"_3550":73115,"_30605":73094,"_21201":123527,"_5":14582,"_27821":123459,"_3006":123528},[],"motor criptográfico o política de clave;",{"_3550":73116,"_30605":73094,"_21201":123530,"_5":14582,"_27821":123459,"_3006":123531},[],"ventana de mantenimiento y ritmo de renovación.",{"_3550":73117,"_30605":73094,"_21201":123533,"_5":14582,"_27821":123459,"_3006":123534},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3550":73118,"_30605":73094,"_21201":123536,"_5":14582,"_27821":123459,"_3006":123537},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3550":73119,"_30605":73094,"_21201":123539,"_5":14582,"_27821":123463,"_3006":123540},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3550":73120,"_30605":73094,"_21201":123542,"_5":14582,"_27821":123463,"_3006":123543},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3550":73121,"_30605":73094,"_21201":123545,"_5":14582,"_27821":123463,"_3006":123546},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3550":73122,"_30605":73094,"_21201":123548,"_5":14582,"_27821":123463,"_3006":123549},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3550":73123,"_30605":73094,"_21201":123551,"_5":14582,"_27821":123467,"_3006":123552},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3550":73124,"_30605":73094,"_21201":123554,"_5":14582,"_27821":123467,"_3006":123555},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3550":73125,"_30605":73094,"_21201":123557,"_5":14582,"_27821":123467,"_3006":123558},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3550":73126,"_30605":73094,"_21201":123560,"_5":14582,"_27821":123467,"_3006":123561},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3550":73127,"_30605":73094,"_21201":123563,"_5":14582,"_27821":123475,"_3006":123564},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3550":73128,"_30605":73094,"_21201":123566,"_5":14582,"_27821":123479,"_3006":123567},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3550":73129,"_30605":73094,"_21201":123569,"_5":14582,"_27821":123483,"_3006":123570},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3550":73130,"_30605":73094,"_21201":123572,"_5":14582,"_27821":123487,"_3006":123573},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3550":73131,"_30605":73094,"_21201":123575,"_5":14582,"_27821":123491,"_3006":123576},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3550":73132,"_30605":73094,"_21201":123578,"_5":14582,"_27821":123495,"_3006":123579},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3550":73133,"_30605":73094,"_21201":123581,"_5":14582,"_27821":123499,"_3006":123582},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3550":73134,"_30605":73094,"_21201":123584,"_5":14582,"_27821":123499,"_3006":123585},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3550":73135,"_30605":73094,"_21201":123587,"_5":14582,"_27821":123499,"_3006":123588},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3550":73136,"_30605":73094,"_21201":123590,"_5":14582,"_27821":123499,"_3006":123591},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3550":73137,"_30605":73094,"_21201":123593,"_5":14582,"_27821":123503,"_3006":123594},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3550":73138,"_30605":73094,"_21201":123596,"_5":14582,"_27821":123503,"_3006":123597},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3550":73139,"_30605":73094,"_21201":123599,"_5":14582,"_27821":123503,"_3006":123600},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3550":73140,"_30605":73094,"_21201":123602,"_5":14582,"_27821":123503,"_3006":123603},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3550":73141,"_30605":73094,"_21201":123605,"_5":14582,"_27821":123503,"_3006":123606},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3550":73142,"_30605":73094,"_21201":123608,"_5":14582,"_27821":123503,"_3006":123609},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3550":73143,"_30605":73094,"_21201":123611,"_5":14582,"_27821":123503,"_3006":123612},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3550":73144,"_30605":73144,"_5":14934,"_3006":123614,"_30964":123615,"_21201":123616,"_27821":73144},"Autoridades de certificación",[49995,119453,55621,123452],[],{"_3550":73145,"_30605":73144,"_21201":123618,"_5":14582,"_27821":73144,"_3006":123619},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3550":73146,"_30605":73144,"_5":30961,"_21201":123621,"_27821":123622,"_3006":123623},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3550":73147,"_30605":73144,"_5":30961,"_21201":123625,"_27821":123626,"_3006":123627},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3550":73148,"_30605":73144,"_5":30961,"_21201":123629,"_27821":123630,"_3006":118024},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3550":73149,"_30605":73144,"_5":30961,"_21201":123632,"_27821":123633,"_3006":123634},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3550":73150,"_30605":73144,"_5":30961,"_21201":123636,"_27821":123637,"_3006":123638},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3550":73151,"_30605":73144,"_5":30961,"_21201":123640,"_27821":123641,"_3006":123642},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3550":73152,"_30605":73144,"_5":30961,"_21201":123644,"_27821":123645,"_3006":123646},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3550":73153,"_30605":73144,"_5":30961,"_21201":123648,"_27821":123649,"_3006":123650},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3550":73154,"_30605":73144,"_5":30961,"_21201":123652,"_27821":123653,"_3006":123654},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3550":73155,"_30605":73144,"_5":30961,"_21201":123656,"_27821":123657,"_3006":123658},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3550":73156,"_30605":73144,"_5":30961,"_21201":123660,"_27821":123661,"_3006":123662},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3550":73157,"_30605":73144,"_5":30961,"_21201":123664,"_27821":123665,"_3006":123666},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3550":73158,"_30605":73144,"_5":30961,"_21201":123668,"_27821":123669,"_3006":123670},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3550":73159,"_30605":73144,"_5":30961,"_21201":123672,"_27821":123673,"_3006":123674},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3550":73160,"_30605":73144,"_5":30961,"_21201":123676,"_27821":123677,"_3006":123678},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3550":73161,"_30605":73144,"_5":30961,"_21201":123680,"_27821":123681,"_3006":123682},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3550":73162,"_30605":73144,"_5":30961,"_21201":123684,"_27821":123685,"_3006":123686},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3550":73163,"_30605":73144,"_5":30961,"_21201":123688,"_27821":123689,"_3006":123690},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3550":73164,"_30605":73144,"_5":30961,"_21201":123692,"_27821":123693,"_3006":123694},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3550":73165,"_30605":73144,"_5":30961,"_21201":123696,"_27821":123697,"_3006":123698},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3550":73166,"_30605":73144,"_5":30961,"_21201":123700,"_27821":123701,"_3006":123702},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3550":73167,"_30605":73144,"_5":30961,"_21201":123704,"_27821":123705,"_3006":123706},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3550":73168,"_30605":73144,"_5":30961,"_21201":123708,"_27821":123709,"_3006":123710},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3550":73169,"_30605":73144,"_21201":123712,"_5":14582,"_27821":73144,"_3006":123713},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3550":73170,"_30605":73144,"_21201":123715,"_5":14582,"_27821":73144,"_3006":123716},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3550":73171,"_30605":73144,"_21201":123718,"_5":14582,"_27821":73144,"_3006":123719},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3550":73172,"_30605":73144,"_21201":123721,"_5":14582,"_27821":123622,"_3006":123722},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3550":73173,"_30605":73144,"_21201":123724,"_5":14582,"_27821":123622,"_3006":123725},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3550":73174,"_30605":73144,"_21201":123727,"_5":14582,"_27821":123622,"_3006":123728},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3550":73175,"_30605":73144,"_21201":123730,"_5":14582,"_27821":123622,"_3006":123731},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3550":73176,"_30605":73144,"_21201":123733,"_5":14582,"_27821":123622,"_3006":123734},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3550":73177,"_30605":73144,"_21201":123736,"_5":14582,"_27821":123630,"_3006":123737},[],"Decide si la CA será raíz o intermedia.",{"_3550":73178,"_30605":73144,"_21201":123739,"_5":14582,"_27821":123630,"_3006":123740},[],"Elige el motor que custodiará la clave.",{"_3550":73179,"_30605":73144,"_21201":123742,"_5":14582,"_27821":123630,"_3006":123743},[],"Define una validez superior a la de los certificados que emitirá.",{"_3550":73180,"_30605":73144,"_21201":123745,"_5":14582,"_27821":123630,"_3006":123746},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3550":73181,"_30605":73144,"_21201":123748,"_5":14582,"_27821":123633,"_3006":123749},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3550":73182,"_30605":73144,"_21201":123751,"_5":14582,"_27821":123637,"_3006":123752},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3550":73183,"_30605":73144,"_21201":123754,"_5":14582,"_27821":123637,"_3006":123755},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3550":73184,"_30605":73144,"_21201":123757,"_5":14582,"_27821":123641,"_3006":123758},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3550":73185,"_30605":73144,"_21201":123760,"_5":14582,"_27821":123645,"_3006":123761},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3550":73186,"_30605":73144,"_21201":123763,"_5":14582,"_27821":123645,"_3006":123764},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3550":73187,"_30605":73144,"_21201":123766,"_5":14582,"_27821":123645,"_3006":123767},[],"`ST`: estado o provincia.",{"_3550":73188,"_30605":73144,"_21201":123769,"_5":14582,"_27821":123645,"_3006":123770},[],"`L`: localidad.",{"_3550":73189,"_30605":73144,"_21201":123772,"_5":14582,"_27821":123645,"_3006":123773},[],"`O`: organización.",{"_3550":73190,"_30605":73144,"_21201":123775,"_5":14582,"_27821":123645,"_3006":123776},[],"`OU`: unidad organizativa.",{"_3550":73191,"_30605":73144,"_21201":123778,"_5":14582,"_27821":123645,"_3006":123779},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3550":73192,"_30605":73144,"_21201":123781,"_5":14582,"_27821":123649,"_3006":123782},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3550":73193,"_30605":73144,"_21201":123784,"_5":14582,"_27821":123649,"_3006":123785},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3550":73194,"_30605":73144,"_21201":123787,"_5":14582,"_27821":123653,"_3006":123788},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3550":73195,"_30605":73144,"_21201":123790,"_5":14582,"_27821":123653,"_3006":123791},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3550":73196,"_30605":73144,"_21201":123793,"_5":14582,"_27821":123657,"_3006":123794},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3550":73197,"_30605":73144,"_21201":123796,"_5":14582,"_27821":123657,"_3006":123797},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3550":73198,"_30605":73144,"_21201":123799,"_5":14582,"_27821":123661,"_3006":123800},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3550":73199,"_30605":73144,"_21201":123802,"_5":14582,"_27821":123661,"_3006":123803},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3550":73200,"_30605":73144,"_21201":123805,"_5":14582,"_27821":123661,"_3006":123806},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3550":73201,"_30605":73144,"_21201":123808,"_5":14582,"_27821":123665,"_3006":123809},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3550":73202,"_30605":73144,"_21201":123811,"_5":14582,"_27821":123669,"_3006":123812},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3550":73203,"_30605":73144,"_21201":123814,"_5":14582,"_27821":123669,"_3006":123815},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3550":73204,"_30605":73144,"_21201":123817,"_5":14582,"_27821":123673,"_3006":123818},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3550":73205,"_30605":73144,"_21201":123820,"_5":14582,"_27821":123677,"_3006":123821},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3550":73206,"_30605":73144,"_21201":123823,"_5":14582,"_27821":123677,"_3006":123824},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3550":73207,"_30605":73144,"_21201":123826,"_5":14582,"_27821":123681,"_3006":123827},[],"Abre una CA desde el inventario para consultar:",{"_3550":73208,"_30605":73144,"_21201":123829,"_5":14582,"_27821":123681,"_3006":123830},[],"Estado y periodo de validez.",{"_3550":73209,"_30605":73144,"_21201":123832,"_5":14582,"_27821":123681,"_3006":123833},[],"Certificado y cadena en formato PEM.",{"_3550":73210,"_30605":73144,"_21201":123835,"_5":14582,"_27821":123681,"_3006":123836},[],"Número de certificados activos, expirados y revocados.",{"_3550":73211,"_30605":73144,"_21201":123838,"_5":14582,"_27821":123681,"_3006":123839},[],"Certificados emitidos en **Issued Certificates**.",{"_3550":73212,"_30605":73144,"_21201":123841,"_5":14582,"_27821":123681,"_3006":123842},[],"CRL vinculada a la autoridad.",{"_3550":73213,"_30605":73144,"_21201":123844,"_5":14582,"_27821":123681,"_3006":123845},[],"Metadatos y motor criptográfico asociado.",{"_3550":73214,"_30605":73144,"_21201":123847,"_5":14582,"_27821":123681,"_3006":123848},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3550":73215,"_30605":73144,"_21201":123850,"_5":14582,"_27821":123685,"_3006":123851},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3550":73216,"_30605":73144,"_21201":123853,"_5":14582,"_27821":123685,"_3006":123854},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3550":73217,"_30605":73144,"_21201":123856,"_5":14582,"_27821":123685,"_3006":123857},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3550":73218,"_30605":73144,"_21201":123859,"_5":14582,"_27821":123685,"_3006":123860},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3550":73219,"_30605":73144,"_21201":123862,"_5":14582,"_27821":123689,"_3006":123863},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3550":73220,"_30605":73144,"_21201":123865,"_5":14582,"_27821":123693,"_3006":123866},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3550":73221,"_30605":73144,"_21201":123868,"_5":14582,"_27821":123697,"_3006":123869},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3550":73222,"_30605":73144,"_21201":123871,"_5":14582,"_27821":123701,"_3006":123872},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3550":73223,"_30605":73144,"_21201":123874,"_5":14582,"_27821":123705,"_3006":123875},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3550":73224,"_30605":73144,"_21201":123877,"_5":14582,"_27821":123709,"_3006":123878},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3550":73225,"_30605":73144,"_21201":123880,"_5":14582,"_27821":123709,"_3006":123881},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3550":73226,"_30605":73144,"_21201":123883,"_5":14582,"_27821":123709,"_3006":123884},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3550":73227,"_30605":73144,"_21201":123886,"_5":14582,"_27821":123709,"_3006":123887},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3550":73228,"_30605":73228,"_5":14934,"_3006":123889,"_30964":123890,"_21201":123891,"_27821":73228},"Perfiles de certificado",[49995,119453,55621,123452],[],{"_3550":73229,"_30605":73228,"_21201":123893,"_5":14582,"_27821":73228,"_3006":123894},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3550":73230,"_30605":73228,"_5":30961,"_21201":123896,"_27821":123897,"_3006":123898},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3550":73231,"_30605":73228,"_5":30961,"_21201":123900,"_27821":123901,"_3006":123902},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#validez","Validez",{"_3550":73232,"_30605":73228,"_5":30961,"_21201":123904,"_27821":123905,"_3006":123906},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3550":73233,"_30605":73228,"_5":30961,"_21201":123908,"_27821":123909,"_3006":123910},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3550":73234,"_30605":73228,"_5":30961,"_21201":123912,"_27821":123913,"_3006":123914},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3550":73235,"_30605":73228,"_5":30961,"_21201":123916,"_27821":123917,"_3006":123918},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3550":73236,"_30605":73228,"_5":30961,"_21201":123920,"_27821":123921,"_3006":123922},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3550":73237,"_30605":73228,"_5":30961,"_21201":123924,"_27821":123925,"_3006":123926},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3550":73238,"_30605":73228,"_5":30961,"_21201":123928,"_27821":123929,"_3006":123930},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3550":73239,"_30605":73228,"_5":30961,"_21201":123932,"_27821":123933,"_3006":123934},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3550":73240,"_30605":73228,"_5":30961,"_21201":123936,"_27821":123937,"_3006":123938},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3550":73241,"_30605":73228,"_5":30961,"_21201":123940,"_27821":123941,"_3006":123942},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3550":73242,"_30605":73228,"_5":30961,"_21201":123944,"_27821":123945,"_3006":123946},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3550":73243,"_30605":73228,"_5":30961,"_21201":123948,"_27821":123949,"_3006":123950},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3550":73244,"_30605":73228,"_5":30961,"_21201":123952,"_27821":123953,"_3006":123954},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3550":73245,"_30605":73228,"_5":30961,"_21201":123956,"_27821":123957,"_3006":123958},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3550":73246,"_30605":73228,"_21201":123960,"_5":14582,"_27821":73228,"_3006":123961},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3550":73247,"_30605":73228,"_21201":123963,"_5":14582,"_27821":73228,"_3006":123964},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3550":73248,"_30605":73228,"_21201":123966,"_5":14582,"_27821":123901,"_3006":123967},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3550":73249,"_30605":73228,"_21201":123969,"_5":14582,"_27821":123901,"_3006":123970},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3550":73250,"_30605":73228,"_21201":123972,"_5":14582,"_27821":123905,"_3006":123973},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3550":73251,"_30605":73228,"_21201":123975,"_5":14582,"_27821":123909,"_3006":123976},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3550":73252,"_30605":73228,"_21201":123978,"_5":14582,"_27821":123909,"_3006":123979},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3550":73253,"_30605":73228,"_21201":123981,"_5":14582,"_27821":123909,"_3006":123982},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3550":73254,"_30605":73228,"_21201":123984,"_5":14582,"_27821":123913,"_3006":123985},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3550":73255,"_30605":73228,"_21201":123987,"_5":14582,"_27821":123917,"_3006":123988},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3550":73256,"_30605":73228,"_21201":123990,"_5":14582,"_27821":123917,"_3006":123991},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3550":73257,"_30605":73228,"_21201":123993,"_5":14582,"_27821":123921,"_3006":123994},[],"La aplicación criptográfica puede:",{"_3550":73258,"_30605":73228,"_21201":123996,"_5":14582,"_27821":123921,"_3006":123997},[],"permitir o bloquear claves RSA;",{"_3550":73259,"_30605":73228,"_21201":123999,"_5":14582,"_27821":123921,"_3006":124000},[],"limitar los tamaños RSA admitidos;",{"_3550":73260,"_30605":73228,"_21201":124002,"_5":14582,"_27821":123921,"_3006":124003},[],"permitir o bloquear claves ECDSA;",{"_3550":73261,"_30605":73228,"_21201":124005,"_5":14582,"_27821":123921,"_3006":124006},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3550":73262,"_30605":73228,"_21201":124008,"_5":14582,"_27821":123921,"_3006":124009},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3550":73263,"_30605":73228,"_21201":124011,"_5":14582,"_27821":123925,"_3006":124012},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3550":73264,"_30605":73228,"_21201":124014,"_5":14582,"_27821":123925,"_3006":119213},[],{"_3550":73265,"_30605":73228,"_21201":124016,"_5":14582,"_27821":123925,"_3006":124017},[],"Primera opción",{"_3550":73266,"_30605":73228,"_21201":124019,"_5":14582,"_27821":123925,"_3006":124020},[],"Segunda opción",{"_3550":73267,"_30605":73228,"_21201":124022,"_5":14582,"_27821":123925,"_3006":124023},[],"Si no hay ninguna",{"_3550":73268,"_30605":73228,"_21201":124025,"_5":14582,"_27821":123925,"_3006":124026},[],"Firma directa con una CA",{"_3550":73269,"_30605":73228,"_21201":124028,"_5":14582,"_27821":123925,"_3006":124029},[],"`issuance_profile` incluido en la solicitud",{"_3550":73270,"_30605":73228,"_21201":124031,"_5":14582,"_27821":123925,"_3006":124032},[],"`issuance_profile_id` de la solicitud",{"_3550":73271,"_30605":73228,"_21201":124034,"_5":14582,"_27821":123925,"_3006":124035},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3550":73272,"_30605":73228,"_21201":124037,"_5":14582,"_27821":123925,"_3006":124038},[],"Emisión mediante DMS",{"_3550":73273,"_30605":73228,"_21201":124040,"_5":14582,"_27821":123925,"_3006":56211},[],{"_3550":73274,"_30605":73228,"_21201":124042,"_5":14582,"_27821":123925,"_3006":124043},[],"`settings.issuance_profile` incluido en el DMS",{"_3550":73275,"_30605":73228,"_21201":124045,"_5":14582,"_27821":123925,"_3006":124046},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3550":73276,"_30605":73228,"_21201":124048,"_5":14582,"_27821":123925,"_3006":124049},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3550":73277,"_30605":73228,"_21201":124051,"_5":14582,"_27821":123925,"_3006":124052},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3550":73278,"_30605":73228,"_21201":124054,"_5":14582,"_27821":123933,"_3006":124055},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3550":73279,"_30605":73228,"_21201":124057,"_5":14582,"_27821":123937,"_3006":124058},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3550":73280,"_30605":73228,"_21201":124060,"_5":14582,"_27821":123941,"_3006":124061},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3550":73281,"_30605":73228,"_21201":124063,"_5":14582,"_27821":123945,"_3006":124064},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3550":73282,"_30605":73228,"_21201":124066,"_5":14582,"_27821":123949,"_3006":124067},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3550":73283,"_30605":73228,"_21201":124069,"_5":14582,"_27821":123949,"_3006":124070},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3550":73284,"_30605":73228,"_21201":124072,"_5":14582,"_27821":123953,"_3006":124073},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3550":73285,"_30605":73228,"_21201":124075,"_5":14582,"_27821":123953,"_3006":124076},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3550":73286,"_30605":73228,"_21201":124078,"_5":14582,"_27821":123953,"_3006":124079},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3550":73287,"_30605":73228,"_21201":124081,"_5":14582,"_27821":123953,"_3006":124082},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3550":73288,"_30605":73228,"_21201":124084,"_5":14582,"_27821":123957,"_3006":124085},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3550":73289,"_30605":73228,"_21201":124087,"_5":14582,"_27821":123957,"_3006":124088},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3550":73290,"_30605":73290,"_5":14934,"_3006":124090,"_30964":124091,"_21201":124093,"_27821":73290},"Validación de certificados",[49995,119453,55621,124092],"Validación",[],{"_3550":73291,"_30605":73290,"_21201":124095,"_5":14582,"_27821":73290,"_3006":124096},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3550":73292,"_30605":73290,"_5":30961,"_21201":124098,"_27821":124099,"_3006":124100},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3550":73293,"_30605":73290,"_5":30961,"_21201":124102,"_27821":124103,"_3006":124104},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3550":73294,"_30605":73290,"_5":30961,"_21201":124106,"_27821":124107,"_3006":124108},[],"/docs/pr-preview/pr-66/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3550":73295,"_30605":73290,"_21201":124110,"_5":14582,"_27821":73290,"_3006":124111},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3550":73296,"_30605":73290,"_21201":124113,"_5":14582,"_27821":124099,"_3006":124114},[],"Verifica estos criterios juntos:",{"_3550":73297,"_30605":73290,"_21201":124116,"_5":14582,"_27821":124099,"_3006":123081},[],{"_3550":73298,"_30605":73290,"_21201":124118,"_5":14582,"_27821":124099,"_3006":124119},[],"Resultado necesario",{"_3550":73299,"_30605":73290,"_21201":124121,"_5":14582,"_27821":124099,"_3006":124122},[],"Cadena y firma",{"_3550":73300,"_30605":73290,"_21201":124124,"_5":14582,"_27821":124099,"_3006":124125},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3550":73301,"_30605":73290,"_21201":124127,"_5":14582,"_27821":124099,"_3006":124128},[],"Fechas",{"_3550":73302,"_30605":73290,"_21201":124130,"_5":14582,"_27821":124099,"_3006":124131},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3550":73303,"_30605":73290,"_21201":124133,"_5":14582,"_27821":124099,"_3006":119123},[],{"_3550":73304,"_30605":73290,"_21201":124135,"_5":14582,"_27821":124099,"_3006":124136},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3550":73305,"_30605":73290,"_21201":124138,"_5":14582,"_27821":124099,"_3006":124139},[],"Uso",{"_3550":73306,"_30605":73290,"_21201":124141,"_5":14582,"_27821":124099,"_3006":124142},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3550":73307,"_30605":73290,"_21201":124144,"_5":14582,"_27821":124099,"_3006":124145},[],"Revocación",{"_3550":73308,"_30605":73290,"_21201":124147,"_5":14582,"_27821":124099,"_3006":124148},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3550":73309,"_30605":73290,"_21201":124150,"_5":14582,"_27821":124099,"_3006":124151},[],"Autorización",{"_3550":73310,"_30605":73290,"_21201":124153,"_5":14582,"_27821":124099,"_3006":124154},[],"La aplicación permite la acción a esa identidad.",{"_3550":73311,"_30605":73290,"_21201":124156,"_5":14582,"_27821":124099,"_3006":124157},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3550":73312,"_30605":73290,"_21201":124159,"_5":14582,"_27821":124103,"_3006":124160},[],"Mecanismo",{"_3550":73313,"_30605":73290,"_21201":124162,"_5":14582,"_27821":124103,"_3006":124163},[],"Cuándo utilizarlo",{"_3550":73314,"_30605":73290,"_21201":124165,"_5":14582,"_27821":124103,"_3006":124166},[],"Qué debes mantener",{"_3550":73315,"_30605":73290,"_21201":124168,"_5":14582,"_27821":124103,"_3006":56339},[],{"_3550":73316,"_30605":73290,"_21201":124170,"_5":14582,"_27821":124103,"_3006":124171},[],"Consulta del estado de un certificado concreto.",{"_3550":73317,"_30605":73290,"_21201":124173,"_5":14582,"_27821":124103,"_3006":124174},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3550":73318,"_30605":73290,"_21201":124176,"_5":14582,"_27821":124103,"_3006":56348},[],{"_3550":73319,"_30605":73290,"_21201":124178,"_5":14582,"_27821":124103,"_3006":124179},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3550":73320,"_30605":73290,"_21201":124181,"_5":14582,"_27821":124103,"_3006":124182},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3550":73321,"_30605":73290,"_21201":124184,"_5":14582,"_27821":124103,"_3006":124185},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3550":73322,"_30605":73290,"_21201":124187,"_5":14582,"_27821":124103,"_3006":124188},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3550":73323,"_30605":73290,"_21201":124190,"_5":14582,"_27821":124107,"_3006":124191},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3550":73324,"_30605":73290,"_21201":124193,"_5":14582,"_27821":124107,"_3006":124194},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3550":73325,"_30605":73290,"_21201":124196,"_5":14582,"_27821":124107,"_3006":124197},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3550":73326,"_30605":73290,"_21201":124199,"_5":14582,"_27821":124107,"_3006":124200},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3550":73327,"_30605":73290,"_21201":124202,"_5":14582,"_27821":124107,"_3006":124203},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3550":73328,"_30605":73290,"_21201":124205,"_5":14582,"_27821":124107,"_3006":124206},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3550":73329,"_30605":73290,"_21201":124208,"_5":14582,"_27821":124107,"_3006":124209},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3550":73330,"_30605":73290,"_21201":124211,"_5":14582,"_27821":124107,"_3006":124212},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3550":73331,"_30605":73290,"_21201":124214,"_5":14582,"_27821":124107,"_3006":124215},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3550":73332,"_30605":73332,"_5":14934,"_3006":124217,"_30964":124218,"_21201":124219,"_27821":73332},"Certificados",[49995,119453,55621,123452],[],{"_3550":73333,"_30605":73332,"_21201":124221,"_5":14582,"_27821":73332,"_3006":124222},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3550":73334,"_30605":73332,"_5":30961,"_21201":124224,"_27821":124225,"_3006":124226},[],"/docs/pr-preview/pr-66/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3550":73335,"_30605":73332,"_5":30961,"_21201":124228,"_27821":124229,"_3006":124230},[],"/docs/pr-preview/pr-66/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3550":73336,"_30605":73332,"_5":30961,"_21201":124232,"_27821":124233,"_3006":124234},[],"/docs/pr-preview/pr-66/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3550":73337,"_30605":73332,"_5":30961,"_21201":124236,"_27821":124237,"_3006":124238},[],"/docs/pr-preview/pr-66/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3550":73338,"_30605":73332,"_5":30961,"_21201":124240,"_27821":124241,"_3006":124242},[],"/docs/pr-preview/pr-66/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3550":73339,"_30605":73332,"_5":30961,"_21201":124244,"_27821":124245,"_3006":124246},[],"/docs/pr-preview/pr-66/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3550":73340,"_30605":73332,"_5":30961,"_21201":124248,"_27821":124249,"_3006":124250},[],"/docs/pr-preview/pr-66/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3550":73341,"_30605":73332,"_5":30961,"_21201":124252,"_27821":124253,"_3006":124254},[],"/docs/pr-preview/pr-66/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3550":73342,"_30605":73332,"_5":30961,"_21201":124256,"_27821":124257,"_3006":124258},[],"/docs/pr-preview/pr-66/es/platform/pki/certificates#continúa","Continúa",{"_3550":73343,"_30605":73332,"_21201":124260,"_5":14582,"_27821":73332,"_3006":124261},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3550":73344,"_30605":73332,"_21201":124263,"_5":14582,"_27821":124225,"_3006":124264},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3550":73345,"_30605":73332,"_21201":124266,"_5":14582,"_27821":124225,"_3006":124267},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3550":73346,"_30605":73332,"_21201":124269,"_5":14582,"_27821":124225,"_3006":124270},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3550":73347,"_30605":73332,"_21201":124272,"_5":14582,"_27821":124225,"_3006":124273},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3550":73348,"_30605":73332,"_21201":124275,"_5":14582,"_27821":124225,"_3006":124276},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3550":73349,"_30605":73332,"_21201":124278,"_5":14582,"_27821":124225,"_3006":124279},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3550":73350,"_30605":73332,"_21201":124281,"_5":14582,"_27821":124225,"_3006":124282},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3550":73351,"_30605":73332,"_21201":124284,"_5":14582,"_27821":124229,"_3006":124285},[],"Descarga el PEM e inspecciónalo:",{"_3550":73352,"_30605":73332,"_21201":124287,"_5":14582,"_27821":124229,"_3006":124288},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3550":73353,"_30605":73332,"_21201":124290,"_5":14582,"_27821":124233,"_3006":124291},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3550":73354,"_30605":73332,"_21201":124293,"_5":14582,"_27821":124233,"_3006":124294},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3550":73355,"_30605":73332,"_21201":124296,"_5":14582,"_27821":124233,"_3006":124297},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3550":73356,"_30605":73332,"_21201":124299,"_5":14582,"_27821":124233,"_3006":124300},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3550":73357,"_30605":73332,"_21201":124302,"_5":14582,"_27821":124233,"_3006":124303},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3550":73358,"_30605":73332,"_21201":124305,"_5":14582,"_27821":124233,"_3006":124306},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3550":73359,"_30605":73332,"_21201":124308,"_5":14582,"_27821":124233,"_3006":124309},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3550":73360,"_30605":73332,"_21201":124311,"_5":14582,"_27821":124237,"_3006":124312},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3550":73361,"_30605":73332,"_21201":124314,"_5":14582,"_27821":124241,"_3006":124315},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3550":73362,"_30605":73332,"_21201":124317,"_5":14582,"_27821":124245,"_3006":124318},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3550":73363,"_30605":73332,"_21201":124320,"_5":14582,"_27821":124249,"_3006":124321},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3550":73364,"_30605":73332,"_21201":124323,"_5":14582,"_27821":124249,"_3006":124324},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3550":73365,"_30605":73332,"_21201":124326,"_5":14582,"_27821":124249,"_3006":124327},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3550":73366,"_30605":73332,"_21201":124329,"_5":14582,"_27821":124253,"_3006":124330},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3550":73367,"_30605":73332,"_21201":124332,"_5":14582,"_27821":124253,"_3006":124333},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3550":73368,"_30605":73332,"_21201":124335,"_5":14582,"_27821":124253,"_3006":124336},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3550":73369,"_30605":73332,"_21201":124338,"_5":14582,"_27821":124257,"_3006":124339},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3550":73370,"_30605":73332,"_21201":124341,"_5":14582,"_27821":124257,"_3006":124342},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3550":73371,"_30605":73371,"_5":14934,"_3006":124344,"_30964":124345,"_21201":124347,"_27821":73371},"Ciclo de vida de un certificado",[49995,119453,55621,124346],"Conceptos",[],{"_3550":73372,"_30605":73371,"_21201":124349,"_5":14582,"_27821":73371,"_3006":124350},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3550":73373,"_30605":73371,"_5":30961,"_21201":124352,"_27821":124353,"_3006":124354},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3550":73374,"_30605":73371,"_5":30961,"_21201":124356,"_27821":124357,"_3006":124358},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3550":73375,"_30605":73371,"_5":30961,"_21201":124360,"_27821":124361,"_3006":124362},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3550":73376,"_30605":73371,"_5":30961,"_21201":124364,"_27821":124365,"_3006":124366},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3550":73377,"_30605":73371,"_5":30961,"_21201":124368,"_27821":124369,"_3006":124370},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3550":73378,"_30605":73371,"_5":30961,"_21201":124372,"_27821":124373,"_3006":124374},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3550":73379,"_30605":73371,"_5":30961,"_21201":124376,"_27821":124377,"_3006":122075},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3550":73380,"_30605":73371,"_5":30961,"_21201":124379,"_27821":124380,"_3006":124381},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3550":73381,"_30605":73371,"_5":30961,"_21201":124383,"_27821":124384,"_3006":124385},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3550":73382,"_30605":73371,"_5":30961,"_21201":124387,"_27821":124388,"_3006":124389},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3550":73383,"_30605":73371,"_21201":124391,"_5":14582,"_27821":73371,"_3006":124392},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3550":73384,"_30605":73371,"_21201":124394,"_5":14582,"_27821":124357,"_3006":124395},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3550":73385,"_30605":73371,"_21201":124397,"_5":14582,"_27821":124361,"_3006":124398},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3550":73386,"_30605":73371,"_21201":124400,"_5":14582,"_27821":124365,"_3006":124401},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3550":73387,"_30605":73371,"_21201":124403,"_5":14582,"_27821":124369,"_3006":124404},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3550":73388,"_30605":73371,"_21201":124406,"_5":14582,"_27821":124373,"_3006":124407},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3550":73389,"_30605":73371,"_21201":124409,"_5":14582,"_27821":124377,"_3006":124410},[],"Lamassu persiste cuatro estados X.509:",{"_3550":73390,"_30605":73371,"_21201":124412,"_5":14582,"_27821":124377,"_3006":124413},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3550":73391,"_30605":73371,"_21201":124415,"_5":14582,"_27821":124377,"_3006":124416},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3550":73392,"_30605":73371,"_21201":124418,"_5":14582,"_27821":124377,"_3006":124419},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3550":73393,"_30605":73371,"_21201":124421,"_5":14582,"_27821":124377,"_3006":124422},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3550":73394,"_30605":73371,"_21201":124424,"_5":14582,"_27821":124377,"_3006":124425},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3550":73395,"_30605":73371,"_21201":124427,"_5":14582,"_27821":124380,"_3006":124428},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3550":73396,"_30605":73371,"_21201":124430,"_5":14582,"_27821":124380,"_3006":124431},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3550":73397,"_30605":73371,"_21201":124433,"_5":14582,"_27821":124380,"_3006":124434},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3550":73398,"_30605":73371,"_21201":124436,"_5":14582,"_27821":124384,"_3006":124437},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3550":73399,"_30605":73371,"_21201":124439,"_5":14582,"_27821":124384,"_3006":124440},[],"Antes de confirmar:",{"_3550":73400,"_30605":73371,"_21201":124442,"_5":14582,"_27821":124384,"_3006":124443},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3550":73401,"_30605":73371,"_21201":124445,"_5":14582,"_27821":124384,"_3006":124446},[],"Distribuye la nueva cadena de confianza.",{"_3550":73402,"_30605":73371,"_21201":124448,"_5":14582,"_27821":124384,"_3006":124449},[],"Reemite las identidades necesarias.",{"_3550":73403,"_30605":73371,"_21201":124451,"_5":14582,"_27821":124384,"_3006":124452},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3550":73404,"_30605":73371,"_21201":124454,"_5":14582,"_27821":124384,"_3006":124455},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3550":73405,"_30605":73371,"_21201":124457,"_5":14582,"_27821":124384,"_3006":124458},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3550":73406,"_30605":73371,"_21201":124460,"_5":14582,"_27821":124388,"_3006":124461},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3550":73407,"_30605":73371,"_21201":124463,"_5":14582,"_27821":124388,"_3006":124464},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3550":73408,"_30605":73371,"_21201":124466,"_5":14582,"_27821":124388,"_3006":124467},[],"Cambios de estado y razones de revocación.",{"_3550":73409,"_30605":73371,"_21201":124469,"_5":14582,"_27821":124388,"_3006":124470},[],"Publicación y vigencia de OCSP y CRLs.",{"_3550":73410,"_30605":73371,"_21201":124472,"_5":14582,"_27821":124388,"_3006":124473},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3550":73411,"_30605":73371,"_21201":124475,"_5":14582,"_27821":124388,"_3006":124476},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3550":73412,"_30605":73412,"_5":14934,"_3006":124478,"_30964":124479,"_21201":124480,"_27821":73412},"Modelo de confianza",[49995,119453,55621,124346],[],{"_3550":73413,"_30605":73412,"_21201":124482,"_5":14582,"_27821":73412,"_3006":124483},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3550":73414,"_30605":73412,"_5":30961,"_21201":124485,"_27821":124486,"_3006":124487},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3550":73415,"_30605":73412,"_5":30961,"_21201":124489,"_27821":124490,"_3006":124491},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3550":73416,"_30605":73412,"_5":30961,"_21201":124493,"_27821":124494,"_3006":124495},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3550":73417,"_30605":73412,"_5":30961,"_21201":124497,"_27821":124498,"_3006":124499},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3550":73418,"_30605":73412,"_5":30961,"_21201":124501,"_27821":124502,"_3006":124503},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3550":73419,"_30605":73412,"_5":30961,"_21201":124505,"_27821":124506,"_3006":124507},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3550":73420,"_30605":73412,"_5":30961,"_21201":124509,"_27821":124510,"_3006":124511},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3550":73421,"_30605":73412,"_5":30961,"_21201":124513,"_27821":124514,"_3006":124515},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3550":73422,"_30605":73412,"_5":30961,"_21201":124517,"_27821":124518,"_3006":124519},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3550":73423,"_30605":73412,"_5":30961,"_21201":124521,"_27821":124522,"_3006":124523},[],"/docs/pr-preview/pr-66/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3550":73424,"_30605":73412,"_21201":124525,"_5":14582,"_27821":73412,"_3006":124526},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3550":73425,"_30605":73412,"_21201":124528,"_5":14582,"_27821":124490,"_3006":124529},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3550":73426,"_30605":73412,"_21201":124531,"_5":14582,"_27821":124494,"_3006":124532},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3550":73427,"_30605":73412,"_21201":124534,"_5":14582,"_27821":124498,"_3006":124535},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3550":73428,"_30605":73412,"_21201":124537,"_5":14582,"_27821":124502,"_3006":124538},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3550":73429,"_30605":73412,"_21201":124540,"_5":14582,"_27821":124506,"_3006":124541},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3550":73430,"_30605":73412,"_21201":124543,"_5":14582,"_27821":124506,"_3006":124544},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3550":73431,"_30605":73412,"_21201":124546,"_5":14582,"_27821":124506,"_3006":124547},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3550":73432,"_30605":73412,"_21201":124549,"_5":14582,"_27821":124506,"_3006":124550},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3550":73433,"_30605":73412,"_21201":124552,"_5":14582,"_27821":124506,"_3006":124553},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3550":73434,"_30605":73412,"_21201":124555,"_5":14582,"_27821":124506,"_3006":124556},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3550":73435,"_30605":73412,"_21201":124558,"_5":14582,"_27821":124510,"_3006":124559},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3550":73436,"_30605":73412,"_21201":124561,"_5":14582,"_27821":124510,"_3006":124562},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3550":73437,"_30605":73412,"_21201":124564,"_5":14582,"_27821":124510,"_3006":124565},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3550":73438,"_30605":73412,"_21201":124567,"_5":14582,"_27821":124510,"_3006":124568},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3550":73439,"_30605":73412,"_21201":124570,"_5":14582,"_27821":124510,"_3006":124571},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3550":73440,"_30605":73412,"_21201":124573,"_5":14582,"_27821":124514,"_3006":124574},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3550":73441,"_30605":73412,"_21201":124576,"_5":14582,"_27821":124514,"_3006":124577},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3550":73442,"_30605":73412,"_21201":124579,"_5":14582,"_27821":124514,"_3006":124580},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3550":73443,"_30605":73412,"_21201":124582,"_5":14582,"_27821":124514,"_3006":124583},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3550":73444,"_30605":73412,"_21201":124585,"_5":14582,"_27821":124514,"_3006":124586},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3550":73445,"_30605":73412,"_21201":124588,"_5":14582,"_27821":124514,"_3006":124589},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3550":73446,"_30605":73412,"_21201":124591,"_5":14582,"_27821":124514,"_3006":124592},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3550":73447,"_30605":73412,"_21201":124594,"_5":14582,"_27821":124518,"_3006":124595},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3550":73448,"_30605":73412,"_21201":124597,"_5":14582,"_27821":124522,"_3006":124598},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3550":73449,"_30605":73412,"_21201":124600,"_5":14582,"_27821":124522,"_3006":124601},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3550":73450,"_30605":73412,"_21201":124603,"_5":14582,"_27821":124522,"_3006":124604},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3550":73451,"_30605":73412,"_21201":124606,"_5":14582,"_27821":124522,"_3006":124607},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3550":73452,"_30605":73412,"_21201":124609,"_5":14582,"_27821":124522,"_3006":124610},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3550":73453,"_30605":73412,"_21201":124612,"_5":14582,"_27821":124522,"_3006":124613},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3550":73454,"_30605":73412,"_21201":124615,"_5":14582,"_27821":124522,"_3006":124616},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3550":73455,"_30605":73455,"_5":14934,"_3006":124618,"_30964":124619,"_21201":124620,"_27821":73455},"Listas de revocación (CRL)",[49995,119453,55621,124092],[],{"_3550":73456,"_30605":73455,"_21201":124622,"_5":14582,"_27821":73455,"_3006":124623},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3550":73457,"_30605":73455,"_5":30961,"_21201":124625,"_27821":124626,"_3006":124627},[],"/docs/pr-preview/pr-66/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3550":73458,"_30605":73455,"_5":30961,"_21201":124629,"_27821":124630,"_3006":124631},[],"/docs/pr-preview/pr-66/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3550":73459,"_30605":73455,"_5":30961,"_21201":124633,"_27821":124634,"_3006":124635},[],"/docs/pr-preview/pr-66/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3550":73460,"_30605":73455,"_5":30961,"_21201":124637,"_27821":124638,"_3006":124639},[],"/docs/pr-preview/pr-66/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3550":73461,"_30605":73455,"_5":30961,"_21201":124641,"_27821":124642,"_3006":124643},[],"/docs/pr-preview/pr-66/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3550":73462,"_30605":73455,"_5":30961,"_21201":124645,"_27821":124646,"_3006":124647},[],"/docs/pr-preview/pr-66/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3550":73463,"_30605":73455,"_5":30961,"_21201":124649,"_27821":124650,"_3006":124651},[],"/docs/pr-preview/pr-66/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3550":73464,"_30605":73455,"_5":30961,"_21201":124653,"_27821":124654,"_3006":124655},[],"/docs/pr-preview/pr-66/es/platform/pki/crl#referencias","Referencias",{"_3550":73465,"_30605":73455,"_21201":124657,"_5":14582,"_27821":73455,"_3006":124658},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3550":73466,"_30605":73455,"_21201":124660,"_5":14582,"_27821":124626,"_3006":124661},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3550":73467,"_30605":73455,"_21201":124663,"_5":14582,"_27821":124626,"_3006":124664},[],"Campo",{"_3550":73468,"_30605":73455,"_21201":124666,"_5":14582,"_27821":124626,"_3006":121115},[],{"_3550":73469,"_30605":73455,"_21201":124668,"_5":14582,"_27821":124626,"_3006":51590},[],{"_3550":73470,"_30605":73455,"_21201":124670,"_5":14582,"_27821":124626,"_3006":124671},[],"ID de la CA a la que pertenecen los ajustes.",{"_3550":73471,"_30605":73455,"_21201":124673,"_5":14582,"_27821":124626,"_3006":56847},[],{"_3550":73472,"_30605":73455,"_21201":124675,"_5":14582,"_27821":124626,"_3006":124676},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3550":73473,"_30605":73455,"_21201":124678,"_5":14582,"_27821":124626,"_3006":56853},[],{"_3550":73474,"_30605":73455,"_21201":124680,"_5":14582,"_27821":124626,"_3006":124681},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3550":73475,"_30605":73455,"_21201":124683,"_5":14582,"_27821":124626,"_3006":56859},[],{"_3550":73476,"_30605":73455,"_21201":124685,"_5":14582,"_27821":124626,"_3006":124686},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3550":73477,"_30605":73455,"_21201":124688,"_5":14582,"_27821":124626,"_3006":124689},[],"Campo de `crl_options`",{"_3550":73478,"_30605":73455,"_21201":124691,"_5":14582,"_27821":124626,"_3006":121115},[],{"_3550":73479,"_30605":73455,"_21201":124693,"_5":14582,"_27821":124626,"_3006":124694},[],"Valor inicial",{"_3550":73480,"_30605":73455,"_21201":124696,"_5":14582,"_27821":124626,"_3006":56873},[],{"_3550":73481,"_30605":73455,"_21201":124698,"_5":14582,"_27821":124626,"_3006":124699},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3550":73482,"_30605":73455,"_21201":124701,"_5":14582,"_27821":124626,"_3006":124702},[],"7 días.",{"_3550":73483,"_30605":73455,"_21201":124704,"_5":14582,"_27821":124626,"_3006":56882},[],{"_3550":73484,"_30605":73455,"_21201":124706,"_5":14582,"_27821":124626,"_3006":124707},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3550":73485,"_30605":73455,"_21201":124709,"_5":14582,"_27821":124626,"_3006":124710},[],"6 días y 23 horas.",{"_3550":73486,"_30605":73455,"_21201":124712,"_5":14582,"_27821":124626,"_3006":56891},[],{"_3550":73487,"_30605":73455,"_21201":124714,"_5":14582,"_27821":124626,"_3006":124715},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3550":73488,"_30605":73455,"_21201":124717,"_5":14582,"_27821":124626,"_3006":56897},[],{"_3550":73489,"_30605":73455,"_21201":124719,"_5":14582,"_27821":124626,"_3006":56900},[],{"_3550":73490,"_30605":73455,"_21201":124721,"_5":14582,"_27821":124626,"_3006":124722},[],"Número de serie del certificado existente que firma la CRL.",{"_3550":73491,"_30605":73455,"_21201":124724,"_5":14582,"_27821":124626,"_3006":124725},[],"Número de serie del certificado actual de la CA.",{"_3550":73492,"_30605":73455,"_21201":124727,"_5":14582,"_27821":124626,"_3006":124728},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3550":73493,"_30605":73455,"_21201":124730,"_5":14582,"_27821":124626,"_3006":124731},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3550":73494,"_30605":73455,"_21201":124733,"_5":14582,"_27821":124626,"_3006":124734},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3550":73495,"_30605":73455,"_21201":124736,"_5":14582,"_27821":124626,"_3006":124737},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3550":73496,"_30605":73455,"_21201":124739,"_5":14582,"_27821":124626,"_3006":124740},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3550":73497,"_30605":73455,"_21201":124742,"_5":14582,"_27821":124626,"_3006":124743},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3550":73498,"_30605":73455,"_21201":124745,"_5":14582,"_27821":124626,"_3006":124746},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3550":73499,"_30605":73455,"_21201":124748,"_5":14582,"_27821":124626,"_3006":124749},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3550":73500,"_30605":73455,"_21201":124751,"_5":14582,"_27821":124626,"_3006":124752},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3550":73501,"_30605":73455,"_21201":124754,"_5":14582,"_27821":124626,"_3006":124755},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3550":73502,"_30605":73455,"_21201":124757,"_5":14582,"_27821":124626,"_3006":124758},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3550":73503,"_30605":73455,"_21201":124760,"_5":14582,"_27821":124630,"_3006":124761},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3550":73504,"_30605":73455,"_21201":124763,"_5":14582,"_27821":124630,"_3006":124764},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3550":73505,"_30605":73455,"_21201":124766,"_5":14582,"_27821":124630,"_3006":124767},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3550":73506,"_30605":73455,"_21201":124769,"_5":14582,"_27821":124630,"_3006":124770},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3550":73507,"_30605":73455,"_21201":124772,"_5":14582,"_27821":124634,"_3006":124773},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3550":73508,"_30605":73455,"_21201":124775,"_5":14582,"_27821":124634,"_3006":124776},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3550":73509,"_30605":73455,"_21201":124778,"_5":14582,"_27821":124634,"_3006":124779},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3550":73510,"_30605":73455,"_21201":124781,"_5":14582,"_27821":124634,"_3006":124782},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3550":73511,"_30605":73455,"_21201":124784,"_5":14582,"_27821":124634,"_3006":124785},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3550":73512,"_30605":73455,"_21201":124787,"_5":14582,"_27821":124634,"_3006":124788},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3550":73513,"_30605":73455,"_21201":124790,"_5":14582,"_27821":124634,"_3006":124791},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3550":73514,"_30605":73455,"_21201":124793,"_5":14582,"_27821":124634,"_3006":124794},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3550":73515,"_30605":73455,"_21201":124796,"_5":14582,"_27821":124634,"_3006":124797},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3550":73516,"_30605":73455,"_21201":124799,"_5":14582,"_27821":124638,"_3006":124800},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3550":73517,"_30605":73455,"_21201":124802,"_5":14582,"_27821":124638,"_3006":124803},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3550":73518,"_30605":73455,"_21201":124805,"_5":14582,"_27821":124642,"_3006":124806},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3550":73519,"_30605":73455,"_21201":124808,"_5":14582,"_27821":124642,"_3006":124809},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3550":73520,"_30605":73455,"_21201":124811,"_5":14582,"_27821":124642,"_3006":124812},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3550":73521,"_30605":73455,"_21201":124814,"_5":14582,"_27821":124642,"_3006":124815},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3550":73522,"_30605":73455,"_21201":124817,"_5":14582,"_27821":124642,"_3006":124818},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3550":73523,"_30605":73455,"_21201":124820,"_5":14582,"_27821":124646,"_3006":124821},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3550":73524,"_30605":73455,"_21201":124823,"_5":14582,"_27821":124646,"_3006":121304},[],{"_3550":73525,"_30605":73455,"_21201":124825,"_5":14582,"_27821":124646,"_3006":124826},[],"Path relativo",{"_3550":73526,"_30605":73455,"_21201":124828,"_5":14582,"_27821":124646,"_3006":119213},[],{"_3550":73527,"_30605":73455,"_21201":124830,"_5":14582,"_27821":124646,"_3006":57012},[],{"_3550":73528,"_30605":73455,"_21201":124832,"_5":14582,"_27821":124646,"_3006":57015},[],{"_3550":73529,"_30605":73455,"_21201":124834,"_5":14582,"_27821":124646,"_3006":124835},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3550":73530,"_30605":73455,"_21201":124837,"_5":14582,"_27821":124646,"_3006":57012},[],{"_3550":73531,"_30605":73455,"_21201":124839,"_5":14582,"_27821":124646,"_3006":57023},[],{"_3550":73532,"_30605":73455,"_21201":124841,"_5":14582,"_27821":124646,"_3006":124842},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3550":73533,"_30605":73455,"_21201":124844,"_5":14582,"_27821":124646,"_3006":57029},[],{"_3550":73534,"_30605":73455,"_21201":124846,"_5":14582,"_27821":124646,"_3006":57023},[],{"_3550":73535,"_30605":73455,"_21201":124848,"_5":14582,"_27821":124646,"_3006":124849},[],"Sustituir la configuración de CRL de una CA.",{"_3550":73536,"_30605":73455,"_21201":124851,"_5":14582,"_27821":124646,"_3006":57037},[],{"_3550":73537,"_30605":73455,"_21201":124853,"_5":14582,"_27821":124646,"_3006":57023},[],{"_3550":73538,"_30605":73455,"_21201":124855,"_5":14582,"_27821":124646,"_3006":124856},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3550":73539,"_30605":73455,"_21201":124858,"_5":14582,"_27821":124646,"_3006":124859},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3550":73540,"_30605":73455,"_21201":124861,"_5":14582,"_27821":124646,"_3006":124862},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3550":73541,"_30605":73455,"_21201":124864,"_5":14582,"_27821":124646,"_3006":124865},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3550":73542,"_30605":73455,"_21201":124867,"_5":14582,"_27821":124650,"_3006":124868},[],"Síntoma",{"_3550":73543,"_30605":73455,"_21201":124870,"_5":14582,"_27821":124650,"_3006":124871},[],"Causa",{"_3550":73544,"_30605":73455,"_21201":124873,"_5":14582,"_27821":124650,"_3006":124874},[],"Acción",{"_3550":73545,"_30605":73455,"_21201":124876,"_5":14582,"_27821":124650,"_3006":124877},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3550":73546,"_30605":73455,"_21201":124879,"_5":14582,"_27821":124650,"_3006":124880},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3550":73547,"_30605":73455,"_21201":124882,"_5":14582,"_27821":124650,"_3006":124883},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3550":73548,"_30605":73455,"_21201":124885,"_5":14582,"_27821":124650,"_3006":124886},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3550":73549,"_30605":73455,"_21201":124888,"_5":14582,"_27821":124650,"_3006":124889},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3550":73550,"_30605":73455,"_21201":124891,"_5":14582,"_27821":124650,"_3006":124892},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3550":73551,"_30605":73455,"_21201":124894,"_5":14582,"_27821":124650,"_3006":124895},[],"`PUT` devuelve 400.",{"_3550":73552,"_30605":73455,"_21201":124897,"_5":14582,"_27821":124650,"_3006":124898},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3550":73553,"_30605":73455,"_21201":124900,"_5":14582,"_27821":124650,"_3006":124901},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3550":73554,"_30605":73455,"_21201":124903,"_5":14582,"_27821":124650,"_3006":124904},[],"`PUT` devuelve 404.",{"_3550":73555,"_30605":73455,"_21201":124906,"_5":14582,"_27821":124650,"_3006":124907},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3550":73556,"_30605":73455,"_21201":124909,"_5":14582,"_27821":124650,"_3006":124910},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3550":73557,"_30605":73455,"_21201":124912,"_5":14582,"_27821":124650,"_3006":124913},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3550":73558,"_30605":73455,"_21201":124915,"_5":14582,"_27821":124650,"_3006":124916},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3550":73559,"_30605":73455,"_21201":124918,"_5":14582,"_27821":124650,"_3006":124919},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3550":73560,"_30605":73455,"_21201":124921,"_5":14582,"_27821":124650,"_3006":124922},[],"La CRL no cambia tras revocar un certificado.",{"_3550":73561,"_30605":73455,"_21201":124924,"_5":14582,"_27821":124650,"_3006":124925},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3550":73562,"_30605":73455,"_21201":124927,"_5":14582,"_27821":124650,"_3006":124928},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3550":73563,"_30605":73455,"_21201":124930,"_5":14582,"_27821":124650,"_3006":124931},[],"Un verificador rechaza la CRL por el emisor.",{"_3550":73564,"_30605":73455,"_21201":124933,"_5":14582,"_27821":124650,"_3006":124934},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3550":73565,"_30605":73455,"_21201":124936,"_5":14582,"_27821":124650,"_3006":124937},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3550":73566,"_30605":73455,"_21201":124939,"_5":14582,"_27821":124654,"_3006":124940},[],"RFC 5280: perfil X.509 y CRL.",{"_3550":73567,"_30605":73455,"_21201":124942,"_5":14582,"_27821":124654,"_3006":57129},[],{"_3550":73568,"_30605":73455,"_21201":124944,"_5":14582,"_27821":124654,"_3006":57132},[],{"_3550":73569,"_30605":73455,"_21201":124946,"_5":14582,"_27821":124654,"_3006":124947},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3550":73570,"_30605":73455,"_21201":124949,"_5":14582,"_27821":124654,"_3006":124950},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3550":73571,"_30605":73571,"_5":14934,"_3006":124952,"_30964":124953,"_21201":124954,"_27821":73571},"Claves y motores criptográficos",[49995,119453,55621,123452],[],{"_3550":73572,"_30605":73571,"_21201":124956,"_5":14582,"_27821":73571,"_3006":124957},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3550":73573,"_30605":73571,"_5":30961,"_21201":124959,"_27821":124960,"_3006":124961},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3550":73574,"_30605":73571,"_5":30961,"_21201":124963,"_27821":124964,"_3006":124965},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3550":73575,"_30605":73571,"_5":30961,"_21201":124967,"_27821":124968,"_3006":57157},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#file-system",{"_3550":73576,"_30605":73571,"_5":30961,"_21201":124970,"_27821":124971,"_3006":57161},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#hashicorp-vault",{"_3550":73577,"_30605":73571,"_5":30961,"_21201":124973,"_27821":124974,"_3006":57165},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#aws-secrets-manager",{"_3550":73578,"_30605":73571,"_5":30961,"_21201":124976,"_27821":124977,"_3006":57169},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#aws-kms",{"_3550":73579,"_30605":73571,"_5":30961,"_21201":124979,"_27821":124980,"_3006":57173},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#pkcs11",{"_3550":73580,"_30605":73571,"_5":30961,"_21201":124982,"_27821":124983,"_3006":57177},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#azure-key-vault",{"_3550":73581,"_30605":73571,"_5":30961,"_21201":124985,"_27821":124986,"_3006":124987},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3550":73582,"_30605":73571,"_5":30961,"_21201":124989,"_27821":124990,"_3006":124991},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3550":73583,"_30605":73571,"_5":30961,"_21201":124993,"_27821":124994,"_3006":124995},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3550":73584,"_30605":73571,"_5":30961,"_21201":124997,"_27821":124998,"_3006":124999},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3550":73585,"_30605":73571,"_5":30961,"_21201":125001,"_27821":125002,"_3006":125003},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3550":73586,"_30605":73571,"_5":30961,"_21201":125005,"_27821":125006,"_3006":125007},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3550":73587,"_30605":73571,"_5":30961,"_21201":125009,"_27821":125010,"_3006":125011},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3550":73588,"_30605":73571,"_5":30961,"_21201":125013,"_27821":125014,"_3006":57209},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#sign",{"_3550":73589,"_30605":73571,"_5":30961,"_21201":125016,"_27821":125017,"_3006":57213},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#verify",{"_3550":73590,"_30605":73571,"_5":30961,"_21201":125019,"_27821":125020,"_3006":125021},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3550":73591,"_30605":73571,"_5":30961,"_21201":125023,"_27821":125024,"_3006":125025},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3550":73592,"_30605":73571,"_5":30961,"_21201":125027,"_27821":125028,"_3006":125029},[],"/docs/pr-preview/pr-66/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3550":73593,"_30605":73571,"_21201":125031,"_5":14582,"_27821":73571,"_3006":125032},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3550":73594,"_30605":73571,"_21201":125034,"_5":14582,"_27821":73571,"_3006":125035},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3550":73595,"_30605":73571,"_21201":125037,"_5":14582,"_27821":124960,"_3006":125038},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3550":73596,"_30605":73571,"_21201":125040,"_5":14582,"_27821":124960,"_3006":125041},[],"En la práctica, permite:",{"_3550":73597,"_30605":73571,"_21201":125043,"_5":14582,"_27821":124960,"_3006":125044},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3550":73598,"_30605":73571,"_21201":125046,"_5":14582,"_27821":124960,"_3006":125047},[],"Importar claves creadas externamente.",{"_3550":73599,"_30605":73571,"_21201":125049,"_5":14582,"_27821":124960,"_3006":125050},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3550":73600,"_30605":73571,"_21201":125052,"_5":14582,"_27821":124960,"_3006":125053},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3550":73601,"_30605":73571,"_21201":125055,"_5":14582,"_27821":124964,"_3006":125056},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3550":73602,"_30605":73571,"_21201":125058,"_5":14582,"_27821":124964,"_3006":125059},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3550":73603,"_30605":73571,"_21201":125061,"_5":14582,"_27821":124964,"_3006":125062},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3550":73604,"_30605":73571,"_21201":125064,"_5":14582,"_27821":124968,"_3006":125065},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3550":73605,"_30605":73571,"_21201":125067,"_5":14582,"_27821":124971,"_3006":125068},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3550":73606,"_30605":73571,"_21201":125070,"_5":14582,"_27821":124971,"_3006":125071},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3550":73607,"_30605":73571,"_21201":125073,"_5":14582,"_27821":124974,"_3006":125074},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3550":73608,"_30605":73571,"_21201":125076,"_5":14582,"_27821":124977,"_3006":125077},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3550":73609,"_30605":73571,"_21201":125079,"_5":14582,"_27821":124980,"_3006":125080},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3550":73610,"_30605":73571,"_21201":125082,"_5":14582,"_27821":124983,"_3006":125083},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3550":73611,"_30605":73571,"_21201":125085,"_5":14582,"_27821":124983,"_3006":125086},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3550":73612,"_30605":73571,"_21201":125088,"_5":14582,"_27821":124983,"_3006":125089},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3550":73613,"_30605":73571,"_21201":125091,"_5":14582,"_27821":124983,"_3006":125092},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3550":73614,"_30605":73571,"_21201":125094,"_5":14582,"_27821":124986,"_3006":125095},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3550":73615,"_30605":73571,"_21201":125097,"_5":14582,"_27821":124986,"_3006":125098},[],"La tabla incluye los siguientes campos:",{"_3550":73616,"_30605":73571,"_21201":125100,"_5":14582,"_27821":124986,"_3006":125101},[],"**Name**: nombre descriptivo de la clave.",{"_3550":73617,"_30605":73571,"_21201":125103,"_5":14582,"_27821":124986,"_3006":125104},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3550":73618,"_30605":73571,"_21201":125106,"_5":14582,"_27821":124986,"_3006":125107},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3550":73619,"_30605":73571,"_21201":125109,"_5":14582,"_27821":124986,"_3006":125110},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3550":73620,"_30605":73571,"_21201":125112,"_5":14582,"_27821":124986,"_3006":125113},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3550":73621,"_30605":73571,"_21201":125115,"_5":14582,"_27821":124986,"_3006":125116},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3550":73622,"_30605":73571,"_21201":125118,"_5":14582,"_27821":124986,"_3006":125119},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3550":73623,"_30605":73571,"_21201":125121,"_5":14582,"_27821":124986,"_3006":125122},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3550":73624,"_30605":73571,"_21201":125124,"_5":14582,"_27821":124986,"_3006":125125},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3550":73625,"_30605":73571,"_21201":125127,"_5":14582,"_27821":124986,"_3006":125128},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3550":73626,"_30605":73571,"_21201":125130,"_5":14582,"_27821":124986,"_3006":125131},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3550":73627,"_30605":73571,"_21201":125133,"_5":14582,"_27821":124986,"_3006":125134},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3550":73628,"_30605":73571,"_21201":125136,"_5":14582,"_27821":124986,"_3006":125137},[],"**Delete Key** para eliminar la clave del sistema.",{"_3550":73629,"_30605":73571,"_21201":125139,"_5":14582,"_27821":124990,"_3006":125140},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3550":73630,"_30605":73571,"_21201":125142,"_5":14582,"_27821":124994,"_3006":125143},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3550":73631,"_30605":73571,"_21201":125145,"_5":14582,"_27821":124994,"_3006":125146},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3550":73632,"_30605":73571,"_21201":125148,"_5":14582,"_27821":124994,"_3006":125149},[],"**Key Name**: nombre único y descriptivo.",{"_3550":73633,"_30605":73571,"_21201":125151,"_5":14582,"_27821":124994,"_3006":125152},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3550":73634,"_30605":73571,"_21201":125154,"_5":14582,"_27821":124994,"_3006":125155},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3550":73635,"_30605":73571,"_21201":125157,"_5":14582,"_27821":124994,"_3006":125158},[],"**Tags**: metadatos para clasificar la clave.",{"_3550":73636,"_30605":73571,"_21201":125160,"_5":14582,"_27821":124994,"_3006":125161},[],"**Metadata**: información adicional para usos avanzados.",{"_3550":73637,"_30605":73571,"_21201":125163,"_5":14582,"_27821":124998,"_3006":125164},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3550":73638,"_30605":73571,"_21201":125166,"_5":14582,"_27821":124998,"_3006":125167},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3550":73639,"_30605":73571,"_21201":125169,"_5":14582,"_27821":124998,"_3006":125170},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3550":73640,"_30605":73571,"_21201":125172,"_5":14582,"_27821":124998,"_3006":125173},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3550":73641,"_30605":73571,"_21201":125175,"_5":14582,"_27821":124998,"_3006":125176},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3550":73642,"_30605":73571,"_21201":125178,"_5":14582,"_27821":124998,"_3006":125179},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3550":73643,"_30605":73571,"_21201":125181,"_5":14582,"_27821":124998,"_3006":125182},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3550":73644,"_30605":73571,"_21201":125184,"_5":14582,"_27821":124998,"_3006":125185},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3550":73645,"_30605":73571,"_21201":125187,"_5":14582,"_27821":124998,"_3006":125188},[],"**Metadata**: información adicional opcional.",{"_3550":73646,"_30605":73571,"_21201":125190,"_5":14582,"_27821":124998,"_3006":125191},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3550":73647,"_30605":73571,"_21201":125193,"_5":14582,"_27821":124998,"_3006":125194},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3550":73648,"_30605":73571,"_21201":125196,"_5":14582,"_27821":125002,"_3006":125197},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3550":73649,"_30605":73571,"_21201":125199,"_5":14582,"_27821":125006,"_3006":125200},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3550":73650,"_30605":73571,"_21201":125202,"_5":14582,"_27821":125006,"_3006":125203},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3550":73651,"_30605":73571,"_21201":125205,"_5":14582,"_27821":125006,"_3006":125206},[],"**Key Name**: nombre descriptivo.",{"_3550":73652,"_30605":73571,"_21201":125208,"_5":14582,"_27821":125006,"_3006":125209},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3550":73653,"_30605":73571,"_21201":125211,"_5":14582,"_27821":125006,"_3006":125212},[],"**Tags**: etiquetas asociadas.",{"_3550":73654,"_30605":73571,"_21201":125214,"_5":14582,"_27821":125006,"_3006":125215},[],"**Aliases**: nombres alternativos.",{"_3550":73655,"_30605":73571,"_21201":125217,"_5":14582,"_27821":125006,"_3006":125218},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3550":73656,"_30605":73571,"_21201":125220,"_5":14582,"_27821":125006,"_3006":125221},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3550":73657,"_30605":73571,"_21201":125223,"_5":14582,"_27821":125006,"_3006":125224},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3550":73658,"_30605":73571,"_21201":125226,"_5":14582,"_27821":125006,"_3006":125227},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3550":73659,"_30605":73571,"_21201":125229,"_5":14582,"_27821":125010,"_3006":125230},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3550":73660,"_30605":73571,"_21201":125232,"_5":14582,"_27821":125010,"_3006":125233},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3550":73661,"_30605":73571,"_21201":125235,"_5":14582,"_27821":125010,"_3006":125236},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3550":73662,"_30605":73571,"_21201":125238,"_5":14582,"_27821":125014,"_3006":125239},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3550":73663,"_30605":73571,"_21201":125241,"_5":14582,"_27821":125014,"_3006":125242},[],"Campos principales:",{"_3550":73664,"_30605":73571,"_21201":125244,"_5":14582,"_27821":125014,"_3006":125245},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3550":73665,"_30605":73571,"_21201":125247,"_5":14582,"_27821":125014,"_3006":125248},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3550":73666,"_30605":73571,"_21201":125250,"_5":14582,"_27821":125014,"_3006":125251},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3550":73667,"_30605":73571,"_21201":125253,"_5":14582,"_27821":125014,"_3006":125254},[],"**Message**: contenido que se va a firmar.",{"_3550":73668,"_30605":73571,"_21201":125256,"_5":14582,"_27821":125014,"_3006":125257},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3550":73669,"_30605":73571,"_21201":125259,"_5":14582,"_27821":125017,"_3006":125260},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3550":73670,"_30605":73571,"_21201":125262,"_5":14582,"_27821":125017,"_3006":125242},[],{"_3550":73671,"_30605":73571,"_21201":125264,"_5":14582,"_27821":125017,"_3006":125265},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3550":73672,"_30605":73571,"_21201":125267,"_5":14582,"_27821":125017,"_3006":125268},[],"**Message Type**: `Raw` o `Digest`.",{"_3550":73673,"_30605":73571,"_21201":125270,"_5":14582,"_27821":125017,"_3006":125271},[],"**Payload Encoding**: codificación del mensaje.",{"_3550":73674,"_30605":73571,"_21201":125273,"_5":14582,"_27821":125017,"_3006":125274},[],"**Message**: mensaje original o hash.",{"_3550":73675,"_30605":73571,"_21201":125276,"_5":14582,"_27821":125017,"_3006":125277},[],"**Signature**: firma que se desea comprobar.",{"_3550":73676,"_30605":73571,"_21201":125279,"_5":14582,"_27821":125017,"_3006":125280},[],"**Result**: indicador del resultado de la validación.",{"_3550":73677,"_30605":73571,"_21201":125282,"_5":14582,"_27821":125020,"_3006":125283},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3550":73678,"_30605":73571,"_21201":125285,"_5":14582,"_27821":125020,"_3006":125286},[],"Este flujo es útil para:",{"_3550":73679,"_30605":73571,"_21201":125288,"_5":14582,"_27821":125020,"_3006":125289},[],"Solicitar certificados a una CA externa.",{"_3550":73680,"_30605":73571,"_21201":125291,"_5":14582,"_27821":125020,"_3006":125292},[],"Renovar una identidad manteniendo la misma clave.",{"_3550":73681,"_30605":73571,"_21201":125294,"_5":14582,"_27821":125020,"_3006":125295},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3550":73682,"_30605":73571,"_21201":125297,"_5":14582,"_27821":125020,"_3006":125298},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3550":73683,"_30605":73571,"_21201":125300,"_5":14582,"_27821":125020,"_3006":125301},[],"**Organization (O)**: organización o empresa.",{"_3550":73684,"_30605":73571,"_21201":125303,"_5":14582,"_27821":125020,"_3006":125304},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3550":73685,"_30605":73571,"_21201":125306,"_5":14582,"_27821":125020,"_3006":125307},[],"**Country (C)**: código de país de dos letras.",{"_3550":73686,"_30605":73571,"_21201":125309,"_5":14582,"_27821":125020,"_3006":125310},[],"**State / Province (ST)**: estado o provincia.",{"_3550":73687,"_30605":73571,"_21201":125312,"_5":14582,"_27821":125020,"_3006":125313},[],"**Locality (L)**: ciudad o localidad.",{"_3550":73688,"_30605":73571,"_21201":125315,"_5":14582,"_27821":125020,"_3006":125316},[],"**Email Address**: correo de contacto.",{"_3550":73689,"_30605":73571,"_21201":125318,"_5":14582,"_27821":125020,"_3006":125319},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3550":73690,"_30605":73571,"_21201":125321,"_5":14582,"_27821":125020,"_3006":125322},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3550":73691,"_30605":73571,"_21201":125324,"_5":14582,"_27821":125024,"_3006":125325},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3550":73692,"_30605":73571,"_21201":125327,"_5":14582,"_27821":125024,"_3006":125328},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3550":73693,"_30605":73571,"_21201":125330,"_5":14582,"_27821":125028,"_3006":125331},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3550":73694,"_30605":73571,"_21201":125333,"_5":14582,"_27821":125028,"_3006":125334},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3550":73695,"_30605":73695,"_5":14934,"_3006":125336,"_30964":125337,"_21201":125338,"_27821":73695},"Validación online con OCSP",[49995,119453,55621,124092],[],{"_3550":73696,"_30605":73695,"_21201":125340,"_5":14582,"_27821":73695,"_3006":125341},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3550":73697,"_30605":73695,"_5":30961,"_21201":125343,"_27821":125344,"_3006":125345},[],"/docs/pr-preview/pr-66/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3550":73698,"_30605":73695,"_5":30961,"_21201":125347,"_27821":125348,"_3006":125349},[],"/docs/pr-preview/pr-66/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3550":73699,"_30605":73695,"_5":30961,"_21201":125351,"_27821":125352,"_3006":125353},[],"/docs/pr-preview/pr-66/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3550":73700,"_30605":73695,"_5":30961,"_21201":125355,"_27821":125356,"_3006":125357},[],"/docs/pr-preview/pr-66/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3550":73701,"_30605":73695,"_5":30961,"_21201":125359,"_27821":125360,"_3006":125361},[],"/docs/pr-preview/pr-66/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3550":73702,"_30605":73695,"_5":30961,"_21201":125363,"_27821":125364,"_3006":124655},[],"/docs/pr-preview/pr-66/es/platform/pki/ocsp#referencias",{"_3550":73703,"_30605":73695,"_21201":125366,"_5":14582,"_27821":73695,"_3006":125367},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3550":73704,"_30605":73695,"_21201":125369,"_5":14582,"_27821":125344,"_3006":125370},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3550":73705,"_30605":73695,"_21201":125372,"_5":14582,"_27821":125344,"_3006":125373},[],"Estado del registro",{"_3550":73706,"_30605":73695,"_21201":125375,"_5":14582,"_27821":125344,"_3006":125376},[],"Respuesta firmada",{"_3550":73707,"_30605":73695,"_21201":125378,"_5":14582,"_27821":125344,"_3006":54758},[],{"_3550":73708,"_30605":73695,"_21201":125380,"_5":14582,"_27821":125344,"_3006":57577},[],{"_3550":73709,"_30605":73695,"_21201":125382,"_5":14582,"_27821":125344,"_3006":54775},[],{"_3550":73710,"_30605":73695,"_21201":125384,"_5":14582,"_27821":125344,"_3006":125385},[],"`Revoked`, con razón y fecha de revocación.",{"_3550":73711,"_30605":73695,"_21201":125387,"_5":14582,"_27821":125344,"_3006":125388},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3550":73712,"_30605":73695,"_21201":125390,"_5":14582,"_27821":125344,"_3006":125391},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3550":73713,"_30605":73695,"_21201":125393,"_5":14582,"_27821":125344,"_3006":125394},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3550":73714,"_30605":73695,"_21201":125396,"_5":14582,"_27821":125344,"_3006":125397},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3550":73715,"_30605":73695,"_21201":125399,"_5":14582,"_27821":125344,"_3006":125400},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3550":73716,"_30605":73695,"_21201":125402,"_5":14582,"_27821":125348,"_3006":125403},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3550":73717,"_30605":73695,"_21201":125405,"_5":14582,"_27821":125348,"_3006":125406},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3550":73718,"_30605":73695,"_21201":125408,"_5":14582,"_27821":125352,"_3006":125409},[],"El servicio acepta:",{"_3550":73719,"_30605":73695,"_21201":125411,"_5":14582,"_27821":125352,"_3006":121304},[],{"_3550":73720,"_30605":73695,"_21201":125413,"_5":14582,"_27821":125352,"_3006":125414},[],"Ruta del servicio VA",{"_3550":73721,"_30605":73695,"_21201":125416,"_5":14582,"_27821":125352,"_3006":125417},[],"Formato",{"_3550":73722,"_30605":73695,"_21201":125419,"_5":14582,"_27821":125352,"_3006":57617},[],{"_3550":73723,"_30605":73695,"_21201":125421,"_5":14582,"_27821":125352,"_3006":57620},[],{"_3550":73724,"_30605":73695,"_21201":125423,"_5":14582,"_27821":125352,"_3006":125424},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3550":73725,"_30605":73695,"_21201":125426,"_5":14582,"_27821":125352,"_3006":57012},[],{"_3550":73726,"_30605":73695,"_21201":125428,"_5":14582,"_27821":125352,"_3006":57628},[],{"_3550":73727,"_30605":73695,"_21201":125430,"_5":14582,"_27821":125352,"_3006":125431},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3550":73728,"_30605":73695,"_21201":125433,"_5":14582,"_27821":125352,"_3006":125434},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3550":73729,"_30605":73695,"_21201":125436,"_5":14582,"_27821":125356,"_3006":125437},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3550":73730,"_30605":73695,"_21201":125439,"_5":14582,"_27821":125356,"_3006":125440},[],"Genera la solicitud:",{"_3550":73731,"_30605":73695,"_21201":125442,"_5":14582,"_27821":125356,"_3006":125443},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3550":73732,"_30605":73695,"_21201":125445,"_5":14582,"_27821":125356,"_3006":125446},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3550":73733,"_30605":73695,"_21201":125448,"_5":14582,"_27821":125356,"_3006":125449},[],"Verifica el DER recibido:",{"_3550":73734,"_30605":73695,"_21201":125451,"_5":14582,"_27821":125356,"_3006":125452},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3550":73735,"_30605":73695,"_21201":125454,"_5":14582,"_27821":125360,"_3006":125455},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3550":73736,"_30605":73695,"_21201":125457,"_5":14582,"_27821":125360,"_3006":125458},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3550":73737,"_30605":73695,"_21201":125460,"_5":14582,"_27821":125364,"_3006":57661},[],{"_3550":73738,"_30605":73695,"_21201":125462,"_5":14582,"_27821":125364,"_3006":57664},[],{"_3550":73739,"_30605":73695,"_21201":125464,"_5":14582,"_27821":125364,"_3006":125465},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3550":73740,"_30605":73695,"_21201":125467,"_5":14582,"_27821":125364,"_3006":124950},[],{"_3550":73741,"_30605":73741,"_5":14934,"_3006":55621,"_30964":125469,"_21201":125470,"_27821":73741},[49995,119453,55621],[],{"_3550":73742,"_30605":73741,"_21201":125472,"_5":14582,"_27821":73741,"_3006":125473},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3550":73743,"_30605":73741,"_5":30961,"_21201":125475,"_27821":125476,"_3006":122778},[],"/docs/pr-preview/pr-66/es/platform/pki/overview#empieza-aquí",{"_3550":73744,"_30605":73741,"_5":30961,"_21201":125478,"_27821":125479,"_3006":125480},[],"/docs/pr-preview/pr-66/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3550":73745,"_30605":73741,"_5":30961,"_21201":125482,"_27821":125483,"_3006":123298},[],"/docs/pr-preview/pr-66/es/platform/pki/overview#capacidades-principales",{"_3550":73746,"_30605":73741,"_5":30961,"_21201":125485,"_27821":125486,"_3006":123302},[],"/docs/pr-preview/pr-66/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3550":73747,"_30605":73741,"_5":30961,"_21201":125488,"_27821":125489,"_3006":123306},[],"/docs/pr-preview/pr-66/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3550":73748,"_30605":73741,"_5":30961,"_21201":125491,"_27821":125492,"_3006":123310},[],"/docs/pr-preview/pr-66/es/platform/pki/overview#emite-y-controla-certificados",{"_3550":73749,"_30605":73741,"_5":30961,"_21201":125494,"_27821":125495,"_3006":123318},[],"/docs/pr-preview/pr-66/es/platform/pki/overview#publica-el-estado-de-validación",{"_3550":73750,"_30605":73741,"_5":30961,"_21201":125497,"_27821":125498,"_3006":125499},[],"/docs/pr-preview/pr-66/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3550":73751,"_30605":73741,"_5":30961,"_21201":125501,"_27821":125502,"_3006":124258},[],"/docs/pr-preview/pr-66/es/platform/pki/overview#continúa",{"_3550":73752,"_30605":73741,"_21201":125504,"_5":14582,"_27821":73741,"_3006":125505},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3550":73753,"_30605":73741,"_21201":125507,"_5":14582,"_27821":125476,"_3006":125508},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3550":73754,"_30605":73741,"_21201":125510,"_5":14582,"_27821":125476,"_3006":125511},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3550":73755,"_30605":73741,"_21201":125513,"_5":14582,"_27821":125479,"_3006":125514},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3550":73756,"_30605":73741,"_21201":125516,"_5":14582,"_27821":125479,"_3006":125517},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3550":73757,"_30605":73741,"_21201":125519,"_5":14582,"_27821":125479,"_3006":125520},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3550":73758,"_30605":73741,"_21201":125522,"_5":14582,"_27821":125479,"_3006":125523},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3550":73759,"_30605":73741,"_21201":125525,"_5":14582,"_27821":125479,"_3006":125526},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3550":73760,"_30605":73741,"_21201":125528,"_5":14582,"_27821":125486,"_3006":125529},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3550":73761,"_30605":73741,"_21201":125531,"_5":14582,"_27821":125489,"_3006":125532},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3550":73762,"_30605":73741,"_21201":125534,"_5":14582,"_27821":125492,"_3006":125535},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3550":73763,"_30605":73741,"_21201":125537,"_5":14582,"_27821":125495,"_3006":125538},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3550":73764,"_30605":73741,"_21201":125540,"_5":14582,"_27821":125498,"_3006":125541},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3550":73765,"_30605":73741,"_21201":125543,"_5":14582,"_27821":125498,"_3006":125544},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3550":73766,"_30605":73741,"_21201":125546,"_5":14582,"_27821":125498,"_3006":125547},[],"su clave pública corresponda a la clave privada del cliente;",{"_3550":73767,"_30605":73741,"_21201":125549,"_5":14582,"_27821":125498,"_3006":125550},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3550":73768,"_30605":73741,"_21201":125552,"_5":14582,"_27821":125498,"_3006":125553},[],"sus fechas y usos permitan la operación;",{"_3550":73769,"_30605":73741,"_21201":125555,"_5":14582,"_27821":125498,"_3006":125556},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3550":73770,"_30605":73741,"_21201":125558,"_5":14582,"_27821":125498,"_3006":125559},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3550":73771,"_30605":73741,"_21201":125561,"_5":14582,"_27821":125502,"_3006":125562},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3550":73772,"_30605":73741,"_21201":125564,"_5":14582,"_27821":125502,"_3006":125565},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3550":73773,"_30605":73741,"_21201":125567,"_5":14582,"_27821":125502,"_3006":125568},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3550":73774,"_30605":73774,"_5":14934,"_3006":125570,"_30964":125571,"_21201":125572,"_27821":73774},"Crea tu primera CA",[49995,119453,55621,122902],[],{"_3550":73775,"_30605":73774,"_21201":125574,"_5":14582,"_27821":73774,"_3006":125575},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3550":73776,"_30605":73774,"_5":30961,"_21201":125577,"_27821":125578,"_3006":118024},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3550":73777,"_30605":73774,"_5":30961,"_21201":125580,"_27821":125581,"_3006":125582},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3550":73778,"_30605":73774,"_5":30961,"_21201":125584,"_27821":125585,"_3006":125586},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3550":73779,"_30605":73774,"_5":30961,"_21201":125588,"_27821":125589,"_3006":125590},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3550":73780,"_30605":73774,"_5":30961,"_21201":125592,"_27821":125593,"_3006":125594},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3550":73781,"_30605":73774,"_5":30961,"_21201":125596,"_27821":125597,"_3006":125598},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3550":73782,"_30605":73774,"_5":30961,"_21201":125600,"_27821":125601,"_3006":125602},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3550":73783,"_30605":73774,"_5":30961,"_21201":125604,"_27821":125605,"_3006":123149},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3550":73784,"_30605":73774,"_5":30961,"_21201":125607,"_27821":125608,"_3006":118048},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3550":73785,"_30605":73774,"_21201":125610,"_5":14582,"_27821":73774,"_3006":125611},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3550":73786,"_30605":73774,"_21201":125613,"_5":14582,"_27821":125578,"_3006":125614},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3550":73787,"_30605":73774,"_21201":125616,"_5":14582,"_27821":125578,"_3006":125617},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3550":73788,"_30605":73774,"_21201":125619,"_5":14582,"_27821":125578,"_3006":125620},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3550":73789,"_30605":73774,"_21201":125622,"_5":14582,"_27821":125578,"_3006":125623},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3550":73790,"_30605":73774,"_21201":125625,"_5":14582,"_27821":125581,"_3006":125626},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3550":73791,"_30605":73774,"_21201":125628,"_5":14582,"_27821":125581,"_3006":125629},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3550":73792,"_30605":73774,"_21201":125631,"_5":14582,"_27821":125585,"_3006":125632},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3550":73793,"_30605":73774,"_21201":125634,"_5":14582,"_27821":125585,"_3006":125635},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3550":73794,"_30605":73774,"_21201":125637,"_5":14582,"_27821":125589,"_3006":125638},[],"Selecciona **Root CA** y completa:",{"_3550":73795,"_30605":73774,"_21201":125640,"_5":14582,"_27821":125589,"_3006":57843},[],{"_3550":73796,"_30605":73774,"_21201":125642,"_5":14582,"_27821":125589,"_3006":125643},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3550":73797,"_30605":73774,"_21201":125645,"_5":14582,"_27821":125589,"_3006":125646},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3550":73798,"_30605":73774,"_21201":125648,"_5":14582,"_27821":125589,"_3006":125649},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3550":73799,"_30605":73774,"_21201":125651,"_5":14582,"_27821":125589,"_3006":125652},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3550":73800,"_30605":73774,"_21201":125654,"_5":14582,"_27821":125593,"_3006":125655},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3550":73801,"_30605":73774,"_21201":125657,"_5":14582,"_27821":125597,"_3006":125658},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3550":73802,"_30605":73774,"_21201":125660,"_5":14582,"_27821":125597,"_3006":125661},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3550":73803,"_30605":73774,"_21201":125663,"_5":14582,"_27821":125601,"_3006":125664},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3550":73804,"_30605":73774,"_21201":125666,"_5":14582,"_27821":125601,"_3006":125667},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3550":73805,"_30605":73774,"_21201":125669,"_5":14582,"_27821":125601,"_3006":125670},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3550":73806,"_30605":73774,"_21201":125672,"_5":14582,"_27821":125605,"_3006":125673},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3550":73807,"_30605":73774,"_21201":125675,"_5":14582,"_27821":125605,"_3006":125676},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3550":73808,"_30605":73774,"_21201":125678,"_5":14582,"_27821":125605,"_3006":125679},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3550":73809,"_30605":73774,"_21201":125681,"_5":14582,"_27821":125605,"_3006":125682},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3550":73810,"_30605":73774,"_21201":125684,"_5":14582,"_27821":125608,"_3006":125685},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3550":73811,"_30605":73811,"_5":14934,"_3006":125687,"_30964":125688,"_21201":125689,"_27821":73811},"Emite y verifica un certificado",[49995,119453,55621,122902],[],{"_3550":73812,"_30605":73811,"_21201":125691,"_5":14582,"_27821":73811,"_3006":125692},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3550":73813,"_30605":73811,"_5":30961,"_21201":125694,"_27821":125695,"_3006":118024},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3550":73814,"_30605":73811,"_5":30961,"_21201":125697,"_27821":125698,"_3006":125699},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3550":73815,"_30605":73811,"_5":30961,"_21201":125701,"_27821":125702,"_3006":125703},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3550":73816,"_30605":73811,"_5":30961,"_21201":125705,"_27821":125706,"_3006":125707},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3550":73817,"_30605":73811,"_5":30961,"_21201":125709,"_27821":125710,"_3006":125711},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3550":73818,"_30605":73811,"_5":30961,"_21201":125713,"_27821":125714,"_3006":125715},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3550":73819,"_30605":73811,"_5":30961,"_21201":125717,"_27821":125718,"_3006":125719},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3550":73820,"_30605":73811,"_5":30961,"_21201":125721,"_27821":125722,"_3006":125723},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3550":73821,"_30605":73811,"_5":30961,"_21201":125725,"_27821":125726,"_3006":125727},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3550":73822,"_30605":73811,"_5":30961,"_21201":125729,"_27821":125730,"_3006":125731},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3550":73823,"_30605":73811,"_5":30961,"_21201":125733,"_27821":125734,"_3006":123149},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3550":73824,"_30605":73811,"_5":30961,"_21201":125736,"_27821":125737,"_3006":118048},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3550":73825,"_30605":73811,"_21201":125739,"_5":14582,"_27821":73811,"_3006":125740},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3550":73826,"_30605":73811,"_21201":125742,"_5":14582,"_27821":125695,"_3006":125743},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3550":73827,"_30605":73811,"_21201":125745,"_5":14582,"_27821":125695,"_3006":125746},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3550":73828,"_30605":73811,"_21201":125748,"_5":14582,"_27821":125695,"_3006":125749},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3550":73829,"_30605":73811,"_21201":125751,"_5":14582,"_27821":125695,"_3006":125752},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3550":73830,"_30605":73811,"_21201":125754,"_5":14582,"_27821":125695,"_3006":125755},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3550":73831,"_30605":73811,"_21201":125757,"_5":14582,"_27821":125698,"_3006":125758},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3550":73832,"_30605":73811,"_21201":125760,"_5":14582,"_27821":125702,"_3006":125761},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3550":73833,"_30605":73811,"_21201":125763,"_5":14582,"_27821":125702,"_3006":125764},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3550":73834,"_30605":73811,"_21201":125766,"_5":14582,"_27821":125706,"_3006":125767},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3550":73835,"_30605":73811,"_21201":125769,"_5":14582,"_27821":125706,"_3006":125770},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3550":73836,"_30605":73811,"_21201":125772,"_5":14582,"_27821":125710,"_3006":125773},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3550":73837,"_30605":73811,"_21201":125775,"_5":14582,"_27821":125710,"_3006":125776},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3550":73838,"_30605":73811,"_21201":125778,"_5":14582,"_27821":125714,"_3006":125779},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3550":73839,"_30605":73811,"_21201":125781,"_5":14582,"_27821":125718,"_3006":125782},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3550":73840,"_30605":73811,"_21201":125784,"_5":14582,"_27821":125722,"_3006":125785},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3550":73841,"_30605":73811,"_21201":125787,"_5":14582,"_27821":125726,"_3006":125788},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3550":73842,"_30605":73811,"_21201":125790,"_5":14582,"_27821":125726,"_3006":125791},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3550":73843,"_30605":73811,"_21201":125793,"_5":14582,"_27821":125726,"_3006":125794},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3550":73844,"_30605":73811,"_21201":125796,"_5":14582,"_27821":125730,"_3006":125797},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3550":73845,"_30605":73811,"_21201":125799,"_5":14582,"_27821":125730,"_3006":125800},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3550":73846,"_30605":73811,"_21201":125802,"_5":14582,"_27821":125730,"_3006":125803},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3550":73847,"_30605":73811,"_21201":125805,"_5":14582,"_27821":125734,"_3006":123232},[],{"_3550":73848,"_30605":73811,"_21201":125807,"_5":14582,"_27821":125734,"_3006":121753},[],{"_3550":73849,"_30605":73811,"_21201":125809,"_5":14582,"_27821":125734,"_3006":125810},[],"La CA rechaza la emisión",{"_3550":73850,"_30605":73811,"_21201":125812,"_5":14582,"_27821":125734,"_3006":125813},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3550":73851,"_30605":73811,"_21201":125815,"_5":14582,"_27821":125734,"_3006":125816},[],"Sujeto o usos diferentes",{"_3550":73852,"_30605":73811,"_21201":125818,"_5":14582,"_27821":125734,"_3006":125819},[],"Perfil aplicado y valores solicitados.",{"_3550":73853,"_30605":73811,"_21201":125821,"_5":14582,"_27821":125734,"_3006":125822},[],"No se encuentra el emisor",{"_3550":73854,"_30605":73811,"_21201":125824,"_5":14582,"_27821":125734,"_3006":125825},[],"CA descargada y cadena intermedia necesaria.",{"_3550":73855,"_30605":73811,"_21201":125827,"_5":14582,"_27821":125734,"_3006":125828},[],"Falla la vigencia",{"_3550":73856,"_30605":73811,"_21201":125830,"_5":14582,"_27821":125734,"_3006":125831},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3550":73857,"_30605":73811,"_21201":125833,"_5":14582,"_27821":125734,"_3006":125834},[],"Los resúmenes de clave difieren",{"_3550":73858,"_30605":73811,"_21201":125836,"_5":14582,"_27821":125734,"_3006":125837},[],"Archivos de certificado y clave de la misma emisión.",{"_3550":73859,"_30605":73811,"_21201":125839,"_5":14582,"_27821":125734,"_3006":125840},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3550":73860,"_30605":73811,"_21201":125842,"_5":14582,"_27821":125737,"_3006":125843},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3550":73861,"_30605":73811,"_21201":125845,"_5":14582,"_27821":125737,"_3006":125846},[],"Gestionar certificados para inspección, estado y revocación.",{"_3550":73862,"_30605":73811,"_21201":125848,"_5":14582,"_27821":125737,"_3006":125849},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3550":73863,"_30605":73811,"_21201":125851,"_5":14582,"_27821":125737,"_3006":125852},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3550":73864,"_30605":73811,"_21201":125854,"_5":14582,"_27821":125737,"_3006":125855},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3550":73865,"_30605":73865,"_5":14934,"_3006":125857,"_30964":125858,"_21201":125859,"_27821":73865},"Primeros pasos de PKI",[49995,119453,55621,122902],[],{"_3550":73866,"_30605":73865,"_21201":125861,"_5":14582,"_27821":73865,"_3006":125862},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3550":73867,"_30605":73865,"_5":30961,"_21201":125864,"_27821":125865,"_3006":118024},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3550":73868,"_30605":73865,"_5":30961,"_21201":125867,"_27821":125868,"_3006":125869},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3550":73869,"_30605":73865,"_5":30961,"_21201":125871,"_27821":125872,"_3006":123084},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3550":73870,"_30605":73865,"_5":30961,"_21201":125874,"_27821":125875,"_3006":125876},[],"/docs/pr-preview/pr-66/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3550":73871,"_30605":73865,"_21201":125878,"_5":14582,"_27821":73865,"_3006":125879},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3550":73872,"_30605":73865,"_21201":125881,"_5":14582,"_27821":125865,"_3006":125882},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3550":73873,"_30605":73865,"_21201":125884,"_5":14582,"_27821":125865,"_3006":125885},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3550":73874,"_30605":73865,"_21201":125887,"_5":14582,"_27821":125865,"_3006":125888},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3550":73875,"_30605":73865,"_21201":125890,"_5":14582,"_27821":125865,"_3006":125891},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3550":73876,"_30605":73865,"_21201":125893,"_5":14582,"_27821":125865,"_3006":125894},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3550":73877,"_30605":73865,"_21201":125896,"_5":14582,"_27821":125868,"_3006":125897},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3550":73878,"_30605":73865,"_21201":125899,"_5":14582,"_27821":125868,"_3006":125900},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3550":73879,"_30605":73865,"_21201":125902,"_5":14582,"_27821":125868,"_3006":125903},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3550":73880,"_30605":73865,"_21201":125905,"_5":14582,"_27821":125868,"_3006":125906},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3550":73881,"_30605":73865,"_21201":125908,"_5":14582,"_27821":125872,"_3006":125909},[],"Archivo o recurso",{"_3550":73882,"_30605":73865,"_21201":125911,"_5":14582,"_27821":125872,"_3006":123081},[],{"_3550":73883,"_30605":73865,"_21201":125913,"_5":14582,"_27821":125872,"_3006":125914},[],"CA raíz activa y `ca.pem`",{"_3550":73884,"_30605":73865,"_21201":125916,"_5":14582,"_27821":125872,"_3006":125917},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3550":73885,"_30605":73865,"_21201":125919,"_5":14582,"_27821":125872,"_3006":125920},[],"Certificado final y `device.crt`",{"_3550":73886,"_30605":73865,"_21201":125922,"_5":14582,"_27821":125872,"_3006":125923},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3550":73887,"_30605":73865,"_21201":125925,"_5":14582,"_27821":125872,"_3006":125926},[],"Clave privada `device.key`",{"_3550":73888,"_30605":73865,"_21201":125928,"_5":14582,"_27821":125872,"_3006":125929},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3550":73889,"_30605":73865,"_21201":125931,"_5":14582,"_27821":125872,"_3006":125932},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3550":73890,"_30605":73865,"_21201":125934,"_5":14582,"_27821":125875,"_3006":125935},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3550":73891,"_30605":73865,"_21201":125937,"_5":14582,"_27821":125875,"_3006":125938},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3550":73892,"_30605":73865,"_21201":125940,"_5":14582,"_27821":125875,"_3006":125941},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3550":73893,"_30605":73893,"_5":14934,"_3006":125943,"_30964":125944,"_21201":125946,"_27821":73893},"Resolución de problemas PKI",[49995,119453,55621,125945],"Resolución de problemas",[],{"_3550":73894,"_30605":73893,"_21201":125948,"_5":14582,"_27821":73893,"_3006":125949},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3550":73895,"_30605":73893,"_5":30961,"_21201":125951,"_27821":125952,"_3006":125953},[],"/docs/pr-preview/pr-66/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3550":73896,"_30605":73893,"_5":30961,"_21201":125955,"_27821":125956,"_3006":125957},[],"/docs/pr-preview/pr-66/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3550":73897,"_30605":73893,"_5":30961,"_21201":125959,"_27821":125960,"_3006":125961},[],"/docs/pr-preview/pr-66/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3550":73898,"_30605":73893,"_21201":125963,"_5":14582,"_27821":73893,"_3006":125964},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3550":73899,"_30605":73893,"_21201":125966,"_5":14582,"_27821":73893,"_3006":125967},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3550":73900,"_30605":73893,"_21201":125969,"_5":14582,"_27821":125952,"_3006":123081},[],{"_3550":73901,"_30605":73893,"_21201":125971,"_5":14582,"_27821":125952,"_3006":121753},[],{"_3550":73902,"_30605":73893,"_21201":125973,"_5":14582,"_27821":125952,"_3006":118048},[],{"_3550":73903,"_30605":73893,"_21201":125975,"_5":14582,"_27821":125952,"_3006":54463},[],{"_3550":73904,"_30605":73893,"_21201":125977,"_5":14582,"_27821":125952,"_3006":125978},[],"Existe, está activa y sus fechas son utilizables.",{"_3550":73905,"_30605":73893,"_21201":125980,"_5":14582,"_27821":125952,"_3006":125981},[],"Autoridades.",{"_3550":73906,"_30605":73893,"_21201":125983,"_5":14582,"_27821":125952,"_3006":125984},[],"Clave",{"_3550":73907,"_30605":73893,"_21201":125986,"_5":14582,"_27821":125952,"_3006":125987},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3550":73908,"_30605":73893,"_21201":125989,"_5":14582,"_27821":125952,"_3006":125990},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3550":73909,"_30605":73893,"_21201":125992,"_5":14582,"_27821":125952,"_3006":58197},[],{"_3550":73910,"_30605":73893,"_21201":125994,"_5":14582,"_27821":125952,"_3006":125995},[],"PEM correcto y firma verificable.",{"_3550":73911,"_30605":73893,"_21201":125997,"_5":14582,"_27821":125952,"_3006":58203},[],{"_3550":73912,"_30605":73893,"_21201":125999,"_5":14582,"_27821":125952,"_3006":126000},[],"Perfil",{"_3550":73913,"_30605":73893,"_21201":126002,"_5":14582,"_27821":125952,"_3006":126003},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3550":73914,"_30605":73893,"_21201":126005,"_5":14582,"_27821":125952,"_3006":126006},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3550":73915,"_30605":73893,"_21201":126008,"_5":14582,"_27821":125952,"_3006":123232},[],{"_3550":73916,"_30605":73893,"_21201":126010,"_5":14582,"_27821":125952,"_3006":126011},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3550":73917,"_30605":73893,"_21201":126013,"_5":14582,"_27821":125952,"_3006":126014},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3550":73918,"_30605":73893,"_21201":126016,"_5":14582,"_27821":125952,"_3006":126017},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3550":73919,"_30605":73893,"_21201":126019,"_5":14582,"_27821":125952,"_3006":126020},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3550":73920,"_30605":73893,"_21201":126022,"_5":14582,"_27821":125956,"_3006":126023},[],"Revisa cada frontera por separado:",{"_3550":73921,"_30605":73893,"_21201":126025,"_5":14582,"_27821":125956,"_3006":126026},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3550":73922,"_30605":73893,"_21201":126028,"_5":14582,"_27821":125956,"_3006":126029},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3550":73923,"_30605":73893,"_21201":126031,"_5":14582,"_27821":125956,"_3006":126032},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3550":73924,"_30605":73893,"_21201":126034,"_5":14582,"_27821":125956,"_3006":126035},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3550":73925,"_30605":73893,"_21201":126037,"_5":14582,"_27821":125956,"_3006":126038},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3550":73926,"_30605":73893,"_21201":126040,"_5":14582,"_27821":125956,"_3006":126041},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3550":73927,"_30605":73893,"_21201":126043,"_5":14582,"_27821":125960,"_3006":126044},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3550":73928,"_30605":73893,"_21201":126046,"_5":14582,"_27821":125960,"_3006":126047},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3550":73929,"_30605":73929,"_5":14934,"_3006":126049,"_30964":126050,"_21201":126051,"_27821":73929},"Seguridad",[49995],[],{"_3550":73930,"_30605":73929,"_21201":126053,"_5":14582,"_27821":73929,"_3006":126054},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3550":73931,"_30605":73929,"_5":30961,"_21201":126056,"_27821":126057,"_3006":126058},[],"/docs/pr-preview/pr-66/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3550":73932,"_30605":73929,"_5":30961,"_21201":126060,"_27821":126061,"_3006":126062},[],"/docs/pr-preview/pr-66/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3550":73933,"_30605":73929,"_5":30961,"_21201":126064,"_27821":126065,"_3006":126066},[],"/docs/pr-preview/pr-66/es/security#versiones-soportadas","Versiones soportadas",{"_3550":73934,"_30605":73929,"_5":30961,"_21201":126068,"_27821":126069,"_3006":126070},[],"/docs/pr-preview/pr-66/es/security#divulgación-responsable","Divulgación responsable",{"_3550":73935,"_30605":73929,"_21201":126072,"_5":14582,"_27821":73929,"_3006":126073},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3550":73936,"_30605":73929,"_21201":126075,"_5":14582,"_27821":126057,"_3006":126076},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3550":73937,"_30605":73929,"_21201":126078,"_5":14582,"_27821":126057,"_3006":126079},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3550":73938,"_30605":73929,"_21201":126081,"_5":14582,"_27821":126057,"_3006":15201},[],{"_3550":73939,"_30605":73929,"_21201":126083,"_5":14582,"_27821":126057,"_3006":15141},[],{"_3550":73940,"_30605":73929,"_21201":126085,"_5":14582,"_27821":126057,"_3006":15188},[],{"_3550":73941,"_30605":73929,"_21201":126087,"_5":14582,"_27821":126057,"_3006":126088},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3550":73942,"_30605":73929,"_21201":126090,"_5":14582,"_27821":126057,"_3006":126091},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3550":73943,"_30605":73929,"_21201":126093,"_5":14582,"_27821":126061,"_3006":126094},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3550":73944,"_30605":73929,"_21201":126096,"_5":14582,"_27821":126061,"_3006":126097},[],"No incluyas en el reporte:",{"_3550":73945,"_30605":73929,"_21201":126099,"_5":14582,"_27821":126061,"_3006":126100},[],"Credenciales, tokens o claves privadas",{"_3550":73946,"_30605":73929,"_21201":126102,"_5":14582,"_27821":126061,"_3006":126103},[],"Datos de clientes o información identificable de clientes",{"_3550":73947,"_30605":73929,"_21201":126105,"_5":14582,"_27821":126061,"_3006":126106},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3550":73948,"_30605":73929,"_21201":126108,"_5":14582,"_27821":126065,"_3006":126109},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3550":73949,"_30605":73929,"_21201":126111,"_5":14582,"_27821":126065,"_3006":126112},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3550":73950,"_30605":73929,"_21201":126114,"_5":14582,"_27821":126069,"_3006":126115},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3550":73951,"_30605":73929,"_21201":126117,"_5":14582,"_27821":126069,"_3006":126118},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3550":73952,"_30605":73929,"_21201":126120,"_5":14582,"_27821":126069,"_3006":126121},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3550":73953,"_30605":73929,"_21201":126123,"_5":14582,"_27821":126069,"_3006":126124},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3550":73954,"_30605":73929,"_21201":126126,"_5":14582,"_27821":126069,"_3006":126127},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3550":73955,"_30605":73955,"_5":14934,"_3006":126129,"_30964":126130,"_21201":126132,"_27821":73955},"3.8.0 a 4.0.0",[49995,126131],"Actualizaciones",[],{"_3550":73956,"_30605":73955,"_21201":126134,"_5":14582,"_27821":73955,"_3006":126135},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3550":73957,"_30605":73955,"_5":30961,"_21201":126137,"_27821":126138,"_3006":126139},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3550":73958,"_30605":73955,"_5":30961,"_21201":126141,"_27821":126142,"_3006":126143},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3550":73959,"_30605":73955,"_5":30961,"_21201":126145,"_27821":126146,"_3006":126147},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3550":73960,"_30605":73955,"_5":30961,"_21201":126149,"_27821":126150,"_3006":126151},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3550":73961,"_30605":73955,"_5":30961,"_21201":126153,"_27821":126154,"_3006":126155},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3550":73962,"_30605":73955,"_5":30961,"_21201":126157,"_27821":126158,"_3006":126159},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3550":73963,"_30605":73955,"_5":30961,"_21201":126161,"_27821":126162,"_3006":58369},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3550":73964,"_30605":73955,"_5":30961,"_21201":126164,"_27821":126165,"_3006":126166},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3550":73965,"_30605":73955,"_5":30961,"_21201":126168,"_27821":126169,"_3006":126170},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3550":73966,"_30605":73955,"_5":30961,"_21201":126172,"_27821":126173,"_3006":126174},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3550":73967,"_30605":73955,"_5":30961,"_21201":126176,"_27821":126177,"_3006":126178},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3550":73968,"_30605":73955,"_5":30961,"_21201":126180,"_27821":126181,"_3006":126182},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3550":73969,"_30605":73955,"_5":30961,"_21201":126184,"_27821":126185,"_3006":126186},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3550":73970,"_30605":73955,"_5":30961,"_21201":126188,"_27821":126189,"_3006":126190},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3550":73971,"_30605":73955,"_5":30961,"_21201":126192,"_27821":126193,"_3006":126194},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3550":73972,"_30605":73955,"_5":30961,"_21201":126196,"_27821":126197,"_3006":126198},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3550":73973,"_30605":73955,"_5":30961,"_21201":126200,"_27821":126201,"_3006":126202},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3550":73974,"_30605":73955,"_5":30961,"_21201":126204,"_27821":126205,"_3006":126206},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3550":73975,"_30605":73955,"_5":30961,"_21201":126208,"_27821":126209,"_3006":126210},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3550":73976,"_30605":73955,"_5":30961,"_21201":126212,"_27821":126213,"_3006":126214},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3550":73977,"_30605":73955,"_5":30961,"_21201":126216,"_27821":126217,"_3006":126218},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3550":73978,"_30605":73955,"_5":30961,"_21201":126220,"_27821":126221,"_3006":126222},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3550":73979,"_30605":73955,"_5":30961,"_21201":126224,"_27821":126225,"_3006":126226},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3550":73980,"_30605":73955,"_5":30961,"_21201":126228,"_27821":126229,"_3006":126230},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3550":73981,"_30605":73955,"_5":30961,"_21201":126232,"_27821":126233,"_3006":126234},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3550":73982,"_30605":73955,"_5":30961,"_21201":126236,"_27821":126237,"_3006":126238},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3550":73983,"_30605":73955,"_5":30961,"_21201":126240,"_27821":126241,"_3006":126242},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3550":73984,"_30605":73955,"_5":30961,"_21201":126244,"_27821":126245,"_3006":126246},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3550":73985,"_30605":73955,"_5":30961,"_21201":126248,"_27821":126249,"_3006":126250},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3550":73986,"_30605":73955,"_5":30961,"_21201":126252,"_27821":126253,"_3006":126254},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3550":73987,"_30605":73955,"_5":30961,"_21201":126256,"_27821":126257,"_3006":126258},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3550":73988,"_30605":73955,"_5":30961,"_21201":126260,"_27821":126261,"_3006":126262},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3550":73989,"_30605":73955,"_5":30961,"_21201":126264,"_27821":126265,"_3006":126266},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3550":73990,"_30605":73955,"_5":30961,"_21201":126268,"_27821":126269,"_3006":126270},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3550":73991,"_30605":73955,"_5":30961,"_21201":126272,"_27821":126273,"_3006":126274},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3550":73992,"_30605":73955,"_5":30961,"_21201":126276,"_27821":126277,"_3006":126278},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3550":73993,"_30605":73955,"_5":30961,"_21201":126280,"_27821":126281,"_3006":126282},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3550":73994,"_30605":73955,"_5":30961,"_21201":126284,"_27821":126285,"_3006":126286},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3550":73995,"_30605":73955,"_5":30961,"_21201":126288,"_27821":126289,"_3006":126290},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3550":73996,"_30605":73955,"_5":30961,"_21201":126292,"_27821":126293,"_3006":126294},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3550":73997,"_30605":73955,"_5":30961,"_21201":126296,"_27821":126297,"_3006":122095},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3550":73998,"_30605":73955,"_5":30961,"_21201":126299,"_27821":126300,"_3006":126301},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3550":73999,"_30605":73955,"_5":30961,"_21201":126303,"_27821":126304,"_3006":126305},[],"/docs/pr-preview/pr-66/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3550":74000,"_30605":73955,"_21201":126307,"_5":14582,"_27821":73955,"_3006":126308},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3550":74001,"_30605":73955,"_21201":126310,"_5":14582,"_27821":73955,"_3006":126311},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3550":74002,"_30605":73955,"_21201":126313,"_5":14582,"_27821":73955,"_3006":126314},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3550":74003,"_30605":73955,"_21201":126316,"_5":14582,"_27821":73955,"_3006":126317},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3550":74004,"_30605":73955,"_21201":126319,"_5":14582,"_27821":73955,"_3006":126320},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3550":74005,"_30605":73955,"_21201":126322,"_5":14582,"_27821":73955,"_3006":126323},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3550":74006,"_30605":73955,"_21201":126325,"_5":14582,"_27821":73955,"_3006":126326},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3550":74007,"_30605":73955,"_21201":126328,"_5":14582,"_27821":126142,"_3006":126329},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3550":74008,"_30605":73955,"_21201":126331,"_5":14582,"_27821":126142,"_3006":126332},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3550":74009,"_30605":73955,"_21201":126334,"_5":14582,"_27821":126146,"_3006":126335},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3550":74010,"_30605":73955,"_21201":126337,"_5":14582,"_27821":126146,"_3006":126338},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3550":74011,"_30605":73955,"_21201":126340,"_5":14582,"_27821":126150,"_3006":126341},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3550":74012,"_30605":73955,"_21201":126343,"_5":14582,"_27821":126154,"_3006":126344},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3550":74013,"_30605":73955,"_21201":126346,"_5":14582,"_27821":126154,"_3006":126347},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3550":74014,"_30605":73955,"_21201":126349,"_5":14582,"_27821":126154,"_3006":126350},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3550":74015,"_30605":73955,"_21201":126352,"_5":14582,"_27821":126154,"_3006":126353},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3550":74016,"_30605":73955,"_21201":126355,"_5":14582,"_27821":126154,"_3006":126356},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3550":74017,"_30605":73955,"_21201":126358,"_5":14582,"_27821":126158,"_3006":126359},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3550":74018,"_30605":73955,"_21201":126361,"_5":14582,"_27821":126158,"_3006":126362},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3550":74019,"_30605":73955,"_21201":126364,"_5":14582,"_27821":126158,"_3006":126365},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3550":74020,"_30605":73955,"_21201":126367,"_5":14582,"_27821":126158,"_3006":126368},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3550":74021,"_30605":73955,"_21201":126370,"_5":14582,"_27821":126158,"_3006":126371},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3550":74022,"_30605":73955,"_21201":126373,"_5":14582,"_27821":126158,"_3006":126374},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3550":74023,"_30605":73955,"_21201":126376,"_5":14582,"_27821":126162,"_3006":126377},[],"Cambio",{"_3550":74024,"_30605":73955,"_21201":126379,"_5":14582,"_27821":126162,"_3006":126380},[],"A quién afecta",{"_3550":74025,"_30605":73955,"_21201":126382,"_5":14582,"_27821":126162,"_3006":126383},[],"Gravedad",{"_3550":74026,"_30605":73955,"_21201":126385,"_5":14582,"_27821":126162,"_3006":124874},[],{"_3550":74027,"_30605":73955,"_21201":126387,"_5":14582,"_27821":126162,"_3006":126170},[],{"_3550":74028,"_30605":73955,"_21201":126389,"_5":14582,"_27821":126162,"_3006":126390},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3550":74029,"_30605":73955,"_21201":126392,"_5":14582,"_27821":126162,"_3006":126393},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3550":74030,"_30605":73955,"_21201":126395,"_5":14582,"_27821":126162,"_3006":126396},[],"Copiar los datos a los volúmenes nuevos",{"_3550":74031,"_30605":73955,"_21201":126398,"_5":14582,"_27821":126162,"_3006":126174},[],{"_3550":74032,"_30605":73955,"_21201":126400,"_5":14582,"_27821":126162,"_3006":126401},[],"Todas las releases de Helm",{"_3550":74033,"_30605":73955,"_21201":126403,"_5":14582,"_27821":126162,"_3006":126404},[],"Alta: `helm upgrade` falla",{"_3550":74034,"_30605":73955,"_21201":126406,"_5":14582,"_27821":126162,"_3006":126407},[],"Eliminar o renombrar las claves heredadas",{"_3550":74035,"_30605":73955,"_21201":126409,"_5":14582,"_27821":126162,"_3006":126178},[],{"_3550":74036,"_30605":73955,"_21201":126411,"_5":14582,"_27821":126162,"_3006":126412},[],"Todos los despliegues",{"_3550":74037,"_30605":73955,"_21201":126414,"_5":14582,"_27821":126162,"_3006":126415},[],"Alta: sin principal de bootstrap no hay administrador",{"_3550":74038,"_30605":73955,"_21201":126417,"_5":14582,"_27821":126162,"_3006":126418},[],"Configurar `services.authz`",{"_3550":74039,"_30605":73955,"_21201":126420,"_5":14582,"_27821":126162,"_3006":126182},[],{"_3550":74040,"_30605":73955,"_21201":126422,"_5":14582,"_27821":126162,"_3006":126401},[],{"_3550":74041,"_30605":73955,"_21201":126424,"_5":14582,"_27821":126162,"_3006":126425},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3550":74042,"_30605":73955,"_21201":126427,"_5":14582,"_27821":126162,"_3006":126428},[],"Mover JWKS y roles a `services.authz`",{"_3550":74043,"_30605":73955,"_21201":126430,"_5":14582,"_27821":126162,"_3006":126202},[],{"_3550":74044,"_30605":73955,"_21201":126432,"_5":14582,"_27821":126162,"_3006":126433},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3550":74045,"_30605":73955,"_21201":126435,"_5":14582,"_27821":126162,"_3006":126436},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3550":74046,"_30605":73955,"_21201":126438,"_5":14582,"_27821":126162,"_3006":126439},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3550":74047,"_30605":73955,"_21201":126441,"_5":14582,"_27821":126162,"_3006":126206},[],{"_3550":74048,"_30605":73955,"_21201":126443,"_5":14582,"_27821":126162,"_3006":126444},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3550":74049,"_30605":73955,"_21201":126446,"_5":14582,"_27821":126162,"_3006":126447},[],"Alta: el backend ya no arranca con ellos",{"_3550":74050,"_30605":73955,"_21201":126449,"_5":14582,"_27821":126162,"_3006":126450},[],"Pasar a PostgreSQL antes de actualizar",{"_3550":74051,"_30605":73955,"_21201":126452,"_5":14582,"_27821":126162,"_3006":126250},[],{"_3550":74052,"_30605":73955,"_21201":126454,"_5":14582,"_27821":126162,"_3006":126455},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3550":74053,"_30605":73955,"_21201":126457,"_5":14582,"_27821":126162,"_3006":126458},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3550":74054,"_30605":73955,"_21201":126460,"_5":14582,"_27821":126162,"_3006":126461},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3550":74055,"_30605":73955,"_21201":126463,"_5":14582,"_27821":126162,"_3006":126464},[],"Webhooks con referencias a archivos",{"_3550":74056,"_30605":73955,"_21201":126466,"_5":14582,"_27821":126162,"_3006":126467},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3550":74057,"_30605":73955,"_21201":126469,"_5":14582,"_27821":126162,"_3006":126470},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3550":74058,"_30605":73955,"_21201":126472,"_5":14582,"_27821":126162,"_3006":126473},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3550":74059,"_30605":73955,"_21201":126475,"_5":14582,"_27821":126162,"_3006":126186},[],{"_3550":74060,"_30605":73955,"_21201":126477,"_5":14582,"_27821":126162,"_3006":126478},[],"Releases con identidades por servicio o material de claves montado",{"_3550":74061,"_30605":73955,"_21201":126480,"_5":14582,"_27821":126162,"_3006":126481},[],"Media: los servicios no pueden leer sus archivos",{"_3550":74062,"_30605":73955,"_21201":126483,"_5":14582,"_27821":126162,"_3006":126484},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3550":74063,"_30605":73955,"_21201":126486,"_5":14582,"_27821":126162,"_3006":126190},[],{"_3550":74064,"_30605":73955,"_21201":126488,"_5":14582,"_27821":126162,"_3006":126489},[],"Releases que definen `amqp.tls`",{"_3550":74065,"_30605":73955,"_21201":126491,"_5":14582,"_27821":126162,"_3006":126492},[],"Media: los clientes se conectan al puerto equivocado",{"_3550":74066,"_30605":73955,"_21201":126494,"_5":14582,"_27821":126162,"_3006":126495},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3550":74067,"_30605":73955,"_21201":126497,"_5":14582,"_27821":126162,"_3006":126210},[],{"_3550":74068,"_30605":73955,"_21201":126499,"_5":14582,"_27821":126162,"_3006":126500},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3550":74069,"_30605":73955,"_21201":126502,"_5":14582,"_27821":126162,"_3006":126503},[],"Media: las claves de CA quedan sin gestionar",{"_3550":74070,"_30605":73955,"_21201":126505,"_5":14582,"_27821":126162,"_3006":126506},[],"Ejecutar la migración de CA a KMS",{"_3550":74071,"_30605":73955,"_21201":126508,"_5":14582,"_27821":126162,"_3006":126509},[],"Verificación del certificado del receptor",{"_3550":74072,"_30605":73955,"_21201":126511,"_5":14582,"_27821":126162,"_3006":126512},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3550":74073,"_30605":73955,"_21201":126514,"_5":14582,"_27821":126162,"_3006":126515},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3550":74074,"_30605":73955,"_21201":126517,"_5":14582,"_27821":126162,"_3006":126518},[],"Poner `insecure_skip_verify` a `false`",{"_3550":74075,"_30605":73955,"_21201":126520,"_5":14582,"_27821":126162,"_3006":126226},[],{"_3550":74076,"_30605":73955,"_21201":126522,"_5":14582,"_27821":126162,"_3006":126523},[],"Scripts y consolas que editan DMS por API",{"_3550":74077,"_30605":73955,"_21201":126525,"_5":14582,"_27821":126162,"_3006":126526},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3550":74078,"_30605":73955,"_21201":126528,"_5":14582,"_27821":126162,"_3006":126529},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3550":74079,"_30605":73955,"_21201":126531,"_5":14582,"_27821":126162,"_3006":126246},[],{"_3550":74080,"_30605":73955,"_21201":126533,"_5":14582,"_27821":126162,"_3006":126534},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3550":74081,"_30605":73955,"_21201":126536,"_5":14582,"_27821":126162,"_3006":126537},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3550":74082,"_30605":73955,"_21201":126539,"_5":14582,"_27821":126162,"_3006":126540},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3550":74083,"_30605":73955,"_21201":126542,"_5":14582,"_27821":126162,"_3006":126254},[],{"_3550":74084,"_30605":73955,"_21201":126544,"_5":14582,"_27821":126162,"_3006":126545},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3550":74085,"_30605":73955,"_21201":126547,"_5":14582,"_27821":126162,"_3006":126548},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3550":74086,"_30605":73955,"_21201":126550,"_5":14582,"_27821":126162,"_3006":126551},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3550":74087,"_30605":73955,"_21201":126553,"_5":14582,"_27821":126162,"_3006":126242},[],{"_3550":74088,"_30605":73955,"_21201":126555,"_5":14582,"_27821":126162,"_3006":126556},[],"Consumidores que leen el campo `events` del dispositivo",{"_3550":74089,"_30605":73955,"_21201":126558,"_5":14582,"_27821":126162,"_3006":126559},[],"Media: el campo desaparece",{"_3550":74090,"_30605":73955,"_21201":126561,"_5":14582,"_27821":126162,"_3006":126562},[],"Usar los nuevos endpoints de eventos",{"_3550":74091,"_30605":73955,"_21201":126564,"_5":14582,"_27821":126162,"_3006":126262},[],{"_3550":74092,"_30605":73955,"_21201":126566,"_5":14582,"_27821":126162,"_3006":126567},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3550":74093,"_30605":73955,"_21201":126569,"_5":14582,"_27821":126162,"_3006":126570},[],"Media: la migración de la VA aborta",{"_3550":74094,"_30605":73955,"_21201":126572,"_5":14582,"_27821":126162,"_3006":126573},[],"Corregir los roles afectados antes de actualizar",{"_3550":74095,"_30605":73955,"_21201":126575,"_5":14582,"_27821":126162,"_3006":126194},[],{"_3550":74096,"_30605":73955,"_21201":126577,"_5":14582,"_27821":126162,"_3006":126578},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3550":74097,"_30605":73955,"_21201":126580,"_5":14582,"_27821":126162,"_3006":126581},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3550":74098,"_30605":73955,"_21201":126583,"_5":14582,"_27821":126162,"_3006":126584},[],"Actualizar el archivo de values",{"_3550":74099,"_30605":73955,"_21201":126586,"_5":14582,"_27821":126162,"_3006":126234},[],{"_3550":74100,"_30605":73955,"_21201":126588,"_5":14582,"_27821":126162,"_3006":126589},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3550":74101,"_30605":73955,"_21201":126591,"_5":14582,"_27821":126162,"_3006":126592},[],"Baja: prevalece el ID de la URL",{"_3550":74102,"_30605":73955,"_21201":126594,"_5":14582,"_27821":126162,"_3006":126595},[],"Enviar el ID en la URL",{"_3550":74103,"_30605":73955,"_21201":126597,"_5":14582,"_27821":126162,"_3006":126258},[],{"_3550":74104,"_30605":73955,"_21201":126599,"_5":14582,"_27821":126162,"_3006":126600},[],"Clientes que envían un `id` al crear o importar CAs",{"_3550":74105,"_30605":73955,"_21201":126602,"_5":14582,"_27821":126162,"_3006":126603},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3550":74106,"_30605":73955,"_21201":126605,"_5":14582,"_27821":126162,"_3006":126606},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3550":74107,"_30605":73955,"_21201":126608,"_5":14582,"_27821":126162,"_3006":126238},[],{"_3550":74108,"_30605":73955,"_21201":126610,"_5":14582,"_27821":126162,"_3006":126611},[],"Consumidores que comparan el `type` del certificado",{"_3550":74109,"_30605":73955,"_21201":126613,"_5":14582,"_27821":126162,"_3006":126614},[],"Baja: dos valores cambian de nombre",{"_3550":74110,"_30605":73955,"_21201":126616,"_5":14582,"_27821":126162,"_3006":126617},[],"Adaptar los consumidores",{"_3550":74111,"_30605":73955,"_21201":126619,"_5":14582,"_27821":126162,"_3006":126230},[],{"_3550":74112,"_30605":73955,"_21201":126621,"_5":14582,"_27821":126162,"_3006":126622},[],"Cualquier DMS",{"_3550":74113,"_30605":73955,"_21201":126624,"_5":14582,"_27821":126162,"_3006":126625},[],"Baja: solo informativo",{"_3550":74114,"_30605":73955,"_21201":126627,"_5":14582,"_27821":126162,"_3006":126628},[],"Revisar ambos bloques antes de editar",{"_3550":74115,"_30605":73955,"_21201":126630,"_5":14582,"_27821":126169,"_3006":126631},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3550":74116,"_30605":73955,"_21201":126633,"_5":14582,"_27821":126169,"_3006":126634},[],"El paso 4 de la guía de migración copia los datos.",{"_3550":74117,"_30605":73955,"_21201":126636,"_5":14582,"_27821":126173,"_3006":126637},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3550":74118,"_30605":73955,"_21201":126639,"_5":14582,"_27821":126177,"_3006":126640},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3550":74119,"_30605":73955,"_21201":126642,"_5":14582,"_27821":126181,"_3006":126643},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3550":74120,"_30605":73955,"_21201":126645,"_5":14582,"_27821":126185,"_3006":126646},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3550":74121,"_30605":73955,"_21201":126648,"_5":14582,"_27821":126185,"_3006":126649},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3550":74122,"_30605":73955,"_21201":126651,"_5":14582,"_27821":126189,"_3006":126652},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3550":74123,"_30605":73955,"_21201":126654,"_5":14582,"_27821":126193,"_3006":126655},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3550":74124,"_30605":73955,"_21201":126657,"_5":14582,"_27821":126193,"_3006":126658},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3550":74125,"_30605":73955,"_21201":126660,"_5":14582,"_27821":126193,"_3006":126661},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3550":74126,"_30605":73955,"_21201":126663,"_5":14582,"_27821":126193,"_3006":126664},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3550":74127,"_30605":73955,"_21201":126666,"_5":14582,"_27821":126193,"_3006":126667},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3550":74128,"_30605":73955,"_21201":126669,"_5":14582,"_27821":126193,"_3006":126670},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3550":74129,"_30605":73955,"_21201":126672,"_5":14582,"_27821":126201,"_3006":126673},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3550":74130,"_30605":73955,"_21201":126675,"_5":14582,"_27821":126201,"_3006":126676},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3550":74131,"_30605":73955,"_21201":126678,"_5":14582,"_27821":126201,"_3006":126679},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3550":74132,"_30605":73955,"_21201":126681,"_5":14582,"_27821":126201,"_3006":126682},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3550":74133,"_30605":73955,"_21201":126684,"_5":14582,"_27821":126201,"_3006":126685},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3550":74134,"_30605":73955,"_21201":126687,"_5":14582,"_27821":126205,"_3006":126688},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3550":74135,"_30605":73955,"_21201":126690,"_5":14582,"_27821":126209,"_3006":126691},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3550":74136,"_30605":73955,"_21201":126693,"_5":14582,"_27821":126209,"_3006":126694},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3550":74137,"_30605":73955,"_21201":126696,"_5":14582,"_27821":126209,"_3006":126697},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3550":74138,"_30605":73955,"_21201":126699,"_5":14582,"_27821":126209,"_3006":126700},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3550":74139,"_30605":73955,"_21201":126702,"_5":14582,"_27821":126209,"_3006":126703},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3550":74140,"_30605":73955,"_21201":126705,"_5":14582,"_27821":126209,"_3006":126706},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3550":74141,"_30605":73955,"_21201":126708,"_5":14582,"_27821":126209,"_3006":126709},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3550":74142,"_30605":73955,"_21201":126711,"_5":14582,"_27821":126209,"_3006":126712},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3550":74143,"_30605":73955,"_21201":126714,"_5":14582,"_27821":126213,"_3006":126715},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3550":74144,"_30605":73955,"_21201":126717,"_5":14582,"_27821":126221,"_3006":126718},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3550":74145,"_30605":73955,"_21201":126720,"_5":14582,"_27821":126221,"_3006":126721},[],"Campo en 3.8.0",{"_3550":74146,"_30605":73955,"_21201":126723,"_5":14582,"_27821":126221,"_3006":126724},[],"Campo en 4.0.0",{"_3550":74147,"_30605":73955,"_21201":126726,"_5":14582,"_27821":126221,"_3006":58934},[],{"_3550":74148,"_30605":73955,"_21201":126728,"_5":14582,"_27821":126221,"_3006":126729},[],"`insecure_skip_verify` (con el valor negado)",{"_3550":74149,"_30605":73955,"_21201":126731,"_5":14582,"_27821":126221,"_3006":58940},[],{"_3550":74150,"_30605":73955,"_21201":126733,"_5":14582,"_27821":126221,"_3006":58943},[],{"_3550":74151,"_30605":73955,"_21201":126735,"_5":14582,"_27821":126221,"_3006":58946},[],{"_3550":74152,"_30605":73955,"_21201":126737,"_5":14582,"_27821":126221,"_3006":58949},[],{"_3550":74153,"_30605":73955,"_21201":126739,"_5":14582,"_27821":126221,"_3006":58952},[],{"_3550":74154,"_30605":73955,"_21201":126741,"_5":14582,"_27821":126221,"_3006":58955},[],{"_3550":74155,"_30605":73955,"_21201":126743,"_5":14582,"_27821":126221,"_3006":126744},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3550":74156,"_30605":73955,"_21201":126746,"_5":14582,"_27821":126221,"_3006":126747},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3550":74157,"_30605":73955,"_21201":126749,"_5":14582,"_27821":126221,"_3006":126750},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3550":74158,"_30605":73955,"_21201":126752,"_5":14582,"_27821":126225,"_3006":126753},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3550":74159,"_30605":73955,"_21201":126755,"_5":14582,"_27821":126225,"_3006":126756},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3550":74160,"_30605":73955,"_21201":126758,"_5":14582,"_27821":126225,"_3006":126759},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3550":74161,"_30605":73955,"_21201":126761,"_5":14582,"_27821":126229,"_3006":126762},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3550":74162,"_30605":73955,"_21201":126764,"_5":14582,"_27821":126233,"_3006":126765},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3550":74163,"_30605":73955,"_21201":126767,"_5":14582,"_27821":126237,"_3006":126768},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3550":74164,"_30605":73955,"_21201":126770,"_5":14582,"_27821":126241,"_3006":126771},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3550":74165,"_30605":73955,"_21201":126773,"_5":14582,"_27821":126241,"_3006":126774},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3550":74166,"_30605":73955,"_21201":126776,"_5":14582,"_27821":126241,"_3006":126777},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3550":74167,"_30605":73955,"_21201":126779,"_5":14582,"_27821":126241,"_3006":126780},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3550":74168,"_30605":73955,"_21201":126782,"_5":14582,"_27821":126245,"_3006":126783},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3550":74169,"_30605":73955,"_21201":126785,"_5":14582,"_27821":126249,"_3006":126786},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3550":74170,"_30605":73955,"_21201":126788,"_5":14582,"_27821":126249,"_3006":126789},[],"Ruta",{"_3550":74171,"_30605":73955,"_21201":126791,"_5":14582,"_27821":126249,"_3006":119213},[],{"_3550":74172,"_30605":73955,"_21201":126793,"_5":14582,"_27821":126249,"_3006":59008},[],{"_3550":74173,"_30605":73955,"_21201":126795,"_5":14582,"_27821":126249,"_3006":126796},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3550":74174,"_30605":73955,"_21201":126798,"_5":14582,"_27821":126249,"_3006":59014},[],{"_3550":74175,"_30605":73955,"_21201":126800,"_5":14582,"_27821":126249,"_3006":126801},[],"Lee los ajustes de una CA.",{"_3550":74176,"_30605":73955,"_21201":126803,"_5":14582,"_27821":126249,"_3006":59020},[],{"_3550":74177,"_30605":73955,"_21201":126805,"_5":14582,"_27821":126249,"_3006":126806},[],"Sustituye los `crl_options`.",{"_3550":74178,"_30605":73955,"_21201":126808,"_5":14582,"_27821":126249,"_3006":59026},[],{"_3550":74179,"_30605":73955,"_21201":126810,"_5":14582,"_27821":126249,"_3006":126811},[],"Elimina los ajustes archivados de una CA.",{"_3550":74180,"_30605":73955,"_21201":126813,"_5":14582,"_27821":126249,"_3006":126814},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3550":74181,"_30605":73955,"_21201":126816,"_5":14582,"_27821":126249,"_3006":126817},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3550":74182,"_30605":73955,"_21201":126819,"_5":14582,"_27821":126249,"_3006":126820},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3550":74183,"_30605":73955,"_21201":126822,"_5":14582,"_27821":126249,"_3006":126823},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3550":74184,"_30605":73955,"_21201":126825,"_5":14582,"_27821":126249,"_3006":126826},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3550":74185,"_30605":73955,"_21201":126828,"_5":14582,"_27821":126249,"_3006":126829},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3550":74186,"_30605":73955,"_21201":126831,"_5":14582,"_27821":126249,"_3006":126832},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3550":74187,"_30605":73955,"_21201":126834,"_5":14582,"_27821":126249,"_3006":126835},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3550":74188,"_30605":73955,"_21201":126837,"_5":14582,"_27821":126249,"_3006":126838},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3550":74189,"_30605":73955,"_21201":126840,"_5":14582,"_27821":126249,"_3006":126841},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3550":74190,"_30605":73955,"_21201":126843,"_5":14582,"_27821":126249,"_3006":126844},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3550":74191,"_30605":73955,"_21201":126846,"_5":14582,"_27821":126253,"_3006":126847},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3550":74192,"_30605":73955,"_21201":126849,"_5":14582,"_27821":126257,"_3006":126850},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3550":74193,"_30605":73955,"_21201":126852,"_5":14582,"_27821":126261,"_3006":126853},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3550":74194,"_30605":73955,"_21201":126855,"_5":14582,"_27821":126265,"_3006":126856},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3550":74195,"_30605":73955,"_21201":126858,"_5":14582,"_27821":126269,"_3006":126859},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3550":74196,"_30605":73955,"_21201":126861,"_5":14582,"_27821":126269,"_3006":126862},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3550":74197,"_30605":73955,"_21201":126864,"_5":14582,"_27821":126269,"_3006":126865},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3550":74198,"_30605":73955,"_21201":126867,"_5":14582,"_27821":126269,"_3006":126868},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3550":74199,"_30605":73955,"_21201":126870,"_5":14582,"_27821":126269,"_3006":126871},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3550":74200,"_30605":73955,"_21201":126873,"_5":14582,"_27821":126269,"_3006":126874},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3550":74201,"_30605":73955,"_21201":126876,"_5":14582,"_27821":126273,"_3006":126877},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3550":74202,"_30605":73955,"_21201":126879,"_5":14582,"_27821":126273,"_3006":126880},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3550":74203,"_30605":73955,"_21201":126882,"_5":14582,"_27821":126273,"_3006":126883},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3550":74204,"_30605":73955,"_21201":126885,"_5":14582,"_27821":126273,"_3006":126886},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3550":74205,"_30605":73955,"_21201":126888,"_5":14582,"_27821":126273,"_3006":126889},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3550":74206,"_30605":73955,"_21201":126891,"_5":14582,"_27821":126277,"_3006":126892},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3550":74207,"_30605":73955,"_21201":126894,"_5":14582,"_27821":126277,"_3006":126895},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3550":74208,"_30605":73955,"_21201":126897,"_5":14582,"_27821":126277,"_3006":126898},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3550":74209,"_30605":73955,"_21201":126900,"_5":14582,"_27821":126277,"_3006":126901},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3550":74210,"_30605":73955,"_21201":126903,"_5":14582,"_27821":126277,"_3006":126904},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3550":74211,"_30605":73955,"_21201":126906,"_5":14582,"_27821":126277,"_3006":126907},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3550":74212,"_30605":73955,"_21201":126909,"_5":14582,"_27821":126277,"_3006":126910},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3550":74213,"_30605":73955,"_21201":126912,"_5":14582,"_27821":126277,"_3006":126913},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3550":74214,"_30605":73955,"_21201":126915,"_5":14582,"_27821":126277,"_3006":126916},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3550":74215,"_30605":73955,"_21201":126918,"_5":14582,"_27821":126277,"_3006":126919},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3550":74216,"_30605":73955,"_21201":126921,"_5":14582,"_27821":126277,"_3006":126922},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3550":74217,"_30605":73955,"_21201":126924,"_5":14582,"_27821":126277,"_3006":126925},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3550":74218,"_30605":73955,"_21201":126927,"_5":14582,"_27821":126281,"_3006":126928},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3550":74219,"_30605":73955,"_21201":126930,"_5":14582,"_27821":126281,"_3006":126931},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3550":74220,"_30605":73955,"_21201":126933,"_5":14582,"_27821":126285,"_3006":126934},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3550":74221,"_30605":73955,"_21201":126936,"_5":14582,"_27821":126285,"_3006":126937},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3550":74222,"_30605":73955,"_21201":126939,"_5":14582,"_27821":126285,"_3006":126940},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3550":74223,"_30605":73955,"_21201":126942,"_5":14582,"_27821":126285,"_3006":126943},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3550":74224,"_30605":73955,"_21201":126945,"_5":14582,"_27821":126285,"_3006":126946},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3550":74225,"_30605":73955,"_21201":126948,"_5":14582,"_27821":126285,"_3006":126949},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3550":74226,"_30605":73955,"_21201":126951,"_5":14582,"_27821":126285,"_3006":126952},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3550":74227,"_30605":73955,"_21201":126954,"_5":14582,"_27821":126285,"_3006":126955},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3550":74228,"_30605":73955,"_21201":126957,"_5":14582,"_27821":126285,"_3006":126958},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3550":74229,"_30605":73955,"_21201":126960,"_5":14582,"_27821":126285,"_3006":126961},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3550":74230,"_30605":73955,"_21201":126963,"_5":14582,"_27821":126285,"_3006":126964},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3550":74231,"_30605":73955,"_21201":126966,"_5":14582,"_27821":126289,"_3006":126967},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3550":74232,"_30605":73955,"_21201":126969,"_5":14582,"_27821":126289,"_3006":126970},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3550":74233,"_30605":73955,"_21201":126972,"_5":14582,"_27821":126293,"_3006":126973},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3550":74234,"_30605":73955,"_21201":126975,"_5":14582,"_27821":126293,"_3006":126976},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3550":74235,"_30605":73955,"_21201":126978,"_5":14582,"_27821":126293,"_3006":126979},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3550":74236,"_30605":73955,"_21201":126981,"_5":14582,"_27821":126293,"_3006":126982},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3550":74237,"_30605":73955,"_21201":126984,"_5":14582,"_27821":126293,"_3006":126985},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3550":74238,"_30605":73955,"_21201":126987,"_5":14582,"_27821":126293,"_3006":126988},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3550":74239,"_30605":73955,"_21201":126990,"_5":14582,"_27821":126293,"_3006":126991},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3550":74240,"_30605":73955,"_21201":126993,"_5":14582,"_27821":126293,"_3006":126994},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3550":74241,"_30605":73955,"_21201":126996,"_5":14582,"_27821":126297,"_3006":126997},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3550":74242,"_30605":73955,"_21201":126999,"_5":14582,"_27821":126297,"_3006":127000},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3550":74243,"_30605":73955,"_21201":127002,"_5":14582,"_27821":126297,"_3006":127003},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3550":74244,"_30605":73955,"_21201":127005,"_5":14582,"_27821":126297,"_3006":127006},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3550":74245,"_30605":73955,"_21201":127008,"_5":14582,"_27821":126297,"_3006":127009},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3550":74246,"_30605":73955,"_21201":127011,"_5":14582,"_27821":126297,"_3006":127012},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3550":74247,"_30605":73955,"_21201":127014,"_5":14582,"_27821":126297,"_3006":127015},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3550":74248,"_30605":73955,"_21201":127017,"_5":14582,"_27821":126297,"_3006":127018},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3550":74249,"_30605":73955,"_21201":127020,"_5":14582,"_27821":126297,"_3006":127021},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3550":74250,"_30605":73955,"_21201":127023,"_5":14582,"_27821":126297,"_3006":127024},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3550":74251,"_30605":73955,"_21201":127026,"_5":14582,"_27821":126297,"_3006":127027},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3550":74252,"_30605":73955,"_21201":127029,"_5":14582,"_27821":126300,"_3006":127030},[],"Tras la actualización, comprueba en este orden:",{"_3550":74253,"_30605":73955,"_21201":127032,"_5":14582,"_27821":126300,"_3006":127033},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3550":74254,"_30605":73955,"_21201":127035,"_5":14582,"_27821":126300,"_3006":127036},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3550":74255,"_30605":73955,"_21201":127038,"_5":14582,"_27821":126300,"_3006":127039},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3550":74256,"_30605":73955,"_21201":127041,"_5":14582,"_27821":126300,"_3006":127042},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3550":74257,"_30605":73955,"_21201":127044,"_5":14582,"_27821":126300,"_3006":127045},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3550":74258,"_30605":73955,"_21201":127047,"_5":14582,"_27821":126300,"_3006":127048},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3550":74259,"_30605":73955,"_21201":127050,"_5":14582,"_27821":126300,"_3006":127051},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3550":74260,"_30605":73955,"_21201":127053,"_5":14582,"_27821":126300,"_3006":127054},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3550":74261,"_30605":73955,"_21201":127056,"_5":14582,"_27821":126300,"_3006":127057},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3550":74262,"_30605":73955,"_21201":127059,"_5":14582,"_27821":126300,"_3006":127060},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3550":74263,"_30605":73955,"_21201":127062,"_5":14582,"_27821":126300,"_3006":127063},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3550":74264,"_30605":73955,"_21201":127065,"_5":14582,"_27821":126300,"_3006":127066},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3550":74265,"_30605":73955,"_21201":127068,"_5":14582,"_27821":126300,"_3006":127069},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3550":74266,"_30605":73955,"_21201":127071,"_5":14582,"_27821":126300,"_3006":127072},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3550":74267,"_30605":73955,"_21201":127074,"_5":14582,"_27821":126300,"_3006":127075},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3550":74268,"_30605":73955,"_21201":127077,"_5":14582,"_27821":126304,"_3006":127078},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3550":74269,"_30605":73955,"_21201":127080,"_5":14582,"_27821":126304,"_3006":127081},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3550":74270,"_30605":73955,"_21201":127083,"_5":14582,"_27821":126304,"_3006":127084},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3550":74271,"_30605":73955,"_21201":127086,"_5":14582,"_27821":126304,"_3006":127087},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3550":74272,"_30605":73955,"_21201":127089,"_5":14582,"_27821":126304,"_3006":127090},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_59311":127092,"_59313":127093,"_59315":127094,"_59317":127095,"_18377":3041,"_71280":3041},"spanish",[3006,30605,5,27821],{"_3006":25326,"_30605":25326,"_5":25326,"_27821":25326},{"_3006":127096,"_30605":130085,"_5":133074,"_27821":136063},{"_4739":127097,"_59321":127098,"_5":25326},{"_14658":17521,"_15033":5223,"_15052":4987,"_29608":5155,"_15039":4065,"_20119":3298,"_14679":13011,"_14686":3813,"_29550":7155,"_29959":7101,"_29980":4859,"_29584":12945,"_34988":12451,"_29687":20599,"_30024":10043,"_34995":23133,"_34998":4234,"_35001":6132,"_35004":5534,"_30431":3407,"_35009":19468,"_35011":9777,"_30461":7190,"_15048":3799,"_35015":7649,"_35018":3316,"_35020":3743,"_30008":23894,"_30426":7795,"_30474":11317,"_35025":7545,"_35027":16190,"_35029":8293,"_29704":6492,"_35032":4831,"_35034":3761,"_35036":3382,"_35038":7275,"_35040":3404,"_29621":4868,"_35043":9353,"_35045":4457,"_29615":3116,"_30045":13102,"_35049":23377,"_35051":20617,"_35054":5061,"_29661":14814,"_35058":4485,"_29541":4076,"_35061":11157,"_29589":17378,"_35064":5051,"_35066":5941,"_35069":7723,"_15042":5535,"_35072":4802,"_35074":20963,"_35077":7786,"_35079":4703,"_35081":3115,"_35083":21695,"_35085":23091,"_20122":3394,"_35088":30621,"_30670":5039,"_29562":6122,"_30002":11153,"_35093":9028,"_35095":7491,"_35097":16714,"_30491":23067,"_35100":3713,"_35102":13894,"_35104":14504,"_30585":4639,"_30061":5668,"_35108":7065,"_35110":4147,"_29599":5768,"_35113":5926,"_35115":3409,"_3511