:59273,"_40935":59276,"_40937":59279,"_40939":59282,"_40941":59285,"_40943":59288,"_40945":59291,"_40947":59294,"_40950":59297,"_40952":59300,"_40954":59303,"_40956":59306},{"_3550":15,"_30605":15,"_5":14934,"_3006":49993,"_30964":49994,"_21201":49998,"_27821":15},"Deploy from AWS Marketplace",[49995,49996,49997],"Docs","Deployment","Other models",[],{"_3550":16,"_30605":15,"_21201":50000,"_5":14582,"_27821":15,"_3006":50001},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3550":17,"_30605":15,"_5":30961,"_21201":50003,"_27821":50004,"_3006":50005},[],"/docs/pr-preview/pr-66/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3550":18,"_30605":15,"_5":30961,"_21201":50007,"_27821":50008,"_3006":50009},[],"/docs/pr-preview/pr-66/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3550":19,"_30605":15,"_5":30961,"_21201":50011,"_27821":50012,"_3006":50013},[],"/docs/pr-preview/pr-66/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3550":20,"_30605":15,"_5":30961,"_21201":50015,"_27821":50016,"_3006":50017},[],"/docs/pr-preview/pr-66/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3550":21,"_30605":15,"_5":30961,"_21201":50019,"_27821":50020,"_3006":50021},[],"/docs/pr-preview/pr-66/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3550":22,"_30605":15,"_5":30961,"_21201":50023,"_27821":50024,"_3006":50025},[],"/docs/pr-preview/pr-66/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3550":23,"_30605":15,"_5":30961,"_21201":50027,"_27821":50028,"_3006":50029},[],"/docs/pr-preview/pr-66/deployment/aws-marketplace#next-step","Next step",{"_3550":24,"_30605":15,"_21201":50031,"_5":14582,"_27821":15,"_3006":50032},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3550":25,"_30605":15,"_21201":50034,"_5":14582,"_27821":50004,"_3006":50035},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3550":26,"_30605":15,"_21201":50037,"_5":14582,"_27821":50004,"_3006":50038},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3550":27,"_30605":15,"_21201":50040,"_5":14582,"_27821":50004,"_3006":50041},[],"A security group allowing the necessary endpoints.",{"_3550":28,"_30605":15,"_21201":50043,"_5":14582,"_27821":50008,"_3006":50044},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3550":29,"_30605":15,"_21201":50046,"_5":14582,"_27821":50008,"_3006":50047},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3550":30,"_30605":15,"_21201":50049,"_5":14582,"_27821":50008,"_3006":50050},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3550":31,"_30605":15,"_21201":50052,"_5":14582,"_27821":50012,"_3006":50053},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3550":32,"_30605":15,"_21201":50055,"_5":14582,"_27821":50016,"_3006":50056},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3550":33,"_30605":15,"_21201":50058,"_5":14582,"_27821":50020,"_3006":50059},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3550":34,"_30605":15,"_21201":50061,"_5":14582,"_27821":50024,"_3006":50062},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3550":35,"_30605":15,"_21201":50064,"_5":14582,"_27821":50028,"_3006":50065},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3550":36,"_30605":36,"_5":14934,"_3006":50067,"_30964":50068,"_21201":50069,"_27821":36},"Deploy Lamassu",[49995,49996],[],{"_3550":37,"_30605":36,"_21201":50071,"_5":14582,"_27821":36,"_3006":50072},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3550":38,"_30605":36,"_5":30961,"_21201":50074,"_27821":50075,"_3006":50076},[],"/docs/pr-preview/pr-66/deployment/overview#choose-a-model","Choose a model",{"_3550":39,"_30605":36,"_5":30961,"_21201":50078,"_27821":50079,"_3006":50080},[],"/docs/pr-preview/pr-66/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3550":40,"_30605":36,"_5":30961,"_21201":50082,"_27821":50083,"_3006":50084},[],"/docs/pr-preview/pr-66/deployment/overview#after-deployment","After deployment",{"_3550":41,"_30605":36,"_21201":50086,"_5":14582,"_27821":36,"_3006":50087},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3550":42,"_30605":36,"_21201":50089,"_5":14582,"_27821":50075,"_3006":50090},[],"Model",{"_3550":43,"_30605":36,"_21201":50092,"_5":14582,"_27821":50075,"_3006":50093},[],"Recommended for",{"_3550":44,"_30605":36,"_21201":50095,"_5":14582,"_27821":50075,"_3006":50096},[],"Who operates the infrastructure",{"_3550":45,"_30605":36,"_21201":50098,"_5":14582,"_27821":50075,"_3006":50099},[],"Starting point",{"_3550":46,"_30605":36,"_21201":50101,"_5":14582,"_27821":50075,"_3006":50102},[],"Kubernetes self-managed",{"_3550":47,"_30605":36,"_21201":50104,"_5":14582,"_27821":50075,"_3006":50105},[],"Production, regulated environments and custom deployments",{"_3550":48,"_30605":36,"_21201":50107,"_5":14582,"_27821":50075,"_3006":50108},[],"Your team",{"_3550":49,"_30605":36,"_21201":50110,"_5":14582,"_27821":50075,"_3006":50111},[],"Helm or Fastlane",{"_3550":50,"_30605":36,"_21201":50113,"_5":14582,"_27821":50075,"_3006":50114},[],"AWS Marketplace",{"_3550":51,"_30605":36,"_21201":50116,"_5":14582,"_27821":50075,"_3006":50117},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3550":52,"_30605":36,"_21201":50119,"_5":14582,"_27821":50075,"_3006":50108},[],{"_3550":53,"_30605":36,"_21201":50121,"_5":14582,"_27821":50075,"_3006":50122},[],"Preconfigured image on EC2",{"_3550":54,"_30605":36,"_21201":50124,"_5":14582,"_27821":50075,"_3006":50125},[],"SaaS",{"_3550":55,"_30605":36,"_21201":50127,"_5":14582,"_27821":50075,"_3006":50128},[],"Teams that want to use the platform without operating it",{"_3550":56,"_30605":36,"_21201":50130,"_5":14582,"_27821":50075,"_3006":50131},[],"Lamassu",{"_3550":57,"_30605":36,"_21201":50133,"_5":14582,"_27821":50075,"_3006":50134},[],"Managed subscription",{"_3550":58,"_30605":36,"_21201":50136,"_5":14582,"_27821":50075,"_3006":50137},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3550":59,"_30605":36,"_21201":50139,"_5":14582,"_27821":50075,"_3006":50140},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3550":60,"_30605":36,"_21201":50142,"_5":14582,"_27821":50075,"_3006":50143},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3550":61,"_30605":36,"_21201":50145,"_5":14582,"_27821":50079,"_3006":50146},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3550":62,"_30605":36,"_21201":50148,"_5":14582,"_27821":50083,"_3006":50149},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3550":63,"_30605":63,"_5":14934,"_3006":50151,"_30964":50152,"_21201":50153,"_27821":63},"Use Lamassu as SaaS",[49995,49996,49997],[],{"_3550":64,"_30605":63,"_21201":50155,"_5":14582,"_27821":63,"_3006":50156},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3550":65,"_30605":63,"_5":30961,"_21201":50158,"_27821":50159,"_3006":50160},[],"/docs/pr-preview/pr-66/deployment/saas#what-the-service-manages","What the service manages",{"_3550":66,"_30605":63,"_5":30961,"_21201":50162,"_27821":50163,"_3006":50164},[],"/docs/pr-preview/pr-66/deployment/saas#plans","Plans",{"_3550":67,"_30605":63,"_5":30961,"_21201":50166,"_27821":50167,"_3006":50168},[],"/docs/pr-preview/pr-66/deployment/saas#request-access","Request access",{"_3550":68,"_30605":63,"_21201":50170,"_5":14582,"_27821":63,"_3006":50171},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3550":69,"_30605":63,"_21201":50173,"_5":14582,"_27821":50159,"_3006":50174},[],"Platform availability and maintenance.",{"_3550":70,"_30605":63,"_21201":50176,"_5":14582,"_27821":50159,"_3006":50177},[],"Automatic backups.",{"_3550":71,"_30605":63,"_21201":50179,"_5":14582,"_27821":50159,"_3006":50180},[],"Version upgrades.",{"_3550":72,"_30605":63,"_21201":50182,"_5":14582,"_27821":50159,"_3006":50183},[],"Technical support and SLA according to your plan.",{"_3550":73,"_30605":63,"_21201":50185,"_5":14582,"_27821":50163,"_3006":50186},[],"Plan",{"_3550":74,"_30605":63,"_21201":50188,"_5":14582,"_27821":50163,"_3006":50189},[],"Devices",{"_3550":75,"_30605":63,"_21201":50191,"_5":14582,"_27821":50163,"_3006":50192},[],"Support",{"_3550":76,"_30605":63,"_21201":50194,"_5":14582,"_27821":50163,"_3006":50195},[],"SLA",{"_3550":77,"_30605":63,"_21201":50197,"_5":14582,"_27821":50163,"_3006":50198},[],"Starter",{"_3550":78,"_30605":63,"_21201":50200,"_5":14582,"_27821":50163,"_3006":50201},[],"Up to 1,000",{"_3550":79,"_30605":63,"_21201":50203,"_5":14582,"_27821":50163,"_3006":50204},[],"Email",{"_3550":80,"_30605":63,"_21201":50206,"_5":14582,"_27821":50163,"_3006":50207},[],"99.5 %",{"_3550":81,"_30605":63,"_21201":50209,"_5":14582,"_27821":50163,"_3006":50210},[],"Professional",{"_3550":82,"_30605":63,"_21201":50212,"_5":14582,"_27821":50163,"_3006":50213},[],"Up to 10,000",{"_3550":83,"_30605":63,"_21201":50215,"_5":14582,"_27821":50163,"_3006":50216},[],"Email and chat",{"_3550":84,"_30605":63,"_21201":50218,"_5":14582,"_27821":50163,"_3006":50219},[],"99.9 %",{"_3550":85,"_30605":63,"_21201":50221,"_5":14582,"_27821":50163,"_3006":50222},[],"Enterprise",{"_3550":86,"_30605":63,"_21201":50224,"_5":14582,"_27821":50163,"_3006":50225},[],"Unlimited",{"_3550":87,"_30605":63,"_21201":50227,"_5":14582,"_27821":50163,"_3006":50228},[],"Dedicated",{"_3550":88,"_30605":63,"_21201":50230,"_5":14582,"_27821":50163,"_3006":50231},[],"99.99 %",{"_3550":89,"_30605":63,"_21201":50233,"_5":14582,"_27821":50167,"_3006":50234},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3550":90,"_30605":63,"_21201":50236,"_5":14582,"_27821":50167,"_3006":50237},[],"When you receive your instance's credentials, continue with Get started.",{"_3550":91,"_30605":91,"_5":14934,"_3006":50239,"_30964":50240,"_21201":50241,"_27821":91},"Fastlane",[49995,49996,50102],[],{"_3550":92,"_30605":91,"_21201":50243,"_5":14582,"_27821":91,"_3006":50244},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3550":93,"_30605":91,"_5":30961,"_21201":50246,"_27821":50247,"_3006":50248},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3550":94,"_30605":91,"_5":30961,"_21201":50250,"_27821":50251,"_3006":50252},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3550":95,"_30605":91,"_5":30961,"_21201":50254,"_27821":50255,"_3006":50005},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#before-you-begin",{"_3550":96,"_30605":91,"_5":30961,"_21201":50257,"_27821":50258,"_3006":50259},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3550":97,"_30605":91,"_5":30961,"_21201":50261,"_27821":50262,"_3006":50263},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3550":98,"_30605":91,"_5":30961,"_21201":50265,"_27821":50266,"_3006":50267},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3550":99,"_30605":91,"_5":30961,"_21201":50269,"_27821":50270,"_3006":50271},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3550":100,"_30605":91,"_5":30961,"_21201":50273,"_27821":50274,"_3006":50275},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3550":101,"_30605":91,"_5":30961,"_21201":50277,"_27821":50278,"_3006":50279},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3550":102,"_30605":91,"_5":30961,"_21201":50281,"_27821":50282,"_3006":50283},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3550":103,"_30605":91,"_5":30961,"_21201":50285,"_27821":50286,"_3006":50287},[],"/docs/pr-preview/pr-66/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3550":104,"_30605":91,"_21201":50289,"_5":14582,"_27821":50247,"_3006":50290},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3550":105,"_30605":91,"_21201":50292,"_5":14582,"_27821":50247,"_3006":50293},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3550":106,"_30605":91,"_21201":50295,"_5":14582,"_27821":50251,"_3006":50296},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3550":107,"_30605":91,"_21201":50298,"_5":14582,"_27821":50251,"_3006":50299},[],"Fastlane installs or configures",{"_3550":108,"_30605":91,"_21201":50301,"_5":14582,"_27821":50251,"_3006":50302},[],"You still provide",{"_3550":109,"_30605":91,"_21201":50304,"_5":14582,"_27821":50251,"_3006":50305},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3550":110,"_30605":91,"_21201":50307,"_5":14582,"_27821":50251,"_3006":50308},[],"The Kubernetes cluster, nodes and persistent storage",{"_3550":111,"_30605":91,"_21201":50310,"_5":14582,"_27821":50251,"_3006":50311},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3550":112,"_30605":91,"_21201":50313,"_5":14582,"_27821":50251,"_3006":50314},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3550":113,"_30605":91,"_21201":50316,"_5":14582,"_27821":50251,"_3006":50317},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3550":114,"_30605":91,"_21201":50319,"_5":14582,"_27821":50251,"_3006":50320},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3550":115,"_30605":91,"_21201":50322,"_5":14582,"_27821":50251,"_3006":50323},[],"Optional observability and lab HSM components",{"_3550":116,"_30605":91,"_21201":50325,"_5":14582,"_27821":50251,"_3006":50326},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3550":117,"_30605":91,"_21201":50328,"_5":14582,"_27821":50251,"_3006":50329},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3550":118,"_30605":91,"_21201":50331,"_5":14582,"_27821":50255,"_3006":50332},[],"You need:",{"_3550":119,"_30605":91,"_21201":50334,"_5":14582,"_27821":50255,"_3006":50335},[],"an existing Kubernetes cluster",{"_3550":120,"_30605":91,"_21201":50337,"_5":14582,"_27821":50255,"_3006":50338},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3550":121,"_30605":91,"_21201":50340,"_5":14582,"_27821":50255,"_3006":50341},[],"`yq`",{"_3550":122,"_30605":91,"_21201":50343,"_5":14582,"_27821":50255,"_3006":23959},[],{"_3550":123,"_30605":91,"_21201":50345,"_5":14582,"_27821":50255,"_3006":50346},[],"`jq` only when using `--sample-data` or `--development`",{"_3550":124,"_30605":91,"_21201":50348,"_5":14582,"_27821":50255,"_3006":50349},[],"`ssh-keygen` only when using `--with-hsm`",{"_3550":125,"_30605":91,"_21201":50351,"_5":14582,"_27821":50255,"_3006":50352},[],"free external ports 80 and 443 on a single-node K3s host",{"_3550":126,"_30605":91,"_21201":50354,"_5":14582,"_27821":50255,"_3006":50355},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3550":127,"_30605":91,"_21201":50357,"_5":14582,"_27821":50255,"_3006":50358},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3550":128,"_30605":91,"_21201":50360,"_5":14582,"_27821":50258,"_3006":50361},[],"Run the script from a clone of the Helm repository:",{"_3550":129,"_30605":91,"_21201":50363,"_5":14582,"_27821":50258,"_3006":50364},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3550":130,"_30605":91,"_21201":50366,"_5":14582,"_27821":50262,"_3006":50367},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3550":131,"_30605":91,"_21201":50369,"_5":14582,"_27821":50262,"_3006":50370},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3550":132,"_30605":91,"_21201":50372,"_5":14582,"_27821":50262,"_3006":50373},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3550":133,"_30605":91,"_21201":50375,"_5":14582,"_27821":50262,"_3006":50376},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3550":134,"_30605":91,"_21201":50378,"_5":14582,"_27821":50266,"_3006":50379},[],"Option",{"_3550":135,"_30605":91,"_21201":50381,"_5":14582,"_27821":50266,"_3006":50382},[],"Default",{"_3550":136,"_30605":91,"_21201":50384,"_5":14582,"_27821":50266,"_3006":50385},[],"Purpose",{"_3550":137,"_30605":91,"_21201":50387,"_5":14582,"_27821":50266,"_3006":50388},[],"`-h`, `--help`",{"_3550":138,"_30605":91,"_21201":50390,"_5":14582,"_27821":50266,"_3006":50391},[],"—",{"_3550":139,"_30605":91,"_21201":50393,"_5":14582,"_27821":50266,"_3006":50394},[],"Show help",{"_3550":140,"_30605":91,"_21201":50396,"_5":14582,"_27821":50266,"_3006":50397},[],"`-c`, `--context`",{"_3550":141,"_30605":91,"_21201":50399,"_5":14582,"_27821":50266,"_3006":50400},[],"current context",{"_3550":142,"_30605":91,"_21201":50402,"_5":14582,"_27821":50266,"_3006":50403},[],"Select the kubeconfig context for kubectl and Helm",{"_3550":143,"_30605":91,"_21201":50405,"_5":14582,"_27821":50266,"_3006":50406},[],"`-n`, `--non-interactive`",{"_3550":144,"_30605":91,"_21201":50408,"_5":14582,"_27821":50266,"_3006":6671},[],{"_3550":145,"_30605":91,"_21201":50410,"_5":14582,"_27821":50266,"_3006":50411},[],"Skip prompts and generate dependency credentials",{"_3550":146,"_30605":91,"_21201":50413,"_5":14582,"_27821":50266,"_3006":50414},[],"`-ns`, `--namespace`",{"_3550":147,"_30605":91,"_21201":50416,"_5":14582,"_27821":50266,"_3006":50417},[],"`lamassu-dev`",{"_3550":148,"_30605":91,"_21201":50419,"_5":14582,"_27821":50266,"_3006":50420},[],"Namespace for the installation",{"_3550":149,"_30605":91,"_21201":50422,"_5":14582,"_27821":50266,"_3006":50423},[],"`-d`, `--domain`",{"_3550":150,"_30605":91,"_21201":50425,"_5":14582,"_27821":50266,"_3006":50426},[],"`dev.lamassu.io`",{"_3550":151,"_30605":91,"_21201":50428,"_5":14582,"_27821":50266,"_3006":50429},[],"Domain used by the UI, OIDC and certificate",{"_3550":152,"_30605":91,"_21201":50431,"_5":14582,"_27821":50266,"_3006":50432},[],"`-v`, `--version`",{"_3550":153,"_30605":91,"_21201":50434,"_5":14582,"_27821":50266,"_3006":15274},[],{"_3550":154,"_30605":91,"_21201":50436,"_5":14582,"_27821":50266,"_3006":50437},[],"Lamassu chart version",{"_3550":155,"_30605":91,"_21201":50439,"_5":14582,"_27821":50266,"_3006":50440},[],"`--https-port`",{"_3550":156,"_30605":91,"_21201":50442,"_5":14582,"_27821":50266,"_3006":50443},[],"`443`",{"_3550":157,"_30605":91,"_21201":50445,"_5":14582,"_27821":50266,"_3006":50446},[],"Gateway HTTPS listener port",{"_3550":158,"_30605":91,"_21201":50448,"_5":14582,"_27821":50266,"_3006":50449},[],"`--http-port`",{"_3550":159,"_30605":91,"_21201":50451,"_5":14582,"_27821":50266,"_3006":50452},[],"`80`",{"_3550":160,"_30605":91,"_21201":50454,"_5":14582,"_27821":50266,"_3006":50455},[],"Gateway HTTP listener port",{"_3550":161,"_30605":91,"_21201":50457,"_5":14582,"_27821":50266,"_3006":50458},[],"`--tls-crt`",{"_3550":162,"_30605":91,"_21201":50460,"_5":14582,"_27821":50266,"_3006":50391},[],{"_3550":163,"_30605":91,"_21201":50462,"_5":14582,"_27821":50266,"_3006":50463},[],"PEM certificate for downstream TLS",{"_3550":164,"_30605":91,"_21201":50465,"_5":14582,"_27821":50266,"_3006":50466},[],"`--tls-key`",{"_3550":165,"_30605":91,"_21201":50468,"_5":14582,"_27821":50266,"_3006":50391},[],{"_3550":166,"_30605":91,"_21201":50470,"_5":14582,"_27821":50266,"_3006":50471},[],"PEM private key for downstream TLS",{"_3550":167,"_30605":91,"_21201":50473,"_5":14582,"_27821":50266,"_3006":50474},[],"`-l`, `--local-chart-path`",{"_3550":168,"_30605":91,"_21201":50476,"_5":14582,"_27821":50266,"_3006":50477},[],"repository chart",{"_3550":169,"_30605":91,"_21201":50479,"_5":14582,"_27821":50266,"_3006":50480},[],"Use an unpacked local Lamassu chart",{"_3550":170,"_30605":91,"_21201":50482,"_5":14582,"_27821":50266,"_3006":50483},[],"`-ip`, `--gateway-ip`",{"_3550":171,"_30605":91,"_21201":50485,"_5":14582,"_27821":50266,"_3006":8904},[],{"_3550":172,"_30605":91,"_21201":50487,"_5":14582,"_27821":50266,"_3006":50488},[],"Override the address written to `gateway.addresses`",{"_3550":173,"_30605":91,"_21201":50490,"_5":14582,"_27821":50266,"_3006":50491},[],"`--otel`",{"_3550":174,"_30605":91,"_21201":50493,"_5":14582,"_27821":50266,"_3006":6671},[],{"_3550":175,"_30605":91,"_21201":50495,"_5":14582,"_27821":50266,"_3006":50496},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3550":176,"_30605":91,"_21201":50498,"_5":14582,"_27821":50266,"_3006":50499},[],"`--development`",{"_3550":177,"_30605":91,"_21201":50501,"_5":14582,"_27821":50266,"_3006":6671},[],{"_3550":178,"_30605":91,"_21201":50503,"_5":14582,"_27821":50266,"_3006":50504},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3550":179,"_30605":91,"_21201":50506,"_5":14582,"_27821":50266,"_3006":50507},[],"`--sample-data`",{"_3550":180,"_30605":91,"_21201":50509,"_5":14582,"_27821":50266,"_3006":6671},[],{"_3550":181,"_30605":91,"_21201":50511,"_5":14582,"_27821":50266,"_3006":50512},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3550":182,"_30605":91,"_21201":50514,"_5":14582,"_27821":50266,"_3006":50515},[],"`--with-hsm`",{"_3550":183,"_30605":91,"_21201":50517,"_5":14582,"_27821":50266,"_3006":6671},[],{"_3550":184,"_30605":91,"_21201":50519,"_5":14582,"_27821":50266,"_3006":50520},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3550":185,"_30605":91,"_21201":50522,"_5":14582,"_27821":50266,"_3006":50523},[],"`--softhsm-chart-path`",{"_3550":186,"_30605":91,"_21201":50525,"_5":14582,"_27821":50266,"_3006":50526},[],"`./charts/softhsm`",{"_3550":187,"_30605":91,"_21201":50528,"_5":14582,"_27821":50266,"_3006":50529},[],"Use a different local SoftHSM chart",{"_3550":188,"_30605":91,"_21201":50531,"_5":14582,"_27821":50266,"_3006":50532},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3550":189,"_30605":91,"_21201":50534,"_5":14582,"_27821":50270,"_3006":50535},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3550":190,"_30605":91,"_21201":50537,"_5":14582,"_27821":50270,"_3006":50538},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3550":191,"_30605":91,"_21201":50540,"_5":14582,"_27821":50270,"_3006":50541},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3550":192,"_30605":91,"_21201":50543,"_5":14582,"_27821":50270,"_3006":50544},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3550":193,"_30605":91,"_21201":50546,"_5":14582,"_27821":50270,"_3006":50547},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3550":194,"_30605":91,"_21201":50549,"_5":14582,"_27821":50270,"_3006":50550},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3550":195,"_30605":91,"_21201":50552,"_5":14582,"_27821":50274,"_3006":50553},[],"Fastlane:",{"_3550":196,"_30605":91,"_21201":50555,"_5":14582,"_27821":50274,"_3006":50556},[],"validates local tools and the selected cluster",{"_3550":197,"_30605":91,"_21201":50558,"_5":14582,"_27821":50274,"_3006":50559},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3550":198,"_30605":91,"_21201":50561,"_5":14582,"_27821":50274,"_3006":50562},[],"creates the namespace",{"_3550":199,"_30605":91,"_21201":50564,"_5":14582,"_27821":50274,"_3006":50565},[],"installs PostgreSQL and creates the required databases",{"_3550":200,"_30605":91,"_21201":50567,"_5":14582,"_27821":50274,"_3006":50568},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3550":201,"_30605":91,"_21201":50570,"_5":14582,"_27821":50274,"_3006":50571},[],"installs RabbitMQ",{"_3550":202,"_30605":91,"_21201":50573,"_5":14582,"_27821":50274,"_3006":50574},[],"optionally installs observability and lab HSM components",{"_3550":203,"_30605":91,"_21201":50576,"_5":14582,"_27821":50274,"_3006":50577},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3550":204,"_30605":91,"_21201":50579,"_5":14582,"_27821":50274,"_3006":50580},[],"optionally loads sample data",{"_3550":205,"_30605":91,"_21201":50582,"_5":14582,"_27821":50274,"_3006":50583},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3550":206,"_30605":91,"_21201":50585,"_5":14582,"_27821":50278,"_3006":50586},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3550":207,"_30605":91,"_21201":50588,"_5":14582,"_27821":50278,"_3006":50589},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3550":208,"_30605":91,"_21201":50591,"_5":14582,"_27821":50282,"_3006":50592},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3550":209,"_30605":91,"_21201":50594,"_5":14582,"_27821":50282,"_3006":50595},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3550":210,"_30605":91,"_21201":50597,"_5":14582,"_27821":50282,"_3006":50598},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3550":211,"_30605":91,"_21201":50600,"_5":14582,"_27821":50286,"_3006":50601},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3550":212,"_30605":212,"_5":14934,"_3006":50603,"_30964":50604,"_21201":50605,"_27821":212},"Install with Helm",[49995,49996,50102],[],{"_3550":213,"_30605":212,"_21201":50607,"_5":14582,"_27821":212,"_3006":50608},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3550":214,"_30605":212,"_5":30961,"_21201":50610,"_27821":50611,"_3006":50612},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3550":215,"_30605":212,"_5":30961,"_21201":50614,"_27821":50615,"_3006":50005},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#before-you-begin",{"_3550":216,"_30605":212,"_5":30961,"_21201":50617,"_27821":50618,"_3006":50619},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3550":217,"_30605":212,"_5":30961,"_21201":50621,"_27821":50622,"_3006":50623},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3550":218,"_30605":212,"_5":30961,"_21201":50625,"_27821":50626,"_3006":50627},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3550":219,"_30605":212,"_5":30961,"_21201":50629,"_27821":50630,"_3006":50631},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3550":220,"_30605":212,"_5":30961,"_21201":50633,"_27821":50634,"_3006":50635},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3550":221,"_30605":212,"_5":30961,"_21201":50637,"_27821":50638,"_3006":50639},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3550":222,"_30605":212,"_5":30961,"_21201":50641,"_27821":50642,"_3006":50643},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3550":223,"_30605":212,"_5":30961,"_21201":50645,"_27821":50646,"_3006":50647},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3550":224,"_30605":212,"_5":30961,"_21201":50649,"_27821":50650,"_3006":50651},[],"/docs/pr-preview/pr-66/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3550":225,"_30605":212,"_21201":50653,"_5":14582,"_27821":50611,"_3006":50654},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3550":226,"_30605":212,"_21201":50656,"_5":14582,"_27821":50615,"_3006":50657},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3550":227,"_30605":212,"_21201":50659,"_5":14582,"_27821":50615,"_3006":50660},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3550":228,"_30605":212,"_21201":50662,"_5":14582,"_27821":50615,"_3006":50663},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3550":229,"_30605":212,"_21201":50665,"_5":14582,"_27821":50615,"_3006":50666},[],"a reachable RabbitMQ broker and credentials",{"_3550":230,"_30605":212,"_21201":50668,"_5":14582,"_27821":50615,"_3006":50669},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3550":231,"_30605":212,"_21201":50671,"_5":14582,"_27821":50615,"_3006":50672},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3550":232,"_30605":212,"_21201":50674,"_5":14582,"_27821":50615,"_3006":50675},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3550":233,"_30605":212,"_21201":50677,"_5":14582,"_27821":50615,"_3006":50678},[],"a StorageClass and an external traffic design",{"_3550":234,"_30605":212,"_21201":50680,"_5":14582,"_27821":50615,"_3006":50681},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3550":235,"_30605":212,"_21201":50683,"_5":14582,"_27821":50615,"_3006":50684},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3550":236,"_30605":212,"_21201":50686,"_5":14582,"_27821":50615,"_3006":50687},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3550":237,"_30605":212,"_21201":50689,"_5":14582,"_27821":50618,"_3006":50690},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3550":238,"_30605":212,"_21201":50692,"_5":14582,"_27821":50618,"_3006":50693},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3550":239,"_30605":212,"_21201":50695,"_5":14582,"_27821":50618,"_3006":50696},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3550":240,"_30605":212,"_21201":50698,"_5":14582,"_27821":50622,"_3006":50699},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3550":241,"_30605":212,"_21201":50701,"_5":14582,"_27821":50622,"_3006":50702},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3550":242,"_30605":212,"_21201":50704,"_5":14582,"_27821":50622,"_3006":50705},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3550":243,"_30605":212,"_21201":50707,"_5":14582,"_27821":50622,"_3006":50708},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3550":244,"_30605":212,"_21201":50710,"_5":14582,"_27821":50626,"_3006":50711},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3550":245,"_30605":212,"_21201":50713,"_5":14582,"_27821":50630,"_3006":50714},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3550":246,"_30605":212,"_21201":50716,"_5":14582,"_27821":50630,"_3006":50717},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3550":247,"_30605":212,"_21201":50719,"_5":14582,"_27821":50630,"_3006":50720},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3550":248,"_30605":212,"_21201":50722,"_5":14582,"_27821":50630,"_3006":50723},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3550":249,"_30605":212,"_21201":50725,"_5":14582,"_27821":50630,"_3006":50726},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3550":250,"_30605":212,"_21201":50728,"_5":14582,"_27821":50630,"_3006":50729},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3550":251,"_30605":212,"_21201":50731,"_5":14582,"_27821":50630,"_3006":50732},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3550":252,"_30605":212,"_21201":50734,"_5":14582,"_27821":50634,"_3006":50735},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3550":253,"_30605":212,"_21201":50737,"_5":14582,"_27821":50634,"_3006":50738},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3550":254,"_30605":212,"_21201":50740,"_5":14582,"_27821":50634,"_3006":50741},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3550":255,"_30605":212,"_21201":50743,"_5":14582,"_27821":50634,"_3006":50744},[],"See Access control for the principal and policy model.",{"_3550":256,"_30605":212,"_21201":50746,"_5":14582,"_27821":50638,"_3006":50747},[],"To install a local checkout instead:",{"_3550":257,"_30605":212,"_21201":50749,"_5":14582,"_27821":50642,"_3006":50750},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3550":258,"_30605":212,"_21201":50752,"_5":14582,"_27821":50642,"_3006":50753},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3550":259,"_30605":212,"_21201":50755,"_5":14582,"_27821":50646,"_3006":50756},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3550":260,"_30605":212,"_21201":50758,"_5":14582,"_27821":50646,"_3006":50759},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3550":261,"_30605":212,"_21201":50761,"_5":14582,"_27821":50646,"_3006":50762},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3550":262,"_30605":212,"_21201":50764,"_5":14582,"_27821":50646,"_3006":50765},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3550":263,"_30605":212,"_21201":50767,"_5":14582,"_27821":50646,"_3006":50768},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3550":264,"_30605":212,"_21201":50770,"_5":14582,"_27821":50650,"_3006":50771},[],"Before going live, review:",{"_3550":265,"_30605":212,"_21201":50773,"_5":14582,"_27821":50650,"_3006":50774},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3550":266,"_30605":212,"_21201":50776,"_5":14582,"_27821":50650,"_3006":50777},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3550":267,"_30605":212,"_21201":50779,"_5":14582,"_27821":50650,"_3006":50780},[],"shared VA storage before increasing VA replicas",{"_3550":268,"_30605":212,"_21201":50782,"_5":14582,"_27821":50650,"_3006":50783},[],"managed OIDC roles and removal of evaluation credentials",{"_3550":269,"_30605":212,"_21201":50785,"_5":14582,"_27821":50650,"_3006":50786},[],"a trusted TLS issuer or externally managed certificate",{"_3550":270,"_30605":212,"_21201":50788,"_5":14582,"_27821":50650,"_3006":50789},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3550":271,"_30605":212,"_21201":50791,"_5":14582,"_27821":50650,"_3006":50792},[],"SMTP, observability and alert delivery",{"_3550":272,"_30605":212,"_21201":50794,"_5":14582,"_27821":50650,"_3006":50795},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3550":273,"_30605":212,"_21201":50797,"_5":14582,"_27821":50650,"_3006":50798},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3550":274,"_30605":274,"_5":14934,"_3006":50800,"_30964":50801,"_21201":50802,"_27821":274},"Expose the Gateway",[49995,49996,50102],[],{"_3550":275,"_30605":274,"_21201":50804,"_5":14582,"_27821":274,"_3006":50805},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3550":276,"_30605":274,"_5":30961,"_21201":50807,"_27821":50808,"_3006":50809},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3550":277,"_30605":274,"_5":30961,"_21201":50811,"_27821":50812,"_3006":50813},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3550":278,"_30605":274,"_5":30961,"_21201":50815,"_27821":50816,"_3006":50817},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3550":279,"_30605":274,"_5":30961,"_21201":50819,"_27821":50820,"_3006":50821},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#k3s","K3s",{"_3550":280,"_30605":274,"_5":30961,"_21201":50823,"_27821":50824,"_3006":50825},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3550":281,"_30605":274,"_5":30961,"_21201":50827,"_27821":50828,"_3006":50829},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3550":282,"_30605":274,"_5":30961,"_21201":50831,"_27821":50832,"_3006":50833},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3550":283,"_30605":274,"_5":30961,"_21201":50835,"_27821":50836,"_3006":50837},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3550":284,"_30605":274,"_5":30961,"_21201":50839,"_27821":50840,"_3006":50841},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3550":285,"_30605":274,"_5":30961,"_21201":50843,"_27821":50844,"_3006":50845},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3550":286,"_30605":274,"_5":30961,"_21201":50847,"_27821":50848,"_3006":50849},[],"/docs/pr-preview/pr-66/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3550":287,"_30605":274,"_21201":50851,"_5":14582,"_27821":50808,"_3006":50852},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3550":288,"_30605":274,"_21201":50854,"_5":14582,"_27821":50808,"_3006":50855},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3550":289,"_30605":274,"_21201":50857,"_5":14582,"_27821":50812,"_3006":50858},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3550":290,"_30605":274,"_21201":50860,"_5":14582,"_27821":50812,"_3006":50861},[],"Set it only when:",{"_3550":291,"_30605":274,"_21201":50863,"_5":14582,"_27821":50812,"_3006":50864},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3550":292,"_30605":274,"_21201":50866,"_5":14582,"_27821":50812,"_3006":50867},[],"that address is allocated to this Gateway",{"_3550":293,"_30605":274,"_21201":50869,"_5":14582,"_27821":50812,"_3006":50870},[],"the surrounding network already routes traffic for it to the cluster",{"_3550":294,"_30605":274,"_21201":50872,"_5":14582,"_27821":50812,"_3006":50873},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3550":295,"_30605":274,"_21201":50875,"_5":14582,"_27821":50812,"_3006":50876},[],"Keep these two settings separate:",{"_3550":296,"_30605":274,"_21201":50878,"_5":14582,"_27821":50812,"_3006":50879},[],"`gateway.addresses` requests an address for the Gateway.",{"_3550":297,"_30605":274,"_21201":50881,"_5":14582,"_27821":50812,"_3006":50882},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3550":298,"_30605":274,"_21201":50884,"_5":14582,"_27821":50812,"_3006":50885},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3550":299,"_30605":274,"_21201":50887,"_5":14582,"_27821":50816,"_3006":50888},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3550":300,"_30605":274,"_21201":50890,"_5":14582,"_27821":50816,"_3006":50891},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3550":301,"_30605":274,"_21201":50893,"_5":14582,"_27821":50820,"_3006":50894},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3550":302,"_30605":274,"_21201":50896,"_5":14582,"_27821":50820,"_3006":50897},[],"For the recommended design:",{"_3550":303,"_30605":274,"_21201":50899,"_5":14582,"_27821":50820,"_3006":50900},[],"Use only one externally exposed Lamassu Gateway.",{"_3550":304,"_30605":274,"_21201":50902,"_5":14582,"_27821":50820,"_3006":50903},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3550":305,"_30605":274,"_21201":50905,"_5":14582,"_27821":50820,"_3006":50906},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3550":306,"_30605":274,"_21201":50908,"_5":14582,"_27821":50820,"_3006":50909},[],"Point DNS at the VM's reachable address.",{"_3550":307,"_30605":274,"_21201":50911,"_5":14582,"_27821":50820,"_3006":50912},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3550":308,"_30605":274,"_21201":50914,"_5":14582,"_27821":50824,"_3006":50915},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3550":309,"_30605":274,"_21201":50917,"_5":14582,"_27821":50828,"_3006":50918},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3550":310,"_30605":274,"_21201":50920,"_5":14582,"_27821":50828,"_3006":50921},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3550":311,"_30605":274,"_21201":50923,"_5":14582,"_27821":50832,"_3006":50924},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3550":312,"_30605":274,"_21201":50926,"_5":14582,"_27821":50832,"_3006":50927},[],"Requirement",{"_3550":313,"_30605":274,"_21201":50929,"_5":14582,"_27821":50832,"_3006":50930},[],"Recommended design",{"_3550":314,"_30605":274,"_21201":50932,"_5":14582,"_27821":50832,"_3006":50933},[],"Consequence",{"_3550":315,"_30605":274,"_21201":50935,"_5":14582,"_27821":50832,"_3006":50936},[],"Several Lamassu URLs or services",{"_3550":316,"_30605":274,"_21201":50938,"_5":14582,"_27821":50832,"_3006":50939},[],"One Gateway with multiple routes",{"_3550":317,"_30605":274,"_21201":50941,"_5":14582,"_27821":50832,"_3006":50942},[],"One IP and one proxy fleet; this is the chart default",{"_3550":318,"_30605":274,"_21201":50944,"_5":14582,"_27821":50832,"_3006":50945},[],"Independent Gateways and separate external IPs",{"_3550":319,"_30605":274,"_21201":50947,"_5":14582,"_27821":50832,"_3006":50948},[],"One VIP per Gateway",{"_3550":320,"_30605":274,"_21201":50950,"_5":14582,"_27821":50832,"_3006":50951},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3550":321,"_30605":274,"_21201":50953,"_5":14582,"_27821":50832,"_3006":50954},[],"Independent Gateways on one node and one IP",{"_3550":322,"_30605":274,"_21201":50956,"_5":14582,"_27821":50832,"_3006":50957},[],"Use different external ports",{"_3550":323,"_30605":274,"_21201":50959,"_5":14582,"_27821":50832,"_3006":50960},[],"Clients must include non-standard ports",{"_3550":324,"_30605":274,"_21201":50962,"_5":14582,"_27821":50832,"_3006":50963},[],"Separate TLS/mTLS termination behind one IP",{"_3550":325,"_30605":274,"_21201":50965,"_5":14582,"_27821":50832,"_3006":50966},[],"Front-door SNI routing to internal Gateways",{"_3550":326,"_30605":274,"_21201":50968,"_5":14582,"_27821":50832,"_3006":50969},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3550":327,"_30605":274,"_21201":50971,"_5":14582,"_27821":50832,"_3006":50972},[],"Separate Gateway resources but shared proxy infrastructure",{"_3550":328,"_30605":274,"_21201":50974,"_5":14582,"_27821":50832,"_3006":50975},[],"Envoy merged-Gateway mode",{"_3550":329,"_30605":274,"_21201":50977,"_5":14582,"_27821":50832,"_3006":50978},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3550":330,"_30605":274,"_21201":50980,"_5":14582,"_27821":50832,"_3006":50981},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3550":331,"_30605":274,"_21201":50983,"_5":14582,"_27821":50832,"_3006":50984},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3550":332,"_30605":274,"_21201":50986,"_5":14582,"_27821":50832,"_3006":50987},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3550":333,"_30605":274,"_21201":50989,"_5":14582,"_27821":50832,"_3006":50990},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3550":334,"_30605":274,"_21201":50992,"_5":14582,"_27821":50836,"_3006":50993},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3550":335,"_30605":274,"_21201":50995,"_5":14582,"_27821":50840,"_3006":50996},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3550":336,"_30605":274,"_21201":50998,"_5":14582,"_27821":50840,"_3006":50999},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3550":337,"_30605":274,"_21201":51001,"_5":14582,"_27821":50840,"_3006":51002},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3550":338,"_30605":274,"_21201":51004,"_5":14582,"_27821":50840,"_3006":51005},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3550":339,"_30605":274,"_21201":51007,"_5":14582,"_27821":50840,"_3006":51008},[],"If none of those are possible, use different external ports or change the external network design.",{"_3550":340,"_30605":274,"_21201":51010,"_5":14582,"_27821":50844,"_3006":51011},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3550":341,"_30605":274,"_21201":51013,"_5":14582,"_27821":50844,"_3006":51014},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3550":342,"_30605":274,"_21201":51016,"_5":14582,"_27821":50848,"_3006":51017},[],"Check, in order:",{"_3550":343,"_30605":274,"_21201":51019,"_5":14582,"_27821":50848,"_3006":51020},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3550":344,"_30605":274,"_21201":51022,"_5":14582,"_27821":50848,"_3006":51023},[],"Its status contains the expected address.",{"_3550":345,"_30605":274,"_21201":51025,"_5":14582,"_27821":50848,"_3006":51026},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3550":346,"_30605":274,"_21201":51028,"_5":14582,"_27821":50848,"_3006":51029},[],"Port 443 reaches that address from the client network.",{"_3550":347,"_30605":274,"_21201":51031,"_5":14582,"_27821":50848,"_3006":51032},[],"DNS resolves to the externally reachable endpoint.",{"_3550":348,"_30605":274,"_21201":51034,"_5":14582,"_27821":50848,"_3006":51035},[],"The certificate contains the DNS name or IP used by the client.",{"_3550":349,"_30605":274,"_21201":51037,"_5":14582,"_27821":50848,"_3006":51038},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3550":350,"_30605":350,"_5":14934,"_3006":50102,"_30964":51040,"_21201":51041,"_27821":350},[49995,49996,50102],[],{"_3550":351,"_30605":350,"_21201":51043,"_5":14582,"_27821":350,"_3006":51044},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3550":352,"_30605":350,"_5":30961,"_21201":51046,"_27821":51047,"_3006":51048},[],"/docs/pr-preview/pr-66/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3550":353,"_30605":350,"_5":30961,"_21201":51050,"_27821":51051,"_3006":51052},[],"/docs/pr-preview/pr-66/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3550":354,"_30605":350,"_5":30961,"_21201":51054,"_27821":51055,"_3006":51056},[],"/docs/pr-preview/pr-66/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3550":355,"_30605":350,"_5":30961,"_21201":51058,"_27821":51059,"_3006":51060},[],"/docs/pr-preview/pr-66/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3550":356,"_30605":350,"_5":30961,"_21201":51062,"_27821":51063,"_3006":51064},[],"/docs/pr-preview/pr-66/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3550":357,"_30605":350,"_5":30961,"_21201":51066,"_27821":51067,"_3006":51068},[],"/docs/pr-preview/pr-66/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3550":358,"_30605":350,"_21201":51070,"_5":14582,"_27821":51047,"_3006":51071},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3550":359,"_30605":350,"_21201":51073,"_5":14582,"_27821":51051,"_3006":51074},[],"Workflow",{"_3550":360,"_30605":350,"_21201":51076,"_5":14582,"_27821":51051,"_3006":51077},[],"Use it for",{"_3550":361,"_30605":350,"_21201":51079,"_5":14582,"_27821":51051,"_3006":51080},[],"What it installs",{"_3550":362,"_30605":350,"_21201":51082,"_5":14582,"_27821":51051,"_3006":51083},[],"Helm",{"_3550":363,"_30605":350,"_21201":51085,"_5":14582,"_27821":51051,"_3006":51086},[],"Production and controlled environments",{"_3550":364,"_30605":350,"_21201":51088,"_5":14582,"_27821":51051,"_3006":51089},[],"Lamassu services and Gateway API resources",{"_3550":365,"_30605":350,"_21201":51091,"_5":14582,"_27821":51051,"_3006":50239},[],{"_3550":366,"_30605":350,"_21201":51093,"_5":14582,"_27821":51051,"_3006":51094},[],"Evaluation, demos, CI and small lab clusters",{"_3550":367,"_30605":350,"_21201":51096,"_5":14582,"_27821":51051,"_3006":51097},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3550":368,"_30605":350,"_21201":51099,"_5":14582,"_27821":51055,"_3006":51100},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3550":369,"_30605":350,"_21201":51102,"_5":14582,"_27821":51055,"_3006":51103},[],"Area",{"_3550":370,"_30605":350,"_21201":51105,"_5":14582,"_27821":51055,"_3006":51106},[],"The Lamassu chart provides",{"_3550":371,"_30605":350,"_21201":51108,"_5":14582,"_27821":51055,"_3006":51109},[],"You provide",{"_3550":372,"_30605":350,"_21201":51111,"_5":14582,"_27821":51055,"_3006":51112},[],"Lamassu applications",{"_3550":373,"_30605":350,"_21201":51114,"_5":14582,"_27821":51055,"_3006":51115},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3550":374,"_30605":350,"_21201":51117,"_5":14582,"_27821":51055,"_3006":51118},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3550":375,"_30605":350,"_21201":51120,"_5":14582,"_27821":51055,"_3006":51121},[],"PostgreSQL data",{"_3550":376,"_30605":350,"_21201":51123,"_5":14582,"_27821":51055,"_3006":51124},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3550":377,"_30605":350,"_21201":51126,"_5":14582,"_27821":51055,"_3006":51127},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3550":378,"_30605":350,"_21201":51129,"_5":14582,"_27821":51055,"_3006":51130},[],"Messaging",{"_3550":379,"_30605":350,"_21201":51132,"_5":14582,"_27821":51055,"_3006":51133},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3550":380,"_30605":350,"_21201":51135,"_5":14582,"_27821":51055,"_3006":51136},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3550":381,"_30605":350,"_21201":51138,"_5":14582,"_27821":51055,"_3006":51139},[],"Identity",{"_3550":382,"_30605":350,"_21201":51141,"_5":14582,"_27821":51055,"_3006":51142},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3550":383,"_30605":350,"_21201":51144,"_5":14582,"_27821":51055,"_3006":51145},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3550":384,"_30605":350,"_21201":51147,"_5":14582,"_27821":51055,"_3006":51148},[],"External routing",{"_3550":385,"_30605":350,"_21201":51150,"_5":14582,"_27821":51055,"_3006":51151},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3550":386,"_30605":350,"_21201":51153,"_5":14582,"_27821":51055,"_3006":51154},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3550":387,"_30605":350,"_21201":51156,"_5":14582,"_27821":51055,"_3006":51157},[],"TLS",{"_3550":388,"_30605":350,"_21201":51159,"_5":14582,"_27821":51055,"_3006":51160},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3550":389,"_30605":350,"_21201":51162,"_5":14582,"_27821":51055,"_3006":51163},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3550":390,"_30605":350,"_21201":51165,"_5":14582,"_27821":51055,"_3006":51166},[],"Persistent application data",{"_3550":391,"_30605":350,"_21201":51168,"_5":14582,"_27821":51055,"_3006":51169},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3550":392,"_30605":350,"_21201":51171,"_5":14582,"_27821":51055,"_3006":51172},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3550":393,"_30605":350,"_21201":51174,"_5":14582,"_27821":51055,"_3006":51175},[],"Optional integrations",{"_3550":394,"_30605":350,"_21201":51177,"_5":14582,"_27821":51055,"_3006":51178},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3550":395,"_30605":350,"_21201":51180,"_5":14582,"_27821":51055,"_3006":51181},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3550":396,"_30605":350,"_21201":51183,"_5":14582,"_27821":51055,"_3006":51184},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3550":397,"_30605":350,"_21201":51186,"_5":14582,"_27821":51055,"_3006":51187},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3550":398,"_30605":350,"_21201":51189,"_5":14582,"_27821":51059,"_3006":51190},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3550":399,"_30605":350,"_21201":51192,"_5":14582,"_27821":51059,"_3006":51193},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3550":400,"_30605":350,"_21201":51195,"_5":14582,"_27821":51063,"_3006":51196},[],"Kubernetes 1.24 or newer",{"_3550":401,"_30605":350,"_21201":51198,"_5":14582,"_27821":51063,"_3006":51199},[],"Helm 3.2 or newer",{"_3550":402,"_30605":350,"_21201":51201,"_5":14582,"_27821":51063,"_3006":51202},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3550":403,"_30605":350,"_21201":51204,"_5":14582,"_27821":51063,"_3006":51205},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3550":404,"_30605":350,"_21201":51207,"_5":14582,"_27821":51063,"_3006":51208},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3550":405,"_30605":350,"_21201":51210,"_5":14582,"_27821":51063,"_3006":51211},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3550":406,"_30605":350,"_21201":51213,"_5":14582,"_27821":51063,"_3006":51214},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3550":407,"_30605":350,"_21201":51216,"_5":14582,"_27821":51067,"_3006":51217},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3550":408,"_30605":350,"_21201":51219,"_5":14582,"_27821":51067,"_3006":51220},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3550":409,"_30605":350,"_21201":51222,"_5":14582,"_27821":51067,"_3006":51223},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3550":410,"_30605":350,"_21201":51225,"_5":14582,"_27821":51067,"_3006":51226},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3550":411,"_30605":411,"_5":14934,"_3006":51228,"_30964":51229,"_21201":51231,"_27821":411},"Deployment troubleshooting",[49995,49996,51230],"Operations",[],{"_3550":412,"_30605":411,"_21201":51233,"_5":14582,"_27821":411,"_3006":51234},[],"Diagnose access, service health and infrastructure dependencies.",{"_3550":413,"_30605":411,"_5":30961,"_21201":51236,"_27821":51237,"_3006":51238},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3550":414,"_30605":411,"_5":30961,"_21201":51240,"_27821":51241,"_3006":51242},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3550":415,"_30605":411,"_5":30961,"_21201":51244,"_27821":51245,"_3006":51246},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3550":416,"_30605":411,"_5":30961,"_21201":51248,"_27821":51249,"_3006":51250},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3550":417,"_30605":411,"_5":30961,"_21201":51252,"_27821":51253,"_3006":51254},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3550":418,"_30605":411,"_5":30961,"_21201":51256,"_27821":51257,"_3006":51258},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3550":419,"_30605":411,"_5":30961,"_21201":51260,"_27821":51261,"_3006":51262},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3550":420,"_30605":411,"_5":30961,"_21201":51264,"_27821":51265,"_3006":51266},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3550":421,"_30605":411,"_5":30961,"_21201":51268,"_27821":51269,"_3006":51270},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3550":422,"_30605":411,"_5":30961,"_21201":51272,"_27821":51273,"_3006":51274},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3550":423,"_30605":411,"_5":30961,"_21201":51276,"_27821":51277,"_3006":51278},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3550":424,"_30605":411,"_5":30961,"_21201":51280,"_27821":51281,"_3006":51282},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3550":425,"_30605":411,"_5":30961,"_21201":51284,"_27821":51285,"_3006":51286},[],"/docs/pr-preview/pr-66/deployment/troubleshooting#observability","Observability",{"_3550":426,"_30605":411,"_21201":51288,"_5":14582,"_27821":411,"_3006":51289},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3550":427,"_30605":411,"_21201":51291,"_5":14582,"_27821":51241,"_3006":51292},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3550":428,"_30605":411,"_21201":51294,"_5":14582,"_27821":51245,"_3006":51295},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3550":429,"_30605":411,"_21201":51297,"_5":14582,"_27821":51249,"_3006":51298},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3550":430,"_30605":411,"_21201":51300,"_5":14582,"_27821":51253,"_3006":51301},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3550":431,"_30605":411,"_21201":51303,"_5":14582,"_27821":51257,"_3006":51304},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3550":432,"_30605":411,"_21201":51306,"_5":14582,"_27821":51261,"_3006":51307},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3550":433,"_30605":411,"_21201":51309,"_5":14582,"_27821":51261,"_3006":51310},[],"Also run the chart's connectivity test:",{"_3550":434,"_30605":411,"_21201":51312,"_5":14582,"_27821":51261,"_3006":51313},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3550":435,"_30605":411,"_21201":51315,"_5":14582,"_27821":51261,"_3006":51316},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3550":436,"_30605":411,"_21201":51318,"_5":14582,"_27821":51265,"_3006":51319},[],"If you receive a 401:",{"_3550":437,"_30605":411,"_21201":51321,"_5":14582,"_27821":51265,"_3006":51322},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3550":438,"_30605":411,"_21201":51324,"_5":14582,"_27821":51265,"_3006":51325},[],"verify issuer, audience and expiration of the token;",{"_3550":439,"_30605":411,"_21201":51327,"_5":14582,"_27821":51265,"_3006":51328},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3550":440,"_30605":411,"_21201":51330,"_5":14582,"_27821":51265,"_3006":51331},[],"check that the provider's public and internal routes point to the same realm.",{"_3550":441,"_30605":411,"_21201":51333,"_5":14582,"_27821":51265,"_3006":51334},[],"If login succeeds but the APIs return 403:",{"_3550":442,"_30605":411,"_21201":51336,"_5":14582,"_27821":51265,"_3006":51337},[],"inspect the token's real claims;",{"_3550":443,"_30605":411,"_21201":51339,"_5":14582,"_27821":51265,"_3006":51340},[],"confirm they match an active principal;",{"_3550":444,"_30605":411,"_21201":51342,"_5":14582,"_27821":51265,"_3006":51343},[],"review the policies granted to that principal;",{"_3550":445,"_30605":411,"_21201":51345,"_5":14582,"_27821":51265,"_3006":51346},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3550":446,"_30605":411,"_21201":51348,"_5":14582,"_27821":51265,"_3006":51349},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3550":447,"_30605":411,"_21201":51351,"_5":14582,"_27821":51269,"_3006":51352},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3550":448,"_30605":411,"_21201":51354,"_5":14582,"_27821":51269,"_3006":51355},[],"Locate the authz pod and Service.",{"_3550":449,"_30605":411,"_21201":51357,"_5":14582,"_27821":51269,"_3006":51358},[],"Check /health, logs and its database connection.",{"_3550":450,"_30605":411,"_21201":51360,"_5":14582,"_27821":51269,"_3006":51361},[],"Verify the DNS and port configured in externalAuthorization.",{"_3550":451,"_30605":411,"_21201":51363,"_5":14582,"_27821":51269,"_3006":51364},[],"Check the check route is /v1/ext\\_authz/check.",{"_3550":452,"_30605":411,"_21201":51366,"_5":14582,"_27821":51269,"_3006":51367},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3550":453,"_30605":411,"_21201":51369,"_5":14582,"_27821":51273,"_3006":51370},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3550":454,"_30605":411,"_21201":51372,"_5":14582,"_27821":51277,"_3006":51373},[],"Review kubectl describe pod first. Common causes are:",{"_3550":455,"_30605":411,"_21201":51375,"_5":14582,"_27821":51277,"_3006":51376},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3550":456,"_30605":411,"_21201":51378,"_5":14582,"_27821":51277,"_3006":51379},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3550":457,"_30605":411,"_21201":51381,"_5":14582,"_27821":51277,"_3006":51382},[],"unbound persistent volume;",{"_3550":458,"_30605":411,"_21201":51384,"_5":14582,"_27821":51277,"_3006":51385},[],"inaccessible image or incorrect pull policy;",{"_3550":459,"_30605":411,"_21201":51387,"_5":14582,"_27821":51277,"_3006":51388},[],"invalid cryptographic engine configuration;",{"_3550":460,"_30605":411,"_21201":51390,"_5":14582,"_27821":51277,"_3006":51391},[],"CPU or memory limits set too low;",{"_3550":461,"_30605":411,"_21201":51393,"_5":14582,"_27821":51277,"_3006":51394},[],"an incomplete prior migration.",{"_3550":462,"_30605":411,"_21201":51396,"_5":14582,"_27821":51277,"_3006":51397},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3550":463,"_30605":411,"_21201":51399,"_5":14582,"_27821":51277,"_3006":51400},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3550":464,"_30605":411,"_21201":51402,"_5":14582,"_27821":51277,"_3006":51403},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3550":465,"_30605":411,"_21201":51405,"_5":14582,"_27821":51281,"_3006":51406},[],"Domain and audit events depend on the bus publisher:",{"_3550":466,"_30605":411,"_21201":51408,"_5":14582,"_27821":51281,"_3006":51409},[],"verify it is enabled in the emitting service;",{"_3550":467,"_30605":411,"_21201":51411,"_5":14582,"_27821":51281,"_3006":51412},[],"check AMQP connectivity and credentials;",{"_3550":468,"_30605":411,"_21201":51414,"_5":14582,"_27821":51281,"_3006":51415},[],"review exchange, routing key, queues and consumers;",{"_3550":469,"_30605":411,"_21201":51417,"_5":14582,"_27821":51281,"_3006":51418},[],"inspect dead-letter queues;",{"_3550":470,"_30605":411,"_21201":51420,"_5":14582,"_27821":51281,"_3006":51421},[],"alert on orphan durable queues and backlog growth.",{"_3550":471,"_30605":411,"_21201":51423,"_5":14582,"_27821":51281,"_3006":51424},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3550":472,"_30605":411,"_21201":51426,"_5":14582,"_27821":51281,"_3006":51427},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3550":473,"_30605":411,"_21201":51429,"_5":14582,"_27821":51281,"_3006":51430},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3550":474,"_30605":411,"_21201":51432,"_5":14582,"_27821":51281,"_3006":51433},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3550":475,"_30605":411,"_21201":51435,"_5":14582,"_27821":51281,"_3006":51436},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3550":476,"_30605":411,"_21201":51438,"_5":14582,"_27821":51281,"_3006":51439},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3550":477,"_30605":411,"_21201":51441,"_5":14582,"_27821":51281,"_3006":51442},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3550":478,"_30605":411,"_21201":51444,"_5":14582,"_27821":51285,"_3006":51445},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3550":479,"_30605":411,"_21201":51447,"_5":14582,"_27821":51285,"_3006":51448},[],"Before closing an incident, record:",{"_3550":480,"_30605":411,"_21201":51450,"_5":14582,"_27821":51285,"_3006":51451},[],"the confirmed cause;",{"_3550":481,"_30605":411,"_21201":51453,"_5":14582,"_27821":51285,"_3006":51454},[],"the time scope and affected resources;",{"_3550":482,"_30605":411,"_21201":51456,"_5":14582,"_27821":51285,"_3006":51457},[],"the commands or queries used;",{"_3550":483,"_30605":411,"_21201":51459,"_5":14582,"_27821":51285,"_3006":51460},[],"the applied change and how to revert it;",{"_3550":484,"_30605":411,"_21201":51462,"_5":14582,"_27821":51285,"_3006":51463},[],"validation from a consumer;",{"_3550":485,"_30605":411,"_21201":51465,"_5":14582,"_27821":51285,"_3006":51466},[],"the preventive action and its owner.",{"_3550":486,"_30605":486,"_5":14934,"_3006":51468,"_30964":51469,"_21201":51473,"_27821":486},"Data model",[49995,51470,51471,51472],"Platform","Administration","Access control",[],{"_3550":487,"_30605":486,"_21201":51475,"_5":14582,"_27821":486,"_3006":51476},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3550":488,"_30605":486,"_5":30961,"_21201":51478,"_27821":51479,"_3006":51480},[],"/docs/pr-preview/pr-66/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3550":489,"_30605":486,"_5":30961,"_21201":51482,"_27821":51483,"_3006":51484},[],"/docs/pr-preview/pr-66/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3550":490,"_30605":486,"_21201":51486,"_5":14582,"_27821":486,"_3006":51487},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3550":491,"_30605":486,"_21201":51489,"_5":14582,"_27821":51479,"_3006":51490},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3550":492,"_30605":486,"_21201":51492,"_5":14582,"_27821":51479,"_3006":51493},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3550":493,"_30605":486,"_21201":51495,"_5":14582,"_27821":51479,"_3006":51496},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3550":494,"_30605":486,"_21201":51498,"_5":14582,"_27821":51483,"_3006":51499},[],"Entity (`schema_name.entity_type`)",{"_3550":495,"_30605":486,"_21201":51501,"_5":14582,"_27821":51483,"_3006":51502},[],"Table (`table_name`)",{"_3550":496,"_30605":486,"_21201":51504,"_5":14582,"_27821":51483,"_3006":51505},[],"Key (`primary_key`)",{"_3550":497,"_30605":486,"_21201":51507,"_5":14582,"_27821":51483,"_3006":51508},[],"`alerts.event`",{"_3550":498,"_30605":486,"_21201":51510,"_5":14582,"_27821":51483,"_3006":51511},[],"`events`",{"_3550":499,"_30605":486,"_21201":51513,"_5":14582,"_27821":51483,"_3006":51514},[],"`event_type`",{"_3550":500,"_30605":486,"_21201":51516,"_5":14582,"_27821":51483,"_3006":51517},[],"`alerts.subscription`",{"_3550":501,"_30605":486,"_21201":51519,"_5":14582,"_27821":51483,"_3006":51520},[],"`subscriptions`",{"_3550":502,"_30605":486,"_21201":51522,"_5":14582,"_27821":51483,"_3006":51523},[],"`id`",{"_3550":503,"_30605":486,"_21201":51525,"_5":14582,"_27821":51483,"_3006":51526},[],"`ca.ca_certificate`",{"_3550":504,"_30605":486,"_21201":51528,"_5":14582,"_27821":51483,"_3006":51529},[],"`ca_certificates`",{"_3550":505,"_30605":486,"_21201":51531,"_5":14582,"_27821":51483,"_3006":51523},[],{"_3550":506,"_30605":486,"_21201":51533,"_5":14582,"_27821":51483,"_3006":51534},[],"`ca.certificate`",{"_3550":507,"_30605":486,"_21201":51536,"_5":14582,"_27821":51483,"_3006":51537},[],"`certificates`",{"_3550":508,"_30605":486,"_21201":51539,"_5":14582,"_27821":51483,"_3006":51540},[],"`serial_number`",{"_3550":509,"_30605":486,"_21201":51542,"_5":14582,"_27821":51483,"_3006":51543},[],"`ca.issuance_profile`",{"_3550":510,"_30605":486,"_21201":51545,"_5":14582,"_27821":51483,"_3006":51546},[],"`issuance_profiles`",{"_3550":511,"_30605":486,"_21201":51548,"_5":14582,"_27821":51483,"_3006":51523},[],{"_3550":512,"_30605":486,"_21201":51550,"_5":14582,"_27821":51483,"_3006":51551},[],"`devicemanager.device_group`",{"_3550":513,"_30605":486,"_21201":51553,"_5":14582,"_27821":51483,"_3006":51554},[],"`device_groups`",{"_3550":514,"_30605":486,"_21201":51556,"_5":14582,"_27821":51483,"_3006":51523},[],{"_3550":515,"_30605":486,"_21201":51558,"_5":14582,"_27821":51483,"_3006":51559},[],"`devicemanager.device`",{"_3550":516,"_30605":486,"_21201":51561,"_5":14582,"_27821":51483,"_3006":51562},[],"`devices`",{"_3550":517,"_30605":486,"_21201":51564,"_5":14582,"_27821":51483,"_3006":51523},[],{"_3550":518,"_30605":486,"_21201":51566,"_5":14582,"_27821":51483,"_3006":51567},[],"`dmsmanager.dms`",{"_3550":519,"_30605":486,"_21201":51569,"_5":14582,"_27821":51483,"_3006":51570},[],"`dms`",{"_3550":520,"_30605":486,"_21201":51572,"_5":14582,"_27821":51483,"_3006":51523},[],{"_3550":521,"_30605":486,"_21201":51574,"_5":14582,"_27821":51483,"_3006":51575},[],"`kms.kms_key`",{"_3550":522,"_30605":486,"_21201":51577,"_5":14582,"_27821":51483,"_3006":51578},[],"`kms_keys`",{"_3550":523,"_30605":486,"_21201":51580,"_5":14582,"_27821":51483,"_3006":51581},[],"`key_id`, `engine_id`",{"_3550":524,"_30605":486,"_21201":51583,"_5":14582,"_27821":51483,"_3006":51584},[],"`va.crl_settings`",{"_3550":525,"_30605":486,"_21201":51586,"_5":14582,"_27821":51483,"_3006":51587},[],"`crl_settings`",{"_3550":526,"_30605":486,"_21201":51589,"_5":14582,"_27821":51483,"_3006":51590},[],"`ca_id`",{"_3550":527,"_30605":486,"_21201":51592,"_5":14582,"_27821":51483,"_3006":51593},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3550":528,"_30605":486,"_21201":51595,"_5":14582,"_27821":51483,"_3006":51596},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3550":529,"_30605":486,"_21201":51598,"_5":14582,"_27821":51483,"_3006":51599},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3550":530,"_30605":530,"_5":14934,"_3006":51601,"_30964":51602,"_21201":51603,"_27821":530},"Access control overview",[49995,51470,51471,51472],[],{"_3550":531,"_30605":530,"_21201":51605,"_5":14582,"_27821":530,"_3006":51606},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3550":532,"_30605":530,"_5":30961,"_21201":51608,"_27821":51609,"_3006":51610},[],"/docs/pr-preview/pr-66/platform/administration/access-control#essential-concepts","Essential concepts",{"_3550":533,"_30605":530,"_5":30961,"_21201":51612,"_27821":51613,"_3006":51614},[],"/docs/pr-preview/pr-66/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3550":534,"_30605":530,"_5":30961,"_21201":51616,"_27821":51617,"_3006":51618},[],"/docs/pr-preview/pr-66/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3550":535,"_30605":530,"_5":30961,"_21201":51620,"_27821":51621,"_3006":51622},[],"/docs/pr-preview/pr-66/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3550":536,"_30605":530,"_5":30961,"_21201":51624,"_27821":51625,"_3006":51626},[],"/docs/pr-preview/pr-66/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3550":537,"_30605":530,"_5":30961,"_21201":51628,"_27821":51629,"_3006":51630},[],"/docs/pr-preview/pr-66/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3550":538,"_30605":530,"_5":30961,"_21201":51632,"_27821":51633,"_3006":51634},[],"/docs/pr-preview/pr-66/platform/administration/access-control#oidc-principals","OIDC principals",{"_3550":539,"_30605":530,"_5":30961,"_21201":51636,"_27821":51637,"_3006":51638},[],"/docs/pr-preview/pr-66/platform/administration/access-control#x509-principals","X.509 principals",{"_3550":540,"_30605":530,"_5":30961,"_21201":51640,"_27821":51641,"_3006":51642},[],"/docs/pr-preview/pr-66/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3550":541,"_30605":530,"_5":30961,"_21201":51644,"_27821":51645,"_3006":51646},[],"/docs/pr-preview/pr-66/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3550":542,"_30605":530,"_5":30961,"_21201":51648,"_27821":51649,"_3006":51650},[],"/docs/pr-preview/pr-66/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3550":543,"_30605":530,"_5":30961,"_21201":51652,"_27821":51653,"_3006":51654},[],"/docs/pr-preview/pr-66/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3550":544,"_30605":530,"_5":30961,"_21201":51656,"_27821":51657,"_3006":51658},[],"/docs/pr-preview/pr-66/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3550":545,"_30605":530,"_5":30961,"_21201":51660,"_27821":51661,"_3006":51662},[],"/docs/pr-preview/pr-66/platform/administration/access-control#http-rules","HTTP rules",{"_3550":546,"_30605":530,"_5":30961,"_21201":51664,"_27821":51665,"_3006":51666},[],"/docs/pr-preview/pr-66/platform/administration/access-control#included-policies","Included policies",{"_3550":547,"_30605":530,"_5":30961,"_21201":51668,"_27821":51669,"_3006":50635},[],"/docs/pr-preview/pr-66/platform/administration/access-control#provision-the-first-administrator",{"_3550":548,"_30605":530,"_5":30961,"_21201":51671,"_27821":51672,"_3006":51673},[],"/docs/pr-preview/pr-66/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3550":549,"_30605":530,"_5":30961,"_21201":51675,"_27821":51676,"_3006":51677},[],"/docs/pr-preview/pr-66/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3550":550,"_30605":530,"_5":30961,"_21201":51679,"_27821":51680,"_3006":51681},[],"/docs/pr-preview/pr-66/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3550":551,"_30605":530,"_5":30961,"_21201":51683,"_27821":51684,"_3006":51685},[],"/docs/pr-preview/pr-66/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3550":552,"_30605":530,"_5":30961,"_21201":51687,"_27821":51688,"_3006":51689},[],"/docs/pr-preview/pr-66/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3550":553,"_30605":530,"_5":30961,"_21201":51691,"_27821":51692,"_3006":51693},[],"/docs/pr-preview/pr-66/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3550":554,"_30605":530,"_5":30961,"_21201":51695,"_27821":51696,"_3006":51697},[],"/docs/pr-preview/pr-66/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3550":555,"_30605":530,"_5":30961,"_21201":51699,"_27821":51700,"_3006":51701},[],"/docs/pr-preview/pr-66/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3550":556,"_30605":530,"_5":30961,"_21201":51703,"_27821":51704,"_3006":51705},[],"/docs/pr-preview/pr-66/platform/administration/access-control#operational-checklist","Operational checklist",{"_3550":557,"_30605":530,"_5":30961,"_21201":51707,"_27821":51708,"_3006":51709},[],"/docs/pr-preview/pr-66/platform/administration/access-control#diagnostics","Diagnostics",{"_3550":558,"_30605":530,"_5":30961,"_21201":51711,"_27821":51712,"_3006":51713},[],"/docs/pr-preview/pr-66/platform/administration/access-control#the-response-is-401","The response is 401",{"_3550":559,"_30605":530,"_5":30961,"_21201":51715,"_27821":51716,"_3006":51717},[],"/docs/pr-preview/pr-66/platform/administration/access-control#the-response-is-403","The response is 403",{"_3550":560,"_30605":530,"_5":30961,"_21201":51719,"_27821":51720,"_3006":51721},[],"/docs/pr-preview/pr-66/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3550":561,"_30605":530,"_5":30961,"_21201":51723,"_27821":51724,"_3006":51725},[],"/docs/pr-preview/pr-66/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3550":562,"_30605":530,"_5":30961,"_21201":51727,"_27821":51728,"_3006":51729},[],"/docs/pr-preview/pr-66/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3550":563,"_30605":530,"_21201":51731,"_5":14582,"_27821":530,"_3006":51732},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3550":564,"_30605":530,"_21201":51734,"_5":14582,"_27821":530,"_3006":51735},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3550":565,"_30605":530,"_21201":51737,"_5":14582,"_27821":530,"_3006":51738},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3550":566,"_30605":530,"_21201":51740,"_5":14582,"_27821":51609,"_3006":51741},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3550":567,"_30605":530,"_21201":51743,"_5":14582,"_27821":51609,"_3006":51744},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3550":568,"_30605":530,"_21201":51746,"_5":14582,"_27821":51609,"_3006":51747},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3550":569,"_30605":530,"_21201":51749,"_5":14582,"_27821":51609,"_3006":51750},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3550":570,"_30605":530,"_21201":51752,"_5":14582,"_27821":51609,"_3006":51753},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3550":571,"_30605":530,"_21201":51755,"_5":14582,"_27821":51609,"_3006":51756},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3550":572,"_30605":530,"_21201":51758,"_5":14582,"_27821":51613,"_3006":51759},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3550":573,"_30605":530,"_21201":51761,"_5":14582,"_27821":51613,"_3006":51762},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3550":574,"_30605":530,"_21201":51764,"_5":14582,"_27821":51617,"_3006":51765},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3550":575,"_30605":530,"_21201":51767,"_5":14582,"_27821":51617,"_3006":51768},[],"The decision is made **before forwarding the request to the service**:",{"_3550":576,"_30605":530,"_21201":51770,"_5":14582,"_27821":51617,"_3006":51771},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3550":577,"_30605":530,"_21201":51773,"_5":14582,"_27821":51617,"_3006":51774},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3550":578,"_30605":530,"_21201":51776,"_5":14582,"_27821":51617,"_3006":51777},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3550":579,"_30605":530,"_21201":51779,"_5":14582,"_27821":51617,"_3006":51780},[],"It separately loads the policies granted to each principal.",{"_3550":580,"_30605":530,"_21201":51782,"_5":14582,"_27821":51617,"_3006":51783},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3550":581,"_30605":530,"_21201":51785,"_5":14582,"_27821":51617,"_3006":51786},[],"`authz` looks for an HTTP rule granting that action.",{"_3550":582,"_30605":530,"_21201":51788,"_5":14582,"_27821":51617,"_3006":51789},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3550":583,"_30605":530,"_21201":51791,"_5":14582,"_27821":51617,"_3006":51792},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3550":584,"_30605":530,"_21201":51794,"_5":14582,"_27821":51617,"_3006":51795},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3550":585,"_30605":530,"_21201":51797,"_5":14582,"_27821":51617,"_3006":51798},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3550":586,"_30605":530,"_21201":51800,"_5":14582,"_27821":51621,"_3006":51801},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3550":587,"_30605":530,"_21201":51803,"_5":14582,"_27821":51621,"_3006":51804},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3550":588,"_30605":530,"_21201":51806,"_5":14582,"_27821":51621,"_3006":51807},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3550":589,"_30605":530,"_21201":51809,"_5":14582,"_27821":51621,"_3006":51810},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3550":590,"_30605":530,"_21201":51812,"_5":14582,"_27821":51621,"_3006":51813},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3550":591,"_30605":530,"_21201":51815,"_5":14582,"_27821":51621,"_3006":51816},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3550":592,"_30605":530,"_21201":51818,"_5":14582,"_27821":51621,"_3006":51819},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3550":593,"_30605":530,"_21201":51821,"_5":14582,"_27821":51621,"_3006":51822},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3550":594,"_30605":530,"_21201":51824,"_5":14582,"_27821":51625,"_3006":51825},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3550":595,"_30605":530,"_21201":51827,"_5":14582,"_27821":51625,"_3006":51828},[],"The decision is made with the domain operation context:",{"_3550":596,"_30605":530,"_21201":51830,"_5":14582,"_27821":51625,"_3006":51831},[],"The middleware extracts the credential and resolves the matching principals.",{"_3550":597,"_30605":530,"_21201":51833,"_5":14582,"_27821":51625,"_3006":51834},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3550":598,"_30605":530,"_21201":51836,"_5":14582,"_27821":51625,"_3006":51837},[],"`authz` gathers the entity rules of the granted policies.",{"_3550":599,"_30605":530,"_21201":51839,"_5":14582,"_27821":51625,"_3006":51840},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3550":600,"_30605":530,"_21201":51842,"_5":14582,"_27821":51625,"_3006":51843},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3550":601,"_30605":530,"_21201":51845,"_5":14582,"_27821":51625,"_3006":51846},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3550":602,"_30605":530,"_21201":51848,"_5":14582,"_27821":51625,"_3006":51849},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3550":603,"_30605":530,"_21201":51851,"_5":14582,"_27821":51625,"_3006":51852},[],"Actions fall into two groups:",{"_3550":604,"_30605":530,"_21201":51854,"_5":14582,"_27821":51625,"_3006":51855},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3550":605,"_30605":530,"_21201":51857,"_5":14582,"_27821":51625,"_3006":51858},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3550":606,"_30605":530,"_21201":51860,"_5":14582,"_27821":51625,"_3006":51861},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3550":607,"_30605":530,"_21201":51863,"_5":14582,"_27821":51629,"_3006":51864},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3550":608,"_30605":530,"_21201":51866,"_5":14582,"_27821":51629,"_3006":51867},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3550":609,"_30605":530,"_21201":51869,"_5":14582,"_27821":51629,"_3006":51870},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3550":610,"_30605":530,"_21201":51872,"_5":14582,"_27821":51633,"_3006":51873},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3550":611,"_30605":530,"_21201":51875,"_5":14582,"_27821":51633,"_3006":51876},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3550":612,"_30605":530,"_21201":51878,"_5":14582,"_27821":51633,"_3006":51879},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3550":613,"_30605":530,"_21201":51881,"_5":14582,"_27821":51633,"_3006":51882},[],"The implemented operators are:",{"_3550":614,"_30605":530,"_21201":51884,"_5":14582,"_27821":51633,"_3006":51885},[],"`equals`, for exact equality;",{"_3550":615,"_30605":530,"_21201":51887,"_5":14582,"_27821":51633,"_3006":51888},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3550":616,"_30605":530,"_21201":51890,"_5":14582,"_27821":51633,"_3006":51891},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3550":617,"_30605":530,"_21201":51893,"_5":14582,"_27821":51633,"_3006":51894},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3550":618,"_30605":530,"_21201":51896,"_5":14582,"_27821":51637,"_3006":51897},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3550":619,"_30605":530,"_21201":51899,"_5":14582,"_27821":51637,"_3006":51900},[],"The available modes are:",{"_3550":620,"_30605":530,"_21201":51902,"_5":14582,"_27821":51637,"_3006":51903},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3550":621,"_30605":530,"_21201":51905,"_5":14582,"_27821":51637,"_3006":51906},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3550":622,"_30605":530,"_21201":51908,"_5":14582,"_27821":51637,"_3006":51909},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3550":623,"_30605":530,"_21201":51911,"_5":14582,"_27821":51637,"_3006":51912},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3550":624,"_30605":530,"_21201":51914,"_5":14582,"_27821":51637,"_3006":51915},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3550":625,"_30605":530,"_21201":51917,"_5":14582,"_27821":51637,"_3006":51918},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3550":626,"_30605":530,"_21201":51920,"_5":14582,"_27821":51641,"_3006":51921},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3550":627,"_30605":530,"_21201":51923,"_5":14582,"_27821":51641,"_3006":51924},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3550":628,"_30605":530,"_21201":51926,"_5":14582,"_27821":51641,"_3006":51927},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3550":629,"_30605":530,"_21201":51929,"_5":14582,"_27821":51641,"_3006":51930},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3550":630,"_30605":530,"_21201":51932,"_5":14582,"_27821":51649,"_3006":51933},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3550":631,"_30605":530,"_21201":51935,"_5":14582,"_27821":51649,"_3006":51936},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3550":632,"_30605":530,"_21201":51938,"_5":14582,"_27821":51653,"_3006":51939},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3550":633,"_30605":530,"_21201":51941,"_5":14582,"_27821":51653,"_3006":51942},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3550":634,"_30605":530,"_21201":51944,"_5":14582,"_27821":51653,"_3006":51945},[],"The data model shows how the resources used in entity rules are connected.",{"_3550":635,"_30605":530,"_21201":51947,"_5":14582,"_27821":51653,"_3006":51948},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3550":636,"_30605":530,"_21201":51950,"_5":14582,"_27821":51653,"_3006":51951},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3550":637,"_30605":530,"_21201":51953,"_5":14582,"_27821":51657,"_3006":51954},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3550":638,"_30605":530,"_21201":51956,"_5":14582,"_27821":51657,"_3006":51957},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3550":639,"_30605":530,"_21201":51959,"_5":14582,"_27821":51657,"_3006":51960},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3550":640,"_30605":530,"_21201":51962,"_5":14582,"_27821":51661,"_3006":51963},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3550":641,"_30605":530,"_21201":51965,"_5":14582,"_27821":51661,"_3006":51966},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3550":642,"_30605":530,"_21201":51968,"_5":14582,"_27821":51661,"_3006":51969},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3550":643,"_30605":530,"_21201":51971,"_5":14582,"_27821":51661,"_3006":51972},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3550":644,"_30605":530,"_21201":51974,"_5":14582,"_27821":51661,"_3006":51975},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3550":645,"_30605":530,"_21201":51977,"_5":14582,"_27821":51661,"_3006":51978},[],"Note that:",{"_3550":646,"_30605":530,"_21201":51980,"_5":14582,"_27821":51661,"_3006":51981},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3550":647,"_30605":530,"_21201":51983,"_5":14582,"_27821":51661,"_3006":51984},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3550":648,"_30605":530,"_21201":51986,"_5":14582,"_27821":51661,"_3006":51987},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3550":649,"_30605":530,"_21201":51989,"_5":14582,"_27821":51665,"_3006":51990},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3550":650,"_30605":530,"_21201":51992,"_5":14582,"_27821":51665,"_3006":51993},[],"full and read-only access to certificates and authorities;",{"_3550":651,"_30605":530,"_21201":51995,"_5":14582,"_27821":51665,"_3006":51996},[],"full and read-only access to the KMS;",{"_3550":652,"_30605":530,"_21201":51998,"_5":14582,"_27821":51665,"_3006":51999},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3550":653,"_30605":530,"_21201":52001,"_5":14582,"_27821":51665,"_3006":52002},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3550":654,"_30605":530,"_21201":52004,"_5":14582,"_27821":51665,"_3006":52005},[],"console access;",{"_3550":655,"_30605":530,"_21201":52007,"_5":14582,"_27821":51665,"_3006":52008},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3550":656,"_30605":530,"_21201":52010,"_5":14582,"_27821":51665,"_3006":52011},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3550":657,"_30605":530,"_21201":52013,"_5":14582,"_27821":51665,"_3006":52014},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3550":658,"_30605":530,"_21201":52016,"_5":14582,"_27821":51669,"_3006":52017},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3550":659,"_30605":530,"_21201":52019,"_5":14582,"_27821":51669,"_3006":52020},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3550":660,"_30605":530,"_21201":52022,"_5":14582,"_27821":51669,"_3006":52023},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3550":661,"_30605":530,"_21201":52025,"_5":14582,"_27821":51672,"_3006":52026},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3550":662,"_30605":530,"_21201":52028,"_5":14582,"_27821":51676,"_3006":52029},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3550":663,"_30605":530,"_21201":52031,"_5":14582,"_27821":51676,"_3006":52032},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3550":664,"_30605":530,"_21201":52034,"_5":14582,"_27821":51680,"_3006":52035},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3550":665,"_30605":530,"_21201":52037,"_5":14582,"_27821":51684,"_3006":52038},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3550":666,"_30605":530,"_21201":52040,"_5":14582,"_27821":51688,"_3006":52041},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3550":667,"_30605":530,"_21201":52043,"_5":14582,"_27821":51692,"_3006":52044},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3550":668,"_30605":530,"_21201":52046,"_5":14582,"_27821":51692,"_3006":52047},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3550":669,"_30605":530,"_21201":52049,"_5":14582,"_27821":51696,"_3006":52050},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3550":670,"_30605":530,"_21201":52052,"_5":14582,"_27821":51696,"_3006":52053},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3550":671,"_30605":530,"_21201":52055,"_5":14582,"_27821":51696,"_3006":52056},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3550":672,"_30605":530,"_21201":52058,"_5":14582,"_27821":51696,"_3006":52059},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3550":673,"_30605":530,"_21201":52061,"_5":14582,"_27821":51696,"_3006":52062},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3550":674,"_30605":530,"_21201":52064,"_5":14582,"_27821":51696,"_3006":52065},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3550":675,"_30605":530,"_21201":52067,"_5":14582,"_27821":51696,"_3006":52068},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3550":676,"_30605":530,"_21201":52070,"_5":14582,"_27821":51696,"_3006":52071},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3550":677,"_30605":530,"_21201":52073,"_5":14582,"_27821":51700,"_3006":52074},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3550":678,"_30605":530,"_21201":52076,"_5":14582,"_27821":51700,"_3006":52077},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3550":679,"_30605":530,"_21201":52079,"_5":14582,"_27821":51700,"_3006":52080},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3550":680,"_30605":530,"_21201":52082,"_5":14582,"_27821":51704,"_3006":52083},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3550":681,"_30605":530,"_21201":52085,"_5":14582,"_27821":51704,"_3006":52086},[],"Use groups or stable roles for people and independent identities for automations.",{"_3550":682,"_30605":530,"_21201":52088,"_5":14582,"_27821":51704,"_3006":52089},[],"Keep at least two recovery administrators and test their access periodically.",{"_3550":683,"_30605":530,"_21201":52091,"_5":14582,"_27821":51704,"_3006":52092},[],"Review active principals, their matches and their grants after IdP changes.",{"_3550":684,"_30605":530,"_21201":52094,"_5":14582,"_27821":51704,"_3006":52095},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3550":685,"_30605":530,"_21201":52097,"_5":14582,"_27821":51704,"_3006":52098},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3550":686,"_30605":530,"_21201":52100,"_5":14582,"_27821":51704,"_3006":52101},[],"Always test one allowed and one denied operation for each role.",{"_3550":687,"_30605":530,"_21201":52103,"_5":14582,"_27821":51704,"_3006":52104},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3550":688,"_30605":530,"_21201":52106,"_5":14582,"_27821":51712,"_3006":52107},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3550":689,"_30605":530,"_21201":52109,"_5":14582,"_27821":51716,"_3006":52110},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3550":690,"_30605":530,"_21201":52112,"_5":14582,"_27821":51716,"_3006":52113},[],"that an active principal of the correct type exists;",{"_3550":691,"_30605":530,"_21201":52115,"_5":14582,"_27821":51716,"_3006":52116},[],"that the claim paths and values match the real token exactly;",{"_3550":692,"_30605":530,"_21201":52118,"_5":14582,"_27821":51716,"_3006":52119},[],"that all of the principal's conditions hold;",{"_3550":693,"_30605":530,"_21201":52121,"_5":14582,"_27821":51716,"_3006":52122},[],"that the principal has the expected policy granted;",{"_3550":694,"_30605":530,"_21201":52124,"_5":14582,"_27821":51716,"_3006":52125},[],"that the policy includes the action and the requested resource type or route;",{"_3550":695,"_30605":530,"_21201":52127,"_5":14582,"_27821":51716,"_3006":52128},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3550":696,"_30605":530,"_21201":52130,"_5":14582,"_27821":51716,"_3006":52131},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3550":697,"_30605":530,"_21201":52133,"_5":14582,"_27821":51716,"_3006":52134},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3550":698,"_30605":530,"_21201":52136,"_5":14582,"_27821":51720,"_3006":52137},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3550":699,"_30605":530,"_21201":52139,"_5":14582,"_27821":51724,"_3006":52140},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3550":700,"_30605":530,"_21201":52142,"_5":14582,"_27821":51728,"_3006":52143},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3550":701,"_30605":530,"_21201":52145,"_5":14582,"_27821":51728,"_3006":52146},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3550":702,"_30605":702,"_5":14934,"_3006":52148,"_30964":52149,"_21201":52150,"_27821":702},"Alerts and subscriptions",[49995,51470,51471],[],{"_3550":703,"_30605":702,"_21201":52152,"_5":14582,"_27821":702,"_3006":52153},[],"Send PKI events to people and external systems.",{"_3550":704,"_30605":702,"_5":30961,"_21201":52155,"_27821":52156,"_3006":52157},[],"/docs/pr-preview/pr-66/platform/administration/alerts#how-it-works","How it works",{"_3550":705,"_30605":702,"_5":30961,"_21201":52159,"_27821":52160,"_3006":52161},[],"/docs/pr-preview/pr-66/platform/administration/alerts#available-channels","Available channels",{"_3550":706,"_30605":702,"_5":30961,"_21201":52163,"_27821":52164,"_3006":52165},[],"/docs/pr-preview/pr-66/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3550":707,"_30605":702,"_5":30961,"_21201":52167,"_27821":52168,"_3006":52169},[],"/docs/pr-preview/pr-66/platform/administration/alerts#choose-the-event","Choose the event",{"_3550":708,"_30605":702,"_5":30961,"_21201":52171,"_27821":52172,"_3006":52173},[],"/docs/pr-preview/pr-66/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3550":709,"_30605":702,"_5":30961,"_21201":52175,"_27821":52176,"_3006":52177},[],"/docs/pr-preview/pr-66/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3550":710,"_30605":702,"_5":30961,"_21201":52179,"_27821":52180,"_3006":52181},[],"/docs/pr-preview/pr-66/platform/administration/alerts#review-and-activate","Review and activate",{"_3550":711,"_30605":702,"_5":30961,"_21201":52183,"_27821":52184,"_3006":52185},[],"/docs/pr-preview/pr-66/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3550":712,"_30605":702,"_5":30961,"_21201":52187,"_27821":52188,"_3006":52189},[],"/docs/pr-preview/pr-66/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3550":713,"_30605":702,"_5":30961,"_21201":52191,"_27821":52192,"_3006":52193},[],"/docs/pr-preview/pr-66/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3550":714,"_30605":702,"_5":30961,"_21201":52195,"_27821":52196,"_3006":52197},[],"/docs/pr-preview/pr-66/platform/administration/alerts#event-families","Event families",{"_3550":715,"_30605":702,"_21201":52199,"_5":14582,"_27821":702,"_3006":52200},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3550":716,"_30605":702,"_21201":52202,"_5":14582,"_27821":52156,"_3006":52203},[],"A service publishes a domain event.",{"_3550":717,"_30605":702,"_21201":52205,"_5":14582,"_27821":52156,"_3006":52206},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3550":718,"_30605":702,"_21201":52208,"_5":14582,"_27821":52156,"_3006":52209},[],"Each subscription's filter decides whether it should be notified.",{"_3550":719,"_30605":702,"_21201":52211,"_5":14582,"_27821":52156,"_3006":52212},[],"Lamassu delivers the event to the configured channel.",{"_3550":720,"_30605":702,"_21201":52214,"_5":14582,"_27821":52156,"_3006":52215},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3550":721,"_30605":702,"_21201":52217,"_5":14582,"_27821":52160,"_3006":52218},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3550":722,"_30605":702,"_21201":52220,"_5":14582,"_27821":52160,"_3006":52221},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3550":723,"_30605":702,"_21201":52223,"_5":14582,"_27821":52160,"_3006":52224},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3550":724,"_30605":702,"_21201":52226,"_5":14582,"_27821":52160,"_3006":52227},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3550":725,"_30605":702,"_21201":52229,"_5":14582,"_27821":52160,"_3006":52230},[],"`apikey_options` requires `header` and `key`.",{"_3550":726,"_30605":702,"_21201":52232,"_5":14582,"_27821":52160,"_3006":52233},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3550":727,"_30605":702,"_21201":52235,"_5":14582,"_27821":52160,"_3006":52236},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3550":728,"_30605":702,"_21201":52238,"_5":14582,"_27821":52160,"_3006":52239},[],"The alerts API reference documents the full `http_client` schema.",{"_3550":729,"_30605":702,"_21201":52241,"_5":14582,"_27821":52168,"_3006":52242},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3550":730,"_30605":702,"_21201":52244,"_5":14582,"_27821":52172,"_3006":52245},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3550":731,"_30605":702,"_21201":52247,"_5":14582,"_27821":52176,"_3006":52248},[],"Add a filter if you don't want to receive every instance of the event.",{"_3550":732,"_30605":702,"_21201":52250,"_5":14582,"_27821":52176,"_3006":52251},[],"**None** notifies all instances of the event.",{"_3550":733,"_30605":702,"_21201":52253,"_5":14582,"_27821":52176,"_3006":52254},[],"**JSON Path** evaluates one or more specific fields.",{"_3550":734,"_30605":702,"_21201":52256,"_5":14582,"_27821":52176,"_3006":52257},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3550":735,"_30605":702,"_21201":52259,"_5":14582,"_27821":52176,"_3006":52260},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3550":736,"_30605":702,"_21201":52262,"_5":14582,"_27821":52176,"_3006":52263},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3550":737,"_30605":702,"_21201":52265,"_5":14582,"_27821":52176,"_3006":52266},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3550":738,"_30605":702,"_21201":52268,"_5":14582,"_27821":52180,"_3006":52269},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3550":739,"_30605":702,"_21201":52271,"_5":14582,"_27821":52184,"_3006":52272},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3550":740,"_30605":702,"_21201":52274,"_5":14582,"_27821":52184,"_3006":52275},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3550":741,"_30605":702,"_21201":52277,"_5":14582,"_27821":52184,"_3006":52278},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3550":742,"_30605":702,"_21201":52280,"_5":14582,"_27821":52184,"_3006":52281},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3550":743,"_30605":702,"_21201":52283,"_5":14582,"_27821":52184,"_3006":52284},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3550":744,"_30605":702,"_21201":52286,"_5":14582,"_27821":52184,"_3006":52287},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3550":745,"_30605":702,"_21201":52289,"_5":14582,"_27821":52184,"_3006":52290},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3550":746,"_30605":702,"_21201":52292,"_5":14582,"_27821":52184,"_3006":52293},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3550":747,"_30605":702,"_21201":52295,"_5":14582,"_27821":52188,"_3006":52296},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3550":748,"_30605":702,"_21201":52298,"_5":14582,"_27821":52188,"_3006":52299},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3550":749,"_30605":702,"_21201":52301,"_5":14582,"_27821":52188,"_3006":52302},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3550":750,"_30605":702,"_21201":52304,"_5":14582,"_27821":52188,"_3006":52305},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3550":751,"_30605":702,"_21201":52307,"_5":14582,"_27821":52188,"_3006":52308},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3550":752,"_30605":702,"_21201":52310,"_5":14582,"_27821":52188,"_3006":52311},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3550":753,"_30605":702,"_21201":52313,"_5":14582,"_27821":52188,"_3006":52314},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3550":754,"_30605":702,"_21201":52316,"_5":14582,"_27821":52188,"_3006":52317},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3550":755,"_30605":702,"_21201":52319,"_5":14582,"_27821":52192,"_3006":52320},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3550":756,"_30605":702,"_21201":52322,"_5":14582,"_27821":52192,"_3006":52323},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3550":757,"_30605":702,"_21201":52325,"_5":14582,"_27821":52196,"_3006":52326},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3550":758,"_30605":702,"_21201":52328,"_5":14582,"_27821":52196,"_3006":52329},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3550":759,"_30605":702,"_21201":52331,"_5":14582,"_27821":52196,"_3006":52332},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3550":760,"_30605":702,"_21201":52334,"_5":14582,"_27821":52196,"_3006":52335},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3550":761,"_30605":702,"_21201":52337,"_5":14582,"_27821":52196,"_3006":52338},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3550":762,"_30605":702,"_21201":52340,"_5":14582,"_27821":52196,"_3006":52341},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3550":763,"_30605":702,"_21201":52343,"_5":14582,"_27821":52196,"_3006":52344},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3550":764,"_30605":702,"_21201":52346,"_5":14582,"_27821":52196,"_3006":52347},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3550":765,"_30605":702,"_21201":52349,"_5":14582,"_27821":52196,"_3006":52350},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3550":766,"_30605":702,"_21201":52352,"_5":14582,"_27821":52196,"_3006":52353},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3550":767,"_30605":767,"_5":14934,"_3006":52355,"_30964":52356,"_21201":52357,"_27821":767},"Audit logs",[49995,51470,51471],[],{"_3550":768,"_30605":767,"_21201":52359,"_5":14582,"_27821":767,"_3006":52360},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3550":769,"_30605":767,"_5":30961,"_21201":52362,"_27821":52363,"_3006":52364},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3550":770,"_30605":767,"_5":30961,"_21201":52366,"_27821":52367,"_3006":52368},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#coverage","Coverage",{"_3550":771,"_30605":767,"_5":30961,"_21201":52370,"_27821":52371,"_3006":52372},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3550":772,"_30605":767,"_5":30961,"_21201":52374,"_27821":52375,"_3006":52376},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3550":773,"_30605":767,"_5":30961,"_21201":52378,"_27821":52379,"_3006":52380},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3550":774,"_30605":767,"_5":30961,"_21201":52382,"_27821":52383,"_3006":52384},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3550":775,"_30605":767,"_5":30961,"_21201":52386,"_27821":52387,"_3006":52388},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3550":776,"_30605":767,"_5":30961,"_21201":52390,"_27821":52391,"_3006":52392},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3550":777,"_30605":767,"_5":30961,"_21201":52394,"_27821":52395,"_3006":52396},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3550":778,"_30605":767,"_5":30961,"_21201":52398,"_27821":52399,"_3006":52400},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3550":779,"_30605":767,"_5":30961,"_21201":52402,"_27821":52403,"_3006":52404},[],"/docs/pr-preview/pr-66/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3550":780,"_30605":767,"_21201":52406,"_5":14582,"_27821":767,"_3006":52407},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3550":781,"_30605":767,"_21201":52409,"_5":14582,"_27821":52363,"_3006":52410},[],"The audit body includes:",{"_3550":782,"_30605":767,"_21201":52412,"_5":14582,"_27821":52363,"_3006":52413},[],"input: data received by the operation;",{"_3550":783,"_30605":767,"_21201":52415,"_5":14582,"_27821":52363,"_3006":52416},[],"has\\_error: whether the service returned an error;",{"_3550":784,"_30605":767,"_21201":52418,"_5":14582,"_27821":52363,"_3006":52419},[],"output: produced result or error message;",{"_3550":785,"_30605":767,"_21201":52421,"_5":14582,"_27821":52363,"_3006":52422},[],"principals: identifiers of the principals that matched the request.",{"_3550":786,"_30605":767,"_21201":52424,"_5":14582,"_27821":52363,"_3006":52425},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3550":787,"_30605":767,"_21201":52427,"_5":14582,"_27821":52363,"_3006":52428},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3550":788,"_30605":767,"_21201":52430,"_5":14582,"_27821":52367,"_3006":52431},[],"The backend applies auditing to mutations of:",{"_3550":789,"_30605":767,"_21201":52433,"_5":14582,"_27821":52367,"_3006":52434},[],"authorities, certificates and issuance profiles;",{"_3550":790,"_30605":767,"_21201":52436,"_5":14582,"_27821":52367,"_3006":52437},[],"keys and KMS engines;",{"_3550":791,"_30605":767,"_21201":52439,"_5":14582,"_27821":52367,"_3006":52440},[],"devices and identities;",{"_3550":792,"_30605":767,"_21201":52442,"_5":14582,"_27821":52367,"_3006":52443},[],"DMSs and enrollment operations;",{"_3550":793,"_30605":767,"_21201":52445,"_5":14582,"_27821":52367,"_3006":52446},[],"validation functions and CRL;",{"_3550":794,"_30605":767,"_21201":52448,"_5":14582,"_27821":52367,"_3006":52449},[],"principals, policies and authorization grants.",{"_3550":795,"_30605":767,"_21201":52451,"_5":14582,"_27821":52367,"_3006":52452},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3550":796,"_30605":767,"_21201":52454,"_5":14582,"_27821":52371,"_3006":52455},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3550":797,"_30605":767,"_21201":52457,"_5":14582,"_27821":52371,"_3006":52458},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3550":798,"_30605":767,"_21201":52460,"_5":14582,"_27821":52371,"_3006":52461},[],"Design the consumer to:",{"_3550":799,"_30605":767,"_21201":52463,"_5":14582,"_27821":52371,"_3006":52464},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3550":800,"_30605":767,"_21201":52466,"_5":14582,"_27821":52371,"_3006":52467},[],"keep the complete CloudEvent unmodified;",{"_3550":801,"_30605":767,"_21201":52469,"_5":14582,"_27821":52371,"_3006":52470},[],"record the ingestion time and detect duplicates by ID;",{"_3550":802,"_30605":767,"_21201":52472,"_5":14582,"_27821":52371,"_3006":52473},[],"encrypt in transit and at rest;",{"_3550":803,"_30605":767,"_21201":52475,"_5":14582,"_27821":52371,"_3006":52476},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3550":804,"_30605":767,"_21201":52478,"_5":14582,"_27821":52371,"_3006":52479},[],"apply an explicit retention and legal hold policy;",{"_3550":805,"_30605":767,"_21201":52481,"_5":14582,"_27821":52371,"_3006":52482},[],"alert if it stops consuming or the pending queue grows.",{"_3550":806,"_30605":767,"_21201":52484,"_5":14582,"_27821":52375,"_3006":52485},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3550":807,"_30605":767,"_21201":52487,"_5":14582,"_27821":52375,"_3006":52488},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3550":808,"_30605":767,"_21201":52490,"_5":14582,"_27821":52383,"_3006":52491},[],"Start from the reported time and normalize every source to UTC.",{"_3550":809,"_30605":767,"_21201":52493,"_5":14582,"_27821":52387,"_3006":52494},[],"Filter by event type, service source and resource identifier.",{"_3550":810,"_30605":767,"_21201":52496,"_5":14582,"_27821":52391,"_3006":52497},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3550":811,"_30605":767,"_21201":52499,"_5":14582,"_27821":52395,"_3006":52500},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3550":812,"_30605":767,"_21201":52502,"_5":14582,"_27821":52399,"_3006":52503},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3550":813,"_30605":767,"_21201":52505,"_5":14582,"_27821":52403,"_3006":52506},[],"Generate a controlled mutation in a test environment and check that:",{"_3550":814,"_30605":767,"_21201":52508,"_5":14582,"_27821":52403,"_3006":52509},[],"a successful audit event appears;",{"_3550":815,"_30605":767,"_21201":52511,"_5":14582,"_27821":52403,"_3006":52512},[],"the principal matches the identity used;",{"_3550":816,"_30605":767,"_21201":52514,"_5":14582,"_27821":52403,"_3006":52515},[],"the consumer persists it exactly once;",{"_3550":817,"_30605":767,"_21201":52517,"_5":14582,"_27821":52403,"_3006":52518},[],"it can be retrieved by resource, actor and period;",{"_3550":818,"_30605":767,"_21201":52520,"_5":14582,"_27821":52403,"_3006":52521},[],"a consumer outage raises an alert.",{"_3550":819,"_30605":767,"_21201":52523,"_5":14582,"_27821":52403,"_3006":52524},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3550":820,"_30605":820,"_5":14934,"_3006":52526,"_30964":52527,"_21201":52528,"_27821":820},"Platform architecture",[49995,51470],[],{"_3550":821,"_30605":820,"_21201":52530,"_5":14582,"_27821":820,"_3006":52531},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3550":822,"_30605":820,"_5":30961,"_21201":52533,"_27821":52534,"_3006":52535},[],"/docs/pr-preview/pr-66/platform/concepts/architecture#control-plane","Control plane",{"_3550":823,"_30605":820,"_5":30961,"_21201":52537,"_27821":52538,"_3006":52539},[],"/docs/pr-preview/pr-66/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3550":824,"_30605":820,"_5":30961,"_21201":52541,"_27821":52542,"_3006":52543},[],"/docs/pr-preview/pr-66/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3550":825,"_30605":820,"_5":30961,"_21201":52545,"_27821":52546,"_3006":52547},[],"/docs/pr-preview/pr-66/platform/concepts/architecture#status-and-validation","Status and validation",{"_3550":826,"_30605":820,"_5":30961,"_21201":52549,"_27821":52550,"_3006":52551},[],"/docs/pr-preview/pr-66/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3550":827,"_30605":820,"_21201":52553,"_5":14582,"_27821":820,"_3006":52554},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3550":828,"_30605":820,"_21201":52556,"_5":14582,"_27821":820,"_3006":52557},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3550":829,"_30605":820,"_21201":52559,"_5":14582,"_27821":52534,"_3006":52560},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3550":830,"_30605":820,"_21201":52562,"_5":14582,"_27821":52538,"_3006":52563},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3550":831,"_30605":820,"_21201":52565,"_5":14582,"_27821":52542,"_3006":52566},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3550":832,"_30605":820,"_21201":52568,"_5":14582,"_27821":52546,"_3006":52569},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3550":833,"_30605":820,"_21201":52571,"_5":14582,"_27821":52550,"_3006":52572},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3550":834,"_30605":834,"_5":14934,"_3006":52574,"_30964":52575,"_21201":52576,"_27821":834},"How Lamassu works",[49995,51470],[],{"_3550":835,"_30605":834,"_21201":52578,"_5":14582,"_27821":834,"_3006":52579},[],"The mental model of trust, keys, certificates and devices.",{"_3550":836,"_30605":834,"_5":30961,"_21201":52581,"_27821":52582,"_3006":52583},[],"/docs/pr-preview/pr-66/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3550":837,"_30605":834,"_5":30961,"_21201":52585,"_27821":52586,"_3006":52587},[],"/docs/pr-preview/pr-66/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3550":838,"_30605":834,"_21201":52589,"_5":14582,"_27821":834,"_3006":52590},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3550":839,"_30605":834,"_21201":52592,"_5":14582,"_27821":52582,"_3006":52593},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3550":840,"_30605":834,"_21201":52595,"_5":14582,"_27821":52582,"_3006":52596},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3550":841,"_30605":834,"_21201":52598,"_5":14582,"_27821":52582,"_3006":52599},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3550":842,"_30605":834,"_21201":52601,"_5":14582,"_27821":52582,"_3006":52602},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3550":843,"_30605":834,"_21201":52604,"_5":14582,"_27821":52582,"_3006":52605},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3550":844,"_30605":834,"_21201":52607,"_5":14582,"_27821":52586,"_3006":52608},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3550":845,"_30605":834,"_21201":52610,"_5":14582,"_27821":52586,"_3006":52611},[],"A DMS relates that CA to an enrollment policy.",{"_3550":846,"_30605":834,"_21201":52613,"_5":14582,"_27821":52586,"_3006":52614},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3550":847,"_30605":834,"_21201":52616,"_5":14582,"_27821":52586,"_3006":52617},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3550":848,"_30605":834,"_21201":52619,"_5":14582,"_27821":52586,"_3006":52620},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3550":849,"_30605":834,"_21201":52622,"_5":14582,"_27821":52586,"_3006":52623},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3550":850,"_30605":834,"_21201":52625,"_5":14582,"_27821":52586,"_3006":52626},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3550":851,"_30605":851,"_5":14934,"_3006":52628,"_30964":52629,"_21201":52631,"_27821":851},"Devices and identities",[49995,51470,52630,52628],"IoT Fleets",[],{"_3550":852,"_30605":851,"_21201":52633,"_5":14582,"_27821":851,"_3006":52634},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3550":853,"_30605":851,"_5":30961,"_21201":52636,"_27821":52637,"_3006":52638},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#device-states","Device states",{"_3550":854,"_30605":851,"_5":30961,"_21201":52640,"_27821":52641,"_3006":52642},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3550":855,"_30605":851,"_5":30961,"_21201":52644,"_27821":52645,"_3006":52646},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3550":856,"_30605":851,"_5":30961,"_21201":52648,"_27821":52649,"_3006":52650},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3550":857,"_30605":851,"_5":30961,"_21201":52652,"_27821":52653,"_3006":52654},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3550":858,"_30605":851,"_5":30961,"_21201":52656,"_27821":52657,"_3006":52658},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3550":859,"_30605":851,"_5":30961,"_21201":52660,"_27821":52661,"_3006":52662},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3550":860,"_30605":851,"_5":30961,"_21201":52664,"_27821":52665,"_3006":52666},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3550":861,"_30605":851,"_5":30961,"_21201":52668,"_27821":52669,"_3006":52670},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3550":862,"_30605":851,"_5":30961,"_21201":52672,"_27821":52673,"_3006":52674},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3550":863,"_30605":851,"_5":30961,"_21201":52676,"_27821":52677,"_3006":52678},[],"/docs/pr-preview/pr-66/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3550":864,"_30605":851,"_21201":52680,"_5":14582,"_27821":851,"_3006":52681},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3550":865,"_30605":851,"_21201":52683,"_5":14582,"_27821":851,"_3006":52684},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3550":866,"_30605":851,"_21201":52686,"_5":14582,"_27821":52637,"_3006":52687},[],"Operational view",{"_3550":867,"_30605":851,"_21201":52689,"_5":14582,"_27821":52637,"_3006":52690},[],"Meaning",{"_3550":868,"_30605":851,"_21201":52692,"_5":14582,"_27821":52637,"_3006":52693},[],"**No Identity**",{"_3550":869,"_30605":851,"_21201":52695,"_5":14582,"_27821":52637,"_3006":52696},[],"A record exists without an associated identity.",{"_3550":870,"_30605":851,"_21201":52698,"_5":14582,"_27821":52637,"_3006":52699},[],"**Active**",{"_3550":871,"_30605":851,"_21201":52701,"_5":14582,"_27821":52637,"_3006":52702},[],"The slot is active; also check certificate dates, status and usages.",{"_3550":872,"_30605":851,"_21201":52704,"_5":14582,"_27821":52637,"_3006":52705},[],"**Renewal Pending**",{"_3550":873,"_30605":851,"_21201":52707,"_5":14582,"_27821":52637,"_3006":52708},[],"The identity is in the operational renewal window.",{"_3550":874,"_30605":851,"_21201":52710,"_5":14582,"_27821":52637,"_3006":52711},[],"**Expiring Soon**",{"_3550":875,"_30605":851,"_21201":52713,"_5":14582,"_27821":52637,"_3006":52714},[],"Expiration is approaching according to configured thresholds.",{"_3550":876,"_30605":851,"_21201":52716,"_5":14582,"_27821":52637,"_3006":52717},[],"**Expired**",{"_3550":877,"_30605":851,"_21201":52719,"_5":14582,"_27821":52637,"_3006":52720},[],"The identity has expired.",{"_3550":878,"_30605":851,"_21201":52722,"_5":14582,"_27821":52637,"_3006":52723},[],"**Revoked**",{"_3550":879,"_30605":851,"_21201":52725,"_5":14582,"_27821":52637,"_3006":52726},[],"The identity is marked revoked.",{"_3550":880,"_30605":851,"_21201":52728,"_5":14582,"_27821":52637,"_3006":52729},[],"**Decommissioned**",{"_3550":881,"_30605":851,"_21201":52731,"_5":14582,"_27821":52637,"_3006":52732},[],"The record is retired and ordinary updates do not restore operation.",{"_3550":882,"_30605":851,"_21201":52734,"_5":14582,"_27821":52637,"_3006":52735},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3550":883,"_30605":851,"_21201":52737,"_5":14582,"_27821":52641,"_3006":52738},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3550":884,"_30605":851,"_21201":52740,"_5":14582,"_27821":52641,"_3006":52741},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3550":885,"_30605":851,"_21201":52743,"_5":14582,"_27821":52641,"_3006":52744},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3550":886,"_30605":851,"_21201":52746,"_5":14582,"_27821":52641,"_3006":52747},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3550":887,"_30605":851,"_21201":52749,"_5":14582,"_27821":52645,"_3006":52750},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3550":888,"_30605":851,"_21201":52752,"_5":14582,"_27821":52649,"_3006":52753},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3550":889,"_30605":851,"_21201":52755,"_5":14582,"_27821":52653,"_3006":52756},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3550":890,"_30605":851,"_21201":52758,"_5":14582,"_27821":52657,"_3006":52759},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3550":891,"_30605":851,"_21201":52761,"_5":14582,"_27821":52661,"_3006":52762},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3550":892,"_30605":851,"_21201":52764,"_5":14582,"_27821":52661,"_3006":52765},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3550":893,"_30605":851,"_21201":52767,"_5":14582,"_27821":52665,"_3006":52768},[],"From **No Identity**, use **Assign Identity**:",{"_3550":894,"_30605":851,"_21201":52770,"_5":14582,"_27821":52665,"_3006":52771},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3550":895,"_30605":851,"_21201":52773,"_5":14582,"_27821":52665,"_3006":52774},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3550":896,"_30605":851,"_21201":52776,"_5":14582,"_27821":52665,"_3006":52777},[],"Confirm and read the serial, active version and history again.",{"_3550":897,"_30605":851,"_21201":52779,"_5":14582,"_27821":52665,"_3006":52780},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3550":898,"_30605":851,"_21201":52782,"_5":14582,"_27821":52665,"_3006":52783},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3550":899,"_30605":851,"_21201":52785,"_5":14582,"_27821":52669,"_3006":52786},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3550":900,"_30605":851,"_21201":52788,"_5":14582,"_27821":52669,"_3006":52789},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3550":901,"_30605":851,"_21201":52791,"_5":14582,"_27821":52673,"_3006":52792},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3550":902,"_30605":851,"_21201":52794,"_5":14582,"_27821":52673,"_3006":52795},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3550":903,"_30605":851,"_21201":52797,"_5":14582,"_27821":52673,"_3006":52798},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3550":904,"_30605":851,"_21201":52800,"_5":14582,"_27821":52673,"_3006":52801},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3550":905,"_30605":851,"_21201":52803,"_5":14582,"_27821":52677,"_3006":52804},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3550":906,"_30605":851,"_21201":52806,"_5":14582,"_27821":52677,"_3006":52807},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3550":907,"_30605":907,"_5":14934,"_3006":52809,"_30964":52810,"_21201":52812,"_27821":907},"Bootstrap identity and authentication",[49995,51470,52630,52628,52811],"Enrollment with PKI",[],{"_3550":908,"_30605":907,"_21201":52814,"_5":14582,"_27821":907,"_3006":52815},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3550":909,"_30605":907,"_5":30961,"_21201":52817,"_27821":52818,"_3006":52819},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3550":910,"_30605":907,"_5":30961,"_21201":52821,"_27821":52822,"_3006":52823},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3550":911,"_30605":907,"_5":30961,"_21201":52825,"_27821":52826,"_3006":52827},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3550":912,"_30605":907,"_5":30961,"_21201":52829,"_27821":52830,"_3006":52831},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3550":913,"_30605":907,"_5":30961,"_21201":52833,"_27821":52834,"_3006":52835},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3550":914,"_30605":907,"_21201":52837,"_5":14582,"_27821":907,"_3006":52838},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3550":915,"_30605":907,"_21201":52840,"_5":14582,"_27821":52818,"_3006":52841},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3550":916,"_30605":907,"_21201":52843,"_5":14582,"_27821":52818,"_3006":52844},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3550":917,"_30605":907,"_21201":52846,"_5":14582,"_27821":52822,"_3006":52847},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3550":918,"_30605":907,"_21201":52849,"_5":14582,"_27821":52822,"_3006":52850},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3550":919,"_30605":907,"_21201":52852,"_5":14582,"_27821":52822,"_3006":52853},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3550":920,"_30605":907,"_21201":52855,"_5":14582,"_27821":52826,"_3006":52856},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3550":921,"_30605":907,"_21201":52858,"_5":14582,"_27821":52826,"_3006":52859},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3550":922,"_30605":907,"_21201":52861,"_5":14582,"_27821":52830,"_3006":52862},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3550":923,"_30605":907,"_21201":52864,"_5":14582,"_27821":52830,"_3006":52865},[],"Example body:",{"_3550":924,"_30605":907,"_21201":52867,"_5":14582,"_27821":52830,"_3006":52868},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3550":925,"_30605":907,"_21201":52870,"_5":14582,"_27821":52830,"_3006":52871},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3550":926,"_30605":907,"_21201":52873,"_5":14582,"_27821":52830,"_3006":52874},[],"Continuation requires a successful HTTP response and JSON:",{"_3550":927,"_30605":907,"_21201":52876,"_5":14582,"_27821":52830,"_3006":52877},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3550":928,"_30605":907,"_21201":52879,"_5":14582,"_27821":52834,"_3006":52880},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3550":929,"_30605":907,"_21201":52882,"_5":14582,"_27821":52834,"_3006":52883},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3550":930,"_30605":930,"_5":14934,"_3006":52885,"_30964":52886,"_21201":52887,"_27821":930},"Configure and operate the DMS",[49995,51470,52630,52628,52811],[],{"_3550":931,"_30605":930,"_21201":52889,"_5":14582,"_27821":930,"_3006":52890},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3550":932,"_30605":930,"_5":30961,"_21201":52892,"_27821":52893,"_3006":50005},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3550":933,"_30605":930,"_5":30961,"_21201":52895,"_27821":52896,"_3006":52897},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3550":934,"_30605":930,"_5":30961,"_21201":52899,"_27821":52900,"_3006":52901},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3550":935,"_30605":930,"_5":30961,"_21201":52903,"_27821":52904,"_3006":52905},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3550":936,"_30605":930,"_5":30961,"_21201":52907,"_27821":52908,"_3006":52909},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3550":937,"_30605":930,"_5":30961,"_21201":52911,"_27821":52912,"_3006":52913},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3550":938,"_30605":930,"_5":30961,"_21201":52915,"_27821":52916,"_3006":52917},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3550":939,"_30605":930,"_5":30961,"_21201":52919,"_27821":52920,"_3006":52921},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3550":940,"_30605":930,"_5":30961,"_21201":52923,"_27821":52924,"_3006":52925},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3550":941,"_30605":930,"_5":30961,"_21201":52927,"_27821":52928,"_3006":52929},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3550":942,"_30605":930,"_5":30961,"_21201":52931,"_27821":52932,"_3006":52933},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3550":943,"_30605":930,"_5":30961,"_21201":52935,"_27821":52936,"_3006":52937},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3550":944,"_30605":930,"_5":30961,"_21201":52939,"_27821":52940,"_3006":52941},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3550":945,"_30605":930,"_5":30961,"_21201":52943,"_27821":52944,"_3006":52945},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3550":946,"_30605":930,"_5":30961,"_21201":52947,"_27821":52948,"_3006":52949},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3550":947,"_30605":930,"_5":30961,"_21201":52951,"_27821":52952,"_3006":52953},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3550":948,"_30605":930,"_5":30961,"_21201":52955,"_27821":52956,"_3006":52957},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3550":949,"_30605":930,"_5":30961,"_21201":52959,"_27821":52960,"_3006":52961},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3550":950,"_30605":930,"_21201":52963,"_5":14582,"_27821":930,"_3006":52964},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3550":951,"_30605":930,"_21201":52966,"_5":14582,"_27821":52893,"_3006":52967},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3550":952,"_30605":930,"_21201":52969,"_5":14582,"_27821":52893,"_3006":52970},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3550":953,"_30605":930,"_21201":52972,"_5":14582,"_27821":52900,"_3006":52973},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3550":954,"_30605":930,"_21201":52975,"_5":14582,"_27821":52904,"_3006":52976},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3550":955,"_30605":930,"_21201":52978,"_5":14582,"_27821":52908,"_3006":52979},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3550":956,"_30605":930,"_21201":52981,"_5":14582,"_27821":52912,"_3006":52982},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3550":957,"_30605":930,"_21201":52984,"_5":14582,"_27821":52916,"_3006":52985},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3550":958,"_30605":930,"_21201":52987,"_5":14582,"_27821":52924,"_3006":52988},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3550":959,"_30605":930,"_21201":52990,"_5":14582,"_27821":52924,"_3006":52991},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3550":960,"_30605":930,"_21201":52993,"_5":14582,"_27821":52928,"_3006":52994},[],"`settings.enrollment_settings` field",{"_3550":961,"_30605":930,"_21201":52996,"_5":14582,"_27821":52928,"_3006":52997},[],"Decision",{"_3550":962,"_30605":930,"_21201":52999,"_5":14582,"_27821":52928,"_3006":53000},[],"`protocol`",{"_3550":963,"_30605":930,"_21201":53002,"_5":14582,"_27821":52928,"_3006":53003},[],"`EST_RFC7030` for these operations.",{"_3550":964,"_30605":930,"_21201":53005,"_5":14582,"_27821":52928,"_3006":53006},[],"`enrollment_ca`",{"_3550":965,"_30605":930,"_21201":53008,"_5":14582,"_27821":52928,"_3006":53009},[],"ID of the signing CA.",{"_3550":966,"_30605":930,"_21201":53011,"_5":14582,"_27821":52928,"_3006":53012},[],"`verify_csr_signature`",{"_3550":967,"_30605":930,"_21201":53014,"_5":14582,"_27821":52928,"_3006":53015},[],"Keep `true` to verify CSR key possession.",{"_3550":968,"_30605":930,"_21201":53017,"_5":14582,"_27821":52928,"_3006":53018},[],"`enable_replaceable_enrollment`",{"_3550":969,"_30605":930,"_21201":53020,"_5":14582,"_27821":52928,"_3006":53021},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3550":970,"_30605":930,"_21201":53023,"_5":14582,"_27821":52928,"_3006":53024},[],"`est_rfc7030_settings.auth_mode`",{"_3550":971,"_30605":930,"_21201":53026,"_5":14582,"_27821":52928,"_3006":53027},[],"One of the four authentication modes.",{"_3550":972,"_30605":930,"_21201":53029,"_5":14582,"_27821":52928,"_3006":53030},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3550":973,"_30605":930,"_21201":53032,"_5":14582,"_27821":52932,"_3006":53033},[],"The blocks are independent:",{"_3550":974,"_30605":930,"_21201":53035,"_5":14582,"_27821":52932,"_3006":53036},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3550":975,"_30605":930,"_21201":53038,"_5":14582,"_27821":52932,"_3006":53039},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3550":976,"_30605":930,"_21201":53041,"_5":14582,"_27821":52932,"_3006":53042},[],"`auth_mode`",{"_3550":977,"_30605":930,"_21201":53044,"_5":14582,"_27821":52932,"_3006":53045},[],"Control applied in the configured operation",{"_3550":978,"_30605":930,"_21201":53047,"_5":14582,"_27821":52932,"_3006":53048},[],"`CLIENT_CERTIFICATE`",{"_3550":979,"_30605":930,"_21201":53050,"_5":14582,"_27821":52932,"_3006":53051},[],"Presented certificate validation.",{"_3550":980,"_30605":930,"_21201":53053,"_5":14582,"_27821":52932,"_3006":53054},[],"`EXTERNAL_WEBHOOK`",{"_3550":981,"_30605":930,"_21201":53056,"_5":14582,"_27821":52932,"_3006":53057},[],"Configured webhook authorization.",{"_3550":982,"_30605":930,"_21201":53059,"_5":14582,"_27821":52932,"_3006":53060},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3550":983,"_30605":930,"_21201":53062,"_5":14582,"_27821":52932,"_3006":53063},[],"Certificate validation followed by webhook approval.",{"_3550":984,"_30605":930,"_21201":53065,"_5":14582,"_27821":52932,"_3006":53066},[],"`NO_AUTH`",{"_3550":985,"_30605":930,"_21201":53068,"_5":14582,"_27821":52932,"_3006":53069},[],"No DMS requester authentication.",{"_3550":986,"_30605":930,"_21201":53071,"_5":14582,"_27821":52932,"_3006":53072},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3550":987,"_30605":930,"_21201":53074,"_5":14582,"_27821":52932,"_3006":53075},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3550":988,"_30605":930,"_21201":53077,"_5":14582,"_27821":52932,"_3006":53078},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3550":989,"_30605":930,"_21201":53080,"_5":14582,"_27821":52932,"_3006":53081},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3550":990,"_30605":930,"_21201":53083,"_5":14582,"_27821":52936,"_3006":53084},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3550":991,"_30605":930,"_21201":53086,"_5":14582,"_27821":52936,"_3006":53087},[],"`external_webhook_settings` field",{"_3550":992,"_30605":930,"_21201":53089,"_5":14582,"_27821":52936,"_3006":52997},[],{"_3550":993,"_30605":930,"_21201":53091,"_5":14582,"_27821":52936,"_3006":53092},[],"`url`",{"_3550":994,"_30605":930,"_21201":53094,"_5":14582,"_27821":52936,"_3006":53095},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3550":995,"_30605":930,"_21201":53097,"_5":14582,"_27821":52936,"_3006":53098},[],"`method`",{"_3550":996,"_30605":930,"_21201":53100,"_5":14582,"_27821":52936,"_3006":53101},[],"`POST` or `PUT`; `POST` by default.",{"_3550":997,"_30605":930,"_21201":53103,"_5":14582,"_27821":52936,"_3006":53104},[],"`name`",{"_3550":998,"_30605":930,"_21201":53106,"_5":14582,"_27821":52936,"_3006":53107},[],"Label used in service logs.",{"_3550":999,"_30605":930,"_21201":53109,"_5":14582,"_27821":52936,"_3006":53110},[],"`config.auth_mode`",{"_3550":1000,"_30605":930,"_21201":53112,"_5":14582,"_27821":52936,"_3006":53113},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3550":1001,"_30605":930,"_21201":53115,"_5":14582,"_27821":52936,"_3006":53116},[],"`config.log_level`",{"_3550":1002,"_30605":930,"_21201":53118,"_5":14582,"_27821":52936,"_3006":53119},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3550":1003,"_30605":930,"_21201":53121,"_5":14582,"_27821":52936,"_3006":53122},[],"`config.apikey_options`",{"_3550":1004,"_30605":930,"_21201":53124,"_5":14582,"_27821":52936,"_3006":53125},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3550":1005,"_30605":930,"_21201":53127,"_5":14582,"_27821":52936,"_3006":53128},[],"`config.jwt_options`",{"_3550":1006,"_30605":930,"_21201":53130,"_5":14582,"_27821":52936,"_3006":53131},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3550":1007,"_30605":930,"_21201":53133,"_5":14582,"_27821":52936,"_3006":53134},[],"`config.mtls_options`",{"_3550":1008,"_30605":930,"_21201":53136,"_5":14582,"_27821":52936,"_3006":53137},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3550":1009,"_30605":930,"_21201":53139,"_5":14582,"_27821":52936,"_3006":53140},[],"`config.insecure_skip_verify`",{"_3550":1010,"_30605":930,"_21201":53142,"_5":14582,"_27821":52936,"_3006":53143},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3550":1011,"_30605":930,"_21201":53145,"_5":14582,"_27821":52936,"_3006":53146},[],"`config.call_timeout`",{"_3550":1012,"_30605":930,"_21201":53148,"_5":14582,"_27821":52936,"_3006":53149},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3550":1013,"_30605":930,"_21201":53151,"_5":14582,"_27821":52936,"_3006":53152},[],"Rules for that configuration:",{"_3550":1014,"_30605":930,"_21201":53154,"_5":14582,"_27821":52936,"_3006":53155},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3550":1015,"_30605":930,"_21201":53157,"_5":14582,"_27821":52936,"_3006":53158},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3550":1016,"_30605":930,"_21201":53160,"_5":14582,"_27821":52936,"_3006":53161},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3550":1017,"_30605":930,"_21201":53163,"_5":14582,"_27821":52936,"_3006":53164},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3550":1018,"_30605":930,"_21201":53166,"_5":14582,"_27821":52936,"_3006":53167},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3550":1019,"_30605":930,"_21201":53169,"_5":14582,"_27821":52936,"_3006":53170},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3550":1020,"_30605":930,"_21201":53172,"_5":14582,"_27821":52936,"_3006":53173},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3550":1021,"_30605":930,"_21201":53175,"_5":14582,"_27821":52936,"_3006":53176},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3550":1022,"_30605":930,"_21201":53178,"_5":14582,"_27821":52936,"_3006":53179},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3550":1023,"_30605":930,"_21201":53181,"_5":14582,"_27821":52940,"_3006":53182},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3550":1024,"_30605":930,"_21201":53184,"_5":14582,"_27821":52944,"_3006":53185},[],"`settings.reenrollment_settings` field",{"_3550":1025,"_30605":930,"_21201":53187,"_5":14582,"_27821":52944,"_3006":50385},[],{"_3550":1026,"_30605":930,"_21201":53189,"_5":14582,"_27821":52944,"_3006":53190},[],"`reenrollment_delta`",{"_3550":1027,"_30605":930,"_21201":53192,"_5":14582,"_27821":52944,"_3006":53193},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3550":1028,"_30605":930,"_21201":53195,"_5":14582,"_27821":52944,"_3006":53196},[],"`preventive_delta`",{"_3550":1029,"_30605":930,"_21201":53198,"_5":14582,"_27821":52944,"_3006":53199},[],"Preventive operational monitoring threshold.",{"_3550":1030,"_30605":930,"_21201":53201,"_5":14582,"_27821":52944,"_3006":53202},[],"`critical_delta`",{"_3550":1031,"_30605":930,"_21201":53204,"_5":14582,"_27821":52944,"_3006":53205},[],"Critical operational monitoring threshold.",{"_3550":1032,"_30605":930,"_21201":53207,"_5":14582,"_27821":52944,"_3006":53208},[],"`enable_expired_renewal`",{"_3550":1033,"_30605":930,"_21201":53210,"_5":14582,"_27821":52944,"_3006":53211},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3550":1034,"_30605":930,"_21201":53213,"_5":14582,"_27821":52944,"_3006":53214},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3550":1035,"_30605":930,"_21201":53216,"_5":14582,"_27821":52944,"_3006":53217},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3550":1036,"_30605":930,"_21201":53219,"_5":14582,"_27821":52944,"_3006":53220},[],"`revoke_on_reenrollment`",{"_3550":1037,"_30605":930,"_21201":53222,"_5":14582,"_27821":52944,"_3006":53223},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3550":1038,"_30605":930,"_21201":53225,"_5":14582,"_27821":52944,"_3006":53226},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3550":1039,"_30605":930,"_21201":53228,"_5":14582,"_27821":52948,"_3006":53229},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3550":1040,"_30605":930,"_21201":53231,"_5":14582,"_27821":52952,"_3006":50379},[],{"_3550":1041,"_30605":930,"_21201":53233,"_5":14582,"_27821":52952,"_3006":53234},[],"Published material",{"_3550":1042,"_30605":930,"_21201":53236,"_5":14582,"_27821":52952,"_3006":53237},[],"**Include Lamassu System CA**",{"_3550":1043,"_30605":930,"_21201":53239,"_5":14582,"_27821":52952,"_3006":53240},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3550":1044,"_30605":930,"_21201":53242,"_5":14582,"_27821":52952,"_3006":53243},[],"**Include Enrollment CA**",{"_3550":1045,"_30605":930,"_21201":53245,"_5":14582,"_27821":52952,"_3006":53246},[],"Selected issuing CA certificate.",{"_3550":1046,"_30605":930,"_21201":53248,"_5":14582,"_27821":52952,"_3006":53249},[],"**Managed CAs**",{"_3550":1047,"_30605":930,"_21201":53251,"_5":14582,"_27821":52952,"_3006":53252},[],"Explicitly selected CA certificates.",{"_3550":1048,"_30605":930,"_21201":53254,"_5":14582,"_27821":52952,"_3006":53255},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3550":1049,"_30605":930,"_21201":53257,"_5":14582,"_27821":52956,"_3006":53258},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3550":1050,"_30605":930,"_21201":53260,"_5":14582,"_27821":52956,"_3006":53261},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3550":1051,"_30605":930,"_21201":53263,"_5":14582,"_27821":52956,"_3006":53264},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3550":1052,"_30605":930,"_21201":53266,"_5":14582,"_27821":52960,"_3006":53267},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3550":1053,"_30605":1053,"_5":14934,"_3006":53269,"_30964":53270,"_21201":53271,"_27821":1053},"Integrate the EST client",[49995,51470,52630,52628,52811],[],{"_3550":1054,"_30605":1053,"_21201":53273,"_5":14582,"_27821":1053,"_3006":53274},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3550":1055,"_30605":1053,"_5":30961,"_21201":53276,"_27821":53277,"_3006":50005},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3550":1056,"_30605":1053,"_5":30961,"_21201":53279,"_27821":53280,"_3006":53281},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3550":1057,"_30605":1053,"_5":30961,"_21201":53283,"_27821":53284,"_3006":53285},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3550":1058,"_30605":1053,"_5":30961,"_21201":53287,"_27821":53288,"_3006":53289},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3550":1059,"_30605":1053,"_5":30961,"_21201":53291,"_27821":53292,"_3006":53293},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3550":1060,"_30605":1053,"_5":30961,"_21201":53295,"_27821":53296,"_3006":53297},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3550":1061,"_30605":1053,"_21201":53299,"_5":14582,"_27821":1053,"_3006":53300},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3550":1062,"_30605":1053,"_21201":53302,"_5":14582,"_27821":53277,"_3006":53303},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3550":1063,"_30605":1053,"_21201":53305,"_5":14582,"_27821":53277,"_3006":53306},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3550":1064,"_30605":1053,"_21201":53308,"_5":14582,"_27821":53277,"_3006":53309},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3550":1065,"_30605":1053,"_21201":53311,"_5":14582,"_27821":53280,"_3006":53312},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3550":1066,"_30605":1053,"_21201":53314,"_5":14582,"_27821":53280,"_3006":53315},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3550":1067,"_30605":1053,"_21201":53317,"_5":14582,"_27821":53284,"_3006":53318},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3550":1068,"_30605":1053,"_21201":53320,"_5":14582,"_27821":53284,"_3006":53321},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3550":1069,"_30605":1053,"_21201":53323,"_5":14582,"_27821":53288,"_3006":53324},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3550":1070,"_30605":1053,"_21201":53326,"_5":14582,"_27821":53288,"_3006":53327},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3550":1071,"_30605":1053,"_21201":53329,"_5":14582,"_27821":53292,"_3006":53330},[],"For a root that issues directly:",{"_3550":1072,"_30605":1053,"_21201":53332,"_5":14582,"_27821":53292,"_3006":53333},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3550":1073,"_30605":1053,"_21201":53335,"_5":14582,"_27821":53292,"_3006":53336},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3550":1074,"_30605":1053,"_21201":53338,"_5":14582,"_27821":53296,"_3006":53339},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3550":1075,"_30605":1075,"_5":14934,"_3006":53341,"_30964":53342,"_21201":53343,"_27821":1075},"EST reference",[49995,51470,52630,52628,52811],[],{"_3550":1076,"_30605":1075,"_21201":53345,"_5":14582,"_27821":1075,"_3006":53346},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3550":1077,"_30605":1075,"_5":30961,"_21201":53348,"_27821":53349,"_3006":53350},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3550":1078,"_30605":1075,"_5":30961,"_21201":53352,"_27821":53353,"_3006":22976},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3550":1079,"_30605":1075,"_5":30961,"_21201":53355,"_27821":53356,"_3006":26393},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3550":1080,"_30605":1075,"_5":30961,"_21201":53358,"_27821":53359,"_3006":26400},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3550":1081,"_30605":1075,"_5":30961,"_21201":53361,"_27821":53362,"_3006":25686},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3550":1082,"_30605":1075,"_5":30961,"_21201":53364,"_27821":53365,"_3006":53366},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3550":1083,"_30605":1075,"_5":30961,"_21201":53368,"_27821":53369,"_3006":53370},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3550":1084,"_30605":1075,"_5":30961,"_21201":53372,"_27821":53373,"_3006":53374},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3550":1085,"_30605":1075,"_21201":53376,"_5":14582,"_27821":1075,"_3006":53377},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3550":1086,"_30605":1075,"_21201":53379,"_5":14582,"_27821":53349,"_3006":53380},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3550":1087,"_30605":1075,"_21201":53382,"_5":14582,"_27821":53349,"_3006":53383},[],"Operation",{"_3550":1088,"_30605":1075,"_21201":53385,"_5":14582,"_27821":53349,"_3006":53386},[],"Method",{"_3550":1089,"_30605":1075,"_21201":53388,"_5":14582,"_27821":53349,"_3006":53389},[],"Authentication and condition",{"_3550":1090,"_30605":1075,"_21201":53391,"_5":14582,"_27821":53349,"_3006":53392},[],"`/cacerts`",{"_3550":1091,"_30605":1075,"_21201":53394,"_5":14582,"_27821":53349,"_3006":53395},[],"GET",{"_3550":1092,"_30605":1075,"_21201":53397,"_5":14582,"_27821":53349,"_3006":53398},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3550":1093,"_30605":1075,"_21201":53400,"_5":14582,"_27821":53349,"_3006":53401},[],"`/simpleenroll`",{"_3550":1094,"_30605":1075,"_21201":53403,"_5":14582,"_27821":53349,"_3006":53404},[],"POST",{"_3550":1095,"_30605":1075,"_21201":53406,"_5":14582,"_27821":53349,"_3006":53407},[],"Initial authentication and DMS registration/replacement policy.",{"_3550":1096,"_30605":1075,"_21201":53409,"_5":14582,"_27821":53349,"_3006":53410},[],"`/simplereenroll`",{"_3550":1097,"_30605":1075,"_21201":53412,"_5":14582,"_27821":53349,"_3006":53404},[],{"_3550":1098,"_30605":1075,"_21201":53414,"_5":14582,"_27821":53349,"_3006":53415},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3550":1099,"_30605":1075,"_21201":53417,"_5":14582,"_27821":53349,"_3006":53418},[],"`/serverkeygen`",{"_3550":1100,"_30605":1075,"_21201":53420,"_5":14582,"_27821":53349,"_3006":53404},[],{"_3550":1101,"_30605":1075,"_21201":53422,"_5":14582,"_27821":53349,"_3006":53423},[],"Initial authentication and admission; server generation enabled.",{"_3550":1102,"_30605":1075,"_21201":53425,"_5":14582,"_27821":53349,"_3006":53426},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3550":1103,"_30605":1075,"_21201":53428,"_5":14582,"_27821":53353,"_3006":53429},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3550":1104,"_30605":1075,"_21201":53431,"_5":14582,"_27821":53353,"_3006":53432},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3550":1105,"_30605":1075,"_21201":53434,"_5":14582,"_27821":53356,"_3006":53435},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3550":1106,"_30605":1075,"_21201":53437,"_5":14582,"_27821":53356,"_3006":53438},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3550":1107,"_30605":1075,"_21201":53440,"_5":14582,"_27821":53359,"_3006":53441},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3550":1108,"_30605":1075,"_21201":53443,"_5":14582,"_27821":53359,"_3006":53444},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3550":1109,"_30605":1075,"_21201":53446,"_5":14582,"_27821":53362,"_3006":53447},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3550":1110,"_30605":1075,"_21201":53449,"_5":14582,"_27821":53362,"_3006":53450},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3550":1111,"_30605":1075,"_21201":53452,"_5":14582,"_27821":53365,"_3006":53453},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3550":1112,"_30605":1075,"_21201":53455,"_5":14582,"_27821":53365,"_3006":53456},[],"Part",{"_3550":1113,"_30605":1075,"_21201":53458,"_5":14582,"_27821":53365,"_3006":53459},[],"Content after decoding its Base64",{"_3550":1114,"_30605":1075,"_21201":53461,"_5":14582,"_27821":53365,"_3006":53462},[],"`application/pkcs8`",{"_3550":1115,"_30605":1075,"_21201":53464,"_5":14582,"_27821":53365,"_3006":53465},[],"Unencrypted DER PKCS#8 private key.",{"_3550":1116,"_30605":1075,"_21201":53467,"_5":14582,"_27821":53365,"_3006":53468},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3550":1117,"_30605":1075,"_21201":53470,"_5":14582,"_27821":53365,"_3006":53471},[],"DER PKCS#7 containing the issued certificate.",{"_3550":1118,"_30605":1075,"_21201":53473,"_5":14582,"_27821":53365,"_3006":53474},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3550":1119,"_30605":1075,"_21201":53476,"_5":14582,"_27821":53369,"_3006":53477},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3550":1120,"_30605":1075,"_21201":53479,"_5":14582,"_27821":53369,"_3006":53480},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3550":1121,"_30605":1075,"_21201":53482,"_5":14582,"_27821":53369,"_3006":53483},[],"Convert and check the result:",{"_3550":1122,"_30605":1075,"_21201":53485,"_5":14582,"_27821":53369,"_3006":53486},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3550":1123,"_30605":1075,"_21201":53488,"_5":14582,"_27821":53373,"_3006":53489},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3550":1124,"_30605":1075,"_21201":53491,"_5":14582,"_27821":53373,"_3006":53492},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3550":1125,"_30605":1125,"_5":14934,"_3006":52811,"_30964":53494,"_21201":53495,"_27821":1125},[49995,51470,52630,52628,52811],[],{"_3550":1126,"_30605":1125,"_21201":53497,"_5":14582,"_27821":1125,"_3006":53498},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3550":1127,"_30605":1125,"_5":30961,"_21201":53500,"_27821":53501,"_3006":53502},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3550":1128,"_30605":1125,"_5":30961,"_21201":53504,"_27821":53505,"_3006":53506},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3550":1129,"_30605":1125,"_5":30961,"_21201":53508,"_27821":53509,"_3006":53510},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3550":1130,"_30605":1125,"_5":30961,"_21201":53512,"_27821":53513,"_3006":53514},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3550":1131,"_30605":1125,"_21201":53516,"_5":14582,"_27821":1125,"_3006":53517},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3550":1132,"_30605":1125,"_21201":53519,"_5":14582,"_27821":53501,"_3006":53520},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3550":1133,"_30605":1125,"_21201":53522,"_5":14582,"_27821":53501,"_3006":53523},[],"The integrator installs initial EST server trust and an admission credential.",{"_3550":1134,"_30605":1125,"_21201":53525,"_5":14582,"_27821":53501,"_3006":53526},[],"The client requests an identity for its `Device ID` through EST.",{"_3550":1135,"_30605":1125,"_21201":53528,"_5":14582,"_27821":53501,"_3006":53529},[],"Certificate, device binding and key/certificate installation are checked.",{"_3550":1136,"_30605":1125,"_21201":53531,"_5":14582,"_27821":53501,"_3006":53532},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3550":1137,"_30605":1125,"_21201":53534,"_5":14582,"_27821":53501,"_3006":53535},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3550":1138,"_30605":1125,"_21201":53537,"_5":14582,"_27821":53505,"_3006":53538},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3550":1139,"_30605":1125,"_21201":53540,"_5":14582,"_27821":53505,"_3006":53541},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3550":1140,"_30605":1125,"_21201":53543,"_5":14582,"_27821":53505,"_3006":53544},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3550":1141,"_30605":1125,"_21201":53546,"_5":14582,"_27821":53505,"_3006":53547},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3550":1142,"_30605":1125,"_21201":53549,"_5":14582,"_27821":53509,"_3006":53550},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3550":1143,"_30605":1125,"_21201":53552,"_5":14582,"_27821":53509,"_3006":53553},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3550":1144,"_30605":1125,"_21201":53555,"_5":14582,"_27821":53509,"_3006":53556},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3550":1145,"_30605":1125,"_21201":53558,"_5":14582,"_27821":53509,"_3006":53559},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3550":1146,"_30605":1125,"_21201":53561,"_5":14582,"_27821":53513,"_3006":53562},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3550":1147,"_30605":1125,"_21201":53564,"_5":14582,"_27821":53513,"_3006":53565},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3550":1148,"_30605":1148,"_5":14934,"_3006":53567,"_30964":53568,"_21201":53569,"_27821":1148},"Provisioning strategies",[49995,51470,52630,52628,52811],[],{"_3550":1149,"_30605":1148,"_21201":53571,"_5":14582,"_27821":1148,"_3006":53572},[],"Choose device registration, identity authorization and key generation.",{"_3550":1150,"_30605":1148,"_5":30961,"_21201":53574,"_27821":53575,"_3006":53576},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3550":1151,"_30605":1148,"_5":30961,"_21201":53578,"_27821":53579,"_3006":53580},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3550":1152,"_30605":1148,"_5":30961,"_21201":53582,"_27821":53583,"_3006":53584},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3550":1153,"_30605":1148,"_5":30961,"_21201":53586,"_27821":53587,"_3006":53588},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3550":1154,"_30605":1148,"_5":30961,"_21201":53590,"_27821":53591,"_3006":53592},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3550":1155,"_30605":1148,"_21201":53594,"_5":14582,"_27821":1148,"_3006":53595},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3550":1156,"_30605":1148,"_21201":53597,"_5":14582,"_27821":53575,"_3006":53598},[],"Path",{"_3550":1157,"_30605":1148,"_21201":53600,"_5":14582,"_27821":53575,"_3006":53601},[],"When the device exists",{"_3550":1158,"_30605":1148,"_21201":53603,"_5":14582,"_27821":53575,"_3006":53604},[],"What to check",{"_3550":1159,"_30605":1148,"_21201":53606,"_5":14582,"_27821":53575,"_3006":53607},[],"Manual assignment",{"_3550":1160,"_30605":1148,"_21201":53609,"_5":14582,"_27821":53575,"_3006":53610},[],"An operator creates it before associating a certificate.",{"_3550":1161,"_30605":1148,"_21201":53612,"_5":14582,"_27821":53575,"_3006":53613},[],"ID, owning DMS, certificate CN and bound serial.",{"_3550":1162,"_30605":1148,"_21201":53615,"_5":14582,"_27821":53575,"_3006":53616},[],"EST with `JITP`",{"_3550":1163,"_30605":1148,"_21201":53618,"_5":14582,"_27821":53575,"_3006":53619},[],"Created for an unknown CN during `/simpleenroll`.",{"_3550":1164,"_30605":1148,"_21201":53621,"_5":14582,"_27821":53575,"_3006":53622},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3550":1165,"_30605":1148,"_21201":53624,"_5":14582,"_27821":53575,"_3006":53625},[],"EST with `PRE_REGISTRATION`",{"_3550":1166,"_30605":1148,"_21201":53627,"_5":14582,"_27821":53575,"_3006":53628},[],"Must exist before `/simpleenroll`.",{"_3550":1167,"_30605":1148,"_21201":53630,"_5":14582,"_27821":53575,"_3006":53631},[],"Approved record, same DMS and replacement conditions for your version.",{"_3550":1168,"_30605":1148,"_21201":53633,"_5":14582,"_27821":53575,"_3006":53634},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3550":1169,"_30605":1148,"_21201":53636,"_5":14582,"_27821":53575,"_3006":53637},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3550":1170,"_30605":1148,"_21201":53639,"_5":14582,"_27821":53579,"_3006":53640},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3550":1171,"_30605":1148,"_21201":53642,"_5":14582,"_27821":53579,"_3006":53643},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3550":1172,"_30605":1148,"_21201":53645,"_5":14582,"_27821":53579,"_3006":53646},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3550":1173,"_30605":1148,"_21201":53648,"_5":14582,"_27821":53583,"_3006":53649},[],"Decide initial enrollment and re-enrollment separately:",{"_3550":1174,"_30605":1148,"_21201":53651,"_5":14582,"_27821":53583,"_3006":53652},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3550":1175,"_30605":1148,"_21201":53654,"_5":14582,"_27821":53583,"_3006":53655},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3550":1176,"_30605":1148,"_21201":53657,"_5":14582,"_27821":53583,"_3006":53658},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3550":1177,"_30605":1148,"_21201":53660,"_5":14582,"_27821":53583,"_3006":53661},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3550":1178,"_30605":1148,"_21201":53663,"_5":14582,"_27821":53583,"_3006":53664},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3550":1179,"_30605":1148,"_21201":53666,"_5":14582,"_27821":53587,"_3006":50379},[],{"_3550":1180,"_30605":1148,"_21201":53668,"_5":14582,"_27821":53587,"_3006":53669},[],"Material crossing EST",{"_3550":1181,"_30605":1148,"_21201":53671,"_5":14582,"_27821":53587,"_3006":53672},[],"Device-generated key",{"_3550":1182,"_30605":1148,"_21201":53674,"_5":14582,"_27821":53587,"_3006":53675},[],"Public CSR and certificate; the key stays on the client.",{"_3550":1183,"_30605":1148,"_21201":53677,"_5":14582,"_27821":53587,"_3006":53678},[],"Existing device key",{"_3550":1184,"_30605":1148,"_21201":53680,"_5":14582,"_27821":53587,"_3006":53681},[],"CSR signed with that key and a new certificate.",{"_3550":1185,"_30605":1148,"_21201":53683,"_5":14582,"_27821":53587,"_3006":52949},[],{"_3550":1186,"_30605":1148,"_21201":53685,"_5":14582,"_27821":53587,"_3006":53686},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3550":1187,"_30605":1148,"_21201":53688,"_5":14582,"_27821":53587,"_3006":53689},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3550":1188,"_30605":1148,"_21201":53691,"_5":14582,"_27821":53591,"_3006":53692},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3550":1189,"_30605":1189,"_5":14934,"_3006":53694,"_30964":53695,"_21201":53696,"_27821":1189},"Renewal and recovery",[49995,51470,52630,52628,52811],[],{"_3550":1190,"_30605":1189,"_21201":53698,"_5":14582,"_27821":1189,"_3006":53699},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3550":1191,"_30605":1189,"_5":30961,"_21201":53701,"_27821":53702,"_3006":53703},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3550":1192,"_30605":1189,"_5":30961,"_21201":53705,"_27821":53706,"_3006":53707},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3550":1193,"_30605":1189,"_5":30961,"_21201":53709,"_27821":53710,"_3006":53711},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3550":1194,"_30605":1189,"_5":30961,"_21201":53713,"_27821":53714,"_3006":53715},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3550":1195,"_30605":1189,"_5":30961,"_21201":53717,"_27821":53718,"_3006":53719},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3550":1196,"_30605":1189,"_21201":53721,"_5":14582,"_27821":1189,"_3006":53722},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3550":1197,"_30605":1189,"_21201":53724,"_5":14582,"_27821":53702,"_3006":53725},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3550":1198,"_30605":1189,"_21201":53727,"_5":14582,"_27821":53702,"_3006":53728},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3550":1199,"_30605":1189,"_21201":53730,"_5":14582,"_27821":53702,"_3006":53731},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3550":1200,"_30605":1189,"_21201":53733,"_5":14582,"_27821":53702,"_3006":53734},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3550":1201,"_30605":1189,"_21201":53736,"_5":14582,"_27821":53706,"_3006":53737},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3550":1202,"_30605":1189,"_21201":53739,"_5":14582,"_27821":53706,"_3006":53740},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3550":1203,"_30605":1189,"_21201":53742,"_5":14582,"_27821":53710,"_3006":53743},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3550":1204,"_30605":1189,"_21201":53745,"_5":14582,"_27821":53710,"_3006":53746},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3550":1205,"_30605":1189,"_21201":53748,"_5":14582,"_27821":53710,"_3006":53749},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3550":1206,"_30605":1189,"_21201":53751,"_5":14582,"_27821":53714,"_3006":53752},[],"Situation",{"_3550":1207,"_30605":1189,"_21201":53754,"_5":14582,"_27821":53714,"_3006":53755},[],"Procedure",{"_3550":1208,"_30605":1189,"_21201":53757,"_5":14582,"_27821":53714,"_3006":53758},[],"Valid certificate, outside the window",{"_3550":1209,"_30605":1189,"_21201":53760,"_5":14582,"_27821":53714,"_3006":53761},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3550":1210,"_30605":1189,"_21201":53763,"_5":14582,"_27821":53714,"_3006":53764},[],"Expired certificate, key available",{"_3550":1211,"_30605":1189,"_21201":53766,"_5":14582,"_27821":53714,"_3006":53767},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3550":1212,"_30605":1189,"_21201":53769,"_5":14582,"_27821":53714,"_3006":53770},[],"Renewal through webhook or `NO_AUTH`",{"_3550":1213,"_30605":1189,"_21201":53772,"_5":14582,"_27821":53714,"_3006":53773},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3550":1214,"_30605":1189,"_21201":53775,"_5":14582,"_27821":53714,"_3006":53776},[],"Lost or inaccessible key",{"_3550":1215,"_30605":1189,"_21201":53778,"_5":14582,"_27821":53714,"_3006":53779},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3550":1216,"_30605":1189,"_21201":53781,"_5":14582,"_27821":53714,"_3006":53782},[],"Current identity revoked",{"_3550":1217,"_30605":1189,"_21201":53784,"_5":14582,"_27821":53714,"_3006":53785},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3550":1218,"_30605":1189,"_21201":53787,"_5":14582,"_27821":53714,"_3006":53788},[],"Device without an identity",{"_3550":1219,"_30605":1189,"_21201":53790,"_5":14582,"_27821":53714,"_3006":53791},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3550":1220,"_30605":1189,"_21201":53793,"_5":14582,"_27821":53714,"_3006":53794},[],"Retired device",{"_3550":1221,"_30605":1189,"_21201":53796,"_5":14582,"_27821":53714,"_3006":53797},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3550":1222,"_30605":1189,"_21201":53799,"_5":14582,"_27821":53714,"_3006":53800},[],"Timeout, HTTP 500 or installation failure",{"_3550":1223,"_30605":1189,"_21201":53802,"_5":14582,"_27821":53714,"_3006":53803},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3550":1224,"_30605":1189,"_21201":53805,"_5":14582,"_27821":53718,"_3006":53806},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3550":1225,"_30605":1189,"_21201":53808,"_5":14582,"_27821":53718,"_3006":53809},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3550":1226,"_30605":1226,"_5":14934,"_3006":53811,"_30964":53812,"_21201":53813,"_27821":1226},"Enrollment troubleshooting",[49995,51470,52630,52628,52811],[],{"_3550":1227,"_30605":1226,"_21201":53815,"_5":14582,"_27821":1226,"_3006":53816},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3550":1228,"_30605":1226,"_5":30961,"_21201":53818,"_27821":53819,"_3006":53820},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3550":1229,"_30605":1226,"_5":30961,"_21201":53822,"_27821":53823,"_3006":53824},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3550":1230,"_30605":1226,"_5":30961,"_21201":53826,"_27821":53827,"_3006":53374},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3550":1231,"_30605":1226,"_5":30961,"_21201":53829,"_27821":53830,"_3006":53831},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3550":1232,"_30605":1226,"_21201":53833,"_5":14582,"_27821":1226,"_3006":53834},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3550":1233,"_30605":1226,"_21201":53836,"_5":14582,"_27821":53823,"_3006":53837},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3550":1234,"_30605":1226,"_21201":53839,"_5":14582,"_27821":53823,"_3006":53840},[],"Symptom or message",{"_3550":1235,"_30605":1226,"_21201":53842,"_5":14582,"_27821":53823,"_3006":53604},[],{"_3550":1236,"_30605":1226,"_21201":53844,"_5":14582,"_27821":53823,"_3006":53845},[],"curl rejects TLS, name or issuer",{"_3550":1237,"_30605":1226,"_21201":53847,"_5":14582,"_27821":53823,"_3006":53848},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3550":1238,"_30605":1226,"_21201":53850,"_5":14582,"_27821":53823,"_3006":53851},[],"404 or missing APS",{"_3550":1239,"_30605":1226,"_21201":53853,"_5":14582,"_27821":53823,"_3006":53854},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3550":1240,"_30605":1226,"_21201":53856,"_5":14582,"_27821":53823,"_3006":53857},[],"400, CSR or format error",{"_3550":1241,"_30605":1226,"_21201":53859,"_5":14582,"_27821":53823,"_3006":53860},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3550":1242,"_30605":1226,"_21201":53862,"_5":14582,"_27821":53823,"_3006":53863},[],"Missing credential or invalid certificate",{"_3550":1243,"_30605":1226,"_21201":53865,"_5":14582,"_27821":53823,"_3006":53866},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3550":1244,"_30605":1226,"_21201":53868,"_5":14582,"_27821":53823,"_3006":53869},[],"Webhook denies, times out or responds without authorization",{"_3550":1245,"_30605":1226,"_21201":53871,"_5":14582,"_27821":53823,"_3006":53872},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3550":1246,"_30605":1226,"_21201":53874,"_5":14582,"_27821":53823,"_3006":53875},[],"`unexpected status code: <n>: redirects are not followed`",{"_3550":1247,"_30605":1226,"_21201":53877,"_5":14582,"_27821":53823,"_3006":53878},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3550":1248,"_30605":1226,"_21201":53880,"_5":14582,"_27821":53823,"_3006":53881},[],"`webhook response exceeds 1048576 bytes`",{"_3550":1249,"_30605":1226,"_21201":53883,"_5":14582,"_27821":53823,"_3006":53884},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3550":1250,"_30605":1226,"_21201":53886,"_5":14582,"_27821":53823,"_3006":53887},[],"`webhook config must not reference files`",{"_3550":1251,"_30605":1226,"_21201":53889,"_5":14582,"_27821":53823,"_3006":53890},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3550":1252,"_30605":1226,"_21201":53892,"_5":14582,"_27821":53823,"_3006":53893},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3550":1253,"_30605":1226,"_21201":53895,"_5":14582,"_27821":53823,"_3006":53896},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3550":1254,"_30605":1226,"_21201":53898,"_5":14582,"_27821":53823,"_3006":53899},[],"`webhook mTLS certificate and key are invalid: …`",{"_3550":1255,"_30605":1226,"_21201":53901,"_5":14582,"_27821":53823,"_3006":53902},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3550":1256,"_30605":1226,"_21201":53904,"_5":14582,"_27821":53823,"_3006":53905},[],"400 `struct validation error` creating or updating a DMS",{"_3550":1257,"_30605":1226,"_21201":53907,"_5":14582,"_27821":53823,"_3006":53908},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3550":1258,"_30605":1226,"_21201":53910,"_5":14582,"_27821":53823,"_3006":53911},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3550":1259,"_30605":1226,"_21201":53913,"_5":14582,"_27821":53823,"_3006":53914},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3550":1260,"_30605":1226,"_21201":53916,"_5":14582,"_27821":53823,"_3006":53917},[],"`device not preregistered`",{"_3550":1261,"_30605":1226,"_21201":53919,"_5":14582,"_27821":53823,"_3006":53920},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3550":1262,"_30605":1226,"_21201":53922,"_5":14582,"_27821":53823,"_3006":53923},[],"`forbiddenNewEnrollment`",{"_3550":1263,"_30605":1226,"_21201":53925,"_5":14582,"_27821":53823,"_3006":53926},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3550":1264,"_30605":1226,"_21201":53928,"_5":14582,"_27821":53823,"_3006":53929},[],"Different owning DMS",{"_3550":1265,"_30605":1226,"_21201":53931,"_5":14582,"_27821":53823,"_3006":53932},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3550":1266,"_30605":1226,"_21201":53934,"_5":14582,"_27821":53823,"_3006":53935},[],"`invalid RawSubject bytes`",{"_3550":1267,"_30605":1226,"_21201":53937,"_5":14582,"_27821":53823,"_3006":53938},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3550":1268,"_30605":1226,"_21201":53940,"_5":14582,"_27821":53823,"_3006":53941},[],"`invalid reenroll window`",{"_3550":1269,"_30605":1226,"_21201":53943,"_5":14582,"_27821":53823,"_3006":53944},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3550":1270,"_30605":1226,"_21201":53946,"_5":14582,"_27821":53823,"_3006":53947},[],"Current certificate revoked",{"_3550":1271,"_30605":1226,"_21201":53949,"_5":14582,"_27821":53823,"_3006":53950},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3550":1272,"_30605":1226,"_21201":53952,"_5":14582,"_27821":53823,"_3006":53953},[],"CA, profile or signing error",{"_3550":1273,"_30605":1226,"_21201":53955,"_5":14582,"_27821":53823,"_3006":53956},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3550":1274,"_30605":1226,"_21201":53958,"_5":14582,"_27821":53823,"_3006":53959},[],"HTTP 200 without a device connection",{"_3550":1275,"_30605":1226,"_21201":53961,"_5":14582,"_27821":53823,"_3006":53962},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3550":1276,"_30605":1226,"_21201":53964,"_5":14582,"_27821":53823,"_3006":53965},[],"Timeout or error after issuance",{"_3550":1277,"_30605":1226,"_21201":53967,"_5":14582,"_27821":53823,"_3006":53968},[],"New certificates, current slot and previous identity's state before retrying.",{"_3550":1278,"_30605":1226,"_21201":53970,"_5":14582,"_27821":53827,"_3006":53971},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3550":1279,"_30605":1226,"_21201":53973,"_5":14582,"_27821":53827,"_3006":53974},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3550":1280,"_30605":1226,"_21201":53976,"_5":14582,"_27821":53830,"_3006":53977},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3550":1281,"_30605":1226,"_21201":53979,"_5":14582,"_27821":53830,"_3006":53980},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3550":1282,"_30605":1226,"_21201":53982,"_5":14582,"_27821":53830,"_3006":53983},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3550":1283,"_30605":1226,"_21201":53985,"_5":14582,"_27821":53830,"_3006":53986},[],"Make one request, save headers/body and query the device and certificates.",{"_3550":1284,"_30605":1226,"_21201":53988,"_5":14582,"_27821":53830,"_3006":53989},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3550":1285,"_30605":1226,"_21201":53991,"_5":14582,"_27821":53830,"_3006":53992},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3550":1286,"_30605":1226,"_21201":53994,"_5":14582,"_27821":53830,"_3006":53995},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3550":1287,"_30605":1287,"_5":14934,"_3006":53997,"_30964":53998,"_21201":53999,"_27821":1287},"Trust distribution and updates",[49995,51470,52630,52628,52811],[],{"_3550":1288,"_30605":1287,"_21201":54001,"_5":14582,"_27821":1287,"_3006":54002},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3550":1289,"_30605":1287,"_5":30961,"_21201":54004,"_27821":54005,"_3006":54006},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3550":1290,"_30605":1287,"_5":30961,"_21201":54008,"_27821":54009,"_3006":54010},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3550":1291,"_30605":1287,"_5":30961,"_21201":54012,"_27821":54013,"_3006":54014},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3550":1292,"_30605":1287,"_5":30961,"_21201":54016,"_27821":54017,"_3006":54018},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3550":1293,"_30605":1287,"_5":30961,"_21201":54020,"_27821":54021,"_3006":54022},[],"/docs/pr-preview/pr-66/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3550":1294,"_30605":1287,"_21201":54024,"_5":14582,"_27821":1287,"_3006":54025},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3550":1295,"_30605":1287,"_21201":54027,"_5":14582,"_27821":54005,"_3006":54028},[],"Relationship",{"_3550":1296,"_30605":1287,"_21201":54030,"_5":14582,"_27821":54005,"_3006":54031},[],"Material prepared by its owner",{"_3550":1297,"_30605":1287,"_21201":54033,"_5":14582,"_27821":54005,"_3006":54034},[],"Device → EST server",{"_3550":1298,"_30605":1287,"_21201":54036,"_5":14582,"_27821":54005,"_3006":54037},[],"Previously verified server root, chain or pin and TLS name.",{"_3550":1299,"_30605":1287,"_21201":54039,"_5":14582,"_27821":54005,"_3006":54040},[],"DMS → requester",{"_3550":1300,"_30605":1287,"_21201":54042,"_5":14582,"_27821":54005,"_3006":54043},[],"CAs and rules authorizing initial or renewal credentials.",{"_3550":1301,"_30605":1287,"_21201":54045,"_5":14582,"_27821":54005,"_3006":54046},[],"Consumer → device",{"_3550":1302,"_30605":1287,"_21201":54048,"_5":14582,"_27821":54005,"_3006":54049},[],"Operational identity roots, intermediates, validation and permissions.",{"_3550":1303,"_30605":1287,"_21201":54051,"_5":14582,"_27821":54005,"_3006":54052},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3550":1304,"_30605":1287,"_21201":54054,"_5":14582,"_27821":54009,"_3006":54055},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3550":1305,"_30605":1287,"_21201":54057,"_5":14582,"_27821":54009,"_3006":54058},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3550":1306,"_30605":1287,"_21201":54060,"_5":14582,"_27821":54013,"_3006":54061},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3550":1307,"_30605":1287,"_21201":54063,"_5":14582,"_27821":54013,"_3006":54064},[],"Select policy-approved roots as anchors.",{"_3550":1308,"_30605":1287,"_21201":54066,"_5":14582,"_27821":54013,"_3006":54067},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3550":1309,"_30605":1287,"_21201":54069,"_5":14582,"_27821":54013,"_3006":54070},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3550":1310,"_30605":1287,"_21201":54072,"_5":14582,"_27821":54013,"_3006":54073},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3550":1311,"_30605":1287,"_21201":54075,"_5":14582,"_27821":54013,"_3006":54076},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3550":1312,"_30605":1287,"_21201":54078,"_5":14582,"_27821":54017,"_3006":54079},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3550":1313,"_30605":1287,"_21201":54081,"_5":14582,"_27821":54017,"_3006":54082},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3550":1314,"_30605":1287,"_21201":54084,"_5":14582,"_27821":54017,"_3006":54085},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3550":1315,"_30605":1287,"_21201":54087,"_5":14582,"_27821":54021,"_3006":54088},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3550":1316,"_30605":1316,"_5":14934,"_3006":54090,"_30964":54091,"_21201":54093,"_27821":1316},"AWS IoT Core",[49995,51470,52630,52628,54092],"Integrations",[],{"_3550":1317,"_30605":1316,"_21201":54095,"_5":14582,"_27821":1316,"_3006":54096},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3550":1318,"_30605":1316,"_5":30961,"_21201":54098,"_27821":54099,"_3006":54100},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3550":1319,"_30605":1316,"_5":30961,"_21201":54102,"_27821":54103,"_3006":54104},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3550":1320,"_30605":1316,"_5":30961,"_21201":54106,"_27821":54107,"_3006":54108},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3550":1321,"_30605":1316,"_5":30961,"_21201":54110,"_27821":54111,"_3006":54112},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3550":1322,"_30605":1316,"_5":30961,"_21201":54114,"_27821":54115,"_3006":54116},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3550":1323,"_30605":1316,"_5":30961,"_21201":54118,"_27821":54119,"_3006":54120},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3550":1324,"_30605":1316,"_5":30961,"_21201":54122,"_27821":54123,"_3006":54124},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3550":1325,"_30605":1316,"_5":30961,"_21201":54126,"_27821":54127,"_3006":54128},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3550":1326,"_30605":1316,"_5":30961,"_21201":54130,"_27821":54131,"_3006":54132},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3550":1327,"_30605":1316,"_5":30961,"_21201":54134,"_27821":54135,"_3006":54136},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3550":1328,"_30605":1316,"_5":30961,"_21201":54138,"_27821":54139,"_3006":54140},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3550":1329,"_30605":1316,"_5":30961,"_21201":54142,"_27821":54143,"_3006":54144},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3550":1330,"_30605":1316,"_5":30961,"_21201":54146,"_27821":54147,"_3006":54148},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3550":1331,"_30605":1316,"_5":30961,"_21201":54150,"_27821":54151,"_3006":54152},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3550":1332,"_30605":1316,"_5":30961,"_21201":54154,"_27821":54155,"_3006":54156},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3550":1333,"_30605":1316,"_5":30961,"_21201":54158,"_27821":54159,"_3006":54160},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3550":1334,"_30605":1316,"_5":30961,"_21201":54162,"_27821":54163,"_3006":54164},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3550":1335,"_30605":1316,"_5":30961,"_21201":54166,"_27821":54167,"_3006":54168},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3550":1336,"_30605":1316,"_5":30961,"_21201":54170,"_27821":54171,"_3006":54172},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3550":1337,"_30605":1316,"_5":30961,"_21201":54174,"_27821":54175,"_3006":54176},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3550":1338,"_30605":1316,"_5":30961,"_21201":54178,"_27821":54179,"_3006":54180},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3550":1339,"_30605":1316,"_5":30961,"_21201":54182,"_27821":54183,"_3006":54184},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3550":1340,"_30605":1316,"_5":30961,"_21201":54186,"_27821":54187,"_3006":54188},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3550":1341,"_30605":1316,"_5":30961,"_21201":54190,"_27821":54191,"_3006":54192},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3550":1342,"_30605":1316,"_5":30961,"_21201":54194,"_27821":54195,"_3006":54196},[],"/docs/pr-preview/pr-66/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3550":1343,"_30605":1316,"_21201":54198,"_5":14582,"_27821":1316,"_3006":54199},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3550":1344,"_30605":1316,"_21201":54201,"_5":14582,"_27821":1316,"_3006":54202},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3550":1345,"_30605":1316,"_21201":54204,"_5":14582,"_27821":1316,"_3006":54205},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3550":1346,"_30605":1316,"_21201":54207,"_5":14582,"_27821":54099,"_3006":54208},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3550":1347,"_30605":1316,"_21201":54210,"_5":14582,"_27821":54099,"_3006":54211},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3550":1348,"_30605":1316,"_21201":54213,"_5":14582,"_27821":54099,"_3006":54214},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3550":1349,"_30605":1316,"_21201":54216,"_5":14582,"_27821":54099,"_3006":54217},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3550":1350,"_30605":1316,"_21201":54219,"_5":14582,"_27821":54103,"_3006":54220},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3550":1351,"_30605":1316,"_21201":54222,"_5":14582,"_27821":54107,"_3006":54223},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3550":1352,"_30605":1316,"_21201":54225,"_5":14582,"_27821":54107,"_3006":54226},[],"IAM action",{"_3550":1353,"_30605":1316,"_21201":54228,"_5":14582,"_27821":54107,"_3006":50385},[],{"_3550":1354,"_30605":1316,"_21201":54230,"_5":14582,"_27821":54107,"_3006":54231},[],"`iot:GetRegistrationCode`",{"_3550":1355,"_30605":1316,"_21201":54233,"_5":14582,"_27821":54107,"_3006":54234},[],"Obtain the verification code for CA registration in the Primary Account",{"_3550":1356,"_30605":1316,"_21201":54236,"_5":14582,"_27821":54107,"_3006":54237},[],"`iot:RegisterCACertificate`",{"_3550":1357,"_30605":1316,"_21201":54239,"_5":14582,"_27821":54107,"_3006":54240},[],"Register the CA in AWS IoT",{"_3550":1358,"_30605":1316,"_21201":54242,"_5":14582,"_27821":54107,"_3006":54243},[],"`iot:DescribeCACertificate`",{"_3550":1359,"_30605":1316,"_21201":54245,"_5":14582,"_27821":54107,"_3006":54246},[],"Check the CA registration status",{"_3550":1360,"_30605":1316,"_21201":54248,"_5":14582,"_27821":54107,"_3006":54249},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3550":1361,"_30605":1316,"_21201":54251,"_5":14582,"_27821":54107,"_3006":54252},[],"Create or update Things in IoT Core",{"_3550":1362,"_30605":1316,"_21201":54254,"_5":14582,"_27821":54107,"_3006":54255},[],"`iot:RegisterThing`",{"_3550":1363,"_30605":1316,"_21201":54257,"_5":14582,"_27821":54107,"_3006":54258},[],"Provision Things through a template",{"_3550":1364,"_30605":1316,"_21201":54260,"_5":14582,"_27821":54107,"_3006":54261},[],"`iot:RegisterCertificate`",{"_3550":1365,"_30605":1316,"_21201":54263,"_5":14582,"_27821":54107,"_3006":54264},[],"Register device certificates",{"_3550":1366,"_30605":1316,"_21201":54266,"_5":14582,"_27821":54107,"_3006":54267},[],"`iot:UpdateCertificate`",{"_3550":1367,"_30605":1316,"_21201":54269,"_5":14582,"_27821":54107,"_3006":54270},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3550":1368,"_30605":1316,"_21201":54272,"_5":14582,"_27821":54107,"_3006":54273},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3550":1369,"_30605":1316,"_21201":54275,"_5":14582,"_27821":54107,"_3006":54276},[],"Create and attach IoT policies",{"_3550":1370,"_30605":1316,"_21201":54278,"_5":14582,"_27821":54107,"_3006":54279},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3550":1371,"_30605":1316,"_21201":54281,"_5":14582,"_27821":54107,"_3006":54282},[],"Manage Thing groups",{"_3550":1372,"_30605":1316,"_21201":54284,"_5":14582,"_27821":54107,"_3006":54285},[],"`iot:CreateProvisioningTemplate`",{"_3550":1373,"_30605":1316,"_21201":54287,"_5":14582,"_27821":54107,"_3006":54288},[],"Create JITP templates",{"_3550":1374,"_30605":1316,"_21201":54290,"_5":14582,"_27821":54107,"_3006":54291},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3550":1375,"_30605":1316,"_21201":54293,"_5":14582,"_27821":54107,"_3006":54294},[],"Read and write the Device Shadow",{"_3550":1376,"_30605":1316,"_21201":54296,"_5":14582,"_27821":54107,"_3006":54297},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3550":1377,"_30605":1316,"_21201":54299,"_5":14582,"_27821":54111,"_3006":54300},[],"Parameter",{"_3550":1378,"_30605":1316,"_21201":54302,"_5":14582,"_27821":54111,"_3006":54303},[],"Type",{"_3550":1379,"_30605":1316,"_21201":54305,"_5":14582,"_27821":54111,"_3006":54306},[],"Required",{"_3550":1380,"_30605":1316,"_21201":54308,"_5":14582,"_27821":54111,"_3006":54309},[],"Description",{"_3550":1381,"_30605":1316,"_21201":54311,"_5":14582,"_27821":54111,"_3006":54312},[],"`connector_id`",{"_3550":1382,"_30605":1316,"_21201":54314,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1383,"_30605":1316,"_21201":54316,"_5":14582,"_27821":54111,"_3006":54317},[],"Yes",{"_3550":1384,"_30605":1316,"_21201":54319,"_5":14582,"_27821":54111,"_3006":54320},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3550":1385,"_30605":1316,"_21201":54322,"_5":14582,"_27821":54111,"_3006":54323},[],"`aws_config.region`",{"_3550":1386,"_30605":1316,"_21201":54325,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1387,"_30605":1316,"_21201":54327,"_5":14582,"_27821":54111,"_3006":54317},[],{"_3550":1388,"_30605":1316,"_21201":54329,"_5":14582,"_27821":54111,"_3006":54330},[],"AWS region where the connector operates.",{"_3550":1389,"_30605":1316,"_21201":54332,"_5":14582,"_27821":54111,"_3006":54333},[],"`aws_config.auth_method`",{"_3550":1390,"_30605":1316,"_21201":54335,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1391,"_30605":1316,"_21201":54337,"_5":14582,"_27821":54111,"_3006":54317},[],{"_3550":1392,"_30605":1316,"_21201":54339,"_5":14582,"_27821":54111,"_3006":54340},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3550":1393,"_30605":1316,"_21201":54342,"_5":14582,"_27821":54111,"_3006":54343},[],"`aws_config.access_key_id`",{"_3550":1394,"_30605":1316,"_21201":54345,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1395,"_30605":1316,"_21201":54347,"_5":14582,"_27821":54111,"_3006":54348},[],"Only with `auth_method=static`",{"_3550":1396,"_30605":1316,"_21201":54350,"_5":14582,"_27821":54111,"_3006":54351},[],"AWS access key.",{"_3550":1397,"_30605":1316,"_21201":54353,"_5":14582,"_27821":54111,"_3006":54354},[],"`aws_config.secret_access_key`",{"_3550":1398,"_30605":1316,"_21201":54356,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1399,"_30605":1316,"_21201":54358,"_5":14582,"_27821":54111,"_3006":54348},[],{"_3550":1400,"_30605":1316,"_21201":54360,"_5":14582,"_27821":54111,"_3006":54361},[],"AWS secret key.",{"_3550":1401,"_30605":1316,"_21201":54363,"_5":14582,"_27821":54111,"_3006":54364},[],"`aws_config.session_token`",{"_3550":1402,"_30605":1316,"_21201":54366,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1403,"_30605":1316,"_21201":54368,"_5":14582,"_27821":54111,"_3006":54369},[],"No",{"_3550":1404,"_30605":1316,"_21201":54371,"_5":14582,"_27821":54111,"_3006":54372},[],"Session token (with `auth_method=static`).",{"_3550":1405,"_30605":1316,"_21201":54374,"_5":14582,"_27821":54111,"_3006":54375},[],"`aws_config.role_arn`",{"_3550":1406,"_30605":1316,"_21201":54377,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1407,"_30605":1316,"_21201":54379,"_5":14582,"_27821":54111,"_3006":54380},[],"Only with `auth_method=role`",{"_3550":1408,"_30605":1316,"_21201":54382,"_5":14582,"_27821":54111,"_3006":54383},[],"ARN of the role to assume.",{"_3550":1409,"_30605":1316,"_21201":54385,"_5":14582,"_27821":54111,"_3006":54386},[],"`aws_config.endpoint_url`",{"_3550":1410,"_30605":1316,"_21201":54388,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1411,"_30605":1316,"_21201":54390,"_5":14582,"_27821":54111,"_3006":54369},[],{"_3550":1412,"_30605":1316,"_21201":54392,"_5":14582,"_27821":54111,"_3006":54393},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3550":1413,"_30605":1316,"_21201":54395,"_5":14582,"_27821":54111,"_3006":54396},[],"`subscriber_event_bus`",{"_3550":1414,"_30605":1316,"_21201":54398,"_5":14582,"_27821":54111,"_3006":17853},[],{"_3550":1415,"_30605":1316,"_21201":54400,"_5":14582,"_27821":54111,"_3006":54317},[],{"_3550":1416,"_30605":1316,"_21201":54402,"_5":14582,"_27821":54111,"_3006":54403},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3550":1417,"_30605":1316,"_21201":54405,"_5":14582,"_27821":54111,"_3006":54406},[],"`dms_manager_client`",{"_3550":1418,"_30605":1316,"_21201":54408,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1419,"_30605":1316,"_21201":54410,"_5":14582,"_27821":54111,"_3006":54317},[],{"_3550":1420,"_30605":1316,"_21201":54412,"_5":14582,"_27821":54111,"_3006":54413},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3550":1421,"_30605":1316,"_21201":54415,"_5":14582,"_27821":54111,"_3006":54416},[],"`device_manager_client`",{"_3550":1422,"_30605":1316,"_21201":54418,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1423,"_30605":1316,"_21201":54420,"_5":14582,"_27821":54111,"_3006":54317},[],{"_3550":1424,"_30605":1316,"_21201":54422,"_5":14582,"_27821":54111,"_3006":54423},[],"HTTP URL of Lamassu's Device Manager.",{"_3550":1425,"_30605":1316,"_21201":54425,"_5":14582,"_27821":54111,"_3006":54426},[],"`ca_client`",{"_3550":1426,"_30605":1316,"_21201":54428,"_5":14582,"_27821":54111,"_3006":25326},[],{"_3550":1427,"_30605":1316,"_21201":54430,"_5":14582,"_27821":54111,"_3006":54317},[],{"_3550":1428,"_30605":1316,"_21201":54432,"_5":14582,"_27821":54111,"_3006":54433},[],"HTTP URL of Lamassu's CA service.",{"_3550":1429,"_30605":1316,"_21201":54435,"_5":14582,"_27821":54115,"_3006":54436},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3550":1430,"_30605":1316,"_21201":54438,"_5":14582,"_27821":54115,"_3006":54439},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3550":1431,"_30605":1316,"_21201":54441,"_5":14582,"_27821":54115,"_3006":54442},[],"CloudEvent type",{"_3550":1432,"_30605":1316,"_21201":54444,"_5":14582,"_27821":54115,"_3006":54445},[],"Lamassu resource",{"_3550":1433,"_30605":1316,"_21201":54447,"_5":14582,"_27821":54115,"_3006":54448},[],"AWS Resource",{"_3550":1434,"_30605":1316,"_21201":54450,"_5":14582,"_27821":54115,"_3006":54451},[],"IAM actions",{"_3550":1435,"_30605":1316,"_21201":54453,"_5":14582,"_27821":54115,"_3006":54454},[],"AWS calls and effect",{"_3550":1436,"_30605":1316,"_21201":54456,"_5":14582,"_27821":54115,"_3006":54457},[],"Where in this page",{"_3550":1437,"_30605":1316,"_21201":54459,"_5":14582,"_27821":54115,"_3006":54460},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3550":1438,"_30605":1316,"_21201":54462,"_5":14582,"_27821":54115,"_3006":54463},[],"CA",{"_3550":1439,"_30605":1316,"_21201":54465,"_5":14582,"_27821":54115,"_3006":54466},[],"`IoTCore/CACertificate`",{"_3550":1440,"_30605":1316,"_21201":54468,"_5":14582,"_27821":54115,"_3006":54469},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3550":1441,"_30605":1316,"_21201":54471,"_5":14582,"_27821":54115,"_3006":54472},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3550":1442,"_30605":1316,"_21201":54474,"_5":14582,"_27821":54115,"_3006":54128},[],{"_3550":1443,"_30605":1316,"_21201":54476,"_5":14582,"_27821":54115,"_3006":54477},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3550":1444,"_30605":1316,"_21201":54479,"_5":14582,"_27821":54115,"_3006":54480},[],"DMS",{"_3550":1445,"_30605":1316,"_21201":54482,"_5":14582,"_27821":54115,"_3006":54483},[],"`IoTCore/ProvisioningTemplate`",{"_3550":1446,"_30605":1316,"_21201":54485,"_5":14582,"_27821":54115,"_3006":54486},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3550":1447,"_30605":1316,"_21201":54488,"_5":14582,"_27821":54115,"_3006":54489},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3550":1448,"_30605":1316,"_21201":54491,"_5":14582,"_27821":54115,"_3006":54156},[],{"_3550":1449,"_30605":1316,"_21201":54493,"_5":14582,"_27821":54115,"_3006":54494},[],"`EventBindDeviceIdentityKey`",{"_3550":1450,"_30605":1316,"_21201":54496,"_5":14582,"_27821":54115,"_3006":54497},[],"Device",{"_3550":1451,"_30605":1316,"_21201":54499,"_5":14582,"_27821":54115,"_3006":54500},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3550":1452,"_30605":1316,"_21201":54502,"_5":14582,"_27821":54115,"_3006":54503},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3550":1453,"_30605":1316,"_21201":54505,"_5":14582,"_27821":54115,"_3006":54506},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3550":1454,"_30605":1316,"_21201":54508,"_5":14582,"_27821":54115,"_3006":54164},[],{"_3550":1455,"_30605":1316,"_21201":54510,"_5":14582,"_27821":54115,"_3006":54511},[],"`EventUpdateCertificateStatusKey`",{"_3550":1456,"_30605":1316,"_21201":54513,"_5":14582,"_27821":54115,"_3006":54514},[],"Certificate",{"_3550":1457,"_30605":1316,"_21201":54516,"_5":14582,"_27821":54115,"_3006":54517},[],"`IoTCore/Certificate`",{"_3550":1458,"_30605":1316,"_21201":54519,"_5":14582,"_27821":54115,"_3006":54520},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3550":1459,"_30605":1316,"_21201":54522,"_5":14582,"_27821":54115,"_3006":54523},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3550":1460,"_30605":1316,"_21201":54525,"_5":14582,"_27821":54115,"_3006":54176},[],{"_3550":1461,"_30605":1316,"_21201":54527,"_5":14582,"_27821":54115,"_3006":54528},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3550":1462,"_30605":1316,"_21201":54530,"_5":14582,"_27821":54115,"_3006":54531},[],"Certificate / Device",{"_3550":1463,"_30605":1316,"_21201":54533,"_5":14582,"_27821":54115,"_3006":54534},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3550":1464,"_30605":1316,"_21201":54536,"_5":14582,"_27821":54115,"_3006":50391},[],{"_3550":1465,"_30605":1316,"_21201":54538,"_5":14582,"_27821":54115,"_3006":54539},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3550":1466,"_30605":1316,"_21201":54541,"_5":14582,"_27821":54115,"_3006":54184},[],{"_3550":1467,"_30605":1316,"_21201":54543,"_5":14582,"_27821":54119,"_3006":54544},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3550":1468,"_30605":1316,"_21201":54546,"_5":14582,"_27821":54123,"_3006":54547},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3550":1469,"_30605":1316,"_21201":54549,"_5":14582,"_27821":54123,"_3006":54550},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3550":1470,"_30605":1316,"_21201":54552,"_5":14582,"_27821":54127,"_3006":54553},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3550":1471,"_30605":1316,"_21201":54555,"_5":14582,"_27821":54127,"_3006":54556},[],"Transition",{"_3550":1472,"_30605":1316,"_21201":54558,"_5":14582,"_27821":54127,"_3006":54559},[],"AWS calls",{"_3550":1473,"_30605":1316,"_21201":54561,"_5":14582,"_27821":54127,"_3006":54562},[],"`NotRegistered` → `Requested`",{"_3550":1474,"_30605":1316,"_21201":54564,"_5":14582,"_27821":54127,"_3006":54565},[],"none (metadata write only)",{"_3550":1475,"_30605":1316,"_21201":54567,"_5":14582,"_27821":54127,"_3006":54568},[],"`Requested` → `Registering`",{"_3550":1476,"_30605":1316,"_21201":54570,"_5":14582,"_27821":54127,"_3006":54571},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3550":1477,"_30605":1316,"_21201":54573,"_5":14582,"_27821":54127,"_3006":54574},[],"`Registering` → `Succeeded`",{"_3550":1478,"_30605":1316,"_21201":54576,"_5":14582,"_27821":54127,"_3006":54577},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3550":1479,"_30605":1316,"_21201":54579,"_5":14582,"_27821":54127,"_3006":54580},[],"`Registering` → `Failed`",{"_3550":1480,"_30605":1316,"_21201":54582,"_5":14582,"_27821":54127,"_3006":54583},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3550":1481,"_30605":1316,"_21201":54585,"_5":14582,"_27821":54127,"_3006":54586},[],"`Failed` / `Succeeded` → `Requested`",{"_3550":1482,"_30605":1316,"_21201":54588,"_5":14582,"_27821":54127,"_3006":54589},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3550":1483,"_30605":1316,"_21201":54591,"_5":14582,"_27821":54131,"_3006":54592},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3550":1484,"_30605":1316,"_21201":54594,"_5":14582,"_27821":54131,"_3006":54595},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3550":1485,"_30605":1316,"_21201":54597,"_5":14582,"_27821":54131,"_3006":54598},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3550":1486,"_30605":1316,"_21201":54600,"_5":14582,"_27821":54131,"_3006":54601},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3550":1487,"_30605":1316,"_21201":54603,"_5":14582,"_27821":54131,"_3006":54604},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3550":1488,"_30605":1316,"_21201":54606,"_5":14582,"_27821":54131,"_3006":54607},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3550":1489,"_30605":1316,"_21201":54609,"_5":14582,"_27821":54135,"_3006":54610},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3550":1490,"_30605":1316,"_21201":54612,"_5":14582,"_27821":54139,"_3006":54613},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3550":1491,"_30605":1316,"_21201":54615,"_5":14582,"_27821":54139,"_3006":54616},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3550":1492,"_30605":1316,"_21201":54618,"_5":14582,"_27821":54143,"_3006":54619},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3550":1493,"_30605":1316,"_21201":54621,"_5":14582,"_27821":54147,"_3006":54622},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3550":1494,"_30605":1316,"_21201":54624,"_5":14582,"_27821":54147,"_3006":54625},[],"Creates or updates the IoT policies configured in the DMS.",{"_3550":1495,"_30605":1316,"_21201":54627,"_5":14582,"_27821":54147,"_3006":54628},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3550":1496,"_30605":1316,"_21201":54630,"_5":14582,"_27821":54147,"_3006":54631},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3550":1497,"_30605":1316,"_21201":54633,"_5":14582,"_27821":54147,"_3006":54634},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3550":1498,"_30605":1316,"_21201":54636,"_5":14582,"_27821":54147,"_3006":54637},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3550":1499,"_30605":1316,"_21201":54639,"_5":14582,"_27821":54147,"_3006":54640},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3550":1500,"_30605":1316,"_21201":54642,"_5":14582,"_27821":54151,"_3006":54643},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3550":1501,"_30605":1316,"_21201":54645,"_5":14582,"_27821":54151,"_3006":54646},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3550":1502,"_30605":1316,"_21201":54648,"_5":14582,"_27821":54151,"_3006":54649},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3550":1503,"_30605":1316,"_21201":54651,"_5":14582,"_27821":54151,"_3006":54652},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3550":1504,"_30605":1316,"_21201":54654,"_5":14582,"_27821":54151,"_3006":54655},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3550":1505,"_30605":1316,"_21201":54657,"_5":14582,"_27821":54155,"_3006":54658},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3550":1506,"_30605":1316,"_21201":54660,"_5":14582,"_27821":54155,"_3006":54556},[],{"_3550":1507,"_30605":1316,"_21201":54662,"_5":14582,"_27821":54155,"_3006":54559},[],{"_3550":1508,"_30605":1316,"_21201":54664,"_5":14582,"_27821":54155,"_3006":54665},[],"`Unconfigured` → `None` / `Auto`",{"_3550":1509,"_30605":1316,"_21201":54667,"_5":14582,"_27821":54155,"_3006":54668},[],"none (configuration only)",{"_3550":1510,"_30605":1316,"_21201":54670,"_5":14582,"_27821":54155,"_3006":54671},[],"`None` ↔ `Auto`",{"_3550":1511,"_30605":1316,"_21201":54673,"_5":14582,"_27821":54155,"_3006":54668},[],{"_3550":1512,"_30605":1316,"_21201":54675,"_5":14582,"_27821":54155,"_3006":54676},[],"Any → `Jitp`",{"_3550":1513,"_30605":1316,"_21201":54678,"_5":14582,"_27821":54155,"_3006":54679},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3550":1514,"_30605":1316,"_21201":54681,"_5":14582,"_27821":54155,"_3006":54682},[],"`Jitp` → `None` / `Auto`",{"_3550":1515,"_30605":1316,"_21201":54684,"_5":14582,"_27821":54155,"_3006":54685},[],"none (the template stays in the AWS account)",{"_3550":1516,"_30605":1316,"_21201":54687,"_5":14582,"_27821":54159,"_3006":54688},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3550":1517,"_30605":1316,"_21201":54690,"_5":14582,"_27821":54159,"_3006":54691},[],"The full flow from the device's perspective is:",{"_3550":1518,"_30605":1316,"_21201":54693,"_5":14582,"_27821":54159,"_3006":54694},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3550":1519,"_30605":1316,"_21201":54696,"_5":14582,"_27821":54163,"_3006":54697},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3550":1520,"_30605":1316,"_21201":54699,"_5":14582,"_27821":54163,"_3006":54556},[],{"_3550":1521,"_30605":1316,"_21201":54701,"_5":14582,"_27821":54163,"_3006":54559},[],{"_3550":1522,"_30605":1316,"_21201":54703,"_5":14582,"_27821":54163,"_3006":54704},[],"`Absent` → `Provisioned`",{"_3550":1523,"_30605":1316,"_21201":54706,"_5":14582,"_27821":54163,"_3006":54707},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3550":1524,"_30605":1316,"_21201":54709,"_5":14582,"_27821":54163,"_3006":54710},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3550":1525,"_30605":1316,"_21201":54712,"_5":14582,"_27821":54163,"_3006":54713},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3550":1526,"_30605":1316,"_21201":54715,"_5":14582,"_27821":54163,"_3006":54716},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3550":1527,"_30605":1316,"_21201":54718,"_5":14582,"_27821":54167,"_3006":54719},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3550":1528,"_30605":1316,"_21201":54721,"_5":14582,"_27821":54167,"_3006":54722},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3550":1529,"_30605":1316,"_21201":54724,"_5":14582,"_27821":54167,"_3006":54725},[],"For the JITP flow to work correctly:",{"_3550":1530,"_30605":1316,"_21201":54727,"_5":14582,"_27821":54167,"_3006":54728},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3550":1531,"_30605":1316,"_21201":54730,"_5":14582,"_27821":54167,"_3006":54731},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3550":1532,"_30605":1316,"_21201":54733,"_5":14582,"_27821":54167,"_3006":54734},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3550":1533,"_30605":1316,"_21201":54736,"_5":14582,"_27821":54167,"_3006":54737},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3550":1534,"_30605":1316,"_21201":54739,"_5":14582,"_27821":54171,"_3006":54740},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3550":1535,"_30605":1316,"_21201":54742,"_5":14582,"_27821":54171,"_3006":54743},[],"Status in Lamassu",{"_3550":1536,"_30605":1316,"_21201":54745,"_5":14582,"_27821":54171,"_3006":54746},[],"Revocation reason",{"_3550":1537,"_30605":1316,"_21201":54748,"_5":14582,"_27821":54171,"_3006":54749},[],"Status in AWS IoT Core",{"_3550":1538,"_30605":1316,"_21201":54751,"_5":14582,"_27821":54171,"_3006":54752},[],"`Active`",{"_3550":1539,"_30605":1316,"_21201":54754,"_5":14582,"_27821":54171,"_3006":54755},[],"None",{"_3550":1540,"_30605":1316,"_21201":54757,"_5":14582,"_27821":54171,"_3006":54758},[],"`ACTIVE`",{"_3550":1541,"_30605":1316,"_21201":54760,"_5":14582,"_27821":54171,"_3006":54761},[],"`Revoked`",{"_3550":1542,"_30605":1316,"_21201":54763,"_5":14582,"_27821":54171,"_3006":54764},[],"`certificateHold`",{"_3550":1543,"_30605":1316,"_21201":54766,"_5":14582,"_27821":54171,"_3006":54767},[],"`INACTIVE`",{"_3550":1544,"_30605":1316,"_21201":54769,"_5":14582,"_27821":54171,"_3006":54761},[],{"_3550":1545,"_30605":1316,"_21201":54771,"_5":14582,"_27821":54171,"_3006":54772},[],"Any other reason",{"_3550":1546,"_30605":1316,"_21201":54774,"_5":14582,"_27821":54171,"_3006":54775},[],"`REVOKED`",{"_3550":1547,"_30605":1316,"_21201":54777,"_5":14582,"_27821":54171,"_3006":54778},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3550":1548,"_30605":1316,"_21201":54780,"_5":14582,"_27821":54175,"_3006":54781},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3550":1549,"_30605":1316,"_21201":54783,"_5":14582,"_27821":54175,"_3006":54556},[],{"_3550":1550,"_30605":1316,"_21201":54785,"_5":14582,"_27821":54175,"_3006":54559},[],{"_3550":1551,"_30605":1316,"_21201":54787,"_5":14582,"_27821":54175,"_3006":54788},[],"`NotSynced` → `Active`",{"_3550":1552,"_30605":1316,"_21201":54790,"_5":14582,"_27821":54175,"_3006":54267},[],{"_3550":1553,"_30605":1316,"_21201":54792,"_5":14582,"_27821":54175,"_3006":54793},[],"`Active` → `Inactive`",{"_3550":1554,"_30605":1316,"_21201":54795,"_5":14582,"_27821":54175,"_3006":54796},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3550":1555,"_30605":1316,"_21201":54798,"_5":14582,"_27821":54175,"_3006":54799},[],"`Active` → `Revoked`",{"_3550":1556,"_30605":1316,"_21201":54801,"_5":14582,"_27821":54175,"_3006":54796},[],{"_3550":1557,"_30605":1316,"_21201":54803,"_5":14582,"_27821":54175,"_3006":54804},[],"`Inactive` / `Revoked` → `Active`",{"_3550":1558,"_30605":1316,"_21201":54806,"_5":14582,"_27821":54175,"_3006":54267},[],{"_3550":1559,"_30605":1316,"_21201":54808,"_5":14582,"_27821":54175,"_3006":54809},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3550":1560,"_30605":1316,"_21201":54811,"_5":14582,"_27821":54175,"_3006":54812},[],"none (these states are not synced to AWS)",{"_3550":1561,"_30605":1316,"_21201":54814,"_5":14582,"_27821":54179,"_3006":54815},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3550":1562,"_30605":1316,"_21201":54817,"_5":14582,"_27821":54179,"_3006":54818},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3550":1563,"_30605":1316,"_21201":54820,"_5":14582,"_27821":54179,"_3006":54821},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3550":1564,"_30605":1316,"_21201":54823,"_5":14582,"_27821":54183,"_3006":54824},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3550":1565,"_30605":1316,"_21201":54826,"_5":14582,"_27821":54183,"_3006":54827},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3550":1566,"_30605":1316,"_21201":54829,"_5":14582,"_27821":54187,"_3006":54830},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3550":1567,"_30605":1316,"_21201":54832,"_5":14582,"_27821":54187,"_3006":54833},[],"There are two action types:",{"_3550":1568,"_30605":1316,"_21201":54835,"_5":14582,"_27821":54187,"_3006":54836},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3550":1569,"_30605":1316,"_21201":54838,"_5":14582,"_27821":54187,"_3006":54839},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3550":1570,"_30605":1316,"_21201":54841,"_5":14582,"_27821":54187,"_3006":54842},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3550":1571,"_30605":1316,"_21201":54844,"_5":14582,"_27821":54191,"_3006":54845},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3550":1572,"_30605":1316,"_21201":54847,"_5":14582,"_27821":54191,"_3006":54848},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3550":1573,"_30605":1316,"_21201":54850,"_5":14582,"_27821":54191,"_3006":54851},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3550":1574,"_30605":1316,"_21201":54853,"_5":14582,"_27821":54195,"_3006":54854},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3550":1575,"_30605":1316,"_21201":54856,"_5":14582,"_27821":54195,"_3006":54857},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3550":1576,"_30605":1316,"_21201":54859,"_5":14582,"_27821":54195,"_3006":54860},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3550":1577,"_30605":1316,"_21201":54862,"_5":14582,"_27821":54195,"_3006":54863},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3550":1578,"_30605":1316,"_21201":54865,"_5":14582,"_27821":54195,"_3006":54866},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3550":1579,"_30605":1316,"_21201":54868,"_5":14582,"_27821":54195,"_3006":54869},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3550":1580,"_30605":1316,"_21201":54871,"_5":14582,"_27821":54195,"_3006":54872},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3550":1581,"_30605":1316,"_21201":54874,"_5":14582,"_27821":54195,"_3006":54875},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3550":1582,"_30605":1316,"_21201":54877,"_5":14582,"_27821":54195,"_3006":54878},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3550":1583,"_30605":1316,"_21201":54880,"_5":14582,"_27821":54195,"_3006":54881},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3550":1584,"_30605":1316,"_21201":54883,"_5":14582,"_27821":54195,"_3006":54884},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3550":1585,"_30605":1316,"_21201":54886,"_5":14582,"_27821":54195,"_3006":54887},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3550":1586,"_30605":1316,"_21201":54889,"_5":14582,"_27821":54195,"_3006":54890},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3550":1587,"_30605":1316,"_21201":54892,"_5":14582,"_27821":54195,"_3006":54893},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3550":1588,"_30605":1316,"_21201":54895,"_5":14582,"_27821":54195,"_3006":54896},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3550":1589,"_30605":1316,"_21201":54898,"_5":14582,"_27821":54195,"_3006":54899},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3550":1590,"_30605":1316,"_21201":54901,"_5":14582,"_27821":54195,"_3006":54902},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3550":1591,"_30605":1316,"_21201":54904,"_5":14582,"_27821":54195,"_3006":54905},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3550":1592,"_30605":1316,"_21201":54907,"_5":14582,"_27821":54195,"_3006":54908},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3550":1593,"_30605":1316,"_21201":54910,"_5":14582,"_27821":54195,"_3006":54911},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3550":1594,"_30605":1316,"_21201":54913,"_5":14582,"_27821":54195,"_3006":54914},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3550":1595,"_30605":1316,"_21201":54916,"_5":14582,"_27821":54195,"_3006":54917},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3550":1596,"_30605":1316,"_21201":54919,"_5":14582,"_27821":54195,"_3006":54920},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3550":1597,"_30605":1316,"_21201":54922,"_5":14582,"_27821":54195,"_3006":54923},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3550":1598,"_30605":1598,"_5":14934,"_3006":52630,"_30964":54925,"_21201":54926,"_27821":1598},[49995,51470,52630],[],{"_3550":1599,"_30605":1598,"_21201":54928,"_5":14582,"_27821":1598,"_3006":54929},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3550":1600,"_30605":1598,"_5":30961,"_21201":54931,"_27821":54932,"_3006":54933},[],"/docs/pr-preview/pr-66/platform/iot-fleets/overview#start-here","Start here",{"_3550":1601,"_30605":1598,"_5":30961,"_21201":54935,"_27821":54936,"_3006":52628},[],"/docs/pr-preview/pr-66/platform/iot-fleets/overview#devices-and-identities",{"_3550":1602,"_30605":1598,"_5":30961,"_21201":54938,"_27821":54939,"_3006":52811},[],"/docs/pr-preview/pr-66/platform/iot-fleets/overview#enrollment-with-pki",{"_3550":1603,"_30605":1598,"_5":30961,"_21201":54941,"_27821":54942,"_3006":54092},[],"/docs/pr-preview/pr-66/platform/iot-fleets/overview#integrations",{"_3550":1604,"_30605":1598,"_5":30961,"_21201":54944,"_27821":54945,"_3006":54946},[],"/docs/pr-preview/pr-66/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3550":1605,"_30605":1598,"_21201":54948,"_5":14582,"_27821":1598,"_3006":54949},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3550":1606,"_30605":1598,"_21201":54951,"_5":14582,"_27821":54932,"_3006":54952},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3550":1607,"_30605":1598,"_21201":54954,"_5":14582,"_27821":54932,"_3006":54955},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3550":1608,"_30605":1598,"_21201":54957,"_5":14582,"_27821":54936,"_3006":54958},[],"Resource",{"_3550":1609,"_30605":1598,"_21201":54960,"_5":14582,"_27821":54936,"_3006":54961},[],"What it represents",{"_3550":1610,"_30605":1598,"_21201":54963,"_5":14582,"_27821":54936,"_3006":54964},[],"**Device**",{"_3550":1611,"_30605":1598,"_21201":54966,"_5":14582,"_27821":54936,"_3006":54967},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3550":1612,"_30605":1598,"_21201":54969,"_5":14582,"_27821":54936,"_3006":54970},[],"**Identity**",{"_3550":1613,"_30605":1598,"_21201":54972,"_5":14582,"_27821":54936,"_3006":54973},[],"The device's association with its certificates: an active version and a history.",{"_3550":1614,"_30605":1598,"_21201":54975,"_5":14582,"_27821":54936,"_3006":54976},[],"**DMS**",{"_3550":1615,"_30605":1598,"_21201":54978,"_5":14582,"_27821":54936,"_3006":54979},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3550":1616,"_30605":1598,"_21201":54981,"_5":14582,"_27821":54936,"_3006":54982},[],"**Fleet**",{"_3550":1617,"_30605":1598,"_21201":54984,"_5":14582,"_27821":54936,"_3006":54985},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3550":1618,"_30605":1598,"_21201":54987,"_5":14582,"_27821":54936,"_3006":54988},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3550":1619,"_30605":1598,"_21201":54990,"_5":14582,"_27821":54936,"_3006":54991},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3550":1620,"_30605":1598,"_21201":54993,"_5":14582,"_27821":54939,"_3006":54994},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3550":1621,"_30605":1598,"_21201":54996,"_5":14582,"_27821":54939,"_3006":54997},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3550":1622,"_30605":1598,"_21201":54999,"_5":14582,"_27821":54939,"_3006":55000},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3550":1623,"_30605":1598,"_21201":55002,"_5":14582,"_27821":54939,"_3006":55003},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3550":1624,"_30605":1598,"_21201":55005,"_5":14582,"_27821":54939,"_3006":55006},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3550":1625,"_30605":1598,"_21201":55008,"_5":14582,"_27821":54939,"_3006":55009},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3550":1626,"_30605":1598,"_21201":55011,"_5":14582,"_27821":54939,"_3006":55012},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3550":1627,"_30605":1598,"_21201":55014,"_5":14582,"_27821":54939,"_3006":55015},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3550":1628,"_30605":1598,"_21201":55017,"_5":14582,"_27821":54942,"_3006":55018},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3550":1629,"_30605":1598,"_21201":55020,"_5":14582,"_27821":54942,"_3006":55021},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3550":1630,"_30605":1598,"_21201":55023,"_5":14582,"_27821":54945,"_3006":55024},[],"Participant",{"_3550":1631,"_30605":1598,"_21201":55026,"_5":14582,"_27821":54945,"_3006":55027},[],"Responsibility",{"_3550":1632,"_30605":1598,"_21201":55029,"_5":14582,"_27821":54945,"_3006":55030},[],"PKI administrator",{"_3550":1633,"_30605":1598,"_21201":55032,"_5":14582,"_27821":54945,"_3006":55033},[],"CA, issuance profile, chain and revocation publication.",{"_3550":1634,"_30605":1598,"_21201":55035,"_5":14582,"_27821":54945,"_3006":55036},[],"Provisioning administrator",{"_3550":1635,"_30605":1598,"_21201":55038,"_5":14582,"_27821":54945,"_3006":55039},[],"DMS, admission, authentication per operation and inventory.",{"_3550":1636,"_30605":1598,"_21201":55041,"_5":14582,"_27821":54945,"_3006":55042},[],"Device integrator",{"_3550":1637,"_30605":1598,"_21201":55044,"_5":14582,"_27821":54945,"_3006":55045},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3550":1638,"_30605":1598,"_21201":55047,"_5":14582,"_27821":54945,"_3006":55048},[],"Consumer integrator",{"_3550":1639,"_30605":1598,"_21201":55050,"_5":14582,"_27821":54945,"_3006":55051},[],"Trusted issuers, validation and device permissions in the destination.",{"_3550":1640,"_30605":1598,"_21201":55053,"_5":14582,"_27821":54945,"_3006":55054},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3550":1641,"_30605":1641,"_5":14934,"_3006":55056,"_30964":55057,"_21201":55059,"_27821":1641},"Enroll and connect your first device",[49995,51470,52630,55058],"Getting started",[],{"_3550":1642,"_30605":1641,"_21201":55061,"_5":14582,"_27821":1641,"_3006":55062},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3550":1643,"_30605":1641,"_5":30961,"_21201":55064,"_27821":55065,"_3006":50005},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3550":1644,"_30605":1641,"_5":30961,"_21201":55067,"_27821":55068,"_3006":55069},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3550":1645,"_30605":1641,"_5":30961,"_21201":55071,"_27821":55072,"_3006":55073},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3550":1646,"_30605":1641,"_5":30961,"_21201":55075,"_27821":55076,"_3006":55077},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3550":1647,"_30605":1641,"_5":30961,"_21201":55079,"_27821":55080,"_3006":55081},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3550":1648,"_30605":1641,"_5":30961,"_21201":55083,"_27821":55084,"_3006":55085},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3550":1649,"_30605":1641,"_5":30961,"_21201":55087,"_27821":55088,"_3006":55089},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3550":1650,"_30605":1641,"_5":30961,"_21201":55091,"_27821":55092,"_3006":55093},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3550":1651,"_30605":1641,"_21201":55095,"_5":14582,"_27821":1641,"_3006":55096},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3550":1652,"_30605":1641,"_21201":55098,"_5":14582,"_27821":55065,"_3006":55099},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3550":1653,"_30605":1641,"_21201":55101,"_5":14582,"_27821":55065,"_3006":55102},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3550":1654,"_30605":1641,"_21201":55104,"_5":14582,"_27821":55065,"_3006":55105},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3550":1655,"_30605":1641,"_21201":55107,"_5":14582,"_27821":55065,"_3006":55108},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3550":1656,"_30605":1641,"_21201":55110,"_5":14582,"_27821":55065,"_3006":55111},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3550":1657,"_30605":1641,"_21201":55113,"_5":14582,"_27821":55068,"_3006":55114},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3550":1658,"_30605":1641,"_21201":55116,"_5":14582,"_27821":55068,"_3006":55117},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3550":1659,"_30605":1641,"_21201":55119,"_5":14582,"_27821":55072,"_3006":55120},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3550":1660,"_30605":1641,"_21201":55122,"_5":14582,"_27821":55072,"_3006":55123},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3550":1661,"_30605":1641,"_21201":55125,"_5":14582,"_27821":55072,"_3006":55126},[],"Setting",{"_3550":1662,"_30605":1641,"_21201":55128,"_5":14582,"_27821":55072,"_3006":55129},[],"Evaluation value",{"_3550":1663,"_30605":1641,"_21201":55131,"_5":14582,"_27821":55072,"_3006":55132},[],"Enrollment CA",{"_3550":1664,"_30605":1641,"_21201":55134,"_5":14582,"_27821":55072,"_3006":55135},[],"Issuing root from `device-root.pem`.",{"_3550":1665,"_30605":1641,"_21201":55137,"_5":14582,"_27821":55072,"_3006":52941},[],{"_3550":1666,"_30605":1641,"_21201":55139,"_5":14582,"_27821":55072,"_3006":55140},[],"The 1-hour leaf profile you just prepared.",{"_3550":1667,"_30605":1641,"_21201":55142,"_5":14582,"_27821":55072,"_3006":55143},[],"Protocol / Registration Mode",{"_3550":1668,"_30605":1641,"_21201":55145,"_5":14582,"_27821":55072,"_3006":55146},[],"`EST_RFC7030` / `JITP`.",{"_3550":1669,"_30605":1641,"_21201":55148,"_5":14582,"_27821":55072,"_3006":55149},[],"Verify CSR Signature",{"_3550":1670,"_30605":1641,"_21201":55151,"_5":14582,"_27821":55072,"_3006":55152},[],"Enabled.",{"_3550":1671,"_30605":1641,"_21201":55154,"_5":14582,"_27821":55072,"_3006":55155},[],"Enable Replaceable Enrollment",{"_3550":1672,"_30605":1641,"_21201":55157,"_5":14582,"_27821":55072,"_3006":55158},[],"Disabled; the ID must be new.",{"_3550":1673,"_30605":1641,"_21201":55160,"_5":14582,"_27821":55072,"_3006":55161},[],"Initial authentication",{"_3550":1674,"_30605":1641,"_21201":55163,"_5":14582,"_27821":55072,"_3006":55164},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3550":1675,"_30605":1641,"_21201":55166,"_5":14582,"_27821":55072,"_3006":55167},[],"Renewal authentication",{"_3550":1676,"_30605":1641,"_21201":55169,"_5":14582,"_27821":55072,"_3006":55170},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3550":1677,"_30605":1641,"_21201":55172,"_5":14582,"_27821":55072,"_3006":55173},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3550":1678,"_30605":1641,"_21201":55175,"_5":14582,"_27821":55072,"_3006":55176},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3550":1679,"_30605":1641,"_21201":55178,"_5":14582,"_27821":55072,"_3006":55179},[],"Re-enrollment Delta",{"_3550":1680,"_30605":1641,"_21201":55181,"_5":14582,"_27821":55072,"_3006":55182},[],"1 hour.",{"_3550":1681,"_30605":1641,"_21201":55184,"_5":14582,"_27821":55072,"_3006":55185},[],"Preventive / Critical Delta",{"_3550":1682,"_30605":1641,"_21201":55187,"_5":14582,"_27821":55072,"_3006":55188},[],"30 minutes / 10 minutes.",{"_3550":1683,"_30605":1641,"_21201":55190,"_5":14582,"_27821":55072,"_3006":55191},[],"Revoke on Re-enrollment",{"_3550":1684,"_30605":1641,"_21201":55193,"_5":14582,"_27821":55072,"_3006":55194},[],"Disabled to test the successor before retiring the previous identity.",{"_3550":1685,"_30605":1641,"_21201":55196,"_5":14582,"_27821":55072,"_3006":52949},[],{"_3550":1686,"_30605":1641,"_21201":55198,"_5":14582,"_27821":55072,"_3006":55199},[],"Disabled; the operational key is generated in the client.",{"_3550":1687,"_30605":1641,"_21201":55201,"_5":14582,"_27821":55072,"_3006":55202},[],"CA Distribution",{"_3550":1688,"_30605":1641,"_21201":55204,"_5":14582,"_27821":55072,"_3006":55205},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3550":1689,"_30605":1641,"_21201":55207,"_5":14582,"_27821":55072,"_3006":55208},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3550":1690,"_30605":1641,"_21201":55210,"_5":14582,"_27821":55076,"_3006":55211},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3550":1691,"_30605":1641,"_21201":55213,"_5":14582,"_27821":55076,"_3006":55214},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3550":1692,"_30605":1641,"_21201":55216,"_5":14582,"_27821":55080,"_3006":55217},[],"Generate a new key and CSR with the selected identifier:",{"_3550":1693,"_30605":1641,"_21201":55219,"_5":14582,"_27821":55080,"_3006":55220},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3550":1694,"_30605":1641,"_21201":55222,"_5":14582,"_27821":55080,"_3006":55223},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3550":1695,"_30605":1641,"_21201":55225,"_5":14582,"_27821":55084,"_3006":55226},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3550":1696,"_30605":1641,"_21201":55228,"_5":14582,"_27821":55084,"_3006":55229},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3550":1697,"_30605":1641,"_21201":55231,"_5":14582,"_27821":55088,"_3006":55232},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3550":1698,"_30605":1641,"_21201":55234,"_5":14582,"_27821":55088,"_3006":55235},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3550":1699,"_30605":1641,"_21201":55237,"_5":14582,"_27821":55088,"_3006":55238},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3550":1700,"_30605":1641,"_21201":55240,"_5":14582,"_27821":55088,"_3006":55241},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3550":1701,"_30605":1641,"_21201":55243,"_5":14582,"_27821":55088,"_3006":55244},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3550":1702,"_30605":1641,"_21201":55246,"_5":14582,"_27821":55092,"_3006":55247},[],"Check",{"_3550":1703,"_30605":1641,"_21201":55249,"_5":14582,"_27821":55092,"_3006":55250},[],"Expected result",{"_3550":1704,"_30605":1641,"_21201":55252,"_5":14582,"_27821":55092,"_3006":55253},[],"Registration",{"_3550":1705,"_30605":1641,"_21201":55255,"_5":14582,"_27821":55092,"_3006":55256},[],"ID created automatically and correct DMS.",{"_3550":1706,"_30605":1641,"_21201":55258,"_5":14582,"_27821":55092,"_3006":54514},[],{"_3550":1707,"_30605":1641,"_21201":55260,"_5":14582,"_27821":55092,"_3006":55261},[],"CN, profile, serial and key verified.",{"_3550":1708,"_30605":1641,"_21201":55263,"_5":14582,"_27821":55092,"_3006":55264},[],"Inventory",{"_3550":1709,"_30605":1641,"_21201":55266,"_5":14582,"_27821":55092,"_3006":55267},[],"Received serial visible as the current identity and in history.",{"_3550":1710,"_30605":1641,"_21201":55269,"_5":14582,"_27821":55092,"_3006":55270},[],"Consumer",{"_3550":1711,"_30605":1641,"_21201":55272,"_5":14582,"_27821":55092,"_3006":55273},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3550":1712,"_30605":1641,"_21201":55275,"_5":14582,"_27821":55092,"_3006":55276},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3550":1713,"_30605":1641,"_21201":55278,"_5":14582,"_27821":55092,"_3006":55279},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3550":1714,"_30605":1714,"_5":14934,"_3006":52646,"_30964":55281,"_21201":55282,"_27821":1714},[49995,51470,52630,55058],[],{"_3550":1715,"_30605":1714,"_21201":55284,"_5":14582,"_27821":1714,"_3006":55285},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3550":1716,"_30605":1714,"_5":30961,"_21201":55287,"_27821":55288,"_3006":50005},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3550":1717,"_30605":1714,"_5":30961,"_21201":55290,"_27821":55291,"_3006":55292},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3550":1718,"_30605":1714,"_5":30961,"_21201":55294,"_27821":55295,"_3006":55296},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3550":1719,"_30605":1714,"_5":30961,"_21201":55298,"_27821":55299,"_3006":55300},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3550":1720,"_30605":1714,"_5":30961,"_21201":55302,"_27821":55303,"_3006":55304},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3550":1721,"_30605":1714,"_5":30961,"_21201":55306,"_27821":55307,"_3006":55308},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3550":1722,"_30605":1714,"_5":30961,"_21201":55310,"_27821":55311,"_3006":55250},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3550":1723,"_30605":1714,"_5":30961,"_21201":55313,"_27821":55314,"_3006":55315},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3550":1724,"_30605":1714,"_5":30961,"_21201":55317,"_27821":55318,"_3006":55319},[],"/docs/pr-preview/pr-66/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3550":1725,"_30605":1714,"_21201":55321,"_5":14582,"_27821":1714,"_3006":55322},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3550":1726,"_30605":1714,"_21201":55324,"_5":14582,"_27821":1714,"_3006":55325},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3550":1727,"_30605":1714,"_21201":55327,"_5":14582,"_27821":55288,"_3006":55328},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3550":1728,"_30605":1714,"_21201":55330,"_5":14582,"_27821":55288,"_3006":55331},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3550":1729,"_30605":1714,"_21201":55333,"_5":14582,"_27821":55288,"_3006":55334},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3550":1730,"_30605":1714,"_21201":55336,"_5":14582,"_27821":55288,"_3006":55337},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3550":1731,"_30605":1714,"_21201":55339,"_5":14582,"_27821":55291,"_3006":55340},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3550":1732,"_30605":1714,"_21201":55342,"_5":14582,"_27821":55291,"_3006":55343},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3550":1733,"_30605":1714,"_21201":55345,"_5":14582,"_27821":55291,"_3006":55346},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3550":1734,"_30605":1714,"_21201":55348,"_5":14582,"_27821":55291,"_3006":55349},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3550":1735,"_30605":1714,"_21201":55351,"_5":14582,"_27821":55291,"_3006":55352},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3550":1736,"_30605":1714,"_21201":55354,"_5":14582,"_27821":55291,"_3006":55355},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3550":1737,"_30605":1714,"_21201":55357,"_5":14582,"_27821":55291,"_3006":55358},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3550":1738,"_30605":1714,"_21201":55360,"_5":14582,"_27821":55291,"_3006":55361},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3550":1739,"_30605":1714,"_21201":55363,"_5":14582,"_27821":55295,"_3006":55364},[],"Open **Managed Devices** and the registration action. Complete:",{"_3550":1740,"_30605":1714,"_21201":55366,"_5":14582,"_27821":55295,"_3006":55367},[],"**Device ID**: `device-001`.",{"_3550":1741,"_30605":1714,"_21201":55369,"_5":14582,"_27821":55295,"_3006":55370},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3550":1742,"_30605":1714,"_21201":55372,"_5":14582,"_27821":55295,"_3006":55373},[],"**Icon** and **Tags**: optional classification.",{"_3550":1743,"_30605":1714,"_21201":55375,"_5":14582,"_27821":55295,"_3006":55376},[],"Confirm registration.",{"_3550":1744,"_30605":1714,"_21201":55378,"_5":14582,"_27821":55299,"_3006":55379},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3550":1745,"_30605":1714,"_21201":55381,"_5":14582,"_27821":55299,"_3006":55382},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3550":1746,"_30605":1714,"_21201":55384,"_5":14582,"_27821":55303,"_3006":55385},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3550":1747,"_30605":1714,"_21201":55387,"_5":14582,"_27821":55303,"_3006":55388},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3550":1748,"_30605":1714,"_21201":55390,"_5":14582,"_27821":55307,"_3006":55391},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3550":1749,"_30605":1714,"_21201":55393,"_5":14582,"_27821":55307,"_3006":55394},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3550":1750,"_30605":1714,"_21201":55396,"_5":14582,"_27821":55311,"_3006":55247},[],{"_3550":1751,"_30605":1714,"_21201":55398,"_5":14582,"_27821":55311,"_3006":55399},[],"Result",{"_3550":1752,"_30605":1714,"_21201":55401,"_5":14582,"_27821":55311,"_3006":54497},[],{"_3550":1753,"_30605":1714,"_21201":55403,"_5":14582,"_27821":55311,"_3006":55404},[],"`device-001` appears in inventory with the expected DMS.",{"_3550":1754,"_30605":1714,"_21201":55406,"_5":14582,"_27821":55311,"_3006":55407},[],"Current identity",{"_3550":1755,"_30605":1714,"_21201":55409,"_5":14582,"_27821":55311,"_3006":55410},[],"The associated certificate matches the one you verified in PKI.",{"_3550":1756,"_30605":1714,"_21201":55412,"_5":14582,"_27821":55311,"_3006":55413},[],"History",{"_3550":1757,"_30605":1714,"_21201":55415,"_5":14582,"_27821":55311,"_3006":55416},[],"The associated issuance appears with its serial number and dates.",{"_3550":1758,"_30605":1714,"_21201":55418,"_5":14582,"_27821":55311,"_3006":55419},[],"Key and certificate",{"_3550":1759,"_30605":1714,"_21201":55421,"_5":14582,"_27821":55311,"_3006":55422},[],"You have the verified pair ready to install on the device.",{"_3550":1760,"_30605":1714,"_21201":55424,"_5":14582,"_27821":55314,"_3006":55425},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3550":1761,"_30605":1714,"_21201":55427,"_5":14582,"_27821":55314,"_3006":55428},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3550":1762,"_30605":1714,"_21201":55430,"_5":14582,"_27821":55314,"_3006":55431},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3550":1763,"_30605":1714,"_21201":55433,"_5":14582,"_27821":55314,"_3006":55434},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3550":1764,"_30605":1714,"_21201":55436,"_5":14582,"_27821":55318,"_3006":55437},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3550":1765,"_30605":1714,"_21201":55439,"_5":14582,"_27821":55318,"_3006":55440},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3550":1766,"_30605":1714,"_21201":55442,"_5":14582,"_27821":55318,"_3006":55443},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3550":1767,"_30605":1767,"_5":14934,"_3006":55445,"_30964":55446,"_21201":55447,"_27821":1767},"Lamassu IoT Platform",[49995,51470],[],{"_3550":1768,"_30605":1767,"_21201":55449,"_5":14582,"_27821":1767,"_3006":55450},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3550":1769,"_30605":1767,"_5":30961,"_21201":55452,"_27821":55453,"_3006":54933},[],"/docs/pr-preview/pr-66/platform/overview#start-here",{"_3550":1770,"_30605":1767,"_5":30961,"_21201":55455,"_27821":55456,"_3006":55457},[],"/docs/pr-preview/pr-66/platform/overview#choose-your-path","Choose your path",{"_3550":1771,"_30605":1767,"_5":30961,"_21201":55459,"_27821":55460,"_3006":55461},[],"/docs/pr-preview/pr-66/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3550":1772,"_30605":1767,"_5":30961,"_21201":55463,"_27821":55464,"_3006":55465},[],"/docs/pr-preview/pr-66/platform/overview#core-capabilities","Core capabilities",{"_3550":1773,"_30605":1767,"_5":30961,"_21201":55467,"_27821":55468,"_3006":55469},[],"/docs/pr-preview/pr-66/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3550":1774,"_30605":1767,"_5":30961,"_21201":55471,"_27821":55472,"_3006":55473},[],"/docs/pr-preview/pr-66/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3550":1775,"_30605":1767,"_5":30961,"_21201":55475,"_27821":55476,"_3006":55477},[],"/docs/pr-preview/pr-66/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3550":1776,"_30605":1767,"_5":30961,"_21201":55479,"_27821":55480,"_3006":55481},[],"/docs/pr-preview/pr-66/platform/overview#automate-device-identities","Automate device identities",{"_3550":1777,"_30605":1767,"_5":30961,"_21201":55483,"_27821":55484,"_3006":55485},[],"/docs/pr-preview/pr-66/platform/overview#publish-validation-status","Publish validation status",{"_3550":1778,"_30605":1767,"_5":30961,"_21201":55487,"_27821":55488,"_3006":55489},[],"/docs/pr-preview/pr-66/platform/overview#react-to-events","React to events",{"_3550":1779,"_30605":1767,"_5":30961,"_21201":55491,"_27821":55492,"_3006":55493},[],"/docs/pr-preview/pr-66/platform/overview#operational-reference","Operational reference",{"_3550":1780,"_30605":1767,"_21201":55495,"_5":14582,"_27821":1767,"_3006":55496},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3550":1781,"_30605":1767,"_21201":55498,"_5":14582,"_27821":55453,"_3006":55499},[],"Choose the result you need:",{"_3550":1782,"_30605":1767,"_21201":55501,"_5":14582,"_27821":55453,"_3006":55502},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3550":1783,"_30605":1767,"_21201":55504,"_5":14582,"_27821":55453,"_3006":55505},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3550":1784,"_30605":1767,"_21201":55507,"_5":14582,"_27821":55453,"_3006":55508},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3550":1785,"_30605":1767,"_21201":55510,"_5":14582,"_27821":55456,"_3006":55511},[],"Section",{"_3550":1786,"_30605":1767,"_21201":55513,"_5":14582,"_27821":55456,"_3006":55514},[],"What you manage",{"_3550":1787,"_30605":1767,"_21201":55516,"_5":14582,"_27821":55456,"_3006":55517},[],"Entry point",{"_3550":1788,"_30605":1767,"_21201":55519,"_5":14582,"_27821":55456,"_3006":55520},[],"**PKI**",{"_3550":1789,"_30605":1767,"_21201":55522,"_5":14582,"_27821":55456,"_3006":55523},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3550":1790,"_30605":1767,"_21201":55525,"_5":14582,"_27821":55456,"_3006":55526},[],"PKI overview",{"_3550":1791,"_30605":1767,"_21201":55528,"_5":14582,"_27821":55456,"_3006":55529},[],"**IoT Fleets**",{"_3550":1792,"_30605":1767,"_21201":55531,"_5":14582,"_27821":55456,"_3006":55532},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3550":1793,"_30605":1767,"_21201":55534,"_5":14582,"_27821":55456,"_3006":55535},[],"IoT Fleets overview",{"_3550":1794,"_30605":1767,"_21201":55537,"_5":14582,"_27821":55456,"_3006":55538},[],"**Administration**",{"_3550":1795,"_30605":1767,"_21201":55540,"_5":14582,"_27821":55456,"_3006":55541},[],"Operator permissions, audit and event subscriptions.",{"_3550":1796,"_30605":1767,"_21201":55543,"_5":14582,"_27821":55456,"_3006":51472},[],{"_3550":1797,"_30605":1767,"_21201":55545,"_5":14582,"_27821":55456,"_3006":55546},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3550":1798,"_30605":1767,"_21201":55548,"_5":14582,"_27821":55460,"_3006":55549},[],"An identity's journey connects four responsibilities:",{"_3550":1799,"_30605":1767,"_21201":55551,"_5":14582,"_27821":55460,"_3006":55552},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3550":1800,"_30605":1767,"_21201":55554,"_5":14582,"_27821":55460,"_3006":55555},[],"The provisioning administrator configures the DMS and initial trust.",{"_3550":1801,"_30605":1767,"_21201":55557,"_5":14582,"_27821":55460,"_3006":55558},[],"The device client requests a certificate and installs it with the matching key.",{"_3550":1802,"_30605":1767,"_21201":55560,"_5":14582,"_27821":55460,"_3006":55561},[],"The consumer validates the identity and applies its access permissions.",{"_3550":1803,"_30605":1767,"_21201":55563,"_5":14582,"_27821":55460,"_3006":55564},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3550":1804,"_30605":1767,"_21201":55566,"_5":14582,"_27821":55468,"_3006":55567},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3550":1805,"_30605":1767,"_21201":55569,"_5":14582,"_27821":55472,"_3006":55570},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3550":1806,"_30605":1767,"_21201":55572,"_5":14582,"_27821":55476,"_3006":55573},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3550":1807,"_30605":1767,"_21201":55575,"_5":14582,"_27821":55480,"_3006":55576},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3550":1808,"_30605":1767,"_21201":55578,"_5":14582,"_27821":55484,"_3006":55579},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3550":1809,"_30605":1767,"_21201":55581,"_5":14582,"_27821":55488,"_3006":55582},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3550":1810,"_30605":1767,"_21201":55584,"_5":14582,"_27821":55492,"_3006":55027},[],{"_3550":1811,"_30605":1767,"_21201":55586,"_5":14582,"_27821":55492,"_3006":55587},[],"What it prepares or checks",{"_3550":1812,"_30605":1767,"_21201":55589,"_5":14582,"_27821":55492,"_3006":55030},[],{"_3550":1813,"_30605":1767,"_21201":55591,"_5":14582,"_27821":55492,"_3006":55592},[],"Key custody, CA hierarchy, profiles and validation.",{"_3550":1814,"_30605":1767,"_21201":55594,"_5":14582,"_27821":55492,"_3006":55595},[],"Fleet administrator",{"_3550":1815,"_30605":1767,"_21201":55597,"_5":14582,"_27821":55492,"_3006":55598},[],"DMS, device admission, renewal policy and inventory.",{"_3550":1816,"_30605":1767,"_21201":55600,"_5":14582,"_27821":55492,"_3006":55042},[],{"_3550":1817,"_30605":1767,"_21201":55602,"_5":14582,"_27821":55492,"_3006":55603},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3550":1818,"_30605":1767,"_21201":55605,"_5":14582,"_27821":55492,"_3006":55048},[],{"_3550":1819,"_30605":1767,"_21201":55607,"_5":14582,"_27821":55492,"_3006":55608},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3550":1820,"_30605":1767,"_21201":55610,"_5":14582,"_27821":55492,"_3006":55611},[],"Infrastructure operator",{"_3550":1821,"_30605":1767,"_21201":55613,"_5":14582,"_27821":55492,"_3006":55614},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3550":1822,"_30605":1767,"_21201":55616,"_5":14582,"_27821":55492,"_3006":55617},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3550":1823,"_30605":1823,"_5":14934,"_3006":55619,"_30964":55620,"_21201":55623,"_27821":1823},"CA hierarchy and rotation",[49995,51470,55621,55622],"PKI","Keys, authorities and certificates",[],{"_3550":1824,"_30605":1823,"_21201":55625,"_5":14582,"_27821":1823,"_3006":55626},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3550":1825,"_30605":1823,"_5":30961,"_21201":55628,"_27821":55629,"_3006":55630},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3550":1826,"_30605":1823,"_5":30961,"_21201":55632,"_27821":55633,"_3006":55634},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3550":1827,"_30605":1823,"_5":30961,"_21201":55636,"_27821":55637,"_3006":55638},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3550":1828,"_30605":1823,"_5":30961,"_21201":55640,"_27821":55641,"_3006":55642},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3550":1829,"_30605":1823,"_5":30961,"_21201":55644,"_27821":55645,"_3006":55646},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3550":1830,"_30605":1823,"_5":30961,"_21201":55648,"_27821":55649,"_3006":55650},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3550":1831,"_30605":1823,"_5":30961,"_21201":55652,"_27821":55653,"_3006":55654},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3550":1832,"_30605":1823,"_5":30961,"_21201":55656,"_27821":55657,"_3006":55658},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3550":1833,"_30605":1823,"_5":30961,"_21201":55660,"_27821":55661,"_3006":55662},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3550":1834,"_30605":1823,"_5":30961,"_21201":55664,"_27821":55665,"_3006":55666},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3550":1835,"_30605":1823,"_5":30961,"_21201":55668,"_27821":55669,"_3006":55670},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3550":1836,"_30605":1823,"_5":30961,"_21201":55672,"_27821":55673,"_3006":55674},[],"/docs/pr-preview/pr-66/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3550":1837,"_30605":1823,"_21201":55676,"_5":14582,"_27821":1823,"_3006":55677},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3550":1838,"_30605":1823,"_21201":55679,"_5":14582,"_27821":1823,"_3006":55680},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3550":1839,"_30605":1823,"_21201":55682,"_5":14582,"_27821":55629,"_3006":55683},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3550":1840,"_30605":1823,"_21201":55685,"_5":14582,"_27821":55629,"_3006":55686},[],"environment, such as production and preproduction;",{"_3550":1841,"_30605":1823,"_21201":55688,"_5":14582,"_27821":55629,"_3006":55689},[],"owner or operating team;",{"_3550":1842,"_30605":1823,"_21201":55691,"_5":14582,"_27821":55629,"_3006":55692},[],"device family or manufacturing process;",{"_3550":1843,"_30605":1823,"_21201":55694,"_5":14582,"_27821":55629,"_3006":55695},[],"region or regulatory requirement;",{"_3550":1844,"_30605":1823,"_21201":55697,"_5":14582,"_27821":55629,"_3006":55698},[],"cryptographic engine or key policy;",{"_3550":1845,"_30605":1823,"_21201":55700,"_5":14582,"_27821":55629,"_3006":55701},[],"maintenance window and renewal cadence.",{"_3550":1846,"_30605":1823,"_21201":55703,"_5":14582,"_27821":55629,"_3006":55704},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3550":1847,"_30605":1823,"_21201":55706,"_5":14582,"_27821":55629,"_3006":55707},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3550":1848,"_30605":1823,"_21201":55709,"_5":14582,"_27821":55633,"_3006":55710},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3550":1849,"_30605":1823,"_21201":55712,"_5":14582,"_27821":55633,"_3006":55713},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3550":1850,"_30605":1823,"_21201":55715,"_5":14582,"_27821":55633,"_3006":55716},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3550":1851,"_30605":1823,"_21201":55718,"_5":14582,"_27821":55633,"_3006":55719},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3550":1852,"_30605":1823,"_21201":55721,"_5":14582,"_27821":55637,"_3006":55722},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3550":1853,"_30605":1823,"_21201":55724,"_5":14582,"_27821":55637,"_3006":55725},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3550":1854,"_30605":1823,"_21201":55727,"_5":14582,"_27821":55637,"_3006":55728},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3550":1855,"_30605":1823,"_21201":55730,"_5":14582,"_27821":55637,"_3006":55731},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3550":1856,"_30605":1823,"_21201":55733,"_5":14582,"_27821":55645,"_3006":55734},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3550":1857,"_30605":1823,"_21201":55736,"_5":14582,"_27821":55649,"_3006":55737},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3550":1858,"_30605":1823,"_21201":55739,"_5":14582,"_27821":55653,"_3006":55740},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3550":1859,"_30605":1823,"_21201":55742,"_5":14582,"_27821":55657,"_3006":55743},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3550":1860,"_30605":1823,"_21201":55745,"_5":14582,"_27821":55661,"_3006":55746},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3550":1861,"_30605":1823,"_21201":55748,"_5":14582,"_27821":55665,"_3006":55749},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3550":1862,"_30605":1823,"_21201":55751,"_5":14582,"_27821":55669,"_3006":55752},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3550":1863,"_30605":1823,"_21201":55754,"_5":14582,"_27821":55669,"_3006":55755},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3550":1864,"_30605":1823,"_21201":55757,"_5":14582,"_27821":55669,"_3006":55758},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3550":1865,"_30605":1823,"_21201":55760,"_5":14582,"_27821":55669,"_3006":55761},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3550":1866,"_30605":1823,"_21201":55763,"_5":14582,"_27821":55673,"_3006":55764},[],"The new chain ends in an anchor installed by the consumer.",{"_3550":1867,"_30605":1823,"_21201":55766,"_5":14582,"_27821":55673,"_3006":55767},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3550":1868,"_30605":1823,"_21201":55769,"_5":14582,"_27821":55673,"_3006":55770},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3550":1869,"_30605":1823,"_21201":55772,"_5":14582,"_27821":55673,"_3006":55773},[],"Re-enrollment accepts the old identity during the planned period.",{"_3550":1870,"_30605":1823,"_21201":55775,"_5":14582,"_27821":55673,"_3006":55776},[],"OCSP and CRL respond for the authorities that remain active.",{"_3550":1871,"_30605":1823,"_21201":55778,"_5":14582,"_27821":55673,"_3006":55779},[],"No DMS is left accidentally issuing from the old CA.",{"_3550":1872,"_30605":1823,"_21201":55781,"_5":14582,"_27821":55673,"_3006":55782},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3550":1873,"_30605":1873,"_5":14934,"_3006":55784,"_30964":55785,"_21201":55786,"_27821":1873},"Certification authorities",[49995,51470,55621,55622],[],{"_3550":1874,"_30605":1873,"_21201":55788,"_5":14582,"_27821":1873,"_3006":55789},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3550":1875,"_30605":1873,"_5":30961,"_21201":55791,"_27821":55792,"_3006":55793},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3550":1876,"_30605":1873,"_5":30961,"_21201":55795,"_27821":55796,"_3006":55797},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3550":1877,"_30605":1873,"_5":30961,"_21201":55799,"_27821":55800,"_3006":50005},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#before-you-begin",{"_3550":1878,"_30605":1873,"_5":30961,"_21201":55802,"_27821":55803,"_3006":55804},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3550":1879,"_30605":1873,"_5":30961,"_21201":55806,"_27821":55807,"_3006":55808},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3550":1880,"_30605":1873,"_5":30961,"_21201":55810,"_27821":55811,"_3006":55812},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3550":1881,"_30605":1873,"_5":30961,"_21201":55814,"_27821":55815,"_3006":55816},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3550":1882,"_30605":1873,"_5":30961,"_21201":55818,"_27821":55819,"_3006":55820},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3550":1883,"_30605":1873,"_5":30961,"_21201":55822,"_27821":55823,"_3006":55824},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3550":1884,"_30605":1873,"_5":30961,"_21201":55826,"_27821":55827,"_3006":55828},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3550":1885,"_30605":1873,"_5":30961,"_21201":55830,"_27821":55831,"_3006":55832},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3550":1886,"_30605":1873,"_5":30961,"_21201":55834,"_27821":55835,"_3006":55836},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3550":1887,"_30605":1873,"_5":30961,"_21201":55838,"_27821":55839,"_3006":55840},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3550":1888,"_30605":1873,"_5":30961,"_21201":55842,"_27821":55843,"_3006":55844},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3550":1889,"_30605":1873,"_5":30961,"_21201":55846,"_27821":55847,"_3006":55848},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3550":1890,"_30605":1873,"_5":30961,"_21201":55850,"_27821":55851,"_3006":55852},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3550":1891,"_30605":1873,"_5":30961,"_21201":55854,"_27821":55855,"_3006":55856},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3550":1892,"_30605":1873,"_5":30961,"_21201":55858,"_27821":55859,"_3006":55860},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3550":1893,"_30605":1873,"_5":30961,"_21201":55862,"_27821":55863,"_3006":55864},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3550":1894,"_30605":1873,"_5":30961,"_21201":55866,"_27821":55867,"_3006":55868},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3550":1895,"_30605":1873,"_5":30961,"_21201":55870,"_27821":55871,"_3006":55872},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3550":1896,"_30605":1873,"_5":30961,"_21201":55874,"_27821":55875,"_3006":55876},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3550":1897,"_30605":1873,"_5":30961,"_21201":55878,"_27821":55879,"_3006":55880},[],"/docs/pr-preview/pr-66/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3550":1898,"_30605":1873,"_21201":55882,"_5":14582,"_27821":1873,"_3006":55883},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3550":1899,"_30605":1873,"_21201":55885,"_5":14582,"_27821":1873,"_3006":55886},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3550":1900,"_30605":1873,"_21201":55888,"_5":14582,"_27821":1873,"_3006":55889},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3550":1901,"_30605":1873,"_21201":55891,"_5":14582,"_27821":55792,"_3006":55892},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3550":1902,"_30605":1873,"_21201":55894,"_5":14582,"_27821":55792,"_3006":55895},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3550":1903,"_30605":1873,"_21201":55897,"_5":14582,"_27821":55792,"_3006":55898},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3550":1904,"_30605":1873,"_21201":55900,"_5":14582,"_27821":55792,"_3006":55901},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3550":1905,"_30605":1873,"_21201":55903,"_5":14582,"_27821":55792,"_3006":55904},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3550":1906,"_30605":1873,"_21201":55906,"_5":14582,"_27821":55800,"_3006":55907},[],"Decide whether the CA will be a root or an intermediate.",{"_3550":1907,"_30605":1873,"_21201":55909,"_5":14582,"_27821":55800,"_3006":55910},[],"Choose the engine that will keep the key.",{"_3550":1908,"_30605":1873,"_21201":55912,"_5":14582,"_27821":55800,"_3006":55913},[],"Define a validity longer than that of the certificates it will issue.",{"_3550":1909,"_30605":1873,"_21201":55915,"_5":14582,"_27821":55800,"_3006":55916},[],"For an intermediate CA, make sure the parent CA is active.",{"_3550":1910,"_30605":1873,"_21201":55918,"_5":14582,"_27821":55803,"_3006":55919},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3550":1911,"_30605":1873,"_21201":55921,"_5":14582,"_27821":55807,"_3006":55922},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3550":1912,"_30605":1873,"_21201":55924,"_5":14582,"_27821":55807,"_3006":55925},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3550":1913,"_30605":1873,"_21201":55927,"_5":14582,"_27821":55811,"_3006":55928},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3550":1914,"_30605":1873,"_21201":55930,"_5":14582,"_27821":55815,"_3006":55931},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3550":1915,"_30605":1873,"_21201":55933,"_5":14582,"_27821":55815,"_3006":55934},[],"`C`: two-letter ISO 3166-1 country code.",{"_3550":1916,"_30605":1873,"_21201":55936,"_5":14582,"_27821":55815,"_3006":55937},[],"`ST`: state or province.",{"_3550":1917,"_30605":1873,"_21201":55939,"_5":14582,"_27821":55815,"_3006":55940},[],"`L`: locality.",{"_3550":1918,"_30605":1873,"_21201":55942,"_5":14582,"_27821":55815,"_3006":55943},[],"`O`: organization.",{"_3550":1919,"_30605":1873,"_21201":55945,"_5":14582,"_27821":55815,"_3006":55946},[],"`OU`: organizational unit.",{"_3550":1920,"_30605":1873,"_21201":55948,"_5":14582,"_27821":55815,"_3006":55949},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3550":1921,"_30605":1873,"_21201":55951,"_5":14582,"_27821":55819,"_3006":55952},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3550":1922,"_30605":1873,"_21201":55954,"_5":14582,"_27821":55819,"_3006":55955},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3550":1923,"_30605":1873,"_21201":55957,"_5":14582,"_27821":55823,"_3006":55958},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3550":1924,"_30605":1873,"_21201":55960,"_5":14582,"_27821":55823,"_3006":55961},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3550":1925,"_30605":1873,"_21201":55963,"_5":14582,"_27821":55827,"_3006":55964},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3550":1926,"_30605":1873,"_21201":55966,"_5":14582,"_27821":55827,"_3006":55967},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3550":1927,"_30605":1873,"_21201":55969,"_5":14582,"_27821":55831,"_3006":55970},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3550":1928,"_30605":1873,"_21201":55972,"_5":14582,"_27821":55831,"_3006":55973},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3550":1929,"_30605":1873,"_21201":55975,"_5":14582,"_27821":55831,"_3006":55976},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3550":1930,"_30605":1873,"_21201":55978,"_5":14582,"_27821":55835,"_3006":55979},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3550":1931,"_30605":1873,"_21201":55981,"_5":14582,"_27821":55839,"_3006":55982},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3550":1932,"_30605":1873,"_21201":55984,"_5":14582,"_27821":55839,"_3006":55985},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3550":1933,"_30605":1873,"_21201":55987,"_5":14582,"_27821":55843,"_3006":55988},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3550":1934,"_30605":1873,"_21201":55990,"_5":14582,"_27821":55847,"_3006":55991},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3550":1935,"_30605":1873,"_21201":55993,"_5":14582,"_27821":55847,"_3006":55994},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3550":1936,"_30605":1873,"_21201":55996,"_5":14582,"_27821":55851,"_3006":55997},[],"Open a CA from the inventory to review:",{"_3550":1937,"_30605":1873,"_21201":55999,"_5":14582,"_27821":55851,"_3006":56000},[],"Status and validity period.",{"_3550":1938,"_30605":1873,"_21201":56002,"_5":14582,"_27821":55851,"_3006":56003},[],"Certificate and chain in PEM format.",{"_3550":1939,"_30605":1873,"_21201":56005,"_5":14582,"_27821":55851,"_3006":56006},[],"Number of active, expired and revoked certificates.",{"_3550":1940,"_30605":1873,"_21201":56008,"_5":14582,"_27821":55851,"_3006":56009},[],"Certificates issued in **Issued Certificates**.",{"_3550":1941,"_30605":1873,"_21201":56011,"_5":14582,"_27821":55851,"_3006":56012},[],"The CRL linked to the authority.",{"_3550":1942,"_30605":1873,"_21201":56014,"_5":14582,"_27821":55851,"_3006":56015},[],"Metadata and the associated cryptographic engine.",{"_3550":1943,"_30605":1873,"_21201":56017,"_5":14582,"_27821":55851,"_3006":56018},[],"You can filter the inventory by name, status and CA type.",{"_3550":1944,"_30605":1873,"_21201":56020,"_5":14582,"_27821":55855,"_3006":56021},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3550":1945,"_30605":1873,"_21201":56023,"_5":14582,"_27821":55855,"_3006":56024},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3550":1946,"_30605":1873,"_21201":56026,"_5":14582,"_27821":55855,"_3006":56027},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3550":1947,"_30605":1873,"_21201":56029,"_5":14582,"_27821":55855,"_3006":56030},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3550":1948,"_30605":1873,"_21201":56032,"_5":14582,"_27821":55859,"_3006":56033},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3550":1949,"_30605":1873,"_21201":56035,"_5":14582,"_27821":55863,"_3006":56036},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3550":1950,"_30605":1873,"_21201":56038,"_5":14582,"_27821":55867,"_3006":56039},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3550":1951,"_30605":1873,"_21201":56041,"_5":14582,"_27821":55871,"_3006":56042},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3550":1952,"_30605":1873,"_21201":56044,"_5":14582,"_27821":55875,"_3006":56045},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3550":1953,"_30605":1873,"_21201":56047,"_5":14582,"_27821":55879,"_3006":56048},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3550":1954,"_30605":1873,"_21201":56050,"_5":14582,"_27821":55879,"_3006":56051},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3550":1955,"_30605":1873,"_21201":56053,"_5":14582,"_27821":55879,"_3006":56054},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3550":1956,"_30605":1873,"_21201":56056,"_5":14582,"_27821":55879,"_3006":56057},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3550":1957,"_30605":1957,"_5":14934,"_3006":56059,"_30964":56060,"_21201":56061,"_27821":1957},"Certificate profiles",[49995,51470,55621,55622],[],{"_3550":1958,"_30605":1957,"_21201":56063,"_5":14582,"_27821":1957,"_3006":56064},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3550":1959,"_30605":1957,"_5":30961,"_21201":56066,"_27821":56067,"_3006":56068},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3550":1960,"_30605":1957,"_5":30961,"_21201":56070,"_27821":56071,"_3006":56072},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#validity","Validity",{"_3550":1961,"_30605":1957,"_5":30961,"_21201":56074,"_27821":56075,"_3006":56076},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3550":1962,"_30605":1957,"_5":30961,"_21201":56078,"_27821":56079,"_3006":56080},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3550":1963,"_30605":1957,"_5":30961,"_21201":56082,"_27821":56083,"_3006":56084},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#subject","Subject",{"_3550":1964,"_30605":1957,"_5":30961,"_21201":56086,"_27821":56087,"_3006":56088},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3550":1965,"_30605":1957,"_5":30961,"_21201":56090,"_27821":56091,"_3006":56092},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3550":1966,"_30605":1957,"_5":30961,"_21201":56094,"_27821":56095,"_3006":56096},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3550":1967,"_30605":1957,"_5":30961,"_21201":56098,"_27821":56099,"_3006":56100},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3550":1968,"_30605":1957,"_5":30961,"_21201":56102,"_27821":56103,"_3006":56104},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3550":1969,"_30605":1957,"_5":30961,"_21201":56106,"_27821":56107,"_3006":56108},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3550":1970,"_30605":1957,"_5":30961,"_21201":56110,"_27821":56111,"_3006":56112},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3550":1971,"_30605":1957,"_5":30961,"_21201":56114,"_27821":56115,"_3006":56116},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3550":1972,"_30605":1957,"_5":30961,"_21201":56118,"_27821":56119,"_3006":56120},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3550":1973,"_30605":1957,"_5":30961,"_21201":56122,"_27821":56123,"_3006":56124},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#design-examples","Design examples",{"_3550":1974,"_30605":1957,"_5":30961,"_21201":56126,"_27821":56127,"_3006":56128},[],"/docs/pr-preview/pr-66/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3550":1975,"_30605":1957,"_21201":56130,"_5":14582,"_27821":1957,"_3006":56131},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3550":1976,"_30605":1957,"_21201":56133,"_5":14582,"_27821":1957,"_3006":56134},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3550":1977,"_30605":1957,"_21201":56136,"_5":14582,"_27821":56071,"_3006":56137},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3550":1978,"_30605":1957,"_21201":56139,"_5":14582,"_27821":56071,"_3006":56140},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3550":1979,"_30605":1957,"_21201":56142,"_5":14582,"_27821":56075,"_3006":56143},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3550":1980,"_30605":1957,"_21201":56145,"_5":14582,"_27821":56079,"_3006":56146},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3550":1981,"_30605":1957,"_21201":56148,"_5":14582,"_27821":56079,"_3006":56149},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3550":1982,"_30605":1957,"_21201":56151,"_5":14582,"_27821":56079,"_3006":56152},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3550":1983,"_30605":1957,"_21201":56154,"_5":14582,"_27821":56083,"_3006":56155},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3550":1984,"_30605":1957,"_21201":56157,"_5":14582,"_27821":56087,"_3006":56158},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3550":1985,"_30605":1957,"_21201":56160,"_5":14582,"_27821":56087,"_3006":56161},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3550":1986,"_30605":1957,"_21201":56163,"_5":14582,"_27821":56091,"_3006":56164},[],"The cryptographic enforcement can:",{"_3550":1987,"_30605":1957,"_21201":56166,"_5":14582,"_27821":56091,"_3006":56167},[],"allow or block RSA keys;",{"_3550":1988,"_30605":1957,"_21201":56169,"_5":14582,"_27821":56091,"_3006":56170},[],"limit the supported RSA sizes;",{"_3550":1989,"_30605":1957,"_21201":56172,"_5":14582,"_27821":56091,"_3006":56173},[],"allow or block ECDSA keys;",{"_3550":1990,"_30605":1957,"_21201":56175,"_5":14582,"_27821":56091,"_3006":56176},[],"limit the supported ECDSA sizes or curves.",{"_3550":1991,"_30605":1957,"_21201":56178,"_5":14582,"_27821":56091,"_3006":56179},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3550":1992,"_30605":1957,"_21201":56181,"_5":14582,"_27821":56095,"_3006":56182},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3550":1993,"_30605":1957,"_21201":56184,"_5":14582,"_27821":56095,"_3006":53383},[],{"_3550":1994,"_30605":1957,"_21201":56186,"_5":14582,"_27821":56095,"_3006":56187},[],"First choice",{"_3550":1995,"_30605":1957,"_21201":56189,"_5":14582,"_27821":56095,"_3006":56190},[],"Second choice",{"_3550":1996,"_30605":1957,"_21201":56192,"_5":14582,"_27821":56095,"_3006":56193},[],"If neither is supplied",{"_3550":1997,"_30605":1957,"_21201":56195,"_5":14582,"_27821":56095,"_3006":56196},[],"Direct signing with a CA",{"_3550":1998,"_30605":1957,"_21201":56198,"_5":14582,"_27821":56095,"_3006":56199},[],"`issuance_profile` embedded in the request",{"_3550":1999,"_30605":1957,"_21201":56201,"_5":14582,"_27821":56095,"_3006":56202},[],"Request `issuance_profile_id`",{"_3550":2000,"_30605":1957,"_21201":56204,"_5":14582,"_27821":56095,"_3006":56205},[],"CA default profile (`profile_id`).",{"_3550":2001,"_30605":1957,"_21201":56207,"_5":14582,"_27821":56095,"_3006":56208},[],"Issuance through a DMS",{"_3550":2002,"_30605":1957,"_21201":56210,"_5":14582,"_27821":56095,"_3006":56211},[],"`settings.issuance_profile_id`",{"_3550":2003,"_30605":1957,"_21201":56213,"_5":14582,"_27821":56095,"_3006":56214},[],"`settings.issuance_profile` embedded in the DMS",{"_3550":2004,"_30605":1957,"_21201":56216,"_5":14582,"_27821":56095,"_3006":56217},[],"Enrollment CA default profile.",{"_3550":2005,"_30605":1957,"_21201":56219,"_5":14582,"_27821":56095,"_3006":56220},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3550":2006,"_30605":1957,"_21201":56222,"_5":14582,"_27821":56095,"_3006":56223},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3550":2007,"_30605":1957,"_21201":56225,"_5":14582,"_27821":56103,"_3006":56226},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3550":2008,"_30605":1957,"_21201":56228,"_5":14582,"_27821":56107,"_3006":56229},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3550":2009,"_30605":1957,"_21201":56231,"_5":14582,"_27821":56111,"_3006":56232},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3550":2010,"_30605":1957,"_21201":56234,"_5":14582,"_27821":56115,"_3006":56235},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3550":2011,"_30605":1957,"_21201":56237,"_5":14582,"_27821":56119,"_3006":56238},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3550":2012,"_30605":1957,"_21201":56240,"_5":14582,"_27821":56119,"_3006":56241},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3550":2013,"_30605":1957,"_21201":56243,"_5":14582,"_27821":56123,"_3006":56244},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3550":2014,"_30605":1957,"_21201":56246,"_5":14582,"_27821":56123,"_3006":56247},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3550":2015,"_30605":1957,"_21201":56249,"_5":14582,"_27821":56123,"_3006":56250},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3550":2016,"_30605":1957,"_21201":56252,"_5":14582,"_27821":56123,"_3006":56253},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3550":2017,"_30605":1957,"_21201":56255,"_5":14582,"_27821":56127,"_3006":56256},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3550":2018,"_30605":1957,"_21201":56258,"_5":14582,"_27821":56127,"_3006":56259},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3550":2019,"_30605":2019,"_5":14934,"_3006":56261,"_30964":56262,"_21201":56264,"_27821":2019},"Certificate validation",[49995,51470,55621,56263],"Validation",[],{"_3550":2020,"_30605":2019,"_21201":56266,"_5":14582,"_27821":2019,"_3006":56267},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3550":2021,"_30605":2019,"_5":30961,"_21201":56269,"_27821":56270,"_3006":56271},[],"/docs/pr-preview/pr-66/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3550":2022,"_30605":2019,"_5":30961,"_21201":56273,"_27821":56274,"_3006":56275},[],"/docs/pr-preview/pr-66/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3550":2023,"_30605":2019,"_5":30961,"_21201":56277,"_27821":56278,"_3006":56279},[],"/docs/pr-preview/pr-66/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3550":2024,"_30605":2019,"_21201":56281,"_5":14582,"_27821":2019,"_3006":56282},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3550":2025,"_30605":2019,"_21201":56284,"_5":14582,"_27821":56270,"_3006":56285},[],"Verify these criteria together:",{"_3550":2026,"_30605":2019,"_21201":56287,"_5":14582,"_27821":56270,"_3006":55247},[],{"_3550":2027,"_30605":2019,"_21201":56289,"_5":14582,"_27821":56270,"_3006":56290},[],"Required result",{"_3550":2028,"_30605":2019,"_21201":56292,"_5":14582,"_27821":56270,"_3006":56293},[],"Chain and signature",{"_3550":2029,"_30605":2019,"_21201":56295,"_5":14582,"_27821":56270,"_3006":56296},[],"Valid chain to a root deliberately installed in the consumer.",{"_3550":2030,"_30605":2019,"_21201":56298,"_5":14582,"_27821":56270,"_3006":56299},[],"Dates",{"_3550":2031,"_30605":2019,"_21201":56301,"_5":14582,"_27821":56270,"_3006":56302},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3550":2032,"_30605":2019,"_21201":56304,"_5":14582,"_27821":56270,"_3006":51139},[],{"_3550":2033,"_30605":2019,"_21201":56306,"_5":14582,"_27821":56270,"_3006":56307},[],"Name, SAN or identifier matches the expected peer.",{"_3550":2034,"_30605":2019,"_21201":56309,"_5":14582,"_27821":56270,"_3006":50385},[],{"_3550":2035,"_30605":2019,"_21201":56311,"_5":14582,"_27821":56270,"_3006":56312},[],"KU, EKU and constraints permit the specific operation.",{"_3550":2036,"_30605":2019,"_21201":56314,"_5":14582,"_27821":56270,"_3006":56315},[],"Revocation",{"_3550":2037,"_30605":2019,"_21201":56317,"_5":14582,"_27821":56270,"_3006":56318},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3550":2038,"_30605":2019,"_21201":56320,"_5":14582,"_27821":56270,"_3006":56321},[],"Authorization",{"_3550":2039,"_30605":2019,"_21201":56323,"_5":14582,"_27821":56270,"_3006":56324},[],"The application permits that identity to perform the action.",{"_3550":2040,"_30605":2019,"_21201":56326,"_5":14582,"_27821":56270,"_3006":56327},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3550":2041,"_30605":2019,"_21201":56329,"_5":14582,"_27821":56274,"_3006":56330},[],"Mechanism",{"_3550":2042,"_30605":2019,"_21201":56332,"_5":14582,"_27821":56274,"_3006":56333},[],"When to use it",{"_3550":2043,"_30605":2019,"_21201":56335,"_5":14582,"_27821":56274,"_3006":56336},[],"What you must maintain",{"_3550":2044,"_30605":2019,"_21201":56338,"_5":14582,"_27821":56274,"_3006":56339},[],"OCSP",{"_3550":2045,"_30605":2019,"_21201":56341,"_5":14582,"_27821":56274,"_3006":56342},[],"Status query for a specific certificate.",{"_3550":2046,"_30605":2019,"_21201":56344,"_5":14582,"_27821":56274,"_3006":56345},[],"Responder access, signature verification and cache/freshness policy.",{"_3550":2047,"_30605":2019,"_21201":56347,"_5":14582,"_27821":56274,"_3006":56348},[],"CRL",{"_3550":2048,"_30605":2019,"_21201":56350,"_5":14582,"_27821":56274,"_3006":56351},[],"Local checks for many certificates or offline operation.",{"_3550":2049,"_30605":2019,"_21201":56353,"_5":14582,"_27821":56274,"_3006":56354},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3550":2050,"_30605":2019,"_21201":56356,"_5":14582,"_27821":56274,"_3006":56357},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3550":2051,"_30605":2019,"_21201":56359,"_5":14582,"_27821":56274,"_3006":56360},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3550":2052,"_30605":2019,"_21201":56362,"_5":14582,"_27821":56278,"_3006":56363},[],"Accept a current, authorized certificate with a known chain.",{"_3550":2053,"_30605":2019,"_21201":56365,"_5":14582,"_27821":56278,"_3006":56366},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3550":2054,"_30605":2019,"_21201":56368,"_5":14582,"_27821":56278,"_3006":56369},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3550":2055,"_30605":2019,"_21201":56371,"_5":14582,"_27821":56278,"_3006":56372},[],"Check that a new connection with that identity is rejected.",{"_3550":2056,"_30605":2019,"_21201":56374,"_5":14582,"_27821":56278,"_3006":56375},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3550":2057,"_30605":2019,"_21201":56377,"_5":14582,"_27821":56278,"_3006":56378},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3550":2058,"_30605":2019,"_21201":56380,"_5":14582,"_27821":56278,"_3006":56381},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3550":2059,"_30605":2019,"_21201":56383,"_5":14582,"_27821":56278,"_3006":56384},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3550":2060,"_30605":2019,"_21201":56386,"_5":14582,"_27821":56278,"_3006":56387},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3550":2061,"_30605":2061,"_5":14934,"_3006":56389,"_30964":56390,"_21201":56391,"_27821":2061},"Certificates",[49995,51470,55621,55622],[],{"_3550":2062,"_30605":2061,"_21201":56393,"_5":14582,"_27821":2061,"_3006":56394},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3550":2063,"_30605":2061,"_5":30961,"_21201":56396,"_27821":56397,"_3006":56398},[],"/docs/pr-preview/pr-66/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3550":2064,"_30605":2061,"_5":30961,"_21201":56400,"_27821":56401,"_3006":56402},[],"/docs/pr-preview/pr-66/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3550":2065,"_30605":2061,"_5":30961,"_21201":56404,"_27821":56405,"_3006":56406},[],"/docs/pr-preview/pr-66/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3550":2066,"_30605":2061,"_5":30961,"_21201":56408,"_27821":56409,"_3006":56410},[],"/docs/pr-preview/pr-66/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3550":2067,"_30605":2061,"_5":30961,"_21201":56412,"_27821":56413,"_3006":56414},[],"/docs/pr-preview/pr-66/platform/pki/certificates#open-the-action","Open the action",{"_3550":2068,"_30605":2061,"_5":30961,"_21201":56416,"_27821":56417,"_3006":56418},[],"/docs/pr-preview/pr-66/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3550":2069,"_30605":2061,"_5":30961,"_21201":56420,"_27821":56421,"_3006":56422},[],"/docs/pr-preview/pr-66/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3550":2070,"_30605":2061,"_5":30961,"_21201":56424,"_27821":56425,"_3006":56426},[],"/docs/pr-preview/pr-66/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3550":2071,"_30605":2061,"_5":30961,"_21201":56428,"_27821":56429,"_3006":56430},[],"/docs/pr-preview/pr-66/platform/pki/certificates#continue","Continue",{"_3550":2072,"_30605":2061,"_21201":56432,"_5":14582,"_27821":2061,"_3006":56433},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3550":2073,"_30605":2061,"_21201":56435,"_5":14582,"_27821":56397,"_3006":56436},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3550":2074,"_30605":2061,"_21201":56438,"_5":14582,"_27821":56397,"_3006":56439},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3550":2075,"_30605":2061,"_21201":56441,"_5":14582,"_27821":56397,"_3006":56442},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3550":2076,"_30605":2061,"_21201":56444,"_5":14582,"_27821":56397,"_3006":56445},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3550":2077,"_30605":2061,"_21201":56447,"_5":14582,"_27821":56397,"_3006":56448},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3550":2078,"_30605":2061,"_21201":56450,"_5":14582,"_27821":56397,"_3006":56451},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3550":2079,"_30605":2061,"_21201":56453,"_5":14582,"_27821":56397,"_3006":56454},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3550":2080,"_30605":2061,"_21201":56456,"_5":14582,"_27821":56401,"_3006":56457},[],"Download the PEM and inspect it:",{"_3550":2081,"_30605":2061,"_21201":56459,"_5":14582,"_27821":56401,"_3006":56460},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3550":2082,"_30605":2061,"_21201":56462,"_5":14582,"_27821":56405,"_3006":56463},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3550":2083,"_30605":2061,"_21201":56465,"_5":14582,"_27821":56405,"_3006":56466},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3550":2084,"_30605":2061,"_21201":56468,"_5":14582,"_27821":56405,"_3006":56469},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3550":2085,"_30605":2061,"_21201":56471,"_5":14582,"_27821":56405,"_3006":56472},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3550":2086,"_30605":2061,"_21201":56474,"_5":14582,"_27821":56405,"_3006":56475},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3550":2087,"_30605":2061,"_21201":56477,"_5":14582,"_27821":56405,"_3006":56478},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3550":2088,"_30605":2061,"_21201":56480,"_5":14582,"_27821":56405,"_3006":56481},[],"For browser key generation, follow Issue your first certificate.",{"_3550":2089,"_30605":2061,"_21201":56483,"_5":14582,"_27821":56409,"_3006":56484},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3550":2090,"_30605":2061,"_21201":56486,"_5":14582,"_27821":56413,"_3006":56487},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3550":2091,"_30605":2061,"_21201":56489,"_5":14582,"_27821":56417,"_3006":56490},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3550":2092,"_30605":2061,"_21201":56492,"_5":14582,"_27821":56421,"_3006":56493},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3550":2093,"_30605":2061,"_21201":56495,"_5":14582,"_27821":56421,"_3006":56496},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3550":2094,"_30605":2061,"_21201":56498,"_5":14582,"_27821":56421,"_3006":56499},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3550":2095,"_30605":2061,"_21201":56501,"_5":14582,"_27821":56425,"_3006":56502},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3550":2096,"_30605":2061,"_21201":56504,"_5":14582,"_27821":56425,"_3006":56505},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3550":2097,"_30605":2061,"_21201":56507,"_5":14582,"_27821":56425,"_3006":56508},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3550":2098,"_30605":2061,"_21201":56510,"_5":14582,"_27821":56429,"_3006":56511},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3550":2099,"_30605":2061,"_21201":56513,"_5":14582,"_27821":56429,"_3006":56514},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3550":2100,"_30605":2100,"_5":14934,"_3006":56516,"_30964":56517,"_21201":56519,"_27821":2100},"Certificate lifecycle",[49995,51470,55621,56518],"Concepts",[],{"_3550":2101,"_30605":2100,"_21201":56521,"_5":14582,"_27821":2100,"_3006":56522},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3550":2102,"_30605":2100,"_5":30961,"_21201":56524,"_27821":56525,"_3006":56526},[],"/docs/pr-preview/pr-66/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3550":2103,"_30605":2100,"_5":30961,"_21201":56528,"_27821":56529,"_3006":56530},[],"/docs/pr-preview/pr-66/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3550":2104,"_30605":2100,"_5":30961,"_21201":56532,"_27821":56533,"_3006":56534},[],"/docs/pr-preview/pr-66/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3550":2105,"_30605":2100,"_5":30961,"_21201":56536,"_27821":56537,"_3006":56538},[],"/docs/pr-preview/pr-66/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3550":2106,"_30605":2100,"_5":30961,"_21201":56540,"_27821":56541,"_3006":56542},[],"/docs/pr-preview/pr-66/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3550":2107,"_30605":2100,"_5":30961,"_21201":56544,"_27821":56545,"_3006":56546},[],"/docs/pr-preview/pr-66/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3550":2108,"_30605":2100,"_5":30961,"_21201":56548,"_27821":56549,"_3006":56550},[],"/docs/pr-preview/pr-66/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3550":2109,"_30605":2100,"_5":30961,"_21201":56552,"_27821":56553,"_3006":56554},[],"/docs/pr-preview/pr-66/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3550":2110,"_30605":2100,"_5":30961,"_21201":56556,"_27821":56557,"_3006":56558},[],"/docs/pr-preview/pr-66/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3550":2111,"_30605":2100,"_5":30961,"_21201":56560,"_27821":56561,"_3006":56562},[],"/docs/pr-preview/pr-66/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3550":2112,"_30605":2100,"_21201":56564,"_5":14582,"_27821":2100,"_3006":56565},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3550":2113,"_30605":2100,"_21201":56567,"_5":14582,"_27821":56529,"_3006":56568},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3550":2114,"_30605":2100,"_21201":56570,"_5":14582,"_27821":56533,"_3006":56571},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3550":2115,"_30605":2100,"_21201":56573,"_5":14582,"_27821":56537,"_3006":56574},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3550":2116,"_30605":2100,"_21201":56576,"_5":14582,"_27821":56541,"_3006":56577},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3550":2117,"_30605":2100,"_21201":56579,"_5":14582,"_27821":56545,"_3006":56580},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3550":2118,"_30605":2100,"_21201":56582,"_5":14582,"_27821":56549,"_3006":56583},[],"Lamassu persists four X.509 states:",{"_3550":2119,"_30605":2100,"_21201":56585,"_5":14582,"_27821":56549,"_3006":56586},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3550":2120,"_30605":2100,"_21201":56588,"_5":14582,"_27821":56549,"_3006":56589},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3550":2121,"_30605":2100,"_21201":56591,"_5":14582,"_27821":56549,"_3006":56592},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3550":2122,"_30605":2100,"_21201":56594,"_5":14582,"_27821":56549,"_3006":56595},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3550":2123,"_30605":2100,"_21201":56597,"_5":14582,"_27821":56549,"_3006":56598},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3550":2124,"_30605":2100,"_21201":56600,"_5":14582,"_27821":56553,"_3006":56601},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3550":2125,"_30605":2100,"_21201":56603,"_5":14582,"_27821":56553,"_3006":56604},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3550":2126,"_30605":2100,"_21201":56606,"_5":14582,"_27821":56553,"_3006":56607},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3550":2127,"_30605":2100,"_21201":56609,"_5":14582,"_27821":56557,"_3006":56610},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3550":2128,"_30605":2100,"_21201":56612,"_5":14582,"_27821":56557,"_3006":56613},[],"Before confirming:",{"_3550":2129,"_30605":2100,"_21201":56615,"_5":14582,"_27821":56557,"_3006":56616},[],"Identify DMSs, devices and services that trust that chain.",{"_3550":2130,"_30605":2100,"_21201":56618,"_5":14582,"_27821":56557,"_3006":56619},[],"Distribute the new chain of trust.",{"_3550":2131,"_30605":2100,"_21201":56621,"_5":14582,"_27821":56557,"_3006":56622},[],"Reissue the necessary identities.",{"_3550":2132,"_30605":2100,"_21201":56624,"_5":14582,"_27821":56557,"_3006":56625},[],"Check OCSP and CRL from a real consumer.",{"_3550":2133,"_30605":2100,"_21201":56627,"_5":14582,"_27821":56557,"_3006":56628},[],"Revoke the old CA once no legitimate traffic remains.",{"_3550":2134,"_30605":2100,"_21201":56630,"_5":14582,"_27821":56557,"_3006":56631},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3550":2135,"_30605":2100,"_21201":56633,"_5":14582,"_27821":56561,"_3006":56634},[],"Certificates entering the preventive or critical renewal window.",{"_3550":2136,"_30605":2100,"_21201":56636,"_5":14582,"_27821":56561,"_3006":56637},[],"Repeated enrollment or re-enrollment failures.",{"_3550":2137,"_30605":2100,"_21201":56639,"_5":14582,"_27821":56561,"_3006":56640},[],"Status changes and revocation reasons.",{"_3550":2138,"_30605":2100,"_21201":56642,"_5":14582,"_27821":56561,"_3006":56643},[],"OCSP and CRL publication and validity.",{"_3550":2139,"_30605":2100,"_21201":56645,"_5":14582,"_27821":56561,"_3006":56646},[],"Dependencies still presenting a replaced certificate.",{"_3550":2140,"_30605":2100,"_21201":56648,"_5":14582,"_27821":56561,"_3006":56649},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3550":2141,"_30605":2141,"_5":14934,"_3006":56651,"_30964":56652,"_21201":56653,"_27821":2141},"Trust model",[49995,51470,55621,56518],[],{"_3550":2142,"_30605":2141,"_21201":56655,"_5":14582,"_27821":2141,"_3006":56656},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3550":2143,"_30605":2141,"_5":30961,"_21201":56658,"_27821":56659,"_3006":56660},[],"/docs/pr-preview/pr-66/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3550":2144,"_30605":2141,"_5":30961,"_21201":56662,"_27821":56663,"_3006":56664},[],"/docs/pr-preview/pr-66/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3550":2145,"_30605":2141,"_5":30961,"_21201":56666,"_27821":56667,"_3006":56668},[],"/docs/pr-preview/pr-66/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3550":2146,"_30605":2141,"_5":30961,"_21201":56670,"_27821":56671,"_3006":56672},[],"/docs/pr-preview/pr-66/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3550":2147,"_30605":2141,"_5":30961,"_21201":56674,"_27821":56675,"_3006":56676},[],"/docs/pr-preview/pr-66/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3550":2148,"_30605":2141,"_5":30961,"_21201":56678,"_27821":56679,"_3006":56680},[],"/docs/pr-preview/pr-66/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3550":2149,"_30605":2141,"_5":30961,"_21201":56682,"_27821":56683,"_3006":56684},[],"/docs/pr-preview/pr-66/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3550":2150,"_30605":2141,"_5":30961,"_21201":56686,"_27821":56687,"_3006":56688},[],"/docs/pr-preview/pr-66/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3550":2151,"_30605":2141,"_5":30961,"_21201":56690,"_27821":56691,"_3006":56692},[],"/docs/pr-preview/pr-66/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3550":2152,"_30605":2141,"_5":30961,"_21201":56694,"_27821":56695,"_3006":56696},[],"/docs/pr-preview/pr-66/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3550":2153,"_30605":2141,"_21201":56698,"_5":14582,"_27821":2141,"_3006":56699},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3550":2154,"_30605":2141,"_21201":56701,"_5":14582,"_27821":56663,"_3006":56702},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3550":2155,"_30605":2141,"_21201":56704,"_5":14582,"_27821":56667,"_3006":56705},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3550":2156,"_30605":2141,"_21201":56707,"_5":14582,"_27821":56671,"_3006":56708},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3550":2157,"_30605":2141,"_21201":56710,"_5":14582,"_27821":56675,"_3006":56711},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3550":2158,"_30605":2141,"_21201":56713,"_5":14582,"_27821":56679,"_3006":56714},[],"The device proves it can enroll according to the DMS policy.",{"_3550":2159,"_30605":2141,"_21201":56716,"_5":14582,"_27821":56679,"_3006":56717},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3550":2160,"_30605":2141,"_21201":56719,"_5":14582,"_27821":56679,"_3006":56720},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3550":2161,"_30605":2141,"_21201":56722,"_5":14582,"_27821":56679,"_3006":56723},[],"The device installs the certificate and the chain it needs.",{"_3550":2162,"_30605":2141,"_21201":56725,"_5":14582,"_27821":56679,"_3006":56726},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3550":2163,"_30605":2141,"_21201":56728,"_5":14582,"_27821":56679,"_3006":56729},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3550":2164,"_30605":2141,"_21201":56731,"_5":14582,"_27821":56683,"_3006":56732},[],"A DMS relates three sets that are worth designing separately:",{"_3550":2165,"_30605":2141,"_21201":56734,"_5":14582,"_27821":56683,"_3006":56735},[],"**Enrollment CA:** signs the new identities.",{"_3550":2166,"_30605":2141,"_21201":56737,"_5":14582,"_27821":56683,"_3006":56738},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3550":2167,"_30605":2141,"_21201":56740,"_5":14582,"_27821":56683,"_3006":56741},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3550":2168,"_30605":2141,"_21201":56743,"_5":14582,"_27821":56683,"_3006":56744},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3550":2169,"_30605":2141,"_21201":56746,"_5":14582,"_27821":56687,"_3006":56747},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3550":2170,"_30605":2141,"_21201":56749,"_5":14582,"_27821":56687,"_3006":56750},[],"that the current date is between `Not Before` and `Not After`;",{"_3550":2171,"_30605":2141,"_21201":56752,"_5":14582,"_27821":56687,"_3006":56753},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3550":2172,"_30605":2141,"_21201":56755,"_5":14582,"_27821":56687,"_3006":56756},[],"that names, SANs and subject match the expected identity;",{"_3550":2173,"_30605":2141,"_21201":56758,"_5":14582,"_27821":56687,"_3006":56759},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3550":2174,"_30605":2141,"_21201":56761,"_5":14582,"_27821":56687,"_3006":56762},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3550":2175,"_30605":2141,"_21201":56764,"_5":14582,"_27821":56687,"_3006":56765},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3550":2176,"_30605":2141,"_21201":56767,"_5":14582,"_27821":56691,"_3006":56768},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3550":2177,"_30605":2141,"_21201":56770,"_5":14582,"_27821":56695,"_3006":56771},[],"Keep the root out of daily operations, or with very restricted access.",{"_3550":2178,"_30605":2141,"_21201":56773,"_5":14582,"_27821":56695,"_3006":56774},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3550":2179,"_30605":2141,"_21201":56776,"_5":14582,"_27821":56695,"_3006":56777},[],"Assign explicit profiles to every use case.",{"_3550":2180,"_30605":2141,"_21201":56779,"_5":14582,"_27821":56695,"_3006":56780},[],"Distribute the new trust before starting a rotation.",{"_3550":2181,"_30605":2141,"_21201":56782,"_5":14582,"_27821":56695,"_3006":56783},[],"Keep enough overlap to renew a disconnected fleet.",{"_3550":2182,"_30605":2141,"_21201":56785,"_5":14582,"_27821":56695,"_3006":56786},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3550":2183,"_30605":2141,"_21201":56788,"_5":14582,"_27821":56695,"_3006":56789},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3550":2184,"_30605":2184,"_5":14934,"_3006":56791,"_30964":56792,"_21201":56793,"_27821":2184},"Revocation lists (CRL)",[49995,51470,55621,56263],[],{"_3550":2185,"_30605":2184,"_21201":56795,"_5":14582,"_27821":2184,"_3006":56796},[],"Generate and distribute signed lists to validate certificates offline.",{"_3550":2186,"_30605":2184,"_5":30961,"_21201":56798,"_27821":56799,"_3006":56800},[],"/docs/pr-preview/pr-66/platform/pki/crl#crl-settings","CRL settings",{"_3550":2187,"_30605":2184,"_5":30961,"_21201":56802,"_27821":56803,"_3006":56804},[],"/docs/pr-preview/pr-66/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3550":2188,"_30605":2184,"_5":30961,"_21201":56806,"_27821":56807,"_3006":56808},[],"/docs/pr-preview/pr-66/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3550":2189,"_30605":2184,"_5":30961,"_21201":56810,"_27821":56811,"_3006":56812},[],"/docs/pr-preview/pr-66/platform/pki/crl#crl-contents","CRL contents",{"_3550":2190,"_30605":2184,"_5":30961,"_21201":56814,"_27821":56815,"_3006":56816},[],"/docs/pr-preview/pr-66/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3550":2191,"_30605":2184,"_5":30961,"_21201":56818,"_27821":56819,"_3006":56820},[],"/docs/pr-preview/pr-66/platform/pki/crl#crl-settings-api","CRL settings API",{"_3550":2192,"_30605":2184,"_5":30961,"_21201":56822,"_27821":56823,"_3006":56824},[],"/docs/pr-preview/pr-66/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3550":2193,"_30605":2184,"_5":30961,"_21201":56826,"_27821":56827,"_3006":56828},[],"/docs/pr-preview/pr-66/platform/pki/crl#references","References",{"_3550":2194,"_30605":2184,"_21201":56830,"_5":14582,"_27821":2184,"_3006":56831},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3550":2195,"_30605":2184,"_21201":56833,"_5":14582,"_27821":56799,"_3006":56834},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3550":2196,"_30605":2184,"_21201":56836,"_5":14582,"_27821":56799,"_3006":56837},[],"Field",{"_3550":2197,"_30605":2184,"_21201":56839,"_5":14582,"_27821":56799,"_3006":50385},[],{"_3550":2198,"_30605":2184,"_21201":56841,"_5":14582,"_27821":56799,"_3006":51590},[],{"_3550":2199,"_30605":2184,"_21201":56843,"_5":14582,"_27821":56799,"_3006":56844},[],"ID of the CA the settings belong to.",{"_3550":2200,"_30605":2184,"_21201":56846,"_5":14582,"_27821":56799,"_3006":56847},[],"`status`",{"_3550":2201,"_30605":2184,"_21201":56849,"_5":14582,"_27821":56799,"_3006":56850},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3550":2202,"_30605":2184,"_21201":56852,"_5":14582,"_27821":56799,"_3006":56853},[],"`legacy_ski`",{"_3550":2203,"_30605":2184,"_21201":56855,"_5":14582,"_27821":56799,"_3006":56856},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3550":2204,"_30605":2184,"_21201":56858,"_5":14582,"_27821":56799,"_3006":56859},[],"`latest_crl`",{"_3550":2205,"_30605":2184,"_21201":56861,"_5":14582,"_27821":56799,"_3006":56862},[],"Version, validity start and end of the last published list. Read-only.",{"_3550":2206,"_30605":2184,"_21201":56864,"_5":14582,"_27821":56799,"_3006":56865},[],"`crl_options` field",{"_3550":2207,"_30605":2184,"_21201":56867,"_5":14582,"_27821":56799,"_3006":50385},[],{"_3550":2208,"_30605":2184,"_21201":56869,"_5":14582,"_27821":56799,"_3006":56870},[],"Initial value",{"_3550":2209,"_30605":2184,"_21201":56872,"_5":14582,"_27821":56799,"_3006":56873},[],"`validity`",{"_3550":2210,"_30605":2184,"_21201":56875,"_5":14582,"_27821":56799,"_3006":56876},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3550":2211,"_30605":2184,"_21201":56878,"_5":14582,"_27821":56799,"_3006":56879},[],"7 days.",{"_3550":2212,"_30605":2184,"_21201":56881,"_5":14582,"_27821":56799,"_3006":56882},[],"`refresh_interval`",{"_3550":2213,"_30605":2184,"_21201":56884,"_5":14582,"_27821":56799,"_3006":56885},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3550":2214,"_30605":2184,"_21201":56887,"_5":14582,"_27821":56799,"_3006":56888},[],"6 days and 23 hours.",{"_3550":2215,"_30605":2184,"_21201":56890,"_5":14582,"_27821":56799,"_3006":56891},[],"`regenerate_on_revoke`",{"_3550":2216,"_30605":2184,"_21201":56893,"_5":14582,"_27821":56799,"_3006":56894},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3550":2217,"_30605":2184,"_21201":56896,"_5":14582,"_27821":56799,"_3006":56897},[],"`true`.",{"_3550":2218,"_30605":2184,"_21201":56899,"_5":14582,"_27821":56799,"_3006":56900},[],"`signer_serial_number`",{"_3550":2219,"_30605":2184,"_21201":56902,"_5":14582,"_27821":56799,"_3006":56903},[],"Serial number of the existing certificate that signs the CRL.",{"_3550":2220,"_30605":2184,"_21201":56905,"_5":14582,"_27821":56799,"_3006":56906},[],"Serial number of the CA’s current certificate.",{"_3550":2221,"_30605":2184,"_21201":56908,"_5":14582,"_27821":56799,"_3006":56909},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3550":2222,"_30605":2184,"_21201":56911,"_5":14582,"_27821":56799,"_3006":56912},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3550":2223,"_30605":2184,"_21201":56914,"_5":14582,"_27821":56799,"_3006":56915},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3550":2224,"_30605":2184,"_21201":56917,"_5":14582,"_27821":56799,"_3006":56918},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3550":2225,"_30605":2184,"_21201":56920,"_5":14582,"_27821":56799,"_3006":56921},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3550":2226,"_30605":2184,"_21201":56923,"_5":14582,"_27821":56799,"_3006":56924},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3550":2227,"_30605":2184,"_21201":56926,"_5":14582,"_27821":56799,"_3006":56927},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3550":2228,"_30605":2184,"_21201":56929,"_5":14582,"_27821":56799,"_3006":56930},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3550":2229,"_30605":2184,"_21201":56932,"_5":14582,"_27821":56799,"_3006":56933},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3550":2230,"_30605":2184,"_21201":56935,"_5":14582,"_27821":56799,"_3006":56936},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3550":2231,"_30605":2184,"_21201":56938,"_5":14582,"_27821":56799,"_3006":56939},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3550":2232,"_30605":2184,"_21201":56941,"_5":14582,"_27821":56803,"_3006":56942},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3550":2233,"_30605":2184,"_21201":56944,"_5":14582,"_27821":56803,"_3006":56945},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3550":2234,"_30605":2184,"_21201":56947,"_5":14582,"_27821":56803,"_3006":56948},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3550":2235,"_30605":2184,"_21201":56950,"_5":14582,"_27821":56803,"_3006":56951},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3550":2236,"_30605":2184,"_21201":56953,"_5":14582,"_27821":56807,"_3006":56954},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3550":2237,"_30605":2184,"_21201":56956,"_5":14582,"_27821":56807,"_3006":56957},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3550":2238,"_30605":2184,"_21201":56959,"_5":14582,"_27821":56807,"_3006":56960},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3550":2239,"_30605":2184,"_21201":56962,"_5":14582,"_27821":56807,"_3006":56963},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3550":2240,"_30605":2184,"_21201":56965,"_5":14582,"_27821":56807,"_3006":56966},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3550":2241,"_30605":2184,"_21201":56968,"_5":14582,"_27821":56807,"_3006":56969},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3550":2242,"_30605":2184,"_21201":56971,"_5":14582,"_27821":56807,"_3006":56972},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3550":2243,"_30605":2184,"_21201":56974,"_5":14582,"_27821":56807,"_3006":56975},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3550":2244,"_30605":2184,"_21201":56977,"_5":14582,"_27821":56807,"_3006":56978},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3550":2245,"_30605":2184,"_21201":56980,"_5":14582,"_27821":56811,"_3006":56981},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3550":2246,"_30605":2184,"_21201":56983,"_5":14582,"_27821":56811,"_3006":56984},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3550":2247,"_30605":2184,"_21201":56986,"_5":14582,"_27821":56815,"_3006":56987},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3550":2248,"_30605":2184,"_21201":56989,"_5":14582,"_27821":56815,"_3006":56990},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3550":2249,"_30605":2184,"_21201":56992,"_5":14582,"_27821":56815,"_3006":56993},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3550":2250,"_30605":2184,"_21201":56995,"_5":14582,"_27821":56815,"_3006":56996},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3550":2251,"_30605":2184,"_21201":56998,"_5":14582,"_27821":56815,"_3006":56999},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3550":2252,"_30605":2184,"_21201":57001,"_5":14582,"_27821":56819,"_3006":57002},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3550":2253,"_30605":2184,"_21201":57004,"_5":14582,"_27821":56819,"_3006":53386},[],{"_3550":2254,"_30605":2184,"_21201":57006,"_5":14582,"_27821":56819,"_3006":57007},[],"Relative path",{"_3550":2255,"_30605":2184,"_21201":57009,"_5":14582,"_27821":56819,"_3006":53383},[],{"_3550":2256,"_30605":2184,"_21201":57011,"_5":14582,"_27821":56819,"_3006":57012},[],"`GET`",{"_3550":2257,"_30605":2184,"_21201":57014,"_5":14582,"_27821":56819,"_3006":57015},[],"`/v1/crl-settings`",{"_3550":2258,"_30605":2184,"_21201":57017,"_5":14582,"_27821":56819,"_3006":57018},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3550":2259,"_30605":2184,"_21201":57020,"_5":14582,"_27821":56819,"_3006":57012},[],{"_3550":2260,"_30605":2184,"_21201":57022,"_5":14582,"_27821":56819,"_3006":57023},[],"`/v1/crl-settings/{ca-id}`",{"_3550":2261,"_30605":2184,"_21201":57025,"_5":14582,"_27821":56819,"_3006":57026},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3550":2262,"_30605":2184,"_21201":57028,"_5":14582,"_27821":56819,"_3006":57029},[],"`PUT`",{"_3550":2263,"_30605":2184,"_21201":57031,"_5":14582,"_27821":56819,"_3006":57023},[],{"_3550":2264,"_30605":2184,"_21201":57033,"_5":14582,"_27821":56819,"_3006":57034},[],"Replace the CRL configuration of a CA.",{"_3550":2265,"_30605":2184,"_21201":57036,"_5":14582,"_27821":56819,"_3006":57037},[],"`DELETE`",{"_3550":2266,"_30605":2184,"_21201":57039,"_5":14582,"_27821":56819,"_3006":57023},[],{"_3550":2267,"_30605":2184,"_21201":57041,"_5":14582,"_27821":56819,"_3006":57042},[],"Remove the archived CRL settings of a CA.",{"_3550":2268,"_30605":2184,"_21201":57044,"_5":14582,"_27821":56819,"_3006":57045},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3550":2269,"_30605":2184,"_21201":57047,"_5":14582,"_27821":56819,"_3006":57048},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3550":2270,"_30605":2184,"_21201":57050,"_5":14582,"_27821":56819,"_3006":57051},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3550":2271,"_30605":2184,"_21201":57053,"_5":14582,"_27821":56823,"_3006":57054},[],"Symptom",{"_3550":2272,"_30605":2184,"_21201":57056,"_5":14582,"_27821":56823,"_3006":57057},[],"Cause",{"_3550":2273,"_30605":2184,"_21201":57059,"_5":14582,"_27821":56823,"_3006":57060},[],"Action",{"_3550":2274,"_30605":2184,"_21201":57062,"_5":14582,"_27821":56823,"_3006":57063},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3550":2275,"_30605":2184,"_21201":57065,"_5":14582,"_27821":56823,"_3006":57066},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3550":2276,"_30605":2184,"_21201":57068,"_5":14582,"_27821":56823,"_3006":57069},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3550":2277,"_30605":2184,"_21201":57071,"_5":14582,"_27821":56823,"_3006":57072},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3550":2278,"_30605":2184,"_21201":57074,"_5":14582,"_27821":56823,"_3006":57075},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3550":2279,"_30605":2184,"_21201":57077,"_5":14582,"_27821":56823,"_3006":57078},[],"Delete the CA first; deleting it archives its settings.",{"_3550":2280,"_30605":2184,"_21201":57080,"_5":14582,"_27821":56823,"_3006":57081},[],"`PUT` returns 400.",{"_3550":2281,"_30605":2184,"_21201":57083,"_5":14582,"_27821":56823,"_3006":57084},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3550":2282,"_30605":2184,"_21201":57086,"_5":14582,"_27821":56823,"_3006":57087},[],"Set the serial number of a valid certificate of that CA.",{"_3550":2283,"_30605":2184,"_21201":57089,"_5":14582,"_27821":56823,"_3006":57090},[],"`PUT` returns 404.",{"_3550":2284,"_30605":2184,"_21201":57092,"_5":14582,"_27821":56823,"_3006":57093},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3550":2285,"_30605":2184,"_21201":57095,"_5":14582,"_27821":56823,"_3006":57096},[],"Check the CA ID and the signer serial number.",{"_3550":2286,"_30605":2184,"_21201":57098,"_5":14582,"_27821":56823,"_3006":57099},[],"`PUT` returns 400 from a 3.x client.",{"_3550":2287,"_30605":2184,"_21201":57101,"_5":14582,"_27821":56823,"_3006":57102},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3550":2288,"_30605":2184,"_21201":57104,"_5":14582,"_27821":56823,"_3006":57105},[],"Update the client to send the new field.",{"_3550":2289,"_30605":2184,"_21201":57107,"_5":14582,"_27821":56823,"_3006":57108},[],"The CRL does not change after revoking a certificate.",{"_3550":2290,"_30605":2184,"_21201":57110,"_5":14582,"_27821":56823,"_3006":57111},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3550":2291,"_30605":2184,"_21201":57113,"_5":14582,"_27821":56823,"_3006":57114},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3550":2292,"_30605":2184,"_21201":57116,"_5":14582,"_27821":56823,"_3006":57117},[],"A verifier rejects the CRL because of the issuer.",{"_3550":2293,"_30605":2184,"_21201":57119,"_5":14582,"_27821":56823,"_3006":57120},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3550":2294,"_30605":2184,"_21201":57122,"_5":14582,"_27821":56823,"_3006":57123},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3550":2295,"_30605":2184,"_21201":57125,"_5":14582,"_27821":56827,"_3006":57126},[],"RFC 5280: X.509 and CRL profile.",{"_3550":2296,"_30605":2184,"_21201":57128,"_5":14582,"_27821":56827,"_3006":57129},[],"OpenSSL: openssl-crl.",{"_3550":2297,"_30605":2184,"_21201":57131,"_5":14582,"_27821":56827,"_3006":57132},[],"OpenSSL: openssl-verify.",{"_3550":2298,"_30605":2184,"_21201":57134,"_5":14582,"_27821":56827,"_3006":57135},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3550":2299,"_30605":2184,"_21201":57137,"_5":14582,"_27821":56827,"_3006":57138},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3550":2300,"_30605":2300,"_5":14934,"_3006":57140,"_30964":57141,"_21201":57142,"_27821":2300},"Keys and cryptographic engines",[49995,51470,55621,55622],[],{"_3550":2301,"_30605":2300,"_21201":57144,"_5":14582,"_27821":2300,"_3006":57145},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3550":2302,"_30605":2300,"_5":30961,"_21201":57147,"_27821":57148,"_3006":57149},[],"/docs/pr-preview/pr-66/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3550":2303,"_30605":2300,"_5":30961,"_21201":57151,"_27821":57152,"_3006":57153},[],"/docs/pr-preview/pr-66/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3550":2304,"_30605":2300,"_5":30961,"_21201":57155,"_27821":57156,"_3006":57157},[],"/docs/pr-preview/pr-66/platform/pki/key-management#file-system","File System",{"_3550":2305,"_30605":2300,"_5":30961,"_21201":57159,"_27821":57160,"_3006":57161},[],"/docs/pr-preview/pr-66/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3550":2306,"_30605":2300,"_5":30961,"_21201":57163,"_27821":57164,"_3006":57165},[],"/docs/pr-preview/pr-66/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3550":2307,"_30605":2300,"_5":30961,"_21201":57167,"_27821":57168,"_3006":57169},[],"/docs/pr-preview/pr-66/platform/pki/key-management#aws-kms","AWS KMS",{"_3550":2308,"_30605":2300,"_5":30961,"_21201":57171,"_27821":57172,"_3006":57173},[],"/docs/pr-preview/pr-66/platform/pki/key-management#pkcs11","PKCS#11",{"_3550":2309,"_30605":2300,"_5":30961,"_21201":57175,"_27821":57176,"_3006":57177},[],"/docs/pr-preview/pr-66/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3550":2310,"_30605":2300,"_5":30961,"_21201":57179,"_27821":57180,"_3006":57181},[],"/docs/pr-preview/pr-66/platform/pki/key-management#key-inventory","Key inventory",{"_3550":2311,"_30605":2300,"_5":30961,"_21201":57183,"_27821":57184,"_3006":57185},[],"/docs/pr-preview/pr-66/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3550":2312,"_30605":2300,"_5":30961,"_21201":57187,"_27821":57188,"_3006":57189},[],"/docs/pr-preview/pr-66/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3550":2313,"_30605":2300,"_5":30961,"_21201":57191,"_27821":57192,"_3006":57193},[],"/docs/pr-preview/pr-66/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3550":2314,"_30605":2300,"_5":30961,"_21201":57195,"_27821":57196,"_3006":57197},[],"/docs/pr-preview/pr-66/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3550":2315,"_30605":2300,"_5":30961,"_21201":57199,"_27821":57200,"_3006":57201},[],"/docs/pr-preview/pr-66/platform/pki/key-management#view-details","View details",{"_3550":2316,"_30605":2300,"_5":30961,"_21201":57203,"_27821":57204,"_3006":57205},[],"/docs/pr-preview/pr-66/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3550":2317,"_30605":2300,"_5":30961,"_21201":57207,"_27821":57208,"_3006":57209},[],"/docs/pr-preview/pr-66/platform/pki/key-management#sign","Sign",{"_3550":2318,"_30605":2300,"_5":30961,"_21201":57211,"_27821":57212,"_3006":57213},[],"/docs/pr-preview/pr-66/platform/pki/key-management#verify","Verify",{"_3550":2319,"_30605":2300,"_5":30961,"_21201":57215,"_27821":57216,"_3006":57217},[],"/docs/pr-preview/pr-66/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3550":2320,"_30605":2300,"_5":30961,"_21201":57219,"_27821":57220,"_3006":57221},[],"/docs/pr-preview/pr-66/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3550":2321,"_30605":2300,"_5":30961,"_21201":57223,"_27821":57224,"_3006":57225},[],"/docs/pr-preview/pr-66/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3550":2322,"_30605":2300,"_21201":57227,"_5":14582,"_27821":2300,"_3006":57228},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3550":2323,"_30605":2300,"_21201":57230,"_5":14582,"_27821":2300,"_3006":57231},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3550":2324,"_30605":2300,"_21201":57233,"_5":14582,"_27821":57148,"_3006":57234},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3550":2325,"_30605":2300,"_21201":57236,"_5":14582,"_27821":57148,"_3006":57237},[],"In practice, it lets you:",{"_3550":2326,"_30605":2300,"_21201":57239,"_5":14582,"_27821":57148,"_3006":57240},[],"Generate new key pairs from Lamassu IoT.",{"_3550":2327,"_30605":2300,"_21201":57242,"_5":14582,"_27821":57148,"_3006":57243},[],"Import keys created externally.",{"_3550":2328,"_30605":2300,"_21201":57245,"_5":14582,"_27821":57148,"_3006":57246},[],"Delegate custody and cryptographic operations to external engines.",{"_3550":2329,"_30605":2300,"_21201":57248,"_5":14582,"_27821":57148,"_3006":57249},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3550":2330,"_30605":2300,"_21201":57251,"_5":14582,"_27821":57152,"_3006":57252},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3550":2331,"_30605":2300,"_21201":57254,"_5":14582,"_27821":57152,"_3006":57255},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3550":2332,"_30605":2300,"_21201":57257,"_5":14582,"_27821":57152,"_3006":57258},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3550":2333,"_30605":2300,"_21201":57260,"_5":14582,"_27821":57156,"_3006":57261},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3550":2334,"_30605":2300,"_21201":57263,"_5":14582,"_27821":57160,"_3006":57264},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3550":2335,"_30605":2300,"_21201":57266,"_5":14582,"_27821":57160,"_3006":57267},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3550":2336,"_30605":2300,"_21201":57269,"_5":14582,"_27821":57164,"_3006":57270},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3550":2337,"_30605":2300,"_21201":57272,"_5":14582,"_27821":57168,"_3006":57273},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3550":2338,"_30605":2300,"_21201":57275,"_5":14582,"_27821":57172,"_3006":57276},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3550":2339,"_30605":2300,"_21201":57278,"_5":14582,"_27821":57176,"_3006":57279},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3550":2340,"_30605":2300,"_21201":57281,"_5":14582,"_27821":57176,"_3006":57282},[],"Lamassu shows the enabled engines in the console.",{"_3550":2341,"_30605":2300,"_21201":57284,"_5":14582,"_27821":57176,"_3006":57285},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3550":2342,"_30605":2300,"_21201":57287,"_5":14582,"_27821":57176,"_3006":57288},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3550":2343,"_30605":2300,"_21201":57290,"_5":14582,"_27821":57180,"_3006":57291},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3550":2344,"_30605":2300,"_21201":57293,"_5":14582,"_27821":57180,"_3006":57294},[],"The table includes the following fields:",{"_3550":2345,"_30605":2300,"_21201":57296,"_5":14582,"_27821":57180,"_3006":57297},[],"**Name**: descriptive name of the key.",{"_3550":2346,"_30605":2300,"_21201":57299,"_5":14582,"_27821":57180,"_3006":57300},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3550":2347,"_30605":2300,"_21201":57302,"_5":14582,"_27821":57180,"_3006":57303},[],"**Strength**: visual indicator of cryptographic strength.",{"_3550":2348,"_30605":2300,"_21201":57305,"_5":14582,"_27821":57180,"_3006":57306},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3550":2349,"_30605":2300,"_21201":57308,"_5":14582,"_27821":57180,"_3006":57309},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3550":2350,"_30605":2300,"_21201":57311,"_5":14582,"_27821":57180,"_3006":57312},[],"**Aliases**: alternative names associated with the key.",{"_3550":2351,"_30605":2300,"_21201":57314,"_5":14582,"_27821":57180,"_3006":57315},[],"**Tags**: labels for classification and search.",{"_3550":2352,"_30605":2300,"_21201":57317,"_5":14582,"_27821":57180,"_3006":57318},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3550":2353,"_30605":2300,"_21201":57320,"_5":14582,"_27821":57180,"_3006":57321},[],"From this view you also reach the most common actions:",{"_3550":2354,"_30605":2300,"_21201":57323,"_5":14582,"_27821":57180,"_3006":57324},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3550":2355,"_30605":2300,"_21201":57326,"_5":14582,"_27821":57180,"_3006":57327},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3550":2356,"_30605":2300,"_21201":57329,"_5":14582,"_27821":57180,"_3006":57330},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3550":2357,"_30605":2300,"_21201":57332,"_5":14582,"_27821":57180,"_3006":57333},[],"**Delete Key** to remove the key from the system.",{"_3550":2358,"_30605":2300,"_21201":57335,"_5":14582,"_27821":57184,"_3006":57336},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3550":2359,"_30605":2300,"_21201":57338,"_5":14582,"_27821":57188,"_3006":57339},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3550":2360,"_30605":2300,"_21201":57341,"_5":14582,"_27821":57188,"_3006":57342},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3550":2361,"_30605":2300,"_21201":57344,"_5":14582,"_27821":57188,"_3006":57345},[],"**Key Name**: unique and descriptive name.",{"_3550":2362,"_30605":2300,"_21201":57347,"_5":14582,"_27821":57188,"_3006":57348},[],"**Crypto Engine**: engine that will keep the key.",{"_3550":2363,"_30605":2300,"_21201":57350,"_5":14582,"_27821":57188,"_3006":57351},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3550":2364,"_30605":2300,"_21201":57353,"_5":14582,"_27821":57188,"_3006":57354},[],"**Tags**: metadata to classify the key.",{"_3550":2365,"_30605":2300,"_21201":57356,"_5":14582,"_27821":57188,"_3006":57357},[],"**Metadata**: additional information for advanced uses.",{"_3550":2366,"_30605":2300,"_21201":57359,"_5":14582,"_27821":57192,"_3006":57360},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3550":2367,"_30605":2300,"_21201":57362,"_5":14582,"_27821":57192,"_3006":57363},[],"When you have an exportable private key and the destination engine supports import.",{"_3550":2368,"_30605":2300,"_21201":57365,"_5":14582,"_27821":57192,"_3006":57366},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3550":2369,"_30605":2300,"_21201":57368,"_5":14582,"_27821":57192,"_3006":57369},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3550":2370,"_30605":2300,"_21201":57371,"_5":14582,"_27821":57192,"_3006":57372},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3550":2371,"_30605":2300,"_21201":57374,"_5":14582,"_27821":57192,"_3006":57375},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3550":2372,"_30605":2300,"_21201":57377,"_5":14582,"_27821":57192,"_3006":57378},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3550":2373,"_30605":2300,"_21201":57380,"_5":14582,"_27821":57192,"_3006":57381},[],"**Tags**: labels for organization and search.",{"_3550":2374,"_30605":2300,"_21201":57383,"_5":14582,"_27821":57192,"_3006":57384},[],"**Metadata**: additional optional information.",{"_3550":2375,"_30605":2300,"_21201":57386,"_5":14582,"_27821":57192,"_3006":57387},[],"**Private Key (PEM)**: private key in PEM format.",{"_3550":2376,"_30605":2300,"_21201":57389,"_5":14582,"_27821":57192,"_3006":57390},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3550":2377,"_30605":2300,"_21201":57392,"_5":14582,"_27821":57196,"_3006":57393},[],"Each registered key has a detail view and several operational actions.",{"_3550":2378,"_30605":2300,"_21201":57395,"_5":14582,"_27821":57200,"_3006":57396},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3550":2379,"_30605":2300,"_21201":57398,"_5":14582,"_27821":57200,"_3006":57399},[],"The **Overview** tab shows, among others, these fields:",{"_3550":2380,"_30605":2300,"_21201":57401,"_5":14582,"_27821":57200,"_3006":57402},[],"**Key Name**: descriptive name.",{"_3550":2381,"_30605":2300,"_21201":57404,"_5":14582,"_27821":57200,"_3006":57405},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3550":2382,"_30605":2300,"_21201":57407,"_5":14582,"_27821":57200,"_3006":57408},[],"**Tags**: associated labels.",{"_3550":2383,"_30605":2300,"_21201":57410,"_5":14582,"_27821":57200,"_3006":57411},[],"**Aliases**: alternative names.",{"_3550":2384,"_30605":2300,"_21201":57413,"_5":14582,"_27821":57200,"_3006":57414},[],"**Crypto Engine**: engine where the key resides.",{"_3550":2385,"_30605":2300,"_21201":57416,"_5":14582,"_27821":57200,"_3006":57417},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3550":2386,"_30605":2300,"_21201":57419,"_5":14582,"_27821":57200,"_3006":57420},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3550":2387,"_30605":2300,"_21201":57422,"_5":14582,"_27821":57200,"_3006":57423},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3550":2388,"_30605":2300,"_21201":57425,"_5":14582,"_27821":57204,"_3006":57426},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3550":2389,"_30605":2300,"_21201":57428,"_5":14582,"_27821":57204,"_3006":57429},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3550":2390,"_30605":2300,"_21201":57431,"_5":14582,"_27821":57204,"_3006":57432},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3550":2391,"_30605":2300,"_21201":57434,"_5":14582,"_27821":57208,"_3006":57435},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3550":2392,"_30605":2300,"_21201":57437,"_5":14582,"_27821":57208,"_3006":57438},[],"Main fields:",{"_3550":2393,"_30605":2300,"_21201":57440,"_5":14582,"_27821":57208,"_3006":57441},[],"**Algorithm**: signing algorithm available for the key type.",{"_3550":2394,"_30605":2300,"_21201":57443,"_5":14582,"_27821":57208,"_3006":57444},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3550":2395,"_30605":2300,"_21201":57446,"_5":14582,"_27821":57208,"_3006":57447},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3550":2396,"_30605":2300,"_21201":57449,"_5":14582,"_27821":57208,"_3006":57450},[],"**Message**: content to sign.",{"_3550":2397,"_30605":2300,"_21201":57452,"_5":14582,"_27821":57208,"_3006":57453},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3550":2398,"_30605":2300,"_21201":57455,"_5":14582,"_27821":57212,"_3006":57456},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3550":2399,"_30605":2300,"_21201":57458,"_5":14582,"_27821":57212,"_3006":57438},[],{"_3550":2400,"_30605":2300,"_21201":57460,"_5":14582,"_27821":57212,"_3006":57461},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3550":2401,"_30605":2300,"_21201":57463,"_5":14582,"_27821":57212,"_3006":57464},[],"**Message Type**: `Raw` or `Digest`.",{"_3550":2402,"_30605":2300,"_21201":57466,"_5":14582,"_27821":57212,"_3006":57467},[],"**Payload Encoding**: encoding of the message.",{"_3550":2403,"_30605":2300,"_21201":57469,"_5":14582,"_27821":57212,"_3006":57470},[],"**Message**: original message or hash.",{"_3550":2404,"_30605":2300,"_21201":57472,"_5":14582,"_27821":57212,"_3006":57473},[],"**Signature**: signature to check.",{"_3550":2405,"_30605":2300,"_21201":57475,"_5":14582,"_27821":57212,"_3006":57476},[],"**Result**: indicator of the validation result.",{"_3550":2406,"_30605":2300,"_21201":57478,"_5":14582,"_27821":57216,"_3006":57479},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3550":2407,"_30605":2300,"_21201":57481,"_5":14582,"_27821":57216,"_3006":57482},[],"This flow is useful for:",{"_3550":2408,"_30605":2300,"_21201":57484,"_5":14582,"_27821":57216,"_3006":57485},[],"Requesting certificates from an external CA.",{"_3550":2409,"_30605":2300,"_21201":57487,"_5":14582,"_27821":57216,"_3006":57488},[],"Renewing an identity while keeping the same key.",{"_3550":2410,"_30605":2300,"_21201":57490,"_5":14582,"_27821":57216,"_3006":57491},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3550":2411,"_30605":2300,"_21201":57493,"_5":14582,"_27821":57216,"_3006":57494},[],"**Common Name (CN)**: main name of the identity.",{"_3550":2412,"_30605":2300,"_21201":57496,"_5":14582,"_27821":57216,"_3006":57497},[],"**Organization (O)**: organization or company.",{"_3550":2413,"_30605":2300,"_21201":57499,"_5":14582,"_27821":57216,"_3006":57500},[],"**Organizational Unit (OU)**: department or unit.",{"_3550":2414,"_30605":2300,"_21201":57502,"_5":14582,"_27821":57216,"_3006":57503},[],"**Country (C)**: two-letter country code.",{"_3550":2415,"_30605":2300,"_21201":57505,"_5":14582,"_27821":57216,"_3006":57506},[],"**State / Province (ST)**: state or province.",{"_3550":2416,"_30605":2300,"_21201":57508,"_5":14582,"_27821":57216,"_3006":57509},[],"**Locality (L)**: city or locality.",{"_3550":2417,"_30605":2300,"_21201":57511,"_5":14582,"_27821":57216,"_3006":57512},[],"**Email Address**: contact email.",{"_3550":2418,"_30605":2300,"_21201":57514,"_5":14582,"_27821":57216,"_3006":57515},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3550":2419,"_30605":2300,"_21201":57517,"_5":14582,"_27821":57216,"_3006":57518},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3550":2420,"_30605":2300,"_21201":57520,"_5":14582,"_27821":57220,"_3006":57521},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3550":2421,"_30605":2300,"_21201":57523,"_5":14582,"_27821":57220,"_3006":57524},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3550":2422,"_30605":2300,"_21201":57526,"_5":14582,"_27821":57224,"_3006":57527},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3550":2423,"_30605":2300,"_21201":57529,"_5":14582,"_27821":57224,"_3006":57530},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3550":2424,"_30605":2424,"_5":14934,"_3006":57532,"_30964":57533,"_21201":57534,"_27821":2424},"Online validation with OCSP",[49995,51470,55621,56263],[],{"_3550":2425,"_30605":2424,"_21201":57536,"_5":14582,"_27821":2424,"_3006":57537},[],"Query signed status and verify the responder’s response.",{"_3550":2426,"_30605":2424,"_5":30961,"_21201":57539,"_27821":57540,"_3006":57541},[],"/docs/pr-preview/pr-66/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3550":2427,"_30605":2424,"_5":30961,"_21201":57543,"_27821":57544,"_3006":57545},[],"/docs/pr-preview/pr-66/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3550":2428,"_30605":2424,"_5":30961,"_21201":57547,"_27821":57548,"_3006":57549},[],"/docs/pr-preview/pr-66/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3550":2429,"_30605":2424,"_5":30961,"_21201":57551,"_27821":57552,"_3006":57553},[],"/docs/pr-preview/pr-66/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3550":2430,"_30605":2424,"_5":30961,"_21201":57555,"_27821":57556,"_3006":57557},[],"/docs/pr-preview/pr-66/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3550":2431,"_30605":2424,"_5":30961,"_21201":57559,"_27821":57560,"_3006":56828},[],"/docs/pr-preview/pr-66/platform/pki/ocsp#references",{"_3550":2432,"_30605":2424,"_21201":57562,"_5":14582,"_27821":2424,"_3006":57563},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3550":2433,"_30605":2424,"_21201":57565,"_5":14582,"_27821":57540,"_3006":57566},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3550":2434,"_30605":2424,"_21201":57568,"_5":14582,"_27821":57540,"_3006":57569},[],"Record status",{"_3550":2435,"_30605":2424,"_21201":57571,"_5":14582,"_27821":57540,"_3006":57572},[],"Signed response",{"_3550":2436,"_30605":2424,"_21201":57574,"_5":14582,"_27821":57540,"_3006":54758},[],{"_3550":2437,"_30605":2424,"_21201":57576,"_5":14582,"_27821":57540,"_3006":57577},[],"`Good`.",{"_3550":2438,"_30605":2424,"_21201":57579,"_5":14582,"_27821":57540,"_3006":54775},[],{"_3550":2439,"_30605":2424,"_21201":57581,"_5":14582,"_27821":57540,"_3006":57582},[],"`Revoked`, with revocation reason and timestamp.",{"_3550":2440,"_30605":2424,"_21201":57584,"_5":14582,"_27821":57540,"_3006":57585},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3550":2441,"_30605":2424,"_21201":57587,"_5":14582,"_27821":57540,"_3006":57588},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3550":2442,"_30605":2424,"_21201":57590,"_5":14582,"_27821":57540,"_3006":57591},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3550":2443,"_30605":2424,"_21201":57593,"_5":14582,"_27821":57540,"_3006":57594},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3550":2444,"_30605":2424,"_21201":57596,"_5":14582,"_27821":57540,"_3006":57597},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3550":2445,"_30605":2424,"_21201":57599,"_5":14582,"_27821":57544,"_3006":57600},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3550":2446,"_30605":2424,"_21201":57602,"_5":14582,"_27821":57544,"_3006":57603},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3550":2447,"_30605":2424,"_21201":57605,"_5":14582,"_27821":57548,"_3006":57606},[],"The service accepts:",{"_3550":2448,"_30605":2424,"_21201":57608,"_5":14582,"_27821":57548,"_3006":53386},[],{"_3550":2449,"_30605":2424,"_21201":57610,"_5":14582,"_27821":57548,"_3006":57611},[],"VA service path",{"_3550":2450,"_30605":2424,"_21201":57613,"_5":14582,"_27821":57548,"_3006":57614},[],"Format",{"_3550":2451,"_30605":2424,"_21201":57616,"_5":14582,"_27821":57548,"_3006":57617},[],"`POST`",{"_3550":2452,"_30605":2424,"_21201":57619,"_5":14582,"_27821":57548,"_3006":57620},[],"`/ocsp`",{"_3550":2453,"_30605":2424,"_21201":57622,"_5":14582,"_27821":57548,"_3006":57623},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3550":2454,"_30605":2424,"_21201":57625,"_5":14582,"_27821":57548,"_3006":57012},[],{"_3550":2455,"_30605":2424,"_21201":57627,"_5":14582,"_27821":57548,"_3006":57628},[],"`/ocsp/{ocsp_request}`",{"_3550":2456,"_30605":2424,"_21201":57630,"_5":14582,"_27821":57548,"_3006":57631},[],"DER request encoded using padded URL Base64.",{"_3550":2457,"_30605":2424,"_21201":57633,"_5":14582,"_27821":57548,"_3006":57634},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3550":2458,"_30605":2424,"_21201":57636,"_5":14582,"_27821":57552,"_3006":57637},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3550":2459,"_30605":2424,"_21201":57639,"_5":14582,"_27821":57552,"_3006":57640},[],"Generate the request:",{"_3550":2460,"_30605":2424,"_21201":57642,"_5":14582,"_27821":57552,"_3006":57643},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3550":2461,"_30605":2424,"_21201":57645,"_5":14582,"_27821":57552,"_3006":57646},[],"Replace the example URL with the inspected endpoint:",{"_3550":2462,"_30605":2424,"_21201":57648,"_5":14582,"_27821":57552,"_3006":57649},[],"Verify the returned DER:",{"_3550":2463,"_30605":2424,"_21201":57651,"_5":14582,"_27821":57552,"_3006":57652},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3550":2464,"_30605":2424,"_21201":57654,"_5":14582,"_27821":57556,"_3006":57655},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3550":2465,"_30605":2424,"_21201":57657,"_5":14582,"_27821":57556,"_3006":57658},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3550":2466,"_30605":2424,"_21201":57660,"_5":14582,"_27821":57560,"_3006":57661},[],"RFC 6960: OCSP.",{"_3550":2467,"_30605":2424,"_21201":57663,"_5":14582,"_27821":57560,"_3006":57664},[],"OpenSSL: openssl-ocsp.",{"_3550":2468,"_30605":2424,"_21201":57666,"_5":14582,"_27821":57560,"_3006":57667},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3550":2469,"_30605":2424,"_21201":57669,"_5":14582,"_27821":57560,"_3006":57138},[],{"_3550":2470,"_30605":2470,"_5":14934,"_3006":55621,"_30964":57671,"_21201":57672,"_27821":2470},[49995,51470,55621],[],{"_3550":2471,"_30605":2470,"_21201":57674,"_5":14582,"_27821":2470,"_3006":57675},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3550":2472,"_30605":2470,"_5":30961,"_21201":57677,"_27821":57678,"_3006":54933},[],"/docs/pr-preview/pr-66/platform/pki/overview#start-here",{"_3550":2473,"_30605":2470,"_5":30961,"_21201":57680,"_27821":57681,"_3006":57682},[],"/docs/pr-preview/pr-66/platform/pki/overview#what-you-need","What you need",{"_3550":2474,"_30605":2470,"_5":30961,"_21201":57684,"_27821":57685,"_3006":55465},[],"/docs/pr-preview/pr-66/platform/pki/overview#core-capabilities",{"_3550":2475,"_30605":2470,"_5":30961,"_21201":57687,"_27821":57688,"_3006":55469},[],"/docs/pr-preview/pr-66/platform/pki/overview#build-your-trust-hierarchy",{"_3550":2476,"_30605":2470,"_5":30961,"_21201":57690,"_27821":57691,"_3006":55473},[],"/docs/pr-preview/pr-66/platform/pki/overview#protect-cryptographic-keys",{"_3550":2477,"_30605":2470,"_5":30961,"_21201":57693,"_27821":57694,"_3006":55477},[],"/docs/pr-preview/pr-66/platform/pki/overview#issue-and-control-certificates",{"_3550":2478,"_30605":2470,"_5":30961,"_21201":57696,"_27821":57697,"_3006":55485},[],"/docs/pr-preview/pr-66/platform/pki/overview#publish-validation-status",{"_3550":2479,"_30605":2470,"_5":30961,"_21201":57699,"_27821":57700,"_3006":57701},[],"/docs/pr-preview/pr-66/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3550":2480,"_30605":2470,"_5":30961,"_21201":57703,"_27821":57704,"_3006":56430},[],"/docs/pr-preview/pr-66/platform/pki/overview#continue",{"_3550":2481,"_30605":2470,"_21201":57706,"_5":14582,"_27821":2470,"_3006":57707},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3550":2482,"_30605":2470,"_21201":57709,"_5":14582,"_27821":57678,"_3006":57710},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3550":2483,"_30605":2470,"_21201":57712,"_5":14582,"_27821":57678,"_3006":57713},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3550":2484,"_30605":2470,"_21201":57715,"_5":14582,"_27821":57681,"_3006":57716},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3550":2485,"_30605":2470,"_21201":57718,"_5":14582,"_27821":57681,"_3006":57719},[],"An available cryptographic engine to keep the authority's key.",{"_3550":2486,"_30605":2470,"_21201":57721,"_5":14582,"_27821":57681,"_3006":57722},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3550":2487,"_30605":2470,"_21201":57724,"_5":14582,"_27821":57681,"_3006":57725},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3550":2488,"_30605":2470,"_21201":57727,"_5":14582,"_27821":57681,"_3006":57728},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3550":2489,"_30605":2470,"_21201":57730,"_5":14582,"_27821":57688,"_3006":57731},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3550":2490,"_30605":2470,"_21201":57733,"_5":14582,"_27821":57691,"_3006":57734},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3550":2491,"_30605":2470,"_21201":57736,"_5":14582,"_27821":57694,"_3006":57737},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3550":2492,"_30605":2470,"_21201":57739,"_5":14582,"_27821":57697,"_3006":57740},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3550":2493,"_30605":2470,"_21201":57742,"_5":14582,"_27821":57700,"_3006":57743},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3550":2494,"_30605":2470,"_21201":57745,"_5":14582,"_27821":57700,"_3006":57746},[],"its subject and extensions identify the expected client;",{"_3550":2495,"_30605":2470,"_21201":57748,"_5":14582,"_27821":57700,"_3006":57749},[],"its public key matches the client's private key;",{"_3550":2496,"_30605":2470,"_21201":57751,"_5":14582,"_27821":57700,"_3006":57752},[],"its chain reaches a root trusted by the consumer;",{"_3550":2497,"_30605":2470,"_21201":57754,"_5":14582,"_27821":57700,"_3006":57755},[],"its dates and usages allow the operation;",{"_3550":2498,"_30605":2470,"_21201":57757,"_5":14582,"_27821":57700,"_3006":57758},[],"the consumer applies revocation checks and authorization.",{"_3550":2499,"_30605":2470,"_21201":57760,"_5":14582,"_27821":57700,"_3006":57761},[],"The issuance path includes the first independent checks.",{"_3550":2500,"_30605":2470,"_21201":57763,"_5":14582,"_27821":57704,"_3006":57764},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3550":2501,"_30605":2470,"_21201":57766,"_5":14582,"_27821":57704,"_3006":57767},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3550":2502,"_30605":2470,"_21201":57769,"_5":14582,"_27821":57704,"_3006":57770},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3550":2503,"_30605":2503,"_5":14934,"_3006":57772,"_30964":57773,"_21201":57774,"_27821":2503},"Create your first CA",[49995,51470,55621,55058],[],{"_3550":2504,"_30605":2503,"_21201":57776,"_5":14582,"_27821":2503,"_3006":57777},[],"Create an evaluation root and check its certificate before issuing.",{"_3550":2505,"_30605":2503,"_5":30961,"_21201":57779,"_27821":57780,"_3006":50005},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3550":2506,"_30605":2503,"_5":30961,"_21201":57782,"_27821":57783,"_3006":57784},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3550":2507,"_30605":2503,"_5":30961,"_21201":57786,"_27821":57787,"_3006":57788},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3550":2508,"_30605":2503,"_5":30961,"_21201":57790,"_27821":57791,"_3006":57792},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3550":2509,"_30605":2503,"_5":30961,"_21201":57794,"_27821":57795,"_3006":57796},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3550":2510,"_30605":2503,"_5":30961,"_21201":57798,"_27821":57799,"_3006":57800},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3550":2511,"_30605":2503,"_5":30961,"_21201":57802,"_27821":57803,"_3006":57804},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3550":2512,"_30605":2503,"_5":30961,"_21201":57806,"_27821":57807,"_3006":55315},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3550":2513,"_30605":2503,"_5":30961,"_21201":57809,"_27821":57810,"_3006":50029},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3550":2514,"_30605":2503,"_21201":57812,"_5":14582,"_27821":2503,"_3006":57813},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3550":2515,"_30605":2503,"_21201":57815,"_5":14582,"_27821":57780,"_3006":57816},[],"Console access and permission to create keys and authorities.",{"_3550":2516,"_30605":2503,"_21201":57818,"_5":14582,"_27821":57780,"_3006":57819},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3550":2517,"_30605":2503,"_21201":57821,"_5":14582,"_27821":57780,"_3006":57822},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3550":2518,"_30605":2503,"_21201":57824,"_5":14582,"_27821":57780,"_3006":57825},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3550":2519,"_30605":2503,"_21201":57827,"_5":14582,"_27821":57783,"_3006":57828},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3550":2520,"_30605":2503,"_21201":57830,"_5":14582,"_27821":57783,"_3006":57831},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3550":2521,"_30605":2503,"_21201":57833,"_5":14582,"_27821":57787,"_3006":57834},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3550":2522,"_30605":2503,"_21201":57836,"_5":14582,"_27821":57787,"_3006":57837},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3550":2523,"_30605":2503,"_21201":57839,"_5":14582,"_27821":57791,"_3006":57840},[],"Select **Root CA** and complete:",{"_3550":2524,"_30605":2503,"_21201":57842,"_5":14582,"_27821":57791,"_3006":57843},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3550":2525,"_30605":2503,"_21201":57845,"_5":14582,"_27821":57791,"_3006":57846},[],"**Subject**: organization and country details for your evaluation.",{"_3550":2526,"_30605":2503,"_21201":57848,"_5":14582,"_27821":57791,"_3006":57849},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3550":2527,"_30605":2503,"_21201":57851,"_5":14582,"_27821":57791,"_3006":57852},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3550":2528,"_30605":2503,"_21201":57854,"_5":14582,"_27821":57791,"_3006":57855},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3550":2529,"_30605":2503,"_21201":57857,"_5":14582,"_27821":57795,"_3006":57858},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3550":2530,"_30605":2503,"_21201":57860,"_5":14582,"_27821":57799,"_3006":57861},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3550":2531,"_30605":2503,"_21201":57863,"_5":14582,"_27821":57799,"_3006":57864},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3550":2532,"_30605":2503,"_21201":57866,"_5":14582,"_27821":57803,"_3006":57867},[],"Run from the directory where you saved `ca.pem`:",{"_3550":2533,"_30605":2503,"_21201":57869,"_5":14582,"_27821":57803,"_3006":57870},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3550":2534,"_30605":2503,"_21201":57872,"_5":14582,"_27821":57803,"_3006":57873},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3550":2535,"_30605":2503,"_21201":57875,"_5":14582,"_27821":57807,"_3006":57876},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3550":2536,"_30605":2503,"_21201":57878,"_5":14582,"_27821":57807,"_3006":57879},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3550":2537,"_30605":2503,"_21201":57881,"_5":14582,"_27821":57807,"_3006":57882},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3550":2538,"_30605":2503,"_21201":57884,"_5":14582,"_27821":57807,"_3006":57885},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3550":2539,"_30605":2503,"_21201":57887,"_5":14582,"_27821":57810,"_3006":57888},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3550":2540,"_30605":2540,"_5":14934,"_3006":57890,"_30964":57891,"_21201":57892,"_27821":2540},"Issue and verify a certificate",[49995,51470,55621,55058],[],{"_3550":2541,"_30605":2540,"_21201":57894,"_5":14582,"_27821":2540,"_3006":57895},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3550":2542,"_30605":2540,"_5":30961,"_21201":57897,"_27821":57898,"_3006":50005},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3550":2543,"_30605":2540,"_5":30961,"_21201":57900,"_27821":57901,"_3006":57902},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3550":2544,"_30605":2540,"_5":30961,"_21201":57904,"_27821":57905,"_3006":57906},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3550":2545,"_30605":2540,"_5":30961,"_21201":57908,"_27821":57909,"_3006":57910},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3550":2546,"_30605":2540,"_5":30961,"_21201":57912,"_27821":57913,"_3006":57914},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3550":2547,"_30605":2540,"_5":30961,"_21201":57916,"_27821":57917,"_3006":57918},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3550":2548,"_30605":2540,"_5":30961,"_21201":57920,"_27821":57921,"_3006":57922},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3550":2549,"_30605":2540,"_5":30961,"_21201":57924,"_27821":57925,"_3006":57926},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3550":2550,"_30605":2540,"_5":30961,"_21201":57928,"_27821":57929,"_3006":57930},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3550":2551,"_30605":2540,"_5":30961,"_21201":57932,"_27821":57933,"_3006":57934},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3550":2552,"_30605":2540,"_5":30961,"_21201":57936,"_27821":57937,"_3006":55315},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3550":2553,"_30605":2540,"_5":30961,"_21201":57939,"_27821":57940,"_3006":50029},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/issue-certificate#next-step",{"_3550":2554,"_30605":2540,"_21201":57942,"_5":14582,"_27821":2540,"_3006":57943},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3550":2555,"_30605":2540,"_21201":57945,"_5":14582,"_27821":57898,"_3006":57946},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3550":2556,"_30605":2540,"_21201":57948,"_5":14582,"_27821":57898,"_3006":57949},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3550":2557,"_30605":2540,"_21201":57951,"_5":14582,"_27821":57898,"_3006":57952},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3550":2558,"_30605":2540,"_21201":57954,"_5":14582,"_27821":57898,"_3006":57955},[],"A client identifier: here we use `device-001`.",{"_3550":2559,"_30605":2540,"_21201":57957,"_5":14582,"_27821":57898,"_3006":57958},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3550":2560,"_30605":2540,"_21201":57960,"_5":14582,"_27821":57901,"_3006":57961},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3550":2561,"_30605":2540,"_21201":57963,"_5":14582,"_27821":57905,"_3006":57964},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3550":2562,"_30605":2540,"_21201":57966,"_5":14582,"_27821":57905,"_3006":57967},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3550":2563,"_30605":2540,"_21201":57969,"_5":14582,"_27821":57909,"_3006":57970},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3550":2564,"_30605":2540,"_21201":57972,"_5":14582,"_27821":57909,"_3006":57973},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3550":2565,"_30605":2540,"_21201":57975,"_5":14582,"_27821":57913,"_3006":57976},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3550":2566,"_30605":2540,"_21201":57978,"_5":14582,"_27821":57913,"_3006":57979},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3550":2567,"_30605":2540,"_21201":57981,"_5":14582,"_27821":57917,"_3006":57982},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3550":2568,"_30605":2540,"_21201":57984,"_5":14582,"_27821":57921,"_3006":57985},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3550":2569,"_30605":2540,"_21201":57987,"_5":14582,"_27821":57925,"_3006":57988},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3550":2570,"_30605":2540,"_21201":57990,"_5":14582,"_27821":57929,"_3006":57991},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3550":2571,"_30605":2540,"_21201":57993,"_5":14582,"_27821":57929,"_3006":57994},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3550":2572,"_30605":2540,"_21201":57996,"_5":14582,"_27821":57929,"_3006":57997},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3550":2573,"_30605":2540,"_21201":57999,"_5":14582,"_27821":57933,"_3006":58000},[],"In Bash, compare the two public-key digests:",{"_3550":2574,"_30605":2540,"_21201":58002,"_5":14582,"_27821":57933,"_3006":58003},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3550":2575,"_30605":2540,"_21201":58005,"_5":14582,"_27821":57933,"_3006":58006},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3550":2576,"_30605":2540,"_21201":58008,"_5":14582,"_27821":57937,"_3006":55399},[],{"_3550":2577,"_30605":2540,"_21201":58010,"_5":14582,"_27821":57937,"_3006":58011},[],"What to review",{"_3550":2578,"_30605":2540,"_21201":58013,"_5":14582,"_27821":57937,"_3006":58014},[],"The CA rejects issuance",{"_3550":2579,"_30605":2540,"_21201":58016,"_5":14582,"_27821":57937,"_3006":58017},[],"Permissions, CA state and key, algorithm and profile.",{"_3550":2580,"_30605":2540,"_21201":58019,"_5":14582,"_27821":57937,"_3006":58020},[],"Different subject or usages",{"_3550":2581,"_30605":2540,"_21201":58022,"_5":14582,"_27821":57937,"_3006":58023},[],"Applied profile and requested values.",{"_3550":2582,"_30605":2540,"_21201":58025,"_5":14582,"_27821":57937,"_3006":58026},[],"Issuer cannot be found",{"_3550":2583,"_30605":2540,"_21201":58028,"_5":14582,"_27821":57937,"_3006":58029},[],"Downloaded CA and required intermediate chain.",{"_3550":2584,"_30605":2540,"_21201":58031,"_5":14582,"_27821":57937,"_3006":58032},[],"Validity fails",{"_3550":2585,"_30605":2540,"_21201":58034,"_5":14582,"_27821":57937,"_3006":58035},[],"Certificate and CA dates, and the computer's clock.",{"_3550":2586,"_30605":2540,"_21201":58037,"_5":14582,"_27821":57937,"_3006":58038},[],"Public-key digests differ",{"_3550":2587,"_30605":2540,"_21201":58040,"_5":14582,"_27821":57937,"_3006":58041},[],"Certificate and key files from the same issuance.",{"_3550":2588,"_30605":2540,"_21201":58043,"_5":14582,"_27821":57937,"_3006":58044},[],"See PKI diagnostics to narrow an issuance failure.",{"_3550":2589,"_30605":2540,"_21201":58046,"_5":14582,"_27821":57940,"_3006":58047},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3550":2590,"_30605":2540,"_21201":58049,"_5":14582,"_27821":57940,"_3006":58050},[],"Manage certificates for inspection, status and revocation.",{"_3550":2591,"_30605":2540,"_21201":58052,"_5":14582,"_27821":57940,"_3006":58053},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3550":2592,"_30605":2540,"_21201":58055,"_5":14582,"_27821":57940,"_3006":58056},[],"Prepare EST for the device to request its next identities.",{"_3550":2593,"_30605":2540,"_21201":58058,"_5":14582,"_27821":57940,"_3006":58059},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3550":2594,"_30605":2594,"_5":14934,"_3006":58061,"_30964":58062,"_21201":58063,"_27821":2594},"PKI getting started",[49995,51470,55621,55058],[],{"_3550":2595,"_30605":2594,"_21201":58065,"_5":14582,"_27821":2594,"_3006":58066},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3550":2596,"_30605":2594,"_5":30961,"_21201":58068,"_27821":58069,"_3006":50005},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/overview#before-you-begin",{"_3550":2597,"_30605":2594,"_5":30961,"_21201":58071,"_27821":58072,"_3006":58073},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3550":2598,"_30605":2594,"_5":30961,"_21201":58075,"_27821":58076,"_3006":55250},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/overview#expected-result",{"_3550":2599,"_30605":2594,"_5":30961,"_21201":58078,"_27821":58079,"_3006":58080},[],"/docs/pr-preview/pr-66/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3550":2600,"_30605":2594,"_21201":58082,"_5":14582,"_27821":2594,"_3006":58083},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3550":2601,"_30605":2594,"_21201":58085,"_5":14582,"_27821":58069,"_3006":58086},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3550":2602,"_30605":2594,"_21201":58088,"_5":14582,"_27821":58069,"_3006":58089},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3550":2603,"_30605":2594,"_21201":58091,"_5":14582,"_27821":58069,"_3006":58092},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3550":2604,"_30605":2594,"_21201":58094,"_5":14582,"_27821":58069,"_3006":58095},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3550":2605,"_30605":2594,"_21201":58097,"_5":14582,"_27821":58069,"_3006":58098},[],"A working directory with restricted access for the downloaded key.",{"_3550":2606,"_30605":2594,"_21201":58100,"_5":14582,"_27821":58072,"_3006":58101},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3550":2607,"_30605":2594,"_21201":58103,"_5":14582,"_27821":58072,"_3006":58104},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3550":2608,"_30605":2594,"_21201":58106,"_5":14582,"_27821":58072,"_3006":58107},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3550":2609,"_30605":2594,"_21201":58109,"_5":14582,"_27821":58072,"_3006":58110},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3550":2610,"_30605":2594,"_21201":58112,"_5":14582,"_27821":58076,"_3006":58113},[],"File or resource",{"_3550":2611,"_30605":2594,"_21201":58115,"_5":14582,"_27821":58076,"_3006":55247},[],{"_3550":2612,"_30605":2594,"_21201":58117,"_5":14582,"_27821":58076,"_3006":58118},[],"Active root CA and `ca.pem`",{"_3550":2613,"_30605":2594,"_21201":58120,"_5":14582,"_27821":58076,"_3006":58121},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3550":2614,"_30605":2594,"_21201":58123,"_5":14582,"_27821":58076,"_3006":58124},[],"End-entity certificate and `device.crt`",{"_3550":2615,"_30605":2594,"_21201":58126,"_5":14582,"_27821":58076,"_3006":58127},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3550":2616,"_30605":2594,"_21201":58129,"_5":14582,"_27821":58076,"_3006":58130},[],"Private key `device.key`",{"_3550":2617,"_30605":2594,"_21201":58132,"_5":14582,"_27821":58076,"_3006":58133},[],"Its public key matches the one included in `device.crt`.",{"_3550":2618,"_30605":2594,"_21201":58135,"_5":14582,"_27821":58076,"_3006":58136},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3550":2619,"_30605":2594,"_21201":58138,"_5":14582,"_27821":58079,"_3006":58139},[],"To operate certificates, continue with Certificates and Validation.",{"_3550":2620,"_30605":2594,"_21201":58141,"_5":14582,"_27821":58079,"_3006":58142},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3550":2621,"_30605":2594,"_21201":58144,"_5":14582,"_27821":58079,"_3006":58145},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3550":2622,"_30605":2622,"_5":14934,"_3006":58147,"_30964":58148,"_21201":58149,"_27821":2622},"PKI troubleshooting",[49995,51470,55621,54196],[],{"_3550":2623,"_30605":2622,"_21201":58151,"_5":14582,"_27821":2622,"_3006":58152},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3550":2624,"_30605":2622,"_5":30961,"_21201":58154,"_27821":58155,"_3006":58156},[],"/docs/pr-preview/pr-66/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3550":2625,"_30605":2622,"_5":30961,"_21201":58158,"_27821":58159,"_3006":58160},[],"/docs/pr-preview/pr-66/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3550":2626,"_30605":2622,"_5":30961,"_21201":58162,"_27821":58163,"_3006":58164},[],"/docs/pr-preview/pr-66/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3550":2627,"_30605":2622,"_21201":58166,"_5":14582,"_27821":2622,"_3006":58167},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3550":2628,"_30605":2622,"_21201":58169,"_5":14582,"_27821":2622,"_3006":58170},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3550":2629,"_30605":2622,"_21201":58172,"_5":14582,"_27821":58155,"_3006":55247},[],{"_3550":2630,"_30605":2622,"_21201":58174,"_5":14582,"_27821":58155,"_3006":58175},[],"What to inspect",{"_3550":2631,"_30605":2622,"_21201":58177,"_5":14582,"_27821":58155,"_3006":50029},[],{"_3550":2632,"_30605":2622,"_21201":58179,"_5":14582,"_27821":58155,"_3006":54463},[],{"_3550":2633,"_30605":2622,"_21201":58181,"_5":14582,"_27821":58155,"_3006":58182},[],"Exists, is active and has usable dates.",{"_3550":2634,"_30605":2622,"_21201":58184,"_5":14582,"_27821":58155,"_3006":58185},[],"Authorities.",{"_3550":2635,"_30605":2622,"_21201":58187,"_5":14582,"_27821":58155,"_3006":58188},[],"Key",{"_3550":2636,"_30605":2622,"_21201":58190,"_5":14582,"_27821":58155,"_3006":58191},[],"The record has a usable private key and the engine can sign.",{"_3550":2637,"_30605":2622,"_21201":58193,"_5":14582,"_27821":58155,"_3006":58194},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3550":2638,"_30605":2622,"_21201":58196,"_5":14582,"_27821":58155,"_3006":58197},[],"CSR",{"_3550":2639,"_30605":2622,"_21201":58199,"_5":14582,"_27821":58155,"_3006":58200},[],"Correct PEM and verifiable signature.",{"_3550":2640,"_30605":2622,"_21201":58202,"_5":14582,"_27821":58155,"_3006":58203},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3550":2641,"_30605":2622,"_21201":58205,"_5":14582,"_27821":58155,"_3006":58206},[],"Profile",{"_3550":2642,"_30605":2622,"_21201":58208,"_5":14582,"_27821":58155,"_3006":58209},[],"Selected source, existing ID, allowed algorithm and size.",{"_3550":2643,"_30605":2622,"_21201":58211,"_5":14582,"_27821":58155,"_3006":58212},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3550":2644,"_30605":2622,"_21201":58214,"_5":14582,"_27821":58155,"_3006":55399},[],{"_3550":2645,"_30605":2622,"_21201":58216,"_5":14582,"_27821":58155,"_3006":58217},[],"Appropriate subject, SAN, usages and dates.",{"_3550":2646,"_30605":2622,"_21201":58219,"_5":14582,"_27821":58155,"_3006":58220},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3550":2647,"_30605":2622,"_21201":58222,"_5":14582,"_27821":58155,"_3006":58223},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3550":2648,"_30605":2622,"_21201":58225,"_5":14582,"_27821":58155,"_3006":58226},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3550":2649,"_30605":2622,"_21201":58228,"_5":14582,"_27821":58159,"_3006":58229},[],"Check each boundary independently:",{"_3550":2650,"_30605":2622,"_21201":58231,"_5":14582,"_27821":58159,"_3006":58232},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3550":2651,"_30605":2622,"_21201":58234,"_5":14582,"_27821":58159,"_3006":58235},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3550":2652,"_30605":2622,"_21201":58237,"_5":14582,"_27821":58159,"_3006":58238},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3550":2653,"_30605":2622,"_21201":58240,"_5":14582,"_27821":58159,"_3006":58241},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3550":2654,"_30605":2622,"_21201":58243,"_5":14582,"_27821":58159,"_3006":58244},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3550":2655,"_30605":2622,"_21201":58246,"_5":14582,"_27821":58159,"_3006":58247},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3550":2656,"_30605":2622,"_21201":58249,"_5":14582,"_27821":58163,"_3006":58250},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3550":2657,"_30605":2622,"_21201":58252,"_5":14582,"_27821":58163,"_3006":58253},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3550":2658,"_30605":2658,"_5":14934,"_3006":58255,"_30964":58256,"_21201":58257,"_27821":2658},"Security",[49995],[],{"_3550":2659,"_30605":2658,"_21201":58259,"_5":14582,"_27821":2658,"_3006":58260},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3550":2660,"_30605":2658,"_5":30961,"_21201":58262,"_27821":58263,"_3006":58264},[],"/docs/pr-preview/pr-66/security#report-a-vulnerability","Report a vulnerability",{"_3550":2661,"_30605":2658,"_5":30961,"_21201":58266,"_27821":58267,"_3006":58268},[],"/docs/pr-preview/pr-66/security#what-to-include-in-a-report","What to include in a report",{"_3550":2662,"_30605":2658,"_5":30961,"_21201":58270,"_27821":58271,"_3006":58272},[],"/docs/pr-preview/pr-66/security#supported-versions","Supported versions",{"_3550":2663,"_30605":2658,"_5":30961,"_21201":58274,"_27821":58275,"_3006":58276},[],"/docs/pr-preview/pr-66/security#responsible-disclosure","Responsible disclosure",{"_3550":2664,"_30605":2658,"_21201":58278,"_5":14582,"_27821":2658,"_3006":58279},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3550":2665,"_30605":2658,"_21201":58281,"_5":14582,"_27821":58263,"_3006":58282},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3550":2666,"_30605":2658,"_21201":58284,"_5":14582,"_27821":58263,"_3006":58285},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3550":2667,"_30605":2658,"_21201":58287,"_5":14582,"_27821":58263,"_3006":15201},[],{"_3550":2668,"_30605":2658,"_21201":58289,"_5":14582,"_27821":58263,"_3006":15141},[],{"_3550":2669,"_30605":2658,"_21201":58291,"_5":14582,"_27821":58263,"_3006":15188},[],{"_3550":2670,"_30605":2658,"_21201":58293,"_5":14582,"_27821":58263,"_3006":58294},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3550":2671,"_30605":2658,"_21201":58296,"_5":14582,"_27821":58263,"_3006":58297},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3550":2672,"_30605":2658,"_21201":58299,"_5":14582,"_27821":58267,"_3006":58300},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3550":2673,"_30605":2658,"_21201":58302,"_5":14582,"_27821":58267,"_3006":58303},[],"Do not include in the report:",{"_3550":2674,"_30605":2658,"_21201":58305,"_5":14582,"_27821":58267,"_3006":58306},[],"Credentials, tokens, or private keys",{"_3550":2675,"_30605":2658,"_21201":58308,"_5":14582,"_27821":58267,"_3006":58309},[],"Customer data or customer-identifiable information",{"_3550":2676,"_30605":2658,"_21201":58311,"_5":14582,"_27821":58267,"_3006":58312},[],"Confidential architecture or internal infrastructure details",{"_3550":2677,"_30605":2658,"_21201":58314,"_5":14582,"_27821":58271,"_3006":58315},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3550":2678,"_30605":2658,"_21201":58317,"_5":14582,"_27821":58271,"_3006":58318},[],"For upgrade guidance, see Upgrades.",{"_3550":2679,"_30605":2658,"_21201":58320,"_5":14582,"_27821":58275,"_3006":58321},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3550":2680,"_30605":2658,"_21201":58323,"_5":14582,"_27821":58275,"_3006":58324},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3550":2681,"_30605":2658,"_21201":58326,"_5":14582,"_27821":58275,"_3006":58327},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3550":2682,"_30605":2658,"_21201":58329,"_5":14582,"_27821":58275,"_3006":58330},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3550":2683,"_30605":2658,"_21201":58332,"_5":14582,"_27821":58275,"_3006":58333},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3550":2684,"_30605":2684,"_5":14934,"_3006":58335,"_30964":58336,"_21201":58338,"_27821":2684},"3.8.0 to 4.0.0",[49995,58337],"Upgrades",[],{"_3550":2685,"_30605":2684,"_21201":58340,"_5":14582,"_27821":2684,"_3006":58341},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3550":2686,"_30605":2684,"_5":30961,"_21201":58343,"_27821":58344,"_3006":58345},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3550":2687,"_30605":2684,"_5":30961,"_21201":58347,"_27821":58348,"_3006":58349},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3550":2688,"_30605":2684,"_5":30961,"_21201":58351,"_27821":58352,"_3006":58353},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3550":2689,"_30605":2684,"_5":30961,"_21201":58355,"_27821":58356,"_3006":58357},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3550":2690,"_30605":2684,"_5":30961,"_21201":58359,"_27821":58360,"_3006":58361},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3550":2691,"_30605":2684,"_5":30961,"_21201":58363,"_27821":58364,"_3006":58365},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3550":2692,"_30605":2684,"_5":30961,"_21201":58367,"_27821":58368,"_3006":58369},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3550":2693,"_30605":2684,"_5":30961,"_21201":58371,"_27821":58372,"_3006":58373},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3550":2694,"_30605":2684,"_5":30961,"_21201":58375,"_27821":58376,"_3006":58377},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3550":2695,"_30605":2684,"_5":30961,"_21201":58379,"_27821":58380,"_3006":58381},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3550":2696,"_30605":2684,"_5":30961,"_21201":58383,"_27821":58384,"_3006":58385},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3550":2697,"_30605":2684,"_5":30961,"_21201":58387,"_27821":58388,"_3006":58389},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3550":2698,"_30605":2684,"_5":30961,"_21201":58391,"_27821":58392,"_3006":58393},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3550":2699,"_30605":2684,"_5":30961,"_21201":58395,"_27821":58396,"_3006":58397},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3550":2700,"_30605":2684,"_5":30961,"_21201":58399,"_27821":58400,"_3006":58401},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3550":2701,"_30605":2684,"_5":30961,"_21201":58403,"_27821":58404,"_3006":58405},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3550":2702,"_30605":2684,"_5":30961,"_21201":58407,"_27821":58408,"_3006":58409},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3550":2703,"_30605":2684,"_5":30961,"_21201":58411,"_27821":58412,"_3006":58413},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3550":2704,"_30605":2684,"_5":30961,"_21201":58415,"_27821":58416,"_3006":58417},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3550":2705,"_30605":2684,"_5":30961,"_21201":58419,"_27821":58420,"_3006":58421},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3550":2706,"_30605":2684,"_5":30961,"_21201":58423,"_27821":58424,"_3006":58425},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3550":2707,"_30605":2684,"_5":30961,"_21201":58427,"_27821":58428,"_3006":58429},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3550":2708,"_30605":2684,"_5":30961,"_21201":58431,"_27821":58432,"_3006":58433},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3550":2709,"_30605":2684,"_5":30961,"_21201":58435,"_27821":58436,"_3006":58437},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3550":2710,"_30605":2684,"_5":30961,"_21201":58439,"_27821":58440,"_3006":58441},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3550":2711,"_30605":2684,"_5":30961,"_21201":58443,"_27821":58444,"_3006":58445},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3550":2712,"_30605":2684,"_5":30961,"_21201":58447,"_27821":58448,"_3006":58449},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3550":2713,"_30605":2684,"_5":30961,"_21201":58451,"_27821":58452,"_3006":58453},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3550":2714,"_30605":2684,"_5":30961,"_21201":58455,"_27821":58456,"_3006":58457},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3550":2715,"_30605":2684,"_5":30961,"_21201":58459,"_27821":58460,"_3006":58461},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3550":2716,"_30605":2684,"_5":30961,"_21201":58463,"_27821":58464,"_3006":58465},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3550":2717,"_30605":2684,"_5":30961,"_21201":58467,"_27821":58468,"_3006":58469},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3550":2718,"_30605":2684,"_5":30961,"_21201":58471,"_27821":58472,"_3006":58473},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3550":2719,"_30605":2684,"_5":30961,"_21201":58475,"_27821":58476,"_3006":58477},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3550":2720,"_30605":2684,"_5":30961,"_21201":58479,"_27821":58480,"_3006":58481},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3550":2721,"_30605":2684,"_5":30961,"_21201":58483,"_27821":58484,"_3006":58485},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3550":2722,"_30605":2684,"_5":30961,"_21201":58487,"_27821":58488,"_3006":58489},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3550":2723,"_30605":2684,"_5":30961,"_21201":58491,"_27821":58492,"_3006":58493},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3550":2724,"_30605":2684,"_5":30961,"_21201":58495,"_27821":58496,"_3006":58497},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3550":2725,"_30605":2684,"_5":30961,"_21201":58499,"_27821":58500,"_3006":58501},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3550":2726,"_30605":2684,"_5":30961,"_21201":58503,"_27821":58504,"_3006":54196},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3550":2727,"_30605":2684,"_5":30961,"_21201":58506,"_27821":58507,"_3006":58508},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3550":2728,"_30605":2684,"_5":30961,"_21201":58510,"_27821":58511,"_3006":58512},[],"/docs/pr-preview/pr-66/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3550":2729,"_30605":2684,"_21201":58514,"_5":14582,"_27821":2684,"_3006":58515},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3550":2730,"_30605":2684,"_21201":58517,"_5":14582,"_27821":2684,"_3006":58518},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3550":2731,"_30605":2684,"_21201":58520,"_5":14582,"_27821":2684,"_3006":58521},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3550":2732,"_30605":2684,"_21201":58523,"_5":14582,"_27821":2684,"_3006":58524},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3550":2733,"_30605":2684,"_21201":58526,"_5":14582,"_27821":2684,"_3006":58527},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3550":2734,"_30605":2684,"_21201":58529,"_5":14582,"_27821":2684,"_3006":58530},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3550":2735,"_30605":2684,"_21201":58532,"_5":14582,"_27821":2684,"_3006":58533},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3550":2736,"_30605":2684,"_21201":58535,"_5":14582,"_27821":58348,"_3006":58536},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3550":2737,"_30605":2684,"_21201":58538,"_5":14582,"_27821":58348,"_3006":58539},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3550":2738,"_30605":2684,"_21201":58541,"_5":14582,"_27821":58352,"_3006":58542},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3550":2739,"_30605":2684,"_21201":58544,"_5":14582,"_27821":58352,"_3006":58545},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3550":2740,"_30605":2684,"_21201":58547,"_5":14582,"_27821":58356,"_3006":58548},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3550":2741,"_30605":2684,"_21201":58550,"_5":14582,"_27821":58360,"_3006":58551},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3550":2742,"_30605":2684,"_21201":58553,"_5":14582,"_27821":58360,"_3006":58554},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3550":2743,"_30605":2684,"_21201":58556,"_5":14582,"_27821":58360,"_3006":58557},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3550":2744,"_30605":2684,"_21201":58559,"_5":14582,"_27821":58360,"_3006":58560},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3550":2745,"_30605":2684,"_21201":58562,"_5":14582,"_27821":58360,"_3006":58563},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3550":2746,"_30605":2684,"_21201":58565,"_5":14582,"_27821":58364,"_3006":58566},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3550":2747,"_30605":2684,"_21201":58568,"_5":14582,"_27821":58364,"_3006":58569},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3550":2748,"_30605":2684,"_21201":58571,"_5":14582,"_27821":58364,"_3006":58572},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3550":2749,"_30605":2684,"_21201":58574,"_5":14582,"_27821":58364,"_3006":58575},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3550":2750,"_30605":2684,"_21201":58577,"_5":14582,"_27821":58364,"_3006":58578},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3550":2751,"_30605":2684,"_21201":58580,"_5":14582,"_27821":58364,"_3006":58581},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3550":2752,"_30605":2684,"_21201":58583,"_5":14582,"_27821":58368,"_3006":58584},[],"Change",{"_3550":2753,"_30605":2684,"_21201":58586,"_5":14582,"_27821":58368,"_3006":58587},[],"Who is affected",{"_3550":2754,"_30605":2684,"_21201":58589,"_5":14582,"_27821":58368,"_3006":58590},[],"Severity",{"_3550":2755,"_30605":2684,"_21201":58592,"_5":14582,"_27821":58368,"_3006":57060},[],{"_3550":2756,"_30605":2684,"_21201":58594,"_5":14582,"_27821":58368,"_3006":58377},[],{"_3550":2757,"_30605":2684,"_21201":58596,"_5":14582,"_27821":58368,"_3006":58597},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3550":2758,"_30605":2684,"_21201":58599,"_5":14582,"_27821":58368,"_3006":58600},[],"High: KMS and VA start on empty volumes",{"_3550":2759,"_30605":2684,"_21201":58602,"_5":14582,"_27821":58368,"_3006":58603},[],"Copy the data into the new volumes",{"_3550":2760,"_30605":2684,"_21201":58605,"_5":14582,"_27821":58368,"_3006":58381},[],{"_3550":2761,"_30605":2684,"_21201":58607,"_5":14582,"_27821":58368,"_3006":58608},[],"Every Helm release",{"_3550":2762,"_30605":2684,"_21201":58610,"_5":14582,"_27821":58368,"_3006":58611},[],"High: `helm upgrade` fails",{"_3550":2763,"_30605":2684,"_21201":58613,"_5":14582,"_27821":58368,"_3006":58614},[],"Remove or rename legacy keys",{"_3550":2764,"_30605":2684,"_21201":58616,"_5":14582,"_27821":58368,"_3006":58385},[],{"_3550":2765,"_30605":2684,"_21201":58618,"_5":14582,"_27821":58368,"_3006":58619},[],"Every deployment",{"_3550":2766,"_30605":2684,"_21201":58621,"_5":14582,"_27821":58368,"_3006":58622},[],"High: without a bootstrap principal there is no administrator",{"_3550":2767,"_30605":2684,"_21201":58624,"_5":14582,"_27821":58368,"_3006":58625},[],"Configure `services.authz`",{"_3550":2768,"_30605":2684,"_21201":58627,"_5":14582,"_27821":58368,"_3006":58389},[],{"_3550":2769,"_30605":2684,"_21201":58629,"_5":14582,"_27821":58368,"_3006":58608},[],{"_3550":2770,"_30605":2684,"_21201":58631,"_5":14582,"_27821":58368,"_3006":58632},[],"High: `helm upgrade` fails on the old keys",{"_3550":2771,"_30605":2684,"_21201":58634,"_5":14582,"_27821":58368,"_3006":58635},[],"Move JWKS and roles into `services.authz`",{"_3550":2772,"_30605":2684,"_21201":58637,"_5":14582,"_27821":58368,"_3006":58409},[],{"_3550":2773,"_30605":2684,"_21201":58639,"_5":14582,"_27821":58368,"_3006":58640},[],"3.8.0 deployments with per-service databases",{"_3550":2774,"_30605":2684,"_21201":58642,"_5":14582,"_27821":58368,"_3006":58643},[],"High: services find no data, or a migration aborts",{"_3550":2775,"_30605":2684,"_21201":58645,"_5":14582,"_27821":58368,"_3006":58646},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3550":2776,"_30605":2684,"_21201":58648,"_5":14582,"_27821":58368,"_3006":58413},[],{"_3550":2777,"_30605":2684,"_21201":58650,"_5":14582,"_27821":58368,"_3006":58651},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3550":2778,"_30605":2684,"_21201":58653,"_5":14582,"_27821":58368,"_3006":58654},[],"High: the backend no longer starts with them",{"_3550":2779,"_30605":2684,"_21201":58656,"_5":14582,"_27821":58368,"_3006":58657},[],"Move to PostgreSQL before upgrading",{"_3550":2780,"_30605":2684,"_21201":58659,"_5":14582,"_27821":58368,"_3006":58457},[],{"_3550":2781,"_30605":2684,"_21201":58661,"_5":14582,"_27821":58368,"_3006":58662},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3550":2782,"_30605":2684,"_21201":58664,"_5":14582,"_27821":58368,"_3006":58665},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3550":2783,"_30605":2684,"_21201":58667,"_5":14582,"_27821":58368,"_3006":58668},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3550":2784,"_30605":2684,"_21201":58670,"_5":14582,"_27821":58368,"_3006":58671},[],"Webhooks with file references",{"_3550":2785,"_30605":2684,"_21201":58673,"_5":14582,"_27821":58368,"_3006":58674},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3550":2786,"_30605":2684,"_21201":58676,"_5":14582,"_27821":58368,"_3006":58677},[],"High: enrollments calling the webhook fail",{"_3550":2787,"_30605":2684,"_21201":58679,"_5":14582,"_27821":58368,"_3006":58680},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3550":2788,"_30605":2684,"_21201":58682,"_5":14582,"_27821":58368,"_3006":58393},[],{"_3550":2789,"_30605":2684,"_21201":58684,"_5":14582,"_27821":58368,"_3006":58685},[],"Releases with per-service identity overrides or mounted key material",{"_3550":2790,"_30605":2684,"_21201":58687,"_5":14582,"_27821":58368,"_3006":58688},[],"Medium: services cannot read their files",{"_3550":2791,"_30605":2684,"_21201":58690,"_5":14582,"_27821":58368,"_3006":58691},[],"Remove the overrides and fix volume ownership",{"_3550":2792,"_30605":2684,"_21201":58693,"_5":14582,"_27821":58368,"_3006":58397},[],{"_3550":2793,"_30605":2684,"_21201":58695,"_5":14582,"_27821":58368,"_3006":58696},[],"Releases that set `amqp.tls`",{"_3550":2794,"_30605":2684,"_21201":58698,"_5":14582,"_27821":58368,"_3006":58699},[],"Medium: clients connect to the wrong port",{"_3550":2795,"_30605":2684,"_21201":58701,"_5":14582,"_27821":58368,"_3006":58702},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3550":2796,"_30605":2684,"_21201":58704,"_5":14582,"_27821":58368,"_3006":58417},[],{"_3550":2797,"_30605":2684,"_21201":58706,"_5":14582,"_27821":58368,"_3006":58707},[],"Installations whose CA keys predate the KMS",{"_3550":2798,"_30605":2684,"_21201":58709,"_5":14582,"_27821":58368,"_3006":58710},[],"Medium: CA keys stay unmanaged",{"_3550":2799,"_30605":2684,"_21201":58712,"_5":14582,"_27821":58368,"_3006":58713},[],"Run the CA-to-KMS migration",{"_3550":2800,"_30605":2684,"_21201":58715,"_5":14582,"_27821":58368,"_3006":58716},[],"Receiver certificate verification",{"_3550":2801,"_30605":2684,"_21201":58718,"_5":14582,"_27821":58368,"_3006":58719},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3550":2802,"_30605":2684,"_21201":58721,"_5":14582,"_27821":58368,"_3006":58722},[],"Medium: credentials go to an unverified receiver",{"_3550":2803,"_30605":2684,"_21201":58724,"_5":14582,"_27821":58368,"_3006":58725},[],"Set `insecure_skip_verify` to `false`",{"_3550":2804,"_30605":2684,"_21201":58727,"_5":14582,"_27821":58368,"_3006":58433},[],{"_3550":2805,"_30605":2684,"_21201":58729,"_5":14582,"_27821":58368,"_3006":58730},[],"Scripts and consoles that edit DMSs through the API",{"_3550":2806,"_30605":2684,"_21201":58732,"_5":14582,"_27821":58368,"_3006":58733},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3550":2807,"_30605":2684,"_21201":58735,"_5":14582,"_27821":58368,"_3006":58736},[],"Read the DMS before editing and use the new field",{"_3550":2808,"_30605":2684,"_21201":58738,"_5":14582,"_27821":58368,"_3006":58453},[],{"_3550":2809,"_30605":2684,"_21201":58740,"_5":14582,"_27821":58368,"_3006":58741},[],"Clients that create or update CRL settings through the API",{"_3550":2810,"_30605":2684,"_21201":58743,"_5":14582,"_27821":58368,"_3006":58744},[],"Medium: requests with the old field return an error",{"_3550":2811,"_30605":2684,"_21201":58746,"_5":14582,"_27821":58368,"_3006":58747},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3550":2812,"_30605":2684,"_21201":58749,"_5":14582,"_27821":58368,"_3006":58461},[],{"_3550":2813,"_30605":2684,"_21201":58751,"_5":14582,"_27821":58368,"_3006":58752},[],"Alert subscriptions and consumers of the VA events",{"_3550":2814,"_30605":2684,"_21201":58754,"_5":14582,"_27821":58368,"_3006":58755},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3550":2815,"_30605":2684,"_21201":58757,"_5":14582,"_27821":58368,"_3006":58758},[],"Review conditions filtering on the old event payload or subject",{"_3550":2816,"_30605":2684,"_21201":58760,"_5":14582,"_27821":58368,"_3006":58449},[],{"_3550":2817,"_30605":2684,"_21201":58762,"_5":14582,"_27821":58368,"_3006":58763},[],"Consumers that read the device `events` field",{"_3550":2818,"_30605":2684,"_21201":58765,"_5":14582,"_27821":58368,"_3006":58766},[],"Medium: the field disappears",{"_3550":2819,"_30605":2684,"_21201":58768,"_5":14582,"_27821":58368,"_3006":58769},[],"Use the new event endpoints",{"_3550":2820,"_30605":2684,"_21201":58771,"_5":14582,"_27821":58368,"_3006":58469},[],{"_3550":2821,"_30605":2684,"_21201":58773,"_5":14582,"_27821":58368,"_3006":58774},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3550":2822,"_30605":2684,"_21201":58776,"_5":14582,"_27821":58368,"_3006":58777},[],"Medium: the VA migration aborts",{"_3550":2823,"_30605":2684,"_21201":58779,"_5":14582,"_27821":58368,"_3006":58780},[],"Fix the affected roles before upgrading",{"_3550":2824,"_30605":2684,"_21201":58782,"_5":14582,"_27821":58368,"_3006":58401},[],{"_3550":2825,"_30605":2684,"_21201":58784,"_5":14582,"_27821":58368,"_3006":58785},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3550":2826,"_30605":2684,"_21201":58787,"_5":14582,"_27821":58368,"_3006":58788},[],"Low to medium: validation errors or changed defaults",{"_3550":2827,"_30605":2684,"_21201":58790,"_5":14582,"_27821":58368,"_3006":58791},[],"Update the values file",{"_3550":2828,"_30605":2684,"_21201":58793,"_5":14582,"_27821":58368,"_3006":58441},[],{"_3550":2829,"_30605":2684,"_21201":58795,"_5":14582,"_27821":58368,"_3006":58796},[],"Clients that send the DMS ID in the update body",{"_3550":2830,"_30605":2684,"_21201":58798,"_5":14582,"_27821":58368,"_3006":58799},[],"Low: the ID in the URL wins",{"_3550":2831,"_30605":2684,"_21201":58801,"_5":14582,"_27821":58368,"_3006":58802},[],"Send the ID in the URL",{"_3550":2832,"_30605":2684,"_21201":58804,"_5":14582,"_27821":58368,"_3006":58465},[],{"_3550":2833,"_30605":2684,"_21201":58806,"_5":14582,"_27821":58368,"_3006":58807},[],"Clients that send an `id` when creating or importing CAs",{"_3550":2834,"_30605":2684,"_21201":58809,"_5":14582,"_27821":58368,"_3006":58810},[],"Low: the ID in the body is ignored, and the field is removed",{"_3550":2835,"_30605":2684,"_21201":58812,"_5":14582,"_27821":58368,"_3006":58813},[],"Let the backend assign the ID and use the returned one",{"_3550":2836,"_30605":2684,"_21201":58815,"_5":14582,"_27821":58368,"_3006":58445},[],{"_3550":2837,"_30605":2684,"_21201":58817,"_5":14582,"_27821":58368,"_3006":58818},[],"Consumers that match on certificate `type`",{"_3550":2838,"_30605":2684,"_21201":58820,"_5":14582,"_27821":58368,"_3006":58821},[],"Low: two values are renamed",{"_3550":2839,"_30605":2684,"_21201":58823,"_5":14582,"_27821":58368,"_3006":58824},[],"Adapt consumers",{"_3550":2840,"_30605":2684,"_21201":58826,"_5":14582,"_27821":58368,"_3006":58437},[],{"_3550":2841,"_30605":2684,"_21201":58828,"_5":14582,"_27821":58368,"_3006":58829},[],"Any DMS",{"_3550":2842,"_30605":2684,"_21201":58831,"_5":14582,"_27821":58368,"_3006":58832},[],"Low: informational",{"_3550":2843,"_30605":2684,"_21201":58834,"_5":14582,"_27821":58368,"_3006":58835},[],"Read both blocks before editing",{"_3550":2844,"_30605":2684,"_21201":58837,"_5":14582,"_27821":58376,"_3006":58838},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3550":2845,"_30605":2684,"_21201":58840,"_5":14582,"_27821":58376,"_3006":58841},[],"Step 4 of the migration guide copies the data.",{"_3550":2846,"_30605":2684,"_21201":58843,"_5":14582,"_27821":58380,"_3006":58844},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3550":2847,"_30605":2684,"_21201":58846,"_5":14582,"_27821":58384,"_3006":58847},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3550":2848,"_30605":2684,"_21201":58849,"_5":14582,"_27821":58388,"_3006":58850},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3550":2849,"_30605":2684,"_21201":58852,"_5":14582,"_27821":58392,"_3006":58853},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3550":2850,"_30605":2684,"_21201":58855,"_5":14582,"_27821":58392,"_3006":58856},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3550":2851,"_30605":2684,"_21201":58858,"_5":14582,"_27821":58396,"_3006":58859},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3550":2852,"_30605":2684,"_21201":58861,"_5":14582,"_27821":58400,"_3006":58862},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3550":2853,"_30605":2684,"_21201":58864,"_5":14582,"_27821":58400,"_3006":58865},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3550":2854,"_30605":2684,"_21201":58867,"_5":14582,"_27821":58400,"_3006":58868},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3550":2855,"_30605":2684,"_21201":58870,"_5":14582,"_27821":58400,"_3006":58871},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3550":2856,"_30605":2684,"_21201":58873,"_5":14582,"_27821":58400,"_3006":58874},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3550":2857,"_30605":2684,"_21201":58876,"_5":14582,"_27821":58400,"_3006":58877},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3550":2858,"_30605":2684,"_21201":58879,"_5":14582,"_27821":58408,"_3006":58880},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3550":2859,"_30605":2684,"_21201":58882,"_5":14582,"_27821":58408,"_3006":58883},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3550":2860,"_30605":2684,"_21201":58885,"_5":14582,"_27821":58408,"_3006":58886},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3550":2861,"_30605":2684,"_21201":58888,"_5":14582,"_27821":58408,"_3006":58889},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3550":2862,"_30605":2684,"_21201":58891,"_5":14582,"_27821":58408,"_3006":58892},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3550":2863,"_30605":2684,"_21201":58894,"_5":14582,"_27821":58412,"_3006":58895},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3550":2864,"_30605":2684,"_21201":58897,"_5":14582,"_27821":58416,"_3006":58898},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3550":2865,"_30605":2684,"_21201":58900,"_5":14582,"_27821":58416,"_3006":58901},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3550":2866,"_30605":2684,"_21201":58903,"_5":14582,"_27821":58416,"_3006":58904},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3550":2867,"_30605":2684,"_21201":58906,"_5":14582,"_27821":58416,"_3006":58907},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3550":2868,"_30605":2684,"_21201":58909,"_5":14582,"_27821":58416,"_3006":58910},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3550":2869,"_30605":2684,"_21201":58912,"_5":14582,"_27821":58416,"_3006":58913},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3550":2870,"_30605":2684,"_21201":58915,"_5":14582,"_27821":58416,"_3006":58916},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3550":2871,"_30605":2684,"_21201":58918,"_5":14582,"_27821":58416,"_3006":58919},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3550":2872,"_30605":2684,"_21201":58921,"_5":14582,"_27821":58420,"_3006":58922},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3550":2873,"_30605":2684,"_21201":58924,"_5":14582,"_27821":58428,"_3006":58925},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3550":2874,"_30605":2684,"_21201":58927,"_5":14582,"_27821":58428,"_3006":58928},[],"Field in 3.8.0",{"_3550":2875,"_30605":2684,"_21201":58930,"_5":14582,"_27821":58428,"_3006":58931},[],"Field in 4.0.0",{"_3550":2876,"_30605":2684,"_21201":58933,"_5":14582,"_27821":58428,"_3006":58934},[],"`validate_server_cert`",{"_3550":2877,"_30605":2684,"_21201":58936,"_5":14582,"_27821":58428,"_3006":58937},[],"`insecure_skip_verify` (value negated)",{"_3550":2878,"_30605":2684,"_21201":58939,"_5":14582,"_27821":58428,"_3006":58940},[],"`oidc`",{"_3550":2879,"_30605":2684,"_21201":58942,"_5":14582,"_27821":58428,"_3006":58943},[],"`jwt_options`",{"_3550":2880,"_30605":2684,"_21201":58945,"_5":14582,"_27821":58428,"_3006":58946},[],"`apikey`",{"_3550":2881,"_30605":2684,"_21201":58948,"_5":14582,"_27821":58428,"_3006":58949},[],"`apikey_options`",{"_3550":2882,"_30605":2684,"_21201":58951,"_5":14582,"_27821":58428,"_3006":58952},[],"`mtls`",{"_3550":2883,"_30605":2684,"_21201":58954,"_5":14582,"_27821":58428,"_3006":58955},[],"`mtls_options`",{"_3550":2884,"_30605":2684,"_21201":58957,"_5":14582,"_27821":58428,"_3006":58958},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3550":2885,"_30605":2684,"_21201":58960,"_5":14582,"_27821":58428,"_3006":58961},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3550":2886,"_30605":2684,"_21201":58963,"_5":14582,"_27821":58428,"_3006":58964},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3550":2887,"_30605":2684,"_21201":58966,"_5":14582,"_27821":58432,"_3006":58967},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3550":2888,"_30605":2684,"_21201":58969,"_5":14582,"_27821":58432,"_3006":58970},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3550":2889,"_30605":2684,"_21201":58972,"_5":14582,"_27821":58432,"_3006":58973},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3550":2890,"_30605":2684,"_21201":58975,"_5":14582,"_27821":58436,"_3006":58976},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3550":2891,"_30605":2684,"_21201":58978,"_5":14582,"_27821":58440,"_3006":58979},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3550":2892,"_30605":2684,"_21201":58981,"_5":14582,"_27821":58444,"_3006":58982},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3550":2893,"_30605":2684,"_21201":58984,"_5":14582,"_27821":58448,"_3006":58985},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3550":2894,"_30605":2684,"_21201":58987,"_5":14582,"_27821":58448,"_3006":58988},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3550":2895,"_30605":2684,"_21201":58990,"_5":14582,"_27821":58448,"_3006":58991},[],"`POST /v1/devices/:id/events` creates an event.",{"_3550":2896,"_30605":2684,"_21201":58993,"_5":14582,"_27821":58448,"_3006":58994},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3550":2897,"_30605":2684,"_21201":58996,"_5":14582,"_27821":58452,"_3006":58997},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3550":2898,"_30605":2684,"_21201":58999,"_5":14582,"_27821":58456,"_3006":59000},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3550":2899,"_30605":2684,"_21201":59002,"_5":14582,"_27821":58456,"_3006":59003},[],"Route",{"_3550":2900,"_30605":2684,"_21201":59005,"_5":14582,"_27821":58456,"_3006":53383},[],{"_3550":2901,"_30605":2684,"_21201":59007,"_5":14582,"_27821":58456,"_3006":59008},[],"`GET /v1/crl-settings`",{"_3550":2902,"_30605":2684,"_21201":59010,"_5":14582,"_27821":58456,"_3006":59011},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3550":2903,"_30605":2684,"_21201":59013,"_5":14582,"_27821":58456,"_3006":59014},[],"`GET /v1/crl-settings/{ca-id}`",{"_3550":2904,"_30605":2684,"_21201":59016,"_5":14582,"_27821":58456,"_3006":59017},[],"Reads the settings of a CA.",{"_3550":2905,"_30605":2684,"_21201":59019,"_5":14582,"_27821":58456,"_3006":59020},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3550":2906,"_30605":2684,"_21201":59022,"_5":14582,"_27821":58456,"_3006":59023},[],"Replaces `crl_options`.",{"_3550":2907,"_30605":2684,"_21201":59025,"_5":14582,"_27821":58456,"_3006":59026},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3550":2908,"_30605":2684,"_21201":59028,"_5":14582,"_27821":58456,"_3006":59029},[],"Removes the archived settings of a CA.",{"_3550":2909,"_30605":2684,"_21201":59031,"_5":14582,"_27821":58456,"_3006":59032},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3550":2910,"_30605":2684,"_21201":59034,"_5":14582,"_27821":58456,"_3006":59035},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3550":2911,"_30605":2684,"_21201":59037,"_5":14582,"_27821":58456,"_3006":59038},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3550":2912,"_30605":2684,"_21201":59040,"_5":14582,"_27821":58456,"_3006":59041},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3550":2913,"_30605":2684,"_21201":59043,"_5":14582,"_27821":58456,"_3006":59044},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3550":2914,"_30605":2684,"_21201":59046,"_5":14582,"_27821":58456,"_3006":59047},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3550":2915,"_30605":2684,"_21201":59049,"_5":14582,"_27821":58456,"_3006":59050},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3550":2916,"_30605":2684,"_21201":59052,"_5":14582,"_27821":58456,"_3006":59053},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3550":2917,"_30605":2684,"_21201":59055,"_5":14582,"_27821":58456,"_3006":59056},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3550":2918,"_30605":2684,"_21201":59058,"_5":14582,"_27821":58456,"_3006":59059},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3550":2919,"_30605":2684,"_21201":59061,"_5":14582,"_27821":58456,"_3006":59062},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3550":2920,"_30605":2684,"_21201":59064,"_5":14582,"_27821":58460,"_3006":59065},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3550":2921,"_30605":2684,"_21201":59067,"_5":14582,"_27821":58464,"_3006":59068},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3550":2922,"_30605":2684,"_21201":59070,"_5":14582,"_27821":58468,"_3006":59071},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3550":2923,"_30605":2684,"_21201":59073,"_5":14582,"_27821":58472,"_3006":59074},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3550":2924,"_30605":2684,"_21201":59076,"_5":14582,"_27821":58476,"_3006":59077},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3550":2925,"_30605":2684,"_21201":59079,"_5":14582,"_27821":58476,"_3006":59080},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3550":2926,"_30605":2684,"_21201":59082,"_5":14582,"_27821":58476,"_3006":59083},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3550":2927,"_30605":2684,"_21201":59085,"_5":14582,"_27821":58476,"_3006":59086},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3550":2928,"_30605":2684,"_21201":59088,"_5":14582,"_27821":58476,"_3006":59089},[],"Record the names of your local-storage PVCs:",{"_3550":2929,"_30605":2684,"_21201":59091,"_5":14582,"_27821":58476,"_3006":59092},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3550":2930,"_30605":2684,"_21201":59094,"_5":14582,"_27821":58480,"_3006":59095},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3550":2931,"_30605":2684,"_21201":59097,"_5":14582,"_27821":58480,"_3006":59098},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3550":2932,"_30605":2684,"_21201":59100,"_5":14582,"_27821":58480,"_3006":59101},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3550":2933,"_30605":2684,"_21201":59103,"_5":14582,"_27821":58480,"_3006":59104},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3550":2934,"_30605":2684,"_21201":59106,"_5":14582,"_27821":58480,"_3006":59107},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3550":2935,"_30605":2684,"_21201":59109,"_5":14582,"_27821":58484,"_3006":59110},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3550":2936,"_30605":2684,"_21201":59112,"_5":14582,"_27821":58484,"_3006":59113},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3550":2937,"_30605":2684,"_21201":59115,"_5":14582,"_27821":58484,"_3006":59116},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3550":2938,"_30605":2684,"_21201":59118,"_5":14582,"_27821":58484,"_3006":59119},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3550":2939,"_30605":2684,"_21201":59121,"_5":14582,"_27821":58484,"_3006":59122},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3550":2940,"_30605":2684,"_21201":59124,"_5":14582,"_27821":58484,"_3006":59125},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3550":2941,"_30605":2684,"_21201":59127,"_5":14582,"_27821":58484,"_3006":59128},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3550":2942,"_30605":2684,"_21201":59130,"_5":14582,"_27821":58484,"_3006":59131},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3550":2943,"_30605":2684,"_21201":59133,"_5":14582,"_27821":58484,"_3006":59134},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3550":2944,"_30605":2684,"_21201":59136,"_5":14582,"_27821":58484,"_3006":59137},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3550":2945,"_30605":2684,"_21201":59139,"_5":14582,"_27821":58484,"_3006":59140},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3550":2946,"_30605":2684,"_21201":59142,"_5":14582,"_27821":58484,"_3006":59143},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3550":2947,"_30605":2684,"_21201":59145,"_5":14582,"_27821":58488,"_3006":59146},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3550":2948,"_30605":2684,"_21201":59148,"_5":14582,"_27821":58488,"_3006":59149},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3550":2949,"_30605":2684,"_21201":59151,"_5":14582,"_27821":58492,"_3006":59152},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3550":2950,"_30605":2684,"_21201":59154,"_5":14582,"_27821":58492,"_3006":59155},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3550":2951,"_30605":2684,"_21201":59157,"_5":14582,"_27821":58492,"_3006":59158},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3550":2952,"_30605":2684,"_21201":59160,"_5":14582,"_27821":58492,"_3006":59161},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3550":2953,"_30605":2684,"_21201":59163,"_5":14582,"_27821":58492,"_3006":59164},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3550":2954,"_30605":2684,"_21201":59166,"_5":14582,"_27821":58492,"_3006":59167},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3550":2955,"_30605":2684,"_21201":59169,"_5":14582,"_27821":58492,"_3006":59170},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3550":2956,"_30605":2684,"_21201":59172,"_5":14582,"_27821":58492,"_3006":59173},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3550":2957,"_30605":2684,"_21201":59175,"_5":14582,"_27821":58492,"_3006":59176},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3550":2958,"_30605":2684,"_21201":59178,"_5":14582,"_27821":58492,"_3006":59179},[],"**Remove the helper and restore the recorded replica counts:**",{"_3550":2959,"_30605":2684,"_21201":59181,"_5":14582,"_27821":58492,"_3006":59182},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3550":2960,"_30605":2684,"_21201":59184,"_5":14582,"_27821":58496,"_3006":59185},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3550":2961,"_30605":2684,"_21201":59187,"_5":14582,"_27821":58496,"_3006":59188},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3550":2962,"_30605":2684,"_21201":59190,"_5":14582,"_27821":58500,"_3006":59191},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3550":2963,"_30605":2684,"_21201":59193,"_5":14582,"_27821":58500,"_3006":59194},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3550":2964,"_30605":2684,"_21201":59196,"_5":14582,"_27821":58500,"_3006":59197},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3550":2965,"_30605":2684,"_21201":59199,"_5":14582,"_27821":58500,"_3006":59200},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3550":2966,"_30605":2684,"_21201":59202,"_5":14582,"_27821":58500,"_3006":59203},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3550":2967,"_30605":2684,"_21201":59205,"_5":14582,"_27821":58500,"_3006":59206},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3550":2968,"_30605":2684,"_21201":59208,"_5":14582,"_27821":58500,"_3006":59209},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3550":2969,"_30605":2684,"_21201":59211,"_5":14582,"_27821":58500,"_3006":59212},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3550":2970,"_30605":2684,"_21201":59214,"_5":14582,"_27821":58504,"_3006":59215},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3550":2971,"_30605":2684,"_21201":59217,"_5":14582,"_27821":58504,"_3006":59218},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3550":2972,"_30605":2684,"_21201":59220,"_5":14582,"_27821":58504,"_3006":59221},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3550":2973,"_30605":2684,"_21201":59223,"_5":14582,"_27821":58504,"_3006":59224},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3550":2974,"_30605":2684,"_21201":59226,"_5":14582,"_27821":58504,"_3006":59227},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3550":2975,"_30605":2684,"_21201":59229,"_5":14582,"_27821":58504,"_3006":59230},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3550":2976,"_30605":2684,"_21201":59232,"_5":14582,"_27821":58504,"_3006":59233},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3550":2977,"_30605":2684,"_21201":59235,"_5":14582,"_27821":58504,"_3006":59236},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3550":2978,"_30605":2684,"_21201":59238,"_5":14582,"_27821":58504,"_3006":59239},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3550":2979,"_30605":2684,"_21201":59241,"_5":14582,"_27821":58504,"_3006":59242},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3550":2980,"_30605":2684,"_21201":59244,"_5":14582,"_27821":58504,"_3006":59245},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3550":2981,"_30605":2684,"_21201":59247,"_5":14582,"_27821":58507,"_3006":59248},[],"After the upgrade, check in this order:",{"_3550":2982,"_30605":2684,"_21201":59250,"_5":14582,"_27821":58507,"_3006":59251},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3550":2983,"_30605":2684,"_21201":59253,"_5":14582,"_27821":58507,"_3006":59254},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3550":2984,"_30605":2684,"_21201":59256,"_5":14582,"_27821":58507,"_3006":59257},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3550":2985,"_30605":2684,"_21201":59259,"_5":14582,"_27821":58507,"_3006":59260},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3550":2986,"_30605":2684,"_21201":59262,"_5":14582,"_27821":58507,"_3006":59263},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3550":2987,"_30605":2684,"_21201":59265,"_5":14582,"_27821":58507,"_3006":59266},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3550":2988,"_30605":2684,"_21201":59268,"_5":14582,"_27821":58507,"_3006":59269},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3550":2989,"_30605":2684,"_21201":59271,"_5":14582,"_27821":58507,"_3006":59272},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3550":2990,"_30605":2684,"_21201":59274,"_5":14582,"_27821":58507,"_3006":59275},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3550":2991,"_30605":2684,"_21201":59277,"_5":14582,"_27821":58507,"_3006":59278},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3550":2992,"_30605":2684,"_21201":59280,"_5":14582,"_27821":58507,"_3006":59281},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3550":2993,"_30605":2684,"_21201":59283,"_5":14582,"_27821":58507,"_3006":59284},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3550":2994,"_30605":2684,"_21201":59286,"_5":14582,"_27821":58507,"_3006":59287},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3550":2995,"_30605":2684,"_21201":59289,"_5":14582,"_27821":58507,"_3006":59290},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3550":2996,"_30605":2684,"_21201":59292,"_5":14582,"_27821":58507,"_3006":59293},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3550":2997,"_30605":2684,"_21201":59295,"_5":14582,"_27821":58511,"_3006":59296},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3550":2998,"_30605":2684,"_21201":59298,"_5":14582,"_27821":58511,"_3006":59299},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3550":2999,"_30605":2684,"_21201":59301,"_5":14582,"_27821":58511,"_3006":59302},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3550":3000,"_30605":2684,"_21201":59304,"_5":14582,"_27821":58511,"_3006":59305},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3550":3001,"_30605":2684,"_21201":59307,"_5":14582,"_27821":58511,"_3006":59308},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_59311":59312,"_59313":59314,"_59315":59316,"_59317":59318,"_18377":3041,"_71280":3041},"language","english","sortableProperties",[3006,30605,5,27821],"sortablePropertiesWithTypes",{"_3006":25326,"_30605":25326,"_5":25326,"_27821":25326},"sorts",{"_3006":59319,"_30605":62310,"_5":65300,"_27821":68290},{"_4739":59320,"_59321":59322,"_5":25326},{"_14658":5219,"_15033":14514,"_15052":14080,"_29608":3376,"_15039":4457,"_20119":4074,"_14679":11155,"_14686":7744,"_29550":7625,"_29959":7636,"_29980":5136,"_29584":4577,"_34988":5041,"_29687":7652,"_30024":5031,"_34995":4882,"_34998":9028,"_35001":7786,"_35004":4075,"_30431":6183,"_35009":3175,"_35011":19439,"_30461":6305,"_15048":3294,"_35015":23892,"_35018":3262,"_35020":6319,"_30008":17484,"_30426":7775,"_30474":5083,"_35025":6192,"_35027":5253,"_35029":7111,"_29704":3106,"_35032":10668,"_35034":4689,"_35036":7181,"_35038":3731,"_35040":3220,"_29621":4446,"_35043":7793,"_35045":3400,"_29615":3417,"_30045":7971,"_35049":7329,"_35051":6662,"_35054":6493,"_29661":7102,"_35058":6414,"_29541":19468,"_35061":14515,"_29589":6345,"_35064":5402,"_35066":3407,"_35069":16929,"_15042":14129,"_35072":29826,"_35074":11317,"_35077":7108,"_35079":3319,"_35081":15091,"_35083":7790,"_35085":3743,"_20122":12659,"_35088":7440,"_30670":6058,"_29562":7629,"_30002":5313,"_35093":13479,"_35095":3257,"_35097":3329,"_30491":6680,"_35100":3714,"_35102":4686,"_35104":4910,"_30585":12231,"_30061":7185,"_35108":3130,"_35110":5845,"_29599":3102,"_35113":7563,"_35115":5944,"_35117":11776,"_30507":3299,"_29681":3602,"_29066":7166,"_35122":8719,"_35124":7714,"_35126":4462,"_29730":7089,"_35130":5231,"_29996":15988,"_35134":3340,"_35136":4402,"_35138":5777,"_35140":14626,"_35142":7731,"_35144":10444,"_29719":4270,"_29964":13245,"_35148":3814,"_35150":4157,"_35152":7088,"_35155":3461,"_35157":8574,"_35159":6714,"_35161":18253,"_35163":8895,"_35165":3189,"_35167":25946,"_35170":7190,"_35172":15989,"_35174":15990,"_35176":4479,"_35178":5679,"_35181":7704,"_3518