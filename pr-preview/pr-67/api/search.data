ements",{"_3475":19,"_30471":15,"_5":30820,"_21105":49611,"_27705":49612,"_2959":49613},[],"/docs/pr-preview/pr-67/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3475":20,"_30471":15,"_5":30820,"_21105":49615,"_27705":49616,"_2959":49617},[],"/docs/pr-preview/pr-67/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3475":21,"_30471":15,"_5":30820,"_21105":49619,"_27705":49620,"_2959":49621},[],"/docs/pr-preview/pr-67/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3475":22,"_30471":15,"_5":30820,"_21105":49623,"_27705":49624,"_2959":49625},[],"/docs/pr-preview/pr-67/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3475":23,"_30471":15,"_5":30820,"_21105":49627,"_27705":49628,"_2959":49629},[],"/docs/pr-preview/pr-67/deployment/aws-marketplace#next-step","Next step",{"_3475":24,"_30471":15,"_21105":49631,"_5":14473,"_27705":15,"_2959":49632},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3475":25,"_30471":15,"_21105":49634,"_5":14473,"_27705":49604,"_2959":49635},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3475":26,"_30471":15,"_21105":49637,"_5":14473,"_27705":49604,"_2959":49638},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3475":27,"_30471":15,"_21105":49640,"_5":14473,"_27705":49604,"_2959":49641},[],"A security group allowing the necessary endpoints.",{"_3475":28,"_30471":15,"_21105":49643,"_5":14473,"_27705":49608,"_2959":49644},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3475":29,"_30471":15,"_21105":49646,"_5":14473,"_27705":49608,"_2959":49647},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3475":30,"_30471":15,"_21105":49649,"_5":14473,"_27705":49608,"_2959":49650},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3475":31,"_30471":15,"_21105":49652,"_5":14473,"_27705":49612,"_2959":49653},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3475":32,"_30471":15,"_21105":49655,"_5":14473,"_27705":49616,"_2959":49656},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3475":33,"_30471":15,"_21105":49658,"_5":14473,"_27705":49620,"_2959":49659},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3475":34,"_30471":15,"_21105":49661,"_5":14473,"_27705":49624,"_2959":49662},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3475":35,"_30471":15,"_21105":49664,"_5":14473,"_27705":49628,"_2959":49665},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3475":36,"_30471":36,"_5":14825,"_2959":49667,"_30823":49668,"_21105":49669,"_27705":36},"Deploy Lamassu",[49595,49596],[],{"_3475":37,"_30471":36,"_21105":49671,"_5":14473,"_27705":36,"_2959":49672},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3475":38,"_30471":36,"_5":30820,"_21105":49674,"_27705":49675,"_2959":49676},[],"/docs/pr-preview/pr-67/deployment/overview#choose-a-model","Choose a model",{"_3475":39,"_30471":36,"_5":30820,"_21105":49678,"_27705":49679,"_2959":49680},[],"/docs/pr-preview/pr-67/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3475":40,"_30471":36,"_5":30820,"_21105":49682,"_27705":49683,"_2959":49684},[],"/docs/pr-preview/pr-67/deployment/overview#after-deployment","After deployment",{"_3475":41,"_30471":36,"_21105":49686,"_5":14473,"_27705":36,"_2959":49687},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3475":42,"_30471":36,"_21105":49689,"_5":14473,"_27705":49675,"_2959":49690},[],"Model",{"_3475":43,"_30471":36,"_21105":49692,"_5":14473,"_27705":49675,"_2959":49693},[],"Recommended for",{"_3475":44,"_30471":36,"_21105":49695,"_5":14473,"_27705":49675,"_2959":49696},[],"Who operates the infrastructure",{"_3475":45,"_30471":36,"_21105":49698,"_5":14473,"_27705":49675,"_2959":49699},[],"Starting point",{"_3475":46,"_30471":36,"_21105":49701,"_5":14473,"_27705":49675,"_2959":49702},[],"Kubernetes self-managed",{"_3475":47,"_30471":36,"_21105":49704,"_5":14473,"_27705":49675,"_2959":49705},[],"Production, regulated environments and custom deployments",{"_3475":48,"_30471":36,"_21105":49707,"_5":14473,"_27705":49675,"_2959":49708},[],"Your team",{"_3475":49,"_30471":36,"_21105":49710,"_5":14473,"_27705":49675,"_2959":49711},[],"Helm or Fastlane",{"_3475":50,"_30471":36,"_21105":49713,"_5":14473,"_27705":49675,"_2959":49714},[],"AWS Marketplace",{"_3475":51,"_30471":36,"_21105":49716,"_5":14473,"_27705":49675,"_2959":49717},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3475":52,"_30471":36,"_21105":49719,"_5":14473,"_27705":49675,"_2959":49708},[],{"_3475":53,"_30471":36,"_21105":49721,"_5":14473,"_27705":49675,"_2959":49722},[],"Preconfigured image on EC2",{"_3475":54,"_30471":36,"_21105":49724,"_5":14473,"_27705":49675,"_2959":49725},[],"SaaS",{"_3475":55,"_30471":36,"_21105":49727,"_5":14473,"_27705":49675,"_2959":49728},[],"Teams that want to use the platform without operating it",{"_3475":56,"_30471":36,"_21105":49730,"_5":14473,"_27705":49675,"_2959":49731},[],"Lamassu",{"_3475":57,"_30471":36,"_21105":49733,"_5":14473,"_27705":49675,"_2959":49734},[],"Managed subscription",{"_3475":58,"_30471":36,"_21105":49736,"_5":14473,"_27705":49675,"_2959":49737},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3475":59,"_30471":36,"_21105":49739,"_5":14473,"_27705":49675,"_2959":49740},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3475":60,"_30471":36,"_21105":49742,"_5":14473,"_27705":49675,"_2959":49743},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3475":61,"_30471":36,"_21105":49745,"_5":14473,"_27705":49679,"_2959":49746},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3475":62,"_30471":36,"_21105":49748,"_5":14473,"_27705":49683,"_2959":49749},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3475":63,"_30471":63,"_5":14825,"_2959":49751,"_30823":49752,"_21105":49753,"_27705":63},"Use Lamassu as SaaS",[49595,49596,49597],[],{"_3475":64,"_30471":63,"_21105":49755,"_5":14473,"_27705":63,"_2959":49756},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3475":65,"_30471":63,"_5":30820,"_21105":49758,"_27705":49759,"_2959":49760},[],"/docs/pr-preview/pr-67/deployment/saas#what-the-service-manages","What the service manages",{"_3475":66,"_30471":63,"_5":30820,"_21105":49762,"_27705":49763,"_2959":49764},[],"/docs/pr-preview/pr-67/deployment/saas#plans","Plans",{"_3475":67,"_30471":63,"_5":30820,"_21105":49766,"_27705":49767,"_2959":49768},[],"/docs/pr-preview/pr-67/deployment/saas#request-access","Request access",{"_3475":68,"_30471":63,"_21105":49770,"_5":14473,"_27705":63,"_2959":49771},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3475":69,"_30471":63,"_21105":49773,"_5":14473,"_27705":49759,"_2959":49774},[],"Platform availability and maintenance.",{"_3475":70,"_30471":63,"_21105":49776,"_5":14473,"_27705":49759,"_2959":49777},[],"Automatic backups.",{"_3475":71,"_30471":63,"_21105":49779,"_5":14473,"_27705":49759,"_2959":49780},[],"Version upgrades.",{"_3475":72,"_30471":63,"_21105":49782,"_5":14473,"_27705":49759,"_2959":49783},[],"Technical support and SLA according to your plan.",{"_3475":73,"_30471":63,"_21105":49785,"_5":14473,"_27705":49763,"_2959":49786},[],"Plan",{"_3475":74,"_30471":63,"_21105":49788,"_5":14473,"_27705":49763,"_2959":49789},[],"Devices",{"_3475":75,"_30471":63,"_21105":49791,"_5":14473,"_27705":49763,"_2959":49792},[],"Support",{"_3475":76,"_30471":63,"_21105":49794,"_5":14473,"_27705":49763,"_2959":49795},[],"SLA",{"_3475":77,"_30471":63,"_21105":49797,"_5":14473,"_27705":49763,"_2959":49798},[],"Starter",{"_3475":78,"_30471":63,"_21105":49800,"_5":14473,"_27705":49763,"_2959":49801},[],"Up to 1,000",{"_3475":79,"_30471":63,"_21105":49803,"_5":14473,"_27705":49763,"_2959":49804},[],"Email",{"_3475":80,"_30471":63,"_21105":49806,"_5":14473,"_27705":49763,"_2959":49807},[],"99.5 %",{"_3475":81,"_30471":63,"_21105":49809,"_5":14473,"_27705":49763,"_2959":49810},[],"Professional",{"_3475":82,"_30471":63,"_21105":49812,"_5":14473,"_27705":49763,"_2959":49813},[],"Up to 10,000",{"_3475":83,"_30471":63,"_21105":49815,"_5":14473,"_27705":49763,"_2959":49816},[],"Email and chat",{"_3475":84,"_30471":63,"_21105":49818,"_5":14473,"_27705":49763,"_2959":49819},[],"99.9 %",{"_3475":85,"_30471":63,"_21105":49821,"_5":14473,"_27705":49763,"_2959":49822},[],"Enterprise",{"_3475":86,"_30471":63,"_21105":49824,"_5":14473,"_27705":49763,"_2959":49825},[],"Unlimited",{"_3475":87,"_30471":63,"_21105":49827,"_5":14473,"_27705":49763,"_2959":49828},[],"Dedicated",{"_3475":88,"_30471":63,"_21105":49830,"_5":14473,"_27705":49763,"_2959":49831},[],"99.99 %",{"_3475":89,"_30471":63,"_21105":49833,"_5":14473,"_27705":49767,"_2959":49834},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3475":90,"_30471":63,"_21105":49836,"_5":14473,"_27705":49767,"_2959":49837},[],"When you receive your instance's credentials, continue with Get started.",{"_3475":91,"_30471":91,"_5":14825,"_2959":49839,"_30823":49840,"_21105":49841,"_27705":91},"Fastlane",[49595,49596,49702],[],{"_3475":92,"_30471":91,"_21105":49843,"_5":14473,"_27705":91,"_2959":49844},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3475":93,"_30471":91,"_5":30820,"_21105":49846,"_27705":49847,"_2959":49848},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3475":94,"_30471":91,"_5":30820,"_21105":49850,"_27705":49851,"_2959":49852},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3475":95,"_30471":91,"_5":30820,"_21105":49854,"_27705":49855,"_2959":49605},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#before-you-begin",{"_3475":96,"_30471":91,"_5":30820,"_21105":49857,"_27705":49858,"_2959":49859},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3475":97,"_30471":91,"_5":30820,"_21105":49861,"_27705":49862,"_2959":49863},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3475":98,"_30471":91,"_5":30820,"_21105":49865,"_27705":49866,"_2959":49867},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3475":99,"_30471":91,"_5":30820,"_21105":49869,"_27705":49870,"_2959":49871},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3475":100,"_30471":91,"_5":30820,"_21105":49873,"_27705":49874,"_2959":49875},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3475":101,"_30471":91,"_5":30820,"_21105":49877,"_27705":49878,"_2959":49879},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3475":102,"_30471":91,"_5":30820,"_21105":49881,"_27705":49882,"_2959":49883},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3475":103,"_30471":91,"_5":30820,"_21105":49885,"_27705":49886,"_2959":49887},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3475":104,"_30471":91,"_21105":49889,"_5":14473,"_27705":49847,"_2959":49890},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3475":105,"_30471":91,"_21105":49892,"_5":14473,"_27705":49847,"_2959":49893},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3475":106,"_30471":91,"_21105":49895,"_5":14473,"_27705":49851,"_2959":49896},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3475":107,"_30471":91,"_21105":49898,"_5":14473,"_27705":49851,"_2959":49899},[],"Fastlane installs or configures",{"_3475":108,"_30471":91,"_21105":49901,"_5":14473,"_27705":49851,"_2959":49902},[],"You still provide",{"_3475":109,"_30471":91,"_21105":49904,"_5":14473,"_27705":49851,"_2959":49905},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3475":110,"_30471":91,"_21105":49907,"_5":14473,"_27705":49851,"_2959":49908},[],"The Kubernetes cluster, nodes and persistent storage",{"_3475":111,"_30471":91,"_21105":49910,"_5":14473,"_27705":49851,"_2959":49911},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3475":112,"_30471":91,"_21105":49913,"_5":14473,"_27705":49851,"_2959":49914},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3475":113,"_30471":91,"_21105":49916,"_5":14473,"_27705":49851,"_2959":49917},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3475":114,"_30471":91,"_21105":49919,"_5":14473,"_27705":49851,"_2959":49920},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3475":115,"_30471":91,"_21105":49922,"_5":14473,"_27705":49851,"_2959":49923},[],"Optional observability and lab HSM components",{"_3475":116,"_30471":91,"_21105":49925,"_5":14473,"_27705":49851,"_2959":49926},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3475":117,"_30471":91,"_21105":49928,"_5":14473,"_27705":49851,"_2959":49929},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3475":118,"_30471":91,"_21105":49931,"_5":14473,"_27705":49855,"_2959":49932},[],"You need:",{"_3475":119,"_30471":91,"_21105":49934,"_5":14473,"_27705":49855,"_2959":49935},[],"an existing Kubernetes cluster",{"_3475":120,"_30471":91,"_21105":49937,"_5":14473,"_27705":49855,"_2959":49938},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3475":121,"_30471":91,"_21105":49940,"_5":14473,"_27705":49855,"_2959":49941},[],"`yq`",{"_3475":122,"_30471":91,"_21105":49943,"_5":14473,"_27705":49855,"_2959":23867},[],{"_3475":123,"_30471":91,"_21105":49945,"_5":14473,"_27705":49855,"_2959":49946},[],"`jq` only when using `--sample-data` or `--development`",{"_3475":124,"_30471":91,"_21105":49948,"_5":14473,"_27705":49855,"_2959":49949},[],"`ssh-keygen` only when using `--with-hsm`",{"_3475":125,"_30471":91,"_21105":49951,"_5":14473,"_27705":49855,"_2959":49952},[],"free external ports 80 and 443 on a single-node K3s host",{"_3475":126,"_30471":91,"_21105":49954,"_5":14473,"_27705":49855,"_2959":49955},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3475":127,"_30471":91,"_21105":49957,"_5":14473,"_27705":49855,"_2959":49958},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3475":128,"_30471":91,"_21105":49960,"_5":14473,"_27705":49858,"_2959":49961},[],"Run the script from a clone of the Helm repository:",{"_3475":129,"_30471":91,"_21105":49963,"_5":14473,"_27705":49858,"_2959":49964},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3475":130,"_30471":91,"_21105":49966,"_5":14473,"_27705":49862,"_2959":49967},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3475":131,"_30471":91,"_21105":49969,"_5":14473,"_27705":49862,"_2959":49970},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3475":132,"_30471":91,"_21105":49972,"_5":14473,"_27705":49862,"_2959":49973},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3475":133,"_30471":91,"_21105":49975,"_5":14473,"_27705":49862,"_2959":49976},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3475":134,"_30471":91,"_21105":49978,"_5":14473,"_27705":49866,"_2959":49979},[],"Option",{"_3475":135,"_30471":91,"_21105":49981,"_5":14473,"_27705":49866,"_2959":49982},[],"Default",{"_3475":136,"_30471":91,"_21105":49984,"_5":14473,"_27705":49866,"_2959":49985},[],"Purpose",{"_3475":137,"_30471":91,"_21105":49987,"_5":14473,"_27705":49866,"_2959":49988},[],"`-h`, `--help`",{"_3475":138,"_30471":91,"_21105":49990,"_5":14473,"_27705":49866,"_2959":49991},[],"—",{"_3475":139,"_30471":91,"_21105":49993,"_5":14473,"_27705":49866,"_2959":49994},[],"Show help",{"_3475":140,"_30471":91,"_21105":49996,"_5":14473,"_27705":49866,"_2959":49997},[],"`-c`, `--context`",{"_3475":141,"_30471":91,"_21105":49999,"_5":14473,"_27705":49866,"_2959":50000},[],"current context",{"_3475":142,"_30471":91,"_21105":50002,"_5":14473,"_27705":49866,"_2959":50003},[],"Select the kubeconfig context for kubectl and Helm",{"_3475":143,"_30471":91,"_21105":50005,"_5":14473,"_27705":49866,"_2959":50006},[],"`-n`, `--non-interactive`",{"_3475":144,"_30471":91,"_21105":50008,"_5":14473,"_27705":49866,"_2959":6614},[],{"_3475":145,"_30471":91,"_21105":50010,"_5":14473,"_27705":49866,"_2959":50011},[],"Skip prompts and generate dependency credentials",{"_3475":146,"_30471":91,"_21105":50013,"_5":14473,"_27705":49866,"_2959":50014},[],"`-ns`, `--namespace`",{"_3475":147,"_30471":91,"_21105":50016,"_5":14473,"_27705":49866,"_2959":50017},[],"`lamassu-dev`",{"_3475":148,"_30471":91,"_21105":50019,"_5":14473,"_27705":49866,"_2959":50020},[],"Namespace for the installation",{"_3475":149,"_30471":91,"_21105":50022,"_5":14473,"_27705":49866,"_2959":50023},[],"`-d`, `--domain`",{"_3475":150,"_30471":91,"_21105":50025,"_5":14473,"_27705":49866,"_2959":50026},[],"`dev.lamassu.io`",{"_3475":151,"_30471":91,"_21105":50028,"_5":14473,"_27705":49866,"_2959":50029},[],"Domain used by the UI, OIDC and certificate",{"_3475":152,"_30471":91,"_21105":50031,"_5":14473,"_27705":49866,"_2959":50032},[],"`-v`, `--version`",{"_3475":153,"_30471":91,"_21105":50034,"_5":14473,"_27705":49866,"_2959":15177},[],{"_3475":154,"_30471":91,"_21105":50036,"_5":14473,"_27705":49866,"_2959":50037},[],"Lamassu chart version",{"_3475":155,"_30471":91,"_21105":50039,"_5":14473,"_27705":49866,"_2959":50040},[],"`--https-port`",{"_3475":156,"_30471":91,"_21105":50042,"_5":14473,"_27705":49866,"_2959":50043},[],"`443`",{"_3475":157,"_30471":91,"_21105":50045,"_5":14473,"_27705":49866,"_2959":50046},[],"Gateway HTTPS listener port",{"_3475":158,"_30471":91,"_21105":50048,"_5":14473,"_27705":49866,"_2959":50049},[],"`--http-port`",{"_3475":159,"_30471":91,"_21105":50051,"_5":14473,"_27705":49866,"_2959":50052},[],"`80`",{"_3475":160,"_30471":91,"_21105":50054,"_5":14473,"_27705":49866,"_2959":50055},[],"Gateway HTTP listener port",{"_3475":161,"_30471":91,"_21105":50057,"_5":14473,"_27705":49866,"_2959":50058},[],"`--tls-crt`",{"_3475":162,"_30471":91,"_21105":50060,"_5":14473,"_27705":49866,"_2959":49991},[],{"_3475":163,"_30471":91,"_21105":50062,"_5":14473,"_27705":49866,"_2959":50063},[],"PEM certificate for downstream TLS",{"_3475":164,"_30471":91,"_21105":50065,"_5":14473,"_27705":49866,"_2959":50066},[],"`--tls-key`",{"_3475":165,"_30471":91,"_21105":50068,"_5":14473,"_27705":49866,"_2959":49991},[],{"_3475":166,"_30471":91,"_21105":50070,"_5":14473,"_27705":49866,"_2959":50071},[],"PEM private key for downstream TLS",{"_3475":167,"_30471":91,"_21105":50073,"_5":14473,"_27705":49866,"_2959":50074},[],"`-l`, `--local-chart-path`",{"_3475":168,"_30471":91,"_21105":50076,"_5":14473,"_27705":49866,"_2959":50077},[],"repository chart",{"_3475":169,"_30471":91,"_21105":50079,"_5":14473,"_27705":49866,"_2959":50080},[],"Use an unpacked local Lamassu chart",{"_3475":170,"_30471":91,"_21105":50082,"_5":14473,"_27705":49866,"_2959":50083},[],"`-ip`, `--gateway-ip`",{"_3475":171,"_30471":91,"_21105":50085,"_5":14473,"_27705":49866,"_2959":8815},[],{"_3475":172,"_30471":91,"_21105":50087,"_5":14473,"_27705":49866,"_2959":50088},[],"Override the address written to `gateway.addresses`",{"_3475":173,"_30471":91,"_21105":50090,"_5":14473,"_27705":49866,"_2959":50091},[],"`--otel`",{"_3475":174,"_30471":91,"_21105":50093,"_5":14473,"_27705":49866,"_2959":6614},[],{"_3475":175,"_30471":91,"_21105":50095,"_5":14473,"_27705":49866,"_2959":50096},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3475":176,"_30471":91,"_21105":50098,"_5":14473,"_27705":49866,"_2959":50099},[],"`--development`",{"_3475":177,"_30471":91,"_21105":50101,"_5":14473,"_27705":49866,"_2959":6614},[],{"_3475":178,"_30471":91,"_21105":50103,"_5":14473,"_27705":49866,"_2959":50104},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3475":179,"_30471":91,"_21105":50106,"_5":14473,"_27705":49866,"_2959":50107},[],"`--sample-data`",{"_3475":180,"_30471":91,"_21105":50109,"_5":14473,"_27705":49866,"_2959":6614},[],{"_3475":181,"_30471":91,"_21105":50111,"_5":14473,"_27705":49866,"_2959":50112},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3475":182,"_30471":91,"_21105":50114,"_5":14473,"_27705":49866,"_2959":50115},[],"`--with-hsm`",{"_3475":183,"_30471":91,"_21105":50117,"_5":14473,"_27705":49866,"_2959":6614},[],{"_3475":184,"_30471":91,"_21105":50119,"_5":14473,"_27705":49866,"_2959":50120},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3475":185,"_30471":91,"_21105":50122,"_5":14473,"_27705":49866,"_2959":50123},[],"`--softhsm-chart-path`",{"_3475":186,"_30471":91,"_21105":50125,"_5":14473,"_27705":49866,"_2959":50126},[],"`./charts/softhsm`",{"_3475":187,"_30471":91,"_21105":50128,"_5":14473,"_27705":49866,"_2959":50129},[],"Use a different local SoftHSM chart",{"_3475":188,"_30471":91,"_21105":50131,"_5":14473,"_27705":49866,"_2959":50132},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3475":189,"_30471":91,"_21105":50134,"_5":14473,"_27705":49870,"_2959":50135},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3475":190,"_30471":91,"_21105":50137,"_5":14473,"_27705":49870,"_2959":50138},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3475":191,"_30471":91,"_21105":50140,"_5":14473,"_27705":49870,"_2959":50141},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3475":192,"_30471":91,"_21105":50143,"_5":14473,"_27705":49870,"_2959":50144},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3475":193,"_30471":91,"_21105":50146,"_5":14473,"_27705":49870,"_2959":50147},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3475":194,"_30471":91,"_21105":50149,"_5":14473,"_27705":49870,"_2959":50150},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3475":195,"_30471":91,"_21105":50152,"_5":14473,"_27705":49874,"_2959":50153},[],"Fastlane:",{"_3475":196,"_30471":91,"_21105":50155,"_5":14473,"_27705":49874,"_2959":50156},[],"validates local tools and the selected cluster",{"_3475":197,"_30471":91,"_21105":50158,"_5":14473,"_27705":49874,"_2959":50159},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3475":198,"_30471":91,"_21105":50161,"_5":14473,"_27705":49874,"_2959":50162},[],"creates the namespace",{"_3475":199,"_30471":91,"_21105":50164,"_5":14473,"_27705":49874,"_2959":50165},[],"installs PostgreSQL and creates the required databases",{"_3475":200,"_30471":91,"_21105":50167,"_5":14473,"_27705":49874,"_2959":50168},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3475":201,"_30471":91,"_21105":50170,"_5":14473,"_27705":49874,"_2959":50171},[],"installs RabbitMQ",{"_3475":202,"_30471":91,"_21105":50173,"_5":14473,"_27705":49874,"_2959":50174},[],"optionally installs observability and lab HSM components",{"_3475":203,"_30471":91,"_21105":50176,"_5":14473,"_27705":49874,"_2959":50177},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3475":204,"_30471":91,"_21105":50179,"_5":14473,"_27705":49874,"_2959":50180},[],"optionally loads sample data",{"_3475":205,"_30471":91,"_21105":50182,"_5":14473,"_27705":49874,"_2959":50183},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3475":206,"_30471":91,"_21105":50185,"_5":14473,"_27705":49878,"_2959":50186},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3475":207,"_30471":91,"_21105":50188,"_5":14473,"_27705":49878,"_2959":50189},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3475":208,"_30471":91,"_21105":50191,"_5":14473,"_27705":49882,"_2959":50192},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3475":209,"_30471":91,"_21105":50194,"_5":14473,"_27705":49882,"_2959":50195},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3475":210,"_30471":91,"_21105":50197,"_5":14473,"_27705":49882,"_2959":50198},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3475":211,"_30471":91,"_21105":50200,"_5":14473,"_27705":49886,"_2959":50201},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3475":212,"_30471":212,"_5":14825,"_2959":50203,"_30823":50204,"_21105":50205,"_27705":212},"Install with Helm",[49595,49596,49702],[],{"_3475":213,"_30471":212,"_21105":50207,"_5":14473,"_27705":212,"_2959":50208},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3475":214,"_30471":212,"_5":30820,"_21105":50210,"_27705":50211,"_2959":50212},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3475":215,"_30471":212,"_5":30820,"_21105":50214,"_27705":50215,"_2959":49605},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#before-you-begin",{"_3475":216,"_30471":212,"_5":30820,"_21105":50217,"_27705":50218,"_2959":50219},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3475":217,"_30471":212,"_5":30820,"_21105":50221,"_27705":50222,"_2959":50223},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3475":218,"_30471":212,"_5":30820,"_21105":50225,"_27705":50226,"_2959":50227},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3475":219,"_30471":212,"_5":30820,"_21105":50229,"_27705":50230,"_2959":50231},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3475":220,"_30471":212,"_5":30820,"_21105":50233,"_27705":50234,"_2959":50235},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3475":221,"_30471":212,"_5":30820,"_21105":50237,"_27705":50238,"_2959":50239},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3475":222,"_30471":212,"_5":30820,"_21105":50241,"_27705":50242,"_2959":50243},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3475":223,"_30471":212,"_5":30820,"_21105":50245,"_27705":50246,"_2959":50247},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3475":224,"_30471":212,"_5":30820,"_21105":50249,"_27705":50250,"_2959":50251},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3475":225,"_30471":212,"_21105":50253,"_5":14473,"_27705":50211,"_2959":50254},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3475":226,"_30471":212,"_21105":50256,"_5":14473,"_27705":50215,"_2959":50257},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3475":227,"_30471":212,"_21105":50259,"_5":14473,"_27705":50215,"_2959":50260},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3475":228,"_30471":212,"_21105":50262,"_5":14473,"_27705":50215,"_2959":50263},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3475":229,"_30471":212,"_21105":50265,"_5":14473,"_27705":50215,"_2959":50266},[],"a reachable RabbitMQ broker and credentials",{"_3475":230,"_30471":212,"_21105":50268,"_5":14473,"_27705":50215,"_2959":50269},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3475":231,"_30471":212,"_21105":50271,"_5":14473,"_27705":50215,"_2959":50272},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3475":232,"_30471":212,"_21105":50274,"_5":14473,"_27705":50215,"_2959":50275},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3475":233,"_30471":212,"_21105":50277,"_5":14473,"_27705":50215,"_2959":50278},[],"a StorageClass and an external traffic design",{"_3475":234,"_30471":212,"_21105":50280,"_5":14473,"_27705":50215,"_2959":50281},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3475":235,"_30471":212,"_21105":50283,"_5":14473,"_27705":50215,"_2959":50284},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3475":236,"_30471":212,"_21105":50286,"_5":14473,"_27705":50215,"_2959":50287},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3475":237,"_30471":212,"_21105":50289,"_5":14473,"_27705":50218,"_2959":50290},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3475":238,"_30471":212,"_21105":50292,"_5":14473,"_27705":50218,"_2959":50293},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3475":239,"_30471":212,"_21105":50295,"_5":14473,"_27705":50218,"_2959":50296},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3475":240,"_30471":212,"_21105":50298,"_5":14473,"_27705":50222,"_2959":50299},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3475":241,"_30471":212,"_21105":50301,"_5":14473,"_27705":50222,"_2959":50302},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3475":242,"_30471":212,"_21105":50304,"_5":14473,"_27705":50222,"_2959":50305},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3475":243,"_30471":212,"_21105":50307,"_5":14473,"_27705":50222,"_2959":50308},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3475":244,"_30471":212,"_21105":50310,"_5":14473,"_27705":50226,"_2959":50311},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3475":245,"_30471":212,"_21105":50313,"_5":14473,"_27705":50230,"_2959":50314},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3475":246,"_30471":212,"_21105":50316,"_5":14473,"_27705":50230,"_2959":50317},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3475":247,"_30471":212,"_21105":50319,"_5":14473,"_27705":50230,"_2959":50320},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3475":248,"_30471":212,"_21105":50322,"_5":14473,"_27705":50230,"_2959":50323},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3475":249,"_30471":212,"_21105":50325,"_5":14473,"_27705":50230,"_2959":50326},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3475":250,"_30471":212,"_21105":50328,"_5":14473,"_27705":50230,"_2959":50329},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3475":251,"_30471":212,"_21105":50331,"_5":14473,"_27705":50230,"_2959":50332},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3475":252,"_30471":212,"_21105":50334,"_5":14473,"_27705":50234,"_2959":50335},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3475":253,"_30471":212,"_21105":50337,"_5":14473,"_27705":50234,"_2959":50338},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3475":254,"_30471":212,"_21105":50340,"_5":14473,"_27705":50234,"_2959":50341},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3475":255,"_30471":212,"_21105":50343,"_5":14473,"_27705":50234,"_2959":50344},[],"See Access control for the principal and policy model.",{"_3475":256,"_30471":212,"_21105":50346,"_5":14473,"_27705":50238,"_2959":50347},[],"To install a local checkout instead:",{"_3475":257,"_30471":212,"_21105":50349,"_5":14473,"_27705":50242,"_2959":50350},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3475":258,"_30471":212,"_21105":50352,"_5":14473,"_27705":50242,"_2959":50353},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3475":259,"_30471":212,"_21105":50355,"_5":14473,"_27705":50246,"_2959":50356},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3475":260,"_30471":212,"_21105":50358,"_5":14473,"_27705":50246,"_2959":50359},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3475":261,"_30471":212,"_21105":50361,"_5":14473,"_27705":50246,"_2959":50362},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3475":262,"_30471":212,"_21105":50364,"_5":14473,"_27705":50246,"_2959":50365},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3475":263,"_30471":212,"_21105":50367,"_5":14473,"_27705":50246,"_2959":50368},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3475":264,"_30471":212,"_21105":50370,"_5":14473,"_27705":50250,"_2959":50371},[],"Before going live, review:",{"_3475":265,"_30471":212,"_21105":50373,"_5":14473,"_27705":50250,"_2959":50374},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3475":266,"_30471":212,"_21105":50376,"_5":14473,"_27705":50250,"_2959":50377},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3475":267,"_30471":212,"_21105":50379,"_5":14473,"_27705":50250,"_2959":50380},[],"shared VA storage before increasing VA replicas",{"_3475":268,"_30471":212,"_21105":50382,"_5":14473,"_27705":50250,"_2959":50383},[],"managed OIDC roles and removal of evaluation credentials",{"_3475":269,"_30471":212,"_21105":50385,"_5":14473,"_27705":50250,"_2959":50386},[],"a trusted TLS issuer or externally managed certificate",{"_3475":270,"_30471":212,"_21105":50388,"_5":14473,"_27705":50250,"_2959":50389},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3475":271,"_30471":212,"_21105":50391,"_5":14473,"_27705":50250,"_2959":50392},[],"SMTP, observability and alert delivery",{"_3475":272,"_30471":212,"_21105":50394,"_5":14473,"_27705":50250,"_2959":50395},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3475":273,"_30471":212,"_21105":50397,"_5":14473,"_27705":50250,"_2959":50398},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3475":274,"_30471":274,"_5":14825,"_2959":50400,"_30823":50401,"_21105":50402,"_27705":274},"Expose the Gateway",[49595,49596,49702],[],{"_3475":275,"_30471":274,"_21105":50404,"_5":14473,"_27705":274,"_2959":50405},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3475":276,"_30471":274,"_5":30820,"_21105":50407,"_27705":50408,"_2959":50409},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3475":277,"_30471":274,"_5":30820,"_21105":50411,"_27705":50412,"_2959":50413},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3475":278,"_30471":274,"_5":30820,"_21105":50415,"_27705":50416,"_2959":50417},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3475":279,"_30471":274,"_5":30820,"_21105":50419,"_27705":50420,"_2959":50421},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#k3s","K3s",{"_3475":280,"_30471":274,"_5":30820,"_21105":50423,"_27705":50424,"_2959":50425},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3475":281,"_30471":274,"_5":30820,"_21105":50427,"_27705":50428,"_2959":50429},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3475":282,"_30471":274,"_5":30820,"_21105":50431,"_27705":50432,"_2959":50433},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3475":283,"_30471":274,"_5":30820,"_21105":50435,"_27705":50436,"_2959":50437},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3475":284,"_30471":274,"_5":30820,"_21105":50439,"_27705":50440,"_2959":50441},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3475":285,"_30471":274,"_5":30820,"_21105":50443,"_27705":50444,"_2959":50445},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3475":286,"_30471":274,"_5":30820,"_21105":50447,"_27705":50448,"_2959":50449},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3475":287,"_30471":274,"_21105":50451,"_5":14473,"_27705":50408,"_2959":50452},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3475":288,"_30471":274,"_21105":50454,"_5":14473,"_27705":50408,"_2959":50455},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3475":289,"_30471":274,"_21105":50457,"_5":14473,"_27705":50412,"_2959":50458},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3475":290,"_30471":274,"_21105":50460,"_5":14473,"_27705":50412,"_2959":50461},[],"Set it only when:",{"_3475":291,"_30471":274,"_21105":50463,"_5":14473,"_27705":50412,"_2959":50464},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3475":292,"_30471":274,"_21105":50466,"_5":14473,"_27705":50412,"_2959":50467},[],"that address is allocated to this Gateway",{"_3475":293,"_30471":274,"_21105":50469,"_5":14473,"_27705":50412,"_2959":50470},[],"the surrounding network already routes traffic for it to the cluster",{"_3475":294,"_30471":274,"_21105":50472,"_5":14473,"_27705":50412,"_2959":50473},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3475":295,"_30471":274,"_21105":50475,"_5":14473,"_27705":50412,"_2959":50476},[],"Keep these two settings separate:",{"_3475":296,"_30471":274,"_21105":50478,"_5":14473,"_27705":50412,"_2959":50479},[],"`gateway.addresses` requests an address for the Gateway.",{"_3475":297,"_30471":274,"_21105":50481,"_5":14473,"_27705":50412,"_2959":50482},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3475":298,"_30471":274,"_21105":50484,"_5":14473,"_27705":50412,"_2959":50485},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3475":299,"_30471":274,"_21105":50487,"_5":14473,"_27705":50416,"_2959":50488},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3475":300,"_30471":274,"_21105":50490,"_5":14473,"_27705":50416,"_2959":50491},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3475":301,"_30471":274,"_21105":50493,"_5":14473,"_27705":50420,"_2959":50494},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3475":302,"_30471":274,"_21105":50496,"_5":14473,"_27705":50420,"_2959":50497},[],"For the recommended design:",{"_3475":303,"_30471":274,"_21105":50499,"_5":14473,"_27705":50420,"_2959":50500},[],"Use only one externally exposed Lamassu Gateway.",{"_3475":304,"_30471":274,"_21105":50502,"_5":14473,"_27705":50420,"_2959":50503},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3475":305,"_30471":274,"_21105":50505,"_5":14473,"_27705":50420,"_2959":50506},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3475":306,"_30471":274,"_21105":50508,"_5":14473,"_27705":50420,"_2959":50509},[],"Point DNS at the VM's reachable address.",{"_3475":307,"_30471":274,"_21105":50511,"_5":14473,"_27705":50420,"_2959":50512},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3475":308,"_30471":274,"_21105":50514,"_5":14473,"_27705":50424,"_2959":50515},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3475":309,"_30471":274,"_21105":50517,"_5":14473,"_27705":50428,"_2959":50518},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3475":310,"_30471":274,"_21105":50520,"_5":14473,"_27705":50428,"_2959":50521},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3475":311,"_30471":274,"_21105":50523,"_5":14473,"_27705":50432,"_2959":50524},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3475":312,"_30471":274,"_21105":50526,"_5":14473,"_27705":50432,"_2959":50527},[],"Requirement",{"_3475":313,"_30471":274,"_21105":50529,"_5":14473,"_27705":50432,"_2959":50530},[],"Recommended design",{"_3475":314,"_30471":274,"_21105":50532,"_5":14473,"_27705":50432,"_2959":50533},[],"Consequence",{"_3475":315,"_30471":274,"_21105":50535,"_5":14473,"_27705":50432,"_2959":50536},[],"Several Lamassu URLs or services",{"_3475":316,"_30471":274,"_21105":50538,"_5":14473,"_27705":50432,"_2959":50539},[],"One Gateway with multiple routes",{"_3475":317,"_30471":274,"_21105":50541,"_5":14473,"_27705":50432,"_2959":50542},[],"One IP and one proxy fleet; this is the chart default",{"_3475":318,"_30471":274,"_21105":50544,"_5":14473,"_27705":50432,"_2959":50545},[],"Independent Gateways and separate external IPs",{"_3475":319,"_30471":274,"_21105":50547,"_5":14473,"_27705":50432,"_2959":50548},[],"One VIP per Gateway",{"_3475":320,"_30471":274,"_21105":50550,"_5":14473,"_27705":50432,"_2959":50551},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3475":321,"_30471":274,"_21105":50553,"_5":14473,"_27705":50432,"_2959":50554},[],"Independent Gateways on one node and one IP",{"_3475":322,"_30471":274,"_21105":50556,"_5":14473,"_27705":50432,"_2959":50557},[],"Use different external ports",{"_3475":323,"_30471":274,"_21105":50559,"_5":14473,"_27705":50432,"_2959":50560},[],"Clients must include non-standard ports",{"_3475":324,"_30471":274,"_21105":50562,"_5":14473,"_27705":50432,"_2959":50563},[],"Separate TLS/mTLS termination behind one IP",{"_3475":325,"_30471":274,"_21105":50565,"_5":14473,"_27705":50432,"_2959":50566},[],"Front-door SNI routing to internal Gateways",{"_3475":326,"_30471":274,"_21105":50568,"_5":14473,"_27705":50432,"_2959":50569},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3475":327,"_30471":274,"_21105":50571,"_5":14473,"_27705":50432,"_2959":50572},[],"Separate Gateway resources but shared proxy infrastructure",{"_3475":328,"_30471":274,"_21105":50574,"_5":14473,"_27705":50432,"_2959":50575},[],"Envoy merged-Gateway mode",{"_3475":329,"_30471":274,"_21105":50577,"_5":14473,"_27705":50432,"_2959":50578},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3475":330,"_30471":274,"_21105":50580,"_5":14473,"_27705":50432,"_2959":50581},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3475":331,"_30471":274,"_21105":50583,"_5":14473,"_27705":50432,"_2959":50584},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3475":332,"_30471":274,"_21105":50586,"_5":14473,"_27705":50432,"_2959":50587},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3475":333,"_30471":274,"_21105":50589,"_5":14473,"_27705":50432,"_2959":50590},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3475":334,"_30471":274,"_21105":50592,"_5":14473,"_27705":50436,"_2959":50593},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3475":335,"_30471":274,"_21105":50595,"_5":14473,"_27705":50440,"_2959":50596},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3475":336,"_30471":274,"_21105":50598,"_5":14473,"_27705":50440,"_2959":50599},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3475":337,"_30471":274,"_21105":50601,"_5":14473,"_27705":50440,"_2959":50602},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3475":338,"_30471":274,"_21105":50604,"_5":14473,"_27705":50440,"_2959":50605},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3475":339,"_30471":274,"_21105":50607,"_5":14473,"_27705":50440,"_2959":50608},[],"If none of those are possible, use different external ports or change the external network design.",{"_3475":340,"_30471":274,"_21105":50610,"_5":14473,"_27705":50444,"_2959":50611},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3475":341,"_30471":274,"_21105":50613,"_5":14473,"_27705":50444,"_2959":50614},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3475":342,"_30471":274,"_21105":50616,"_5":14473,"_27705":50448,"_2959":50617},[],"Check, in order:",{"_3475":343,"_30471":274,"_21105":50619,"_5":14473,"_27705":50448,"_2959":50620},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3475":344,"_30471":274,"_21105":50622,"_5":14473,"_27705":50448,"_2959":50623},[],"Its status contains the expected address.",{"_3475":345,"_30471":274,"_21105":50625,"_5":14473,"_27705":50448,"_2959":50626},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3475":346,"_30471":274,"_21105":50628,"_5":14473,"_27705":50448,"_2959":50629},[],"Port 443 reaches that address from the client network.",{"_3475":347,"_30471":274,"_21105":50631,"_5":14473,"_27705":50448,"_2959":50632},[],"DNS resolves to the externally reachable endpoint.",{"_3475":348,"_30471":274,"_21105":50634,"_5":14473,"_27705":50448,"_2959":50635},[],"The certificate contains the DNS name or IP used by the client.",{"_3475":349,"_30471":274,"_21105":50637,"_5":14473,"_27705":50448,"_2959":50638},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3475":350,"_30471":350,"_5":14825,"_2959":49702,"_30823":50640,"_21105":50641,"_27705":350},[49595,49596,49702],[],{"_3475":351,"_30471":350,"_21105":50643,"_5":14473,"_27705":350,"_2959":50644},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3475":352,"_30471":350,"_5":30820,"_21105":50646,"_27705":50647,"_2959":50648},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3475":353,"_30471":350,"_5":30820,"_21105":50650,"_27705":50651,"_2959":50652},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3475":354,"_30471":350,"_5":30820,"_21105":50654,"_27705":50655,"_2959":50656},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3475":355,"_30471":350,"_5":30820,"_21105":50658,"_27705":50659,"_2959":50660},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3475":356,"_30471":350,"_5":30820,"_21105":50662,"_27705":50663,"_2959":50664},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3475":357,"_30471":350,"_5":30820,"_21105":50666,"_27705":50667,"_2959":50668},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3475":358,"_30471":350,"_21105":50670,"_5":14473,"_27705":50647,"_2959":50671},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3475":359,"_30471":350,"_21105":50673,"_5":14473,"_27705":50651,"_2959":50674},[],"Workflow",{"_3475":360,"_30471":350,"_21105":50676,"_5":14473,"_27705":50651,"_2959":50677},[],"Use it for",{"_3475":361,"_30471":350,"_21105":50679,"_5":14473,"_27705":50651,"_2959":50680},[],"What it installs",{"_3475":362,"_30471":350,"_21105":50682,"_5":14473,"_27705":50651,"_2959":50683},[],"Helm",{"_3475":363,"_30471":350,"_21105":50685,"_5":14473,"_27705":50651,"_2959":50686},[],"Production and controlled environments",{"_3475":364,"_30471":350,"_21105":50688,"_5":14473,"_27705":50651,"_2959":50689},[],"Lamassu services and Gateway API resources",{"_3475":365,"_30471":350,"_21105":50691,"_5":14473,"_27705":50651,"_2959":49839},[],{"_3475":366,"_30471":350,"_21105":50693,"_5":14473,"_27705":50651,"_2959":50694},[],"Evaluation, demos, CI and small lab clusters",{"_3475":367,"_30471":350,"_21105":50696,"_5":14473,"_27705":50651,"_2959":50697},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3475":368,"_30471":350,"_21105":50699,"_5":14473,"_27705":50655,"_2959":50700},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3475":369,"_30471":350,"_21105":50702,"_5":14473,"_27705":50655,"_2959":50703},[],"Area",{"_3475":370,"_30471":350,"_21105":50705,"_5":14473,"_27705":50655,"_2959":50706},[],"The Lamassu chart provides",{"_3475":371,"_30471":350,"_21105":50708,"_5":14473,"_27705":50655,"_2959":50709},[],"You provide",{"_3475":372,"_30471":350,"_21105":50711,"_5":14473,"_27705":50655,"_2959":50712},[],"Lamassu applications",{"_3475":373,"_30471":350,"_21105":50714,"_5":14473,"_27705":50655,"_2959":50715},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3475":374,"_30471":350,"_21105":50717,"_5":14473,"_27705":50655,"_2959":50718},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3475":375,"_30471":350,"_21105":50720,"_5":14473,"_27705":50655,"_2959":50721},[],"PostgreSQL data",{"_3475":376,"_30471":350,"_21105":50723,"_5":14473,"_27705":50655,"_2959":50724},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3475":377,"_30471":350,"_21105":50726,"_5":14473,"_27705":50655,"_2959":50727},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3475":378,"_30471":350,"_21105":50729,"_5":14473,"_27705":50655,"_2959":50730},[],"Messaging",{"_3475":379,"_30471":350,"_21105":50732,"_5":14473,"_27705":50655,"_2959":50733},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3475":380,"_30471":350,"_21105":50735,"_5":14473,"_27705":50655,"_2959":50736},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3475":381,"_30471":350,"_21105":50738,"_5":14473,"_27705":50655,"_2959":50739},[],"Identity",{"_3475":382,"_30471":350,"_21105":50741,"_5":14473,"_27705":50655,"_2959":50742},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3475":383,"_30471":350,"_21105":50744,"_5":14473,"_27705":50655,"_2959":50745},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3475":384,"_30471":350,"_21105":50747,"_5":14473,"_27705":50655,"_2959":50748},[],"External routing",{"_3475":385,"_30471":350,"_21105":50750,"_5":14473,"_27705":50655,"_2959":50751},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3475":386,"_30471":350,"_21105":50753,"_5":14473,"_27705":50655,"_2959":50754},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3475":387,"_30471":350,"_21105":50756,"_5":14473,"_27705":50655,"_2959":50757},[],"TLS",{"_3475":388,"_30471":350,"_21105":50759,"_5":14473,"_27705":50655,"_2959":50760},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3475":389,"_30471":350,"_21105":50762,"_5":14473,"_27705":50655,"_2959":50763},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3475":390,"_30471":350,"_21105":50765,"_5":14473,"_27705":50655,"_2959":50766},[],"Persistent application data",{"_3475":391,"_30471":350,"_21105":50768,"_5":14473,"_27705":50655,"_2959":50769},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3475":392,"_30471":350,"_21105":50771,"_5":14473,"_27705":50655,"_2959":50772},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3475":393,"_30471":350,"_21105":50774,"_5":14473,"_27705":50655,"_2959":50775},[],"Optional integrations",{"_3475":394,"_30471":350,"_21105":50777,"_5":14473,"_27705":50655,"_2959":50778},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3475":395,"_30471":350,"_21105":50780,"_5":14473,"_27705":50655,"_2959":50781},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3475":396,"_30471":350,"_21105":50783,"_5":14473,"_27705":50655,"_2959":50784},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3475":397,"_30471":350,"_21105":50786,"_5":14473,"_27705":50655,"_2959":50787},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3475":398,"_30471":350,"_21105":50789,"_5":14473,"_27705":50659,"_2959":50790},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3475":399,"_30471":350,"_21105":50792,"_5":14473,"_27705":50659,"_2959":50793},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3475":400,"_30471":350,"_21105":50795,"_5":14473,"_27705":50663,"_2959":50796},[],"Kubernetes 1.24 or newer",{"_3475":401,"_30471":350,"_21105":50798,"_5":14473,"_27705":50663,"_2959":50799},[],"Helm 3.2 or newer",{"_3475":402,"_30471":350,"_21105":50801,"_5":14473,"_27705":50663,"_2959":50802},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3475":403,"_30471":350,"_21105":50804,"_5":14473,"_27705":50663,"_2959":50805},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3475":404,"_30471":350,"_21105":50807,"_5":14473,"_27705":50663,"_2959":50808},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3475":405,"_30471":350,"_21105":50810,"_5":14473,"_27705":50663,"_2959":50811},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3475":406,"_30471":350,"_21105":50813,"_5":14473,"_27705":50663,"_2959":50814},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3475":407,"_30471":350,"_21105":50816,"_5":14473,"_27705":50667,"_2959":50817},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3475":408,"_30471":350,"_21105":50819,"_5":14473,"_27705":50667,"_2959":50820},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3475":409,"_30471":350,"_21105":50822,"_5":14473,"_27705":50667,"_2959":50823},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3475":410,"_30471":350,"_21105":50825,"_5":14473,"_27705":50667,"_2959":50826},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3475":411,"_30471":411,"_5":14825,"_2959":50828,"_30823":50829,"_21105":50831,"_27705":411},"Deployment troubleshooting",[49595,49596,50830],"Operations",[],{"_3475":412,"_30471":411,"_21105":50833,"_5":14473,"_27705":411,"_2959":50834},[],"Diagnose access, service health and infrastructure dependencies.",{"_3475":413,"_30471":411,"_5":30820,"_21105":50836,"_27705":50837,"_2959":50838},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3475":414,"_30471":411,"_5":30820,"_21105":50840,"_27705":50841,"_2959":50842},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3475":415,"_30471":411,"_5":30820,"_21105":50844,"_27705":50845,"_2959":50846},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3475":416,"_30471":411,"_5":30820,"_21105":50848,"_27705":50849,"_2959":50850},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3475":417,"_30471":411,"_5":30820,"_21105":50852,"_27705":50853,"_2959":50854},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3475":418,"_30471":411,"_5":30820,"_21105":50856,"_27705":50857,"_2959":50858},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3475":419,"_30471":411,"_5":30820,"_21105":50860,"_27705":50861,"_2959":50862},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3475":420,"_30471":411,"_5":30820,"_21105":50864,"_27705":50865,"_2959":50866},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3475":421,"_30471":411,"_5":30820,"_21105":50868,"_27705":50869,"_2959":50870},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3475":422,"_30471":411,"_5":30820,"_21105":50872,"_27705":50873,"_2959":50874},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3475":423,"_30471":411,"_5":30820,"_21105":50876,"_27705":50877,"_2959":50878},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3475":424,"_30471":411,"_5":30820,"_21105":50880,"_27705":50881,"_2959":50882},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3475":425,"_30471":411,"_5":30820,"_21105":50884,"_27705":50885,"_2959":50886},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#observability","Observability",{"_3475":426,"_30471":411,"_21105":50888,"_5":14473,"_27705":411,"_2959":50889},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3475":427,"_30471":411,"_21105":50891,"_5":14473,"_27705":50841,"_2959":50892},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3475":428,"_30471":411,"_21105":50894,"_5":14473,"_27705":50845,"_2959":50895},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3475":429,"_30471":411,"_21105":50897,"_5":14473,"_27705":50849,"_2959":50898},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3475":430,"_30471":411,"_21105":50900,"_5":14473,"_27705":50853,"_2959":50901},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3475":431,"_30471":411,"_21105":50903,"_5":14473,"_27705":50857,"_2959":50904},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3475":432,"_30471":411,"_21105":50906,"_5":14473,"_27705":50861,"_2959":50907},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3475":433,"_30471":411,"_21105":50909,"_5":14473,"_27705":50861,"_2959":50910},[],"Also run the chart's connectivity test:",{"_3475":434,"_30471":411,"_21105":50912,"_5":14473,"_27705":50861,"_2959":50913},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3475":435,"_30471":411,"_21105":50915,"_5":14473,"_27705":50861,"_2959":50916},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3475":436,"_30471":411,"_21105":50918,"_5":14473,"_27705":50865,"_2959":50919},[],"If you receive a 401:",{"_3475":437,"_30471":411,"_21105":50921,"_5":14473,"_27705":50865,"_2959":50922},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3475":438,"_30471":411,"_21105":50924,"_5":14473,"_27705":50865,"_2959":50925},[],"verify issuer, audience and expiration of the token;",{"_3475":439,"_30471":411,"_21105":50927,"_5":14473,"_27705":50865,"_2959":50928},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3475":440,"_30471":411,"_21105":50930,"_5":14473,"_27705":50865,"_2959":50931},[],"check that the provider's public and internal routes point to the same realm.",{"_3475":441,"_30471":411,"_21105":50933,"_5":14473,"_27705":50865,"_2959":50934},[],"If login succeeds but the APIs return 403:",{"_3475":442,"_30471":411,"_21105":50936,"_5":14473,"_27705":50865,"_2959":50937},[],"inspect the token's real claims;",{"_3475":443,"_30471":411,"_21105":50939,"_5":14473,"_27705":50865,"_2959":50940},[],"confirm they match an active principal;",{"_3475":444,"_30471":411,"_21105":50942,"_5":14473,"_27705":50865,"_2959":50943},[],"review the policies granted to that principal;",{"_3475":445,"_30471":411,"_21105":50945,"_5":14473,"_27705":50865,"_2959":50946},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3475":446,"_30471":411,"_21105":50948,"_5":14473,"_27705":50865,"_2959":50949},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3475":447,"_30471":411,"_21105":50951,"_5":14473,"_27705":50869,"_2959":50952},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3475":448,"_30471":411,"_21105":50954,"_5":14473,"_27705":50869,"_2959":50955},[],"Locate the authz pod and Service.",{"_3475":449,"_30471":411,"_21105":50957,"_5":14473,"_27705":50869,"_2959":50958},[],"Check /health, logs and its database connection.",{"_3475":450,"_30471":411,"_21105":50960,"_5":14473,"_27705":50869,"_2959":50961},[],"Verify the DNS and port configured in externalAuthorization.",{"_3475":451,"_30471":411,"_21105":50963,"_5":14473,"_27705":50869,"_2959":50964},[],"Check the check route is /v1/ext\\_authz/check.",{"_3475":452,"_30471":411,"_21105":50966,"_5":14473,"_27705":50869,"_2959":50967},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3475":453,"_30471":411,"_21105":50969,"_5":14473,"_27705":50873,"_2959":50970},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3475":454,"_30471":411,"_21105":50972,"_5":14473,"_27705":50877,"_2959":50973},[],"Review kubectl describe pod first. Common causes are:",{"_3475":455,"_30471":411,"_21105":50975,"_5":14473,"_27705":50877,"_2959":50976},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3475":456,"_30471":411,"_21105":50978,"_5":14473,"_27705":50877,"_2959":50979},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3475":457,"_30471":411,"_21105":50981,"_5":14473,"_27705":50877,"_2959":50982},[],"unbound persistent volume;",{"_3475":458,"_30471":411,"_21105":50984,"_5":14473,"_27705":50877,"_2959":50985},[],"inaccessible image or incorrect pull policy;",{"_3475":459,"_30471":411,"_21105":50987,"_5":14473,"_27705":50877,"_2959":50988},[],"invalid cryptographic engine configuration;",{"_3475":460,"_30471":411,"_21105":50990,"_5":14473,"_27705":50877,"_2959":50991},[],"CPU or memory limits set too low;",{"_3475":461,"_30471":411,"_21105":50993,"_5":14473,"_27705":50877,"_2959":50994},[],"an incomplete prior migration.",{"_3475":462,"_30471":411,"_21105":50996,"_5":14473,"_27705":50877,"_2959":50997},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3475":463,"_30471":411,"_21105":50999,"_5":14473,"_27705":50877,"_2959":51000},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3475":464,"_30471":411,"_21105":51002,"_5":14473,"_27705":50877,"_2959":51003},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3475":465,"_30471":411,"_21105":51005,"_5":14473,"_27705":50881,"_2959":51006},[],"Domain and audit events depend on the bus publisher:",{"_3475":466,"_30471":411,"_21105":51008,"_5":14473,"_27705":50881,"_2959":51009},[],"verify it is enabled in the emitting service;",{"_3475":467,"_30471":411,"_21105":51011,"_5":14473,"_27705":50881,"_2959":51012},[],"check AMQP connectivity and credentials;",{"_3475":468,"_30471":411,"_21105":51014,"_5":14473,"_27705":50881,"_2959":51015},[],"review exchange, routing key, queues and consumers;",{"_3475":469,"_30471":411,"_21105":51017,"_5":14473,"_27705":50881,"_2959":51018},[],"inspect dead-letter queues;",{"_3475":470,"_30471":411,"_21105":51020,"_5":14473,"_27705":50881,"_2959":51021},[],"alert on orphan durable queues and backlog growth.",{"_3475":471,"_30471":411,"_21105":51023,"_5":14473,"_27705":50881,"_2959":51024},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3475":472,"_30471":411,"_21105":51026,"_5":14473,"_27705":50881,"_2959":51027},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3475":473,"_30471":411,"_21105":51029,"_5":14473,"_27705":50881,"_2959":51030},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3475":474,"_30471":411,"_21105":51032,"_5":14473,"_27705":50881,"_2959":51033},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3475":475,"_30471":411,"_21105":51035,"_5":14473,"_27705":50881,"_2959":51036},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3475":476,"_30471":411,"_21105":51038,"_5":14473,"_27705":50881,"_2959":51039},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3475":477,"_30471":411,"_21105":51041,"_5":14473,"_27705":50881,"_2959":51042},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3475":478,"_30471":411,"_21105":51044,"_5":14473,"_27705":50885,"_2959":51045},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3475":479,"_30471":411,"_21105":51047,"_5":14473,"_27705":50885,"_2959":51048},[],"Before closing an incident, record:",{"_3475":480,"_30471":411,"_21105":51050,"_5":14473,"_27705":50885,"_2959":51051},[],"the confirmed cause;",{"_3475":481,"_30471":411,"_21105":51053,"_5":14473,"_27705":50885,"_2959":51054},[],"the time scope and affected resources;",{"_3475":482,"_30471":411,"_21105":51056,"_5":14473,"_27705":50885,"_2959":51057},[],"the commands or queries used;",{"_3475":483,"_30471":411,"_21105":51059,"_5":14473,"_27705":50885,"_2959":51060},[],"the applied change and how to revert it;",{"_3475":484,"_30471":411,"_21105":51062,"_5":14473,"_27705":50885,"_2959":51063},[],"validation from a consumer;",{"_3475":485,"_30471":411,"_21105":51065,"_5":14473,"_27705":50885,"_2959":51066},[],"the preventive action and its owner.",{"_3475":486,"_30471":486,"_5":14825,"_2959":51068,"_30823":51069,"_21105":51072,"_27705":486},"Access control",[49595,51070,51071],"Platform","Administration",[],{"_3475":487,"_30471":486,"_21105":51074,"_5":14473,"_27705":486,"_2959":51075},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3475":488,"_30471":486,"_5":30820,"_21105":51077,"_27705":51078,"_2959":51079},[],"/docs/pr-preview/pr-67/platform/administration/access-control#essential-concepts","Essential concepts",{"_3475":489,"_30471":486,"_5":30820,"_21105":51081,"_27705":51082,"_2959":51083},[],"/docs/pr-preview/pr-67/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3475":490,"_30471":486,"_5":30820,"_21105":51085,"_27705":51086,"_2959":51087},[],"/docs/pr-preview/pr-67/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3475":491,"_30471":486,"_5":30820,"_21105":51089,"_27705":51090,"_2959":51091},[],"/docs/pr-preview/pr-67/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3475":492,"_30471":486,"_5":30820,"_21105":51093,"_27705":51094,"_2959":51095},[],"/docs/pr-preview/pr-67/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3475":493,"_30471":486,"_5":30820,"_21105":51097,"_27705":51098,"_2959":51099},[],"/docs/pr-preview/pr-67/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3475":494,"_30471":486,"_5":30820,"_21105":51101,"_27705":51102,"_2959":51103},[],"/docs/pr-preview/pr-67/platform/administration/access-control#oidc-principals","OIDC principals",{"_3475":495,"_30471":486,"_5":30820,"_21105":51105,"_27705":51106,"_2959":51107},[],"/docs/pr-preview/pr-67/platform/administration/access-control#x509-principals","X.509 principals",{"_3475":496,"_30471":486,"_5":30820,"_21105":51109,"_27705":51110,"_2959":51111},[],"/docs/pr-preview/pr-67/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3475":497,"_30471":486,"_5":30820,"_21105":51113,"_27705":51114,"_2959":51115},[],"/docs/pr-preview/pr-67/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3475":498,"_30471":486,"_5":30820,"_21105":51117,"_27705":51118,"_2959":51119},[],"/docs/pr-preview/pr-67/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3475":499,"_30471":486,"_5":30820,"_21105":51121,"_27705":51122,"_2959":51123},[],"/docs/pr-preview/pr-67/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3475":500,"_30471":486,"_5":30820,"_21105":51125,"_27705":51126,"_2959":51127},[],"/docs/pr-preview/pr-67/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3475":501,"_30471":486,"_5":30820,"_21105":51129,"_27705":51130,"_2959":51131},[],"/docs/pr-preview/pr-67/platform/administration/access-control#http-rules","HTTP rules",{"_3475":502,"_30471":486,"_5":30820,"_21105":51133,"_27705":51134,"_2959":51135},[],"/docs/pr-preview/pr-67/platform/administration/access-control#included-policies","Included policies",{"_3475":503,"_30471":486,"_5":30820,"_21105":51137,"_27705":51138,"_2959":50235},[],"/docs/pr-preview/pr-67/platform/administration/access-control#provision-the-first-administrator",{"_3475":504,"_30471":486,"_5":30820,"_21105":51140,"_27705":51141,"_2959":51142},[],"/docs/pr-preview/pr-67/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3475":505,"_30471":486,"_5":30820,"_21105":51144,"_27705":51145,"_2959":51146},[],"/docs/pr-preview/pr-67/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3475":506,"_30471":486,"_5":30820,"_21105":51148,"_27705":51149,"_2959":51150},[],"/docs/pr-preview/pr-67/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3475":507,"_30471":486,"_5":30820,"_21105":51152,"_27705":51153,"_2959":51154},[],"/docs/pr-preview/pr-67/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3475":508,"_30471":486,"_5":30820,"_21105":51156,"_27705":51157,"_2959":51158},[],"/docs/pr-preview/pr-67/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3475":509,"_30471":486,"_5":30820,"_21105":51160,"_27705":51161,"_2959":51162},[],"/docs/pr-preview/pr-67/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3475":510,"_30471":486,"_5":30820,"_21105":51164,"_27705":51165,"_2959":51166},[],"/docs/pr-preview/pr-67/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3475":511,"_30471":486,"_5":30820,"_21105":51168,"_27705":51169,"_2959":51170},[],"/docs/pr-preview/pr-67/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3475":512,"_30471":486,"_5":30820,"_21105":51172,"_27705":51173,"_2959":51174},[],"/docs/pr-preview/pr-67/platform/administration/access-control#operational-checklist","Operational checklist",{"_3475":513,"_30471":486,"_5":30820,"_21105":51176,"_27705":51177,"_2959":51178},[],"/docs/pr-preview/pr-67/platform/administration/access-control#diagnostics","Diagnostics",{"_3475":514,"_30471":486,"_5":30820,"_21105":51180,"_27705":51181,"_2959":51182},[],"/docs/pr-preview/pr-67/platform/administration/access-control#the-response-is-401","The response is 401",{"_3475":515,"_30471":486,"_5":30820,"_21105":51184,"_27705":51185,"_2959":51186},[],"/docs/pr-preview/pr-67/platform/administration/access-control#the-response-is-403","The response is 403",{"_3475":516,"_30471":486,"_5":30820,"_21105":51188,"_27705":51189,"_2959":51190},[],"/docs/pr-preview/pr-67/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3475":517,"_30471":486,"_5":30820,"_21105":51192,"_27705":51193,"_2959":51194},[],"/docs/pr-preview/pr-67/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3475":518,"_30471":486,"_5":30820,"_21105":51196,"_27705":51197,"_2959":51198},[],"/docs/pr-preview/pr-67/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3475":519,"_30471":486,"_21105":51200,"_5":14473,"_27705":486,"_2959":51201},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3475":520,"_30471":486,"_21105":51203,"_5":14473,"_27705":486,"_2959":51204},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3475":521,"_30471":486,"_21105":51206,"_5":14473,"_27705":486,"_2959":51207},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3475":522,"_30471":486,"_21105":51209,"_5":14473,"_27705":51078,"_2959":51210},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3475":523,"_30471":486,"_21105":51212,"_5":14473,"_27705":51078,"_2959":51213},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3475":524,"_30471":486,"_21105":51215,"_5":14473,"_27705":51078,"_2959":51216},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3475":525,"_30471":486,"_21105":51218,"_5":14473,"_27705":51078,"_2959":51219},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3475":526,"_30471":486,"_21105":51221,"_5":14473,"_27705":51078,"_2959":51222},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3475":527,"_30471":486,"_21105":51224,"_5":14473,"_27705":51078,"_2959":51225},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3475":528,"_30471":486,"_21105":51227,"_5":14473,"_27705":51082,"_2959":51228},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3475":529,"_30471":486,"_21105":51230,"_5":14473,"_27705":51082,"_2959":51231},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3475":530,"_30471":486,"_21105":51233,"_5":14473,"_27705":51086,"_2959":51234},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3475":531,"_30471":486,"_21105":51236,"_5":14473,"_27705":51086,"_2959":51237},[],"The decision is made **before forwarding the request to the service**:",{"_3475":532,"_30471":486,"_21105":51239,"_5":14473,"_27705":51086,"_2959":51240},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3475":533,"_30471":486,"_21105":51242,"_5":14473,"_27705":51086,"_2959":51243},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3475":534,"_30471":486,"_21105":51245,"_5":14473,"_27705":51086,"_2959":51246},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3475":535,"_30471":486,"_21105":51248,"_5":14473,"_27705":51086,"_2959":51249},[],"It separately loads the policies granted to each principal.",{"_3475":536,"_30471":486,"_21105":51251,"_5":14473,"_27705":51086,"_2959":51252},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3475":537,"_30471":486,"_21105":51254,"_5":14473,"_27705":51086,"_2959":51255},[],"`authz` looks for an HTTP rule granting that action.",{"_3475":538,"_30471":486,"_21105":51257,"_5":14473,"_27705":51086,"_2959":51258},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3475":539,"_30471":486,"_21105":51260,"_5":14473,"_27705":51086,"_2959":51261},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3475":540,"_30471":486,"_21105":51263,"_5":14473,"_27705":51086,"_2959":51264},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3475":541,"_30471":486,"_21105":51266,"_5":14473,"_27705":51086,"_2959":51267},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3475":542,"_30471":486,"_21105":51269,"_5":14473,"_27705":51090,"_2959":51270},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3475":543,"_30471":486,"_21105":51272,"_5":14473,"_27705":51090,"_2959":51273},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3475":544,"_30471":486,"_21105":51275,"_5":14473,"_27705":51090,"_2959":51276},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3475":545,"_30471":486,"_21105":51278,"_5":14473,"_27705":51090,"_2959":51279},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3475":546,"_30471":486,"_21105":51281,"_5":14473,"_27705":51090,"_2959":51282},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3475":547,"_30471":486,"_21105":51284,"_5":14473,"_27705":51090,"_2959":51285},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3475":548,"_30471":486,"_21105":51287,"_5":14473,"_27705":51090,"_2959":51288},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3475":549,"_30471":486,"_21105":51290,"_5":14473,"_27705":51090,"_2959":51291},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3475":550,"_30471":486,"_21105":51293,"_5":14473,"_27705":51094,"_2959":51294},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3475":551,"_30471":486,"_21105":51296,"_5":14473,"_27705":51094,"_2959":51297},[],"The decision is made with the domain operation context:",{"_3475":552,"_30471":486,"_21105":51299,"_5":14473,"_27705":51094,"_2959":51300},[],"The middleware extracts the credential and resolves the matching principals.",{"_3475":553,"_30471":486,"_21105":51302,"_5":14473,"_27705":51094,"_2959":51303},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3475":554,"_30471":486,"_21105":51305,"_5":14473,"_27705":51094,"_2959":51306},[],"`authz` gathers the entity rules of the granted policies.",{"_3475":555,"_30471":486,"_21105":51308,"_5":14473,"_27705":51094,"_2959":51309},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3475":556,"_30471":486,"_21105":51311,"_5":14473,"_27705":51094,"_2959":51312},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3475":557,"_30471":486,"_21105":51314,"_5":14473,"_27705":51094,"_2959":51315},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3475":558,"_30471":486,"_21105":51317,"_5":14473,"_27705":51094,"_2959":51318},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3475":559,"_30471":486,"_21105":51320,"_5":14473,"_27705":51094,"_2959":51321},[],"Actions fall into two groups:",{"_3475":560,"_30471":486,"_21105":51323,"_5":14473,"_27705":51094,"_2959":51324},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3475":561,"_30471":486,"_21105":51326,"_5":14473,"_27705":51094,"_2959":51327},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3475":562,"_30471":486,"_21105":51329,"_5":14473,"_27705":51094,"_2959":51330},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3475":563,"_30471":486,"_21105":51332,"_5":14473,"_27705":51098,"_2959":51333},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3475":564,"_30471":486,"_21105":51335,"_5":14473,"_27705":51098,"_2959":51336},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3475":565,"_30471":486,"_21105":51338,"_5":14473,"_27705":51098,"_2959":51339},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3475":566,"_30471":486,"_21105":51341,"_5":14473,"_27705":51102,"_2959":51342},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3475":567,"_30471":486,"_21105":51344,"_5":14473,"_27705":51102,"_2959":51345},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3475":568,"_30471":486,"_21105":51347,"_5":14473,"_27705":51102,"_2959":51348},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3475":569,"_30471":486,"_21105":51350,"_5":14473,"_27705":51102,"_2959":51351},[],"The implemented operators are:",{"_3475":570,"_30471":486,"_21105":51353,"_5":14473,"_27705":51102,"_2959":51354},[],"`equals`, for exact equality;",{"_3475":571,"_30471":486,"_21105":51356,"_5":14473,"_27705":51102,"_2959":51357},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3475":572,"_30471":486,"_21105":51359,"_5":14473,"_27705":51102,"_2959":51360},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3475":573,"_30471":486,"_21105":51362,"_5":14473,"_27705":51102,"_2959":51363},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3475":574,"_30471":486,"_21105":51365,"_5":14473,"_27705":51106,"_2959":51366},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3475":575,"_30471":486,"_21105":51368,"_5":14473,"_27705":51106,"_2959":51369},[],"The available modes are:",{"_3475":576,"_30471":486,"_21105":51371,"_5":14473,"_27705":51106,"_2959":51372},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3475":577,"_30471":486,"_21105":51374,"_5":14473,"_27705":51106,"_2959":51375},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3475":578,"_30471":486,"_21105":51377,"_5":14473,"_27705":51106,"_2959":51378},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3475":579,"_30471":486,"_21105":51380,"_5":14473,"_27705":51106,"_2959":51381},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3475":580,"_30471":486,"_21105":51383,"_5":14473,"_27705":51106,"_2959":51384},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3475":581,"_30471":486,"_21105":51386,"_5":14473,"_27705":51106,"_2959":51387},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3475":582,"_30471":486,"_21105":51389,"_5":14473,"_27705":51110,"_2959":51390},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3475":583,"_30471":486,"_21105":51392,"_5":14473,"_27705":51110,"_2959":51393},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3475":584,"_30471":486,"_21105":51395,"_5":14473,"_27705":51110,"_2959":51396},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3475":585,"_30471":486,"_21105":51398,"_5":14473,"_27705":51110,"_2959":51399},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3475":586,"_30471":486,"_21105":51401,"_5":14473,"_27705":51118,"_2959":51402},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3475":587,"_30471":486,"_21105":51404,"_5":14473,"_27705":51118,"_2959":51405},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3475":588,"_30471":486,"_21105":51407,"_5":14473,"_27705":51122,"_2959":51408},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3475":589,"_30471":486,"_21105":51410,"_5":14473,"_27705":51122,"_2959":51411},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3475":590,"_30471":486,"_21105":51413,"_5":14473,"_27705":51126,"_2959":51414},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3475":591,"_30471":486,"_21105":51416,"_5":14473,"_27705":51126,"_2959":51417},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3475":592,"_30471":486,"_21105":51419,"_5":14473,"_27705":51126,"_2959":51420},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3475":593,"_30471":486,"_21105":51422,"_5":14473,"_27705":51130,"_2959":51423},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3475":594,"_30471":486,"_21105":51425,"_5":14473,"_27705":51130,"_2959":51426},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3475":595,"_30471":486,"_21105":51428,"_5":14473,"_27705":51130,"_2959":51429},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3475":596,"_30471":486,"_21105":51431,"_5":14473,"_27705":51130,"_2959":51432},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3475":597,"_30471":486,"_21105":51434,"_5":14473,"_27705":51130,"_2959":51435},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3475":598,"_30471":486,"_21105":51437,"_5":14473,"_27705":51130,"_2959":51438},[],"Note that:",{"_3475":599,"_30471":486,"_21105":51440,"_5":14473,"_27705":51130,"_2959":51441},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3475":600,"_30471":486,"_21105":51443,"_5":14473,"_27705":51130,"_2959":51444},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3475":601,"_30471":486,"_21105":51446,"_5":14473,"_27705":51130,"_2959":51447},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3475":602,"_30471":486,"_21105":51449,"_5":14473,"_27705":51134,"_2959":51450},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3475":603,"_30471":486,"_21105":51452,"_5":14473,"_27705":51134,"_2959":51453},[],"full and read-only access to certificates and authorities;",{"_3475":604,"_30471":486,"_21105":51455,"_5":14473,"_27705":51134,"_2959":51456},[],"full and read-only access to the KMS;",{"_3475":605,"_30471":486,"_21105":51458,"_5":14473,"_27705":51134,"_2959":51459},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3475":606,"_30471":486,"_21105":51461,"_5":14473,"_27705":51134,"_2959":51462},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3475":607,"_30471":486,"_21105":51464,"_5":14473,"_27705":51134,"_2959":51465},[],"console access;",{"_3475":608,"_30471":486,"_21105":51467,"_5":14473,"_27705":51134,"_2959":51468},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3475":609,"_30471":486,"_21105":51470,"_5":14473,"_27705":51134,"_2959":51471},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3475":610,"_30471":486,"_21105":51473,"_5":14473,"_27705":51134,"_2959":51474},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3475":611,"_30471":486,"_21105":51476,"_5":14473,"_27705":51138,"_2959":51477},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3475":612,"_30471":486,"_21105":51479,"_5":14473,"_27705":51138,"_2959":51480},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3475":613,"_30471":486,"_21105":51482,"_5":14473,"_27705":51138,"_2959":51483},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3475":614,"_30471":486,"_21105":51485,"_5":14473,"_27705":51141,"_2959":51486},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3475":615,"_30471":486,"_21105":51488,"_5":14473,"_27705":51145,"_2959":51489},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3475":616,"_30471":486,"_21105":51491,"_5":14473,"_27705":51145,"_2959":51492},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3475":617,"_30471":486,"_21105":51494,"_5":14473,"_27705":51149,"_2959":51495},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3475":618,"_30471":486,"_21105":51497,"_5":14473,"_27705":51153,"_2959":51498},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3475":619,"_30471":486,"_21105":51500,"_5":14473,"_27705":51157,"_2959":51501},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3475":620,"_30471":486,"_21105":51503,"_5":14473,"_27705":51161,"_2959":51504},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3475":621,"_30471":486,"_21105":51506,"_5":14473,"_27705":51161,"_2959":51507},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3475":622,"_30471":486,"_21105":51509,"_5":14473,"_27705":51165,"_2959":51510},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3475":623,"_30471":486,"_21105":51512,"_5":14473,"_27705":51165,"_2959":51513},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3475":624,"_30471":486,"_21105":51515,"_5":14473,"_27705":51165,"_2959":51516},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3475":625,"_30471":486,"_21105":51518,"_5":14473,"_27705":51165,"_2959":51519},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3475":626,"_30471":486,"_21105":51521,"_5":14473,"_27705":51165,"_2959":51522},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3475":627,"_30471":486,"_21105":51524,"_5":14473,"_27705":51165,"_2959":51525},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3475":628,"_30471":486,"_21105":51527,"_5":14473,"_27705":51165,"_2959":51528},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3475":629,"_30471":486,"_21105":51530,"_5":14473,"_27705":51165,"_2959":51531},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3475":630,"_30471":486,"_21105":51533,"_5":14473,"_27705":51169,"_2959":51534},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3475":631,"_30471":486,"_21105":51536,"_5":14473,"_27705":51169,"_2959":51537},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3475":632,"_30471":486,"_21105":51539,"_5":14473,"_27705":51169,"_2959":51540},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3475":633,"_30471":486,"_21105":51542,"_5":14473,"_27705":51173,"_2959":51543},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3475":634,"_30471":486,"_21105":51545,"_5":14473,"_27705":51173,"_2959":51546},[],"Use groups or stable roles for people and independent identities for automations.",{"_3475":635,"_30471":486,"_21105":51548,"_5":14473,"_27705":51173,"_2959":51549},[],"Keep at least two recovery administrators and test their access periodically.",{"_3475":636,"_30471":486,"_21105":51551,"_5":14473,"_27705":51173,"_2959":51552},[],"Review active principals, their matches and their grants after IdP changes.",{"_3475":637,"_30471":486,"_21105":51554,"_5":14473,"_27705":51173,"_2959":51555},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3475":638,"_30471":486,"_21105":51557,"_5":14473,"_27705":51173,"_2959":51558},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3475":639,"_30471":486,"_21105":51560,"_5":14473,"_27705":51173,"_2959":51561},[],"Always test one allowed and one denied operation for each role.",{"_3475":640,"_30471":486,"_21105":51563,"_5":14473,"_27705":51173,"_2959":51564},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3475":641,"_30471":486,"_21105":51566,"_5":14473,"_27705":51181,"_2959":51567},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3475":642,"_30471":486,"_21105":51569,"_5":14473,"_27705":51185,"_2959":51570},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3475":643,"_30471":486,"_21105":51572,"_5":14473,"_27705":51185,"_2959":51573},[],"that an active principal of the correct type exists;",{"_3475":644,"_30471":486,"_21105":51575,"_5":14473,"_27705":51185,"_2959":51576},[],"that the claim paths and values match the real token exactly;",{"_3475":645,"_30471":486,"_21105":51578,"_5":14473,"_27705":51185,"_2959":51579},[],"that all of the principal's conditions hold;",{"_3475":646,"_30471":486,"_21105":51581,"_5":14473,"_27705":51185,"_2959":51582},[],"that the principal has the expected policy granted;",{"_3475":647,"_30471":486,"_21105":51584,"_5":14473,"_27705":51185,"_2959":51585},[],"that the policy includes the action and the requested resource type or route;",{"_3475":648,"_30471":486,"_21105":51587,"_5":14473,"_27705":51185,"_2959":51588},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3475":649,"_30471":486,"_21105":51590,"_5":14473,"_27705":51185,"_2959":51591},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3475":650,"_30471":486,"_21105":51593,"_5":14473,"_27705":51189,"_2959":51594},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3475":651,"_30471":486,"_21105":51596,"_5":14473,"_27705":51193,"_2959":51597},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3475":652,"_30471":486,"_21105":51599,"_5":14473,"_27705":51197,"_2959":51600},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3475":653,"_30471":486,"_21105":51602,"_5":14473,"_27705":51197,"_2959":51603},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3475":654,"_30471":654,"_5":14825,"_2959":51605,"_30823":51606,"_21105":51607,"_27705":654},"Alerts and subscriptions",[49595,51070,51071],[],{"_3475":655,"_30471":654,"_21105":51609,"_5":14473,"_27705":654,"_2959":51610},[],"Send PKI events to people and external systems.",{"_3475":656,"_30471":654,"_5":30820,"_21105":51612,"_27705":51613,"_2959":51614},[],"/docs/pr-preview/pr-67/platform/administration/alerts#how-it-works","How it works",{"_3475":657,"_30471":654,"_5":30820,"_21105":51616,"_27705":51617,"_2959":51618},[],"/docs/pr-preview/pr-67/platform/administration/alerts#available-channels","Available channels",{"_3475":658,"_30471":654,"_5":30820,"_21105":51620,"_27705":51621,"_2959":51622},[],"/docs/pr-preview/pr-67/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3475":659,"_30471":654,"_5":30820,"_21105":51624,"_27705":51625,"_2959":51626},[],"/docs/pr-preview/pr-67/platform/administration/alerts#choose-the-event","Choose the event",{"_3475":660,"_30471":654,"_5":30820,"_21105":51628,"_27705":51629,"_2959":51630},[],"/docs/pr-preview/pr-67/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3475":661,"_30471":654,"_5":30820,"_21105":51632,"_27705":51633,"_2959":51634},[],"/docs/pr-preview/pr-67/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3475":662,"_30471":654,"_5":30820,"_21105":51636,"_27705":51637,"_2959":51638},[],"/docs/pr-preview/pr-67/platform/administration/alerts#review-and-activate","Review and activate",{"_3475":663,"_30471":654,"_5":30820,"_21105":51640,"_27705":51641,"_2959":51642},[],"/docs/pr-preview/pr-67/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3475":664,"_30471":654,"_5":30820,"_21105":51644,"_27705":51645,"_2959":51646},[],"/docs/pr-preview/pr-67/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3475":665,"_30471":654,"_5":30820,"_21105":51648,"_27705":51649,"_2959":51650},[],"/docs/pr-preview/pr-67/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3475":666,"_30471":654,"_5":30820,"_21105":51652,"_27705":51653,"_2959":51654},[],"/docs/pr-preview/pr-67/platform/administration/alerts#event-families","Event families",{"_3475":667,"_30471":654,"_21105":51656,"_5":14473,"_27705":654,"_2959":51657},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3475":668,"_30471":654,"_21105":51659,"_5":14473,"_27705":51613,"_2959":51660},[],"A service publishes a domain event.",{"_3475":669,"_30471":654,"_21105":51662,"_5":14473,"_27705":51613,"_2959":51663},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3475":670,"_30471":654,"_21105":51665,"_5":14473,"_27705":51613,"_2959":51666},[],"Each subscription's filter decides whether it should be notified.",{"_3475":671,"_30471":654,"_21105":51668,"_5":14473,"_27705":51613,"_2959":51669},[],"Lamassu delivers the event to the configured channel.",{"_3475":672,"_30471":654,"_21105":51671,"_5":14473,"_27705":51613,"_2959":51672},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3475":673,"_30471":654,"_21105":51674,"_5":14473,"_27705":51617,"_2959":51675},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3475":674,"_30471":654,"_21105":51677,"_5":14473,"_27705":51617,"_2959":51678},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3475":675,"_30471":654,"_21105":51680,"_5":14473,"_27705":51617,"_2959":51681},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3475":676,"_30471":654,"_21105":51683,"_5":14473,"_27705":51617,"_2959":51684},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3475":677,"_30471":654,"_21105":51686,"_5":14473,"_27705":51617,"_2959":51687},[],"`apikey_options` requires `header` and `key`.",{"_3475":678,"_30471":654,"_21105":51689,"_5":14473,"_27705":51617,"_2959":51690},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3475":679,"_30471":654,"_21105":51692,"_5":14473,"_27705":51617,"_2959":51693},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3475":680,"_30471":654,"_21105":51695,"_5":14473,"_27705":51617,"_2959":51696},[],"The alerts API reference documents the full `http_client` schema.",{"_3475":681,"_30471":654,"_21105":51698,"_5":14473,"_27705":51625,"_2959":51699},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3475":682,"_30471":654,"_21105":51701,"_5":14473,"_27705":51629,"_2959":51702},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3475":683,"_30471":654,"_21105":51704,"_5":14473,"_27705":51633,"_2959":51705},[],"Add a filter if you don't want to receive every instance of the event.",{"_3475":684,"_30471":654,"_21105":51707,"_5":14473,"_27705":51633,"_2959":51708},[],"**None** notifies all instances of the event.",{"_3475":685,"_30471":654,"_21105":51710,"_5":14473,"_27705":51633,"_2959":51711},[],"**JSON Path** evaluates one or more specific fields.",{"_3475":686,"_30471":654,"_21105":51713,"_5":14473,"_27705":51633,"_2959":51714},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3475":687,"_30471":654,"_21105":51716,"_5":14473,"_27705":51633,"_2959":51717},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3475":688,"_30471":654,"_21105":51719,"_5":14473,"_27705":51633,"_2959":51720},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3475":689,"_30471":654,"_21105":51722,"_5":14473,"_27705":51633,"_2959":51723},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3475":690,"_30471":654,"_21105":51725,"_5":14473,"_27705":51637,"_2959":51726},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3475":691,"_30471":654,"_21105":51728,"_5":14473,"_27705":51641,"_2959":51729},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3475":692,"_30471":654,"_21105":51731,"_5":14473,"_27705":51641,"_2959":51732},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3475":693,"_30471":654,"_21105":51734,"_5":14473,"_27705":51641,"_2959":51735},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3475":694,"_30471":654,"_21105":51737,"_5":14473,"_27705":51641,"_2959":51738},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3475":695,"_30471":654,"_21105":51740,"_5":14473,"_27705":51641,"_2959":51741},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3475":696,"_30471":654,"_21105":51743,"_5":14473,"_27705":51641,"_2959":51744},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3475":697,"_30471":654,"_21105":51746,"_5":14473,"_27705":51641,"_2959":51747},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3475":698,"_30471":654,"_21105":51749,"_5":14473,"_27705":51641,"_2959":51750},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3475":699,"_30471":654,"_21105":51752,"_5":14473,"_27705":51645,"_2959":51753},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3475":700,"_30471":654,"_21105":51755,"_5":14473,"_27705":51645,"_2959":51756},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3475":701,"_30471":654,"_21105":51758,"_5":14473,"_27705":51645,"_2959":51759},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3475":702,"_30471":654,"_21105":51761,"_5":14473,"_27705":51645,"_2959":51762},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3475":703,"_30471":654,"_21105":51764,"_5":14473,"_27705":51645,"_2959":51765},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3475":704,"_30471":654,"_21105":51767,"_5":14473,"_27705":51645,"_2959":51768},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3475":705,"_30471":654,"_21105":51770,"_5":14473,"_27705":51645,"_2959":51771},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3475":706,"_30471":654,"_21105":51773,"_5":14473,"_27705":51645,"_2959":51774},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3475":707,"_30471":654,"_21105":51776,"_5":14473,"_27705":51649,"_2959":51777},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3475":708,"_30471":654,"_21105":51779,"_5":14473,"_27705":51649,"_2959":51780},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3475":709,"_30471":654,"_21105":51782,"_5":14473,"_27705":51653,"_2959":51783},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3475":710,"_30471":654,"_21105":51785,"_5":14473,"_27705":51653,"_2959":51786},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3475":711,"_30471":654,"_21105":51788,"_5":14473,"_27705":51653,"_2959":51789},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3475":712,"_30471":654,"_21105":51791,"_5":14473,"_27705":51653,"_2959":51792},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3475":713,"_30471":654,"_21105":51794,"_5":14473,"_27705":51653,"_2959":51795},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3475":714,"_30471":654,"_21105":51797,"_5":14473,"_27705":51653,"_2959":51798},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3475":715,"_30471":654,"_21105":51800,"_5":14473,"_27705":51653,"_2959":51801},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3475":716,"_30471":654,"_21105":51803,"_5":14473,"_27705":51653,"_2959":51804},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3475":717,"_30471":654,"_21105":51806,"_5":14473,"_27705":51653,"_2959":51807},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3475":718,"_30471":718,"_5":14825,"_2959":51809,"_30823":51810,"_21105":51811,"_27705":718},"Audit logs",[49595,51070,51071],[],{"_3475":719,"_30471":718,"_21105":51813,"_5":14473,"_27705":718,"_2959":51814},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3475":720,"_30471":718,"_5":30820,"_21105":51816,"_27705":51817,"_2959":51818},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3475":721,"_30471":718,"_5":30820,"_21105":51820,"_27705":51821,"_2959":51822},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#coverage","Coverage",{"_3475":722,"_30471":718,"_5":30820,"_21105":51824,"_27705":51825,"_2959":51826},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3475":723,"_30471":718,"_5":30820,"_21105":51828,"_27705":51829,"_2959":51830},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3475":724,"_30471":718,"_5":30820,"_21105":51832,"_27705":51833,"_2959":51834},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3475":725,"_30471":718,"_5":30820,"_21105":51836,"_27705":51837,"_2959":51838},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3475":726,"_30471":718,"_5":30820,"_21105":51840,"_27705":51841,"_2959":51842},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3475":727,"_30471":718,"_5":30820,"_21105":51844,"_27705":51845,"_2959":51846},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3475":728,"_30471":718,"_5":30820,"_21105":51848,"_27705":51849,"_2959":51850},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3475":729,"_30471":718,"_5":30820,"_21105":51852,"_27705":51853,"_2959":51854},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3475":730,"_30471":718,"_5":30820,"_21105":51856,"_27705":51857,"_2959":51858},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3475":731,"_30471":718,"_21105":51860,"_5":14473,"_27705":718,"_2959":51861},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3475":732,"_30471":718,"_21105":51863,"_5":14473,"_27705":51817,"_2959":51864},[],"The audit body includes:",{"_3475":733,"_30471":718,"_21105":51866,"_5":14473,"_27705":51817,"_2959":51867},[],"input: data received by the operation;",{"_3475":734,"_30471":718,"_21105":51869,"_5":14473,"_27705":51817,"_2959":51870},[],"has\\_error: whether the service returned an error;",{"_3475":735,"_30471":718,"_21105":51872,"_5":14473,"_27705":51817,"_2959":51873},[],"output: produced result or error message;",{"_3475":736,"_30471":718,"_21105":51875,"_5":14473,"_27705":51817,"_2959":51876},[],"principals: identifiers of the principals that matched the request.",{"_3475":737,"_30471":718,"_21105":51878,"_5":14473,"_27705":51817,"_2959":51879},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3475":738,"_30471":718,"_21105":51881,"_5":14473,"_27705":51817,"_2959":51882},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3475":739,"_30471":718,"_21105":51884,"_5":14473,"_27705":51821,"_2959":51885},[],"The backend applies auditing to mutations of:",{"_3475":740,"_30471":718,"_21105":51887,"_5":14473,"_27705":51821,"_2959":51888},[],"authorities, certificates and issuance profiles;",{"_3475":741,"_30471":718,"_21105":51890,"_5":14473,"_27705":51821,"_2959":51891},[],"keys and KMS engines;",{"_3475":742,"_30471":718,"_21105":51893,"_5":14473,"_27705":51821,"_2959":51894},[],"devices and identities;",{"_3475":743,"_30471":718,"_21105":51896,"_5":14473,"_27705":51821,"_2959":51897},[],"DMSs and enrollment operations;",{"_3475":744,"_30471":718,"_21105":51899,"_5":14473,"_27705":51821,"_2959":51900},[],"validation functions and CRL;",{"_3475":745,"_30471":718,"_21105":51902,"_5":14473,"_27705":51821,"_2959":51903},[],"principals, policies and authorization grants.",{"_3475":746,"_30471":718,"_21105":51905,"_5":14473,"_27705":51821,"_2959":51906},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3475":747,"_30471":718,"_21105":51908,"_5":14473,"_27705":51825,"_2959":51909},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3475":748,"_30471":718,"_21105":51911,"_5":14473,"_27705":51825,"_2959":51912},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3475":749,"_30471":718,"_21105":51914,"_5":14473,"_27705":51825,"_2959":51915},[],"Design the consumer to:",{"_3475":750,"_30471":718,"_21105":51917,"_5":14473,"_27705":51825,"_2959":51918},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3475":751,"_30471":718,"_21105":51920,"_5":14473,"_27705":51825,"_2959":51921},[],"keep the complete CloudEvent unmodified;",{"_3475":752,"_30471":718,"_21105":51923,"_5":14473,"_27705":51825,"_2959":51924},[],"record the ingestion time and detect duplicates by ID;",{"_3475":753,"_30471":718,"_21105":51926,"_5":14473,"_27705":51825,"_2959":51927},[],"encrypt in transit and at rest;",{"_3475":754,"_30471":718,"_21105":51929,"_5":14473,"_27705":51825,"_2959":51930},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3475":755,"_30471":718,"_21105":51932,"_5":14473,"_27705":51825,"_2959":51933},[],"apply an explicit retention and legal hold policy;",{"_3475":756,"_30471":718,"_21105":51935,"_5":14473,"_27705":51825,"_2959":51936},[],"alert if it stops consuming or the pending queue grows.",{"_3475":757,"_30471":718,"_21105":51938,"_5":14473,"_27705":51829,"_2959":51939},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3475":758,"_30471":718,"_21105":51941,"_5":14473,"_27705":51829,"_2959":51942},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3475":759,"_30471":718,"_21105":51944,"_5":14473,"_27705":51837,"_2959":51945},[],"Start from the reported time and normalize every source to UTC.",{"_3475":760,"_30471":718,"_21105":51947,"_5":14473,"_27705":51841,"_2959":51948},[],"Filter by event type, service source and resource identifier.",{"_3475":761,"_30471":718,"_21105":51950,"_5":14473,"_27705":51845,"_2959":51951},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3475":762,"_30471":718,"_21105":51953,"_5":14473,"_27705":51849,"_2959":51954},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3475":763,"_30471":718,"_21105":51956,"_5":14473,"_27705":51853,"_2959":51957},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3475":764,"_30471":718,"_21105":51959,"_5":14473,"_27705":51857,"_2959":51960},[],"Generate a controlled mutation in a test environment and check that:",{"_3475":765,"_30471":718,"_21105":51962,"_5":14473,"_27705":51857,"_2959":51963},[],"a successful audit event appears;",{"_3475":766,"_30471":718,"_21105":51965,"_5":14473,"_27705":51857,"_2959":51966},[],"the principal matches the identity used;",{"_3475":767,"_30471":718,"_21105":51968,"_5":14473,"_27705":51857,"_2959":51969},[],"the consumer persists it exactly once;",{"_3475":768,"_30471":718,"_21105":51971,"_5":14473,"_27705":51857,"_2959":51972},[],"it can be retrieved by resource, actor and period;",{"_3475":769,"_30471":718,"_21105":51974,"_5":14473,"_27705":51857,"_2959":51975},[],"a consumer outage raises an alert.",{"_3475":770,"_30471":718,"_21105":51977,"_5":14473,"_27705":51857,"_2959":51978},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3475":771,"_30471":771,"_5":14825,"_2959":51980,"_30823":51981,"_21105":51982,"_27705":771},"Platform architecture",[49595,51070],[],{"_3475":772,"_30471":771,"_21105":51984,"_5":14473,"_27705":771,"_2959":51985},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3475":773,"_30471":771,"_5":30820,"_21105":51987,"_27705":51988,"_2959":51989},[],"/docs/pr-preview/pr-67/platform/concepts/architecture#control-plane","Control plane",{"_3475":774,"_30471":771,"_5":30820,"_21105":51991,"_27705":51992,"_2959":51993},[],"/docs/pr-preview/pr-67/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3475":775,"_30471":771,"_5":30820,"_21105":51995,"_27705":51996,"_2959":51997},[],"/docs/pr-preview/pr-67/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3475":776,"_30471":771,"_5":30820,"_21105":51999,"_27705":52000,"_2959":52001},[],"/docs/pr-preview/pr-67/platform/concepts/architecture#status-and-validation","Status and validation",{"_3475":777,"_30471":771,"_5":30820,"_21105":52003,"_27705":52004,"_2959":52005},[],"/docs/pr-preview/pr-67/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3475":778,"_30471":771,"_21105":52007,"_5":14473,"_27705":771,"_2959":52008},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3475":779,"_30471":771,"_21105":52010,"_5":14473,"_27705":771,"_2959":52011},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3475":780,"_30471":771,"_21105":52013,"_5":14473,"_27705":51988,"_2959":52014},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3475":781,"_30471":771,"_21105":52016,"_5":14473,"_27705":51992,"_2959":52017},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3475":782,"_30471":771,"_21105":52019,"_5":14473,"_27705":51996,"_2959":52020},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3475":783,"_30471":771,"_21105":52022,"_5":14473,"_27705":52000,"_2959":52023},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3475":784,"_30471":771,"_21105":52025,"_5":14473,"_27705":52004,"_2959":52026},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3475":785,"_30471":785,"_5":14825,"_2959":52028,"_30823":52029,"_21105":52030,"_27705":785},"How Lamassu works",[49595,51070],[],{"_3475":786,"_30471":785,"_21105":52032,"_5":14473,"_27705":785,"_2959":52033},[],"The mental model of trust, keys, certificates and devices.",{"_3475":787,"_30471":785,"_5":30820,"_21105":52035,"_27705":52036,"_2959":52037},[],"/docs/pr-preview/pr-67/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3475":788,"_30471":785,"_5":30820,"_21105":52039,"_27705":52040,"_2959":52041},[],"/docs/pr-preview/pr-67/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3475":789,"_30471":785,"_21105":52043,"_5":14473,"_27705":785,"_2959":52044},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3475":790,"_30471":785,"_21105":52046,"_5":14473,"_27705":52036,"_2959":52047},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3475":791,"_30471":785,"_21105":52049,"_5":14473,"_27705":52036,"_2959":52050},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3475":792,"_30471":785,"_21105":52052,"_5":14473,"_27705":52036,"_2959":52053},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3475":793,"_30471":785,"_21105":52055,"_5":14473,"_27705":52036,"_2959":52056},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3475":794,"_30471":785,"_21105":52058,"_5":14473,"_27705":52036,"_2959":52059},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3475":795,"_30471":785,"_21105":52061,"_5":14473,"_27705":52040,"_2959":52062},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3475":796,"_30471":785,"_21105":52064,"_5":14473,"_27705":52040,"_2959":52065},[],"A DMS relates that CA to an enrollment policy.",{"_3475":797,"_30471":785,"_21105":52067,"_5":14473,"_27705":52040,"_2959":52068},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3475":798,"_30471":785,"_21105":52070,"_5":14473,"_27705":52040,"_2959":52071},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3475":799,"_30471":785,"_21105":52073,"_5":14473,"_27705":52040,"_2959":52074},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3475":800,"_30471":785,"_21105":52076,"_5":14473,"_27705":52040,"_2959":52077},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3475":801,"_30471":785,"_21105":52079,"_5":14473,"_27705":52040,"_2959":52080},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3475":802,"_30471":802,"_5":14825,"_2959":52082,"_30823":52083,"_21105":52085,"_27705":802},"Devices and identities",[49595,51070,52084,52082],"IoT Fleets",[],{"_3475":803,"_30471":802,"_21105":52087,"_5":14473,"_27705":802,"_2959":52088},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3475":804,"_30471":802,"_5":30820,"_21105":52090,"_27705":52091,"_2959":52092},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#device-states","Device states",{"_3475":805,"_30471":802,"_5":30820,"_21105":52094,"_27705":52095,"_2959":52096},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3475":806,"_30471":802,"_5":30820,"_21105":52098,"_27705":52099,"_2959":52100},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3475":807,"_30471":802,"_5":30820,"_21105":52102,"_27705":52103,"_2959":52104},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3475":808,"_30471":802,"_5":30820,"_21105":52106,"_27705":52107,"_2959":52108},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3475":809,"_30471":802,"_5":30820,"_21105":52110,"_27705":52111,"_2959":52112},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3475":810,"_30471":802,"_5":30820,"_21105":52114,"_27705":52115,"_2959":52116},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3475":811,"_30471":802,"_5":30820,"_21105":52118,"_27705":52119,"_2959":52120},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3475":812,"_30471":802,"_5":30820,"_21105":52122,"_27705":52123,"_2959":52124},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3475":813,"_30471":802,"_5":30820,"_21105":52126,"_27705":52127,"_2959":52128},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3475":814,"_30471":802,"_5":30820,"_21105":52130,"_27705":52131,"_2959":52132},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3475":815,"_30471":802,"_21105":52134,"_5":14473,"_27705":802,"_2959":52135},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3475":816,"_30471":802,"_21105":52137,"_5":14473,"_27705":802,"_2959":52138},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3475":817,"_30471":802,"_21105":52140,"_5":14473,"_27705":52091,"_2959":52141},[],"Operational view",{"_3475":818,"_30471":802,"_21105":52143,"_5":14473,"_27705":52091,"_2959":52144},[],"Meaning",{"_3475":819,"_30471":802,"_21105":52146,"_5":14473,"_27705":52091,"_2959":52147},[],"**No Identity**",{"_3475":820,"_30471":802,"_21105":52149,"_5":14473,"_27705":52091,"_2959":52150},[],"A record exists without an associated identity.",{"_3475":821,"_30471":802,"_21105":52152,"_5":14473,"_27705":52091,"_2959":52153},[],"**Active**",{"_3475":822,"_30471":802,"_21105":52155,"_5":14473,"_27705":52091,"_2959":52156},[],"The slot is active; also check certificate dates, status and usages.",{"_3475":823,"_30471":802,"_21105":52158,"_5":14473,"_27705":52091,"_2959":52159},[],"**Renewal Pending**",{"_3475":824,"_30471":802,"_21105":52161,"_5":14473,"_27705":52091,"_2959":52162},[],"The identity is in the operational renewal window.",{"_3475":825,"_30471":802,"_21105":52164,"_5":14473,"_27705":52091,"_2959":52165},[],"**Expiring Soon**",{"_3475":826,"_30471":802,"_21105":52167,"_5":14473,"_27705":52091,"_2959":52168},[],"Expiration is approaching according to configured thresholds.",{"_3475":827,"_30471":802,"_21105":52170,"_5":14473,"_27705":52091,"_2959":52171},[],"**Expired**",{"_3475":828,"_30471":802,"_21105":52173,"_5":14473,"_27705":52091,"_2959":52174},[],"The identity has expired.",{"_3475":829,"_30471":802,"_21105":52176,"_5":14473,"_27705":52091,"_2959":52177},[],"**Revoked**",{"_3475":830,"_30471":802,"_21105":52179,"_5":14473,"_27705":52091,"_2959":52180},[],"The identity is marked revoked.",{"_3475":831,"_30471":802,"_21105":52182,"_5":14473,"_27705":52091,"_2959":52183},[],"**Decommissioned**",{"_3475":832,"_30471":802,"_21105":52185,"_5":14473,"_27705":52091,"_2959":52186},[],"The record is retired and ordinary updates do not restore operation.",{"_3475":833,"_30471":802,"_21105":52188,"_5":14473,"_27705":52091,"_2959":52189},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3475":834,"_30471":802,"_21105":52191,"_5":14473,"_27705":52095,"_2959":52192},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3475":835,"_30471":802,"_21105":52194,"_5":14473,"_27705":52095,"_2959":52195},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3475":836,"_30471":802,"_21105":52197,"_5":14473,"_27705":52095,"_2959":52198},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3475":837,"_30471":802,"_21105":52200,"_5":14473,"_27705":52095,"_2959":52201},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3475":838,"_30471":802,"_21105":52203,"_5":14473,"_27705":52099,"_2959":52204},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3475":839,"_30471":802,"_21105":52206,"_5":14473,"_27705":52103,"_2959":52207},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3475":840,"_30471":802,"_21105":52209,"_5":14473,"_27705":52107,"_2959":52210},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3475":841,"_30471":802,"_21105":52212,"_5":14473,"_27705":52111,"_2959":52213},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3475":842,"_30471":802,"_21105":52215,"_5":14473,"_27705":52115,"_2959":52216},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3475":843,"_30471":802,"_21105":52218,"_5":14473,"_27705":52115,"_2959":52219},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3475":844,"_30471":802,"_21105":52221,"_5":14473,"_27705":52119,"_2959":52222},[],"From **No Identity**, use **Assign Identity**:",{"_3475":845,"_30471":802,"_21105":52224,"_5":14473,"_27705":52119,"_2959":52225},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3475":846,"_30471":802,"_21105":52227,"_5":14473,"_27705":52119,"_2959":52228},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3475":847,"_30471":802,"_21105":52230,"_5":14473,"_27705":52119,"_2959":52231},[],"Confirm and read the serial, active version and history again.",{"_3475":848,"_30471":802,"_21105":52233,"_5":14473,"_27705":52119,"_2959":52234},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3475":849,"_30471":802,"_21105":52236,"_5":14473,"_27705":52119,"_2959":52237},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3475":850,"_30471":802,"_21105":52239,"_5":14473,"_27705":52123,"_2959":52240},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3475":851,"_30471":802,"_21105":52242,"_5":14473,"_27705":52123,"_2959":52243},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3475":852,"_30471":802,"_21105":52245,"_5":14473,"_27705":52127,"_2959":52246},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3475":853,"_30471":802,"_21105":52248,"_5":14473,"_27705":52127,"_2959":52249},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3475":854,"_30471":802,"_21105":52251,"_5":14473,"_27705":52127,"_2959":52252},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3475":855,"_30471":802,"_21105":52254,"_5":14473,"_27705":52127,"_2959":52255},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3475":856,"_30471":802,"_21105":52257,"_5":14473,"_27705":52131,"_2959":52258},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3475":857,"_30471":802,"_21105":52260,"_5":14473,"_27705":52131,"_2959":52261},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3475":858,"_30471":858,"_5":14825,"_2959":52263,"_30823":52264,"_21105":52266,"_27705":858},"Bootstrap identity and authentication",[49595,51070,52084,52082,52265],"Enrollment with PKI",[],{"_3475":859,"_30471":858,"_21105":52268,"_5":14473,"_27705":858,"_2959":52269},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3475":860,"_30471":858,"_5":30820,"_21105":52271,"_27705":52272,"_2959":52273},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3475":861,"_30471":858,"_5":30820,"_21105":52275,"_27705":52276,"_2959":52277},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3475":862,"_30471":858,"_5":30820,"_21105":52279,"_27705":52280,"_2959":52281},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3475":863,"_30471":858,"_5":30820,"_21105":52283,"_27705":52284,"_2959":52285},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3475":864,"_30471":858,"_5":30820,"_21105":52287,"_27705":52288,"_2959":52289},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3475":865,"_30471":858,"_21105":52291,"_5":14473,"_27705":858,"_2959":52292},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3475":866,"_30471":858,"_21105":52294,"_5":14473,"_27705":52272,"_2959":52295},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3475":867,"_30471":858,"_21105":52297,"_5":14473,"_27705":52272,"_2959":52298},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3475":868,"_30471":858,"_21105":52300,"_5":14473,"_27705":52276,"_2959":52301},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3475":869,"_30471":858,"_21105":52303,"_5":14473,"_27705":52276,"_2959":52304},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3475":870,"_30471":858,"_21105":52306,"_5":14473,"_27705":52276,"_2959":52307},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3475":871,"_30471":858,"_21105":52309,"_5":14473,"_27705":52280,"_2959":52310},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3475":872,"_30471":858,"_21105":52312,"_5":14473,"_27705":52280,"_2959":52313},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3475":873,"_30471":858,"_21105":52315,"_5":14473,"_27705":52284,"_2959":52316},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3475":874,"_30471":858,"_21105":52318,"_5":14473,"_27705":52284,"_2959":52319},[],"Example body:",{"_3475":875,"_30471":858,"_21105":52321,"_5":14473,"_27705":52284,"_2959":52322},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3475":876,"_30471":858,"_21105":52324,"_5":14473,"_27705":52284,"_2959":52325},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3475":877,"_30471":858,"_21105":52327,"_5":14473,"_27705":52284,"_2959":52328},[],"Continuation requires a successful HTTP response and JSON:",{"_3475":878,"_30471":858,"_21105":52330,"_5":14473,"_27705":52284,"_2959":52331},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3475":879,"_30471":858,"_21105":52333,"_5":14473,"_27705":52288,"_2959":52334},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3475":880,"_30471":858,"_21105":52336,"_5":14473,"_27705":52288,"_2959":52337},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3475":881,"_30471":881,"_5":14825,"_2959":52339,"_30823":52340,"_21105":52341,"_27705":881},"Configure and operate the DMS",[49595,51070,52084,52082,52265],[],{"_3475":882,"_30471":881,"_21105":52343,"_5":14473,"_27705":881,"_2959":52344},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3475":883,"_30471":881,"_5":30820,"_21105":52346,"_27705":52347,"_2959":49605},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3475":884,"_30471":881,"_5":30820,"_21105":52349,"_27705":52350,"_2959":52351},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3475":885,"_30471":881,"_5":30820,"_21105":52353,"_27705":52354,"_2959":52355},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3475":886,"_30471":881,"_5":30820,"_21105":52357,"_27705":52358,"_2959":52359},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3475":887,"_30471":881,"_5":30820,"_21105":52361,"_27705":52362,"_2959":52363},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3475":888,"_30471":881,"_5":30820,"_21105":52365,"_27705":52366,"_2959":52367},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3475":889,"_30471":881,"_5":30820,"_21105":52369,"_27705":52370,"_2959":52371},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3475":890,"_30471":881,"_5":30820,"_21105":52373,"_27705":52374,"_2959":52375},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3475":891,"_30471":881,"_5":30820,"_21105":52377,"_27705":52378,"_2959":52379},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3475":892,"_30471":881,"_5":30820,"_21105":52381,"_27705":52382,"_2959":52383},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3475":893,"_30471":881,"_5":30820,"_21105":52385,"_27705":52386,"_2959":52387},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3475":894,"_30471":881,"_5":30820,"_21105":52389,"_27705":52390,"_2959":52391},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3475":895,"_30471":881,"_5":30820,"_21105":52393,"_27705":52394,"_2959":52395},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3475":896,"_30471":881,"_5":30820,"_21105":52397,"_27705":52398,"_2959":52399},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3475":897,"_30471":881,"_5":30820,"_21105":52401,"_27705":52402,"_2959":52403},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3475":898,"_30471":881,"_5":30820,"_21105":52405,"_27705":52406,"_2959":52407},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3475":899,"_30471":881,"_5":30820,"_21105":52409,"_27705":52410,"_2959":52411},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3475":900,"_30471":881,"_5":30820,"_21105":52413,"_27705":52414,"_2959":52415},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3475":901,"_30471":881,"_21105":52417,"_5":14473,"_27705":881,"_2959":52418},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3475":902,"_30471":881,"_21105":52420,"_5":14473,"_27705":52347,"_2959":52421},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3475":903,"_30471":881,"_21105":52423,"_5":14473,"_27705":52347,"_2959":52424},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3475":904,"_30471":881,"_21105":52426,"_5":14473,"_27705":52354,"_2959":52427},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3475":905,"_30471":881,"_21105":52429,"_5":14473,"_27705":52358,"_2959":52430},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3475":906,"_30471":881,"_21105":52432,"_5":14473,"_27705":52362,"_2959":52433},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3475":907,"_30471":881,"_21105":52435,"_5":14473,"_27705":52366,"_2959":52436},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3475":908,"_30471":881,"_21105":52438,"_5":14473,"_27705":52370,"_2959":52439},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3475":909,"_30471":881,"_21105":52441,"_5":14473,"_27705":52378,"_2959":52442},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3475":910,"_30471":881,"_21105":52444,"_5":14473,"_27705":52378,"_2959":52445},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3475":911,"_30471":881,"_21105":52447,"_5":14473,"_27705":52382,"_2959":52448},[],"`settings.enrollment_settings` field",{"_3475":912,"_30471":881,"_21105":52450,"_5":14473,"_27705":52382,"_2959":52451},[],"Decision",{"_3475":913,"_30471":881,"_21105":52453,"_5":14473,"_27705":52382,"_2959":52454},[],"`protocol`",{"_3475":914,"_30471":881,"_21105":52456,"_5":14473,"_27705":52382,"_2959":52457},[],"`EST_RFC7030` for these operations.",{"_3475":915,"_30471":881,"_21105":52459,"_5":14473,"_27705":52382,"_2959":52460},[],"`enrollment_ca`",{"_3475":916,"_30471":881,"_21105":52462,"_5":14473,"_27705":52382,"_2959":52463},[],"ID of the signing CA.",{"_3475":917,"_30471":881,"_21105":52465,"_5":14473,"_27705":52382,"_2959":52466},[],"`verify_csr_signature`",{"_3475":918,"_30471":881,"_21105":52468,"_5":14473,"_27705":52382,"_2959":52469},[],"Keep `true` to verify CSR key possession.",{"_3475":919,"_30471":881,"_21105":52471,"_5":14473,"_27705":52382,"_2959":52472},[],"`enable_replaceable_enrollment`",{"_3475":920,"_30471":881,"_21105":52474,"_5":14473,"_27705":52382,"_2959":52475},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3475":921,"_30471":881,"_21105":52477,"_5":14473,"_27705":52382,"_2959":52478},[],"`est_rfc7030_settings.auth_mode`",{"_3475":922,"_30471":881,"_21105":52480,"_5":14473,"_27705":52382,"_2959":52481},[],"One of the four authentication modes.",{"_3475":923,"_30471":881,"_21105":52483,"_5":14473,"_27705":52382,"_2959":52484},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3475":924,"_30471":881,"_21105":52486,"_5":14473,"_27705":52386,"_2959":52487},[],"The blocks are independent:",{"_3475":925,"_30471":881,"_21105":52489,"_5":14473,"_27705":52386,"_2959":52490},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3475":926,"_30471":881,"_21105":52492,"_5":14473,"_27705":52386,"_2959":52493},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3475":927,"_30471":881,"_21105":52495,"_5":14473,"_27705":52386,"_2959":52496},[],"`auth_mode`",{"_3475":928,"_30471":881,"_21105":52498,"_5":14473,"_27705":52386,"_2959":52499},[],"Control applied in the configured operation",{"_3475":929,"_30471":881,"_21105":52501,"_5":14473,"_27705":52386,"_2959":52502},[],"`CLIENT_CERTIFICATE`",{"_3475":930,"_30471":881,"_21105":52504,"_5":14473,"_27705":52386,"_2959":52505},[],"Presented certificate validation.",{"_3475":931,"_30471":881,"_21105":52507,"_5":14473,"_27705":52386,"_2959":52508},[],"`EXTERNAL_WEBHOOK`",{"_3475":932,"_30471":881,"_21105":52510,"_5":14473,"_27705":52386,"_2959":52511},[],"Configured webhook authorization.",{"_3475":933,"_30471":881,"_21105":52513,"_5":14473,"_27705":52386,"_2959":52514},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3475":934,"_30471":881,"_21105":52516,"_5":14473,"_27705":52386,"_2959":52517},[],"Certificate validation followed by webhook approval.",{"_3475":935,"_30471":881,"_21105":52519,"_5":14473,"_27705":52386,"_2959":52520},[],"`NO_AUTH`",{"_3475":936,"_30471":881,"_21105":52522,"_5":14473,"_27705":52386,"_2959":52523},[],"No DMS requester authentication.",{"_3475":937,"_30471":881,"_21105":52525,"_5":14473,"_27705":52386,"_2959":52526},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3475":938,"_30471":881,"_21105":52528,"_5":14473,"_27705":52386,"_2959":52529},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3475":939,"_30471":881,"_21105":52531,"_5":14473,"_27705":52386,"_2959":52532},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3475":940,"_30471":881,"_21105":52534,"_5":14473,"_27705":52386,"_2959":52535},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3475":941,"_30471":881,"_21105":52537,"_5":14473,"_27705":52390,"_2959":52538},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3475":942,"_30471":881,"_21105":52540,"_5":14473,"_27705":52390,"_2959":52541},[],"`external_webhook_settings` field",{"_3475":943,"_30471":881,"_21105":52543,"_5":14473,"_27705":52390,"_2959":52451},[],{"_3475":944,"_30471":881,"_21105":52545,"_5":14473,"_27705":52390,"_2959":52546},[],"`url`",{"_3475":945,"_30471":881,"_21105":52548,"_5":14473,"_27705":52390,"_2959":52549},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3475":946,"_30471":881,"_21105":52551,"_5":14473,"_27705":52390,"_2959":52552},[],"`method`",{"_3475":947,"_30471":881,"_21105":52554,"_5":14473,"_27705":52390,"_2959":52555},[],"`POST` or `PUT`; `POST` by default.",{"_3475":948,"_30471":881,"_21105":52557,"_5":14473,"_27705":52390,"_2959":52558},[],"`name`",{"_3475":949,"_30471":881,"_21105":52560,"_5":14473,"_27705":52390,"_2959":52561},[],"Label used in service logs.",{"_3475":950,"_30471":881,"_21105":52563,"_5":14473,"_27705":52390,"_2959":52564},[],"`config.auth_mode`",{"_3475":951,"_30471":881,"_21105":52566,"_5":14473,"_27705":52390,"_2959":52567},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3475":952,"_30471":881,"_21105":52569,"_5":14473,"_27705":52390,"_2959":52570},[],"`config.log_level`",{"_3475":953,"_30471":881,"_21105":52572,"_5":14473,"_27705":52390,"_2959":52573},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3475":954,"_30471":881,"_21105":52575,"_5":14473,"_27705":52390,"_2959":52576},[],"`config.apikey_options`",{"_3475":955,"_30471":881,"_21105":52578,"_5":14473,"_27705":52390,"_2959":52579},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3475":956,"_30471":881,"_21105":52581,"_5":14473,"_27705":52390,"_2959":52582},[],"`config.jwt_options`",{"_3475":957,"_30471":881,"_21105":52584,"_5":14473,"_27705":52390,"_2959":52585},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3475":958,"_30471":881,"_21105":52587,"_5":14473,"_27705":52390,"_2959":52588},[],"`config.mtls_options`",{"_3475":959,"_30471":881,"_21105":52590,"_5":14473,"_27705":52390,"_2959":52591},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3475":960,"_30471":881,"_21105":52593,"_5":14473,"_27705":52390,"_2959":52594},[],"`config.insecure_skip_verify`",{"_3475":961,"_30471":881,"_21105":52596,"_5":14473,"_27705":52390,"_2959":52597},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3475":962,"_30471":881,"_21105":52599,"_5":14473,"_27705":52390,"_2959":52600},[],"`config.call_timeout`",{"_3475":963,"_30471":881,"_21105":52602,"_5":14473,"_27705":52390,"_2959":52603},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3475":964,"_30471":881,"_21105":52605,"_5":14473,"_27705":52390,"_2959":52606},[],"Rules for that configuration:",{"_3475":965,"_30471":881,"_21105":52608,"_5":14473,"_27705":52390,"_2959":52609},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3475":966,"_30471":881,"_21105":52611,"_5":14473,"_27705":52390,"_2959":52612},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3475":967,"_30471":881,"_21105":52614,"_5":14473,"_27705":52390,"_2959":52615},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3475":968,"_30471":881,"_21105":52617,"_5":14473,"_27705":52390,"_2959":52618},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3475":969,"_30471":881,"_21105":52620,"_5":14473,"_27705":52390,"_2959":52621},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3475":970,"_30471":881,"_21105":52623,"_5":14473,"_27705":52390,"_2959":52624},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3475":971,"_30471":881,"_21105":52626,"_5":14473,"_27705":52390,"_2959":52627},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3475":972,"_30471":881,"_21105":52629,"_5":14473,"_27705":52390,"_2959":52630},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3475":973,"_30471":881,"_21105":52632,"_5":14473,"_27705":52390,"_2959":52633},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3475":974,"_30471":881,"_21105":52635,"_5":14473,"_27705":52394,"_2959":52636},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3475":975,"_30471":881,"_21105":52638,"_5":14473,"_27705":52398,"_2959":52639},[],"`settings.reenrollment_settings` field",{"_3475":976,"_30471":881,"_21105":52641,"_5":14473,"_27705":52398,"_2959":49985},[],{"_3475":977,"_30471":881,"_21105":52643,"_5":14473,"_27705":52398,"_2959":52644},[],"`reenrollment_delta`",{"_3475":978,"_30471":881,"_21105":52646,"_5":14473,"_27705":52398,"_2959":52647},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3475":979,"_30471":881,"_21105":52649,"_5":14473,"_27705":52398,"_2959":52650},[],"`preventive_delta`",{"_3475":980,"_30471":881,"_21105":52652,"_5":14473,"_27705":52398,"_2959":52653},[],"Preventive operational monitoring threshold.",{"_3475":981,"_30471":881,"_21105":52655,"_5":14473,"_27705":52398,"_2959":52656},[],"`critical_delta`",{"_3475":982,"_30471":881,"_21105":52658,"_5":14473,"_27705":52398,"_2959":52659},[],"Critical operational monitoring threshold.",{"_3475":983,"_30471":881,"_21105":52661,"_5":14473,"_27705":52398,"_2959":52662},[],"`enable_expired_renewal`",{"_3475":984,"_30471":881,"_21105":52664,"_5":14473,"_27705":52398,"_2959":52665},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3475":985,"_30471":881,"_21105":52667,"_5":14473,"_27705":52398,"_2959":52668},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3475":986,"_30471":881,"_21105":52670,"_5":14473,"_27705":52398,"_2959":52671},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3475":987,"_30471":881,"_21105":52673,"_5":14473,"_27705":52398,"_2959":52674},[],"`revoke_on_reenrollment`",{"_3475":988,"_30471":881,"_21105":52676,"_5":14473,"_27705":52398,"_2959":52677},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3475":989,"_30471":881,"_21105":52679,"_5":14473,"_27705":52398,"_2959":52680},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3475":990,"_30471":881,"_21105":52682,"_5":14473,"_27705":52402,"_2959":52683},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3475":991,"_30471":881,"_21105":52685,"_5":14473,"_27705":52406,"_2959":49979},[],{"_3475":992,"_30471":881,"_21105":52687,"_5":14473,"_27705":52406,"_2959":52688},[],"Published material",{"_3475":993,"_30471":881,"_21105":52690,"_5":14473,"_27705":52406,"_2959":52691},[],"**Include Lamassu System CA**",{"_3475":994,"_30471":881,"_21105":52693,"_5":14473,"_27705":52406,"_2959":52694},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3475":995,"_30471":881,"_21105":52696,"_5":14473,"_27705":52406,"_2959":52697},[],"**Include Enrollment CA**",{"_3475":996,"_30471":881,"_21105":52699,"_5":14473,"_27705":52406,"_2959":52700},[],"Selected issuing CA certificate.",{"_3475":997,"_30471":881,"_21105":52702,"_5":14473,"_27705":52406,"_2959":52703},[],"**Managed CAs**",{"_3475":998,"_30471":881,"_21105":52705,"_5":14473,"_27705":52406,"_2959":52706},[],"Explicitly selected CA certificates.",{"_3475":999,"_30471":881,"_21105":52708,"_5":14473,"_27705":52406,"_2959":52709},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3475":1000,"_30471":881,"_21105":52711,"_5":14473,"_27705":52410,"_2959":52712},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3475":1001,"_30471":881,"_21105":52714,"_5":14473,"_27705":52410,"_2959":52715},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3475":1002,"_30471":881,"_21105":52717,"_5":14473,"_27705":52410,"_2959":52718},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3475":1003,"_30471":881,"_21105":52720,"_5":14473,"_27705":52414,"_2959":52721},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3475":1004,"_30471":1004,"_5":14825,"_2959":52723,"_30823":52724,"_21105":52725,"_27705":1004},"Integrate the EST client",[49595,51070,52084,52082,52265],[],{"_3475":1005,"_30471":1004,"_21105":52727,"_5":14473,"_27705":1004,"_2959":52728},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3475":1006,"_30471":1004,"_5":30820,"_21105":52730,"_27705":52731,"_2959":49605},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3475":1007,"_30471":1004,"_5":30820,"_21105":52733,"_27705":52734,"_2959":52735},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3475":1008,"_30471":1004,"_5":30820,"_21105":52737,"_27705":52738,"_2959":52739},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3475":1009,"_30471":1004,"_5":30820,"_21105":52741,"_27705":52742,"_2959":52743},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3475":1010,"_30471":1004,"_5":30820,"_21105":52745,"_27705":52746,"_2959":52747},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3475":1011,"_30471":1004,"_5":30820,"_21105":52749,"_27705":52750,"_2959":52751},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3475":1012,"_30471":1004,"_21105":52753,"_5":14473,"_27705":1004,"_2959":52754},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3475":1013,"_30471":1004,"_21105":52756,"_5":14473,"_27705":52731,"_2959":52757},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3475":1014,"_30471":1004,"_21105":52759,"_5":14473,"_27705":52731,"_2959":52760},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3475":1015,"_30471":1004,"_21105":52762,"_5":14473,"_27705":52731,"_2959":52763},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3475":1016,"_30471":1004,"_21105":52765,"_5":14473,"_27705":52734,"_2959":52766},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3475":1017,"_30471":1004,"_21105":52768,"_5":14473,"_27705":52734,"_2959":52769},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3475":1018,"_30471":1004,"_21105":52771,"_5":14473,"_27705":52738,"_2959":52772},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3475":1019,"_30471":1004,"_21105":52774,"_5":14473,"_27705":52738,"_2959":52775},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3475":1020,"_30471":1004,"_21105":52777,"_5":14473,"_27705":52742,"_2959":52778},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3475":1021,"_30471":1004,"_21105":52780,"_5":14473,"_27705":52742,"_2959":52781},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3475":1022,"_30471":1004,"_21105":52783,"_5":14473,"_27705":52746,"_2959":52784},[],"For a root that issues directly:",{"_3475":1023,"_30471":1004,"_21105":52786,"_5":14473,"_27705":52746,"_2959":52787},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3475":1024,"_30471":1004,"_21105":52789,"_5":14473,"_27705":52746,"_2959":52790},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3475":1025,"_30471":1004,"_21105":52792,"_5":14473,"_27705":52750,"_2959":52793},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3475":1026,"_30471":1026,"_5":14825,"_2959":52795,"_30823":52796,"_21105":52797,"_27705":1026},"EST reference",[49595,51070,52084,52082,52265],[],{"_3475":1027,"_30471":1026,"_21105":52799,"_5":14473,"_27705":1026,"_2959":52800},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3475":1028,"_30471":1026,"_5":30820,"_21105":52802,"_27705":52803,"_2959":52804},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3475":1029,"_30471":1026,"_5":30820,"_21105":52806,"_27705":52807,"_2959":22871},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3475":1030,"_30471":1026,"_5":30820,"_21105":52809,"_27705":52810,"_2959":26294},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3475":1031,"_30471":1026,"_5":30820,"_21105":52812,"_27705":52813,"_2959":26301},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3475":1032,"_30471":1026,"_5":30820,"_21105":52815,"_27705":52816,"_2959":25603},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3475":1033,"_30471":1026,"_5":30820,"_21105":52818,"_27705":52819,"_2959":52820},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3475":1034,"_30471":1026,"_5":30820,"_21105":52822,"_27705":52823,"_2959":52824},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3475":1035,"_30471":1026,"_5":30820,"_21105":52826,"_27705":52827,"_2959":52828},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3475":1036,"_30471":1026,"_21105":52830,"_5":14473,"_27705":1026,"_2959":52831},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3475":1037,"_30471":1026,"_21105":52833,"_5":14473,"_27705":52803,"_2959":52834},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3475":1038,"_30471":1026,"_21105":52836,"_5":14473,"_27705":52803,"_2959":52837},[],"Operation",{"_3475":1039,"_30471":1026,"_21105":52839,"_5":14473,"_27705":52803,"_2959":52840},[],"Method",{"_3475":1040,"_30471":1026,"_21105":52842,"_5":14473,"_27705":52803,"_2959":52843},[],"Authentication and condition",{"_3475":1041,"_30471":1026,"_21105":52845,"_5":14473,"_27705":52803,"_2959":52846},[],"`/cacerts`",{"_3475":1042,"_30471":1026,"_21105":52848,"_5":14473,"_27705":52803,"_2959":52849},[],"GET",{"_3475":1043,"_30471":1026,"_21105":52851,"_5":14473,"_27705":52803,"_2959":52852},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3475":1044,"_30471":1026,"_21105":52854,"_5":14473,"_27705":52803,"_2959":52855},[],"`/simpleenroll`",{"_3475":1045,"_30471":1026,"_21105":52857,"_5":14473,"_27705":52803,"_2959":52858},[],"POST",{"_3475":1046,"_30471":1026,"_21105":52860,"_5":14473,"_27705":52803,"_2959":52861},[],"Initial authentication and DMS registration/replacement policy.",{"_3475":1047,"_30471":1026,"_21105":52863,"_5":14473,"_27705":52803,"_2959":52864},[],"`/simplereenroll`",{"_3475":1048,"_30471":1026,"_21105":52866,"_5":14473,"_27705":52803,"_2959":52858},[],{"_3475":1049,"_30471":1026,"_21105":52868,"_5":14473,"_27705":52803,"_2959":52869},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3475":1050,"_30471":1026,"_21105":52871,"_5":14473,"_27705":52803,"_2959":52872},[],"`/serverkeygen`",{"_3475":1051,"_30471":1026,"_21105":52874,"_5":14473,"_27705":52803,"_2959":52858},[],{"_3475":1052,"_30471":1026,"_21105":52876,"_5":14473,"_27705":52803,"_2959":52877},[],"Initial authentication and admission; server generation enabled.",{"_3475":1053,"_30471":1026,"_21105":52879,"_5":14473,"_27705":52803,"_2959":52880},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3475":1054,"_30471":1026,"_21105":52882,"_5":14473,"_27705":52807,"_2959":52883},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3475":1055,"_30471":1026,"_21105":52885,"_5":14473,"_27705":52807,"_2959":52886},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3475":1056,"_30471":1026,"_21105":52888,"_5":14473,"_27705":52810,"_2959":52889},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3475":1057,"_30471":1026,"_21105":52891,"_5":14473,"_27705":52810,"_2959":52892},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3475":1058,"_30471":1026,"_21105":52894,"_5":14473,"_27705":52813,"_2959":52895},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3475":1059,"_30471":1026,"_21105":52897,"_5":14473,"_27705":52813,"_2959":52898},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3475":1060,"_30471":1026,"_21105":52900,"_5":14473,"_27705":52816,"_2959":52901},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3475":1061,"_30471":1026,"_21105":52903,"_5":14473,"_27705":52816,"_2959":52904},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3475":1062,"_30471":1026,"_21105":52906,"_5":14473,"_27705":52819,"_2959":52907},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3475":1063,"_30471":1026,"_21105":52909,"_5":14473,"_27705":52819,"_2959":52910},[],"Part",{"_3475":1064,"_30471":1026,"_21105":52912,"_5":14473,"_27705":52819,"_2959":52913},[],"Content after decoding its Base64",{"_3475":1065,"_30471":1026,"_21105":52915,"_5":14473,"_27705":52819,"_2959":52916},[],"`application/pkcs8`",{"_3475":1066,"_30471":1026,"_21105":52918,"_5":14473,"_27705":52819,"_2959":52919},[],"Unencrypted DER PKCS#8 private key.",{"_3475":1067,"_30471":1026,"_21105":52921,"_5":14473,"_27705":52819,"_2959":52922},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3475":1068,"_30471":1026,"_21105":52924,"_5":14473,"_27705":52819,"_2959":52925},[],"DER PKCS#7 containing the issued certificate.",{"_3475":1069,"_30471":1026,"_21105":52927,"_5":14473,"_27705":52819,"_2959":52928},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3475":1070,"_30471":1026,"_21105":52930,"_5":14473,"_27705":52823,"_2959":52931},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3475":1071,"_30471":1026,"_21105":52933,"_5":14473,"_27705":52823,"_2959":52934},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3475":1072,"_30471":1026,"_21105":52936,"_5":14473,"_27705":52823,"_2959":52937},[],"Convert and check the result:",{"_3475":1073,"_30471":1026,"_21105":52939,"_5":14473,"_27705":52823,"_2959":52940},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3475":1074,"_30471":1026,"_21105":52942,"_5":14473,"_27705":52827,"_2959":52943},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3475":1075,"_30471":1026,"_21105":52945,"_5":14473,"_27705":52827,"_2959":52946},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3475":1076,"_30471":1076,"_5":14825,"_2959":52265,"_30823":52948,"_21105":52949,"_27705":1076},[49595,51070,52084,52082,52265],[],{"_3475":1077,"_30471":1076,"_21105":52951,"_5":14473,"_27705":1076,"_2959":52952},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3475":1078,"_30471":1076,"_5":30820,"_21105":52954,"_27705":52955,"_2959":52956},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3475":1079,"_30471":1076,"_5":30820,"_21105":52958,"_27705":52959,"_2959":52960},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3475":1080,"_30471":1076,"_5":30820,"_21105":52962,"_27705":52963,"_2959":52964},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3475":1081,"_30471":1076,"_5":30820,"_21105":52966,"_27705":52967,"_2959":52968},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3475":1082,"_30471":1076,"_21105":52970,"_5":14473,"_27705":1076,"_2959":52971},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3475":1083,"_30471":1076,"_21105":52973,"_5":14473,"_27705":52955,"_2959":52974},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3475":1084,"_30471":1076,"_21105":52976,"_5":14473,"_27705":52955,"_2959":52977},[],"The integrator installs initial EST server trust and an admission credential.",{"_3475":1085,"_30471":1076,"_21105":52979,"_5":14473,"_27705":52955,"_2959":52980},[],"The client requests an identity for its `Device ID` through EST.",{"_3475":1086,"_30471":1076,"_21105":52982,"_5":14473,"_27705":52955,"_2959":52983},[],"Certificate, device binding and key/certificate installation are checked.",{"_3475":1087,"_30471":1076,"_21105":52985,"_5":14473,"_27705":52955,"_2959":52986},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3475":1088,"_30471":1076,"_21105":52988,"_5":14473,"_27705":52955,"_2959":52989},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3475":1089,"_30471":1076,"_21105":52991,"_5":14473,"_27705":52959,"_2959":52992},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3475":1090,"_30471":1076,"_21105":52994,"_5":14473,"_27705":52959,"_2959":52995},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":1091,"_30471":1076,"_21105":52997,"_5":14473,"_27705":52959,"_2959":52998},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3475":1092,"_30471":1076,"_21105":53000,"_5":14473,"_27705":52959,"_2959":53001},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3475":1093,"_30471":1076,"_21105":53003,"_5":14473,"_27705":52963,"_2959":53004},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3475":1094,"_30471":1076,"_21105":53006,"_5":14473,"_27705":52963,"_2959":53007},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3475":1095,"_30471":1076,"_21105":53009,"_5":14473,"_27705":52963,"_2959":53010},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3475":1096,"_30471":1076,"_21105":53012,"_5":14473,"_27705":52963,"_2959":53013},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3475":1097,"_30471":1076,"_21105":53015,"_5":14473,"_27705":52967,"_2959":53016},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3475":1098,"_30471":1076,"_21105":53018,"_5":14473,"_27705":52967,"_2959":53019},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3475":1099,"_30471":1099,"_5":14825,"_2959":53021,"_30823":53022,"_21105":53023,"_27705":1099},"Provisioning strategies",[49595,51070,52084,52082,52265],[],{"_3475":1100,"_30471":1099,"_21105":53025,"_5":14473,"_27705":1099,"_2959":53026},[],"Choose device registration, identity authorization and key generation.",{"_3475":1101,"_30471":1099,"_5":30820,"_21105":53028,"_27705":53029,"_2959":53030},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3475":1102,"_30471":1099,"_5":30820,"_21105":53032,"_27705":53033,"_2959":53034},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3475":1103,"_30471":1099,"_5":30820,"_21105":53036,"_27705":53037,"_2959":53038},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3475":1104,"_30471":1099,"_5":30820,"_21105":53040,"_27705":53041,"_2959":53042},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3475":1105,"_30471":1099,"_5":30820,"_21105":53044,"_27705":53045,"_2959":53046},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3475":1106,"_30471":1099,"_21105":53048,"_5":14473,"_27705":1099,"_2959":53049},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3475":1107,"_30471":1099,"_21105":53051,"_5":14473,"_27705":53029,"_2959":53052},[],"Path",{"_3475":1108,"_30471":1099,"_21105":53054,"_5":14473,"_27705":53029,"_2959":53055},[],"When the device exists",{"_3475":1109,"_30471":1099,"_21105":53057,"_5":14473,"_27705":53029,"_2959":53058},[],"What to check",{"_3475":1110,"_30471":1099,"_21105":53060,"_5":14473,"_27705":53029,"_2959":53061},[],"Manual assignment",{"_3475":1111,"_30471":1099,"_21105":53063,"_5":14473,"_27705":53029,"_2959":53064},[],"An operator creates it before associating a certificate.",{"_3475":1112,"_30471":1099,"_21105":53066,"_5":14473,"_27705":53029,"_2959":53067},[],"ID, owning DMS, certificate CN and bound serial.",{"_3475":1113,"_30471":1099,"_21105":53069,"_5":14473,"_27705":53029,"_2959":53070},[],"EST with `JITP`",{"_3475":1114,"_30471":1099,"_21105":53072,"_5":14473,"_27705":53029,"_2959":53073},[],"Created for an unknown CN during `/simpleenroll`.",{"_3475":1115,"_30471":1099,"_21105":53075,"_5":14473,"_27705":53029,"_2959":53076},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3475":1116,"_30471":1099,"_21105":53078,"_5":14473,"_27705":53029,"_2959":53079},[],"EST with `PRE_REGISTRATION`",{"_3475":1117,"_30471":1099,"_21105":53081,"_5":14473,"_27705":53029,"_2959":53082},[],"Must exist before `/simpleenroll`.",{"_3475":1118,"_30471":1099,"_21105":53084,"_5":14473,"_27705":53029,"_2959":53085},[],"Approved record, same DMS and replacement conditions for your version.",{"_3475":1119,"_30471":1099,"_21105":53087,"_5":14473,"_27705":53029,"_2959":53088},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3475":1120,"_30471":1099,"_21105":53090,"_5":14473,"_27705":53029,"_2959":53091},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3475":1121,"_30471":1099,"_21105":53093,"_5":14473,"_27705":53033,"_2959":53094},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3475":1122,"_30471":1099,"_21105":53096,"_5":14473,"_27705":53033,"_2959":53097},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3475":1123,"_30471":1099,"_21105":53099,"_5":14473,"_27705":53033,"_2959":53100},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3475":1124,"_30471":1099,"_21105":53102,"_5":14473,"_27705":53037,"_2959":53103},[],"Decide initial enrollment and re-enrollment separately:",{"_3475":1125,"_30471":1099,"_21105":53105,"_5":14473,"_27705":53037,"_2959":53106},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3475":1126,"_30471":1099,"_21105":53108,"_5":14473,"_27705":53037,"_2959":53109},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3475":1127,"_30471":1099,"_21105":53111,"_5":14473,"_27705":53037,"_2959":53112},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3475":1128,"_30471":1099,"_21105":53114,"_5":14473,"_27705":53037,"_2959":53115},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3475":1129,"_30471":1099,"_21105":53117,"_5":14473,"_27705":53037,"_2959":53118},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3475":1130,"_30471":1099,"_21105":53120,"_5":14473,"_27705":53041,"_2959":49979},[],{"_3475":1131,"_30471":1099,"_21105":53122,"_5":14473,"_27705":53041,"_2959":53123},[],"Material crossing EST",{"_3475":1132,"_30471":1099,"_21105":53125,"_5":14473,"_27705":53041,"_2959":53126},[],"Device-generated key",{"_3475":1133,"_30471":1099,"_21105":53128,"_5":14473,"_27705":53041,"_2959":53129},[],"Public CSR and certificate; the key stays on the client.",{"_3475":1134,"_30471":1099,"_21105":53131,"_5":14473,"_27705":53041,"_2959":53132},[],"Existing device key",{"_3475":1135,"_30471":1099,"_21105":53134,"_5":14473,"_27705":53041,"_2959":53135},[],"CSR signed with that key and a new certificate.",{"_3475":1136,"_30471":1099,"_21105":53137,"_5":14473,"_27705":53041,"_2959":52403},[],{"_3475":1137,"_30471":1099,"_21105":53139,"_5":14473,"_27705":53041,"_2959":53140},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3475":1138,"_30471":1099,"_21105":53142,"_5":14473,"_27705":53041,"_2959":53143},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3475":1139,"_30471":1099,"_21105":53145,"_5":14473,"_27705":53045,"_2959":53146},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3475":1140,"_30471":1140,"_5":14825,"_2959":53148,"_30823":53149,"_21105":53150,"_27705":1140},"Renewal and recovery",[49595,51070,52084,52082,52265],[],{"_3475":1141,"_30471":1140,"_21105":53152,"_5":14473,"_27705":1140,"_2959":53153},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3475":1142,"_30471":1140,"_5":30820,"_21105":53155,"_27705":53156,"_2959":53157},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3475":1143,"_30471":1140,"_5":30820,"_21105":53159,"_27705":53160,"_2959":53161},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3475":1144,"_30471":1140,"_5":30820,"_21105":53163,"_27705":53164,"_2959":53165},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3475":1145,"_30471":1140,"_5":30820,"_21105":53167,"_27705":53168,"_2959":53169},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3475":1146,"_30471":1140,"_5":30820,"_21105":53171,"_27705":53172,"_2959":53173},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3475":1147,"_30471":1140,"_21105":53175,"_5":14473,"_27705":1140,"_2959":53176},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3475":1148,"_30471":1140,"_21105":53178,"_5":14473,"_27705":53156,"_2959":53179},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3475":1149,"_30471":1140,"_21105":53181,"_5":14473,"_27705":53156,"_2959":53182},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3475":1150,"_30471":1140,"_21105":53184,"_5":14473,"_27705":53156,"_2959":53185},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3475":1151,"_30471":1140,"_21105":53187,"_5":14473,"_27705":53156,"_2959":53188},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3475":1152,"_30471":1140,"_21105":53190,"_5":14473,"_27705":53160,"_2959":53191},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3475":1153,"_30471":1140,"_21105":53193,"_5":14473,"_27705":53160,"_2959":53194},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3475":1154,"_30471":1140,"_21105":53196,"_5":14473,"_27705":53164,"_2959":53197},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3475":1155,"_30471":1140,"_21105":53199,"_5":14473,"_27705":53164,"_2959":53200},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3475":1156,"_30471":1140,"_21105":53202,"_5":14473,"_27705":53164,"_2959":53203},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3475":1157,"_30471":1140,"_21105":53205,"_5":14473,"_27705":53168,"_2959":53206},[],"Situation",{"_3475":1158,"_30471":1140,"_21105":53208,"_5":14473,"_27705":53168,"_2959":53209},[],"Procedure",{"_3475":1159,"_30471":1140,"_21105":53211,"_5":14473,"_27705":53168,"_2959":53212},[],"Valid certificate, outside the window",{"_3475":1160,"_30471":1140,"_21105":53214,"_5":14473,"_27705":53168,"_2959":53215},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3475":1161,"_30471":1140,"_21105":53217,"_5":14473,"_27705":53168,"_2959":53218},[],"Expired certificate, key available",{"_3475":1162,"_30471":1140,"_21105":53220,"_5":14473,"_27705":53168,"_2959":53221},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3475":1163,"_30471":1140,"_21105":53223,"_5":14473,"_27705":53168,"_2959":53224},[],"Renewal through webhook or `NO_AUTH`",{"_3475":1164,"_30471":1140,"_21105":53226,"_5":14473,"_27705":53168,"_2959":53227},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3475":1165,"_30471":1140,"_21105":53229,"_5":14473,"_27705":53168,"_2959":53230},[],"Lost or inaccessible key",{"_3475":1166,"_30471":1140,"_21105":53232,"_5":14473,"_27705":53168,"_2959":53233},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3475":1167,"_30471":1140,"_21105":53235,"_5":14473,"_27705":53168,"_2959":53236},[],"Current identity revoked",{"_3475":1168,"_30471":1140,"_21105":53238,"_5":14473,"_27705":53168,"_2959":53239},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3475":1169,"_30471":1140,"_21105":53241,"_5":14473,"_27705":53168,"_2959":53242},[],"Device without an identity",{"_3475":1170,"_30471":1140,"_21105":53244,"_5":14473,"_27705":53168,"_2959":53245},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3475":1171,"_30471":1140,"_21105":53247,"_5":14473,"_27705":53168,"_2959":53248},[],"Retired device",{"_3475":1172,"_30471":1140,"_21105":53250,"_5":14473,"_27705":53168,"_2959":53251},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3475":1173,"_30471":1140,"_21105":53253,"_5":14473,"_27705":53168,"_2959":53254},[],"Timeout, HTTP 500 or installation failure",{"_3475":1174,"_30471":1140,"_21105":53256,"_5":14473,"_27705":53168,"_2959":53257},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3475":1175,"_30471":1140,"_21105":53259,"_5":14473,"_27705":53172,"_2959":53260},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3475":1176,"_30471":1140,"_21105":53262,"_5":14473,"_27705":53172,"_2959":53263},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3475":1177,"_30471":1177,"_5":14825,"_2959":53265,"_30823":53266,"_21105":53267,"_27705":1177},"Enrollment troubleshooting",[49595,51070,52084,52082,52265],[],{"_3475":1178,"_30471":1177,"_21105":53269,"_5":14473,"_27705":1177,"_2959":53270},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3475":1179,"_30471":1177,"_5":30820,"_21105":53272,"_27705":53273,"_2959":53274},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3475":1180,"_30471":1177,"_5":30820,"_21105":53276,"_27705":53277,"_2959":53278},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3475":1181,"_30471":1177,"_5":30820,"_21105":53280,"_27705":53281,"_2959":52828},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3475":1182,"_30471":1177,"_5":30820,"_21105":53283,"_27705":53284,"_2959":53285},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3475":1183,"_30471":1177,"_21105":53287,"_5":14473,"_27705":1177,"_2959":53288},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3475":1184,"_30471":1177,"_21105":53290,"_5":14473,"_27705":53277,"_2959":53291},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3475":1185,"_30471":1177,"_21105":53293,"_5":14473,"_27705":53277,"_2959":53294},[],"Symptom or message",{"_3475":1186,"_30471":1177,"_21105":53296,"_5":14473,"_27705":53277,"_2959":53058},[],{"_3475":1187,"_30471":1177,"_21105":53298,"_5":14473,"_27705":53277,"_2959":53299},[],"curl rejects TLS, name or issuer",{"_3475":1188,"_30471":1177,"_21105":53301,"_5":14473,"_27705":53277,"_2959":53302},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3475":1189,"_30471":1177,"_21105":53304,"_5":14473,"_27705":53277,"_2959":53305},[],"404 or missing APS",{"_3475":1190,"_30471":1177,"_21105":53307,"_5":14473,"_27705":53277,"_2959":53308},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3475":1191,"_30471":1177,"_21105":53310,"_5":14473,"_27705":53277,"_2959":53311},[],"400, CSR or format error",{"_3475":1192,"_30471":1177,"_21105":53313,"_5":14473,"_27705":53277,"_2959":53314},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3475":1193,"_30471":1177,"_21105":53316,"_5":14473,"_27705":53277,"_2959":53317},[],"Missing credential or invalid certificate",{"_3475":1194,"_30471":1177,"_21105":53319,"_5":14473,"_27705":53277,"_2959":53320},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3475":1195,"_30471":1177,"_21105":53322,"_5":14473,"_27705":53277,"_2959":53323},[],"Webhook denies, times out or responds without authorization",{"_3475":1196,"_30471":1177,"_21105":53325,"_5":14473,"_27705":53277,"_2959":53326},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3475":1197,"_30471":1177,"_21105":53328,"_5":14473,"_27705":53277,"_2959":53329},[],"`unexpected status code: <n>: redirects are not followed`",{"_3475":1198,"_30471":1177,"_21105":53331,"_5":14473,"_27705":53277,"_2959":53332},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3475":1199,"_30471":1177,"_21105":53334,"_5":14473,"_27705":53277,"_2959":53335},[],"`webhook response exceeds 1048576 bytes`",{"_3475":1200,"_30471":1177,"_21105":53337,"_5":14473,"_27705":53277,"_2959":53338},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3475":1201,"_30471":1177,"_21105":53340,"_5":14473,"_27705":53277,"_2959":53341},[],"`webhook config must not reference files`",{"_3475":1202,"_30471":1177,"_21105":53343,"_5":14473,"_27705":53277,"_2959":53344},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3475":1203,"_30471":1177,"_21105":53346,"_5":14473,"_27705":53277,"_2959":53347},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3475":1204,"_30471":1177,"_21105":53349,"_5":14473,"_27705":53277,"_2959":53350},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3475":1205,"_30471":1177,"_21105":53352,"_5":14473,"_27705":53277,"_2959":53353},[],"`webhook mTLS certificate and key are invalid: …`",{"_3475":1206,"_30471":1177,"_21105":53355,"_5":14473,"_27705":53277,"_2959":53356},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3475":1207,"_30471":1177,"_21105":53358,"_5":14473,"_27705":53277,"_2959":53359},[],"400 `struct validation error` creating or updating a DMS",{"_3475":1208,"_30471":1177,"_21105":53361,"_5":14473,"_27705":53277,"_2959":53362},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3475":1209,"_30471":1177,"_21105":53364,"_5":14473,"_27705":53277,"_2959":53365},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3475":1210,"_30471":1177,"_21105":53367,"_5":14473,"_27705":53277,"_2959":53368},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3475":1211,"_30471":1177,"_21105":53370,"_5":14473,"_27705":53277,"_2959":53371},[],"`device not preregistered`",{"_3475":1212,"_30471":1177,"_21105":53373,"_5":14473,"_27705":53277,"_2959":53374},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3475":1213,"_30471":1177,"_21105":53376,"_5":14473,"_27705":53277,"_2959":53377},[],"`forbiddenNewEnrollment`",{"_3475":1214,"_30471":1177,"_21105":53379,"_5":14473,"_27705":53277,"_2959":53380},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3475":1215,"_30471":1177,"_21105":53382,"_5":14473,"_27705":53277,"_2959":53383},[],"Different owning DMS",{"_3475":1216,"_30471":1177,"_21105":53385,"_5":14473,"_27705":53277,"_2959":53386},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3475":1217,"_30471":1177,"_21105":53388,"_5":14473,"_27705":53277,"_2959":53389},[],"`invalid RawSubject bytes`",{"_3475":1218,"_30471":1177,"_21105":53391,"_5":14473,"_27705":53277,"_2959":53392},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3475":1219,"_30471":1177,"_21105":53394,"_5":14473,"_27705":53277,"_2959":53395},[],"`invalid reenroll window`",{"_3475":1220,"_30471":1177,"_21105":53397,"_5":14473,"_27705":53277,"_2959":53398},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3475":1221,"_30471":1177,"_21105":53400,"_5":14473,"_27705":53277,"_2959":53401},[],"Current certificate revoked",{"_3475":1222,"_30471":1177,"_21105":53403,"_5":14473,"_27705":53277,"_2959":53404},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3475":1223,"_30471":1177,"_21105":53406,"_5":14473,"_27705":53277,"_2959":53407},[],"CA, profile or signing error",{"_3475":1224,"_30471":1177,"_21105":53409,"_5":14473,"_27705":53277,"_2959":53410},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3475":1225,"_30471":1177,"_21105":53412,"_5":14473,"_27705":53277,"_2959":53413},[],"HTTP 200 without a device connection",{"_3475":1226,"_30471":1177,"_21105":53415,"_5":14473,"_27705":53277,"_2959":53416},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3475":1227,"_30471":1177,"_21105":53418,"_5":14473,"_27705":53277,"_2959":53419},[],"Timeout or error after issuance",{"_3475":1228,"_30471":1177,"_21105":53421,"_5":14473,"_27705":53277,"_2959":53422},[],"New certificates, current slot and previous identity's state before retrying.",{"_3475":1229,"_30471":1177,"_21105":53424,"_5":14473,"_27705":53281,"_2959":53425},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3475":1230,"_30471":1177,"_21105":53427,"_5":14473,"_27705":53281,"_2959":53428},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3475":1231,"_30471":1177,"_21105":53430,"_5":14473,"_27705":53284,"_2959":53431},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3475":1232,"_30471":1177,"_21105":53433,"_5":14473,"_27705":53284,"_2959":53434},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3475":1233,"_30471":1177,"_21105":53436,"_5":14473,"_27705":53284,"_2959":53437},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3475":1234,"_30471":1177,"_21105":53439,"_5":14473,"_27705":53284,"_2959":53440},[],"Make one request, save headers/body and query the device and certificates.",{"_3475":1235,"_30471":1177,"_21105":53442,"_5":14473,"_27705":53284,"_2959":53443},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3475":1236,"_30471":1177,"_21105":53445,"_5":14473,"_27705":53284,"_2959":53446},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3475":1237,"_30471":1177,"_21105":53448,"_5":14473,"_27705":53284,"_2959":53449},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3475":1238,"_30471":1238,"_5":14825,"_2959":53451,"_30823":53452,"_21105":53453,"_27705":1238},"Trust distribution and updates",[49595,51070,52084,52082,52265],[],{"_3475":1239,"_30471":1238,"_21105":53455,"_5":14473,"_27705":1238,"_2959":53456},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3475":1240,"_30471":1238,"_5":30820,"_21105":53458,"_27705":53459,"_2959":53460},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3475":1241,"_30471":1238,"_5":30820,"_21105":53462,"_27705":53463,"_2959":53464},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3475":1242,"_30471":1238,"_5":30820,"_21105":53466,"_27705":53467,"_2959":53468},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3475":1243,"_30471":1238,"_5":30820,"_21105":53470,"_27705":53471,"_2959":53472},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3475":1244,"_30471":1238,"_5":30820,"_21105":53474,"_27705":53475,"_2959":53476},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3475":1245,"_30471":1238,"_21105":53478,"_5":14473,"_27705":1238,"_2959":53479},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3475":1246,"_30471":1238,"_21105":53481,"_5":14473,"_27705":53459,"_2959":53482},[],"Relationship",{"_3475":1247,"_30471":1238,"_21105":53484,"_5":14473,"_27705":53459,"_2959":53485},[],"Material prepared by its owner",{"_3475":1248,"_30471":1238,"_21105":53487,"_5":14473,"_27705":53459,"_2959":53488},[],"Device → EST server",{"_3475":1249,"_30471":1238,"_21105":53490,"_5":14473,"_27705":53459,"_2959":53491},[],"Previously verified server root, chain or pin and TLS name.",{"_3475":1250,"_30471":1238,"_21105":53493,"_5":14473,"_27705":53459,"_2959":53494},[],"DMS → requester",{"_3475":1251,"_30471":1238,"_21105":53496,"_5":14473,"_27705":53459,"_2959":53497},[],"CAs and rules authorizing initial or renewal credentials.",{"_3475":1252,"_30471":1238,"_21105":53499,"_5":14473,"_27705":53459,"_2959":53500},[],"Consumer → device",{"_3475":1253,"_30471":1238,"_21105":53502,"_5":14473,"_27705":53459,"_2959":53503},[],"Operational identity roots, intermediates, validation and permissions.",{"_3475":1254,"_30471":1238,"_21105":53505,"_5":14473,"_27705":53459,"_2959":53506},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3475":1255,"_30471":1238,"_21105":53508,"_5":14473,"_27705":53463,"_2959":53509},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3475":1256,"_30471":1238,"_21105":53511,"_5":14473,"_27705":53463,"_2959":53512},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3475":1257,"_30471":1238,"_21105":53514,"_5":14473,"_27705":53467,"_2959":53515},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3475":1258,"_30471":1238,"_21105":53517,"_5":14473,"_27705":53467,"_2959":53518},[],"Select policy-approved roots as anchors.",{"_3475":1259,"_30471":1238,"_21105":53520,"_5":14473,"_27705":53467,"_2959":53521},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3475":1260,"_30471":1238,"_21105":53523,"_5":14473,"_27705":53467,"_2959":53524},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3475":1261,"_30471":1238,"_21105":53526,"_5":14473,"_27705":53467,"_2959":53527},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3475":1262,"_30471":1238,"_21105":53529,"_5":14473,"_27705":53467,"_2959":53530},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3475":1263,"_30471":1238,"_21105":53532,"_5":14473,"_27705":53471,"_2959":53533},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3475":1264,"_30471":1238,"_21105":53535,"_5":14473,"_27705":53471,"_2959":53536},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3475":1265,"_30471":1238,"_21105":53538,"_5":14473,"_27705":53471,"_2959":53539},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3475":1266,"_30471":1238,"_21105":53541,"_5":14473,"_27705":53475,"_2959":53542},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3475":1267,"_30471":1267,"_5":14825,"_2959":53544,"_30823":53545,"_21105":53547,"_27705":1267},"AWS IoT Core",[49595,51070,52084,52082,53546],"Integrations",[],{"_3475":1268,"_30471":1267,"_21105":53549,"_5":14473,"_27705":1267,"_2959":53550},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3475":1269,"_30471":1267,"_5":30820,"_21105":53552,"_27705":53553,"_2959":53554},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3475":1270,"_30471":1267,"_5":30820,"_21105":53556,"_27705":53557,"_2959":53558},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3475":1271,"_30471":1267,"_5":30820,"_21105":53560,"_27705":53561,"_2959":53562},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3475":1272,"_30471":1267,"_5":30820,"_21105":53564,"_27705":53565,"_2959":53566},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3475":1273,"_30471":1267,"_5":30820,"_21105":53568,"_27705":53569,"_2959":53570},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3475":1274,"_30471":1267,"_5":30820,"_21105":53572,"_27705":53573,"_2959":53574},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3475":1275,"_30471":1267,"_5":30820,"_21105":53576,"_27705":53577,"_2959":53578},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3475":1276,"_30471":1267,"_5":30820,"_21105":53580,"_27705":53581,"_2959":53582},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3475":1277,"_30471":1267,"_5":30820,"_21105":53584,"_27705":53585,"_2959":53586},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3475":1278,"_30471":1267,"_5":30820,"_21105":53588,"_27705":53589,"_2959":53590},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3475":1279,"_30471":1267,"_5":30820,"_21105":53592,"_27705":53593,"_2959":53594},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3475":1280,"_30471":1267,"_5":30820,"_21105":53596,"_27705":53597,"_2959":53598},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3475":1281,"_30471":1267,"_5":30820,"_21105":53600,"_27705":53601,"_2959":53602},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3475":1282,"_30471":1267,"_5":30820,"_21105":53604,"_27705":53605,"_2959":53606},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3475":1283,"_30471":1267,"_5":30820,"_21105":53608,"_27705":53609,"_2959":53610},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3475":1284,"_30471":1267,"_5":30820,"_21105":53612,"_27705":53613,"_2959":53614},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3475":1285,"_30471":1267,"_5":30820,"_21105":53616,"_27705":53617,"_2959":53618},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3475":1286,"_30471":1267,"_5":30820,"_21105":53620,"_27705":53621,"_2959":53622},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3475":1287,"_30471":1267,"_5":30820,"_21105":53624,"_27705":53625,"_2959":53626},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3475":1288,"_30471":1267,"_5":30820,"_21105":53628,"_27705":53629,"_2959":53630},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3475":1289,"_30471":1267,"_5":30820,"_21105":53632,"_27705":53633,"_2959":53634},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3475":1290,"_30471":1267,"_5":30820,"_21105":53636,"_27705":53637,"_2959":53638},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3475":1291,"_30471":1267,"_5":30820,"_21105":53640,"_27705":53641,"_2959":53642},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3475":1292,"_30471":1267,"_5":30820,"_21105":53644,"_27705":53645,"_2959":53646},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3475":1293,"_30471":1267,"_5":30820,"_21105":53648,"_27705":53649,"_2959":53650},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3475":1294,"_30471":1267,"_21105":53652,"_5":14473,"_27705":1267,"_2959":53653},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3475":1295,"_30471":1267,"_21105":53655,"_5":14473,"_27705":1267,"_2959":53656},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3475":1296,"_30471":1267,"_21105":53658,"_5":14473,"_27705":1267,"_2959":53659},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3475":1297,"_30471":1267,"_21105":53661,"_5":14473,"_27705":53553,"_2959":53662},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3475":1298,"_30471":1267,"_21105":53664,"_5":14473,"_27705":53553,"_2959":53665},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3475":1299,"_30471":1267,"_21105":53667,"_5":14473,"_27705":53553,"_2959":53668},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3475":1300,"_30471":1267,"_21105":53670,"_5":14473,"_27705":53553,"_2959":53671},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3475":1301,"_30471":1267,"_21105":53673,"_5":14473,"_27705":53557,"_2959":53674},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3475":1302,"_30471":1267,"_21105":53676,"_5":14473,"_27705":53561,"_2959":53677},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3475":1303,"_30471":1267,"_21105":53679,"_5":14473,"_27705":53561,"_2959":53680},[],"IAM action",{"_3475":1304,"_30471":1267,"_21105":53682,"_5":14473,"_27705":53561,"_2959":49985},[],{"_3475":1305,"_30471":1267,"_21105":53684,"_5":14473,"_27705":53561,"_2959":53685},[],"`iot:GetRegistrationCode`",{"_3475":1306,"_30471":1267,"_21105":53687,"_5":14473,"_27705":53561,"_2959":53688},[],"Obtain the verification code for CA registration in the Primary Account",{"_3475":1307,"_30471":1267,"_21105":53690,"_5":14473,"_27705":53561,"_2959":53691},[],"`iot:RegisterCACertificate`",{"_3475":1308,"_30471":1267,"_21105":53693,"_5":14473,"_27705":53561,"_2959":53694},[],"Register the CA in AWS IoT",{"_3475":1309,"_30471":1267,"_21105":53696,"_5":14473,"_27705":53561,"_2959":53697},[],"`iot:DescribeCACertificate`",{"_3475":1310,"_30471":1267,"_21105":53699,"_5":14473,"_27705":53561,"_2959":53700},[],"Check the CA registration status",{"_3475":1311,"_30471":1267,"_21105":53702,"_5":14473,"_27705":53561,"_2959":53703},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3475":1312,"_30471":1267,"_21105":53705,"_5":14473,"_27705":53561,"_2959":53706},[],"Create or update Things in IoT Core",{"_3475":1313,"_30471":1267,"_21105":53708,"_5":14473,"_27705":53561,"_2959":53709},[],"`iot:RegisterThing`",{"_3475":1314,"_30471":1267,"_21105":53711,"_5":14473,"_27705":53561,"_2959":53712},[],"Provision Things through a template",{"_3475":1315,"_30471":1267,"_21105":53714,"_5":14473,"_27705":53561,"_2959":53715},[],"`iot:RegisterCertificate`",{"_3475":1316,"_30471":1267,"_21105":53717,"_5":14473,"_27705":53561,"_2959":53718},[],"Register device certificates",{"_3475":1317,"_30471":1267,"_21105":53720,"_5":14473,"_27705":53561,"_2959":53721},[],"`iot:UpdateCertificate`",{"_3475":1318,"_30471":1267,"_21105":53723,"_5":14473,"_27705":53561,"_2959":53724},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3475":1319,"_30471":1267,"_21105":53726,"_5":14473,"_27705":53561,"_2959":53727},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3475":1320,"_30471":1267,"_21105":53729,"_5":14473,"_27705":53561,"_2959":53730},[],"Create and attach IoT policies",{"_3475":1321,"_30471":1267,"_21105":53732,"_5":14473,"_27705":53561,"_2959":53733},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3475":1322,"_30471":1267,"_21105":53735,"_5":14473,"_27705":53561,"_2959":53736},[],"Manage Thing groups",{"_3475":1323,"_30471":1267,"_21105":53738,"_5":14473,"_27705":53561,"_2959":53739},[],"`iot:CreateProvisioningTemplate`",{"_3475":1324,"_30471":1267,"_21105":53741,"_5":14473,"_27705":53561,"_2959":53742},[],"Create JITP templates",{"_3475":1325,"_30471":1267,"_21105":53744,"_5":14473,"_27705":53561,"_2959":53745},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3475":1326,"_30471":1267,"_21105":53747,"_5":14473,"_27705":53561,"_2959":53748},[],"Read and write the Device Shadow",{"_3475":1327,"_30471":1267,"_21105":53750,"_5":14473,"_27705":53561,"_2959":53751},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3475":1328,"_30471":1267,"_21105":53753,"_5":14473,"_27705":53565,"_2959":53754},[],"Parameter",{"_3475":1329,"_30471":1267,"_21105":53756,"_5":14473,"_27705":53565,"_2959":53757},[],"Type",{"_3475":1330,"_30471":1267,"_21105":53759,"_5":14473,"_27705":53565,"_2959":53760},[],"Required",{"_3475":1331,"_30471":1267,"_21105":53762,"_5":14473,"_27705":53565,"_2959":53763},[],"Description",{"_3475":1332,"_30471":1267,"_21105":53765,"_5":14473,"_27705":53565,"_2959":53766},[],"`connector_id`",{"_3475":1333,"_30471":1267,"_21105":53768,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1334,"_30471":1267,"_21105":53770,"_5":14473,"_27705":53565,"_2959":53771},[],"Yes",{"_3475":1335,"_30471":1267,"_21105":53773,"_5":14473,"_27705":53565,"_2959":53774},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3475":1336,"_30471":1267,"_21105":53776,"_5":14473,"_27705":53565,"_2959":53777},[],"`aws_config.region`",{"_3475":1337,"_30471":1267,"_21105":53779,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1338,"_30471":1267,"_21105":53781,"_5":14473,"_27705":53565,"_2959":53771},[],{"_3475":1339,"_30471":1267,"_21105":53783,"_5":14473,"_27705":53565,"_2959":53784},[],"AWS region where the connector operates.",{"_3475":1340,"_30471":1267,"_21105":53786,"_5":14473,"_27705":53565,"_2959":53787},[],"`aws_config.auth_method`",{"_3475":1341,"_30471":1267,"_21105":53789,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1342,"_30471":1267,"_21105":53791,"_5":14473,"_27705":53565,"_2959":53771},[],{"_3475":1343,"_30471":1267,"_21105":53793,"_5":14473,"_27705":53565,"_2959":53794},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3475":1344,"_30471":1267,"_21105":53796,"_5":14473,"_27705":53565,"_2959":53797},[],"`aws_config.access_key_id`",{"_3475":1345,"_30471":1267,"_21105":53799,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1346,"_30471":1267,"_21105":53801,"_5":14473,"_27705":53565,"_2959":53802},[],"Only with `auth_method=static`",{"_3475":1347,"_30471":1267,"_21105":53804,"_5":14473,"_27705":53565,"_2959":53805},[],"AWS access key.",{"_3475":1348,"_30471":1267,"_21105":53807,"_5":14473,"_27705":53565,"_2959":53808},[],"`aws_config.secret_access_key`",{"_3475":1349,"_30471":1267,"_21105":53810,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1350,"_30471":1267,"_21105":53812,"_5":14473,"_27705":53565,"_2959":53802},[],{"_3475":1351,"_30471":1267,"_21105":53814,"_5":14473,"_27705":53565,"_2959":53815},[],"AWS secret key.",{"_3475":1352,"_30471":1267,"_21105":53817,"_5":14473,"_27705":53565,"_2959":53818},[],"`aws_config.session_token`",{"_3475":1353,"_30471":1267,"_21105":53820,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1354,"_30471":1267,"_21105":53822,"_5":14473,"_27705":53565,"_2959":53823},[],"No",{"_3475":1355,"_30471":1267,"_21105":53825,"_5":14473,"_27705":53565,"_2959":53826},[],"Session token (with `auth_method=static`).",{"_3475":1356,"_30471":1267,"_21105":53828,"_5":14473,"_27705":53565,"_2959":53829},[],"`aws_config.role_arn`",{"_3475":1357,"_30471":1267,"_21105":53831,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1358,"_30471":1267,"_21105":53833,"_5":14473,"_27705":53565,"_2959":53834},[],"Only with `auth_method=role`",{"_3475":1359,"_30471":1267,"_21105":53836,"_5":14473,"_27705":53565,"_2959":53837},[],"ARN of the role to assume.",{"_3475":1360,"_30471":1267,"_21105":53839,"_5":14473,"_27705":53565,"_2959":53840},[],"`aws_config.endpoint_url`",{"_3475":1361,"_30471":1267,"_21105":53842,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1362,"_30471":1267,"_21105":53844,"_5":14473,"_27705":53565,"_2959":53823},[],{"_3475":1363,"_30471":1267,"_21105":53846,"_5":14473,"_27705":53565,"_2959":53847},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3475":1364,"_30471":1267,"_21105":53849,"_5":14473,"_27705":53565,"_2959":53850},[],"`subscriber_event_bus`",{"_3475":1365,"_30471":1267,"_21105":53852,"_5":14473,"_27705":53565,"_2959":17746},[],{"_3475":1366,"_30471":1267,"_21105":53854,"_5":14473,"_27705":53565,"_2959":53771},[],{"_3475":1367,"_30471":1267,"_21105":53856,"_5":14473,"_27705":53565,"_2959":53857},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3475":1368,"_30471":1267,"_21105":53859,"_5":14473,"_27705":53565,"_2959":53860},[],"`dms_manager_client`",{"_3475":1369,"_30471":1267,"_21105":53862,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1370,"_30471":1267,"_21105":53864,"_5":14473,"_27705":53565,"_2959":53771},[],{"_3475":1371,"_30471":1267,"_21105":53866,"_5":14473,"_27705":53565,"_2959":53867},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3475":1372,"_30471":1267,"_21105":53869,"_5":14473,"_27705":53565,"_2959":53870},[],"`device_manager_client`",{"_3475":1373,"_30471":1267,"_21105":53872,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1374,"_30471":1267,"_21105":53874,"_5":14473,"_27705":53565,"_2959":53771},[],{"_3475":1375,"_30471":1267,"_21105":53876,"_5":14473,"_27705":53565,"_2959":53877},[],"HTTP URL of Lamassu's Device Manager.",{"_3475":1376,"_30471":1267,"_21105":53879,"_5":14473,"_27705":53565,"_2959":53880},[],"`ca_client`",{"_3475":1377,"_30471":1267,"_21105":53882,"_5":14473,"_27705":53565,"_2959":25243},[],{"_3475":1378,"_30471":1267,"_21105":53884,"_5":14473,"_27705":53565,"_2959":53771},[],{"_3475":1379,"_30471":1267,"_21105":53886,"_5":14473,"_27705":53565,"_2959":53887},[],"HTTP URL of Lamassu's CA service.",{"_3475":1380,"_30471":1267,"_21105":53889,"_5":14473,"_27705":53569,"_2959":53890},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3475":1381,"_30471":1267,"_21105":53892,"_5":14473,"_27705":53569,"_2959":53893},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3475":1382,"_30471":1267,"_21105":53895,"_5":14473,"_27705":53569,"_2959":53896},[],"CloudEvent type",{"_3475":1383,"_30471":1267,"_21105":53898,"_5":14473,"_27705":53569,"_2959":53899},[],"Lamassu resource",{"_3475":1384,"_30471":1267,"_21105":53901,"_5":14473,"_27705":53569,"_2959":53902},[],"AWS Resource",{"_3475":1385,"_30471":1267,"_21105":53904,"_5":14473,"_27705":53569,"_2959":53905},[],"IAM actions",{"_3475":1386,"_30471":1267,"_21105":53907,"_5":14473,"_27705":53569,"_2959":53908},[],"AWS calls and effect",{"_3475":1387,"_30471":1267,"_21105":53910,"_5":14473,"_27705":53569,"_2959":53911},[],"Where in this page",{"_3475":1388,"_30471":1267,"_21105":53913,"_5":14473,"_27705":53569,"_2959":53914},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3475":1389,"_30471":1267,"_21105":53916,"_5":14473,"_27705":53569,"_2959":53917},[],"CA",{"_3475":1390,"_30471":1267,"_21105":53919,"_5":14473,"_27705":53569,"_2959":53920},[],"`IoTCore/CACertificate`",{"_3475":1391,"_30471":1267,"_21105":53922,"_5":14473,"_27705":53569,"_2959":53923},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3475":1392,"_30471":1267,"_21105":53925,"_5":14473,"_27705":53569,"_2959":53926},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3475":1393,"_30471":1267,"_21105":53928,"_5":14473,"_27705":53569,"_2959":53582},[],{"_3475":1394,"_30471":1267,"_21105":53930,"_5":14473,"_27705":53569,"_2959":53931},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3475":1395,"_30471":1267,"_21105":53933,"_5":14473,"_27705":53569,"_2959":53934},[],"DMS",{"_3475":1396,"_30471":1267,"_21105":53936,"_5":14473,"_27705":53569,"_2959":53937},[],"`IoTCore/ProvisioningTemplate`",{"_3475":1397,"_30471":1267,"_21105":53939,"_5":14473,"_27705":53569,"_2959":53940},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3475":1398,"_30471":1267,"_21105":53942,"_5":14473,"_27705":53569,"_2959":53943},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3475":1399,"_30471":1267,"_21105":53945,"_5":14473,"_27705":53569,"_2959":53610},[],{"_3475":1400,"_30471":1267,"_21105":53947,"_5":14473,"_27705":53569,"_2959":53948},[],"`EventBindDeviceIdentityKey`",{"_3475":1401,"_30471":1267,"_21105":53950,"_5":14473,"_27705":53569,"_2959":53951},[],"Device",{"_3475":1402,"_30471":1267,"_21105":53953,"_5":14473,"_27705":53569,"_2959":53954},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3475":1403,"_30471":1267,"_21105":53956,"_5":14473,"_27705":53569,"_2959":53957},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3475":1404,"_30471":1267,"_21105":53959,"_5":14473,"_27705":53569,"_2959":53960},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3475":1405,"_30471":1267,"_21105":53962,"_5":14473,"_27705":53569,"_2959":53618},[],{"_3475":1406,"_30471":1267,"_21105":53964,"_5":14473,"_27705":53569,"_2959":53965},[],"`EventUpdateCertificateStatusKey`",{"_3475":1407,"_30471":1267,"_21105":53967,"_5":14473,"_27705":53569,"_2959":53968},[],"Certificate",{"_3475":1408,"_30471":1267,"_21105":53970,"_5":14473,"_27705":53569,"_2959":53971},[],"`IoTCore/Certificate`",{"_3475":1409,"_30471":1267,"_21105":53973,"_5":14473,"_27705":53569,"_2959":53974},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3475":1410,"_30471":1267,"_21105":53976,"_5":14473,"_27705":53569,"_2959":53977},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3475":1411,"_30471":1267,"_21105":53979,"_5":14473,"_27705":53569,"_2959":53630},[],{"_3475":1412,"_30471":1267,"_21105":53981,"_5":14473,"_27705":53569,"_2959":53982},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3475":1413,"_30471":1267,"_21105":53984,"_5":14473,"_27705":53569,"_2959":53985},[],"Certificate / Device",{"_3475":1414,"_30471":1267,"_21105":53987,"_5":14473,"_27705":53569,"_2959":53988},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3475":1415,"_30471":1267,"_21105":53990,"_5":14473,"_27705":53569,"_2959":49991},[],{"_3475":1416,"_30471":1267,"_21105":53992,"_5":14473,"_27705":53569,"_2959":53993},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3475":1417,"_30471":1267,"_21105":53995,"_5":14473,"_27705":53569,"_2959":53638},[],{"_3475":1418,"_30471":1267,"_21105":53997,"_5":14473,"_27705":53573,"_2959":53998},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3475":1419,"_30471":1267,"_21105":54000,"_5":14473,"_27705":53577,"_2959":54001},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3475":1420,"_30471":1267,"_21105":54003,"_5":14473,"_27705":53577,"_2959":54004},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3475":1421,"_30471":1267,"_21105":54006,"_5":14473,"_27705":53581,"_2959":54007},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3475":1422,"_30471":1267,"_21105":54009,"_5":14473,"_27705":53581,"_2959":54010},[],"Transition",{"_3475":1423,"_30471":1267,"_21105":54012,"_5":14473,"_27705":53581,"_2959":54013},[],"AWS calls",{"_3475":1424,"_30471":1267,"_21105":54015,"_5":14473,"_27705":53581,"_2959":54016},[],"`NotRegistered` → `Requested`",{"_3475":1425,"_30471":1267,"_21105":54018,"_5":14473,"_27705":53581,"_2959":54019},[],"none (metadata write only)",{"_3475":1426,"_30471":1267,"_21105":54021,"_5":14473,"_27705":53581,"_2959":54022},[],"`Requested` → `Registering`",{"_3475":1427,"_30471":1267,"_21105":54024,"_5":14473,"_27705":53581,"_2959":54025},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3475":1428,"_30471":1267,"_21105":54027,"_5":14473,"_27705":53581,"_2959":54028},[],"`Registering` → `Succeeded`",{"_3475":1429,"_30471":1267,"_21105":54030,"_5":14473,"_27705":53581,"_2959":54031},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3475":1430,"_30471":1267,"_21105":54033,"_5":14473,"_27705":53581,"_2959":54034},[],"`Registering` → `Failed`",{"_3475":1431,"_30471":1267,"_21105":54036,"_5":14473,"_27705":53581,"_2959":54037},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3475":1432,"_30471":1267,"_21105":54039,"_5":14473,"_27705":53581,"_2959":54040},[],"`Failed` / `Succeeded` → `Requested`",{"_3475":1433,"_30471":1267,"_21105":54042,"_5":14473,"_27705":53581,"_2959":54043},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3475":1434,"_30471":1267,"_21105":54045,"_5":14473,"_27705":53585,"_2959":54046},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3475":1435,"_30471":1267,"_21105":54048,"_5":14473,"_27705":53585,"_2959":54049},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3475":1436,"_30471":1267,"_21105":54051,"_5":14473,"_27705":53585,"_2959":54052},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3475":1437,"_30471":1267,"_21105":54054,"_5":14473,"_27705":53585,"_2959":54055},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3475":1438,"_30471":1267,"_21105":54057,"_5":14473,"_27705":53585,"_2959":54058},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3475":1439,"_30471":1267,"_21105":54060,"_5":14473,"_27705":53585,"_2959":54061},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3475":1440,"_30471":1267,"_21105":54063,"_5":14473,"_27705":53589,"_2959":54064},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3475":1441,"_30471":1267,"_21105":54066,"_5":14473,"_27705":53593,"_2959":54067},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3475":1442,"_30471":1267,"_21105":54069,"_5":14473,"_27705":53593,"_2959":54070},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3475":1443,"_30471":1267,"_21105":54072,"_5":14473,"_27705":53597,"_2959":54073},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3475":1444,"_30471":1267,"_21105":54075,"_5":14473,"_27705":53601,"_2959":54076},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3475":1445,"_30471":1267,"_21105":54078,"_5":14473,"_27705":53601,"_2959":54079},[],"Creates or updates the IoT policies configured in the DMS.",{"_3475":1446,"_30471":1267,"_21105":54081,"_5":14473,"_27705":53601,"_2959":54082},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3475":1447,"_30471":1267,"_21105":54084,"_5":14473,"_27705":53601,"_2959":54085},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3475":1448,"_30471":1267,"_21105":54087,"_5":14473,"_27705":53601,"_2959":54088},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3475":1449,"_30471":1267,"_21105":54090,"_5":14473,"_27705":53601,"_2959":54091},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3475":1450,"_30471":1267,"_21105":54093,"_5":14473,"_27705":53601,"_2959":54094},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3475":1451,"_30471":1267,"_21105":54096,"_5":14473,"_27705":53605,"_2959":54097},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3475":1452,"_30471":1267,"_21105":54099,"_5":14473,"_27705":53605,"_2959":54100},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3475":1453,"_30471":1267,"_21105":54102,"_5":14473,"_27705":53605,"_2959":54103},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3475":1454,"_30471":1267,"_21105":54105,"_5":14473,"_27705":53605,"_2959":54106},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3475":1455,"_30471":1267,"_21105":54108,"_5":14473,"_27705":53605,"_2959":54109},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3475":1456,"_30471":1267,"_21105":54111,"_5":14473,"_27705":53609,"_2959":54112},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3475":1457,"_30471":1267,"_21105":54114,"_5":14473,"_27705":53609,"_2959":54010},[],{"_3475":1458,"_30471":1267,"_21105":54116,"_5":14473,"_27705":53609,"_2959":54013},[],{"_3475":1459,"_30471":1267,"_21105":54118,"_5":14473,"_27705":53609,"_2959":54119},[],"`Unconfigured` → `None` / `Auto`",{"_3475":1460,"_30471":1267,"_21105":54121,"_5":14473,"_27705":53609,"_2959":54122},[],"none (configuration only)",{"_3475":1461,"_30471":1267,"_21105":54124,"_5":14473,"_27705":53609,"_2959":54125},[],"`None` ↔ `Auto`",{"_3475":1462,"_30471":1267,"_21105":54127,"_5":14473,"_27705":53609,"_2959":54122},[],{"_3475":1463,"_30471":1267,"_21105":54129,"_5":14473,"_27705":53609,"_2959":54130},[],"Any → `Jitp`",{"_3475":1464,"_30471":1267,"_21105":54132,"_5":14473,"_27705":53609,"_2959":54133},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3475":1465,"_30471":1267,"_21105":54135,"_5":14473,"_27705":53609,"_2959":54136},[],"`Jitp` → `None` / `Auto`",{"_3475":1466,"_30471":1267,"_21105":54138,"_5":14473,"_27705":53609,"_2959":54139},[],"none (the template stays in the AWS account)",{"_3475":1467,"_30471":1267,"_21105":54141,"_5":14473,"_27705":53613,"_2959":54142},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3475":1468,"_30471":1267,"_21105":54144,"_5":14473,"_27705":53613,"_2959":54145},[],"The full flow from the device's perspective is:",{"_3475":1469,"_30471":1267,"_21105":54147,"_5":14473,"_27705":53613,"_2959":54148},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3475":1470,"_30471":1267,"_21105":54150,"_5":14473,"_27705":53617,"_2959":54151},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3475":1471,"_30471":1267,"_21105":54153,"_5":14473,"_27705":53617,"_2959":54010},[],{"_3475":1472,"_30471":1267,"_21105":54155,"_5":14473,"_27705":53617,"_2959":54013},[],{"_3475":1473,"_30471":1267,"_21105":54157,"_5":14473,"_27705":53617,"_2959":54158},[],"`Absent` → `Provisioned`",{"_3475":1474,"_30471":1267,"_21105":54160,"_5":14473,"_27705":53617,"_2959":54161},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3475":1475,"_30471":1267,"_21105":54163,"_5":14473,"_27705":53617,"_2959":54164},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3475":1476,"_30471":1267,"_21105":54166,"_5":14473,"_27705":53617,"_2959":54167},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3475":1477,"_30471":1267,"_21105":54169,"_5":14473,"_27705":53617,"_2959":54170},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3475":1478,"_30471":1267,"_21105":54172,"_5":14473,"_27705":53621,"_2959":54173},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3475":1479,"_30471":1267,"_21105":54175,"_5":14473,"_27705":53621,"_2959":54176},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3475":1480,"_30471":1267,"_21105":54178,"_5":14473,"_27705":53621,"_2959":54179},[],"For the JITP flow to work correctly:",{"_3475":1481,"_30471":1267,"_21105":54181,"_5":14473,"_27705":53621,"_2959":54182},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3475":1482,"_30471":1267,"_21105":54184,"_5":14473,"_27705":53621,"_2959":54185},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3475":1483,"_30471":1267,"_21105":54187,"_5":14473,"_27705":53621,"_2959":54188},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3475":1484,"_30471":1267,"_21105":54190,"_5":14473,"_27705":53621,"_2959":54191},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3475":1485,"_30471":1267,"_21105":54193,"_5":14473,"_27705":53625,"_2959":54194},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3475":1486,"_30471":1267,"_21105":54196,"_5":14473,"_27705":53625,"_2959":54197},[],"Status in Lamassu",{"_3475":1487,"_30471":1267,"_21105":54199,"_5":14473,"_27705":53625,"_2959":54200},[],"Revocation reason",{"_3475":1488,"_30471":1267,"_21105":54202,"_5":14473,"_27705":53625,"_2959":54203},[],"Status in AWS IoT Core",{"_3475":1489,"_30471":1267,"_21105":54205,"_5":14473,"_27705":53625,"_2959":54206},[],"`Active`",{"_3475":1490,"_30471":1267,"_21105":54208,"_5":14473,"_27705":53625,"_2959":54209},[],"None",{"_3475":1491,"_30471":1267,"_21105":54211,"_5":14473,"_27705":53625,"_2959":54212},[],"`ACTIVE`",{"_3475":1492,"_30471":1267,"_21105":54214,"_5":14473,"_27705":53625,"_2959":54215},[],"`Revoked`",{"_3475":1493,"_30471":1267,"_21105":54217,"_5":14473,"_27705":53625,"_2959":54218},[],"`certificateHold`",{"_3475":1494,"_30471":1267,"_21105":54220,"_5":14473,"_27705":53625,"_2959":54221},[],"`INACTIVE`",{"_3475":1495,"_30471":1267,"_21105":54223,"_5":14473,"_27705":53625,"_2959":54215},[],{"_3475":1496,"_30471":1267,"_21105":54225,"_5":14473,"_27705":53625,"_2959":54226},[],"Any other reason",{"_3475":1497,"_30471":1267,"_21105":54228,"_5":14473,"_27705":53625,"_2959":54229},[],"`REVOKED`",{"_3475":1498,"_30471":1267,"_21105":54231,"_5":14473,"_27705":53625,"_2959":54232},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3475":1499,"_30471":1267,"_21105":54234,"_5":14473,"_27705":53629,"_2959":54235},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3475":1500,"_30471":1267,"_21105":54237,"_5":14473,"_27705":53629,"_2959":54010},[],{"_3475":1501,"_30471":1267,"_21105":54239,"_5":14473,"_27705":53629,"_2959":54013},[],{"_3475":1502,"_30471":1267,"_21105":54241,"_5":14473,"_27705":53629,"_2959":54242},[],"`NotSynced` → `Active`",{"_3475":1503,"_30471":1267,"_21105":54244,"_5":14473,"_27705":53629,"_2959":53721},[],{"_3475":1504,"_30471":1267,"_21105":54246,"_5":14473,"_27705":53629,"_2959":54247},[],"`Active` → `Inactive`",{"_3475":1505,"_30471":1267,"_21105":54249,"_5":14473,"_27705":53629,"_2959":54250},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3475":1506,"_30471":1267,"_21105":54252,"_5":14473,"_27705":53629,"_2959":54253},[],"`Active` → `Revoked`",{"_3475":1507,"_30471":1267,"_21105":54255,"_5":14473,"_27705":53629,"_2959":54250},[],{"_3475":1508,"_30471":1267,"_21105":54257,"_5":14473,"_27705":53629,"_2959":54258},[],"`Inactive` / `Revoked` → `Active`",{"_3475":1509,"_30471":1267,"_21105":54260,"_5":14473,"_27705":53629,"_2959":53721},[],{"_3475":1510,"_30471":1267,"_21105":54262,"_5":14473,"_27705":53629,"_2959":54263},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3475":1511,"_30471":1267,"_21105":54265,"_5":14473,"_27705":53629,"_2959":54266},[],"none (these states are not synced to AWS)",{"_3475":1512,"_30471":1267,"_21105":54268,"_5":14473,"_27705":53633,"_2959":54269},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3475":1513,"_30471":1267,"_21105":54271,"_5":14473,"_27705":53633,"_2959":54272},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3475":1514,"_30471":1267,"_21105":54274,"_5":14473,"_27705":53633,"_2959":54275},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3475":1515,"_30471":1267,"_21105":54277,"_5":14473,"_27705":53637,"_2959":54278},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3475":1516,"_30471":1267,"_21105":54280,"_5":14473,"_27705":53637,"_2959":54281},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3475":1517,"_30471":1267,"_21105":54283,"_5":14473,"_27705":53641,"_2959":54284},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3475":1518,"_30471":1267,"_21105":54286,"_5":14473,"_27705":53641,"_2959":54287},[],"There are two action types:",{"_3475":1519,"_30471":1267,"_21105":54289,"_5":14473,"_27705":53641,"_2959":54290},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3475":1520,"_30471":1267,"_21105":54292,"_5":14473,"_27705":53641,"_2959":54293},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3475":1521,"_30471":1267,"_21105":54295,"_5":14473,"_27705":53641,"_2959":54296},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3475":1522,"_30471":1267,"_21105":54298,"_5":14473,"_27705":53645,"_2959":54299},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3475":1523,"_30471":1267,"_21105":54301,"_5":14473,"_27705":53645,"_2959":54302},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3475":1524,"_30471":1267,"_21105":54304,"_5":14473,"_27705":53645,"_2959":54305},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3475":1525,"_30471":1267,"_21105":54307,"_5":14473,"_27705":53649,"_2959":54308},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3475":1526,"_30471":1267,"_21105":54310,"_5":14473,"_27705":53649,"_2959":54311},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3475":1527,"_30471":1267,"_21105":54313,"_5":14473,"_27705":53649,"_2959":54314},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3475":1528,"_30471":1267,"_21105":54316,"_5":14473,"_27705":53649,"_2959":54317},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3475":1529,"_30471":1267,"_21105":54319,"_5":14473,"_27705":53649,"_2959":54320},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3475":1530,"_30471":1267,"_21105":54322,"_5":14473,"_27705":53649,"_2959":54323},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3475":1531,"_30471":1267,"_21105":54325,"_5":14473,"_27705":53649,"_2959":54326},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3475":1532,"_30471":1267,"_21105":54328,"_5":14473,"_27705":53649,"_2959":54329},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3475":1533,"_30471":1267,"_21105":54331,"_5":14473,"_27705":53649,"_2959":54332},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3475":1534,"_30471":1267,"_21105":54334,"_5":14473,"_27705":53649,"_2959":54335},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3475":1535,"_30471":1267,"_21105":54337,"_5":14473,"_27705":53649,"_2959":54338},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3475":1536,"_30471":1267,"_21105":54340,"_5":14473,"_27705":53649,"_2959":54341},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3475":1537,"_30471":1267,"_21105":54343,"_5":14473,"_27705":53649,"_2959":54344},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3475":1538,"_30471":1267,"_21105":54346,"_5":14473,"_27705":53649,"_2959":54347},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3475":1539,"_30471":1267,"_21105":54349,"_5":14473,"_27705":53649,"_2959":54350},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3475":1540,"_30471":1267,"_21105":54352,"_5":14473,"_27705":53649,"_2959":54353},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3475":1541,"_30471":1267,"_21105":54355,"_5":14473,"_27705":53649,"_2959":54356},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3475":1542,"_30471":1267,"_21105":54358,"_5":14473,"_27705":53649,"_2959":54359},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3475":1543,"_30471":1267,"_21105":54361,"_5":14473,"_27705":53649,"_2959":54362},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3475":1544,"_30471":1267,"_21105":54364,"_5":14473,"_27705":53649,"_2959":54365},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3475":1545,"_30471":1267,"_21105":54367,"_5":14473,"_27705":53649,"_2959":54368},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3475":1546,"_30471":1267,"_21105":54370,"_5":14473,"_27705":53649,"_2959":54371},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":1547,"_30471":1267,"_21105":54373,"_5":14473,"_27705":53649,"_2959":54374},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3475":1548,"_30471":1267,"_21105":54376,"_5":14473,"_27705":53649,"_2959":54377},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3475":1549,"_30471":1549,"_5":14825,"_2959":52084,"_30823":54379,"_21105":54380,"_27705":1549},[49595,51070,52084],[],{"_3475":1550,"_30471":1549,"_21105":54382,"_5":14473,"_27705":1549,"_2959":54383},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3475":1551,"_30471":1549,"_5":30820,"_21105":54385,"_27705":54386,"_2959":54387},[],"/docs/pr-preview/pr-67/platform/iot-fleets/overview#start-here","Start here",{"_3475":1552,"_30471":1549,"_5":30820,"_21105":54389,"_27705":54390,"_2959":52082},[],"/docs/pr-preview/pr-67/platform/iot-fleets/overview#devices-and-identities",{"_3475":1553,"_30471":1549,"_5":30820,"_21105":54392,"_27705":54393,"_2959":52265},[],"/docs/pr-preview/pr-67/platform/iot-fleets/overview#enrollment-with-pki",{"_3475":1554,"_30471":1549,"_5":30820,"_21105":54395,"_27705":54396,"_2959":53546},[],"/docs/pr-preview/pr-67/platform/iot-fleets/overview#integrations",{"_3475":1555,"_30471":1549,"_5":30820,"_21105":54398,"_27705":54399,"_2959":54400},[],"/docs/pr-preview/pr-67/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3475":1556,"_30471":1549,"_21105":54402,"_5":14473,"_27705":1549,"_2959":54403},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3475":1557,"_30471":1549,"_21105":54405,"_5":14473,"_27705":54386,"_2959":54406},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3475":1558,"_30471":1549,"_21105":54408,"_5":14473,"_27705":54386,"_2959":54409},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3475":1559,"_30471":1549,"_21105":54411,"_5":14473,"_27705":54390,"_2959":54412},[],"Resource",{"_3475":1560,"_30471":1549,"_21105":54414,"_5":14473,"_27705":54390,"_2959":54415},[],"What it represents",{"_3475":1561,"_30471":1549,"_21105":54417,"_5":14473,"_27705":54390,"_2959":54418},[],"**Device**",{"_3475":1562,"_30471":1549,"_21105":54420,"_5":14473,"_27705":54390,"_2959":54421},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3475":1563,"_30471":1549,"_21105":54423,"_5":14473,"_27705":54390,"_2959":54424},[],"**Identity**",{"_3475":1564,"_30471":1549,"_21105":54426,"_5":14473,"_27705":54390,"_2959":54427},[],"The device's association with its certificates: an active version and a history.",{"_3475":1565,"_30471":1549,"_21105":54429,"_5":14473,"_27705":54390,"_2959":54430},[],"**DMS**",{"_3475":1566,"_30471":1549,"_21105":54432,"_5":14473,"_27705":54390,"_2959":54433},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3475":1567,"_30471":1549,"_21105":54435,"_5":14473,"_27705":54390,"_2959":54436},[],"**Fleet**",{"_3475":1568,"_30471":1549,"_21105":54438,"_5":14473,"_27705":54390,"_2959":54439},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3475":1569,"_30471":1549,"_21105":54441,"_5":14473,"_27705":54390,"_2959":54442},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3475":1570,"_30471":1549,"_21105":54444,"_5":14473,"_27705":54390,"_2959":54445},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3475":1571,"_30471":1549,"_21105":54447,"_5":14473,"_27705":54393,"_2959":54448},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3475":1572,"_30471":1549,"_21105":54450,"_5":14473,"_27705":54393,"_2959":54451},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3475":1573,"_30471":1549,"_21105":54453,"_5":14473,"_27705":54393,"_2959":54454},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3475":1574,"_30471":1549,"_21105":54456,"_5":14473,"_27705":54393,"_2959":54457},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3475":1575,"_30471":1549,"_21105":54459,"_5":14473,"_27705":54393,"_2959":54460},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3475":1576,"_30471":1549,"_21105":54462,"_5":14473,"_27705":54393,"_2959":54463},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3475":1577,"_30471":1549,"_21105":54465,"_5":14473,"_27705":54393,"_2959":54466},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":1578,"_30471":1549,"_21105":54468,"_5":14473,"_27705":54393,"_2959":54469},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3475":1579,"_30471":1549,"_21105":54471,"_5":14473,"_27705":54396,"_2959":54472},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3475":1580,"_30471":1549,"_21105":54474,"_5":14473,"_27705":54396,"_2959":54475},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3475":1581,"_30471":1549,"_21105":54477,"_5":14473,"_27705":54399,"_2959":54478},[],"Participant",{"_3475":1582,"_30471":1549,"_21105":54480,"_5":14473,"_27705":54399,"_2959":54481},[],"Responsibility",{"_3475":1583,"_30471":1549,"_21105":54483,"_5":14473,"_27705":54399,"_2959":54484},[],"PKI administrator",{"_3475":1584,"_30471":1549,"_21105":54486,"_5":14473,"_27705":54399,"_2959":54487},[],"CA, issuance profile, chain and revocation publication.",{"_3475":1585,"_30471":1549,"_21105":54489,"_5":14473,"_27705":54399,"_2959":54490},[],"Provisioning administrator",{"_3475":1586,"_30471":1549,"_21105":54492,"_5":14473,"_27705":54399,"_2959":54493},[],"DMS, admission, authentication per operation and inventory.",{"_3475":1587,"_30471":1549,"_21105":54495,"_5":14473,"_27705":54399,"_2959":54496},[],"Device integrator",{"_3475":1588,"_30471":1549,"_21105":54498,"_5":14473,"_27705":54399,"_2959":54499},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3475":1589,"_30471":1549,"_21105":54501,"_5":14473,"_27705":54399,"_2959":54502},[],"Consumer integrator",{"_3475":1590,"_30471":1549,"_21105":54504,"_5":14473,"_27705":54399,"_2959":54505},[],"Trusted issuers, validation and device permissions in the destination.",{"_3475":1591,"_30471":1549,"_21105":54507,"_5":14473,"_27705":54399,"_2959":54508},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3475":1592,"_30471":1592,"_5":14825,"_2959":54510,"_30823":54511,"_21105":54513,"_27705":1592},"Enroll and connect your first device",[49595,51070,52084,54512],"Getting started",[],{"_3475":1593,"_30471":1592,"_21105":54515,"_5":14473,"_27705":1592,"_2959":54516},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3475":1594,"_30471":1592,"_5":30820,"_21105":54518,"_27705":54519,"_2959":49605},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3475":1595,"_30471":1592,"_5":30820,"_21105":54521,"_27705":54522,"_2959":54523},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3475":1596,"_30471":1592,"_5":30820,"_21105":54525,"_27705":54526,"_2959":54527},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3475":1597,"_30471":1592,"_5":30820,"_21105":54529,"_27705":54530,"_2959":54531},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3475":1598,"_30471":1592,"_5":30820,"_21105":54533,"_27705":54534,"_2959":54535},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3475":1599,"_30471":1592,"_5":30820,"_21105":54537,"_27705":54538,"_2959":54539},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3475":1600,"_30471":1592,"_5":30820,"_21105":54541,"_27705":54542,"_2959":54543},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3475":1601,"_30471":1592,"_5":30820,"_21105":54545,"_27705":54546,"_2959":54547},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3475":1602,"_30471":1592,"_21105":54549,"_5":14473,"_27705":1592,"_2959":54550},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3475":1603,"_30471":1592,"_21105":54552,"_5":14473,"_27705":54519,"_2959":54553},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3475":1604,"_30471":1592,"_21105":54555,"_5":14473,"_27705":54519,"_2959":54556},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3475":1605,"_30471":1592,"_21105":54558,"_5":14473,"_27705":54519,"_2959":54559},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3475":1606,"_30471":1592,"_21105":54561,"_5":14473,"_27705":54519,"_2959":54562},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3475":1607,"_30471":1592,"_21105":54564,"_5":14473,"_27705":54519,"_2959":54565},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3475":1608,"_30471":1592,"_21105":54567,"_5":14473,"_27705":54522,"_2959":54568},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3475":1609,"_30471":1592,"_21105":54570,"_5":14473,"_27705":54522,"_2959":54571},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3475":1610,"_30471":1592,"_21105":54573,"_5":14473,"_27705":54526,"_2959":54574},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3475":1611,"_30471":1592,"_21105":54576,"_5":14473,"_27705":54526,"_2959":54577},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3475":1612,"_30471":1592,"_21105":54579,"_5":14473,"_27705":54526,"_2959":54580},[],"Setting",{"_3475":1613,"_30471":1592,"_21105":54582,"_5":14473,"_27705":54526,"_2959":54583},[],"Evaluation value",{"_3475":1614,"_30471":1592,"_21105":54585,"_5":14473,"_27705":54526,"_2959":54586},[],"Enrollment CA",{"_3475":1615,"_30471":1592,"_21105":54588,"_5":14473,"_27705":54526,"_2959":54589},[],"Issuing root from `device-root.pem`.",{"_3475":1616,"_30471":1592,"_21105":54591,"_5":14473,"_27705":54526,"_2959":52395},[],{"_3475":1617,"_30471":1592,"_21105":54593,"_5":14473,"_27705":54526,"_2959":54594},[],"The 1-hour leaf profile you just prepared.",{"_3475":1618,"_30471":1592,"_21105":54596,"_5":14473,"_27705":54526,"_2959":54597},[],"Protocol / Registration Mode",{"_3475":1619,"_30471":1592,"_21105":54599,"_5":14473,"_27705":54526,"_2959":54600},[],"`EST_RFC7030` / `JITP`.",{"_3475":1620,"_30471":1592,"_21105":54602,"_5":14473,"_27705":54526,"_2959":54603},[],"Verify CSR Signature",{"_3475":1621,"_30471":1592,"_21105":54605,"_5":14473,"_27705":54526,"_2959":54606},[],"Enabled.",{"_3475":1622,"_30471":1592,"_21105":54608,"_5":14473,"_27705":54526,"_2959":54609},[],"Enable Replaceable Enrollment",{"_3475":1623,"_30471":1592,"_21105":54611,"_5":14473,"_27705":54526,"_2959":54612},[],"Disabled; the ID must be new.",{"_3475":1624,"_30471":1592,"_21105":54614,"_5":14473,"_27705":54526,"_2959":54615},[],"Initial authentication",{"_3475":1625,"_30471":1592,"_21105":54617,"_5":14473,"_27705":54526,"_2959":54618},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3475":1626,"_30471":1592,"_21105":54620,"_5":14473,"_27705":54526,"_2959":54621},[],"Renewal authentication",{"_3475":1627,"_30471":1592,"_21105":54623,"_5":14473,"_27705":54526,"_2959":54624},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3475":1628,"_30471":1592,"_21105":54626,"_5":14473,"_27705":54526,"_2959":54627},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3475":1629,"_30471":1592,"_21105":54629,"_5":14473,"_27705":54526,"_2959":54630},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3475":1630,"_30471":1592,"_21105":54632,"_5":14473,"_27705":54526,"_2959":54633},[],"Re-enrollment Delta",{"_3475":1631,"_30471":1592,"_21105":54635,"_5":14473,"_27705":54526,"_2959":54636},[],"1 hour.",{"_3475":1632,"_30471":1592,"_21105":54638,"_5":14473,"_27705":54526,"_2959":54639},[],"Preventive / Critical Delta",{"_3475":1633,"_30471":1592,"_21105":54641,"_5":14473,"_27705":54526,"_2959":54642},[],"30 minutes / 10 minutes.",{"_3475":1634,"_30471":1592,"_21105":54644,"_5":14473,"_27705":54526,"_2959":54645},[],"Revoke on Re-enrollment",{"_3475":1635,"_30471":1592,"_21105":54647,"_5":14473,"_27705":54526,"_2959":54648},[],"Disabled to test the successor before retiring the previous identity.",{"_3475":1636,"_30471":1592,"_21105":54650,"_5":14473,"_27705":54526,"_2959":52403},[],{"_3475":1637,"_30471":1592,"_21105":54652,"_5":14473,"_27705":54526,"_2959":54653},[],"Disabled; the operational key is generated in the client.",{"_3475":1638,"_30471":1592,"_21105":54655,"_5":14473,"_27705":54526,"_2959":54656},[],"CA Distribution",{"_3475":1639,"_30471":1592,"_21105":54658,"_5":14473,"_27705":54526,"_2959":54659},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3475":1640,"_30471":1592,"_21105":54661,"_5":14473,"_27705":54526,"_2959":54662},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3475":1641,"_30471":1592,"_21105":54664,"_5":14473,"_27705":54530,"_2959":54665},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3475":1642,"_30471":1592,"_21105":54667,"_5":14473,"_27705":54530,"_2959":54668},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3475":1643,"_30471":1592,"_21105":54670,"_5":14473,"_27705":54534,"_2959":54671},[],"Generate a new key and CSR with the selected identifier:",{"_3475":1644,"_30471":1592,"_21105":54673,"_5":14473,"_27705":54534,"_2959":54674},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3475":1645,"_30471":1592,"_21105":54676,"_5":14473,"_27705":54534,"_2959":54677},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3475":1646,"_30471":1592,"_21105":54679,"_5":14473,"_27705":54538,"_2959":54680},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3475":1647,"_30471":1592,"_21105":54682,"_5":14473,"_27705":54538,"_2959":54683},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3475":1648,"_30471":1592,"_21105":54685,"_5":14473,"_27705":54542,"_2959":54686},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3475":1649,"_30471":1592,"_21105":54688,"_5":14473,"_27705":54542,"_2959":54689},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3475":1650,"_30471":1592,"_21105":54691,"_5":14473,"_27705":54542,"_2959":54692},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3475":1651,"_30471":1592,"_21105":54694,"_5":14473,"_27705":54542,"_2959":54695},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3475":1652,"_30471":1592,"_21105":54697,"_5":14473,"_27705":54542,"_2959":54698},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3475":1653,"_30471":1592,"_21105":54700,"_5":14473,"_27705":54546,"_2959":54701},[],"Check",{"_3475":1654,"_30471":1592,"_21105":54703,"_5":14473,"_27705":54546,"_2959":54704},[],"Expected result",{"_3475":1655,"_30471":1592,"_21105":54706,"_5":14473,"_27705":54546,"_2959":54707},[],"Registration",{"_3475":1656,"_30471":1592,"_21105":54709,"_5":14473,"_27705":54546,"_2959":54710},[],"ID created automatically and correct DMS.",{"_3475":1657,"_30471":1592,"_21105":54712,"_5":14473,"_27705":54546,"_2959":53968},[],{"_3475":1658,"_30471":1592,"_21105":54714,"_5":14473,"_27705":54546,"_2959":54715},[],"CN, profile, serial and key verified.",{"_3475":1659,"_30471":1592,"_21105":54717,"_5":14473,"_27705":54546,"_2959":54718},[],"Inventory",{"_3475":1660,"_30471":1592,"_21105":54720,"_5":14473,"_27705":54546,"_2959":54721},[],"Received serial visible as the current identity and in history.",{"_3475":1661,"_30471":1592,"_21105":54723,"_5":14473,"_27705":54546,"_2959":54724},[],"Consumer",{"_3475":1662,"_30471":1592,"_21105":54726,"_5":14473,"_27705":54546,"_2959":54727},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3475":1663,"_30471":1592,"_21105":54729,"_5":14473,"_27705":54546,"_2959":54730},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3475":1664,"_30471":1592,"_21105":54732,"_5":14473,"_27705":54546,"_2959":54733},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3475":1665,"_30471":1665,"_5":14825,"_2959":52100,"_30823":54735,"_21105":54736,"_27705":1665},[49595,51070,52084,54512],[],{"_3475":1666,"_30471":1665,"_21105":54738,"_5":14473,"_27705":1665,"_2959":54739},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3475":1667,"_30471":1665,"_5":30820,"_21105":54741,"_27705":54742,"_2959":49605},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3475":1668,"_30471":1665,"_5":30820,"_21105":54744,"_27705":54745,"_2959":54746},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3475":1669,"_30471":1665,"_5":30820,"_21105":54748,"_27705":54749,"_2959":54750},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3475":1670,"_30471":1665,"_5":30820,"_21105":54752,"_27705":54753,"_2959":54754},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3475":1671,"_30471":1665,"_5":30820,"_21105":54756,"_27705":54757,"_2959":54758},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3475":1672,"_30471":1665,"_5":30820,"_21105":54760,"_27705":54761,"_2959":54762},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3475":1673,"_30471":1665,"_5":30820,"_21105":54764,"_27705":54765,"_2959":54704},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3475":1674,"_30471":1665,"_5":30820,"_21105":54767,"_27705":54768,"_2959":54769},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3475":1675,"_30471":1665,"_5":30820,"_21105":54771,"_27705":54772,"_2959":54773},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3475":1676,"_30471":1665,"_21105":54775,"_5":14473,"_27705":1665,"_2959":54776},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3475":1677,"_30471":1665,"_21105":54778,"_5":14473,"_27705":1665,"_2959":54779},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3475":1678,"_30471":1665,"_21105":54781,"_5":14473,"_27705":54742,"_2959":54782},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3475":1679,"_30471":1665,"_21105":54784,"_5":14473,"_27705":54742,"_2959":54785},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3475":1680,"_30471":1665,"_21105":54787,"_5":14473,"_27705":54742,"_2959":54788},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3475":1681,"_30471":1665,"_21105":54790,"_5":14473,"_27705":54742,"_2959":54791},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3475":1682,"_30471":1665,"_21105":54793,"_5":14473,"_27705":54745,"_2959":54794},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3475":1683,"_30471":1665,"_21105":54796,"_5":14473,"_27705":54745,"_2959":54797},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3475":1684,"_30471":1665,"_21105":54799,"_5":14473,"_27705":54745,"_2959":54800},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3475":1685,"_30471":1665,"_21105":54802,"_5":14473,"_27705":54745,"_2959":54803},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3475":1686,"_30471":1665,"_21105":54805,"_5":14473,"_27705":54745,"_2959":54806},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3475":1687,"_30471":1665,"_21105":54808,"_5":14473,"_27705":54745,"_2959":54809},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3475":1688,"_30471":1665,"_21105":54811,"_5":14473,"_27705":54745,"_2959":54812},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3475":1689,"_30471":1665,"_21105":54814,"_5":14473,"_27705":54745,"_2959":54815},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3475":1690,"_30471":1665,"_21105":54817,"_5":14473,"_27705":54749,"_2959":54818},[],"Open **Managed Devices** and the registration action. Complete:",{"_3475":1691,"_30471":1665,"_21105":54820,"_5":14473,"_27705":54749,"_2959":54821},[],"**Device ID**: `device-001`.",{"_3475":1692,"_30471":1665,"_21105":54823,"_5":14473,"_27705":54749,"_2959":54824},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3475":1693,"_30471":1665,"_21105":54826,"_5":14473,"_27705":54749,"_2959":54827},[],"**Icon** and **Tags**: optional classification.",{"_3475":1694,"_30471":1665,"_21105":54829,"_5":14473,"_27705":54749,"_2959":54830},[],"Confirm registration.",{"_3475":1695,"_30471":1665,"_21105":54832,"_5":14473,"_27705":54753,"_2959":54833},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3475":1696,"_30471":1665,"_21105":54835,"_5":14473,"_27705":54753,"_2959":54836},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3475":1697,"_30471":1665,"_21105":54838,"_5":14473,"_27705":54757,"_2959":54839},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3475":1698,"_30471":1665,"_21105":54841,"_5":14473,"_27705":54757,"_2959":54842},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3475":1699,"_30471":1665,"_21105":54844,"_5":14473,"_27705":54761,"_2959":54845},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3475":1700,"_30471":1665,"_21105":54847,"_5":14473,"_27705":54761,"_2959":54848},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3475":1701,"_30471":1665,"_21105":54850,"_5":14473,"_27705":54765,"_2959":54701},[],{"_3475":1702,"_30471":1665,"_21105":54852,"_5":14473,"_27705":54765,"_2959":54853},[],"Result",{"_3475":1703,"_30471":1665,"_21105":54855,"_5":14473,"_27705":54765,"_2959":53951},[],{"_3475":1704,"_30471":1665,"_21105":54857,"_5":14473,"_27705":54765,"_2959":54858},[],"`device-001` appears in inventory with the expected DMS.",{"_3475":1705,"_30471":1665,"_21105":54860,"_5":14473,"_27705":54765,"_2959":54861},[],"Current identity",{"_3475":1706,"_30471":1665,"_21105":54863,"_5":14473,"_27705":54765,"_2959":54864},[],"The associated certificate matches the one you verified in PKI.",{"_3475":1707,"_30471":1665,"_21105":54866,"_5":14473,"_27705":54765,"_2959":54867},[],"History",{"_3475":1708,"_30471":1665,"_21105":54869,"_5":14473,"_27705":54765,"_2959":54870},[],"The associated issuance appears with its serial number and dates.",{"_3475":1709,"_30471":1665,"_21105":54872,"_5":14473,"_27705":54765,"_2959":54873},[],"Key and certificate",{"_3475":1710,"_30471":1665,"_21105":54875,"_5":14473,"_27705":54765,"_2959":54876},[],"You have the verified pair ready to install on the device.",{"_3475":1711,"_30471":1665,"_21105":54878,"_5":14473,"_27705":54768,"_2959":54879},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3475":1712,"_30471":1665,"_21105":54881,"_5":14473,"_27705":54768,"_2959":54882},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3475":1713,"_30471":1665,"_21105":54884,"_5":14473,"_27705":54768,"_2959":54885},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3475":1714,"_30471":1665,"_21105":54887,"_5":14473,"_27705":54768,"_2959":54888},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3475":1715,"_30471":1665,"_21105":54890,"_5":14473,"_27705":54772,"_2959":54891},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3475":1716,"_30471":1665,"_21105":54893,"_5":14473,"_27705":54772,"_2959":54894},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3475":1717,"_30471":1665,"_21105":54896,"_5":14473,"_27705":54772,"_2959":54897},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3475":1718,"_30471":1718,"_5":14825,"_2959":54899,"_30823":54900,"_21105":54901,"_27705":1718},"Lamassu IoT Platform",[49595,51070],[],{"_3475":1719,"_30471":1718,"_21105":54903,"_5":14473,"_27705":1718,"_2959":54904},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3475":1720,"_30471":1718,"_5":30820,"_21105":54906,"_27705":54907,"_2959":54387},[],"/docs/pr-preview/pr-67/platform/overview#start-here",{"_3475":1721,"_30471":1718,"_5":30820,"_21105":54909,"_27705":54910,"_2959":54911},[],"/docs/pr-preview/pr-67/platform/overview#choose-your-path","Choose your path",{"_3475":1722,"_30471":1718,"_5":30820,"_21105":54913,"_27705":54914,"_2959":54915},[],"/docs/pr-preview/pr-67/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3475":1723,"_30471":1718,"_5":30820,"_21105":54917,"_27705":54918,"_2959":54919},[],"/docs/pr-preview/pr-67/platform/overview#core-capabilities","Core capabilities",{"_3475":1724,"_30471":1718,"_5":30820,"_21105":54921,"_27705":54922,"_2959":54923},[],"/docs/pr-preview/pr-67/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3475":1725,"_30471":1718,"_5":30820,"_21105":54925,"_27705":54926,"_2959":54927},[],"/docs/pr-preview/pr-67/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3475":1726,"_30471":1718,"_5":30820,"_21105":54929,"_27705":54930,"_2959":54931},[],"/docs/pr-preview/pr-67/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3475":1727,"_30471":1718,"_5":30820,"_21105":54933,"_27705":54934,"_2959":54935},[],"/docs/pr-preview/pr-67/platform/overview#automate-device-identities","Automate device identities",{"_3475":1728,"_30471":1718,"_5":30820,"_21105":54937,"_27705":54938,"_2959":54939},[],"/docs/pr-preview/pr-67/platform/overview#publish-validation-status","Publish validation status",{"_3475":1729,"_30471":1718,"_5":30820,"_21105":54941,"_27705":54942,"_2959":54943},[],"/docs/pr-preview/pr-67/platform/overview#react-to-events","React to events",{"_3475":1730,"_30471":1718,"_5":30820,"_21105":54945,"_27705":54946,"_2959":54947},[],"/docs/pr-preview/pr-67/platform/overview#operational-reference","Operational reference",{"_3475":1731,"_30471":1718,"_21105":54949,"_5":14473,"_27705":1718,"_2959":54950},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3475":1732,"_30471":1718,"_21105":54952,"_5":14473,"_27705":54907,"_2959":54953},[],"Choose the result you need:",{"_3475":1733,"_30471":1718,"_21105":54955,"_5":14473,"_27705":54907,"_2959":54956},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3475":1734,"_30471":1718,"_21105":54958,"_5":14473,"_27705":54907,"_2959":54959},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3475":1735,"_30471":1718,"_21105":54961,"_5":14473,"_27705":54907,"_2959":54962},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3475":1736,"_30471":1718,"_21105":54964,"_5":14473,"_27705":54910,"_2959":54965},[],"Section",{"_3475":1737,"_30471":1718,"_21105":54967,"_5":14473,"_27705":54910,"_2959":54968},[],"What you manage",{"_3475":1738,"_30471":1718,"_21105":54970,"_5":14473,"_27705":54910,"_2959":54971},[],"Entry point",{"_3475":1739,"_30471":1718,"_21105":54973,"_5":14473,"_27705":54910,"_2959":54974},[],"**PKI**",{"_3475":1740,"_30471":1718,"_21105":54976,"_5":14473,"_27705":54910,"_2959":54977},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3475":1741,"_30471":1718,"_21105":54979,"_5":14473,"_27705":54910,"_2959":54980},[],"PKI overview",{"_3475":1742,"_30471":1718,"_21105":54982,"_5":14473,"_27705":54910,"_2959":54983},[],"**IoT Fleets**",{"_3475":1743,"_30471":1718,"_21105":54985,"_5":14473,"_27705":54910,"_2959":54986},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3475":1744,"_30471":1718,"_21105":54988,"_5":14473,"_27705":54910,"_2959":54989},[],"IoT Fleets overview",{"_3475":1745,"_30471":1718,"_21105":54991,"_5":14473,"_27705":54910,"_2959":54992},[],"**Administration**",{"_3475":1746,"_30471":1718,"_21105":54994,"_5":14473,"_27705":54910,"_2959":54995},[],"Operator permissions, audit and event subscriptions.",{"_3475":1747,"_30471":1718,"_21105":54997,"_5":14473,"_27705":54910,"_2959":51068},[],{"_3475":1748,"_30471":1718,"_21105":54999,"_5":14473,"_27705":54910,"_2959":55000},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3475":1749,"_30471":1718,"_21105":55002,"_5":14473,"_27705":54914,"_2959":55003},[],"An identity's journey connects four responsibilities:",{"_3475":1750,"_30471":1718,"_21105":55005,"_5":14473,"_27705":54914,"_2959":55006},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3475":1751,"_30471":1718,"_21105":55008,"_5":14473,"_27705":54914,"_2959":55009},[],"The provisioning administrator configures the DMS and initial trust.",{"_3475":1752,"_30471":1718,"_21105":55011,"_5":14473,"_27705":54914,"_2959":55012},[],"The device client requests a certificate and installs it with the matching key.",{"_3475":1753,"_30471":1718,"_21105":55014,"_5":14473,"_27705":54914,"_2959":55015},[],"The consumer validates the identity and applies its access permissions.",{"_3475":1754,"_30471":1718,"_21105":55017,"_5":14473,"_27705":54914,"_2959":55018},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3475":1755,"_30471":1718,"_21105":55020,"_5":14473,"_27705":54922,"_2959":55021},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3475":1756,"_30471":1718,"_21105":55023,"_5":14473,"_27705":54926,"_2959":55024},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3475":1757,"_30471":1718,"_21105":55026,"_5":14473,"_27705":54930,"_2959":55027},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3475":1758,"_30471":1718,"_21105":55029,"_5":14473,"_27705":54934,"_2959":55030},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3475":1759,"_30471":1718,"_21105":55032,"_5":14473,"_27705":54938,"_2959":55033},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3475":1760,"_30471":1718,"_21105":55035,"_5":14473,"_27705":54942,"_2959":55036},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3475":1761,"_30471":1718,"_21105":55038,"_5":14473,"_27705":54946,"_2959":54481},[],{"_3475":1762,"_30471":1718,"_21105":55040,"_5":14473,"_27705":54946,"_2959":55041},[],"What it prepares or checks",{"_3475":1763,"_30471":1718,"_21105":55043,"_5":14473,"_27705":54946,"_2959":54484},[],{"_3475":1764,"_30471":1718,"_21105":55045,"_5":14473,"_27705":54946,"_2959":55046},[],"Key custody, CA hierarchy, profiles and validation.",{"_3475":1765,"_30471":1718,"_21105":55048,"_5":14473,"_27705":54946,"_2959":55049},[],"Fleet administrator",{"_3475":1766,"_30471":1718,"_21105":55051,"_5":14473,"_27705":54946,"_2959":55052},[],"DMS, device admission, renewal policy and inventory.",{"_3475":1767,"_30471":1718,"_21105":55054,"_5":14473,"_27705":54946,"_2959":54496},[],{"_3475":1768,"_30471":1718,"_21105":55056,"_5":14473,"_27705":54946,"_2959":55057},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3475":1769,"_30471":1718,"_21105":55059,"_5":14473,"_27705":54946,"_2959":54502},[],{"_3475":1770,"_30471":1718,"_21105":55061,"_5":14473,"_27705":54946,"_2959":55062},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3475":1771,"_30471":1718,"_21105":55064,"_5":14473,"_27705":54946,"_2959":55065},[],"Infrastructure operator",{"_3475":1772,"_30471":1718,"_21105":55067,"_5":14473,"_27705":54946,"_2959":55068},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3475":1773,"_30471":1718,"_21105":55070,"_5":14473,"_27705":54946,"_2959":55071},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3475":1774,"_30471":1774,"_5":14825,"_2959":55073,"_30823":55074,"_21105":55077,"_27705":1774},"CA hierarchy and rotation",[49595,51070,55075,55076],"PKI","Keys, authorities and certificates",[],{"_3475":1775,"_30471":1774,"_21105":55079,"_5":14473,"_27705":1774,"_2959":55080},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3475":1776,"_30471":1774,"_5":30820,"_21105":55082,"_27705":55083,"_2959":55084},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3475":1777,"_30471":1774,"_5":30820,"_21105":55086,"_27705":55087,"_2959":55088},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3475":1778,"_30471":1774,"_5":30820,"_21105":55090,"_27705":55091,"_2959":55092},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3475":1779,"_30471":1774,"_5":30820,"_21105":55094,"_27705":55095,"_2959":55096},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3475":1780,"_30471":1774,"_5":30820,"_21105":55098,"_27705":55099,"_2959":55100},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3475":1781,"_30471":1774,"_5":30820,"_21105":55102,"_27705":55103,"_2959":55104},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3475":1782,"_30471":1774,"_5":30820,"_21105":55106,"_27705":55107,"_2959":55108},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3475":1783,"_30471":1774,"_5":30820,"_21105":55110,"_27705":55111,"_2959":55112},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3475":1784,"_30471":1774,"_5":30820,"_21105":55114,"_27705":55115,"_2959":55116},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3475":1785,"_30471":1774,"_5":30820,"_21105":55118,"_27705":55119,"_2959":55120},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3475":1786,"_30471":1774,"_5":30820,"_21105":55122,"_27705":55123,"_2959":55124},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3475":1787,"_30471":1774,"_5":30820,"_21105":55126,"_27705":55127,"_2959":55128},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3475":1788,"_30471":1774,"_21105":55130,"_5":14473,"_27705":1774,"_2959":55131},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3475":1789,"_30471":1774,"_21105":55133,"_5":14473,"_27705":1774,"_2959":55134},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3475":1790,"_30471":1774,"_21105":55136,"_5":14473,"_27705":55083,"_2959":55137},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3475":1791,"_30471":1774,"_21105":55139,"_5":14473,"_27705":55083,"_2959":55140},[],"environment, such as production and preproduction;",{"_3475":1792,"_30471":1774,"_21105":55142,"_5":14473,"_27705":55083,"_2959":55143},[],"owner or operating team;",{"_3475":1793,"_30471":1774,"_21105":55145,"_5":14473,"_27705":55083,"_2959":55146},[],"device family or manufacturing process;",{"_3475":1794,"_30471":1774,"_21105":55148,"_5":14473,"_27705":55083,"_2959":55149},[],"region or regulatory requirement;",{"_3475":1795,"_30471":1774,"_21105":55151,"_5":14473,"_27705":55083,"_2959":55152},[],"cryptographic engine or key policy;",{"_3475":1796,"_30471":1774,"_21105":55154,"_5":14473,"_27705":55083,"_2959":55155},[],"maintenance window and renewal cadence.",{"_3475":1797,"_30471":1774,"_21105":55157,"_5":14473,"_27705":55083,"_2959":55158},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3475":1798,"_30471":1774,"_21105":55160,"_5":14473,"_27705":55083,"_2959":55161},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3475":1799,"_30471":1774,"_21105":55163,"_5":14473,"_27705":55087,"_2959":55164},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3475":1800,"_30471":1774,"_21105":55166,"_5":14473,"_27705":55087,"_2959":55167},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3475":1801,"_30471":1774,"_21105":55169,"_5":14473,"_27705":55087,"_2959":55170},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3475":1802,"_30471":1774,"_21105":55172,"_5":14473,"_27705":55087,"_2959":55173},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3475":1803,"_30471":1774,"_21105":55175,"_5":14473,"_27705":55091,"_2959":55176},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3475":1804,"_30471":1774,"_21105":55178,"_5":14473,"_27705":55091,"_2959":55179},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3475":1805,"_30471":1774,"_21105":55181,"_5":14473,"_27705":55091,"_2959":55182},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3475":1806,"_30471":1774,"_21105":55184,"_5":14473,"_27705":55091,"_2959":55185},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3475":1807,"_30471":1774,"_21105":55187,"_5":14473,"_27705":55099,"_2959":55188},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3475":1808,"_30471":1774,"_21105":55190,"_5":14473,"_27705":55103,"_2959":55191},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3475":1809,"_30471":1774,"_21105":55193,"_5":14473,"_27705":55107,"_2959":55194},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3475":1810,"_30471":1774,"_21105":55196,"_5":14473,"_27705":55111,"_2959":55197},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3475":1811,"_30471":1774,"_21105":55199,"_5":14473,"_27705":55115,"_2959":55200},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3475":1812,"_30471":1774,"_21105":55202,"_5":14473,"_27705":55119,"_2959":55203},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3475":1813,"_30471":1774,"_21105":55205,"_5":14473,"_27705":55123,"_2959":55206},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3475":1814,"_30471":1774,"_21105":55208,"_5":14473,"_27705":55123,"_2959":55209},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3475":1815,"_30471":1774,"_21105":55211,"_5":14473,"_27705":55123,"_2959":55212},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3475":1816,"_30471":1774,"_21105":55214,"_5":14473,"_27705":55123,"_2959":55215},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3475":1817,"_30471":1774,"_21105":55217,"_5":14473,"_27705":55127,"_2959":55218},[],"The new chain ends in an anchor installed by the consumer.",{"_3475":1818,"_30471":1774,"_21105":55220,"_5":14473,"_27705":55127,"_2959":55221},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3475":1819,"_30471":1774,"_21105":55223,"_5":14473,"_27705":55127,"_2959":55224},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3475":1820,"_30471":1774,"_21105":55226,"_5":14473,"_27705":55127,"_2959":55227},[],"Re-enrollment accepts the old identity during the planned period.",{"_3475":1821,"_30471":1774,"_21105":55229,"_5":14473,"_27705":55127,"_2959":55230},[],"OCSP and CRL respond for the authorities that remain active.",{"_3475":1822,"_30471":1774,"_21105":55232,"_5":14473,"_27705":55127,"_2959":55233},[],"No DMS is left accidentally issuing from the old CA.",{"_3475":1823,"_30471":1774,"_21105":55235,"_5":14473,"_27705":55127,"_2959":55236},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3475":1824,"_30471":1824,"_5":14825,"_2959":55238,"_30823":55239,"_21105":55240,"_27705":1824},"Certification authorities",[49595,51070,55075,55076],[],{"_3475":1825,"_30471":1824,"_21105":55242,"_5":14473,"_27705":1824,"_2959":55243},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3475":1826,"_30471":1824,"_5":30820,"_21105":55245,"_27705":55246,"_2959":55247},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3475":1827,"_30471":1824,"_5":30820,"_21105":55249,"_27705":55250,"_2959":55251},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3475":1828,"_30471":1824,"_5":30820,"_21105":55253,"_27705":55254,"_2959":49605},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#before-you-begin",{"_3475":1829,"_30471":1824,"_5":30820,"_21105":55256,"_27705":55257,"_2959":55258},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3475":1830,"_30471":1824,"_5":30820,"_21105":55260,"_27705":55261,"_2959":55262},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3475":1831,"_30471":1824,"_5":30820,"_21105":55264,"_27705":55265,"_2959":55266},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3475":1832,"_30471":1824,"_5":30820,"_21105":55268,"_27705":55269,"_2959":55270},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3475":1833,"_30471":1824,"_5":30820,"_21105":55272,"_27705":55273,"_2959":55274},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3475":1834,"_30471":1824,"_5":30820,"_21105":55276,"_27705":55277,"_2959":55278},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3475":1835,"_30471":1824,"_5":30820,"_21105":55280,"_27705":55281,"_2959":55282},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3475":1836,"_30471":1824,"_5":30820,"_21105":55284,"_27705":55285,"_2959":55286},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3475":1837,"_30471":1824,"_5":30820,"_21105":55288,"_27705":55289,"_2959":55290},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3475":1838,"_30471":1824,"_5":30820,"_21105":55292,"_27705":55293,"_2959":55294},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3475":1839,"_30471":1824,"_5":30820,"_21105":55296,"_27705":55297,"_2959":55298},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3475":1840,"_30471":1824,"_5":30820,"_21105":55300,"_27705":55301,"_2959":55302},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3475":1841,"_30471":1824,"_5":30820,"_21105":55304,"_27705":55305,"_2959":55306},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3475":1842,"_30471":1824,"_5":30820,"_21105":55308,"_27705":55309,"_2959":55310},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3475":1843,"_30471":1824,"_5":30820,"_21105":55312,"_27705":55313,"_2959":55314},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3475":1844,"_30471":1824,"_5":30820,"_21105":55316,"_27705":55317,"_2959":55318},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3475":1845,"_30471":1824,"_5":30820,"_21105":55320,"_27705":55321,"_2959":55322},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3475":1846,"_30471":1824,"_5":30820,"_21105":55324,"_27705":55325,"_2959":55326},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3475":1847,"_30471":1824,"_5":30820,"_21105":55328,"_27705":55329,"_2959":55330},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3475":1848,"_30471":1824,"_5":30820,"_21105":55332,"_27705":55333,"_2959":55334},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3475":1849,"_30471":1824,"_21105":55336,"_5":14473,"_27705":1824,"_2959":55337},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3475":1850,"_30471":1824,"_21105":55339,"_5":14473,"_27705":1824,"_2959":55340},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3475":1851,"_30471":1824,"_21105":55342,"_5":14473,"_27705":1824,"_2959":55343},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3475":1852,"_30471":1824,"_21105":55345,"_5":14473,"_27705":55246,"_2959":55346},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3475":1853,"_30471":1824,"_21105":55348,"_5":14473,"_27705":55246,"_2959":55349},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3475":1854,"_30471":1824,"_21105":55351,"_5":14473,"_27705":55246,"_2959":55352},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3475":1855,"_30471":1824,"_21105":55354,"_5":14473,"_27705":55246,"_2959":55355},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3475":1856,"_30471":1824,"_21105":55357,"_5":14473,"_27705":55246,"_2959":55358},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3475":1857,"_30471":1824,"_21105":55360,"_5":14473,"_27705":55254,"_2959":55361},[],"Decide whether the CA will be a root or an intermediate.",{"_3475":1858,"_30471":1824,"_21105":55363,"_5":14473,"_27705":55254,"_2959":55364},[],"Choose the engine that will keep the key.",{"_3475":1859,"_30471":1824,"_21105":55366,"_5":14473,"_27705":55254,"_2959":55367},[],"Define a validity longer than that of the certificates it will issue.",{"_3475":1860,"_30471":1824,"_21105":55369,"_5":14473,"_27705":55254,"_2959":55370},[],"For an intermediate CA, make sure the parent CA is active.",{"_3475":1861,"_30471":1824,"_21105":55372,"_5":14473,"_27705":55257,"_2959":55373},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3475":1862,"_30471":1824,"_21105":55375,"_5":14473,"_27705":55261,"_2959":55376},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3475":1863,"_30471":1824,"_21105":55378,"_5":14473,"_27705":55261,"_2959":55379},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3475":1864,"_30471":1824,"_21105":55381,"_5":14473,"_27705":55265,"_2959":55382},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3475":1865,"_30471":1824,"_21105":55384,"_5":14473,"_27705":55269,"_2959":55385},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3475":1866,"_30471":1824,"_21105":55387,"_5":14473,"_27705":55269,"_2959":55388},[],"`C`: two-letter ISO 3166-1 country code.",{"_3475":1867,"_30471":1824,"_21105":55390,"_5":14473,"_27705":55269,"_2959":55391},[],"`ST`: state or province.",{"_3475":1868,"_30471":1824,"_21105":55393,"_5":14473,"_27705":55269,"_2959":55394},[],"`L`: locality.",{"_3475":1869,"_30471":1824,"_21105":55396,"_5":14473,"_27705":55269,"_2959":55397},[],"`O`: organization.",{"_3475":1870,"_30471":1824,"_21105":55399,"_5":14473,"_27705":55269,"_2959":55400},[],"`OU`: organizational unit.",{"_3475":1871,"_30471":1824,"_21105":55402,"_5":14473,"_27705":55269,"_2959":55403},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3475":1872,"_30471":1824,"_21105":55405,"_5":14473,"_27705":55273,"_2959":55406},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3475":1873,"_30471":1824,"_21105":55408,"_5":14473,"_27705":55273,"_2959":55409},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3475":1874,"_30471":1824,"_21105":55411,"_5":14473,"_27705":55277,"_2959":55412},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3475":1875,"_30471":1824,"_21105":55414,"_5":14473,"_27705":55277,"_2959":55415},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3475":1876,"_30471":1824,"_21105":55417,"_5":14473,"_27705":55281,"_2959":55418},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3475":1877,"_30471":1824,"_21105":55420,"_5":14473,"_27705":55281,"_2959":55421},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3475":1878,"_30471":1824,"_21105":55423,"_5":14473,"_27705":55285,"_2959":55424},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3475":1879,"_30471":1824,"_21105":55426,"_5":14473,"_27705":55285,"_2959":55427},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3475":1880,"_30471":1824,"_21105":55429,"_5":14473,"_27705":55285,"_2959":55430},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3475":1881,"_30471":1824,"_21105":55432,"_5":14473,"_27705":55289,"_2959":55433},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3475":1882,"_30471":1824,"_21105":55435,"_5":14473,"_27705":55293,"_2959":55436},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3475":1883,"_30471":1824,"_21105":55438,"_5":14473,"_27705":55293,"_2959":55439},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3475":1884,"_30471":1824,"_21105":55441,"_5":14473,"_27705":55297,"_2959":55442},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3475":1885,"_30471":1824,"_21105":55444,"_5":14473,"_27705":55301,"_2959":55445},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3475":1886,"_30471":1824,"_21105":55447,"_5":14473,"_27705":55301,"_2959":55448},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3475":1887,"_30471":1824,"_21105":55450,"_5":14473,"_27705":55305,"_2959":55451},[],"Open a CA from the inventory to review:",{"_3475":1888,"_30471":1824,"_21105":55453,"_5":14473,"_27705":55305,"_2959":55454},[],"Status and validity period.",{"_3475":1889,"_30471":1824,"_21105":55456,"_5":14473,"_27705":55305,"_2959":55457},[],"Certificate and chain in PEM format.",{"_3475":1890,"_30471":1824,"_21105":55459,"_5":14473,"_27705":55305,"_2959":55460},[],"Number of active, expired and revoked certificates.",{"_3475":1891,"_30471":1824,"_21105":55462,"_5":14473,"_27705":55305,"_2959":55463},[],"Certificates issued in **Issued Certificates**.",{"_3475":1892,"_30471":1824,"_21105":55465,"_5":14473,"_27705":55305,"_2959":55466},[],"The CRL linked to the authority.",{"_3475":1893,"_30471":1824,"_21105":55468,"_5":14473,"_27705":55305,"_2959":55469},[],"Metadata and the associated cryptographic engine.",{"_3475":1894,"_30471":1824,"_21105":55471,"_5":14473,"_27705":55305,"_2959":55472},[],"You can filter the inventory by name, status and CA type.",{"_3475":1895,"_30471":1824,"_21105":55474,"_5":14473,"_27705":55309,"_2959":55475},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3475":1896,"_30471":1824,"_21105":55477,"_5":14473,"_27705":55309,"_2959":55478},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3475":1897,"_30471":1824,"_21105":55480,"_5":14473,"_27705":55309,"_2959":55481},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3475":1898,"_30471":1824,"_21105":55483,"_5":14473,"_27705":55309,"_2959":55484},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3475":1899,"_30471":1824,"_21105":55486,"_5":14473,"_27705":55313,"_2959":55487},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3475":1900,"_30471":1824,"_21105":55489,"_5":14473,"_27705":55317,"_2959":55490},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3475":1901,"_30471":1824,"_21105":55492,"_5":14473,"_27705":55321,"_2959":55493},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3475":1902,"_30471":1824,"_21105":55495,"_5":14473,"_27705":55325,"_2959":55496},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3475":1903,"_30471":1824,"_21105":55498,"_5":14473,"_27705":55329,"_2959":55499},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3475":1904,"_30471":1824,"_21105":55501,"_5":14473,"_27705":55333,"_2959":55502},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3475":1905,"_30471":1824,"_21105":55504,"_5":14473,"_27705":55333,"_2959":55505},[],"The CA’s CRL settings are kept, and they cannot be removed through the API. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3475":1906,"_30471":1824,"_21105":55507,"_5":14473,"_27705":55333,"_2959":55508},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3475":1907,"_30471":1907,"_5":14825,"_2959":55510,"_30823":55511,"_21105":55512,"_27705":1907},"Certificate profiles",[49595,51070,55075,55076],[],{"_3475":1908,"_30471":1907,"_21105":55514,"_5":14473,"_27705":1907,"_2959":55515},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3475":1909,"_30471":1907,"_5":30820,"_21105":55517,"_27705":55518,"_2959":55519},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3475":1910,"_30471":1907,"_5":30820,"_21105":55521,"_27705":55522,"_2959":55523},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#validity","Validity",{"_3475":1911,"_30471":1907,"_5":30820,"_21105":55525,"_27705":55526,"_2959":55527},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3475":1912,"_30471":1907,"_5":30820,"_21105":55529,"_27705":55530,"_2959":55531},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3475":1913,"_30471":1907,"_5":30820,"_21105":55533,"_27705":55534,"_2959":55535},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#subject","Subject",{"_3475":1914,"_30471":1907,"_5":30820,"_21105":55537,"_27705":55538,"_2959":55539},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3475":1915,"_30471":1907,"_5":30820,"_21105":55541,"_27705":55542,"_2959":55543},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3475":1916,"_30471":1907,"_5":30820,"_21105":55545,"_27705":55546,"_2959":55547},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3475":1917,"_30471":1907,"_5":30820,"_21105":55549,"_27705":55550,"_2959":55551},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3475":1918,"_30471":1907,"_5":30820,"_21105":55553,"_27705":55554,"_2959":55555},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3475":1919,"_30471":1907,"_5":30820,"_21105":55557,"_27705":55558,"_2959":55559},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3475":1920,"_30471":1907,"_5":30820,"_21105":55561,"_27705":55562,"_2959":55563},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3475":1921,"_30471":1907,"_5":30820,"_21105":55565,"_27705":55566,"_2959":55567},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3475":1922,"_30471":1907,"_5":30820,"_21105":55569,"_27705":55570,"_2959":55571},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3475":1923,"_30471":1907,"_5":30820,"_21105":55573,"_27705":55574,"_2959":55575},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#design-examples","Design examples",{"_3475":1924,"_30471":1907,"_5":30820,"_21105":55577,"_27705":55578,"_2959":55579},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3475":1925,"_30471":1907,"_21105":55581,"_5":14473,"_27705":1907,"_2959":55582},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3475":1926,"_30471":1907,"_21105":55584,"_5":14473,"_27705":1907,"_2959":55585},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3475":1927,"_30471":1907,"_21105":55587,"_5":14473,"_27705":55522,"_2959":55588},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3475":1928,"_30471":1907,"_21105":55590,"_5":14473,"_27705":55522,"_2959":55591},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3475":1929,"_30471":1907,"_21105":55593,"_5":14473,"_27705":55526,"_2959":55594},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3475":1930,"_30471":1907,"_21105":55596,"_5":14473,"_27705":55530,"_2959":55597},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3475":1931,"_30471":1907,"_21105":55599,"_5":14473,"_27705":55530,"_2959":55600},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3475":1932,"_30471":1907,"_21105":55602,"_5":14473,"_27705":55530,"_2959":55603},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3475":1933,"_30471":1907,"_21105":55605,"_5":14473,"_27705":55534,"_2959":55606},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3475":1934,"_30471":1907,"_21105":55608,"_5":14473,"_27705":55538,"_2959":55609},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3475":1935,"_30471":1907,"_21105":55611,"_5":14473,"_27705":55538,"_2959":55612},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3475":1936,"_30471":1907,"_21105":55614,"_5":14473,"_27705":55542,"_2959":55615},[],"The cryptographic enforcement can:",{"_3475":1937,"_30471":1907,"_21105":55617,"_5":14473,"_27705":55542,"_2959":55618},[],"allow or block RSA keys;",{"_3475":1938,"_30471":1907,"_21105":55620,"_5":14473,"_27705":55542,"_2959":55621},[],"limit the supported RSA sizes;",{"_3475":1939,"_30471":1907,"_21105":55623,"_5":14473,"_27705":55542,"_2959":55624},[],"allow or block ECDSA keys;",{"_3475":1940,"_30471":1907,"_21105":55626,"_5":14473,"_27705":55542,"_2959":55627},[],"limit the supported ECDSA sizes or curves.",{"_3475":1941,"_30471":1907,"_21105":55629,"_5":14473,"_27705":55542,"_2959":55630},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3475":1942,"_30471":1907,"_21105":55632,"_5":14473,"_27705":55546,"_2959":55633},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3475":1943,"_30471":1907,"_21105":55635,"_5":14473,"_27705":55546,"_2959":52837},[],{"_3475":1944,"_30471":1907,"_21105":55637,"_5":14473,"_27705":55546,"_2959":55638},[],"First choice",{"_3475":1945,"_30471":1907,"_21105":55640,"_5":14473,"_27705":55546,"_2959":55641},[],"Second choice",{"_3475":1946,"_30471":1907,"_21105":55643,"_5":14473,"_27705":55546,"_2959":55644},[],"If neither is supplied",{"_3475":1947,"_30471":1907,"_21105":55646,"_5":14473,"_27705":55546,"_2959":55647},[],"Direct signing with a CA",{"_3475":1948,"_30471":1907,"_21105":55649,"_5":14473,"_27705":55546,"_2959":55650},[],"`issuance_profile` embedded in the request",{"_3475":1949,"_30471":1907,"_21105":55652,"_5":14473,"_27705":55546,"_2959":55653},[],"Request `issuance_profile_id`",{"_3475":1950,"_30471":1907,"_21105":55655,"_5":14473,"_27705":55546,"_2959":55656},[],"CA default profile (`profile_id`).",{"_3475":1951,"_30471":1907,"_21105":55658,"_5":14473,"_27705":55546,"_2959":55659},[],"Issuance through a DMS",{"_3475":1952,"_30471":1907,"_21105":55661,"_5":14473,"_27705":55546,"_2959":55662},[],"`settings.issuance_profile_id`",{"_3475":1953,"_30471":1907,"_21105":55664,"_5":14473,"_27705":55546,"_2959":55665},[],"`settings.issuance_profile` embedded in the DMS",{"_3475":1954,"_30471":1907,"_21105":55667,"_5":14473,"_27705":55546,"_2959":55668},[],"Enrollment CA default profile.",{"_3475":1955,"_30471":1907,"_21105":55670,"_5":14473,"_27705":55546,"_2959":55671},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3475":1956,"_30471":1907,"_21105":55673,"_5":14473,"_27705":55546,"_2959":55674},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3475":1957,"_30471":1907,"_21105":55676,"_5":14473,"_27705":55554,"_2959":55677},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3475":1958,"_30471":1907,"_21105":55679,"_5":14473,"_27705":55558,"_2959":55680},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3475":1959,"_30471":1907,"_21105":55682,"_5":14473,"_27705":55562,"_2959":55683},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3475":1960,"_30471":1907,"_21105":55685,"_5":14473,"_27705":55566,"_2959":55686},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3475":1961,"_30471":1907,"_21105":55688,"_5":14473,"_27705":55570,"_2959":55689},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3475":1962,"_30471":1907,"_21105":55691,"_5":14473,"_27705":55570,"_2959":55692},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3475":1963,"_30471":1907,"_21105":55694,"_5":14473,"_27705":55574,"_2959":55695},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3475":1964,"_30471":1907,"_21105":55697,"_5":14473,"_27705":55574,"_2959":55698},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3475":1965,"_30471":1907,"_21105":55700,"_5":14473,"_27705":55574,"_2959":55701},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3475":1966,"_30471":1907,"_21105":55703,"_5":14473,"_27705":55574,"_2959":55704},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3475":1967,"_30471":1907,"_21105":55706,"_5":14473,"_27705":55578,"_2959":55707},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3475":1968,"_30471":1907,"_21105":55709,"_5":14473,"_27705":55578,"_2959":55710},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3475":1969,"_30471":1969,"_5":14825,"_2959":55712,"_30823":55713,"_21105":55715,"_27705":1969},"Certificate validation",[49595,51070,55075,55714],"Validation",[],{"_3475":1970,"_30471":1969,"_21105":55717,"_5":14473,"_27705":1969,"_2959":55718},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3475":1971,"_30471":1969,"_5":30820,"_21105":55720,"_27705":55721,"_2959":55722},[],"/docs/pr-preview/pr-67/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3475":1972,"_30471":1969,"_5":30820,"_21105":55724,"_27705":55725,"_2959":55726},[],"/docs/pr-preview/pr-67/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3475":1973,"_30471":1969,"_5":30820,"_21105":55728,"_27705":55729,"_2959":55730},[],"/docs/pr-preview/pr-67/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3475":1974,"_30471":1969,"_21105":55732,"_5":14473,"_27705":1969,"_2959":55733},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3475":1975,"_30471":1969,"_21105":55735,"_5":14473,"_27705":55721,"_2959":55736},[],"Verify these criteria together:",{"_3475":1976,"_30471":1969,"_21105":55738,"_5":14473,"_27705":55721,"_2959":54701},[],{"_3475":1977,"_30471":1969,"_21105":55740,"_5":14473,"_27705":55721,"_2959":55741},[],"Required result",{"_3475":1978,"_30471":1969,"_21105":55743,"_5":14473,"_27705":55721,"_2959":55744},[],"Chain and signature",{"_3475":1979,"_30471":1969,"_21105":55746,"_5":14473,"_27705":55721,"_2959":55747},[],"Valid chain to a root deliberately installed in the consumer.",{"_3475":1980,"_30471":1969,"_21105":55749,"_5":14473,"_27705":55721,"_2959":55750},[],"Dates",{"_3475":1981,"_30471":1969,"_21105":55752,"_5":14473,"_27705":55721,"_2959":55753},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3475":1982,"_30471":1969,"_21105":55755,"_5":14473,"_27705":55721,"_2959":50739},[],{"_3475":1983,"_30471":1969,"_21105":55757,"_5":14473,"_27705":55721,"_2959":55758},[],"Name, SAN or identifier matches the expected peer.",{"_3475":1984,"_30471":1969,"_21105":55760,"_5":14473,"_27705":55721,"_2959":49985},[],{"_3475":1985,"_30471":1969,"_21105":55762,"_5":14473,"_27705":55721,"_2959":55763},[],"KU, EKU and constraints permit the specific operation.",{"_3475":1986,"_30471":1969,"_21105":55765,"_5":14473,"_27705":55721,"_2959":55766},[],"Revocation",{"_3475":1987,"_30471":1969,"_21105":55768,"_5":14473,"_27705":55721,"_2959":55769},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3475":1988,"_30471":1969,"_21105":55771,"_5":14473,"_27705":55721,"_2959":55772},[],"Authorization",{"_3475":1989,"_30471":1969,"_21105":55774,"_5":14473,"_27705":55721,"_2959":55775},[],"The application permits that identity to perform the action.",{"_3475":1990,"_30471":1969,"_21105":55777,"_5":14473,"_27705":55721,"_2959":55778},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3475":1991,"_30471":1969,"_21105":55780,"_5":14473,"_27705":55725,"_2959":55781},[],"Mechanism",{"_3475":1992,"_30471":1969,"_21105":55783,"_5":14473,"_27705":55725,"_2959":55784},[],"When to use it",{"_3475":1993,"_30471":1969,"_21105":55786,"_5":14473,"_27705":55725,"_2959":55787},[],"What you must maintain",{"_3475":1994,"_30471":1969,"_21105":55789,"_5":14473,"_27705":55725,"_2959":55790},[],"OCSP",{"_3475":1995,"_30471":1969,"_21105":55792,"_5":14473,"_27705":55725,"_2959":55793},[],"Status query for a specific certificate.",{"_3475":1996,"_30471":1969,"_21105":55795,"_5":14473,"_27705":55725,"_2959":55796},[],"Responder access, signature verification and cache/freshness policy.",{"_3475":1997,"_30471":1969,"_21105":55798,"_5":14473,"_27705":55725,"_2959":55799},[],"CRL",{"_3475":1998,"_30471":1969,"_21105":55801,"_5":14473,"_27705":55725,"_2959":55802},[],"Local checks for many certificates or offline operation.",{"_3475":1999,"_30471":1969,"_21105":55804,"_5":14473,"_27705":55725,"_2959":55805},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3475":2000,"_30471":1969,"_21105":55807,"_5":14473,"_27705":55725,"_2959":55808},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3475":2001,"_30471":1969,"_21105":55810,"_5":14473,"_27705":55725,"_2959":55811},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3475":2002,"_30471":1969,"_21105":55813,"_5":14473,"_27705":55729,"_2959":55814},[],"Accept a current, authorized certificate with a known chain.",{"_3475":2003,"_30471":1969,"_21105":55816,"_5":14473,"_27705":55729,"_2959":55817},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3475":2004,"_30471":1969,"_21105":55819,"_5":14473,"_27705":55729,"_2959":55820},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3475":2005,"_30471":1969,"_21105":55822,"_5":14473,"_27705":55729,"_2959":55823},[],"Check that a new connection with that identity is rejected.",{"_3475":2006,"_30471":1969,"_21105":55825,"_5":14473,"_27705":55729,"_2959":55826},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3475":2007,"_30471":1969,"_21105":55828,"_5":14473,"_27705":55729,"_2959":55829},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3475":2008,"_30471":1969,"_21105":55831,"_5":14473,"_27705":55729,"_2959":55832},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3475":2009,"_30471":1969,"_21105":55834,"_5":14473,"_27705":55729,"_2959":55835},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":2010,"_30471":1969,"_21105":55837,"_5":14473,"_27705":55729,"_2959":55838},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3475":2011,"_30471":2011,"_5":14825,"_2959":55840,"_30823":55841,"_21105":55842,"_27705":2011},"Certificates",[49595,51070,55075,55076],[],{"_3475":2012,"_30471":2011,"_21105":55844,"_5":14473,"_27705":2011,"_2959":55845},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3475":2013,"_30471":2011,"_5":30820,"_21105":55847,"_27705":55848,"_2959":55849},[],"/docs/pr-preview/pr-67/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3475":2014,"_30471":2011,"_5":30820,"_21105":55851,"_27705":55852,"_2959":55853},[],"/docs/pr-preview/pr-67/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3475":2015,"_30471":2011,"_5":30820,"_21105":55855,"_27705":55856,"_2959":55857},[],"/docs/pr-preview/pr-67/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3475":2016,"_30471":2011,"_5":30820,"_21105":55859,"_27705":55860,"_2959":55861},[],"/docs/pr-preview/pr-67/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3475":2017,"_30471":2011,"_5":30820,"_21105":55863,"_27705":55864,"_2959":55865},[],"/docs/pr-preview/pr-67/platform/pki/certificates#open-the-action","Open the action",{"_3475":2018,"_30471":2011,"_5":30820,"_21105":55867,"_27705":55868,"_2959":55869},[],"/docs/pr-preview/pr-67/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3475":2019,"_30471":2011,"_5":30820,"_21105":55871,"_27705":55872,"_2959":55873},[],"/docs/pr-preview/pr-67/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3475":2020,"_30471":2011,"_5":30820,"_21105":55875,"_27705":55876,"_2959":55877},[],"/docs/pr-preview/pr-67/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3475":2021,"_30471":2011,"_5":30820,"_21105":55879,"_27705":55880,"_2959":55881},[],"/docs/pr-preview/pr-67/platform/pki/certificates#continue","Continue",{"_3475":2022,"_30471":2011,"_21105":55883,"_5":14473,"_27705":2011,"_2959":55884},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3475":2023,"_30471":2011,"_21105":55886,"_5":14473,"_27705":55848,"_2959":55887},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3475":2024,"_30471":2011,"_21105":55889,"_5":14473,"_27705":55848,"_2959":55890},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3475":2025,"_30471":2011,"_21105":55892,"_5":14473,"_27705":55848,"_2959":55893},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3475":2026,"_30471":2011,"_21105":55895,"_5":14473,"_27705":55848,"_2959":55896},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3475":2027,"_30471":2011,"_21105":55898,"_5":14473,"_27705":55848,"_2959":55899},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3475":2028,"_30471":2011,"_21105":55901,"_5":14473,"_27705":55848,"_2959":55902},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3475":2029,"_30471":2011,"_21105":55904,"_5":14473,"_27705":55848,"_2959":55905},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3475":2030,"_30471":2011,"_21105":55907,"_5":14473,"_27705":55852,"_2959":55908},[],"Download the PEM and inspect it:",{"_3475":2031,"_30471":2011,"_21105":55910,"_5":14473,"_27705":55852,"_2959":55911},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3475":2032,"_30471":2011,"_21105":55913,"_5":14473,"_27705":55856,"_2959":55914},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3475":2033,"_30471":2011,"_21105":55916,"_5":14473,"_27705":55856,"_2959":55917},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3475":2034,"_30471":2011,"_21105":55919,"_5":14473,"_27705":55856,"_2959":55920},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3475":2035,"_30471":2011,"_21105":55922,"_5":14473,"_27705":55856,"_2959":55923},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3475":2036,"_30471":2011,"_21105":55925,"_5":14473,"_27705":55856,"_2959":55926},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3475":2037,"_30471":2011,"_21105":55928,"_5":14473,"_27705":55856,"_2959":55929},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3475":2038,"_30471":2011,"_21105":55931,"_5":14473,"_27705":55856,"_2959":55932},[],"For browser key generation, follow Issue your first certificate.",{"_3475":2039,"_30471":2011,"_21105":55934,"_5":14473,"_27705":55860,"_2959":55935},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3475":2040,"_30471":2011,"_21105":55937,"_5":14473,"_27705":55864,"_2959":55938},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3475":2041,"_30471":2011,"_21105":55940,"_5":14473,"_27705":55868,"_2959":55941},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3475":2042,"_30471":2011,"_21105":55943,"_5":14473,"_27705":55872,"_2959":55944},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3475":2043,"_30471":2011,"_21105":55946,"_5":14473,"_27705":55872,"_2959":55947},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3475":2044,"_30471":2011,"_21105":55949,"_5":14473,"_27705":55872,"_2959":55950},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3475":2045,"_30471":2011,"_21105":55952,"_5":14473,"_27705":55876,"_2959":55953},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3475":2046,"_30471":2011,"_21105":55955,"_5":14473,"_27705":55876,"_2959":55956},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3475":2047,"_30471":2011,"_21105":55958,"_5":14473,"_27705":55876,"_2959":55959},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3475":2048,"_30471":2011,"_21105":55961,"_5":14473,"_27705":55880,"_2959":55962},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":2049,"_30471":2011,"_21105":55964,"_5":14473,"_27705":55880,"_2959":55965},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3475":2050,"_30471":2050,"_5":14825,"_2959":55967,"_30823":55968,"_21105":55970,"_27705":2050},"Certificate lifecycle",[49595,51070,55075,55969],"Concepts",[],{"_3475":2051,"_30471":2050,"_21105":55972,"_5":14473,"_27705":2050,"_2959":55973},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3475":2052,"_30471":2050,"_5":30820,"_21105":55975,"_27705":55976,"_2959":55977},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3475":2053,"_30471":2050,"_5":30820,"_21105":55979,"_27705":55980,"_2959":55981},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3475":2054,"_30471":2050,"_5":30820,"_21105":55983,"_27705":55984,"_2959":55985},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3475":2055,"_30471":2050,"_5":30820,"_21105":55987,"_27705":55988,"_2959":55989},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3475":2056,"_30471":2050,"_5":30820,"_21105":55991,"_27705":55992,"_2959":55993},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3475":2057,"_30471":2050,"_5":30820,"_21105":55995,"_27705":55996,"_2959":55997},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3475":2058,"_30471":2050,"_5":30820,"_21105":55999,"_27705":56000,"_2959":56001},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3475":2059,"_30471":2050,"_5":30820,"_21105":56003,"_27705":56004,"_2959":56005},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3475":2060,"_30471":2050,"_5":30820,"_21105":56007,"_27705":56008,"_2959":56009},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3475":2061,"_30471":2050,"_5":30820,"_21105":56011,"_27705":56012,"_2959":56013},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3475":2062,"_30471":2050,"_21105":56015,"_5":14473,"_27705":2050,"_2959":56016},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3475":2063,"_30471":2050,"_21105":56018,"_5":14473,"_27705":55980,"_2959":56019},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3475":2064,"_30471":2050,"_21105":56021,"_5":14473,"_27705":55984,"_2959":56022},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3475":2065,"_30471":2050,"_21105":56024,"_5":14473,"_27705":55988,"_2959":56025},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3475":2066,"_30471":2050,"_21105":56027,"_5":14473,"_27705":55992,"_2959":56028},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3475":2067,"_30471":2050,"_21105":56030,"_5":14473,"_27705":55996,"_2959":56031},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3475":2068,"_30471":2050,"_21105":56033,"_5":14473,"_27705":56000,"_2959":56034},[],"Lamassu persists four X.509 states:",{"_3475":2069,"_30471":2050,"_21105":56036,"_5":14473,"_27705":56000,"_2959":56037},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3475":2070,"_30471":2050,"_21105":56039,"_5":14473,"_27705":56000,"_2959":56040},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3475":2071,"_30471":2050,"_21105":56042,"_5":14473,"_27705":56000,"_2959":56043},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3475":2072,"_30471":2050,"_21105":56045,"_5":14473,"_27705":56000,"_2959":56046},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3475":2073,"_30471":2050,"_21105":56048,"_5":14473,"_27705":56000,"_2959":56049},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3475":2074,"_30471":2050,"_21105":56051,"_5":14473,"_27705":56004,"_2959":56052},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3475":2075,"_30471":2050,"_21105":56054,"_5":14473,"_27705":56004,"_2959":56055},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3475":2076,"_30471":2050,"_21105":56057,"_5":14473,"_27705":56004,"_2959":56058},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3475":2077,"_30471":2050,"_21105":56060,"_5":14473,"_27705":56008,"_2959":56061},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3475":2078,"_30471":2050,"_21105":56063,"_5":14473,"_27705":56008,"_2959":56064},[],"Before confirming:",{"_3475":2079,"_30471":2050,"_21105":56066,"_5":14473,"_27705":56008,"_2959":56067},[],"Identify DMSs, devices and services that trust that chain.",{"_3475":2080,"_30471":2050,"_21105":56069,"_5":14473,"_27705":56008,"_2959":56070},[],"Distribute the new chain of trust.",{"_3475":2081,"_30471":2050,"_21105":56072,"_5":14473,"_27705":56008,"_2959":56073},[],"Reissue the necessary identities.",{"_3475":2082,"_30471":2050,"_21105":56075,"_5":14473,"_27705":56008,"_2959":56076},[],"Check OCSP and CRL from a real consumer.",{"_3475":2083,"_30471":2050,"_21105":56078,"_5":14473,"_27705":56008,"_2959":56079},[],"Revoke the old CA once no legitimate traffic remains.",{"_3475":2084,"_30471":2050,"_21105":56081,"_5":14473,"_27705":56008,"_2959":56082},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3475":2085,"_30471":2050,"_21105":56084,"_5":14473,"_27705":56012,"_2959":56085},[],"Certificates entering the preventive or critical renewal window.",{"_3475":2086,"_30471":2050,"_21105":56087,"_5":14473,"_27705":56012,"_2959":56088},[],"Repeated enrollment or re-enrollment failures.",{"_3475":2087,"_30471":2050,"_21105":56090,"_5":14473,"_27705":56012,"_2959":56091},[],"Status changes and revocation reasons.",{"_3475":2088,"_30471":2050,"_21105":56093,"_5":14473,"_27705":56012,"_2959":56094},[],"OCSP and CRL publication and validity.",{"_3475":2089,"_30471":2050,"_21105":56096,"_5":14473,"_27705":56012,"_2959":56097},[],"Dependencies still presenting a replaced certificate.",{"_3475":2090,"_30471":2050,"_21105":56099,"_5":14473,"_27705":56012,"_2959":56100},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3475":2091,"_30471":2091,"_5":14825,"_2959":56102,"_30823":56103,"_21105":56104,"_27705":2091},"Trust model",[49595,51070,55075,55969],[],{"_3475":2092,"_30471":2091,"_21105":56106,"_5":14473,"_27705":2091,"_2959":56107},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3475":2093,"_30471":2091,"_5":30820,"_21105":56109,"_27705":56110,"_2959":56111},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3475":2094,"_30471":2091,"_5":30820,"_21105":56113,"_27705":56114,"_2959":56115},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3475":2095,"_30471":2091,"_5":30820,"_21105":56117,"_27705":56118,"_2959":56119},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3475":2096,"_30471":2091,"_5":30820,"_21105":56121,"_27705":56122,"_2959":56123},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3475":2097,"_30471":2091,"_5":30820,"_21105":56125,"_27705":56126,"_2959":56127},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3475":2098,"_30471":2091,"_5":30820,"_21105":56129,"_27705":56130,"_2959":56131},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3475":2099,"_30471":2091,"_5":30820,"_21105":56133,"_27705":56134,"_2959":56135},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3475":2100,"_30471":2091,"_5":30820,"_21105":56137,"_27705":56138,"_2959":56139},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3475":2101,"_30471":2091,"_5":30820,"_21105":56141,"_27705":56142,"_2959":56143},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3475":2102,"_30471":2091,"_5":30820,"_21105":56145,"_27705":56146,"_2959":56147},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3475":2103,"_30471":2091,"_21105":56149,"_5":14473,"_27705":2091,"_2959":56150},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3475":2104,"_30471":2091,"_21105":56152,"_5":14473,"_27705":56114,"_2959":56153},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3475":2105,"_30471":2091,"_21105":56155,"_5":14473,"_27705":56118,"_2959":56156},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3475":2106,"_30471":2091,"_21105":56158,"_5":14473,"_27705":56122,"_2959":56159},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3475":2107,"_30471":2091,"_21105":56161,"_5":14473,"_27705":56126,"_2959":56162},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3475":2108,"_30471":2091,"_21105":56164,"_5":14473,"_27705":56130,"_2959":56165},[],"The device proves it can enroll according to the DMS policy.",{"_3475":2109,"_30471":2091,"_21105":56167,"_5":14473,"_27705":56130,"_2959":56168},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3475":2110,"_30471":2091,"_21105":56170,"_5":14473,"_27705":56130,"_2959":56171},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3475":2111,"_30471":2091,"_21105":56173,"_5":14473,"_27705":56130,"_2959":56174},[],"The device installs the certificate and the chain it needs.",{"_3475":2112,"_30471":2091,"_21105":56176,"_5":14473,"_27705":56130,"_2959":56177},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3475":2113,"_30471":2091,"_21105":56179,"_5":14473,"_27705":56130,"_2959":56180},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3475":2114,"_30471":2091,"_21105":56182,"_5":14473,"_27705":56134,"_2959":56183},[],"A DMS relates three sets that are worth designing separately:",{"_3475":2115,"_30471":2091,"_21105":56185,"_5":14473,"_27705":56134,"_2959":56186},[],"**Enrollment CA:** signs the new identities.",{"_3475":2116,"_30471":2091,"_21105":56188,"_5":14473,"_27705":56134,"_2959":56189},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3475":2117,"_30471":2091,"_21105":56191,"_5":14473,"_27705":56134,"_2959":56192},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3475":2118,"_30471":2091,"_21105":56194,"_5":14473,"_27705":56134,"_2959":56195},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3475":2119,"_30471":2091,"_21105":56197,"_5":14473,"_27705":56138,"_2959":56198},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3475":2120,"_30471":2091,"_21105":56200,"_5":14473,"_27705":56138,"_2959":56201},[],"that the current date is between `Not Before` and `Not After`;",{"_3475":2121,"_30471":2091,"_21105":56203,"_5":14473,"_27705":56138,"_2959":56204},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3475":2122,"_30471":2091,"_21105":56206,"_5":14473,"_27705":56138,"_2959":56207},[],"that names, SANs and subject match the expected identity;",{"_3475":2123,"_30471":2091,"_21105":56209,"_5":14473,"_27705":56138,"_2959":56210},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3475":2124,"_30471":2091,"_21105":56212,"_5":14473,"_27705":56138,"_2959":56213},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3475":2125,"_30471":2091,"_21105":56215,"_5":14473,"_27705":56138,"_2959":56216},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3475":2126,"_30471":2091,"_21105":56218,"_5":14473,"_27705":56142,"_2959":56219},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3475":2127,"_30471":2091,"_21105":56221,"_5":14473,"_27705":56146,"_2959":56222},[],"Keep the root out of daily operations, or with very restricted access.",{"_3475":2128,"_30471":2091,"_21105":56224,"_5":14473,"_27705":56146,"_2959":56225},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3475":2129,"_30471":2091,"_21105":56227,"_5":14473,"_27705":56146,"_2959":56228},[],"Assign explicit profiles to every use case.",{"_3475":2130,"_30471":2091,"_21105":56230,"_5":14473,"_27705":56146,"_2959":56231},[],"Distribute the new trust before starting a rotation.",{"_3475":2131,"_30471":2091,"_21105":56233,"_5":14473,"_27705":56146,"_2959":56234},[],"Keep enough overlap to renew a disconnected fleet.",{"_3475":2132,"_30471":2091,"_21105":56236,"_5":14473,"_27705":56146,"_2959":56237},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3475":2133,"_30471":2091,"_21105":56239,"_5":14473,"_27705":56146,"_2959":56240},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3475":2134,"_30471":2134,"_5":14825,"_2959":56242,"_30823":56243,"_21105":56244,"_27705":2134},"Revocation lists (CRL)",[49595,51070,55075,55714],[],{"_3475":2135,"_30471":2134,"_21105":56246,"_5":14473,"_27705":2134,"_2959":56247},[],"Generate and distribute signed lists to validate certificates offline.",{"_3475":2136,"_30471":2134,"_5":30820,"_21105":56249,"_27705":56250,"_2959":56251},[],"/docs/pr-preview/pr-67/platform/pki/crl#crl-settings","CRL settings",{"_3475":2137,"_30471":2134,"_5":30820,"_21105":56253,"_27705":56254,"_2959":56255},[],"/docs/pr-preview/pr-67/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3475":2138,"_30471":2134,"_5":30820,"_21105":56257,"_27705":56258,"_2959":56259},[],"/docs/pr-preview/pr-67/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3475":2139,"_30471":2134,"_5":30820,"_21105":56261,"_27705":56262,"_2959":56263},[],"/docs/pr-preview/pr-67/platform/pki/crl#crl-contents","CRL contents",{"_3475":2140,"_30471":2134,"_5":30820,"_21105":56265,"_27705":56266,"_2959":56267},[],"/docs/pr-preview/pr-67/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3475":2141,"_30471":2134,"_5":30820,"_21105":56269,"_27705":56270,"_2959":56271},[],"/docs/pr-preview/pr-67/platform/pki/crl#crl-settings-api","CRL settings API",{"_3475":2142,"_30471":2134,"_5":30820,"_21105":56273,"_27705":56274,"_2959":56275},[],"/docs/pr-preview/pr-67/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3475":2143,"_30471":2134,"_5":30820,"_21105":56277,"_27705":56278,"_2959":56279},[],"/docs/pr-preview/pr-67/platform/pki/crl#from-the-interface","From the interface",{"_3475":2144,"_30471":2134,"_5":30820,"_21105":56281,"_27705":56282,"_2959":56283},[],"/docs/pr-preview/pr-67/platform/pki/crl#references","References",{"_3475":2145,"_30471":2134,"_21105":56285,"_5":14473,"_27705":2134,"_2959":56286},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3475":2146,"_30471":2134,"_21105":56288,"_5":14473,"_27705":56250,"_2959":56289},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3475":2147,"_30471":2134,"_21105":56291,"_5":14473,"_27705":56250,"_2959":56292},[],"Field",{"_3475":2148,"_30471":2134,"_21105":56294,"_5":14473,"_27705":56250,"_2959":49985},[],{"_3475":2149,"_30471":2134,"_21105":56296,"_5":14473,"_27705":56250,"_2959":56297},[],"`ca_id`",{"_3475":2150,"_30471":2134,"_21105":56299,"_5":14473,"_27705":56250,"_2959":56300},[],"ID of the CA the settings belong to.",{"_3475":2151,"_30471":2134,"_21105":56302,"_5":14473,"_27705":56250,"_2959":56303},[],"`status`",{"_3475":2152,"_30471":2134,"_21105":56305,"_5":14473,"_27705":56250,"_2959":56306},[],"`ACTIVE` settings generate CRLs. `FINAL` ones belong to a CA that was revoked or has expired: its final CRL, if any, is published and no new one is generated. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3475":2153,"_30471":2134,"_21105":56308,"_5":14473,"_27705":56250,"_2959":56309},[],"`legacy_ski`",{"_3475":2154,"_30471":2134,"_21105":56311,"_5":14473,"_27705":56250,"_2959":56312},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3475":2155,"_30471":2134,"_21105":56314,"_5":14473,"_27705":56250,"_2959":56315},[],"`latest_crl`",{"_3475":2156,"_30471":2134,"_21105":56317,"_5":14473,"_27705":56250,"_2959":56318},[],"Version, validity start and end of the last published list. Read-only.",{"_3475":2157,"_30471":2134,"_21105":56320,"_5":14473,"_27705":56250,"_2959":56321},[],"`crl_options` field",{"_3475":2158,"_30471":2134,"_21105":56323,"_5":14473,"_27705":56250,"_2959":49985},[],{"_3475":2159,"_30471":2134,"_21105":56325,"_5":14473,"_27705":56250,"_2959":56326},[],"Initial value",{"_3475":2160,"_30471":2134,"_21105":56328,"_5":14473,"_27705":56250,"_2959":56329},[],"`validity`",{"_3475":2161,"_30471":2134,"_21105":56331,"_5":14473,"_27705":56250,"_2959":56332},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3475":2162,"_30471":2134,"_21105":56334,"_5":14473,"_27705":56250,"_2959":56335},[],"7 days.",{"_3475":2163,"_30471":2134,"_21105":56337,"_5":14473,"_27705":56250,"_2959":56338},[],"`refresh_interval`",{"_3475":2164,"_30471":2134,"_21105":56340,"_5":14473,"_27705":56250,"_2959":56341},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3475":2165,"_30471":2134,"_21105":56343,"_5":14473,"_27705":56250,"_2959":56344},[],"6 days and 23 hours.",{"_3475":2166,"_30471":2134,"_21105":56346,"_5":14473,"_27705":56250,"_2959":56347},[],"`regenerate_on_revoke`",{"_3475":2167,"_30471":2134,"_21105":56349,"_5":14473,"_27705":56250,"_2959":56350},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3475":2168,"_30471":2134,"_21105":56352,"_5":14473,"_27705":56250,"_2959":56353},[],"`true`.",{"_3475":2169,"_30471":2134,"_21105":56355,"_5":14473,"_27705":56250,"_2959":56356},[],"`signer_serial_number`",{"_3475":2170,"_30471":2134,"_21105":56358,"_5":14473,"_27705":56250,"_2959":56359},[],"Serial number of the existing certificate that signs the CRL.",{"_3475":2171,"_30471":2134,"_21105":56361,"_5":14473,"_27705":56250,"_2959":56362},[],"Serial number of the CA’s current certificate.",{"_3475":2172,"_30471":2134,"_21105":56364,"_5":14473,"_27705":56250,"_2959":56365},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3475":2173,"_30471":2134,"_21105":56367,"_5":14473,"_27705":56250,"_2959":56368},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3475":2174,"_30471":2134,"_21105":56370,"_5":14473,"_27705":56250,"_2959":56371},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3475":2175,"_30471":2134,"_21105":56373,"_5":14473,"_27705":56250,"_2959":56374},[],"Settings whose `status` is `FINAL` or `ARCHIVED` are read-only: any `PUT` returns 409. Deleting a CA keeps its CRL settings:",{"_3475":2176,"_30471":2134,"_21105":56376,"_5":14473,"_27705":56250,"_2959":56377},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated.",{"_3475":2177,"_30471":2134,"_21105":56379,"_5":14473,"_27705":56250,"_2959":56380},[],"`ARCHIVED` settings of a deleted CA can be deleted, with `DELETE` or from the console's Verification Authorities page. That CRL stops being served — anyone checking its certificates against it will no longer find it — while the CRLs already published remain in the bucket. The action cannot be undone.",{"_3475":2178,"_30471":2134,"_21105":56382,"_5":14473,"_27705":56250,"_2959":56383},[],"Adjust validity and signer before deleting a CA.",{"_3475":2179,"_30471":2134,"_21105":56385,"_5":14473,"_27705":56250,"_2959":56386},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3475":2180,"_30471":2134,"_21105":56388,"_5":14473,"_27705":56250,"_2959":56389},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3475":2181,"_30471":2134,"_21105":56391,"_5":14473,"_27705":56250,"_2959":56392},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3475":2182,"_30471":2134,"_21105":56394,"_5":14473,"_27705":56254,"_2959":56395},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3475":2183,"_30471":2134,"_21105":56397,"_5":14473,"_27705":56254,"_2959":56398},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3475":2184,"_30471":2134,"_21105":56400,"_5":14473,"_27705":56254,"_2959":56401},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3475":2185,"_30471":2134,"_21105":56403,"_5":14473,"_27705":56254,"_2959":56404},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3475":2186,"_30471":2134,"_21105":56406,"_5":14473,"_27705":56258,"_2959":56407},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3475":2187,"_30471":2134,"_21105":56409,"_5":14473,"_27705":56258,"_2959":56410},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3475":2188,"_30471":2134,"_21105":56412,"_5":14473,"_27705":56258,"_2959":56413},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3475":2189,"_30471":2134,"_21105":56415,"_5":14473,"_27705":56258,"_2959":56416},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3475":2190,"_30471":2134,"_21105":56418,"_5":14473,"_27705":56258,"_2959":56419},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3475":2191,"_30471":2134,"_21105":56421,"_5":14473,"_27705":56258,"_2959":56422},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3475":2192,"_30471":2134,"_21105":56424,"_5":14473,"_27705":56258,"_2959":56425},[],"Settings whose `status` is `FINAL` or `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3475":2193,"_30471":2134,"_21105":56427,"_5":14473,"_27705":56258,"_2959":56428},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3475":2194,"_30471":2134,"_21105":56430,"_5":14473,"_27705":56258,"_2959":56431},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3475":2195,"_30471":2134,"_21105":56433,"_5":14473,"_27705":56262,"_2959":56434},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3475":2196,"_30471":2134,"_21105":56436,"_5":14473,"_27705":56262,"_2959":56437},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3475":2197,"_30471":2134,"_21105":56439,"_5":14473,"_27705":56266,"_2959":56440},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3475":2198,"_30471":2134,"_21105":56442,"_5":14473,"_27705":56266,"_2959":56443},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3475":2199,"_30471":2134,"_21105":56445,"_5":14473,"_27705":56266,"_2959":56446},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3475":2200,"_30471":2134,"_21105":56448,"_5":14473,"_27705":56266,"_2959":56449},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3475":2201,"_30471":2134,"_21105":56451,"_5":14473,"_27705":56266,"_2959":56452},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3475":2202,"_30471":2134,"_21105":56454,"_5":14473,"_27705":56270,"_2959":56455},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3475":2203,"_30471":2134,"_21105":56457,"_5":14473,"_27705":56270,"_2959":52840},[],{"_3475":2204,"_30471":2134,"_21105":56459,"_5":14473,"_27705":56270,"_2959":56460},[],"Relative path",{"_3475":2205,"_30471":2134,"_21105":56462,"_5":14473,"_27705":56270,"_2959":52837},[],{"_3475":2206,"_30471":2134,"_21105":56464,"_5":14473,"_27705":56270,"_2959":56465},[],"`GET`",{"_3475":2207,"_30471":2134,"_21105":56467,"_5":14473,"_27705":56270,"_2959":56468},[],"`/v1/crl-settings`",{"_3475":2208,"_30471":2134,"_21105":56470,"_5":14473,"_27705":56270,"_2959":56471},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3475":2209,"_30471":2134,"_21105":56473,"_5":14473,"_27705":56270,"_2959":56465},[],{"_3475":2210,"_30471":2134,"_21105":56475,"_5":14473,"_27705":56270,"_2959":56476},[],"`/v1/crl-settings/{ca-id}`",{"_3475":2211,"_30471":2134,"_21105":56478,"_5":14473,"_27705":56270,"_2959":56479},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3475":2212,"_30471":2134,"_21105":56481,"_5":14473,"_27705":56270,"_2959":56482},[],"`PUT`",{"_3475":2213,"_30471":2134,"_21105":56484,"_5":14473,"_27705":56270,"_2959":56476},[],{"_3475":2214,"_30471":2134,"_21105":56486,"_5":14473,"_27705":56270,"_2959":56487},[],"Replace the CRL configuration of a CA.",{"_3475":2215,"_30471":2134,"_21105":56489,"_5":14473,"_27705":56270,"_2959":56490},[],"`DELETE`",{"_3475":2216,"_30471":2134,"_21105":56492,"_5":14473,"_27705":56270,"_2959":56476},[],{"_3475":2217,"_30471":2134,"_21105":56494,"_5":14473,"_27705":56270,"_2959":56495},[],"Delete the settings of a CA whose settings are `ARCHIVED`; its published CRLs stay in the bucket but stop being served.",{"_3475":2218,"_30471":2134,"_21105":56497,"_5":14473,"_27705":56270,"_2959":56498},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation's API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL. A `DELETE` returns 409 unless the settings are `ARCHIVED`.",{"_3475":2219,"_30471":2134,"_21105":56500,"_5":14473,"_27705":56270,"_2959":56501},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3475":2220,"_30471":2134,"_21105":56503,"_5":14473,"_27705":56274,"_2959":56504},[],"Symptom",{"_3475":2221,"_30471":2134,"_21105":56506,"_5":14473,"_27705":56274,"_2959":56507},[],"Cause",{"_3475":2222,"_30471":2134,"_21105":56509,"_5":14473,"_27705":56274,"_2959":56510},[],"Action",{"_3475":2223,"_30471":2134,"_21105":56512,"_5":14473,"_27705":56274,"_2959":56513},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3475":2224,"_30471":2134,"_21105":56515,"_5":14473,"_27705":56274,"_2959":56516},[],"The settings are not `ACTIVE`: they are `FINAL` or `ARCHIVED` (see the `status` table in CRL settings).",{"_3475":2225,"_30471":2134,"_21105":56518,"_5":14473,"_27705":56274,"_2959":56519},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3475":2226,"_30471":2134,"_21105":56521,"_5":14473,"_27705":56274,"_2959":56522},[],"`PUT` returns 400.",{"_3475":2227,"_30471":2134,"_21105":56524,"_5":14473,"_27705":56274,"_2959":56525},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3475":2228,"_30471":2134,"_21105":56527,"_5":14473,"_27705":56274,"_2959":56528},[],"Set the serial number of a valid certificate of that CA.",{"_3475":2229,"_30471":2134,"_21105":56530,"_5":14473,"_27705":56274,"_2959":56531},[],"`PUT` returns 404.",{"_3475":2230,"_30471":2134,"_21105":56533,"_5":14473,"_27705":56274,"_2959":56534},[],"The CA or the new signer certificate does not exist (for example, the CA was deleted), or the CA has no CRL settings (for example, an imported CA).",{"_3475":2231,"_30471":2134,"_21105":56536,"_5":14473,"_27705":56274,"_2959":56537},[],"Check the CA ID and the signer serial number.",{"_3475":2232,"_30471":2134,"_21105":56539,"_5":14473,"_27705":56274,"_2959":56540},[],"`PUT` returns 400 from a 3.x client.",{"_3475":2233,"_30471":2134,"_21105":56542,"_5":14473,"_27705":56274,"_2959":56543},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3475":2234,"_30471":2134,"_21105":56545,"_5":14473,"_27705":56274,"_2959":56546},[],"Update the client to send the new field.",{"_3475":2235,"_30471":2134,"_21105":56548,"_5":14473,"_27705":56274,"_2959":56549},[],"The CRL does not change after revoking a certificate.",{"_3475":2236,"_30471":2134,"_21105":56551,"_5":14473,"_27705":56274,"_2959":56552},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3475":2237,"_30471":2134,"_21105":56554,"_5":14473,"_27705":56274,"_2959":56555},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3475":2238,"_30471":2134,"_21105":56557,"_5":14473,"_27705":56274,"_2959":56558},[],"A verifier rejects the CRL because of the issuer.",{"_3475":2239,"_30471":2134,"_21105":56560,"_5":14473,"_27705":56274,"_2959":56561},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3475":2240,"_30471":2134,"_21105":56563,"_5":14473,"_27705":56274,"_2959":56564},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3475":2241,"_30471":2134,"_21105":56566,"_5":14473,"_27705":56278,"_2959":56567},[],"A CA's CRL settings are edited in the **Validation Authority** tab of the CA view, which you reach with **Configure VA** on the console's **Verification Authorities** page. Both read the settings by CA ID at `/v1/crl-settings/{ca-id}`, which requires a 4.0.0 backend. The Verification Authorities page does not edit the settings: it lists those of every CA for review and, for `ARCHIVED` settings, deletes them.",{"_3475":2242,"_30471":2134,"_21105":56569,"_5":14473,"_27705":56278,"_2959":56570},[],"If the backend has no settings for a CA yet, the tab shows a **No CRL Settings** panel stating that CRL settings are created when the CA is, and that if the CA was created just now they may still be initializing, with a **Retry** button. While the settings load, it shows &#x2A;*Loading CRL Settings...**; a failed fetch shows **Error Loading CRL Settings**, also with a **Retry** button. The 404 row of Common CRL settings errors lists when a CA can have no settings.",{"_3475":2243,"_30471":2134,"_21105":56572,"_5":14473,"_27705":56278,"_2959":56573},[],"In the CA view, the **Latest Generated CRL** section comes first and **CRL Configuration** last. Settings that are not `ACTIVE` are shown read-only: their status badge (`Active`, `Final` or `Archived`) appears next to the latest CRL, with a warning alert — **Final CRL Settings** or **Archived CRL Settings** — explaining that the settings cannot be edited; see Cases in which the settings can no longer be edited. Settings migrated from the SKI-keyed model show a note with their legacy CRL URL `/crl/<legacy-ski>`, which still resolves to this CA's list.",{"_3475":2244,"_30471":2134,"_21105":56575,"_5":14473,"_27705":56278,"_2959":56576},[],"The **Verification Authorities** page lists the CRL settings and the latest CRL of every Certification Authority, including those of deleted ones, whose last CRL is still served. It has a **Refresh** button, a text filter by CA name, DN or ID, and a status filter with **All**, **Active**, **Final** and **Archived**. The table lists each CA with its status badge, the version and validity (**Valid From** / **Valid Until**) of its latest CRL and its refresh interval (**Disabled** for `0`), with actions per row: **Configure VA** (opens the CA view's Validation Authority tab; hidden for archived rows), **Fetch & Show CRL**, **Download CRL** (when a latest CRL exists) and, for `ARCHIVED` rows, **Delete CRL Settings**. Rows of deleted CAs show **Deleted CA** with the CA ID instead of a name. Deleting opens a confirmation dialog warning that the CRL of the deleted CA will stop being served (anyone checking its certificates against it will no longer find it), that the CRLs already published stay in the bucket, and that the action cannot be undone.",{"_3475":2245,"_30471":2134,"_21105":56578,"_5":14473,"_27705":56278,"_2959":56579},[],"**Fetch & Show CRL**, from the CA view or the Verification Authorities page, opens a panel — docked at the bottom of the page on desktop, a side panel on mobile — that loads this CA's CRL when it opens; enter another URL to inspect any CRL. It shows the issuer DN, the update window (**This update** / **Next update**, with a progress bar), the CRL number and the revoked-certificate count broken down by the three most common reasons. A CRL whose **Next update** has passed shows an **Out of date** badge and a warning alert; otherwise the badge reads **Current**, and there is no badge when the CRL sets no next update. The revoked-certificate table can be filtered by serial number or reason, and its display is capped at 200 rows, with a notice suggesting to filter by serial number to find a specific certificate. Serial numbers link to the certificate details. The downloaded file is named `<ca-id>.crl`; compare version, issuer and timestamps with the copy downloaded from the public endpoint. A failed load shows a **Could not load the CRL** alert with the HTTP status or a message that the response is not a valid DER-encoded CRL, and a **Retry** button. When the console is served over HTTPS and the CRL URL uses `http://`, an insecure-URL warning appears, because the browser may block the plain HTTP request or upgrade it to HTTPS.",{"_3475":2246,"_30471":2134,"_21105":56581,"_5":14473,"_27705":56278,"_2959":56582},[],"The **CRL Refresh Interval** field accepts `0`. An info alert then explains that no new CRL is generated just because time has passed — one is only generated shortly before the current one expires — and, with **Regenerate CRL Immediately on Revocation** off, that revocations are not published until then. The Verification Authorities table shows **Disabled** for a refresh interval of `0`; the semantics are described in Periodic and automatic regeneration. The **CRL Max Validity / Cache Duration** field still requires a positive duration and rejects `0`.",{"_3475":2247,"_30471":2134,"_21105":56584,"_5":14473,"_27705":56278,"_2959":56585},[],"Editing is forgiving: a field shows its error only after you leave it. **Save CRL Settings** is always clickable; if any field is invalid when you save, the interface marks all of them, shows the errors and focuses the first invalid field instead of keeping the button disabled.",{"_3475":2248,"_30471":2134,"_21105":56587,"_5":14473,"_27705":56278,"_2959":56588},[],"The selected signer appears as a card with its issuer (the full DN in a tooltip on hover, and the issuer name links to its CA when its record is available), its expiry, key algorithm, usage chips and serial number, under the footer **CRL signer — Signs the CRLs of this CA**. The certificate picker only offers certificates that have a private key and carry the `cRLSign` key usage. If a configured signer's certificate cannot be resolved, the interface shows `Unknown Certificate (Serial: X)` or `Certificate details unavailable (Serial: X)`.",{"_3475":2249,"_30471":2134,"_21105":56590,"_5":14473,"_27705":56278,"_2959":56591},[],"Diagnose differences between the console and the public endpoint using PKI troubleshooting.",{"_3475":2250,"_30471":2134,"_21105":56593,"_5":14473,"_27705":56282,"_2959":56594},[],"RFC 5280: X.509 and CRL profile.",{"_3475":2251,"_30471":2134,"_21105":56596,"_5":14473,"_27705":56282,"_2959":56597},[],"OpenSSL: openssl-crl.",{"_3475":2252,"_30471":2134,"_21105":56599,"_5":14473,"_27705":56282,"_2959":56600},[],"OpenSSL: openssl-verify.",{"_3475":2253,"_30471":2134,"_21105":56602,"_5":14473,"_27705":56282,"_2959":56603},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":2254,"_30471":2134,"_21105":56605,"_5":14473,"_27705":56282,"_2959":56606},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3475":2255,"_30471":2255,"_5":14825,"_2959":56608,"_30823":56609,"_21105":56610,"_27705":2255},"Keys and cryptographic engines",[49595,51070,55075,55076],[],{"_3475":2256,"_30471":2255,"_21105":56612,"_5":14473,"_27705":2255,"_2959":56613},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3475":2257,"_30471":2255,"_5":30820,"_21105":56615,"_27705":56616,"_2959":56617},[],"/docs/pr-preview/pr-67/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3475":2258,"_30471":2255,"_5":30820,"_21105":56619,"_27705":56620,"_2959":56621},[],"/docs/pr-preview/pr-67/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3475":2259,"_30471":2255,"_5":30820,"_21105":56623,"_27705":56624,"_2959":56625},[],"/docs/pr-preview/pr-67/platform/pki/key-management#file-system","File System",{"_3475":2260,"_30471":2255,"_5":30820,"_21105":56627,"_27705":56628,"_2959":56629},[],"/docs/pr-preview/pr-67/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3475":2261,"_30471":2255,"_5":30820,"_21105":56631,"_27705":56632,"_2959":56633},[],"/docs/pr-preview/pr-67/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3475":2262,"_30471":2255,"_5":30820,"_21105":56635,"_27705":56636,"_2959":56637},[],"/docs/pr-preview/pr-67/platform/pki/key-management#aws-kms","AWS KMS",{"_3475":2263,"_30471":2255,"_5":30820,"_21105":56639,"_27705":56640,"_2959":56641},[],"/docs/pr-preview/pr-67/platform/pki/key-management#pkcs11","PKCS#11",{"_3475":2264,"_30471":2255,"_5":30820,"_21105":56643,"_27705":56644,"_2959":56645},[],"/docs/pr-preview/pr-67/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3475":2265,"_30471":2255,"_5":30820,"_21105":56647,"_27705":56648,"_2959":56649},[],"/docs/pr-preview/pr-67/platform/pki/key-management#key-inventory","Key inventory",{"_3475":2266,"_30471":2255,"_5":30820,"_21105":56651,"_27705":56652,"_2959":56653},[],"/docs/pr-preview/pr-67/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3475":2267,"_30471":2255,"_5":30820,"_21105":56655,"_27705":56656,"_2959":56657},[],"/docs/pr-preview/pr-67/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3475":2268,"_30471":2255,"_5":30820,"_21105":56659,"_27705":56660,"_2959":56661},[],"/docs/pr-preview/pr-67/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3475":2269,"_30471":2255,"_5":30820,"_21105":56663,"_27705":56664,"_2959":56665},[],"/docs/pr-preview/pr-67/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3475":2270,"_30471":2255,"_5":30820,"_21105":56667,"_27705":56668,"_2959":56669},[],"/docs/pr-preview/pr-67/platform/pki/key-management#view-details","View details",{"_3475":2271,"_30471":2255,"_5":30820,"_21105":56671,"_27705":56672,"_2959":56673},[],"/docs/pr-preview/pr-67/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3475":2272,"_30471":2255,"_5":30820,"_21105":56675,"_27705":56676,"_2959":56677},[],"/docs/pr-preview/pr-67/platform/pki/key-management#sign","Sign",{"_3475":2273,"_30471":2255,"_5":30820,"_21105":56679,"_27705":56680,"_2959":56681},[],"/docs/pr-preview/pr-67/platform/pki/key-management#verify","Verify",{"_3475":2274,"_30471":2255,"_5":30820,"_21105":56683,"_27705":56684,"_2959":56685},[],"/docs/pr-preview/pr-67/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3475":2275,"_30471":2255,"_5":30820,"_21105":56687,"_27705":56688,"_2959":56689},[],"/docs/pr-preview/pr-67/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3475":2276,"_30471":2255,"_5":30820,"_21105":56691,"_27705":56692,"_2959":56693},[],"/docs/pr-preview/pr-67/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3475":2277,"_30471":2255,"_21105":56695,"_5":14473,"_27705":2255,"_2959":56696},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3475":2278,"_30471":2255,"_21105":56698,"_5":14473,"_27705":2255,"_2959":56699},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3475":2279,"_30471":2255,"_21105":56701,"_5":14473,"_27705":56616,"_2959":56702},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3475":2280,"_30471":2255,"_21105":56704,"_5":14473,"_27705":56616,"_2959":56705},[],"In practice, it lets you:",{"_3475":2281,"_30471":2255,"_21105":56707,"_5":14473,"_27705":56616,"_2959":56708},[],"Generate new key pairs from Lamassu IoT.",{"_3475":2282,"_30471":2255,"_21105":56710,"_5":14473,"_27705":56616,"_2959":56711},[],"Import keys created externally.",{"_3475":2283,"_30471":2255,"_21105":56713,"_5":14473,"_27705":56616,"_2959":56714},[],"Delegate custody and cryptographic operations to external engines.",{"_3475":2284,"_30471":2255,"_21105":56716,"_5":14473,"_27705":56616,"_2959":56717},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3475":2285,"_30471":2255,"_21105":56719,"_5":14473,"_27705":56620,"_2959":56720},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3475":2286,"_30471":2255,"_21105":56722,"_5":14473,"_27705":56620,"_2959":56723},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3475":2287,"_30471":2255,"_21105":56725,"_5":14473,"_27705":56620,"_2959":56726},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3475":2288,"_30471":2255,"_21105":56728,"_5":14473,"_27705":56624,"_2959":56729},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3475":2289,"_30471":2255,"_21105":56731,"_5":14473,"_27705":56628,"_2959":56732},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3475":2290,"_30471":2255,"_21105":56734,"_5":14473,"_27705":56628,"_2959":56735},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3475":2291,"_30471":2255,"_21105":56737,"_5":14473,"_27705":56632,"_2959":56738},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3475":2292,"_30471":2255,"_21105":56740,"_5":14473,"_27705":56636,"_2959":56741},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3475":2293,"_30471":2255,"_21105":56743,"_5":14473,"_27705":56640,"_2959":56744},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3475":2294,"_30471":2255,"_21105":56746,"_5":14473,"_27705":56644,"_2959":56747},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3475":2295,"_30471":2255,"_21105":56749,"_5":14473,"_27705":56644,"_2959":56750},[],"Lamassu shows the enabled engines in the console.",{"_3475":2296,"_30471":2255,"_21105":56752,"_5":14473,"_27705":56644,"_2959":56753},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3475":2297,"_30471":2255,"_21105":56755,"_5":14473,"_27705":56644,"_2959":56756},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3475":2298,"_30471":2255,"_21105":56758,"_5":14473,"_27705":56648,"_2959":56759},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3475":2299,"_30471":2255,"_21105":56761,"_5":14473,"_27705":56648,"_2959":56762},[],"The table includes the following fields:",{"_3475":2300,"_30471":2255,"_21105":56764,"_5":14473,"_27705":56648,"_2959":56765},[],"**Name**: descriptive name of the key.",{"_3475":2301,"_30471":2255,"_21105":56767,"_5":14473,"_27705":56648,"_2959":56768},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3475":2302,"_30471":2255,"_21105":56770,"_5":14473,"_27705":56648,"_2959":56771},[],"**Strength**: visual indicator of cryptographic strength.",{"_3475":2303,"_30471":2255,"_21105":56773,"_5":14473,"_27705":56648,"_2959":56774},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3475":2304,"_30471":2255,"_21105":56776,"_5":14473,"_27705":56648,"_2959":56777},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3475":2305,"_30471":2255,"_21105":56779,"_5":14473,"_27705":56648,"_2959":56780},[],"**Aliases**: alternative names associated with the key.",{"_3475":2306,"_30471":2255,"_21105":56782,"_5":14473,"_27705":56648,"_2959":56783},[],"**Tags**: labels for classification and search.",{"_3475":2307,"_30471":2255,"_21105":56785,"_5":14473,"_27705":56648,"_2959":56786},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3475":2308,"_30471":2255,"_21105":56788,"_5":14473,"_27705":56648,"_2959":56789},[],"From this view you also reach the most common actions:",{"_3475":2309,"_30471":2255,"_21105":56791,"_5":14473,"_27705":56648,"_2959":56792},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3475":2310,"_30471":2255,"_21105":56794,"_5":14473,"_27705":56648,"_2959":56795},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3475":2311,"_30471":2255,"_21105":56797,"_5":14473,"_27705":56648,"_2959":56798},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3475":2312,"_30471":2255,"_21105":56800,"_5":14473,"_27705":56648,"_2959":56801},[],"**Delete Key** to remove the key from the system.",{"_3475":2313,"_30471":2255,"_21105":56803,"_5":14473,"_27705":56652,"_2959":56804},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3475":2314,"_30471":2255,"_21105":56806,"_5":14473,"_27705":56656,"_2959":56807},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3475":2315,"_30471":2255,"_21105":56809,"_5":14473,"_27705":56656,"_2959":56810},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3475":2316,"_30471":2255,"_21105":56812,"_5":14473,"_27705":56656,"_2959":56813},[],"**Key Name**: unique and descriptive name.",{"_3475":2317,"_30471":2255,"_21105":56815,"_5":14473,"_27705":56656,"_2959":56816},[],"**Crypto Engine**: engine that will keep the key.",{"_3475":2318,"_30471":2255,"_21105":56818,"_5":14473,"_27705":56656,"_2959":56819},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3475":2319,"_30471":2255,"_21105":56821,"_5":14473,"_27705":56656,"_2959":56822},[],"**Tags**: metadata to classify the key.",{"_3475":2320,"_30471":2255,"_21105":56824,"_5":14473,"_27705":56656,"_2959":56825},[],"**Metadata**: additional information for advanced uses.",{"_3475":2321,"_30471":2255,"_21105":56827,"_5":14473,"_27705":56660,"_2959":56828},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3475":2322,"_30471":2255,"_21105":56830,"_5":14473,"_27705":56660,"_2959":56831},[],"When you have an exportable private key and the destination engine supports import.",{"_3475":2323,"_30471":2255,"_21105":56833,"_5":14473,"_27705":56660,"_2959":56834},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3475":2324,"_30471":2255,"_21105":56836,"_5":14473,"_27705":56660,"_2959":56837},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3475":2325,"_30471":2255,"_21105":56839,"_5":14473,"_27705":56660,"_2959":56840},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3475":2326,"_30471":2255,"_21105":56842,"_5":14473,"_27705":56660,"_2959":56843},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3475":2327,"_30471":2255,"_21105":56845,"_5":14473,"_27705":56660,"_2959":56846},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3475":2328,"_30471":2255,"_21105":56848,"_5":14473,"_27705":56660,"_2959":56849},[],"**Tags**: labels for organization and search.",{"_3475":2329,"_30471":2255,"_21105":56851,"_5":14473,"_27705":56660,"_2959":56852},[],"**Metadata**: additional optional information.",{"_3475":2330,"_30471":2255,"_21105":56854,"_5":14473,"_27705":56660,"_2959":56855},[],"**Private Key (PEM)**: private key in PEM format.",{"_3475":2331,"_30471":2255,"_21105":56857,"_5":14473,"_27705":56660,"_2959":56858},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3475":2332,"_30471":2255,"_21105":56860,"_5":14473,"_27705":56664,"_2959":56861},[],"Each registered key has a detail view and several operational actions.",{"_3475":2333,"_30471":2255,"_21105":56863,"_5":14473,"_27705":56668,"_2959":56864},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3475":2334,"_30471":2255,"_21105":56866,"_5":14473,"_27705":56668,"_2959":56867},[],"The **Overview** tab shows, among others, these fields:",{"_3475":2335,"_30471":2255,"_21105":56869,"_5":14473,"_27705":56668,"_2959":56870},[],"**Key Name**: descriptive name.",{"_3475":2336,"_30471":2255,"_21105":56872,"_5":14473,"_27705":56668,"_2959":56873},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3475":2337,"_30471":2255,"_21105":56875,"_5":14473,"_27705":56668,"_2959":56876},[],"**Tags**: associated labels.",{"_3475":2338,"_30471":2255,"_21105":56878,"_5":14473,"_27705":56668,"_2959":56879},[],"**Aliases**: alternative names.",{"_3475":2339,"_30471":2255,"_21105":56881,"_5":14473,"_27705":56668,"_2959":56882},[],"**Crypto Engine**: engine where the key resides.",{"_3475":2340,"_30471":2255,"_21105":56884,"_5":14473,"_27705":56668,"_2959":56885},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3475":2341,"_30471":2255,"_21105":56887,"_5":14473,"_27705":56668,"_2959":56888},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3475":2342,"_30471":2255,"_21105":56890,"_5":14473,"_27705":56668,"_2959":56891},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3475":2343,"_30471":2255,"_21105":56893,"_5":14473,"_27705":56672,"_2959":56894},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3475":2344,"_30471":2255,"_21105":56896,"_5":14473,"_27705":56672,"_2959":56897},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3475":2345,"_30471":2255,"_21105":56899,"_5":14473,"_27705":56672,"_2959":56900},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3475":2346,"_30471":2255,"_21105":56902,"_5":14473,"_27705":56676,"_2959":56903},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3475":2347,"_30471":2255,"_21105":56905,"_5":14473,"_27705":56676,"_2959":56906},[],"Main fields:",{"_3475":2348,"_30471":2255,"_21105":56908,"_5":14473,"_27705":56676,"_2959":56909},[],"**Algorithm**: signing algorithm available for the key type.",{"_3475":2349,"_30471":2255,"_21105":56911,"_5":14473,"_27705":56676,"_2959":56912},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3475":2350,"_30471":2255,"_21105":56914,"_5":14473,"_27705":56676,"_2959":56915},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3475":2351,"_30471":2255,"_21105":56917,"_5":14473,"_27705":56676,"_2959":56918},[],"**Message**: content to sign.",{"_3475":2352,"_30471":2255,"_21105":56920,"_5":14473,"_27705":56676,"_2959":56921},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3475":2353,"_30471":2255,"_21105":56923,"_5":14473,"_27705":56680,"_2959":56924},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3475":2354,"_30471":2255,"_21105":56926,"_5":14473,"_27705":56680,"_2959":56906},[],{"_3475":2355,"_30471":2255,"_21105":56928,"_5":14473,"_27705":56680,"_2959":56929},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3475":2356,"_30471":2255,"_21105":56931,"_5":14473,"_27705":56680,"_2959":56932},[],"**Message Type**: `Raw` or `Digest`.",{"_3475":2357,"_30471":2255,"_21105":56934,"_5":14473,"_27705":56680,"_2959":56935},[],"**Payload Encoding**: encoding of the message.",{"_3475":2358,"_30471":2255,"_21105":56937,"_5":14473,"_27705":56680,"_2959":56938},[],"**Message**: original message or hash.",{"_3475":2359,"_30471":2255,"_21105":56940,"_5":14473,"_27705":56680,"_2959":56941},[],"**Signature**: signature to check.",{"_3475":2360,"_30471":2255,"_21105":56943,"_5":14473,"_27705":56680,"_2959":56944},[],"**Result**: indicator of the validation result.",{"_3475":2361,"_30471":2255,"_21105":56946,"_5":14473,"_27705":56684,"_2959":56947},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3475":2362,"_30471":2255,"_21105":56949,"_5":14473,"_27705":56684,"_2959":56950},[],"This flow is useful for:",{"_3475":2363,"_30471":2255,"_21105":56952,"_5":14473,"_27705":56684,"_2959":56953},[],"Requesting certificates from an external CA.",{"_3475":2364,"_30471":2255,"_21105":56955,"_5":14473,"_27705":56684,"_2959":56956},[],"Renewing an identity while keeping the same key.",{"_3475":2365,"_30471":2255,"_21105":56958,"_5":14473,"_27705":56684,"_2959":56959},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3475":2366,"_30471":2255,"_21105":56961,"_5":14473,"_27705":56684,"_2959":56962},[],"**Common Name (CN)**: main name of the identity.",{"_3475":2367,"_30471":2255,"_21105":56964,"_5":14473,"_27705":56684,"_2959":56965},[],"**Organization (O)**: organization or company.",{"_3475":2368,"_30471":2255,"_21105":56967,"_5":14473,"_27705":56684,"_2959":56968},[],"**Organizational Unit (OU)**: department or unit.",{"_3475":2369,"_30471":2255,"_21105":56970,"_5":14473,"_27705":56684,"_2959":56971},[],"**Country (C)**: two-letter country code.",{"_3475":2370,"_30471":2255,"_21105":56973,"_5":14473,"_27705":56684,"_2959":56974},[],"**State / Province (ST)**: state or province.",{"_3475":2371,"_30471":2255,"_21105":56976,"_5":14473,"_27705":56684,"_2959":56977},[],"**Locality (L)**: city or locality.",{"_3475":2372,"_30471":2255,"_21105":56979,"_5":14473,"_27705":56684,"_2959":56980},[],"**Email Address**: contact email.",{"_3475":2373,"_30471":2255,"_21105":56982,"_5":14473,"_27705":56684,"_2959":56983},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3475":2374,"_30471":2255,"_21105":56985,"_5":14473,"_27705":56684,"_2959":56986},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3475":2375,"_30471":2255,"_21105":56988,"_5":14473,"_27705":56688,"_2959":56989},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3475":2376,"_30471":2255,"_21105":56991,"_5":14473,"_27705":56688,"_2959":56992},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3475":2377,"_30471":2255,"_21105":56994,"_5":14473,"_27705":56692,"_2959":56995},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3475":2378,"_30471":2255,"_21105":56997,"_5":14473,"_27705":56692,"_2959":56998},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3475":2379,"_30471":2379,"_5":14825,"_2959":57000,"_30823":57001,"_21105":57002,"_27705":2379},"Online validation with OCSP",[49595,51070,55075,55714],[],{"_3475":2380,"_30471":2379,"_21105":57004,"_5":14473,"_27705":2379,"_2959":57005},[],"Query signed status and verify the responder’s response.",{"_3475":2381,"_30471":2379,"_5":30820,"_21105":57007,"_27705":57008,"_2959":57009},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3475":2382,"_30471":2379,"_5":30820,"_21105":57011,"_27705":57012,"_2959":57013},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3475":2383,"_30471":2379,"_5":30820,"_21105":57015,"_27705":57016,"_2959":57017},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3475":2384,"_30471":2379,"_5":30820,"_21105":57019,"_27705":57020,"_2959":57021},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3475":2385,"_30471":2379,"_5":30820,"_21105":57023,"_27705":57024,"_2959":57025},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3475":2386,"_30471":2379,"_5":30820,"_21105":57027,"_27705":57028,"_2959":56283},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#references",{"_3475":2387,"_30471":2379,"_21105":57030,"_5":14473,"_27705":2379,"_2959":57031},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3475":2388,"_30471":2379,"_21105":57033,"_5":14473,"_27705":57008,"_2959":57034},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3475":2389,"_30471":2379,"_21105":57036,"_5":14473,"_27705":57008,"_2959":57037},[],"Record status",{"_3475":2390,"_30471":2379,"_21105":57039,"_5":14473,"_27705":57008,"_2959":57040},[],"Signed response",{"_3475":2391,"_30471":2379,"_21105":57042,"_5":14473,"_27705":57008,"_2959":54212},[],{"_3475":2392,"_30471":2379,"_21105":57044,"_5":14473,"_27705":57008,"_2959":57045},[],"`Good`.",{"_3475":2393,"_30471":2379,"_21105":57047,"_5":14473,"_27705":57008,"_2959":54229},[],{"_3475":2394,"_30471":2379,"_21105":57049,"_5":14473,"_27705":57008,"_2959":57050},[],"`Revoked`, with revocation reason and timestamp.",{"_3475":2395,"_30471":2379,"_21105":57052,"_5":14473,"_27705":57008,"_2959":57053},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3475":2396,"_30471":2379,"_21105":57055,"_5":14473,"_27705":57008,"_2959":57056},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3475":2397,"_30471":2379,"_21105":57058,"_5":14473,"_27705":57008,"_2959":57059},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3475":2398,"_30471":2379,"_21105":57061,"_5":14473,"_27705":57008,"_2959":57062},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3475":2399,"_30471":2379,"_21105":57064,"_5":14473,"_27705":57008,"_2959":57065},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3475":2400,"_30471":2379,"_21105":57067,"_5":14473,"_27705":57012,"_2959":57068},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3475":2401,"_30471":2379,"_21105":57070,"_5":14473,"_27705":57012,"_2959":57071},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3475":2402,"_30471":2379,"_21105":57073,"_5":14473,"_27705":57016,"_2959":57074},[],"The service accepts:",{"_3475":2403,"_30471":2379,"_21105":57076,"_5":14473,"_27705":57016,"_2959":52840},[],{"_3475":2404,"_30471":2379,"_21105":57078,"_5":14473,"_27705":57016,"_2959":57079},[],"VA service path",{"_3475":2405,"_30471":2379,"_21105":57081,"_5":14473,"_27705":57016,"_2959":57082},[],"Format",{"_3475":2406,"_30471":2379,"_21105":57084,"_5":14473,"_27705":57016,"_2959":57085},[],"`POST`",{"_3475":2407,"_30471":2379,"_21105":57087,"_5":14473,"_27705":57016,"_2959":57088},[],"`/ocsp`",{"_3475":2408,"_30471":2379,"_21105":57090,"_5":14473,"_27705":57016,"_2959":57091},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3475":2409,"_30471":2379,"_21105":57093,"_5":14473,"_27705":57016,"_2959":56465},[],{"_3475":2410,"_30471":2379,"_21105":57095,"_5":14473,"_27705":57016,"_2959":57096},[],"`/ocsp/{ocsp_request}`",{"_3475":2411,"_30471":2379,"_21105":57098,"_5":14473,"_27705":57016,"_2959":57099},[],"DER request encoded using padded URL Base64.",{"_3475":2412,"_30471":2379,"_21105":57101,"_5":14473,"_27705":57016,"_2959":57102},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3475":2413,"_30471":2379,"_21105":57104,"_5":14473,"_27705":57020,"_2959":57105},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3475":2414,"_30471":2379,"_21105":57107,"_5":14473,"_27705":57020,"_2959":57108},[],"Generate the request:",{"_3475":2415,"_30471":2379,"_21105":57110,"_5":14473,"_27705":57020,"_2959":57111},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3475":2416,"_30471":2379,"_21105":57113,"_5":14473,"_27705":57020,"_2959":57114},[],"Replace the example URL with the inspected endpoint:",{"_3475":2417,"_30471":2379,"_21105":57116,"_5":14473,"_27705":57020,"_2959":57117},[],"Verify the returned DER:",{"_3475":2418,"_30471":2379,"_21105":57119,"_5":14473,"_27705":57020,"_2959":57120},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3475":2419,"_30471":2379,"_21105":57122,"_5":14473,"_27705":57024,"_2959":57123},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3475":2420,"_30471":2379,"_21105":57125,"_5":14473,"_27705":57024,"_2959":57126},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3475":2421,"_30471":2379,"_21105":57128,"_5":14473,"_27705":57028,"_2959":57129},[],"RFC 6960: OCSP.",{"_3475":2422,"_30471":2379,"_21105":57131,"_5":14473,"_27705":57028,"_2959":57132},[],"OpenSSL: openssl-ocsp.",{"_3475":2423,"_30471":2379,"_21105":57134,"_5":14473,"_27705":57028,"_2959":57135},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3475":2424,"_30471":2379,"_21105":57137,"_5":14473,"_27705":57028,"_2959":56606},[],{"_3475":2425,"_30471":2425,"_5":14825,"_2959":55075,"_30823":57139,"_21105":57140,"_27705":2425},[49595,51070,55075],[],{"_3475":2426,"_30471":2425,"_21105":57142,"_5":14473,"_27705":2425,"_2959":57143},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3475":2427,"_30471":2425,"_5":30820,"_21105":57145,"_27705":57146,"_2959":54387},[],"/docs/pr-preview/pr-67/platform/pki/overview#start-here",{"_3475":2428,"_30471":2425,"_5":30820,"_21105":57148,"_27705":57149,"_2959":57150},[],"/docs/pr-preview/pr-67/platform/pki/overview#what-you-need","What you need",{"_3475":2429,"_30471":2425,"_5":30820,"_21105":57152,"_27705":57153,"_2959":54919},[],"/docs/pr-preview/pr-67/platform/pki/overview#core-capabilities",{"_3475":2430,"_30471":2425,"_5":30820,"_21105":57155,"_27705":57156,"_2959":54923},[],"/docs/pr-preview/pr-67/platform/pki/overview#build-your-trust-hierarchy",{"_3475":2431,"_30471":2425,"_5":30820,"_21105":57158,"_27705":57159,"_2959":54927},[],"/docs/pr-preview/pr-67/platform/pki/overview#protect-cryptographic-keys",{"_3475":2432,"_30471":2425,"_5":30820,"_21105":57161,"_27705":57162,"_2959":54931},[],"/docs/pr-preview/pr-67/platform/pki/overview#issue-and-control-certificates",{"_3475":2433,"_30471":2425,"_5":30820,"_21105":57164,"_27705":57165,"_2959":54939},[],"/docs/pr-preview/pr-67/platform/pki/overview#publish-validation-status",{"_3475":2434,"_30471":2425,"_5":30820,"_21105":57167,"_27705":57168,"_2959":57169},[],"/docs/pr-preview/pr-67/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3475":2435,"_30471":2425,"_5":30820,"_21105":57171,"_27705":57172,"_2959":55881},[],"/docs/pr-preview/pr-67/platform/pki/overview#continue",{"_3475":2436,"_30471":2425,"_21105":57174,"_5":14473,"_27705":2425,"_2959":57175},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3475":2437,"_30471":2425,"_21105":57177,"_5":14473,"_27705":57146,"_2959":57178},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3475":2438,"_30471":2425,"_21105":57180,"_5":14473,"_27705":57146,"_2959":57181},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3475":2439,"_30471":2425,"_21105":57183,"_5":14473,"_27705":57149,"_2959":57184},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3475":2440,"_30471":2425,"_21105":57186,"_5":14473,"_27705":57149,"_2959":57187},[],"An available cryptographic engine to keep the authority's key.",{"_3475":2441,"_30471":2425,"_21105":57189,"_5":14473,"_27705":57149,"_2959":57190},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3475":2442,"_30471":2425,"_21105":57192,"_5":14473,"_27705":57149,"_2959":57193},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3475":2443,"_30471":2425,"_21105":57195,"_5":14473,"_27705":57149,"_2959":57196},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3475":2444,"_30471":2425,"_21105":57198,"_5":14473,"_27705":57156,"_2959":57199},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3475":2445,"_30471":2425,"_21105":57201,"_5":14473,"_27705":57159,"_2959":57202},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3475":2446,"_30471":2425,"_21105":57204,"_5":14473,"_27705":57162,"_2959":57205},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3475":2447,"_30471":2425,"_21105":57207,"_5":14473,"_27705":57165,"_2959":57208},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3475":2448,"_30471":2425,"_21105":57210,"_5":14473,"_27705":57168,"_2959":57211},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3475":2449,"_30471":2425,"_21105":57213,"_5":14473,"_27705":57168,"_2959":57214},[],"its subject and extensions identify the expected client;",{"_3475":2450,"_30471":2425,"_21105":57216,"_5":14473,"_27705":57168,"_2959":57217},[],"its public key matches the client's private key;",{"_3475":2451,"_30471":2425,"_21105":57219,"_5":14473,"_27705":57168,"_2959":57220},[],"its chain reaches a root trusted by the consumer;",{"_3475":2452,"_30471":2425,"_21105":57222,"_5":14473,"_27705":57168,"_2959":57223},[],"its dates and usages allow the operation;",{"_3475":2453,"_30471":2425,"_21105":57225,"_5":14473,"_27705":57168,"_2959":57226},[],"the consumer applies revocation checks and authorization.",{"_3475":2454,"_30471":2425,"_21105":57228,"_5":14473,"_27705":57168,"_2959":57229},[],"The issuance path includes the first independent checks.",{"_3475":2455,"_30471":2425,"_21105":57231,"_5":14473,"_27705":57172,"_2959":57232},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3475":2456,"_30471":2425,"_21105":57234,"_5":14473,"_27705":57172,"_2959":57235},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3475":2457,"_30471":2425,"_21105":57237,"_5":14473,"_27705":57172,"_2959":57238},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3475":2458,"_30471":2458,"_5":14825,"_2959":57240,"_30823":57241,"_21105":57242,"_27705":2458},"Create your first CA",[49595,51070,55075,54512],[],{"_3475":2459,"_30471":2458,"_21105":57244,"_5":14473,"_27705":2458,"_2959":57245},[],"Create an evaluation root and check its certificate before issuing.",{"_3475":2460,"_30471":2458,"_5":30820,"_21105":57247,"_27705":57248,"_2959":49605},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3475":2461,"_30471":2458,"_5":30820,"_21105":57250,"_27705":57251,"_2959":57252},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3475":2462,"_30471":2458,"_5":30820,"_21105":57254,"_27705":57255,"_2959":57256},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3475":2463,"_30471":2458,"_5":30820,"_21105":57258,"_27705":57259,"_2959":57260},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3475":2464,"_30471":2458,"_5":30820,"_21105":57262,"_27705":57263,"_2959":57264},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3475":2465,"_30471":2458,"_5":30820,"_21105":57266,"_27705":57267,"_2959":57268},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3475":2466,"_30471":2458,"_5":30820,"_21105":57270,"_27705":57271,"_2959":57272},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3475":2467,"_30471":2458,"_5":30820,"_21105":57274,"_27705":57275,"_2959":54769},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3475":2468,"_30471":2458,"_5":30820,"_21105":57277,"_27705":57278,"_2959":49629},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3475":2469,"_30471":2458,"_21105":57280,"_5":14473,"_27705":2458,"_2959":57281},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3475":2470,"_30471":2458,"_21105":57283,"_5":14473,"_27705":57248,"_2959":57284},[],"Console access and permission to create keys and authorities.",{"_3475":2471,"_30471":2458,"_21105":57286,"_5":14473,"_27705":57248,"_2959":57287},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3475":2472,"_30471":2458,"_21105":57289,"_5":14473,"_27705":57248,"_2959":57290},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3475":2473,"_30471":2458,"_21105":57292,"_5":14473,"_27705":57248,"_2959":57293},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3475":2474,"_30471":2458,"_21105":57295,"_5":14473,"_27705":57251,"_2959":57296},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3475":2475,"_30471":2458,"_21105":57298,"_5":14473,"_27705":57251,"_2959":57299},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3475":2476,"_30471":2458,"_21105":57301,"_5":14473,"_27705":57255,"_2959":57302},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3475":2477,"_30471":2458,"_21105":57304,"_5":14473,"_27705":57255,"_2959":57305},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3475":2478,"_30471":2458,"_21105":57307,"_5":14473,"_27705":57259,"_2959":57308},[],"Select **Root CA** and complete:",{"_3475":2479,"_30471":2458,"_21105":57310,"_5":14473,"_27705":57259,"_2959":57311},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3475":2480,"_30471":2458,"_21105":57313,"_5":14473,"_27705":57259,"_2959":57314},[],"**Subject**: organization and country details for your evaluation.",{"_3475":2481,"_30471":2458,"_21105":57316,"_5":14473,"_27705":57259,"_2959":57317},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3475":2482,"_30471":2458,"_21105":57319,"_5":14473,"_27705":57259,"_2959":57320},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3475":2483,"_30471":2458,"_21105":57322,"_5":14473,"_27705":57259,"_2959":57323},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3475":2484,"_30471":2458,"_21105":57325,"_5":14473,"_27705":57263,"_2959":57326},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3475":2485,"_30471":2458,"_21105":57328,"_5":14473,"_27705":57267,"_2959":57329},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3475":2486,"_30471":2458,"_21105":57331,"_5":14473,"_27705":57267,"_2959":57332},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3475":2487,"_30471":2458,"_21105":57334,"_5":14473,"_27705":57271,"_2959":57335},[],"Run from the directory where you saved `ca.pem`:",{"_3475":2488,"_30471":2458,"_21105":57337,"_5":14473,"_27705":57271,"_2959":57338},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3475":2489,"_30471":2458,"_21105":57340,"_5":14473,"_27705":57271,"_2959":57341},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3475":2490,"_30471":2458,"_21105":57343,"_5":14473,"_27705":57275,"_2959":57344},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3475":2491,"_30471":2458,"_21105":57346,"_5":14473,"_27705":57275,"_2959":57347},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3475":2492,"_30471":2458,"_21105":57349,"_5":14473,"_27705":57275,"_2959":57350},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3475":2493,"_30471":2458,"_21105":57352,"_5":14473,"_27705":57275,"_2959":57353},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3475":2494,"_30471":2458,"_21105":57355,"_5":14473,"_27705":57278,"_2959":57356},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3475":2495,"_30471":2495,"_5":14825,"_2959":57358,"_30823":57359,"_21105":57360,"_27705":2495},"Issue and verify a certificate",[49595,51070,55075,54512],[],{"_3475":2496,"_30471":2495,"_21105":57362,"_5":14473,"_27705":2495,"_2959":57363},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3475":2497,"_30471":2495,"_5":30820,"_21105":57365,"_27705":57366,"_2959":49605},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3475":2498,"_30471":2495,"_5":30820,"_21105":57368,"_27705":57369,"_2959":57370},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3475":2499,"_30471":2495,"_5":30820,"_21105":57372,"_27705":57373,"_2959":57374},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3475":2500,"_30471":2495,"_5":30820,"_21105":57376,"_27705":57377,"_2959":57378},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3475":2501,"_30471":2495,"_5":30820,"_21105":57380,"_27705":57381,"_2959":57382},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3475":2502,"_30471":2495,"_5":30820,"_21105":57384,"_27705":57385,"_2959":57386},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3475":2503,"_30471":2495,"_5":30820,"_21105":57388,"_27705":57389,"_2959":57390},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3475":2504,"_30471":2495,"_5":30820,"_21105":57392,"_27705":57393,"_2959":57394},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3475":2505,"_30471":2495,"_5":30820,"_21105":57396,"_27705":57397,"_2959":57398},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3475":2506,"_30471":2495,"_5":30820,"_21105":57400,"_27705":57401,"_2959":57402},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3475":2507,"_30471":2495,"_5":30820,"_21105":57404,"_27705":57405,"_2959":54769},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3475":2508,"_30471":2495,"_5":30820,"_21105":57407,"_27705":57408,"_2959":49629},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#next-step",{"_3475":2509,"_30471":2495,"_21105":57410,"_5":14473,"_27705":2495,"_2959":57411},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3475":2510,"_30471":2495,"_21105":57413,"_5":14473,"_27705":57366,"_2959":57414},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3475":2511,"_30471":2495,"_21105":57416,"_5":14473,"_27705":57366,"_2959":57417},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3475":2512,"_30471":2495,"_21105":57419,"_5":14473,"_27705":57366,"_2959":57420},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3475":2513,"_30471":2495,"_21105":57422,"_5":14473,"_27705":57366,"_2959":57423},[],"A client identifier: here we use `device-001`.",{"_3475":2514,"_30471":2495,"_21105":57425,"_5":14473,"_27705":57366,"_2959":57426},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3475":2515,"_30471":2495,"_21105":57428,"_5":14473,"_27705":57369,"_2959":57429},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3475":2516,"_30471":2495,"_21105":57431,"_5":14473,"_27705":57373,"_2959":57432},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3475":2517,"_30471":2495,"_21105":57434,"_5":14473,"_27705":57373,"_2959":57435},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3475":2518,"_30471":2495,"_21105":57437,"_5":14473,"_27705":57377,"_2959":57438},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3475":2519,"_30471":2495,"_21105":57440,"_5":14473,"_27705":57377,"_2959":57441},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3475":2520,"_30471":2495,"_21105":57443,"_5":14473,"_27705":57381,"_2959":57444},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3475":2521,"_30471":2495,"_21105":57446,"_5":14473,"_27705":57381,"_2959":57447},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3475":2522,"_30471":2495,"_21105":57449,"_5":14473,"_27705":57385,"_2959":57450},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3475":2523,"_30471":2495,"_21105":57452,"_5":14473,"_27705":57389,"_2959":57453},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3475":2524,"_30471":2495,"_21105":57455,"_5":14473,"_27705":57393,"_2959":57456},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3475":2525,"_30471":2495,"_21105":57458,"_5":14473,"_27705":57397,"_2959":57459},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3475":2526,"_30471":2495,"_21105":57461,"_5":14473,"_27705":57397,"_2959":57462},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3475":2527,"_30471":2495,"_21105":57464,"_5":14473,"_27705":57397,"_2959":57465},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3475":2528,"_30471":2495,"_21105":57467,"_5":14473,"_27705":57401,"_2959":57468},[],"In Bash, compare the two public-key digests:",{"_3475":2529,"_30471":2495,"_21105":57470,"_5":14473,"_27705":57401,"_2959":57471},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3475":2530,"_30471":2495,"_21105":57473,"_5":14473,"_27705":57401,"_2959":57474},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3475":2531,"_30471":2495,"_21105":57476,"_5":14473,"_27705":57405,"_2959":54853},[],{"_3475":2532,"_30471":2495,"_21105":57478,"_5":14473,"_27705":57405,"_2959":57479},[],"What to review",{"_3475":2533,"_30471":2495,"_21105":57481,"_5":14473,"_27705":57405,"_2959":57482},[],"The CA rejects issuance",{"_3475":2534,"_30471":2495,"_21105":57484,"_5":14473,"_27705":57405,"_2959":57485},[],"Permissions, CA state and key, algorithm and profile.",{"_3475":2535,"_30471":2495,"_21105":57487,"_5":14473,"_27705":57405,"_2959":57488},[],"Different subject or usages",{"_3475":2536,"_30471":2495,"_21105":57490,"_5":14473,"_27705":57405,"_2959":57491},[],"Applied profile and requested values.",{"_3475":2537,"_30471":2495,"_21105":57493,"_5":14473,"_27705":57405,"_2959":57494},[],"Issuer cannot be found",{"_3475":2538,"_30471":2495,"_21105":57496,"_5":14473,"_27705":57405,"_2959":57497},[],"Downloaded CA and required intermediate chain.",{"_3475":2539,"_30471":2495,"_21105":57499,"_5":14473,"_27705":57405,"_2959":57500},[],"Validity fails",{"_3475":2540,"_30471":2495,"_21105":57502,"_5":14473,"_27705":57405,"_2959":57503},[],"Certificate and CA dates, and the computer's clock.",{"_3475":2541,"_30471":2495,"_21105":57505,"_5":14473,"_27705":57405,"_2959":57506},[],"Public-key digests differ",{"_3475":2542,"_30471":2495,"_21105":57508,"_5":14473,"_27705":57405,"_2959":57509},[],"Certificate and key files from the same issuance.",{"_3475":2543,"_30471":2495,"_21105":57511,"_5":14473,"_27705":57405,"_2959":57512},[],"See PKI diagnostics to narrow an issuance failure.",{"_3475":2544,"_30471":2495,"_21105":57514,"_5":14473,"_27705":57408,"_2959":57515},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3475":2545,"_30471":2495,"_21105":57517,"_5":14473,"_27705":57408,"_2959":57518},[],"Manage certificates for inspection, status and revocation.",{"_3475":2546,"_30471":2495,"_21105":57520,"_5":14473,"_27705":57408,"_2959":57521},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3475":2547,"_30471":2495,"_21105":57523,"_5":14473,"_27705":57408,"_2959":57524},[],"Prepare EST for the device to request its next identities.",{"_3475":2548,"_30471":2495,"_21105":57526,"_5":14473,"_27705":57408,"_2959":57527},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3475":2549,"_30471":2549,"_5":14825,"_2959":57529,"_30823":57530,"_21105":57531,"_27705":2549},"PKI getting started",[49595,51070,55075,54512],[],{"_3475":2550,"_30471":2549,"_21105":57533,"_5":14473,"_27705":2549,"_2959":57534},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3475":2551,"_30471":2549,"_5":30820,"_21105":57536,"_27705":57537,"_2959":49605},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/overview#before-you-begin",{"_3475":2552,"_30471":2549,"_5":30820,"_21105":57539,"_27705":57540,"_2959":57541},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3475":2553,"_30471":2549,"_5":30820,"_21105":57543,"_27705":57544,"_2959":54704},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/overview#expected-result",{"_3475":2554,"_30471":2549,"_5":30820,"_21105":57546,"_27705":57547,"_2959":57548},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3475":2555,"_30471":2549,"_21105":57550,"_5":14473,"_27705":2549,"_2959":57551},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3475":2556,"_30471":2549,"_21105":57553,"_5":14473,"_27705":57537,"_2959":57554},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3475":2557,"_30471":2549,"_21105":57556,"_5":14473,"_27705":57537,"_2959":57557},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3475":2558,"_30471":2549,"_21105":57559,"_5":14473,"_27705":57537,"_2959":57560},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3475":2559,"_30471":2549,"_21105":57562,"_5":14473,"_27705":57537,"_2959":57563},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3475":2560,"_30471":2549,"_21105":57565,"_5":14473,"_27705":57537,"_2959":57566},[],"A working directory with restricted access for the downloaded key.",{"_3475":2561,"_30471":2549,"_21105":57568,"_5":14473,"_27705":57540,"_2959":57569},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3475":2562,"_30471":2549,"_21105":57571,"_5":14473,"_27705":57540,"_2959":57572},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3475":2563,"_30471":2549,"_21105":57574,"_5":14473,"_27705":57540,"_2959":57575},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3475":2564,"_30471":2549,"_21105":57577,"_5":14473,"_27705":57540,"_2959":57578},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3475":2565,"_30471":2549,"_21105":57580,"_5":14473,"_27705":57544,"_2959":57581},[],"File or resource",{"_3475":2566,"_30471":2549,"_21105":57583,"_5":14473,"_27705":57544,"_2959":54701},[],{"_3475":2567,"_30471":2549,"_21105":57585,"_5":14473,"_27705":57544,"_2959":57586},[],"Active root CA and `ca.pem`",{"_3475":2568,"_30471":2549,"_21105":57588,"_5":14473,"_27705":57544,"_2959":57589},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3475":2569,"_30471":2549,"_21105":57591,"_5":14473,"_27705":57544,"_2959":57592},[],"End-entity certificate and `device.crt`",{"_3475":2570,"_30471":2549,"_21105":57594,"_5":14473,"_27705":57544,"_2959":57595},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3475":2571,"_30471":2549,"_21105":57597,"_5":14473,"_27705":57544,"_2959":57598},[],"Private key `device.key`",{"_3475":2572,"_30471":2549,"_21105":57600,"_5":14473,"_27705":57544,"_2959":57601},[],"Its public key matches the one included in `device.crt`.",{"_3475":2573,"_30471":2549,"_21105":57603,"_5":14473,"_27705":57544,"_2959":57604},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3475":2574,"_30471":2549,"_21105":57606,"_5":14473,"_27705":57547,"_2959":57607},[],"To operate certificates, continue with Certificates and Validation.",{"_3475":2575,"_30471":2549,"_21105":57609,"_5":14473,"_27705":57547,"_2959":57610},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3475":2576,"_30471":2549,"_21105":57612,"_5":14473,"_27705":57547,"_2959":57613},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3475":2577,"_30471":2577,"_5":14825,"_2959":57615,"_30823":57616,"_21105":57617,"_27705":2577},"PKI troubleshooting",[49595,51070,55075,53650],[],{"_3475":2578,"_30471":2577,"_21105":57619,"_5":14473,"_27705":2577,"_2959":57620},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3475":2579,"_30471":2577,"_5":30820,"_21105":57622,"_27705":57623,"_2959":57624},[],"/docs/pr-preview/pr-67/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3475":2580,"_30471":2577,"_5":30820,"_21105":57626,"_27705":57627,"_2959":57628},[],"/docs/pr-preview/pr-67/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3475":2581,"_30471":2577,"_5":30820,"_21105":57630,"_27705":57631,"_2959":57632},[],"/docs/pr-preview/pr-67/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3475":2582,"_30471":2577,"_21105":57634,"_5":14473,"_27705":2577,"_2959":57635},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3475":2583,"_30471":2577,"_21105":57637,"_5":14473,"_27705":2577,"_2959":57638},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3475":2584,"_30471":2577,"_21105":57640,"_5":14473,"_27705":57623,"_2959":54701},[],{"_3475":2585,"_30471":2577,"_21105":57642,"_5":14473,"_27705":57623,"_2959":57643},[],"What to inspect",{"_3475":2586,"_30471":2577,"_21105":57645,"_5":14473,"_27705":57623,"_2959":49629},[],{"_3475":2587,"_30471":2577,"_21105":57647,"_5":14473,"_27705":57623,"_2959":53917},[],{"_3475":2588,"_30471":2577,"_21105":57649,"_5":14473,"_27705":57623,"_2959":57650},[],"Exists, is active and has usable dates.",{"_3475":2589,"_30471":2577,"_21105":57652,"_5":14473,"_27705":57623,"_2959":57653},[],"Authorities.",{"_3475":2590,"_30471":2577,"_21105":57655,"_5":14473,"_27705":57623,"_2959":57656},[],"Key",{"_3475":2591,"_30471":2577,"_21105":57658,"_5":14473,"_27705":57623,"_2959":57659},[],"The record has a usable private key and the engine can sign.",{"_3475":2592,"_30471":2577,"_21105":57661,"_5":14473,"_27705":57623,"_2959":57662},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3475":2593,"_30471":2577,"_21105":57664,"_5":14473,"_27705":57623,"_2959":57665},[],"CSR",{"_3475":2594,"_30471":2577,"_21105":57667,"_5":14473,"_27705":57623,"_2959":57668},[],"Correct PEM and verifiable signature.",{"_3475":2595,"_30471":2577,"_21105":57670,"_5":14473,"_27705":57623,"_2959":57671},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3475":2596,"_30471":2577,"_21105":57673,"_5":14473,"_27705":57623,"_2959":57674},[],"Profile",{"_3475":2597,"_30471":2577,"_21105":57676,"_5":14473,"_27705":57623,"_2959":57677},[],"Selected source, existing ID, allowed algorithm and size.",{"_3475":2598,"_30471":2577,"_21105":57679,"_5":14473,"_27705":57623,"_2959":57680},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3475":2599,"_30471":2577,"_21105":57682,"_5":14473,"_27705":57623,"_2959":54853},[],{"_3475":2600,"_30471":2577,"_21105":57684,"_5":14473,"_27705":57623,"_2959":57685},[],"Appropriate subject, SAN, usages and dates.",{"_3475":2601,"_30471":2577,"_21105":57687,"_5":14473,"_27705":57623,"_2959":57688},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3475":2602,"_30471":2577,"_21105":57690,"_5":14473,"_27705":57623,"_2959":57691},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3475":2603,"_30471":2577,"_21105":57693,"_5":14473,"_27705":57623,"_2959":57694},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3475":2604,"_30471":2577,"_21105":57696,"_5":14473,"_27705":57627,"_2959":57697},[],"Check each boundary independently:",{"_3475":2605,"_30471":2577,"_21105":57699,"_5":14473,"_27705":57627,"_2959":57700},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3475":2606,"_30471":2577,"_21105":57702,"_5":14473,"_27705":57627,"_2959":57703},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3475":2607,"_30471":2577,"_21105":57705,"_5":14473,"_27705":57627,"_2959":57706},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3475":2608,"_30471":2577,"_21105":57708,"_5":14473,"_27705":57627,"_2959":57709},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3475":2609,"_30471":2577,"_21105":57711,"_5":14473,"_27705":57627,"_2959":57712},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3475":2610,"_30471":2577,"_21105":57714,"_5":14473,"_27705":57627,"_2959":57715},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3475":2611,"_30471":2577,"_21105":57717,"_5":14473,"_27705":57631,"_2959":57718},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3475":2612,"_30471":2577,"_21105":57720,"_5":14473,"_27705":57631,"_2959":57721},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3475":2613,"_30471":2613,"_5":14825,"_2959":57723,"_30823":57724,"_21105":57725,"_27705":2613},"Security",[49595],[],{"_3475":2614,"_30471":2613,"_21105":57727,"_5":14473,"_27705":2613,"_2959":57728},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3475":2615,"_30471":2613,"_5":30820,"_21105":57730,"_27705":57731,"_2959":57732},[],"/docs/pr-preview/pr-67/security#report-a-vulnerability","Report a vulnerability",{"_3475":2616,"_30471":2613,"_5":30820,"_21105":57734,"_27705":57735,"_2959":57736},[],"/docs/pr-preview/pr-67/security#what-to-include-in-a-report","What to include in a report",{"_3475":2617,"_30471":2613,"_5":30820,"_21105":57738,"_27705":57739,"_2959":57740},[],"/docs/pr-preview/pr-67/security#supported-versions","Supported versions",{"_3475":2618,"_30471":2613,"_5":30820,"_21105":57742,"_27705":57743,"_2959":57744},[],"/docs/pr-preview/pr-67/security#responsible-disclosure","Responsible disclosure",{"_3475":2619,"_30471":2613,"_21105":57746,"_5":14473,"_27705":2613,"_2959":57747},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3475":2620,"_30471":2613,"_21105":57749,"_5":14473,"_27705":57731,"_2959":57750},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3475":2621,"_30471":2613,"_21105":57752,"_5":14473,"_27705":57731,"_2959":57753},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3475":2622,"_30471":2613,"_21105":57755,"_5":14473,"_27705":57731,"_2959":15104},[],{"_3475":2623,"_30471":2613,"_21105":57757,"_5":14473,"_27705":57731,"_2959":15044},[],{"_3475":2624,"_30471":2613,"_21105":57759,"_5":14473,"_27705":57731,"_2959":15091},[],{"_3475":2625,"_30471":2613,"_21105":57761,"_5":14473,"_27705":57731,"_2959":57762},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3475":2626,"_30471":2613,"_21105":57764,"_5":14473,"_27705":57731,"_2959":57765},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3475":2627,"_30471":2613,"_21105":57767,"_5":14473,"_27705":57735,"_2959":57768},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3475":2628,"_30471":2613,"_21105":57770,"_5":14473,"_27705":57735,"_2959":57771},[],"Do not include in the report:",{"_3475":2629,"_30471":2613,"_21105":57773,"_5":14473,"_27705":57735,"_2959":57774},[],"Credentials, tokens, or private keys",{"_3475":2630,"_30471":2613,"_21105":57776,"_5":14473,"_27705":57735,"_2959":57777},[],"Customer data or customer-identifiable information",{"_3475":2631,"_30471":2613,"_21105":57779,"_5":14473,"_27705":57735,"_2959":57780},[],"Confidential architecture or internal infrastructure details",{"_3475":2632,"_30471":2613,"_21105":57782,"_5":14473,"_27705":57739,"_2959":57783},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3475":2633,"_30471":2613,"_21105":57785,"_5":14473,"_27705":57739,"_2959":57786},[],"For upgrade guidance, see Upgrades.",{"_3475":2634,"_30471":2613,"_21105":57788,"_5":14473,"_27705":57743,"_2959":57789},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3475":2635,"_30471":2613,"_21105":57791,"_5":14473,"_27705":57743,"_2959":57792},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3475":2636,"_30471":2613,"_21105":57794,"_5":14473,"_27705":57743,"_2959":57795},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3475":2637,"_30471":2613,"_21105":57797,"_5":14473,"_27705":57743,"_2959":57798},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3475":2638,"_30471":2613,"_21105":57800,"_5":14473,"_27705":57743,"_2959":57801},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3475":2639,"_30471":2639,"_5":14825,"_2959":57803,"_30823":57804,"_21105":57806,"_27705":2639},"3.8.0 to 4.0.0",[49595,57805],"Upgrades",[],{"_3475":2640,"_30471":2639,"_21105":57808,"_5":14473,"_27705":2639,"_2959":57809},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3475":2641,"_30471":2639,"_5":30820,"_21105":57811,"_27705":57812,"_2959":57813},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3475":2642,"_30471":2639,"_5":30820,"_21105":57815,"_27705":57816,"_2959":57817},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3475":2643,"_30471":2639,"_5":30820,"_21105":57819,"_27705":57820,"_2959":57821},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3475":2644,"_30471":2639,"_5":30820,"_21105":57823,"_27705":57824,"_2959":57825},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3475":2645,"_30471":2639,"_5":30820,"_21105":57827,"_27705":57828,"_2959":57829},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3475":2646,"_30471":2639,"_5":30820,"_21105":57831,"_27705":57832,"_2959":57833},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3475":2647,"_30471":2639,"_5":30820,"_21105":57835,"_27705":57836,"_2959":57837},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3475":2648,"_30471":2639,"_5":30820,"_21105":57839,"_27705":57840,"_2959":57841},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3475":2649,"_30471":2639,"_5":30820,"_21105":57843,"_27705":57844,"_2959":57845},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3475":2650,"_30471":2639,"_5":30820,"_21105":57847,"_27705":57848,"_2959":57849},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3475":2651,"_30471":2639,"_5":30820,"_21105":57851,"_27705":57852,"_2959":57853},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3475":2652,"_30471":2639,"_5":30820,"_21105":57855,"_27705":57856,"_2959":57857},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3475":2653,"_30471":2639,"_5":30820,"_21105":57859,"_27705":57860,"_2959":57861},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3475":2654,"_30471":2639,"_5":30820,"_21105":57863,"_27705":57864,"_2959":57865},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3475":2655,"_30471":2639,"_5":30820,"_21105":57867,"_27705":57868,"_2959":57869},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3475":2656,"_30471":2639,"_5":30820,"_21105":57871,"_27705":57872,"_2959":57873},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3475":2657,"_30471":2639,"_5":30820,"_21105":57875,"_27705":57876,"_2959":57877},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3475":2658,"_30471":2639,"_5":30820,"_21105":57879,"_27705":57880,"_2959":57881},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3475":2659,"_30471":2639,"_5":30820,"_21105":57883,"_27705":57884,"_2959":57885},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3475":2660,"_30471":2639,"_5":30820,"_21105":57887,"_27705":57888,"_2959":57889},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3475":2661,"_30471":2639,"_5":30820,"_21105":57891,"_27705":57892,"_2959":57893},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3475":2662,"_30471":2639,"_5":30820,"_21105":57895,"_27705":57896,"_2959":57897},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3475":2663,"_30471":2639,"_5":30820,"_21105":57899,"_27705":57900,"_2959":57901},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3475":2664,"_30471":2639,"_5":30820,"_21105":57903,"_27705":57904,"_2959":57905},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3475":2665,"_30471":2639,"_5":30820,"_21105":57907,"_27705":57908,"_2959":57909},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3475":2666,"_30471":2639,"_5":30820,"_21105":57911,"_27705":57912,"_2959":57913},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3475":2667,"_30471":2639,"_5":30820,"_21105":57915,"_27705":57916,"_2959":57917},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3475":2668,"_30471":2639,"_5":30820,"_21105":57919,"_27705":57920,"_2959":57921},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3475":2669,"_30471":2639,"_5":30820,"_21105":57923,"_27705":57924,"_2959":57925},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3475":2670,"_30471":2639,"_5":30820,"_21105":57927,"_27705":57928,"_2959":57929},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3475":2671,"_30471":2639,"_5":30820,"_21105":57931,"_27705":57932,"_2959":57933},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3475":2672,"_30471":2639,"_5":30820,"_21105":57935,"_27705":57936,"_2959":57937},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3475":2673,"_30471":2639,"_5":30820,"_21105":57939,"_27705":57940,"_2959":57941},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3475":2674,"_30471":2639,"_5":30820,"_21105":57943,"_27705":57944,"_2959":57945},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3475":2675,"_30471":2639,"_5":30820,"_21105":57947,"_27705":57948,"_2959":57949},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3475":2676,"_30471":2639,"_5":30820,"_21105":57951,"_27705":57952,"_2959":57953},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3475":2677,"_30471":2639,"_5":30820,"_21105":57955,"_27705":57956,"_2959":57957},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3475":2678,"_30471":2639,"_5":30820,"_21105":57959,"_27705":57960,"_2959":57961},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3475":2679,"_30471":2639,"_5":30820,"_21105":57963,"_27705":57964,"_2959":57965},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3475":2680,"_30471":2639,"_5":30820,"_21105":57967,"_27705":57968,"_2959":57969},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3475":2681,"_30471":2639,"_5":30820,"_21105":57971,"_27705":57972,"_2959":53650},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3475":2682,"_30471":2639,"_5":30820,"_21105":57974,"_27705":57975,"_2959":57976},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3475":2683,"_30471":2639,"_5":30820,"_21105":57978,"_27705":57979,"_2959":57980},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3475":2684,"_30471":2639,"_21105":57982,"_5":14473,"_27705":2639,"_2959":57983},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3475":2685,"_30471":2639,"_21105":57985,"_5":14473,"_27705":2639,"_2959":57986},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3475":2686,"_30471":2639,"_21105":57988,"_5":14473,"_27705":2639,"_2959":57989},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3475":2687,"_30471":2639,"_21105":57991,"_5":14473,"_27705":2639,"_2959":57992},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3475":2688,"_30471":2639,"_21105":57994,"_5":14473,"_27705":2639,"_2959":57995},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3475":2689,"_30471":2639,"_21105":57997,"_5":14473,"_27705":2639,"_2959":57998},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3475":2690,"_30471":2639,"_21105":58000,"_5":14473,"_27705":2639,"_2959":58001},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3475":2691,"_30471":2639,"_21105":58003,"_5":14473,"_27705":57816,"_2959":58004},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3475":2692,"_30471":2639,"_21105":58006,"_5":14473,"_27705":57816,"_2959":58007},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3475":2693,"_30471":2639,"_21105":58009,"_5":14473,"_27705":57820,"_2959":58010},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3475":2694,"_30471":2639,"_21105":58012,"_5":14473,"_27705":57820,"_2959":58013},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3475":2695,"_30471":2639,"_21105":58015,"_5":14473,"_27705":57824,"_2959":58016},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3475":2696,"_30471":2639,"_21105":58018,"_5":14473,"_27705":57828,"_2959":58019},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3475":2697,"_30471":2639,"_21105":58021,"_5":14473,"_27705":57828,"_2959":58022},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3475":2698,"_30471":2639,"_21105":58024,"_5":14473,"_27705":57828,"_2959":58025},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3475":2699,"_30471":2639,"_21105":58027,"_5":14473,"_27705":57828,"_2959":58028},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3475":2700,"_30471":2639,"_21105":58030,"_5":14473,"_27705":57828,"_2959":58031},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3475":2701,"_30471":2639,"_21105":58033,"_5":14473,"_27705":57832,"_2959":58034},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3475":2702,"_30471":2639,"_21105":58036,"_5":14473,"_27705":57832,"_2959":58037},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3475":2703,"_30471":2639,"_21105":58039,"_5":14473,"_27705":57832,"_2959":58040},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3475":2704,"_30471":2639,"_21105":58042,"_5":14473,"_27705":57832,"_2959":58043},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3475":2705,"_30471":2639,"_21105":58045,"_5":14473,"_27705":57832,"_2959":58046},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3475":2706,"_30471":2639,"_21105":58048,"_5":14473,"_27705":57832,"_2959":58049},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3475":2707,"_30471":2639,"_21105":58051,"_5":14473,"_27705":57836,"_2959":58052},[],"Change",{"_3475":2708,"_30471":2639,"_21105":58054,"_5":14473,"_27705":57836,"_2959":58055},[],"Who is affected",{"_3475":2709,"_30471":2639,"_21105":58057,"_5":14473,"_27705":57836,"_2959":58058},[],"Severity",{"_3475":2710,"_30471":2639,"_21105":58060,"_5":14473,"_27705":57836,"_2959":56510},[],{"_3475":2711,"_30471":2639,"_21105":58062,"_5":14473,"_27705":57836,"_2959":57845},[],{"_3475":2712,"_30471":2639,"_21105":58064,"_5":14473,"_27705":57836,"_2959":58065},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3475":2713,"_30471":2639,"_21105":58067,"_5":14473,"_27705":57836,"_2959":58068},[],"High: KMS and VA start on empty volumes",{"_3475":2714,"_30471":2639,"_21105":58070,"_5":14473,"_27705":57836,"_2959":58071},[],"Copy the data into the new volumes",{"_3475":2715,"_30471":2639,"_21105":58073,"_5":14473,"_27705":57836,"_2959":57849},[],{"_3475":2716,"_30471":2639,"_21105":58075,"_5":14473,"_27705":57836,"_2959":58076},[],"Every Helm release",{"_3475":2717,"_30471":2639,"_21105":58078,"_5":14473,"_27705":57836,"_2959":58079},[],"High: `helm upgrade` fails",{"_3475":2718,"_30471":2639,"_21105":58081,"_5":14473,"_27705":57836,"_2959":58082},[],"Remove or rename legacy keys",{"_3475":2719,"_30471":2639,"_21105":58084,"_5":14473,"_27705":57836,"_2959":57853},[],{"_3475":2720,"_30471":2639,"_21105":58086,"_5":14473,"_27705":57836,"_2959":58087},[],"Every deployment",{"_3475":2721,"_30471":2639,"_21105":58089,"_5":14473,"_27705":57836,"_2959":58090},[],"High: without a bootstrap principal there is no administrator",{"_3475":2722,"_30471":2639,"_21105":58092,"_5":14473,"_27705":57836,"_2959":58093},[],"Configure `services.authz`",{"_3475":2723,"_30471":2639,"_21105":58095,"_5":14473,"_27705":57836,"_2959":57857},[],{"_3475":2724,"_30471":2639,"_21105":58097,"_5":14473,"_27705":57836,"_2959":58076},[],{"_3475":2725,"_30471":2639,"_21105":58099,"_5":14473,"_27705":57836,"_2959":58100},[],"High: `helm upgrade` fails on the old keys",{"_3475":2726,"_30471":2639,"_21105":58102,"_5":14473,"_27705":57836,"_2959":58103},[],"Move JWKS and roles into `services.authz`",{"_3475":2727,"_30471":2639,"_21105":58105,"_5":14473,"_27705":57836,"_2959":57877},[],{"_3475":2728,"_30471":2639,"_21105":58107,"_5":14473,"_27705":57836,"_2959":58108},[],"3.8.0 deployments with per-service databases",{"_3475":2729,"_30471":2639,"_21105":58110,"_5":14473,"_27705":57836,"_2959":58111},[],"High: services find no data, or a migration aborts",{"_3475":2730,"_30471":2639,"_21105":58113,"_5":14473,"_27705":57836,"_2959":58114},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3475":2731,"_30471":2639,"_21105":58116,"_5":14473,"_27705":57836,"_2959":57881},[],{"_3475":2732,"_30471":2639,"_21105":58118,"_5":14473,"_27705":57836,"_2959":58119},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3475":2733,"_30471":2639,"_21105":58121,"_5":14473,"_27705":57836,"_2959":58122},[],"High: the backend no longer starts with them",{"_3475":2734,"_30471":2639,"_21105":58124,"_5":14473,"_27705":57836,"_2959":58125},[],"Move to PostgreSQL before upgrading",{"_3475":2735,"_30471":2639,"_21105":58127,"_5":14473,"_27705":57836,"_2959":57925},[],{"_3475":2736,"_30471":2639,"_21105":58129,"_5":14473,"_27705":57836,"_2959":58130},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3475":2737,"_30471":2639,"_21105":58132,"_5":14473,"_27705":57836,"_2959":58133},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3475":2738,"_30471":2639,"_21105":58135,"_5":14473,"_27705":57836,"_2959":58136},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3475":2739,"_30471":2639,"_21105":58138,"_5":14473,"_27705":57836,"_2959":58139},[],"Webhooks with file references",{"_3475":2740,"_30471":2639,"_21105":58141,"_5":14473,"_27705":57836,"_2959":58142},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3475":2741,"_30471":2639,"_21105":58144,"_5":14473,"_27705":57836,"_2959":58145},[],"High: enrollments calling the webhook fail",{"_3475":2742,"_30471":2639,"_21105":58147,"_5":14473,"_27705":57836,"_2959":58148},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3475":2743,"_30471":2639,"_21105":58150,"_5":14473,"_27705":57836,"_2959":57861},[],{"_3475":2744,"_30471":2639,"_21105":58152,"_5":14473,"_27705":57836,"_2959":58153},[],"Releases with per-service identity overrides or mounted key material",{"_3475":2745,"_30471":2639,"_21105":58155,"_5":14473,"_27705":57836,"_2959":58156},[],"Medium: services cannot read their files",{"_3475":2746,"_30471":2639,"_21105":58158,"_5":14473,"_27705":57836,"_2959":58159},[],"Remove the overrides and fix volume ownership",{"_3475":2747,"_30471":2639,"_21105":58161,"_5":14473,"_27705":57836,"_2959":57865},[],{"_3475":2748,"_30471":2639,"_21105":58163,"_5":14473,"_27705":57836,"_2959":58164},[],"Releases that set `amqp.tls`",{"_3475":2749,"_30471":2639,"_21105":58166,"_5":14473,"_27705":57836,"_2959":58167},[],"Medium: clients connect to the wrong port",{"_3475":2750,"_30471":2639,"_21105":58169,"_5":14473,"_27705":57836,"_2959":58170},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3475":2751,"_30471":2639,"_21105":58172,"_5":14473,"_27705":57836,"_2959":57885},[],{"_3475":2752,"_30471":2639,"_21105":58174,"_5":14473,"_27705":57836,"_2959":58175},[],"Installations whose CA keys predate the KMS",{"_3475":2753,"_30471":2639,"_21105":58177,"_5":14473,"_27705":57836,"_2959":58178},[],"Medium: CA keys stay unmanaged",{"_3475":2754,"_30471":2639,"_21105":58180,"_5":14473,"_27705":57836,"_2959":58181},[],"Run the CA-to-KMS migration",{"_3475":2755,"_30471":2639,"_21105":58183,"_5":14473,"_27705":57836,"_2959":58184},[],"Receiver certificate verification",{"_3475":2756,"_30471":2639,"_21105":58186,"_5":14473,"_27705":57836,"_2959":58187},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3475":2757,"_30471":2639,"_21105":58189,"_5":14473,"_27705":57836,"_2959":58190},[],"Medium: credentials go to an unverified receiver",{"_3475":2758,"_30471":2639,"_21105":58192,"_5":14473,"_27705":57836,"_2959":58193},[],"Set `insecure_skip_verify` to `false`",{"_3475":2759,"_30471":2639,"_21105":58195,"_5":14473,"_27705":57836,"_2959":57901},[],{"_3475":2760,"_30471":2639,"_21105":58197,"_5":14473,"_27705":57836,"_2959":58198},[],"Scripts and consoles that edit DMSs through the API",{"_3475":2761,"_30471":2639,"_21105":58200,"_5":14473,"_27705":57836,"_2959":58201},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3475":2762,"_30471":2639,"_21105":58203,"_5":14473,"_27705":57836,"_2959":58204},[],"Read the DMS before editing and use the new field",{"_3475":2763,"_30471":2639,"_21105":58206,"_5":14473,"_27705":57836,"_2959":57921},[],{"_3475":2764,"_30471":2639,"_21105":58208,"_5":14473,"_27705":57836,"_2959":58209},[],"Clients that create or update CRL settings through the API",{"_3475":2765,"_30471":2639,"_21105":58211,"_5":14473,"_27705":57836,"_2959":58212},[],"Medium: requests with the old field return an error",{"_3475":2766,"_30471":2639,"_21105":58214,"_5":14473,"_27705":57836,"_2959":58215},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3475":2767,"_30471":2639,"_21105":58217,"_5":14473,"_27705":57836,"_2959":57929},[],{"_3475":2768,"_30471":2639,"_21105":58219,"_5":14473,"_27705":57836,"_2959":58220},[],"Alert subscriptions and consumers of the VA events",{"_3475":2769,"_30471":2639,"_21105":58222,"_5":14473,"_27705":57836,"_2959":58223},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3475":2770,"_30471":2639,"_21105":58225,"_5":14473,"_27705":57836,"_2959":58226},[],"Review conditions filtering on the old event payload or subject",{"_3475":2771,"_30471":2639,"_21105":58228,"_5":14473,"_27705":57836,"_2959":57917},[],{"_3475":2772,"_30471":2639,"_21105":58230,"_5":14473,"_27705":57836,"_2959":58231},[],"Consumers that read the device `events` field",{"_3475":2773,"_30471":2639,"_21105":58233,"_5":14473,"_27705":57836,"_2959":58234},[],"Medium: the field disappears",{"_3475":2774,"_30471":2639,"_21105":58236,"_5":14473,"_27705":57836,"_2959":58237},[],"Use the new event endpoints",{"_3475":2775,"_30471":2639,"_21105":58239,"_5":14473,"_27705":57836,"_2959":57937},[],{"_3475":2776,"_30471":2639,"_21105":58241,"_5":14473,"_27705":57836,"_2959":58242},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3475":2777,"_30471":2639,"_21105":58244,"_5":14473,"_27705":57836,"_2959":58245},[],"Medium: the VA migration aborts",{"_3475":2778,"_30471":2639,"_21105":58247,"_5":14473,"_27705":57836,"_2959":58248},[],"Fix the affected roles before upgrading",{"_3475":2779,"_30471":2639,"_21105":58250,"_5":14473,"_27705":57836,"_2959":57869},[],{"_3475":2780,"_30471":2639,"_21105":58252,"_5":14473,"_27705":57836,"_2959":58253},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3475":2781,"_30471":2639,"_21105":58255,"_5":14473,"_27705":57836,"_2959":58256},[],"Low to medium: validation errors or changed defaults",{"_3475":2782,"_30471":2639,"_21105":58258,"_5":14473,"_27705":57836,"_2959":58259},[],"Update the values file",{"_3475":2783,"_30471":2639,"_21105":58261,"_5":14473,"_27705":57836,"_2959":57909},[],{"_3475":2784,"_30471":2639,"_21105":58263,"_5":14473,"_27705":57836,"_2959":58264},[],"Clients that send the DMS ID in the update body",{"_3475":2785,"_30471":2639,"_21105":58266,"_5":14473,"_27705":57836,"_2959":58267},[],"Low: the ID in the URL wins",{"_3475":2786,"_30471":2639,"_21105":58269,"_5":14473,"_27705":57836,"_2959":58270},[],"Send the ID in the URL",{"_3475":2787,"_30471":2639,"_21105":58272,"_5":14473,"_27705":57836,"_2959":57933},[],{"_3475":2788,"_30471":2639,"_21105":58274,"_5":14473,"_27705":57836,"_2959":58275},[],"Clients that send an `id` when creating or importing CAs",{"_3475":2789,"_30471":2639,"_21105":58277,"_5":14473,"_27705":57836,"_2959":58278},[],"Low: the ID in the body is ignored, and the field is removed",{"_3475":2790,"_30471":2639,"_21105":58280,"_5":14473,"_27705":57836,"_2959":58281},[],"Let the backend assign the ID and use the returned one",{"_3475":2791,"_30471":2639,"_21105":58283,"_5":14473,"_27705":57836,"_2959":57913},[],{"_3475":2792,"_30471":2639,"_21105":58285,"_5":14473,"_27705":57836,"_2959":58286},[],"Consumers that match on certificate `type`",{"_3475":2793,"_30471":2639,"_21105":58288,"_5":14473,"_27705":57836,"_2959":58289},[],"Low: two values are renamed",{"_3475":2794,"_30471":2639,"_21105":58291,"_5":14473,"_27705":57836,"_2959":58292},[],"Adapt consumers",{"_3475":2795,"_30471":2639,"_21105":58294,"_5":14473,"_27705":57836,"_2959":57905},[],{"_3475":2796,"_30471":2639,"_21105":58296,"_5":14473,"_27705":57836,"_2959":58297},[],"Any DMS",{"_3475":2797,"_30471":2639,"_21105":58299,"_5":14473,"_27705":57836,"_2959":58300},[],"Low: informational",{"_3475":2798,"_30471":2639,"_21105":58302,"_5":14473,"_27705":57836,"_2959":58303},[],"Read both blocks before editing",{"_3475":2799,"_30471":2639,"_21105":58305,"_5":14473,"_27705":57844,"_2959":58306},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3475":2800,"_30471":2639,"_21105":58308,"_5":14473,"_27705":57844,"_2959":58309},[],"Step 4 of the migration guide copies the data.",{"_3475":2801,"_30471":2639,"_21105":58311,"_5":14473,"_27705":57848,"_2959":58312},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3475":2802,"_30471":2639,"_21105":58314,"_5":14473,"_27705":57852,"_2959":58315},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3475":2803,"_30471":2639,"_21105":58317,"_5":14473,"_27705":57856,"_2959":58318},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3475":2804,"_30471":2639,"_21105":58320,"_5":14473,"_27705":57860,"_2959":58321},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3475":2805,"_30471":2639,"_21105":58323,"_5":14473,"_27705":57860,"_2959":58324},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3475":2806,"_30471":2639,"_21105":58326,"_5":14473,"_27705":57864,"_2959":58327},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3475":2807,"_30471":2639,"_21105":58329,"_5":14473,"_27705":57868,"_2959":58330},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3475":2808,"_30471":2639,"_21105":58332,"_5":14473,"_27705":57868,"_2959":58333},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3475":2809,"_30471":2639,"_21105":58335,"_5":14473,"_27705":57868,"_2959":58336},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3475":2810,"_30471":2639,"_21105":58338,"_5":14473,"_27705":57868,"_2959":58339},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3475":2811,"_30471":2639,"_21105":58341,"_5":14473,"_27705":57868,"_2959":58342},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3475":2812,"_30471":2639,"_21105":58344,"_5":14473,"_27705":57868,"_2959":58345},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3475":2813,"_30471":2639,"_21105":58347,"_5":14473,"_27705":57876,"_2959":58348},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3475":2814,"_30471":2639,"_21105":58350,"_5":14473,"_27705":57876,"_2959":58351},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3475":2815,"_30471":2639,"_21105":58353,"_5":14473,"_27705":57876,"_2959":58354},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3475":2816,"_30471":2639,"_21105":58356,"_5":14473,"_27705":57876,"_2959":58357},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3475":2817,"_30471":2639,"_21105":58359,"_5":14473,"_27705":57876,"_2959":58360},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3475":2818,"_30471":2639,"_21105":58362,"_5":14473,"_27705":57880,"_2959":58363},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3475":2819,"_30471":2639,"_21105":58365,"_5":14473,"_27705":57884,"_2959":58366},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3475":2820,"_30471":2639,"_21105":58368,"_5":14473,"_27705":57884,"_2959":58369},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3475":2821,"_30471":2639,"_21105":58371,"_5":14473,"_27705":57884,"_2959":58372},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3475":2822,"_30471":2639,"_21105":58374,"_5":14473,"_27705":57884,"_2959":58375},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3475":2823,"_30471":2639,"_21105":58377,"_5":14473,"_27705":57884,"_2959":58378},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3475":2824,"_30471":2639,"_21105":58380,"_5":14473,"_27705":57884,"_2959":58381},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3475":2825,"_30471":2639,"_21105":58383,"_5":14473,"_27705":57884,"_2959":58384},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3475":2826,"_30471":2639,"_21105":58386,"_5":14473,"_27705":57884,"_2959":58387},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3475":2827,"_30471":2639,"_21105":58389,"_5":14473,"_27705":57888,"_2959":58390},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3475":2828,"_30471":2639,"_21105":58392,"_5":14473,"_27705":57896,"_2959":58393},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3475":2829,"_30471":2639,"_21105":58395,"_5":14473,"_27705":57896,"_2959":58396},[],"Field in 3.8.0",{"_3475":2830,"_30471":2639,"_21105":58398,"_5":14473,"_27705":57896,"_2959":58399},[],"Field in 4.0.0",{"_3475":2831,"_30471":2639,"_21105":58401,"_5":14473,"_27705":57896,"_2959":58402},[],"`validate_server_cert`",{"_3475":2832,"_30471":2639,"_21105":58404,"_5":14473,"_27705":57896,"_2959":58405},[],"`insecure_skip_verify` (value negated)",{"_3475":2833,"_30471":2639,"_21105":58407,"_5":14473,"_27705":57896,"_2959":58408},[],"`oidc`",{"_3475":2834,"_30471":2639,"_21105":58410,"_5":14473,"_27705":57896,"_2959":58411},[],"`jwt_options`",{"_3475":2835,"_30471":2639,"_21105":58413,"_5":14473,"_27705":57896,"_2959":58414},[],"`apikey`",{"_3475":2836,"_30471":2639,"_21105":58416,"_5":14473,"_27705":57896,"_2959":58417},[],"`apikey_options`",{"_3475":2837,"_30471":2639,"_21105":58419,"_5":14473,"_27705":57896,"_2959":58420},[],"`mtls`",{"_3475":2838,"_30471":2639,"_21105":58422,"_5":14473,"_27705":57896,"_2959":58423},[],"`mtls_options`",{"_3475":2839,"_30471":2639,"_21105":58425,"_5":14473,"_27705":57896,"_2959":58426},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3475":2840,"_30471":2639,"_21105":58428,"_5":14473,"_27705":57896,"_2959":58429},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3475":2841,"_30471":2639,"_21105":58431,"_5":14473,"_27705":57896,"_2959":58432},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3475":2842,"_30471":2639,"_21105":58434,"_5":14473,"_27705":57900,"_2959":58435},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3475":2843,"_30471":2639,"_21105":58437,"_5":14473,"_27705":57900,"_2959":58438},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3475":2844,"_30471":2639,"_21105":58440,"_5":14473,"_27705":57900,"_2959":58441},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3475":2845,"_30471":2639,"_21105":58443,"_5":14473,"_27705":57904,"_2959":58444},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3475":2846,"_30471":2639,"_21105":58446,"_5":14473,"_27705":57908,"_2959":58447},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3475":2847,"_30471":2639,"_21105":58449,"_5":14473,"_27705":57912,"_2959":58450},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3475":2848,"_30471":2639,"_21105":58452,"_5":14473,"_27705":57916,"_2959":58453},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3475":2849,"_30471":2639,"_21105":58455,"_5":14473,"_27705":57916,"_2959":58456},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3475":2850,"_30471":2639,"_21105":58458,"_5":14473,"_27705":57916,"_2959":58459},[],"`POST /v1/devices/:id/events` creates an event.",{"_3475":2851,"_30471":2639,"_21105":58461,"_5":14473,"_27705":57916,"_2959":58462},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3475":2852,"_30471":2639,"_21105":58464,"_5":14473,"_27705":57920,"_2959":58465},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3475":2853,"_30471":2639,"_21105":58467,"_5":14473,"_27705":57924,"_2959":58468},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3475":2854,"_30471":2639,"_21105":58470,"_5":14473,"_27705":57924,"_2959":58471},[],"Route",{"_3475":2855,"_30471":2639,"_21105":58473,"_5":14473,"_27705":57924,"_2959":52837},[],{"_3475":2856,"_30471":2639,"_21105":58475,"_5":14473,"_27705":57924,"_2959":58476},[],"`GET /v1/crl-settings`",{"_3475":2857,"_30471":2639,"_21105":58478,"_5":14473,"_27705":57924,"_2959":58479},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3475":2858,"_30471":2639,"_21105":58481,"_5":14473,"_27705":57924,"_2959":58482},[],"`GET /v1/crl-settings/{ca-id}`",{"_3475":2859,"_30471":2639,"_21105":58484,"_5":14473,"_27705":57924,"_2959":58485},[],"Reads the settings of a CA.",{"_3475":2860,"_30471":2639,"_21105":58487,"_5":14473,"_27705":57924,"_2959":58488},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3475":2861,"_30471":2639,"_21105":58490,"_5":14473,"_27705":57924,"_2959":58491},[],"Replaces `crl_options`.",{"_3475":2862,"_30471":2639,"_21105":58493,"_5":14473,"_27705":57924,"_2959":58494},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3475":2863,"_30471":2639,"_21105":58496,"_5":14473,"_27705":57924,"_2959":58497},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3475":2864,"_30471":2639,"_21105":58499,"_5":14473,"_27705":57924,"_2959":58500},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3475":2865,"_30471":2639,"_21105":58502,"_5":14473,"_27705":57924,"_2959":58503},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3475":2866,"_30471":2639,"_21105":58505,"_5":14473,"_27705":57924,"_2959":58506},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3475":2867,"_30471":2639,"_21105":58508,"_5":14473,"_27705":57924,"_2959":58509},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3475":2868,"_30471":2639,"_21105":58511,"_5":14473,"_27705":57924,"_2959":58512},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3475":2869,"_30471":2639,"_21105":58514,"_5":14473,"_27705":57924,"_2959":58515},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3475":2870,"_30471":2639,"_21105":58517,"_5":14473,"_27705":57924,"_2959":58518},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3475":2871,"_30471":2639,"_21105":58520,"_5":14473,"_27705":57924,"_2959":58521},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3475":2872,"_30471":2639,"_21105":58523,"_5":14473,"_27705":57924,"_2959":58524},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3475":2873,"_30471":2639,"_21105":58526,"_5":14473,"_27705":57928,"_2959":58527},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3475":2874,"_30471":2639,"_21105":58529,"_5":14473,"_27705":57932,"_2959":58530},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3475":2875,"_30471":2639,"_21105":58532,"_5":14473,"_27705":57936,"_2959":58533},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3475":2876,"_30471":2639,"_21105":58535,"_5":14473,"_27705":57940,"_2959":58536},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3475":2877,"_30471":2639,"_21105":58538,"_5":14473,"_27705":57944,"_2959":58539},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3475":2878,"_30471":2639,"_21105":58541,"_5":14473,"_27705":57944,"_2959":58542},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3475":2879,"_30471":2639,"_21105":58544,"_5":14473,"_27705":57944,"_2959":58545},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3475":2880,"_30471":2639,"_21105":58547,"_5":14473,"_27705":57944,"_2959":58548},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3475":2881,"_30471":2639,"_21105":58550,"_5":14473,"_27705":57944,"_2959":58551},[],"Record the names of your local-storage PVCs:",{"_3475":2882,"_30471":2639,"_21105":58553,"_5":14473,"_27705":57944,"_2959":58554},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3475":2883,"_30471":2639,"_21105":58556,"_5":14473,"_27705":57948,"_2959":58557},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3475":2884,"_30471":2639,"_21105":58559,"_5":14473,"_27705":57948,"_2959":58560},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3475":2885,"_30471":2639,"_21105":58562,"_5":14473,"_27705":57948,"_2959":58563},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3475":2886,"_30471":2639,"_21105":58565,"_5":14473,"_27705":57948,"_2959":58566},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3475":2887,"_30471":2639,"_21105":58568,"_5":14473,"_27705":57948,"_2959":58569},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3475":2888,"_30471":2639,"_21105":58571,"_5":14473,"_27705":57952,"_2959":58572},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3475":2889,"_30471":2639,"_21105":58574,"_5":14473,"_27705":57952,"_2959":58575},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3475":2890,"_30471":2639,"_21105":58577,"_5":14473,"_27705":57952,"_2959":58578},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3475":2891,"_30471":2639,"_21105":58580,"_5":14473,"_27705":57952,"_2959":58581},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3475":2892,"_30471":2639,"_21105":58583,"_5":14473,"_27705":57952,"_2959":58584},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3475":2893,"_30471":2639,"_21105":58586,"_5":14473,"_27705":57952,"_2959":58587},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3475":2894,"_30471":2639,"_21105":58589,"_5":14473,"_27705":57952,"_2959":58590},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3475":2895,"_30471":2639,"_21105":58592,"_5":14473,"_27705":57952,"_2959":58593},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3475":2896,"_30471":2639,"_21105":58595,"_5":14473,"_27705":57952,"_2959":58596},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3475":2897,"_30471":2639,"_21105":58598,"_5":14473,"_27705":57952,"_2959":58599},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3475":2898,"_30471":2639,"_21105":58601,"_5":14473,"_27705":57952,"_2959":58602},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3475":2899,"_30471":2639,"_21105":58604,"_5":14473,"_27705":57952,"_2959":58605},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3475":2900,"_30471":2639,"_21105":58607,"_5":14473,"_27705":57956,"_2959":58608},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3475":2901,"_30471":2639,"_21105":58610,"_5":14473,"_27705":57956,"_2959":58611},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3475":2902,"_30471":2639,"_21105":58613,"_5":14473,"_27705":57960,"_2959":58614},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3475":2903,"_30471":2639,"_21105":58616,"_5":14473,"_27705":57960,"_2959":58617},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3475":2904,"_30471":2639,"_21105":58619,"_5":14473,"_27705":57960,"_2959":58620},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3475":2905,"_30471":2639,"_21105":58622,"_5":14473,"_27705":57960,"_2959":58623},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3475":2906,"_30471":2639,"_21105":58625,"_5":14473,"_27705":57960,"_2959":58626},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3475":2907,"_30471":2639,"_21105":58628,"_5":14473,"_27705":57960,"_2959":58629},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3475":2908,"_30471":2639,"_21105":58631,"_5":14473,"_27705":57960,"_2959":58632},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3475":2909,"_30471":2639,"_21105":58634,"_5":14473,"_27705":57960,"_2959":58635},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3475":2910,"_30471":2639,"_21105":58637,"_5":14473,"_27705":57960,"_2959":58638},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3475":2911,"_30471":2639,"_21105":58640,"_5":14473,"_27705":57960,"_2959":58641},[],"**Remove the helper and restore the recorded replica counts:**",{"_3475":2912,"_30471":2639,"_21105":58643,"_5":14473,"_27705":57960,"_2959":58644},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3475":2913,"_30471":2639,"_21105":58646,"_5":14473,"_27705":57964,"_2959":58647},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3475":2914,"_30471":2639,"_21105":58649,"_5":14473,"_27705":57964,"_2959":58650},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3475":2915,"_30471":2639,"_21105":58652,"_5":14473,"_27705":57968,"_2959":58653},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3475":2916,"_30471":2639,"_21105":58655,"_5":14473,"_27705":57968,"_2959":58656},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3475":2917,"_30471":2639,"_21105":58658,"_5":14473,"_27705":57968,"_2959":58659},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3475":2918,"_30471":2639,"_21105":58661,"_5":14473,"_27705":57968,"_2959":58662},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3475":2919,"_30471":2639,"_21105":58664,"_5":14473,"_27705":57968,"_2959":58665},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3475":2920,"_30471":2639,"_21105":58667,"_5":14473,"_27705":57968,"_2959":58668},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3475":2921,"_30471":2639,"_21105":58670,"_5":14473,"_27705":57968,"_2959":58671},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3475":2922,"_30471":2639,"_21105":58673,"_5":14473,"_27705":57968,"_2959":58674},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3475":2923,"_30471":2639,"_21105":58676,"_5":14473,"_27705":57972,"_2959":58677},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3475":2924,"_30471":2639,"_21105":58679,"_5":14473,"_27705":57972,"_2959":58680},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3475":2925,"_30471":2639,"_21105":58682,"_5":14473,"_27705":57972,"_2959":58683},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3475":2926,"_30471":2639,"_21105":58685,"_5":14473,"_27705":57972,"_2959":58686},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3475":2927,"_30471":2639,"_21105":58688,"_5":14473,"_27705":57972,"_2959":58689},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3475":2928,"_30471":2639,"_21105":58691,"_5":14473,"_27705":57972,"_2959":58692},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3475":2929,"_30471":2639,"_21105":58694,"_5":14473,"_27705":57972,"_2959":58695},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3475":2930,"_30471":2639,"_21105":58697,"_5":14473,"_27705":57972,"_2959":58698},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3475":2931,"_30471":2639,"_21105":58700,"_5":14473,"_27705":57972,"_2959":58701},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3475":2932,"_30471":2639,"_21105":58703,"_5":14473,"_27705":57972,"_2959":58704},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3475":2933,"_30471":2639,"_21105":58706,"_5":14473,"_27705":57972,"_2959":58707},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3475":2934,"_30471":2639,"_21105":58709,"_5":14473,"_27705":57975,"_2959":58710},[],"After the upgrade, check in this order:",{"_3475":2935,"_30471":2639,"_21105":58712,"_5":14473,"_27705":57975,"_2959":58713},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3475":2936,"_30471":2639,"_21105":58715,"_5":14473,"_27705":57975,"_2959":58716},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3475":2937,"_30471":2639,"_21105":58718,"_5":14473,"_27705":57975,"_2959":58719},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3475":2938,"_30471":2639,"_21105":58721,"_5":14473,"_27705":57975,"_2959":58722},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3475":2939,"_30471":2639,"_21105":58724,"_5":14473,"_27705":57975,"_2959":58725},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3475":2940,"_30471":2639,"_21105":58727,"_5":14473,"_27705":57975,"_2959":58728},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3475":2941,"_30471":2639,"_21105":58730,"_5":14473,"_27705":57975,"_2959":58731},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3475":2942,"_30471":2639,"_21105":58733,"_5":14473,"_27705":57975,"_2959":58734},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3475":2943,"_30471":2639,"_21105":58736,"_5":14473,"_27705":57975,"_2959":58737},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3475":2944,"_30471":2639,"_21105":58739,"_5":14473,"_27705":57975,"_2959":58740},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3475":2945,"_30471":2639,"_21105":58742,"_5":14473,"_27705":57975,"_2959":58743},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3475":2946,"_30471":2639,"_21105":58745,"_5":14473,"_27705":57975,"_2959":58746},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3475":2947,"_30471":2639,"_21105":58748,"_5":14473,"_27705":57975,"_2959":58749},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3475":2948,"_30471":2639,"_21105":58751,"_5":14473,"_27705":57975,"_2959":58752},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3475":2949,"_30471":2639,"_21105":58754,"_5":14473,"_27705":57975,"_2959":58755},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3475":2950,"_30471":2639,"_21105":58757,"_5":14473,"_27705":57979,"_2959":58758},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3475":2951,"_30471":2639,"_21105":58760,"_5":14473,"_27705":57979,"_2959":58761},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3475":2952,"_30471":2639,"_21105":58763,"_5":14473,"_27705":57979,"_2959":58764},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3475":2953,"_30471":2639,"_21105":58766,"_5":14473,"_27705":57979,"_2959":58767},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3475":2954,"_30471":2639,"_21105":58769,"_5":14473,"_27705":57979,"_2959":58770},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_58773":58774,"_58775":58776,"_58777":58778,"_58779":58780,"_18268":2994,"_70554":2994},"language","english","sortableProperties",[2959,30471,5,27705],"sortablePropertiesWithTypes",{"_2959":25243,"_30471":25243,"_5":25243,"_27705":25243},"sorts",{"_2959":58781,"_30471":61725,"_5":64668,"_27705":67611},{"_4675":58782,"_58783":58784,"_5":25243},{"_14549":7650,"_14936":22802,"_14955":3025,"_29474":7904,"_14942":8694,"_20024":4471,"_14570":6831,"_14577":14513,"_29416":4779,"_29825":3047,"_29846":15249,"_29450":5866,"_34823":6859,"_29553":7582,"_29890":6978,"_34830":30061,"_34833":7552,"_34836":17272,"_34839":10001,"_30297":3967,"_34844":4761,"_34846":4311,"_30327":4630,"_14951":8733,"_34850":7554,"_34853":5696,"_34855":6265,"_29874":7768,"_30292":7061,"_30340":5025,"_34860":11288,"_34862":22963,"_34864":4885,"_29570":3059,"_34867":7134,"_34869":4829,"_34871":9936,"_34873":3665,"_34875":5094,"_29487":7069,"_34878":15932,"_34880":3539,"_29481":17351,"_29911":4116,"_34884":7273,"_34886":6998,"_34889":9261,"_29527":7047,"_34893":4055,"_29407":3128,"_34896":7108,"_29455":3450,"_34899":9076,"_34901":7675,"_34904":3370,"_14945":4753,"_34907":17763,"_34909":18063,"_34912":4032,"_34914":3268,"_34916":3935,"_34918":6782,"_34920":8226,"_20027":6623,"_34923":3029,"_34925":8628,"_29428":5883,"_29868":12566,"_34929":5481,"_34931":5602,"_34933":5346,"_30357":7570,"_34936":3258,"_34938":6001,"_34940":24060,"_30451":12149,"_29927":7663,"_34944":7019,"_34946":4089,"_29465":3457,"_34949":15014,"_34951":7561,"_34953":18614,"_30373":6026,"_29547":3265,"_28928":22735,"_34958":7103,"_34960":4261,"_34962":4222,"_29596":10534,"_34966":11099,"_29862":15899