_40617":125943,"_40619":125946,"_40621":125949,"_40623":125952,"_40625":125955,"_40627":125958,"_40629":125961,"_40631":125964,"_40633":125967,"_40635":125970,"_40637":125973,"_40639":125976,"_40641":125979,"_40643":125982,"_40645":125985,"_40647":125988,"_40649":125991,"_40651":125994,"_40653":125997,"_40655":126000,"_40657":126003,"_40659":126006,"_40661":126009,"_40663":126012,"_40665":126015,"_40667":126018,"_40669":126021,"_40671":126024,"_40673":126027,"_40675":126030,"_40677":126033,"_40679":126036,"_40681":126039,"_40683":126042,"_40685":126045,"_40687":126048,"_40689":126051,"_40692":126054,"_40694":126057,"_40696":126060},{"_3475":70561,"_30471":70561,"_5":14825,"_2959":117098,"_30823":117099,"_21105":117102,"_27705":70561},"Despliega desde AWS Marketplace",[49595,117100,117101],"Despliegue","Otros modelos",[],{"_3475":70562,"_30471":70561,"_21105":117104,"_5":14473,"_27705":70561,"_2959":117105},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3475":70563,"_30471":70561,"_5":30820,"_21105":117107,"_27705":117108,"_2959":117109},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3475":70564,"_30471":70561,"_5":30820,"_21105":117111,"_27705":117112,"_2959":117113},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3475":70565,"_30471":70561,"_5":30820,"_21105":117115,"_27705":117116,"_2959":117117},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3475":70566,"_30471":70561,"_5":30820,"_21105":117119,"_27705":117120,"_2959":117121},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3475":70567,"_30471":70561,"_5":30820,"_21105":117123,"_27705":117124,"_2959":117125},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3475":70568,"_30471":70561,"_5":30820,"_21105":117127,"_27705":117128,"_2959":117129},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3475":70569,"_30471":70561,"_5":30820,"_21105":117131,"_27705":117132,"_2959":117133},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3475":70570,"_30471":70561,"_21105":117135,"_5":14473,"_27705":70561,"_2959":117136},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3475":70571,"_30471":70561,"_21105":117138,"_5":14473,"_27705":117108,"_2959":117139},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3475":70572,"_30471":70561,"_21105":117141,"_5":14473,"_27705":117108,"_2959":117142},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3475":70573,"_30471":70561,"_21105":117144,"_5":14473,"_27705":117108,"_2959":117145},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3475":70574,"_30471":70561,"_21105":117147,"_5":14473,"_27705":117112,"_2959":117148},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3475":70575,"_30471":70561,"_21105":117150,"_5":14473,"_27705":117112,"_2959":117151},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3475":70576,"_30471":70561,"_21105":117153,"_5":14473,"_27705":117112,"_2959":117154},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3475":70577,"_30471":70561,"_21105":117156,"_5":14473,"_27705":117116,"_2959":117157},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3475":70578,"_30471":70561,"_21105":117159,"_5":14473,"_27705":117120,"_2959":117160},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3475":70579,"_30471":70561,"_21105":117162,"_5":14473,"_27705":117124,"_2959":117163},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3475":70580,"_30471":70561,"_21105":117165,"_5":14473,"_27705":117128,"_2959":117166},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3475":70581,"_30471":70561,"_21105":117168,"_5":14473,"_27705":117132,"_2959":117169},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3475":70582,"_30471":70582,"_5":14825,"_2959":117171,"_30823":117172,"_21105":117173,"_27705":70582},"Despliega Lamassu",[49595,117100],[],{"_3475":70583,"_30471":70582,"_21105":117175,"_5":14473,"_27705":70582,"_2959":117176},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3475":70584,"_30471":70582,"_5":30820,"_21105":117178,"_27705":117179,"_2959":117180},[],"/docs/pr-preview/pr-67/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3475":70585,"_30471":70582,"_5":30820,"_21105":117182,"_27705":117183,"_2959":117184},[],"/docs/pr-preview/pr-67/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3475":70586,"_30471":70582,"_5":30820,"_21105":117186,"_27705":117187,"_2959":117188},[],"/docs/pr-preview/pr-67/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3475":70587,"_30471":70582,"_21105":117190,"_5":14473,"_27705":70582,"_2959":117191},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3475":70588,"_30471":70582,"_21105":117193,"_5":14473,"_27705":117179,"_2959":117194},[],"Modelo",{"_3475":70589,"_30471":70582,"_21105":117196,"_5":14473,"_27705":117179,"_2959":117197},[],"Recomendado para",{"_3475":70590,"_30471":70582,"_21105":117199,"_5":14473,"_27705":117179,"_2959":117200},[],"Quién opera la infraestructura",{"_3475":70591,"_30471":70582,"_21105":117202,"_5":14473,"_27705":117179,"_2959":117203},[],"Punto de partida",{"_3475":70592,"_30471":70582,"_21105":117205,"_5":14473,"_27705":117179,"_2959":49702},[],{"_3475":70593,"_30471":70582,"_21105":117207,"_5":14473,"_27705":117179,"_2959":117208},[],"Producción, entornos regulados y despliegues personalizados",{"_3475":70594,"_30471":70582,"_21105":117210,"_5":14473,"_27705":117179,"_2959":117211},[],"Tu equipo",{"_3475":70595,"_30471":70582,"_21105":117213,"_5":14473,"_27705":117179,"_2959":117214},[],"Helm o Fastlane",{"_3475":70596,"_30471":70582,"_21105":117216,"_5":14473,"_27705":117179,"_2959":49714},[],{"_3475":70597,"_30471":70582,"_21105":117218,"_5":14473,"_27705":117179,"_2959":117219},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3475":70598,"_30471":70582,"_21105":117221,"_5":14473,"_27705":117179,"_2959":117211},[],{"_3475":70599,"_30471":70582,"_21105":117223,"_5":14473,"_27705":117179,"_2959":117224},[],"Imagen preconfigurada en EC2",{"_3475":70600,"_30471":70582,"_21105":117226,"_5":14473,"_27705":117179,"_2959":49725},[],{"_3475":70601,"_30471":70582,"_21105":117228,"_5":14473,"_27705":117179,"_2959":117229},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3475":70602,"_30471":70582,"_21105":117231,"_5":14473,"_27705":117179,"_2959":49731},[],{"_3475":70603,"_30471":70582,"_21105":117233,"_5":14473,"_27705":117179,"_2959":117234},[],"Suscripción gestionada",{"_3475":70604,"_30471":70582,"_21105":117236,"_5":14473,"_27705":117179,"_2959":117237},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3475":70605,"_30471":70582,"_21105":117239,"_5":14473,"_27705":117179,"_2959":117240},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3475":70606,"_30471":70582,"_21105":117242,"_5":14473,"_27705":117179,"_2959":117243},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3475":70607,"_30471":70582,"_21105":117245,"_5":14473,"_27705":117183,"_2959":117246},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3475":70608,"_30471":70582,"_21105":117248,"_5":14473,"_27705":117187,"_2959":117249},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3475":70609,"_30471":70609,"_5":14825,"_2959":117251,"_30823":117252,"_21105":117253,"_27705":70609},"Utiliza Lamassu como SaaS",[49595,117100,117101],[],{"_3475":70610,"_30471":70609,"_21105":117255,"_5":14473,"_27705":70609,"_2959":117256},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3475":70611,"_30471":70609,"_5":30820,"_21105":117258,"_27705":117259,"_2959":117260},[],"/docs/pr-preview/pr-67/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3475":70612,"_30471":70609,"_5":30820,"_21105":117262,"_27705":117263,"_2959":117264},[],"/docs/pr-preview/pr-67/es/deployment/saas#planes","Planes",{"_3475":70613,"_30471":70609,"_5":30820,"_21105":117266,"_27705":117267,"_2959":117268},[],"/docs/pr-preview/pr-67/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3475":70614,"_30471":70609,"_21105":117270,"_5":14473,"_27705":70609,"_2959":117271},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3475":70615,"_30471":70609,"_21105":117273,"_5":14473,"_27705":117259,"_2959":117274},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3475":70616,"_30471":70609,"_21105":117276,"_5":14473,"_27705":117259,"_2959":117277},[],"Copias de seguridad automáticas.",{"_3475":70617,"_30471":70609,"_21105":117279,"_5":14473,"_27705":117259,"_2959":117280},[],"Actualizaciones de versión.",{"_3475":70618,"_30471":70609,"_21105":117282,"_5":14473,"_27705":117259,"_2959":117283},[],"Soporte técnico y SLA según el plan contratado.",{"_3475":70619,"_30471":70609,"_21105":117285,"_5":14473,"_27705":117263,"_2959":49786},[],{"_3475":70620,"_30471":70609,"_21105":117287,"_5":14473,"_27705":117263,"_2959":117288},[],"Dispositivos",{"_3475":70621,"_30471":70609,"_21105":117290,"_5":14473,"_27705":117263,"_2959":117291},[],"Soporte",{"_3475":70622,"_30471":70609,"_21105":117293,"_5":14473,"_27705":117263,"_2959":49795},[],{"_3475":70623,"_30471":70609,"_21105":117295,"_5":14473,"_27705":117263,"_2959":49798},[],{"_3475":70624,"_30471":70609,"_21105":117297,"_5":14473,"_27705":117263,"_2959":117298},[],"Hasta 1.000",{"_3475":70625,"_30471":70609,"_21105":117300,"_5":14473,"_27705":117263,"_2959":49804},[],{"_3475":70626,"_30471":70609,"_21105":117302,"_5":14473,"_27705":117263,"_2959":117303},[],"99,5 %",{"_3475":70627,"_30471":70609,"_21105":117305,"_5":14473,"_27705":117263,"_2959":49810},[],{"_3475":70628,"_30471":70609,"_21105":117307,"_5":14473,"_27705":117263,"_2959":117308},[],"Hasta 10.000",{"_3475":70629,"_30471":70609,"_21105":117310,"_5":14473,"_27705":117263,"_2959":117311},[],"Email y chat",{"_3475":70630,"_30471":70609,"_21105":117313,"_5":14473,"_27705":117263,"_2959":117314},[],"99,9 %",{"_3475":70631,"_30471":70609,"_21105":117316,"_5":14473,"_27705":117263,"_2959":49822},[],{"_3475":70632,"_30471":70609,"_21105":117318,"_5":14473,"_27705":117263,"_2959":117319},[],"Ilimitados",{"_3475":70633,"_30471":70609,"_21105":117321,"_5":14473,"_27705":117263,"_2959":117322},[],"Dedicado",{"_3475":70634,"_30471":70609,"_21105":117324,"_5":14473,"_27705":117263,"_2959":117325},[],"99,99 %",{"_3475":70635,"_30471":70609,"_21105":117327,"_5":14473,"_27705":117267,"_2959":117328},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3475":70636,"_30471":70609,"_21105":117330,"_5":14473,"_27705":117267,"_2959":117331},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3475":70637,"_30471":70637,"_5":14825,"_2959":49839,"_30823":117333,"_21105":117335,"_27705":70637},[49595,117100,117334],"Kubernetes autogestionado",[],{"_3475":70638,"_30471":70637,"_21105":117337,"_5":14473,"_27705":70637,"_2959":117338},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3475":70639,"_30471":70637,"_5":30820,"_21105":117340,"_27705":117341,"_2959":117342},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3475":70640,"_30471":70637,"_5":30820,"_21105":117344,"_27705":117345,"_2959":117346},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3475":70641,"_30471":70637,"_5":30820,"_21105":117348,"_27705":117349,"_2959":117350},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3475":70642,"_30471":70637,"_5":30820,"_21105":117352,"_27705":117353,"_2959":117354},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3475":70643,"_30471":70637,"_5":30820,"_21105":117356,"_27705":117357,"_2959":117358},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3475":70644,"_30471":70637,"_5":30820,"_21105":117360,"_27705":117361,"_2959":117362},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3475":70645,"_30471":70637,"_5":30820,"_21105":117364,"_27705":117365,"_2959":117366},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3475":70646,"_30471":70637,"_5":30820,"_21105":117368,"_27705":117369,"_2959":117370},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3475":70647,"_30471":70637,"_5":30820,"_21105":117372,"_27705":117373,"_2959":117374},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3475":70648,"_30471":70637,"_5":30820,"_21105":117376,"_27705":117377,"_2959":117378},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3475":70649,"_30471":70637,"_5":30820,"_21105":117380,"_27705":117381,"_2959":117382},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3475":70650,"_30471":70637,"_21105":117384,"_5":14473,"_27705":117341,"_2959":117385},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3475":70651,"_30471":70637,"_21105":117387,"_5":14473,"_27705":117341,"_2959":117388},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3475":70652,"_30471":70637,"_21105":117390,"_5":14473,"_27705":117345,"_2959":117391},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3475":70653,"_30471":70637,"_21105":117393,"_5":14473,"_27705":117345,"_2959":117394},[],"Fastlane instala o configura",{"_3475":70654,"_30471":70637,"_21105":117396,"_5":14473,"_27705":117345,"_2959":117397},[],"Tú sigues proporcionando",{"_3475":70655,"_30471":70637,"_21105":117399,"_5":14473,"_27705":117345,"_2959":117400},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3475":70656,"_30471":70637,"_21105":117402,"_5":14473,"_27705":117345,"_2959":117403},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3475":70657,"_30471":70637,"_21105":117405,"_5":14473,"_27705":117345,"_2959":117406},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3475":70658,"_30471":70637,"_21105":117408,"_5":14473,"_27705":117345,"_2959":117409},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3475":70659,"_30471":70637,"_21105":117411,"_5":14473,"_27705":117345,"_2959":117412},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3475":70660,"_30471":70637,"_21105":117414,"_5":14473,"_27705":117345,"_2959":117415},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3475":70661,"_30471":70637,"_21105":117417,"_5":14473,"_27705":117345,"_2959":117418},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3475":70662,"_30471":70637,"_21105":117420,"_5":14473,"_27705":117345,"_2959":117421},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3475":70663,"_30471":70637,"_21105":117423,"_5":14473,"_27705":117345,"_2959":117424},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3475":70664,"_30471":70637,"_21105":117426,"_5":14473,"_27705":117349,"_2959":117427},[],"Necesitas:",{"_3475":70665,"_30471":70637,"_21105":117429,"_5":14473,"_27705":117349,"_2959":117430},[],"un clúster Kubernetes existente",{"_3475":70666,"_30471":70637,"_21105":117432,"_5":14473,"_27705":117349,"_2959":117433},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3475":70667,"_30471":70637,"_21105":117435,"_5":14473,"_27705":117349,"_2959":49941},[],{"_3475":70668,"_30471":70637,"_21105":117437,"_5":14473,"_27705":117349,"_2959":23867},[],{"_3475":70669,"_30471":70637,"_21105":117439,"_5":14473,"_27705":117349,"_2959":117440},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3475":70670,"_30471":70637,"_21105":117442,"_5":14473,"_27705":117349,"_2959":117443},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3475":70671,"_30471":70637,"_21105":117445,"_5":14473,"_27705":117349,"_2959":117446},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3475":70672,"_30471":70637,"_21105":117448,"_5":14473,"_27705":117349,"_2959":117449},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3475":70673,"_30471":70637,"_21105":117451,"_5":14473,"_27705":117349,"_2959":117452},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3475":70674,"_30471":70637,"_21105":117454,"_5":14473,"_27705":117353,"_2959":117455},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3475":70675,"_30471":70637,"_21105":117457,"_5":14473,"_27705":117353,"_2959":117458},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3475":70676,"_30471":70637,"_21105":117460,"_5":14473,"_27705":117357,"_2959":117461},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3475":70677,"_30471":70637,"_21105":117463,"_5":14473,"_27705":117357,"_2959":117464},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3475":70678,"_30471":70637,"_21105":117466,"_5":14473,"_27705":117357,"_2959":117467},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3475":70679,"_30471":70637,"_21105":117469,"_5":14473,"_27705":117357,"_2959":117470},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3475":70680,"_30471":70637,"_21105":117472,"_5":14473,"_27705":117361,"_2959":117473},[],"Opción",{"_3475":70681,"_30471":70637,"_21105":117475,"_5":14473,"_27705":117361,"_2959":117476},[],"Valor predeterminado",{"_3475":70682,"_30471":70637,"_21105":117478,"_5":14473,"_27705":117361,"_2959":117479},[],"Propósito",{"_3475":70683,"_30471":70637,"_21105":117481,"_5":14473,"_27705":117361,"_2959":49988},[],{"_3475":70684,"_30471":70637,"_21105":117483,"_5":14473,"_27705":117361,"_2959":49991},[],{"_3475":70685,"_30471":70637,"_21105":117485,"_5":14473,"_27705":117361,"_2959":117486},[],"Muestra la ayuda",{"_3475":70686,"_30471":70637,"_21105":117488,"_5":14473,"_27705":117361,"_2959":49997},[],{"_3475":70687,"_30471":70637,"_21105":117490,"_5":14473,"_27705":117361,"_2959":117491},[],"contexto actual",{"_3475":70688,"_30471":70637,"_21105":117493,"_5":14473,"_27705":117361,"_2959":117494},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3475":70689,"_30471":70637,"_21105":117496,"_5":14473,"_27705":117361,"_2959":50006},[],{"_3475":70690,"_30471":70637,"_21105":117498,"_5":14473,"_27705":117361,"_2959":6614},[],{"_3475":70691,"_30471":70637,"_21105":117500,"_5":14473,"_27705":117361,"_2959":117501},[],"Omite prompts y genera credenciales para las dependencias",{"_3475":70692,"_30471":70637,"_21105":117503,"_5":14473,"_27705":117361,"_2959":50014},[],{"_3475":70693,"_30471":70637,"_21105":117505,"_5":14473,"_27705":117361,"_2959":50017},[],{"_3475":70694,"_30471":70637,"_21105":117507,"_5":14473,"_27705":117361,"_2959":117508},[],"Namespace de la instalación",{"_3475":70695,"_30471":70637,"_21105":117510,"_5":14473,"_27705":117361,"_2959":50023},[],{"_3475":70696,"_30471":70637,"_21105":117512,"_5":14473,"_27705":117361,"_2959":50026},[],{"_3475":70697,"_30471":70637,"_21105":117514,"_5":14473,"_27705":117361,"_2959":117515},[],"Dominio usado por la UI, OIDC y el certificado",{"_3475":70698,"_30471":70637,"_21105":117517,"_5":14473,"_27705":117361,"_2959":50032},[],{"_3475":70699,"_30471":70637,"_21105":117519,"_5":14473,"_27705":117361,"_2959":15177},[],{"_3475":70700,"_30471":70637,"_21105":117521,"_5":14473,"_27705":117361,"_2959":117522},[],"Versión del chart de Lamassu",{"_3475":70701,"_30471":70637,"_21105":117524,"_5":14473,"_27705":117361,"_2959":50040},[],{"_3475":70702,"_30471":70637,"_21105":117526,"_5":14473,"_27705":117361,"_2959":50043},[],{"_3475":70703,"_30471":70637,"_21105":117528,"_5":14473,"_27705":117361,"_2959":117529},[],"Puerto del listener HTTPS",{"_3475":70704,"_30471":70637,"_21105":117531,"_5":14473,"_27705":117361,"_2959":50049},[],{"_3475":70705,"_30471":70637,"_21105":117533,"_5":14473,"_27705":117361,"_2959":50052},[],{"_3475":70706,"_30471":70637,"_21105":117535,"_5":14473,"_27705":117361,"_2959":117536},[],"Puerto del listener HTTP",{"_3475":70707,"_30471":70637,"_21105":117538,"_5":14473,"_27705":117361,"_2959":50058},[],{"_3475":70708,"_30471":70637,"_21105":117540,"_5":14473,"_27705":117361,"_2959":49991},[],{"_3475":70709,"_30471":70637,"_21105":117542,"_5":14473,"_27705":117361,"_2959":117543},[],"Certificado PEM para TLS downstream",{"_3475":70710,"_30471":70637,"_21105":117545,"_5":14473,"_27705":117361,"_2959":50066},[],{"_3475":70711,"_30471":70637,"_21105":117547,"_5":14473,"_27705":117361,"_2959":49991},[],{"_3475":70712,"_30471":70637,"_21105":117549,"_5":14473,"_27705":117361,"_2959":117550},[],"Clave privada PEM para TLS downstream",{"_3475":70713,"_30471":70637,"_21105":117552,"_5":14473,"_27705":117361,"_2959":50074},[],{"_3475":70714,"_30471":70637,"_21105":117554,"_5":14473,"_27705":117361,"_2959":117555},[],"chart del repositorio",{"_3475":70715,"_30471":70637,"_21105":117557,"_5":14473,"_27705":117361,"_2959":117558},[],"Usa un chart local de Lamassu sin empaquetar",{"_3475":70716,"_30471":70637,"_21105":117560,"_5":14473,"_27705":117361,"_2959":50083},[],{"_3475":70717,"_30471":70637,"_21105":117562,"_5":14473,"_27705":117361,"_2959":117563},[],"detección automática",{"_3475":70718,"_30471":70637,"_21105":117565,"_5":14473,"_27705":117361,"_2959":117566},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3475":70719,"_30471":70637,"_21105":117568,"_5":14473,"_27705":117361,"_2959":50091},[],{"_3475":70720,"_30471":70637,"_21105":117570,"_5":14473,"_27705":117361,"_2959":6614},[],{"_3475":70721,"_30471":70637,"_21105":117572,"_5":14473,"_27705":117361,"_2959":117573},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3475":70722,"_30471":70637,"_21105":117575,"_5":14473,"_27705":117361,"_2959":50099},[],{"_3475":70723,"_30471":70637,"_21105":117577,"_5":14473,"_27705":117361,"_2959":6614},[],{"_3475":70724,"_30471":70637,"_21105":117579,"_5":14473,"_27705":117361,"_2959":117580},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3475":70725,"_30471":70637,"_21105":117582,"_5":14473,"_27705":117361,"_2959":50107},[],{"_3475":70726,"_30471":70637,"_21105":117584,"_5":14473,"_27705":117361,"_2959":6614},[],{"_3475":70727,"_30471":70637,"_21105":117586,"_5":14473,"_27705":117361,"_2959":117587},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3475":70728,"_30471":70637,"_21105":117589,"_5":14473,"_27705":117361,"_2959":50115},[],{"_3475":70729,"_30471":70637,"_21105":117591,"_5":14473,"_27705":117361,"_2959":6614},[],{"_3475":70730,"_30471":70637,"_21105":117593,"_5":14473,"_27705":117361,"_2959":117594},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3475":70731,"_30471":70637,"_21105":117596,"_5":14473,"_27705":117361,"_2959":50123},[],{"_3475":70732,"_30471":70637,"_21105":117598,"_5":14473,"_27705":117361,"_2959":50126},[],{"_3475":70733,"_30471":70637,"_21105":117600,"_5":14473,"_27705":117361,"_2959":117601},[],"Usa otro chart local de SoftHSM",{"_3475":70734,"_30471":70637,"_21105":117603,"_5":14473,"_27705":117361,"_2959":117604},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3475":70735,"_30471":70637,"_21105":117606,"_5":14473,"_27705":117365,"_2959":117607},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3475":70736,"_30471":70637,"_21105":117609,"_5":14473,"_27705":117365,"_2959":117610},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3475":70737,"_30471":70637,"_21105":117612,"_5":14473,"_27705":117365,"_2959":117613},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3475":70738,"_30471":70637,"_21105":117615,"_5":14473,"_27705":117365,"_2959":117616},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3475":70739,"_30471":70637,"_21105":117618,"_5":14473,"_27705":117365,"_2959":117619},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3475":70740,"_30471":70637,"_21105":117621,"_5":14473,"_27705":117365,"_2959":117622},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3475":70741,"_30471":70637,"_21105":117624,"_5":14473,"_27705":117369,"_2959":50153},[],{"_3475":70742,"_30471":70637,"_21105":117626,"_5":14473,"_27705":117369,"_2959":117627},[],"valida las herramientas locales y el clúster seleccionado",{"_3475":70743,"_30471":70637,"_21105":117629,"_5":14473,"_27705":117369,"_2959":117630},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3475":70744,"_30471":70637,"_21105":117632,"_5":14473,"_27705":117369,"_2959":117633},[],"crea el namespace",{"_3475":70745,"_30471":70637,"_21105":117635,"_5":14473,"_27705":117369,"_2959":117636},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3475":70746,"_30471":70637,"_21105":117638,"_5":14473,"_27705":117369,"_2959":117639},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3475":70747,"_30471":70637,"_21105":117641,"_5":14473,"_27705":117369,"_2959":117642},[],"instala RabbitMQ",{"_3475":70748,"_30471":70637,"_21105":117644,"_5":14473,"_27705":117369,"_2959":117645},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3475":70749,"_30471":70637,"_21105":117647,"_5":14473,"_27705":117369,"_2959":117648},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3475":70750,"_30471":70637,"_21105":117650,"_5":14473,"_27705":117369,"_2959":117651},[],"carga datos de ejemplo opcionalmente",{"_3475":70751,"_30471":70637,"_21105":117653,"_5":14473,"_27705":117369,"_2959":117654},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3475":70752,"_30471":70637,"_21105":117656,"_5":14473,"_27705":117373,"_2959":117657},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3475":70753,"_30471":70637,"_21105":117659,"_5":14473,"_27705":117373,"_2959":117660},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3475":70754,"_30471":70637,"_21105":117662,"_5":14473,"_27705":117377,"_2959":117663},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3475":70755,"_30471":70637,"_21105":117665,"_5":14473,"_27705":117377,"_2959":117666},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3475":70756,"_30471":70637,"_21105":117668,"_5":14473,"_27705":117377,"_2959":117669},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3475":70757,"_30471":70637,"_21105":117671,"_5":14473,"_27705":117381,"_2959":117672},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3475":70758,"_30471":70758,"_5":14825,"_2959":117674,"_30823":117675,"_21105":117676,"_27705":70758},"Instala con Helm",[49595,117100,117334],[],{"_3475":70759,"_30471":70758,"_21105":117678,"_5":14473,"_27705":70758,"_2959":117679},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3475":70760,"_30471":70758,"_5":30820,"_21105":117681,"_27705":117682,"_2959":117683},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3475":70761,"_30471":70758,"_5":30820,"_21105":117685,"_27705":117686,"_2959":117350},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3475":70762,"_30471":70758,"_5":30820,"_21105":117688,"_27705":117689,"_2959":117690},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3475":70763,"_30471":70758,"_5":30820,"_21105":117692,"_27705":117693,"_2959":117694},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3475":70764,"_30471":70758,"_5":30820,"_21105":117696,"_27705":117697,"_2959":117698},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3475":70765,"_30471":70758,"_5":30820,"_21105":117700,"_27705":117701,"_2959":117702},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3475":70766,"_30471":70758,"_5":30820,"_21105":117704,"_27705":117705,"_2959":117706},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3475":70767,"_30471":70758,"_5":30820,"_21105":117708,"_27705":117709,"_2959":117710},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3475":70768,"_30471":70758,"_5":30820,"_21105":117712,"_27705":117713,"_2959":117714},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3475":70769,"_30471":70758,"_5":30820,"_21105":117716,"_27705":117717,"_2959":117718},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3475":70770,"_30471":70758,"_5":30820,"_21105":117720,"_27705":117721,"_2959":117722},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3475":70771,"_30471":70758,"_21105":117724,"_5":14473,"_27705":117682,"_2959":117725},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3475":70772,"_30471":70758,"_21105":117727,"_5":14473,"_27705":117686,"_2959":117728},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3475":70773,"_30471":70758,"_21105":117730,"_5":14473,"_27705":117686,"_2959":117731},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3475":70774,"_30471":70758,"_21105":117733,"_5":14473,"_27705":117686,"_2959":117734},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3475":70775,"_30471":70758,"_21105":117736,"_5":14473,"_27705":117686,"_2959":117737},[],"un broker RabbitMQ accesible y sus credenciales",{"_3475":70776,"_30471":70758,"_21105":117739,"_5":14473,"_27705":117686,"_2959":117740},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3475":70777,"_30471":70758,"_21105":117742,"_5":14473,"_27705":117686,"_2959":117743},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3475":70778,"_30471":70758,"_21105":117745,"_5":14473,"_27705":117686,"_2959":117746},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3475":70779,"_30471":70758,"_21105":117748,"_5":14473,"_27705":117686,"_2959":117749},[],"una StorageClass y un diseño de tráfico externo",{"_3475":70780,"_30471":70758,"_21105":117751,"_5":14473,"_27705":117686,"_2959":117752},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3475":70781,"_30471":70758,"_21105":117754,"_5":14473,"_27705":117686,"_2959":117755},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3475":70782,"_30471":70758,"_21105":117757,"_5":14473,"_27705":117686,"_2959":117758},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3475":70783,"_30471":70758,"_21105":117760,"_5":14473,"_27705":117689,"_2959":117761},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3475":70784,"_30471":70758,"_21105":117763,"_5":14473,"_27705":117689,"_2959":117764},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3475":70785,"_30471":70758,"_21105":117766,"_5":14473,"_27705":117689,"_2959":117767},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3475":70786,"_30471":70758,"_21105":117769,"_5":14473,"_27705":117693,"_2959":117770},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3475":70787,"_30471":70758,"_21105":117772,"_5":14473,"_27705":117693,"_2959":117773},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3475":70788,"_30471":70758,"_21105":117775,"_5":14473,"_27705":117693,"_2959":117776},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3475":70789,"_30471":70758,"_21105":117778,"_5":14473,"_27705":117693,"_2959":117779},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3475":70790,"_30471":70758,"_21105":117781,"_5":14473,"_27705":117697,"_2959":117782},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3475":70791,"_30471":70758,"_21105":117784,"_5":14473,"_27705":117701,"_2959":117785},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3475":70792,"_30471":70758,"_21105":117787,"_5":14473,"_27705":117701,"_2959":117788},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3475":70793,"_30471":70758,"_21105":117790,"_5":14473,"_27705":117701,"_2959":117791},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3475":70794,"_30471":70758,"_21105":117793,"_5":14473,"_27705":117701,"_2959":117794},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3475":70795,"_30471":70758,"_21105":117796,"_5":14473,"_27705":117701,"_2959":117797},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3475":70796,"_30471":70758,"_21105":117799,"_5":14473,"_27705":117701,"_2959":117800},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3475":70797,"_30471":70758,"_21105":117802,"_5":14473,"_27705":117701,"_2959":117803},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3475":70798,"_30471":70758,"_21105":117805,"_5":14473,"_27705":117705,"_2959":117806},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3475":70799,"_30471":70758,"_21105":117808,"_5":14473,"_27705":117705,"_2959":117809},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3475":70800,"_30471":70758,"_21105":117811,"_5":14473,"_27705":117705,"_2959":117812},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3475":70801,"_30471":70758,"_21105":117814,"_5":14473,"_27705":117705,"_2959":117815},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3475":70802,"_30471":70758,"_21105":117817,"_5":14473,"_27705":117709,"_2959":117818},[],"Para instalar un checkout local:",{"_3475":70803,"_30471":70758,"_21105":117820,"_5":14473,"_27705":117713,"_2959":117821},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3475":70804,"_30471":70758,"_21105":117823,"_5":14473,"_27705":117713,"_2959":117824},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3475":70805,"_30471":70758,"_21105":117826,"_5":14473,"_27705":117717,"_2959":117827},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3475":70806,"_30471":70758,"_21105":117829,"_5":14473,"_27705":117717,"_2959":117830},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3475":70807,"_30471":70758,"_21105":117832,"_5":14473,"_27705":117717,"_2959":117833},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3475":70808,"_30471":70758,"_21105":117835,"_5":14473,"_27705":117717,"_2959":117836},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3475":70809,"_30471":70758,"_21105":117838,"_5":14473,"_27705":117717,"_2959":117839},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3475":70810,"_30471":70758,"_21105":117841,"_5":14473,"_27705":117721,"_2959":117842},[],"Antes de pasar a producción, revisa:",{"_3475":70811,"_30471":70758,"_21105":117844,"_5":14473,"_27705":117721,"_2959":117845},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3475":70812,"_30471":70758,"_21105":117847,"_5":14473,"_27705":117721,"_2959":117848},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3475":70813,"_30471":70758,"_21105":117850,"_5":14473,"_27705":117721,"_2959":117851},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3475":70814,"_30471":70758,"_21105":117853,"_5":14473,"_27705":117721,"_2959":117854},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3475":70815,"_30471":70758,"_21105":117856,"_5":14473,"_27705":117721,"_2959":117857},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3475":70816,"_30471":70758,"_21105":117859,"_5":14473,"_27705":117721,"_2959":117860},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3475":70817,"_30471":70758,"_21105":117862,"_5":14473,"_27705":117721,"_2959":117863},[],"SMTP, observabilidad y entrega de alertas",{"_3475":70818,"_30471":70758,"_21105":117865,"_5":14473,"_27705":117721,"_2959":117866},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3475":70819,"_30471":70758,"_21105":117868,"_5":14473,"_27705":117721,"_2959":117869},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3475":70820,"_30471":70820,"_5":14825,"_2959":117871,"_30823":117872,"_21105":117873,"_27705":70820},"Expón el Gateway",[49595,117100,117334],[],{"_3475":70821,"_30471":70820,"_21105":117875,"_5":14473,"_27705":70820,"_2959":117876},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3475":70822,"_30471":70820,"_5":30820,"_21105":117878,"_27705":117879,"_2959":117880},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3475":70823,"_30471":70820,"_5":30820,"_21105":117882,"_27705":117883,"_2959":117884},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3475":70824,"_30471":70820,"_5":30820,"_21105":117886,"_27705":117887,"_2959":117888},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3475":70825,"_30471":70820,"_5":30820,"_21105":117890,"_27705":117891,"_2959":50421},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#k3s",{"_3475":70826,"_30471":70820,"_5":30820,"_21105":117893,"_27705":117894,"_2959":117895},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3475":70827,"_30471":70820,"_5":30820,"_21105":117897,"_27705":117898,"_2959":117899},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3475":70828,"_30471":70820,"_5":30820,"_21105":117901,"_27705":117902,"_2959":117903},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3475":70829,"_30471":70820,"_5":30820,"_21105":117905,"_27705":117906,"_2959":117907},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3475":70830,"_30471":70820,"_5":30820,"_21105":117909,"_27705":117910,"_2959":117911},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3475":70831,"_30471":70820,"_5":30820,"_21105":117913,"_27705":117914,"_2959":117915},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3475":70832,"_30471":70820,"_5":30820,"_21105":117917,"_27705":117918,"_2959":117919},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3475":70833,"_30471":70820,"_21105":117921,"_5":14473,"_27705":117879,"_2959":117922},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3475":70834,"_30471":70820,"_21105":117924,"_5":14473,"_27705":117879,"_2959":117925},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3475":70835,"_30471":70820,"_21105":117927,"_5":14473,"_27705":117883,"_2959":117928},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3475":70836,"_30471":70820,"_21105":117930,"_5":14473,"_27705":117883,"_2959":117931},[],"Defínelo únicamente cuando:",{"_3475":70837,"_30471":70820,"_21105":117933,"_5":14473,"_27705":117883,"_2959":117934},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3475":70838,"_30471":70820,"_21105":117936,"_5":14473,"_27705":117883,"_2959":117937},[],"esa dirección está asignada a este Gateway",{"_3475":70839,"_30471":70820,"_21105":117939,"_5":14473,"_27705":117883,"_2959":117940},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3475":70840,"_30471":70820,"_21105":117942,"_5":14473,"_27705":117883,"_2959":117943},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3475":70841,"_30471":70820,"_21105":117945,"_5":14473,"_27705":117883,"_2959":117946},[],"No confundas estos valores:",{"_3475":70842,"_30471":70820,"_21105":117948,"_5":14473,"_27705":117883,"_2959":117949},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3475":70843,"_30471":70820,"_21105":117951,"_5":14473,"_27705":117883,"_2959":117952},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3475":70844,"_30471":70820,"_21105":117954,"_5":14473,"_27705":117883,"_2959":117955},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3475":70845,"_30471":70820,"_21105":117957,"_5":14473,"_27705":117887,"_2959":117958},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3475":70846,"_30471":70820,"_21105":117960,"_5":14473,"_27705":117887,"_2959":117961},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3475":70847,"_30471":70820,"_21105":117963,"_5":14473,"_27705":117891,"_2959":117964},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3475":70848,"_30471":70820,"_21105":117966,"_5":14473,"_27705":117891,"_2959":117967},[],"Para el diseño recomendado:",{"_3475":70849,"_30471":70820,"_21105":117969,"_5":14473,"_27705":117891,"_2959":117970},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3475":70850,"_30471":70820,"_21105":117972,"_5":14473,"_27705":117891,"_2959":117973},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3475":70851,"_30471":70820,"_21105":117975,"_5":14473,"_27705":117891,"_2959":117976},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3475":70852,"_30471":70820,"_21105":117978,"_5":14473,"_27705":117891,"_2959":117979},[],"Apunta DNS a la dirección accesible de la VM.",{"_3475":70853,"_30471":70820,"_21105":117981,"_5":14473,"_27705":117891,"_2959":117982},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3475":70854,"_30471":70820,"_21105":117984,"_5":14473,"_27705":117894,"_2959":117985},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3475":70855,"_30471":70820,"_21105":117987,"_5":14473,"_27705":117898,"_2959":117988},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3475":70856,"_30471":70820,"_21105":117990,"_5":14473,"_27705":117898,"_2959":117991},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3475":70857,"_30471":70820,"_21105":117993,"_5":14473,"_27705":117902,"_2959":117994},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3475":70858,"_30471":70820,"_21105":117996,"_5":14473,"_27705":117902,"_2959":117997},[],"Requisito",{"_3475":70859,"_30471":70820,"_21105":117999,"_5":14473,"_27705":117902,"_2959":118000},[],"Diseño recomendado",{"_3475":70860,"_30471":70820,"_21105":118002,"_5":14473,"_27705":117902,"_2959":118003},[],"Consecuencia",{"_3475":70861,"_30471":70820,"_21105":118005,"_5":14473,"_27705":117902,"_2959":118006},[],"Varias URL o servicios de Lamassu",{"_3475":70862,"_30471":70820,"_21105":118008,"_5":14473,"_27705":117902,"_2959":118009},[],"Un Gateway con varias rutas",{"_3475":70863,"_30471":70820,"_21105":118011,"_5":14473,"_27705":117902,"_2959":118012},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3475":70864,"_30471":70820,"_21105":118014,"_5":14473,"_27705":117902,"_2959":118015},[],"Gateways independientes e IP externas distintas",{"_3475":70865,"_30471":70820,"_21105":118017,"_5":14473,"_27705":117902,"_2959":118018},[],"Una VIP por Gateway",{"_3475":70866,"_30471":70820,"_21105":118020,"_5":14473,"_27705":117902,"_2959":118021},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3475":70867,"_30471":70820,"_21105":118023,"_5":14473,"_27705":117902,"_2959":118024},[],"Gateways independientes, un nodo y una IP",{"_3475":70868,"_30471":70820,"_21105":118026,"_5":14473,"_27705":117902,"_2959":118027},[],"Puertos externos diferentes",{"_3475":70869,"_30471":70820,"_21105":118029,"_5":14473,"_27705":117902,"_2959":118030},[],"Los clientes deben indicar puertos no estándar",{"_3475":70870,"_30471":70820,"_21105":118032,"_5":14473,"_27705":117902,"_2959":118033},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3475":70871,"_30471":70820,"_21105":118035,"_5":14473,"_27705":117902,"_2959":118036},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3475":70872,"_30471":70820,"_21105":118038,"_5":14473,"_27705":117902,"_2959":118039},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3475":70873,"_30471":70820,"_21105":118041,"_5":14473,"_27705":117902,"_2959":118042},[],"Recursos Gateway separados pero proxy compartido",{"_3475":70874,"_30471":70820,"_21105":118044,"_5":14473,"_27705":117902,"_2959":118045},[],"Modo merged Gateway de Envoy",{"_3475":70875,"_30471":70820,"_21105":118047,"_5":14473,"_27705":117902,"_2959":118048},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3475":70876,"_30471":70820,"_21105":118050,"_5":14473,"_27705":117902,"_2959":118051},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3475":70877,"_30471":70820,"_21105":118053,"_5":14473,"_27705":117902,"_2959":118054},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3475":70878,"_30471":70820,"_21105":118056,"_5":14473,"_27705":117902,"_2959":118057},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3475":70879,"_30471":70820,"_21105":118059,"_5":14473,"_27705":117902,"_2959":118060},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3475":70880,"_30471":70820,"_21105":118062,"_5":14473,"_27705":117906,"_2959":118063},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3475":70881,"_30471":70820,"_21105":118065,"_5":14473,"_27705":117910,"_2959":118066},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3475":70882,"_30471":70820,"_21105":118068,"_5":14473,"_27705":117910,"_2959":118069},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3475":70883,"_30471":70820,"_21105":118071,"_5":14473,"_27705":117910,"_2959":118072},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3475":70884,"_30471":70820,"_21105":118074,"_5":14473,"_27705":117910,"_2959":118075},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3475":70885,"_30471":70820,"_21105":118077,"_5":14473,"_27705":117910,"_2959":118078},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3475":70886,"_30471":70820,"_21105":118080,"_5":14473,"_27705":117914,"_2959":118081},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3475":70887,"_30471":70820,"_21105":118083,"_5":14473,"_27705":117914,"_2959":118084},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3475":70888,"_30471":70820,"_21105":118086,"_5":14473,"_27705":117918,"_2959":118087},[],"Comprueba, en orden:",{"_3475":70889,"_30471":70820,"_21105":118089,"_5":14473,"_27705":117918,"_2959":118090},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3475":70890,"_30471":70820,"_21105":118092,"_5":14473,"_27705":117918,"_2959":118093},[],"Su estado contiene la dirección esperada.",{"_3475":70891,"_30471":70820,"_21105":118095,"_5":14473,"_27705":117918,"_2959":118096},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3475":70892,"_30471":70820,"_21105":118098,"_5":14473,"_27705":117918,"_2959":118099},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3475":70893,"_30471":70820,"_21105":118101,"_5":14473,"_27705":117918,"_2959":118102},[],"DNS resuelve al endpoint accesible externamente.",{"_3475":70894,"_30471":70820,"_21105":118104,"_5":14473,"_27705":117918,"_2959":118105},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3475":70895,"_30471":70820,"_21105":118107,"_5":14473,"_27705":117918,"_2959":118108},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3475":70896,"_30471":70896,"_5":14825,"_2959":49702,"_30823":118110,"_21105":118111,"_27705":70896},[49595,117100,117334],[],{"_3475":70897,"_30471":70896,"_21105":118113,"_5":14473,"_27705":70896,"_2959":118114},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3475":70898,"_30471":70896,"_5":30820,"_21105":118116,"_27705":118117,"_2959":118118},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3475":70899,"_30471":70896,"_5":30820,"_21105":118120,"_27705":118121,"_2959":118122},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3475":70900,"_30471":70896,"_5":30820,"_21105":118124,"_27705":118125,"_2959":118126},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3475":70901,"_30471":70896,"_5":30820,"_21105":118128,"_27705":118129,"_2959":118130},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3475":70902,"_30471":70896,"_5":30820,"_21105":118132,"_27705":118133,"_2959":118134},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3475":70903,"_30471":70896,"_5":30820,"_21105":118136,"_27705":118137,"_2959":118138},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3475":70904,"_30471":70896,"_21105":118140,"_5":14473,"_27705":118117,"_2959":118141},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3475":70905,"_30471":70896,"_21105":118143,"_5":14473,"_27705":118121,"_2959":118144},[],"Flujo",{"_3475":70906,"_30471":70896,"_21105":118146,"_5":14473,"_27705":118121,"_2959":118147},[],"Úsalo para",{"_3475":70907,"_30471":70896,"_21105":118149,"_5":14473,"_27705":118121,"_2959":118150},[],"Qué instala",{"_3475":70908,"_30471":70896,"_21105":118152,"_5":14473,"_27705":118121,"_2959":50683},[],{"_3475":70909,"_30471":70896,"_21105":118154,"_5":14473,"_27705":118121,"_2959":118155},[],"Producción y entornos controlados",{"_3475":70910,"_30471":70896,"_21105":118157,"_5":14473,"_27705":118121,"_2959":118158},[],"Servicios de Lamassu y recursos de Gateway API",{"_3475":70911,"_30471":70896,"_21105":118160,"_5":14473,"_27705":118121,"_2959":49839},[],{"_3475":70912,"_30471":70896,"_21105":118162,"_5":14473,"_27705":118121,"_2959":118163},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3475":70913,"_30471":70896,"_21105":118165,"_5":14473,"_27705":118121,"_2959":118166},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3475":70914,"_30471":70896,"_21105":118168,"_5":14473,"_27705":118125,"_2959":118169},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3475":70915,"_30471":70896,"_21105":118171,"_5":14473,"_27705":118125,"_2959":118172},[],"Área",{"_3475":70916,"_30471":70896,"_21105":118174,"_5":14473,"_27705":118125,"_2959":118175},[],"El chart de Lamassu proporciona",{"_3475":70917,"_30471":70896,"_21105":118177,"_5":14473,"_27705":118125,"_2959":118178},[],"Tú proporcionas",{"_3475":70918,"_30471":70896,"_21105":118180,"_5":14473,"_27705":118125,"_2959":118181},[],"Aplicaciones Lamassu",{"_3475":70919,"_30471":70896,"_21105":118183,"_5":14473,"_27705":118125,"_2959":118184},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3475":70920,"_30471":70896,"_21105":118186,"_5":14473,"_27705":118125,"_2959":118187},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3475":70921,"_30471":70896,"_21105":118189,"_5":14473,"_27705":118125,"_2959":118190},[],"Datos PostgreSQL",{"_3475":70922,"_30471":70896,"_21105":118192,"_5":14473,"_27705":118125,"_2959":118193},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3475":70923,"_30471":70896,"_21105":118195,"_5":14473,"_27705":118125,"_2959":118196},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3475":70924,"_30471":70896,"_21105":118198,"_5":14473,"_27705":118125,"_2959":118199},[],"Mensajería",{"_3475":70925,"_30471":70896,"_21105":118201,"_5":14473,"_27705":118125,"_2959":118202},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3475":70926,"_30471":70896,"_21105":118204,"_5":14473,"_27705":118125,"_2959":118205},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3475":70927,"_30471":70896,"_21105":118207,"_5":14473,"_27705":118125,"_2959":118208},[],"Identidad",{"_3475":70928,"_30471":70896,"_21105":118210,"_5":14473,"_27705":118125,"_2959":118211},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3475":70929,"_30471":70896,"_21105":118213,"_5":14473,"_27705":118125,"_2959":118214},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3475":70930,"_30471":70896,"_21105":118216,"_5":14473,"_27705":118125,"_2959":118217},[],"Enrutamiento externo",{"_3475":70931,"_30471":70896,"_21105":118219,"_5":14473,"_27705":118125,"_2959":118220},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3475":70932,"_30471":70896,"_21105":118222,"_5":14473,"_27705":118125,"_2959":118223},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3475":70933,"_30471":70896,"_21105":118225,"_5":14473,"_27705":118125,"_2959":50757},[],{"_3475":70934,"_30471":70896,"_21105":118227,"_5":14473,"_27705":118125,"_2959":118228},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3475":70935,"_30471":70896,"_21105":118230,"_5":14473,"_27705":118125,"_2959":118231},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3475":70936,"_30471":70896,"_21105":118233,"_5":14473,"_27705":118125,"_2959":118234},[],"Datos persistentes de la aplicación",{"_3475":70937,"_30471":70896,"_21105":118236,"_5":14473,"_27705":118125,"_2959":118237},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3475":70938,"_30471":70896,"_21105":118239,"_5":14473,"_27705":118125,"_2959":118240},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3475":70939,"_30471":70896,"_21105":118242,"_5":14473,"_27705":118125,"_2959":118243},[],"Integraciones opcionales",{"_3475":70940,"_30471":70896,"_21105":118245,"_5":14473,"_27705":118125,"_2959":118246},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3475":70941,"_30471":70896,"_21105":118248,"_5":14473,"_27705":118125,"_2959":118249},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3475":70942,"_30471":70896,"_21105":118251,"_5":14473,"_27705":118125,"_2959":118252},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3475":70943,"_30471":70896,"_21105":118254,"_5":14473,"_27705":118125,"_2959":118255},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3475":70944,"_30471":70896,"_21105":118257,"_5":14473,"_27705":118129,"_2959":118258},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3475":70945,"_30471":70896,"_21105":118260,"_5":14473,"_27705":118129,"_2959":118261},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3475":70946,"_30471":70896,"_21105":118263,"_5":14473,"_27705":118133,"_2959":118264},[],"Kubernetes 1.24 o posterior",{"_3475":70947,"_30471":70896,"_21105":118266,"_5":14473,"_27705":118133,"_2959":118267},[],"Helm 3.2 o posterior",{"_3475":70948,"_30471":70896,"_21105":118269,"_5":14473,"_27705":118133,"_2959":118270},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3475":70949,"_30471":70896,"_21105":118272,"_5":14473,"_27705":118133,"_2959":118273},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3475":70950,"_30471":70896,"_21105":118275,"_5":14473,"_27705":118133,"_2959":118276},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3475":70951,"_30471":70896,"_21105":118278,"_5":14473,"_27705":118133,"_2959":118279},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3475":70952,"_30471":70896,"_21105":118281,"_5":14473,"_27705":118133,"_2959":118282},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3475":70953,"_30471":70896,"_21105":118284,"_5":14473,"_27705":118137,"_2959":118285},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3475":70954,"_30471":70896,"_21105":118287,"_5":14473,"_27705":118137,"_2959":118288},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3475":70955,"_30471":70896,"_21105":118290,"_5":14473,"_27705":118137,"_2959":118291},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3475":70956,"_30471":70896,"_21105":118293,"_5":14473,"_27705":118137,"_2959":118294},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3475":70957,"_30471":70957,"_5":14825,"_2959":118296,"_30823":118297,"_21105":118299,"_27705":70957},"Resolución de problemas de despliegue",[49595,117100,118298],"Operación",[],{"_3475":70958,"_30471":70957,"_21105":118301,"_5":14473,"_27705":70957,"_2959":118302},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3475":70959,"_30471":70957,"_5":30820,"_21105":118304,"_27705":118305,"_2959":118306},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3475":70960,"_30471":70957,"_5":30820,"_21105":118308,"_27705":118309,"_2959":118310},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3475":70961,"_30471":70957,"_5":30820,"_21105":118312,"_27705":118313,"_2959":118314},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3475":70962,"_30471":70957,"_5":30820,"_21105":118316,"_27705":118317,"_2959":118318},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3475":70963,"_30471":70957,"_5":30820,"_21105":118320,"_27705":118321,"_2959":118322},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3475":70964,"_30471":70957,"_5":30820,"_21105":118324,"_27705":118325,"_2959":118326},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3475":70965,"_30471":70957,"_5":30820,"_21105":118328,"_27705":118329,"_2959":118330},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3475":70966,"_30471":70957,"_5":30820,"_21105":118332,"_27705":118333,"_2959":118334},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3475":70967,"_30471":70957,"_5":30820,"_21105":118336,"_27705":118337,"_2959":118338},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3475":70968,"_30471":70957,"_5":30820,"_21105":118340,"_27705":118341,"_2959":118342},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3475":70969,"_30471":70957,"_5":30820,"_21105":118344,"_27705":118345,"_2959":118346},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3475":70970,"_30471":70957,"_5":30820,"_21105":118348,"_27705":118349,"_2959":118350},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3475":70971,"_30471":70957,"_5":30820,"_21105":118352,"_27705":118353,"_2959":118354},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3475":70972,"_30471":70957,"_21105":118356,"_5":14473,"_27705":70957,"_2959":118357},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3475":70973,"_30471":70957,"_21105":118359,"_5":14473,"_27705":118309,"_2959":118360},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3475":70974,"_30471":70957,"_21105":118362,"_5":14473,"_27705":118313,"_2959":118363},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3475":70975,"_30471":70957,"_21105":118365,"_5":14473,"_27705":118317,"_2959":118366},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3475":70976,"_30471":70957,"_21105":118368,"_5":14473,"_27705":118321,"_2959":118369},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3475":70977,"_30471":70957,"_21105":118371,"_5":14473,"_27705":118325,"_2959":118372},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3475":70978,"_30471":70957,"_21105":118374,"_5":14473,"_27705":118329,"_2959":118375},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3475":70979,"_30471":70957,"_21105":118377,"_5":14473,"_27705":118329,"_2959":118378},[],"Ejecuta también la prueba de conectividad del chart:",{"_3475":70980,"_30471":70957,"_21105":118380,"_5":14473,"_27705":118329,"_2959":118381},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3475":70981,"_30471":70957,"_21105":118383,"_5":14473,"_27705":118329,"_2959":118384},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3475":70982,"_30471":70957,"_21105":118386,"_5":14473,"_27705":118333,"_2959":118387},[],"Si recibes un 401:",{"_3475":70983,"_30471":70957,"_21105":118389,"_5":14473,"_27705":118333,"_2959":118390},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3475":70984,"_30471":70957,"_21105":118392,"_5":14473,"_27705":118333,"_2959":118393},[],"verifica emisor, audiencia y expiración del token;",{"_3475":70985,"_30471":70957,"_21105":118395,"_5":14473,"_27705":118333,"_2959":118396},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3475":70986,"_30471":70957,"_21105":118398,"_5":14473,"_27705":118333,"_2959":118399},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3475":70987,"_30471":70957,"_21105":118401,"_5":14473,"_27705":118333,"_2959":118402},[],"Si el login termina pero las APIs devuelven 403:",{"_3475":70988,"_30471":70957,"_21105":118404,"_5":14473,"_27705":118333,"_2959":118405},[],"inspecciona los claims reales del token;",{"_3475":70989,"_30471":70957,"_21105":118407,"_5":14473,"_27705":118333,"_2959":118408},[],"confirma que coinciden con un principal activo;",{"_3475":70990,"_30471":70957,"_21105":118410,"_5":14473,"_27705":118333,"_2959":118411},[],"revisa las políticas concedidas al principal;",{"_3475":70991,"_30471":70957,"_21105":118413,"_5":14473,"_27705":118333,"_2959":118414},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3475":70992,"_30471":70957,"_21105":118416,"_5":14473,"_27705":118333,"_2959":118417},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3475":70993,"_30471":70957,"_21105":118419,"_5":14473,"_27705":118337,"_2959":118420},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3475":70994,"_30471":70957,"_21105":118422,"_5":14473,"_27705":118337,"_2959":118423},[],"Localiza el pod y Service de authz.",{"_3475":70995,"_30471":70957,"_21105":118425,"_5":14473,"_27705":118337,"_2959":118426},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3475":70996,"_30471":70957,"_21105":118428,"_5":14473,"_27705":118337,"_2959":118429},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3475":70997,"_30471":70957,"_21105":118431,"_5":14473,"_27705":118337,"_2959":118432},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3475":70998,"_30471":70957,"_21105":118434,"_5":14473,"_27705":118337,"_2959":118435},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3475":70999,"_30471":70957,"_21105":118437,"_5":14473,"_27705":118341,"_2959":118438},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3475":71000,"_30471":70957,"_21105":118440,"_5":14473,"_27705":118345,"_2959":118441},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3475":71001,"_30471":70957,"_21105":118443,"_5":14473,"_27705":118345,"_2959":118444},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3475":71002,"_30471":70957,"_21105":118446,"_5":14473,"_27705":118345,"_2959":118447},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3475":71003,"_30471":70957,"_21105":118449,"_5":14473,"_27705":118345,"_2959":118450},[],"volumen persistente sin enlazar;",{"_3475":71004,"_30471":70957,"_21105":118452,"_5":14473,"_27705":118345,"_2959":118453},[],"imagen inaccesible o política de pull incorrecta;",{"_3475":71005,"_30471":70957,"_21105":118455,"_5":14473,"_27705":118345,"_2959":118456},[],"configuración inválida del motor criptográfico;",{"_3475":71006,"_30471":70957,"_21105":118458,"_5":14473,"_27705":118345,"_2959":118459},[],"límites de CPU o memoria demasiado bajos;",{"_3475":71007,"_30471":70957,"_21105":118461,"_5":14473,"_27705":118345,"_2959":118462},[],"migración previa incompleta.",{"_3475":71008,"_30471":70957,"_21105":118464,"_5":14473,"_27705":118345,"_2959":118465},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3475":71009,"_30471":70957,"_21105":118467,"_5":14473,"_27705":118345,"_2959":118468},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3475":71010,"_30471":70957,"_21105":118470,"_5":14473,"_27705":118345,"_2959":118471},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3475":71011,"_30471":70957,"_21105":118473,"_5":14473,"_27705":118349,"_2959":118474},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3475":71012,"_30471":70957,"_21105":118476,"_5":14473,"_27705":118349,"_2959":118477},[],"verifica que esté habilitado en el servicio emisor;",{"_3475":71013,"_30471":70957,"_21105":118479,"_5":14473,"_27705":118349,"_2959":118480},[],"comprueba conectividad y credenciales AMQP;",{"_3475":71014,"_30471":70957,"_21105":118482,"_5":14473,"_27705":118349,"_2959":118483},[],"revisa exchange, routing key, colas y consumidores;",{"_3475":71015,"_30471":70957,"_21105":118485,"_5":14473,"_27705":118349,"_2959":118486},[],"inspecciona dead-letter queues;",{"_3475":71016,"_30471":70957,"_21105":118488,"_5":14473,"_27705":118349,"_2959":118489},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3475":71017,"_30471":70957,"_21105":118491,"_5":14473,"_27705":118349,"_2959":118492},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3475":71018,"_30471":70957,"_21105":118494,"_5":14473,"_27705":118349,"_2959":118495},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3475":71019,"_30471":70957,"_21105":118497,"_5":14473,"_27705":118349,"_2959":118498},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3475":71020,"_30471":70957,"_21105":118500,"_5":14473,"_27705":118349,"_2959":118501},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3475":71021,"_30471":70957,"_21105":118503,"_5":14473,"_27705":118349,"_2959":118504},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3475":71022,"_30471":70957,"_21105":118506,"_5":14473,"_27705":118349,"_2959":118507},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3475":71023,"_30471":70957,"_21105":118509,"_5":14473,"_27705":118349,"_2959":118510},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3475":71024,"_30471":70957,"_21105":118512,"_5":14473,"_27705":118353,"_2959":118513},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3475":71025,"_30471":70957,"_21105":118515,"_5":14473,"_27705":118353,"_2959":118516},[],"Antes de cerrar una incidencia, guarda:",{"_3475":71026,"_30471":70957,"_21105":118518,"_5":14473,"_27705":118353,"_2959":118519},[],"causa confirmada;",{"_3475":71027,"_30471":70957,"_21105":118521,"_5":14473,"_27705":118353,"_2959":118522},[],"alcance temporal y recursos afectados;",{"_3475":71028,"_30471":70957,"_21105":118524,"_5":14473,"_27705":118353,"_2959":118525},[],"comandos o consultas utilizados;",{"_3475":71029,"_30471":70957,"_21105":118527,"_5":14473,"_27705":118353,"_2959":118528},[],"cambio aplicado y forma de revertirlo;",{"_3475":71030,"_30471":70957,"_21105":118530,"_5":14473,"_27705":118353,"_2959":118531},[],"validación desde un consumidor;",{"_3475":71031,"_30471":70957,"_21105":118533,"_5":14473,"_27705":118353,"_2959":118534},[],"acción preventiva y propietario.",{"_3475":71032,"_30471":71032,"_5":14825,"_2959":118536,"_30823":118537,"_21105":118540,"_27705":71032},"Control de acceso",[49595,118538,118539],"Plataforma","Administración",[],{"_3475":71033,"_30471":71032,"_21105":118542,"_5":14473,"_27705":71032,"_2959":118543},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3475":71034,"_30471":71032,"_5":30820,"_21105":118545,"_27705":118546,"_2959":118547},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3475":71035,"_30471":71032,"_5":30820,"_21105":118549,"_27705":118550,"_2959":118551},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3475":71036,"_30471":71032,"_5":30820,"_21105":118553,"_27705":118554,"_2959":118555},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3475":71037,"_30471":71032,"_5":30820,"_21105":118557,"_27705":118558,"_2959":118559},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3475":71038,"_30471":71032,"_5":30820,"_21105":118561,"_27705":118562,"_2959":118563},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3475":71039,"_30471":71032,"_5":30820,"_21105":118565,"_27705":118566,"_2959":118567},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3475":71040,"_30471":71032,"_5":30820,"_21105":118569,"_27705":118570,"_2959":118571},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3475":71041,"_30471":71032,"_5":30820,"_21105":118573,"_27705":118574,"_2959":118575},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3475":71042,"_30471":71032,"_5":30820,"_21105":118577,"_27705":118578,"_2959":118579},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3475":71043,"_30471":71032,"_5":30820,"_21105":118581,"_27705":118582,"_2959":118583},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3475":71044,"_30471":71032,"_5":30820,"_21105":118585,"_27705":118586,"_2959":118587},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3475":71045,"_30471":71032,"_5":30820,"_21105":118589,"_27705":118590,"_2959":118591},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3475":71046,"_30471":71032,"_5":30820,"_21105":118593,"_27705":118594,"_2959":118595},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3475":71047,"_30471":71032,"_5":30820,"_21105":118597,"_27705":118598,"_2959":118599},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3475":71048,"_30471":71032,"_5":30820,"_21105":118601,"_27705":118602,"_2959":118603},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3475":71049,"_30471":71032,"_5":30820,"_21105":118605,"_27705":118606,"_2959":117706},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3475":71050,"_30471":71032,"_5":30820,"_21105":118608,"_27705":118609,"_2959":118610},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3475":71051,"_30471":71032,"_5":30820,"_21105":118612,"_27705":118613,"_2959":118614},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3475":71052,"_30471":71032,"_5":30820,"_21105":118616,"_27705":118617,"_2959":118618},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3475":71053,"_30471":71032,"_5":30820,"_21105":118620,"_27705":118621,"_2959":118622},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3475":71054,"_30471":71032,"_5":30820,"_21105":118624,"_27705":118625,"_2959":118626},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3475":71055,"_30471":71032,"_5":30820,"_21105":118628,"_27705":118629,"_2959":118630},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3475":71056,"_30471":71032,"_5":30820,"_21105":118632,"_27705":118633,"_2959":118634},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3475":71057,"_30471":71032,"_5":30820,"_21105":118636,"_27705":118637,"_2959":118638},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3475":71058,"_30471":71032,"_5":30820,"_21105":118640,"_27705":118641,"_2959":118642},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3475":71059,"_30471":71032,"_5":30820,"_21105":118644,"_27705":118645,"_2959":118646},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3475":71060,"_30471":71032,"_5":30820,"_21105":118648,"_27705":118649,"_2959":118650},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3475":71061,"_30471":71032,"_5":30820,"_21105":118652,"_27705":118653,"_2959":118654},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3475":71062,"_30471":71032,"_5":30820,"_21105":118656,"_27705":118657,"_2959":118658},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3475":71063,"_30471":71032,"_5":30820,"_21105":118660,"_27705":118661,"_2959":118662},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3475":71064,"_30471":71032,"_5":30820,"_21105":118664,"_27705":118665,"_2959":118666},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3475":71065,"_30471":71032,"_21105":118668,"_5":14473,"_27705":71032,"_2959":118669},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3475":71066,"_30471":71032,"_21105":118671,"_5":14473,"_27705":71032,"_2959":118672},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3475":71067,"_30471":71032,"_21105":118674,"_5":14473,"_27705":71032,"_2959":118675},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3475":71068,"_30471":71032,"_21105":118677,"_5":14473,"_27705":118546,"_2959":118678},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3475":71069,"_30471":71032,"_21105":118680,"_5":14473,"_27705":118546,"_2959":118681},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3475":71070,"_30471":71032,"_21105":118683,"_5":14473,"_27705":118546,"_2959":118684},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3475":71071,"_30471":71032,"_21105":118686,"_5":14473,"_27705":118546,"_2959":118687},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3475":71072,"_30471":71032,"_21105":118689,"_5":14473,"_27705":118546,"_2959":118690},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3475":71073,"_30471":71032,"_21105":118692,"_5":14473,"_27705":118546,"_2959":118693},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3475":71074,"_30471":71032,"_21105":118695,"_5":14473,"_27705":118550,"_2959":118696},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3475":71075,"_30471":71032,"_21105":118698,"_5":14473,"_27705":118550,"_2959":118699},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3475":71076,"_30471":71032,"_21105":118701,"_5":14473,"_27705":118554,"_2959":118702},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3475":71077,"_30471":71032,"_21105":118704,"_5":14473,"_27705":118554,"_2959":118705},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3475":71078,"_30471":71032,"_21105":118707,"_5":14473,"_27705":118554,"_2959":118708},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3475":71079,"_30471":71032,"_21105":118710,"_5":14473,"_27705":118554,"_2959":118711},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3475":71080,"_30471":71032,"_21105":118713,"_5":14473,"_27705":118554,"_2959":118714},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3475":71081,"_30471":71032,"_21105":118716,"_5":14473,"_27705":118554,"_2959":118717},[],"Carga por separado las políticas concedidas a cada principal.",{"_3475":71082,"_30471":71032,"_21105":118719,"_5":14473,"_27705":118554,"_2959":118720},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3475":71083,"_30471":71032,"_21105":118722,"_5":14473,"_27705":118554,"_2959":118723},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3475":71084,"_30471":71032,"_21105":118725,"_5":14473,"_27705":118554,"_2959":118726},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3475":71085,"_30471":71032,"_21105":118728,"_5":14473,"_27705":118554,"_2959":118729},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3475":71086,"_30471":71032,"_21105":118731,"_5":14473,"_27705":118554,"_2959":118732},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3475":71087,"_30471":71032,"_21105":118734,"_5":14473,"_27705":118554,"_2959":118735},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3475":71088,"_30471":71032,"_21105":118737,"_5":14473,"_27705":118558,"_2959":118738},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3475":71089,"_30471":71032,"_21105":118740,"_5":14473,"_27705":118558,"_2959":118741},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3475":71090,"_30471":71032,"_21105":118743,"_5":14473,"_27705":118558,"_2959":118744},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3475":71091,"_30471":71032,"_21105":118746,"_5":14473,"_27705":118558,"_2959":118747},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3475":71092,"_30471":71032,"_21105":118749,"_5":14473,"_27705":118558,"_2959":118750},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3475":71093,"_30471":71032,"_21105":118752,"_5":14473,"_27705":118558,"_2959":118753},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3475":71094,"_30471":71032,"_21105":118755,"_5":14473,"_27705":118558,"_2959":118756},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3475":71095,"_30471":71032,"_21105":118758,"_5":14473,"_27705":118558,"_2959":118759},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3475":71096,"_30471":71032,"_21105":118761,"_5":14473,"_27705":118562,"_2959":118762},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3475":71097,"_30471":71032,"_21105":118764,"_5":14473,"_27705":118562,"_2959":118765},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3475":71098,"_30471":71032,"_21105":118767,"_5":14473,"_27705":118562,"_2959":118768},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3475":71099,"_30471":71032,"_21105":118770,"_5":14473,"_27705":118562,"_2959":118771},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3475":71100,"_30471":71032,"_21105":118773,"_5":14473,"_27705":118562,"_2959":118774},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3475":71101,"_30471":71032,"_21105":118776,"_5":14473,"_27705":118562,"_2959":118777},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3475":71102,"_30471":71032,"_21105":118779,"_5":14473,"_27705":118562,"_2959":118780},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3475":71103,"_30471":71032,"_21105":118782,"_5":14473,"_27705":118562,"_2959":118783},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3475":71104,"_30471":71032,"_21105":118785,"_5":14473,"_27705":118562,"_2959":118786},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3475":71105,"_30471":71032,"_21105":118788,"_5":14473,"_27705":118562,"_2959":118789},[],"Las acciones se dividen en dos grupos:",{"_3475":71106,"_30471":71032,"_21105":118791,"_5":14473,"_27705":118562,"_2959":118792},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3475":71107,"_30471":71032,"_21105":118794,"_5":14473,"_27705":118562,"_2959":118795},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3475":71108,"_30471":71032,"_21105":118797,"_5":14473,"_27705":118562,"_2959":118798},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3475":71109,"_30471":71032,"_21105":118800,"_5":14473,"_27705":118566,"_2959":118801},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3475":71110,"_30471":71032,"_21105":118803,"_5":14473,"_27705":118566,"_2959":118804},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3475":71111,"_30471":71032,"_21105":118806,"_5":14473,"_27705":118566,"_2959":118807},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3475":71112,"_30471":71032,"_21105":118809,"_5":14473,"_27705":118570,"_2959":118810},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3475":71113,"_30471":71032,"_21105":118812,"_5":14473,"_27705":118570,"_2959":118813},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3475":71114,"_30471":71032,"_21105":118815,"_5":14473,"_27705":118570,"_2959":118816},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3475":71115,"_30471":71032,"_21105":118818,"_5":14473,"_27705":118570,"_2959":118819},[],"Los operadores implementados son:",{"_3475":71116,"_30471":71032,"_21105":118821,"_5":14473,"_27705":118570,"_2959":118822},[],"`equals`, para igualdad exacta;",{"_3475":71117,"_30471":71032,"_21105":118824,"_5":14473,"_27705":118570,"_2959":118825},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3475":71118,"_30471":71032,"_21105":118827,"_5":14473,"_27705":118570,"_2959":118828},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3475":71119,"_30471":71032,"_21105":118830,"_5":14473,"_27705":118570,"_2959":118831},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3475":71120,"_30471":71032,"_21105":118833,"_5":14473,"_27705":118574,"_2959":118834},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3475":71121,"_30471":71032,"_21105":118836,"_5":14473,"_27705":118574,"_2959":118837},[],"Los modos disponibles son:",{"_3475":71122,"_30471":71032,"_21105":118839,"_5":14473,"_27705":118574,"_2959":118840},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3475":71123,"_30471":71032,"_21105":118842,"_5":14473,"_27705":118574,"_2959":118843},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3475":71124,"_30471":71032,"_21105":118845,"_5":14473,"_27705":118574,"_2959":118846},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3475":71125,"_30471":71032,"_21105":118848,"_5":14473,"_27705":118574,"_2959":118849},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3475":71126,"_30471":71032,"_21105":118851,"_5":14473,"_27705":118574,"_2959":118852},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3475":71127,"_30471":71032,"_21105":118854,"_5":14473,"_27705":118574,"_2959":118855},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3475":71128,"_30471":71032,"_21105":118857,"_5":14473,"_27705":118578,"_2959":118858},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3475":71129,"_30471":71032,"_21105":118860,"_5":14473,"_27705":118578,"_2959":118861},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3475":71130,"_30471":71032,"_21105":118863,"_5":14473,"_27705":118578,"_2959":118864},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3475":71131,"_30471":71032,"_21105":118866,"_5":14473,"_27705":118578,"_2959":118867},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3475":71132,"_30471":71032,"_21105":118869,"_5":14473,"_27705":118586,"_2959":118870},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3475":71133,"_30471":71032,"_21105":118872,"_5":14473,"_27705":118586,"_2959":118873},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3475":71134,"_30471":71032,"_21105":118875,"_5":14473,"_27705":118590,"_2959":118876},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3475":71135,"_30471":71032,"_21105":118878,"_5":14473,"_27705":118590,"_2959":118879},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3475":71136,"_30471":71032,"_21105":118881,"_5":14473,"_27705":118594,"_2959":118882},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3475":71137,"_30471":71032,"_21105":118884,"_5":14473,"_27705":118594,"_2959":118885},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3475":71138,"_30471":71032,"_21105":118887,"_5":14473,"_27705":118594,"_2959":118888},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3475":71139,"_30471":71032,"_21105":118890,"_5":14473,"_27705":118598,"_2959":118891},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3475":71140,"_30471":71032,"_21105":118893,"_5":14473,"_27705":118598,"_2959":118894},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3475":71141,"_30471":71032,"_21105":118896,"_5":14473,"_27705":118598,"_2959":118897},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3475":71142,"_30471":71032,"_21105":118899,"_5":14473,"_27705":118598,"_2959":118900},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3475":71143,"_30471":71032,"_21105":118902,"_5":14473,"_27705":118598,"_2959":118903},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3475":71144,"_30471":71032,"_21105":118905,"_5":14473,"_27705":118598,"_2959":118906},[],"Ten en cuenta que:",{"_3475":71145,"_30471":71032,"_21105":118908,"_5":14473,"_27705":118598,"_2959":118909},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3475":71146,"_30471":71032,"_21105":118911,"_5":14473,"_27705":118598,"_2959":118912},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3475":71147,"_30471":71032,"_21105":118914,"_5":14473,"_27705":118598,"_2959":118915},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3475":71148,"_30471":71032,"_21105":118917,"_5":14473,"_27705":118602,"_2959":118918},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3475":71149,"_30471":71032,"_21105":118920,"_5":14473,"_27705":118602,"_2959":118921},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3475":71150,"_30471":71032,"_21105":118923,"_5":14473,"_27705":118602,"_2959":118924},[],"acceso completo y de solo lectura a KMS;",{"_3475":71151,"_30471":71032,"_21105":118926,"_5":14473,"_27705":118602,"_2959":118927},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3475":71152,"_30471":71032,"_21105":118929,"_5":14473,"_27705":118602,"_2959":118930},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3475":71153,"_30471":71032,"_21105":118932,"_5":14473,"_27705":118602,"_2959":118933},[],"acceso a la interfaz;",{"_3475":71154,"_30471":71032,"_21105":118935,"_5":14473,"_27705":118602,"_2959":118936},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3475":71155,"_30471":71032,"_21105":118938,"_5":14473,"_27705":118602,"_2959":118939},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3475":71156,"_30471":71032,"_21105":118941,"_5":14473,"_27705":118602,"_2959":118942},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3475":71157,"_30471":71032,"_21105":118944,"_5":14473,"_27705":118606,"_2959":118945},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3475":71158,"_30471":71032,"_21105":118947,"_5":14473,"_27705":118606,"_2959":118948},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3475":71159,"_30471":71032,"_21105":118950,"_5":14473,"_27705":118606,"_2959":118951},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3475":71160,"_30471":71032,"_21105":118953,"_5":14473,"_27705":118609,"_2959":118954},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3475":71161,"_30471":71032,"_21105":118956,"_5":14473,"_27705":118613,"_2959":118957},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3475":71162,"_30471":71032,"_21105":118959,"_5":14473,"_27705":118613,"_2959":118960},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3475":71163,"_30471":71032,"_21105":118962,"_5":14473,"_27705":118617,"_2959":118963},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3475":71164,"_30471":71032,"_21105":118965,"_5":14473,"_27705":118621,"_2959":118966},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3475":71165,"_30471":71032,"_21105":118968,"_5":14473,"_27705":118625,"_2959":118969},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3475":71166,"_30471":71032,"_21105":118971,"_5":14473,"_27705":118629,"_2959":118972},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3475":71167,"_30471":71032,"_21105":118974,"_5":14473,"_27705":118629,"_2959":118975},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3475":71168,"_30471":71032,"_21105":118977,"_5":14473,"_27705":118633,"_2959":118978},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3475":71169,"_30471":71032,"_21105":118980,"_5":14473,"_27705":118633,"_2959":118981},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3475":71170,"_30471":71032,"_21105":118983,"_5":14473,"_27705":118633,"_2959":118984},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3475":71171,"_30471":71032,"_21105":118986,"_5":14473,"_27705":118633,"_2959":118987},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3475":71172,"_30471":71032,"_21105":118989,"_5":14473,"_27705":118633,"_2959":118990},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3475":71173,"_30471":71032,"_21105":118992,"_5":14473,"_27705":118633,"_2959":118993},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3475":71174,"_30471":71032,"_21105":118995,"_5":14473,"_27705":118633,"_2959":118996},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3475":71175,"_30471":71032,"_21105":118998,"_5":14473,"_27705":118633,"_2959":118999},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3475":71176,"_30471":71032,"_21105":119001,"_5":14473,"_27705":118637,"_2959":119002},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3475":71177,"_30471":71032,"_21105":119004,"_5":14473,"_27705":118637,"_2959":119005},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3475":71178,"_30471":71032,"_21105":119007,"_5":14473,"_27705":118637,"_2959":119008},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3475":71179,"_30471":71032,"_21105":119010,"_5":14473,"_27705":118641,"_2959":119011},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3475":71180,"_30471":71032,"_21105":119013,"_5":14473,"_27705":118641,"_2959":119014},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3475":71181,"_30471":71032,"_21105":119016,"_5":14473,"_27705":118641,"_2959":119017},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3475":71182,"_30471":71032,"_21105":119019,"_5":14473,"_27705":118641,"_2959":119020},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3475":71183,"_30471":71032,"_21105":119022,"_5":14473,"_27705":118641,"_2959":119023},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3475":71184,"_30471":71032,"_21105":119025,"_5":14473,"_27705":118641,"_2959":119026},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3475":71185,"_30471":71032,"_21105":119028,"_5":14473,"_27705":118641,"_2959":119029},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3475":71186,"_30471":71032,"_21105":119031,"_5":14473,"_27705":118641,"_2959":119032},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3475":71187,"_30471":71032,"_21105":119034,"_5":14473,"_27705":118649,"_2959":119035},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3475":71188,"_30471":71032,"_21105":119037,"_5":14473,"_27705":118653,"_2959":119038},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3475":71189,"_30471":71032,"_21105":119040,"_5":14473,"_27705":118653,"_2959":119041},[],"que exista un principal activo del tipo correcto;",{"_3475":71190,"_30471":71032,"_21105":119043,"_5":14473,"_27705":118653,"_2959":119044},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3475":71191,"_30471":71032,"_21105":119046,"_5":14473,"_27705":118653,"_2959":119047},[],"que todas las condiciones del principal se cumplan;",{"_3475":71192,"_30471":71032,"_21105":119049,"_5":14473,"_27705":118653,"_2959":119050},[],"que el principal tenga concedida la política esperada;",{"_3475":71193,"_30471":71032,"_21105":119052,"_5":14473,"_27705":118653,"_2959":119053},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3475":71194,"_30471":71032,"_21105":119055,"_5":14473,"_27705":118653,"_2959":119056},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3475":71195,"_30471":71032,"_21105":119058,"_5":14473,"_27705":118653,"_2959":119059},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3475":71196,"_30471":71032,"_21105":119061,"_5":14473,"_27705":118657,"_2959":119062},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3475":71197,"_30471":71032,"_21105":119064,"_5":14473,"_27705":118661,"_2959":119065},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3475":71198,"_30471":71032,"_21105":119067,"_5":14473,"_27705":118665,"_2959":119068},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3475":71199,"_30471":71032,"_21105":119070,"_5":14473,"_27705":118665,"_2959":119071},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3475":71200,"_30471":71200,"_5":14825,"_2959":119073,"_30823":119074,"_21105":119075,"_27705":71200},"Alertas y suscripciones",[49595,118538,118539],[],{"_3475":71201,"_30471":71200,"_21105":119077,"_5":14473,"_27705":71200,"_2959":119078},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3475":71202,"_30471":71200,"_5":30820,"_21105":119080,"_27705":119081,"_2959":119082},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3475":71203,"_30471":71200,"_5":30820,"_21105":119084,"_27705":119085,"_2959":119086},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3475":71204,"_30471":71200,"_5":30820,"_21105":119088,"_27705":119089,"_2959":119090},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3475":71205,"_30471":71200,"_5":30820,"_21105":119092,"_27705":119093,"_2959":119094},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3475":71206,"_30471":71200,"_5":30820,"_21105":119096,"_27705":119097,"_2959":119098},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3475":71207,"_30471":71200,"_5":30820,"_21105":119100,"_27705":119101,"_2959":119102},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3475":71208,"_30471":71200,"_5":30820,"_21105":119104,"_27705":119105,"_2959":119106},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3475":71209,"_30471":71200,"_5":30820,"_21105":119108,"_27705":119109,"_2959":119110},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3475":71210,"_30471":71200,"_5":30820,"_21105":119112,"_27705":119113,"_2959":119114},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3475":71211,"_30471":71200,"_5":30820,"_21105":119116,"_27705":119117,"_2959":119118},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3475":71212,"_30471":71200,"_5":30820,"_21105":119120,"_27705":119121,"_2959":119122},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3475":71213,"_30471":71200,"_21105":119124,"_5":14473,"_27705":71200,"_2959":119125},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3475":71214,"_30471":71200,"_21105":119127,"_5":14473,"_27705":119081,"_2959":119128},[],"Un servicio publica un evento de dominio.",{"_3475":71215,"_30471":71200,"_21105":119130,"_5":14473,"_27705":119081,"_2959":119131},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3475":71216,"_30471":71200,"_21105":119133,"_5":14473,"_27705":119081,"_2959":119134},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3475":71217,"_30471":71200,"_21105":119136,"_5":14473,"_27705":119081,"_2959":119137},[],"Lamassu entrega el evento al canal configurado.",{"_3475":71218,"_30471":71200,"_21105":119139,"_5":14473,"_27705":119081,"_2959":119140},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3475":71219,"_30471":71200,"_21105":119142,"_5":14473,"_27705":119085,"_2959":119143},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3475":71220,"_30471":71200,"_21105":119145,"_5":14473,"_27705":119085,"_2959":119146},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3475":71221,"_30471":71200,"_21105":119148,"_5":14473,"_27705":119085,"_2959":119149},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3475":71222,"_30471":71200,"_21105":119151,"_5":14473,"_27705":119085,"_2959":119152},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3475":71223,"_30471":71200,"_21105":119154,"_5":14473,"_27705":119085,"_2959":119155},[],"`apikey_options` necesita `header` y `key`.",{"_3475":71224,"_30471":71200,"_21105":119157,"_5":14473,"_27705":119085,"_2959":119158},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3475":71225,"_30471":71200,"_21105":119160,"_5":14473,"_27705":119085,"_2959":119161},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3475":71226,"_30471":71200,"_21105":119163,"_5":14473,"_27705":119085,"_2959":119164},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3475":71227,"_30471":71200,"_21105":119166,"_5":14473,"_27705":119093,"_2959":119167},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3475":71228,"_30471":71200,"_21105":119169,"_5":14473,"_27705":119097,"_2959":119170},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3475":71229,"_30471":71200,"_21105":119172,"_5":14473,"_27705":119101,"_2959":119173},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3475":71230,"_30471":71200,"_21105":119175,"_5":14473,"_27705":119101,"_2959":119176},[],"**None** notifica todas las instancias del evento.",{"_3475":71231,"_30471":71200,"_21105":119178,"_5":14473,"_27705":119101,"_2959":119179},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3475":71232,"_30471":71200,"_21105":119181,"_5":14473,"_27705":119101,"_2959":119182},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3475":71233,"_30471":71200,"_21105":119184,"_5":14473,"_27705":119101,"_2959":119185},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3475":71234,"_30471":71200,"_21105":119187,"_5":14473,"_27705":119101,"_2959":119188},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3475":71235,"_30471":71200,"_21105":119190,"_5":14473,"_27705":119101,"_2959":119191},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3475":71236,"_30471":71200,"_21105":119193,"_5":14473,"_27705":119105,"_2959":119194},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3475":71237,"_30471":71200,"_21105":119196,"_5":14473,"_27705":119109,"_2959":119197},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3475":71238,"_30471":71200,"_21105":119199,"_5":14473,"_27705":119109,"_2959":119200},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3475":71239,"_30471":71200,"_21105":119202,"_5":14473,"_27705":119109,"_2959":119203},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3475":71240,"_30471":71200,"_21105":119205,"_5":14473,"_27705":119109,"_2959":119206},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3475":71241,"_30471":71200,"_21105":119208,"_5":14473,"_27705":119109,"_2959":119209},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3475":71242,"_30471":71200,"_21105":119211,"_5":14473,"_27705":119109,"_2959":119212},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3475":71243,"_30471":71200,"_21105":119214,"_5":14473,"_27705":119109,"_2959":119215},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3475":71244,"_30471":71200,"_21105":119217,"_5":14473,"_27705":119109,"_2959":119218},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3475":71245,"_30471":71200,"_21105":119220,"_5":14473,"_27705":119113,"_2959":119221},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3475":71246,"_30471":71200,"_21105":119223,"_5":14473,"_27705":119113,"_2959":119224},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3475":71247,"_30471":71200,"_21105":119226,"_5":14473,"_27705":119113,"_2959":119227},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3475":71248,"_30471":71200,"_21105":119229,"_5":14473,"_27705":119113,"_2959":119230},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3475":71249,"_30471":71200,"_21105":119232,"_5":14473,"_27705":119113,"_2959":119233},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3475":71250,"_30471":71200,"_21105":119235,"_5":14473,"_27705":119113,"_2959":119236},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3475":71251,"_30471":71200,"_21105":119238,"_5":14473,"_27705":119113,"_2959":119239},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3475":71252,"_30471":71200,"_21105":119241,"_5":14473,"_27705":119113,"_2959":119242},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3475":71253,"_30471":71200,"_21105":119244,"_5":14473,"_27705":119117,"_2959":119245},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3475":71254,"_30471":71200,"_21105":119247,"_5":14473,"_27705":119117,"_2959":119248},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3475":71255,"_30471":71200,"_21105":119250,"_5":14473,"_27705":119121,"_2959":119251},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3475":71256,"_30471":71200,"_21105":119253,"_5":14473,"_27705":119121,"_2959":119254},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3475":71257,"_30471":71200,"_21105":119256,"_5":14473,"_27705":119121,"_2959":119257},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3475":71258,"_30471":71200,"_21105":119259,"_5":14473,"_27705":119121,"_2959":119260},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3475":71259,"_30471":71200,"_21105":119262,"_5":14473,"_27705":119121,"_2959":119263},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3475":71260,"_30471":71200,"_21105":119265,"_5":14473,"_27705":119121,"_2959":119266},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3475":71261,"_30471":71200,"_21105":119268,"_5":14473,"_27705":119121,"_2959":119269},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3475":71262,"_30471":71200,"_21105":119271,"_5":14473,"_27705":119121,"_2959":119272},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3475":71263,"_30471":71200,"_21105":119274,"_5":14473,"_27705":119121,"_2959":119275},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3475":71264,"_30471":71264,"_5":14825,"_2959":119277,"_30823":119278,"_21105":119279,"_27705":71264},"Registros de auditoría",[49595,118538,118539],[],{"_3475":71265,"_30471":71264,"_21105":119281,"_5":14473,"_27705":71264,"_2959":119282},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3475":71266,"_30471":71264,"_5":30820,"_21105":119284,"_27705":119285,"_2959":119286},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3475":71267,"_30471":71264,"_5":30820,"_21105":119288,"_27705":119289,"_2959":119290},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3475":71268,"_30471":71264,"_5":30820,"_21105":119292,"_27705":119293,"_2959":119294},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3475":71269,"_30471":71264,"_5":30820,"_21105":119296,"_27705":119297,"_2959":119298},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3475":71270,"_30471":71264,"_5":30820,"_21105":119300,"_27705":119301,"_2959":119302},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3475":71271,"_30471":71264,"_5":30820,"_21105":119304,"_27705":119305,"_2959":119306},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3475":71272,"_30471":71264,"_5":30820,"_21105":119308,"_27705":119309,"_2959":119310},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3475":71273,"_30471":71264,"_5":30820,"_21105":119312,"_27705":119313,"_2959":119314},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3475":71274,"_30471":71264,"_5":30820,"_21105":119316,"_27705":119317,"_2959":119318},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3475":71275,"_30471":71264,"_5":30820,"_21105":119320,"_27705":119321,"_2959":119322},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3475":71276,"_30471":71264,"_5":30820,"_21105":119324,"_27705":119325,"_2959":119326},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3475":71277,"_30471":71264,"_21105":119328,"_5":14473,"_27705":71264,"_2959":119329},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3475":71278,"_30471":71264,"_21105":119331,"_5":14473,"_27705":119285,"_2959":119332},[],"El cuerpo de auditoría incluye:",{"_3475":71279,"_30471":71264,"_21105":119334,"_5":14473,"_27705":119285,"_2959":119335},[],"input: datos recibidos por la operación;",{"_3475":71280,"_30471":71264,"_21105":119337,"_5":14473,"_27705":119285,"_2959":119338},[],"has\\_error: indica si el servicio devolvió un error;",{"_3475":71281,"_30471":71264,"_21105":119340,"_5":14473,"_27705":119285,"_2959":119341},[],"output: resultado producido o mensaje de error;",{"_3475":71282,"_30471":71264,"_21105":119343,"_5":14473,"_27705":119285,"_2959":119344},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3475":71283,"_30471":71264,"_21105":119346,"_5":14473,"_27705":119285,"_2959":119347},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3475":71284,"_30471":71264,"_21105":119349,"_5":14473,"_27705":119285,"_2959":119350},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3475":71285,"_30471":71264,"_21105":119352,"_5":14473,"_27705":119289,"_2959":119353},[],"El backend aplica auditoría a mutaciones de:",{"_3475":71286,"_30471":71264,"_21105":119355,"_5":14473,"_27705":119289,"_2959":119356},[],"autoridades, certificados y perfiles de emisión;",{"_3475":71287,"_30471":71264,"_21105":119358,"_5":14473,"_27705":119289,"_2959":119359},[],"claves y motores KMS;",{"_3475":71288,"_30471":71264,"_21105":119361,"_5":14473,"_27705":119289,"_2959":119362},[],"dispositivos e identidades;",{"_3475":71289,"_30471":71264,"_21105":119364,"_5":14473,"_27705":119289,"_2959":119365},[],"DMS y operaciones de enrolamiento;",{"_3475":71290,"_30471":71264,"_21105":119367,"_5":14473,"_27705":119289,"_2959":119368},[],"funciones de validación y CRL;",{"_3475":71291,"_30471":71264,"_21105":119370,"_5":14473,"_27705":119289,"_2959":119371},[],"principales, políticas y concesiones de autorización.",{"_3475":71292,"_30471":71264,"_21105":119373,"_5":14473,"_27705":119289,"_2959":119374},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3475":71293,"_30471":71264,"_21105":119376,"_5":14473,"_27705":119293,"_2959":119377},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3475":71294,"_30471":71264,"_21105":119379,"_5":14473,"_27705":119293,"_2959":119380},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3475":71295,"_30471":71264,"_21105":119382,"_5":14473,"_27705":119293,"_2959":119383},[],"Diseña el consumidor para:",{"_3475":71296,"_30471":71264,"_21105":119385,"_5":14473,"_27705":119293,"_2959":119386},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3475":71297,"_30471":71264,"_21105":119388,"_5":14473,"_27705":119293,"_2959":119389},[],"conservar el CloudEvent completo sin modificar;",{"_3475":71298,"_30471":71264,"_21105":119391,"_5":14473,"_27705":119293,"_2959":119392},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3475":71299,"_30471":71264,"_21105":119394,"_5":14473,"_27705":119293,"_2959":119395},[],"cifrar en tránsito y en reposo;",{"_3475":71300,"_30471":71264,"_21105":119397,"_5":14473,"_27705":119293,"_2959":119398},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3475":71301,"_30471":71264,"_21105":119400,"_5":14473,"_27705":119293,"_2959":119401},[],"aplicar una política explícita de retención y legal hold;",{"_3475":71302,"_30471":71264,"_21105":119403,"_5":14473,"_27705":119293,"_2959":119404},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3475":71303,"_30471":71264,"_21105":119406,"_5":14473,"_27705":119297,"_2959":119407},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3475":71304,"_30471":71264,"_21105":119409,"_5":14473,"_27705":119297,"_2959":119410},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3475":71305,"_30471":71264,"_21105":119412,"_5":14473,"_27705":119305,"_2959":119413},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3475":71306,"_30471":71264,"_21105":119415,"_5":14473,"_27705":119309,"_2959":119416},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3475":71307,"_30471":71264,"_21105":119418,"_5":14473,"_27705":119313,"_2959":119419},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3475":71308,"_30471":71264,"_21105":119421,"_5":14473,"_27705":119317,"_2959":119422},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3475":71309,"_30471":71264,"_21105":119424,"_5":14473,"_27705":119321,"_2959":119425},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3475":71310,"_30471":71264,"_21105":119427,"_5":14473,"_27705":119325,"_2959":119428},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3475":71311,"_30471":71264,"_21105":119430,"_5":14473,"_27705":119325,"_2959":119431},[],"aparece un evento de auditoría correcto;",{"_3475":71312,"_30471":71264,"_21105":119433,"_5":14473,"_27705":119325,"_2959":119434},[],"el principal coincide con la identidad utilizada;",{"_3475":71313,"_30471":71264,"_21105":119436,"_5":14473,"_27705":119325,"_2959":119437},[],"el consumidor lo persiste una sola vez;",{"_3475":71314,"_30471":71264,"_21105":119439,"_5":14473,"_27705":119325,"_2959":119440},[],"puede recuperarse por recurso, actor y periodo;",{"_3475":71315,"_30471":71264,"_21105":119442,"_5":14473,"_27705":119325,"_2959":119443},[],"una interrupción del consumidor produce una alerta.",{"_3475":71316,"_30471":71264,"_21105":119445,"_5":14473,"_27705":119325,"_2959":119446},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3475":71317,"_30471":71317,"_5":14825,"_2959":119448,"_30823":119449,"_21105":119450,"_27705":71317},"Arquitectura de la plataforma",[49595,118538],[],{"_3475":71318,"_30471":71317,"_21105":119452,"_5":14473,"_27705":71317,"_2959":119453},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3475":71319,"_30471":71317,"_5":30820,"_21105":119455,"_27705":119456,"_2959":119457},[],"/docs/pr-preview/pr-67/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3475":71320,"_30471":71317,"_5":30820,"_21105":119459,"_27705":119460,"_2959":119461},[],"/docs/pr-preview/pr-67/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3475":71321,"_30471":71317,"_5":30820,"_21105":119463,"_27705":119464,"_2959":119465},[],"/docs/pr-preview/pr-67/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3475":71322,"_30471":71317,"_5":30820,"_21105":119467,"_27705":119468,"_2959":119469},[],"/docs/pr-preview/pr-67/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3475":71323,"_30471":71317,"_5":30820,"_21105":119471,"_27705":119472,"_2959":119473},[],"/docs/pr-preview/pr-67/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3475":71324,"_30471":71317,"_21105":119475,"_5":14473,"_27705":71317,"_2959":119476},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3475":71325,"_30471":71317,"_21105":119478,"_5":14473,"_27705":71317,"_2959":119479},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3475":71326,"_30471":71317,"_21105":119481,"_5":14473,"_27705":119456,"_2959":119482},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3475":71327,"_30471":71317,"_21105":119484,"_5":14473,"_27705":119460,"_2959":119485},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3475":71328,"_30471":71317,"_21105":119487,"_5":14473,"_27705":119464,"_2959":119488},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3475":71329,"_30471":71317,"_21105":119490,"_5":14473,"_27705":119468,"_2959":119491},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3475":71330,"_30471":71317,"_21105":119493,"_5":14473,"_27705":119472,"_2959":119494},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3475":71331,"_30471":71331,"_5":14825,"_2959":119496,"_30823":119497,"_21105":119498,"_27705":71331},"Cómo funciona Lamassu",[49595,118538],[],{"_3475":71332,"_30471":71331,"_21105":119500,"_5":14473,"_27705":71331,"_2959":119501},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3475":71333,"_30471":71331,"_5":30820,"_21105":119503,"_27705":119504,"_2959":119505},[],"/docs/pr-preview/pr-67/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3475":71334,"_30471":71331,"_5":30820,"_21105":119507,"_27705":119508,"_2959":119509},[],"/docs/pr-preview/pr-67/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3475":71335,"_30471":71331,"_21105":119511,"_5":14473,"_27705":71331,"_2959":119512},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3475":71336,"_30471":71331,"_21105":119514,"_5":14473,"_27705":119504,"_2959":119515},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3475":71337,"_30471":71331,"_21105":119517,"_5":14473,"_27705":119504,"_2959":119518},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3475":71338,"_30471":71331,"_21105":119520,"_5":14473,"_27705":119504,"_2959":119521},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3475":71339,"_30471":71331,"_21105":119523,"_5":14473,"_27705":119504,"_2959":119524},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3475":71340,"_30471":71331,"_21105":119526,"_5":14473,"_27705":119504,"_2959":119527},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3475":71341,"_30471":71331,"_21105":119529,"_5":14473,"_27705":119508,"_2959":119530},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3475":71342,"_30471":71331,"_21105":119532,"_5":14473,"_27705":119508,"_2959":119533},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3475":71343,"_30471":71331,"_21105":119535,"_5":14473,"_27705":119508,"_2959":119536},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3475":71344,"_30471":71331,"_21105":119538,"_5":14473,"_27705":119508,"_2959":119539},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3475":71345,"_30471":71331,"_21105":119541,"_5":14473,"_27705":119508,"_2959":119542},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3475":71346,"_30471":71331,"_21105":119544,"_5":14473,"_27705":119508,"_2959":119545},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3475":71347,"_30471":71331,"_21105":119547,"_5":14473,"_27705":119508,"_2959":119548},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3475":71348,"_30471":71348,"_5":14825,"_2959":119550,"_30823":119551,"_21105":119552,"_27705":71348},"Dispositivos e identidades",[49595,118538,52084,119550],[],{"_3475":71349,"_30471":71348,"_21105":119554,"_5":14473,"_27705":71348,"_2959":119555},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3475":71350,"_30471":71348,"_5":30820,"_21105":119557,"_27705":119558,"_2959":119559},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3475":71351,"_30471":71348,"_5":30820,"_21105":119561,"_27705":119562,"_2959":119563},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3475":71352,"_30471":71348,"_5":30820,"_21105":119565,"_27705":119566,"_2959":119567},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3475":71353,"_30471":71348,"_5":30820,"_21105":119569,"_27705":119570,"_2959":119571},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3475":71354,"_30471":71348,"_5":30820,"_21105":119573,"_27705":119574,"_2959":119575},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3475":71355,"_30471":71348,"_5":30820,"_21105":119577,"_27705":119578,"_2959":119579},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3475":71356,"_30471":71348,"_5":30820,"_21105":119581,"_27705":119582,"_2959":119583},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3475":71357,"_30471":71348,"_5":30820,"_21105":119585,"_27705":119586,"_2959":119587},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3475":71358,"_30471":71348,"_5":30820,"_21105":119589,"_27705":119590,"_2959":119591},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3475":71359,"_30471":71348,"_5":30820,"_21105":119593,"_27705":119594,"_2959":119595},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3475":71360,"_30471":71348,"_5":30820,"_21105":119597,"_27705":119598,"_2959":119599},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3475":71361,"_30471":71348,"_21105":119601,"_5":14473,"_27705":71348,"_2959":119602},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3475":71362,"_30471":71348,"_21105":119604,"_5":14473,"_27705":71348,"_2959":119605},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3475":71363,"_30471":71348,"_21105":119607,"_5":14473,"_27705":119558,"_2959":119608},[],"Vista operativa",{"_3475":71364,"_30471":71348,"_21105":119610,"_5":14473,"_27705":119558,"_2959":119611},[],"Interpretación",{"_3475":71365,"_30471":71348,"_21105":119613,"_5":14473,"_27705":119558,"_2959":52147},[],{"_3475":71366,"_30471":71348,"_21105":119615,"_5":14473,"_27705":119558,"_2959":119616},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3475":71367,"_30471":71348,"_21105":119618,"_5":14473,"_27705":119558,"_2959":52153},[],{"_3475":71368,"_30471":71348,"_21105":119620,"_5":14473,"_27705":119558,"_2959":119621},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3475":71369,"_30471":71348,"_21105":119623,"_5":14473,"_27705":119558,"_2959":52159},[],{"_3475":71370,"_30471":71348,"_21105":119625,"_5":14473,"_27705":119558,"_2959":119626},[],"La identidad está en la ventana operativa de renovación.",{"_3475":71371,"_30471":71348,"_21105":119628,"_5":14473,"_27705":119558,"_2959":52165},[],{"_3475":71372,"_30471":71348,"_21105":119630,"_5":14473,"_27705":119558,"_2959":119631},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3475":71373,"_30471":71348,"_21105":119633,"_5":14473,"_27705":119558,"_2959":52171},[],{"_3475":71374,"_30471":71348,"_21105":119635,"_5":14473,"_27705":119558,"_2959":119636},[],"La identidad ha vencido.",{"_3475":71375,"_30471":71348,"_21105":119638,"_5":14473,"_27705":119558,"_2959":52177},[],{"_3475":71376,"_30471":71348,"_21105":119640,"_5":14473,"_27705":119558,"_2959":119641},[],"La identidad está marcada como revocada.",{"_3475":71377,"_30471":71348,"_21105":119643,"_5":14473,"_27705":119558,"_2959":52183},[],{"_3475":71378,"_30471":71348,"_21105":119645,"_5":14473,"_27705":119558,"_2959":119646},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3475":71379,"_30471":71348,"_21105":119648,"_5":14473,"_27705":119558,"_2959":119649},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3475":71380,"_30471":71348,"_21105":119651,"_5":14473,"_27705":119562,"_2959":119652},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3475":71381,"_30471":71348,"_21105":119654,"_5":14473,"_27705":119562,"_2959":119655},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3475":71382,"_30471":71348,"_21105":119657,"_5":14473,"_27705":119562,"_2959":119658},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3475":71383,"_30471":71348,"_21105":119660,"_5":14473,"_27705":119562,"_2959":119661},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3475":71384,"_30471":71348,"_21105":119663,"_5":14473,"_27705":119566,"_2959":119664},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3475":71385,"_30471":71348,"_21105":119666,"_5":14473,"_27705":119570,"_2959":119667},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3475":71386,"_30471":71348,"_21105":119669,"_5":14473,"_27705":119574,"_2959":119670},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3475":71387,"_30471":71348,"_21105":119672,"_5":14473,"_27705":119578,"_2959":119673},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3475":71388,"_30471":71348,"_21105":119675,"_5":14473,"_27705":119582,"_2959":119676},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3475":71389,"_30471":71348,"_21105":119678,"_5":14473,"_27705":119582,"_2959":119679},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3475":71390,"_30471":71348,"_21105":119681,"_5":14473,"_27705":119586,"_2959":119682},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3475":71391,"_30471":71348,"_21105":119684,"_5":14473,"_27705":119586,"_2959":119685},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3475":71392,"_30471":71348,"_21105":119687,"_5":14473,"_27705":119586,"_2959":119688},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3475":71393,"_30471":71348,"_21105":119690,"_5":14473,"_27705":119586,"_2959":119691},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3475":71394,"_30471":71348,"_21105":119693,"_5":14473,"_27705":119586,"_2959":119694},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3475":71395,"_30471":71348,"_21105":119696,"_5":14473,"_27705":119586,"_2959":119697},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3475":71396,"_30471":71348,"_21105":119699,"_5":14473,"_27705":119590,"_2959":119700},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3475":71397,"_30471":71348,"_21105":119702,"_5":14473,"_27705":119590,"_2959":119703},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3475":71398,"_30471":71348,"_21105":119705,"_5":14473,"_27705":119594,"_2959":119706},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3475":71399,"_30471":71348,"_21105":119708,"_5":14473,"_27705":119594,"_2959":119709},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3475":71400,"_30471":71348,"_21105":119711,"_5":14473,"_27705":119594,"_2959":119712},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3475":71401,"_30471":71348,"_21105":119714,"_5":14473,"_27705":119594,"_2959":119715},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3475":71402,"_30471":71348,"_21105":119717,"_5":14473,"_27705":119598,"_2959":119718},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3475":71403,"_30471":71348,"_21105":119720,"_5":14473,"_27705":119598,"_2959":119721},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3475":71404,"_30471":71404,"_5":14825,"_2959":119723,"_30823":119724,"_21105":119726,"_27705":71404},"Identidad inicial y autenticación",[49595,118538,52084,119550,119725],"Enrolamiento con PKI",[],{"_3475":71405,"_30471":71404,"_21105":119728,"_5":14473,"_27705":71404,"_2959":119729},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3475":71406,"_30471":71404,"_5":30820,"_21105":119731,"_27705":119732,"_2959":119733},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3475":71407,"_30471":71404,"_5":30820,"_21105":119735,"_27705":119736,"_2959":119737},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3475":71408,"_30471":71404,"_5":30820,"_21105":119739,"_27705":119740,"_2959":119741},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3475":71409,"_30471":71404,"_5":30820,"_21105":119743,"_27705":119744,"_2959":119745},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3475":71410,"_30471":71404,"_5":30820,"_21105":119747,"_27705":119748,"_2959":119749},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3475":71411,"_30471":71404,"_21105":119751,"_5":14473,"_27705":71404,"_2959":119752},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3475":71412,"_30471":71404,"_21105":119754,"_5":14473,"_27705":119732,"_2959":119755},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3475":71413,"_30471":71404,"_21105":119757,"_5":14473,"_27705":119732,"_2959":119758},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3475":71414,"_30471":71404,"_21105":119760,"_5":14473,"_27705":119736,"_2959":119761},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3475":71415,"_30471":71404,"_21105":119763,"_5":14473,"_27705":119736,"_2959":119764},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3475":71416,"_30471":71404,"_21105":119766,"_5":14473,"_27705":119736,"_2959":119767},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3475":71417,"_30471":71404,"_21105":119769,"_5":14473,"_27705":119740,"_2959":119770},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3475":71418,"_30471":71404,"_21105":119772,"_5":14473,"_27705":119740,"_2959":119773},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3475":71419,"_30471":71404,"_21105":119775,"_5":14473,"_27705":119744,"_2959":119776},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3475":71420,"_30471":71404,"_21105":119778,"_5":14473,"_27705":119744,"_2959":119779},[],"Ejemplo de cuerpo:",{"_3475":71421,"_30471":71404,"_21105":119781,"_5":14473,"_27705":119744,"_2959":119782},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3475":71422,"_30471":71404,"_21105":119784,"_5":14473,"_27705":119744,"_2959":119785},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3475":71423,"_30471":71404,"_21105":119787,"_5":14473,"_27705":119744,"_2959":119788},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3475":71424,"_30471":71404,"_21105":119790,"_5":14473,"_27705":119744,"_2959":119791},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3475":71425,"_30471":71404,"_21105":119793,"_5":14473,"_27705":119748,"_2959":119794},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3475":71426,"_30471":71404,"_21105":119796,"_5":14473,"_27705":119748,"_2959":119797},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3475":71427,"_30471":71427,"_5":14825,"_2959":119799,"_30823":119800,"_21105":119801,"_27705":71427},"Configura y opera el DMS",[49595,118538,52084,119550,119725],[],{"_3475":71428,"_30471":71427,"_21105":119803,"_5":14473,"_27705":71427,"_2959":119804},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3475":71429,"_30471":71427,"_5":30820,"_21105":119806,"_27705":119807,"_2959":117109},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3475":71430,"_30471":71427,"_5":30820,"_21105":119809,"_27705":119810,"_2959":119811},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3475":71431,"_30471":71427,"_5":30820,"_21105":119813,"_27705":119814,"_2959":119815},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3475":71432,"_30471":71427,"_5":30820,"_21105":119817,"_27705":119818,"_2959":119819},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3475":71433,"_30471":71427,"_5":30820,"_21105":119821,"_27705":119822,"_2959":119823},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3475":71434,"_30471":71427,"_5":30820,"_21105":119825,"_27705":119826,"_2959":119827},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3475":71435,"_30471":71427,"_5":30820,"_21105":119829,"_27705":119830,"_2959":119831},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3475":71436,"_30471":71427,"_5":30820,"_21105":119833,"_27705":119834,"_2959":119835},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3475":71437,"_30471":71427,"_5":30820,"_21105":119837,"_27705":119838,"_2959":52379},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3475":71438,"_30471":71427,"_5":30820,"_21105":119840,"_27705":119841,"_2959":52383},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3475":71439,"_30471":71427,"_5":30820,"_21105":119843,"_27705":119844,"_2959":119845},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3475":71440,"_30471":71427,"_5":30820,"_21105":119847,"_27705":119848,"_2959":119849},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3475":71441,"_30471":71427,"_5":30820,"_21105":119851,"_27705":119852,"_2959":119853},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3475":71442,"_30471":71427,"_5":30820,"_21105":119855,"_27705":119856,"_2959":119857},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3475":71443,"_30471":71427,"_5":30820,"_21105":119859,"_27705":119860,"_2959":52403},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3475":71444,"_30471":71427,"_5":30820,"_21105":119862,"_27705":119863,"_2959":119864},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3475":71445,"_30471":71427,"_5":30820,"_21105":119866,"_27705":119867,"_2959":119868},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3475":71446,"_30471":71427,"_5":30820,"_21105":119870,"_27705":119871,"_2959":119872},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3475":71447,"_30471":71427,"_21105":119874,"_5":14473,"_27705":71427,"_2959":119875},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3475":71448,"_30471":71427,"_21105":119877,"_5":14473,"_27705":119807,"_2959":119878},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3475":71449,"_30471":71427,"_21105":119880,"_5":14473,"_27705":119807,"_2959":119881},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3475":71450,"_30471":71427,"_21105":119883,"_5":14473,"_27705":119814,"_2959":119884},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3475":71451,"_30471":71427,"_21105":119886,"_5":14473,"_27705":119818,"_2959":119887},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3475":71452,"_30471":71427,"_21105":119889,"_5":14473,"_27705":119822,"_2959":119890},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3475":71453,"_30471":71427,"_21105":119892,"_5":14473,"_27705":119826,"_2959":119893},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3475":71454,"_30471":71427,"_21105":119895,"_5":14473,"_27705":119830,"_2959":119896},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3475":71455,"_30471":71427,"_21105":119898,"_5":14473,"_27705":119838,"_2959":119899},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3475":71456,"_30471":71427,"_21105":119901,"_5":14473,"_27705":119838,"_2959":119902},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3475":71457,"_30471":71427,"_21105":119904,"_5":14473,"_27705":119841,"_2959":119905},[],"Campo de `settings.enrollment_settings`",{"_3475":71458,"_30471":71427,"_21105":119907,"_5":14473,"_27705":119841,"_2959":119908},[],"Decisión",{"_3475":71459,"_30471":71427,"_21105":119910,"_5":14473,"_27705":119841,"_2959":52454},[],{"_3475":71460,"_30471":71427,"_21105":119912,"_5":14473,"_27705":119841,"_2959":119913},[],"`EST_RFC7030` para estas operaciones.",{"_3475":71461,"_30471":71427,"_21105":119915,"_5":14473,"_27705":119841,"_2959":52460},[],{"_3475":71462,"_30471":71427,"_21105":119917,"_5":14473,"_27705":119841,"_2959":119918},[],"ID de la CA que firmará.",{"_3475":71463,"_30471":71427,"_21105":119920,"_5":14473,"_27705":119841,"_2959":52466},[],{"_3475":71464,"_30471":71427,"_21105":119922,"_5":14473,"_27705":119841,"_2959":119923},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3475":71465,"_30471":71427,"_21105":119925,"_5":14473,"_27705":119841,"_2959":52472},[],{"_3475":71466,"_30471":71427,"_21105":119927,"_5":14473,"_27705":119841,"_2959":119928},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3475":71467,"_30471":71427,"_21105":119930,"_5":14473,"_27705":119841,"_2959":52478},[],{"_3475":71468,"_30471":71427,"_21105":119932,"_5":14473,"_27705":119841,"_2959":119933},[],"Uno de los cuatro modos de autenticación.",{"_3475":71469,"_30471":71427,"_21105":119935,"_5":14473,"_27705":119841,"_2959":119936},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3475":71470,"_30471":71427,"_21105":119938,"_5":14473,"_27705":119844,"_2959":119939},[],"Los bloques son independientes:",{"_3475":71471,"_30471":71427,"_21105":119941,"_5":14473,"_27705":119844,"_2959":119942},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3475":71472,"_30471":71427,"_21105":119944,"_5":14473,"_27705":119844,"_2959":119945},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3475":71473,"_30471":71427,"_21105":119947,"_5":14473,"_27705":119844,"_2959":52496},[],{"_3475":71474,"_30471":71427,"_21105":119949,"_5":14473,"_27705":119844,"_2959":119950},[],"Control aplicado en la operación configurada",{"_3475":71475,"_30471":71427,"_21105":119952,"_5":14473,"_27705":119844,"_2959":52502},[],{"_3475":71476,"_30471":71427,"_21105":119954,"_5":14473,"_27705":119844,"_2959":119955},[],"Validación del certificado presentado.",{"_3475":71477,"_30471":71427,"_21105":119957,"_5":14473,"_27705":119844,"_2959":52508},[],{"_3475":71478,"_30471":71427,"_21105":119959,"_5":14473,"_27705":119844,"_2959":119960},[],"Autorización del webhook configurado.",{"_3475":71479,"_30471":71427,"_21105":119962,"_5":14473,"_27705":119844,"_2959":52514},[],{"_3475":71480,"_30471":71427,"_21105":119964,"_5":14473,"_27705":119844,"_2959":119965},[],"Validación del certificado y, después, aprobación del webhook.",{"_3475":71481,"_30471":71427,"_21105":119967,"_5":14473,"_27705":119844,"_2959":52520},[],{"_3475":71482,"_30471":71427,"_21105":119969,"_5":14473,"_27705":119844,"_2959":119970},[],"Sin autenticación del solicitante por el DMS.",{"_3475":71483,"_30471":71427,"_21105":119972,"_5":14473,"_27705":119844,"_2959":119973},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3475":71484,"_30471":71427,"_21105":119975,"_5":14473,"_27705":119844,"_2959":119976},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3475":71485,"_30471":71427,"_21105":119978,"_5":14473,"_27705":119844,"_2959":119979},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3475":71486,"_30471":71427,"_21105":119981,"_5":14473,"_27705":119844,"_2959":119982},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3475":71487,"_30471":71427,"_21105":119984,"_5":14473,"_27705":119848,"_2959":119985},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3475":71488,"_30471":71427,"_21105":119987,"_5":14473,"_27705":119848,"_2959":119988},[],"Campo de `external_webhook_settings`",{"_3475":71489,"_30471":71427,"_21105":119990,"_5":14473,"_27705":119848,"_2959":119908},[],{"_3475":71490,"_30471":71427,"_21105":119992,"_5":14473,"_27705":119848,"_2959":52546},[],{"_3475":71491,"_30471":71427,"_21105":119994,"_5":14473,"_27705":119848,"_2959":119995},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3475":71492,"_30471":71427,"_21105":119997,"_5":14473,"_27705":119848,"_2959":52552},[],{"_3475":71493,"_30471":71427,"_21105":119999,"_5":14473,"_27705":119848,"_2959":120000},[],"`POST` o `PUT`; `POST` por defecto.",{"_3475":71494,"_30471":71427,"_21105":120002,"_5":14473,"_27705":119848,"_2959":52558},[],{"_3475":71495,"_30471":71427,"_21105":120004,"_5":14473,"_27705":119848,"_2959":120005},[],"Etiqueta usada en los logs del servicio.",{"_3475":71496,"_30471":71427,"_21105":120007,"_5":14473,"_27705":119848,"_2959":52564},[],{"_3475":71497,"_30471":71427,"_21105":120009,"_5":14473,"_27705":119848,"_2959":120010},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3475":71498,"_30471":71427,"_21105":120012,"_5":14473,"_27705":119848,"_2959":52570},[],{"_3475":71499,"_30471":71427,"_21105":120014,"_5":14473,"_27705":119848,"_2959":120015},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3475":71500,"_30471":71427,"_21105":120017,"_5":14473,"_27705":119848,"_2959":52576},[],{"_3475":71501,"_30471":71427,"_21105":120019,"_5":14473,"_27705":119848,"_2959":120020},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3475":71502,"_30471":71427,"_21105":120022,"_5":14473,"_27705":119848,"_2959":52582},[],{"_3475":71503,"_30471":71427,"_21105":120024,"_5":14473,"_27705":119848,"_2959":120025},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3475":71504,"_30471":71427,"_21105":120027,"_5":14473,"_27705":119848,"_2959":52588},[],{"_3475":71505,"_30471":71427,"_21105":120029,"_5":14473,"_27705":119848,"_2959":120030},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3475":71506,"_30471":71427,"_21105":120032,"_5":14473,"_27705":119848,"_2959":52594},[],{"_3475":71507,"_30471":71427,"_21105":120034,"_5":14473,"_27705":119848,"_2959":120035},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3475":71508,"_30471":71427,"_21105":120037,"_5":14473,"_27705":119848,"_2959":52600},[],{"_3475":71509,"_30471":71427,"_21105":120039,"_5":14473,"_27705":119848,"_2959":120040},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3475":71510,"_30471":71427,"_21105":120042,"_5":14473,"_27705":119848,"_2959":120043},[],"Reglas de esa configuración:",{"_3475":71511,"_30471":71427,"_21105":120045,"_5":14473,"_27705":119848,"_2959":120046},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3475":71512,"_30471":71427,"_21105":120048,"_5":14473,"_27705":119848,"_2959":120049},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3475":71513,"_30471":71427,"_21105":120051,"_5":14473,"_27705":119848,"_2959":120052},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3475":71514,"_30471":71427,"_21105":120054,"_5":14473,"_27705":119848,"_2959":120055},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3475":71515,"_30471":71427,"_21105":120057,"_5":14473,"_27705":119848,"_2959":120058},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3475":71516,"_30471":71427,"_21105":120060,"_5":14473,"_27705":119848,"_2959":120061},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3475":71517,"_30471":71427,"_21105":120063,"_5":14473,"_27705":119848,"_2959":120064},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3475":71518,"_30471":71427,"_21105":120066,"_5":14473,"_27705":119848,"_2959":120067},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3475":71519,"_30471":71427,"_21105":120069,"_5":14473,"_27705":119848,"_2959":120070},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3475":71520,"_30471":71427,"_21105":120072,"_5":14473,"_27705":119852,"_2959":120073},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3475":71521,"_30471":71427,"_21105":120075,"_5":14473,"_27705":119856,"_2959":120076},[],"Campo de `settings.reenrollment_settings`",{"_3475":71522,"_30471":71427,"_21105":120078,"_5":14473,"_27705":119856,"_2959":120079},[],"Función",{"_3475":71523,"_30471":71427,"_21105":120081,"_5":14473,"_27705":119856,"_2959":52644},[],{"_3475":71524,"_30471":71427,"_21105":120083,"_5":14473,"_27705":119856,"_2959":120084},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3475":71525,"_30471":71427,"_21105":120086,"_5":14473,"_27705":119856,"_2959":52650},[],{"_3475":71526,"_30471":71427,"_21105":120088,"_5":14473,"_27705":119856,"_2959":120089},[],"Umbral operativo preventivo de monitorización.",{"_3475":71527,"_30471":71427,"_21105":120091,"_5":14473,"_27705":119856,"_2959":52656},[],{"_3475":71528,"_30471":71427,"_21105":120093,"_5":14473,"_27705":119856,"_2959":120094},[],"Umbral operativo crítico de monitorización.",{"_3475":71529,"_30471":71427,"_21105":120096,"_5":14473,"_27705":119856,"_2959":52662},[],{"_3475":71530,"_30471":71427,"_21105":120098,"_5":14473,"_27705":119856,"_2959":120099},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3475":71531,"_30471":71427,"_21105":120101,"_5":14473,"_27705":119856,"_2959":52668},[],{"_3475":71532,"_30471":71427,"_21105":120103,"_5":14473,"_27705":119856,"_2959":120104},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3475":71533,"_30471":71427,"_21105":120106,"_5":14473,"_27705":119856,"_2959":52674},[],{"_3475":71534,"_30471":71427,"_21105":120108,"_5":14473,"_27705":119856,"_2959":120109},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3475":71535,"_30471":71427,"_21105":120111,"_5":14473,"_27705":119856,"_2959":120112},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3475":71536,"_30471":71427,"_21105":120114,"_5":14473,"_27705":119860,"_2959":120115},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3475":71537,"_30471":71427,"_21105":120117,"_5":14473,"_27705":119863,"_2959":117473},[],{"_3475":71538,"_30471":71427,"_21105":120119,"_5":14473,"_27705":119863,"_2959":120120},[],"Qué publica",{"_3475":71539,"_30471":71427,"_21105":120122,"_5":14473,"_27705":119863,"_2959":52691},[],{"_3475":71540,"_30471":71427,"_21105":120124,"_5":14473,"_27705":119863,"_2959":120125},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3475":71541,"_30471":71427,"_21105":120127,"_5":14473,"_27705":119863,"_2959":52697},[],{"_3475":71542,"_30471":71427,"_21105":120129,"_5":14473,"_27705":119863,"_2959":120130},[],"Certificado de la CA emisora seleccionada.",{"_3475":71543,"_30471":71427,"_21105":120132,"_5":14473,"_27705":119863,"_2959":52703},[],{"_3475":71544,"_30471":71427,"_21105":120134,"_5":14473,"_27705":119863,"_2959":120135},[],"Certificados de las CAs elegidas explícitamente.",{"_3475":71545,"_30471":71427,"_21105":120137,"_5":14473,"_27705":119863,"_2959":120138},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3475":71546,"_30471":71427,"_21105":120140,"_5":14473,"_27705":119867,"_2959":120141},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3475":71547,"_30471":71427,"_21105":120143,"_5":14473,"_27705":119867,"_2959":120144},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3475":71548,"_30471":71427,"_21105":120146,"_5":14473,"_27705":119867,"_2959":120147},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3475":71549,"_30471":71427,"_21105":120149,"_5":14473,"_27705":119871,"_2959":120150},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3475":71550,"_30471":71550,"_5":14825,"_2959":120152,"_30823":120153,"_21105":120154,"_27705":71550},"Integra el cliente EST",[49595,118538,52084,119550,119725],[],{"_3475":71551,"_30471":71550,"_21105":120156,"_5":14473,"_27705":71550,"_2959":120157},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3475":71552,"_30471":71550,"_5":30820,"_21105":120159,"_27705":120160,"_2959":117109},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3475":71553,"_30471":71550,"_5":30820,"_21105":120162,"_27705":120163,"_2959":120164},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3475":71554,"_30471":71550,"_5":30820,"_21105":120166,"_27705":120167,"_2959":120168},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3475":71555,"_30471":71550,"_5":30820,"_21105":120170,"_27705":120171,"_2959":120172},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3475":71556,"_30471":71550,"_5":30820,"_21105":120174,"_27705":120175,"_2959":120176},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3475":71557,"_30471":71550,"_5":30820,"_21105":120178,"_27705":120179,"_2959":120180},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3475":71558,"_30471":71550,"_21105":120182,"_5":14473,"_27705":71550,"_2959":120183},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3475":71559,"_30471":71550,"_21105":120185,"_5":14473,"_27705":120160,"_2959":120186},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3475":71560,"_30471":71550,"_21105":120188,"_5":14473,"_27705":120160,"_2959":120189},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3475":71561,"_30471":71550,"_21105":120191,"_5":14473,"_27705":120160,"_2959":120192},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3475":71562,"_30471":71550,"_21105":120194,"_5":14473,"_27705":120163,"_2959":120195},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3475":71563,"_30471":71550,"_21105":120197,"_5":14473,"_27705":120163,"_2959":120198},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3475":71564,"_30471":71550,"_21105":120200,"_5":14473,"_27705":120167,"_2959":120201},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3475":71565,"_30471":71550,"_21105":120203,"_5":14473,"_27705":120167,"_2959":120204},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3475":71566,"_30471":71550,"_21105":120206,"_5":14473,"_27705":120171,"_2959":120207},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3475":71567,"_30471":71550,"_21105":120209,"_5":14473,"_27705":120171,"_2959":120210},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3475":71568,"_30471":71550,"_21105":120212,"_5":14473,"_27705":120175,"_2959":120213},[],"Para el caso de una raíz que emite directamente:",{"_3475":71569,"_30471":71550,"_21105":120215,"_5":14473,"_27705":120175,"_2959":120216},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3475":71570,"_30471":71550,"_21105":120218,"_5":14473,"_27705":120175,"_2959":120219},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3475":71571,"_30471":71550,"_21105":120221,"_5":14473,"_27705":120179,"_2959":120222},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3475":71572,"_30471":71572,"_5":14825,"_2959":120224,"_30823":120225,"_21105":120226,"_27705":71572},"Referencia EST",[49595,118538,52084,119550,119725],[],{"_3475":71573,"_30471":71572,"_21105":120228,"_5":14473,"_27705":71572,"_2959":120229},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3475":71574,"_30471":71572,"_5":30820,"_21105":120231,"_27705":120232,"_2959":120233},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3475":71575,"_30471":71572,"_5":30820,"_21105":120235,"_27705":120236,"_2959":22871},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3475":71576,"_30471":71572,"_5":30820,"_21105":120238,"_27705":120239,"_2959":26294},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3475":71577,"_30471":71572,"_5":30820,"_21105":120241,"_27705":120242,"_2959":26301},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3475":71578,"_30471":71572,"_5":30820,"_21105":120244,"_27705":120245,"_2959":25603},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3475":71579,"_30471":71572,"_5":30820,"_21105":120247,"_27705":120248,"_2959":120249},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3475":71580,"_30471":71572,"_5":30820,"_21105":120251,"_27705":120252,"_2959":120253},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3475":71581,"_30471":71572,"_5":30820,"_21105":120255,"_27705":120256,"_2959":120257},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3475":71582,"_30471":71572,"_21105":120259,"_5":14473,"_27705":71572,"_2959":120260},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3475":71583,"_30471":71572,"_21105":120262,"_5":14473,"_27705":120232,"_2959":120263},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3475":71584,"_30471":71572,"_21105":120265,"_5":14473,"_27705":120232,"_2959":118298},[],{"_3475":71585,"_30471":71572,"_21105":120267,"_5":14473,"_27705":120232,"_2959":120268},[],"Método",{"_3475":71586,"_30471":71572,"_21105":120270,"_5":14473,"_27705":120232,"_2959":120271},[],"Autenticación y condición",{"_3475":71587,"_30471":71572,"_21105":120273,"_5":14473,"_27705":120232,"_2959":52846},[],{"_3475":71588,"_30471":71572,"_21105":120275,"_5":14473,"_27705":120232,"_2959":52849},[],{"_3475":71589,"_30471":71572,"_21105":120277,"_5":14473,"_27705":120232,"_2959":120278},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3475":71590,"_30471":71572,"_21105":120280,"_5":14473,"_27705":120232,"_2959":52855},[],{"_3475":71591,"_30471":71572,"_21105":120282,"_5":14473,"_27705":120232,"_2959":52858},[],{"_3475":71592,"_30471":71572,"_21105":120284,"_5":14473,"_27705":120232,"_2959":120285},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3475":71593,"_30471":71572,"_21105":120287,"_5":14473,"_27705":120232,"_2959":52864},[],{"_3475":71594,"_30471":71572,"_21105":120289,"_5":14473,"_27705":120232,"_2959":52858},[],{"_3475":71595,"_30471":71572,"_21105":120291,"_5":14473,"_27705":120232,"_2959":120292},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3475":71596,"_30471":71572,"_21105":120294,"_5":14473,"_27705":120232,"_2959":52872},[],{"_3475":71597,"_30471":71572,"_21105":120296,"_5":14473,"_27705":120232,"_2959":52858},[],{"_3475":71598,"_30471":71572,"_21105":120298,"_5":14473,"_27705":120232,"_2959":120299},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3475":71599,"_30471":71572,"_21105":120301,"_5":14473,"_27705":120232,"_2959":120302},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3475":71600,"_30471":71572,"_21105":120304,"_5":14473,"_27705":120236,"_2959":120305},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3475":71601,"_30471":71572,"_21105":120307,"_5":14473,"_27705":120236,"_2959":120308},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3475":71602,"_30471":71572,"_21105":120310,"_5":14473,"_27705":120239,"_2959":120311},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3475":71603,"_30471":71572,"_21105":120313,"_5":14473,"_27705":120239,"_2959":120314},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3475":71604,"_30471":71572,"_21105":120316,"_5":14473,"_27705":120242,"_2959":120317},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3475":71605,"_30471":71572,"_21105":120319,"_5":14473,"_27705":120242,"_2959":120320},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3475":71606,"_30471":71572,"_21105":120322,"_5":14473,"_27705":120245,"_2959":120323},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3475":71607,"_30471":71572,"_21105":120325,"_5":14473,"_27705":120245,"_2959":120326},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3475":71608,"_30471":71572,"_21105":120328,"_5":14473,"_27705":120248,"_2959":120329},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3475":71609,"_30471":71572,"_21105":120331,"_5":14473,"_27705":120248,"_2959":120332},[],"Parte",{"_3475":71610,"_30471":71572,"_21105":120334,"_5":14473,"_27705":120248,"_2959":120335},[],"Contenido tras decodificar su Base64",{"_3475":71611,"_30471":71572,"_21105":120337,"_5":14473,"_27705":120248,"_2959":52916},[],{"_3475":71612,"_30471":71572,"_21105":120339,"_5":14473,"_27705":120248,"_2959":120340},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3475":71613,"_30471":71572,"_21105":120342,"_5":14473,"_27705":120248,"_2959":52922},[],{"_3475":71614,"_30471":71572,"_21105":120344,"_5":14473,"_27705":120248,"_2959":120345},[],"PKCS#7 DER con el certificado emitido.",{"_3475":71615,"_30471":71572,"_21105":120347,"_5":14473,"_27705":120248,"_2959":120348},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3475":71616,"_30471":71572,"_21105":120350,"_5":14473,"_27705":120252,"_2959":120351},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3475":71617,"_30471":71572,"_21105":120353,"_5":14473,"_27705":120252,"_2959":120354},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3475":71618,"_30471":71572,"_21105":120356,"_5":14473,"_27705":120252,"_2959":120357},[],"Convierte y comprueba el resultado:",{"_3475":71619,"_30471":71572,"_21105":120359,"_5":14473,"_27705":120252,"_2959":120360},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3475":71620,"_30471":71572,"_21105":120362,"_5":14473,"_27705":120256,"_2959":120363},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3475":71621,"_30471":71572,"_21105":120365,"_5":14473,"_27705":120256,"_2959":120366},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3475":71622,"_30471":71622,"_5":14825,"_2959":119725,"_30823":120368,"_21105":120369,"_27705":71622},[49595,118538,52084,119550,119725],[],{"_3475":71623,"_30471":71622,"_21105":120371,"_5":14473,"_27705":71622,"_2959":120372},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3475":71624,"_30471":71622,"_5":30820,"_21105":120374,"_27705":120375,"_2959":120376},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3475":71625,"_30471":71622,"_5":30820,"_21105":120378,"_27705":120379,"_2959":120380},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3475":71626,"_30471":71622,"_5":30820,"_21105":120382,"_27705":120383,"_2959":120384},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3475":71627,"_30471":71622,"_5":30820,"_21105":120386,"_27705":120387,"_2959":120388},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3475":71628,"_30471":71622,"_21105":120390,"_5":14473,"_27705":71622,"_2959":120391},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3475":71629,"_30471":71622,"_21105":120393,"_5":14473,"_27705":120375,"_2959":120394},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3475":71630,"_30471":71622,"_21105":120396,"_5":14473,"_27705":120375,"_2959":120397},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3475":71631,"_30471":71622,"_21105":120399,"_5":14473,"_27705":120375,"_2959":120400},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3475":71632,"_30471":71622,"_21105":120402,"_5":14473,"_27705":120375,"_2959":120403},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3475":71633,"_30471":71622,"_21105":120405,"_5":14473,"_27705":120375,"_2959":120406},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3475":71634,"_30471":71622,"_21105":120408,"_5":14473,"_27705":120375,"_2959":120409},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3475":71635,"_30471":71622,"_21105":120411,"_5":14473,"_27705":120379,"_2959":120412},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3475":71636,"_30471":71622,"_21105":120414,"_5":14473,"_27705":120379,"_2959":120415},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":71637,"_30471":71622,"_21105":120417,"_5":14473,"_27705":120379,"_2959":120418},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3475":71638,"_30471":71622,"_21105":120420,"_5":14473,"_27705":120379,"_2959":120421},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3475":71639,"_30471":71622,"_21105":120423,"_5":14473,"_27705":120383,"_2959":120424},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3475":71640,"_30471":71622,"_21105":120426,"_5":14473,"_27705":120383,"_2959":120427},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3475":71641,"_30471":71622,"_21105":120429,"_5":14473,"_27705":120383,"_2959":120430},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3475":71642,"_30471":71622,"_21105":120432,"_5":14473,"_27705":120383,"_2959":120433},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3475":71643,"_30471":71622,"_21105":120435,"_5":14473,"_27705":120387,"_2959":120436},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3475":71644,"_30471":71622,"_21105":120438,"_5":14473,"_27705":120387,"_2959":120439},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3475":71645,"_30471":71645,"_5":14825,"_2959":120441,"_30823":120442,"_21105":120443,"_27705":71645},"Estrategias de aprovisionamiento",[49595,118538,52084,119550,119725],[],{"_3475":71646,"_30471":71645,"_21105":120445,"_5":14473,"_27705":71645,"_2959":120446},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3475":71647,"_30471":71645,"_5":30820,"_21105":120448,"_27705":120449,"_2959":120450},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3475":71648,"_30471":71645,"_5":30820,"_21105":120452,"_27705":120453,"_2959":120454},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3475":71649,"_30471":71645,"_5":30820,"_21105":120456,"_27705":120457,"_2959":120458},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3475":71650,"_30471":71645,"_5":30820,"_21105":120460,"_27705":120461,"_2959":120462},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3475":71651,"_30471":71645,"_5":30820,"_21105":120464,"_27705":120465,"_2959":120466},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3475":71652,"_30471":71645,"_21105":120468,"_5":14473,"_27705":71645,"_2959":120469},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3475":71653,"_30471":71645,"_21105":120471,"_5":14473,"_27705":120449,"_2959":120472},[],"Recorrido",{"_3475":71654,"_30471":71645,"_21105":120474,"_5":14473,"_27705":120449,"_2959":120475},[],"Cuándo existe el dispositivo",{"_3475":71655,"_30471":71645,"_21105":120477,"_5":14473,"_27705":120449,"_2959":120478},[],"Qué compruebas",{"_3475":71656,"_30471":71645,"_21105":120480,"_5":14473,"_27705":120449,"_2959":120481},[],"Asignación manual",{"_3475":71657,"_30471":71645,"_21105":120483,"_5":14473,"_27705":120449,"_2959":120484},[],"El operador lo crea antes de asociar un certificado.",{"_3475":71658,"_30471":71645,"_21105":120486,"_5":14473,"_27705":120449,"_2959":120487},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3475":71659,"_30471":71645,"_21105":120489,"_5":14473,"_27705":120449,"_2959":120490},[],"EST con `JITP`",{"_3475":71660,"_30471":71645,"_21105":120492,"_5":14473,"_27705":120449,"_2959":120493},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3475":71661,"_30471":71645,"_21105":120495,"_5":14473,"_27705":120449,"_2959":120496},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3475":71662,"_30471":71645,"_21105":120498,"_5":14473,"_27705":120449,"_2959":120499},[],"EST con `PRE_REGISTRATION`",{"_3475":71663,"_30471":71645,"_21105":120501,"_5":14473,"_27705":120449,"_2959":120502},[],"Debe existir antes de `/simpleenroll`.",{"_3475":71664,"_30471":71645,"_21105":120504,"_5":14473,"_27705":120449,"_2959":120505},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3475":71665,"_30471":71645,"_21105":120507,"_5":14473,"_27705":120449,"_2959":120508},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3475":71666,"_30471":71645,"_21105":120510,"_5":14473,"_27705":120449,"_2959":120511},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3475":71667,"_30471":71645,"_21105":120513,"_5":14473,"_27705":120453,"_2959":120514},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3475":71668,"_30471":71645,"_21105":120516,"_5":14473,"_27705":120453,"_2959":120517},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3475":71669,"_30471":71645,"_21105":120519,"_5":14473,"_27705":120453,"_2959":120520},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3475":71670,"_30471":71645,"_21105":120522,"_5":14473,"_27705":120457,"_2959":120523},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3475":71671,"_30471":71645,"_21105":120525,"_5":14473,"_27705":120457,"_2959":120526},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3475":71672,"_30471":71645,"_21105":120528,"_5":14473,"_27705":120457,"_2959":120529},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3475":71673,"_30471":71645,"_21105":120531,"_5":14473,"_27705":120457,"_2959":120532},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3475":71674,"_30471":71645,"_21105":120534,"_5":14473,"_27705":120457,"_2959":120535},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3475":71675,"_30471":71645,"_21105":120537,"_5":14473,"_27705":120457,"_2959":120538},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3475":71676,"_30471":71645,"_21105":120540,"_5":14473,"_27705":120461,"_2959":117473},[],{"_3475":71677,"_30471":71645,"_21105":120542,"_5":14473,"_27705":120461,"_2959":120543},[],"Material que atraviesa EST",{"_3475":71678,"_30471":71645,"_21105":120545,"_5":14473,"_27705":120461,"_2959":120546},[],"Clave generada por el dispositivo",{"_3475":71679,"_30471":71645,"_21105":120548,"_5":14473,"_27705":120461,"_2959":120549},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3475":71680,"_30471":71645,"_21105":120551,"_5":14473,"_27705":120461,"_2959":120552},[],"Clave ya disponible en el dispositivo",{"_3475":71681,"_30471":71645,"_21105":120554,"_5":14473,"_27705":120461,"_2959":120555},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3475":71682,"_30471":71645,"_21105":120557,"_5":14473,"_27705":120461,"_2959":52403},[],{"_3475":71683,"_30471":71645,"_21105":120559,"_5":14473,"_27705":120461,"_2959":120560},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3475":71684,"_30471":71645,"_21105":120562,"_5":14473,"_27705":120461,"_2959":120563},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3475":71685,"_30471":71645,"_21105":120565,"_5":14473,"_27705":120465,"_2959":120566},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3475":71686,"_30471":71686,"_5":14825,"_2959":120568,"_30823":120569,"_21105":120570,"_27705":71686},"Renovación y recuperación",[49595,118538,52084,119550,119725],[],{"_3475":71687,"_30471":71686,"_21105":120572,"_5":14473,"_27705":71686,"_2959":120573},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3475":71688,"_30471":71686,"_5":30820,"_21105":120575,"_27705":120576,"_2959":120577},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3475":71689,"_30471":71686,"_5":30820,"_21105":120579,"_27705":120580,"_2959":120581},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3475":71690,"_30471":71686,"_5":30820,"_21105":120583,"_27705":120584,"_2959":120585},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3475":71691,"_30471":71686,"_5":30820,"_21105":120587,"_27705":120588,"_2959":120589},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3475":71692,"_30471":71686,"_5":30820,"_21105":120591,"_27705":120592,"_2959":120593},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3475":71693,"_30471":71686,"_21105":120595,"_5":14473,"_27705":71686,"_2959":120596},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3475":71694,"_30471":71686,"_21105":120598,"_5":14473,"_27705":120576,"_2959":120599},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3475":71695,"_30471":71686,"_21105":120601,"_5":14473,"_27705":120576,"_2959":120602},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3475":71696,"_30471":71686,"_21105":120604,"_5":14473,"_27705":120576,"_2959":120605},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3475":71697,"_30471":71686,"_21105":120607,"_5":14473,"_27705":120576,"_2959":120608},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3475":71698,"_30471":71686,"_21105":120610,"_5":14473,"_27705":120580,"_2959":120611},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3475":71699,"_30471":71686,"_21105":120613,"_5":14473,"_27705":120580,"_2959":120614},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3475":71700,"_30471":71686,"_21105":120616,"_5":14473,"_27705":120584,"_2959":120617},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3475":71701,"_30471":71686,"_21105":120619,"_5":14473,"_27705":120584,"_2959":120620},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3475":71702,"_30471":71686,"_21105":120622,"_5":14473,"_27705":120584,"_2959":120623},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3475":71703,"_30471":71686,"_21105":120625,"_5":14473,"_27705":120588,"_2959":120626},[],"Situación",{"_3475":71704,"_30471":71686,"_21105":120628,"_5":14473,"_27705":120588,"_2959":120629},[],"Procedimiento",{"_3475":71705,"_30471":71686,"_21105":120631,"_5":14473,"_27705":120588,"_2959":120632},[],"Certificado vigente, fuera de ventana",{"_3475":71706,"_30471":71686,"_21105":120634,"_5":14473,"_27705":120588,"_2959":120635},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3475":71707,"_30471":71686,"_21105":120637,"_5":14473,"_27705":120588,"_2959":120638},[],"Certificado vencido, clave disponible",{"_3475":71708,"_30471":71686,"_21105":120640,"_5":14473,"_27705":120588,"_2959":120641},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3475":71709,"_30471":71686,"_21105":120643,"_5":14473,"_27705":120588,"_2959":120644},[],"Renovación por webhook o `NO_AUTH`",{"_3475":71710,"_30471":71686,"_21105":120646,"_5":14473,"_27705":120588,"_2959":120647},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3475":71711,"_30471":71686,"_21105":120649,"_5":14473,"_27705":120588,"_2959":120650},[],"Clave perdida o inaccesible",{"_3475":71712,"_30471":71686,"_21105":120652,"_5":14473,"_27705":120588,"_2959":120653},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3475":71713,"_30471":71686,"_21105":120655,"_5":14473,"_27705":120588,"_2959":120656},[],"Identidad actual revocada",{"_3475":71714,"_30471":71686,"_21105":120658,"_5":14473,"_27705":120588,"_2959":120659},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3475":71715,"_30471":71686,"_21105":120661,"_5":14473,"_27705":120588,"_2959":120662},[],"Dispositivo sin identidad",{"_3475":71716,"_30471":71686,"_21105":120664,"_5":14473,"_27705":120588,"_2959":120665},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3475":71717,"_30471":71686,"_21105":120667,"_5":14473,"_27705":120588,"_2959":120668},[],"Dispositivo retirado",{"_3475":71718,"_30471":71686,"_21105":120670,"_5":14473,"_27705":120588,"_2959":120671},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3475":71719,"_30471":71686,"_21105":120673,"_5":14473,"_27705":120588,"_2959":120674},[],"Timeout, HTTP 500 o fallo de instalación",{"_3475":71720,"_30471":71686,"_21105":120676,"_5":14473,"_27705":120588,"_2959":120677},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3475":71721,"_30471":71686,"_21105":120679,"_5":14473,"_27705":120592,"_2959":120680},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3475":71722,"_30471":71686,"_21105":120682,"_5":14473,"_27705":120592,"_2959":120683},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3475":71723,"_30471":71723,"_5":14825,"_2959":120685,"_30823":120686,"_21105":120687,"_27705":71723},"Diagnóstico de enrolamiento",[49595,118538,52084,119550,119725],[],{"_3475":71724,"_30471":71723,"_21105":120689,"_5":14473,"_27705":71723,"_2959":120690},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3475":71725,"_30471":71723,"_5":30820,"_21105":120692,"_27705":120693,"_2959":120694},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3475":71726,"_30471":71723,"_5":30820,"_21105":120696,"_27705":120697,"_2959":120698},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3475":71727,"_30471":71723,"_5":30820,"_21105":120700,"_27705":120701,"_2959":120257},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3475":71728,"_30471":71723,"_5":30820,"_21105":120703,"_27705":120704,"_2959":120705},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3475":71729,"_30471":71723,"_21105":120707,"_5":14473,"_27705":71723,"_2959":120708},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3475":71730,"_30471":71723,"_21105":120710,"_5":14473,"_27705":120697,"_2959":120711},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3475":71731,"_30471":71723,"_21105":120713,"_5":14473,"_27705":120697,"_2959":120714},[],"Síntoma o mensaje",{"_3475":71732,"_30471":71723,"_21105":120716,"_5":14473,"_27705":120697,"_2959":120717},[],"Qué revisar",{"_3475":71733,"_30471":71723,"_21105":120719,"_5":14473,"_27705":120697,"_2959":120720},[],"curl rechaza TLS, nombre o emisor",{"_3475":71734,"_30471":71723,"_21105":120722,"_5":14473,"_27705":120697,"_2959":120723},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3475":71735,"_30471":71723,"_21105":120725,"_5":14473,"_27705":120697,"_2959":120726},[],"404 o APS ausente",{"_3475":71736,"_30471":71723,"_21105":120728,"_5":14473,"_27705":120697,"_2959":120729},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3475":71737,"_30471":71723,"_21105":120731,"_5":14473,"_27705":120697,"_2959":120732},[],"400, error de CSR o formato",{"_3475":71738,"_30471":71723,"_21105":120734,"_5":14473,"_27705":120697,"_2959":120735},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3475":71739,"_30471":71723,"_21105":120737,"_5":14473,"_27705":120697,"_2959":120738},[],"Credencial ausente o certificado no válido",{"_3475":71740,"_30471":71723,"_21105":120740,"_5":14473,"_27705":120697,"_2959":120741},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3475":71741,"_30471":71723,"_21105":120743,"_5":14473,"_27705":120697,"_2959":120744},[],"Webhook deniega, expira o responde sin autorización",{"_3475":71742,"_30471":71723,"_21105":120746,"_5":14473,"_27705":120697,"_2959":120747},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3475":71743,"_30471":71723,"_21105":120749,"_5":14473,"_27705":120697,"_2959":53329},[],{"_3475":71744,"_30471":71723,"_21105":120751,"_5":14473,"_27705":120697,"_2959":120752},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3475":71745,"_30471":71723,"_21105":120754,"_5":14473,"_27705":120697,"_2959":53335},[],{"_3475":71746,"_30471":71723,"_21105":120756,"_5":14473,"_27705":120697,"_2959":120757},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3475":71747,"_30471":71723,"_21105":120759,"_5":14473,"_27705":120697,"_2959":53341},[],{"_3475":71748,"_30471":71723,"_21105":120761,"_5":14473,"_27705":120697,"_2959":120762},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3475":71749,"_30471":71723,"_21105":120764,"_5":14473,"_27705":120697,"_2959":53347},[],{"_3475":71750,"_30471":71723,"_21105":120766,"_5":14473,"_27705":120697,"_2959":120767},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3475":71751,"_30471":71723,"_21105":120769,"_5":14473,"_27705":120697,"_2959":53353},[],{"_3475":71752,"_30471":71723,"_21105":120771,"_5":14473,"_27705":120697,"_2959":120772},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3475":71753,"_30471":71723,"_21105":120774,"_5":14473,"_27705":120697,"_2959":120775},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3475":71754,"_30471":71723,"_21105":120777,"_5":14473,"_27705":120697,"_2959":120778},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3475":71755,"_30471":71723,"_21105":120780,"_5":14473,"_27705":120697,"_2959":120781},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3475":71756,"_30471":71723,"_21105":120783,"_5":14473,"_27705":120697,"_2959":120784},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3475":71757,"_30471":71723,"_21105":120786,"_5":14473,"_27705":120697,"_2959":53371},[],{"_3475":71758,"_30471":71723,"_21105":120788,"_5":14473,"_27705":120697,"_2959":120789},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3475":71759,"_30471":71723,"_21105":120791,"_5":14473,"_27705":120697,"_2959":53377},[],{"_3475":71760,"_30471":71723,"_21105":120793,"_5":14473,"_27705":120697,"_2959":120794},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3475":71761,"_30471":71723,"_21105":120796,"_5":14473,"_27705":120697,"_2959":120797},[],"DMS propietario distinto",{"_3475":71762,"_30471":71723,"_21105":120799,"_5":14473,"_27705":120697,"_2959":120800},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3475":71763,"_30471":71723,"_21105":120802,"_5":14473,"_27705":120697,"_2959":53389},[],{"_3475":71764,"_30471":71723,"_21105":120804,"_5":14473,"_27705":120697,"_2959":120805},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3475":71765,"_30471":71723,"_21105":120807,"_5":14473,"_27705":120697,"_2959":53395},[],{"_3475":71766,"_30471":71723,"_21105":120809,"_5":14473,"_27705":120697,"_2959":120810},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3475":71767,"_30471":71723,"_21105":120812,"_5":14473,"_27705":120697,"_2959":120813},[],"Certificado actual revocado",{"_3475":71768,"_30471":71723,"_21105":120815,"_5":14473,"_27705":120697,"_2959":120816},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3475":71769,"_30471":71723,"_21105":120818,"_5":14473,"_27705":120697,"_2959":120819},[],"Error de CA, perfil o firma",{"_3475":71770,"_30471":71723,"_21105":120821,"_5":14473,"_27705":120697,"_2959":120822},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3475":71771,"_30471":71723,"_21105":120824,"_5":14473,"_27705":120697,"_2959":120825},[],"HTTP 200 sin conexión del dispositivo",{"_3475":71772,"_30471":71723,"_21105":120827,"_5":14473,"_27705":120697,"_2959":120828},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3475":71773,"_30471":71723,"_21105":120830,"_5":14473,"_27705":120697,"_2959":120831},[],"Timeout o error después de emitir",{"_3475":71774,"_30471":71723,"_21105":120833,"_5":14473,"_27705":120697,"_2959":120834},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3475":71775,"_30471":71723,"_21105":120836,"_5":14473,"_27705":120701,"_2959":120837},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3475":71776,"_30471":71723,"_21105":120839,"_5":14473,"_27705":120701,"_2959":120840},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3475":71777,"_30471":71723,"_21105":120842,"_5":14473,"_27705":120704,"_2959":120843},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3475":71778,"_30471":71723,"_21105":120845,"_5":14473,"_27705":120704,"_2959":120846},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3475":71779,"_30471":71723,"_21105":120848,"_5":14473,"_27705":120704,"_2959":120849},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3475":71780,"_30471":71723,"_21105":120851,"_5":14473,"_27705":120704,"_2959":120852},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3475":71781,"_30471":71723,"_21105":120854,"_5":14473,"_27705":120704,"_2959":120855},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3475":71782,"_30471":71723,"_21105":120857,"_5":14473,"_27705":120704,"_2959":120858},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3475":71783,"_30471":71723,"_21105":120860,"_5":14473,"_27705":120704,"_2959":120861},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3475":71784,"_30471":71784,"_5":14825,"_2959":120863,"_30823":120864,"_21105":120865,"_27705":71784},"Distribución y actualización de confianza",[49595,118538,52084,119550,119725],[],{"_3475":71785,"_30471":71784,"_21105":120867,"_5":14473,"_27705":71784,"_2959":120868},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3475":71786,"_30471":71784,"_5":30820,"_21105":120870,"_27705":120871,"_2959":120872},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3475":71787,"_30471":71784,"_5":30820,"_21105":120874,"_27705":120875,"_2959":120876},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3475":71788,"_30471":71784,"_5":30820,"_21105":120878,"_27705":120879,"_2959":120880},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3475":71789,"_30471":71784,"_5":30820,"_21105":120882,"_27705":120883,"_2959":120884},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3475":71790,"_30471":71784,"_5":30820,"_21105":120886,"_27705":120887,"_2959":120888},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3475":71791,"_30471":71784,"_21105":120890,"_5":14473,"_27705":71784,"_2959":120891},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3475":71792,"_30471":71784,"_21105":120893,"_5":14473,"_27705":120871,"_2959":120894},[],"Relación",{"_3475":71793,"_30471":71784,"_21105":120896,"_5":14473,"_27705":120871,"_2959":120897},[],"Material que prepara el responsable",{"_3475":71794,"_30471":71784,"_21105":120899,"_5":14473,"_27705":120871,"_2959":120900},[],"Dispositivo → servidor EST",{"_3475":71795,"_30471":71784,"_21105":120902,"_5":14473,"_27705":120871,"_2959":120903},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3475":71796,"_30471":71784,"_21105":120905,"_5":14473,"_27705":120871,"_2959":120906},[],"DMS → solicitante",{"_3475":71797,"_30471":71784,"_21105":120908,"_5":14473,"_27705":120871,"_2959":120909},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3475":71798,"_30471":71784,"_21105":120911,"_5":14473,"_27705":120871,"_2959":120912},[],"Consumidor → dispositivo",{"_3475":71799,"_30471":71784,"_21105":120914,"_5":14473,"_27705":120871,"_2959":120915},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3475":71800,"_30471":71784,"_21105":120917,"_5":14473,"_27705":120871,"_2959":120918},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3475":71801,"_30471":71784,"_21105":120920,"_5":14473,"_27705":120875,"_2959":120921},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3475":71802,"_30471":71784,"_21105":120923,"_5":14473,"_27705":120875,"_2959":120924},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3475":71803,"_30471":71784,"_21105":120926,"_5":14473,"_27705":120879,"_2959":120927},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3475":71804,"_30471":71784,"_21105":120929,"_5":14473,"_27705":120879,"_2959":120930},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3475":71805,"_30471":71784,"_21105":120932,"_5":14473,"_27705":120879,"_2959":120933},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3475":71806,"_30471":71784,"_21105":120935,"_5":14473,"_27705":120879,"_2959":120936},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3475":71807,"_30471":71784,"_21105":120938,"_5":14473,"_27705":120879,"_2959":120939},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3475":71808,"_30471":71784,"_21105":120941,"_5":14473,"_27705":120879,"_2959":120942},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3475":71809,"_30471":71784,"_21105":120944,"_5":14473,"_27705":120883,"_2959":120945},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3475":71810,"_30471":71784,"_21105":120947,"_5":14473,"_27705":120883,"_2959":120948},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3475":71811,"_30471":71784,"_21105":120950,"_5":14473,"_27705":120883,"_2959":120951},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3475":71812,"_30471":71784,"_21105":120953,"_5":14473,"_27705":120887,"_2959":120954},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3475":71813,"_30471":71813,"_5":14825,"_2959":53544,"_30823":120956,"_21105":120958,"_27705":71813},[49595,118538,52084,119550,120957],"Integraciones",[],{"_3475":71814,"_30471":71813,"_21105":120960,"_5":14473,"_27705":71813,"_2959":120961},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3475":71815,"_30471":71813,"_5":30820,"_21105":120963,"_27705":120964,"_2959":120965},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3475":71816,"_30471":71813,"_5":30820,"_21105":120967,"_27705":120968,"_2959":120969},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3475":71817,"_30471":71813,"_5":30820,"_21105":120971,"_27705":120972,"_2959":120973},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3475":71818,"_30471":71813,"_5":30820,"_21105":120975,"_27705":120976,"_2959":120977},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3475":71819,"_30471":71813,"_5":30820,"_21105":120979,"_27705":120980,"_2959":120981},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3475":71820,"_30471":71813,"_5":30820,"_21105":120983,"_27705":120984,"_2959":120985},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3475":71821,"_30471":71813,"_5":30820,"_21105":120987,"_27705":120988,"_2959":120989},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3475":71822,"_30471":71813,"_5":30820,"_21105":120991,"_27705":120992,"_2959":120993},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3475":71823,"_30471":71813,"_5":30820,"_21105":120995,"_27705":120996,"_2959":53586},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3475":71824,"_30471":71813,"_5":30820,"_21105":120998,"_27705":120999,"_2959":53590},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3475":71825,"_30471":71813,"_5":30820,"_21105":121001,"_27705":121002,"_2959":121003},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3475":71826,"_30471":71813,"_5":30820,"_21105":121005,"_27705":121006,"_2959":121007},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3475":71827,"_30471":71813,"_5":30820,"_21105":121009,"_27705":121010,"_2959":121011},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3475":71828,"_30471":71813,"_5":30820,"_21105":121013,"_27705":121014,"_2959":121015},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3475":71829,"_30471":71813,"_5":30820,"_21105":121017,"_27705":121018,"_2959":121019},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3475":71830,"_30471":71813,"_5":30820,"_21105":121021,"_27705":121022,"_2959":121023},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3475":71831,"_30471":71813,"_5":30820,"_21105":121025,"_27705":121026,"_2959":121027},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3475":71832,"_30471":71813,"_5":30820,"_21105":121029,"_27705":121030,"_2959":121031},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3475":71833,"_30471":71813,"_5":30820,"_21105":121033,"_27705":121034,"_2959":121035},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3475":71834,"_30471":71813,"_5":30820,"_21105":121037,"_27705":121038,"_2959":121039},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3475":71835,"_30471":71813,"_5":30820,"_21105":121041,"_27705":121042,"_2959":121043},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3475":71836,"_30471":71813,"_5":30820,"_21105":121045,"_27705":121046,"_2959":121047},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3475":71837,"_30471":71813,"_5":30820,"_21105":121049,"_27705":121050,"_2959":121051},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3475":71838,"_30471":71813,"_5":30820,"_21105":121053,"_27705":121054,"_2959":121055},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3475":71839,"_30471":71813,"_5":30820,"_21105":121057,"_27705":121058,"_2959":121059},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3475":71840,"_30471":71813,"_21105":121061,"_5":14473,"_27705":71813,"_2959":121062},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3475":71841,"_30471":71813,"_21105":121064,"_5":14473,"_27705":71813,"_2959":121065},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3475":71842,"_30471":71813,"_21105":121067,"_5":14473,"_27705":71813,"_2959":121068},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3475":71843,"_30471":71813,"_21105":121070,"_5":14473,"_27705":120964,"_2959":121071},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3475":71844,"_30471":71813,"_21105":121073,"_5":14473,"_27705":120964,"_2959":121074},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3475":71845,"_30471":71813,"_21105":121076,"_5":14473,"_27705":120964,"_2959":121077},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3475":71846,"_30471":71813,"_21105":121079,"_5":14473,"_27705":120964,"_2959":121080},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3475":71847,"_30471":71813,"_21105":121082,"_5":14473,"_27705":120968,"_2959":121083},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3475":71848,"_30471":71813,"_21105":121085,"_5":14473,"_27705":120972,"_2959":121086},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3475":71849,"_30471":71813,"_21105":121088,"_5":14473,"_27705":120972,"_2959":121089},[],"Acción IAM",{"_3475":71850,"_30471":71813,"_21105":121091,"_5":14473,"_27705":120972,"_2959":117479},[],{"_3475":71851,"_30471":71813,"_21105":121093,"_5":14473,"_27705":120972,"_2959":53685},[],{"_3475":71852,"_30471":71813,"_21105":121095,"_5":14473,"_27705":120972,"_2959":121096},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3475":71853,"_30471":71813,"_21105":121098,"_5":14473,"_27705":120972,"_2959":53691},[],{"_3475":71854,"_30471":71813,"_21105":121100,"_5":14473,"_27705":120972,"_2959":121101},[],"Registrar la CA en AWS IoT",{"_3475":71855,"_30471":71813,"_21105":121103,"_5":14473,"_27705":120972,"_2959":53697},[],{"_3475":71856,"_30471":71813,"_21105":121105,"_5":14473,"_27705":120972,"_2959":121106},[],"Consultar el estado del registro de la CA",{"_3475":71857,"_30471":71813,"_21105":121108,"_5":14473,"_27705":120972,"_2959":53703},[],{"_3475":71858,"_30471":71813,"_21105":121110,"_5":14473,"_27705":120972,"_2959":121111},[],"Crear o actualizar Things en IoT Core",{"_3475":71859,"_30471":71813,"_21105":121113,"_5":14473,"_27705":120972,"_2959":53709},[],{"_3475":71860,"_30471":71813,"_21105":121115,"_5":14473,"_27705":120972,"_2959":121116},[],"Aprovisionar Things mediante plantilla",{"_3475":71861,"_30471":71813,"_21105":121118,"_5":14473,"_27705":120972,"_2959":53715},[],{"_3475":71862,"_30471":71813,"_21105":121120,"_5":14473,"_27705":120972,"_2959":121121},[],"Registrar certificados de dispositivo",{"_3475":71863,"_30471":71813,"_21105":121123,"_5":14473,"_27705":120972,"_2959":53721},[],{"_3475":71864,"_30471":71813,"_21105":121125,"_5":14473,"_27705":120972,"_2959":121126},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3475":71865,"_30471":71813,"_21105":121128,"_5":14473,"_27705":120972,"_2959":53727},[],{"_3475":71866,"_30471":71813,"_21105":121130,"_5":14473,"_27705":120972,"_2959":121131},[],"Crear y adjuntar políticas IoT",{"_3475":71867,"_30471":71813,"_21105":121133,"_5":14473,"_27705":120972,"_2959":53733},[],{"_3475":71868,"_30471":71813,"_21105":121135,"_5":14473,"_27705":120972,"_2959":121136},[],"Gestionar grupos de Things",{"_3475":71869,"_30471":71813,"_21105":121138,"_5":14473,"_27705":120972,"_2959":53739},[],{"_3475":71870,"_30471":71813,"_21105":121140,"_5":14473,"_27705":120972,"_2959":121141},[],"Crear plantillas JITP",{"_3475":71871,"_30471":71813,"_21105":121143,"_5":14473,"_27705":120972,"_2959":53745},[],{"_3475":71872,"_30471":71813,"_21105":121145,"_5":14473,"_27705":120972,"_2959":121146},[],"Leer y escribir el Device Shadow",{"_3475":71873,"_30471":71813,"_21105":121148,"_5":14473,"_27705":120972,"_2959":121149},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3475":71874,"_30471":71813,"_21105":121151,"_5":14473,"_27705":120976,"_2959":121152},[],"Parámetro",{"_3475":71875,"_30471":71813,"_21105":121154,"_5":14473,"_27705":120976,"_2959":121155},[],"Tipo",{"_3475":71876,"_30471":71813,"_21105":121157,"_5":14473,"_27705":120976,"_2959":121158},[],"Requerido",{"_3475":71877,"_30471":71813,"_21105":121160,"_5":14473,"_27705":120976,"_2959":121161},[],"Descripción",{"_3475":71878,"_30471":71813,"_21105":121163,"_5":14473,"_27705":120976,"_2959":53766},[],{"_3475":71879,"_30471":71813,"_21105":121165,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71880,"_30471":71813,"_21105":121167,"_5":14473,"_27705":120976,"_2959":121168},[],"Sí",{"_3475":71881,"_30471":71813,"_21105":121170,"_5":14473,"_27705":120976,"_2959":121171},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3475":71882,"_30471":71813,"_21105":121173,"_5":14473,"_27705":120976,"_2959":53777},[],{"_3475":71883,"_30471":71813,"_21105":121175,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71884,"_30471":71813,"_21105":121177,"_5":14473,"_27705":120976,"_2959":121168},[],{"_3475":71885,"_30471":71813,"_21105":121179,"_5":14473,"_27705":120976,"_2959":121180},[],"Región AWS donde opera el conector.",{"_3475":71886,"_30471":71813,"_21105":121182,"_5":14473,"_27705":120976,"_2959":53787},[],{"_3475":71887,"_30471":71813,"_21105":121184,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71888,"_30471":71813,"_21105":121186,"_5":14473,"_27705":120976,"_2959":121168},[],{"_3475":71889,"_30471":71813,"_21105":121188,"_5":14473,"_27705":120976,"_2959":121189},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3475":71890,"_30471":71813,"_21105":121191,"_5":14473,"_27705":120976,"_2959":53797},[],{"_3475":71891,"_30471":71813,"_21105":121193,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71892,"_30471":71813,"_21105":121195,"_5":14473,"_27705":120976,"_2959":121196},[],"Solo con `auth_method=static`",{"_3475":71893,"_30471":71813,"_21105":121198,"_5":14473,"_27705":120976,"_2959":121199},[],"Clave de acceso AWS.",{"_3475":71894,"_30471":71813,"_21105":121201,"_5":14473,"_27705":120976,"_2959":53808},[],{"_3475":71895,"_30471":71813,"_21105":121203,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71896,"_30471":71813,"_21105":121205,"_5":14473,"_27705":120976,"_2959":121196},[],{"_3475":71897,"_30471":71813,"_21105":121207,"_5":14473,"_27705":120976,"_2959":121208},[],"Clave secreta AWS.",{"_3475":71898,"_30471":71813,"_21105":121210,"_5":14473,"_27705":120976,"_2959":53818},[],{"_3475":71899,"_30471":71813,"_21105":121212,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71900,"_30471":71813,"_21105":121214,"_5":14473,"_27705":120976,"_2959":53823},[],{"_3475":71901,"_30471":71813,"_21105":121216,"_5":14473,"_27705":120976,"_2959":121217},[],"Token de sesión (con `auth_method=static`).",{"_3475":71902,"_30471":71813,"_21105":121219,"_5":14473,"_27705":120976,"_2959":53829},[],{"_3475":71903,"_30471":71813,"_21105":121221,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71904,"_30471":71813,"_21105":121223,"_5":14473,"_27705":120976,"_2959":121224},[],"Solo con `auth_method=role`",{"_3475":71905,"_30471":71813,"_21105":121226,"_5":14473,"_27705":120976,"_2959":121227},[],"ARN del rol a asumir.",{"_3475":71906,"_30471":71813,"_21105":121229,"_5":14473,"_27705":120976,"_2959":53840},[],{"_3475":71907,"_30471":71813,"_21105":121231,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71908,"_30471":71813,"_21105":121233,"_5":14473,"_27705":120976,"_2959":53823},[],{"_3475":71909,"_30471":71813,"_21105":121235,"_5":14473,"_27705":120976,"_2959":121236},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3475":71910,"_30471":71813,"_21105":121238,"_5":14473,"_27705":120976,"_2959":53850},[],{"_3475":71911,"_30471":71813,"_21105":121240,"_5":14473,"_27705":120976,"_2959":90417},[],{"_3475":71912,"_30471":71813,"_21105":121242,"_5":14473,"_27705":120976,"_2959":121168},[],{"_3475":71913,"_30471":71813,"_21105":121244,"_5":14473,"_27705":120976,"_2959":121245},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3475":71914,"_30471":71813,"_21105":121247,"_5":14473,"_27705":120976,"_2959":53860},[],{"_3475":71915,"_30471":71813,"_21105":121249,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71916,"_30471":71813,"_21105":121251,"_5":14473,"_27705":120976,"_2959":121168},[],{"_3475":71917,"_30471":71813,"_21105":121253,"_5":14473,"_27705":120976,"_2959":121254},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3475":71918,"_30471":71813,"_21105":121256,"_5":14473,"_27705":120976,"_2959":53870},[],{"_3475":71919,"_30471":71813,"_21105":121258,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71920,"_30471":71813,"_21105":121260,"_5":14473,"_27705":120976,"_2959":121168},[],{"_3475":71921,"_30471":71813,"_21105":121262,"_5":14473,"_27705":120976,"_2959":121263},[],"URL HTTP del Device Manager de Lamassu.",{"_3475":71922,"_30471":71813,"_21105":121265,"_5":14473,"_27705":120976,"_2959":53880},[],{"_3475":71923,"_30471":71813,"_21105":121267,"_5":14473,"_27705":120976,"_2959":25243},[],{"_3475":71924,"_30471":71813,"_21105":121269,"_5":14473,"_27705":120976,"_2959":121168},[],{"_3475":71925,"_30471":71813,"_21105":121271,"_5":14473,"_27705":120976,"_2959":121272},[],"URL HTTP del servicio de CA de Lamassu.",{"_3475":71926,"_30471":71813,"_21105":121274,"_5":14473,"_27705":120980,"_2959":121275},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3475":71927,"_30471":71813,"_21105":121277,"_5":14473,"_27705":120980,"_2959":121278},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3475":71928,"_30471":71813,"_21105":121280,"_5":14473,"_27705":120980,"_2959":121281},[],"Tipo de CloudEvent",{"_3475":71929,"_30471":71813,"_21105":121283,"_5":14473,"_27705":120980,"_2959":121284},[],"Recurso en Lamassu",{"_3475":71930,"_30471":71813,"_21105":121286,"_5":14473,"_27705":120980,"_2959":121287},[],"Recurso AWS",{"_3475":71931,"_30471":71813,"_21105":121289,"_5":14473,"_27705":120980,"_2959":121290},[],"Acciones IAM",{"_3475":71932,"_30471":71813,"_21105":121292,"_5":14473,"_27705":120980,"_2959":121293},[],"Llamadas AWS y efecto",{"_3475":71933,"_30471":71813,"_21105":121295,"_5":14473,"_27705":120980,"_2959":121296},[],"Dónde en esta página",{"_3475":71934,"_30471":71813,"_21105":121298,"_5":14473,"_27705":120980,"_2959":53914},[],{"_3475":71935,"_30471":71813,"_21105":121300,"_5":14473,"_27705":120980,"_2959":53917},[],{"_3475":71936,"_30471":71813,"_21105":121302,"_5":14473,"_27705":120980,"_2959":53920},[],{"_3475":71937,"_30471":71813,"_21105":121304,"_5":14473,"_27705":120980,"_2959":53923},[],{"_3475":71938,"_30471":71813,"_21105":121306,"_5":14473,"_27705":120980,"_2959":121307},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3475":71939,"_30471":71813,"_21105":121309,"_5":14473,"_27705":120980,"_2959":120993},[],{"_3475":71940,"_30471":71813,"_21105":121311,"_5":14473,"_27705":120980,"_2959":53931},[],{"_3475":71941,"_30471":71813,"_21105":121313,"_5":14473,"_27705":120980,"_2959":53934},[],{"_3475":71942,"_30471":71813,"_21105":121315,"_5":14473,"_27705":120980,"_2959":53937},[],{"_3475":71943,"_30471":71813,"_21105":121317,"_5":14473,"_27705":120980,"_2959":53940},[],{"_3475":71944,"_30471":71813,"_21105":121319,"_5":14473,"_27705":120980,"_2959":121320},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3475":71945,"_30471":71813,"_21105":121322,"_5":14473,"_27705":120980,"_2959":121019},[],{"_3475":71946,"_30471":71813,"_21105":121324,"_5":14473,"_27705":120980,"_2959":53948},[],{"_3475":71947,"_30471":71813,"_21105":121326,"_5":14473,"_27705":120980,"_2959":121327},[],"Dispositivo",{"_3475":71948,"_30471":71813,"_21105":121329,"_5":14473,"_27705":120980,"_2959":53954},[],{"_3475":71949,"_30471":71813,"_21105":121331,"_5":14473,"_27705":120980,"_2959":53957},[],{"_3475":71950,"_30471":71813,"_21105":121333,"_5":14473,"_27705":120980,"_2959":121334},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3475":71951,"_30471":71813,"_21105":121336,"_5":14473,"_27705":120980,"_2959":121027},[],{"_3475":71952,"_30471":71813,"_21105":121338,"_5":14473,"_27705":120980,"_2959":53965},[],{"_3475":71953,"_30471":71813,"_21105":121340,"_5":14473,"_27705":120980,"_2959":121341},[],"Certificado",{"_3475":71954,"_30471":71813,"_21105":121343,"_5":14473,"_27705":120980,"_2959":53971},[],{"_3475":71955,"_30471":71813,"_21105":121345,"_5":14473,"_27705":120980,"_2959":121346},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3475":71956,"_30471":71813,"_21105":121348,"_5":14473,"_27705":120980,"_2959":121349},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3475":71957,"_30471":71813,"_21105":121351,"_5":14473,"_27705":120980,"_2959":121039},[],{"_3475":71958,"_30471":71813,"_21105":121353,"_5":14473,"_27705":120980,"_2959":53982},[],{"_3475":71959,"_30471":71813,"_21105":121355,"_5":14473,"_27705":120980,"_2959":121356},[],"Certificado / Dispositivo",{"_3475":71960,"_30471":71813,"_21105":121358,"_5":14473,"_27705":120980,"_2959":53988},[],{"_3475":71961,"_30471":71813,"_21105":121360,"_5":14473,"_27705":120980,"_2959":49991},[],{"_3475":71962,"_30471":71813,"_21105":121362,"_5":14473,"_27705":120980,"_2959":121363},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3475":71963,"_30471":71813,"_21105":121365,"_5":14473,"_27705":120980,"_2959":121047},[],{"_3475":71964,"_30471":71813,"_21105":121367,"_5":14473,"_27705":120984,"_2959":121368},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3475":71965,"_30471":71813,"_21105":121370,"_5":14473,"_27705":120988,"_2959":121371},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3475":71966,"_30471":71813,"_21105":121373,"_5":14473,"_27705":120988,"_2959":121374},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3475":71967,"_30471":71813,"_21105":121376,"_5":14473,"_27705":120992,"_2959":121377},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3475":71968,"_30471":71813,"_21105":121379,"_5":14473,"_27705":120992,"_2959":121380},[],"Transición",{"_3475":71969,"_30471":71813,"_21105":121382,"_5":14473,"_27705":120992,"_2959":121383},[],"Llamadas AWS",{"_3475":71970,"_30471":71813,"_21105":121385,"_5":14473,"_27705":120992,"_2959":121386},[],"`NoRegistrada` → `Solicitada`",{"_3475":71971,"_30471":71813,"_21105":121388,"_5":14473,"_27705":120992,"_2959":121389},[],"ninguna (solo escritura de metadatos)",{"_3475":71972,"_30471":71813,"_21105":121391,"_5":14473,"_27705":120992,"_2959":121392},[],"`Solicitada` → `Registrando`",{"_3475":71973,"_30471":71813,"_21105":121394,"_5":14473,"_27705":120992,"_2959":121395},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3475":71974,"_30471":71813,"_21105":121397,"_5":14473,"_27705":120992,"_2959":121398},[],"`Registrando` → `Completada`",{"_3475":71975,"_30471":71813,"_21105":121400,"_5":14473,"_27705":120992,"_2959":121401},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3475":71976,"_30471":71813,"_21105":121403,"_5":14473,"_27705":120992,"_2959":121404},[],"`Registrando` → `Fallida`",{"_3475":71977,"_30471":71813,"_21105":121406,"_5":14473,"_27705":120992,"_2959":121407},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3475":71978,"_30471":71813,"_21105":121409,"_5":14473,"_27705":120992,"_2959":121410},[],"`Fallida` / `Completada` → `Solicitada`",{"_3475":71979,"_30471":71813,"_21105":121412,"_5":14473,"_27705":120992,"_2959":121413},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3475":71980,"_30471":71813,"_21105":121415,"_5":14473,"_27705":120996,"_2959":121416},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3475":71981,"_30471":71813,"_21105":121418,"_5":14473,"_27705":120996,"_2959":121419},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3475":71982,"_30471":71813,"_21105":121421,"_5":14473,"_27705":120996,"_2959":121422},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3475":71983,"_30471":71813,"_21105":121424,"_5":14473,"_27705":120996,"_2959":121425},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3475":71984,"_30471":71813,"_21105":121427,"_5":14473,"_27705":120996,"_2959":121428},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3475":71985,"_30471":71813,"_21105":121430,"_5":14473,"_27705":120996,"_2959":121431},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3475":71986,"_30471":71813,"_21105":121433,"_5":14473,"_27705":120999,"_2959":121434},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3475":71987,"_30471":71813,"_21105":121436,"_5":14473,"_27705":121002,"_2959":121437},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3475":71988,"_30471":71813,"_21105":121439,"_5":14473,"_27705":121002,"_2959":121440},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3475":71989,"_30471":71813,"_21105":121442,"_5":14473,"_27705":121006,"_2959":121443},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3475":71990,"_30471":71813,"_21105":121445,"_5":14473,"_27705":121010,"_2959":121446},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3475":71991,"_30471":71813,"_21105":121448,"_5":14473,"_27705":121010,"_2959":121449},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3475":71992,"_30471":71813,"_21105":121451,"_5":14473,"_27705":121010,"_2959":121452},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3475":71993,"_30471":71813,"_21105":121454,"_5":14473,"_27705":121010,"_2959":121455},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3475":71994,"_30471":71813,"_21105":121457,"_5":14473,"_27705":121010,"_2959":121458},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3475":71995,"_30471":71813,"_21105":121460,"_5":14473,"_27705":121010,"_2959":121461},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3475":71996,"_30471":71813,"_21105":121463,"_5":14473,"_27705":121014,"_2959":121464},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3475":71997,"_30471":71813,"_21105":121466,"_5":14473,"_27705":121014,"_2959":121467},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3475":71998,"_30471":71813,"_21105":121469,"_5":14473,"_27705":121014,"_2959":121470},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3475":71999,"_30471":71813,"_21105":121472,"_5":14473,"_27705":121014,"_2959":121473},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3475":72000,"_30471":71813,"_21105":121475,"_5":14473,"_27705":121014,"_2959":121476},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3475":72001,"_30471":71813,"_21105":121478,"_5":14473,"_27705":121018,"_2959":121479},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3475":72002,"_30471":71813,"_21105":121481,"_5":14473,"_27705":121018,"_2959":121380},[],{"_3475":72003,"_30471":71813,"_21105":121483,"_5":14473,"_27705":121018,"_2959":121383},[],{"_3475":72004,"_30471":71813,"_21105":121485,"_5":14473,"_27705":121018,"_2959":121486},[],"`SinConfigurar` → `None` / `Auto`",{"_3475":72005,"_30471":71813,"_21105":121488,"_5":14473,"_27705":121018,"_2959":121489},[],"ninguna (solo configuración)",{"_3475":72006,"_30471":71813,"_21105":121491,"_5":14473,"_27705":121018,"_2959":54125},[],{"_3475":72007,"_30471":71813,"_21105":121493,"_5":14473,"_27705":121018,"_2959":121489},[],{"_3475":72008,"_30471":71813,"_21105":121495,"_5":14473,"_27705":121018,"_2959":121496},[],"Cualquiera → `Jitp`",{"_3475":72009,"_30471":71813,"_21105":121498,"_5":14473,"_27705":121018,"_2959":121499},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3475":72010,"_30471":71813,"_21105":121501,"_5":14473,"_27705":121018,"_2959":54136},[],{"_3475":72011,"_30471":71813,"_21105":121503,"_5":14473,"_27705":121018,"_2959":121504},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3475":72012,"_30471":71813,"_21105":121506,"_5":14473,"_27705":121022,"_2959":121507},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3475":72013,"_30471":71813,"_21105":121509,"_5":14473,"_27705":121022,"_2959":121510},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3475":72014,"_30471":71813,"_21105":121512,"_5":14473,"_27705":121022,"_2959":121513},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3475":72015,"_30471":71813,"_21105":121515,"_5":14473,"_27705":121026,"_2959":121516},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3475":72016,"_30471":71813,"_21105":121518,"_5":14473,"_27705":121026,"_2959":121380},[],{"_3475":72017,"_30471":71813,"_21105":121520,"_5":14473,"_27705":121026,"_2959":121383},[],{"_3475":72018,"_30471":71813,"_21105":121522,"_5":14473,"_27705":121026,"_2959":121523},[],"`Ausente` → `Aprovisionado`",{"_3475":72019,"_30471":71813,"_21105":121525,"_5":14473,"_27705":121026,"_2959":121526},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3475":72020,"_30471":71813,"_21105":121528,"_5":14473,"_27705":121026,"_2959":121529},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3475":72021,"_30471":71813,"_21105":121531,"_5":14473,"_27705":121026,"_2959":121532},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3475":72022,"_30471":71813,"_21105":121534,"_5":14473,"_27705":121026,"_2959":121535},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3475":72023,"_30471":71813,"_21105":121537,"_5":14473,"_27705":121030,"_2959":121538},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3475":72024,"_30471":71813,"_21105":121540,"_5":14473,"_27705":121030,"_2959":121541},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3475":72025,"_30471":71813,"_21105":121543,"_5":14473,"_27705":121030,"_2959":121544},[],"Para que el flujo JITP funcione correctamente:",{"_3475":72026,"_30471":71813,"_21105":121546,"_5":14473,"_27705":121030,"_2959":121547},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3475":72027,"_30471":71813,"_21105":121549,"_5":14473,"_27705":121030,"_2959":121550},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3475":72028,"_30471":71813,"_21105":121552,"_5":14473,"_27705":121030,"_2959":121553},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3475":72029,"_30471":71813,"_21105":121555,"_5":14473,"_27705":121030,"_2959":121556},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3475":72030,"_30471":71813,"_21105":121558,"_5":14473,"_27705":121034,"_2959":121559},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3475":72031,"_30471":71813,"_21105":121561,"_5":14473,"_27705":121034,"_2959":121562},[],"Estado en Lamassu",{"_3475":72032,"_30471":71813,"_21105":121564,"_5":14473,"_27705":121034,"_2959":121565},[],"Razón de revocación",{"_3475":72033,"_30471":71813,"_21105":121567,"_5":14473,"_27705":121034,"_2959":121568},[],"Estado en AWS IoT Core",{"_3475":72034,"_30471":71813,"_21105":121570,"_5":14473,"_27705":121034,"_2959":54206},[],{"_3475":72035,"_30471":71813,"_21105":121572,"_5":14473,"_27705":121034,"_2959":121573},[],"Ninguna",{"_3475":72036,"_30471":71813,"_21105":121575,"_5":14473,"_27705":121034,"_2959":54212},[],{"_3475":72037,"_30471":71813,"_21105":121577,"_5":14473,"_27705":121034,"_2959":54215},[],{"_3475":72038,"_30471":71813,"_21105":121579,"_5":14473,"_27705":121034,"_2959":54218},[],{"_3475":72039,"_30471":71813,"_21105":121581,"_5":14473,"_27705":121034,"_2959":54221},[],{"_3475":72040,"_30471":71813,"_21105":121583,"_5":14473,"_27705":121034,"_2959":54215},[],{"_3475":72041,"_30471":71813,"_21105":121585,"_5":14473,"_27705":121034,"_2959":121586},[],"Cualquier otra razón",{"_3475":72042,"_30471":71813,"_21105":121588,"_5":14473,"_27705":121034,"_2959":54229},[],{"_3475":72043,"_30471":71813,"_21105":121590,"_5":14473,"_27705":121034,"_2959":121591},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3475":72044,"_30471":71813,"_21105":121593,"_5":14473,"_27705":121038,"_2959":121594},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3475":72045,"_30471":71813,"_21105":121596,"_5":14473,"_27705":121038,"_2959":121380},[],{"_3475":72046,"_30471":71813,"_21105":121598,"_5":14473,"_27705":121038,"_2959":121383},[],{"_3475":72047,"_30471":71813,"_21105":121600,"_5":14473,"_27705":121038,"_2959":121601},[],"`NoSincronizado` → `Active`",{"_3475":72048,"_30471":71813,"_21105":121603,"_5":14473,"_27705":121038,"_2959":53721},[],{"_3475":72049,"_30471":71813,"_21105":121605,"_5":14473,"_27705":121038,"_2959":54247},[],{"_3475":72050,"_30471":71813,"_21105":121607,"_5":14473,"_27705":121038,"_2959":121608},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3475":72051,"_30471":71813,"_21105":121610,"_5":14473,"_27705":121038,"_2959":54253},[],{"_3475":72052,"_30471":71813,"_21105":121612,"_5":14473,"_27705":121038,"_2959":121608},[],{"_3475":72053,"_30471":71813,"_21105":121614,"_5":14473,"_27705":121038,"_2959":54258},[],{"_3475":72054,"_30471":71813,"_21105":121616,"_5":14473,"_27705":121038,"_2959":53721},[],{"_3475":72055,"_30471":71813,"_21105":121618,"_5":14473,"_27705":121038,"_2959":54263},[],{"_3475":72056,"_30471":71813,"_21105":121620,"_5":14473,"_27705":121038,"_2959":121621},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3475":72057,"_30471":71813,"_21105":121623,"_5":14473,"_27705":121042,"_2959":121624},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3475":72058,"_30471":71813,"_21105":121626,"_5":14473,"_27705":121042,"_2959":121627},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3475":72059,"_30471":71813,"_21105":121629,"_5":14473,"_27705":121042,"_2959":121630},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3475":72060,"_30471":71813,"_21105":121632,"_5":14473,"_27705":121046,"_2959":121633},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3475":72061,"_30471":71813,"_21105":121635,"_5":14473,"_27705":121046,"_2959":121636},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3475":72062,"_30471":71813,"_21105":121638,"_5":14473,"_27705":121050,"_2959":121639},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3475":72063,"_30471":71813,"_21105":121641,"_5":14473,"_27705":121050,"_2959":121642},[],"Existen dos tipos de acciones:",{"_3475":72064,"_30471":71813,"_21105":121644,"_5":14473,"_27705":121050,"_2959":121645},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3475":72065,"_30471":71813,"_21105":121647,"_5":14473,"_27705":121050,"_2959":121648},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3475":72066,"_30471":71813,"_21105":121650,"_5":14473,"_27705":121050,"_2959":121651},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3475":72067,"_30471":71813,"_21105":121653,"_5":14473,"_27705":121054,"_2959":121654},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3475":72068,"_30471":71813,"_21105":121656,"_5":14473,"_27705":121054,"_2959":121657},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3475":72069,"_30471":71813,"_21105":121659,"_5":14473,"_27705":121054,"_2959":121660},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3475":72070,"_30471":71813,"_21105":121662,"_5":14473,"_27705":121058,"_2959":121663},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3475":72071,"_30471":71813,"_21105":121665,"_5":14473,"_27705":121058,"_2959":121666},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3475":72072,"_30471":71813,"_21105":121668,"_5":14473,"_27705":121058,"_2959":121669},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3475":72073,"_30471":71813,"_21105":121671,"_5":14473,"_27705":121058,"_2959":121672},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3475":72074,"_30471":71813,"_21105":121674,"_5":14473,"_27705":121058,"_2959":121675},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3475":72075,"_30471":71813,"_21105":121677,"_5":14473,"_27705":121058,"_2959":121678},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3475":72076,"_30471":71813,"_21105":121680,"_5":14473,"_27705":121058,"_2959":121681},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3475":72077,"_30471":71813,"_21105":121683,"_5":14473,"_27705":121058,"_2959":121684},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3475":72078,"_30471":71813,"_21105":121686,"_5":14473,"_27705":121058,"_2959":121687},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3475":72079,"_30471":71813,"_21105":121689,"_5":14473,"_27705":121058,"_2959":121690},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3475":72080,"_30471":71813,"_21105":121692,"_5":14473,"_27705":121058,"_2959":121693},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3475":72081,"_30471":71813,"_21105":121695,"_5":14473,"_27705":121058,"_2959":121696},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3475":72082,"_30471":71813,"_21105":121698,"_5":14473,"_27705":121058,"_2959":121699},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3475":72083,"_30471":71813,"_21105":121701,"_5":14473,"_27705":121058,"_2959":121702},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3475":72084,"_30471":71813,"_21105":121704,"_5":14473,"_27705":121058,"_2959":121705},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3475":72085,"_30471":71813,"_21105":121707,"_5":14473,"_27705":121058,"_2959":121708},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3475":72086,"_30471":71813,"_21105":121710,"_5":14473,"_27705":121058,"_2959":121711},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3475":72087,"_30471":71813,"_21105":121713,"_5":14473,"_27705":121058,"_2959":121714},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3475":72088,"_30471":71813,"_21105":121716,"_5":14473,"_27705":121058,"_2959":121717},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3475":72089,"_30471":71813,"_21105":121719,"_5":14473,"_27705":121058,"_2959":121720},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3475":72090,"_30471":71813,"_21105":121722,"_5":14473,"_27705":121058,"_2959":121723},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3475":72091,"_30471":71813,"_21105":121725,"_5":14473,"_27705":121058,"_2959":121726},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":72092,"_30471":71813,"_21105":121728,"_5":14473,"_27705":121058,"_2959":121729},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3475":72093,"_30471":71813,"_21105":121731,"_5":14473,"_27705":121058,"_2959":121732},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3475":72094,"_30471":72094,"_5":14825,"_2959":52084,"_30823":121734,"_21105":121735,"_27705":72094},[49595,118538,52084],[],{"_3475":72095,"_30471":72094,"_21105":121737,"_5":14473,"_27705":72094,"_2959":121738},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3475":72096,"_30471":72094,"_5":30820,"_21105":121740,"_27705":121741,"_2959":121742},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3475":72097,"_30471":72094,"_5":30820,"_21105":121744,"_27705":121745,"_2959":119550},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3475":72098,"_30471":72094,"_5":30820,"_21105":121747,"_27705":121748,"_2959":119725},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3475":72099,"_30471":72094,"_5":30820,"_21105":121750,"_27705":121751,"_2959":120957},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/overview#integraciones",{"_3475":72100,"_30471":72094,"_5":30820,"_21105":121753,"_27705":121754,"_2959":121755},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3475":72101,"_30471":72094,"_21105":121757,"_5":14473,"_27705":72094,"_2959":121758},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3475":72102,"_30471":72094,"_21105":121760,"_5":14473,"_27705":121741,"_2959":121761},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3475":72103,"_30471":72094,"_21105":121763,"_5":14473,"_27705":121741,"_2959":121764},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3475":72104,"_30471":72094,"_21105":121766,"_5":14473,"_27705":121745,"_2959":121767},[],"Recurso",{"_3475":72105,"_30471":72094,"_21105":121769,"_5":14473,"_27705":121745,"_2959":121770},[],"Qué representa",{"_3475":72106,"_30471":72094,"_21105":121772,"_5":14473,"_27705":121745,"_2959":121773},[],"**Dispositivo**",{"_3475":72107,"_30471":72094,"_21105":121775,"_5":14473,"_27705":121745,"_2959":121776},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3475":72108,"_30471":72094,"_21105":121778,"_5":14473,"_27705":121745,"_2959":121779},[],"**Identidad**",{"_3475":72109,"_30471":72094,"_21105":121781,"_5":14473,"_27705":121745,"_2959":121782},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3475":72110,"_30471":72094,"_21105":121784,"_5":14473,"_27705":121745,"_2959":54430},[],{"_3475":72111,"_30471":72094,"_21105":121786,"_5":14473,"_27705":121745,"_2959":121787},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3475":72112,"_30471":72094,"_21105":121789,"_5":14473,"_27705":121745,"_2959":121790},[],"**Flota**",{"_3475":72113,"_30471":72094,"_21105":121792,"_5":14473,"_27705":121745,"_2959":121793},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3475":72114,"_30471":72094,"_21105":121795,"_5":14473,"_27705":121745,"_2959":121796},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3475":72115,"_30471":72094,"_21105":121798,"_5":14473,"_27705":121745,"_2959":121799},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3475":72116,"_30471":72094,"_21105":121801,"_5":14473,"_27705":121748,"_2959":121802},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3475":72117,"_30471":72094,"_21105":121804,"_5":14473,"_27705":121748,"_2959":121805},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3475":72118,"_30471":72094,"_21105":121807,"_5":14473,"_27705":121748,"_2959":121808},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3475":72119,"_30471":72094,"_21105":121810,"_5":14473,"_27705":121748,"_2959":121811},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3475":72120,"_30471":72094,"_21105":121813,"_5":14473,"_27705":121748,"_2959":121814},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3475":72121,"_30471":72094,"_21105":121816,"_5":14473,"_27705":121748,"_2959":121817},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3475":72122,"_30471":72094,"_21105":121819,"_5":14473,"_27705":121748,"_2959":121820},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3475":72123,"_30471":72094,"_21105":121822,"_5":14473,"_27705":121748,"_2959":121823},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3475":72124,"_30471":72094,"_21105":121825,"_5":14473,"_27705":121751,"_2959":121826},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3475":72125,"_30471":72094,"_21105":121828,"_5":14473,"_27705":121751,"_2959":121829},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3475":72126,"_30471":72094,"_21105":121831,"_5":14473,"_27705":121754,"_2959":121832},[],"Participante",{"_3475":72127,"_30471":72094,"_21105":121834,"_5":14473,"_27705":121754,"_2959":121835},[],"Responsabilidad",{"_3475":72128,"_30471":72094,"_21105":121837,"_5":14473,"_27705":121754,"_2959":121838},[],"Administrador PKI",{"_3475":72129,"_30471":72094,"_21105":121840,"_5":14473,"_27705":121754,"_2959":121841},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3475":72130,"_30471":72094,"_21105":121843,"_5":14473,"_27705":121754,"_2959":121844},[],"Administrador del aprovisionamiento",{"_3475":72131,"_30471":72094,"_21105":121846,"_5":14473,"_27705":121754,"_2959":121847},[],"DMS, admisión, autenticación por operación e inventario.",{"_3475":72132,"_30471":72094,"_21105":121849,"_5":14473,"_27705":121754,"_2959":121850},[],"Integrador del dispositivo",{"_3475":72133,"_30471":72094,"_21105":121852,"_5":14473,"_27705":121754,"_2959":121853},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3475":72134,"_30471":72094,"_21105":121855,"_5":14473,"_27705":121754,"_2959":121856},[],"Integrador del consumidor",{"_3475":72135,"_30471":72094,"_21105":121858,"_5":14473,"_27705":121754,"_2959":121859},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3475":72136,"_30471":72094,"_21105":121861,"_5":14473,"_27705":121754,"_2959":121862},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3475":72137,"_30471":72137,"_5":14825,"_2959":121864,"_30823":121865,"_21105":121867,"_27705":72137},"Enrola y conecta tu primer dispositivo",[49595,118538,52084,121866],"Primeros pasos",[],{"_3475":72138,"_30471":72137,"_21105":121869,"_5":14473,"_27705":72137,"_2959":121870},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3475":72139,"_30471":72137,"_5":30820,"_21105":121872,"_27705":121873,"_2959":117109},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3475":72140,"_30471":72137,"_5":30820,"_21105":121875,"_27705":121876,"_2959":121877},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3475":72141,"_30471":72137,"_5":30820,"_21105":121879,"_27705":121880,"_2959":121881},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3475":72142,"_30471":72137,"_5":30820,"_21105":121883,"_27705":121884,"_2959":121885},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3475":72143,"_30471":72137,"_5":30820,"_21105":121887,"_27705":121888,"_2959":121889},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3475":72144,"_30471":72137,"_5":30820,"_21105":121891,"_27705":121892,"_2959":121893},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3475":72145,"_30471":72137,"_5":30820,"_21105":121895,"_27705":121896,"_2959":121897},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3475":72146,"_30471":72137,"_5":30820,"_21105":121899,"_27705":121900,"_2959":121901},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3475":72147,"_30471":72137,"_21105":121903,"_5":14473,"_27705":72137,"_2959":121904},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3475":72148,"_30471":72137,"_21105":121906,"_5":14473,"_27705":121873,"_2959":121907},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3475":72149,"_30471":72137,"_21105":121909,"_5":14473,"_27705":121873,"_2959":121910},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3475":72150,"_30471":72137,"_21105":121912,"_5":14473,"_27705":121873,"_2959":121913},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3475":72151,"_30471":72137,"_21105":121915,"_5":14473,"_27705":121873,"_2959":121916},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3475":72152,"_30471":72137,"_21105":121918,"_5":14473,"_27705":121873,"_2959":121919},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3475":72153,"_30471":72137,"_21105":121921,"_5":14473,"_27705":121876,"_2959":121922},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3475":72154,"_30471":72137,"_21105":121924,"_5":14473,"_27705":121876,"_2959":121925},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3475":72155,"_30471":72137,"_21105":121927,"_5":14473,"_27705":121880,"_2959":121928},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3475":72156,"_30471":72137,"_21105":121930,"_5":14473,"_27705":121880,"_2959":121931},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3475":72157,"_30471":72137,"_21105":121933,"_5":14473,"_27705":121880,"_2959":121934},[],"Ajuste",{"_3475":72158,"_30471":72137,"_21105":121936,"_5":14473,"_27705":121880,"_2959":121937},[],"Valor de evaluación",{"_3475":72159,"_30471":72137,"_21105":121939,"_5":14473,"_27705":121880,"_2959":54586},[],{"_3475":72160,"_30471":72137,"_21105":121941,"_5":14473,"_27705":121880,"_2959":121942},[],"Raíz emisora de `device-root.pem`.",{"_3475":72161,"_30471":72137,"_21105":121944,"_5":14473,"_27705":121880,"_2959":119853},[],{"_3475":72162,"_30471":72137,"_21105":121946,"_5":14473,"_27705":121880,"_2959":121947},[],"Perfil final de 1 hora que acabas de preparar.",{"_3475":72163,"_30471":72137,"_21105":121949,"_5":14473,"_27705":121880,"_2959":54597},[],{"_3475":72164,"_30471":72137,"_21105":121951,"_5":14473,"_27705":121880,"_2959":54600},[],{"_3475":72165,"_30471":72137,"_21105":121953,"_5":14473,"_27705":121880,"_2959":54603},[],{"_3475":72166,"_30471":72137,"_21105":121955,"_5":14473,"_27705":121880,"_2959":121956},[],"Habilitado.",{"_3475":72167,"_30471":72137,"_21105":121958,"_5":14473,"_27705":121880,"_2959":54609},[],{"_3475":72168,"_30471":72137,"_21105":121960,"_5":14473,"_27705":121880,"_2959":121961},[],"Deshabilitado; el ID debe ser nuevo.",{"_3475":72169,"_30471":72137,"_21105":121963,"_5":14473,"_27705":121880,"_2959":121964},[],"Autenticación inicial",{"_3475":72170,"_30471":72137,"_21105":121966,"_5":14473,"_27705":121880,"_2959":121967},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3475":72171,"_30471":72137,"_21105":121969,"_5":14473,"_27705":121880,"_2959":121970},[],"Autenticación de renovación",{"_3475":72172,"_30471":72137,"_21105":121972,"_5":14473,"_27705":121880,"_2959":121973},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3475":72173,"_30471":72137,"_21105":121975,"_5":14473,"_27705":121880,"_2959":54627},[],{"_3475":72174,"_30471":72137,"_21105":121977,"_5":14473,"_27705":121880,"_2959":121978},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3475":72175,"_30471":72137,"_21105":121980,"_5":14473,"_27705":121880,"_2959":54633},[],{"_3475":72176,"_30471":72137,"_21105":121982,"_5":14473,"_27705":121880,"_2959":121983},[],"1 hora.",{"_3475":72177,"_30471":72137,"_21105":121985,"_5":14473,"_27705":121880,"_2959":54639},[],{"_3475":72178,"_30471":72137,"_21105":121987,"_5":14473,"_27705":121880,"_2959":121988},[],"30 minutos / 10 minutos.",{"_3475":72179,"_30471":72137,"_21105":121990,"_5":14473,"_27705":121880,"_2959":54645},[],{"_3475":72180,"_30471":72137,"_21105":121992,"_5":14473,"_27705":121880,"_2959":121993},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3475":72181,"_30471":72137,"_21105":121995,"_5":14473,"_27705":121880,"_2959":52403},[],{"_3475":72182,"_30471":72137,"_21105":121997,"_5":14473,"_27705":121880,"_2959":121998},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3475":72183,"_30471":72137,"_21105":122000,"_5":14473,"_27705":121880,"_2959":54656},[],{"_3475":72184,"_30471":72137,"_21105":122002,"_5":14473,"_27705":121880,"_2959":122003},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3475":72185,"_30471":72137,"_21105":122005,"_5":14473,"_27705":121880,"_2959":122006},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3475":72186,"_30471":72137,"_21105":122008,"_5":14473,"_27705":121884,"_2959":122009},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3475":72187,"_30471":72137,"_21105":122011,"_5":14473,"_27705":121884,"_2959":122012},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3475":72188,"_30471":72137,"_21105":122014,"_5":14473,"_27705":121888,"_2959":122015},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3475":72189,"_30471":72137,"_21105":122017,"_5":14473,"_27705":121888,"_2959":122018},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3475":72190,"_30471":72137,"_21105":122020,"_5":14473,"_27705":121888,"_2959":122021},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3475":72191,"_30471":72137,"_21105":122023,"_5":14473,"_27705":121892,"_2959":122024},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3475":72192,"_30471":72137,"_21105":122026,"_5":14473,"_27705":121892,"_2959":122027},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3475":72193,"_30471":72137,"_21105":122029,"_5":14473,"_27705":121896,"_2959":122030},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3475":72194,"_30471":72137,"_21105":122032,"_5":14473,"_27705":121896,"_2959":122033},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3475":72195,"_30471":72137,"_21105":122035,"_5":14473,"_27705":121896,"_2959":122036},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3475":72196,"_30471":72137,"_21105":122038,"_5":14473,"_27705":121896,"_2959":122039},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3475":72197,"_30471":72137,"_21105":122041,"_5":14473,"_27705":121896,"_2959":122042},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3475":72198,"_30471":72137,"_21105":122044,"_5":14473,"_27705":121900,"_2959":122045},[],"Comprobación",{"_3475":72199,"_30471":72137,"_21105":122047,"_5":14473,"_27705":121900,"_2959":122048},[],"Resultado esperado",{"_3475":72200,"_30471":72137,"_21105":122050,"_5":14473,"_27705":121900,"_2959":122051},[],"Registro",{"_3475":72201,"_30471":72137,"_21105":122053,"_5":14473,"_27705":121900,"_2959":122054},[],"ID creado automáticamente y DMS correcto.",{"_3475":72202,"_30471":72137,"_21105":122056,"_5":14473,"_27705":121900,"_2959":121341},[],{"_3475":72203,"_30471":72137,"_21105":122058,"_5":14473,"_27705":121900,"_2959":122059},[],"CN, perfil, serie y clave verificados.",{"_3475":72204,"_30471":72137,"_21105":122061,"_5":14473,"_27705":121900,"_2959":122062},[],"Inventario",{"_3475":72205,"_30471":72137,"_21105":122064,"_5":14473,"_27705":121900,"_2959":122065},[],"Serie recibida visible como identidad actual y en el historial.",{"_3475":72206,"_30471":72137,"_21105":122067,"_5":14473,"_27705":121900,"_2959":122068},[],"Consumidor",{"_3475":72207,"_30471":72137,"_21105":122070,"_5":14473,"_27705":121900,"_2959":122071},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3475":72208,"_30471":72137,"_21105":122073,"_5":14473,"_27705":121900,"_2959":122074},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3475":72209,"_30471":72137,"_21105":122076,"_5":14473,"_27705":121900,"_2959":122077},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3475":72210,"_30471":72210,"_5":14825,"_2959":119567,"_30823":122079,"_21105":122080,"_27705":72210},[49595,118538,52084,121866],[],{"_3475":72211,"_30471":72210,"_21105":122082,"_5":14473,"_27705":72210,"_2959":122083},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3475":72212,"_30471":72210,"_5":30820,"_21105":122085,"_27705":122086,"_2959":117109},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3475":72213,"_30471":72210,"_5":30820,"_21105":122088,"_27705":122089,"_2959":122090},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3475":72214,"_30471":72210,"_5":30820,"_21105":122092,"_27705":122093,"_2959":122094},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3475":72215,"_30471":72210,"_5":30820,"_21105":122096,"_27705":122097,"_2959":122098},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3475":72216,"_30471":72210,"_5":30820,"_21105":122100,"_27705":122101,"_2959":122102},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3475":72217,"_30471":72210,"_5":30820,"_21105":122104,"_27705":122105,"_2959":122106},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3475":72218,"_30471":72210,"_5":30820,"_21105":122108,"_27705":122109,"_2959":122048},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3475":72219,"_30471":72210,"_5":30820,"_21105":122111,"_27705":122112,"_2959":122113},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3475":72220,"_30471":72210,"_5":30820,"_21105":122115,"_27705":122116,"_2959":122117},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3475":72221,"_30471":72210,"_21105":122119,"_5":14473,"_27705":72210,"_2959":122120},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3475":72222,"_30471":72210,"_21105":122122,"_5":14473,"_27705":72210,"_2959":122123},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3475":72223,"_30471":72210,"_21105":122125,"_5":14473,"_27705":122086,"_2959":122126},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3475":72224,"_30471":72210,"_21105":122128,"_5":14473,"_27705":122086,"_2959":122129},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3475":72225,"_30471":72210,"_21105":122131,"_5":14473,"_27705":122086,"_2959":122132},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3475":72226,"_30471":72210,"_21105":122134,"_5":14473,"_27705":122086,"_2959":122135},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3475":72227,"_30471":72210,"_21105":122137,"_5":14473,"_27705":122089,"_2959":122138},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3475":72228,"_30471":72210,"_21105":122140,"_5":14473,"_27705":122089,"_2959":122141},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3475":72229,"_30471":72210,"_21105":122143,"_5":14473,"_27705":122089,"_2959":122144},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3475":72230,"_30471":72210,"_21105":122146,"_5":14473,"_27705":122089,"_2959":122147},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3475":72231,"_30471":72210,"_21105":122149,"_5":14473,"_27705":122089,"_2959":122150},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3475":72232,"_30471":72210,"_21105":122152,"_5":14473,"_27705":122089,"_2959":122153},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3475":72233,"_30471":72210,"_21105":122155,"_5":14473,"_27705":122089,"_2959":122156},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3475":72234,"_30471":72210,"_21105":122158,"_5":14473,"_27705":122089,"_2959":122159},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3475":72235,"_30471":72210,"_21105":122161,"_5":14473,"_27705":122093,"_2959":122162},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3475":72236,"_30471":72210,"_21105":122164,"_5":14473,"_27705":122093,"_2959":54821},[],{"_3475":72237,"_30471":72210,"_21105":122166,"_5":14473,"_27705":122093,"_2959":122167},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3475":72238,"_30471":72210,"_21105":122169,"_5":14473,"_27705":122093,"_2959":122170},[],"**Icon** y **Tags**: clasificación opcional.",{"_3475":72239,"_30471":72210,"_21105":122172,"_5":14473,"_27705":122093,"_2959":122173},[],"Confirma el registro.",{"_3475":72240,"_30471":72210,"_21105":122175,"_5":14473,"_27705":122097,"_2959":122176},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3475":72241,"_30471":72210,"_21105":122178,"_5":14473,"_27705":122097,"_2959":122179},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3475":72242,"_30471":72210,"_21105":122181,"_5":14473,"_27705":122101,"_2959":122182},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3475":72243,"_30471":72210,"_21105":122184,"_5":14473,"_27705":122101,"_2959":122185},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3475":72244,"_30471":72210,"_21105":122187,"_5":14473,"_27705":122105,"_2959":122188},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3475":72245,"_30471":72210,"_21105":122190,"_5":14473,"_27705":122105,"_2959":122191},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3475":72246,"_30471":72210,"_21105":122193,"_5":14473,"_27705":122109,"_2959":122045},[],{"_3475":72247,"_30471":72210,"_21105":122195,"_5":14473,"_27705":122109,"_2959":122196},[],"Resultado",{"_3475":72248,"_30471":72210,"_21105":122198,"_5":14473,"_27705":122109,"_2959":121327},[],{"_3475":72249,"_30471":72210,"_21105":122200,"_5":14473,"_27705":122109,"_2959":122201},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3475":72250,"_30471":72210,"_21105":122203,"_5":14473,"_27705":122109,"_2959":122204},[],"Identidad actual",{"_3475":72251,"_30471":72210,"_21105":122206,"_5":14473,"_27705":122109,"_2959":122207},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3475":72252,"_30471":72210,"_21105":122209,"_5":14473,"_27705":122109,"_2959":122210},[],"Historial",{"_3475":72253,"_30471":72210,"_21105":122212,"_5":14473,"_27705":122109,"_2959":122213},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3475":72254,"_30471":72210,"_21105":122215,"_5":14473,"_27705":122109,"_2959":122216},[],"Clave y certificado",{"_3475":72255,"_30471":72210,"_21105":122218,"_5":14473,"_27705":122109,"_2959":122219},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3475":72256,"_30471":72210,"_21105":122221,"_5":14473,"_27705":122112,"_2959":122222},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3475":72257,"_30471":72210,"_21105":122224,"_5":14473,"_27705":122112,"_2959":122225},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3475":72258,"_30471":72210,"_21105":122227,"_5":14473,"_27705":122112,"_2959":122228},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3475":72259,"_30471":72210,"_21105":122230,"_5":14473,"_27705":122112,"_2959":122231},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3475":72260,"_30471":72210,"_21105":122233,"_5":14473,"_27705":122116,"_2959":122234},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3475":72261,"_30471":72210,"_21105":122236,"_5":14473,"_27705":122116,"_2959":122237},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3475":72262,"_30471":72210,"_21105":122239,"_5":14473,"_27705":122116,"_2959":122240},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3475":72263,"_30471":72263,"_5":14825,"_2959":122242,"_30823":122243,"_21105":122244,"_27705":72263},"Plataforma Lamassu IoT",[49595,118538],[],{"_3475":72264,"_30471":72263,"_21105":122246,"_5":14473,"_27705":72263,"_2959":122247},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3475":72265,"_30471":72263,"_5":30820,"_21105":122249,"_27705":122250,"_2959":121742},[],"/docs/pr-preview/pr-67/es/platform/overview#empieza-aquí",{"_3475":72266,"_30471":72263,"_5":30820,"_21105":122252,"_27705":122253,"_2959":122254},[],"/docs/pr-preview/pr-67/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3475":72267,"_30471":72263,"_5":30820,"_21105":122256,"_27705":122257,"_2959":122258},[],"/docs/pr-preview/pr-67/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3475":72268,"_30471":72263,"_5":30820,"_21105":122260,"_27705":122261,"_2959":122262},[],"/docs/pr-preview/pr-67/es/platform/overview#capacidades-principales","Capacidades principales",{"_3475":72269,"_30471":72263,"_5":30820,"_21105":122264,"_27705":122265,"_2959":122266},[],"/docs/pr-preview/pr-67/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3475":72270,"_30471":72263,"_5":30820,"_21105":122268,"_27705":122269,"_2959":122270},[],"/docs/pr-preview/pr-67/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3475":72271,"_30471":72263,"_5":30820,"_21105":122272,"_27705":122273,"_2959":122274},[],"/docs/pr-preview/pr-67/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3475":72272,"_30471":72263,"_5":30820,"_21105":122276,"_27705":122277,"_2959":122278},[],"/docs/pr-preview/pr-67/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3475":72273,"_30471":72263,"_5":30820,"_21105":122280,"_27705":122281,"_2959":122282},[],"/docs/pr-preview/pr-67/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3475":72274,"_30471":72263,"_5":30820,"_21105":122284,"_27705":122285,"_2959":122286},[],"/docs/pr-preview/pr-67/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3475":72275,"_30471":72263,"_5":30820,"_21105":122288,"_27705":122289,"_2959":122290},[],"/docs/pr-preview/pr-67/es/platform/overview#referencia-operativa","Referencia operativa",{"_3475":72276,"_30471":72263,"_21105":122292,"_5":14473,"_27705":72263,"_2959":122293},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3475":72277,"_30471":72263,"_21105":122295,"_5":14473,"_27705":122250,"_2959":122296},[],"Elige el resultado que necesitas obtener:",{"_3475":72278,"_30471":72263,"_21105":122298,"_5":14473,"_27705":122250,"_2959":122299},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3475":72279,"_30471":72263,"_21105":122301,"_5":14473,"_27705":122250,"_2959":122302},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3475":72280,"_30471":72263,"_21105":122304,"_5":14473,"_27705":122250,"_2959":122305},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3475":72281,"_30471":72263,"_21105":122307,"_5":14473,"_27705":122253,"_2959":122308},[],"Bloque",{"_3475":72282,"_30471":72263,"_21105":122310,"_5":14473,"_27705":122253,"_2959":122311},[],"Qué gestionas",{"_3475":72283,"_30471":72263,"_21105":122313,"_5":14473,"_27705":122253,"_2959":122314},[],"Punto de entrada",{"_3475":72284,"_30471":72263,"_21105":122316,"_5":14473,"_27705":122253,"_2959":54974},[],{"_3475":72285,"_30471":72263,"_21105":122318,"_5":14473,"_27705":122253,"_2959":122319},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3475":72286,"_30471":72263,"_21105":122321,"_5":14473,"_27705":122253,"_2959":122322},[],"Visión general de PKI",{"_3475":72287,"_30471":72263,"_21105":122324,"_5":14473,"_27705":122253,"_2959":54983},[],{"_3475":72288,"_30471":72263,"_21105":122326,"_5":14473,"_27705":122253,"_2959":122327},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3475":72289,"_30471":72263,"_21105":122329,"_5":14473,"_27705":122253,"_2959":122330},[],"Visión general de IoT Fleets",{"_3475":72290,"_30471":72263,"_21105":122332,"_5":14473,"_27705":122253,"_2959":122333},[],"**Administración**",{"_3475":72291,"_30471":72263,"_21105":122335,"_5":14473,"_27705":122253,"_2959":122336},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3475":72292,"_30471":72263,"_21105":122338,"_5":14473,"_27705":122253,"_2959":118536},[],{"_3475":72293,"_30471":72263,"_21105":122340,"_5":14473,"_27705":122253,"_2959":122341},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3475":72294,"_30471":72263,"_21105":122343,"_5":14473,"_27705":122257,"_2959":122344},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3475":72295,"_30471":72263,"_21105":122346,"_5":14473,"_27705":122257,"_2959":122347},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3475":72296,"_30471":72263,"_21105":122349,"_5":14473,"_27705":122257,"_2959":122350},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3475":72297,"_30471":72263,"_21105":122352,"_5":14473,"_27705":122257,"_2959":122353},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3475":72298,"_30471":72263,"_21105":122355,"_5":14473,"_27705":122257,"_2959":122356},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3475":72299,"_30471":72263,"_21105":122358,"_5":14473,"_27705":122257,"_2959":122359},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3475":72300,"_30471":72263,"_21105":122361,"_5":14473,"_27705":122265,"_2959":122362},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3475":72301,"_30471":72263,"_21105":122364,"_5":14473,"_27705":122269,"_2959":122365},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3475":72302,"_30471":72263,"_21105":122367,"_5":14473,"_27705":122273,"_2959":122368},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3475":72303,"_30471":72263,"_21105":122370,"_5":14473,"_27705":122277,"_2959":122371},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3475":72304,"_30471":72263,"_21105":122373,"_5":14473,"_27705":122281,"_2959":122374},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3475":72305,"_30471":72263,"_21105":122376,"_5":14473,"_27705":122285,"_2959":122377},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3475":72306,"_30471":72263,"_21105":122379,"_5":14473,"_27705":122289,"_2959":121835},[],{"_3475":72307,"_30471":72263,"_21105":122381,"_5":14473,"_27705":122289,"_2959":122382},[],"Qué prepara o comprueba",{"_3475":72308,"_30471":72263,"_21105":122384,"_5":14473,"_27705":122289,"_2959":121838},[],{"_3475":72309,"_30471":72263,"_21105":122386,"_5":14473,"_27705":122289,"_2959":122387},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3475":72310,"_30471":72263,"_21105":122389,"_5":14473,"_27705":122289,"_2959":122390},[],"Administrador de la flota",{"_3475":72311,"_30471":72263,"_21105":122392,"_5":14473,"_27705":122289,"_2959":122393},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3475":72312,"_30471":72263,"_21105":122395,"_5":14473,"_27705":122289,"_2959":121850},[],{"_3475":72313,"_30471":72263,"_21105":122397,"_5":14473,"_27705":122289,"_2959":122398},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3475":72314,"_30471":72263,"_21105":122400,"_5":14473,"_27705":122289,"_2959":121856},[],{"_3475":72315,"_30471":72263,"_21105":122402,"_5":14473,"_27705":122289,"_2959":122403},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3475":72316,"_30471":72263,"_21105":122405,"_5":14473,"_27705":122289,"_2959":122406},[],"Operador de infraestructura",{"_3475":72317,"_30471":72263,"_21105":122408,"_5":14473,"_27705":122289,"_2959":122409},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3475":72318,"_30471":72263,"_21105":122411,"_5":14473,"_27705":122289,"_2959":122412},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3475":72319,"_30471":72319,"_5":14825,"_2959":122414,"_30823":122415,"_21105":122417,"_27705":72319},"Jerarquía y rotación de CAs",[49595,118538,55075,122416],"Claves, autoridades y certificados",[],{"_3475":72320,"_30471":72319,"_21105":122419,"_5":14473,"_27705":72319,"_2959":122420},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3475":72321,"_30471":72319,"_5":30820,"_21105":122422,"_27705":122423,"_2959":122424},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3475":72322,"_30471":72319,"_5":30820,"_21105":122426,"_27705":122427,"_2959":122428},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3475":72323,"_30471":72319,"_5":30820,"_21105":122430,"_27705":122431,"_2959":122432},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3475":72324,"_30471":72319,"_5":30820,"_21105":122434,"_27705":122435,"_2959":122436},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3475":72325,"_30471":72319,"_5":30820,"_21105":122438,"_27705":122439,"_2959":122440},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3475":72326,"_30471":72319,"_5":30820,"_21105":122442,"_27705":122443,"_2959":122444},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3475":72327,"_30471":72319,"_5":30820,"_21105":122446,"_27705":122447,"_2959":122448},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3475":72328,"_30471":72319,"_5":30820,"_21105":122450,"_27705":122451,"_2959":122452},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3475":72329,"_30471":72319,"_5":30820,"_21105":122454,"_27705":122455,"_2959":122456},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3475":72330,"_30471":72319,"_5":30820,"_21105":122458,"_27705":122459,"_2959":122460},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3475":72331,"_30471":72319,"_5":30820,"_21105":122462,"_27705":122463,"_2959":122464},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3475":72332,"_30471":72319,"_5":30820,"_21105":122466,"_27705":122467,"_2959":122468},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3475":72333,"_30471":72319,"_21105":122470,"_5":14473,"_27705":72319,"_2959":122471},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3475":72334,"_30471":72319,"_21105":122473,"_5":14473,"_27705":72319,"_2959":122474},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3475":72335,"_30471":72319,"_21105":122476,"_5":14473,"_27705":122423,"_2959":122477},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3475":72336,"_30471":72319,"_21105":122479,"_5":14473,"_27705":122423,"_2959":122480},[],"entorno, como producción y preproducción;",{"_3475":72337,"_30471":72319,"_21105":122482,"_5":14473,"_27705":122423,"_2959":122483},[],"propietario o equipo operador;",{"_3475":72338,"_30471":72319,"_21105":122485,"_5":14473,"_27705":122423,"_2959":122486},[],"familia de dispositivos o proceso de fabricación;",{"_3475":72339,"_30471":72319,"_21105":122488,"_5":14473,"_27705":122423,"_2959":122489},[],"región o requisito regulatorio;",{"_3475":72340,"_30471":72319,"_21105":122491,"_5":14473,"_27705":122423,"_2959":122492},[],"motor criptográfico o política de clave;",{"_3475":72341,"_30471":72319,"_21105":122494,"_5":14473,"_27705":122423,"_2959":122495},[],"ventana de mantenimiento y ritmo de renovación.",{"_3475":72342,"_30471":72319,"_21105":122497,"_5":14473,"_27705":122423,"_2959":122498},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3475":72343,"_30471":72319,"_21105":122500,"_5":14473,"_27705":122423,"_2959":122501},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3475":72344,"_30471":72319,"_21105":122503,"_5":14473,"_27705":122427,"_2959":122504},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3475":72345,"_30471":72319,"_21105":122506,"_5":14473,"_27705":122427,"_2959":122507},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3475":72346,"_30471":72319,"_21105":122509,"_5":14473,"_27705":122427,"_2959":122510},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3475":72347,"_30471":72319,"_21105":122512,"_5":14473,"_27705":122427,"_2959":122513},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3475":72348,"_30471":72319,"_21105":122515,"_5":14473,"_27705":122431,"_2959":122516},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3475":72349,"_30471":72319,"_21105":122518,"_5":14473,"_27705":122431,"_2959":122519},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3475":72350,"_30471":72319,"_21105":122521,"_5":14473,"_27705":122431,"_2959":122522},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3475":72351,"_30471":72319,"_21105":122524,"_5":14473,"_27705":122431,"_2959":122525},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3475":72352,"_30471":72319,"_21105":122527,"_5":14473,"_27705":122439,"_2959":122528},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3475":72353,"_30471":72319,"_21105":122530,"_5":14473,"_27705":122443,"_2959":122531},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3475":72354,"_30471":72319,"_21105":122533,"_5":14473,"_27705":122447,"_2959":122534},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3475":72355,"_30471":72319,"_21105":122536,"_5":14473,"_27705":122451,"_2959":122537},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3475":72356,"_30471":72319,"_21105":122539,"_5":14473,"_27705":122455,"_2959":122540},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3475":72357,"_30471":72319,"_21105":122542,"_5":14473,"_27705":122459,"_2959":122543},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3475":72358,"_30471":72319,"_21105":122545,"_5":14473,"_27705":122463,"_2959":122546},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3475":72359,"_30471":72319,"_21105":122548,"_5":14473,"_27705":122463,"_2959":122549},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3475":72360,"_30471":72319,"_21105":122551,"_5":14473,"_27705":122463,"_2959":122552},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3475":72361,"_30471":72319,"_21105":122554,"_5":14473,"_27705":122463,"_2959":122555},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3475":72362,"_30471":72319,"_21105":122557,"_5":14473,"_27705":122467,"_2959":122558},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3475":72363,"_30471":72319,"_21105":122560,"_5":14473,"_27705":122467,"_2959":122561},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3475":72364,"_30471":72319,"_21105":122563,"_5":14473,"_27705":122467,"_2959":122564},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3475":72365,"_30471":72319,"_21105":122566,"_5":14473,"_27705":122467,"_2959":122567},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3475":72366,"_30471":72319,"_21105":122569,"_5":14473,"_27705":122467,"_2959":122570},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3475":72367,"_30471":72319,"_21105":122572,"_5":14473,"_27705":122467,"_2959":122573},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3475":72368,"_30471":72319,"_21105":122575,"_5":14473,"_27705":122467,"_2959":122576},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3475":72369,"_30471":72369,"_5":14825,"_2959":122578,"_30823":122579,"_21105":122580,"_27705":72369},"Autoridades de certificación",[49595,118538,55075,122416],[],{"_3475":72370,"_30471":72369,"_21105":122582,"_5":14473,"_27705":72369,"_2959":122583},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3475":72371,"_30471":72369,"_5":30820,"_21105":122585,"_27705":122586,"_2959":122587},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3475":72372,"_30471":72369,"_5":30820,"_21105":122589,"_27705":122590,"_2959":122591},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3475":72373,"_30471":72369,"_5":30820,"_21105":122593,"_27705":122594,"_2959":117109},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3475":72374,"_30471":72369,"_5":30820,"_21105":122596,"_27705":122597,"_2959":122598},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3475":72375,"_30471":72369,"_5":30820,"_21105":122600,"_27705":122601,"_2959":122602},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3475":72376,"_30471":72369,"_5":30820,"_21105":122604,"_27705":122605,"_2959":122606},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3475":72377,"_30471":72369,"_5":30820,"_21105":122608,"_27705":122609,"_2959":122610},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3475":72378,"_30471":72369,"_5":30820,"_21105":122612,"_27705":122613,"_2959":122614},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3475":72379,"_30471":72369,"_5":30820,"_21105":122616,"_27705":122617,"_2959":122618},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3475":72380,"_30471":72369,"_5":30820,"_21105":122620,"_27705":122621,"_2959":122622},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3475":72381,"_30471":72369,"_5":30820,"_21105":122624,"_27705":122625,"_2959":122626},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3475":72382,"_30471":72369,"_5":30820,"_21105":122628,"_27705":122629,"_2959":122630},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3475":72383,"_30471":72369,"_5":30820,"_21105":122632,"_27705":122633,"_2959":122634},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3475":72384,"_30471":72369,"_5":30820,"_21105":122636,"_27705":122637,"_2959":122638},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3475":72385,"_30471":72369,"_5":30820,"_21105":122640,"_27705":122641,"_2959":122642},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3475":72386,"_30471":72369,"_5":30820,"_21105":122644,"_27705":122645,"_2959":122646},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3475":72387,"_30471":72369,"_5":30820,"_21105":122648,"_27705":122649,"_2959":122650},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3475":72388,"_30471":72369,"_5":30820,"_21105":122652,"_27705":122653,"_2959":122654},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3475":72389,"_30471":72369,"_5":30820,"_21105":122656,"_27705":122657,"_2959":122658},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3475":72390,"_30471":72369,"_5":30820,"_21105":122660,"_27705":122661,"_2959":122662},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3475":72391,"_30471":72369,"_5":30820,"_21105":122664,"_27705":122665,"_2959":122666},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3475":72392,"_30471":72369,"_5":30820,"_21105":122668,"_27705":122669,"_2959":122670},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3475":72393,"_30471":72369,"_5":30820,"_21105":122672,"_27705":122673,"_2959":122674},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3475":72394,"_30471":72369,"_21105":122676,"_5":14473,"_27705":72369,"_2959":122677},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3475":72395,"_30471":72369,"_21105":122679,"_5":14473,"_27705":72369,"_2959":122680},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3475":72396,"_30471":72369,"_21105":122682,"_5":14473,"_27705":72369,"_2959":122683},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3475":72397,"_30471":72369,"_21105":122685,"_5":14473,"_27705":122586,"_2959":122686},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3475":72398,"_30471":72369,"_21105":122688,"_5":14473,"_27705":122586,"_2959":122689},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3475":72399,"_30471":72369,"_21105":122691,"_5":14473,"_27705":122586,"_2959":122692},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3475":72400,"_30471":72369,"_21105":122694,"_5":14473,"_27705":122586,"_2959":122695},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3475":72401,"_30471":72369,"_21105":122697,"_5":14473,"_27705":122586,"_2959":122698},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3475":72402,"_30471":72369,"_21105":122700,"_5":14473,"_27705":122594,"_2959":122701},[],"Decide si la CA será raíz o intermedia.",{"_3475":72403,"_30471":72369,"_21105":122703,"_5":14473,"_27705":122594,"_2959":122704},[],"Elige el motor que custodiará la clave.",{"_3475":72404,"_30471":72369,"_21105":122706,"_5":14473,"_27705":122594,"_2959":122707},[],"Define una validez superior a la de los certificados que emitirá.",{"_3475":72405,"_30471":72369,"_21105":122709,"_5":14473,"_27705":122594,"_2959":122710},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3475":72406,"_30471":72369,"_21105":122712,"_5":14473,"_27705":122597,"_2959":122713},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3475":72407,"_30471":72369,"_21105":122715,"_5":14473,"_27705":122601,"_2959":122716},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3475":72408,"_30471":72369,"_21105":122718,"_5":14473,"_27705":122601,"_2959":122719},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3475":72409,"_30471":72369,"_21105":122721,"_5":14473,"_27705":122605,"_2959":122722},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3475":72410,"_30471":72369,"_21105":122724,"_5":14473,"_27705":122609,"_2959":122725},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3475":72411,"_30471":72369,"_21105":122727,"_5":14473,"_27705":122609,"_2959":122728},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3475":72412,"_30471":72369,"_21105":122730,"_5":14473,"_27705":122609,"_2959":122731},[],"`ST`: estado o provincia.",{"_3475":72413,"_30471":72369,"_21105":122733,"_5":14473,"_27705":122609,"_2959":122734},[],"`L`: localidad.",{"_3475":72414,"_30471":72369,"_21105":122736,"_5":14473,"_27705":122609,"_2959":122737},[],"`O`: organización.",{"_3475":72415,"_30471":72369,"_21105":122739,"_5":14473,"_27705":122609,"_2959":122740},[],"`OU`: unidad organizativa.",{"_3475":72416,"_30471":72369,"_21105":122742,"_5":14473,"_27705":122609,"_2959":122743},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3475":72417,"_30471":72369,"_21105":122745,"_5":14473,"_27705":122613,"_2959":122746},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3475":72418,"_30471":72369,"_21105":122748,"_5":14473,"_27705":122613,"_2959":122749},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3475":72419,"_30471":72369,"_21105":122751,"_5":14473,"_27705":122617,"_2959":122752},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3475":72420,"_30471":72369,"_21105":122754,"_5":14473,"_27705":122617,"_2959":122755},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3475":72421,"_30471":72369,"_21105":122757,"_5":14473,"_27705":122621,"_2959":122758},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3475":72422,"_30471":72369,"_21105":122760,"_5":14473,"_27705":122621,"_2959":122761},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3475":72423,"_30471":72369,"_21105":122763,"_5":14473,"_27705":122625,"_2959":122764},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3475":72424,"_30471":72369,"_21105":122766,"_5":14473,"_27705":122625,"_2959":122767},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3475":72425,"_30471":72369,"_21105":122769,"_5":14473,"_27705":122625,"_2959":122770},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3475":72426,"_30471":72369,"_21105":122772,"_5":14473,"_27705":122629,"_2959":122773},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3475":72427,"_30471":72369,"_21105":122775,"_5":14473,"_27705":122633,"_2959":122776},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3475":72428,"_30471":72369,"_21105":122778,"_5":14473,"_27705":122633,"_2959":122779},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3475":72429,"_30471":72369,"_21105":122781,"_5":14473,"_27705":122637,"_2959":122782},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3475":72430,"_30471":72369,"_21105":122784,"_5":14473,"_27705":122641,"_2959":122785},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3475":72431,"_30471":72369,"_21105":122787,"_5":14473,"_27705":122641,"_2959":122788},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3475":72432,"_30471":72369,"_21105":122790,"_5":14473,"_27705":122645,"_2959":122791},[],"Abre una CA desde el inventario para consultar:",{"_3475":72433,"_30471":72369,"_21105":122793,"_5":14473,"_27705":122645,"_2959":122794},[],"Estado y periodo de validez.",{"_3475":72434,"_30471":72369,"_21105":122796,"_5":14473,"_27705":122645,"_2959":122797},[],"Certificado y cadena en formato PEM.",{"_3475":72435,"_30471":72369,"_21105":122799,"_5":14473,"_27705":122645,"_2959":122800},[],"Número de certificados activos, expirados y revocados.",{"_3475":72436,"_30471":72369,"_21105":122802,"_5":14473,"_27705":122645,"_2959":122803},[],"Certificados emitidos en **Issued Certificates**.",{"_3475":72437,"_30471":72369,"_21105":122805,"_5":14473,"_27705":122645,"_2959":122806},[],"CRL vinculada a la autoridad.",{"_3475":72438,"_30471":72369,"_21105":122808,"_5":14473,"_27705":122645,"_2959":122809},[],"Metadatos y motor criptográfico asociado.",{"_3475":72439,"_30471":72369,"_21105":122811,"_5":14473,"_27705":122645,"_2959":122812},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3475":72440,"_30471":72369,"_21105":122814,"_5":14473,"_27705":122649,"_2959":122815},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3475":72441,"_30471":72369,"_21105":122817,"_5":14473,"_27705":122649,"_2959":122818},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3475":72442,"_30471":72369,"_21105":122820,"_5":14473,"_27705":122649,"_2959":122821},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3475":72443,"_30471":72369,"_21105":122823,"_5":14473,"_27705":122649,"_2959":122824},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3475":72444,"_30471":72369,"_21105":122826,"_5":14473,"_27705":122653,"_2959":122827},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3475":72445,"_30471":72369,"_21105":122829,"_5":14473,"_27705":122657,"_2959":122830},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3475":72446,"_30471":72369,"_21105":122832,"_5":14473,"_27705":122661,"_2959":122833},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3475":72447,"_30471":72369,"_21105":122835,"_5":14473,"_27705":122665,"_2959":122836},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3475":72448,"_30471":72369,"_21105":122838,"_5":14473,"_27705":122669,"_2959":122839},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3475":72449,"_30471":72369,"_21105":122841,"_5":14473,"_27705":122673,"_2959":122842},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3475":72450,"_30471":72369,"_21105":122844,"_5":14473,"_27705":122673,"_2959":122845},[],"Los ajustes de CRL de la CA se conservan y no pueden borrarse por API. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3475":72451,"_30471":72369,"_21105":122847,"_5":14473,"_27705":122673,"_2959":122848},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3475":72452,"_30471":72452,"_5":14825,"_2959":122850,"_30823":122851,"_21105":122852,"_27705":72452},"Perfiles de certificado",[49595,118538,55075,122416],[],{"_3475":72453,"_30471":72452,"_21105":122854,"_5":14473,"_27705":72452,"_2959":122855},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3475":72454,"_30471":72452,"_5":30820,"_21105":122857,"_27705":122858,"_2959":122859},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3475":72455,"_30471":72452,"_5":30820,"_21105":122861,"_27705":122862,"_2959":122863},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#validez","Validez",{"_3475":72456,"_30471":72452,"_5":30820,"_21105":122865,"_27705":122866,"_2959":122867},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3475":72457,"_30471":72452,"_5":30820,"_21105":122869,"_27705":122870,"_2959":122871},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3475":72458,"_30471":72452,"_5":30820,"_21105":122873,"_27705":122874,"_2959":122875},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3475":72459,"_30471":72452,"_5":30820,"_21105":122877,"_27705":122878,"_2959":122879},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3475":72460,"_30471":72452,"_5":30820,"_21105":122881,"_27705":122882,"_2959":122883},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3475":72461,"_30471":72452,"_5":30820,"_21105":122885,"_27705":122886,"_2959":122887},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3475":72462,"_30471":72452,"_5":30820,"_21105":122889,"_27705":122890,"_2959":122891},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3475":72463,"_30471":72452,"_5":30820,"_21105":122893,"_27705":122894,"_2959":122895},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3475":72464,"_30471":72452,"_5":30820,"_21105":122897,"_27705":122898,"_2959":122899},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3475":72465,"_30471":72452,"_5":30820,"_21105":122901,"_27705":122902,"_2959":122903},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3475":72466,"_30471":72452,"_5":30820,"_21105":122905,"_27705":122906,"_2959":122907},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3475":72467,"_30471":72452,"_5":30820,"_21105":122909,"_27705":122910,"_2959":122911},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3475":72468,"_30471":72452,"_5":30820,"_21105":122913,"_27705":122914,"_2959":122915},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3475":72469,"_30471":72452,"_5":30820,"_21105":122917,"_27705":122918,"_2959":122919},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3475":72470,"_30471":72452,"_21105":122921,"_5":14473,"_27705":72452,"_2959":122922},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3475":72471,"_30471":72452,"_21105":122924,"_5":14473,"_27705":72452,"_2959":122925},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3475":72472,"_30471":72452,"_21105":122927,"_5":14473,"_27705":122862,"_2959":122928},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3475":72473,"_30471":72452,"_21105":122930,"_5":14473,"_27705":122862,"_2959":122931},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3475":72474,"_30471":72452,"_21105":122933,"_5":14473,"_27705":122866,"_2959":122934},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3475":72475,"_30471":72452,"_21105":122936,"_5":14473,"_27705":122870,"_2959":122937},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3475":72476,"_30471":72452,"_21105":122939,"_5":14473,"_27705":122870,"_2959":122940},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3475":72477,"_30471":72452,"_21105":122942,"_5":14473,"_27705":122870,"_2959":122943},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3475":72478,"_30471":72452,"_21105":122945,"_5":14473,"_27705":122874,"_2959":122946},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3475":72479,"_30471":72452,"_21105":122948,"_5":14473,"_27705":122878,"_2959":122949},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3475":72480,"_30471":72452,"_21105":122951,"_5":14473,"_27705":122878,"_2959":122952},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3475":72481,"_30471":72452,"_21105":122954,"_5":14473,"_27705":122882,"_2959":122955},[],"La aplicación criptográfica puede:",{"_3475":72482,"_30471":72452,"_21105":122957,"_5":14473,"_27705":122882,"_2959":122958},[],"permitir o bloquear claves RSA;",{"_3475":72483,"_30471":72452,"_21105":122960,"_5":14473,"_27705":122882,"_2959":122961},[],"limitar los tamaños RSA admitidos;",{"_3475":72484,"_30471":72452,"_21105":122963,"_5":14473,"_27705":122882,"_2959":122964},[],"permitir o bloquear claves ECDSA;",{"_3475":72485,"_30471":72452,"_21105":122966,"_5":14473,"_27705":122882,"_2959":122967},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3475":72486,"_30471":72452,"_21105":122969,"_5":14473,"_27705":122882,"_2959":122970},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3475":72487,"_30471":72452,"_21105":122972,"_5":14473,"_27705":122886,"_2959":122973},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3475":72488,"_30471":72452,"_21105":122975,"_5":14473,"_27705":122886,"_2959":118298},[],{"_3475":72489,"_30471":72452,"_21105":122977,"_5":14473,"_27705":122886,"_2959":122978},[],"Primera opción",{"_3475":72490,"_30471":72452,"_21105":122980,"_5":14473,"_27705":122886,"_2959":122981},[],"Segunda opción",{"_3475":72491,"_30471":72452,"_21105":122983,"_5":14473,"_27705":122886,"_2959":122984},[],"Si no hay ninguna",{"_3475":72492,"_30471":72452,"_21105":122986,"_5":14473,"_27705":122886,"_2959":122987},[],"Firma directa con una CA",{"_3475":72493,"_30471":72452,"_21105":122989,"_5":14473,"_27705":122886,"_2959":122990},[],"`issuance_profile` incluido en la solicitud",{"_3475":72494,"_30471":72452,"_21105":122992,"_5":14473,"_27705":122886,"_2959":122993},[],"`issuance_profile_id` de la solicitud",{"_3475":72495,"_30471":72452,"_21105":122995,"_5":14473,"_27705":122886,"_2959":122996},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3475":72496,"_30471":72452,"_21105":122998,"_5":14473,"_27705":122886,"_2959":122999},[],"Emisión mediante DMS",{"_3475":72497,"_30471":72452,"_21105":123001,"_5":14473,"_27705":122886,"_2959":55662},[],{"_3475":72498,"_30471":72452,"_21105":123003,"_5":14473,"_27705":122886,"_2959":123004},[],"`settings.issuance_profile` incluido en el DMS",{"_3475":72499,"_30471":72452,"_21105":123006,"_5":14473,"_27705":122886,"_2959":123007},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3475":72500,"_30471":72452,"_21105":123009,"_5":14473,"_27705":122886,"_2959":123010},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3475":72501,"_30471":72452,"_21105":123012,"_5":14473,"_27705":122886,"_2959":123013},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3475":72502,"_30471":72452,"_21105":123015,"_5":14473,"_27705":122894,"_2959":123016},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3475":72503,"_30471":72452,"_21105":123018,"_5":14473,"_27705":122898,"_2959":123019},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3475":72504,"_30471":72452,"_21105":123021,"_5":14473,"_27705":122902,"_2959":123022},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3475":72505,"_30471":72452,"_21105":123024,"_5":14473,"_27705":122906,"_2959":123025},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3475":72506,"_30471":72452,"_21105":123027,"_5":14473,"_27705":122910,"_2959":123028},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3475":72507,"_30471":72452,"_21105":123030,"_5":14473,"_27705":122910,"_2959":123031},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3475":72508,"_30471":72452,"_21105":123033,"_5":14473,"_27705":122914,"_2959":123034},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3475":72509,"_30471":72452,"_21105":123036,"_5":14473,"_27705":122914,"_2959":123037},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3475":72510,"_30471":72452,"_21105":123039,"_5":14473,"_27705":122914,"_2959":123040},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3475":72511,"_30471":72452,"_21105":123042,"_5":14473,"_27705":122914,"_2959":123043},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3475":72512,"_30471":72452,"_21105":123045,"_5":14473,"_27705":122918,"_2959":123046},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3475":72513,"_30471":72452,"_21105":123048,"_5":14473,"_27705":122918,"_2959":123049},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3475":72514,"_30471":72514,"_5":14825,"_2959":123051,"_30823":123052,"_21105":123054,"_27705":72514},"Validación de certificados",[49595,118538,55075,123053],"Validación",[],{"_3475":72515,"_30471":72514,"_21105":123056,"_5":14473,"_27705":72514,"_2959":123057},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3475":72516,"_30471":72514,"_5":30820,"_21105":123059,"_27705":123060,"_2959":123061},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3475":72517,"_30471":72514,"_5":30820,"_21105":123063,"_27705":123064,"_2959":123065},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3475":72518,"_30471":72514,"_5":30820,"_21105":123067,"_27705":123068,"_2959":123069},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3475":72519,"_30471":72514,"_21105":123071,"_5":14473,"_27705":72514,"_2959":123072},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3475":72520,"_30471":72514,"_21105":123074,"_5":14473,"_27705":123060,"_2959":123075},[],"Verifica estos criterios juntos:",{"_3475":72521,"_30471":72514,"_21105":123077,"_5":14473,"_27705":123060,"_2959":122045},[],{"_3475":72522,"_30471":72514,"_21105":123079,"_5":14473,"_27705":123060,"_2959":123080},[],"Resultado necesario",{"_3475":72523,"_30471":72514,"_21105":123082,"_5":14473,"_27705":123060,"_2959":123083},[],"Cadena y firma",{"_3475":72524,"_30471":72514,"_21105":123085,"_5":14473,"_27705":123060,"_2959":123086},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3475":72525,"_30471":72514,"_21105":123088,"_5":14473,"_27705":123060,"_2959":123089},[],"Fechas",{"_3475":72526,"_30471":72514,"_21105":123091,"_5":14473,"_27705":123060,"_2959":123092},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3475":72527,"_30471":72514,"_21105":123094,"_5":14473,"_27705":123060,"_2959":118208},[],{"_3475":72528,"_30471":72514,"_21105":123096,"_5":14473,"_27705":123060,"_2959":123097},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3475":72529,"_30471":72514,"_21105":123099,"_5":14473,"_27705":123060,"_2959":123100},[],"Uso",{"_3475":72530,"_30471":72514,"_21105":123102,"_5":14473,"_27705":123060,"_2959":123103},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3475":72531,"_30471":72514,"_21105":123105,"_5":14473,"_27705":123060,"_2959":123106},[],"Revocación",{"_3475":72532,"_30471":72514,"_21105":123108,"_5":14473,"_27705":123060,"_2959":123109},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3475":72533,"_30471":72514,"_21105":123111,"_5":14473,"_27705":123060,"_2959":123112},[],"Autorización",{"_3475":72534,"_30471":72514,"_21105":123114,"_5":14473,"_27705":123060,"_2959":123115},[],"La aplicación permite la acción a esa identidad.",{"_3475":72535,"_30471":72514,"_21105":123117,"_5":14473,"_27705":123060,"_2959":123118},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3475":72536,"_30471":72514,"_21105":123120,"_5":14473,"_27705":123064,"_2959":123121},[],"Mecanismo",{"_3475":72537,"_30471":72514,"_21105":123123,"_5":14473,"_27705":123064,"_2959":123124},[],"Cuándo utilizarlo",{"_3475":72538,"_30471":72514,"_21105":123126,"_5":14473,"_27705":123064,"_2959":123127},[],"Qué debes mantener",{"_3475":72539,"_30471":72514,"_21105":123129,"_5":14473,"_27705":123064,"_2959":55790},[],{"_3475":72540,"_30471":72514,"_21105":123131,"_5":14473,"_27705":123064,"_2959":123132},[],"Consulta del estado de un certificado concreto.",{"_3475":72541,"_30471":72514,"_21105":123134,"_5":14473,"_27705":123064,"_2959":123135},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3475":72542,"_30471":72514,"_21105":123137,"_5":14473,"_27705":123064,"_2959":55799},[],{"_3475":72543,"_30471":72514,"_21105":123139,"_5":14473,"_27705":123064,"_2959":123140},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3475":72544,"_30471":72514,"_21105":123142,"_5":14473,"_27705":123064,"_2959":123143},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3475":72545,"_30471":72514,"_21105":123145,"_5":14473,"_27705":123064,"_2959":123146},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3475":72546,"_30471":72514,"_21105":123148,"_5":14473,"_27705":123064,"_2959":123149},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3475":72547,"_30471":72514,"_21105":123151,"_5":14473,"_27705":123068,"_2959":123152},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3475":72548,"_30471":72514,"_21105":123154,"_5":14473,"_27705":123068,"_2959":123155},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3475":72549,"_30471":72514,"_21105":123157,"_5":14473,"_27705":123068,"_2959":123158},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3475":72550,"_30471":72514,"_21105":123160,"_5":14473,"_27705":123068,"_2959":123161},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3475":72551,"_30471":72514,"_21105":123163,"_5":14473,"_27705":123068,"_2959":123164},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3475":72552,"_30471":72514,"_21105":123166,"_5":14473,"_27705":123068,"_2959":123167},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3475":72553,"_30471":72514,"_21105":123169,"_5":14473,"_27705":123068,"_2959":123170},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3475":72554,"_30471":72514,"_21105":123172,"_5":14473,"_27705":123068,"_2959":123173},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":72555,"_30471":72514,"_21105":123175,"_5":14473,"_27705":123068,"_2959":123176},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3475":72556,"_30471":72556,"_5":14825,"_2959":123178,"_30823":123179,"_21105":123180,"_27705":72556},"Certificados",[49595,118538,55075,122416],[],{"_3475":72557,"_30471":72556,"_21105":123182,"_5":14473,"_27705":72556,"_2959":123183},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3475":72558,"_30471":72556,"_5":30820,"_21105":123185,"_27705":123186,"_2959":123187},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3475":72559,"_30471":72556,"_5":30820,"_21105":123189,"_27705":123190,"_2959":123191},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3475":72560,"_30471":72556,"_5":30820,"_21105":123193,"_27705":123194,"_2959":123195},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3475":72561,"_30471":72556,"_5":30820,"_21105":123197,"_27705":123198,"_2959":123199},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3475":72562,"_30471":72556,"_5":30820,"_21105":123201,"_27705":123202,"_2959":123203},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3475":72563,"_30471":72556,"_5":30820,"_21105":123205,"_27705":123206,"_2959":123207},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3475":72564,"_30471":72556,"_5":30820,"_21105":123209,"_27705":123210,"_2959":123211},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3475":72565,"_30471":72556,"_5":30820,"_21105":123213,"_27705":123214,"_2959":123215},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3475":72566,"_30471":72556,"_5":30820,"_21105":123217,"_27705":123218,"_2959":123219},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#continúa","Continúa",{"_3475":72567,"_30471":72556,"_21105":123221,"_5":14473,"_27705":72556,"_2959":123222},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3475":72568,"_30471":72556,"_21105":123224,"_5":14473,"_27705":123186,"_2959":123225},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3475":72569,"_30471":72556,"_21105":123227,"_5":14473,"_27705":123186,"_2959":123228},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3475":72570,"_30471":72556,"_21105":123230,"_5":14473,"_27705":123186,"_2959":123231},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3475":72571,"_30471":72556,"_21105":123233,"_5":14473,"_27705":123186,"_2959":123234},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3475":72572,"_30471":72556,"_21105":123236,"_5":14473,"_27705":123186,"_2959":123237},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3475":72573,"_30471":72556,"_21105":123239,"_5":14473,"_27705":123186,"_2959":123240},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3475":72574,"_30471":72556,"_21105":123242,"_5":14473,"_27705":123186,"_2959":123243},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3475":72575,"_30471":72556,"_21105":123245,"_5":14473,"_27705":123190,"_2959":123246},[],"Descarga el PEM e inspecciónalo:",{"_3475":72576,"_30471":72556,"_21105":123248,"_5":14473,"_27705":123190,"_2959":123249},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3475":72577,"_30471":72556,"_21105":123251,"_5":14473,"_27705":123194,"_2959":123252},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3475":72578,"_30471":72556,"_21105":123254,"_5":14473,"_27705":123194,"_2959":123255},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3475":72579,"_30471":72556,"_21105":123257,"_5":14473,"_27705":123194,"_2959":123258},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3475":72580,"_30471":72556,"_21105":123260,"_5":14473,"_27705":123194,"_2959":123261},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3475":72581,"_30471":72556,"_21105":123263,"_5":14473,"_27705":123194,"_2959":123264},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3475":72582,"_30471":72556,"_21105":123266,"_5":14473,"_27705":123194,"_2959":123267},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3475":72583,"_30471":72556,"_21105":123269,"_5":14473,"_27705":123194,"_2959":123270},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3475":72584,"_30471":72556,"_21105":123272,"_5":14473,"_27705":123198,"_2959":123273},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3475":72585,"_30471":72556,"_21105":123275,"_5":14473,"_27705":123202,"_2959":123276},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3475":72586,"_30471":72556,"_21105":123278,"_5":14473,"_27705":123206,"_2959":123279},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3475":72587,"_30471":72556,"_21105":123281,"_5":14473,"_27705":123210,"_2959":123282},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3475":72588,"_30471":72556,"_21105":123284,"_5":14473,"_27705":123210,"_2959":123285},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3475":72589,"_30471":72556,"_21105":123287,"_5":14473,"_27705":123210,"_2959":123288},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3475":72590,"_30471":72556,"_21105":123290,"_5":14473,"_27705":123214,"_2959":123291},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3475":72591,"_30471":72556,"_21105":123293,"_5":14473,"_27705":123214,"_2959":123294},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3475":72592,"_30471":72556,"_21105":123296,"_5":14473,"_27705":123214,"_2959":123297},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3475":72593,"_30471":72556,"_21105":123299,"_5":14473,"_27705":123218,"_2959":123300},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":72594,"_30471":72556,"_21105":123302,"_5":14473,"_27705":123218,"_2959":123303},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3475":72595,"_30471":72595,"_5":14825,"_2959":123305,"_30823":123306,"_21105":123308,"_27705":72595},"Ciclo de vida de un certificado",[49595,118538,55075,123307],"Conceptos",[],{"_3475":72596,"_30471":72595,"_21105":123310,"_5":14473,"_27705":72595,"_2959":123311},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3475":72597,"_30471":72595,"_5":30820,"_21105":123313,"_27705":123314,"_2959":123315},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3475":72598,"_30471":72595,"_5":30820,"_21105":123317,"_27705":123318,"_2959":123319},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3475":72599,"_30471":72595,"_5":30820,"_21105":123321,"_27705":123322,"_2959":123323},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3475":72600,"_30471":72595,"_5":30820,"_21105":123325,"_27705":123326,"_2959":123327},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3475":72601,"_30471":72595,"_5":30820,"_21105":123329,"_27705":123330,"_2959":123331},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3475":72602,"_30471":72595,"_5":30820,"_21105":123333,"_27705":123334,"_2959":123335},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3475":72603,"_30471":72595,"_5":30820,"_21105":123337,"_27705":123338,"_2959":121039},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3475":72604,"_30471":72595,"_5":30820,"_21105":123340,"_27705":123341,"_2959":123342},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3475":72605,"_30471":72595,"_5":30820,"_21105":123344,"_27705":123345,"_2959":123346},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3475":72606,"_30471":72595,"_5":30820,"_21105":123348,"_27705":123349,"_2959":123350},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3475":72607,"_30471":72595,"_21105":123352,"_5":14473,"_27705":72595,"_2959":123353},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3475":72608,"_30471":72595,"_21105":123355,"_5":14473,"_27705":123318,"_2959":123356},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3475":72609,"_30471":72595,"_21105":123358,"_5":14473,"_27705":123322,"_2959":123359},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3475":72610,"_30471":72595,"_21105":123361,"_5":14473,"_27705":123326,"_2959":123362},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3475":72611,"_30471":72595,"_21105":123364,"_5":14473,"_27705":123330,"_2959":123365},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3475":72612,"_30471":72595,"_21105":123367,"_5":14473,"_27705":123334,"_2959":123368},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3475":72613,"_30471":72595,"_21105":123370,"_5":14473,"_27705":123338,"_2959":123371},[],"Lamassu persiste cuatro estados X.509:",{"_3475":72614,"_30471":72595,"_21105":123373,"_5":14473,"_27705":123338,"_2959":123374},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3475":72615,"_30471":72595,"_21105":123376,"_5":14473,"_27705":123338,"_2959":123377},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3475":72616,"_30471":72595,"_21105":123379,"_5":14473,"_27705":123338,"_2959":123380},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3475":72617,"_30471":72595,"_21105":123382,"_5":14473,"_27705":123338,"_2959":123383},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3475":72618,"_30471":72595,"_21105":123385,"_5":14473,"_27705":123338,"_2959":123386},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3475":72619,"_30471":72595,"_21105":123388,"_5":14473,"_27705":123341,"_2959":123389},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3475":72620,"_30471":72595,"_21105":123391,"_5":14473,"_27705":123341,"_2959":123392},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3475":72621,"_30471":72595,"_21105":123394,"_5":14473,"_27705":123341,"_2959":123395},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3475":72622,"_30471":72595,"_21105":123397,"_5":14473,"_27705":123345,"_2959":123398},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3475":72623,"_30471":72595,"_21105":123400,"_5":14473,"_27705":123345,"_2959":123401},[],"Antes de confirmar:",{"_3475":72624,"_30471":72595,"_21105":123403,"_5":14473,"_27705":123345,"_2959":123404},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3475":72625,"_30471":72595,"_21105":123406,"_5":14473,"_27705":123345,"_2959":123407},[],"Distribuye la nueva cadena de confianza.",{"_3475":72626,"_30471":72595,"_21105":123409,"_5":14473,"_27705":123345,"_2959":123410},[],"Reemite las identidades necesarias.",{"_3475":72627,"_30471":72595,"_21105":123412,"_5":14473,"_27705":123345,"_2959":123413},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3475":72628,"_30471":72595,"_21105":123415,"_5":14473,"_27705":123345,"_2959":123416},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3475":72629,"_30471":72595,"_21105":123418,"_5":14473,"_27705":123345,"_2959":123419},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3475":72630,"_30471":72595,"_21105":123421,"_5":14473,"_27705":123349,"_2959":123422},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3475":72631,"_30471":72595,"_21105":123424,"_5":14473,"_27705":123349,"_2959":123425},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3475":72632,"_30471":72595,"_21105":123427,"_5":14473,"_27705":123349,"_2959":123428},[],"Cambios de estado y razones de revocación.",{"_3475":72633,"_30471":72595,"_21105":123430,"_5":14473,"_27705":123349,"_2959":123431},[],"Publicación y vigencia de OCSP y CRLs.",{"_3475":72634,"_30471":72595,"_21105":123433,"_5":14473,"_27705":123349,"_2959":123434},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3475":72635,"_30471":72595,"_21105":123436,"_5":14473,"_27705":123349,"_2959":123437},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3475":72636,"_30471":72636,"_5":14825,"_2959":123439,"_30823":123440,"_21105":123441,"_27705":72636},"Modelo de confianza",[49595,118538,55075,123307],[],{"_3475":72637,"_30471":72636,"_21105":123443,"_5":14473,"_27705":72636,"_2959":123444},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3475":72638,"_30471":72636,"_5":30820,"_21105":123446,"_27705":123447,"_2959":123448},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3475":72639,"_30471":72636,"_5":30820,"_21105":123450,"_27705":123451,"_2959":123452},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3475":72640,"_30471":72636,"_5":30820,"_21105":123454,"_27705":123455,"_2959":123456},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3475":72641,"_30471":72636,"_5":30820,"_21105":123458,"_27705":123459,"_2959":123460},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3475":72642,"_30471":72636,"_5":30820,"_21105":123462,"_27705":123463,"_2959":123464},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3475":72643,"_30471":72636,"_5":30820,"_21105":123466,"_27705":123467,"_2959":123468},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3475":72644,"_30471":72636,"_5":30820,"_21105":123470,"_27705":123471,"_2959":123472},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3475":72645,"_30471":72636,"_5":30820,"_21105":123474,"_27705":123475,"_2959":123476},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3475":72646,"_30471":72636,"_5":30820,"_21105":123478,"_27705":123479,"_2959":123480},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3475":72647,"_30471":72636,"_5":30820,"_21105":123482,"_27705":123483,"_2959":123484},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3475":72648,"_30471":72636,"_21105":123486,"_5":14473,"_27705":72636,"_2959":123487},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3475":72649,"_30471":72636,"_21105":123489,"_5":14473,"_27705":123451,"_2959":123490},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3475":72650,"_30471":72636,"_21105":123492,"_5":14473,"_27705":123455,"_2959":123493},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3475":72651,"_30471":72636,"_21105":123495,"_5":14473,"_27705":123459,"_2959":123496},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3475":72652,"_30471":72636,"_21105":123498,"_5":14473,"_27705":123463,"_2959":123499},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3475":72653,"_30471":72636,"_21105":123501,"_5":14473,"_27705":123467,"_2959":123502},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3475":72654,"_30471":72636,"_21105":123504,"_5":14473,"_27705":123467,"_2959":123505},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3475":72655,"_30471":72636,"_21105":123507,"_5":14473,"_27705":123467,"_2959":123508},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3475":72656,"_30471":72636,"_21105":123510,"_5":14473,"_27705":123467,"_2959":123511},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3475":72657,"_30471":72636,"_21105":123513,"_5":14473,"_27705":123467,"_2959":123514},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3475":72658,"_30471":72636,"_21105":123516,"_5":14473,"_27705":123467,"_2959":123517},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3475":72659,"_30471":72636,"_21105":123519,"_5":14473,"_27705":123471,"_2959":123520},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3475":72660,"_30471":72636,"_21105":123522,"_5":14473,"_27705":123471,"_2959":123523},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3475":72661,"_30471":72636,"_21105":123525,"_5":14473,"_27705":123471,"_2959":123526},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3475":72662,"_30471":72636,"_21105":123528,"_5":14473,"_27705":123471,"_2959":123529},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3475":72663,"_30471":72636,"_21105":123531,"_5":14473,"_27705":123471,"_2959":123532},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3475":72664,"_30471":72636,"_21105":123534,"_5":14473,"_27705":123475,"_2959":123535},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3475":72665,"_30471":72636,"_21105":123537,"_5":14473,"_27705":123475,"_2959":123538},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3475":72666,"_30471":72636,"_21105":123540,"_5":14473,"_27705":123475,"_2959":123541},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3475":72667,"_30471":72636,"_21105":123543,"_5":14473,"_27705":123475,"_2959":123544},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3475":72668,"_30471":72636,"_21105":123546,"_5":14473,"_27705":123475,"_2959":123547},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3475":72669,"_30471":72636,"_21105":123549,"_5":14473,"_27705":123475,"_2959":123550},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3475":72670,"_30471":72636,"_21105":123552,"_5":14473,"_27705":123475,"_2959":123553},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3475":72671,"_30471":72636,"_21105":123555,"_5":14473,"_27705":123479,"_2959":123556},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3475":72672,"_30471":72636,"_21105":123558,"_5":14473,"_27705":123483,"_2959":123559},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3475":72673,"_30471":72636,"_21105":123561,"_5":14473,"_27705":123483,"_2959":123562},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3475":72674,"_30471":72636,"_21105":123564,"_5":14473,"_27705":123483,"_2959":123565},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3475":72675,"_30471":72636,"_21105":123567,"_5":14473,"_27705":123483,"_2959":123568},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3475":72676,"_30471":72636,"_21105":123570,"_5":14473,"_27705":123483,"_2959":123571},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3475":72677,"_30471":72636,"_21105":123573,"_5":14473,"_27705":123483,"_2959":123574},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3475":72678,"_30471":72636,"_21105":123576,"_5":14473,"_27705":123483,"_2959":123577},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3475":72679,"_30471":72679,"_5":14825,"_2959":123579,"_30823":123580,"_21105":123581,"_27705":72679},"Listas de revocación (CRL)",[49595,118538,55075,123053],[],{"_3475":72680,"_30471":72679,"_21105":123583,"_5":14473,"_27705":72679,"_2959":123584},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3475":72681,"_30471":72679,"_5":30820,"_21105":123586,"_27705":123587,"_2959":123588},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3475":72682,"_30471":72679,"_5":30820,"_21105":123590,"_27705":123591,"_2959":123592},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3475":72683,"_30471":72679,"_5":30820,"_21105":123594,"_27705":123595,"_2959":123596},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3475":72684,"_30471":72679,"_5":30820,"_21105":123598,"_27705":123599,"_2959":123600},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3475":72685,"_30471":72679,"_5":30820,"_21105":123602,"_27705":123603,"_2959":123604},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3475":72686,"_30471":72679,"_5":30820,"_21105":123606,"_27705":123607,"_2959":123608},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3475":72687,"_30471":72679,"_5":30820,"_21105":123610,"_27705":123611,"_2959":123612},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3475":72688,"_30471":72679,"_5":30820,"_21105":123614,"_27705":123615,"_2959":123616},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3475":72689,"_30471":72679,"_5":30820,"_21105":123618,"_27705":123619,"_2959":123620},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#referencias","Referencias",{"_3475":72690,"_30471":72679,"_21105":123622,"_5":14473,"_27705":72679,"_2959":123623},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3475":72691,"_30471":72679,"_21105":123625,"_5":14473,"_27705":123587,"_2959":123626},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3475":72692,"_30471":72679,"_21105":123628,"_5":14473,"_27705":123587,"_2959":123629},[],"Campo",{"_3475":72693,"_30471":72679,"_21105":123631,"_5":14473,"_27705":123587,"_2959":120079},[],{"_3475":72694,"_30471":72679,"_21105":123633,"_5":14473,"_27705":123587,"_2959":56297},[],{"_3475":72695,"_30471":72679,"_21105":123635,"_5":14473,"_27705":123587,"_2959":123636},[],"ID de la CA a la que pertenecen los ajustes.",{"_3475":72696,"_30471":72679,"_21105":123638,"_5":14473,"_27705":123587,"_2959":56303},[],{"_3475":72697,"_30471":72679,"_21105":123640,"_5":14473,"_27705":123587,"_2959":123641},[],"Los ajustes `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA que fue revocada o ha expirado: su última CRL, si la hay, se publica y no se genera ninguna nueva. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3475":72698,"_30471":72679,"_21105":123643,"_5":14473,"_27705":123587,"_2959":56309},[],{"_3475":72699,"_30471":72679,"_21105":123645,"_5":14473,"_27705":123587,"_2959":123646},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3475":72700,"_30471":72679,"_21105":123648,"_5":14473,"_27705":123587,"_2959":56315},[],{"_3475":72701,"_30471":72679,"_21105":123650,"_5":14473,"_27705":123587,"_2959":123651},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3475":72702,"_30471":72679,"_21105":123653,"_5":14473,"_27705":123587,"_2959":123654},[],"Campo de `crl_options`",{"_3475":72703,"_30471":72679,"_21105":123656,"_5":14473,"_27705":123587,"_2959":120079},[],{"_3475":72704,"_30471":72679,"_21105":123658,"_5":14473,"_27705":123587,"_2959":123659},[],"Valor inicial",{"_3475":72705,"_30471":72679,"_21105":123661,"_5":14473,"_27705":123587,"_2959":56329},[],{"_3475":72706,"_30471":72679,"_21105":123663,"_5":14473,"_27705":123587,"_2959":123664},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3475":72707,"_30471":72679,"_21105":123666,"_5":14473,"_27705":123587,"_2959":123667},[],"7 días.",{"_3475":72708,"_30471":72679,"_21105":123669,"_5":14473,"_27705":123587,"_2959":56338},[],{"_3475":72709,"_30471":72679,"_21105":123671,"_5":14473,"_27705":123587,"_2959":123672},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3475":72710,"_30471":72679,"_21105":123674,"_5":14473,"_27705":123587,"_2959":123675},[],"6 días y 23 horas.",{"_3475":72711,"_30471":72679,"_21105":123677,"_5":14473,"_27705":123587,"_2959":56347},[],{"_3475":72712,"_30471":72679,"_21105":123679,"_5":14473,"_27705":123587,"_2959":123680},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3475":72713,"_30471":72679,"_21105":123682,"_5":14473,"_27705":123587,"_2959":56353},[],{"_3475":72714,"_30471":72679,"_21105":123684,"_5":14473,"_27705":123587,"_2959":56356},[],{"_3475":72715,"_30471":72679,"_21105":123686,"_5":14473,"_27705":123587,"_2959":123687},[],"Número de serie del certificado existente que firma la CRL.",{"_3475":72716,"_30471":72679,"_21105":123689,"_5":14473,"_27705":123587,"_2959":123690},[],"Número de serie del certificado actual de la CA.",{"_3475":72717,"_30471":72679,"_21105":123692,"_5":14473,"_27705":123587,"_2959":123693},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3475":72718,"_30471":72679,"_21105":123695,"_5":14473,"_27705":123587,"_2959":123696},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3475":72719,"_30471":72679,"_21105":123698,"_5":14473,"_27705":123587,"_2959":123699},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3475":72720,"_30471":72679,"_21105":123701,"_5":14473,"_27705":123587,"_2959":123702},[],"Los ajustes cuyo `status` es `FINAL` o `ARCHIVED` son de solo lectura: cualquier `PUT` devuelve 409. Eliminar una CA conserva sus ajustes de CRL:",{"_3475":72721,"_30471":72679,"_21105":123704,"_5":14473,"_27705":123587,"_2959":123705},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera.",{"_3475":72722,"_30471":72679,"_21105":123707,"_5":14473,"_27705":123587,"_2959":123708},[],"Los ajustes `ARCHIVED` de una CA eliminada pueden borrarse, con `DELETE` o desde la página Verification Authorities de la consola. Esa CRL deja de servirse — quien compruebe sus certificados contra ella dejará de encontrarla —, mientras que las CRLs ya publicadas permanecen en el bucket. La acción no puede deshacerse.",{"_3475":72723,"_30471":72679,"_21105":123710,"_5":14473,"_27705":123587,"_2959":123711},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3475":72724,"_30471":72679,"_21105":123713,"_5":14473,"_27705":123587,"_2959":123714},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3475":72725,"_30471":72679,"_21105":123716,"_5":14473,"_27705":123587,"_2959":123717},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3475":72726,"_30471":72679,"_21105":123719,"_5":14473,"_27705":123587,"_2959":123720},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3475":72727,"_30471":72679,"_21105":123722,"_5":14473,"_27705":123591,"_2959":123723},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3475":72728,"_30471":72679,"_21105":123725,"_5":14473,"_27705":123591,"_2959":123726},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3475":72729,"_30471":72679,"_21105":123728,"_5":14473,"_27705":123591,"_2959":123729},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3475":72730,"_30471":72679,"_21105":123731,"_5":14473,"_27705":123591,"_2959":123732},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3475":72731,"_30471":72679,"_21105":123734,"_5":14473,"_27705":123595,"_2959":123735},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3475":72732,"_30471":72679,"_21105":123737,"_5":14473,"_27705":123595,"_2959":123738},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3475":72733,"_30471":72679,"_21105":123740,"_5":14473,"_27705":123595,"_2959":123741},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3475":72734,"_30471":72679,"_21105":123743,"_5":14473,"_27705":123595,"_2959":123744},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3475":72735,"_30471":72679,"_21105":123746,"_5":14473,"_27705":123595,"_2959":123747},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3475":72736,"_30471":72679,"_21105":123749,"_5":14473,"_27705":123595,"_2959":123750},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3475":72737,"_30471":72679,"_21105":123752,"_5":14473,"_27705":123595,"_2959":123753},[],"Los ajustes con `status` `FINAL` o `ARCHIVED` se omiten: nada regenera su CRL.",{"_3475":72738,"_30471":72679,"_21105":123755,"_5":14473,"_27705":123595,"_2959":123756},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3475":72739,"_30471":72679,"_21105":123758,"_5":14473,"_27705":123595,"_2959":123759},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3475":72740,"_30471":72679,"_21105":123761,"_5":14473,"_27705":123599,"_2959":123762},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3475":72741,"_30471":72679,"_21105":123764,"_5":14473,"_27705":123599,"_2959":123765},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3475":72742,"_30471":72679,"_21105":123767,"_5":14473,"_27705":123603,"_2959":123768},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3475":72743,"_30471":72679,"_21105":123770,"_5":14473,"_27705":123603,"_2959":123771},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3475":72744,"_30471":72679,"_21105":123773,"_5":14473,"_27705":123603,"_2959":123774},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3475":72745,"_30471":72679,"_21105":123776,"_5":14473,"_27705":123603,"_2959":123777},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3475":72746,"_30471":72679,"_21105":123779,"_5":14473,"_27705":123603,"_2959":123780},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3475":72747,"_30471":72679,"_21105":123782,"_5":14473,"_27705":123607,"_2959":123783},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3475":72748,"_30471":72679,"_21105":123785,"_5":14473,"_27705":123607,"_2959":120268},[],{"_3475":72749,"_30471":72679,"_21105":123787,"_5":14473,"_27705":123607,"_2959":123788},[],"Path relativo",{"_3475":72750,"_30471":72679,"_21105":123790,"_5":14473,"_27705":123607,"_2959":118298},[],{"_3475":72751,"_30471":72679,"_21105":123792,"_5":14473,"_27705":123607,"_2959":56465},[],{"_3475":72752,"_30471":72679,"_21105":123794,"_5":14473,"_27705":123607,"_2959":56468},[],{"_3475":72753,"_30471":72679,"_21105":123796,"_5":14473,"_27705":123607,"_2959":123797},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3475":72754,"_30471":72679,"_21105":123799,"_5":14473,"_27705":123607,"_2959":56465},[],{"_3475":72755,"_30471":72679,"_21105":123801,"_5":14473,"_27705":123607,"_2959":56476},[],{"_3475":72756,"_30471":72679,"_21105":123803,"_5":14473,"_27705":123607,"_2959":123804},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3475":72757,"_30471":72679,"_21105":123806,"_5":14473,"_27705":123607,"_2959":56482},[],{"_3475":72758,"_30471":72679,"_21105":123808,"_5":14473,"_27705":123607,"_2959":56476},[],{"_3475":72759,"_30471":72679,"_21105":123810,"_5":14473,"_27705":123607,"_2959":123811},[],"Sustituir la configuración de CRL de una CA.",{"_3475":72760,"_30471":72679,"_21105":123813,"_5":14473,"_27705":123607,"_2959":56490},[],{"_3475":72761,"_30471":72679,"_21105":123815,"_5":14473,"_27705":123607,"_2959":56476},[],{"_3475":72762,"_30471":72679,"_21105":123817,"_5":14473,"_27705":123607,"_2959":123818},[],"Borrar los ajustes de una CA cuyos ajustes están `ARCHIVED`; sus CRLs publicadas permanecen en el bucket pero dejan de servirse.",{"_3475":72763,"_30471":72679,"_21105":123820,"_5":14473,"_27705":123607,"_2959":123821},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL. Un `DELETE` devuelve 409 salvo que los ajustes estén `ARCHIVED`.",{"_3475":72764,"_30471":72679,"_21105":123823,"_5":14473,"_27705":123607,"_2959":123824},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3475":72765,"_30471":72679,"_21105":123826,"_5":14473,"_27705":123611,"_2959":123827},[],"Síntoma",{"_3475":72766,"_30471":72679,"_21105":123829,"_5":14473,"_27705":123611,"_2959":123830},[],"Causa",{"_3475":72767,"_30471":72679,"_21105":123832,"_5":14473,"_27705":123611,"_2959":123833},[],"Acción",{"_3475":72768,"_30471":72679,"_21105":123835,"_5":14473,"_27705":123611,"_2959":123836},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3475":72769,"_30471":72679,"_21105":123838,"_5":14473,"_27705":123611,"_2959":123839},[],"Los ajustes no están `ACTIVE`: son `FINAL` o `ARCHIVED` (consulta la tabla del campo `status` en Ajustes de CRL).",{"_3475":72770,"_30471":72679,"_21105":123841,"_5":14473,"_27705":123611,"_2959":123842},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3475":72771,"_30471":72679,"_21105":123844,"_5":14473,"_27705":123611,"_2959":123845},[],"`PUT` devuelve 400.",{"_3475":72772,"_30471":72679,"_21105":123847,"_5":14473,"_27705":123611,"_2959":123848},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3475":72773,"_30471":72679,"_21105":123850,"_5":14473,"_27705":123611,"_2959":123851},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3475":72774,"_30471":72679,"_21105":123853,"_5":14473,"_27705":123611,"_2959":123854},[],"`PUT` devuelve 404.",{"_3475":72775,"_30471":72679,"_21105":123856,"_5":14473,"_27705":123611,"_2959":123857},[],"La CA o el certificado firmante nuevo no existen (por ejemplo, la CA se eliminó), o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3475":72776,"_30471":72679,"_21105":123859,"_5":14473,"_27705":123611,"_2959":123860},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3475":72777,"_30471":72679,"_21105":123862,"_5":14473,"_27705":123611,"_2959":123863},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3475":72778,"_30471":72679,"_21105":123865,"_5":14473,"_27705":123611,"_2959":123866},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3475":72779,"_30471":72679,"_21105":123868,"_5":14473,"_27705":123611,"_2959":123869},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3475":72780,"_30471":72679,"_21105":123871,"_5":14473,"_27705":123611,"_2959":123872},[],"La CRL no cambia tras revocar un certificado.",{"_3475":72781,"_30471":72679,"_21105":123874,"_5":14473,"_27705":123611,"_2959":123875},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3475":72782,"_30471":72679,"_21105":123877,"_5":14473,"_27705":123611,"_2959":123878},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3475":72783,"_30471":72679,"_21105":123880,"_5":14473,"_27705":123611,"_2959":123881},[],"Un verificador rechaza la CRL por el emisor.",{"_3475":72784,"_30471":72679,"_21105":123883,"_5":14473,"_27705":123611,"_2959":123884},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3475":72785,"_30471":72679,"_21105":123886,"_5":14473,"_27705":123611,"_2959":123887},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3475":72786,"_30471":72679,"_21105":123889,"_5":14473,"_27705":123615,"_2959":123890},[],"Los ajustes de CRL de una CA se editan en la pestaña **Validation Authority** de la vista de la CA, a la que se llega con **Configure VA** desde la página **Verification Authorities** de la consola. Ambas leen los ajustes por ID de CA en `/v1/crl-settings/{ca-id}`, que requiere un backend 4.0.0. La página Verification Authorities no edita los ajustes: lista los de todas las CA para revisarlos y, en los `ARCHIVED`, permite borrarlos.",{"_3475":72787,"_30471":72679,"_21105":123892,"_5":14473,"_27705":123615,"_2959":123893},[],"Si el backend aún no tiene ajustes para una CA, la pestaña muestra un panel **No CRL Settings** que indica que los ajustes de CRL se crean junto con la CA y que, si la CA se acaba de crear, pueden seguir inicializándose, con un botón **Retry**. Mientras cargan los ajustes, muestra &#x2A;*Loading CRL Settings...**; si falla la consulta, muestra **Error Loading CRL Settings**, también con un botón **Retry**. La fila 404 de Errores frecuentes de los ajustes de CRL enumera cuándo puede una CA no tener ajustes.",{"_3475":72788,"_30471":72679,"_21105":123895,"_5":14473,"_27705":123615,"_2959":123896},[],"En la vista de la CA, la sección **Latest Generated CRL** va primero y **CRL Configuration** al final. Los ajustes que no están `ACTIVE` se muestran en solo lectura: su insignia de estado (`Active`, `Final` o `Archived`) aparece junto a la última CRL, con un aviso de advertencia — **Final CRL Settings** o **Archived CRL Settings** — que explica que los ajustes no pueden editarse; consulta Casos en los que los ajustes dejan de poder editarse. Los ajustes migrados del modelo indexado por SKI muestran una nota con su URL de CRL heredada `/crl/<legacy-ski>`, que sigue resolviendo a la lista de esta CA.",{"_3475":72789,"_30471":72679,"_21105":123898,"_5":14473,"_27705":123615,"_2959":123899},[],"La página **Verification Authorities** lista los ajustes de CRL y la última CRL de cada Certification Authority, incluidas las eliminadas cuya última CRL aún se sirve. Tiene un botón **Refresh**, un filtro de texto por nombre, DN o ID de la CA y un filtro de estado con **All**, **Active**, **Final** y **Archived**. La tabla lista cada CA con su insignia de estado, la versión y la validez (**Valid From** / **Valid Until**) de su última CRL y su intervalo de renovación — muestra **Disabled** para `0` —, con acciones por fila: **Configure VA** (abre la pestaña Validation Authority de la vista de la CA; oculta en las filas archivadas), **Fetch & Show CRL**, **Download CRL** (cuando existe una última CRL) y, en las filas `ARCHIVED`, **Delete CRL Settings**. Las filas de CAs eliminadas muestran **Deleted CA** con el ID de la CA en lugar del nombre. Al borrar se abre un diálogo de confirmación que advierte de que la CRL de la CA eliminada dejará de servirse — quien compruebe sus certificados contra ella dejará de encontrarla —, de que las CRLs ya publicadas permanecen en el bucket y de que la acción no puede deshacerse.",{"_3475":72790,"_30471":72679,"_21105":123901,"_5":14473,"_27705":123615,"_2959":123902},[],"**Fetch & Show CRL**, desde la vista de la CA o desde la página Verification Authorities, abre un panel — acoplado a la parte inferior de la página en escritorio, lateral en móvil — que carga la CRL de esta CA al abrirse; introduce otra URL para inspeccionar cualquier CRL. Muestra el DN del emisor, la ventana de actualización (**This update** / **Next update**, con una barra de progreso), el número de CRL y el número de certificados revocados desglosado por las tres razones más frecuentes. Una CRL cuyo **Next update** ha pasado muestra la insignia **Out of date** y un aviso de advertencia; en caso contrario la insignia indica **Current**, y no hay insignia cuando la CRL no define próxima actualización. La tabla de certificados revocados puede filtrarse por número de serie o razón, y su visualización se limita a 200 filas, con un aviso que sugiere filtrar por número de serie para localizar un certificado concreto. Los números de serie enlazan a los detalles del certificado. El fichero descargado se llama `<ca-id>.crl`; compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Un fallo de carga muestra el aviso **Could not load the CRL** con el estado HTTP o un mensaje de que la respuesta no es una CRL DER válida, y un botón **Retry**. Cuando la consola se sirve por HTTPS y la URL de la CRL usa `http://`, aparece un aviso de URL insegura, porque el navegador puede bloquear la petición HTTP sin cifrar o convertirla a HTTPS.",{"_3475":72791,"_30471":72679,"_21105":123904,"_5":14473,"_27705":123615,"_2959":123905},[],"El campo **CRL Refresh Interval** acepta `0`. Entonces un aviso informativo explica que no se genera una CRL nueva solo porque pase el tiempo — una se genera únicamente poco antes de que venza la actual — y, con **Regenerate CRL Immediately on Revocation** desactivado, que las revocaciones no se publican hasta entonces. La tabla de la página Verification Authorities muestra **Disabled** para un intervalo de renovación de `0`; la semántica está descrita en Regeneración periódica y automática. El campo **CRL Max Validity / Cache Duration** sigue exigiendo una duración positiva y rechaza `0`.",{"_3475":72792,"_30471":72679,"_21105":123907,"_5":14473,"_27705":123615,"_2959":123908},[],"La edición es tolerante: un campo muestra su error solo cuando lo abandonas. **Save CRL Settings** siempre está activado; si al guardar hay campos no válidos, la interfaz los marca todos, muestra los errores y enfoca el primero no válido en lugar de dejar desactivado el botón.",{"_3475":72793,"_30471":72679,"_21105":123910,"_5":14473,"_27705":123615,"_2959":123911},[],"El firmante seleccionado aparece como una tarjeta con su emisor (el DN completo en un tooltip que se abre al pasar el ratón, y cuyo nombre enlaza a su CA cuando existe su registro), su fecha de vencimiento, su algoritmo de clave, sus chips de usos y su número de serie, bajo el pie **CRL signer — Signs the CRLs of this CA**. El selector de certificados solo ofrece certificados que tienen clave privada y el uso de clave `cRLSign`. Si el certificado de un firmante configurado no puede resolverse, la interfaz muestra `Unknown Certificate (Serial: X)` o `Certificate details unavailable (Serial: X)`.",{"_3475":72794,"_30471":72679,"_21105":123913,"_5":14473,"_27705":123615,"_2959":123914},[],"Para diagnosticar una diferencia entre la consola y el endpoint público, sigue Diagnóstico PKI.",{"_3475":72795,"_30471":72679,"_21105":123916,"_5":14473,"_27705":123619,"_2959":123917},[],"RFC 5280: perfil X.509 y CRL.",{"_3475":72796,"_30471":72679,"_21105":123919,"_5":14473,"_27705":123619,"_2959":56597},[],{"_3475":72797,"_30471":72679,"_21105":123921,"_5":14473,"_27705":123619,"_2959":56600},[],{"_3475":72798,"_30471":72679,"_21105":123923,"_5":14473,"_27705":123619,"_2959":123924},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3475":72799,"_30471":72679,"_21105":123926,"_5":14473,"_27705":123619,"_2959":123927},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3475":72800,"_30471":72800,"_5":14825,"_2959":123929,"_30823":123930,"_21105":123931,"_27705":72800},"Claves y motores criptográficos",[49595,118538,55075,122416],[],{"_3475":72801,"_30471":72800,"_21105":123933,"_5":14473,"_27705":72800,"_2959":123934},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3475":72802,"_30471":72800,"_5":30820,"_21105":123936,"_27705":123937,"_2959":123938},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3475":72803,"_30471":72800,"_5":30820,"_21105":123940,"_27705":123941,"_2959":123942},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3475":72804,"_30471":72800,"_5":30820,"_21105":123944,"_27705":123945,"_2959":56625},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#file-system",{"_3475":72805,"_30471":72800,"_5":30820,"_21105":123947,"_27705":123948,"_2959":56629},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#hashicorp-vault",{"_3475":72806,"_30471":72800,"_5":30820,"_21105":123950,"_27705":123951,"_2959":56633},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#aws-secrets-manager",{"_3475":72807,"_30471":72800,"_5":30820,"_21105":123953,"_27705":123954,"_2959":56637},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#aws-kms",{"_3475":72808,"_30471":72800,"_5":30820,"_21105":123956,"_27705":123957,"_2959":56641},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#pkcs11",{"_3475":72809,"_30471":72800,"_5":30820,"_21105":123959,"_27705":123960,"_2959":56645},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#azure-key-vault",{"_3475":72810,"_30471":72800,"_5":30820,"_21105":123962,"_27705":123963,"_2959":123964},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3475":72811,"_30471":72800,"_5":30820,"_21105":123966,"_27705":123967,"_2959":123968},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3475":72812,"_30471":72800,"_5":30820,"_21105":123970,"_27705":123971,"_2959":123972},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3475":72813,"_30471":72800,"_5":30820,"_21105":123974,"_27705":123975,"_2959":123976},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3475":72814,"_30471":72800,"_5":30820,"_21105":123978,"_27705":123979,"_2959":123980},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3475":72815,"_30471":72800,"_5":30820,"_21105":123982,"_27705":123983,"_2959":123984},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3475":72816,"_30471":72800,"_5":30820,"_21105":123986,"_27705":123987,"_2959":123988},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3475":72817,"_30471":72800,"_5":30820,"_21105":123990,"_27705":123991,"_2959":56677},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#sign",{"_3475":72818,"_30471":72800,"_5":30820,"_21105":123993,"_27705":123994,"_2959":56681},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#verify",{"_3475":72819,"_30471":72800,"_5":30820,"_21105":123996,"_27705":123997,"_2959":123998},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3475":72820,"_30471":72800,"_5":30820,"_21105":124000,"_27705":124001,"_2959":124002},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3475":72821,"_30471":72800,"_5":30820,"_21105":124004,"_27705":124005,"_2959":124006},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3475":72822,"_30471":72800,"_21105":124008,"_5":14473,"_27705":72800,"_2959":124009},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3475":72823,"_30471":72800,"_21105":124011,"_5":14473,"_27705":72800,"_2959":124012},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3475":72824,"_30471":72800,"_21105":124014,"_5":14473,"_27705":123937,"_2959":124015},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3475":72825,"_30471":72800,"_21105":124017,"_5":14473,"_27705":123937,"_2959":124018},[],"En la práctica, permite:",{"_3475":72826,"_30471":72800,"_21105":124020,"_5":14473,"_27705":123937,"_2959":124021},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3475":72827,"_30471":72800,"_21105":124023,"_5":14473,"_27705":123937,"_2959":124024},[],"Importar claves creadas externamente.",{"_3475":72828,"_30471":72800,"_21105":124026,"_5":14473,"_27705":123937,"_2959":124027},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3475":72829,"_30471":72800,"_21105":124029,"_5":14473,"_27705":123937,"_2959":124030},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3475":72830,"_30471":72800,"_21105":124032,"_5":14473,"_27705":123941,"_2959":124033},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3475":72831,"_30471":72800,"_21105":124035,"_5":14473,"_27705":123941,"_2959":124036},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3475":72832,"_30471":72800,"_21105":124038,"_5":14473,"_27705":123941,"_2959":124039},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3475":72833,"_30471":72800,"_21105":124041,"_5":14473,"_27705":123945,"_2959":124042},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3475":72834,"_30471":72800,"_21105":124044,"_5":14473,"_27705":123948,"_2959":124045},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3475":72835,"_30471":72800,"_21105":124047,"_5":14473,"_27705":123948,"_2959":124048},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3475":72836,"_30471":72800,"_21105":124050,"_5":14473,"_27705":123951,"_2959":124051},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3475":72837,"_30471":72800,"_21105":124053,"_5":14473,"_27705":123954,"_2959":124054},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3475":72838,"_30471":72800,"_21105":124056,"_5":14473,"_27705":123957,"_2959":124057},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3475":72839,"_30471":72800,"_21105":124059,"_5":14473,"_27705":123960,"_2959":124060},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3475":72840,"_30471":72800,"_21105":124062,"_5":14473,"_27705":123960,"_2959":124063},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3475":72841,"_30471":72800,"_21105":124065,"_5":14473,"_27705":123960,"_2959":124066},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3475":72842,"_30471":72800,"_21105":124068,"_5":14473,"_27705":123960,"_2959":124069},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3475":72843,"_30471":72800,"_21105":124071,"_5":14473,"_27705":123963,"_2959":124072},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3475":72844,"_30471":72800,"_21105":124074,"_5":14473,"_27705":123963,"_2959":124075},[],"La tabla incluye los siguientes campos:",{"_3475":72845,"_30471":72800,"_21105":124077,"_5":14473,"_27705":123963,"_2959":124078},[],"**Name**: nombre descriptivo de la clave.",{"_3475":72846,"_30471":72800,"_21105":124080,"_5":14473,"_27705":123963,"_2959":124081},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3475":72847,"_30471":72800,"_21105":124083,"_5":14473,"_27705":123963,"_2959":124084},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3475":72848,"_30471":72800,"_21105":124086,"_5":14473,"_27705":123963,"_2959":124087},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3475":72849,"_30471":72800,"_21105":124089,"_5":14473,"_27705":123963,"_2959":124090},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3475":72850,"_30471":72800,"_21105":124092,"_5":14473,"_27705":123963,"_2959":124093},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3475":72851,"_30471":72800,"_21105":124095,"_5":14473,"_27705":123963,"_2959":124096},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3475":72852,"_30471":72800,"_21105":124098,"_5":14473,"_27705":123963,"_2959":124099},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3475":72853,"_30471":72800,"_21105":124101,"_5":14473,"_27705":123963,"_2959":124102},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3475":72854,"_30471":72800,"_21105":124104,"_5":14473,"_27705":123963,"_2959":124105},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3475":72855,"_30471":72800,"_21105":124107,"_5":14473,"_27705":123963,"_2959":124108},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3475":72856,"_30471":72800,"_21105":124110,"_5":14473,"_27705":123963,"_2959":124111},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3475":72857,"_30471":72800,"_21105":124113,"_5":14473,"_27705":123963,"_2959":124114},[],"**Delete Key** para eliminar la clave del sistema.",{"_3475":72858,"_30471":72800,"_21105":124116,"_5":14473,"_27705":123967,"_2959":124117},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3475":72859,"_30471":72800,"_21105":124119,"_5":14473,"_27705":123971,"_2959":124120},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3475":72860,"_30471":72800,"_21105":124122,"_5":14473,"_27705":123971,"_2959":124123},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3475":72861,"_30471":72800,"_21105":124125,"_5":14473,"_27705":123971,"_2959":124126},[],"**Key Name**: nombre único y descriptivo.",{"_3475":72862,"_30471":72800,"_21105":124128,"_5":14473,"_27705":123971,"_2959":124129},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3475":72863,"_30471":72800,"_21105":124131,"_5":14473,"_27705":123971,"_2959":124132},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3475":72864,"_30471":72800,"_21105":124134,"_5":14473,"_27705":123971,"_2959":124135},[],"**Tags**: metadatos para clasificar la clave.",{"_3475":72865,"_30471":72800,"_21105":124137,"_5":14473,"_27705":123971,"_2959":124138},[],"**Metadata**: información adicional para usos avanzados.",{"_3475":72866,"_30471":72800,"_21105":124140,"_5":14473,"_27705":123975,"_2959":124141},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3475":72867,"_30471":72800,"_21105":124143,"_5":14473,"_27705":123975,"_2959":124144},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3475":72868,"_30471":72800,"_21105":124146,"_5":14473,"_27705":123975,"_2959":124147},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3475":72869,"_30471":72800,"_21105":124149,"_5":14473,"_27705":123975,"_2959":124150},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3475":72870,"_30471":72800,"_21105":124152,"_5":14473,"_27705":123975,"_2959":124153},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3475":72871,"_30471":72800,"_21105":124155,"_5":14473,"_27705":123975,"_2959":124156},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3475":72872,"_30471":72800,"_21105":124158,"_5":14473,"_27705":123975,"_2959":124159},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3475":72873,"_30471":72800,"_21105":124161,"_5":14473,"_27705":123975,"_2959":124162},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3475":72874,"_30471":72800,"_21105":124164,"_5":14473,"_27705":123975,"_2959":124165},[],"**Metadata**: información adicional opcional.",{"_3475":72875,"_30471":72800,"_21105":124167,"_5":14473,"_27705":123975,"_2959":124168},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3475":72876,"_30471":72800,"_21105":124170,"_5":14473,"_27705":123975,"_2959":124171},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3475":72877,"_30471":72800,"_21105":124173,"_5":14473,"_27705":123979,"_2959":124174},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3475":72878,"_30471":72800,"_21105":124176,"_5":14473,"_27705":123983,"_2959":124177},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3475":72879,"_30471":72800,"_21105":124179,"_5":14473,"_27705":123983,"_2959":124180},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3475":72880,"_30471":72800,"_21105":124182,"_5":14473,"_27705":123983,"_2959":124183},[],"**Key Name**: nombre descriptivo.",{"_3475":72881,"_30471":72800,"_21105":124185,"_5":14473,"_27705":123983,"_2959":124186},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3475":72882,"_30471":72800,"_21105":124188,"_5":14473,"_27705":123983,"_2959":124189},[],"**Tags**: etiquetas asociadas.",{"_3475":72883,"_30471":72800,"_21105":124191,"_5":14473,"_27705":123983,"_2959":124192},[],"**Aliases**: nombres alternativos.",{"_3475":72884,"_30471":72800,"_21105":124194,"_5":14473,"_27705":123983,"_2959":124195},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3475":72885,"_30471":72800,"_21105":124197,"_5":14473,"_27705":123983,"_2959":124198},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3475":72886,"_30471":72800,"_21105":124200,"_5":14473,"_27705":123983,"_2959":124201},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3475":72887,"_30471":72800,"_21105":124203,"_5":14473,"_27705":123983,"_2959":124204},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3475":72888,"_30471":72800,"_21105":124206,"_5":14473,"_27705":123987,"_2959":124207},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3475":72889,"_30471":72800,"_21105":124209,"_5":14473,"_27705":123987,"_2959":124210},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3475":72890,"_30471":72800,"_21105":124212,"_5":14473,"_27705":123987,"_2959":124213},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3475":72891,"_30471":72800,"_21105":124215,"_5":14473,"_27705":123991,"_2959":124216},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3475":72892,"_30471":72800,"_21105":124218,"_5":14473,"_27705":123991,"_2959":124219},[],"Campos principales:",{"_3475":72893,"_30471":72800,"_21105":124221,"_5":14473,"_27705":123991,"_2959":124222},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3475":72894,"_30471":72800,"_21105":124224,"_5":14473,"_27705":123991,"_2959":124225},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3475":72895,"_30471":72800,"_21105":124227,"_5":14473,"_27705":123991,"_2959":124228},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3475":72896,"_30471":72800,"_21105":124230,"_5":14473,"_27705":123991,"_2959":124231},[],"**Message**: contenido que se va a firmar.",{"_3475":72897,"_30471":72800,"_21105":124233,"_5":14473,"_27705":123991,"_2959":124234},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3475":72898,"_30471":72800,"_21105":124236,"_5":14473,"_27705":123994,"_2959":124237},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3475":72899,"_30471":72800,"_21105":124239,"_5":14473,"_27705":123994,"_2959":124219},[],{"_3475":72900,"_30471":72800,"_21105":124241,"_5":14473,"_27705":123994,"_2959":124242},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3475":72901,"_30471":72800,"_21105":124244,"_5":14473,"_27705":123994,"_2959":124245},[],"**Message Type**: `Raw` o `Digest`.",{"_3475":72902,"_30471":72800,"_21105":124247,"_5":14473,"_27705":123994,"_2959":124248},[],"**Payload Encoding**: codificación del mensaje.",{"_3475":72903,"_30471":72800,"_21105":124250,"_5":14473,"_27705":123994,"_2959":124251},[],"**Message**: mensaje original o hash.",{"_3475":72904,"_30471":72800,"_21105":124253,"_5":14473,"_27705":123994,"_2959":124254},[],"**Signature**: firma que se desea comprobar.",{"_3475":72905,"_30471":72800,"_21105":124256,"_5":14473,"_27705":123994,"_2959":124257},[],"**Result**: indicador del resultado de la validación.",{"_3475":72906,"_30471":72800,"_21105":124259,"_5":14473,"_27705":123997,"_2959":124260},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3475":72907,"_30471":72800,"_21105":124262,"_5":14473,"_27705":123997,"_2959":124263},[],"Este flujo es útil para:",{"_3475":72908,"_30471":72800,"_21105":124265,"_5":14473,"_27705":123997,"_2959":124266},[],"Solicitar certificados a una CA externa.",{"_3475":72909,"_30471":72800,"_21105":124268,"_5":14473,"_27705":123997,"_2959":124269},[],"Renovar una identidad manteniendo la misma clave.",{"_3475":72910,"_30471":72800,"_21105":124271,"_5":14473,"_27705":123997,"_2959":124272},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3475":72911,"_30471":72800,"_21105":124274,"_5":14473,"_27705":123997,"_2959":124275},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3475":72912,"_30471":72800,"_21105":124277,"_5":14473,"_27705":123997,"_2959":124278},[],"**Organization (O)**: organización o empresa.",{"_3475":72913,"_30471":72800,"_21105":124280,"_5":14473,"_27705":123997,"_2959":124281},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3475":72914,"_30471":72800,"_21105":124283,"_5":14473,"_27705":123997,"_2959":124284},[],"**Country (C)**: código de país de dos letras.",{"_3475":72915,"_30471":72800,"_21105":124286,"_5":14473,"_27705":123997,"_2959":124287},[],"**State / Province (ST)**: estado o provincia.",{"_3475":72916,"_30471":72800,"_21105":124289,"_5":14473,"_27705":123997,"_2959":124290},[],"**Locality (L)**: ciudad o localidad.",{"_3475":72917,"_30471":72800,"_21105":124292,"_5":14473,"_27705":123997,"_2959":124293},[],"**Email Address**: correo de contacto.",{"_3475":72918,"_30471":72800,"_21105":124295,"_5":14473,"_27705":123997,"_2959":124296},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3475":72919,"_30471":72800,"_21105":124298,"_5":14473,"_27705":123997,"_2959":124299},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3475":72920,"_30471":72800,"_21105":124301,"_5":14473,"_27705":124001,"_2959":124302},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3475":72921,"_30471":72800,"_21105":124304,"_5":14473,"_27705":124001,"_2959":124305},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3475":72922,"_30471":72800,"_21105":124307,"_5":14473,"_27705":124005,"_2959":124308},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3475":72923,"_30471":72800,"_21105":124310,"_5":14473,"_27705":124005,"_2959":124311},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3475":72924,"_30471":72924,"_5":14825,"_2959":124313,"_30823":124314,"_21105":124315,"_27705":72924},"Validación online con OCSP",[49595,118538,55075,123053],[],{"_3475":72925,"_30471":72924,"_21105":124317,"_5":14473,"_27705":72924,"_2959":124318},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3475":72926,"_30471":72924,"_5":30820,"_21105":124320,"_27705":124321,"_2959":124322},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3475":72927,"_30471":72924,"_5":30820,"_21105":124324,"_27705":124325,"_2959":124326},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3475":72928,"_30471":72924,"_5":30820,"_21105":124328,"_27705":124329,"_2959":124330},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3475":72929,"_30471":72924,"_5":30820,"_21105":124332,"_27705":124333,"_2959":124334},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3475":72930,"_30471":72924,"_5":30820,"_21105":124336,"_27705":124337,"_2959":124338},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3475":72931,"_30471":72924,"_5":30820,"_21105":124340,"_27705":124341,"_2959":123620},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#referencias",{"_3475":72932,"_30471":72924,"_21105":124343,"_5":14473,"_27705":72924,"_2959":124344},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3475":72933,"_30471":72924,"_21105":124346,"_5":14473,"_27705":124321,"_2959":124347},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3475":72934,"_30471":72924,"_21105":124349,"_5":14473,"_27705":124321,"_2959":124350},[],"Estado del registro",{"_3475":72935,"_30471":72924,"_21105":124352,"_5":14473,"_27705":124321,"_2959":124353},[],"Respuesta firmada",{"_3475":72936,"_30471":72924,"_21105":124355,"_5":14473,"_27705":124321,"_2959":54212},[],{"_3475":72937,"_30471":72924,"_21105":124357,"_5":14473,"_27705":124321,"_2959":57045},[],{"_3475":72938,"_30471":72924,"_21105":124359,"_5":14473,"_27705":124321,"_2959":54229},[],{"_3475":72939,"_30471":72924,"_21105":124361,"_5":14473,"_27705":124321,"_2959":124362},[],"`Revoked`, con razón y fecha de revocación.",{"_3475":72940,"_30471":72924,"_21105":124364,"_5":14473,"_27705":124321,"_2959":124365},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3475":72941,"_30471":72924,"_21105":124367,"_5":14473,"_27705":124321,"_2959":124368},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3475":72942,"_30471":72924,"_21105":124370,"_5":14473,"_27705":124321,"_2959":124371},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3475":72943,"_30471":72924,"_21105":124373,"_5":14473,"_27705":124321,"_2959":124374},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3475":72944,"_30471":72924,"_21105":124376,"_5":14473,"_27705":124321,"_2959":124377},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3475":72945,"_30471":72924,"_21105":124379,"_5":14473,"_27705":124325,"_2959":124380},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3475":72946,"_30471":72924,"_21105":124382,"_5":14473,"_27705":124325,"_2959":124383},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3475":72947,"_30471":72924,"_21105":124385,"_5":14473,"_27705":124329,"_2959":124386},[],"El servicio acepta:",{"_3475":72948,"_30471":72924,"_21105":124388,"_5":14473,"_27705":124329,"_2959":120268},[],{"_3475":72949,"_30471":72924,"_21105":124390,"_5":14473,"_27705":124329,"_2959":124391},[],"Ruta del servicio VA",{"_3475":72950,"_30471":72924,"_21105":124393,"_5":14473,"_27705":124329,"_2959":124394},[],"Formato",{"_3475":72951,"_30471":72924,"_21105":124396,"_5":14473,"_27705":124329,"_2959":57085},[],{"_3475":72952,"_30471":72924,"_21105":124398,"_5":14473,"_27705":124329,"_2959":57088},[],{"_3475":72953,"_30471":72924,"_21105":124400,"_5":14473,"_27705":124329,"_2959":124401},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3475":72954,"_30471":72924,"_21105":124403,"_5":14473,"_27705":124329,"_2959":56465},[],{"_3475":72955,"_30471":72924,"_21105":124405,"_5":14473,"_27705":124329,"_2959":57096},[],{"_3475":72956,"_30471":72924,"_21105":124407,"_5":14473,"_27705":124329,"_2959":124408},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3475":72957,"_30471":72924,"_21105":124410,"_5":14473,"_27705":124329,"_2959":124411},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3475":72958,"_30471":72924,"_21105":124413,"_5":14473,"_27705":124333,"_2959":124414},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3475":72959,"_30471":72924,"_21105":124416,"_5":14473,"_27705":124333,"_2959":124417},[],"Genera la solicitud:",{"_3475":72960,"_30471":72924,"_21105":124419,"_5":14473,"_27705":124333,"_2959":124420},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3475":72961,"_30471":72924,"_21105":124422,"_5":14473,"_27705":124333,"_2959":124423},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3475":72962,"_30471":72924,"_21105":124425,"_5":14473,"_27705":124333,"_2959":124426},[],"Verifica el DER recibido:",{"_3475":72963,"_30471":72924,"_21105":124428,"_5":14473,"_27705":124333,"_2959":124429},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3475":72964,"_30471":72924,"_21105":124431,"_5":14473,"_27705":124337,"_2959":124432},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3475":72965,"_30471":72924,"_21105":124434,"_5":14473,"_27705":124337,"_2959":124435},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3475":72966,"_30471":72924,"_21105":124437,"_5":14473,"_27705":124341,"_2959":57129},[],{"_3475":72967,"_30471":72924,"_21105":124439,"_5":14473,"_27705":124341,"_2959":57132},[],{"_3475":72968,"_30471":72924,"_21105":124441,"_5":14473,"_27705":124341,"_2959":124442},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3475":72969,"_30471":72924,"_21105":124444,"_5":14473,"_27705":124341,"_2959":123927},[],{"_3475":72970,"_30471":72970,"_5":14825,"_2959":55075,"_30823":124446,"_21105":124447,"_27705":72970},[49595,118538,55075],[],{"_3475":72971,"_30471":72970,"_21105":124449,"_5":14473,"_27705":72970,"_2959":124450},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3475":72972,"_30471":72970,"_5":30820,"_21105":124452,"_27705":124453,"_2959":121742},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#empieza-aquí",{"_3475":72973,"_30471":72970,"_5":30820,"_21105":124455,"_27705":124456,"_2959":124457},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3475":72974,"_30471":72970,"_5":30820,"_21105":124459,"_27705":124460,"_2959":122262},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#capacidades-principales",{"_3475":72975,"_30471":72970,"_5":30820,"_21105":124462,"_27705":124463,"_2959":122266},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3475":72976,"_30471":72970,"_5":30820,"_21105":124465,"_27705":124466,"_2959":122270},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3475":72977,"_30471":72970,"_5":30820,"_21105":124468,"_27705":124469,"_2959":122274},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#emite-y-controla-certificados",{"_3475":72978,"_30471":72970,"_5":30820,"_21105":124471,"_27705":124472,"_2959":122282},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#publica-el-estado-de-validación",{"_3475":72979,"_30471":72970,"_5":30820,"_21105":124474,"_27705":124475,"_2959":124476},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3475":72980,"_30471":72970,"_5":30820,"_21105":124478,"_27705":124479,"_2959":123219},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#continúa",{"_3475":72981,"_30471":72970,"_21105":124481,"_5":14473,"_27705":72970,"_2959":124482},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3475":72982,"_30471":72970,"_21105":124484,"_5":14473,"_27705":124453,"_2959":124485},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3475":72983,"_30471":72970,"_21105":124487,"_5":14473,"_27705":124453,"_2959":124488},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3475":72984,"_30471":72970,"_21105":124490,"_5":14473,"_27705":124456,"_2959":124491},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3475":72985,"_30471":72970,"_21105":124493,"_5":14473,"_27705":124456,"_2959":124494},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3475":72986,"_30471":72970,"_21105":124496,"_5":14473,"_27705":124456,"_2959":124497},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3475":72987,"_30471":72970,"_21105":124499,"_5":14473,"_27705":124456,"_2959":124500},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3475":72988,"_30471":72970,"_21105":124502,"_5":14473,"_27705":124456,"_2959":124503},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3475":72989,"_30471":72970,"_21105":124505,"_5":14473,"_27705":124463,"_2959":124506},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3475":72990,"_30471":72970,"_21105":124508,"_5":14473,"_27705":124466,"_2959":124509},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3475":72991,"_30471":72970,"_21105":124511,"_5":14473,"_27705":124469,"_2959":124512},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3475":72992,"_30471":72970,"_21105":124514,"_5":14473,"_27705":124472,"_2959":124515},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3475":72993,"_30471":72970,"_21105":124517,"_5":14473,"_27705":124475,"_2959":124518},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3475":72994,"_30471":72970,"_21105":124520,"_5":14473,"_27705":124475,"_2959":124521},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3475":72995,"_30471":72970,"_21105":124523,"_5":14473,"_27705":124475,"_2959":124524},[],"su clave pública corresponda a la clave privada del cliente;",{"_3475":72996,"_30471":72970,"_21105":124526,"_5":14473,"_27705":124475,"_2959":124527},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3475":72997,"_30471":72970,"_21105":124529,"_5":14473,"_27705":124475,"_2959":124530},[],"sus fechas y usos permitan la operación;",{"_3475":72998,"_30471":72970,"_21105":124532,"_5":14473,"_27705":124475,"_2959":124533},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3475":72999,"_30471":72970,"_21105":124535,"_5":14473,"_27705":124475,"_2959":124536},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3475":73000,"_30471":72970,"_21105":124538,"_5":14473,"_27705":124479,"_2959":124539},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3475":73001,"_30471":72970,"_21105":124541,"_5":14473,"_27705":124479,"_2959":124542},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3475":73002,"_30471":72970,"_21105":124544,"_5":14473,"_27705":124479,"_2959":124545},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3475":73003,"_30471":73003,"_5":14825,"_2959":124547,"_30823":124548,"_21105":124549,"_27705":73003},"Crea tu primera CA",[49595,118538,55075,121866],[],{"_3475":73004,"_30471":73003,"_21105":124551,"_5":14473,"_27705":73003,"_2959":124552},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3475":73005,"_30471":73003,"_5":30820,"_21105":124554,"_27705":124555,"_2959":117109},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3475":73006,"_30471":73003,"_5":30820,"_21105":124557,"_27705":124558,"_2959":124559},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3475":73007,"_30471":73003,"_5":30820,"_21105":124561,"_27705":124562,"_2959":124563},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3475":73008,"_30471":73003,"_5":30820,"_21105":124565,"_27705":124566,"_2959":124567},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3475":73009,"_30471":73003,"_5":30820,"_21105":124569,"_27705":124570,"_2959":124571},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3475":73010,"_30471":73003,"_5":30820,"_21105":124573,"_27705":124574,"_2959":124575},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3475":73011,"_30471":73003,"_5":30820,"_21105":124577,"_27705":124578,"_2959":124579},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3475":73012,"_30471":73003,"_5":30820,"_21105":124581,"_27705":124582,"_2959":122113},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3475":73013,"_30471":73003,"_5":30820,"_21105":124584,"_27705":124585,"_2959":117133},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3475":73014,"_30471":73003,"_21105":124587,"_5":14473,"_27705":73003,"_2959":124588},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3475":73015,"_30471":73003,"_21105":124590,"_5":14473,"_27705":124555,"_2959":124591},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3475":73016,"_30471":73003,"_21105":124593,"_5":14473,"_27705":124555,"_2959":124594},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3475":73017,"_30471":73003,"_21105":124596,"_5":14473,"_27705":124555,"_2959":124597},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3475":73018,"_30471":73003,"_21105":124599,"_5":14473,"_27705":124555,"_2959":124600},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3475":73019,"_30471":73003,"_21105":124602,"_5":14473,"_27705":124558,"_2959":124603},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3475":73020,"_30471":73003,"_21105":124605,"_5":14473,"_27705":124558,"_2959":124606},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3475":73021,"_30471":73003,"_21105":124608,"_5":14473,"_27705":124562,"_2959":124609},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3475":73022,"_30471":73003,"_21105":124611,"_5":14473,"_27705":124562,"_2959":124612},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3475":73023,"_30471":73003,"_21105":124614,"_5":14473,"_27705":124566,"_2959":124615},[],"Selecciona **Root CA** y completa:",{"_3475":73024,"_30471":73003,"_21105":124617,"_5":14473,"_27705":124566,"_2959":57311},[],{"_3475":73025,"_30471":73003,"_21105":124619,"_5":14473,"_27705":124566,"_2959":124620},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3475":73026,"_30471":73003,"_21105":124622,"_5":14473,"_27705":124566,"_2959":124623},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3475":73027,"_30471":73003,"_21105":124625,"_5":14473,"_27705":124566,"_2959":124626},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3475":73028,"_30471":73003,"_21105":124628,"_5":14473,"_27705":124566,"_2959":124629},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3475":73029,"_30471":73003,"_21105":124631,"_5":14473,"_27705":124570,"_2959":124632},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3475":73030,"_30471":73003,"_21105":124634,"_5":14473,"_27705":124574,"_2959":124635},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3475":73031,"_30471":73003,"_21105":124637,"_5":14473,"_27705":124574,"_2959":124638},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3475":73032,"_30471":73003,"_21105":124640,"_5":14473,"_27705":124578,"_2959":124641},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3475":73033,"_30471":73003,"_21105":124643,"_5":14473,"_27705":124578,"_2959":124644},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3475":73034,"_30471":73003,"_21105":124646,"_5":14473,"_27705":124578,"_2959":124647},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3475":73035,"_30471":73003,"_21105":124649,"_5":14473,"_27705":124582,"_2959":124650},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3475":73036,"_30471":73003,"_21105":124652,"_5":14473,"_27705":124582,"_2959":124653},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3475":73037,"_30471":73003,"_21105":124655,"_5":14473,"_27705":124582,"_2959":124656},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3475":73038,"_30471":73003,"_21105":124658,"_5":14473,"_27705":124582,"_2959":124659},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3475":73039,"_30471":73003,"_21105":124661,"_5":14473,"_27705":124585,"_2959":124662},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3475":73040,"_30471":73040,"_5":14825,"_2959":124664,"_30823":124665,"_21105":124666,"_27705":73040},"Emite y verifica un certificado",[49595,118538,55075,121866],[],{"_3475":73041,"_30471":73040,"_21105":124668,"_5":14473,"_27705":73040,"_2959":124669},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3475":73042,"_30471":73040,"_5":30820,"_21105":124671,"_27705":124672,"_2959":117109},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3475":73043,"_30471":73040,"_5":30820,"_21105":124674,"_27705":124675,"_2959":124676},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3475":73044,"_30471":73040,"_5":30820,"_21105":124678,"_27705":124679,"_2959":124680},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3475":73045,"_30471":73040,"_5":30820,"_21105":124682,"_27705":124683,"_2959":124684},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3475":73046,"_30471":73040,"_5":30820,"_21105":124686,"_27705":124687,"_2959":124688},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3475":73047,"_30471":73040,"_5":30820,"_21105":124690,"_27705":124691,"_2959":124692},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3475":73048,"_30471":73040,"_5":30820,"_21105":124694,"_27705":124695,"_2959":124696},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3475":73049,"_30471":73040,"_5":30820,"_21105":124698,"_27705":124699,"_2959":124700},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3475":73050,"_30471":73040,"_5":30820,"_21105":124702,"_27705":124703,"_2959":124704},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3475":73051,"_30471":73040,"_5":30820,"_21105":124706,"_27705":124707,"_2959":124708},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3475":73052,"_30471":73040,"_5":30820,"_21105":124710,"_27705":124711,"_2959":122113},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3475":73053,"_30471":73040,"_5":30820,"_21105":124713,"_27705":124714,"_2959":117133},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3475":73054,"_30471":73040,"_21105":124716,"_5":14473,"_27705":73040,"_2959":124717},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3475":73055,"_30471":73040,"_21105":124719,"_5":14473,"_27705":124672,"_2959":124720},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3475":73056,"_30471":73040,"_21105":124722,"_5":14473,"_27705":124672,"_2959":124723},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3475":73057,"_30471":73040,"_21105":124725,"_5":14473,"_27705":124672,"_2959":124726},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3475":73058,"_30471":73040,"_21105":124728,"_5":14473,"_27705":124672,"_2959":124729},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3475":73059,"_30471":73040,"_21105":124731,"_5":14473,"_27705":124672,"_2959":124732},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3475":73060,"_30471":73040,"_21105":124734,"_5":14473,"_27705":124675,"_2959":124735},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3475":73061,"_30471":73040,"_21105":124737,"_5":14473,"_27705":124679,"_2959":124738},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3475":73062,"_30471":73040,"_21105":124740,"_5":14473,"_27705":124679,"_2959":124741},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3475":73063,"_30471":73040,"_21105":124743,"_5":14473,"_27705":124683,"_2959":124744},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3475":73064,"_30471":73040,"_21105":124746,"_5":14473,"_27705":124683,"_2959":124747},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3475":73065,"_30471":73040,"_21105":124749,"_5":14473,"_27705":124687,"_2959":124750},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3475":73066,"_30471":73040,"_21105":124752,"_5":14473,"_27705":124687,"_2959":124753},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3475":73067,"_30471":73040,"_21105":124755,"_5":14473,"_27705":124691,"_2959":124756},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3475":73068,"_30471":73040,"_21105":124758,"_5":14473,"_27705":124695,"_2959":124759},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3475":73069,"_30471":73040,"_21105":124761,"_5":14473,"_27705":124699,"_2959":124762},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3475":73070,"_30471":73040,"_21105":124764,"_5":14473,"_27705":124703,"_2959":124765},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3475":73071,"_30471":73040,"_21105":124767,"_5":14473,"_27705":124703,"_2959":124768},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3475":73072,"_30471":73040,"_21105":124770,"_5":14473,"_27705":124703,"_2959":124771},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3475":73073,"_30471":73040,"_21105":124773,"_5":14473,"_27705":124707,"_2959":124774},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3475":73074,"_30471":73040,"_21105":124776,"_5":14473,"_27705":124707,"_2959":124777},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3475":73075,"_30471":73040,"_21105":124779,"_5":14473,"_27705":124707,"_2959":124780},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3475":73076,"_30471":73040,"_21105":124782,"_5":14473,"_27705":124711,"_2959":122196},[],{"_3475":73077,"_30471":73040,"_21105":124784,"_5":14473,"_27705":124711,"_2959":120717},[],{"_3475":73078,"_30471":73040,"_21105":124786,"_5":14473,"_27705":124711,"_2959":124787},[],"La CA rechaza la emisión",{"_3475":73079,"_30471":73040,"_21105":124789,"_5":14473,"_27705":124711,"_2959":124790},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3475":73080,"_30471":73040,"_21105":124792,"_5":14473,"_27705":124711,"_2959":124793},[],"Sujeto o usos diferentes",{"_3475":73081,"_30471":73040,"_21105":124795,"_5":14473,"_27705":124711,"_2959":124796},[],"Perfil aplicado y valores solicitados.",{"_3475":73082,"_30471":73040,"_21105":124798,"_5":14473,"_27705":124711,"_2959":124799},[],"No se encuentra el emisor",{"_3475":73083,"_30471":73040,"_21105":124801,"_5":14473,"_27705":124711,"_2959":124802},[],"CA descargada y cadena intermedia necesaria.",{"_3475":73084,"_30471":73040,"_21105":124804,"_5":14473,"_27705":124711,"_2959":124805},[],"Falla la vigencia",{"_3475":73085,"_30471":73040,"_21105":124807,"_5":14473,"_27705":124711,"_2959":124808},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3475":73086,"_30471":73040,"_21105":124810,"_5":14473,"_27705":124711,"_2959":124811},[],"Los resúmenes de clave difieren",{"_3475":73087,"_30471":73040,"_21105":124813,"_5":14473,"_27705":124711,"_2959":124814},[],"Archivos de certificado y clave de la misma emisión.",{"_3475":73088,"_30471":73040,"_21105":124816,"_5":14473,"_27705":124711,"_2959":124817},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3475":73089,"_30471":73040,"_21105":124819,"_5":14473,"_27705":124714,"_2959":124820},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3475":73090,"_30471":73040,"_21105":124822,"_5":14473,"_27705":124714,"_2959":124823},[],"Gestionar certificados para inspección, estado y revocación.",{"_3475":73091,"_30471":73040,"_21105":124825,"_5":14473,"_27705":124714,"_2959":124826},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3475":73092,"_30471":73040,"_21105":124828,"_5":14473,"_27705":124714,"_2959":124829},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3475":73093,"_30471":73040,"_21105":124831,"_5":14473,"_27705":124714,"_2959":124832},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3475":73094,"_30471":73094,"_5":14825,"_2959":124834,"_30823":124835,"_21105":124836,"_27705":73094},"Primeros pasos de PKI",[49595,118538,55075,121866],[],{"_3475":73095,"_30471":73094,"_21105":124838,"_5":14473,"_27705":73094,"_2959":124839},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3475":73096,"_30471":73094,"_5":30820,"_21105":124841,"_27705":124842,"_2959":117109},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3475":73097,"_30471":73094,"_5":30820,"_21105":124844,"_27705":124845,"_2959":124846},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3475":73098,"_30471":73094,"_5":30820,"_21105":124848,"_27705":124849,"_2959":122048},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3475":73099,"_30471":73094,"_5":30820,"_21105":124851,"_27705":124852,"_2959":124853},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3475":73100,"_30471":73094,"_21105":124855,"_5":14473,"_27705":73094,"_2959":124856},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3475":73101,"_30471":73094,"_21105":124858,"_5":14473,"_27705":124842,"_2959":124859},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3475":73102,"_30471":73094,"_21105":124861,"_5":14473,"_27705":124842,"_2959":124862},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3475":73103,"_30471":73094,"_21105":124864,"_5":14473,"_27705":124842,"_2959":124865},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3475":73104,"_30471":73094,"_21105":124867,"_5":14473,"_27705":124842,"_2959":124868},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3475":73105,"_30471":73094,"_21105":124870,"_5":14473,"_27705":124842,"_2959":124871},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3475":73106,"_30471":73094,"_21105":124873,"_5":14473,"_27705":124845,"_2959":124874},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3475":73107,"_30471":73094,"_21105":124876,"_5":14473,"_27705":124845,"_2959":124877},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3475":73108,"_30471":73094,"_21105":124879,"_5":14473,"_27705":124845,"_2959":124880},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3475":73109,"_30471":73094,"_21105":124882,"_5":14473,"_27705":124845,"_2959":124883},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3475":73110,"_30471":73094,"_21105":124885,"_5":14473,"_27705":124849,"_2959":124886},[],"Archivo o recurso",{"_3475":73111,"_30471":73094,"_21105":124888,"_5":14473,"_27705":124849,"_2959":122045},[],{"_3475":73112,"_30471":73094,"_21105":124890,"_5":14473,"_27705":124849,"_2959":124891},[],"CA raíz activa y `ca.pem`",{"_3475":73113,"_30471":73094,"_21105":124893,"_5":14473,"_27705":124849,"_2959":124894},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3475":73114,"_30471":73094,"_21105":124896,"_5":14473,"_27705":124849,"_2959":124897},[],"Certificado final y `device.crt`",{"_3475":73115,"_30471":73094,"_21105":124899,"_5":14473,"_27705":124849,"_2959":124900},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3475":73116,"_30471":73094,"_21105":124902,"_5":14473,"_27705":124849,"_2959":124903},[],"Clave privada `device.key`",{"_3475":73117,"_30471":73094,"_21105":124905,"_5":14473,"_27705":124849,"_2959":124906},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3475":73118,"_30471":73094,"_21105":124908,"_5":14473,"_27705":124849,"_2959":124909},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3475":73119,"_30471":73094,"_21105":124911,"_5":14473,"_27705":124852,"_2959":124912},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3475":73120,"_30471":73094,"_21105":124914,"_5":14473,"_27705":124852,"_2959":124915},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3475":73121,"_30471":73094,"_21105":124917,"_5":14473,"_27705":124852,"_2959":124918},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3475":73122,"_30471":73122,"_5":14825,"_2959":124920,"_30823":124921,"_21105":124923,"_27705":73122},"Resolución de problemas PKI",[49595,118538,55075,124922],"Resolución de problemas",[],{"_3475":73123,"_30471":73122,"_21105":124925,"_5":14473,"_27705":73122,"_2959":124926},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3475":73124,"_30471":73122,"_5":30820,"_21105":124928,"_27705":124929,"_2959":124930},[],"/docs/pr-preview/pr-67/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3475":73125,"_30471":73122,"_5":30820,"_21105":124932,"_27705":124933,"_2959":124934},[],"/docs/pr-preview/pr-67/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3475":73126,"_30471":73122,"_5":30820,"_21105":124936,"_27705":124937,"_2959":124938},[],"/docs/pr-preview/pr-67/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3475":73127,"_30471":73122,"_21105":124940,"_5":14473,"_27705":73122,"_2959":124941},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3475":73128,"_30471":73122,"_21105":124943,"_5":14473,"_27705":73122,"_2959":124944},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3475":73129,"_30471":73122,"_21105":124946,"_5":14473,"_27705":124929,"_2959":122045},[],{"_3475":73130,"_30471":73122,"_21105":124948,"_5":14473,"_27705":124929,"_2959":120717},[],{"_3475":73131,"_30471":73122,"_21105":124950,"_5":14473,"_27705":124929,"_2959":117133},[],{"_3475":73132,"_30471":73122,"_21105":124952,"_5":14473,"_27705":124929,"_2959":53917},[],{"_3475":73133,"_30471":73122,"_21105":124954,"_5":14473,"_27705":124929,"_2959":124955},[],"Existe, está activa y sus fechas son utilizables.",{"_3475":73134,"_30471":73122,"_21105":124957,"_5":14473,"_27705":124929,"_2959":124958},[],"Autoridades.",{"_3475":73135,"_30471":73122,"_21105":124960,"_5":14473,"_27705":124929,"_2959":124961},[],"Clave",{"_3475":73136,"_30471":73122,"_21105":124963,"_5":14473,"_27705":124929,"_2959":124964},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3475":73137,"_30471":73122,"_21105":124966,"_5":14473,"_27705":124929,"_2959":124967},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3475":73138,"_30471":73122,"_21105":124969,"_5":14473,"_27705":124929,"_2959":57665},[],{"_3475":73139,"_30471":73122,"_21105":124971,"_5":14473,"_27705":124929,"_2959":124972},[],"PEM correcto y firma verificable.",{"_3475":73140,"_30471":73122,"_21105":124974,"_5":14473,"_27705":124929,"_2959":57671},[],{"_3475":73141,"_30471":73122,"_21105":124976,"_5":14473,"_27705":124929,"_2959":124977},[],"Perfil",{"_3475":73142,"_30471":73122,"_21105":124979,"_5":14473,"_27705":124929,"_2959":124980},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3475":73143,"_30471":73122,"_21105":124982,"_5":14473,"_27705":124929,"_2959":124983},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3475":73144,"_30471":73122,"_21105":124985,"_5":14473,"_27705":124929,"_2959":122196},[],{"_3475":73145,"_30471":73122,"_21105":124987,"_5":14473,"_27705":124929,"_2959":124988},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3475":73146,"_30471":73122,"_21105":124990,"_5":14473,"_27705":124929,"_2959":124991},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3475":73147,"_30471":73122,"_21105":124993,"_5":14473,"_27705":124929,"_2959":124994},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3475":73148,"_30471":73122,"_21105":124996,"_5":14473,"_27705":124929,"_2959":124997},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3475":73149,"_30471":73122,"_21105":124999,"_5":14473,"_27705":124933,"_2959":125000},[],"Revisa cada frontera por separado:",{"_3475":73150,"_30471":73122,"_21105":125002,"_5":14473,"_27705":124933,"_2959":125003},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3475":73151,"_30471":73122,"_21105":125005,"_5":14473,"_27705":124933,"_2959":125006},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3475":73152,"_30471":73122,"_21105":125008,"_5":14473,"_27705":124933,"_2959":125009},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3475":73153,"_30471":73122,"_21105":125011,"_5":14473,"_27705":124933,"_2959":125012},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3475":73154,"_30471":73122,"_21105":125014,"_5":14473,"_27705":124933,"_2959":125015},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3475":73155,"_30471":73122,"_21105":125017,"_5":14473,"_27705":124933,"_2959":125018},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3475":73156,"_30471":73122,"_21105":125020,"_5":14473,"_27705":124937,"_2959":125021},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3475":73157,"_30471":73122,"_21105":125023,"_5":14473,"_27705":124937,"_2959":125024},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3475":73158,"_30471":73158,"_5":14825,"_2959":125026,"_30823":125027,"_21105":125028,"_27705":73158},"Seguridad",[49595],[],{"_3475":73159,"_30471":73158,"_21105":125030,"_5":14473,"_27705":73158,"_2959":125031},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3475":73160,"_30471":73158,"_5":30820,"_21105":125033,"_27705":125034,"_2959":125035},[],"/docs/pr-preview/pr-67/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3475":73161,"_30471":73158,"_5":30820,"_21105":125037,"_27705":125038,"_2959":125039},[],"/docs/pr-preview/pr-67/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3475":73162,"_30471":73158,"_5":30820,"_21105":125041,"_27705":125042,"_2959":125043},[],"/docs/pr-preview/pr-67/es/security#versiones-soportadas","Versiones soportadas",{"_3475":73163,"_30471":73158,"_5":30820,"_21105":125045,"_27705":125046,"_2959":125047},[],"/docs/pr-preview/pr-67/es/security#divulgación-responsable","Divulgación responsable",{"_3475":73164,"_30471":73158,"_21105":125049,"_5":14473,"_27705":73158,"_2959":125050},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3475":73165,"_30471":73158,"_21105":125052,"_5":14473,"_27705":125034,"_2959":125053},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3475":73166,"_30471":73158,"_21105":125055,"_5":14473,"_27705":125034,"_2959":125056},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3475":73167,"_30471":73158,"_21105":125058,"_5":14473,"_27705":125034,"_2959":15104},[],{"_3475":73168,"_30471":73158,"_21105":125060,"_5":14473,"_27705":125034,"_2959":15044},[],{"_3475":73169,"_30471":73158,"_21105":125062,"_5":14473,"_27705":125034,"_2959":15091},[],{"_3475":73170,"_30471":73158,"_21105":125064,"_5":14473,"_27705":125034,"_2959":125065},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3475":73171,"_30471":73158,"_21105":125067,"_5":14473,"_27705":125034,"_2959":125068},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3475":73172,"_30471":73158,"_21105":125070,"_5":14473,"_27705":125038,"_2959":125071},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3475":73173,"_30471":73158,"_21105":125073,"_5":14473,"_27705":125038,"_2959":125074},[],"No incluyas en el reporte:",{"_3475":73174,"_30471":73158,"_21105":125076,"_5":14473,"_27705":125038,"_2959":125077},[],"Credenciales, tokens o claves privadas",{"_3475":73175,"_30471":73158,"_21105":125079,"_5":14473,"_27705":125038,"_2959":125080},[],"Datos de clientes o información identificable de clientes",{"_3475":73176,"_30471":73158,"_21105":125082,"_5":14473,"_27705":125038,"_2959":125083},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3475":73177,"_30471":73158,"_21105":125085,"_5":14473,"_27705":125042,"_2959":125086},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3475":73178,"_30471":73158,"_21105":125088,"_5":14473,"_27705":125042,"_2959":125089},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3475":73179,"_30471":73158,"_21105":125091,"_5":14473,"_27705":125046,"_2959":125092},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3475":73180,"_30471":73158,"_21105":125094,"_5":14473,"_27705":125046,"_2959":125095},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3475":73181,"_30471":73158,"_21105":125097,"_5":14473,"_27705":125046,"_2959":125098},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3475":73182,"_30471":73158,"_21105":125100,"_5":14473,"_27705":125046,"_2959":125101},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3475":73183,"_30471":73158,"_21105":125103,"_5":14473,"_27705":125046,"_2959":125104},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3475":73184,"_30471":73184,"_5":14825,"_2959":125106,"_30823":125107,"_21105":125109,"_27705":73184},"3.8.0 a 4.0.0",[49595,125108],"Actualizaciones",[],{"_3475":73185,"_30471":73184,"_21105":125111,"_5":14473,"_27705":73184,"_2959":125112},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3475":73186,"_30471":73184,"_5":30820,"_21105":125114,"_27705":125115,"_2959":125116},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3475":73187,"_30471":73184,"_5":30820,"_21105":125118,"_27705":125119,"_2959":125120},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3475":73188,"_30471":73184,"_5":30820,"_21105":125122,"_27705":125123,"_2959":125124},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3475":73189,"_30471":73184,"_5":30820,"_21105":125126,"_27705":125127,"_2959":125128},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3475":73190,"_30471":73184,"_5":30820,"_21105":125130,"_27705":125131,"_2959":125132},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3475":73191,"_30471":73184,"_5":30820,"_21105":125134,"_27705":125135,"_2959":125136},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3475":73192,"_30471":73184,"_5":30820,"_21105":125138,"_27705":125139,"_2959":57837},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3475":73193,"_30471":73184,"_5":30820,"_21105":125141,"_27705":125142,"_2959":125143},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3475":73194,"_30471":73184,"_5":30820,"_21105":125145,"_27705":125146,"_2959":125147},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3475":73195,"_30471":73184,"_5":30820,"_21105":125149,"_27705":125150,"_2959":125151},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3475":73196,"_30471":73184,"_5":30820,"_21105":125153,"_27705":125154,"_2959":125155},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3475":73197,"_30471":73184,"_5":30820,"_21105":125157,"_27705":125158,"_2959":125159},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3475":73198,"_30471":73184,"_5":30820,"_21105":125161,"_27705":125162,"_2959":125163},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3475":73199,"_30471":73184,"_5":30820,"_21105":125165,"_27705":125166,"_2959":125167},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3475":73200,"_30471":73184,"_5":30820,"_21105":125169,"_27705":125170,"_2959":125171},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3475":73201,"_30471":73184,"_5":30820,"_21105":125173,"_27705":125174,"_2959":125175},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3475":73202,"_30471":73184,"_5":30820,"_21105":125177,"_27705":125178,"_2959":125179},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3475":73203,"_30471":73184,"_5":30820,"_21105":125181,"_27705":125182,"_2959":125183},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3475":73204,"_30471":73184,"_5":30820,"_21105":125185,"_27705":125186,"_2959":125187},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3475":73205,"_30471":73184,"_5":30820,"_21105":125189,"_27705":125190,"_2959":125191},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3475":73206,"_30471":73184,"_5":30820,"_21105":125193,"_27705":125194,"_2959":125195},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3475":73207,"_30471":73184,"_5":30820,"_21105":125197,"_27705":125198,"_2959":125199},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3475":73208,"_30471":73184,"_5":30820,"_21105":125201,"_27705":125202,"_2959":125203},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3475":73209,"_30471":73184,"_5":30820,"_21105":125205,"_27705":125206,"_2959":125207},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3475":73210,"_30471":73184,"_5":30820,"_21105":125209,"_27705":125210,"_2959":125211},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3475":73211,"_30471":73184,"_5":30820,"_21105":125213,"_27705":125214,"_2959":125215},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3475":73212,"_30471":73184,"_5":30820,"_21105":125217,"_27705":125218,"_2959":125219},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3475":73213,"_30471":73184,"_5":30820,"_21105":125221,"_27705":125222,"_2959":125223},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3475":73214,"_30471":73184,"_5":30820,"_21105":125225,"_27705":125226,"_2959":125227},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3475":73215,"_30471":73184,"_5":30820,"_21105":125229,"_27705":125230,"_2959":125231},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3475":73216,"_30471":73184,"_5":30820,"_21105":125233,"_27705":125234,"_2959":125235},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3475":73217,"_30471":73184,"_5":30820,"_21105":125237,"_27705":125238,"_2959":125239},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3475":73218,"_30471":73184,"_5":30820,"_21105":125241,"_27705":125242,"_2959":125243},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3475":73219,"_30471":73184,"_5":30820,"_21105":125245,"_27705":125246,"_2959":125247},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3475":73220,"_30471":73184,"_5":30820,"_21105":125249,"_27705":125250,"_2959":125251},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3475":73221,"_30471":73184,"_5":30820,"_21105":125253,"_27705":125254,"_2959":125255},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3475":73222,"_30471":73184,"_5":30820,"_21105":125257,"_27705":125258,"_2959":125259},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3475":73223,"_30471":73184,"_5":30820,"_21105":125261,"_27705":125262,"_2959":125263},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3475":73224,"_30471":73184,"_5":30820,"_21105":125265,"_27705":125266,"_2959":125267},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3475":73225,"_30471":73184,"_5":30820,"_21105":125269,"_27705":125270,"_2959":125271},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3475":73226,"_30471":73184,"_5":30820,"_21105":125273,"_27705":125274,"_2959":121059},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3475":73227,"_30471":73184,"_5":30820,"_21105":125276,"_27705":125277,"_2959":125278},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3475":73228,"_30471":73184,"_5":30820,"_21105":125280,"_27705":125281,"_2959":125282},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3475":73229,"_30471":73184,"_21105":125284,"_5":14473,"_27705":73184,"_2959":125285},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3475":73230,"_30471":73184,"_21105":125287,"_5":14473,"_27705":73184,"_2959":125288},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3475":73231,"_30471":73184,"_21105":125290,"_5":14473,"_27705":73184,"_2959":125291},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3475":73232,"_30471":73184,"_21105":125293,"_5":14473,"_27705":73184,"_2959":125294},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3475":73233,"_30471":73184,"_21105":125296,"_5":14473,"_27705":73184,"_2959":125297},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3475":73234,"_30471":73184,"_21105":125299,"_5":14473,"_27705":73184,"_2959":125300},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3475":73235,"_30471":73184,"_21105":125302,"_5":14473,"_27705":73184,"_2959":125303},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3475":73236,"_30471":73184,"_21105":125305,"_5":14473,"_27705":125119,"_2959":125306},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3475":73237,"_30471":73184,"_21105":125308,"_5":14473,"_27705":125119,"_2959":125309},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3475":73238,"_30471":73184,"_21105":125311,"_5":14473,"_27705":125123,"_2959":125312},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3475":73239,"_30471":73184,"_21105":125314,"_5":14473,"_27705":125123,"_2959":125315},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3475":73240,"_30471":73184,"_21105":125317,"_5":14473,"_27705":125127,"_2959":125318},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3475":73241,"_30471":73184,"_21105":125320,"_5":14473,"_27705":125131,"_2959":125321},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3475":73242,"_30471":73184,"_21105":125323,"_5":14473,"_27705":125131,"_2959":125324},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3475":73243,"_30471":73184,"_21105":125326,"_5":14473,"_27705":125131,"_2959":125327},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3475":73244,"_30471":73184,"_21105":125329,"_5":14473,"_27705":125131,"_2959":125330},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3475":73245,"_30471":73184,"_21105":125332,"_5":14473,"_27705":125131,"_2959":125333},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3475":73246,"_30471":73184,"_21105":125335,"_5":14473,"_27705":125135,"_2959":125336},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3475":73247,"_30471":73184,"_21105":125338,"_5":14473,"_27705":125135,"_2959":125339},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3475":73248,"_30471":73184,"_21105":125341,"_5":14473,"_27705":125135,"_2959":125342},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3475":73249,"_30471":73184,"_21105":125344,"_5":14473,"_27705":125135,"_2959":125345},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3475":73250,"_30471":73184,"_21105":125347,"_5":14473,"_27705":125135,"_2959":125348},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3475":73251,"_30471":73184,"_21105":125350,"_5":14473,"_27705":125135,"_2959":125351},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3475":73252,"_30471":73184,"_21105":125353,"_5":14473,"_27705":125139,"_2959":125354},[],"Cambio",{"_3475":73253,"_30471":73184,"_21105":125356,"_5":14473,"_27705":125139,"_2959":125357},[],"A quién afecta",{"_3475":73254,"_30471":73184,"_21105":125359,"_5":14473,"_27705":125139,"_2959":125360},[],"Gravedad",{"_3475":73255,"_30471":73184,"_21105":125362,"_5":14473,"_27705":125139,"_2959":123833},[],{"_3475":73256,"_30471":73184,"_21105":125364,"_5":14473,"_27705":125139,"_2959":125147},[],{"_3475":73257,"_30471":73184,"_21105":125366,"_5":14473,"_27705":125139,"_2959":125367},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3475":73258,"_30471":73184,"_21105":125369,"_5":14473,"_27705":125139,"_2959":125370},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3475":73259,"_30471":73184,"_21105":125372,"_5":14473,"_27705":125139,"_2959":125373},[],"Copiar los datos a los volúmenes nuevos",{"_3475":73260,"_30471":73184,"_21105":125375,"_5":14473,"_27705":125139,"_2959":125151},[],{"_3475":73261,"_30471":73184,"_21105":125377,"_5":14473,"_27705":125139,"_2959":125378},[],"Todas las releases de Helm",{"_3475":73262,"_30471":73184,"_21105":125380,"_5":14473,"_27705":125139,"_2959":125381},[],"Alta: `helm upgrade` falla",{"_3475":73263,"_30471":73184,"_21105":125383,"_5":14473,"_27705":125139,"_2959":125384},[],"Eliminar o renombrar las claves heredadas",{"_3475":73264,"_30471":73184,"_21105":125386,"_5":14473,"_27705":125139,"_2959":125155},[],{"_3475":73265,"_30471":73184,"_21105":125388,"_5":14473,"_27705":125139,"_2959":125389},[],"Todos los despliegues",{"_3475":73266,"_30471":73184,"_21105":125391,"_5":14473,"_27705":125139,"_2959":125392},[],"Alta: sin principal de bootstrap no hay administrador",{"_3475":73267,"_30471":73184,"_21105":125394,"_5":14473,"_27705":125139,"_2959":125395},[],"Configurar `services.authz`",{"_3475":73268,"_30471":73184,"_21105":125397,"_5":14473,"_27705":125139,"_2959":125159},[],{"_3475":73269,"_30471":73184,"_21105":125399,"_5":14473,"_27705":125139,"_2959":125378},[],{"_3475":73270,"_30471":73184,"_21105":125401,"_5":14473,"_27705":125139,"_2959":125402},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3475":73271,"_30471":73184,"_21105":125404,"_5":14473,"_27705":125139,"_2959":125405},[],"Mover JWKS y roles a `services.authz`",{"_3475":73272,"_30471":73184,"_21105":125407,"_5":14473,"_27705":125139,"_2959":125179},[],{"_3475":73273,"_30471":73184,"_21105":125409,"_5":14473,"_27705":125139,"_2959":125410},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3475":73274,"_30471":73184,"_21105":125412,"_5":14473,"_27705":125139,"_2959":125413},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3475":73275,"_30471":73184,"_21105":125415,"_5":14473,"_27705":125139,"_2959":125416},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3475":73276,"_30471":73184,"_21105":125418,"_5":14473,"_27705":125139,"_2959":125183},[],{"_3475":73277,"_30471":73184,"_21105":125420,"_5":14473,"_27705":125139,"_2959":125421},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3475":73278,"_30471":73184,"_21105":125423,"_5":14473,"_27705":125139,"_2959":125424},[],"Alta: el backend ya no arranca con ellos",{"_3475":73279,"_30471":73184,"_21105":125426,"_5":14473,"_27705":125139,"_2959":125427},[],"Pasar a PostgreSQL antes de actualizar",{"_3475":73280,"_30471":73184,"_21105":125429,"_5":14473,"_27705":125139,"_2959":125227},[],{"_3475":73281,"_30471":73184,"_21105":125431,"_5":14473,"_27705":125139,"_2959":125432},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3475":73282,"_30471":73184,"_21105":125434,"_5":14473,"_27705":125139,"_2959":125435},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3475":73283,"_30471":73184,"_21105":125437,"_5":14473,"_27705":125139,"_2959":125438},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3475":73284,"_30471":73184,"_21105":125440,"_5":14473,"_27705":125139,"_2959":125441},[],"Webhooks con referencias a archivos",{"_3475":73285,"_30471":73184,"_21105":125443,"_5":14473,"_27705":125139,"_2959":125444},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3475":73286,"_30471":73184,"_21105":125446,"_5":14473,"_27705":125139,"_2959":125447},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3475":73287,"_30471":73184,"_21105":125449,"_5":14473,"_27705":125139,"_2959":125450},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3475":73288,"_30471":73184,"_21105":125452,"_5":14473,"_27705":125139,"_2959":125163},[],{"_3475":73289,"_30471":73184,"_21105":125454,"_5":14473,"_27705":125139,"_2959":125455},[],"Releases con identidades por servicio o material de claves montado",{"_3475":73290,"_30471":73184,"_21105":125457,"_5":14473,"_27705":125139,"_2959":125458},[],"Media: los servicios no pueden leer sus archivos",{"_3475":73291,"_30471":73184,"_21105":125460,"_5":14473,"_27705":125139,"_2959":125461},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3475":73292,"_30471":73184,"_21105":125463,"_5":14473,"_27705":125139,"_2959":125167},[],{"_3475":73293,"_30471":73184,"_21105":125465,"_5":14473,"_27705":125139,"_2959":125466},[],"Releases que definen `amqp.tls`",{"_3475":73294,"_30471":73184,"_21105":125468,"_5":14473,"_27705":125139,"_2959":125469},[],"Media: los clientes se conectan al puerto equivocado",{"_3475":73295,"_30471":73184,"_21105":125471,"_5":14473,"_27705":125139,"_2959":125472},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3475":73296,"_30471":73184,"_21105":125474,"_5":14473,"_27705":125139,"_2959":125187},[],{"_3475":73297,"_30471":73184,"_21105":125476,"_5":14473,"_27705":125139,"_2959":125477},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3475":73298,"_30471":73184,"_21105":125479,"_5":14473,"_27705":125139,"_2959":125480},[],"Media: las claves de CA quedan sin gestionar",{"_3475":73299,"_30471":73184,"_21105":125482,"_5":14473,"_27705":125139,"_2959":125483},[],"Ejecutar la migración de CA a KMS",{"_3475":73300,"_30471":73184,"_21105":125485,"_5":14473,"_27705":125139,"_2959":125486},[],"Verificación del certificado del receptor",{"_3475":73301,"_30471":73184,"_21105":125488,"_5":14473,"_27705":125139,"_2959":125489},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3475":73302,"_30471":73184,"_21105":125491,"_5":14473,"_27705":125139,"_2959":125492},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3475":73303,"_30471":73184,"_21105":125494,"_5":14473,"_27705":125139,"_2959":125495},[],"Poner `insecure_skip_verify` a `false`",{"_3475":73304,"_30471":73184,"_21105":125497,"_5":14473,"_27705":125139,"_2959":125203},[],{"_3475":73305,"_30471":73184,"_21105":125499,"_5":14473,"_27705":125139,"_2959":125500},[],"Scripts y consolas que editan DMS por API",{"_3475":73306,"_30471":73184,"_21105":125502,"_5":14473,"_27705":125139,"_2959":125503},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3475":73307,"_30471":73184,"_21105":125505,"_5":14473,"_27705":125139,"_2959":125506},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3475":73308,"_30471":73184,"_21105":125508,"_5":14473,"_27705":125139,"_2959":125223},[],{"_3475":73309,"_30471":73184,"_21105":125510,"_5":14473,"_27705":125139,"_2959":125511},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3475":73310,"_30471":73184,"_21105":125513,"_5":14473,"_27705":125139,"_2959":125514},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3475":73311,"_30471":73184,"_21105":125516,"_5":14473,"_27705":125139,"_2959":125517},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3475":73312,"_30471":73184,"_21105":125519,"_5":14473,"_27705":125139,"_2959":125231},[],{"_3475":73313,"_30471":73184,"_21105":125521,"_5":14473,"_27705":125139,"_2959":125522},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3475":73314,"_30471":73184,"_21105":125524,"_5":14473,"_27705":125139,"_2959":125525},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3475":73315,"_30471":73184,"_21105":125527,"_5":14473,"_27705":125139,"_2959":125528},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3475":73316,"_30471":73184,"_21105":125530,"_5":14473,"_27705":125139,"_2959":125219},[],{"_3475":73317,"_30471":73184,"_21105":125532,"_5":14473,"_27705":125139,"_2959":125533},[],"Consumidores que leen el campo `events` del dispositivo",{"_3475":73318,"_30471":73184,"_21105":125535,"_5":14473,"_27705":125139,"_2959":125536},[],"Media: el campo desaparece",{"_3475":73319,"_30471":73184,"_21105":125538,"_5":14473,"_27705":125139,"_2959":125539},[],"Usar los nuevos endpoints de eventos",{"_3475":73320,"_30471":73184,"_21105":125541,"_5":14473,"_27705":125139,"_2959":125239},[],{"_3475":73321,"_30471":73184,"_21105":125543,"_5":14473,"_27705":125139,"_2959":125544},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3475":73322,"_30471":73184,"_21105":125546,"_5":14473,"_27705":125139,"_2959":125547},[],"Media: la migración de la VA aborta",{"_3475":73323,"_30471":73184,"_21105":125549,"_5":14473,"_27705":125139,"_2959":125550},[],"Corregir los roles afectados antes de actualizar",{"_3475":73324,"_30471":73184,"_21105":125552,"_5":14473,"_27705":125139,"_2959":125171},[],{"_3475":73325,"_30471":73184,"_21105":125554,"_5":14473,"_27705":125139,"_2959":125555},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3475":73326,"_30471":73184,"_21105":125557,"_5":14473,"_27705":125139,"_2959":125558},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3475":73327,"_30471":73184,"_21105":125560,"_5":14473,"_27705":125139,"_2959":125561},[],"Actualizar el archivo de values",{"_3475":73328,"_30471":73184,"_21105":125563,"_5":14473,"_27705":125139,"_2959":125211},[],{"_3475":73329,"_30471":73184,"_21105":125565,"_5":14473,"_27705":125139,"_2959":125566},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3475":73330,"_30471":73184,"_21105":125568,"_5":14473,"_27705":125139,"_2959":125569},[],"Baja: prevalece el ID de la URL",{"_3475":73331,"_30471":73184,"_21105":125571,"_5":14473,"_27705":125139,"_2959":125572},[],"Enviar el ID en la URL",{"_3475":73332,"_30471":73184,"_21105":125574,"_5":14473,"_27705":125139,"_2959":125235},[],{"_3475":73333,"_30471":73184,"_21105":125576,"_5":14473,"_27705":125139,"_2959":125577},[],"Clientes que envían un `id` al crear o importar CAs",{"_3475":73334,"_30471":73184,"_21105":125579,"_5":14473,"_27705":125139,"_2959":125580},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3475":73335,"_30471":73184,"_21105":125582,"_5":14473,"_27705":125139,"_2959":125583},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3475":73336,"_30471":73184,"_21105":125585,"_5":14473,"_27705":125139,"_2959":125215},[],{"_3475":73337,"_30471":73184,"_21105":125587,"_5":14473,"_27705":125139,"_2959":125588},[],"Consumidores que comparan el `type` del certificado",{"_3475":73338,"_30471":73184,"_21105":125590,"_5":14473,"_27705":125139,"_2959":125591},[],"Baja: dos valores cambian de nombre",{"_3475":73339,"_30471":73184,"_21105":125593,"_5":14473,"_27705":125139,"_2959":125594},[],"Adaptar los consumidores",{"_3475":73340,"_30471":73184,"_21105":125596,"_5":14473,"_27705":125139,"_2959":125207},[],{"_3475":73341,"_30471":73184,"_21105":125598,"_5":14473,"_27705":125139,"_2959":125599},[],"Cualquier DMS",{"_3475":73342,"_30471":73184,"_21105":125601,"_5":14473,"_27705":125139,"_2959":125602},[],"Baja: solo informativo",{"_3475":73343,"_30471":73184,"_21105":125604,"_5":14473,"_27705":125139,"_2959":125605},[],"Revisar ambos bloques antes de editar",{"_3475":73344,"_30471":73184,"_21105":125607,"_5":14473,"_27705":125146,"_2959":125608},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3475":73345,"_30471":73184,"_21105":125610,"_5":14473,"_27705":125146,"_2959":125611},[],"El paso 4 de la guía de migración copia los datos.",{"_3475":73346,"_30471":73184,"_21105":125613,"_5":14473,"_27705":125150,"_2959":125614},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3475":73347,"_30471":73184,"_21105":125616,"_5":14473,"_27705":125154,"_2959":125617},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3475":73348,"_30471":73184,"_21105":125619,"_5":14473,"_27705":125158,"_2959":125620},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3475":73349,"_30471":73184,"_21105":125622,"_5":14473,"_27705":125162,"_2959":125623},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3475":73350,"_30471":73184,"_21105":125625,"_5":14473,"_27705":125162,"_2959":125626},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3475":73351,"_30471":73184,"_21105":125628,"_5":14473,"_27705":125166,"_2959":125629},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3475":73352,"_30471":73184,"_21105":125631,"_5":14473,"_27705":125170,"_2959":125632},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3475":73353,"_30471":73184,"_21105":125634,"_5":14473,"_27705":125170,"_2959":125635},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3475":73354,"_30471":73184,"_21105":125637,"_5":14473,"_27705":125170,"_2959":125638},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3475":73355,"_30471":73184,"_21105":125640,"_5":14473,"_27705":125170,"_2959":125641},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3475":73356,"_30471":73184,"_21105":125643,"_5":14473,"_27705":125170,"_2959":125644},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3475":73357,"_30471":73184,"_21105":125646,"_5":14473,"_27705":125170,"_2959":125647},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3475":73358,"_30471":73184,"_21105":125649,"_5":14473,"_27705":125178,"_2959":125650},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3475":73359,"_30471":73184,"_21105":125652,"_5":14473,"_27705":125178,"_2959":125653},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3475":73360,"_30471":73184,"_21105":125655,"_5":14473,"_27705":125178,"_2959":125656},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3475":73361,"_30471":73184,"_21105":125658,"_5":14473,"_27705":125178,"_2959":125659},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3475":73362,"_30471":73184,"_21105":125661,"_5":14473,"_27705":125178,"_2959":125662},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3475":73363,"_30471":73184,"_21105":125664,"_5":14473,"_27705":125182,"_2959":125665},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3475":73364,"_30471":73184,"_21105":125667,"_5":14473,"_27705":125186,"_2959":125668},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3475":73365,"_30471":73184,"_21105":125670,"_5":14473,"_27705":125186,"_2959":125671},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3475":73366,"_30471":73184,"_21105":125673,"_5":14473,"_27705":125186,"_2959":125674},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3475":73367,"_30471":73184,"_21105":125676,"_5":14473,"_27705":125186,"_2959":125677},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3475":73368,"_30471":73184,"_21105":125679,"_5":14473,"_27705":125186,"_2959":125680},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3475":73369,"_30471":73184,"_21105":125682,"_5":14473,"_27705":125186,"_2959":125683},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3475":73370,"_30471":73184,"_21105":125685,"_5":14473,"_27705":125186,"_2959":125686},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3475":73371,"_30471":73184,"_21105":125688,"_5":14473,"_27705":125186,"_2959":125689},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3475":73372,"_30471":73184,"_21105":125691,"_5":14473,"_27705":125190,"_2959":125692},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3475":73373,"_30471":73184,"_21105":125694,"_5":14473,"_27705":125198,"_2959":125695},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3475":73374,"_30471":73184,"_21105":125697,"_5":14473,"_27705":125198,"_2959":125698},[],"Campo en 3.8.0",{"_3475":73375,"_30471":73184,"_21105":125700,"_5":14473,"_27705":125198,"_2959":125701},[],"Campo en 4.0.0",{"_3475":73376,"_30471":73184,"_21105":125703,"_5":14473,"_27705":125198,"_2959":58402},[],{"_3475":73377,"_30471":73184,"_21105":125705,"_5":14473,"_27705":125198,"_2959":125706},[],"`insecure_skip_verify` (con el valor negado)",{"_3475":73378,"_30471":73184,"_21105":125708,"_5":14473,"_27705":125198,"_2959":58408},[],{"_3475":73379,"_30471":73184,"_21105":125710,"_5":14473,"_27705":125198,"_2959":58411},[],{"_3475":73380,"_30471":73184,"_21105":125712,"_5":14473,"_27705":125198,"_2959":58414},[],{"_3475":73381,"_30471":73184,"_21105":125714,"_5":14473,"_27705":125198,"_2959":58417},[],{"_3475":73382,"_30471":73184,"_21105":125716,"_5":14473,"_27705":125198,"_2959":58420},[],{"_3475":73383,"_30471":73184,"_21105":125718,"_5":14473,"_27705":125198,"_2959":58423},[],{"_3475":73384,"_30471":73184,"_21105":125720,"_5":14473,"_27705":125198,"_2959":125721},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3475":73385,"_30471":73184,"_21105":125723,"_5":14473,"_27705":125198,"_2959":125724},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3475":73386,"_30471":73184,"_21105":125726,"_5":14473,"_27705":125198,"_2959":125727},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3475":73387,"_30471":73184,"_21105":125729,"_5":14473,"_27705":125202,"_2959":125730},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3475":73388,"_30471":73184,"_21105":125732,"_5":14473,"_27705":125202,"_2959":125733},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3475":73389,"_30471":73184,"_21105":125735,"_5":14473,"_27705":125202,"_2959":125736},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3475":73390,"_30471":73184,"_21105":125738,"_5":14473,"_27705":125206,"_2959":125739},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3475":73391,"_30471":73184,"_21105":125741,"_5":14473,"_27705":125210,"_2959":125742},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3475":73392,"_30471":73184,"_21105":125744,"_5":14473,"_27705":125214,"_2959":125745},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3475":73393,"_30471":73184,"_21105":125747,"_5":14473,"_27705":125218,"_2959":125748},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3475":73394,"_30471":73184,"_21105":125750,"_5":14473,"_27705":125218,"_2959":125751},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3475":73395,"_30471":73184,"_21105":125753,"_5":14473,"_27705":125218,"_2959":125754},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3475":73396,"_30471":73184,"_21105":125756,"_5":14473,"_27705":125218,"_2959":125757},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3475":73397,"_30471":73184,"_21105":125759,"_5":14473,"_27705":125222,"_2959":125760},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3475":73398,"_30471":73184,"_21105":125762,"_5":14473,"_27705":125226,"_2959":125763},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3475":73399,"_30471":73184,"_21105":125765,"_5":14473,"_27705":125226,"_2959":125766},[],"Ruta",{"_3475":73400,"_30471":73184,"_21105":125768,"_5":14473,"_27705":125226,"_2959":118298},[],{"_3475":73401,"_30471":73184,"_21105":125770,"_5":14473,"_27705":125226,"_2959":58476},[],{"_3475":73402,"_30471":73184,"_21105":125772,"_5":14473,"_27705":125226,"_2959":125773},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3475":73403,"_30471":73184,"_21105":125775,"_5":14473,"_27705":125226,"_2959":58482},[],{"_3475":73404,"_30471":73184,"_21105":125777,"_5":14473,"_27705":125226,"_2959":125778},[],"Lee los ajustes de una CA.",{"_3475":73405,"_30471":73184,"_21105":125780,"_5":14473,"_27705":125226,"_2959":58488},[],{"_3475":73406,"_30471":73184,"_21105":125782,"_5":14473,"_27705":125226,"_2959":125783},[],"Sustituye los `crl_options`.",{"_3475":73407,"_30471":73184,"_21105":125785,"_5":14473,"_27705":125226,"_2959":125786},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3475":73408,"_30471":73184,"_21105":125788,"_5":14473,"_27705":125226,"_2959":125789},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3475":73409,"_30471":73184,"_21105":125791,"_5":14473,"_27705":125226,"_2959":125792},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3475":73410,"_30471":73184,"_21105":125794,"_5":14473,"_27705":125226,"_2959":125795},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3475":73411,"_30471":73184,"_21105":125797,"_5":14473,"_27705":125226,"_2959":125798},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3475":73412,"_30471":73184,"_21105":125800,"_5":14473,"_27705":125226,"_2959":125801},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3475":73413,"_30471":73184,"_21105":125803,"_5":14473,"_27705":125226,"_2959":125804},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3475":73414,"_30471":73184,"_21105":125806,"_5":14473,"_27705":125226,"_2959":125807},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3475":73415,"_30471":73184,"_21105":125809,"_5":14473,"_27705":125226,"_2959":125810},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3475":73416,"_30471":73184,"_21105":125812,"_5":14473,"_27705":125226,"_2959":125813},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3475":73417,"_30471":73184,"_21105":125815,"_5":14473,"_27705":125226,"_2959":125816},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3475":73418,"_30471":73184,"_21105":125818,"_5":14473,"_27705":125230,"_2959":125819},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3475":73419,"_30471":73184,"_21105":125821,"_5":14473,"_27705":125234,"_2959":125822},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3475":73420,"_30471":73184,"_21105":125824,"_5":14473,"_27705":125238,"_2959":125825},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3475":73421,"_30471":73184,"_21105":125827,"_5":14473,"_27705":125242,"_2959":125828},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3475":73422,"_30471":73184,"_21105":125830,"_5":14473,"_27705":125246,"_2959":125831},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3475":73423,"_30471":73184,"_21105":125833,"_5":14473,"_27705":125246,"_2959":125834},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3475":73424,"_30471":73184,"_21105":125836,"_5":14473,"_27705":125246,"_2959":125837},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3475":73425,"_30471":73184,"_21105":125839,"_5":14473,"_27705":125246,"_2959":125840},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3475":73426,"_30471":73184,"_21105":125842,"_5":14473,"_27705":125246,"_2959":125843},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3475":73427,"_30471":73184,"_21105":125845,"_5":14473,"_27705":125246,"_2959":125846},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3475":73428,"_30471":73184,"_21105":125848,"_5":14473,"_27705":125250,"_2959":125849},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3475":73429,"_30471":73184,"_21105":125851,"_5":14473,"_27705":125250,"_2959":125852},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3475":73430,"_30471":73184,"_21105":125854,"_5":14473,"_27705":125250,"_2959":125855},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3475":73431,"_30471":73184,"_21105":125857,"_5":14473,"_27705":125250,"_2959":125858},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3475":73432,"_30471":73184,"_21105":125860,"_5":14473,"_27705":125250,"_2959":125861},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3475":73433,"_30471":73184,"_21105":125863,"_5":14473,"_27705":125254,"_2959":125864},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3475":73434,"_30471":73184,"_21105":125866,"_5":14473,"_27705":125254,"_2959":125867},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3475":73435,"_30471":73184,"_21105":125869,"_5":14473,"_27705":125254,"_2959":125870},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3475":73436,"_30471":73184,"_21105":125872,"_5":14473,"_27705":125254,"_2959":125873},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3475":73437,"_30471":73184,"_21105":125875,"_5":14473,"_27705":125254,"_2959":125876},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3475":73438,"_30471":73184,"_21105":125878,"_5":14473,"_27705":125254,"_2959":125879},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3475":73439,"_30471":73184,"_21105":125881,"_5":14473,"_27705":125254,"_2959":125882},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3475":73440,"_30471":73184,"_21105":125884,"_5":14473,"_27705":125254,"_2959":125885},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3475":73441,"_30471":73184,"_21105":125887,"_5":14473,"_27705":125254,"_2959":125888},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3475":73442,"_30471":73184,"_21105":125890,"_5":14473,"_27705":125254,"_2959":125891},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3475":73443,"_30471":73184,"_21105":125893,"_5":14473,"_27705":125254,"_2959":125894},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3475":73444,"_30471":73184,"_21105":125896,"_5":14473,"_27705":125254,"_2959":125897},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3475":73445,"_30471":73184,"_21105":125899,"_5":14473,"_27705":125258,"_2959":125900},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3475":73446,"_30471":73184,"_21105":125902,"_5":14473,"_27705":125258,"_2959":125903},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3475":73447,"_30471":73184,"_21105":125905,"_5":14473,"_27705":125262,"_2959":125906},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3475":73448,"_30471":73184,"_21105":125908,"_5":14473,"_27705":125262,"_2959":125909},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3475":73449,"_30471":73184,"_21105":125911,"_5":14473,"_27705":125262,"_2959":125912},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3475":73450,"_30471":73184,"_21105":125914,"_5":14473,"_27705":125262,"_2959":125915},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3475":73451,"_30471":73184,"_21105":125917,"_5":14473,"_27705":125262,"_2959":125918},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3475":73452,"_30471":73184,"_21105":125920,"_5":14473,"_27705":125262,"_2959":125921},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3475":73453,"_30471":73184,"_21105":125923,"_5":14473,"_27705":125262,"_2959":125924},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3475":73454,"_30471":73184,"_21105":125926,"_5":14473,"_27705":125262,"_2959":125927},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3475":73455,"_30471":73184,"_21105":125929,"_5":14473,"_27705":125262,"_2959":125930},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3475":73456,"_30471":73184,"_21105":125932,"_5":14473,"_27705":125262,"_2959":125933},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3475":73457,"_30471":73184,"_21105":125935,"_5":14473,"_27705":125262,"_2959":125936},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3475":73458,"_30471":73184,"_21105":125938,"_5":14473,"_27705":125266,"_2959":125939},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3475":73459,"_30471":73184,"_21105":125941,"_5":14473,"_27705":125266,"_2959":125942},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3475":73460,"_30471":73184,"_21105":125944,"_5":14473,"_27705":125270,"_2959":125945},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3475":73461,"_30471":73184,"_21105":125947,"_5":14473,"_27705":125270,"_2959":125948},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3475":73462,"_30471":73184,"_21105":125950,"_5":14473,"_27705":125270,"_2959":125951},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3475":73463,"_30471":73184,"_21105":125953,"_5":14473,"_27705":125270,"_2959":125954},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3475":73464,"_30471":73184,"_21105":125956,"_5":14473,"_27705":125270,"_2959":125957},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3475":73465,"_30471":73184,"_21105":125959,"_5":14473,"_27705":125270,"_2959":125960},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3475":73466,"_30471":73184,"_21105":125962,"_5":14473,"_27705":125270,"_2959":125963},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3475":73467,"_30471":73184,"_21105":125965,"_5":14473,"_27705":125270,"_2959":125966},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3475":73468,"_30471":73184,"_21105":125968,"_5":14473,"_27705":125274,"_2959":125969},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3475":73469,"_30471":73184,"_21105":125971,"_5":14473,"_27705":125274,"_2959":125972},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3475":73470,"_30471":73184,"_21105":125974,"_5":14473,"_27705":125274,"_2959":125975},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3475":73471,"_30471":73184,"_21105":125977,"_5":14473,"_27705":125274,"_2959":125978},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3475":73472,"_30471":73184,"_21105":125980,"_5":14473,"_27705":125274,"_2959":125981},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3475":73473,"_30471":73184,"_21105":125983,"_5":14473,"_27705":125274,"_2959":125984},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3475":73474,"_30471":73184,"_21105":125986,"_5":14473,"_27705":125274,"_2959":125987},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3475":73475,"_30471":73184,"_21105":125989,"_5":14473,"_27705":125274,"_2959":125990},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3475":73476,"_30471":73184,"_21105":125992,"_5":14473,"_27705":125274,"_2959":125993},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3475":73477,"_30471":73184,"_21105":125995,"_5":14473,"_27705":125274,"_2959":125996},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3475":73478,"_30471":73184,"_21105":125998,"_5":14473,"_27705":125274,"_2959":125999},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3475":73479,"_30471":73184,"_21105":126001,"_5":14473,"_27705":125277,"_2959":126002},[],"Tras la actualización, comprueba en este orden:",{"_3475":73480,"_30471":73184,"_21105":126004,"_5":14473,"_27705":125277,"_2959":126005},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3475":73481,"_30471":73184,"_21105":126007,"_5":14473,"_27705":125277,"_2959":126008},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3475":73482,"_30471":73184,"_21105":126010,"_5":14473,"_27705":125277,"_2959":126011},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3475":73483,"_30471":73184,"_21105":126013,"_5":14473,"_27705":125277,"_2959":126014},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3475":73484,"_30471":73184,"_21105":126016,"_5":14473,"_27705":125277,"_2959":126017},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3475":73485,"_30471":73184,"_21105":126019,"_5":14473,"_27705":125277,"_2959":126020},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3475":73486,"_30471":73184,"_21105":126022,"_5":14473,"_27705":125277,"_2959":126023},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3475":73487,"_30471":73184,"_21105":126025,"_5":14473,"_27705":125277,"_2959":126026},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3475":73488,"_30471":73184,"_21105":126028,"_5":14473,"_27705":125277,"_2959":126029},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3475":73489,"_30471":73184,"_21105":126031,"_5":14473,"_27705":125277,"_2959":126032},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3475":73490,"_30471":73184,"_21105":126034,"_5":14473,"_27705":125277,"_2959":126035},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3475":73491,"_30471":73184,"_21105":126037,"_5":14473,"_27705":125277,"_2959":126038},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3475":73492,"_30471":73184,"_21105":126040,"_5":14473,"_27705":125277,"_2959":126041},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3475":73493,"_30471":73184,"_21105":126043,"_5":14473,"_27705":125277,"_2959":126044},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3475":73494,"_30471":73184,"_21105":126046,"_5":14473,"_27705":125277,"_2959":126047},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3475":73495,"_30471":73184,"_21105":126049,"_5":14473,"_27705":125281,"_2959":126050},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3475":73496,"_30471":73184,"_21105":126052,"_5":14473,"_27705":125281,"_2959":126053},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3475":73497,"_30471":73184,"_21105":126055,"_5":14473,"_27705":125281,"_2959":126056},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3475":73498,"_30471":73184,"_21105":126058,"_5":14473,"_27705":125281,"_2959":126059},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3475":73499,"_30471":73184,"_21105":126061,"_5":14473,"_27705":125281,"_2959":126062},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58773":126064,"_58775":126065,"_58777":126066,"_58779":126067,"_18268":2994,"_70554":2994},"spanish",[2959,30471,5,27705],{"_2959":25243,"_30471":25243,"_5":25243,"_27705":25243},{"_2959":126068,"_30471":129010,"_5":131952,"_27705":134894},{"_4675":126069,"_58783":126070,"_5":25243},{"_14549":3265,"_14936":4765,"_14955":4074,"_29474":3454,"_14942":4623,"_20024":6023,"_14570":10551,"_14577":18965,"_29416":3051,"_29825":7046,"_29846":4392,"_29450":7107,"_34823":4055,"_29553":20516,"_29890":9944,"_34830":5286,"_34833":4983,"_34836":7090,"_34839":6251,"_30297":22329,"_34844":4760,"_34846":5089,"_30327":3292,"_14951":6552,"_34850":75