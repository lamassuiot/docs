9289,"_27449":49290,"_2949":49291},[],"/docs/pr-preview/pr-67/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3465":20,"_30211":15,"_5":30560,"_20923":49293,"_27449":49294,"_2949":49295},[],"/docs/pr-preview/pr-67/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3465":21,"_30211":15,"_5":30560,"_20923":49297,"_27449":49298,"_2949":49299},[],"/docs/pr-preview/pr-67/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3465":22,"_30211":15,"_5":30560,"_20923":49301,"_27449":49302,"_2949":49303},[],"/docs/pr-preview/pr-67/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3465":23,"_30211":15,"_5":30560,"_20923":49305,"_27449":49306,"_2949":49307},[],"/docs/pr-preview/pr-67/deployment/aws-marketplace#next-step","Next step",{"_3465":24,"_30211":15,"_20923":49309,"_5":14374,"_27449":15,"_2949":49310},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3465":25,"_30211":15,"_20923":49312,"_5":14374,"_27449":49282,"_2949":49313},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3465":26,"_30211":15,"_20923":49315,"_5":14374,"_27449":49282,"_2949":49316},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3465":27,"_30211":15,"_20923":49318,"_5":14374,"_27449":49282,"_2949":49319},[],"A security group allowing the necessary endpoints.",{"_3465":28,"_30211":15,"_20923":49321,"_5":14374,"_27449":49286,"_2949":49322},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3465":29,"_30211":15,"_20923":49324,"_5":14374,"_27449":49286,"_2949":49325},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3465":30,"_30211":15,"_20923":49327,"_5":14374,"_27449":49286,"_2949":49328},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3465":31,"_30211":15,"_20923":49330,"_5":14374,"_27449":49290,"_2949":49331},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3465":32,"_30211":15,"_20923":49333,"_5":14374,"_27449":49294,"_2949":49334},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3465":33,"_30211":15,"_20923":49336,"_5":14374,"_27449":49298,"_2949":49337},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3465":34,"_30211":15,"_20923":49339,"_5":14374,"_27449":49302,"_2949":49340},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3465":35,"_30211":15,"_20923":49342,"_5":14374,"_27449":49306,"_2949":49343},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3465":36,"_30211":36,"_5":14726,"_2949":49345,"_30563":49346,"_20923":49347,"_27449":36},"Deploy Lamassu",[49273,49274],[],{"_3465":37,"_30211":36,"_20923":49349,"_5":14374,"_27449":36,"_2949":49350},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3465":38,"_30211":36,"_5":30560,"_20923":49352,"_27449":49353,"_2949":49354},[],"/docs/pr-preview/pr-67/deployment/overview#choose-a-model","Choose a model",{"_3465":39,"_30211":36,"_5":30560,"_20923":49356,"_27449":49357,"_2949":49358},[],"/docs/pr-preview/pr-67/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3465":40,"_30211":36,"_5":30560,"_20923":49360,"_27449":49361,"_2949":49362},[],"/docs/pr-preview/pr-67/deployment/overview#after-deployment","After deployment",{"_3465":41,"_30211":36,"_20923":49364,"_5":14374,"_27449":36,"_2949":49365},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3465":42,"_30211":36,"_20923":49367,"_5":14374,"_27449":49353,"_2949":49368},[],"Model",{"_3465":43,"_30211":36,"_20923":49370,"_5":14374,"_27449":49353,"_2949":49371},[],"Recommended for",{"_3465":44,"_30211":36,"_20923":49373,"_5":14374,"_27449":49353,"_2949":49374},[],"Who operates the infrastructure",{"_3465":45,"_30211":36,"_20923":49376,"_5":14374,"_27449":49353,"_2949":49377},[],"Starting point",{"_3465":46,"_30211":36,"_20923":49379,"_5":14374,"_27449":49353,"_2949":49380},[],"Kubernetes self-managed",{"_3465":47,"_30211":36,"_20923":49382,"_5":14374,"_27449":49353,"_2949":49383},[],"Production, regulated environments and custom deployments",{"_3465":48,"_30211":36,"_20923":49385,"_5":14374,"_27449":49353,"_2949":49386},[],"Your team",{"_3465":49,"_30211":36,"_20923":49388,"_5":14374,"_27449":49353,"_2949":49389},[],"Helm or Fastlane",{"_3465":50,"_30211":36,"_20923":49391,"_5":14374,"_27449":49353,"_2949":49392},[],"AWS Marketplace",{"_3465":51,"_30211":36,"_20923":49394,"_5":14374,"_27449":49353,"_2949":49395},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3465":52,"_30211":36,"_20923":49397,"_5":14374,"_27449":49353,"_2949":49386},[],{"_3465":53,"_30211":36,"_20923":49399,"_5":14374,"_27449":49353,"_2949":49400},[],"Preconfigured image on EC2",{"_3465":54,"_30211":36,"_20923":49402,"_5":14374,"_27449":49353,"_2949":49403},[],"SaaS",{"_3465":55,"_30211":36,"_20923":49405,"_5":14374,"_27449":49353,"_2949":49406},[],"Teams that want to use the platform without operating it",{"_3465":56,"_30211":36,"_20923":49408,"_5":14374,"_27449":49353,"_2949":49409},[],"Lamassu",{"_3465":57,"_30211":36,"_20923":49411,"_5":14374,"_27449":49353,"_2949":49412},[],"Managed subscription",{"_3465":58,"_30211":36,"_20923":49414,"_5":14374,"_27449":49353,"_2949":49415},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3465":59,"_30211":36,"_20923":49417,"_5":14374,"_27449":49353,"_2949":49418},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3465":60,"_30211":36,"_20923":49420,"_5":14374,"_27449":49353,"_2949":49421},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3465":61,"_30211":36,"_20923":49423,"_5":14374,"_27449":49357,"_2949":49424},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3465":62,"_30211":36,"_20923":49426,"_5":14374,"_27449":49361,"_2949":49427},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3465":63,"_30211":63,"_5":14726,"_2949":49429,"_30563":49430,"_20923":49431,"_27449":63},"Use Lamassu as SaaS",[49273,49274,49275],[],{"_3465":64,"_30211":63,"_20923":49433,"_5":14374,"_27449":63,"_2949":49434},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3465":65,"_30211":63,"_5":30560,"_20923":49436,"_27449":49437,"_2949":49438},[],"/docs/pr-preview/pr-67/deployment/saas#what-the-service-manages","What the service manages",{"_3465":66,"_30211":63,"_5":30560,"_20923":49440,"_27449":49441,"_2949":49442},[],"/docs/pr-preview/pr-67/deployment/saas#plans","Plans",{"_3465":67,"_30211":63,"_5":30560,"_20923":49444,"_27449":49445,"_2949":49446},[],"/docs/pr-preview/pr-67/deployment/saas#request-access","Request access",{"_3465":68,"_30211":63,"_20923":49448,"_5":14374,"_27449":63,"_2949":49449},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3465":69,"_30211":63,"_20923":49451,"_5":14374,"_27449":49437,"_2949":49452},[],"Platform availability and maintenance.",{"_3465":70,"_30211":63,"_20923":49454,"_5":14374,"_27449":49437,"_2949":49455},[],"Automatic backups.",{"_3465":71,"_30211":63,"_20923":49457,"_5":14374,"_27449":49437,"_2949":49458},[],"Version upgrades.",{"_3465":72,"_30211":63,"_20923":49460,"_5":14374,"_27449":49437,"_2949":49461},[],"Technical support and SLA according to your plan.",{"_3465":73,"_30211":63,"_20923":49463,"_5":14374,"_27449":49441,"_2949":49464},[],"Plan",{"_3465":74,"_30211":63,"_20923":49466,"_5":14374,"_27449":49441,"_2949":49467},[],"Devices",{"_3465":75,"_30211":63,"_20923":49469,"_5":14374,"_27449":49441,"_2949":49470},[],"Support",{"_3465":76,"_30211":63,"_20923":49472,"_5":14374,"_27449":49441,"_2949":49473},[],"SLA",{"_3465":77,"_30211":63,"_20923":49475,"_5":14374,"_27449":49441,"_2949":49476},[],"Starter",{"_3465":78,"_30211":63,"_20923":49478,"_5":14374,"_27449":49441,"_2949":49479},[],"Up to 1,000",{"_3465":79,"_30211":63,"_20923":49481,"_5":14374,"_27449":49441,"_2949":49482},[],"Email",{"_3465":80,"_30211":63,"_20923":49484,"_5":14374,"_27449":49441,"_2949":49485},[],"99.5 %",{"_3465":81,"_30211":63,"_20923":49487,"_5":14374,"_27449":49441,"_2949":49488},[],"Professional",{"_3465":82,"_30211":63,"_20923":49490,"_5":14374,"_27449":49441,"_2949":49491},[],"Up to 10,000",{"_3465":83,"_30211":63,"_20923":49493,"_5":14374,"_27449":49441,"_2949":49494},[],"Email and chat",{"_3465":84,"_30211":63,"_20923":49496,"_5":14374,"_27449":49441,"_2949":49497},[],"99.9 %",{"_3465":85,"_30211":63,"_20923":49499,"_5":14374,"_27449":49441,"_2949":49500},[],"Enterprise",{"_3465":86,"_30211":63,"_20923":49502,"_5":14374,"_27449":49441,"_2949":49503},[],"Unlimited",{"_3465":87,"_30211":63,"_20923":49505,"_5":14374,"_27449":49441,"_2949":49506},[],"Dedicated",{"_3465":88,"_30211":63,"_20923":49508,"_5":14374,"_27449":49441,"_2949":49509},[],"99.99 %",{"_3465":89,"_30211":63,"_20923":49511,"_5":14374,"_27449":49445,"_2949":49512},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3465":90,"_30211":63,"_20923":49514,"_5":14374,"_27449":49445,"_2949":49515},[],"When you receive your instance's credentials, continue with Get started.",{"_3465":91,"_30211":91,"_5":14726,"_2949":49517,"_30563":49518,"_20923":49519,"_27449":91},"Fastlane",[49273,49274,49380],[],{"_3465":92,"_30211":91,"_20923":49521,"_5":14374,"_27449":91,"_2949":49522},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3465":93,"_30211":91,"_5":30560,"_20923":49524,"_27449":49525,"_2949":49526},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3465":94,"_30211":91,"_5":30560,"_20923":49528,"_27449":49529,"_2949":49530},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3465":95,"_30211":91,"_5":30560,"_20923":49532,"_27449":49533,"_2949":49283},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#before-you-begin",{"_3465":96,"_30211":91,"_5":30560,"_20923":49535,"_27449":49536,"_2949":49537},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3465":97,"_30211":91,"_5":30560,"_20923":49539,"_27449":49540,"_2949":49541},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3465":98,"_30211":91,"_5":30560,"_20923":49543,"_27449":49544,"_2949":49545},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3465":99,"_30211":91,"_5":30560,"_20923":49547,"_27449":49548,"_2949":49549},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3465":100,"_30211":91,"_5":30560,"_20923":49551,"_27449":49552,"_2949":49553},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3465":101,"_30211":91,"_5":30560,"_20923":49555,"_27449":49556,"_2949":49557},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3465":102,"_30211":91,"_5":30560,"_20923":49559,"_27449":49560,"_2949":49561},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3465":103,"_30211":91,"_5":30560,"_20923":49563,"_27449":49564,"_2949":49565},[],"/docs/pr-preview/pr-67/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3465":104,"_30211":91,"_20923":49567,"_5":14374,"_27449":49525,"_2949":49568},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3465":105,"_30211":91,"_20923":49570,"_5":14374,"_27449":49525,"_2949":49571},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3465":106,"_30211":91,"_20923":49573,"_5":14374,"_27449":49529,"_2949":49574},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3465":107,"_30211":91,"_20923":49576,"_5":14374,"_27449":49529,"_2949":49577},[],"Fastlane installs or configures",{"_3465":108,"_30211":91,"_20923":49579,"_5":14374,"_27449":49529,"_2949":49580},[],"You still provide",{"_3465":109,"_30211":91,"_20923":49582,"_5":14374,"_27449":49529,"_2949":49583},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3465":110,"_30211":91,"_20923":49585,"_5":14374,"_27449":49529,"_2949":49586},[],"The Kubernetes cluster, nodes and persistent storage",{"_3465":111,"_30211":91,"_20923":49588,"_5":14374,"_27449":49529,"_2949":49589},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3465":112,"_30211":91,"_20923":49591,"_5":14374,"_27449":49529,"_2949":49592},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3465":113,"_30211":91,"_20923":49594,"_5":14374,"_27449":49529,"_2949":49595},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3465":114,"_30211":91,"_20923":49597,"_5":14374,"_27449":49529,"_2949":49598},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3465":115,"_30211":91,"_20923":49600,"_5":14374,"_27449":49529,"_2949":49601},[],"Optional observability and lab HSM components",{"_3465":116,"_30211":91,"_20923":49603,"_5":14374,"_27449":49529,"_2949":49604},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3465":117,"_30211":91,"_20923":49606,"_5":14374,"_27449":49529,"_2949":49607},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3465":118,"_30211":91,"_20923":49609,"_5":14374,"_27449":49533,"_2949":49610},[],"You need:",{"_3465":119,"_30211":91,"_20923":49612,"_5":14374,"_27449":49533,"_2949":49613},[],"an existing Kubernetes cluster",{"_3465":120,"_30211":91,"_20923":49615,"_5":14374,"_27449":49533,"_2949":49616},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3465":121,"_30211":91,"_20923":49618,"_5":14374,"_27449":49533,"_2949":49619},[],"`yq`",{"_3465":122,"_30211":91,"_20923":49621,"_5":14374,"_27449":49533,"_2949":23667},[],{"_3465":123,"_30211":91,"_20923":49623,"_5":14374,"_27449":49533,"_2949":49624},[],"`jq` only when using `--sample-data` or `--development`",{"_3465":124,"_30211":91,"_20923":49626,"_5":14374,"_27449":49533,"_2949":49627},[],"`ssh-keygen` only when using `--with-hsm`",{"_3465":125,"_30211":91,"_20923":49629,"_5":14374,"_27449":49533,"_2949":49630},[],"free external ports 80 and 443 on a single-node K3s host",{"_3465":126,"_30211":91,"_20923":49632,"_5":14374,"_27449":49533,"_2949":49633},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3465":127,"_30211":91,"_20923":49635,"_5":14374,"_27449":49533,"_2949":49636},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3465":128,"_30211":91,"_20923":49638,"_5":14374,"_27449":49536,"_2949":49639},[],"Run the script from a clone of the Helm repository:",{"_3465":129,"_30211":91,"_20923":49641,"_5":14374,"_27449":49536,"_2949":49642},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3465":130,"_30211":91,"_20923":49644,"_5":14374,"_27449":49540,"_2949":49645},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3465":131,"_30211":91,"_20923":49647,"_5":14374,"_27449":49540,"_2949":49648},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3465":132,"_30211":91,"_20923":49650,"_5":14374,"_27449":49540,"_2949":49651},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3465":133,"_30211":91,"_20923":49653,"_5":14374,"_27449":49540,"_2949":49654},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3465":134,"_30211":91,"_20923":49656,"_5":14374,"_27449":49544,"_2949":49657},[],"Option",{"_3465":135,"_30211":91,"_20923":49659,"_5":14374,"_27449":49544,"_2949":49660},[],"Default",{"_3465":136,"_30211":91,"_20923":49662,"_5":14374,"_27449":49544,"_2949":49663},[],"Purpose",{"_3465":137,"_30211":91,"_20923":49665,"_5":14374,"_27449":49544,"_2949":49666},[],"`-h`, `--help`",{"_3465":138,"_30211":91,"_20923":49668,"_5":14374,"_27449":49544,"_2949":49669},[],"—",{"_3465":139,"_30211":91,"_20923":49671,"_5":14374,"_27449":49544,"_2949":49672},[],"Show help",{"_3465":140,"_30211":91,"_20923":49674,"_5":14374,"_27449":49544,"_2949":49675},[],"`-c`, `--context`",{"_3465":141,"_30211":91,"_20923":49677,"_5":14374,"_27449":49544,"_2949":49678},[],"current context",{"_3465":142,"_30211":91,"_20923":49680,"_5":14374,"_27449":49544,"_2949":49681},[],"Select the kubeconfig context for kubectl and Helm",{"_3465":143,"_30211":91,"_20923":49683,"_5":14374,"_27449":49544,"_2949":49684},[],"`-n`, `--non-interactive`",{"_3465":144,"_30211":91,"_20923":49686,"_5":14374,"_27449":49544,"_2949":6537},[],{"_3465":145,"_30211":91,"_20923":49688,"_5":14374,"_27449":49544,"_2949":49689},[],"Skip prompts and generate dependency credentials",{"_3465":146,"_30211":91,"_20923":49691,"_5":14374,"_27449":49544,"_2949":49692},[],"`-ns`, `--namespace`",{"_3465":147,"_30211":91,"_20923":49694,"_5":14374,"_27449":49544,"_2949":49695},[],"`lamassu-dev`",{"_3465":148,"_30211":91,"_20923":49697,"_5":14374,"_27449":49544,"_2949":49698},[],"Namespace for the installation",{"_3465":149,"_30211":91,"_20923":49700,"_5":14374,"_27449":49544,"_2949":49701},[],"`-d`, `--domain`",{"_3465":150,"_30211":91,"_20923":49703,"_5":14374,"_27449":49544,"_2949":49704},[],"`dev.lamassu.io`",{"_3465":151,"_30211":91,"_20923":49706,"_5":14374,"_27449":49544,"_2949":49707},[],"Domain used by the UI, OIDC and certificate",{"_3465":152,"_30211":91,"_20923":49709,"_5":14374,"_27449":49544,"_2949":49710},[],"`-v`, `--version`",{"_3465":153,"_30211":91,"_20923":49712,"_5":14374,"_27449":49544,"_2949":15066},[],{"_3465":154,"_30211":91,"_20923":49714,"_5":14374,"_27449":49544,"_2949":49715},[],"Lamassu chart version",{"_3465":155,"_30211":91,"_20923":49717,"_5":14374,"_27449":49544,"_2949":49718},[],"`--https-port`",{"_3465":156,"_30211":91,"_20923":49720,"_5":14374,"_27449":49544,"_2949":49721},[],"`443`",{"_3465":157,"_30211":91,"_20923":49723,"_5":14374,"_27449":49544,"_2949":49724},[],"Gateway HTTPS listener port",{"_3465":158,"_30211":91,"_20923":49726,"_5":14374,"_27449":49544,"_2949":49727},[],"`--http-port`",{"_3465":159,"_30211":91,"_20923":49729,"_5":14374,"_27449":49544,"_2949":49730},[],"`80`",{"_3465":160,"_30211":91,"_20923":49732,"_5":14374,"_27449":49544,"_2949":49733},[],"Gateway HTTP listener port",{"_3465":161,"_30211":91,"_20923":49735,"_5":14374,"_27449":49544,"_2949":49736},[],"`--tls-crt`",{"_3465":162,"_30211":91,"_20923":49738,"_5":14374,"_27449":49544,"_2949":49669},[],{"_3465":163,"_30211":91,"_20923":49740,"_5":14374,"_27449":49544,"_2949":49741},[],"PEM certificate for downstream TLS",{"_3465":164,"_30211":91,"_20923":49743,"_5":14374,"_27449":49544,"_2949":49744},[],"`--tls-key`",{"_3465":165,"_30211":91,"_20923":49746,"_5":14374,"_27449":49544,"_2949":49669},[],{"_3465":166,"_30211":91,"_20923":49748,"_5":14374,"_27449":49544,"_2949":49749},[],"PEM private key for downstream TLS",{"_3465":167,"_30211":91,"_20923":49751,"_5":14374,"_27449":49544,"_2949":49752},[],"`-l`, `--local-chart-path`",{"_3465":168,"_30211":91,"_20923":49754,"_5":14374,"_27449":49544,"_2949":49755},[],"repository chart",{"_3465":169,"_30211":91,"_20923":49757,"_5":14374,"_27449":49544,"_2949":49758},[],"Use an unpacked local Lamassu chart",{"_3465":170,"_30211":91,"_20923":49760,"_5":14374,"_27449":49544,"_2949":49761},[],"`-ip`, `--gateway-ip`",{"_3465":171,"_30211":91,"_20923":49763,"_5":14374,"_27449":49544,"_2949":8736},[],{"_3465":172,"_30211":91,"_20923":49765,"_5":14374,"_27449":49544,"_2949":49766},[],"Override the address written to `gateway.addresses`",{"_3465":173,"_30211":91,"_20923":49768,"_5":14374,"_27449":49544,"_2949":49769},[],"`--otel`",{"_3465":174,"_30211":91,"_20923":49771,"_5":14374,"_27449":49544,"_2949":6537},[],{"_3465":175,"_30211":91,"_20923":49773,"_5":14374,"_27449":49544,"_2949":49774},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3465":176,"_30211":91,"_20923":49776,"_5":14374,"_27449":49544,"_2949":49777},[],"`--development`",{"_3465":177,"_30211":91,"_20923":49779,"_5":14374,"_27449":49544,"_2949":6537},[],{"_3465":178,"_30211":91,"_20923":49781,"_5":14374,"_27449":49544,"_2949":49782},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3465":179,"_30211":91,"_20923":49784,"_5":14374,"_27449":49544,"_2949":49785},[],"`--sample-data`",{"_3465":180,"_30211":91,"_20923":49787,"_5":14374,"_27449":49544,"_2949":6537},[],{"_3465":181,"_30211":91,"_20923":49789,"_5":14374,"_27449":49544,"_2949":49790},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3465":182,"_30211":91,"_20923":49792,"_5":14374,"_27449":49544,"_2949":49793},[],"`--with-hsm`",{"_3465":183,"_30211":91,"_20923":49795,"_5":14374,"_27449":49544,"_2949":6537},[],{"_3465":184,"_30211":91,"_20923":49797,"_5":14374,"_27449":49544,"_2949":49798},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3465":185,"_30211":91,"_20923":49800,"_5":14374,"_27449":49544,"_2949":49801},[],"`--softhsm-chart-path`",{"_3465":186,"_30211":91,"_20923":49803,"_5":14374,"_27449":49544,"_2949":49804},[],"`./charts/softhsm`",{"_3465":187,"_30211":91,"_20923":49806,"_5":14374,"_27449":49544,"_2949":49807},[],"Use a different local SoftHSM chart",{"_3465":188,"_30211":91,"_20923":49809,"_5":14374,"_27449":49544,"_2949":49810},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3465":189,"_30211":91,"_20923":49812,"_5":14374,"_27449":49548,"_2949":49813},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3465":190,"_30211":91,"_20923":49815,"_5":14374,"_27449":49548,"_2949":49816},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3465":191,"_30211":91,"_20923":49818,"_5":14374,"_27449":49548,"_2949":49819},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3465":192,"_30211":91,"_20923":49821,"_5":14374,"_27449":49548,"_2949":49822},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3465":193,"_30211":91,"_20923":49824,"_5":14374,"_27449":49548,"_2949":49825},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3465":194,"_30211":91,"_20923":49827,"_5":14374,"_27449":49548,"_2949":49828},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3465":195,"_30211":91,"_20923":49830,"_5":14374,"_27449":49552,"_2949":49831},[],"Fastlane:",{"_3465":196,"_30211":91,"_20923":49833,"_5":14374,"_27449":49552,"_2949":49834},[],"validates local tools and the selected cluster",{"_3465":197,"_30211":91,"_20923":49836,"_5":14374,"_27449":49552,"_2949":49837},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3465":198,"_30211":91,"_20923":49839,"_5":14374,"_27449":49552,"_2949":49840},[],"creates the namespace",{"_3465":199,"_30211":91,"_20923":49842,"_5":14374,"_27449":49552,"_2949":49843},[],"installs PostgreSQL and creates the required databases",{"_3465":200,"_30211":91,"_20923":49845,"_5":14374,"_27449":49552,"_2949":49846},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3465":201,"_30211":91,"_20923":49848,"_5":14374,"_27449":49552,"_2949":49849},[],"installs RabbitMQ",{"_3465":202,"_30211":91,"_20923":49851,"_5":14374,"_27449":49552,"_2949":49852},[],"optionally installs observability and lab HSM components",{"_3465":203,"_30211":91,"_20923":49854,"_5":14374,"_27449":49552,"_2949":49855},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3465":204,"_30211":91,"_20923":49857,"_5":14374,"_27449":49552,"_2949":49858},[],"optionally loads sample data",{"_3465":205,"_30211":91,"_20923":49860,"_5":14374,"_27449":49552,"_2949":49861},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3465":206,"_30211":91,"_20923":49863,"_5":14374,"_27449":49556,"_2949":49864},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3465":207,"_30211":91,"_20923":49866,"_5":14374,"_27449":49556,"_2949":49867},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3465":208,"_30211":91,"_20923":49869,"_5":14374,"_27449":49560,"_2949":49870},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3465":209,"_30211":91,"_20923":49872,"_5":14374,"_27449":49560,"_2949":49873},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3465":210,"_30211":91,"_20923":49875,"_5":14374,"_27449":49560,"_2949":49876},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3465":211,"_30211":91,"_20923":49878,"_5":14374,"_27449":49564,"_2949":49879},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3465":212,"_30211":212,"_5":14726,"_2949":49881,"_30563":49882,"_20923":49883,"_27449":212},"Install with Helm",[49273,49274,49380],[],{"_3465":213,"_30211":212,"_20923":49885,"_5":14374,"_27449":212,"_2949":49886},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3465":214,"_30211":212,"_5":30560,"_20923":49888,"_27449":49889,"_2949":49890},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3465":215,"_30211":212,"_5":30560,"_20923":49892,"_27449":49893,"_2949":49283},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#before-you-begin",{"_3465":216,"_30211":212,"_5":30560,"_20923":49895,"_27449":49896,"_2949":49897},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3465":217,"_30211":212,"_5":30560,"_20923":49899,"_27449":49900,"_2949":49901},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3465":218,"_30211":212,"_5":30560,"_20923":49903,"_27449":49904,"_2949":49905},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3465":219,"_30211":212,"_5":30560,"_20923":49907,"_27449":49908,"_2949":49909},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3465":220,"_30211":212,"_5":30560,"_20923":49911,"_27449":49912,"_2949":49913},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3465":221,"_30211":212,"_5":30560,"_20923":49915,"_27449":49916,"_2949":49917},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3465":222,"_30211":212,"_5":30560,"_20923":49919,"_27449":49920,"_2949":49921},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3465":223,"_30211":212,"_5":30560,"_20923":49923,"_27449":49924,"_2949":49925},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3465":224,"_30211":212,"_5":30560,"_20923":49927,"_27449":49928,"_2949":49929},[],"/docs/pr-preview/pr-67/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3465":225,"_30211":212,"_20923":49931,"_5":14374,"_27449":49889,"_2949":49932},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3465":226,"_30211":212,"_20923":49934,"_5":14374,"_27449":49893,"_2949":49935},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3465":227,"_30211":212,"_20923":49937,"_5":14374,"_27449":49893,"_2949":49938},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3465":228,"_30211":212,"_20923":49940,"_5":14374,"_27449":49893,"_2949":49941},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3465":229,"_30211":212,"_20923":49943,"_5":14374,"_27449":49893,"_2949":49944},[],"a reachable RabbitMQ broker and credentials",{"_3465":230,"_30211":212,"_20923":49946,"_5":14374,"_27449":49893,"_2949":49947},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3465":231,"_30211":212,"_20923":49949,"_5":14374,"_27449":49893,"_2949":49950},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3465":232,"_30211":212,"_20923":49952,"_5":14374,"_27449":49893,"_2949":49953},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3465":233,"_30211":212,"_20923":49955,"_5":14374,"_27449":49893,"_2949":49956},[],"a StorageClass and an external traffic design",{"_3465":234,"_30211":212,"_20923":49958,"_5":14374,"_27449":49893,"_2949":49959},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3465":235,"_30211":212,"_20923":49961,"_5":14374,"_27449":49893,"_2949":49962},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3465":236,"_30211":212,"_20923":49964,"_5":14374,"_27449":49893,"_2949":49965},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3465":237,"_30211":212,"_20923":49967,"_5":14374,"_27449":49896,"_2949":49968},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3465":238,"_30211":212,"_20923":49970,"_5":14374,"_27449":49896,"_2949":49971},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3465":239,"_30211":212,"_20923":49973,"_5":14374,"_27449":49896,"_2949":49974},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3465":240,"_30211":212,"_20923":49976,"_5":14374,"_27449":49900,"_2949":49977},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3465":241,"_30211":212,"_20923":49979,"_5":14374,"_27449":49900,"_2949":49980},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3465":242,"_30211":212,"_20923":49982,"_5":14374,"_27449":49900,"_2949":49983},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3465":243,"_30211":212,"_20923":49985,"_5":14374,"_27449":49900,"_2949":49986},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3465":244,"_30211":212,"_20923":49988,"_5":14374,"_27449":49904,"_2949":49989},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3465":245,"_30211":212,"_20923":49991,"_5":14374,"_27449":49908,"_2949":49992},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3465":246,"_30211":212,"_20923":49994,"_5":14374,"_27449":49908,"_2949":49995},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3465":247,"_30211":212,"_20923":49997,"_5":14374,"_27449":49908,"_2949":49998},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3465":248,"_30211":212,"_20923":50000,"_5":14374,"_27449":49908,"_2949":50001},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3465":249,"_30211":212,"_20923":50003,"_5":14374,"_27449":49908,"_2949":50004},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3465":250,"_30211":212,"_20923":50006,"_5":14374,"_27449":49908,"_2949":50007},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3465":251,"_30211":212,"_20923":50009,"_5":14374,"_27449":49908,"_2949":50010},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3465":252,"_30211":212,"_20923":50012,"_5":14374,"_27449":49912,"_2949":50013},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3465":253,"_30211":212,"_20923":50015,"_5":14374,"_27449":49912,"_2949":50016},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3465":254,"_30211":212,"_20923":50018,"_5":14374,"_27449":49912,"_2949":50019},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3465":255,"_30211":212,"_20923":50021,"_5":14374,"_27449":49912,"_2949":50022},[],"See Access control for the principal and policy model.",{"_3465":256,"_30211":212,"_20923":50024,"_5":14374,"_27449":49916,"_2949":50025},[],"To install a local checkout instead:",{"_3465":257,"_30211":212,"_20923":50027,"_5":14374,"_27449":49920,"_2949":50028},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3465":258,"_30211":212,"_20923":50030,"_5":14374,"_27449":49920,"_2949":50031},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3465":259,"_30211":212,"_20923":50033,"_5":14374,"_27449":49924,"_2949":50034},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3465":260,"_30211":212,"_20923":50036,"_5":14374,"_27449":49924,"_2949":50037},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3465":261,"_30211":212,"_20923":50039,"_5":14374,"_27449":49924,"_2949":50040},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3465":262,"_30211":212,"_20923":50042,"_5":14374,"_27449":49924,"_2949":50043},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3465":263,"_30211":212,"_20923":50045,"_5":14374,"_27449":49924,"_2949":50046},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3465":264,"_30211":212,"_20923":50048,"_5":14374,"_27449":49928,"_2949":50049},[],"Before going live, review:",{"_3465":265,"_30211":212,"_20923":50051,"_5":14374,"_27449":49928,"_2949":50052},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3465":266,"_30211":212,"_20923":50054,"_5":14374,"_27449":49928,"_2949":50055},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3465":267,"_30211":212,"_20923":50057,"_5":14374,"_27449":49928,"_2949":50058},[],"shared VA storage before increasing VA replicas",{"_3465":268,"_30211":212,"_20923":50060,"_5":14374,"_27449":49928,"_2949":50061},[],"managed OIDC roles and removal of evaluation credentials",{"_3465":269,"_30211":212,"_20923":50063,"_5":14374,"_27449":49928,"_2949":50064},[],"a trusted TLS issuer or externally managed certificate",{"_3465":270,"_30211":212,"_20923":50066,"_5":14374,"_27449":49928,"_2949":50067},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3465":271,"_30211":212,"_20923":50069,"_5":14374,"_27449":49928,"_2949":50070},[],"SMTP, observability and alert delivery",{"_3465":272,"_30211":212,"_20923":50072,"_5":14374,"_27449":49928,"_2949":50073},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3465":273,"_30211":212,"_20923":50075,"_5":14374,"_27449":49928,"_2949":50076},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3465":274,"_30211":274,"_5":14726,"_2949":50078,"_30563":50079,"_20923":50080,"_27449":274},"Expose the Gateway",[49273,49274,49380],[],{"_3465":275,"_30211":274,"_20923":50082,"_5":14374,"_27449":274,"_2949":50083},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3465":276,"_30211":274,"_5":30560,"_20923":50085,"_27449":50086,"_2949":50087},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3465":277,"_30211":274,"_5":30560,"_20923":50089,"_27449":50090,"_2949":50091},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3465":278,"_30211":274,"_5":30560,"_20923":50093,"_27449":50094,"_2949":50095},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3465":279,"_30211":274,"_5":30560,"_20923":50097,"_27449":50098,"_2949":50099},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#k3s","K3s",{"_3465":280,"_30211":274,"_5":30560,"_20923":50101,"_27449":50102,"_2949":50103},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3465":281,"_30211":274,"_5":30560,"_20923":50105,"_27449":50106,"_2949":50107},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3465":282,"_30211":274,"_5":30560,"_20923":50109,"_27449":50110,"_2949":50111},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3465":283,"_30211":274,"_5":30560,"_20923":50113,"_27449":50114,"_2949":50115},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3465":284,"_30211":274,"_5":30560,"_20923":50117,"_27449":50118,"_2949":50119},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3465":285,"_30211":274,"_5":30560,"_20923":50121,"_27449":50122,"_2949":50123},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3465":286,"_30211":274,"_5":30560,"_20923":50125,"_27449":50126,"_2949":50127},[],"/docs/pr-preview/pr-67/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3465":287,"_30211":274,"_20923":50129,"_5":14374,"_27449":50086,"_2949":50130},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3465":288,"_30211":274,"_20923":50132,"_5":14374,"_27449":50086,"_2949":50133},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3465":289,"_30211":274,"_20923":50135,"_5":14374,"_27449":50090,"_2949":50136},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3465":290,"_30211":274,"_20923":50138,"_5":14374,"_27449":50090,"_2949":50139},[],"Set it only when:",{"_3465":291,"_30211":274,"_20923":50141,"_5":14374,"_27449":50090,"_2949":50142},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3465":292,"_30211":274,"_20923":50144,"_5":14374,"_27449":50090,"_2949":50145},[],"that address is allocated to this Gateway",{"_3465":293,"_30211":274,"_20923":50147,"_5":14374,"_27449":50090,"_2949":50148},[],"the surrounding network already routes traffic for it to the cluster",{"_3465":294,"_30211":274,"_20923":50150,"_5":14374,"_27449":50090,"_2949":50151},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3465":295,"_30211":274,"_20923":50153,"_5":14374,"_27449":50090,"_2949":50154},[],"Keep these two settings separate:",{"_3465":296,"_30211":274,"_20923":50156,"_5":14374,"_27449":50090,"_2949":50157},[],"`gateway.addresses` requests an address for the Gateway.",{"_3465":297,"_30211":274,"_20923":50159,"_5":14374,"_27449":50090,"_2949":50160},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3465":298,"_30211":274,"_20923":50162,"_5":14374,"_27449":50090,"_2949":50163},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3465":299,"_30211":274,"_20923":50165,"_5":14374,"_27449":50094,"_2949":50166},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3465":300,"_30211":274,"_20923":50168,"_5":14374,"_27449":50094,"_2949":50169},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3465":301,"_30211":274,"_20923":50171,"_5":14374,"_27449":50098,"_2949":50172},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3465":302,"_30211":274,"_20923":50174,"_5":14374,"_27449":50098,"_2949":50175},[],"For the recommended design:",{"_3465":303,"_30211":274,"_20923":50177,"_5":14374,"_27449":50098,"_2949":50178},[],"Use only one externally exposed Lamassu Gateway.",{"_3465":304,"_30211":274,"_20923":50180,"_5":14374,"_27449":50098,"_2949":50181},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3465":305,"_30211":274,"_20923":50183,"_5":14374,"_27449":50098,"_2949":50184},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3465":306,"_30211":274,"_20923":50186,"_5":14374,"_27449":50098,"_2949":50187},[],"Point DNS at the VM's reachable address.",{"_3465":307,"_30211":274,"_20923":50189,"_5":14374,"_27449":50098,"_2949":50190},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3465":308,"_30211":274,"_20923":50192,"_5":14374,"_27449":50102,"_2949":50193},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3465":309,"_30211":274,"_20923":50195,"_5":14374,"_27449":50106,"_2949":50196},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3465":310,"_30211":274,"_20923":50198,"_5":14374,"_27449":50106,"_2949":50199},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3465":311,"_30211":274,"_20923":50201,"_5":14374,"_27449":50110,"_2949":50202},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3465":312,"_30211":274,"_20923":50204,"_5":14374,"_27449":50110,"_2949":50205},[],"Requirement",{"_3465":313,"_30211":274,"_20923":50207,"_5":14374,"_27449":50110,"_2949":50208},[],"Recommended design",{"_3465":314,"_30211":274,"_20923":50210,"_5":14374,"_27449":50110,"_2949":50211},[],"Consequence",{"_3465":315,"_30211":274,"_20923":50213,"_5":14374,"_27449":50110,"_2949":50214},[],"Several Lamassu URLs or services",{"_3465":316,"_30211":274,"_20923":50216,"_5":14374,"_27449":50110,"_2949":50217},[],"One Gateway with multiple routes",{"_3465":317,"_30211":274,"_20923":50219,"_5":14374,"_27449":50110,"_2949":50220},[],"One IP and one proxy fleet; this is the chart default",{"_3465":318,"_30211":274,"_20923":50222,"_5":14374,"_27449":50110,"_2949":50223},[],"Independent Gateways and separate external IPs",{"_3465":319,"_30211":274,"_20923":50225,"_5":14374,"_27449":50110,"_2949":50226},[],"One VIP per Gateway",{"_3465":320,"_30211":274,"_20923":50228,"_5":14374,"_27449":50110,"_2949":50229},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3465":321,"_30211":274,"_20923":50231,"_5":14374,"_27449":50110,"_2949":50232},[],"Independent Gateways on one node and one IP",{"_3465":322,"_30211":274,"_20923":50234,"_5":14374,"_27449":50110,"_2949":50235},[],"Use different external ports",{"_3465":323,"_30211":274,"_20923":50237,"_5":14374,"_27449":50110,"_2949":50238},[],"Clients must include non-standard ports",{"_3465":324,"_30211":274,"_20923":50240,"_5":14374,"_27449":50110,"_2949":50241},[],"Separate TLS/mTLS termination behind one IP",{"_3465":325,"_30211":274,"_20923":50243,"_5":14374,"_27449":50110,"_2949":50244},[],"Front-door SNI routing to internal Gateways",{"_3465":326,"_30211":274,"_20923":50246,"_5":14374,"_27449":50110,"_2949":50247},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3465":327,"_30211":274,"_20923":50249,"_5":14374,"_27449":50110,"_2949":50250},[],"Separate Gateway resources but shared proxy infrastructure",{"_3465":328,"_30211":274,"_20923":50252,"_5":14374,"_27449":50110,"_2949":50253},[],"Envoy merged-Gateway mode",{"_3465":329,"_30211":274,"_20923":50255,"_5":14374,"_27449":50110,"_2949":50256},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3465":330,"_30211":274,"_20923":50258,"_5":14374,"_27449":50110,"_2949":50259},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3465":331,"_30211":274,"_20923":50261,"_5":14374,"_27449":50110,"_2949":50262},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3465":332,"_30211":274,"_20923":50264,"_5":14374,"_27449":50110,"_2949":50265},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3465":333,"_30211":274,"_20923":50267,"_5":14374,"_27449":50110,"_2949":50268},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3465":334,"_30211":274,"_20923":50270,"_5":14374,"_27449":50114,"_2949":50271},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3465":335,"_30211":274,"_20923":50273,"_5":14374,"_27449":50118,"_2949":50274},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3465":336,"_30211":274,"_20923":50276,"_5":14374,"_27449":50118,"_2949":50277},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3465":337,"_30211":274,"_20923":50279,"_5":14374,"_27449":50118,"_2949":50280},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3465":338,"_30211":274,"_20923":50282,"_5":14374,"_27449":50118,"_2949":50283},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3465":339,"_30211":274,"_20923":50285,"_5":14374,"_27449":50118,"_2949":50286},[],"If none of those are possible, use different external ports or change the external network design.",{"_3465":340,"_30211":274,"_20923":50288,"_5":14374,"_27449":50122,"_2949":50289},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3465":341,"_30211":274,"_20923":50291,"_5":14374,"_27449":50122,"_2949":50292},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3465":342,"_30211":274,"_20923":50294,"_5":14374,"_27449":50126,"_2949":50295},[],"Check, in order:",{"_3465":343,"_30211":274,"_20923":50297,"_5":14374,"_27449":50126,"_2949":50298},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3465":344,"_30211":274,"_20923":50300,"_5":14374,"_27449":50126,"_2949":50301},[],"Its status contains the expected address.",{"_3465":345,"_30211":274,"_20923":50303,"_5":14374,"_27449":50126,"_2949":50304},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3465":346,"_30211":274,"_20923":50306,"_5":14374,"_27449":50126,"_2949":50307},[],"Port 443 reaches that address from the client network.",{"_3465":347,"_30211":274,"_20923":50309,"_5":14374,"_27449":50126,"_2949":50310},[],"DNS resolves to the externally reachable endpoint.",{"_3465":348,"_30211":274,"_20923":50312,"_5":14374,"_27449":50126,"_2949":50313},[],"The certificate contains the DNS name or IP used by the client.",{"_3465":349,"_30211":274,"_20923":50315,"_5":14374,"_27449":50126,"_2949":50316},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3465":350,"_30211":350,"_5":14726,"_2949":49380,"_30563":50318,"_20923":50319,"_27449":350},[49273,49274,49380],[],{"_3465":351,"_30211":350,"_20923":50321,"_5":14374,"_27449":350,"_2949":50322},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3465":352,"_30211":350,"_5":30560,"_20923":50324,"_27449":50325,"_2949":50326},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3465":353,"_30211":350,"_5":30560,"_20923":50328,"_27449":50329,"_2949":50330},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3465":354,"_30211":350,"_5":30560,"_20923":50332,"_27449":50333,"_2949":50334},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3465":355,"_30211":350,"_5":30560,"_20923":50336,"_27449":50337,"_2949":50338},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3465":356,"_30211":350,"_5":30560,"_20923":50340,"_27449":50341,"_2949":50342},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3465":357,"_30211":350,"_5":30560,"_20923":50344,"_27449":50345,"_2949":50346},[],"/docs/pr-preview/pr-67/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3465":358,"_30211":350,"_20923":50348,"_5":14374,"_27449":50325,"_2949":50349},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3465":359,"_30211":350,"_20923":50351,"_5":14374,"_27449":50329,"_2949":50352},[],"Workflow",{"_3465":360,"_30211":350,"_20923":50354,"_5":14374,"_27449":50329,"_2949":50355},[],"Use it for",{"_3465":361,"_30211":350,"_20923":50357,"_5":14374,"_27449":50329,"_2949":50358},[],"What it installs",{"_3465":362,"_30211":350,"_20923":50360,"_5":14374,"_27449":50329,"_2949":50361},[],"Helm",{"_3465":363,"_30211":350,"_20923":50363,"_5":14374,"_27449":50329,"_2949":50364},[],"Production and controlled environments",{"_3465":364,"_30211":350,"_20923":50366,"_5":14374,"_27449":50329,"_2949":50367},[],"Lamassu services and Gateway API resources",{"_3465":365,"_30211":350,"_20923":50369,"_5":14374,"_27449":50329,"_2949":49517},[],{"_3465":366,"_30211":350,"_20923":50371,"_5":14374,"_27449":50329,"_2949":50372},[],"Evaluation, demos, CI and small lab clusters",{"_3465":367,"_30211":350,"_20923":50374,"_5":14374,"_27449":50329,"_2949":50375},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3465":368,"_30211":350,"_20923":50377,"_5":14374,"_27449":50333,"_2949":50378},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3465":369,"_30211":350,"_20923":50380,"_5":14374,"_27449":50333,"_2949":50381},[],"Area",{"_3465":370,"_30211":350,"_20923":50383,"_5":14374,"_27449":50333,"_2949":50384},[],"The Lamassu chart provides",{"_3465":371,"_30211":350,"_20923":50386,"_5":14374,"_27449":50333,"_2949":50387},[],"You provide",{"_3465":372,"_30211":350,"_20923":50389,"_5":14374,"_27449":50333,"_2949":50390},[],"Lamassu applications",{"_3465":373,"_30211":350,"_20923":50392,"_5":14374,"_27449":50333,"_2949":50393},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3465":374,"_30211":350,"_20923":50395,"_5":14374,"_27449":50333,"_2949":50396},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3465":375,"_30211":350,"_20923":50398,"_5":14374,"_27449":50333,"_2949":50399},[],"PostgreSQL data",{"_3465":376,"_30211":350,"_20923":50401,"_5":14374,"_27449":50333,"_2949":50402},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3465":377,"_30211":350,"_20923":50404,"_5":14374,"_27449":50333,"_2949":50405},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3465":378,"_30211":350,"_20923":50407,"_5":14374,"_27449":50333,"_2949":50408},[],"Messaging",{"_3465":379,"_30211":350,"_20923":50410,"_5":14374,"_27449":50333,"_2949":50411},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3465":380,"_30211":350,"_20923":50413,"_5":14374,"_27449":50333,"_2949":50414},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3465":381,"_30211":350,"_20923":50416,"_5":14374,"_27449":50333,"_2949":50417},[],"Identity",{"_3465":382,"_30211":350,"_20923":50419,"_5":14374,"_27449":50333,"_2949":50420},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3465":383,"_30211":350,"_20923":50422,"_5":14374,"_27449":50333,"_2949":50423},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3465":384,"_30211":350,"_20923":50425,"_5":14374,"_27449":50333,"_2949":50426},[],"External routing",{"_3465":385,"_30211":350,"_20923":50428,"_5":14374,"_27449":50333,"_2949":50429},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3465":386,"_30211":350,"_20923":50431,"_5":14374,"_27449":50333,"_2949":50432},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3465":387,"_30211":350,"_20923":50434,"_5":14374,"_27449":50333,"_2949":50435},[],"TLS",{"_3465":388,"_30211":350,"_20923":50437,"_5":14374,"_27449":50333,"_2949":50438},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3465":389,"_30211":350,"_20923":50440,"_5":14374,"_27449":50333,"_2949":50441},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3465":390,"_30211":350,"_20923":50443,"_5":14374,"_27449":50333,"_2949":50444},[],"Persistent application data",{"_3465":391,"_30211":350,"_20923":50446,"_5":14374,"_27449":50333,"_2949":50447},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3465":392,"_30211":350,"_20923":50449,"_5":14374,"_27449":50333,"_2949":50450},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3465":393,"_30211":350,"_20923":50452,"_5":14374,"_27449":50333,"_2949":50453},[],"Optional integrations",{"_3465":394,"_30211":350,"_20923":50455,"_5":14374,"_27449":50333,"_2949":50456},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3465":395,"_30211":350,"_20923":50458,"_5":14374,"_27449":50333,"_2949":50459},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3465":396,"_30211":350,"_20923":50461,"_5":14374,"_27449":50333,"_2949":50462},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3465":397,"_30211":350,"_20923":50464,"_5":14374,"_27449":50333,"_2949":50465},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3465":398,"_30211":350,"_20923":50467,"_5":14374,"_27449":50337,"_2949":50468},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3465":399,"_30211":350,"_20923":50470,"_5":14374,"_27449":50337,"_2949":50471},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3465":400,"_30211":350,"_20923":50473,"_5":14374,"_27449":50341,"_2949":50474},[],"Kubernetes 1.24 or newer",{"_3465":401,"_30211":350,"_20923":50476,"_5":14374,"_27449":50341,"_2949":50477},[],"Helm 3.2 or newer",{"_3465":402,"_30211":350,"_20923":50479,"_5":14374,"_27449":50341,"_2949":50480},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3465":403,"_30211":350,"_20923":50482,"_5":14374,"_27449":50341,"_2949":50483},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3465":404,"_30211":350,"_20923":50485,"_5":14374,"_27449":50341,"_2949":50486},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3465":405,"_30211":350,"_20923":50488,"_5":14374,"_27449":50341,"_2949":50489},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3465":406,"_30211":350,"_20923":50491,"_5":14374,"_27449":50341,"_2949":50492},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3465":407,"_30211":350,"_20923":50494,"_5":14374,"_27449":50345,"_2949":50495},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3465":408,"_30211":350,"_20923":50497,"_5":14374,"_27449":50345,"_2949":50498},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3465":409,"_30211":350,"_20923":50500,"_5":14374,"_27449":50345,"_2949":50501},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3465":410,"_30211":350,"_20923":50503,"_5":14374,"_27449":50345,"_2949":50504},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3465":411,"_30211":411,"_5":14726,"_2949":50506,"_30563":50507,"_20923":50509,"_27449":411},"Deployment troubleshooting",[49273,49274,50508],"Operations",[],{"_3465":412,"_30211":411,"_20923":50511,"_5":14374,"_27449":411,"_2949":50512},[],"Diagnose access, service health and infrastructure dependencies.",{"_3465":413,"_30211":411,"_5":30560,"_20923":50514,"_27449":50515,"_2949":50516},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3465":414,"_30211":411,"_5":30560,"_20923":50518,"_27449":50519,"_2949":50520},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3465":415,"_30211":411,"_5":30560,"_20923":50522,"_27449":50523,"_2949":50524},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3465":416,"_30211":411,"_5":30560,"_20923":50526,"_27449":50527,"_2949":50528},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3465":417,"_30211":411,"_5":30560,"_20923":50530,"_27449":50531,"_2949":50532},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3465":418,"_30211":411,"_5":30560,"_20923":50534,"_27449":50535,"_2949":50536},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3465":419,"_30211":411,"_5":30560,"_20923":50538,"_27449":50539,"_2949":50540},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3465":420,"_30211":411,"_5":30560,"_20923":50542,"_27449":50543,"_2949":50544},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3465":421,"_30211":411,"_5":30560,"_20923":50546,"_27449":50547,"_2949":50548},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3465":422,"_30211":411,"_5":30560,"_20923":50550,"_27449":50551,"_2949":50552},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3465":423,"_30211":411,"_5":30560,"_20923":50554,"_27449":50555,"_2949":50556},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3465":424,"_30211":411,"_5":30560,"_20923":50558,"_27449":50559,"_2949":50560},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3465":425,"_30211":411,"_5":30560,"_20923":50562,"_27449":50563,"_2949":50564},[],"/docs/pr-preview/pr-67/deployment/troubleshooting#observability","Observability",{"_3465":426,"_30211":411,"_20923":50566,"_5":14374,"_27449":411,"_2949":50567},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3465":427,"_30211":411,"_20923":50569,"_5":14374,"_27449":50519,"_2949":50570},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3465":428,"_30211":411,"_20923":50572,"_5":14374,"_27449":50523,"_2949":50573},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3465":429,"_30211":411,"_20923":50575,"_5":14374,"_27449":50527,"_2949":50576},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3465":430,"_30211":411,"_20923":50578,"_5":14374,"_27449":50531,"_2949":50579},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3465":431,"_30211":411,"_20923":50581,"_5":14374,"_27449":50535,"_2949":50582},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3465":432,"_30211":411,"_20923":50584,"_5":14374,"_27449":50539,"_2949":50585},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3465":433,"_30211":411,"_20923":50587,"_5":14374,"_27449":50539,"_2949":50588},[],"Also run the chart's connectivity test:",{"_3465":434,"_30211":411,"_20923":50590,"_5":14374,"_27449":50539,"_2949":50591},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3465":435,"_30211":411,"_20923":50593,"_5":14374,"_27449":50539,"_2949":50594},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3465":436,"_30211":411,"_20923":50596,"_5":14374,"_27449":50543,"_2949":50597},[],"If you receive a 401:",{"_3465":437,"_30211":411,"_20923":50599,"_5":14374,"_27449":50543,"_2949":50600},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3465":438,"_30211":411,"_20923":50602,"_5":14374,"_27449":50543,"_2949":50603},[],"verify issuer, audience and expiration of the token;",{"_3465":439,"_30211":411,"_20923":50605,"_5":14374,"_27449":50543,"_2949":50606},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3465":440,"_30211":411,"_20923":50608,"_5":14374,"_27449":50543,"_2949":50609},[],"check that the provider's public and internal routes point to the same realm.",{"_3465":441,"_30211":411,"_20923":50611,"_5":14374,"_27449":50543,"_2949":50612},[],"If login succeeds but the APIs return 403:",{"_3465":442,"_30211":411,"_20923":50614,"_5":14374,"_27449":50543,"_2949":50615},[],"inspect the token's real claims;",{"_3465":443,"_30211":411,"_20923":50617,"_5":14374,"_27449":50543,"_2949":50618},[],"confirm they match an active principal;",{"_3465":444,"_30211":411,"_20923":50620,"_5":14374,"_27449":50543,"_2949":50621},[],"review the policies granted to that principal;",{"_3465":445,"_30211":411,"_20923":50623,"_5":14374,"_27449":50543,"_2949":50624},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3465":446,"_30211":411,"_20923":50626,"_5":14374,"_27449":50543,"_2949":50627},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3465":447,"_30211":411,"_20923":50629,"_5":14374,"_27449":50547,"_2949":50630},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3465":448,"_30211":411,"_20923":50632,"_5":14374,"_27449":50547,"_2949":50633},[],"Locate the authz pod and Service.",{"_3465":449,"_30211":411,"_20923":50635,"_5":14374,"_27449":50547,"_2949":50636},[],"Check /health, logs and its database connection.",{"_3465":450,"_30211":411,"_20923":50638,"_5":14374,"_27449":50547,"_2949":50639},[],"Verify the DNS and port configured in externalAuthorization.",{"_3465":451,"_30211":411,"_20923":50641,"_5":14374,"_27449":50547,"_2949":50642},[],"Check the check route is /v1/ext\\_authz/check.",{"_3465":452,"_30211":411,"_20923":50644,"_5":14374,"_27449":50547,"_2949":50645},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3465":453,"_30211":411,"_20923":50647,"_5":14374,"_27449":50551,"_2949":50648},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3465":454,"_30211":411,"_20923":50650,"_5":14374,"_27449":50555,"_2949":50651},[],"Review kubectl describe pod first. Common causes are:",{"_3465":455,"_30211":411,"_20923":50653,"_5":14374,"_27449":50555,"_2949":50654},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3465":456,"_30211":411,"_20923":50656,"_5":14374,"_27449":50555,"_2949":50657},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3465":457,"_30211":411,"_20923":50659,"_5":14374,"_27449":50555,"_2949":50660},[],"unbound persistent volume;",{"_3465":458,"_30211":411,"_20923":50662,"_5":14374,"_27449":50555,"_2949":50663},[],"inaccessible image or incorrect pull policy;",{"_3465":459,"_30211":411,"_20923":50665,"_5":14374,"_27449":50555,"_2949":50666},[],"invalid cryptographic engine configuration;",{"_3465":460,"_30211":411,"_20923":50668,"_5":14374,"_27449":50555,"_2949":50669},[],"CPU or memory limits set too low;",{"_3465":461,"_30211":411,"_20923":50671,"_5":14374,"_27449":50555,"_2949":50672},[],"an incomplete prior migration.",{"_3465":462,"_30211":411,"_20923":50674,"_5":14374,"_27449":50555,"_2949":50675},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3465":463,"_30211":411,"_20923":50677,"_5":14374,"_27449":50555,"_2949":50678},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3465":464,"_30211":411,"_20923":50680,"_5":14374,"_27449":50555,"_2949":50681},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3465":465,"_30211":411,"_20923":50683,"_5":14374,"_27449":50559,"_2949":50684},[],"Domain and audit events depend on the bus publisher:",{"_3465":466,"_30211":411,"_20923":50686,"_5":14374,"_27449":50559,"_2949":50687},[],"verify it is enabled in the emitting service;",{"_3465":467,"_30211":411,"_20923":50689,"_5":14374,"_27449":50559,"_2949":50690},[],"check AMQP connectivity and credentials;",{"_3465":468,"_30211":411,"_20923":50692,"_5":14374,"_27449":50559,"_2949":50693},[],"review exchange, routing key, queues and consumers;",{"_3465":469,"_30211":411,"_20923":50695,"_5":14374,"_27449":50559,"_2949":50696},[],"inspect dead-letter queues;",{"_3465":470,"_30211":411,"_20923":50698,"_5":14374,"_27449":50559,"_2949":50699},[],"alert on orphan durable queues and backlog growth.",{"_3465":471,"_30211":411,"_20923":50701,"_5":14374,"_27449":50559,"_2949":50702},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3465":472,"_30211":411,"_20923":50704,"_5":14374,"_27449":50559,"_2949":50705},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3465":473,"_30211":411,"_20923":50707,"_5":14374,"_27449":50559,"_2949":50708},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3465":474,"_30211":411,"_20923":50710,"_5":14374,"_27449":50559,"_2949":50711},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3465":475,"_30211":411,"_20923":50713,"_5":14374,"_27449":50559,"_2949":50714},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3465":476,"_30211":411,"_20923":50716,"_5":14374,"_27449":50559,"_2949":50717},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3465":477,"_30211":411,"_20923":50719,"_5":14374,"_27449":50559,"_2949":50720},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3465":478,"_30211":411,"_20923":50722,"_5":14374,"_27449":50563,"_2949":50723},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3465":479,"_30211":411,"_20923":50725,"_5":14374,"_27449":50563,"_2949":50726},[],"Before closing an incident, record:",{"_3465":480,"_30211":411,"_20923":50728,"_5":14374,"_27449":50563,"_2949":50729},[],"the confirmed cause;",{"_3465":481,"_30211":411,"_20923":50731,"_5":14374,"_27449":50563,"_2949":50732},[],"the time scope and affected resources;",{"_3465":482,"_30211":411,"_20923":50734,"_5":14374,"_27449":50563,"_2949":50735},[],"the commands or queries used;",{"_3465":483,"_30211":411,"_20923":50737,"_5":14374,"_27449":50563,"_2949":50738},[],"the applied change and how to revert it;",{"_3465":484,"_30211":411,"_20923":50740,"_5":14374,"_27449":50563,"_2949":50741},[],"validation from a consumer;",{"_3465":485,"_30211":411,"_20923":50743,"_5":14374,"_27449":50563,"_2949":50744},[],"the preventive action and its owner.",{"_3465":486,"_30211":486,"_5":14726,"_2949":50746,"_30563":50747,"_20923":50750,"_27449":486},"Access control",[49273,50748,50749],"Platform","Administration",[],{"_3465":487,"_30211":486,"_20923":50752,"_5":14374,"_27449":486,"_2949":50753},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3465":488,"_30211":486,"_5":30560,"_20923":50755,"_27449":50756,"_2949":50757},[],"/docs/pr-preview/pr-67/platform/administration/access-control#essential-concepts","Essential concepts",{"_3465":489,"_30211":486,"_5":30560,"_20923":50759,"_27449":50760,"_2949":50761},[],"/docs/pr-preview/pr-67/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3465":490,"_30211":486,"_5":30560,"_20923":50763,"_27449":50764,"_2949":50765},[],"/docs/pr-preview/pr-67/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3465":491,"_30211":486,"_5":30560,"_20923":50767,"_27449":50768,"_2949":50769},[],"/docs/pr-preview/pr-67/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3465":492,"_30211":486,"_5":30560,"_20923":50771,"_27449":50772,"_2949":50773},[],"/docs/pr-preview/pr-67/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3465":493,"_30211":486,"_5":30560,"_20923":50775,"_27449":50776,"_2949":50777},[],"/docs/pr-preview/pr-67/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3465":494,"_30211":486,"_5":30560,"_20923":50779,"_27449":50780,"_2949":50781},[],"/docs/pr-preview/pr-67/platform/administration/access-control#oidc-principals","OIDC principals",{"_3465":495,"_30211":486,"_5":30560,"_20923":50783,"_27449":50784,"_2949":50785},[],"/docs/pr-preview/pr-67/platform/administration/access-control#x509-principals","X.509 principals",{"_3465":496,"_30211":486,"_5":30560,"_20923":50787,"_27449":50788,"_2949":50789},[],"/docs/pr-preview/pr-67/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3465":497,"_30211":486,"_5":30560,"_20923":50791,"_27449":50792,"_2949":50793},[],"/docs/pr-preview/pr-67/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3465":498,"_30211":486,"_5":30560,"_20923":50795,"_27449":50796,"_2949":50797},[],"/docs/pr-preview/pr-67/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3465":499,"_30211":486,"_5":30560,"_20923":50799,"_27449":50800,"_2949":50801},[],"/docs/pr-preview/pr-67/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3465":500,"_30211":486,"_5":30560,"_20923":50803,"_27449":50804,"_2949":50805},[],"/docs/pr-preview/pr-67/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3465":501,"_30211":486,"_5":30560,"_20923":50807,"_27449":50808,"_2949":50809},[],"/docs/pr-preview/pr-67/platform/administration/access-control#http-rules","HTTP rules",{"_3465":502,"_30211":486,"_5":30560,"_20923":50811,"_27449":50812,"_2949":50813},[],"/docs/pr-preview/pr-67/platform/administration/access-control#included-policies","Included policies",{"_3465":503,"_30211":486,"_5":30560,"_20923":50815,"_27449":50816,"_2949":49913},[],"/docs/pr-preview/pr-67/platform/administration/access-control#provision-the-first-administrator",{"_3465":504,"_30211":486,"_5":30560,"_20923":50818,"_27449":50819,"_2949":50820},[],"/docs/pr-preview/pr-67/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3465":505,"_30211":486,"_5":30560,"_20923":50822,"_27449":50823,"_2949":50824},[],"/docs/pr-preview/pr-67/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3465":506,"_30211":486,"_5":30560,"_20923":50826,"_27449":50827,"_2949":50828},[],"/docs/pr-preview/pr-67/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3465":507,"_30211":486,"_5":30560,"_20923":50830,"_27449":50831,"_2949":50832},[],"/docs/pr-preview/pr-67/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3465":508,"_30211":486,"_5":30560,"_20923":50834,"_27449":50835,"_2949":50836},[],"/docs/pr-preview/pr-67/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3465":509,"_30211":486,"_5":30560,"_20923":50838,"_27449":50839,"_2949":50840},[],"/docs/pr-preview/pr-67/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3465":510,"_30211":486,"_5":30560,"_20923":50842,"_27449":50843,"_2949":50844},[],"/docs/pr-preview/pr-67/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3465":511,"_30211":486,"_5":30560,"_20923":50846,"_27449":50847,"_2949":50848},[],"/docs/pr-preview/pr-67/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3465":512,"_30211":486,"_5":30560,"_20923":50850,"_27449":50851,"_2949":50852},[],"/docs/pr-preview/pr-67/platform/administration/access-control#operational-checklist","Operational checklist",{"_3465":513,"_30211":486,"_5":30560,"_20923":50854,"_27449":50855,"_2949":50856},[],"/docs/pr-preview/pr-67/platform/administration/access-control#diagnostics","Diagnostics",{"_3465":514,"_30211":486,"_5":30560,"_20923":50858,"_27449":50859,"_2949":50860},[],"/docs/pr-preview/pr-67/platform/administration/access-control#the-response-is-401","The response is 401",{"_3465":515,"_30211":486,"_5":30560,"_20923":50862,"_27449":50863,"_2949":50864},[],"/docs/pr-preview/pr-67/platform/administration/access-control#the-response-is-403","The response is 403",{"_3465":516,"_30211":486,"_5":30560,"_20923":50866,"_27449":50867,"_2949":50868},[],"/docs/pr-preview/pr-67/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3465":517,"_30211":486,"_5":30560,"_20923":50870,"_27449":50871,"_2949":50872},[],"/docs/pr-preview/pr-67/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3465":518,"_30211":486,"_5":30560,"_20923":50874,"_27449":50875,"_2949":50876},[],"/docs/pr-preview/pr-67/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3465":519,"_30211":486,"_20923":50878,"_5":14374,"_27449":486,"_2949":50879},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3465":520,"_30211":486,"_20923":50881,"_5":14374,"_27449":486,"_2949":50882},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3465":521,"_30211":486,"_20923":50884,"_5":14374,"_27449":486,"_2949":50885},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3465":522,"_30211":486,"_20923":50887,"_5":14374,"_27449":50756,"_2949":50888},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3465":523,"_30211":486,"_20923":50890,"_5":14374,"_27449":50756,"_2949":50891},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3465":524,"_30211":486,"_20923":50893,"_5":14374,"_27449":50756,"_2949":50894},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3465":525,"_30211":486,"_20923":50896,"_5":14374,"_27449":50756,"_2949":50897},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3465":526,"_30211":486,"_20923":50899,"_5":14374,"_27449":50756,"_2949":50900},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3465":527,"_30211":486,"_20923":50902,"_5":14374,"_27449":50756,"_2949":50903},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3465":528,"_30211":486,"_20923":50905,"_5":14374,"_27449":50760,"_2949":50906},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3465":529,"_30211":486,"_20923":50908,"_5":14374,"_27449":50760,"_2949":50909},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3465":530,"_30211":486,"_20923":50911,"_5":14374,"_27449":50764,"_2949":50912},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3465":531,"_30211":486,"_20923":50914,"_5":14374,"_27449":50764,"_2949":50915},[],"The decision is made **before forwarding the request to the service**:",{"_3465":532,"_30211":486,"_20923":50917,"_5":14374,"_27449":50764,"_2949":50918},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3465":533,"_30211":486,"_20923":50920,"_5":14374,"_27449":50764,"_2949":50921},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3465":534,"_30211":486,"_20923":50923,"_5":14374,"_27449":50764,"_2949":50924},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3465":535,"_30211":486,"_20923":50926,"_5":14374,"_27449":50764,"_2949":50927},[],"It separately loads the policies granted to each principal.",{"_3465":536,"_30211":486,"_20923":50929,"_5":14374,"_27449":50764,"_2949":50930},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3465":537,"_30211":486,"_20923":50932,"_5":14374,"_27449":50764,"_2949":50933},[],"`authz` looks for an HTTP rule granting that action.",{"_3465":538,"_30211":486,"_20923":50935,"_5":14374,"_27449":50764,"_2949":50936},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3465":539,"_30211":486,"_20923":50938,"_5":14374,"_27449":50764,"_2949":50939},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3465":540,"_30211":486,"_20923":50941,"_5":14374,"_27449":50764,"_2949":50942},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3465":541,"_30211":486,"_20923":50944,"_5":14374,"_27449":50764,"_2949":50945},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3465":542,"_30211":486,"_20923":50947,"_5":14374,"_27449":50768,"_2949":50948},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3465":543,"_30211":486,"_20923":50950,"_5":14374,"_27449":50768,"_2949":50951},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3465":544,"_30211":486,"_20923":50953,"_5":14374,"_27449":50768,"_2949":50954},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3465":545,"_30211":486,"_20923":50956,"_5":14374,"_27449":50768,"_2949":50957},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3465":546,"_30211":486,"_20923":50959,"_5":14374,"_27449":50768,"_2949":50960},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3465":547,"_30211":486,"_20923":50962,"_5":14374,"_27449":50768,"_2949":50963},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3465":548,"_30211":486,"_20923":50965,"_5":14374,"_27449":50768,"_2949":50966},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3465":549,"_30211":486,"_20923":50968,"_5":14374,"_27449":50768,"_2949":50969},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3465":550,"_30211":486,"_20923":50971,"_5":14374,"_27449":50772,"_2949":50972},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3465":551,"_30211":486,"_20923":50974,"_5":14374,"_27449":50772,"_2949":50975},[],"The decision is made with the domain operation context:",{"_3465":552,"_30211":486,"_20923":50977,"_5":14374,"_27449":50772,"_2949":50978},[],"The middleware extracts the credential and resolves the matching principals.",{"_3465":553,"_30211":486,"_20923":50980,"_5":14374,"_27449":50772,"_2949":50981},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3465":554,"_30211":486,"_20923":50983,"_5":14374,"_27449":50772,"_2949":50984},[],"`authz` gathers the entity rules of the granted policies.",{"_3465":555,"_30211":486,"_20923":50986,"_5":14374,"_27449":50772,"_2949":50987},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3465":556,"_30211":486,"_20923":50989,"_5":14374,"_27449":50772,"_2949":50990},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3465":557,"_30211":486,"_20923":50992,"_5":14374,"_27449":50772,"_2949":50993},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3465":558,"_30211":486,"_20923":50995,"_5":14374,"_27449":50772,"_2949":50996},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3465":559,"_30211":486,"_20923":50998,"_5":14374,"_27449":50772,"_2949":50999},[],"Actions fall into two groups:",{"_3465":560,"_30211":486,"_20923":51001,"_5":14374,"_27449":50772,"_2949":51002},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3465":561,"_30211":486,"_20923":51004,"_5":14374,"_27449":50772,"_2949":51005},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3465":562,"_30211":486,"_20923":51007,"_5":14374,"_27449":50772,"_2949":51008},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3465":563,"_30211":486,"_20923":51010,"_5":14374,"_27449":50776,"_2949":51011},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3465":564,"_30211":486,"_20923":51013,"_5":14374,"_27449":50776,"_2949":51014},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3465":565,"_30211":486,"_20923":51016,"_5":14374,"_27449":50776,"_2949":51017},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3465":566,"_30211":486,"_20923":51019,"_5":14374,"_27449":50780,"_2949":51020},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3465":567,"_30211":486,"_20923":51022,"_5":14374,"_27449":50780,"_2949":51023},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3465":568,"_30211":486,"_20923":51025,"_5":14374,"_27449":50780,"_2949":51026},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3465":569,"_30211":486,"_20923":51028,"_5":14374,"_27449":50780,"_2949":51029},[],"The implemented operators are:",{"_3465":570,"_30211":486,"_20923":51031,"_5":14374,"_27449":50780,"_2949":51032},[],"`equals`, for exact equality;",{"_3465":571,"_30211":486,"_20923":51034,"_5":14374,"_27449":50780,"_2949":51035},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3465":572,"_30211":486,"_20923":51037,"_5":14374,"_27449":50780,"_2949":51038},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3465":573,"_30211":486,"_20923":51040,"_5":14374,"_27449":50780,"_2949":51041},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3465":574,"_30211":486,"_20923":51043,"_5":14374,"_27449":50784,"_2949":51044},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3465":575,"_30211":486,"_20923":51046,"_5":14374,"_27449":50784,"_2949":51047},[],"The available modes are:",{"_3465":576,"_30211":486,"_20923":51049,"_5":14374,"_27449":50784,"_2949":51050},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3465":577,"_30211":486,"_20923":51052,"_5":14374,"_27449":50784,"_2949":51053},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3465":578,"_30211":486,"_20923":51055,"_5":14374,"_27449":50784,"_2949":51056},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3465":579,"_30211":486,"_20923":51058,"_5":14374,"_27449":50784,"_2949":51059},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3465":580,"_30211":486,"_20923":51061,"_5":14374,"_27449":50784,"_2949":51062},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3465":581,"_30211":486,"_20923":51064,"_5":14374,"_27449":50784,"_2949":51065},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3465":582,"_30211":486,"_20923":51067,"_5":14374,"_27449":50788,"_2949":51068},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3465":583,"_30211":486,"_20923":51070,"_5":14374,"_27449":50788,"_2949":51071},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3465":584,"_30211":486,"_20923":51073,"_5":14374,"_27449":50788,"_2949":51074},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3465":585,"_30211":486,"_20923":51076,"_5":14374,"_27449":50788,"_2949":51077},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3465":586,"_30211":486,"_20923":51079,"_5":14374,"_27449":50796,"_2949":51080},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3465":587,"_30211":486,"_20923":51082,"_5":14374,"_27449":50796,"_2949":51083},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3465":588,"_30211":486,"_20923":51085,"_5":14374,"_27449":50800,"_2949":51086},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3465":589,"_30211":486,"_20923":51088,"_5":14374,"_27449":50800,"_2949":51089},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3465":590,"_30211":486,"_20923":51091,"_5":14374,"_27449":50804,"_2949":51092},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3465":591,"_30211":486,"_20923":51094,"_5":14374,"_27449":50804,"_2949":51095},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3465":592,"_30211":486,"_20923":51097,"_5":14374,"_27449":50804,"_2949":51098},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3465":593,"_30211":486,"_20923":51100,"_5":14374,"_27449":50808,"_2949":51101},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3465":594,"_30211":486,"_20923":51103,"_5":14374,"_27449":50808,"_2949":51104},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3465":595,"_30211":486,"_20923":51106,"_5":14374,"_27449":50808,"_2949":51107},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3465":596,"_30211":486,"_20923":51109,"_5":14374,"_27449":50808,"_2949":51110},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3465":597,"_30211":486,"_20923":51112,"_5":14374,"_27449":50808,"_2949":51113},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3465":598,"_30211":486,"_20923":51115,"_5":14374,"_27449":50808,"_2949":51116},[],"Note that:",{"_3465":599,"_30211":486,"_20923":51118,"_5":14374,"_27449":50808,"_2949":51119},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3465":600,"_30211":486,"_20923":51121,"_5":14374,"_27449":50808,"_2949":51122},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3465":601,"_30211":486,"_20923":51124,"_5":14374,"_27449":50808,"_2949":51125},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3465":602,"_30211":486,"_20923":51127,"_5":14374,"_27449":50812,"_2949":51128},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3465":603,"_30211":486,"_20923":51130,"_5":14374,"_27449":50812,"_2949":51131},[],"full and read-only access to certificates and authorities;",{"_3465":604,"_30211":486,"_20923":51133,"_5":14374,"_27449":50812,"_2949":51134},[],"full and read-only access to the KMS;",{"_3465":605,"_30211":486,"_20923":51136,"_5":14374,"_27449":50812,"_2949":51137},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3465":606,"_30211":486,"_20923":51139,"_5":14374,"_27449":50812,"_2949":51140},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3465":607,"_30211":486,"_20923":51142,"_5":14374,"_27449":50812,"_2949":51143},[],"console access;",{"_3465":608,"_30211":486,"_20923":51145,"_5":14374,"_27449":50812,"_2949":51146},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3465":609,"_30211":486,"_20923":51148,"_5":14374,"_27449":50812,"_2949":51149},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3465":610,"_30211":486,"_20923":51151,"_5":14374,"_27449":50812,"_2949":51152},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3465":611,"_30211":486,"_20923":51154,"_5":14374,"_27449":50816,"_2949":51155},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3465":612,"_30211":486,"_20923":51157,"_5":14374,"_27449":50816,"_2949":51158},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3465":613,"_30211":486,"_20923":51160,"_5":14374,"_27449":50816,"_2949":51161},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3465":614,"_30211":486,"_20923":51163,"_5":14374,"_27449":50819,"_2949":51164},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3465":615,"_30211":486,"_20923":51166,"_5":14374,"_27449":50823,"_2949":51167},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3465":616,"_30211":486,"_20923":51169,"_5":14374,"_27449":50823,"_2949":51170},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3465":617,"_30211":486,"_20923":51172,"_5":14374,"_27449":50827,"_2949":51173},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3465":618,"_30211":486,"_20923":51175,"_5":14374,"_27449":50831,"_2949":51176},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3465":619,"_30211":486,"_20923":51178,"_5":14374,"_27449":50835,"_2949":51179},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3465":620,"_30211":486,"_20923":51181,"_5":14374,"_27449":50839,"_2949":51182},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3465":621,"_30211":486,"_20923":51184,"_5":14374,"_27449":50839,"_2949":51185},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3465":622,"_30211":486,"_20923":51187,"_5":14374,"_27449":50843,"_2949":51188},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3465":623,"_30211":486,"_20923":51190,"_5":14374,"_27449":50843,"_2949":51191},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3465":624,"_30211":486,"_20923":51193,"_5":14374,"_27449":50843,"_2949":51194},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3465":625,"_30211":486,"_20923":51196,"_5":14374,"_27449":50843,"_2949":51197},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3465":626,"_30211":486,"_20923":51199,"_5":14374,"_27449":50843,"_2949":51200},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3465":627,"_30211":486,"_20923":51202,"_5":14374,"_27449":50843,"_2949":51203},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3465":628,"_30211":486,"_20923":51205,"_5":14374,"_27449":50843,"_2949":51206},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3465":629,"_30211":486,"_20923":51208,"_5":14374,"_27449":50843,"_2949":51209},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3465":630,"_30211":486,"_20923":51211,"_5":14374,"_27449":50847,"_2949":51212},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3465":631,"_30211":486,"_20923":51214,"_5":14374,"_27449":50847,"_2949":51215},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3465":632,"_30211":486,"_20923":51217,"_5":14374,"_27449":50847,"_2949":51218},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3465":633,"_30211":486,"_20923":51220,"_5":14374,"_27449":50851,"_2949":51221},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3465":634,"_30211":486,"_20923":51223,"_5":14374,"_27449":50851,"_2949":51224},[],"Use groups or stable roles for people and independent identities for automations.",{"_3465":635,"_30211":486,"_20923":51226,"_5":14374,"_27449":50851,"_2949":51227},[],"Keep at least two recovery administrators and test their access periodically.",{"_3465":636,"_30211":486,"_20923":51229,"_5":14374,"_27449":50851,"_2949":51230},[],"Review active principals, their matches and their grants after IdP changes.",{"_3465":637,"_30211":486,"_20923":51232,"_5":14374,"_27449":50851,"_2949":51233},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3465":638,"_30211":486,"_20923":51235,"_5":14374,"_27449":50851,"_2949":51236},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3465":639,"_30211":486,"_20923":51238,"_5":14374,"_27449":50851,"_2949":51239},[],"Always test one allowed and one denied operation for each role.",{"_3465":640,"_30211":486,"_20923":51241,"_5":14374,"_27449":50851,"_2949":51242},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3465":641,"_30211":486,"_20923":51244,"_5":14374,"_27449":50859,"_2949":51245},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3465":642,"_30211":486,"_20923":51247,"_5":14374,"_27449":50863,"_2949":51248},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3465":643,"_30211":486,"_20923":51250,"_5":14374,"_27449":50863,"_2949":51251},[],"that an active principal of the correct type exists;",{"_3465":644,"_30211":486,"_20923":51253,"_5":14374,"_27449":50863,"_2949":51254},[],"that the claim paths and values match the real token exactly;",{"_3465":645,"_30211":486,"_20923":51256,"_5":14374,"_27449":50863,"_2949":51257},[],"that all of the principal's conditions hold;",{"_3465":646,"_30211":486,"_20923":51259,"_5":14374,"_27449":50863,"_2949":51260},[],"that the principal has the expected policy granted;",{"_3465":647,"_30211":486,"_20923":51262,"_5":14374,"_27449":50863,"_2949":51263},[],"that the policy includes the action and the requested resource type or route;",{"_3465":648,"_30211":486,"_20923":51265,"_5":14374,"_27449":50863,"_2949":51266},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3465":649,"_30211":486,"_20923":51268,"_5":14374,"_27449":50863,"_2949":51269},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3465":650,"_30211":486,"_20923":51271,"_5":14374,"_27449":50867,"_2949":51272},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3465":651,"_30211":486,"_20923":51274,"_5":14374,"_27449":50871,"_2949":51275},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3465":652,"_30211":486,"_20923":51277,"_5":14374,"_27449":50875,"_2949":51278},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3465":653,"_30211":486,"_20923":51280,"_5":14374,"_27449":50875,"_2949":51281},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3465":654,"_30211":654,"_5":14726,"_2949":51283,"_30563":51284,"_20923":51285,"_27449":654},"Alerts and subscriptions",[49273,50748,50749],[],{"_3465":655,"_30211":654,"_20923":51287,"_5":14374,"_27449":654,"_2949":51288},[],"Send PKI events to people and external systems.",{"_3465":656,"_30211":654,"_5":30560,"_20923":51290,"_27449":51291,"_2949":51292},[],"/docs/pr-preview/pr-67/platform/administration/alerts#how-it-works","How it works",{"_3465":657,"_30211":654,"_5":30560,"_20923":51294,"_27449":51295,"_2949":51296},[],"/docs/pr-preview/pr-67/platform/administration/alerts#available-channels","Available channels",{"_3465":658,"_30211":654,"_5":30560,"_20923":51298,"_27449":51299,"_2949":51300},[],"/docs/pr-preview/pr-67/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3465":659,"_30211":654,"_5":30560,"_20923":51302,"_27449":51303,"_2949":51304},[],"/docs/pr-preview/pr-67/platform/administration/alerts#choose-the-event","Choose the event",{"_3465":660,"_30211":654,"_5":30560,"_20923":51306,"_27449":51307,"_2949":51308},[],"/docs/pr-preview/pr-67/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3465":661,"_30211":654,"_5":30560,"_20923":51310,"_27449":51311,"_2949":51312},[],"/docs/pr-preview/pr-67/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3465":662,"_30211":654,"_5":30560,"_20923":51314,"_27449":51315,"_2949":51316},[],"/docs/pr-preview/pr-67/platform/administration/alerts#review-and-activate","Review and activate",{"_3465":663,"_30211":654,"_5":30560,"_20923":51318,"_27449":51319,"_2949":51320},[],"/docs/pr-preview/pr-67/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3465":664,"_30211":654,"_5":30560,"_20923":51322,"_27449":51323,"_2949":51324},[],"/docs/pr-preview/pr-67/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3465":665,"_30211":654,"_5":30560,"_20923":51326,"_27449":51327,"_2949":51328},[],"/docs/pr-preview/pr-67/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3465":666,"_30211":654,"_5":30560,"_20923":51330,"_27449":51331,"_2949":51332},[],"/docs/pr-preview/pr-67/platform/administration/alerts#event-families","Event families",{"_3465":667,"_30211":654,"_20923":51334,"_5":14374,"_27449":654,"_2949":51335},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3465":668,"_30211":654,"_20923":51337,"_5":14374,"_27449":51291,"_2949":51338},[],"A service publishes a domain event.",{"_3465":669,"_30211":654,"_20923":51340,"_5":14374,"_27449":51291,"_2949":51341},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3465":670,"_30211":654,"_20923":51343,"_5":14374,"_27449":51291,"_2949":51344},[],"Each subscription's filter decides whether it should be notified.",{"_3465":671,"_30211":654,"_20923":51346,"_5":14374,"_27449":51291,"_2949":51347},[],"Lamassu delivers the event to the configured channel.",{"_3465":672,"_30211":654,"_20923":51349,"_5":14374,"_27449":51291,"_2949":51350},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3465":673,"_30211":654,"_20923":51352,"_5":14374,"_27449":51295,"_2949":51353},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3465":674,"_30211":654,"_20923":51355,"_5":14374,"_27449":51295,"_2949":51356},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3465":675,"_30211":654,"_20923":51358,"_5":14374,"_27449":51295,"_2949":51359},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3465":676,"_30211":654,"_20923":51361,"_5":14374,"_27449":51295,"_2949":51362},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3465":677,"_30211":654,"_20923":51364,"_5":14374,"_27449":51295,"_2949":51365},[],"`apikey_options` requires `header` and `key`.",{"_3465":678,"_30211":654,"_20923":51367,"_5":14374,"_27449":51295,"_2949":51368},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3465":679,"_30211":654,"_20923":51370,"_5":14374,"_27449":51295,"_2949":51371},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3465":680,"_30211":654,"_20923":51373,"_5":14374,"_27449":51295,"_2949":51374},[],"The alerts API reference documents the full `http_client` schema.",{"_3465":681,"_30211":654,"_20923":51376,"_5":14374,"_27449":51303,"_2949":51377},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3465":682,"_30211":654,"_20923":51379,"_5":14374,"_27449":51307,"_2949":51380},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3465":683,"_30211":654,"_20923":51382,"_5":14374,"_27449":51311,"_2949":51383},[],"Add a filter if you don't want to receive every instance of the event.",{"_3465":684,"_30211":654,"_20923":51385,"_5":14374,"_27449":51311,"_2949":51386},[],"**None** notifies all instances of the event.",{"_3465":685,"_30211":654,"_20923":51388,"_5":14374,"_27449":51311,"_2949":51389},[],"**JSON Path** evaluates one or more specific fields.",{"_3465":686,"_30211":654,"_20923":51391,"_5":14374,"_27449":51311,"_2949":51392},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3465":687,"_30211":654,"_20923":51394,"_5":14374,"_27449":51311,"_2949":51395},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3465":688,"_30211":654,"_20923":51397,"_5":14374,"_27449":51311,"_2949":51398},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3465":689,"_30211":654,"_20923":51400,"_5":14374,"_27449":51311,"_2949":51401},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3465":690,"_30211":654,"_20923":51403,"_5":14374,"_27449":51315,"_2949":51404},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3465":691,"_30211":654,"_20923":51406,"_5":14374,"_27449":51319,"_2949":51407},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3465":692,"_30211":654,"_20923":51409,"_5":14374,"_27449":51319,"_2949":51410},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3465":693,"_30211":654,"_20923":51412,"_5":14374,"_27449":51319,"_2949":51413},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3465":694,"_30211":654,"_20923":51415,"_5":14374,"_27449":51319,"_2949":51416},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3465":695,"_30211":654,"_20923":51418,"_5":14374,"_27449":51319,"_2949":51419},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3465":696,"_30211":654,"_20923":51421,"_5":14374,"_27449":51319,"_2949":51422},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3465":697,"_30211":654,"_20923":51424,"_5":14374,"_27449":51319,"_2949":51425},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3465":698,"_30211":654,"_20923":51427,"_5":14374,"_27449":51319,"_2949":51428},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3465":699,"_30211":654,"_20923":51430,"_5":14374,"_27449":51323,"_2949":51431},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3465":700,"_30211":654,"_20923":51433,"_5":14374,"_27449":51323,"_2949":51434},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3465":701,"_30211":654,"_20923":51436,"_5":14374,"_27449":51323,"_2949":51437},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3465":702,"_30211":654,"_20923":51439,"_5":14374,"_27449":51323,"_2949":51440},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3465":703,"_30211":654,"_20923":51442,"_5":14374,"_27449":51323,"_2949":51443},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3465":704,"_30211":654,"_20923":51445,"_5":14374,"_27449":51323,"_2949":51446},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3465":705,"_30211":654,"_20923":51448,"_5":14374,"_27449":51323,"_2949":51449},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3465":706,"_30211":654,"_20923":51451,"_5":14374,"_27449":51323,"_2949":51452},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3465":707,"_30211":654,"_20923":51454,"_5":14374,"_27449":51327,"_2949":51455},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3465":708,"_30211":654,"_20923":51457,"_5":14374,"_27449":51327,"_2949":51458},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3465":709,"_30211":654,"_20923":51460,"_5":14374,"_27449":51331,"_2949":51461},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3465":710,"_30211":654,"_20923":51463,"_5":14374,"_27449":51331,"_2949":51464},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3465":711,"_30211":654,"_20923":51466,"_5":14374,"_27449":51331,"_2949":51467},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3465":712,"_30211":654,"_20923":51469,"_5":14374,"_27449":51331,"_2949":51470},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3465":713,"_30211":654,"_20923":51472,"_5":14374,"_27449":51331,"_2949":51473},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3465":714,"_30211":654,"_20923":51475,"_5":14374,"_27449":51331,"_2949":51476},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init` and `va.crl-settings.update`.",{"_3465":715,"_30211":654,"_20923":51478,"_5":14374,"_27449":51331,"_2949":51479},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3465":716,"_30211":654,"_20923":51481,"_5":14374,"_27449":51331,"_2949":51482},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3465":717,"_30211":654,"_20923":51484,"_5":14374,"_27449":51331,"_2949":51485},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3465":718,"_30211":718,"_5":14726,"_2949":51487,"_30563":51488,"_20923":51489,"_27449":718},"Audit logs",[49273,50748,50749],[],{"_3465":719,"_30211":718,"_20923":51491,"_5":14374,"_27449":718,"_2949":51492},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3465":720,"_30211":718,"_5":30560,"_20923":51494,"_27449":51495,"_2949":51496},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3465":721,"_30211":718,"_5":30560,"_20923":51498,"_27449":51499,"_2949":51500},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#coverage","Coverage",{"_3465":722,"_30211":718,"_5":30560,"_20923":51502,"_27449":51503,"_2949":51504},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3465":723,"_30211":718,"_5":30560,"_20923":51506,"_27449":51507,"_2949":51508},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3465":724,"_30211":718,"_5":30560,"_20923":51510,"_27449":51511,"_2949":51512},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3465":725,"_30211":718,"_5":30560,"_20923":51514,"_27449":51515,"_2949":51516},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3465":726,"_30211":718,"_5":30560,"_20923":51518,"_27449":51519,"_2949":51520},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3465":727,"_30211":718,"_5":30560,"_20923":51522,"_27449":51523,"_2949":51524},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3465":728,"_30211":718,"_5":30560,"_20923":51526,"_27449":51527,"_2949":51528},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3465":729,"_30211":718,"_5":30560,"_20923":51530,"_27449":51531,"_2949":51532},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3465":730,"_30211":718,"_5":30560,"_20923":51534,"_27449":51535,"_2949":51536},[],"/docs/pr-preview/pr-67/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3465":731,"_30211":718,"_20923":51538,"_5":14374,"_27449":718,"_2949":51539},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3465":732,"_30211":718,"_20923":51541,"_5":14374,"_27449":51495,"_2949":51542},[],"The audit body includes:",{"_3465":733,"_30211":718,"_20923":51544,"_5":14374,"_27449":51495,"_2949":51545},[],"input: data received by the operation;",{"_3465":734,"_30211":718,"_20923":51547,"_5":14374,"_27449":51495,"_2949":51548},[],"has\\_error: whether the service returned an error;",{"_3465":735,"_30211":718,"_20923":51550,"_5":14374,"_27449":51495,"_2949":51551},[],"output: produced result or error message;",{"_3465":736,"_30211":718,"_20923":51553,"_5":14374,"_27449":51495,"_2949":51554},[],"principals: identifiers of the principals that matched the request.",{"_3465":737,"_30211":718,"_20923":51556,"_5":14374,"_27449":51495,"_2949":51557},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3465":738,"_30211":718,"_20923":51559,"_5":14374,"_27449":51495,"_2949":51560},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3465":739,"_30211":718,"_20923":51562,"_5":14374,"_27449":51499,"_2949":51563},[],"The backend applies auditing to mutations of:",{"_3465":740,"_30211":718,"_20923":51565,"_5":14374,"_27449":51499,"_2949":51566},[],"authorities, certificates and issuance profiles;",{"_3465":741,"_30211":718,"_20923":51568,"_5":14374,"_27449":51499,"_2949":51569},[],"keys and KMS engines;",{"_3465":742,"_30211":718,"_20923":51571,"_5":14374,"_27449":51499,"_2949":51572},[],"devices and identities;",{"_3465":743,"_30211":718,"_20923":51574,"_5":14374,"_27449":51499,"_2949":51575},[],"DMSs and enrollment operations;",{"_3465":744,"_30211":718,"_20923":51577,"_5":14374,"_27449":51499,"_2949":51578},[],"validation functions and CRL;",{"_3465":745,"_30211":718,"_20923":51580,"_5":14374,"_27449":51499,"_2949":51581},[],"principals, policies and authorization grants.",{"_3465":746,"_30211":718,"_20923":51583,"_5":14374,"_27449":51499,"_2949":51584},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3465":747,"_30211":718,"_20923":51586,"_5":14374,"_27449":51503,"_2949":51587},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3465":748,"_30211":718,"_20923":51589,"_5":14374,"_27449":51503,"_2949":51590},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3465":749,"_30211":718,"_20923":51592,"_5":14374,"_27449":51503,"_2949":51593},[],"Design the consumer to:",{"_3465":750,"_30211":718,"_20923":51595,"_5":14374,"_27449":51503,"_2949":51596},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3465":751,"_30211":718,"_20923":51598,"_5":14374,"_27449":51503,"_2949":51599},[],"keep the complete CloudEvent unmodified;",{"_3465":752,"_30211":718,"_20923":51601,"_5":14374,"_27449":51503,"_2949":51602},[],"record the ingestion time and detect duplicates by ID;",{"_3465":753,"_30211":718,"_20923":51604,"_5":14374,"_27449":51503,"_2949":51605},[],"encrypt in transit and at rest;",{"_3465":754,"_30211":718,"_20923":51607,"_5":14374,"_27449":51503,"_2949":51608},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3465":755,"_30211":718,"_20923":51610,"_5":14374,"_27449":51503,"_2949":51611},[],"apply an explicit retention and legal hold policy;",{"_3465":756,"_30211":718,"_20923":51613,"_5":14374,"_27449":51503,"_2949":51614},[],"alert if it stops consuming or the pending queue grows.",{"_3465":757,"_30211":718,"_20923":51616,"_5":14374,"_27449":51507,"_2949":51617},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3465":758,"_30211":718,"_20923":51619,"_5":14374,"_27449":51507,"_2949":51620},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3465":759,"_30211":718,"_20923":51622,"_5":14374,"_27449":51515,"_2949":51623},[],"Start from the reported time and normalize every source to UTC.",{"_3465":760,"_30211":718,"_20923":51625,"_5":14374,"_27449":51519,"_2949":51626},[],"Filter by event type, service source and resource identifier.",{"_3465":761,"_30211":718,"_20923":51628,"_5":14374,"_27449":51523,"_2949":51629},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3465":762,"_30211":718,"_20923":51631,"_5":14374,"_27449":51527,"_2949":51632},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3465":763,"_30211":718,"_20923":51634,"_5":14374,"_27449":51531,"_2949":51635},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3465":764,"_30211":718,"_20923":51637,"_5":14374,"_27449":51535,"_2949":51638},[],"Generate a controlled mutation in a test environment and check that:",{"_3465":765,"_30211":718,"_20923":51640,"_5":14374,"_27449":51535,"_2949":51641},[],"a successful audit event appears;",{"_3465":766,"_30211":718,"_20923":51643,"_5":14374,"_27449":51535,"_2949":51644},[],"the principal matches the identity used;",{"_3465":767,"_30211":718,"_20923":51646,"_5":14374,"_27449":51535,"_2949":51647},[],"the consumer persists it exactly once;",{"_3465":768,"_30211":718,"_20923":51649,"_5":14374,"_27449":51535,"_2949":51650},[],"it can be retrieved by resource, actor and period;",{"_3465":769,"_30211":718,"_20923":51652,"_5":14374,"_27449":51535,"_2949":51653},[],"a consumer outage raises an alert.",{"_3465":770,"_30211":718,"_20923":51655,"_5":14374,"_27449":51535,"_2949":51656},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3465":771,"_30211":771,"_5":14726,"_2949":51658,"_30563":51659,"_20923":51660,"_27449":771},"Platform architecture",[49273,50748],[],{"_3465":772,"_30211":771,"_20923":51662,"_5":14374,"_27449":771,"_2949":51663},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3465":773,"_30211":771,"_5":30560,"_20923":51665,"_27449":51666,"_2949":51667},[],"/docs/pr-preview/pr-67/platform/concepts/architecture#control-plane","Control plane",{"_3465":774,"_30211":771,"_5":30560,"_20923":51669,"_27449":51670,"_2949":51671},[],"/docs/pr-preview/pr-67/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3465":775,"_30211":771,"_5":30560,"_20923":51673,"_27449":51674,"_2949":51675},[],"/docs/pr-preview/pr-67/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3465":776,"_30211":771,"_5":30560,"_20923":51677,"_27449":51678,"_2949":51679},[],"/docs/pr-preview/pr-67/platform/concepts/architecture#status-and-validation","Status and validation",{"_3465":777,"_30211":771,"_5":30560,"_20923":51681,"_27449":51682,"_2949":51683},[],"/docs/pr-preview/pr-67/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3465":778,"_30211":771,"_20923":51685,"_5":14374,"_27449":771,"_2949":51686},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3465":779,"_30211":771,"_20923":51688,"_5":14374,"_27449":771,"_2949":51689},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3465":780,"_30211":771,"_20923":51691,"_5":14374,"_27449":51666,"_2949":51692},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3465":781,"_30211":771,"_20923":51694,"_5":14374,"_27449":51670,"_2949":51695},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3465":782,"_30211":771,"_20923":51697,"_5":14374,"_27449":51674,"_2949":51698},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3465":783,"_30211":771,"_20923":51700,"_5":14374,"_27449":51678,"_2949":51701},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3465":784,"_30211":771,"_20923":51703,"_5":14374,"_27449":51682,"_2949":51704},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3465":785,"_30211":785,"_5":14726,"_2949":51706,"_30563":51707,"_20923":51708,"_27449":785},"How Lamassu works",[49273,50748],[],{"_3465":786,"_30211":785,"_20923":51710,"_5":14374,"_27449":785,"_2949":51711},[],"The mental model of trust, keys, certificates and devices.",{"_3465":787,"_30211":785,"_5":30560,"_20923":51713,"_27449":51714,"_2949":51715},[],"/docs/pr-preview/pr-67/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3465":788,"_30211":785,"_5":30560,"_20923":51717,"_27449":51718,"_2949":51719},[],"/docs/pr-preview/pr-67/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3465":789,"_30211":785,"_20923":51721,"_5":14374,"_27449":785,"_2949":51722},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3465":790,"_30211":785,"_20923":51724,"_5":14374,"_27449":51714,"_2949":51725},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3465":791,"_30211":785,"_20923":51727,"_5":14374,"_27449":51714,"_2949":51728},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3465":792,"_30211":785,"_20923":51730,"_5":14374,"_27449":51714,"_2949":51731},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3465":793,"_30211":785,"_20923":51733,"_5":14374,"_27449":51714,"_2949":51734},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3465":794,"_30211":785,"_20923":51736,"_5":14374,"_27449":51714,"_2949":51737},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3465":795,"_30211":785,"_20923":51739,"_5":14374,"_27449":51718,"_2949":51740},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3465":796,"_30211":785,"_20923":51742,"_5":14374,"_27449":51718,"_2949":51743},[],"A DMS relates that CA to an enrollment policy.",{"_3465":797,"_30211":785,"_20923":51745,"_5":14374,"_27449":51718,"_2949":51746},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3465":798,"_30211":785,"_20923":51748,"_5":14374,"_27449":51718,"_2949":51749},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3465":799,"_30211":785,"_20923":51751,"_5":14374,"_27449":51718,"_2949":51752},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3465":800,"_30211":785,"_20923":51754,"_5":14374,"_27449":51718,"_2949":51755},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3465":801,"_30211":785,"_20923":51757,"_5":14374,"_27449":51718,"_2949":51758},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3465":802,"_30211":802,"_5":14726,"_2949":51760,"_30563":51761,"_20923":51763,"_27449":802},"Devices and identities",[49273,50748,51762,51760],"IoT Fleets",[],{"_3465":803,"_30211":802,"_20923":51765,"_5":14374,"_27449":802,"_2949":51766},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3465":804,"_30211":802,"_5":30560,"_20923":51768,"_27449":51769,"_2949":51770},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#device-states","Device states",{"_3465":805,"_30211":802,"_5":30560,"_20923":51772,"_27449":51773,"_2949":51774},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3465":806,"_30211":802,"_5":30560,"_20923":51776,"_27449":51777,"_2949":51778},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3465":807,"_30211":802,"_5":30560,"_20923":51780,"_27449":51781,"_2949":51782},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3465":808,"_30211":802,"_5":30560,"_20923":51784,"_27449":51785,"_2949":51786},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3465":809,"_30211":802,"_5":30560,"_20923":51788,"_27449":51789,"_2949":51790},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3465":810,"_30211":802,"_5":30560,"_20923":51792,"_27449":51793,"_2949":51794},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3465":811,"_30211":802,"_5":30560,"_20923":51796,"_27449":51797,"_2949":51798},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3465":812,"_30211":802,"_5":30560,"_20923":51800,"_27449":51801,"_2949":51802},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3465":813,"_30211":802,"_5":30560,"_20923":51804,"_27449":51805,"_2949":51806},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3465":814,"_30211":802,"_5":30560,"_20923":51808,"_27449":51809,"_2949":51810},[],"/docs/pr-preview/pr-67/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3465":815,"_30211":802,"_20923":51812,"_5":14374,"_27449":802,"_2949":51813},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3465":816,"_30211":802,"_20923":51815,"_5":14374,"_27449":802,"_2949":51816},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3465":817,"_30211":802,"_20923":51818,"_5":14374,"_27449":51769,"_2949":51819},[],"Operational view",{"_3465":818,"_30211":802,"_20923":51821,"_5":14374,"_27449":51769,"_2949":51822},[],"Meaning",{"_3465":819,"_30211":802,"_20923":51824,"_5":14374,"_27449":51769,"_2949":51825},[],"**No Identity**",{"_3465":820,"_30211":802,"_20923":51827,"_5":14374,"_27449":51769,"_2949":51828},[],"A record exists without an associated identity.",{"_3465":821,"_30211":802,"_20923":51830,"_5":14374,"_27449":51769,"_2949":51831},[],"**Active**",{"_3465":822,"_30211":802,"_20923":51833,"_5":14374,"_27449":51769,"_2949":51834},[],"The slot is active; also check certificate dates, status and usages.",{"_3465":823,"_30211":802,"_20923":51836,"_5":14374,"_27449":51769,"_2949":51837},[],"**Renewal Pending**",{"_3465":824,"_30211":802,"_20923":51839,"_5":14374,"_27449":51769,"_2949":51840},[],"The identity is in the operational renewal window.",{"_3465":825,"_30211":802,"_20923":51842,"_5":14374,"_27449":51769,"_2949":51843},[],"**Expiring Soon**",{"_3465":826,"_30211":802,"_20923":51845,"_5":14374,"_27449":51769,"_2949":51846},[],"Expiration is approaching according to configured thresholds.",{"_3465":827,"_30211":802,"_20923":51848,"_5":14374,"_27449":51769,"_2949":51849},[],"**Expired**",{"_3465":828,"_30211":802,"_20923":51851,"_5":14374,"_27449":51769,"_2949":51852},[],"The identity has expired.",{"_3465":829,"_30211":802,"_20923":51854,"_5":14374,"_27449":51769,"_2949":51855},[],"**Revoked**",{"_3465":830,"_30211":802,"_20923":51857,"_5":14374,"_27449":51769,"_2949":51858},[],"The identity is marked revoked.",{"_3465":831,"_30211":802,"_20923":51860,"_5":14374,"_27449":51769,"_2949":51861},[],"**Decommissioned**",{"_3465":832,"_30211":802,"_20923":51863,"_5":14374,"_27449":51769,"_2949":51864},[],"The record is retired and ordinary updates do not restore operation.",{"_3465":833,"_30211":802,"_20923":51866,"_5":14374,"_27449":51769,"_2949":51867},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3465":834,"_30211":802,"_20923":51869,"_5":14374,"_27449":51773,"_2949":51870},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3465":835,"_30211":802,"_20923":51872,"_5":14374,"_27449":51773,"_2949":51873},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3465":836,"_30211":802,"_20923":51875,"_5":14374,"_27449":51773,"_2949":51876},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3465":837,"_30211":802,"_20923":51878,"_5":14374,"_27449":51773,"_2949":51879},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3465":838,"_30211":802,"_20923":51881,"_5":14374,"_27449":51777,"_2949":51882},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3465":839,"_30211":802,"_20923":51884,"_5":14374,"_27449":51781,"_2949":51885},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3465":840,"_30211":802,"_20923":51887,"_5":14374,"_27449":51785,"_2949":51888},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3465":841,"_30211":802,"_20923":51890,"_5":14374,"_27449":51789,"_2949":51891},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3465":842,"_30211":802,"_20923":51893,"_5":14374,"_27449":51793,"_2949":51894},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3465":843,"_30211":802,"_20923":51896,"_5":14374,"_27449":51793,"_2949":51897},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3465":844,"_30211":802,"_20923":51899,"_5":14374,"_27449":51797,"_2949":51900},[],"From **No Identity**, use **Assign Identity**:",{"_3465":845,"_30211":802,"_20923":51902,"_5":14374,"_27449":51797,"_2949":51903},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3465":846,"_30211":802,"_20923":51905,"_5":14374,"_27449":51797,"_2949":51906},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3465":847,"_30211":802,"_20923":51908,"_5":14374,"_27449":51797,"_2949":51909},[],"Confirm and read the serial, active version and history again.",{"_3465":848,"_30211":802,"_20923":51911,"_5":14374,"_27449":51797,"_2949":51912},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3465":849,"_30211":802,"_20923":51914,"_5":14374,"_27449":51797,"_2949":51915},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3465":850,"_30211":802,"_20923":51917,"_5":14374,"_27449":51801,"_2949":51918},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3465":851,"_30211":802,"_20923":51920,"_5":14374,"_27449":51801,"_2949":51921},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3465":852,"_30211":802,"_20923":51923,"_5":14374,"_27449":51805,"_2949":51924},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3465":853,"_30211":802,"_20923":51926,"_5":14374,"_27449":51805,"_2949":51927},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3465":854,"_30211":802,"_20923":51929,"_5":14374,"_27449":51805,"_2949":51930},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3465":855,"_30211":802,"_20923":51932,"_5":14374,"_27449":51805,"_2949":51933},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3465":856,"_30211":802,"_20923":51935,"_5":14374,"_27449":51809,"_2949":51936},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3465":857,"_30211":802,"_20923":51938,"_5":14374,"_27449":51809,"_2949":51939},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3465":858,"_30211":858,"_5":14726,"_2949":51941,"_30563":51942,"_20923":51944,"_27449":858},"Bootstrap identity and authentication",[49273,50748,51762,51760,51943],"Enrollment with PKI",[],{"_3465":859,"_30211":858,"_20923":51946,"_5":14374,"_27449":858,"_2949":51947},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3465":860,"_30211":858,"_5":30560,"_20923":51949,"_27449":51950,"_2949":51951},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3465":861,"_30211":858,"_5":30560,"_20923":51953,"_27449":51954,"_2949":51955},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3465":862,"_30211":858,"_5":30560,"_20923":51957,"_27449":51958,"_2949":51959},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3465":863,"_30211":858,"_5":30560,"_20923":51961,"_27449":51962,"_2949":51963},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3465":864,"_30211":858,"_5":30560,"_20923":51965,"_27449":51966,"_2949":51967},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3465":865,"_30211":858,"_20923":51969,"_5":14374,"_27449":858,"_2949":51970},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3465":866,"_30211":858,"_20923":51972,"_5":14374,"_27449":51950,"_2949":51973},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3465":867,"_30211":858,"_20923":51975,"_5":14374,"_27449":51950,"_2949":51976},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3465":868,"_30211":858,"_20923":51978,"_5":14374,"_27449":51954,"_2949":51979},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3465":869,"_30211":858,"_20923":51981,"_5":14374,"_27449":51954,"_2949":51982},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3465":870,"_30211":858,"_20923":51984,"_5":14374,"_27449":51954,"_2949":51985},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3465":871,"_30211":858,"_20923":51987,"_5":14374,"_27449":51958,"_2949":51988},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3465":872,"_30211":858,"_20923":51990,"_5":14374,"_27449":51958,"_2949":51991},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3465":873,"_30211":858,"_20923":51993,"_5":14374,"_27449":51962,"_2949":51994},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3465":874,"_30211":858,"_20923":51996,"_5":14374,"_27449":51962,"_2949":51997},[],"Example body:",{"_3465":875,"_30211":858,"_20923":51999,"_5":14374,"_27449":51962,"_2949":52000},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3465":876,"_30211":858,"_20923":52002,"_5":14374,"_27449":51962,"_2949":52003},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3465":877,"_30211":858,"_20923":52005,"_5":14374,"_27449":51962,"_2949":52006},[],"Continuation requires a successful HTTP response and JSON:",{"_3465":878,"_30211":858,"_20923":52008,"_5":14374,"_27449":51962,"_2949":52009},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3465":879,"_30211":858,"_20923":52011,"_5":14374,"_27449":51966,"_2949":52012},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3465":880,"_30211":858,"_20923":52014,"_5":14374,"_27449":51966,"_2949":52015},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3465":881,"_30211":881,"_5":14726,"_2949":52017,"_30563":52018,"_20923":52019,"_27449":881},"Configure and operate the DMS",[49273,50748,51762,51760,51943],[],{"_3465":882,"_30211":881,"_20923":52021,"_5":14374,"_27449":881,"_2949":52022},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3465":883,"_30211":881,"_5":30560,"_20923":52024,"_27449":52025,"_2949":49283},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3465":884,"_30211":881,"_5":30560,"_20923":52027,"_27449":52028,"_2949":52029},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3465":885,"_30211":881,"_5":30560,"_20923":52031,"_27449":52032,"_2949":52033},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3465":886,"_30211":881,"_5":30560,"_20923":52035,"_27449":52036,"_2949":52037},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3465":887,"_30211":881,"_5":30560,"_20923":52039,"_27449":52040,"_2949":52041},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3465":888,"_30211":881,"_5":30560,"_20923":52043,"_27449":52044,"_2949":52045},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3465":889,"_30211":881,"_5":30560,"_20923":52047,"_27449":52048,"_2949":52049},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3465":890,"_30211":881,"_5":30560,"_20923":52051,"_27449":52052,"_2949":52053},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3465":891,"_30211":881,"_5":30560,"_20923":52055,"_27449":52056,"_2949":52057},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3465":892,"_30211":881,"_5":30560,"_20923":52059,"_27449":52060,"_2949":52061},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3465":893,"_30211":881,"_5":30560,"_20923":52063,"_27449":52064,"_2949":52065},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3465":894,"_30211":881,"_5":30560,"_20923":52067,"_27449":52068,"_2949":52069},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3465":895,"_30211":881,"_5":30560,"_20923":52071,"_27449":52072,"_2949":52073},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3465":896,"_30211":881,"_5":30560,"_20923":52075,"_27449":52076,"_2949":52077},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3465":897,"_30211":881,"_5":30560,"_20923":52079,"_27449":52080,"_2949":52081},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3465":898,"_30211":881,"_5":30560,"_20923":52083,"_27449":52084,"_2949":52085},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3465":899,"_30211":881,"_5":30560,"_20923":52087,"_27449":52088,"_2949":52089},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3465":900,"_30211":881,"_5":30560,"_20923":52091,"_27449":52092,"_2949":52093},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3465":901,"_30211":881,"_20923":52095,"_5":14374,"_27449":881,"_2949":52096},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3465":902,"_30211":881,"_20923":52098,"_5":14374,"_27449":52025,"_2949":52099},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3465":903,"_30211":881,"_20923":52101,"_5":14374,"_27449":52025,"_2949":52102},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3465":904,"_30211":881,"_20923":52104,"_5":14374,"_27449":52032,"_2949":52105},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3465":905,"_30211":881,"_20923":52107,"_5":14374,"_27449":52036,"_2949":52108},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3465":906,"_30211":881,"_20923":52110,"_5":14374,"_27449":52040,"_2949":52111},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3465":907,"_30211":881,"_20923":52113,"_5":14374,"_27449":52044,"_2949":52114},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3465":908,"_30211":881,"_20923":52116,"_5":14374,"_27449":52048,"_2949":52117},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3465":909,"_30211":881,"_20923":52119,"_5":14374,"_27449":52056,"_2949":52120},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3465":910,"_30211":881,"_20923":52122,"_5":14374,"_27449":52056,"_2949":52123},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3465":911,"_30211":881,"_20923":52125,"_5":14374,"_27449":52060,"_2949":52126},[],"`settings.enrollment_settings` field",{"_3465":912,"_30211":881,"_20923":52128,"_5":14374,"_27449":52060,"_2949":52129},[],"Decision",{"_3465":913,"_30211":881,"_20923":52131,"_5":14374,"_27449":52060,"_2949":52132},[],"`protocol`",{"_3465":914,"_30211":881,"_20923":52134,"_5":14374,"_27449":52060,"_2949":52135},[],"`EST_RFC7030` for these operations.",{"_3465":915,"_30211":881,"_20923":52137,"_5":14374,"_27449":52060,"_2949":52138},[],"`enrollment_ca`",{"_3465":916,"_30211":881,"_20923":52140,"_5":14374,"_27449":52060,"_2949":52141},[],"ID of the signing CA.",{"_3465":917,"_30211":881,"_20923":52143,"_5":14374,"_27449":52060,"_2949":52144},[],"`verify_csr_signature`",{"_3465":918,"_30211":881,"_20923":52146,"_5":14374,"_27449":52060,"_2949":52147},[],"Keep `true` to verify CSR key possession.",{"_3465":919,"_30211":881,"_20923":52149,"_5":14374,"_27449":52060,"_2949":52150},[],"`enable_replaceable_enrollment`",{"_3465":920,"_30211":881,"_20923":52152,"_5":14374,"_27449":52060,"_2949":52153},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3465":921,"_30211":881,"_20923":52155,"_5":14374,"_27449":52060,"_2949":52156},[],"`est_rfc7030_settings.auth_mode`",{"_3465":922,"_30211":881,"_20923":52158,"_5":14374,"_27449":52060,"_2949":52159},[],"One of the four authentication modes.",{"_3465":923,"_30211":881,"_20923":52161,"_5":14374,"_27449":52060,"_2949":52162},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3465":924,"_30211":881,"_20923":52164,"_5":14374,"_27449":52064,"_2949":52165},[],"The blocks are independent:",{"_3465":925,"_30211":881,"_20923":52167,"_5":14374,"_27449":52064,"_2949":52168},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3465":926,"_30211":881,"_20923":52170,"_5":14374,"_27449":52064,"_2949":52171},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3465":927,"_30211":881,"_20923":52173,"_5":14374,"_27449":52064,"_2949":52174},[],"`auth_mode`",{"_3465":928,"_30211":881,"_20923":52176,"_5":14374,"_27449":52064,"_2949":52177},[],"Control applied in the configured operation",{"_3465":929,"_30211":881,"_20923":52179,"_5":14374,"_27449":52064,"_2949":52180},[],"`CLIENT_CERTIFICATE`",{"_3465":930,"_30211":881,"_20923":52182,"_5":14374,"_27449":52064,"_2949":52183},[],"Presented certificate validation.",{"_3465":931,"_30211":881,"_20923":52185,"_5":14374,"_27449":52064,"_2949":52186},[],"`EXTERNAL_WEBHOOK`",{"_3465":932,"_30211":881,"_20923":52188,"_5":14374,"_27449":52064,"_2949":52189},[],"Configured webhook authorization.",{"_3465":933,"_30211":881,"_20923":52191,"_5":14374,"_27449":52064,"_2949":52192},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3465":934,"_30211":881,"_20923":52194,"_5":14374,"_27449":52064,"_2949":52195},[],"Certificate validation followed by webhook approval.",{"_3465":935,"_30211":881,"_20923":52197,"_5":14374,"_27449":52064,"_2949":52198},[],"`NO_AUTH`",{"_3465":936,"_30211":881,"_20923":52200,"_5":14374,"_27449":52064,"_2949":52201},[],"No DMS requester authentication.",{"_3465":937,"_30211":881,"_20923":52203,"_5":14374,"_27449":52064,"_2949":52204},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3465":938,"_30211":881,"_20923":52206,"_5":14374,"_27449":52064,"_2949":52207},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3465":939,"_30211":881,"_20923":52209,"_5":14374,"_27449":52064,"_2949":52210},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3465":940,"_30211":881,"_20923":52212,"_5":14374,"_27449":52064,"_2949":52213},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3465":941,"_30211":881,"_20923":52215,"_5":14374,"_27449":52068,"_2949":52216},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3465":942,"_30211":881,"_20923":52218,"_5":14374,"_27449":52068,"_2949":52219},[],"`external_webhook_settings` field",{"_3465":943,"_30211":881,"_20923":52221,"_5":14374,"_27449":52068,"_2949":52129},[],{"_3465":944,"_30211":881,"_20923":52223,"_5":14374,"_27449":52068,"_2949":52224},[],"`url`",{"_3465":945,"_30211":881,"_20923":52226,"_5":14374,"_27449":52068,"_2949":52227},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3465":946,"_30211":881,"_20923":52229,"_5":14374,"_27449":52068,"_2949":52230},[],"`method`",{"_3465":947,"_30211":881,"_20923":52232,"_5":14374,"_27449":52068,"_2949":52233},[],"`POST` or `PUT`; `POST` by default.",{"_3465":948,"_30211":881,"_20923":52235,"_5":14374,"_27449":52068,"_2949":52236},[],"`name`",{"_3465":949,"_30211":881,"_20923":52238,"_5":14374,"_27449":52068,"_2949":52239},[],"Label used in service logs.",{"_3465":950,"_30211":881,"_20923":52241,"_5":14374,"_27449":52068,"_2949":52242},[],"`config.auth_mode`",{"_3465":951,"_30211":881,"_20923":52244,"_5":14374,"_27449":52068,"_2949":52245},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3465":952,"_30211":881,"_20923":52247,"_5":14374,"_27449":52068,"_2949":52248},[],"`config.log_level`",{"_3465":953,"_30211":881,"_20923":52250,"_5":14374,"_27449":52068,"_2949":52251},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3465":954,"_30211":881,"_20923":52253,"_5":14374,"_27449":52068,"_2949":52254},[],"`config.apikey_options`",{"_3465":955,"_30211":881,"_20923":52256,"_5":14374,"_27449":52068,"_2949":52257},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3465":956,"_30211":881,"_20923":52259,"_5":14374,"_27449":52068,"_2949":52260},[],"`config.jwt_options`",{"_3465":957,"_30211":881,"_20923":52262,"_5":14374,"_27449":52068,"_2949":52263},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3465":958,"_30211":881,"_20923":52265,"_5":14374,"_27449":52068,"_2949":52266},[],"`config.mtls_options`",{"_3465":959,"_30211":881,"_20923":52268,"_5":14374,"_27449":52068,"_2949":52269},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3465":960,"_30211":881,"_20923":52271,"_5":14374,"_27449":52068,"_2949":52272},[],"`config.insecure_skip_verify`",{"_3465":961,"_30211":881,"_20923":52274,"_5":14374,"_27449":52068,"_2949":52275},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3465":962,"_30211":881,"_20923":52277,"_5":14374,"_27449":52068,"_2949":52278},[],"`config.call_timeout`",{"_3465":963,"_30211":881,"_20923":52280,"_5":14374,"_27449":52068,"_2949":52281},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3465":964,"_30211":881,"_20923":52283,"_5":14374,"_27449":52068,"_2949":52284},[],"Rules for that configuration:",{"_3465":965,"_30211":881,"_20923":52286,"_5":14374,"_27449":52068,"_2949":52287},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3465":966,"_30211":881,"_20923":52289,"_5":14374,"_27449":52068,"_2949":52290},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3465":967,"_30211":881,"_20923":52292,"_5":14374,"_27449":52068,"_2949":52293},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3465":968,"_30211":881,"_20923":52295,"_5":14374,"_27449":52068,"_2949":52296},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3465":969,"_30211":881,"_20923":52298,"_5":14374,"_27449":52068,"_2949":52299},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3465":970,"_30211":881,"_20923":52301,"_5":14374,"_27449":52068,"_2949":52302},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3465":971,"_30211":881,"_20923":52304,"_5":14374,"_27449":52068,"_2949":52305},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3465":972,"_30211":881,"_20923":52307,"_5":14374,"_27449":52068,"_2949":52308},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3465":973,"_30211":881,"_20923":52310,"_5":14374,"_27449":52068,"_2949":52311},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3465":974,"_30211":881,"_20923":52313,"_5":14374,"_27449":52072,"_2949":52314},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3465":975,"_30211":881,"_20923":52316,"_5":14374,"_27449":52076,"_2949":52317},[],"`settings.reenrollment_settings` field",{"_3465":976,"_30211":881,"_20923":52319,"_5":14374,"_27449":52076,"_2949":49663},[],{"_3465":977,"_30211":881,"_20923":52321,"_5":14374,"_27449":52076,"_2949":52322},[],"`reenrollment_delta`",{"_3465":978,"_30211":881,"_20923":52324,"_5":14374,"_27449":52076,"_2949":52325},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3465":979,"_30211":881,"_20923":52327,"_5":14374,"_27449":52076,"_2949":52328},[],"`preventive_delta`",{"_3465":980,"_30211":881,"_20923":52330,"_5":14374,"_27449":52076,"_2949":52331},[],"Preventive operational monitoring threshold.",{"_3465":981,"_30211":881,"_20923":52333,"_5":14374,"_27449":52076,"_2949":52334},[],"`critical_delta`",{"_3465":982,"_30211":881,"_20923":52336,"_5":14374,"_27449":52076,"_2949":52337},[],"Critical operational monitoring threshold.",{"_3465":983,"_30211":881,"_20923":52339,"_5":14374,"_27449":52076,"_2949":52340},[],"`enable_expired_renewal`",{"_3465":984,"_30211":881,"_20923":52342,"_5":14374,"_27449":52076,"_2949":52343},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3465":985,"_30211":881,"_20923":52345,"_5":14374,"_27449":52076,"_2949":52346},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3465":986,"_30211":881,"_20923":52348,"_5":14374,"_27449":52076,"_2949":52349},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3465":987,"_30211":881,"_20923":52351,"_5":14374,"_27449":52076,"_2949":52352},[],"`revoke_on_reenrollment`",{"_3465":988,"_30211":881,"_20923":52354,"_5":14374,"_27449":52076,"_2949":52355},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3465":989,"_30211":881,"_20923":52357,"_5":14374,"_27449":52076,"_2949":52358},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3465":990,"_30211":881,"_20923":52360,"_5":14374,"_27449":52080,"_2949":52361},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3465":991,"_30211":881,"_20923":52363,"_5":14374,"_27449":52084,"_2949":49657},[],{"_3465":992,"_30211":881,"_20923":52365,"_5":14374,"_27449":52084,"_2949":52366},[],"Published material",{"_3465":993,"_30211":881,"_20923":52368,"_5":14374,"_27449":52084,"_2949":52369},[],"**Include Lamassu System CA**",{"_3465":994,"_30211":881,"_20923":52371,"_5":14374,"_27449":52084,"_2949":52372},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3465":995,"_30211":881,"_20923":52374,"_5":14374,"_27449":52084,"_2949":52375},[],"**Include Enrollment CA**",{"_3465":996,"_30211":881,"_20923":52377,"_5":14374,"_27449":52084,"_2949":52378},[],"Selected issuing CA certificate.",{"_3465":997,"_30211":881,"_20923":52380,"_5":14374,"_27449":52084,"_2949":52381},[],"**Managed CAs**",{"_3465":998,"_30211":881,"_20923":52383,"_5":14374,"_27449":52084,"_2949":52384},[],"Explicitly selected CA certificates.",{"_3465":999,"_30211":881,"_20923":52386,"_5":14374,"_27449":52084,"_2949":52387},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3465":1000,"_30211":881,"_20923":52389,"_5":14374,"_27449":52088,"_2949":52390},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3465":1001,"_30211":881,"_20923":52392,"_5":14374,"_27449":52088,"_2949":52393},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3465":1002,"_30211":881,"_20923":52395,"_5":14374,"_27449":52088,"_2949":52396},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3465":1003,"_30211":881,"_20923":52398,"_5":14374,"_27449":52092,"_2949":52399},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3465":1004,"_30211":1004,"_5":14726,"_2949":52401,"_30563":52402,"_20923":52403,"_27449":1004},"Integrate the EST client",[49273,50748,51762,51760,51943],[],{"_3465":1005,"_30211":1004,"_20923":52405,"_5":14374,"_27449":1004,"_2949":52406},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3465":1006,"_30211":1004,"_5":30560,"_20923":52408,"_27449":52409,"_2949":49283},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3465":1007,"_30211":1004,"_5":30560,"_20923":52411,"_27449":52412,"_2949":52413},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3465":1008,"_30211":1004,"_5":30560,"_20923":52415,"_27449":52416,"_2949":52417},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3465":1009,"_30211":1004,"_5":30560,"_20923":52419,"_27449":52420,"_2949":52421},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3465":1010,"_30211":1004,"_5":30560,"_20923":52423,"_27449":52424,"_2949":52425},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3465":1011,"_30211":1004,"_5":30560,"_20923":52427,"_27449":52428,"_2949":52429},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3465":1012,"_30211":1004,"_20923":52431,"_5":14374,"_27449":1004,"_2949":52432},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3465":1013,"_30211":1004,"_20923":52434,"_5":14374,"_27449":52409,"_2949":52435},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3465":1014,"_30211":1004,"_20923":52437,"_5":14374,"_27449":52409,"_2949":52438},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3465":1015,"_30211":1004,"_20923":52440,"_5":14374,"_27449":52409,"_2949":52441},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3465":1016,"_30211":1004,"_20923":52443,"_5":14374,"_27449":52412,"_2949":52444},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3465":1017,"_30211":1004,"_20923":52446,"_5":14374,"_27449":52412,"_2949":52447},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3465":1018,"_30211":1004,"_20923":52449,"_5":14374,"_27449":52416,"_2949":52450},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3465":1019,"_30211":1004,"_20923":52452,"_5":14374,"_27449":52416,"_2949":52453},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3465":1020,"_30211":1004,"_20923":52455,"_5":14374,"_27449":52420,"_2949":52456},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3465":1021,"_30211":1004,"_20923":52458,"_5":14374,"_27449":52420,"_2949":52459},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3465":1022,"_30211":1004,"_20923":52461,"_5":14374,"_27449":52424,"_2949":52462},[],"For a root that issues directly:",{"_3465":1023,"_30211":1004,"_20923":52464,"_5":14374,"_27449":52424,"_2949":52465},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3465":1024,"_30211":1004,"_20923":52467,"_5":14374,"_27449":52424,"_2949":52468},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3465":1025,"_30211":1004,"_20923":52470,"_5":14374,"_27449":52428,"_2949":52471},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3465":1026,"_30211":1026,"_5":14726,"_2949":52473,"_30563":52474,"_20923":52475,"_27449":1026},"EST reference",[49273,50748,51762,51760,51943],[],{"_3465":1027,"_30211":1026,"_20923":52477,"_5":14374,"_27449":1026,"_2949":52478},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3465":1028,"_30211":1026,"_5":30560,"_20923":52480,"_27449":52481,"_2949":52482},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3465":1029,"_30211":1026,"_5":30560,"_20923":52484,"_27449":52485,"_2949":22685},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3465":1030,"_30211":1026,"_5":30560,"_20923":52487,"_27449":52488,"_2949":26052},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3465":1031,"_30211":1026,"_5":30560,"_20923":52490,"_27449":52491,"_2949":26059},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3465":1032,"_30211":1026,"_5":30560,"_20923":52493,"_27449":52494,"_2949":25378},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3465":1033,"_30211":1026,"_5":30560,"_20923":52496,"_27449":52497,"_2949":52498},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3465":1034,"_30211":1026,"_5":30560,"_20923":52500,"_27449":52501,"_2949":52502},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3465":1035,"_30211":1026,"_5":30560,"_20923":52504,"_27449":52505,"_2949":52506},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3465":1036,"_30211":1026,"_20923":52508,"_5":14374,"_27449":1026,"_2949":52509},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3465":1037,"_30211":1026,"_20923":52511,"_5":14374,"_27449":52481,"_2949":52512},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3465":1038,"_30211":1026,"_20923":52514,"_5":14374,"_27449":52481,"_2949":52515},[],"Operation",{"_3465":1039,"_30211":1026,"_20923":52517,"_5":14374,"_27449":52481,"_2949":52518},[],"Method",{"_3465":1040,"_30211":1026,"_20923":52520,"_5":14374,"_27449":52481,"_2949":52521},[],"Authentication and condition",{"_3465":1041,"_30211":1026,"_20923":52523,"_5":14374,"_27449":52481,"_2949":52524},[],"`/cacerts`",{"_3465":1042,"_30211":1026,"_20923":52526,"_5":14374,"_27449":52481,"_2949":52527},[],"GET",{"_3465":1043,"_30211":1026,"_20923":52529,"_5":14374,"_27449":52481,"_2949":52530},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3465":1044,"_30211":1026,"_20923":52532,"_5":14374,"_27449":52481,"_2949":52533},[],"`/simpleenroll`",{"_3465":1045,"_30211":1026,"_20923":52535,"_5":14374,"_27449":52481,"_2949":52536},[],"POST",{"_3465":1046,"_30211":1026,"_20923":52538,"_5":14374,"_27449":52481,"_2949":52539},[],"Initial authentication and DMS registration/replacement policy.",{"_3465":1047,"_30211":1026,"_20923":52541,"_5":14374,"_27449":52481,"_2949":52542},[],"`/simplereenroll`",{"_3465":1048,"_30211":1026,"_20923":52544,"_5":14374,"_27449":52481,"_2949":52536},[],{"_3465":1049,"_30211":1026,"_20923":52546,"_5":14374,"_27449":52481,"_2949":52547},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3465":1050,"_30211":1026,"_20923":52549,"_5":14374,"_27449":52481,"_2949":52550},[],"`/serverkeygen`",{"_3465":1051,"_30211":1026,"_20923":52552,"_5":14374,"_27449":52481,"_2949":52536},[],{"_3465":1052,"_30211":1026,"_20923":52554,"_5":14374,"_27449":52481,"_2949":52555},[],"Initial authentication and admission; server generation enabled.",{"_3465":1053,"_30211":1026,"_20923":52557,"_5":14374,"_27449":52481,"_2949":52558},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3465":1054,"_30211":1026,"_20923":52560,"_5":14374,"_27449":52485,"_2949":52561},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3465":1055,"_30211":1026,"_20923":52563,"_5":14374,"_27449":52485,"_2949":52564},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3465":1056,"_30211":1026,"_20923":52566,"_5":14374,"_27449":52488,"_2949":52567},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3465":1057,"_30211":1026,"_20923":52569,"_5":14374,"_27449":52488,"_2949":52570},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3465":1058,"_30211":1026,"_20923":52572,"_5":14374,"_27449":52491,"_2949":52573},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3465":1059,"_30211":1026,"_20923":52575,"_5":14374,"_27449":52491,"_2949":52576},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3465":1060,"_30211":1026,"_20923":52578,"_5":14374,"_27449":52494,"_2949":52579},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3465":1061,"_30211":1026,"_20923":52581,"_5":14374,"_27449":52494,"_2949":52582},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3465":1062,"_30211":1026,"_20923":52584,"_5":14374,"_27449":52497,"_2949":52585},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3465":1063,"_30211":1026,"_20923":52587,"_5":14374,"_27449":52497,"_2949":52588},[],"Part",{"_3465":1064,"_30211":1026,"_20923":52590,"_5":14374,"_27449":52497,"_2949":52591},[],"Content after decoding its Base64",{"_3465":1065,"_30211":1026,"_20923":52593,"_5":14374,"_27449":52497,"_2949":52594},[],"`application/pkcs8`",{"_3465":1066,"_30211":1026,"_20923":52596,"_5":14374,"_27449":52497,"_2949":52597},[],"Unencrypted DER PKCS#8 private key.",{"_3465":1067,"_30211":1026,"_20923":52599,"_5":14374,"_27449":52497,"_2949":52600},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3465":1068,"_30211":1026,"_20923":52602,"_5":14374,"_27449":52497,"_2949":52603},[],"DER PKCS#7 containing the issued certificate.",{"_3465":1069,"_30211":1026,"_20923":52605,"_5":14374,"_27449":52497,"_2949":52606},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3465":1070,"_30211":1026,"_20923":52608,"_5":14374,"_27449":52501,"_2949":52609},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3465":1071,"_30211":1026,"_20923":52611,"_5":14374,"_27449":52501,"_2949":52612},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3465":1072,"_30211":1026,"_20923":52614,"_5":14374,"_27449":52501,"_2949":52615},[],"Convert and check the result:",{"_3465":1073,"_30211":1026,"_20923":52617,"_5":14374,"_27449":52501,"_2949":52618},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3465":1074,"_30211":1026,"_20923":52620,"_5":14374,"_27449":52505,"_2949":52621},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3465":1075,"_30211":1026,"_20923":52623,"_5":14374,"_27449":52505,"_2949":52624},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3465":1076,"_30211":1076,"_5":14726,"_2949":51943,"_30563":52626,"_20923":52627,"_27449":1076},[49273,50748,51762,51760,51943],[],{"_3465":1077,"_30211":1076,"_20923":52629,"_5":14374,"_27449":1076,"_2949":52630},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3465":1078,"_30211":1076,"_5":30560,"_20923":52632,"_27449":52633,"_2949":52634},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3465":1079,"_30211":1076,"_5":30560,"_20923":52636,"_27449":52637,"_2949":52638},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3465":1080,"_30211":1076,"_5":30560,"_20923":52640,"_27449":52641,"_2949":52642},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3465":1081,"_30211":1076,"_5":30560,"_20923":52644,"_27449":52645,"_2949":52646},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3465":1082,"_30211":1076,"_20923":52648,"_5":14374,"_27449":1076,"_2949":52649},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3465":1083,"_30211":1076,"_20923":52651,"_5":14374,"_27449":52633,"_2949":52652},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3465":1084,"_30211":1076,"_20923":52654,"_5":14374,"_27449":52633,"_2949":52655},[],"The integrator installs initial EST server trust and an admission credential.",{"_3465":1085,"_30211":1076,"_20923":52657,"_5":14374,"_27449":52633,"_2949":52658},[],"The client requests an identity for its `Device ID` through EST.",{"_3465":1086,"_30211":1076,"_20923":52660,"_5":14374,"_27449":52633,"_2949":52661},[],"Certificate, device binding and key/certificate installation are checked.",{"_3465":1087,"_30211":1076,"_20923":52663,"_5":14374,"_27449":52633,"_2949":52664},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3465":1088,"_30211":1076,"_20923":52666,"_5":14374,"_27449":52633,"_2949":52667},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3465":1089,"_30211":1076,"_20923":52669,"_5":14374,"_27449":52637,"_2949":52670},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3465":1090,"_30211":1076,"_20923":52672,"_5":14374,"_27449":52637,"_2949":52673},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":1091,"_30211":1076,"_20923":52675,"_5":14374,"_27449":52637,"_2949":52676},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3465":1092,"_30211":1076,"_20923":52678,"_5":14374,"_27449":52637,"_2949":52679},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3465":1093,"_30211":1076,"_20923":52681,"_5":14374,"_27449":52641,"_2949":52682},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3465":1094,"_30211":1076,"_20923":52684,"_5":14374,"_27449":52641,"_2949":52685},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3465":1095,"_30211":1076,"_20923":52687,"_5":14374,"_27449":52641,"_2949":52688},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3465":1096,"_30211":1076,"_20923":52690,"_5":14374,"_27449":52641,"_2949":52691},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3465":1097,"_30211":1076,"_20923":52693,"_5":14374,"_27449":52645,"_2949":52694},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3465":1098,"_30211":1076,"_20923":52696,"_5":14374,"_27449":52645,"_2949":52697},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3465":1099,"_30211":1099,"_5":14726,"_2949":52699,"_30563":52700,"_20923":52701,"_27449":1099},"Provisioning strategies",[49273,50748,51762,51760,51943],[],{"_3465":1100,"_30211":1099,"_20923":52703,"_5":14374,"_27449":1099,"_2949":52704},[],"Choose device registration, identity authorization and key generation.",{"_3465":1101,"_30211":1099,"_5":30560,"_20923":52706,"_27449":52707,"_2949":52708},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3465":1102,"_30211":1099,"_5":30560,"_20923":52710,"_27449":52711,"_2949":52712},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3465":1103,"_30211":1099,"_5":30560,"_20923":52714,"_27449":52715,"_2949":52716},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3465":1104,"_30211":1099,"_5":30560,"_20923":52718,"_27449":52719,"_2949":52720},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3465":1105,"_30211":1099,"_5":30560,"_20923":52722,"_27449":52723,"_2949":52724},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3465":1106,"_30211":1099,"_20923":52726,"_5":14374,"_27449":1099,"_2949":52727},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3465":1107,"_30211":1099,"_20923":52729,"_5":14374,"_27449":52707,"_2949":52730},[],"Path",{"_3465":1108,"_30211":1099,"_20923":52732,"_5":14374,"_27449":52707,"_2949":52733},[],"When the device exists",{"_3465":1109,"_30211":1099,"_20923":52735,"_5":14374,"_27449":52707,"_2949":52736},[],"What to check",{"_3465":1110,"_30211":1099,"_20923":52738,"_5":14374,"_27449":52707,"_2949":52739},[],"Manual assignment",{"_3465":1111,"_30211":1099,"_20923":52741,"_5":14374,"_27449":52707,"_2949":52742},[],"An operator creates it before associating a certificate.",{"_3465":1112,"_30211":1099,"_20923":52744,"_5":14374,"_27449":52707,"_2949":52745},[],"ID, owning DMS, certificate CN and bound serial.",{"_3465":1113,"_30211":1099,"_20923":52747,"_5":14374,"_27449":52707,"_2949":52748},[],"EST with `JITP`",{"_3465":1114,"_30211":1099,"_20923":52750,"_5":14374,"_27449":52707,"_2949":52751},[],"Created for an unknown CN during `/simpleenroll`.",{"_3465":1115,"_30211":1099,"_20923":52753,"_5":14374,"_27449":52707,"_2949":52754},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3465":1116,"_30211":1099,"_20923":52756,"_5":14374,"_27449":52707,"_2949":52757},[],"EST with `PRE_REGISTRATION`",{"_3465":1117,"_30211":1099,"_20923":52759,"_5":14374,"_27449":52707,"_2949":52760},[],"Must exist before `/simpleenroll`.",{"_3465":1118,"_30211":1099,"_20923":52762,"_5":14374,"_27449":52707,"_2949":52763},[],"Approved record, same DMS and replacement conditions for your version.",{"_3465":1119,"_30211":1099,"_20923":52765,"_5":14374,"_27449":52707,"_2949":52766},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3465":1120,"_30211":1099,"_20923":52768,"_5":14374,"_27449":52707,"_2949":52769},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3465":1121,"_30211":1099,"_20923":52771,"_5":14374,"_27449":52711,"_2949":52772},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3465":1122,"_30211":1099,"_20923":52774,"_5":14374,"_27449":52711,"_2949":52775},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3465":1123,"_30211":1099,"_20923":52777,"_5":14374,"_27449":52711,"_2949":52778},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3465":1124,"_30211":1099,"_20923":52780,"_5":14374,"_27449":52715,"_2949":52781},[],"Decide initial enrollment and re-enrollment separately:",{"_3465":1125,"_30211":1099,"_20923":52783,"_5":14374,"_27449":52715,"_2949":52784},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3465":1126,"_30211":1099,"_20923":52786,"_5":14374,"_27449":52715,"_2949":52787},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3465":1127,"_30211":1099,"_20923":52789,"_5":14374,"_27449":52715,"_2949":52790},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3465":1128,"_30211":1099,"_20923":52792,"_5":14374,"_27449":52715,"_2949":52793},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3465":1129,"_30211":1099,"_20923":52795,"_5":14374,"_27449":52715,"_2949":52796},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3465":1130,"_30211":1099,"_20923":52798,"_5":14374,"_27449":52719,"_2949":49657},[],{"_3465":1131,"_30211":1099,"_20923":52800,"_5":14374,"_27449":52719,"_2949":52801},[],"Material crossing EST",{"_3465":1132,"_30211":1099,"_20923":52803,"_5":14374,"_27449":52719,"_2949":52804},[],"Device-generated key",{"_3465":1133,"_30211":1099,"_20923":52806,"_5":14374,"_27449":52719,"_2949":52807},[],"Public CSR and certificate; the key stays on the client.",{"_3465":1134,"_30211":1099,"_20923":52809,"_5":14374,"_27449":52719,"_2949":52810},[],"Existing device key",{"_3465":1135,"_30211":1099,"_20923":52812,"_5":14374,"_27449":52719,"_2949":52813},[],"CSR signed with that key and a new certificate.",{"_3465":1136,"_30211":1099,"_20923":52815,"_5":14374,"_27449":52719,"_2949":52081},[],{"_3465":1137,"_30211":1099,"_20923":52817,"_5":14374,"_27449":52719,"_2949":52818},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3465":1138,"_30211":1099,"_20923":52820,"_5":14374,"_27449":52719,"_2949":52821},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3465":1139,"_30211":1099,"_20923":52823,"_5":14374,"_27449":52723,"_2949":52824},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3465":1140,"_30211":1140,"_5":14726,"_2949":52826,"_30563":52827,"_20923":52828,"_27449":1140},"Renewal and recovery",[49273,50748,51762,51760,51943],[],{"_3465":1141,"_30211":1140,"_20923":52830,"_5":14374,"_27449":1140,"_2949":52831},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3465":1142,"_30211":1140,"_5":30560,"_20923":52833,"_27449":52834,"_2949":52835},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3465":1143,"_30211":1140,"_5":30560,"_20923":52837,"_27449":52838,"_2949":52839},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3465":1144,"_30211":1140,"_5":30560,"_20923":52841,"_27449":52842,"_2949":52843},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3465":1145,"_30211":1140,"_5":30560,"_20923":52845,"_27449":52846,"_2949":52847},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3465":1146,"_30211":1140,"_5":30560,"_20923":52849,"_27449":52850,"_2949":52851},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3465":1147,"_30211":1140,"_20923":52853,"_5":14374,"_27449":1140,"_2949":52854},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3465":1148,"_30211":1140,"_20923":52856,"_5":14374,"_27449":52834,"_2949":52857},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3465":1149,"_30211":1140,"_20923":52859,"_5":14374,"_27449":52834,"_2949":52860},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3465":1150,"_30211":1140,"_20923":52862,"_5":14374,"_27449":52834,"_2949":52863},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3465":1151,"_30211":1140,"_20923":52865,"_5":14374,"_27449":52834,"_2949":52866},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3465":1152,"_30211":1140,"_20923":52868,"_5":14374,"_27449":52838,"_2949":52869},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3465":1153,"_30211":1140,"_20923":52871,"_5":14374,"_27449":52838,"_2949":52872},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3465":1154,"_30211":1140,"_20923":52874,"_5":14374,"_27449":52842,"_2949":52875},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3465":1155,"_30211":1140,"_20923":52877,"_5":14374,"_27449":52842,"_2949":52878},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3465":1156,"_30211":1140,"_20923":52880,"_5":14374,"_27449":52842,"_2949":52881},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3465":1157,"_30211":1140,"_20923":52883,"_5":14374,"_27449":52846,"_2949":52884},[],"Situation",{"_3465":1158,"_30211":1140,"_20923":52886,"_5":14374,"_27449":52846,"_2949":52887},[],"Procedure",{"_3465":1159,"_30211":1140,"_20923":52889,"_5":14374,"_27449":52846,"_2949":52890},[],"Valid certificate, outside the window",{"_3465":1160,"_30211":1140,"_20923":52892,"_5":14374,"_27449":52846,"_2949":52893},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3465":1161,"_30211":1140,"_20923":52895,"_5":14374,"_27449":52846,"_2949":52896},[],"Expired certificate, key available",{"_3465":1162,"_30211":1140,"_20923":52898,"_5":14374,"_27449":52846,"_2949":52899},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3465":1163,"_30211":1140,"_20923":52901,"_5":14374,"_27449":52846,"_2949":52902},[],"Renewal through webhook or `NO_AUTH`",{"_3465":1164,"_30211":1140,"_20923":52904,"_5":14374,"_27449":52846,"_2949":52905},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3465":1165,"_30211":1140,"_20923":52907,"_5":14374,"_27449":52846,"_2949":52908},[],"Lost or inaccessible key",{"_3465":1166,"_30211":1140,"_20923":52910,"_5":14374,"_27449":52846,"_2949":52911},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3465":1167,"_30211":1140,"_20923":52913,"_5":14374,"_27449":52846,"_2949":52914},[],"Current identity revoked",{"_3465":1168,"_30211":1140,"_20923":52916,"_5":14374,"_27449":52846,"_2949":52917},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3465":1169,"_30211":1140,"_20923":52919,"_5":14374,"_27449":52846,"_2949":52920},[],"Device without an identity",{"_3465":1170,"_30211":1140,"_20923":52922,"_5":14374,"_27449":52846,"_2949":52923},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3465":1171,"_30211":1140,"_20923":52925,"_5":14374,"_27449":52846,"_2949":52926},[],"Retired device",{"_3465":1172,"_30211":1140,"_20923":52928,"_5":14374,"_27449":52846,"_2949":52929},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3465":1173,"_30211":1140,"_20923":52931,"_5":14374,"_27449":52846,"_2949":52932},[],"Timeout, HTTP 500 or installation failure",{"_3465":1174,"_30211":1140,"_20923":52934,"_5":14374,"_27449":52846,"_2949":52935},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3465":1175,"_30211":1140,"_20923":52937,"_5":14374,"_27449":52850,"_2949":52938},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3465":1176,"_30211":1140,"_20923":52940,"_5":14374,"_27449":52850,"_2949":52941},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3465":1177,"_30211":1177,"_5":14726,"_2949":52943,"_30563":52944,"_20923":52945,"_27449":1177},"Enrollment troubleshooting",[49273,50748,51762,51760,51943],[],{"_3465":1178,"_30211":1177,"_20923":52947,"_5":14374,"_27449":1177,"_2949":52948},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3465":1179,"_30211":1177,"_5":30560,"_20923":52950,"_27449":52951,"_2949":52952},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3465":1180,"_30211":1177,"_5":30560,"_20923":52954,"_27449":52955,"_2949":52956},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3465":1181,"_30211":1177,"_5":30560,"_20923":52958,"_27449":52959,"_2949":52506},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3465":1182,"_30211":1177,"_5":30560,"_20923":52961,"_27449":52962,"_2949":52963},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3465":1183,"_30211":1177,"_20923":52965,"_5":14374,"_27449":1177,"_2949":52966},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3465":1184,"_30211":1177,"_20923":52968,"_5":14374,"_27449":52955,"_2949":52969},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3465":1185,"_30211":1177,"_20923":52971,"_5":14374,"_27449":52955,"_2949":52972},[],"Symptom or message",{"_3465":1186,"_30211":1177,"_20923":52974,"_5":14374,"_27449":52955,"_2949":52736},[],{"_3465":1187,"_30211":1177,"_20923":52976,"_5":14374,"_27449":52955,"_2949":52977},[],"curl rejects TLS, name or issuer",{"_3465":1188,"_30211":1177,"_20923":52979,"_5":14374,"_27449":52955,"_2949":52980},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3465":1189,"_30211":1177,"_20923":52982,"_5":14374,"_27449":52955,"_2949":52983},[],"404 or missing APS",{"_3465":1190,"_30211":1177,"_20923":52985,"_5":14374,"_27449":52955,"_2949":52986},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3465":1191,"_30211":1177,"_20923":52988,"_5":14374,"_27449":52955,"_2949":52989},[],"400, CSR or format error",{"_3465":1192,"_30211":1177,"_20923":52991,"_5":14374,"_27449":52955,"_2949":52992},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3465":1193,"_30211":1177,"_20923":52994,"_5":14374,"_27449":52955,"_2949":52995},[],"Missing credential or invalid certificate",{"_3465":1194,"_30211":1177,"_20923":52997,"_5":14374,"_27449":52955,"_2949":52998},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3465":1195,"_30211":1177,"_20923":53000,"_5":14374,"_27449":52955,"_2949":53001},[],"Webhook denies, times out or responds without authorization",{"_3465":1196,"_30211":1177,"_20923":53003,"_5":14374,"_27449":52955,"_2949":53004},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3465":1197,"_30211":1177,"_20923":53006,"_5":14374,"_27449":52955,"_2949":53007},[],"`unexpected status code: <n>: redirects are not followed`",{"_3465":1198,"_30211":1177,"_20923":53009,"_5":14374,"_27449":52955,"_2949":53010},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3465":1199,"_30211":1177,"_20923":53012,"_5":14374,"_27449":52955,"_2949":53013},[],"`webhook response exceeds 1048576 bytes`",{"_3465":1200,"_30211":1177,"_20923":53015,"_5":14374,"_27449":52955,"_2949":53016},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3465":1201,"_30211":1177,"_20923":53018,"_5":14374,"_27449":52955,"_2949":53019},[],"`webhook config must not reference files`",{"_3465":1202,"_30211":1177,"_20923":53021,"_5":14374,"_27449":52955,"_2949":53022},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3465":1203,"_30211":1177,"_20923":53024,"_5":14374,"_27449":52955,"_2949":53025},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3465":1204,"_30211":1177,"_20923":53027,"_5":14374,"_27449":52955,"_2949":53028},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3465":1205,"_30211":1177,"_20923":53030,"_5":14374,"_27449":52955,"_2949":53031},[],"`webhook mTLS certificate and key are invalid: …`",{"_3465":1206,"_30211":1177,"_20923":53033,"_5":14374,"_27449":52955,"_2949":53034},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3465":1207,"_30211":1177,"_20923":53036,"_5":14374,"_27449":52955,"_2949":53037},[],"400 `struct validation error` creating or updating a DMS",{"_3465":1208,"_30211":1177,"_20923":53039,"_5":14374,"_27449":52955,"_2949":53040},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3465":1209,"_30211":1177,"_20923":53042,"_5":14374,"_27449":52955,"_2949":53043},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3465":1210,"_30211":1177,"_20923":53045,"_5":14374,"_27449":52955,"_2949":53046},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3465":1211,"_30211":1177,"_20923":53048,"_5":14374,"_27449":52955,"_2949":53049},[],"`device not preregistered`",{"_3465":1212,"_30211":1177,"_20923":53051,"_5":14374,"_27449":52955,"_2949":53052},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3465":1213,"_30211":1177,"_20923":53054,"_5":14374,"_27449":52955,"_2949":53055},[],"`forbiddenNewEnrollment`",{"_3465":1214,"_30211":1177,"_20923":53057,"_5":14374,"_27449":52955,"_2949":53058},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3465":1215,"_30211":1177,"_20923":53060,"_5":14374,"_27449":52955,"_2949":53061},[],"Different owning DMS",{"_3465":1216,"_30211":1177,"_20923":53063,"_5":14374,"_27449":52955,"_2949":53064},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3465":1217,"_30211":1177,"_20923":53066,"_5":14374,"_27449":52955,"_2949":53067},[],"`invalid RawSubject bytes`",{"_3465":1218,"_30211":1177,"_20923":53069,"_5":14374,"_27449":52955,"_2949":53070},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3465":1219,"_30211":1177,"_20923":53072,"_5":14374,"_27449":52955,"_2949":53073},[],"`invalid reenroll window`",{"_3465":1220,"_30211":1177,"_20923":53075,"_5":14374,"_27449":52955,"_2949":53076},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3465":1221,"_30211":1177,"_20923":53078,"_5":14374,"_27449":52955,"_2949":53079},[],"Current certificate revoked",{"_3465":1222,"_30211":1177,"_20923":53081,"_5":14374,"_27449":52955,"_2949":53082},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3465":1223,"_30211":1177,"_20923":53084,"_5":14374,"_27449":52955,"_2949":53085},[],"CA, profile or signing error",{"_3465":1224,"_30211":1177,"_20923":53087,"_5":14374,"_27449":52955,"_2949":53088},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3465":1225,"_30211":1177,"_20923":53090,"_5":14374,"_27449":52955,"_2949":53091},[],"HTTP 200 without a device connection",{"_3465":1226,"_30211":1177,"_20923":53093,"_5":14374,"_27449":52955,"_2949":53094},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3465":1227,"_30211":1177,"_20923":53096,"_5":14374,"_27449":52955,"_2949":53097},[],"Timeout or error after issuance",{"_3465":1228,"_30211":1177,"_20923":53099,"_5":14374,"_27449":52955,"_2949":53100},[],"New certificates, current slot and previous identity's state before retrying.",{"_3465":1229,"_30211":1177,"_20923":53102,"_5":14374,"_27449":52959,"_2949":53103},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3465":1230,"_30211":1177,"_20923":53105,"_5":14374,"_27449":52959,"_2949":53106},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3465":1231,"_30211":1177,"_20923":53108,"_5":14374,"_27449":52962,"_2949":53109},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3465":1232,"_30211":1177,"_20923":53111,"_5":14374,"_27449":52962,"_2949":53112},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3465":1233,"_30211":1177,"_20923":53114,"_5":14374,"_27449":52962,"_2949":53115},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3465":1234,"_30211":1177,"_20923":53117,"_5":14374,"_27449":52962,"_2949":53118},[],"Make one request, save headers/body and query the device and certificates.",{"_3465":1235,"_30211":1177,"_20923":53120,"_5":14374,"_27449":52962,"_2949":53121},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3465":1236,"_30211":1177,"_20923":53123,"_5":14374,"_27449":52962,"_2949":53124},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3465":1237,"_30211":1177,"_20923":53126,"_5":14374,"_27449":52962,"_2949":53127},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3465":1238,"_30211":1238,"_5":14726,"_2949":53129,"_30563":53130,"_20923":53131,"_27449":1238},"Trust distribution and updates",[49273,50748,51762,51760,51943],[],{"_3465":1239,"_30211":1238,"_20923":53133,"_5":14374,"_27449":1238,"_2949":53134},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3465":1240,"_30211":1238,"_5":30560,"_20923":53136,"_27449":53137,"_2949":53138},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3465":1241,"_30211":1238,"_5":30560,"_20923":53140,"_27449":53141,"_2949":53142},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3465":1242,"_30211":1238,"_5":30560,"_20923":53144,"_27449":53145,"_2949":53146},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3465":1243,"_30211":1238,"_5":30560,"_20923":53148,"_27449":53149,"_2949":53150},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3465":1244,"_30211":1238,"_5":30560,"_20923":53152,"_27449":53153,"_2949":53154},[],"/docs/pr-preview/pr-67/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3465":1245,"_30211":1238,"_20923":53156,"_5":14374,"_27449":1238,"_2949":53157},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3465":1246,"_30211":1238,"_20923":53159,"_5":14374,"_27449":53137,"_2949":53160},[],"Relationship",{"_3465":1247,"_30211":1238,"_20923":53162,"_5":14374,"_27449":53137,"_2949":53163},[],"Material prepared by its owner",{"_3465":1248,"_30211":1238,"_20923":53165,"_5":14374,"_27449":53137,"_2949":53166},[],"Device → EST server",{"_3465":1249,"_30211":1238,"_20923":53168,"_5":14374,"_27449":53137,"_2949":53169},[],"Previously verified server root, chain or pin and TLS name.",{"_3465":1250,"_30211":1238,"_20923":53171,"_5":14374,"_27449":53137,"_2949":53172},[],"DMS → requester",{"_3465":1251,"_30211":1238,"_20923":53174,"_5":14374,"_27449":53137,"_2949":53175},[],"CAs and rules authorizing initial or renewal credentials.",{"_3465":1252,"_30211":1238,"_20923":53177,"_5":14374,"_27449":53137,"_2949":53178},[],"Consumer → device",{"_3465":1253,"_30211":1238,"_20923":53180,"_5":14374,"_27449":53137,"_2949":53181},[],"Operational identity roots, intermediates, validation and permissions.",{"_3465":1254,"_30211":1238,"_20923":53183,"_5":14374,"_27449":53137,"_2949":53184},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3465":1255,"_30211":1238,"_20923":53186,"_5":14374,"_27449":53141,"_2949":53187},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3465":1256,"_30211":1238,"_20923":53189,"_5":14374,"_27449":53141,"_2949":53190},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3465":1257,"_30211":1238,"_20923":53192,"_5":14374,"_27449":53145,"_2949":53193},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3465":1258,"_30211":1238,"_20923":53195,"_5":14374,"_27449":53145,"_2949":53196},[],"Select policy-approved roots as anchors.",{"_3465":1259,"_30211":1238,"_20923":53198,"_5":14374,"_27449":53145,"_2949":53199},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3465":1260,"_30211":1238,"_20923":53201,"_5":14374,"_27449":53145,"_2949":53202},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3465":1261,"_30211":1238,"_20923":53204,"_5":14374,"_27449":53145,"_2949":53205},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3465":1262,"_30211":1238,"_20923":53207,"_5":14374,"_27449":53145,"_2949":53208},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3465":1263,"_30211":1238,"_20923":53210,"_5":14374,"_27449":53149,"_2949":53211},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3465":1264,"_30211":1238,"_20923":53213,"_5":14374,"_27449":53149,"_2949":53214},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3465":1265,"_30211":1238,"_20923":53216,"_5":14374,"_27449":53149,"_2949":53217},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3465":1266,"_30211":1238,"_20923":53219,"_5":14374,"_27449":53153,"_2949":53220},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3465":1267,"_30211":1267,"_5":14726,"_2949":53222,"_30563":53223,"_20923":53225,"_27449":1267},"AWS IoT Core",[49273,50748,51762,51760,53224],"Integrations",[],{"_3465":1268,"_30211":1267,"_20923":53227,"_5":14374,"_27449":1267,"_2949":53228},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3465":1269,"_30211":1267,"_5":30560,"_20923":53230,"_27449":53231,"_2949":53232},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3465":1270,"_30211":1267,"_5":30560,"_20923":53234,"_27449":53235,"_2949":53236},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3465":1271,"_30211":1267,"_5":30560,"_20923":53238,"_27449":53239,"_2949":53240},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3465":1272,"_30211":1267,"_5":30560,"_20923":53242,"_27449":53243,"_2949":53244},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3465":1273,"_30211":1267,"_5":30560,"_20923":53246,"_27449":53247,"_2949":53248},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3465":1274,"_30211":1267,"_5":30560,"_20923":53250,"_27449":53251,"_2949":53252},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3465":1275,"_30211":1267,"_5":30560,"_20923":53254,"_27449":53255,"_2949":53256},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3465":1276,"_30211":1267,"_5":30560,"_20923":53258,"_27449":53259,"_2949":53260},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3465":1277,"_30211":1267,"_5":30560,"_20923":53262,"_27449":53263,"_2949":53264},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3465":1278,"_30211":1267,"_5":30560,"_20923":53266,"_27449":53267,"_2949":53268},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3465":1279,"_30211":1267,"_5":30560,"_20923":53270,"_27449":53271,"_2949":53272},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3465":1280,"_30211":1267,"_5":30560,"_20923":53274,"_27449":53275,"_2949":53276},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3465":1281,"_30211":1267,"_5":30560,"_20923":53278,"_27449":53279,"_2949":53280},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3465":1282,"_30211":1267,"_5":30560,"_20923":53282,"_27449":53283,"_2949":53284},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3465":1283,"_30211":1267,"_5":30560,"_20923":53286,"_27449":53287,"_2949":53288},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3465":1284,"_30211":1267,"_5":30560,"_20923":53290,"_27449":53291,"_2949":53292},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3465":1285,"_30211":1267,"_5":30560,"_20923":53294,"_27449":53295,"_2949":53296},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3465":1286,"_30211":1267,"_5":30560,"_20923":53298,"_27449":53299,"_2949":53300},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3465":1287,"_30211":1267,"_5":30560,"_20923":53302,"_27449":53303,"_2949":53304},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3465":1288,"_30211":1267,"_5":30560,"_20923":53306,"_27449":53307,"_2949":53308},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3465":1289,"_30211":1267,"_5":30560,"_20923":53310,"_27449":53311,"_2949":53312},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3465":1290,"_30211":1267,"_5":30560,"_20923":53314,"_27449":53315,"_2949":53316},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3465":1291,"_30211":1267,"_5":30560,"_20923":53318,"_27449":53319,"_2949":53320},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3465":1292,"_30211":1267,"_5":30560,"_20923":53322,"_27449":53323,"_2949":53324},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3465":1293,"_30211":1267,"_5":30560,"_20923":53326,"_27449":53327,"_2949":53328},[],"/docs/pr-preview/pr-67/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3465":1294,"_30211":1267,"_20923":53330,"_5":14374,"_27449":1267,"_2949":53331},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3465":1295,"_30211":1267,"_20923":53333,"_5":14374,"_27449":1267,"_2949":53334},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3465":1296,"_30211":1267,"_20923":53336,"_5":14374,"_27449":1267,"_2949":53337},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3465":1297,"_30211":1267,"_20923":53339,"_5":14374,"_27449":53231,"_2949":53340},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3465":1298,"_30211":1267,"_20923":53342,"_5":14374,"_27449":53231,"_2949":53343},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3465":1299,"_30211":1267,"_20923":53345,"_5":14374,"_27449":53231,"_2949":53346},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3465":1300,"_30211":1267,"_20923":53348,"_5":14374,"_27449":53231,"_2949":53349},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3465":1301,"_30211":1267,"_20923":53351,"_5":14374,"_27449":53235,"_2949":53352},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3465":1302,"_30211":1267,"_20923":53354,"_5":14374,"_27449":53239,"_2949":53355},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3465":1303,"_30211":1267,"_20923":53357,"_5":14374,"_27449":53239,"_2949":53358},[],"IAM action",{"_3465":1304,"_30211":1267,"_20923":53360,"_5":14374,"_27449":53239,"_2949":49663},[],{"_3465":1305,"_30211":1267,"_20923":53362,"_5":14374,"_27449":53239,"_2949":53363},[],"`iot:GetRegistrationCode`",{"_3465":1306,"_30211":1267,"_20923":53365,"_5":14374,"_27449":53239,"_2949":53366},[],"Obtain the verification code for CA registration in the Primary Account",{"_3465":1307,"_30211":1267,"_20923":53368,"_5":14374,"_27449":53239,"_2949":53369},[],"`iot:RegisterCACertificate`",{"_3465":1308,"_30211":1267,"_20923":53371,"_5":14374,"_27449":53239,"_2949":53372},[],"Register the CA in AWS IoT",{"_3465":1309,"_30211":1267,"_20923":53374,"_5":14374,"_27449":53239,"_2949":53375},[],"`iot:DescribeCACertificate`",{"_3465":1310,"_30211":1267,"_20923":53377,"_5":14374,"_27449":53239,"_2949":53378},[],"Check the CA registration status",{"_3465":1311,"_30211":1267,"_20923":53380,"_5":14374,"_27449":53239,"_2949":53381},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3465":1312,"_30211":1267,"_20923":53383,"_5":14374,"_27449":53239,"_2949":53384},[],"Create or update Things in IoT Core",{"_3465":1313,"_30211":1267,"_20923":53386,"_5":14374,"_27449":53239,"_2949":53387},[],"`iot:RegisterThing`",{"_3465":1314,"_30211":1267,"_20923":53389,"_5":14374,"_27449":53239,"_2949":53390},[],"Provision Things through a template",{"_3465":1315,"_30211":1267,"_20923":53392,"_5":14374,"_27449":53239,"_2949":53393},[],"`iot:RegisterCertificate`",{"_3465":1316,"_30211":1267,"_20923":53395,"_5":14374,"_27449":53239,"_2949":53396},[],"Register device certificates",{"_3465":1317,"_30211":1267,"_20923":53398,"_5":14374,"_27449":53239,"_2949":53399},[],"`iot:UpdateCertificate`",{"_3465":1318,"_30211":1267,"_20923":53401,"_5":14374,"_27449":53239,"_2949":53402},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3465":1319,"_30211":1267,"_20923":53404,"_5":14374,"_27449":53239,"_2949":53405},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3465":1320,"_30211":1267,"_20923":53407,"_5":14374,"_27449":53239,"_2949":53408},[],"Create and attach IoT policies",{"_3465":1321,"_30211":1267,"_20923":53410,"_5":14374,"_27449":53239,"_2949":53411},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3465":1322,"_30211":1267,"_20923":53413,"_5":14374,"_27449":53239,"_2949":53414},[],"Manage Thing groups",{"_3465":1323,"_30211":1267,"_20923":53416,"_5":14374,"_27449":53239,"_2949":53417},[],"`iot:CreateProvisioningTemplate`",{"_3465":1324,"_30211":1267,"_20923":53419,"_5":14374,"_27449":53239,"_2949":53420},[],"Create JITP templates",{"_3465":1325,"_30211":1267,"_20923":53422,"_5":14374,"_27449":53239,"_2949":53423},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3465":1326,"_30211":1267,"_20923":53425,"_5":14374,"_27449":53239,"_2949":53426},[],"Read and write the Device Shadow",{"_3465":1327,"_30211":1267,"_20923":53428,"_5":14374,"_27449":53239,"_2949":53429},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3465":1328,"_30211":1267,"_20923":53431,"_5":14374,"_27449":53243,"_2949":53432},[],"Parameter",{"_3465":1329,"_30211":1267,"_20923":53434,"_5":14374,"_27449":53243,"_2949":53435},[],"Type",{"_3465":1330,"_30211":1267,"_20923":53437,"_5":14374,"_27449":53243,"_2949":53438},[],"Required",{"_3465":1331,"_30211":1267,"_20923":53440,"_5":14374,"_27449":53243,"_2949":53441},[],"Description",{"_3465":1332,"_30211":1267,"_20923":53443,"_5":14374,"_27449":53243,"_2949":53444},[],"`connector_id`",{"_3465":1333,"_30211":1267,"_20923":53446,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1334,"_30211":1267,"_20923":53448,"_5":14374,"_27449":53243,"_2949":53449},[],"Yes",{"_3465":1335,"_30211":1267,"_20923":53451,"_5":14374,"_27449":53243,"_2949":53452},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3465":1336,"_30211":1267,"_20923":53454,"_5":14374,"_27449":53243,"_2949":53455},[],"`aws_config.region`",{"_3465":1337,"_30211":1267,"_20923":53457,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1338,"_30211":1267,"_20923":53459,"_5":14374,"_27449":53243,"_2949":53449},[],{"_3465":1339,"_30211":1267,"_20923":53461,"_5":14374,"_27449":53243,"_2949":53462},[],"AWS region where the connector operates.",{"_3465":1340,"_30211":1267,"_20923":53464,"_5":14374,"_27449":53243,"_2949":53465},[],"`aws_config.auth_method`",{"_3465":1341,"_30211":1267,"_20923":53467,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1342,"_30211":1267,"_20923":53469,"_5":14374,"_27449":53243,"_2949":53449},[],{"_3465":1343,"_30211":1267,"_20923":53471,"_5":14374,"_27449":53243,"_2949":53472},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3465":1344,"_30211":1267,"_20923":53474,"_5":14374,"_27449":53243,"_2949":53475},[],"`aws_config.access_key_id`",{"_3465":1345,"_30211":1267,"_20923":53477,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1346,"_30211":1267,"_20923":53479,"_5":14374,"_27449":53243,"_2949":53480},[],"Only with `auth_method=static`",{"_3465":1347,"_30211":1267,"_20923":53482,"_5":14374,"_27449":53243,"_2949":53483},[],"AWS access key.",{"_3465":1348,"_30211":1267,"_20923":53485,"_5":14374,"_27449":53243,"_2949":53486},[],"`aws_config.secret_access_key`",{"_3465":1349,"_30211":1267,"_20923":53488,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1350,"_30211":1267,"_20923":53490,"_5":14374,"_27449":53243,"_2949":53480},[],{"_3465":1351,"_30211":1267,"_20923":53492,"_5":14374,"_27449":53243,"_2949":53493},[],"AWS secret key.",{"_3465":1352,"_30211":1267,"_20923":53495,"_5":14374,"_27449":53243,"_2949":53496},[],"`aws_config.session_token`",{"_3465":1353,"_30211":1267,"_20923":53498,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1354,"_30211":1267,"_20923":53500,"_5":14374,"_27449":53243,"_2949":53501},[],"No",{"_3465":1355,"_30211":1267,"_20923":53503,"_5":14374,"_27449":53243,"_2949":53504},[],"Session token (with `auth_method=static`).",{"_3465":1356,"_30211":1267,"_20923":53506,"_5":14374,"_27449":53243,"_2949":53507},[],"`aws_config.role_arn`",{"_3465":1357,"_30211":1267,"_20923":53509,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1358,"_30211":1267,"_20923":53511,"_5":14374,"_27449":53243,"_2949":53512},[],"Only with `auth_method=role`",{"_3465":1359,"_30211":1267,"_20923":53514,"_5":14374,"_27449":53243,"_2949":53515},[],"ARN of the role to assume.",{"_3465":1360,"_30211":1267,"_20923":53517,"_5":14374,"_27449":53243,"_2949":53518},[],"`aws_config.endpoint_url`",{"_3465":1361,"_30211":1267,"_20923":53520,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1362,"_30211":1267,"_20923":53522,"_5":14374,"_27449":53243,"_2949":53501},[],{"_3465":1363,"_30211":1267,"_20923":53524,"_5":14374,"_27449":53243,"_2949":53525},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3465":1364,"_30211":1267,"_20923":53527,"_5":14374,"_27449":53243,"_2949":53528},[],"`subscriber_event_bus`",{"_3465":1365,"_30211":1267,"_20923":53530,"_5":14374,"_27449":53243,"_2949":17607},[],{"_3465":1366,"_30211":1267,"_20923":53532,"_5":14374,"_27449":53243,"_2949":53449},[],{"_3465":1367,"_30211":1267,"_20923":53534,"_5":14374,"_27449":53243,"_2949":53535},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3465":1368,"_30211":1267,"_20923":53537,"_5":14374,"_27449":53243,"_2949":53538},[],"`dms_manager_client`",{"_3465":1369,"_30211":1267,"_20923":53540,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1370,"_30211":1267,"_20923":53542,"_5":14374,"_27449":53243,"_2949":53449},[],{"_3465":1371,"_30211":1267,"_20923":53544,"_5":14374,"_27449":53243,"_2949":53545},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3465":1372,"_30211":1267,"_20923":53547,"_5":14374,"_27449":53243,"_2949":53548},[],"`device_manager_client`",{"_3465":1373,"_30211":1267,"_20923":53550,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1374,"_30211":1267,"_20923":53552,"_5":14374,"_27449":53243,"_2949":53449},[],{"_3465":1375,"_30211":1267,"_20923":53554,"_5":14374,"_27449":53243,"_2949":53555},[],"HTTP URL of Lamassu's Device Manager.",{"_3465":1376,"_30211":1267,"_20923":53557,"_5":14374,"_27449":53243,"_2949":53558},[],"`ca_client`",{"_3465":1377,"_30211":1267,"_20923":53560,"_5":14374,"_27449":53243,"_2949":25028},[],{"_3465":1378,"_30211":1267,"_20923":53562,"_5":14374,"_27449":53243,"_2949":53449},[],{"_3465":1379,"_30211":1267,"_20923":53564,"_5":14374,"_27449":53243,"_2949":53565},[],"HTTP URL of Lamassu's CA service.",{"_3465":1380,"_30211":1267,"_20923":53567,"_5":14374,"_27449":53247,"_2949":53568},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3465":1381,"_30211":1267,"_20923":53570,"_5":14374,"_27449":53247,"_2949":53571},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3465":1382,"_30211":1267,"_20923":53573,"_5":14374,"_27449":53247,"_2949":53574},[],"CloudEvent type",{"_3465":1383,"_30211":1267,"_20923":53576,"_5":14374,"_27449":53247,"_2949":53577},[],"Lamassu resource",{"_3465":1384,"_30211":1267,"_20923":53579,"_5":14374,"_27449":53247,"_2949":53580},[],"AWS Resource",{"_3465":1385,"_30211":1267,"_20923":53582,"_5":14374,"_27449":53247,"_2949":53583},[],"IAM actions",{"_3465":1386,"_30211":1267,"_20923":53585,"_5":14374,"_27449":53247,"_2949":53586},[],"AWS calls and effect",{"_3465":1387,"_30211":1267,"_20923":53588,"_5":14374,"_27449":53247,"_2949":53589},[],"Where in this page",{"_3465":1388,"_30211":1267,"_20923":53591,"_5":14374,"_27449":53247,"_2949":53592},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3465":1389,"_30211":1267,"_20923":53594,"_5":14374,"_27449":53247,"_2949":53595},[],"CA",{"_3465":1390,"_30211":1267,"_20923":53597,"_5":14374,"_27449":53247,"_2949":53598},[],"`IoTCore/CACertificate`",{"_3465":1391,"_30211":1267,"_20923":53600,"_5":14374,"_27449":53247,"_2949":53601},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3465":1392,"_30211":1267,"_20923":53603,"_5":14374,"_27449":53247,"_2949":53604},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3465":1393,"_30211":1267,"_20923":53606,"_5":14374,"_27449":53247,"_2949":53260},[],{"_3465":1394,"_30211":1267,"_20923":53608,"_5":14374,"_27449":53247,"_2949":53609},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3465":1395,"_30211":1267,"_20923":53611,"_5":14374,"_27449":53247,"_2949":53612},[],"DMS",{"_3465":1396,"_30211":1267,"_20923":53614,"_5":14374,"_27449":53247,"_2949":53615},[],"`IoTCore/ProvisioningTemplate`",{"_3465":1397,"_30211":1267,"_20923":53617,"_5":14374,"_27449":53247,"_2949":53618},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3465":1398,"_30211":1267,"_20923":53620,"_5":14374,"_27449":53247,"_2949":53621},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3465":1399,"_30211":1267,"_20923":53623,"_5":14374,"_27449":53247,"_2949":53288},[],{"_3465":1400,"_30211":1267,"_20923":53625,"_5":14374,"_27449":53247,"_2949":53626},[],"`EventBindDeviceIdentityKey`",{"_3465":1401,"_30211":1267,"_20923":53628,"_5":14374,"_27449":53247,"_2949":53629},[],"Device",{"_3465":1402,"_30211":1267,"_20923":53631,"_5":14374,"_27449":53247,"_2949":53632},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3465":1403,"_30211":1267,"_20923":53634,"_5":14374,"_27449":53247,"_2949":53635},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3465":1404,"_30211":1267,"_20923":53637,"_5":14374,"_27449":53247,"_2949":53638},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3465":1405,"_30211":1267,"_20923":53640,"_5":14374,"_27449":53247,"_2949":53296},[],{"_3465":1406,"_30211":1267,"_20923":53642,"_5":14374,"_27449":53247,"_2949":53643},[],"`EventUpdateCertificateStatusKey`",{"_3465":1407,"_30211":1267,"_20923":53645,"_5":14374,"_27449":53247,"_2949":53646},[],"Certificate",{"_3465":1408,"_30211":1267,"_20923":53648,"_5":14374,"_27449":53247,"_2949":53649},[],"`IoTCore/Certificate`",{"_3465":1409,"_30211":1267,"_20923":53651,"_5":14374,"_27449":53247,"_2949":53652},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3465":1410,"_30211":1267,"_20923":53654,"_5":14374,"_27449":53247,"_2949":53655},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3465":1411,"_30211":1267,"_20923":53657,"_5":14374,"_27449":53247,"_2949":53308},[],{"_3465":1412,"_30211":1267,"_20923":53659,"_5":14374,"_27449":53247,"_2949":53660},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3465":1413,"_30211":1267,"_20923":53662,"_5":14374,"_27449":53247,"_2949":53663},[],"Certificate / Device",{"_3465":1414,"_30211":1267,"_20923":53665,"_5":14374,"_27449":53247,"_2949":53666},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3465":1415,"_30211":1267,"_20923":53668,"_5":14374,"_27449":53247,"_2949":49669},[],{"_3465":1416,"_30211":1267,"_20923":53670,"_5":14374,"_27449":53247,"_2949":53671},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3465":1417,"_30211":1267,"_20923":53673,"_5":14374,"_27449":53247,"_2949":53316},[],{"_3465":1418,"_30211":1267,"_20923":53675,"_5":14374,"_27449":53251,"_2949":53676},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3465":1419,"_30211":1267,"_20923":53678,"_5":14374,"_27449":53255,"_2949":53679},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3465":1420,"_30211":1267,"_20923":53681,"_5":14374,"_27449":53255,"_2949":53682},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3465":1421,"_30211":1267,"_20923":53684,"_5":14374,"_27449":53259,"_2949":53685},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3465":1422,"_30211":1267,"_20923":53687,"_5":14374,"_27449":53259,"_2949":53688},[],"Transition",{"_3465":1423,"_30211":1267,"_20923":53690,"_5":14374,"_27449":53259,"_2949":53691},[],"AWS calls",{"_3465":1424,"_30211":1267,"_20923":53693,"_5":14374,"_27449":53259,"_2949":53694},[],"`NotRegistered` → `Requested`",{"_3465":1425,"_30211":1267,"_20923":53696,"_5":14374,"_27449":53259,"_2949":53697},[],"none (metadata write only)",{"_3465":1426,"_30211":1267,"_20923":53699,"_5":14374,"_27449":53259,"_2949":53700},[],"`Requested` → `Registering`",{"_3465":1427,"_30211":1267,"_20923":53702,"_5":14374,"_27449":53259,"_2949":53703},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3465":1428,"_30211":1267,"_20923":53705,"_5":14374,"_27449":53259,"_2949":53706},[],"`Registering` → `Succeeded`",{"_3465":1429,"_30211":1267,"_20923":53708,"_5":14374,"_27449":53259,"_2949":53709},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3465":1430,"_30211":1267,"_20923":53711,"_5":14374,"_27449":53259,"_2949":53712},[],"`Registering` → `Failed`",{"_3465":1431,"_30211":1267,"_20923":53714,"_5":14374,"_27449":53259,"_2949":53715},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3465":1432,"_30211":1267,"_20923":53717,"_5":14374,"_27449":53259,"_2949":53718},[],"`Failed` / `Succeeded` → `Requested`",{"_3465":1433,"_30211":1267,"_20923":53720,"_5":14374,"_27449":53259,"_2949":53721},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3465":1434,"_30211":1267,"_20923":53723,"_5":14374,"_27449":53263,"_2949":53724},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3465":1435,"_30211":1267,"_20923":53726,"_5":14374,"_27449":53263,"_2949":53727},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3465":1436,"_30211":1267,"_20923":53729,"_5":14374,"_27449":53263,"_2949":53730},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3465":1437,"_30211":1267,"_20923":53732,"_5":14374,"_27449":53263,"_2949":53733},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3465":1438,"_30211":1267,"_20923":53735,"_5":14374,"_27449":53263,"_2949":53736},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3465":1439,"_30211":1267,"_20923":53738,"_5":14374,"_27449":53263,"_2949":53739},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3465":1440,"_30211":1267,"_20923":53741,"_5":14374,"_27449":53267,"_2949":53742},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3465":1441,"_30211":1267,"_20923":53744,"_5":14374,"_27449":53271,"_2949":53745},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3465":1442,"_30211":1267,"_20923":53747,"_5":14374,"_27449":53271,"_2949":53748},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3465":1443,"_30211":1267,"_20923":53750,"_5":14374,"_27449":53275,"_2949":53751},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3465":1444,"_30211":1267,"_20923":53753,"_5":14374,"_27449":53279,"_2949":53754},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3465":1445,"_30211":1267,"_20923":53756,"_5":14374,"_27449":53279,"_2949":53757},[],"Creates or updates the IoT policies configured in the DMS.",{"_3465":1446,"_30211":1267,"_20923":53759,"_5":14374,"_27449":53279,"_2949":53760},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3465":1447,"_30211":1267,"_20923":53762,"_5":14374,"_27449":53279,"_2949":53763},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3465":1448,"_30211":1267,"_20923":53765,"_5":14374,"_27449":53279,"_2949":53766},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3465":1449,"_30211":1267,"_20923":53768,"_5":14374,"_27449":53279,"_2949":53769},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3465":1450,"_30211":1267,"_20923":53771,"_5":14374,"_27449":53279,"_2949":53772},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3465":1451,"_30211":1267,"_20923":53774,"_5":14374,"_27449":53283,"_2949":53775},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3465":1452,"_30211":1267,"_20923":53777,"_5":14374,"_27449":53283,"_2949":53778},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3465":1453,"_30211":1267,"_20923":53780,"_5":14374,"_27449":53283,"_2949":53781},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3465":1454,"_30211":1267,"_20923":53783,"_5":14374,"_27449":53283,"_2949":53784},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3465":1455,"_30211":1267,"_20923":53786,"_5":14374,"_27449":53283,"_2949":53787},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3465":1456,"_30211":1267,"_20923":53789,"_5":14374,"_27449":53287,"_2949":53790},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3465":1457,"_30211":1267,"_20923":53792,"_5":14374,"_27449":53287,"_2949":53688},[],{"_3465":1458,"_30211":1267,"_20923":53794,"_5":14374,"_27449":53287,"_2949":53691},[],{"_3465":1459,"_30211":1267,"_20923":53796,"_5":14374,"_27449":53287,"_2949":53797},[],"`Unconfigured` → `None` / `Auto`",{"_3465":1460,"_30211":1267,"_20923":53799,"_5":14374,"_27449":53287,"_2949":53800},[],"none (configuration only)",{"_3465":1461,"_30211":1267,"_20923":53802,"_5":14374,"_27449":53287,"_2949":53803},[],"`None` ↔ `Auto`",{"_3465":1462,"_30211":1267,"_20923":53805,"_5":14374,"_27449":53287,"_2949":53800},[],{"_3465":1463,"_30211":1267,"_20923":53807,"_5":14374,"_27449":53287,"_2949":53808},[],"Any → `Jitp`",{"_3465":1464,"_30211":1267,"_20923":53810,"_5":14374,"_27449":53287,"_2949":53811},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3465":1465,"_30211":1267,"_20923":53813,"_5":14374,"_27449":53287,"_2949":53814},[],"`Jitp` → `None` / `Auto`",{"_3465":1466,"_30211":1267,"_20923":53816,"_5":14374,"_27449":53287,"_2949":53817},[],"none (the template stays in the AWS account)",{"_3465":1467,"_30211":1267,"_20923":53819,"_5":14374,"_27449":53291,"_2949":53820},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3465":1468,"_30211":1267,"_20923":53822,"_5":14374,"_27449":53291,"_2949":53823},[],"The full flow from the device's perspective is:",{"_3465":1469,"_30211":1267,"_20923":53825,"_5":14374,"_27449":53291,"_2949":53826},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3465":1470,"_30211":1267,"_20923":53828,"_5":14374,"_27449":53295,"_2949":53829},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3465":1471,"_30211":1267,"_20923":53831,"_5":14374,"_27449":53295,"_2949":53688},[],{"_3465":1472,"_30211":1267,"_20923":53833,"_5":14374,"_27449":53295,"_2949":53691},[],{"_3465":1473,"_30211":1267,"_20923":53835,"_5":14374,"_27449":53295,"_2949":53836},[],"`Absent` → `Provisioned`",{"_3465":1474,"_30211":1267,"_20923":53838,"_5":14374,"_27449":53295,"_2949":53839},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3465":1475,"_30211":1267,"_20923":53841,"_5":14374,"_27449":53295,"_2949":53842},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3465":1476,"_30211":1267,"_20923":53844,"_5":14374,"_27449":53295,"_2949":53845},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3465":1477,"_30211":1267,"_20923":53847,"_5":14374,"_27449":53295,"_2949":53848},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3465":1478,"_30211":1267,"_20923":53850,"_5":14374,"_27449":53299,"_2949":53851},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3465":1479,"_30211":1267,"_20923":53853,"_5":14374,"_27449":53299,"_2949":53854},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3465":1480,"_30211":1267,"_20923":53856,"_5":14374,"_27449":53299,"_2949":53857},[],"For the JITP flow to work correctly:",{"_3465":1481,"_30211":1267,"_20923":53859,"_5":14374,"_27449":53299,"_2949":53860},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3465":1482,"_30211":1267,"_20923":53862,"_5":14374,"_27449":53299,"_2949":53863},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3465":1483,"_30211":1267,"_20923":53865,"_5":14374,"_27449":53299,"_2949":53866},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3465":1484,"_30211":1267,"_20923":53868,"_5":14374,"_27449":53299,"_2949":53869},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3465":1485,"_30211":1267,"_20923":53871,"_5":14374,"_27449":53303,"_2949":53872},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3465":1486,"_30211":1267,"_20923":53874,"_5":14374,"_27449":53303,"_2949":53875},[],"Status in Lamassu",{"_3465":1487,"_30211":1267,"_20923":53877,"_5":14374,"_27449":53303,"_2949":53878},[],"Revocation reason",{"_3465":1488,"_30211":1267,"_20923":53880,"_5":14374,"_27449":53303,"_2949":53881},[],"Status in AWS IoT Core",{"_3465":1489,"_30211":1267,"_20923":53883,"_5":14374,"_27449":53303,"_2949":53884},[],"`Active`",{"_3465":1490,"_30211":1267,"_20923":53886,"_5":14374,"_27449":53303,"_2949":53887},[],"None",{"_3465":1491,"_30211":1267,"_20923":53889,"_5":14374,"_27449":53303,"_2949":53890},[],"`ACTIVE`",{"_3465":1492,"_30211":1267,"_20923":53892,"_5":14374,"_27449":53303,"_2949":53893},[],"`Revoked`",{"_3465":1493,"_30211":1267,"_20923":53895,"_5":14374,"_27449":53303,"_2949":53896},[],"`certificateHold`",{"_3465":1494,"_30211":1267,"_20923":53898,"_5":14374,"_27449":53303,"_2949":53899},[],"`INACTIVE`",{"_3465":1495,"_30211":1267,"_20923":53901,"_5":14374,"_27449":53303,"_2949":53893},[],{"_3465":1496,"_30211":1267,"_20923":53903,"_5":14374,"_27449":53303,"_2949":53904},[],"Any other reason",{"_3465":1497,"_30211":1267,"_20923":53906,"_5":14374,"_27449":53303,"_2949":53907},[],"`REVOKED`",{"_3465":1498,"_30211":1267,"_20923":53909,"_5":14374,"_27449":53303,"_2949":53910},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3465":1499,"_30211":1267,"_20923":53912,"_5":14374,"_27449":53307,"_2949":53913},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3465":1500,"_30211":1267,"_20923":53915,"_5":14374,"_27449":53307,"_2949":53688},[],{"_3465":1501,"_30211":1267,"_20923":53917,"_5":14374,"_27449":53307,"_2949":53691},[],{"_3465":1502,"_30211":1267,"_20923":53919,"_5":14374,"_27449":53307,"_2949":53920},[],"`NotSynced` → `Active`",{"_3465":1503,"_30211":1267,"_20923":53922,"_5":14374,"_27449":53307,"_2949":53399},[],{"_3465":1504,"_30211":1267,"_20923":53924,"_5":14374,"_27449":53307,"_2949":53925},[],"`Active` → `Inactive`",{"_3465":1505,"_30211":1267,"_20923":53927,"_5":14374,"_27449":53307,"_2949":53928},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3465":1506,"_30211":1267,"_20923":53930,"_5":14374,"_27449":53307,"_2949":53931},[],"`Active` → `Revoked`",{"_3465":1507,"_30211":1267,"_20923":53933,"_5":14374,"_27449":53307,"_2949":53928},[],{"_3465":1508,"_30211":1267,"_20923":53935,"_5":14374,"_27449":53307,"_2949":53936},[],"`Inactive` / `Revoked` → `Active`",{"_3465":1509,"_30211":1267,"_20923":53938,"_5":14374,"_27449":53307,"_2949":53399},[],{"_3465":1510,"_30211":1267,"_20923":53940,"_5":14374,"_27449":53307,"_2949":53941},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3465":1511,"_30211":1267,"_20923":53943,"_5":14374,"_27449":53307,"_2949":53944},[],"none (these states are not synced to AWS)",{"_3465":1512,"_30211":1267,"_20923":53946,"_5":14374,"_27449":53311,"_2949":53947},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3465":1513,"_30211":1267,"_20923":53949,"_5":14374,"_27449":53311,"_2949":53950},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3465":1514,"_30211":1267,"_20923":53952,"_5":14374,"_27449":53311,"_2949":53953},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3465":1515,"_30211":1267,"_20923":53955,"_5":14374,"_27449":53315,"_2949":53956},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3465":1516,"_30211":1267,"_20923":53958,"_5":14374,"_27449":53315,"_2949":53959},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3465":1517,"_30211":1267,"_20923":53961,"_5":14374,"_27449":53319,"_2949":53962},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3465":1518,"_30211":1267,"_20923":53964,"_5":14374,"_27449":53319,"_2949":53965},[],"There are two action types:",{"_3465":1519,"_30211":1267,"_20923":53967,"_5":14374,"_27449":53319,"_2949":53968},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3465":1520,"_30211":1267,"_20923":53970,"_5":14374,"_27449":53319,"_2949":53971},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3465":1521,"_30211":1267,"_20923":53973,"_5":14374,"_27449":53319,"_2949":53974},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3465":1522,"_30211":1267,"_20923":53976,"_5":14374,"_27449":53323,"_2949":53977},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3465":1523,"_30211":1267,"_20923":53979,"_5":14374,"_27449":53323,"_2949":53980},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3465":1524,"_30211":1267,"_20923":53982,"_5":14374,"_27449":53323,"_2949":53983},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3465":1525,"_30211":1267,"_20923":53985,"_5":14374,"_27449":53327,"_2949":53986},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3465":1526,"_30211":1267,"_20923":53988,"_5":14374,"_27449":53327,"_2949":53989},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3465":1527,"_30211":1267,"_20923":53991,"_5":14374,"_27449":53327,"_2949":53992},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3465":1528,"_30211":1267,"_20923":53994,"_5":14374,"_27449":53327,"_2949":53995},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3465":1529,"_30211":1267,"_20923":53997,"_5":14374,"_27449":53327,"_2949":53998},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3465":1530,"_30211":1267,"_20923":54000,"_5":14374,"_27449":53327,"_2949":54001},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3465":1531,"_30211":1267,"_20923":54003,"_5":14374,"_27449":53327,"_2949":54004},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3465":1532,"_30211":1267,"_20923":54006,"_5":14374,"_27449":53327,"_2949":54007},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3465":1533,"_30211":1267,"_20923":54009,"_5":14374,"_27449":53327,"_2949":54010},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3465":1534,"_30211":1267,"_20923":54012,"_5":14374,"_27449":53327,"_2949":54013},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3465":1535,"_30211":1267,"_20923":54015,"_5":14374,"_27449":53327,"_2949":54016},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3465":1536,"_30211":1267,"_20923":54018,"_5":14374,"_27449":53327,"_2949":54019},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3465":1537,"_30211":1267,"_20923":54021,"_5":14374,"_27449":53327,"_2949":54022},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3465":1538,"_30211":1267,"_20923":54024,"_5":14374,"_27449":53327,"_2949":54025},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3465":1539,"_30211":1267,"_20923":54027,"_5":14374,"_27449":53327,"_2949":54028},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3465":1540,"_30211":1267,"_20923":54030,"_5":14374,"_27449":53327,"_2949":54031},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3465":1541,"_30211":1267,"_20923":54033,"_5":14374,"_27449":53327,"_2949":54034},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3465":1542,"_30211":1267,"_20923":54036,"_5":14374,"_27449":53327,"_2949":54037},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3465":1543,"_30211":1267,"_20923":54039,"_5":14374,"_27449":53327,"_2949":54040},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3465":1544,"_30211":1267,"_20923":54042,"_5":14374,"_27449":53327,"_2949":54043},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3465":1545,"_30211":1267,"_20923":54045,"_5":14374,"_27449":53327,"_2949":54046},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3465":1546,"_30211":1267,"_20923":54048,"_5":14374,"_27449":53327,"_2949":54049},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":1547,"_30211":1267,"_20923":54051,"_5":14374,"_27449":53327,"_2949":54052},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3465":1548,"_30211":1267,"_20923":54054,"_5":14374,"_27449":53327,"_2949":54055},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3465":1549,"_30211":1549,"_5":14726,"_2949":51762,"_30563":54057,"_20923":54058,"_27449":1549},[49273,50748,51762],[],{"_3465":1550,"_30211":1549,"_20923":54060,"_5":14374,"_27449":1549,"_2949":54061},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3465":1551,"_30211":1549,"_5":30560,"_20923":54063,"_27449":54064,"_2949":54065},[],"/docs/pr-preview/pr-67/platform/iot-fleets/overview#start-here","Start here",{"_3465":1552,"_30211":1549,"_5":30560,"_20923":54067,"_27449":54068,"_2949":51760},[],"/docs/pr-preview/pr-67/platform/iot-fleets/overview#devices-and-identities",{"_3465":1553,"_30211":1549,"_5":30560,"_20923":54070,"_27449":54071,"_2949":51943},[],"/docs/pr-preview/pr-67/platform/iot-fleets/overview#enrollment-with-pki",{"_3465":1554,"_30211":1549,"_5":30560,"_20923":54073,"_27449":54074,"_2949":53224},[],"/docs/pr-preview/pr-67/platform/iot-fleets/overview#integrations",{"_3465":1555,"_30211":1549,"_5":30560,"_20923":54076,"_27449":54077,"_2949":54078},[],"/docs/pr-preview/pr-67/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3465":1556,"_30211":1549,"_20923":54080,"_5":14374,"_27449":1549,"_2949":54081},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3465":1557,"_30211":1549,"_20923":54083,"_5":14374,"_27449":54064,"_2949":54084},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3465":1558,"_30211":1549,"_20923":54086,"_5":14374,"_27449":54064,"_2949":54087},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3465":1559,"_30211":1549,"_20923":54089,"_5":14374,"_27449":54068,"_2949":54090},[],"Resource",{"_3465":1560,"_30211":1549,"_20923":54092,"_5":14374,"_27449":54068,"_2949":54093},[],"What it represents",{"_3465":1561,"_30211":1549,"_20923":54095,"_5":14374,"_27449":54068,"_2949":54096},[],"**Device**",{"_3465":1562,"_30211":1549,"_20923":54098,"_5":14374,"_27449":54068,"_2949":54099},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3465":1563,"_30211":1549,"_20923":54101,"_5":14374,"_27449":54068,"_2949":54102},[],"**Identity**",{"_3465":1564,"_30211":1549,"_20923":54104,"_5":14374,"_27449":54068,"_2949":54105},[],"The device's association with its certificates: an active version and a history.",{"_3465":1565,"_30211":1549,"_20923":54107,"_5":14374,"_27449":54068,"_2949":54108},[],"**DMS**",{"_3465":1566,"_30211":1549,"_20923":54110,"_5":14374,"_27449":54068,"_2949":54111},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3465":1567,"_30211":1549,"_20923":54113,"_5":14374,"_27449":54068,"_2949":54114},[],"**Fleet**",{"_3465":1568,"_30211":1549,"_20923":54116,"_5":14374,"_27449":54068,"_2949":54117},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3465":1569,"_30211":1549,"_20923":54119,"_5":14374,"_27449":54068,"_2949":54120},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3465":1570,"_30211":1549,"_20923":54122,"_5":14374,"_27449":54068,"_2949":54123},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3465":1571,"_30211":1549,"_20923":54125,"_5":14374,"_27449":54071,"_2949":54126},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3465":1572,"_30211":1549,"_20923":54128,"_5":14374,"_27449":54071,"_2949":54129},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3465":1573,"_30211":1549,"_20923":54131,"_5":14374,"_27449":54071,"_2949":54132},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3465":1574,"_30211":1549,"_20923":54134,"_5":14374,"_27449":54071,"_2949":54135},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3465":1575,"_30211":1549,"_20923":54137,"_5":14374,"_27449":54071,"_2949":54138},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3465":1576,"_30211":1549,"_20923":54140,"_5":14374,"_27449":54071,"_2949":54141},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3465":1577,"_30211":1549,"_20923":54143,"_5":14374,"_27449":54071,"_2949":54144},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":1578,"_30211":1549,"_20923":54146,"_5":14374,"_27449":54071,"_2949":54147},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3465":1579,"_30211":1549,"_20923":54149,"_5":14374,"_27449":54074,"_2949":54150},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3465":1580,"_30211":1549,"_20923":54152,"_5":14374,"_27449":54074,"_2949":54153},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3465":1581,"_30211":1549,"_20923":54155,"_5":14374,"_27449":54077,"_2949":54156},[],"Participant",{"_3465":1582,"_30211":1549,"_20923":54158,"_5":14374,"_27449":54077,"_2949":54159},[],"Responsibility",{"_3465":1583,"_30211":1549,"_20923":54161,"_5":14374,"_27449":54077,"_2949":54162},[],"PKI administrator",{"_3465":1584,"_30211":1549,"_20923":54164,"_5":14374,"_27449":54077,"_2949":54165},[],"CA, issuance profile, chain and revocation publication.",{"_3465":1585,"_30211":1549,"_20923":54167,"_5":14374,"_27449":54077,"_2949":54168},[],"Provisioning administrator",{"_3465":1586,"_30211":1549,"_20923":54170,"_5":14374,"_27449":54077,"_2949":54171},[],"DMS, admission, authentication per operation and inventory.",{"_3465":1587,"_30211":1549,"_20923":54173,"_5":14374,"_27449":54077,"_2949":54174},[],"Device integrator",{"_3465":1588,"_30211":1549,"_20923":54176,"_5":14374,"_27449":54077,"_2949":54177},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3465":1589,"_30211":1549,"_20923":54179,"_5":14374,"_27449":54077,"_2949":54180},[],"Consumer integrator",{"_3465":1590,"_30211":1549,"_20923":54182,"_5":14374,"_27449":54077,"_2949":54183},[],"Trusted issuers, validation and device permissions in the destination.",{"_3465":1591,"_30211":1549,"_20923":54185,"_5":14374,"_27449":54077,"_2949":54186},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3465":1592,"_30211":1592,"_5":14726,"_2949":54188,"_30563":54189,"_20923":54191,"_27449":1592},"Enroll and connect your first device",[49273,50748,51762,54190],"Getting started",[],{"_3465":1593,"_30211":1592,"_20923":54193,"_5":14374,"_27449":1592,"_2949":54194},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3465":1594,"_30211":1592,"_5":30560,"_20923":54196,"_27449":54197,"_2949":49283},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3465":1595,"_30211":1592,"_5":30560,"_20923":54199,"_27449":54200,"_2949":54201},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3465":1596,"_30211":1592,"_5":30560,"_20923":54203,"_27449":54204,"_2949":54205},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3465":1597,"_30211":1592,"_5":30560,"_20923":54207,"_27449":54208,"_2949":54209},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3465":1598,"_30211":1592,"_5":30560,"_20923":54211,"_27449":54212,"_2949":54213},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3465":1599,"_30211":1592,"_5":30560,"_20923":54215,"_27449":54216,"_2949":54217},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3465":1600,"_30211":1592,"_5":30560,"_20923":54219,"_27449":54220,"_2949":54221},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3465":1601,"_30211":1592,"_5":30560,"_20923":54223,"_27449":54224,"_2949":54225},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3465":1602,"_30211":1592,"_20923":54227,"_5":14374,"_27449":1592,"_2949":54228},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3465":1603,"_30211":1592,"_20923":54230,"_5":14374,"_27449":54197,"_2949":54231},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3465":1604,"_30211":1592,"_20923":54233,"_5":14374,"_27449":54197,"_2949":54234},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3465":1605,"_30211":1592,"_20923":54236,"_5":14374,"_27449":54197,"_2949":54237},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3465":1606,"_30211":1592,"_20923":54239,"_5":14374,"_27449":54197,"_2949":54240},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3465":1607,"_30211":1592,"_20923":54242,"_5":14374,"_27449":54197,"_2949":54243},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3465":1608,"_30211":1592,"_20923":54245,"_5":14374,"_27449":54200,"_2949":54246},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3465":1609,"_30211":1592,"_20923":54248,"_5":14374,"_27449":54200,"_2949":54249},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3465":1610,"_30211":1592,"_20923":54251,"_5":14374,"_27449":54204,"_2949":54252},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3465":1611,"_30211":1592,"_20923":54254,"_5":14374,"_27449":54204,"_2949":54255},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3465":1612,"_30211":1592,"_20923":54257,"_5":14374,"_27449":54204,"_2949":54258},[],"Setting",{"_3465":1613,"_30211":1592,"_20923":54260,"_5":14374,"_27449":54204,"_2949":54261},[],"Evaluation value",{"_3465":1614,"_30211":1592,"_20923":54263,"_5":14374,"_27449":54204,"_2949":54264},[],"Enrollment CA",{"_3465":1615,"_30211":1592,"_20923":54266,"_5":14374,"_27449":54204,"_2949":54267},[],"Issuing root from `device-root.pem`.",{"_3465":1616,"_30211":1592,"_20923":54269,"_5":14374,"_27449":54204,"_2949":52073},[],{"_3465":1617,"_30211":1592,"_20923":54271,"_5":14374,"_27449":54204,"_2949":54272},[],"The 1-hour leaf profile you just prepared.",{"_3465":1618,"_30211":1592,"_20923":54274,"_5":14374,"_27449":54204,"_2949":54275},[],"Protocol / Registration Mode",{"_3465":1619,"_30211":1592,"_20923":54277,"_5":14374,"_27449":54204,"_2949":54278},[],"`EST_RFC7030` / `JITP`.",{"_3465":1620,"_30211":1592,"_20923":54280,"_5":14374,"_27449":54204,"_2949":54281},[],"Verify CSR Signature",{"_3465":1621,"_30211":1592,"_20923":54283,"_5":14374,"_27449":54204,"_2949":54284},[],"Enabled.",{"_3465":1622,"_30211":1592,"_20923":54286,"_5":14374,"_27449":54204,"_2949":54287},[],"Enable Replaceable Enrollment",{"_3465":1623,"_30211":1592,"_20923":54289,"_5":14374,"_27449":54204,"_2949":54290},[],"Disabled; the ID must be new.",{"_3465":1624,"_30211":1592,"_20923":54292,"_5":14374,"_27449":54204,"_2949":54293},[],"Initial authentication",{"_3465":1625,"_30211":1592,"_20923":54295,"_5":14374,"_27449":54204,"_2949":54296},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3465":1626,"_30211":1592,"_20923":54298,"_5":14374,"_27449":54204,"_2949":54299},[],"Renewal authentication",{"_3465":1627,"_30211":1592,"_20923":54301,"_5":14374,"_27449":54204,"_2949":54302},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3465":1628,"_30211":1592,"_20923":54304,"_5":14374,"_27449":54204,"_2949":54305},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3465":1629,"_30211":1592,"_20923":54307,"_5":14374,"_27449":54204,"_2949":54308},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3465":1630,"_30211":1592,"_20923":54310,"_5":14374,"_27449":54204,"_2949":54311},[],"Re-enrollment Delta",{"_3465":1631,"_30211":1592,"_20923":54313,"_5":14374,"_27449":54204,"_2949":54314},[],"1 hour.",{"_3465":1632,"_30211":1592,"_20923":54316,"_5":14374,"_27449":54204,"_2949":54317},[],"Preventive / Critical Delta",{"_3465":1633,"_30211":1592,"_20923":54319,"_5":14374,"_27449":54204,"_2949":54320},[],"30 minutes / 10 minutes.",{"_3465":1634,"_30211":1592,"_20923":54322,"_5":14374,"_27449":54204,"_2949":54323},[],"Revoke on Re-enrollment",{"_3465":1635,"_30211":1592,"_20923":54325,"_5":14374,"_27449":54204,"_2949":54326},[],"Disabled to test the successor before retiring the previous identity.",{"_3465":1636,"_30211":1592,"_20923":54328,"_5":14374,"_27449":54204,"_2949":52081},[],{"_3465":1637,"_30211":1592,"_20923":54330,"_5":14374,"_27449":54204,"_2949":54331},[],"Disabled; the operational key is generated in the client.",{"_3465":1638,"_30211":1592,"_20923":54333,"_5":14374,"_27449":54204,"_2949":54334},[],"CA Distribution",{"_3465":1639,"_30211":1592,"_20923":54336,"_5":14374,"_27449":54204,"_2949":54337},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3465":1640,"_30211":1592,"_20923":54339,"_5":14374,"_27449":54204,"_2949":54340},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3465":1641,"_30211":1592,"_20923":54342,"_5":14374,"_27449":54208,"_2949":54343},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3465":1642,"_30211":1592,"_20923":54345,"_5":14374,"_27449":54208,"_2949":54346},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3465":1643,"_30211":1592,"_20923":54348,"_5":14374,"_27449":54212,"_2949":54349},[],"Generate a new key and CSR with the selected identifier:",{"_3465":1644,"_30211":1592,"_20923":54351,"_5":14374,"_27449":54212,"_2949":54352},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3465":1645,"_30211":1592,"_20923":54354,"_5":14374,"_27449":54212,"_2949":54355},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3465":1646,"_30211":1592,"_20923":54357,"_5":14374,"_27449":54216,"_2949":54358},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3465":1647,"_30211":1592,"_20923":54360,"_5":14374,"_27449":54216,"_2949":54361},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3465":1648,"_30211":1592,"_20923":54363,"_5":14374,"_27449":54220,"_2949":54364},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3465":1649,"_30211":1592,"_20923":54366,"_5":14374,"_27449":54220,"_2949":54367},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3465":1650,"_30211":1592,"_20923":54369,"_5":14374,"_27449":54220,"_2949":54370},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3465":1651,"_30211":1592,"_20923":54372,"_5":14374,"_27449":54220,"_2949":54373},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3465":1652,"_30211":1592,"_20923":54375,"_5":14374,"_27449":54220,"_2949":54376},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3465":1653,"_30211":1592,"_20923":54378,"_5":14374,"_27449":54224,"_2949":54379},[],"Check",{"_3465":1654,"_30211":1592,"_20923":54381,"_5":14374,"_27449":54224,"_2949":54382},[],"Expected result",{"_3465":1655,"_30211":1592,"_20923":54384,"_5":14374,"_27449":54224,"_2949":54385},[],"Registration",{"_3465":1656,"_30211":1592,"_20923":54387,"_5":14374,"_27449":54224,"_2949":54388},[],"ID created automatically and correct DMS.",{"_3465":1657,"_30211":1592,"_20923":54390,"_5":14374,"_27449":54224,"_2949":53646},[],{"_3465":1658,"_30211":1592,"_20923":54392,"_5":14374,"_27449":54224,"_2949":54393},[],"CN, profile, serial and key verified.",{"_3465":1659,"_30211":1592,"_20923":54395,"_5":14374,"_27449":54224,"_2949":54396},[],"Inventory",{"_3465":1660,"_30211":1592,"_20923":54398,"_5":14374,"_27449":54224,"_2949":54399},[],"Received serial visible as the current identity and in history.",{"_3465":1661,"_30211":1592,"_20923":54401,"_5":14374,"_27449":54224,"_2949":54402},[],"Consumer",{"_3465":1662,"_30211":1592,"_20923":54404,"_5":14374,"_27449":54224,"_2949":54405},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3465":1663,"_30211":1592,"_20923":54407,"_5":14374,"_27449":54224,"_2949":54408},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3465":1664,"_30211":1592,"_20923":54410,"_5":14374,"_27449":54224,"_2949":54411},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3465":1665,"_30211":1665,"_5":14726,"_2949":51778,"_30563":54413,"_20923":54414,"_27449":1665},[49273,50748,51762,54190],[],{"_3465":1666,"_30211":1665,"_20923":54416,"_5":14374,"_27449":1665,"_2949":54417},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3465":1667,"_30211":1665,"_5":30560,"_20923":54419,"_27449":54420,"_2949":49283},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3465":1668,"_30211":1665,"_5":30560,"_20923":54422,"_27449":54423,"_2949":54424},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3465":1669,"_30211":1665,"_5":30560,"_20923":54426,"_27449":54427,"_2949":54428},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3465":1670,"_30211":1665,"_5":30560,"_20923":54430,"_27449":54431,"_2949":54432},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3465":1671,"_30211":1665,"_5":30560,"_20923":54434,"_27449":54435,"_2949":54436},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3465":1672,"_30211":1665,"_5":30560,"_20923":54438,"_27449":54439,"_2949":54440},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3465":1673,"_30211":1665,"_5":30560,"_20923":54442,"_27449":54443,"_2949":54382},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3465":1674,"_30211":1665,"_5":30560,"_20923":54445,"_27449":54446,"_2949":54447},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3465":1675,"_30211":1665,"_5":30560,"_20923":54449,"_27449":54450,"_2949":54451},[],"/docs/pr-preview/pr-67/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3465":1676,"_30211":1665,"_20923":54453,"_5":14374,"_27449":1665,"_2949":54454},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3465":1677,"_30211":1665,"_20923":54456,"_5":14374,"_27449":1665,"_2949":54457},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3465":1678,"_30211":1665,"_20923":54459,"_5":14374,"_27449":54420,"_2949":54460},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3465":1679,"_30211":1665,"_20923":54462,"_5":14374,"_27449":54420,"_2949":54463},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3465":1680,"_30211":1665,"_20923":54465,"_5":14374,"_27449":54420,"_2949":54466},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3465":1681,"_30211":1665,"_20923":54468,"_5":14374,"_27449":54420,"_2949":54469},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3465":1682,"_30211":1665,"_20923":54471,"_5":14374,"_27449":54423,"_2949":54472},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3465":1683,"_30211":1665,"_20923":54474,"_5":14374,"_27449":54423,"_2949":54475},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3465":1684,"_30211":1665,"_20923":54477,"_5":14374,"_27449":54423,"_2949":54478},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3465":1685,"_30211":1665,"_20923":54480,"_5":14374,"_27449":54423,"_2949":54481},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3465":1686,"_30211":1665,"_20923":54483,"_5":14374,"_27449":54423,"_2949":54484},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3465":1687,"_30211":1665,"_20923":54486,"_5":14374,"_27449":54423,"_2949":54487},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3465":1688,"_30211":1665,"_20923":54489,"_5":14374,"_27449":54423,"_2949":54490},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3465":1689,"_30211":1665,"_20923":54492,"_5":14374,"_27449":54423,"_2949":54493},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3465":1690,"_30211":1665,"_20923":54495,"_5":14374,"_27449":54427,"_2949":54496},[],"Open **Managed Devices** and the registration action. Complete:",{"_3465":1691,"_30211":1665,"_20923":54498,"_5":14374,"_27449":54427,"_2949":54499},[],"**Device ID**: `device-001`.",{"_3465":1692,"_30211":1665,"_20923":54501,"_5":14374,"_27449":54427,"_2949":54502},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3465":1693,"_30211":1665,"_20923":54504,"_5":14374,"_27449":54427,"_2949":54505},[],"**Icon** and **Tags**: optional classification.",{"_3465":1694,"_30211":1665,"_20923":54507,"_5":14374,"_27449":54427,"_2949":54508},[],"Confirm registration.",{"_3465":1695,"_30211":1665,"_20923":54510,"_5":14374,"_27449":54431,"_2949":54511},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3465":1696,"_30211":1665,"_20923":54513,"_5":14374,"_27449":54431,"_2949":54514},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3465":1697,"_30211":1665,"_20923":54516,"_5":14374,"_27449":54435,"_2949":54517},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3465":1698,"_30211":1665,"_20923":54519,"_5":14374,"_27449":54435,"_2949":54520},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3465":1699,"_30211":1665,"_20923":54522,"_5":14374,"_27449":54439,"_2949":54523},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3465":1700,"_30211":1665,"_20923":54525,"_5":14374,"_27449":54439,"_2949":54526},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3465":1701,"_30211":1665,"_20923":54528,"_5":14374,"_27449":54443,"_2949":54379},[],{"_3465":1702,"_30211":1665,"_20923":54530,"_5":14374,"_27449":54443,"_2949":54531},[],"Result",{"_3465":1703,"_30211":1665,"_20923":54533,"_5":14374,"_27449":54443,"_2949":53629},[],{"_3465":1704,"_30211":1665,"_20923":54535,"_5":14374,"_27449":54443,"_2949":54536},[],"`device-001` appears in inventory with the expected DMS.",{"_3465":1705,"_30211":1665,"_20923":54538,"_5":14374,"_27449":54443,"_2949":54539},[],"Current identity",{"_3465":1706,"_30211":1665,"_20923":54541,"_5":14374,"_27449":54443,"_2949":54542},[],"The associated certificate matches the one you verified in PKI.",{"_3465":1707,"_30211":1665,"_20923":54544,"_5":14374,"_27449":54443,"_2949":54545},[],"History",{"_3465":1708,"_30211":1665,"_20923":54547,"_5":14374,"_27449":54443,"_2949":54548},[],"The associated issuance appears with its serial number and dates.",{"_3465":1709,"_30211":1665,"_20923":54550,"_5":14374,"_27449":54443,"_2949":54551},[],"Key and certificate",{"_3465":1710,"_30211":1665,"_20923":54553,"_5":14374,"_27449":54443,"_2949":54554},[],"You have the verified pair ready to install on the device.",{"_3465":1711,"_30211":1665,"_20923":54556,"_5":14374,"_27449":54446,"_2949":54557},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3465":1712,"_30211":1665,"_20923":54559,"_5":14374,"_27449":54446,"_2949":54560},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3465":1713,"_30211":1665,"_20923":54562,"_5":14374,"_27449":54446,"_2949":54563},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3465":1714,"_30211":1665,"_20923":54565,"_5":14374,"_27449":54446,"_2949":54566},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3465":1715,"_30211":1665,"_20923":54568,"_5":14374,"_27449":54450,"_2949":54569},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3465":1716,"_30211":1665,"_20923":54571,"_5":14374,"_27449":54450,"_2949":54572},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3465":1717,"_30211":1665,"_20923":54574,"_5":14374,"_27449":54450,"_2949":54575},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3465":1718,"_30211":1718,"_5":14726,"_2949":54577,"_30563":54578,"_20923":54579,"_27449":1718},"Lamassu IoT Platform",[49273,50748],[],{"_3465":1719,"_30211":1718,"_20923":54581,"_5":14374,"_27449":1718,"_2949":54582},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3465":1720,"_30211":1718,"_5":30560,"_20923":54584,"_27449":54585,"_2949":54065},[],"/docs/pr-preview/pr-67/platform/overview#start-here",{"_3465":1721,"_30211":1718,"_5":30560,"_20923":54587,"_27449":54588,"_2949":54589},[],"/docs/pr-preview/pr-67/platform/overview#choose-your-path","Choose your path",{"_3465":1722,"_30211":1718,"_5":30560,"_20923":54591,"_27449":54592,"_2949":54593},[],"/docs/pr-preview/pr-67/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3465":1723,"_30211":1718,"_5":30560,"_20923":54595,"_27449":54596,"_2949":54597},[],"/docs/pr-preview/pr-67/platform/overview#core-capabilities","Core capabilities",{"_3465":1724,"_30211":1718,"_5":30560,"_20923":54599,"_27449":54600,"_2949":54601},[],"/docs/pr-preview/pr-67/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3465":1725,"_30211":1718,"_5":30560,"_20923":54603,"_27449":54604,"_2949":54605},[],"/docs/pr-preview/pr-67/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3465":1726,"_30211":1718,"_5":30560,"_20923":54607,"_27449":54608,"_2949":54609},[],"/docs/pr-preview/pr-67/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3465":1727,"_30211":1718,"_5":30560,"_20923":54611,"_27449":54612,"_2949":54613},[],"/docs/pr-preview/pr-67/platform/overview#automate-device-identities","Automate device identities",{"_3465":1728,"_30211":1718,"_5":30560,"_20923":54615,"_27449":54616,"_2949":54617},[],"/docs/pr-preview/pr-67/platform/overview#publish-validation-status","Publish validation status",{"_3465":1729,"_30211":1718,"_5":30560,"_20923":54619,"_27449":54620,"_2949":54621},[],"/docs/pr-preview/pr-67/platform/overview#react-to-events","React to events",{"_3465":1730,"_30211":1718,"_5":30560,"_20923":54623,"_27449":54624,"_2949":54625},[],"/docs/pr-preview/pr-67/platform/overview#operational-reference","Operational reference",{"_3465":1731,"_30211":1718,"_20923":54627,"_5":14374,"_27449":1718,"_2949":54628},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3465":1732,"_30211":1718,"_20923":54630,"_5":14374,"_27449":54585,"_2949":54631},[],"Choose the result you need:",{"_3465":1733,"_30211":1718,"_20923":54633,"_5":14374,"_27449":54585,"_2949":54634},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3465":1734,"_30211":1718,"_20923":54636,"_5":14374,"_27449":54585,"_2949":54637},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3465":1735,"_30211":1718,"_20923":54639,"_5":14374,"_27449":54585,"_2949":54640},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3465":1736,"_30211":1718,"_20923":54642,"_5":14374,"_27449":54588,"_2949":54643},[],"Section",{"_3465":1737,"_30211":1718,"_20923":54645,"_5":14374,"_27449":54588,"_2949":54646},[],"What you manage",{"_3465":1738,"_30211":1718,"_20923":54648,"_5":14374,"_27449":54588,"_2949":54649},[],"Entry point",{"_3465":1739,"_30211":1718,"_20923":54651,"_5":14374,"_27449":54588,"_2949":54652},[],"**PKI**",{"_3465":1740,"_30211":1718,"_20923":54654,"_5":14374,"_27449":54588,"_2949":54655},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3465":1741,"_30211":1718,"_20923":54657,"_5":14374,"_27449":54588,"_2949":54658},[],"PKI overview",{"_3465":1742,"_30211":1718,"_20923":54660,"_5":14374,"_27449":54588,"_2949":54661},[],"**IoT Fleets**",{"_3465":1743,"_30211":1718,"_20923":54663,"_5":14374,"_27449":54588,"_2949":54664},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3465":1744,"_30211":1718,"_20923":54666,"_5":14374,"_27449":54588,"_2949":54667},[],"IoT Fleets overview",{"_3465":1745,"_30211":1718,"_20923":54669,"_5":14374,"_27449":54588,"_2949":54670},[],"**Administration**",{"_3465":1746,"_30211":1718,"_20923":54672,"_5":14374,"_27449":54588,"_2949":54673},[],"Operator permissions, audit and event subscriptions.",{"_3465":1747,"_30211":1718,"_20923":54675,"_5":14374,"_27449":54588,"_2949":50746},[],{"_3465":1748,"_30211":1718,"_20923":54677,"_5":14374,"_27449":54588,"_2949":54678},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3465":1749,"_30211":1718,"_20923":54680,"_5":14374,"_27449":54592,"_2949":54681},[],"An identity's journey connects four responsibilities:",{"_3465":1750,"_30211":1718,"_20923":54683,"_5":14374,"_27449":54592,"_2949":54684},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3465":1751,"_30211":1718,"_20923":54686,"_5":14374,"_27449":54592,"_2949":54687},[],"The provisioning administrator configures the DMS and initial trust.",{"_3465":1752,"_30211":1718,"_20923":54689,"_5":14374,"_27449":54592,"_2949":54690},[],"The device client requests a certificate and installs it with the matching key.",{"_3465":1753,"_30211":1718,"_20923":54692,"_5":14374,"_27449":54592,"_2949":54693},[],"The consumer validates the identity and applies its access permissions.",{"_3465":1754,"_30211":1718,"_20923":54695,"_5":14374,"_27449":54592,"_2949":54696},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3465":1755,"_30211":1718,"_20923":54698,"_5":14374,"_27449":54600,"_2949":54699},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3465":1756,"_30211":1718,"_20923":54701,"_5":14374,"_27449":54604,"_2949":54702},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3465":1757,"_30211":1718,"_20923":54704,"_5":14374,"_27449":54608,"_2949":54705},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3465":1758,"_30211":1718,"_20923":54707,"_5":14374,"_27449":54612,"_2949":54708},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3465":1759,"_30211":1718,"_20923":54710,"_5":14374,"_27449":54616,"_2949":54711},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3465":1760,"_30211":1718,"_20923":54713,"_5":14374,"_27449":54620,"_2949":54714},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3465":1761,"_30211":1718,"_20923":54716,"_5":14374,"_27449":54624,"_2949":54159},[],{"_3465":1762,"_30211":1718,"_20923":54718,"_5":14374,"_27449":54624,"_2949":54719},[],"What it prepares or checks",{"_3465":1763,"_30211":1718,"_20923":54721,"_5":14374,"_27449":54624,"_2949":54162},[],{"_3465":1764,"_30211":1718,"_20923":54723,"_5":14374,"_27449":54624,"_2949":54724},[],"Key custody, CA hierarchy, profiles and validation.",{"_3465":1765,"_30211":1718,"_20923":54726,"_5":14374,"_27449":54624,"_2949":54727},[],"Fleet administrator",{"_3465":1766,"_30211":1718,"_20923":54729,"_5":14374,"_27449":54624,"_2949":54730},[],"DMS, device admission, renewal policy and inventory.",{"_3465":1767,"_30211":1718,"_20923":54732,"_5":14374,"_27449":54624,"_2949":54174},[],{"_3465":1768,"_30211":1718,"_20923":54734,"_5":14374,"_27449":54624,"_2949":54735},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3465":1769,"_30211":1718,"_20923":54737,"_5":14374,"_27449":54624,"_2949":54180},[],{"_3465":1770,"_30211":1718,"_20923":54739,"_5":14374,"_27449":54624,"_2949":54740},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3465":1771,"_30211":1718,"_20923":54742,"_5":14374,"_27449":54624,"_2949":54743},[],"Infrastructure operator",{"_3465":1772,"_30211":1718,"_20923":54745,"_5":14374,"_27449":54624,"_2949":54746},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3465":1773,"_30211":1718,"_20923":54748,"_5":14374,"_27449":54624,"_2949":54749},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3465":1774,"_30211":1774,"_5":14726,"_2949":54751,"_30563":54752,"_20923":54755,"_27449":1774},"CA hierarchy and rotation",[49273,50748,54753,54754],"PKI","Keys, authorities and certificates",[],{"_3465":1775,"_30211":1774,"_20923":54757,"_5":14374,"_27449":1774,"_2949":54758},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3465":1776,"_30211":1774,"_5":30560,"_20923":54760,"_27449":54761,"_2949":54762},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3465":1777,"_30211":1774,"_5":30560,"_20923":54764,"_27449":54765,"_2949":54766},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3465":1778,"_30211":1774,"_5":30560,"_20923":54768,"_27449":54769,"_2949":54770},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3465":1779,"_30211":1774,"_5":30560,"_20923":54772,"_27449":54773,"_2949":54774},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3465":1780,"_30211":1774,"_5":30560,"_20923":54776,"_27449":54777,"_2949":54778},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3465":1781,"_30211":1774,"_5":30560,"_20923":54780,"_27449":54781,"_2949":54782},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3465":1782,"_30211":1774,"_5":30560,"_20923":54784,"_27449":54785,"_2949":54786},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3465":1783,"_30211":1774,"_5":30560,"_20923":54788,"_27449":54789,"_2949":54790},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3465":1784,"_30211":1774,"_5":30560,"_20923":54792,"_27449":54793,"_2949":54794},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3465":1785,"_30211":1774,"_5":30560,"_20923":54796,"_27449":54797,"_2949":54798},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3465":1786,"_30211":1774,"_5":30560,"_20923":54800,"_27449":54801,"_2949":54802},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3465":1787,"_30211":1774,"_5":30560,"_20923":54804,"_27449":54805,"_2949":54806},[],"/docs/pr-preview/pr-67/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3465":1788,"_30211":1774,"_20923":54808,"_5":14374,"_27449":1774,"_2949":54809},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3465":1789,"_30211":1774,"_20923":54811,"_5":14374,"_27449":1774,"_2949":54812},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3465":1790,"_30211":1774,"_20923":54814,"_5":14374,"_27449":54761,"_2949":54815},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3465":1791,"_30211":1774,"_20923":54817,"_5":14374,"_27449":54761,"_2949":54818},[],"environment, such as production and preproduction;",{"_3465":1792,"_30211":1774,"_20923":54820,"_5":14374,"_27449":54761,"_2949":54821},[],"owner or operating team;",{"_3465":1793,"_30211":1774,"_20923":54823,"_5":14374,"_27449":54761,"_2949":54824},[],"device family or manufacturing process;",{"_3465":1794,"_30211":1774,"_20923":54826,"_5":14374,"_27449":54761,"_2949":54827},[],"region or regulatory requirement;",{"_3465":1795,"_30211":1774,"_20923":54829,"_5":14374,"_27449":54761,"_2949":54830},[],"cryptographic engine or key policy;",{"_3465":1796,"_30211":1774,"_20923":54832,"_5":14374,"_27449":54761,"_2949":54833},[],"maintenance window and renewal cadence.",{"_3465":1797,"_30211":1774,"_20923":54835,"_5":14374,"_27449":54761,"_2949":54836},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3465":1798,"_30211":1774,"_20923":54838,"_5":14374,"_27449":54761,"_2949":54839},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3465":1799,"_30211":1774,"_20923":54841,"_5":14374,"_27449":54765,"_2949":54842},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3465":1800,"_30211":1774,"_20923":54844,"_5":14374,"_27449":54765,"_2949":54845},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide.",{"_3465":1801,"_30211":1774,"_20923":54847,"_5":14374,"_27449":54765,"_2949":54848},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3465":1802,"_30211":1774,"_20923":54850,"_5":14374,"_27449":54765,"_2949":54851},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3465":1803,"_30211":1774,"_20923":54853,"_5":14374,"_27449":54769,"_2949":54854},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3465":1804,"_30211":1774,"_20923":54856,"_5":14374,"_27449":54769,"_2949":54857},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3465":1805,"_30211":1774,"_20923":54859,"_5":14374,"_27449":54769,"_2949":54860},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3465":1806,"_30211":1774,"_20923":54862,"_5":14374,"_27449":54769,"_2949":54863},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3465":1807,"_30211":1774,"_20923":54865,"_5":14374,"_27449":54777,"_2949":54866},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3465":1808,"_30211":1774,"_20923":54868,"_5":14374,"_27449":54781,"_2949":54869},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3465":1809,"_30211":1774,"_20923":54871,"_5":14374,"_27449":54785,"_2949":54872},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3465":1810,"_30211":1774,"_20923":54874,"_5":14374,"_27449":54789,"_2949":54875},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3465":1811,"_30211":1774,"_20923":54877,"_5":14374,"_27449":54793,"_2949":54878},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3465":1812,"_30211":1774,"_20923":54880,"_5":14374,"_27449":54797,"_2949":54881},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3465":1813,"_30211":1774,"_20923":54883,"_5":14374,"_27449":54801,"_2949":54884},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3465":1814,"_30211":1774,"_20923":54886,"_5":14374,"_27449":54801,"_2949":54887},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3465":1815,"_30211":1774,"_20923":54889,"_5":14374,"_27449":54801,"_2949":54890},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3465":1816,"_30211":1774,"_20923":54892,"_5":14374,"_27449":54801,"_2949":54893},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3465":1817,"_30211":1774,"_20923":54895,"_5":14374,"_27449":54805,"_2949":54896},[],"The new chain ends in an anchor installed by the consumer.",{"_3465":1818,"_30211":1774,"_20923":54898,"_5":14374,"_27449":54805,"_2949":54899},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3465":1819,"_30211":1774,"_20923":54901,"_5":14374,"_27449":54805,"_2949":54902},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3465":1820,"_30211":1774,"_20923":54904,"_5":14374,"_27449":54805,"_2949":54905},[],"Re-enrollment accepts the old identity during the planned period.",{"_3465":1821,"_30211":1774,"_20923":54907,"_5":14374,"_27449":54805,"_2949":54908},[],"OCSP and CRL respond for the authorities that remain active.",{"_3465":1822,"_30211":1774,"_20923":54910,"_5":14374,"_27449":54805,"_2949":54911},[],"No DMS is left accidentally issuing from the old CA.",{"_3465":1823,"_30211":1774,"_20923":54913,"_5":14374,"_27449":54805,"_2949":54914},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3465":1824,"_30211":1824,"_5":14726,"_2949":54916,"_30563":54917,"_20923":54918,"_27449":1824},"Certification authorities",[49273,50748,54753,54754],[],{"_3465":1825,"_30211":1824,"_20923":54920,"_5":14374,"_27449":1824,"_2949":54921},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3465":1826,"_30211":1824,"_5":30560,"_20923":54923,"_27449":54924,"_2949":54925},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3465":1827,"_30211":1824,"_5":30560,"_20923":54927,"_27449":54928,"_2949":54929},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3465":1828,"_30211":1824,"_5":30560,"_20923":54931,"_27449":54932,"_2949":49283},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#before-you-begin",{"_3465":1829,"_30211":1824,"_5":30560,"_20923":54934,"_27449":54935,"_2949":54936},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3465":1830,"_30211":1824,"_5":30560,"_20923":54938,"_27449":54939,"_2949":54940},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3465":1831,"_30211":1824,"_5":30560,"_20923":54942,"_27449":54943,"_2949":54944},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3465":1832,"_30211":1824,"_5":30560,"_20923":54946,"_27449":54947,"_2949":54948},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3465":1833,"_30211":1824,"_5":30560,"_20923":54950,"_27449":54951,"_2949":54952},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3465":1834,"_30211":1824,"_5":30560,"_20923":54954,"_27449":54955,"_2949":54956},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3465":1835,"_30211":1824,"_5":30560,"_20923":54958,"_27449":54959,"_2949":54960},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3465":1836,"_30211":1824,"_5":30560,"_20923":54962,"_27449":54963,"_2949":54964},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3465":1837,"_30211":1824,"_5":30560,"_20923":54966,"_27449":54967,"_2949":54968},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3465":1838,"_30211":1824,"_5":30560,"_20923":54970,"_27449":54971,"_2949":54972},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3465":1839,"_30211":1824,"_5":30560,"_20923":54974,"_27449":54975,"_2949":54976},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3465":1840,"_30211":1824,"_5":30560,"_20923":54978,"_27449":54979,"_2949":54980},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3465":1841,"_30211":1824,"_5":30560,"_20923":54982,"_27449":54983,"_2949":54984},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3465":1842,"_30211":1824,"_5":30560,"_20923":54986,"_27449":54987,"_2949":54988},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3465":1843,"_30211":1824,"_5":30560,"_20923":54990,"_27449":54991,"_2949":54992},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3465":1844,"_30211":1824,"_5":30560,"_20923":54994,"_27449":54995,"_2949":54996},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3465":1845,"_30211":1824,"_5":30560,"_20923":54998,"_27449":54999,"_2949":55000},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3465":1846,"_30211":1824,"_5":30560,"_20923":55002,"_27449":55003,"_2949":55004},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3465":1847,"_30211":1824,"_5":30560,"_20923":55006,"_27449":55007,"_2949":55008},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3465":1848,"_30211":1824,"_5":30560,"_20923":55010,"_27449":55011,"_2949":55012},[],"/docs/pr-preview/pr-67/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3465":1849,"_30211":1824,"_20923":55014,"_5":14374,"_27449":1824,"_2949":55015},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3465":1850,"_30211":1824,"_20923":55017,"_5":14374,"_27449":1824,"_2949":55018},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3465":1851,"_30211":1824,"_20923":55020,"_5":14374,"_27449":1824,"_2949":55021},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3465":1852,"_30211":1824,"_20923":55023,"_5":14374,"_27449":54924,"_2949":55024},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3465":1853,"_30211":1824,"_20923":55026,"_5":14374,"_27449":54924,"_2949":55027},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3465":1854,"_30211":1824,"_20923":55029,"_5":14374,"_27449":54924,"_2949":55030},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3465":1855,"_30211":1824,"_20923":55032,"_5":14374,"_27449":54924,"_2949":55033},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3465":1856,"_30211":1824,"_20923":55035,"_5":14374,"_27449":54924,"_2949":55036},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3465":1857,"_30211":1824,"_20923":55038,"_5":14374,"_27449":54932,"_2949":55039},[],"Decide whether the CA will be a root or an intermediate.",{"_3465":1858,"_30211":1824,"_20923":55041,"_5":14374,"_27449":54932,"_2949":55042},[],"Choose the engine that will keep the key.",{"_3465":1859,"_30211":1824,"_20923":55044,"_5":14374,"_27449":54932,"_2949":55045},[],"Define a validity longer than that of the certificates it will issue.",{"_3465":1860,"_30211":1824,"_20923":55047,"_5":14374,"_27449":54932,"_2949":55048},[],"For an intermediate CA, make sure the parent CA is active.",{"_3465":1861,"_30211":1824,"_20923":55050,"_5":14374,"_27449":54935,"_2949":55051},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3465":1862,"_30211":1824,"_20923":55053,"_5":14374,"_27449":54939,"_2949":55054},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3465":1863,"_30211":1824,"_20923":55056,"_5":14374,"_27449":54939,"_2949":55057},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3465":1864,"_30211":1824,"_20923":55059,"_5":14374,"_27449":54943,"_2949":55060},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3465":1865,"_30211":1824,"_20923":55062,"_5":14374,"_27449":54947,"_2949":55063},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3465":1866,"_30211":1824,"_20923":55065,"_5":14374,"_27449":54947,"_2949":55066},[],"`C`: two-letter ISO 3166-1 country code.",{"_3465":1867,"_30211":1824,"_20923":55068,"_5":14374,"_27449":54947,"_2949":55069},[],"`ST`: state or province.",{"_3465":1868,"_30211":1824,"_20923":55071,"_5":14374,"_27449":54947,"_2949":55072},[],"`L`: locality.",{"_3465":1869,"_30211":1824,"_20923":55074,"_5":14374,"_27449":54947,"_2949":55075},[],"`O`: organization.",{"_3465":1870,"_30211":1824,"_20923":55077,"_5":14374,"_27449":54947,"_2949":55078},[],"`OU`: organizational unit.",{"_3465":1871,"_30211":1824,"_20923":55080,"_5":14374,"_27449":54947,"_2949":55081},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3465":1872,"_30211":1824,"_20923":55083,"_5":14374,"_27449":54951,"_2949":55084},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3465":1873,"_30211":1824,"_20923":55086,"_5":14374,"_27449":54951,"_2949":55087},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3465":1874,"_30211":1824,"_20923":55089,"_5":14374,"_27449":54955,"_2949":55090},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3465":1875,"_30211":1824,"_20923":55092,"_5":14374,"_27449":54955,"_2949":55093},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3465":1876,"_30211":1824,"_20923":55095,"_5":14374,"_27449":54959,"_2949":55096},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3465":1877,"_30211":1824,"_20923":55098,"_5":14374,"_27449":54959,"_2949":55099},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3465":1878,"_30211":1824,"_20923":55101,"_5":14374,"_27449":54963,"_2949":55102},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3465":1879,"_30211":1824,"_20923":55104,"_5":14374,"_27449":54963,"_2949":55105},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3465":1880,"_30211":1824,"_20923":55107,"_5":14374,"_27449":54963,"_2949":55108},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3465":1881,"_30211":1824,"_20923":55110,"_5":14374,"_27449":54967,"_2949":55111},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3465":1882,"_30211":1824,"_20923":55113,"_5":14374,"_27449":54971,"_2949":55114},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3465":1883,"_30211":1824,"_20923":55116,"_5":14374,"_27449":54971,"_2949":55117},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3465":1884,"_30211":1824,"_20923":55119,"_5":14374,"_27449":54975,"_2949":55120},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3465":1885,"_30211":1824,"_20923":55122,"_5":14374,"_27449":54979,"_2949":55123},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3465":1886,"_30211":1824,"_20923":55125,"_5":14374,"_27449":54979,"_2949":55126},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3465":1887,"_30211":1824,"_20923":55128,"_5":14374,"_27449":54983,"_2949":55129},[],"Open a CA from the inventory to review:",{"_3465":1888,"_30211":1824,"_20923":55131,"_5":14374,"_27449":54983,"_2949":55132},[],"Status and validity period.",{"_3465":1889,"_30211":1824,"_20923":55134,"_5":14374,"_27449":54983,"_2949":55135},[],"Certificate and chain in PEM format.",{"_3465":1890,"_30211":1824,"_20923":55137,"_5":14374,"_27449":54983,"_2949":55138},[],"Number of active, expired and revoked certificates.",{"_3465":1891,"_30211":1824,"_20923":55140,"_5":14374,"_27449":54983,"_2949":55141},[],"Certificates issued in **Issued Certificates**.",{"_3465":1892,"_30211":1824,"_20923":55143,"_5":14374,"_27449":54983,"_2949":55144},[],"The CRL linked to the authority.",{"_3465":1893,"_30211":1824,"_20923":55146,"_5":14374,"_27449":54983,"_2949":55147},[],"Metadata and the associated cryptographic engine.",{"_3465":1894,"_30211":1824,"_20923":55149,"_5":14374,"_27449":54983,"_2949":55150},[],"You can filter the inventory by name, status and CA type.",{"_3465":1895,"_30211":1824,"_20923":55152,"_5":14374,"_27449":54987,"_2949":55153},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3465":1896,"_30211":1824,"_20923":55155,"_5":14374,"_27449":54987,"_2949":55156},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3465":1897,"_30211":1824,"_20923":55158,"_5":14374,"_27449":54987,"_2949":55159},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3465":1898,"_30211":1824,"_20923":55161,"_5":14374,"_27449":54987,"_2949":55162},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3465":1899,"_30211":1824,"_20923":55164,"_5":14374,"_27449":54991,"_2949":55165},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3465":1900,"_30211":1824,"_20923":55167,"_5":14374,"_27449":54995,"_2949":55168},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3465":1901,"_30211":1824,"_20923":55170,"_5":14374,"_27449":54999,"_2949":55171},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3465":1902,"_30211":1824,"_20923":55173,"_5":14374,"_27449":55003,"_2949":55174},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3465":1903,"_30211":1824,"_20923":55176,"_5":14374,"_27449":55007,"_2949":55177},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3465":1904,"_30211":1824,"_20923":55179,"_5":14374,"_27449":55011,"_2949":55180},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3465":1905,"_30211":1824,"_20923":55182,"_5":14374,"_27449":55011,"_2949":55183},[],"The CA’s CRL settings are kept as `ARCHIVED`. The last CRL keeps being served but is never regenerated once the CA is gone, so adjust its validity and signer beforehand. Archived settings can be deleted with `DELETE /v1/crl-settings/{ca-id}` or from the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone; see the warning in CRL. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3465":1906,"_30211":1824,"_20923":55185,"_5":14374,"_27449":55011,"_2949":55186},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, their last CRL keeps being served at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; archived settings can no longer be edited (see CRL).",{"_3465":1907,"_30211":1907,"_5":14726,"_2949":55188,"_30563":55189,"_20923":55190,"_27449":1907},"Certificate profiles",[49273,50748,54753,54754],[],{"_3465":1908,"_30211":1907,"_20923":55192,"_5":14374,"_27449":1907,"_2949":55193},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3465":1909,"_30211":1907,"_5":30560,"_20923":55195,"_27449":55196,"_2949":55197},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3465":1910,"_30211":1907,"_5":30560,"_20923":55199,"_27449":55200,"_2949":55201},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#validity","Validity",{"_3465":1911,"_30211":1907,"_5":30560,"_20923":55203,"_27449":55204,"_2949":55205},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3465":1912,"_30211":1907,"_5":30560,"_20923":55207,"_27449":55208,"_2949":55209},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3465":1913,"_30211":1907,"_5":30560,"_20923":55211,"_27449":55212,"_2949":55213},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#subject","Subject",{"_3465":1914,"_30211":1907,"_5":30560,"_20923":55215,"_27449":55216,"_2949":55217},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3465":1915,"_30211":1907,"_5":30560,"_20923":55219,"_27449":55220,"_2949":55221},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3465":1916,"_30211":1907,"_5":30560,"_20923":55223,"_27449":55224,"_2949":55225},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3465":1917,"_30211":1907,"_5":30560,"_20923":55227,"_27449":55228,"_2949":55229},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3465":1918,"_30211":1907,"_5":30560,"_20923":55231,"_27449":55232,"_2949":55233},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3465":1919,"_30211":1907,"_5":30560,"_20923":55235,"_27449":55236,"_2949":55237},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3465":1920,"_30211":1907,"_5":30560,"_20923":55239,"_27449":55240,"_2949":55241},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3465":1921,"_30211":1907,"_5":30560,"_20923":55243,"_27449":55244,"_2949":55245},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3465":1922,"_30211":1907,"_5":30560,"_20923":55247,"_27449":55248,"_2949":55249},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3465":1923,"_30211":1907,"_5":30560,"_20923":55251,"_27449":55252,"_2949":55253},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#design-examples","Design examples",{"_3465":1924,"_30211":1907,"_5":30560,"_20923":55255,"_27449":55256,"_2949":55257},[],"/docs/pr-preview/pr-67/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3465":1925,"_30211":1907,"_20923":55259,"_5":14374,"_27449":1907,"_2949":55260},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3465":1926,"_30211":1907,"_20923":55262,"_5":14374,"_27449":1907,"_2949":55263},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3465":1927,"_30211":1907,"_20923":55265,"_5":14374,"_27449":55200,"_2949":55266},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3465":1928,"_30211":1907,"_20923":55268,"_5":14374,"_27449":55200,"_2949":55269},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3465":1929,"_30211":1907,"_20923":55271,"_5":14374,"_27449":55204,"_2949":55272},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3465":1930,"_30211":1907,"_20923":55274,"_5":14374,"_27449":55208,"_2949":55275},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3465":1931,"_30211":1907,"_20923":55277,"_5":14374,"_27449":55208,"_2949":55278},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3465":1932,"_30211":1907,"_20923":55280,"_5":14374,"_27449":55208,"_2949":55281},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3465":1933,"_30211":1907,"_20923":55283,"_5":14374,"_27449":55212,"_2949":55284},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3465":1934,"_30211":1907,"_20923":55286,"_5":14374,"_27449":55216,"_2949":55287},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3465":1935,"_30211":1907,"_20923":55289,"_5":14374,"_27449":55216,"_2949":55290},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3465":1936,"_30211":1907,"_20923":55292,"_5":14374,"_27449":55220,"_2949":55293},[],"The cryptographic enforcement can:",{"_3465":1937,"_30211":1907,"_20923":55295,"_5":14374,"_27449":55220,"_2949":55296},[],"allow or block RSA keys;",{"_3465":1938,"_30211":1907,"_20923":55298,"_5":14374,"_27449":55220,"_2949":55299},[],"limit the supported RSA sizes;",{"_3465":1939,"_30211":1907,"_20923":55301,"_5":14374,"_27449":55220,"_2949":55302},[],"allow or block ECDSA keys;",{"_3465":1940,"_30211":1907,"_20923":55304,"_5":14374,"_27449":55220,"_2949":55305},[],"limit the supported ECDSA sizes or curves.",{"_3465":1941,"_30211":1907,"_20923":55307,"_5":14374,"_27449":55220,"_2949":55308},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3465":1942,"_30211":1907,"_20923":55310,"_5":14374,"_27449":55224,"_2949":55311},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3465":1943,"_30211":1907,"_20923":55313,"_5":14374,"_27449":55224,"_2949":52515},[],{"_3465":1944,"_30211":1907,"_20923":55315,"_5":14374,"_27449":55224,"_2949":55316},[],"First choice",{"_3465":1945,"_30211":1907,"_20923":55318,"_5":14374,"_27449":55224,"_2949":55319},[],"Second choice",{"_3465":1946,"_30211":1907,"_20923":55321,"_5":14374,"_27449":55224,"_2949":55322},[],"If neither is supplied",{"_3465":1947,"_30211":1907,"_20923":55324,"_5":14374,"_27449":55224,"_2949":55325},[],"Direct signing with a CA",{"_3465":1948,"_30211":1907,"_20923":55327,"_5":14374,"_27449":55224,"_2949":55328},[],"`issuance_profile` embedded in the request",{"_3465":1949,"_30211":1907,"_20923":55330,"_5":14374,"_27449":55224,"_2949":55331},[],"Request `issuance_profile_id`",{"_3465":1950,"_30211":1907,"_20923":55333,"_5":14374,"_27449":55224,"_2949":55334},[],"CA default profile (`profile_id`).",{"_3465":1951,"_30211":1907,"_20923":55336,"_5":14374,"_27449":55224,"_2949":55337},[],"Issuance through a DMS",{"_3465":1952,"_30211":1907,"_20923":55339,"_5":14374,"_27449":55224,"_2949":55340},[],"`settings.issuance_profile_id`",{"_3465":1953,"_30211":1907,"_20923":55342,"_5":14374,"_27449":55224,"_2949":55343},[],"`settings.issuance_profile` embedded in the DMS",{"_3465":1954,"_30211":1907,"_20923":55345,"_5":14374,"_27449":55224,"_2949":55346},[],"Enrollment CA default profile.",{"_3465":1955,"_30211":1907,"_20923":55348,"_5":14374,"_27449":55224,"_2949":55349},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3465":1956,"_30211":1907,"_20923":55351,"_5":14374,"_27449":55224,"_2949":55352},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3465":1957,"_30211":1907,"_20923":55354,"_5":14374,"_27449":55232,"_2949":55355},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3465":1958,"_30211":1907,"_20923":55357,"_5":14374,"_27449":55236,"_2949":55358},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3465":1959,"_30211":1907,"_20923":55360,"_5":14374,"_27449":55240,"_2949":55361},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3465":1960,"_30211":1907,"_20923":55363,"_5":14374,"_27449":55244,"_2949":55364},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3465":1961,"_30211":1907,"_20923":55366,"_5":14374,"_27449":55248,"_2949":55367},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3465":1962,"_30211":1907,"_20923":55369,"_5":14374,"_27449":55248,"_2949":55370},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3465":1963,"_30211":1907,"_20923":55372,"_5":14374,"_27449":55252,"_2949":55373},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3465":1964,"_30211":1907,"_20923":55375,"_5":14374,"_27449":55252,"_2949":55376},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3465":1965,"_30211":1907,"_20923":55378,"_5":14374,"_27449":55252,"_2949":55379},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3465":1966,"_30211":1907,"_20923":55381,"_5":14374,"_27449":55252,"_2949":55382},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3465":1967,"_30211":1907,"_20923":55384,"_5":14374,"_27449":55256,"_2949":55385},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3465":1968,"_30211":1907,"_20923":55387,"_5":14374,"_27449":55256,"_2949":55388},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3465":1969,"_30211":1969,"_5":14726,"_2949":55390,"_30563":55391,"_20923":55393,"_27449":1969},"Certificate validation",[49273,50748,54753,55392],"Validation",[],{"_3465":1970,"_30211":1969,"_20923":55395,"_5":14374,"_27449":1969,"_2949":55396},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3465":1971,"_30211":1969,"_5":30560,"_20923":55398,"_27449":55399,"_2949":55400},[],"/docs/pr-preview/pr-67/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3465":1972,"_30211":1969,"_5":30560,"_20923":55402,"_27449":55403,"_2949":55404},[],"/docs/pr-preview/pr-67/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3465":1973,"_30211":1969,"_5":30560,"_20923":55406,"_27449":55407,"_2949":55408},[],"/docs/pr-preview/pr-67/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3465":1974,"_30211":1969,"_20923":55410,"_5":14374,"_27449":1969,"_2949":55411},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3465":1975,"_30211":1969,"_20923":55413,"_5":14374,"_27449":55399,"_2949":55414},[],"Verify these criteria together:",{"_3465":1976,"_30211":1969,"_20923":55416,"_5":14374,"_27449":55399,"_2949":54379},[],{"_3465":1977,"_30211":1969,"_20923":55418,"_5":14374,"_27449":55399,"_2949":55419},[],"Required result",{"_3465":1978,"_30211":1969,"_20923":55421,"_5":14374,"_27449":55399,"_2949":55422},[],"Chain and signature",{"_3465":1979,"_30211":1969,"_20923":55424,"_5":14374,"_27449":55399,"_2949":55425},[],"Valid chain to a root deliberately installed in the consumer.",{"_3465":1980,"_30211":1969,"_20923":55427,"_5":14374,"_27449":55399,"_2949":55428},[],"Dates",{"_3465":1981,"_30211":1969,"_20923":55430,"_5":14374,"_27449":55399,"_2949":55431},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3465":1982,"_30211":1969,"_20923":55433,"_5":14374,"_27449":55399,"_2949":50417},[],{"_3465":1983,"_30211":1969,"_20923":55435,"_5":14374,"_27449":55399,"_2949":55436},[],"Name, SAN or identifier matches the expected peer.",{"_3465":1984,"_30211":1969,"_20923":55438,"_5":14374,"_27449":55399,"_2949":49663},[],{"_3465":1985,"_30211":1969,"_20923":55440,"_5":14374,"_27449":55399,"_2949":55441},[],"KU, EKU and constraints permit the specific operation.",{"_3465":1986,"_30211":1969,"_20923":55443,"_5":14374,"_27449":55399,"_2949":55444},[],"Revocation",{"_3465":1987,"_30211":1969,"_20923":55446,"_5":14374,"_27449":55399,"_2949":55447},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3465":1988,"_30211":1969,"_20923":55449,"_5":14374,"_27449":55399,"_2949":55450},[],"Authorization",{"_3465":1989,"_30211":1969,"_20923":55452,"_5":14374,"_27449":55399,"_2949":55453},[],"The application permits that identity to perform the action.",{"_3465":1990,"_30211":1969,"_20923":55455,"_5":14374,"_27449":55399,"_2949":55456},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3465":1991,"_30211":1969,"_20923":55458,"_5":14374,"_27449":55403,"_2949":55459},[],"Mechanism",{"_3465":1992,"_30211":1969,"_20923":55461,"_5":14374,"_27449":55403,"_2949":55462},[],"When to use it",{"_3465":1993,"_30211":1969,"_20923":55464,"_5":14374,"_27449":55403,"_2949":55465},[],"What you must maintain",{"_3465":1994,"_30211":1969,"_20923":55467,"_5":14374,"_27449":55403,"_2949":55468},[],"OCSP",{"_3465":1995,"_30211":1969,"_20923":55470,"_5":14374,"_27449":55403,"_2949":55471},[],"Status query for a specific certificate.",{"_3465":1996,"_30211":1969,"_20923":55473,"_5":14374,"_27449":55403,"_2949":55474},[],"Responder access, signature verification and cache/freshness policy.",{"_3465":1997,"_30211":1969,"_20923":55476,"_5":14374,"_27449":55403,"_2949":55477},[],"CRL",{"_3465":1998,"_30211":1969,"_20923":55479,"_5":14374,"_27449":55403,"_2949":55480},[],"Local checks for many certificates or offline operation.",{"_3465":1999,"_30211":1969,"_20923":55482,"_5":14374,"_27449":55403,"_2949":55483},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3465":2000,"_30211":1969,"_20923":55485,"_5":14374,"_27449":55403,"_2949":55486},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3465":2001,"_30211":1969,"_20923":55488,"_5":14374,"_27449":55403,"_2949":55489},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3465":2002,"_30211":1969,"_20923":55491,"_5":14374,"_27449":55407,"_2949":55492},[],"Accept a current, authorized certificate with a known chain.",{"_3465":2003,"_30211":1969,"_20923":55494,"_5":14374,"_27449":55407,"_2949":55495},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3465":2004,"_30211":1969,"_20923":55497,"_5":14374,"_27449":55407,"_2949":55498},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3465":2005,"_30211":1969,"_20923":55500,"_5":14374,"_27449":55407,"_2949":55501},[],"Check that a new connection with that identity is rejected.",{"_3465":2006,"_30211":1969,"_20923":55503,"_5":14374,"_27449":55407,"_2949":55504},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3465":2007,"_30211":1969,"_20923":55506,"_5":14374,"_27449":55407,"_2949":55507},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3465":2008,"_30211":1969,"_20923":55509,"_5":14374,"_27449":55407,"_2949":55510},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3465":2009,"_30211":1969,"_20923":55512,"_5":14374,"_27449":55407,"_2949":55513},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":2010,"_30211":1969,"_20923":55515,"_5":14374,"_27449":55407,"_2949":55516},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3465":2011,"_30211":2011,"_5":14726,"_2949":55518,"_30563":55519,"_20923":55520,"_27449":2011},"Certificates",[49273,50748,54753,54754],[],{"_3465":2012,"_30211":2011,"_20923":55522,"_5":14374,"_27449":2011,"_2949":55523},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3465":2013,"_30211":2011,"_5":30560,"_20923":55525,"_27449":55526,"_2949":55527},[],"/docs/pr-preview/pr-67/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3465":2014,"_30211":2011,"_5":30560,"_20923":55529,"_27449":55530,"_2949":55531},[],"/docs/pr-preview/pr-67/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3465":2015,"_30211":2011,"_5":30560,"_20923":55533,"_27449":55534,"_2949":55535},[],"/docs/pr-preview/pr-67/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3465":2016,"_30211":2011,"_5":30560,"_20923":55537,"_27449":55538,"_2949":55539},[],"/docs/pr-preview/pr-67/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3465":2017,"_30211":2011,"_5":30560,"_20923":55541,"_27449":55542,"_2949":55543},[],"/docs/pr-preview/pr-67/platform/pki/certificates#open-the-action","Open the action",{"_3465":2018,"_30211":2011,"_5":30560,"_20923":55545,"_27449":55546,"_2949":55547},[],"/docs/pr-preview/pr-67/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3465":2019,"_30211":2011,"_5":30560,"_20923":55549,"_27449":55550,"_2949":55551},[],"/docs/pr-preview/pr-67/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3465":2020,"_30211":2011,"_5":30560,"_20923":55553,"_27449":55554,"_2949":55555},[],"/docs/pr-preview/pr-67/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3465":2021,"_30211":2011,"_5":30560,"_20923":55557,"_27449":55558,"_2949":55559},[],"/docs/pr-preview/pr-67/platform/pki/certificates#continue","Continue",{"_3465":2022,"_30211":2011,"_20923":55561,"_5":14374,"_27449":2011,"_2949":55562},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3465":2023,"_30211":2011,"_20923":55564,"_5":14374,"_27449":55526,"_2949":55565},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3465":2024,"_30211":2011,"_20923":55567,"_5":14374,"_27449":55526,"_2949":55568},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3465":2025,"_30211":2011,"_20923":55570,"_5":14374,"_27449":55526,"_2949":55571},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3465":2026,"_30211":2011,"_20923":55573,"_5":14374,"_27449":55526,"_2949":55574},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3465":2027,"_30211":2011,"_20923":55576,"_5":14374,"_27449":55526,"_2949":55577},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3465":2028,"_30211":2011,"_20923":55579,"_5":14374,"_27449":55526,"_2949":55580},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3465":2029,"_30211":2011,"_20923":55582,"_5":14374,"_27449":55526,"_2949":55583},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3465":2030,"_30211":2011,"_20923":55585,"_5":14374,"_27449":55530,"_2949":55586},[],"Download the PEM and inspect it:",{"_3465":2031,"_30211":2011,"_20923":55588,"_5":14374,"_27449":55530,"_2949":55589},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3465":2032,"_30211":2011,"_20923":55591,"_5":14374,"_27449":55534,"_2949":55592},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3465":2033,"_30211":2011,"_20923":55594,"_5":14374,"_27449":55534,"_2949":55595},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3465":2034,"_30211":2011,"_20923":55597,"_5":14374,"_27449":55534,"_2949":55598},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3465":2035,"_30211":2011,"_20923":55600,"_5":14374,"_27449":55534,"_2949":55601},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3465":2036,"_30211":2011,"_20923":55603,"_5":14374,"_27449":55534,"_2949":55604},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3465":2037,"_30211":2011,"_20923":55606,"_5":14374,"_27449":55534,"_2949":55607},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3465":2038,"_30211":2011,"_20923":55609,"_5":14374,"_27449":55534,"_2949":55610},[],"For browser key generation, follow Issue your first certificate.",{"_3465":2039,"_30211":2011,"_20923":55612,"_5":14374,"_27449":55538,"_2949":55613},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3465":2040,"_30211":2011,"_20923":55615,"_5":14374,"_27449":55542,"_2949":55616},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3465":2041,"_30211":2011,"_20923":55618,"_5":14374,"_27449":55546,"_2949":55619},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3465":2042,"_30211":2011,"_20923":55621,"_5":14374,"_27449":55550,"_2949":55622},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3465":2043,"_30211":2011,"_20923":55624,"_5":14374,"_27449":55550,"_2949":55625},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3465":2044,"_30211":2011,"_20923":55627,"_5":14374,"_27449":55550,"_2949":55628},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3465":2045,"_30211":2011,"_20923":55630,"_5":14374,"_27449":55554,"_2949":55631},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3465":2046,"_30211":2011,"_20923":55633,"_5":14374,"_27449":55554,"_2949":55634},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3465":2047,"_30211":2011,"_20923":55636,"_5":14374,"_27449":55554,"_2949":55637},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3465":2048,"_30211":2011,"_20923":55639,"_5":14374,"_27449":55558,"_2949":55640},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":2049,"_30211":2011,"_20923":55642,"_5":14374,"_27449":55558,"_2949":55643},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3465":2050,"_30211":2050,"_5":14726,"_2949":55645,"_30563":55646,"_20923":55648,"_27449":2050},"Certificate lifecycle",[49273,50748,54753,55647],"Concepts",[],{"_3465":2051,"_30211":2050,"_20923":55650,"_5":14374,"_27449":2050,"_2949":55651},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3465":2052,"_30211":2050,"_5":30560,"_20923":55653,"_27449":55654,"_2949":55655},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3465":2053,"_30211":2050,"_5":30560,"_20923":55657,"_27449":55658,"_2949":55659},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3465":2054,"_30211":2050,"_5":30560,"_20923":55661,"_27449":55662,"_2949":55663},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3465":2055,"_30211":2050,"_5":30560,"_20923":55665,"_27449":55666,"_2949":55667},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3465":2056,"_30211":2050,"_5":30560,"_20923":55669,"_27449":55670,"_2949":55671},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3465":2057,"_30211":2050,"_5":30560,"_20923":55673,"_27449":55674,"_2949":55675},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3465":2058,"_30211":2050,"_5":30560,"_20923":55677,"_27449":55678,"_2949":55679},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3465":2059,"_30211":2050,"_5":30560,"_20923":55681,"_27449":55682,"_2949":55683},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3465":2060,"_30211":2050,"_5":30560,"_20923":55685,"_27449":55686,"_2949":55687},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3465":2061,"_30211":2050,"_5":30560,"_20923":55689,"_27449":55690,"_2949":55691},[],"/docs/pr-preview/pr-67/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3465":2062,"_30211":2050,"_20923":55693,"_5":14374,"_27449":2050,"_2949":55694},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3465":2063,"_30211":2050,"_20923":55696,"_5":14374,"_27449":55658,"_2949":55697},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3465":2064,"_30211":2050,"_20923":55699,"_5":14374,"_27449":55662,"_2949":55700},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3465":2065,"_30211":2050,"_20923":55702,"_5":14374,"_27449":55666,"_2949":55703},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3465":2066,"_30211":2050,"_20923":55705,"_5":14374,"_27449":55670,"_2949":55706},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3465":2067,"_30211":2050,"_20923":55708,"_5":14374,"_27449":55674,"_2949":55709},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3465":2068,"_30211":2050,"_20923":55711,"_5":14374,"_27449":55678,"_2949":55712},[],"Lamassu persists four X.509 states:",{"_3465":2069,"_30211":2050,"_20923":55714,"_5":14374,"_27449":55678,"_2949":55715},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3465":2070,"_30211":2050,"_20923":55717,"_5":14374,"_27449":55678,"_2949":55718},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3465":2071,"_30211":2050,"_20923":55720,"_5":14374,"_27449":55678,"_2949":55721},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3465":2072,"_30211":2050,"_20923":55723,"_5":14374,"_27449":55678,"_2949":55724},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3465":2073,"_30211":2050,"_20923":55726,"_5":14374,"_27449":55678,"_2949":55727},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3465":2074,"_30211":2050,"_20923":55729,"_5":14374,"_27449":55682,"_2949":55730},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3465":2075,"_30211":2050,"_20923":55732,"_5":14374,"_27449":55682,"_2949":55733},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3465":2076,"_30211":2050,"_20923":55735,"_5":14374,"_27449":55682,"_2949":55736},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3465":2077,"_30211":2050,"_20923":55738,"_5":14374,"_27449":55686,"_2949":55739},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3465":2078,"_30211":2050,"_20923":55741,"_5":14374,"_27449":55686,"_2949":55742},[],"Before confirming:",{"_3465":2079,"_30211":2050,"_20923":55744,"_5":14374,"_27449":55686,"_2949":55745},[],"Identify DMSs, devices and services that trust that chain.",{"_3465":2080,"_30211":2050,"_20923":55747,"_5":14374,"_27449":55686,"_2949":55748},[],"Distribute the new chain of trust.",{"_3465":2081,"_30211":2050,"_20923":55750,"_5":14374,"_27449":55686,"_2949":55751},[],"Reissue the necessary identities.",{"_3465":2082,"_30211":2050,"_20923":55753,"_5":14374,"_27449":55686,"_2949":55754},[],"Check OCSP and CRL from a real consumer.",{"_3465":2083,"_30211":2050,"_20923":55756,"_5":14374,"_27449":55686,"_2949":55757},[],"Revoke the old CA once no legitimate traffic remains.",{"_3465":2084,"_30211":2050,"_20923":55759,"_5":14374,"_27449":55686,"_2949":55760},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3465":2085,"_30211":2050,"_20923":55762,"_5":14374,"_27449":55690,"_2949":55763},[],"Certificates entering the preventive or critical renewal window.",{"_3465":2086,"_30211":2050,"_20923":55765,"_5":14374,"_27449":55690,"_2949":55766},[],"Repeated enrollment or re-enrollment failures.",{"_3465":2087,"_30211":2050,"_20923":55768,"_5":14374,"_27449":55690,"_2949":55769},[],"Status changes and revocation reasons.",{"_3465":2088,"_30211":2050,"_20923":55771,"_5":14374,"_27449":55690,"_2949":55772},[],"OCSP and CRL publication and validity.",{"_3465":2089,"_30211":2050,"_20923":55774,"_5":14374,"_27449":55690,"_2949":55775},[],"Dependencies still presenting a replaced certificate.",{"_3465":2090,"_30211":2050,"_20923":55777,"_5":14374,"_27449":55690,"_2949":55778},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3465":2091,"_30211":2091,"_5":14726,"_2949":55780,"_30563":55781,"_20923":55782,"_27449":2091},"Trust model",[49273,50748,54753,55647],[],{"_3465":2092,"_30211":2091,"_20923":55784,"_5":14374,"_27449":2091,"_2949":55785},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3465":2093,"_30211":2091,"_5":30560,"_20923":55787,"_27449":55788,"_2949":55789},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3465":2094,"_30211":2091,"_5":30560,"_20923":55791,"_27449":55792,"_2949":55793},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3465":2095,"_30211":2091,"_5":30560,"_20923":55795,"_27449":55796,"_2949":55797},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3465":2096,"_30211":2091,"_5":30560,"_20923":55799,"_27449":55800,"_2949":55801},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3465":2097,"_30211":2091,"_5":30560,"_20923":55803,"_27449":55804,"_2949":55805},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3465":2098,"_30211":2091,"_5":30560,"_20923":55807,"_27449":55808,"_2949":55809},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3465":2099,"_30211":2091,"_5":30560,"_20923":55811,"_27449":55812,"_2949":55813},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3465":2100,"_30211":2091,"_5":30560,"_20923":55815,"_27449":55816,"_2949":55817},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3465":2101,"_30211":2091,"_5":30560,"_20923":55819,"_27449":55820,"_2949":55821},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3465":2102,"_30211":2091,"_5":30560,"_20923":55823,"_27449":55824,"_2949":55825},[],"/docs/pr-preview/pr-67/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3465":2103,"_30211":2091,"_20923":55827,"_5":14374,"_27449":2091,"_2949":55828},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3465":2104,"_30211":2091,"_20923":55830,"_5":14374,"_27449":55792,"_2949":55831},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3465":2105,"_30211":2091,"_20923":55833,"_5":14374,"_27449":55796,"_2949":55834},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3465":2106,"_30211":2091,"_20923":55836,"_5":14374,"_27449":55800,"_2949":55837},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3465":2107,"_30211":2091,"_20923":55839,"_5":14374,"_27449":55804,"_2949":55840},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3465":2108,"_30211":2091,"_20923":55842,"_5":14374,"_27449":55808,"_2949":55843},[],"The device proves it can enroll according to the DMS policy.",{"_3465":2109,"_30211":2091,"_20923":55845,"_5":14374,"_27449":55808,"_2949":55846},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3465":2110,"_30211":2091,"_20923":55848,"_5":14374,"_27449":55808,"_2949":55849},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3465":2111,"_30211":2091,"_20923":55851,"_5":14374,"_27449":55808,"_2949":55852},[],"The device installs the certificate and the chain it needs.",{"_3465":2112,"_30211":2091,"_20923":55854,"_5":14374,"_27449":55808,"_2949":55855},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3465":2113,"_30211":2091,"_20923":55857,"_5":14374,"_27449":55808,"_2949":55858},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3465":2114,"_30211":2091,"_20923":55860,"_5":14374,"_27449":55812,"_2949":55861},[],"A DMS relates three sets that are worth designing separately:",{"_3465":2115,"_30211":2091,"_20923":55863,"_5":14374,"_27449":55812,"_2949":55864},[],"**Enrollment CA:** signs the new identities.",{"_3465":2116,"_30211":2091,"_20923":55866,"_5":14374,"_27449":55812,"_2949":55867},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3465":2117,"_30211":2091,"_20923":55869,"_5":14374,"_27449":55812,"_2949":55870},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3465":2118,"_30211":2091,"_20923":55872,"_5":14374,"_27449":55812,"_2949":55873},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3465":2119,"_30211":2091,"_20923":55875,"_5":14374,"_27449":55816,"_2949":55876},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3465":2120,"_30211":2091,"_20923":55878,"_5":14374,"_27449":55816,"_2949":55879},[],"that the current date is between `Not Before` and `Not After`;",{"_3465":2121,"_30211":2091,"_20923":55881,"_5":14374,"_27449":55816,"_2949":55882},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3465":2122,"_30211":2091,"_20923":55884,"_5":14374,"_27449":55816,"_2949":55885},[],"that names, SANs and subject match the expected identity;",{"_3465":2123,"_30211":2091,"_20923":55887,"_5":14374,"_27449":55816,"_2949":55888},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3465":2124,"_30211":2091,"_20923":55890,"_5":14374,"_27449":55816,"_2949":55891},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3465":2125,"_30211":2091,"_20923":55893,"_5":14374,"_27449":55816,"_2949":55894},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3465":2126,"_30211":2091,"_20923":55896,"_5":14374,"_27449":55820,"_2949":55897},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3465":2127,"_30211":2091,"_20923":55899,"_5":14374,"_27449":55824,"_2949":55900},[],"Keep the root out of daily operations, or with very restricted access.",{"_3465":2128,"_30211":2091,"_20923":55902,"_5":14374,"_27449":55824,"_2949":55903},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3465":2129,"_30211":2091,"_20923":55905,"_5":14374,"_27449":55824,"_2949":55906},[],"Assign explicit profiles to every use case.",{"_3465":2130,"_30211":2091,"_20923":55908,"_5":14374,"_27449":55824,"_2949":55909},[],"Distribute the new trust before starting a rotation.",{"_3465":2131,"_30211":2091,"_20923":55911,"_5":14374,"_27449":55824,"_2949":55912},[],"Keep enough overlap to renew a disconnected fleet.",{"_3465":2132,"_30211":2091,"_20923":55914,"_5":14374,"_27449":55824,"_2949":55915},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3465":2133,"_30211":2091,"_20923":55917,"_5":14374,"_27449":55824,"_2949":55918},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3465":2134,"_30211":2134,"_5":14726,"_2949":55920,"_30563":55921,"_20923":55922,"_27449":2134},"Revocation lists (CRL)",[49273,50748,54753,55392],[],{"_3465":2135,"_30211":2134,"_20923":55924,"_5":14374,"_27449":2134,"_2949":55925},[],"Generate and distribute signed lists to validate certificates offline.",{"_3465":2136,"_30211":2134,"_5":30560,"_20923":55927,"_27449":55928,"_2949":55929},[],"/docs/pr-preview/pr-67/platform/pki/crl#crl-settings","CRL settings",{"_3465":2137,"_30211":2134,"_5":30560,"_20923":55931,"_27449":55932,"_2949":55933},[],"/docs/pr-preview/pr-67/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3465":2138,"_30211":2134,"_5":30560,"_20923":55935,"_27449":55936,"_2949":55937},[],"/docs/pr-preview/pr-67/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3465":2139,"_30211":2134,"_5":30560,"_20923":55939,"_27449":55940,"_2949":55941},[],"/docs/pr-preview/pr-67/platform/pki/crl#crl-contents","CRL contents",{"_3465":2140,"_30211":2134,"_5":30560,"_20923":55943,"_27449":55944,"_2949":55945},[],"/docs/pr-preview/pr-67/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3465":2141,"_30211":2134,"_5":30560,"_20923":55947,"_27449":55948,"_2949":55949},[],"/docs/pr-preview/pr-67/platform/pki/crl#crl-settings-api","CRL settings API",{"_3465":2142,"_30211":2134,"_5":30560,"_20923":55951,"_27449":55952,"_2949":55953},[],"/docs/pr-preview/pr-67/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3465":2143,"_30211":2134,"_5":30560,"_20923":55955,"_27449":55956,"_2949":55957},[],"/docs/pr-preview/pr-67/platform/pki/crl#references","References",{"_3465":2144,"_30211":2134,"_20923":55959,"_5":14374,"_27449":2134,"_2949":55960},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3465":2145,"_30211":2134,"_20923":55962,"_5":14374,"_27449":55928,"_2949":55963},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3465":2146,"_30211":2134,"_20923":55965,"_5":14374,"_27449":55928,"_2949":55966},[],"Field",{"_3465":2147,"_30211":2134,"_20923":55968,"_5":14374,"_27449":55928,"_2949":49663},[],{"_3465":2148,"_30211":2134,"_20923":55970,"_5":14374,"_27449":55928,"_2949":55971},[],"`ca_id`",{"_3465":2149,"_30211":2134,"_20923":55973,"_5":14374,"_27449":55928,"_2949":55974},[],"ID of the CA the settings belong to.",{"_3465":2150,"_30211":2134,"_20923":55976,"_5":14374,"_27449":55928,"_2949":55977},[],"`status`",{"_3465":2151,"_30211":2134,"_20923":55979,"_5":14374,"_27449":55928,"_2949":55980},[],"`ACTIVE` settings generate CRLs. `FINAL` ones belong to a CA that was revoked or has expired: its final CRL, if any, is published and no new one is generated. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3465":2152,"_30211":2134,"_20923":55982,"_5":14374,"_27449":55928,"_2949":55983},[],"`legacy_ski`",{"_3465":2153,"_30211":2134,"_20923":55985,"_5":14374,"_27449":55928,"_2949":55986},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3465":2154,"_30211":2134,"_20923":55988,"_5":14374,"_27449":55928,"_2949":55989},[],"`latest_crl`",{"_3465":2155,"_30211":2134,"_20923":55991,"_5":14374,"_27449":55928,"_2949":55992},[],"Version, validity start and end of the last published list. Read-only.",{"_3465":2156,"_30211":2134,"_20923":55994,"_5":14374,"_27449":55928,"_2949":55995},[],"`crl_options` field",{"_3465":2157,"_30211":2134,"_20923":55997,"_5":14374,"_27449":55928,"_2949":49663},[],{"_3465":2158,"_30211":2134,"_20923":55999,"_5":14374,"_27449":55928,"_2949":56000},[],"Initial value",{"_3465":2159,"_30211":2134,"_20923":56002,"_5":14374,"_27449":55928,"_2949":56003},[],"`validity`",{"_3465":2160,"_30211":2134,"_20923":56005,"_5":14374,"_27449":55928,"_2949":56006},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3465":2161,"_30211":2134,"_20923":56008,"_5":14374,"_27449":55928,"_2949":56009},[],"7 days.",{"_3465":2162,"_30211":2134,"_20923":56011,"_5":14374,"_27449":55928,"_2949":56012},[],"`refresh_interval`",{"_3465":2163,"_30211":2134,"_20923":56014,"_5":14374,"_27449":55928,"_2949":56015},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3465":2164,"_30211":2134,"_20923":56017,"_5":14374,"_27449":55928,"_2949":56018},[],"6 days and 23 hours.",{"_3465":2165,"_30211":2134,"_20923":56020,"_5":14374,"_27449":55928,"_2949":56021},[],"`regenerate_on_revoke`",{"_3465":2166,"_30211":2134,"_20923":56023,"_5":14374,"_27449":55928,"_2949":56024},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3465":2167,"_30211":2134,"_20923":56026,"_5":14374,"_27449":55928,"_2949":56027},[],"`true`.",{"_3465":2168,"_30211":2134,"_20923":56029,"_5":14374,"_27449":55928,"_2949":56030},[],"`signer_serial_number`",{"_3465":2169,"_30211":2134,"_20923":56032,"_5":14374,"_27449":55928,"_2949":56033},[],"Serial number of the existing certificate that signs the CRL.",{"_3465":2170,"_30211":2134,"_20923":56035,"_5":14374,"_27449":55928,"_2949":56036},[],"Serial number of the CA’s current certificate.",{"_3465":2171,"_30211":2134,"_20923":56038,"_5":14374,"_27449":55928,"_2949":56039},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3465":2172,"_30211":2134,"_20923":56041,"_5":14374,"_27449":55928,"_2949":56042},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3465":2173,"_30211":2134,"_20923":56044,"_5":14374,"_27449":55928,"_2949":56045},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3465":2174,"_30211":2134,"_20923":56047,"_5":14374,"_27449":55928,"_2949":56048},[],"Settings whose `status` is `FINAL` or `ARCHIVED` are read-only: any `PUT` returns 409. Deleting a CA keeps its CRL settings:",{"_3465":2175,"_30211":2134,"_20923":56050,"_5":14374,"_27449":55928,"_2949":56051},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated.",{"_3465":2176,"_30211":2134,"_20923":56053,"_5":14374,"_27449":55928,"_2949":56054},[],"`ARCHIVED` settings of a deleted CA can be deleted, with `DELETE` or from the console's Verification Authorities page. That CRL stops being served — anyone checking its certificates against it will no longer find it — while the CRLs already published remain in the bucket. The action cannot be undone.",{"_3465":2177,"_30211":2134,"_20923":56056,"_5":14374,"_27449":55928,"_2949":56057},[],"Adjust validity and signer before deleting a CA.",{"_3465":2178,"_30211":2134,"_20923":56059,"_5":14374,"_27449":55928,"_2949":56060},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3465":2179,"_30211":2134,"_20923":56062,"_5":14374,"_27449":55928,"_2949":56063},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3465":2180,"_30211":2134,"_20923":56065,"_5":14374,"_27449":55928,"_2949":56066},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3465":2181,"_30211":2134,"_20923":56068,"_5":14374,"_27449":55932,"_2949":56069},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3465":2182,"_30211":2134,"_20923":56071,"_5":14374,"_27449":55932,"_2949":56072},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3465":2183,"_30211":2134,"_20923":56074,"_5":14374,"_27449":55932,"_2949":56075},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3465":2184,"_30211":2134,"_20923":56077,"_5":14374,"_27449":55932,"_2949":56078},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3465":2185,"_30211":2134,"_20923":56080,"_5":14374,"_27449":55936,"_2949":56081},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3465":2186,"_30211":2134,"_20923":56083,"_5":14374,"_27449":55936,"_2949":56084},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3465":2187,"_30211":2134,"_20923":56086,"_5":14374,"_27449":55936,"_2949":56087},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3465":2188,"_30211":2134,"_20923":56089,"_5":14374,"_27449":55936,"_2949":56090},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3465":2189,"_30211":2134,"_20923":56092,"_5":14374,"_27449":55936,"_2949":56093},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3465":2190,"_30211":2134,"_20923":56095,"_5":14374,"_27449":55936,"_2949":56096},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3465":2191,"_30211":2134,"_20923":56098,"_5":14374,"_27449":55936,"_2949":56099},[],"Settings whose `status` is `FINAL` or `ARCHIVED` are skipped: nothing regenerates their CRL.",{"_3465":2192,"_30211":2134,"_20923":56101,"_5":14374,"_27449":55936,"_2949":56102},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3465":2193,"_30211":2134,"_20923":56104,"_5":14374,"_27449":55936,"_2949":56105},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3465":2194,"_30211":2134,"_20923":56107,"_5":14374,"_27449":55940,"_2949":56108},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3465":2195,"_30211":2134,"_20923":56110,"_5":14374,"_27449":55940,"_2949":56111},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3465":2196,"_30211":2134,"_20923":56113,"_5":14374,"_27449":55944,"_2949":56114},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3465":2197,"_30211":2134,"_20923":56116,"_5":14374,"_27449":55944,"_2949":56117},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3465":2198,"_30211":2134,"_20923":56119,"_5":14374,"_27449":55944,"_2949":56120},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3465":2199,"_30211":2134,"_20923":56122,"_5":14374,"_27449":55944,"_2949":56123},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3465":2200,"_30211":2134,"_20923":56125,"_5":14374,"_27449":55944,"_2949":56126},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3465":2201,"_30211":2134,"_20923":56128,"_5":14374,"_27449":55948,"_2949":56129},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3465":2202,"_30211":2134,"_20923":56131,"_5":14374,"_27449":55948,"_2949":52518},[],{"_3465":2203,"_30211":2134,"_20923":56133,"_5":14374,"_27449":55948,"_2949":56134},[],"Relative path",{"_3465":2204,"_30211":2134,"_20923":56136,"_5":14374,"_27449":55948,"_2949":52515},[],{"_3465":2205,"_30211":2134,"_20923":56138,"_5":14374,"_27449":55948,"_2949":56139},[],"`GET`",{"_3465":2206,"_30211":2134,"_20923":56141,"_5":14374,"_27449":55948,"_2949":56142},[],"`/v1/crl-settings`",{"_3465":2207,"_30211":2134,"_20923":56144,"_5":14374,"_27449":55948,"_2949":56145},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3465":2208,"_30211":2134,"_20923":56147,"_5":14374,"_27449":55948,"_2949":56139},[],{"_3465":2209,"_30211":2134,"_20923":56149,"_5":14374,"_27449":55948,"_2949":56150},[],"`/v1/crl-settings/{ca-id}`",{"_3465":2210,"_30211":2134,"_20923":56152,"_5":14374,"_27449":55948,"_2949":56153},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3465":2211,"_30211":2134,"_20923":56155,"_5":14374,"_27449":55948,"_2949":56156},[],"`PUT`",{"_3465":2212,"_30211":2134,"_20923":56158,"_5":14374,"_27449":55948,"_2949":56150},[],{"_3465":2213,"_30211":2134,"_20923":56160,"_5":14374,"_27449":55948,"_2949":56161},[],"Replace the CRL configuration of a CA.",{"_3465":2214,"_30211":2134,"_20923":56163,"_5":14374,"_27449":55948,"_2949":56164},[],"`DELETE`",{"_3465":2215,"_30211":2134,"_20923":56166,"_5":14374,"_27449":55948,"_2949":56150},[],{"_3465":2216,"_30211":2134,"_20923":56168,"_5":14374,"_27449":55948,"_2949":56169},[],"Delete the settings of a CA whose settings are `ARCHIVED`; its published CRLs stay in the bucket but stop being served.",{"_3465":2217,"_30211":2134,"_20923":56171,"_5":14374,"_27449":55948,"_2949":56172},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation's API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL. A `DELETE` returns 409 unless the settings are `ARCHIVED`.",{"_3465":2218,"_30211":2134,"_20923":56174,"_5":14374,"_27449":55948,"_2949":56175},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3465":2219,"_30211":2134,"_20923":56177,"_5":14374,"_27449":55952,"_2949":56178},[],"Symptom",{"_3465":2220,"_30211":2134,"_20923":56180,"_5":14374,"_27449":55952,"_2949":56181},[],"Cause",{"_3465":2221,"_30211":2134,"_20923":56183,"_5":14374,"_27449":55952,"_2949":56184},[],"Action",{"_3465":2222,"_30211":2134,"_20923":56186,"_5":14374,"_27449":55952,"_2949":56187},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3465":2223,"_30211":2134,"_20923":56189,"_5":14374,"_27449":55952,"_2949":56190},[],"The settings are not `ACTIVE`: they are `FINAL` or `ARCHIVED` (see the `status` table in CRL settings).",{"_3465":2224,"_30211":2134,"_20923":56192,"_5":14374,"_27449":55952,"_2949":56193},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3465":2225,"_30211":2134,"_20923":56195,"_5":14374,"_27449":55952,"_2949":56196},[],"`PUT` returns 400.",{"_3465":2226,"_30211":2134,"_20923":56198,"_5":14374,"_27449":55952,"_2949":56199},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3465":2227,"_30211":2134,"_20923":56201,"_5":14374,"_27449":55952,"_2949":56202},[],"Set the serial number of a valid certificate of that CA.",{"_3465":2228,"_30211":2134,"_20923":56204,"_5":14374,"_27449":55952,"_2949":56205},[],"`PUT` returns 404.",{"_3465":2229,"_30211":2134,"_20923":56207,"_5":14374,"_27449":55952,"_2949":56208},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings (for example, an imported CA).",{"_3465":2230,"_30211":2134,"_20923":56210,"_5":14374,"_27449":55952,"_2949":56211},[],"Check the CA ID and the signer serial number.",{"_3465":2231,"_30211":2134,"_20923":56213,"_5":14374,"_27449":55952,"_2949":56214},[],"`PUT` returns 400 from a 3.x client.",{"_3465":2232,"_30211":2134,"_20923":56216,"_5":14374,"_27449":55952,"_2949":56217},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3465":2233,"_30211":2134,"_20923":56219,"_5":14374,"_27449":55952,"_2949":56220},[],"Update the client to send the new field.",{"_3465":2234,"_30211":2134,"_20923":56222,"_5":14374,"_27449":55952,"_2949":56223},[],"The CRL does not change after revoking a certificate.",{"_3465":2235,"_30211":2134,"_20923":56225,"_5":14374,"_27449":55952,"_2949":56226},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3465":2236,"_30211":2134,"_20923":56228,"_5":14374,"_27449":55952,"_2949":56229},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3465":2237,"_30211":2134,"_20923":56231,"_5":14374,"_27449":55952,"_2949":56232},[],"A verifier rejects the CRL because of the issuer.",{"_3465":2238,"_30211":2134,"_20923":56234,"_5":14374,"_27449":55952,"_2949":56235},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3465":2239,"_30211":2134,"_20923":56237,"_5":14374,"_27449":55952,"_2949":56238},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3465":2240,"_30211":2134,"_20923":56240,"_5":14374,"_27449":55956,"_2949":56241},[],"RFC 5280: X.509 and CRL profile.",{"_3465":2241,"_30211":2134,"_20923":56243,"_5":14374,"_27449":55956,"_2949":56244},[],"OpenSSL: openssl-crl.",{"_3465":2242,"_30211":2134,"_20923":56246,"_5":14374,"_27449":55956,"_2949":56247},[],"OpenSSL: openssl-verify.",{"_3465":2243,"_30211":2134,"_20923":56249,"_5":14374,"_27449":55956,"_2949":56250},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":2244,"_30211":2134,"_20923":56252,"_5":14374,"_27449":55956,"_2949":56253},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3465":2245,"_30211":2245,"_5":14726,"_2949":56255,"_30563":56256,"_20923":56257,"_27449":2245},"Keys and cryptographic engines",[49273,50748,54753,54754],[],{"_3465":2246,"_30211":2245,"_20923":56259,"_5":14374,"_27449":2245,"_2949":56260},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3465":2247,"_30211":2245,"_5":30560,"_20923":56262,"_27449":56263,"_2949":56264},[],"/docs/pr-preview/pr-67/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3465":2248,"_30211":2245,"_5":30560,"_20923":56266,"_27449":56267,"_2949":56268},[],"/docs/pr-preview/pr-67/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3465":2249,"_30211":2245,"_5":30560,"_20923":56270,"_27449":56271,"_2949":56272},[],"/docs/pr-preview/pr-67/platform/pki/key-management#file-system","File System",{"_3465":2250,"_30211":2245,"_5":30560,"_20923":56274,"_27449":56275,"_2949":56276},[],"/docs/pr-preview/pr-67/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3465":2251,"_30211":2245,"_5":30560,"_20923":56278,"_27449":56279,"_2949":56280},[],"/docs/pr-preview/pr-67/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3465":2252,"_30211":2245,"_5":30560,"_20923":56282,"_27449":56283,"_2949":56284},[],"/docs/pr-preview/pr-67/platform/pki/key-management#aws-kms","AWS KMS",{"_3465":2253,"_30211":2245,"_5":30560,"_20923":56286,"_27449":56287,"_2949":56288},[],"/docs/pr-preview/pr-67/platform/pki/key-management#pkcs11","PKCS#11",{"_3465":2254,"_30211":2245,"_5":30560,"_20923":56290,"_27449":56291,"_2949":56292},[],"/docs/pr-preview/pr-67/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3465":2255,"_30211":2245,"_5":30560,"_20923":56294,"_27449":56295,"_2949":56296},[],"/docs/pr-preview/pr-67/platform/pki/key-management#key-inventory","Key inventory",{"_3465":2256,"_30211":2245,"_5":30560,"_20923":56298,"_27449":56299,"_2949":56300},[],"/docs/pr-preview/pr-67/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3465":2257,"_30211":2245,"_5":30560,"_20923":56302,"_27449":56303,"_2949":56304},[],"/docs/pr-preview/pr-67/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3465":2258,"_30211":2245,"_5":30560,"_20923":56306,"_27449":56307,"_2949":56308},[],"/docs/pr-preview/pr-67/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3465":2259,"_30211":2245,"_5":30560,"_20923":56310,"_27449":56311,"_2949":56312},[],"/docs/pr-preview/pr-67/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3465":2260,"_30211":2245,"_5":30560,"_20923":56314,"_27449":56315,"_2949":56316},[],"/docs/pr-preview/pr-67/platform/pki/key-management#view-details","View details",{"_3465":2261,"_30211":2245,"_5":30560,"_20923":56318,"_27449":56319,"_2949":56320},[],"/docs/pr-preview/pr-67/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3465":2262,"_30211":2245,"_5":30560,"_20923":56322,"_27449":56323,"_2949":56324},[],"/docs/pr-preview/pr-67/platform/pki/key-management#sign","Sign",{"_3465":2263,"_30211":2245,"_5":30560,"_20923":56326,"_27449":56327,"_2949":56328},[],"/docs/pr-preview/pr-67/platform/pki/key-management#verify","Verify",{"_3465":2264,"_30211":2245,"_5":30560,"_20923":56330,"_27449":56331,"_2949":56332},[],"/docs/pr-preview/pr-67/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3465":2265,"_30211":2245,"_5":30560,"_20923":56334,"_27449":56335,"_2949":56336},[],"/docs/pr-preview/pr-67/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3465":2266,"_30211":2245,"_5":30560,"_20923":56338,"_27449":56339,"_2949":56340},[],"/docs/pr-preview/pr-67/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3465":2267,"_30211":2245,"_20923":56342,"_5":14374,"_27449":2245,"_2949":56343},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3465":2268,"_30211":2245,"_20923":56345,"_5":14374,"_27449":2245,"_2949":56346},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3465":2269,"_30211":2245,"_20923":56348,"_5":14374,"_27449":56263,"_2949":56349},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3465":2270,"_30211":2245,"_20923":56351,"_5":14374,"_27449":56263,"_2949":56352},[],"In practice, it lets you:",{"_3465":2271,"_30211":2245,"_20923":56354,"_5":14374,"_27449":56263,"_2949":56355},[],"Generate new key pairs from Lamassu IoT.",{"_3465":2272,"_30211":2245,"_20923":56357,"_5":14374,"_27449":56263,"_2949":56358},[],"Import keys created externally.",{"_3465":2273,"_30211":2245,"_20923":56360,"_5":14374,"_27449":56263,"_2949":56361},[],"Delegate custody and cryptographic operations to external engines.",{"_3465":2274,"_30211":2245,"_20923":56363,"_5":14374,"_27449":56263,"_2949":56364},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3465":2275,"_30211":2245,"_20923":56366,"_5":14374,"_27449":56267,"_2949":56367},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3465":2276,"_30211":2245,"_20923":56369,"_5":14374,"_27449":56267,"_2949":56370},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3465":2277,"_30211":2245,"_20923":56372,"_5":14374,"_27449":56267,"_2949":56373},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3465":2278,"_30211":2245,"_20923":56375,"_5":14374,"_27449":56271,"_2949":56376},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3465":2279,"_30211":2245,"_20923":56378,"_5":14374,"_27449":56275,"_2949":56379},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3465":2280,"_30211":2245,"_20923":56381,"_5":14374,"_27449":56275,"_2949":56382},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3465":2281,"_30211":2245,"_20923":56384,"_5":14374,"_27449":56279,"_2949":56385},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3465":2282,"_30211":2245,"_20923":56387,"_5":14374,"_27449":56283,"_2949":56388},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3465":2283,"_30211":2245,"_20923":56390,"_5":14374,"_27449":56287,"_2949":56391},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3465":2284,"_30211":2245,"_20923":56393,"_5":14374,"_27449":56291,"_2949":56394},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3465":2285,"_30211":2245,"_20923":56396,"_5":14374,"_27449":56291,"_2949":56397},[],"Lamassu shows the enabled engines in the console.",{"_3465":2286,"_30211":2245,"_20923":56399,"_5":14374,"_27449":56291,"_2949":56400},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3465":2287,"_30211":2245,"_20923":56402,"_5":14374,"_27449":56291,"_2949":56403},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3465":2288,"_30211":2245,"_20923":56405,"_5":14374,"_27449":56295,"_2949":56406},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3465":2289,"_30211":2245,"_20923":56408,"_5":14374,"_27449":56295,"_2949":56409},[],"The table includes the following fields:",{"_3465":2290,"_30211":2245,"_20923":56411,"_5":14374,"_27449":56295,"_2949":56412},[],"**Name**: descriptive name of the key.",{"_3465":2291,"_30211":2245,"_20923":56414,"_5":14374,"_27449":56295,"_2949":56415},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3465":2292,"_30211":2245,"_20923":56417,"_5":14374,"_27449":56295,"_2949":56418},[],"**Strength**: visual indicator of cryptographic strength.",{"_3465":2293,"_30211":2245,"_20923":56420,"_5":14374,"_27449":56295,"_2949":56421},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3465":2294,"_30211":2245,"_20923":56423,"_5":14374,"_27449":56295,"_2949":56424},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3465":2295,"_30211":2245,"_20923":56426,"_5":14374,"_27449":56295,"_2949":56427},[],"**Aliases**: alternative names associated with the key.",{"_3465":2296,"_30211":2245,"_20923":56429,"_5":14374,"_27449":56295,"_2949":56430},[],"**Tags**: labels for classification and search.",{"_3465":2297,"_30211":2245,"_20923":56432,"_5":14374,"_27449":56295,"_2949":56433},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3465":2298,"_30211":2245,"_20923":56435,"_5":14374,"_27449":56295,"_2949":56436},[],"From this view you also reach the most common actions:",{"_3465":2299,"_30211":2245,"_20923":56438,"_5":14374,"_27449":56295,"_2949":56439},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3465":2300,"_30211":2245,"_20923":56441,"_5":14374,"_27449":56295,"_2949":56442},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3465":2301,"_30211":2245,"_20923":56444,"_5":14374,"_27449":56295,"_2949":56445},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3465":2302,"_30211":2245,"_20923":56447,"_5":14374,"_27449":56295,"_2949":56448},[],"**Delete Key** to remove the key from the system.",{"_3465":2303,"_30211":2245,"_20923":56450,"_5":14374,"_27449":56299,"_2949":56451},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3465":2304,"_30211":2245,"_20923":56453,"_5":14374,"_27449":56303,"_2949":56454},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3465":2305,"_30211":2245,"_20923":56456,"_5":14374,"_27449":56303,"_2949":56457},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3465":2306,"_30211":2245,"_20923":56459,"_5":14374,"_27449":56303,"_2949":56460},[],"**Key Name**: unique and descriptive name.",{"_3465":2307,"_30211":2245,"_20923":56462,"_5":14374,"_27449":56303,"_2949":56463},[],"**Crypto Engine**: engine that will keep the key.",{"_3465":2308,"_30211":2245,"_20923":56465,"_5":14374,"_27449":56303,"_2949":56466},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3465":2309,"_30211":2245,"_20923":56468,"_5":14374,"_27449":56303,"_2949":56469},[],"**Tags**: metadata to classify the key.",{"_3465":2310,"_30211":2245,"_20923":56471,"_5":14374,"_27449":56303,"_2949":56472},[],"**Metadata**: additional information for advanced uses.",{"_3465":2311,"_30211":2245,"_20923":56474,"_5":14374,"_27449":56307,"_2949":56475},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3465":2312,"_30211":2245,"_20923":56477,"_5":14374,"_27449":56307,"_2949":56478},[],"When you have an exportable private key and the destination engine supports import.",{"_3465":2313,"_30211":2245,"_20923":56480,"_5":14374,"_27449":56307,"_2949":56481},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3465":2314,"_30211":2245,"_20923":56483,"_5":14374,"_27449":56307,"_2949":56484},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3465":2315,"_30211":2245,"_20923":56486,"_5":14374,"_27449":56307,"_2949":56487},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3465":2316,"_30211":2245,"_20923":56489,"_5":14374,"_27449":56307,"_2949":56490},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3465":2317,"_30211":2245,"_20923":56492,"_5":14374,"_27449":56307,"_2949":56493},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3465":2318,"_30211":2245,"_20923":56495,"_5":14374,"_27449":56307,"_2949":56496},[],"**Tags**: labels for organization and search.",{"_3465":2319,"_30211":2245,"_20923":56498,"_5":14374,"_27449":56307,"_2949":56499},[],"**Metadata**: additional optional information.",{"_3465":2320,"_30211":2245,"_20923":56501,"_5":14374,"_27449":56307,"_2949":56502},[],"**Private Key (PEM)**: private key in PEM format.",{"_3465":2321,"_30211":2245,"_20923":56504,"_5":14374,"_27449":56307,"_2949":56505},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3465":2322,"_30211":2245,"_20923":56507,"_5":14374,"_27449":56311,"_2949":56508},[],"Each registered key has a detail view and several operational actions.",{"_3465":2323,"_30211":2245,"_20923":56510,"_5":14374,"_27449":56315,"_2949":56511},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3465":2324,"_30211":2245,"_20923":56513,"_5":14374,"_27449":56315,"_2949":56514},[],"The **Overview** tab shows, among others, these fields:",{"_3465":2325,"_30211":2245,"_20923":56516,"_5":14374,"_27449":56315,"_2949":56517},[],"**Key Name**: descriptive name.",{"_3465":2326,"_30211":2245,"_20923":56519,"_5":14374,"_27449":56315,"_2949":56520},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3465":2327,"_30211":2245,"_20923":56522,"_5":14374,"_27449":56315,"_2949":56523},[],"**Tags**: associated labels.",{"_3465":2328,"_30211":2245,"_20923":56525,"_5":14374,"_27449":56315,"_2949":56526},[],"**Aliases**: alternative names.",{"_3465":2329,"_30211":2245,"_20923":56528,"_5":14374,"_27449":56315,"_2949":56529},[],"**Crypto Engine**: engine where the key resides.",{"_3465":2330,"_30211":2245,"_20923":56531,"_5":14374,"_27449":56315,"_2949":56532},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3465":2331,"_30211":2245,"_20923":56534,"_5":14374,"_27449":56315,"_2949":56535},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3465":2332,"_30211":2245,"_20923":56537,"_5":14374,"_27449":56315,"_2949":56538},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3465":2333,"_30211":2245,"_20923":56540,"_5":14374,"_27449":56319,"_2949":56541},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3465":2334,"_30211":2245,"_20923":56543,"_5":14374,"_27449":56319,"_2949":56544},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3465":2335,"_30211":2245,"_20923":56546,"_5":14374,"_27449":56319,"_2949":56547},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3465":2336,"_30211":2245,"_20923":56549,"_5":14374,"_27449":56323,"_2949":56550},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3465":2337,"_30211":2245,"_20923":56552,"_5":14374,"_27449":56323,"_2949":56553},[],"Main fields:",{"_3465":2338,"_30211":2245,"_20923":56555,"_5":14374,"_27449":56323,"_2949":56556},[],"**Algorithm**: signing algorithm available for the key type.",{"_3465":2339,"_30211":2245,"_20923":56558,"_5":14374,"_27449":56323,"_2949":56559},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3465":2340,"_30211":2245,"_20923":56561,"_5":14374,"_27449":56323,"_2949":56562},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3465":2341,"_30211":2245,"_20923":56564,"_5":14374,"_27449":56323,"_2949":56565},[],"**Message**: content to sign.",{"_3465":2342,"_30211":2245,"_20923":56567,"_5":14374,"_27449":56323,"_2949":56568},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3465":2343,"_30211":2245,"_20923":56570,"_5":14374,"_27449":56327,"_2949":56571},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3465":2344,"_30211":2245,"_20923":56573,"_5":14374,"_27449":56327,"_2949":56553},[],{"_3465":2345,"_30211":2245,"_20923":56575,"_5":14374,"_27449":56327,"_2949":56576},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3465":2346,"_30211":2245,"_20923":56578,"_5":14374,"_27449":56327,"_2949":56579},[],"**Message Type**: `Raw` or `Digest`.",{"_3465":2347,"_30211":2245,"_20923":56581,"_5":14374,"_27449":56327,"_2949":56582},[],"**Payload Encoding**: encoding of the message.",{"_3465":2348,"_30211":2245,"_20923":56584,"_5":14374,"_27449":56327,"_2949":56585},[],"**Message**: original message or hash.",{"_3465":2349,"_30211":2245,"_20923":56587,"_5":14374,"_27449":56327,"_2949":56588},[],"**Signature**: signature to check.",{"_3465":2350,"_30211":2245,"_20923":56590,"_5":14374,"_27449":56327,"_2949":56591},[],"**Result**: indicator of the validation result.",{"_3465":2351,"_30211":2245,"_20923":56593,"_5":14374,"_27449":56331,"_2949":56594},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3465":2352,"_30211":2245,"_20923":56596,"_5":14374,"_27449":56331,"_2949":56597},[],"This flow is useful for:",{"_3465":2353,"_30211":2245,"_20923":56599,"_5":14374,"_27449":56331,"_2949":56600},[],"Requesting certificates from an external CA.",{"_3465":2354,"_30211":2245,"_20923":56602,"_5":14374,"_27449":56331,"_2949":56603},[],"Renewing an identity while keeping the same key.",{"_3465":2355,"_30211":2245,"_20923":56605,"_5":14374,"_27449":56331,"_2949":56606},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3465":2356,"_30211":2245,"_20923":56608,"_5":14374,"_27449":56331,"_2949":56609},[],"**Common Name (CN)**: main name of the identity.",{"_3465":2357,"_30211":2245,"_20923":56611,"_5":14374,"_27449":56331,"_2949":56612},[],"**Organization (O)**: organization or company.",{"_3465":2358,"_30211":2245,"_20923":56614,"_5":14374,"_27449":56331,"_2949":56615},[],"**Organizational Unit (OU)**: department or unit.",{"_3465":2359,"_30211":2245,"_20923":56617,"_5":14374,"_27449":56331,"_2949":56618},[],"**Country (C)**: two-letter country code.",{"_3465":2360,"_30211":2245,"_20923":56620,"_5":14374,"_27449":56331,"_2949":56621},[],"**State / Province (ST)**: state or province.",{"_3465":2361,"_30211":2245,"_20923":56623,"_5":14374,"_27449":56331,"_2949":56624},[],"**Locality (L)**: city or locality.",{"_3465":2362,"_30211":2245,"_20923":56626,"_5":14374,"_27449":56331,"_2949":56627},[],"**Email Address**: contact email.",{"_3465":2363,"_30211":2245,"_20923":56629,"_5":14374,"_27449":56331,"_2949":56630},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3465":2364,"_30211":2245,"_20923":56632,"_5":14374,"_27449":56331,"_2949":56633},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3465":2365,"_30211":2245,"_20923":56635,"_5":14374,"_27449":56335,"_2949":56636},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3465":2366,"_30211":2245,"_20923":56638,"_5":14374,"_27449":56335,"_2949":56639},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3465":2367,"_30211":2245,"_20923":56641,"_5":14374,"_27449":56339,"_2949":56642},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3465":2368,"_30211":2245,"_20923":56644,"_5":14374,"_27449":56339,"_2949":56645},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3465":2369,"_30211":2369,"_5":14726,"_2949":56647,"_30563":56648,"_20923":56649,"_27449":2369},"Online validation with OCSP",[49273,50748,54753,55392],[],{"_3465":2370,"_30211":2369,"_20923":56651,"_5":14374,"_27449":2369,"_2949":56652},[],"Query signed status and verify the responder’s response.",{"_3465":2371,"_30211":2369,"_5":30560,"_20923":56654,"_27449":56655,"_2949":56656},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3465":2372,"_30211":2369,"_5":30560,"_20923":56658,"_27449":56659,"_2949":56660},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3465":2373,"_30211":2369,"_5":30560,"_20923":56662,"_27449":56663,"_2949":56664},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3465":2374,"_30211":2369,"_5":30560,"_20923":56666,"_27449":56667,"_2949":56668},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3465":2375,"_30211":2369,"_5":30560,"_20923":56670,"_27449":56671,"_2949":56672},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3465":2376,"_30211":2369,"_5":30560,"_20923":56674,"_27449":56675,"_2949":55957},[],"/docs/pr-preview/pr-67/platform/pki/ocsp#references",{"_3465":2377,"_30211":2369,"_20923":56677,"_5":14374,"_27449":2369,"_2949":56678},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3465":2378,"_30211":2369,"_20923":56680,"_5":14374,"_27449":56655,"_2949":56681},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3465":2379,"_30211":2369,"_20923":56683,"_5":14374,"_27449":56655,"_2949":56684},[],"Record status",{"_3465":2380,"_30211":2369,"_20923":56686,"_5":14374,"_27449":56655,"_2949":56687},[],"Signed response",{"_3465":2381,"_30211":2369,"_20923":56689,"_5":14374,"_27449":56655,"_2949":53890},[],{"_3465":2382,"_30211":2369,"_20923":56691,"_5":14374,"_27449":56655,"_2949":56692},[],"`Good`.",{"_3465":2383,"_30211":2369,"_20923":56694,"_5":14374,"_27449":56655,"_2949":53907},[],{"_3465":2384,"_30211":2369,"_20923":56696,"_5":14374,"_27449":56655,"_2949":56697},[],"`Revoked`, with revocation reason and timestamp.",{"_3465":2385,"_30211":2369,"_20923":56699,"_5":14374,"_27449":56655,"_2949":56700},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3465":2386,"_30211":2369,"_20923":56702,"_5":14374,"_27449":56655,"_2949":56703},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3465":2387,"_30211":2369,"_20923":56705,"_5":14374,"_27449":56655,"_2949":56706},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3465":2388,"_30211":2369,"_20923":56708,"_5":14374,"_27449":56655,"_2949":56709},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3465":2389,"_30211":2369,"_20923":56711,"_5":14374,"_27449":56655,"_2949":56712},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3465":2390,"_30211":2369,"_20923":56714,"_5":14374,"_27449":56659,"_2949":56715},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3465":2391,"_30211":2369,"_20923":56717,"_5":14374,"_27449":56659,"_2949":56718},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3465":2392,"_30211":2369,"_20923":56720,"_5":14374,"_27449":56663,"_2949":56721},[],"The service accepts:",{"_3465":2393,"_30211":2369,"_20923":56723,"_5":14374,"_27449":56663,"_2949":52518},[],{"_3465":2394,"_30211":2369,"_20923":56725,"_5":14374,"_27449":56663,"_2949":56726},[],"VA service path",{"_3465":2395,"_30211":2369,"_20923":56728,"_5":14374,"_27449":56663,"_2949":56729},[],"Format",{"_3465":2396,"_30211":2369,"_20923":56731,"_5":14374,"_27449":56663,"_2949":56732},[],"`POST`",{"_3465":2397,"_30211":2369,"_20923":56734,"_5":14374,"_27449":56663,"_2949":56735},[],"`/ocsp`",{"_3465":2398,"_30211":2369,"_20923":56737,"_5":14374,"_27449":56663,"_2949":56738},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3465":2399,"_30211":2369,"_20923":56740,"_5":14374,"_27449":56663,"_2949":56139},[],{"_3465":2400,"_30211":2369,"_20923":56742,"_5":14374,"_27449":56663,"_2949":56743},[],"`/ocsp/{ocsp_request}`",{"_3465":2401,"_30211":2369,"_20923":56745,"_5":14374,"_27449":56663,"_2949":56746},[],"DER request encoded using padded URL Base64.",{"_3465":2402,"_30211":2369,"_20923":56748,"_5":14374,"_27449":56663,"_2949":56749},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3465":2403,"_30211":2369,"_20923":56751,"_5":14374,"_27449":56667,"_2949":56752},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3465":2404,"_30211":2369,"_20923":56754,"_5":14374,"_27449":56667,"_2949":56755},[],"Generate the request:",{"_3465":2405,"_30211":2369,"_20923":56757,"_5":14374,"_27449":56667,"_2949":56758},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3465":2406,"_30211":2369,"_20923":56760,"_5":14374,"_27449":56667,"_2949":56761},[],"Replace the example URL with the inspected endpoint:",{"_3465":2407,"_30211":2369,"_20923":56763,"_5":14374,"_27449":56667,"_2949":56764},[],"Verify the returned DER:",{"_3465":2408,"_30211":2369,"_20923":56766,"_5":14374,"_27449":56667,"_2949":56767},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3465":2409,"_30211":2369,"_20923":56769,"_5":14374,"_27449":56671,"_2949":56770},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3465":2410,"_30211":2369,"_20923":56772,"_5":14374,"_27449":56671,"_2949":56773},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3465":2411,"_30211":2369,"_20923":56775,"_5":14374,"_27449":56675,"_2949":56776},[],"RFC 6960: OCSP.",{"_3465":2412,"_30211":2369,"_20923":56778,"_5":14374,"_27449":56675,"_2949":56779},[],"OpenSSL: openssl-ocsp.",{"_3465":2413,"_30211":2369,"_20923":56781,"_5":14374,"_27449":56675,"_2949":56782},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3465":2414,"_30211":2369,"_20923":56784,"_5":14374,"_27449":56675,"_2949":56253},[],{"_3465":2415,"_30211":2415,"_5":14726,"_2949":54753,"_30563":56786,"_20923":56787,"_27449":2415},[49273,50748,54753],[],{"_3465":2416,"_30211":2415,"_20923":56789,"_5":14374,"_27449":2415,"_2949":56790},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3465":2417,"_30211":2415,"_5":30560,"_20923":56792,"_27449":56793,"_2949":54065},[],"/docs/pr-preview/pr-67/platform/pki/overview#start-here",{"_3465":2418,"_30211":2415,"_5":30560,"_20923":56795,"_27449":56796,"_2949":56797},[],"/docs/pr-preview/pr-67/platform/pki/overview#what-you-need","What you need",{"_3465":2419,"_30211":2415,"_5":30560,"_20923":56799,"_27449":56800,"_2949":54597},[],"/docs/pr-preview/pr-67/platform/pki/overview#core-capabilities",{"_3465":2420,"_30211":2415,"_5":30560,"_20923":56802,"_27449":56803,"_2949":54601},[],"/docs/pr-preview/pr-67/platform/pki/overview#build-your-trust-hierarchy",{"_3465":2421,"_30211":2415,"_5":30560,"_20923":56805,"_27449":56806,"_2949":54605},[],"/docs/pr-preview/pr-67/platform/pki/overview#protect-cryptographic-keys",{"_3465":2422,"_30211":2415,"_5":30560,"_20923":56808,"_27449":56809,"_2949":54609},[],"/docs/pr-preview/pr-67/platform/pki/overview#issue-and-control-certificates",{"_3465":2423,"_30211":2415,"_5":30560,"_20923":56811,"_27449":56812,"_2949":54617},[],"/docs/pr-preview/pr-67/platform/pki/overview#publish-validation-status",{"_3465":2424,"_30211":2415,"_5":30560,"_20923":56814,"_27449":56815,"_2949":56816},[],"/docs/pr-preview/pr-67/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3465":2425,"_30211":2415,"_5":30560,"_20923":56818,"_27449":56819,"_2949":55559},[],"/docs/pr-preview/pr-67/platform/pki/overview#continue",{"_3465":2426,"_30211":2415,"_20923":56821,"_5":14374,"_27449":2415,"_2949":56822},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3465":2427,"_30211":2415,"_20923":56824,"_5":14374,"_27449":56793,"_2949":56825},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3465":2428,"_30211":2415,"_20923":56827,"_5":14374,"_27449":56793,"_2949":56828},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3465":2429,"_30211":2415,"_20923":56830,"_5":14374,"_27449":56796,"_2949":56831},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3465":2430,"_30211":2415,"_20923":56833,"_5":14374,"_27449":56796,"_2949":56834},[],"An available cryptographic engine to keep the authority's key.",{"_3465":2431,"_30211":2415,"_20923":56836,"_5":14374,"_27449":56796,"_2949":56837},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3465":2432,"_30211":2415,"_20923":56839,"_5":14374,"_27449":56796,"_2949":56840},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3465":2433,"_30211":2415,"_20923":56842,"_5":14374,"_27449":56796,"_2949":56843},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3465":2434,"_30211":2415,"_20923":56845,"_5":14374,"_27449":56803,"_2949":56846},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3465":2435,"_30211":2415,"_20923":56848,"_5":14374,"_27449":56806,"_2949":56849},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3465":2436,"_30211":2415,"_20923":56851,"_5":14374,"_27449":56809,"_2949":56852},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3465":2437,"_30211":2415,"_20923":56854,"_5":14374,"_27449":56812,"_2949":56855},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3465":2438,"_30211":2415,"_20923":56857,"_5":14374,"_27449":56815,"_2949":56858},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3465":2439,"_30211":2415,"_20923":56860,"_5":14374,"_27449":56815,"_2949":56861},[],"its subject and extensions identify the expected client;",{"_3465":2440,"_30211":2415,"_20923":56863,"_5":14374,"_27449":56815,"_2949":56864},[],"its public key matches the client's private key;",{"_3465":2441,"_30211":2415,"_20923":56866,"_5":14374,"_27449":56815,"_2949":56867},[],"its chain reaches a root trusted by the consumer;",{"_3465":2442,"_30211":2415,"_20923":56869,"_5":14374,"_27449":56815,"_2949":56870},[],"its dates and usages allow the operation;",{"_3465":2443,"_30211":2415,"_20923":56872,"_5":14374,"_27449":56815,"_2949":56873},[],"the consumer applies revocation checks and authorization.",{"_3465":2444,"_30211":2415,"_20923":56875,"_5":14374,"_27449":56815,"_2949":56876},[],"The issuance path includes the first independent checks.",{"_3465":2445,"_30211":2415,"_20923":56878,"_5":14374,"_27449":56819,"_2949":56879},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3465":2446,"_30211":2415,"_20923":56881,"_5":14374,"_27449":56819,"_2949":56882},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3465":2447,"_30211":2415,"_20923":56884,"_5":14374,"_27449":56819,"_2949":56885},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3465":2448,"_30211":2448,"_5":14726,"_2949":56887,"_30563":56888,"_20923":56889,"_27449":2448},"Create your first CA",[49273,50748,54753,54190],[],{"_3465":2449,"_30211":2448,"_20923":56891,"_5":14374,"_27449":2448,"_2949":56892},[],"Create an evaluation root and check its certificate before issuing.",{"_3465":2450,"_30211":2448,"_5":30560,"_20923":56894,"_27449":56895,"_2949":49283},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3465":2451,"_30211":2448,"_5":30560,"_20923":56897,"_27449":56898,"_2949":56899},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3465":2452,"_30211":2448,"_5":30560,"_20923":56901,"_27449":56902,"_2949":56903},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3465":2453,"_30211":2448,"_5":30560,"_20923":56905,"_27449":56906,"_2949":56907},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3465":2454,"_30211":2448,"_5":30560,"_20923":56909,"_27449":56910,"_2949":56911},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3465":2455,"_30211":2448,"_5":30560,"_20923":56913,"_27449":56914,"_2949":56915},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3465":2456,"_30211":2448,"_5":30560,"_20923":56917,"_27449":56918,"_2949":56919},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3465":2457,"_30211":2448,"_5":30560,"_20923":56921,"_27449":56922,"_2949":54447},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3465":2458,"_30211":2448,"_5":30560,"_20923":56924,"_27449":56925,"_2949":49307},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3465":2459,"_30211":2448,"_20923":56927,"_5":14374,"_27449":2448,"_2949":56928},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3465":2460,"_30211":2448,"_20923":56930,"_5":14374,"_27449":56895,"_2949":56931},[],"Console access and permission to create keys and authorities.",{"_3465":2461,"_30211":2448,"_20923":56933,"_5":14374,"_27449":56895,"_2949":56934},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3465":2462,"_30211":2448,"_20923":56936,"_5":14374,"_27449":56895,"_2949":56937},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3465":2463,"_30211":2448,"_20923":56939,"_5":14374,"_27449":56895,"_2949":56940},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3465":2464,"_30211":2448,"_20923":56942,"_5":14374,"_27449":56898,"_2949":56943},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3465":2465,"_30211":2448,"_20923":56945,"_5":14374,"_27449":56898,"_2949":56946},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3465":2466,"_30211":2448,"_20923":56948,"_5":14374,"_27449":56902,"_2949":56949},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3465":2467,"_30211":2448,"_20923":56951,"_5":14374,"_27449":56902,"_2949":56952},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3465":2468,"_30211":2448,"_20923":56954,"_5":14374,"_27449":56906,"_2949":56955},[],"Select **Root CA** and complete:",{"_3465":2469,"_30211":2448,"_20923":56957,"_5":14374,"_27449":56906,"_2949":56958},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3465":2470,"_30211":2448,"_20923":56960,"_5":14374,"_27449":56906,"_2949":56961},[],"**Subject**: organization and country details for your evaluation.",{"_3465":2471,"_30211":2448,"_20923":56963,"_5":14374,"_27449":56906,"_2949":56964},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3465":2472,"_30211":2448,"_20923":56966,"_5":14374,"_27449":56906,"_2949":56967},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3465":2473,"_30211":2448,"_20923":56969,"_5":14374,"_27449":56906,"_2949":56970},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3465":2474,"_30211":2448,"_20923":56972,"_5":14374,"_27449":56910,"_2949":56973},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3465":2475,"_30211":2448,"_20923":56975,"_5":14374,"_27449":56914,"_2949":56976},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3465":2476,"_30211":2448,"_20923":56978,"_5":14374,"_27449":56914,"_2949":56979},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3465":2477,"_30211":2448,"_20923":56981,"_5":14374,"_27449":56918,"_2949":56982},[],"Run from the directory where you saved `ca.pem`:",{"_3465":2478,"_30211":2448,"_20923":56984,"_5":14374,"_27449":56918,"_2949":56985},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3465":2479,"_30211":2448,"_20923":56987,"_5":14374,"_27449":56918,"_2949":56988},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3465":2480,"_30211":2448,"_20923":56990,"_5":14374,"_27449":56922,"_2949":56991},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3465":2481,"_30211":2448,"_20923":56993,"_5":14374,"_27449":56922,"_2949":56994},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3465":2482,"_30211":2448,"_20923":56996,"_5":14374,"_27449":56922,"_2949":56997},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3465":2483,"_30211":2448,"_20923":56999,"_5":14374,"_27449":56922,"_2949":57000},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3465":2484,"_30211":2448,"_20923":57002,"_5":14374,"_27449":56925,"_2949":57003},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3465":2485,"_30211":2485,"_5":14726,"_2949":57005,"_30563":57006,"_20923":57007,"_27449":2485},"Issue and verify a certificate",[49273,50748,54753,54190],[],{"_3465":2486,"_30211":2485,"_20923":57009,"_5":14374,"_27449":2485,"_2949":57010},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3465":2487,"_30211":2485,"_5":30560,"_20923":57012,"_27449":57013,"_2949":49283},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3465":2488,"_30211":2485,"_5":30560,"_20923":57015,"_27449":57016,"_2949":57017},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3465":2489,"_30211":2485,"_5":30560,"_20923":57019,"_27449":57020,"_2949":57021},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3465":2490,"_30211":2485,"_5":30560,"_20923":57023,"_27449":57024,"_2949":57025},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3465":2491,"_30211":2485,"_5":30560,"_20923":57027,"_27449":57028,"_2949":57029},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3465":2492,"_30211":2485,"_5":30560,"_20923":57031,"_27449":57032,"_2949":57033},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3465":2493,"_30211":2485,"_5":30560,"_20923":57035,"_27449":57036,"_2949":57037},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3465":2494,"_30211":2485,"_5":30560,"_20923":57039,"_27449":57040,"_2949":57041},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3465":2495,"_30211":2485,"_5":30560,"_20923":57043,"_27449":57044,"_2949":57045},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3465":2496,"_30211":2485,"_5":30560,"_20923":57047,"_27449":57048,"_2949":57049},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3465":2497,"_30211":2485,"_5":30560,"_20923":57051,"_27449":57052,"_2949":54447},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3465":2498,"_30211":2485,"_5":30560,"_20923":57054,"_27449":57055,"_2949":49307},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/issue-certificate#next-step",{"_3465":2499,"_30211":2485,"_20923":57057,"_5":14374,"_27449":2485,"_2949":57058},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3465":2500,"_30211":2485,"_20923":57060,"_5":14374,"_27449":57013,"_2949":57061},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3465":2501,"_30211":2485,"_20923":57063,"_5":14374,"_27449":57013,"_2949":57064},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3465":2502,"_30211":2485,"_20923":57066,"_5":14374,"_27449":57013,"_2949":57067},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3465":2503,"_30211":2485,"_20923":57069,"_5":14374,"_27449":57013,"_2949":57070},[],"A client identifier: here we use `device-001`.",{"_3465":2504,"_30211":2485,"_20923":57072,"_5":14374,"_27449":57013,"_2949":57073},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3465":2505,"_30211":2485,"_20923":57075,"_5":14374,"_27449":57016,"_2949":57076},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3465":2506,"_30211":2485,"_20923":57078,"_5":14374,"_27449":57020,"_2949":57079},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3465":2507,"_30211":2485,"_20923":57081,"_5":14374,"_27449":57020,"_2949":57082},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3465":2508,"_30211":2485,"_20923":57084,"_5":14374,"_27449":57024,"_2949":57085},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3465":2509,"_30211":2485,"_20923":57087,"_5":14374,"_27449":57024,"_2949":57088},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3465":2510,"_30211":2485,"_20923":57090,"_5":14374,"_27449":57028,"_2949":57091},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3465":2511,"_30211":2485,"_20923":57093,"_5":14374,"_27449":57028,"_2949":57094},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3465":2512,"_30211":2485,"_20923":57096,"_5":14374,"_27449":57032,"_2949":57097},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3465":2513,"_30211":2485,"_20923":57099,"_5":14374,"_27449":57036,"_2949":57100},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3465":2514,"_30211":2485,"_20923":57102,"_5":14374,"_27449":57040,"_2949":57103},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3465":2515,"_30211":2485,"_20923":57105,"_5":14374,"_27449":57044,"_2949":57106},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3465":2516,"_30211":2485,"_20923":57108,"_5":14374,"_27449":57044,"_2949":57109},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3465":2517,"_30211":2485,"_20923":57111,"_5":14374,"_27449":57044,"_2949":57112},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3465":2518,"_30211":2485,"_20923":57114,"_5":14374,"_27449":57048,"_2949":57115},[],"In Bash, compare the two public-key digests:",{"_3465":2519,"_30211":2485,"_20923":57117,"_5":14374,"_27449":57048,"_2949":57118},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3465":2520,"_30211":2485,"_20923":57120,"_5":14374,"_27449":57048,"_2949":57121},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3465":2521,"_30211":2485,"_20923":57123,"_5":14374,"_27449":57052,"_2949":54531},[],{"_3465":2522,"_30211":2485,"_20923":57125,"_5":14374,"_27449":57052,"_2949":57126},[],"What to review",{"_3465":2523,"_30211":2485,"_20923":57128,"_5":14374,"_27449":57052,"_2949":57129},[],"The CA rejects issuance",{"_3465":2524,"_30211":2485,"_20923":57131,"_5":14374,"_27449":57052,"_2949":57132},[],"Permissions, CA state and key, algorithm and profile.",{"_3465":2525,"_30211":2485,"_20923":57134,"_5":14374,"_27449":57052,"_2949":57135},[],"Different subject or usages",{"_3465":2526,"_30211":2485,"_20923":57137,"_5":14374,"_27449":57052,"_2949":57138},[],"Applied profile and requested values.",{"_3465":2527,"_30211":2485,"_20923":57140,"_5":14374,"_27449":57052,"_2949":57141},[],"Issuer cannot be found",{"_3465":2528,"_30211":2485,"_20923":57143,"_5":14374,"_27449":57052,"_2949":57144},[],"Downloaded CA and required intermediate chain.",{"_3465":2529,"_30211":2485,"_20923":57146,"_5":14374,"_27449":57052,"_2949":57147},[],"Validity fails",{"_3465":2530,"_30211":2485,"_20923":57149,"_5":14374,"_27449":57052,"_2949":57150},[],"Certificate and CA dates, and the computer's clock.",{"_3465":2531,"_30211":2485,"_20923":57152,"_5":14374,"_27449":57052,"_2949":57153},[],"Public-key digests differ",{"_3465":2532,"_30211":2485,"_20923":57155,"_5":14374,"_27449":57052,"_2949":57156},[],"Certificate and key files from the same issuance.",{"_3465":2533,"_30211":2485,"_20923":57158,"_5":14374,"_27449":57052,"_2949":57159},[],"See PKI diagnostics to narrow an issuance failure.",{"_3465":2534,"_30211":2485,"_20923":57161,"_5":14374,"_27449":57055,"_2949":57162},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3465":2535,"_30211":2485,"_20923":57164,"_5":14374,"_27449":57055,"_2949":57165},[],"Manage certificates for inspection, status and revocation.",{"_3465":2536,"_30211":2485,"_20923":57167,"_5":14374,"_27449":57055,"_2949":57168},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3465":2537,"_30211":2485,"_20923":57170,"_5":14374,"_27449":57055,"_2949":57171},[],"Prepare EST for the device to request its next identities.",{"_3465":2538,"_30211":2485,"_20923":57173,"_5":14374,"_27449":57055,"_2949":57174},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3465":2539,"_30211":2539,"_5":14726,"_2949":57176,"_30563":57177,"_20923":57178,"_27449":2539},"PKI getting started",[49273,50748,54753,54190],[],{"_3465":2540,"_30211":2539,"_20923":57180,"_5":14374,"_27449":2539,"_2949":57181},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3465":2541,"_30211":2539,"_5":30560,"_20923":57183,"_27449":57184,"_2949":49283},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/overview#before-you-begin",{"_3465":2542,"_30211":2539,"_5":30560,"_20923":57186,"_27449":57187,"_2949":57188},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3465":2543,"_30211":2539,"_5":30560,"_20923":57190,"_27449":57191,"_2949":54382},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/overview#expected-result",{"_3465":2544,"_30211":2539,"_5":30560,"_20923":57193,"_27449":57194,"_2949":57195},[],"/docs/pr-preview/pr-67/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3465":2545,"_30211":2539,"_20923":57197,"_5":14374,"_27449":2539,"_2949":57198},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3465":2546,"_30211":2539,"_20923":57200,"_5":14374,"_27449":57184,"_2949":57201},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3465":2547,"_30211":2539,"_20923":57203,"_5":14374,"_27449":57184,"_2949":57204},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3465":2548,"_30211":2539,"_20923":57206,"_5":14374,"_27449":57184,"_2949":57207},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3465":2549,"_30211":2539,"_20923":57209,"_5":14374,"_27449":57184,"_2949":57210},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3465":2550,"_30211":2539,"_20923":57212,"_5":14374,"_27449":57184,"_2949":57213},[],"A working directory with restricted access for the downloaded key.",{"_3465":2551,"_30211":2539,"_20923":57215,"_5":14374,"_27449":57187,"_2949":57216},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3465":2552,"_30211":2539,"_20923":57218,"_5":14374,"_27449":57187,"_2949":57219},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3465":2553,"_30211":2539,"_20923":57221,"_5":14374,"_27449":57187,"_2949":57222},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3465":2554,"_30211":2539,"_20923":57224,"_5":14374,"_27449":57187,"_2949":57225},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3465":2555,"_30211":2539,"_20923":57227,"_5":14374,"_27449":57191,"_2949":57228},[],"File or resource",{"_3465":2556,"_30211":2539,"_20923":57230,"_5":14374,"_27449":57191,"_2949":54379},[],{"_3465":2557,"_30211":2539,"_20923":57232,"_5":14374,"_27449":57191,"_2949":57233},[],"Active root CA and `ca.pem`",{"_3465":2558,"_30211":2539,"_20923":57235,"_5":14374,"_27449":57191,"_2949":57236},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3465":2559,"_30211":2539,"_20923":57238,"_5":14374,"_27449":57191,"_2949":57239},[],"End-entity certificate and `device.crt`",{"_3465":2560,"_30211":2539,"_20923":57241,"_5":14374,"_27449":57191,"_2949":57242},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3465":2561,"_30211":2539,"_20923":57244,"_5":14374,"_27449":57191,"_2949":57245},[],"Private key `device.key`",{"_3465":2562,"_30211":2539,"_20923":57247,"_5":14374,"_27449":57191,"_2949":57248},[],"Its public key matches the one included in `device.crt`.",{"_3465":2563,"_30211":2539,"_20923":57250,"_5":14374,"_27449":57191,"_2949":57251},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3465":2564,"_30211":2539,"_20923":57253,"_5":14374,"_27449":57194,"_2949":57254},[],"To operate certificates, continue with Certificates and Validation.",{"_3465":2565,"_30211":2539,"_20923":57256,"_5":14374,"_27449":57194,"_2949":57257},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3465":2566,"_30211":2539,"_20923":57259,"_5":14374,"_27449":57194,"_2949":57260},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3465":2567,"_30211":2567,"_5":14726,"_2949":57262,"_30563":57263,"_20923":57264,"_27449":2567},"PKI troubleshooting",[49273,50748,54753,53328],[],{"_3465":2568,"_30211":2567,"_20923":57266,"_5":14374,"_27449":2567,"_2949":57267},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3465":2569,"_30211":2567,"_5":30560,"_20923":57269,"_27449":57270,"_2949":57271},[],"/docs/pr-preview/pr-67/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3465":2570,"_30211":2567,"_5":30560,"_20923":57273,"_27449":57274,"_2949":57275},[],"/docs/pr-preview/pr-67/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3465":2571,"_30211":2567,"_5":30560,"_20923":57277,"_27449":57278,"_2949":57279},[],"/docs/pr-preview/pr-67/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3465":2572,"_30211":2567,"_20923":57281,"_5":14374,"_27449":2567,"_2949":57282},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3465":2573,"_30211":2567,"_20923":57284,"_5":14374,"_27449":2567,"_2949":57285},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3465":2574,"_30211":2567,"_20923":57287,"_5":14374,"_27449":57270,"_2949":54379},[],{"_3465":2575,"_30211":2567,"_20923":57289,"_5":14374,"_27449":57270,"_2949":57290},[],"What to inspect",{"_3465":2576,"_30211":2567,"_20923":57292,"_5":14374,"_27449":57270,"_2949":49307},[],{"_3465":2577,"_30211":2567,"_20923":57294,"_5":14374,"_27449":57270,"_2949":53595},[],{"_3465":2578,"_30211":2567,"_20923":57296,"_5":14374,"_27449":57270,"_2949":57297},[],"Exists, is active and has usable dates.",{"_3465":2579,"_30211":2567,"_20923":57299,"_5":14374,"_27449":57270,"_2949":57300},[],"Authorities.",{"_3465":2580,"_30211":2567,"_20923":57302,"_5":14374,"_27449":57270,"_2949":57303},[],"Key",{"_3465":2581,"_30211":2567,"_20923":57305,"_5":14374,"_27449":57270,"_2949":57306},[],"The record has a usable private key and the engine can sign.",{"_3465":2582,"_30211":2567,"_20923":57308,"_5":14374,"_27449":57270,"_2949":57309},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3465":2583,"_30211":2567,"_20923":57311,"_5":14374,"_27449":57270,"_2949":57312},[],"CSR",{"_3465":2584,"_30211":2567,"_20923":57314,"_5":14374,"_27449":57270,"_2949":57315},[],"Correct PEM and verifiable signature.",{"_3465":2585,"_30211":2567,"_20923":57317,"_5":14374,"_27449":57270,"_2949":57318},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3465":2586,"_30211":2567,"_20923":57320,"_5":14374,"_27449":57270,"_2949":57321},[],"Profile",{"_3465":2587,"_30211":2567,"_20923":57323,"_5":14374,"_27449":57270,"_2949":57324},[],"Selected source, existing ID, allowed algorithm and size.",{"_3465":2588,"_30211":2567,"_20923":57326,"_5":14374,"_27449":57270,"_2949":57327},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3465":2589,"_30211":2567,"_20923":57329,"_5":14374,"_27449":57270,"_2949":54531},[],{"_3465":2590,"_30211":2567,"_20923":57331,"_5":14374,"_27449":57270,"_2949":57332},[],"Appropriate subject, SAN, usages and dates.",{"_3465":2591,"_30211":2567,"_20923":57334,"_5":14374,"_27449":57270,"_2949":57335},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3465":2592,"_30211":2567,"_20923":57337,"_5":14374,"_27449":57270,"_2949":57338},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3465":2593,"_30211":2567,"_20923":57340,"_5":14374,"_27449":57270,"_2949":57341},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3465":2594,"_30211":2567,"_20923":57343,"_5":14374,"_27449":57274,"_2949":57344},[],"Check each boundary independently:",{"_3465":2595,"_30211":2567,"_20923":57346,"_5":14374,"_27449":57274,"_2949":57347},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3465":2596,"_30211":2567,"_20923":57349,"_5":14374,"_27449":57274,"_2949":57350},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3465":2597,"_30211":2567,"_20923":57352,"_5":14374,"_27449":57274,"_2949":57353},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3465":2598,"_30211":2567,"_20923":57355,"_5":14374,"_27449":57274,"_2949":57356},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3465":2599,"_30211":2567,"_20923":57358,"_5":14374,"_27449":57274,"_2949":57359},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3465":2600,"_30211":2567,"_20923":57361,"_5":14374,"_27449":57274,"_2949":57362},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3465":2601,"_30211":2567,"_20923":57364,"_5":14374,"_27449":57278,"_2949":57365},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3465":2602,"_30211":2567,"_20923":57367,"_5":14374,"_27449":57278,"_2949":57368},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3465":2603,"_30211":2603,"_5":14726,"_2949":57370,"_30563":57371,"_20923":57372,"_27449":2603},"Security",[49273],[],{"_3465":2604,"_30211":2603,"_20923":57374,"_5":14374,"_27449":2603,"_2949":57375},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3465":2605,"_30211":2603,"_5":30560,"_20923":57377,"_27449":57378,"_2949":57379},[],"/docs/pr-preview/pr-67/security#report-a-vulnerability","Report a vulnerability",{"_3465":2606,"_30211":2603,"_5":30560,"_20923":57381,"_27449":57382,"_2949":57383},[],"/docs/pr-preview/pr-67/security#what-to-include-in-a-report","What to include in a report",{"_3465":2607,"_30211":2603,"_5":30560,"_20923":57385,"_27449":57386,"_2949":57387},[],"/docs/pr-preview/pr-67/security#supported-versions","Supported versions",{"_3465":2608,"_30211":2603,"_5":30560,"_20923":57389,"_27449":57390,"_2949":57391},[],"/docs/pr-preview/pr-67/security#responsible-disclosure","Responsible disclosure",{"_3465":2609,"_30211":2603,"_20923":57393,"_5":14374,"_27449":2603,"_2949":57394},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3465":2610,"_30211":2603,"_20923":57396,"_5":14374,"_27449":57378,"_2949":57397},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3465":2611,"_30211":2603,"_20923":57399,"_5":14374,"_27449":57378,"_2949":57400},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3465":2612,"_30211":2603,"_20923":57402,"_5":14374,"_27449":57378,"_2949":14993},[],{"_3465":2613,"_30211":2603,"_20923":57404,"_5":14374,"_27449":57378,"_2949":14933},[],{"_3465":2614,"_30211":2603,"_20923":57406,"_5":14374,"_27449":57378,"_2949":14980},[],{"_3465":2615,"_30211":2603,"_20923":57408,"_5":14374,"_27449":57378,"_2949":57409},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3465":2616,"_30211":2603,"_20923":57411,"_5":14374,"_27449":57378,"_2949":57412},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3465":2617,"_30211":2603,"_20923":57414,"_5":14374,"_27449":57382,"_2949":57415},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3465":2618,"_30211":2603,"_20923":57417,"_5":14374,"_27449":57382,"_2949":57418},[],"Do not include in the report:",{"_3465":2619,"_30211":2603,"_20923":57420,"_5":14374,"_27449":57382,"_2949":57421},[],"Credentials, tokens, or private keys",{"_3465":2620,"_30211":2603,"_20923":57423,"_5":14374,"_27449":57382,"_2949":57424},[],"Customer data or customer-identifiable information",{"_3465":2621,"_30211":2603,"_20923":57426,"_5":14374,"_27449":57382,"_2949":57427},[],"Confidential architecture or internal infrastructure details",{"_3465":2622,"_30211":2603,"_20923":57429,"_5":14374,"_27449":57386,"_2949":57430},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3465":2623,"_30211":2603,"_20923":57432,"_5":14374,"_27449":57386,"_2949":57433},[],"For upgrade guidance, see Upgrades.",{"_3465":2624,"_30211":2603,"_20923":57435,"_5":14374,"_27449":57390,"_2949":57436},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3465":2625,"_30211":2603,"_20923":57438,"_5":14374,"_27449":57390,"_2949":57439},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3465":2626,"_30211":2603,"_20923":57441,"_5":14374,"_27449":57390,"_2949":57442},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3465":2627,"_30211":2603,"_20923":57444,"_5":14374,"_27449":57390,"_2949":57445},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3465":2628,"_30211":2603,"_20923":57447,"_5":14374,"_27449":57390,"_2949":57448},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3465":2629,"_30211":2629,"_5":14726,"_2949":57450,"_30563":57451,"_20923":57453,"_27449":2629},"3.8.0 to 4.0.0",[49273,57452],"Upgrades",[],{"_3465":2630,"_30211":2629,"_20923":57455,"_5":14374,"_27449":2629,"_2949":57456},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3465":2631,"_30211":2629,"_5":30560,"_20923":57458,"_27449":57459,"_2949":57460},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3465":2632,"_30211":2629,"_5":30560,"_20923":57462,"_27449":57463,"_2949":57464},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3465":2633,"_30211":2629,"_5":30560,"_20923":57466,"_27449":57467,"_2949":57468},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3465":2634,"_30211":2629,"_5":30560,"_20923":57470,"_27449":57471,"_2949":57472},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3465":2635,"_30211":2629,"_5":30560,"_20923":57474,"_27449":57475,"_2949":57476},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3465":2636,"_30211":2629,"_5":30560,"_20923":57478,"_27449":57479,"_2949":57480},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3465":2637,"_30211":2629,"_5":30560,"_20923":57482,"_27449":57483,"_2949":57484},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3465":2638,"_30211":2629,"_5":30560,"_20923":57486,"_27449":57487,"_2949":57488},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3465":2639,"_30211":2629,"_5":30560,"_20923":57490,"_27449":57491,"_2949":57492},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3465":2640,"_30211":2629,"_5":30560,"_20923":57494,"_27449":57495,"_2949":57496},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3465":2641,"_30211":2629,"_5":30560,"_20923":57498,"_27449":57499,"_2949":57500},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3465":2642,"_30211":2629,"_5":30560,"_20923":57502,"_27449":57503,"_2949":57504},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3465":2643,"_30211":2629,"_5":30560,"_20923":57506,"_27449":57507,"_2949":57508},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3465":2644,"_30211":2629,"_5":30560,"_20923":57510,"_27449":57511,"_2949":57512},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3465":2645,"_30211":2629,"_5":30560,"_20923":57514,"_27449":57515,"_2949":57516},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3465":2646,"_30211":2629,"_5":30560,"_20923":57518,"_27449":57519,"_2949":57520},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3465":2647,"_30211":2629,"_5":30560,"_20923":57522,"_27449":57523,"_2949":57524},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3465":2648,"_30211":2629,"_5":30560,"_20923":57526,"_27449":57527,"_2949":57528},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3465":2649,"_30211":2629,"_5":30560,"_20923":57530,"_27449":57531,"_2949":57532},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3465":2650,"_30211":2629,"_5":30560,"_20923":57534,"_27449":57535,"_2949":57536},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3465":2651,"_30211":2629,"_5":30560,"_20923":57538,"_27449":57539,"_2949":57540},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3465":2652,"_30211":2629,"_5":30560,"_20923":57542,"_27449":57543,"_2949":57544},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3465":2653,"_30211":2629,"_5":30560,"_20923":57546,"_27449":57547,"_2949":57548},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3465":2654,"_30211":2629,"_5":30560,"_20923":57550,"_27449":57551,"_2949":57552},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3465":2655,"_30211":2629,"_5":30560,"_20923":57554,"_27449":57555,"_2949":57556},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3465":2656,"_30211":2629,"_5":30560,"_20923":57558,"_27449":57559,"_2949":57560},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3465":2657,"_30211":2629,"_5":30560,"_20923":57562,"_27449":57563,"_2949":57564},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3465":2658,"_30211":2629,"_5":30560,"_20923":57566,"_27449":57567,"_2949":57568},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3465":2659,"_30211":2629,"_5":30560,"_20923":57570,"_27449":57571,"_2949":57572},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3465":2660,"_30211":2629,"_5":30560,"_20923":57574,"_27449":57575,"_2949":57576},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3465":2661,"_30211":2629,"_5":30560,"_20923":57578,"_27449":57579,"_2949":57580},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3465":2662,"_30211":2629,"_5":30560,"_20923":57582,"_27449":57583,"_2949":57584},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3465":2663,"_30211":2629,"_5":30560,"_20923":57586,"_27449":57587,"_2949":57588},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3465":2664,"_30211":2629,"_5":30560,"_20923":57590,"_27449":57591,"_2949":57592},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3465":2665,"_30211":2629,"_5":30560,"_20923":57594,"_27449":57595,"_2949":57596},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3465":2666,"_30211":2629,"_5":30560,"_20923":57598,"_27449":57599,"_2949":57600},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3465":2667,"_30211":2629,"_5":30560,"_20923":57602,"_27449":57603,"_2949":57604},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3465":2668,"_30211":2629,"_5":30560,"_20923":57606,"_27449":57607,"_2949":57608},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3465":2669,"_30211":2629,"_5":30560,"_20923":57610,"_27449":57611,"_2949":57612},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3465":2670,"_30211":2629,"_5":30560,"_20923":57614,"_27449":57615,"_2949":57616},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3465":2671,"_30211":2629,"_5":30560,"_20923":57618,"_27449":57619,"_2949":53328},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3465":2672,"_30211":2629,"_5":30560,"_20923":57621,"_27449":57622,"_2949":57623},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3465":2673,"_30211":2629,"_5":30560,"_20923":57625,"_27449":57626,"_2949":57627},[],"/docs/pr-preview/pr-67/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3465":2674,"_30211":2629,"_20923":57629,"_5":14374,"_27449":2629,"_2949":57630},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3465":2675,"_30211":2629,"_20923":57632,"_5":14374,"_27449":2629,"_2949":57633},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3465":2676,"_30211":2629,"_20923":57635,"_5":14374,"_27449":2629,"_2949":57636},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3465":2677,"_30211":2629,"_20923":57638,"_5":14374,"_27449":2629,"_2949":57639},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3465":2678,"_30211":2629,"_20923":57641,"_5":14374,"_27449":2629,"_2949":57642},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3465":2679,"_30211":2629,"_20923":57644,"_5":14374,"_27449":2629,"_2949":57645},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3465":2680,"_30211":2629,"_20923":57647,"_5":14374,"_27449":2629,"_2949":57648},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3465":2681,"_30211":2629,"_20923":57650,"_5":14374,"_27449":57463,"_2949":57651},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3465":2682,"_30211":2629,"_20923":57653,"_5":14374,"_27449":57463,"_2949":57654},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3465":2683,"_30211":2629,"_20923":57656,"_5":14374,"_27449":57467,"_2949":57657},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3465":2684,"_30211":2629,"_20923":57659,"_5":14374,"_27449":57467,"_2949":57660},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3465":2685,"_30211":2629,"_20923":57662,"_5":14374,"_27449":57471,"_2949":57663},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3465":2686,"_30211":2629,"_20923":57665,"_5":14374,"_27449":57475,"_2949":57666},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3465":2687,"_30211":2629,"_20923":57668,"_5":14374,"_27449":57475,"_2949":57669},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3465":2688,"_30211":2629,"_20923":57671,"_5":14374,"_27449":57475,"_2949":57672},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3465":2689,"_30211":2629,"_20923":57674,"_5":14374,"_27449":57475,"_2949":57675},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3465":2690,"_30211":2629,"_20923":57677,"_5":14374,"_27449":57475,"_2949":57678},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3465":2691,"_30211":2629,"_20923":57680,"_5":14374,"_27449":57479,"_2949":57681},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3465":2692,"_30211":2629,"_20923":57683,"_5":14374,"_27449":57479,"_2949":57684},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3465":2693,"_30211":2629,"_20923":57686,"_5":14374,"_27449":57479,"_2949":57687},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3465":2694,"_30211":2629,"_20923":57689,"_5":14374,"_27449":57479,"_2949":57690},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3465":2695,"_30211":2629,"_20923":57692,"_5":14374,"_27449":57479,"_2949":57693},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3465":2696,"_30211":2629,"_20923":57695,"_5":14374,"_27449":57479,"_2949":57696},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3465":2697,"_30211":2629,"_20923":57698,"_5":14374,"_27449":57483,"_2949":57699},[],"Change",{"_3465":2698,"_30211":2629,"_20923":57701,"_5":14374,"_27449":57483,"_2949":57702},[],"Who is affected",{"_3465":2699,"_30211":2629,"_20923":57704,"_5":14374,"_27449":57483,"_2949":57705},[],"Severity",{"_3465":2700,"_30211":2629,"_20923":57707,"_5":14374,"_27449":57483,"_2949":56184},[],{"_3465":2701,"_30211":2629,"_20923":57709,"_5":14374,"_27449":57483,"_2949":57492},[],{"_3465":2702,"_30211":2629,"_20923":57711,"_5":14374,"_27449":57483,"_2949":57712},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3465":2703,"_30211":2629,"_20923":57714,"_5":14374,"_27449":57483,"_2949":57715},[],"High: KMS and VA start on empty volumes",{"_3465":2704,"_30211":2629,"_20923":57717,"_5":14374,"_27449":57483,"_2949":57718},[],"Copy the data into the new volumes",{"_3465":2705,"_30211":2629,"_20923":57720,"_5":14374,"_27449":57483,"_2949":57496},[],{"_3465":2706,"_30211":2629,"_20923":57722,"_5":14374,"_27449":57483,"_2949":57723},[],"Every Helm release",{"_3465":2707,"_30211":2629,"_20923":57725,"_5":14374,"_27449":57483,"_2949":57726},[],"High: `helm upgrade` fails",{"_3465":2708,"_30211":2629,"_20923":57728,"_5":14374,"_27449":57483,"_2949":57729},[],"Remove or rename legacy keys",{"_3465":2709,"_30211":2629,"_20923":57731,"_5":14374,"_27449":57483,"_2949":57500},[],{"_3465":2710,"_30211":2629,"_20923":57733,"_5":14374,"_27449":57483,"_2949":57734},[],"Every deployment",{"_3465":2711,"_30211":2629,"_20923":57736,"_5":14374,"_27449":57483,"_2949":57737},[],"High: without a bootstrap principal there is no administrator",{"_3465":2712,"_30211":2629,"_20923":57739,"_5":14374,"_27449":57483,"_2949":57740},[],"Configure `services.authz`",{"_3465":2713,"_30211":2629,"_20923":57742,"_5":14374,"_27449":57483,"_2949":57504},[],{"_3465":2714,"_30211":2629,"_20923":57744,"_5":14374,"_27449":57483,"_2949":57723},[],{"_3465":2715,"_30211":2629,"_20923":57746,"_5":14374,"_27449":57483,"_2949":57747},[],"High: `helm upgrade` fails on the old keys",{"_3465":2716,"_30211":2629,"_20923":57749,"_5":14374,"_27449":57483,"_2949":57750},[],"Move JWKS and roles into `services.authz`",{"_3465":2717,"_30211":2629,"_20923":57752,"_5":14374,"_27449":57483,"_2949":57524},[],{"_3465":2718,"_30211":2629,"_20923":57754,"_5":14374,"_27449":57483,"_2949":57755},[],"3.8.0 deployments with per-service databases",{"_3465":2719,"_30211":2629,"_20923":57757,"_5":14374,"_27449":57483,"_2949":57758},[],"High: services find no data, or a migration aborts",{"_3465":2720,"_30211":2629,"_20923":57760,"_5":14374,"_27449":57483,"_2949":57761},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3465":2721,"_30211":2629,"_20923":57763,"_5":14374,"_27449":57483,"_2949":57528},[],{"_3465":2722,"_30211":2629,"_20923":57765,"_5":14374,"_27449":57483,"_2949":57766},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3465":2723,"_30211":2629,"_20923":57768,"_5":14374,"_27449":57483,"_2949":57769},[],"High: the backend no longer starts with them",{"_3465":2724,"_30211":2629,"_20923":57771,"_5":14374,"_27449":57483,"_2949":57772},[],"Move to PostgreSQL before upgrading",{"_3465":2725,"_30211":2629,"_20923":57774,"_5":14374,"_27449":57483,"_2949":57572},[],{"_3465":2726,"_30211":2629,"_20923":57776,"_5":14374,"_27449":57483,"_2949":57777},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3465":2727,"_30211":2629,"_20923":57779,"_5":14374,"_27449":57483,"_2949":57780},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3465":2728,"_30211":2629,"_20923":57782,"_5":14374,"_27449":57483,"_2949":57783},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3465":2729,"_30211":2629,"_20923":57785,"_5":14374,"_27449":57483,"_2949":57786},[],"Webhooks with file references",{"_3465":2730,"_30211":2629,"_20923":57788,"_5":14374,"_27449":57483,"_2949":57789},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3465":2731,"_30211":2629,"_20923":57791,"_5":14374,"_27449":57483,"_2949":57792},[],"High: enrollments calling the webhook fail",{"_3465":2732,"_30211":2629,"_20923":57794,"_5":14374,"_27449":57483,"_2949":57795},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3465":2733,"_30211":2629,"_20923":57797,"_5":14374,"_27449":57483,"_2949":57508},[],{"_3465":2734,"_30211":2629,"_20923":57799,"_5":14374,"_27449":57483,"_2949":57800},[],"Releases with per-service identity overrides or mounted key material",{"_3465":2735,"_30211":2629,"_20923":57802,"_5":14374,"_27449":57483,"_2949":57803},[],"Medium: services cannot read their files",{"_3465":2736,"_30211":2629,"_20923":57805,"_5":14374,"_27449":57483,"_2949":57806},[],"Remove the overrides and fix volume ownership",{"_3465":2737,"_30211":2629,"_20923":57808,"_5":14374,"_27449":57483,"_2949":57512},[],{"_3465":2738,"_30211":2629,"_20923":57810,"_5":14374,"_27449":57483,"_2949":57811},[],"Releases that set `amqp.tls`",{"_3465":2739,"_30211":2629,"_20923":57813,"_5":14374,"_27449":57483,"_2949":57814},[],"Medium: clients connect to the wrong port",{"_3465":2740,"_30211":2629,"_20923":57816,"_5":14374,"_27449":57483,"_2949":57817},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3465":2741,"_30211":2629,"_20923":57819,"_5":14374,"_27449":57483,"_2949":57532},[],{"_3465":2742,"_30211":2629,"_20923":57821,"_5":14374,"_27449":57483,"_2949":57822},[],"Installations whose CA keys predate the KMS",{"_3465":2743,"_30211":2629,"_20923":57824,"_5":14374,"_27449":57483,"_2949":57825},[],"Medium: CA keys stay unmanaged",{"_3465":2744,"_30211":2629,"_20923":57827,"_5":14374,"_27449":57483,"_2949":57828},[],"Run the CA-to-KMS migration",{"_3465":2745,"_30211":2629,"_20923":57830,"_5":14374,"_27449":57483,"_2949":57831},[],"Receiver certificate verification",{"_3465":2746,"_30211":2629,"_20923":57833,"_5":14374,"_27449":57483,"_2949":57834},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3465":2747,"_30211":2629,"_20923":57836,"_5":14374,"_27449":57483,"_2949":57837},[],"Medium: credentials go to an unverified receiver",{"_3465":2748,"_30211":2629,"_20923":57839,"_5":14374,"_27449":57483,"_2949":57840},[],"Set `insecure_skip_verify` to `false`",{"_3465":2749,"_30211":2629,"_20923":57842,"_5":14374,"_27449":57483,"_2949":57548},[],{"_3465":2750,"_30211":2629,"_20923":57844,"_5":14374,"_27449":57483,"_2949":57845},[],"Scripts and consoles that edit DMSs through the API",{"_3465":2751,"_30211":2629,"_20923":57847,"_5":14374,"_27449":57483,"_2949":57848},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3465":2752,"_30211":2629,"_20923":57850,"_5":14374,"_27449":57483,"_2949":57851},[],"Read the DMS before editing and use the new field",{"_3465":2753,"_30211":2629,"_20923":57853,"_5":14374,"_27449":57483,"_2949":57568},[],{"_3465":2754,"_30211":2629,"_20923":57855,"_5":14374,"_27449":57483,"_2949":57856},[],"Clients that create or update CRL settings through the API",{"_3465":2755,"_30211":2629,"_20923":57858,"_5":14374,"_27449":57483,"_2949":57859},[],"Medium: requests with the old field return an error",{"_3465":2756,"_30211":2629,"_20923":57861,"_5":14374,"_27449":57483,"_2949":57862},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3465":2757,"_30211":2629,"_20923":57864,"_5":14374,"_27449":57483,"_2949":57576},[],{"_3465":2758,"_30211":2629,"_20923":57866,"_5":14374,"_27449":57483,"_2949":57867},[],"Alert subscriptions and consumers of the VA events",{"_3465":2759,"_30211":2629,"_20923":57869,"_5":14374,"_27449":57483,"_2949":57870},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3465":2760,"_30211":2629,"_20923":57872,"_5":14374,"_27449":57483,"_2949":57873},[],"Review conditions filtering on the old event payload or subject",{"_3465":2761,"_30211":2629,"_20923":57875,"_5":14374,"_27449":57483,"_2949":57564},[],{"_3465":2762,"_30211":2629,"_20923":57877,"_5":14374,"_27449":57483,"_2949":57878},[],"Consumers that read the device `events` field",{"_3465":2763,"_30211":2629,"_20923":57880,"_5":14374,"_27449":57483,"_2949":57881},[],"Medium: the field disappears",{"_3465":2764,"_30211":2629,"_20923":57883,"_5":14374,"_27449":57483,"_2949":57884},[],"Use the new event endpoints",{"_3465":2765,"_30211":2629,"_20923":57886,"_5":14374,"_27449":57483,"_2949":57584},[],{"_3465":2766,"_30211":2629,"_20923":57888,"_5":14374,"_27449":57483,"_2949":57889},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3465":2767,"_30211":2629,"_20923":57891,"_5":14374,"_27449":57483,"_2949":57892},[],"Medium: the VA migration aborts",{"_3465":2768,"_30211":2629,"_20923":57894,"_5":14374,"_27449":57483,"_2949":57895},[],"Fix the affected roles before upgrading",{"_3465":2769,"_30211":2629,"_20923":57897,"_5":14374,"_27449":57483,"_2949":57516},[],{"_3465":2770,"_30211":2629,"_20923":57899,"_5":14374,"_27449":57483,"_2949":57900},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3465":2771,"_30211":2629,"_20923":57902,"_5":14374,"_27449":57483,"_2949":57903},[],"Low to medium: validation errors or changed defaults",{"_3465":2772,"_30211":2629,"_20923":57905,"_5":14374,"_27449":57483,"_2949":57906},[],"Update the values file",{"_3465":2773,"_30211":2629,"_20923":57908,"_5":14374,"_27449":57483,"_2949":57556},[],{"_3465":2774,"_30211":2629,"_20923":57910,"_5":14374,"_27449":57483,"_2949":57911},[],"Clients that send the DMS ID in the update body",{"_3465":2775,"_30211":2629,"_20923":57913,"_5":14374,"_27449":57483,"_2949":57914},[],"Low: the ID in the URL wins",{"_3465":2776,"_30211":2629,"_20923":57916,"_5":14374,"_27449":57483,"_2949":57917},[],"Send the ID in the URL",{"_3465":2777,"_30211":2629,"_20923":57919,"_5":14374,"_27449":57483,"_2949":57580},[],{"_3465":2778,"_30211":2629,"_20923":57921,"_5":14374,"_27449":57483,"_2949":57922},[],"Clients that send an `id` when creating or importing CAs",{"_3465":2779,"_30211":2629,"_20923":57924,"_5":14374,"_27449":57483,"_2949":57925},[],"Low: the ID in the body is ignored, and the field is removed",{"_3465":2780,"_30211":2629,"_20923":57927,"_5":14374,"_27449":57483,"_2949":57928},[],"Let the backend assign the ID and use the returned one",{"_3465":2781,"_30211":2629,"_20923":57930,"_5":14374,"_27449":57483,"_2949":57560},[],{"_3465":2782,"_30211":2629,"_20923":57932,"_5":14374,"_27449":57483,"_2949":57933},[],"Consumers that match on certificate `type`",{"_3465":2783,"_30211":2629,"_20923":57935,"_5":14374,"_27449":57483,"_2949":57936},[],"Low: two values are renamed",{"_3465":2784,"_30211":2629,"_20923":57938,"_5":14374,"_27449":57483,"_2949":57939},[],"Adapt consumers",{"_3465":2785,"_30211":2629,"_20923":57941,"_5":14374,"_27449":57483,"_2949":57552},[],{"_3465":2786,"_30211":2629,"_20923":57943,"_5":14374,"_27449":57483,"_2949":57944},[],"Any DMS",{"_3465":2787,"_30211":2629,"_20923":57946,"_5":14374,"_27449":57483,"_2949":57947},[],"Low: informational",{"_3465":2788,"_30211":2629,"_20923":57949,"_5":14374,"_27449":57483,"_2949":57950},[],"Read both blocks before editing",{"_3465":2789,"_30211":2629,"_20923":57952,"_5":14374,"_27449":57491,"_2949":57953},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3465":2790,"_30211":2629,"_20923":57955,"_5":14374,"_27449":57491,"_2949":57956},[],"Step 4 of the migration guide copies the data.",{"_3465":2791,"_30211":2629,"_20923":57958,"_5":14374,"_27449":57495,"_2949":57959},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3465":2792,"_30211":2629,"_20923":57961,"_5":14374,"_27449":57499,"_2949":57962},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3465":2793,"_30211":2629,"_20923":57964,"_5":14374,"_27449":57503,"_2949":57965},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3465":2794,"_30211":2629,"_20923":57967,"_5":14374,"_27449":57507,"_2949":57968},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3465":2795,"_30211":2629,"_20923":57970,"_5":14374,"_27449":57507,"_2949":57971},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3465":2796,"_30211":2629,"_20923":57973,"_5":14374,"_27449":57511,"_2949":57974},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3465":2797,"_30211":2629,"_20923":57976,"_5":14374,"_27449":57515,"_2949":57977},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3465":2798,"_30211":2629,"_20923":57979,"_5":14374,"_27449":57515,"_2949":57980},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3465":2799,"_30211":2629,"_20923":57982,"_5":14374,"_27449":57515,"_2949":57983},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3465":2800,"_30211":2629,"_20923":57985,"_5":14374,"_27449":57515,"_2949":57986},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3465":2801,"_30211":2629,"_20923":57988,"_5":14374,"_27449":57515,"_2949":57989},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3465":2802,"_30211":2629,"_20923":57991,"_5":14374,"_27449":57515,"_2949":57992},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3465":2803,"_30211":2629,"_20923":57994,"_5":14374,"_27449":57523,"_2949":57995},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3465":2804,"_30211":2629,"_20923":57997,"_5":14374,"_27449":57523,"_2949":57998},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3465":2805,"_30211":2629,"_20923":58000,"_5":14374,"_27449":57523,"_2949":58001},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3465":2806,"_30211":2629,"_20923":58003,"_5":14374,"_27449":57523,"_2949":58004},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3465":2807,"_30211":2629,"_20923":58006,"_5":14374,"_27449":57523,"_2949":58007},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3465":2808,"_30211":2629,"_20923":58009,"_5":14374,"_27449":57527,"_2949":58010},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3465":2809,"_30211":2629,"_20923":58012,"_5":14374,"_27449":57531,"_2949":58013},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3465":2810,"_30211":2629,"_20923":58015,"_5":14374,"_27449":57531,"_2949":58016},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3465":2811,"_30211":2629,"_20923":58018,"_5":14374,"_27449":57531,"_2949":58019},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3465":2812,"_30211":2629,"_20923":58021,"_5":14374,"_27449":57531,"_2949":58022},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3465":2813,"_30211":2629,"_20923":58024,"_5":14374,"_27449":57531,"_2949":58025},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3465":2814,"_30211":2629,"_20923":58027,"_5":14374,"_27449":57531,"_2949":58028},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3465":2815,"_30211":2629,"_20923":58030,"_5":14374,"_27449":57531,"_2949":58031},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3465":2816,"_30211":2629,"_20923":58033,"_5":14374,"_27449":57531,"_2949":58034},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3465":2817,"_30211":2629,"_20923":58036,"_5":14374,"_27449":57535,"_2949":58037},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3465":2818,"_30211":2629,"_20923":58039,"_5":14374,"_27449":57543,"_2949":58040},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3465":2819,"_30211":2629,"_20923":58042,"_5":14374,"_27449":57543,"_2949":58043},[],"Field in 3.8.0",{"_3465":2820,"_30211":2629,"_20923":58045,"_5":14374,"_27449":57543,"_2949":58046},[],"Field in 4.0.0",{"_3465":2821,"_30211":2629,"_20923":58048,"_5":14374,"_27449":57543,"_2949":58049},[],"`validate_server_cert`",{"_3465":2822,"_30211":2629,"_20923":58051,"_5":14374,"_27449":57543,"_2949":58052},[],"`insecure_skip_verify` (value negated)",{"_3465":2823,"_30211":2629,"_20923":58054,"_5":14374,"_27449":57543,"_2949":58055},[],"`oidc`",{"_3465":2824,"_30211":2629,"_20923":58057,"_5":14374,"_27449":57543,"_2949":58058},[],"`jwt_options`",{"_3465":2825,"_30211":2629,"_20923":58060,"_5":14374,"_27449":57543,"_2949":58061},[],"`apikey`",{"_3465":2826,"_30211":2629,"_20923":58063,"_5":14374,"_27449":57543,"_2949":58064},[],"`apikey_options`",{"_3465":2827,"_30211":2629,"_20923":58066,"_5":14374,"_27449":57543,"_2949":58067},[],"`mtls`",{"_3465":2828,"_30211":2629,"_20923":58069,"_5":14374,"_27449":57543,"_2949":58070},[],"`mtls_options`",{"_3465":2829,"_30211":2629,"_20923":58072,"_5":14374,"_27449":57543,"_2949":58073},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3465":2830,"_30211":2629,"_20923":58075,"_5":14374,"_27449":57543,"_2949":58076},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3465":2831,"_30211":2629,"_20923":58078,"_5":14374,"_27449":57543,"_2949":58079},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3465":2832,"_30211":2629,"_20923":58081,"_5":14374,"_27449":57547,"_2949":58082},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3465":2833,"_30211":2629,"_20923":58084,"_5":14374,"_27449":57547,"_2949":58085},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3465":2834,"_30211":2629,"_20923":58087,"_5":14374,"_27449":57547,"_2949":58088},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3465":2835,"_30211":2629,"_20923":58090,"_5":14374,"_27449":57551,"_2949":58091},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3465":2836,"_30211":2629,"_20923":58093,"_5":14374,"_27449":57555,"_2949":58094},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3465":2837,"_30211":2629,"_20923":58096,"_5":14374,"_27449":57559,"_2949":58097},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3465":2838,"_30211":2629,"_20923":58099,"_5":14374,"_27449":57563,"_2949":58100},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3465":2839,"_30211":2629,"_20923":58102,"_5":14374,"_27449":57563,"_2949":58103},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3465":2840,"_30211":2629,"_20923":58105,"_5":14374,"_27449":57563,"_2949":58106},[],"`POST /v1/devices/:id/events` creates an event.",{"_3465":2841,"_30211":2629,"_20923":58108,"_5":14374,"_27449":57563,"_2949":58109},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3465":2842,"_30211":2629,"_20923":58111,"_5":14374,"_27449":57567,"_2949":58112},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3465":2843,"_30211":2629,"_20923":58114,"_5":14374,"_27449":57571,"_2949":58115},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3465":2844,"_30211":2629,"_20923":58117,"_5":14374,"_27449":57571,"_2949":58118},[],"Route",{"_3465":2845,"_30211":2629,"_20923":58120,"_5":14374,"_27449":57571,"_2949":52515},[],{"_3465":2846,"_30211":2629,"_20923":58122,"_5":14374,"_27449":57571,"_2949":58123},[],"`GET /v1/crl-settings`",{"_3465":2847,"_30211":2629,"_20923":58125,"_5":14374,"_27449":57571,"_2949":58126},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3465":2848,"_30211":2629,"_20923":58128,"_5":14374,"_27449":57571,"_2949":58129},[],"`GET /v1/crl-settings/{ca-id}`",{"_3465":2849,"_30211":2629,"_20923":58131,"_5":14374,"_27449":57571,"_2949":58132},[],"Reads the settings of a CA.",{"_3465":2850,"_30211":2629,"_20923":58134,"_5":14374,"_27449":57571,"_2949":58135},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3465":2851,"_30211":2629,"_20923":58137,"_5":14374,"_27449":57571,"_2949":58138},[],"Replaces `crl_options`.",{"_3465":2852,"_30211":2629,"_20923":58140,"_5":14374,"_27449":57571,"_2949":58141},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3465":2853,"_30211":2629,"_20923":58143,"_5":14374,"_27449":57571,"_2949":58144},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3465":2854,"_30211":2629,"_20923":58146,"_5":14374,"_27449":57571,"_2949":58147},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3465":2855,"_30211":2629,"_20923":58149,"_5":14374,"_27449":57571,"_2949":58150},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3465":2856,"_30211":2629,"_20923":58152,"_5":14374,"_27449":57571,"_2949":58153},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3465":2857,"_30211":2629,"_20923":58155,"_5":14374,"_27449":57571,"_2949":58156},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3465":2858,"_30211":2629,"_20923":58158,"_5":14374,"_27449":57571,"_2949":58159},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3465":2859,"_30211":2629,"_20923":58161,"_5":14374,"_27449":57571,"_2949":58162},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3465":2860,"_30211":2629,"_20923":58164,"_5":14374,"_27449":57571,"_2949":58165},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3465":2861,"_30211":2629,"_20923":58167,"_5":14374,"_27449":57571,"_2949":58168},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3465":2862,"_30211":2629,"_20923":58170,"_5":14374,"_27449":57571,"_2949":58171},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3465":2863,"_30211":2629,"_20923":58173,"_5":14374,"_27449":57575,"_2949":58174},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3465":2864,"_30211":2629,"_20923":58176,"_5":14374,"_27449":57579,"_2949":58177},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3465":2865,"_30211":2629,"_20923":58179,"_5":14374,"_27449":57583,"_2949":58180},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3465":2866,"_30211":2629,"_20923":58182,"_5":14374,"_27449":57587,"_2949":58183},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3465":2867,"_30211":2629,"_20923":58185,"_5":14374,"_27449":57591,"_2949":58186},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3465":2868,"_30211":2629,"_20923":58188,"_5":14374,"_27449":57591,"_2949":58189},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3465":2869,"_30211":2629,"_20923":58191,"_5":14374,"_27449":57591,"_2949":58192},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3465":2870,"_30211":2629,"_20923":58194,"_5":14374,"_27449":57591,"_2949":58195},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3465":2871,"_30211":2629,"_20923":58197,"_5":14374,"_27449":57591,"_2949":58198},[],"Record the names of your local-storage PVCs:",{"_3465":2872,"_30211":2629,"_20923":58200,"_5":14374,"_27449":57591,"_2949":58201},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3465":2873,"_30211":2629,"_20923":58203,"_5":14374,"_27449":57595,"_2949":58204},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3465":2874,"_30211":2629,"_20923":58206,"_5":14374,"_27449":57595,"_2949":58207},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3465":2875,"_30211":2629,"_20923":58209,"_5":14374,"_27449":57595,"_2949":58210},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3465":2876,"_30211":2629,"_20923":58212,"_5":14374,"_27449":57595,"_2949":58213},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3465":2877,"_30211":2629,"_20923":58215,"_5":14374,"_27449":57595,"_2949":58216},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3465":2878,"_30211":2629,"_20923":58218,"_5":14374,"_27449":57599,"_2949":58219},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3465":2879,"_30211":2629,"_20923":58221,"_5":14374,"_27449":57599,"_2949":58222},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3465":2880,"_30211":2629,"_20923":58224,"_5":14374,"_27449":57599,"_2949":58225},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3465":2881,"_30211":2629,"_20923":58227,"_5":14374,"_27449":57599,"_2949":58228},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3465":2882,"_30211":2629,"_20923":58230,"_5":14374,"_27449":57599,"_2949":58231},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3465":2883,"_30211":2629,"_20923":58233,"_5":14374,"_27449":57599,"_2949":58234},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3465":2884,"_30211":2629,"_20923":58236,"_5":14374,"_27449":57599,"_2949":58237},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3465":2885,"_30211":2629,"_20923":58239,"_5":14374,"_27449":57599,"_2949":58240},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3465":2886,"_30211":2629,"_20923":58242,"_5":14374,"_27449":57599,"_2949":58243},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3465":2887,"_30211":2629,"_20923":58245,"_5":14374,"_27449":57599,"_2949":58246},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3465":2888,"_30211":2629,"_20923":58248,"_5":14374,"_27449":57599,"_2949":58249},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3465":2889,"_30211":2629,"_20923":58251,"_5":14374,"_27449":57599,"_2949":58252},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3465":2890,"_30211":2629,"_20923":58254,"_5":14374,"_27449":57603,"_2949":58255},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3465":2891,"_30211":2629,"_20923":58257,"_5":14374,"_27449":57603,"_2949":58258},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3465":2892,"_30211":2629,"_20923":58260,"_5":14374,"_27449":57607,"_2949":58261},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3465":2893,"_30211":2629,"_20923":58263,"_5":14374,"_27449":57607,"_2949":58264},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3465":2894,"_30211":2629,"_20923":58266,"_5":14374,"_27449":57607,"_2949":58267},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3465":2895,"_30211":2629,"_20923":58269,"_5":14374,"_27449":57607,"_2949":58270},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3465":2896,"_30211":2629,"_20923":58272,"_5":14374,"_27449":57607,"_2949":58273},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3465":2897,"_30211":2629,"_20923":58275,"_5":14374,"_27449":57607,"_2949":58276},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3465":2898,"_30211":2629,"_20923":58278,"_5":14374,"_27449":57607,"_2949":58279},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3465":2899,"_30211":2629,"_20923":58281,"_5":14374,"_27449":57607,"_2949":58282},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3465":2900,"_30211":2629,"_20923":58284,"_5":14374,"_27449":57607,"_2949":58285},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3465":2901,"_30211":2629,"_20923":58287,"_5":14374,"_27449":57607,"_2949":58288},[],"**Remove the helper and restore the recorded replica counts:**",{"_3465":2902,"_30211":2629,"_20923":58290,"_5":14374,"_27449":57607,"_2949":58291},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3465":2903,"_30211":2629,"_20923":58293,"_5":14374,"_27449":57611,"_2949":58294},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3465":2904,"_30211":2629,"_20923":58296,"_5":14374,"_27449":57611,"_2949":58297},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3465":2905,"_30211":2629,"_20923":58299,"_5":14374,"_27449":57615,"_2949":58300},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3465":2906,"_30211":2629,"_20923":58302,"_5":14374,"_27449":57615,"_2949":58303},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3465":2907,"_30211":2629,"_20923":58305,"_5":14374,"_27449":57615,"_2949":58306},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration likewise requires `ca` to be migrated first.",{"_3465":2908,"_30211":2629,"_20923":58308,"_5":14374,"_27449":57615,"_2949":58309},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates` and `SELECT` on `ca.ca_certificates`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`.",{"_3465":2909,"_30211":2629,"_20923":58311,"_5":14374,"_27449":57615,"_2949":58312},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3465":2910,"_30211":2629,"_20923":58314,"_5":14374,"_27449":57615,"_2949":58315},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3465":2911,"_30211":2629,"_20923":58317,"_5":14374,"_27449":57615,"_2949":58318},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3465":2912,"_30211":2629,"_20923":58320,"_5":14374,"_27449":57615,"_2949":58321},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3465":2913,"_30211":2629,"_20923":58323,"_5":14374,"_27449":57619,"_2949":58324},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3465":2914,"_30211":2629,"_20923":58326,"_5":14374,"_27449":57619,"_2949":58327},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3465":2915,"_30211":2629,"_20923":58329,"_5":14374,"_27449":57619,"_2949":58330},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3465":2916,"_30211":2629,"_20923":58332,"_5":14374,"_27449":57619,"_2949":58333},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3465":2917,"_30211":2629,"_20923":58335,"_5":14374,"_27449":57619,"_2949":58336},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3465":2918,"_30211":2629,"_20923":58338,"_5":14374,"_27449":57619,"_2949":58339},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3465":2919,"_30211":2629,"_20923":58341,"_5":14374,"_27449":57619,"_2949":58342},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3465":2920,"_30211":2629,"_20923":58344,"_5":14374,"_27449":57619,"_2949":58345},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` schema migration.",{"_3465":2921,"_30211":2629,"_20923":58347,"_5":14374,"_27449":57619,"_2949":58348},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3465":2922,"_30211":2629,"_20923":58350,"_5":14374,"_27449":57619,"_2949":58351},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3465":2923,"_30211":2629,"_20923":58353,"_5":14374,"_27449":57619,"_2949":58354},[],"**A migration or service fails with `permission denied for table ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped. Grant the missing privileges and re-run.",{"_3465":2924,"_30211":2629,"_20923":58356,"_5":14374,"_27449":57622,"_2949":58357},[],"After the upgrade, check in this order:",{"_3465":2925,"_30211":2629,"_20923":58359,"_5":14374,"_27449":57622,"_2949":58360},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3465":2926,"_30211":2629,"_20923":58362,"_5":14374,"_27449":57622,"_2949":58363},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3465":2927,"_30211":2629,"_20923":58365,"_5":14374,"_27449":57622,"_2949":58366},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3465":2928,"_30211":2629,"_20923":58368,"_5":14374,"_27449":57622,"_2949":58369},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3465":2929,"_30211":2629,"_20923":58371,"_5":14374,"_27449":57622,"_2949":58372},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3465":2930,"_30211":2629,"_20923":58374,"_5":14374,"_27449":57622,"_2949":58375},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3465":2931,"_30211":2629,"_20923":58377,"_5":14374,"_27449":57622,"_2949":58378},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3465":2932,"_30211":2629,"_20923":58380,"_5":14374,"_27449":57622,"_2949":58381},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3465":2933,"_30211":2629,"_20923":58383,"_5":14374,"_27449":57622,"_2949":58384},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3465":2934,"_30211":2629,"_20923":58386,"_5":14374,"_27449":57622,"_2949":58387},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3465":2935,"_30211":2629,"_20923":58389,"_5":14374,"_27449":57622,"_2949":58390},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3465":2936,"_30211":2629,"_20923":58392,"_5":14374,"_27449":57622,"_2949":58393},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3465":2937,"_30211":2629,"_20923":58395,"_5":14374,"_27449":57622,"_2949":58396},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3465":2938,"_30211":2629,"_20923":58398,"_5":14374,"_27449":57622,"_2949":58399},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3465":2939,"_30211":2629,"_20923":58401,"_5":14374,"_27449":57622,"_2949":58402},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3465":2940,"_30211":2629,"_20923":58404,"_5":14374,"_27449":57626,"_2949":58405},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3465":2941,"_30211":2629,"_20923":58407,"_5":14374,"_27449":57626,"_2949":58408},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3465":2942,"_30211":2629,"_20923":58410,"_5":14374,"_27449":57626,"_2949":58411},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3465":2943,"_30211":2629,"_20923":58413,"_5":14374,"_27449":57626,"_2949":58414},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3465":2944,"_30211":2629,"_20923":58416,"_5":14374,"_27449":57626