4946,"_40178":124949,"_40180":124952,"_40182":124955,"_40184":124958,"_40186":124961,"_40188":124964,"_40190":124967,"_40192":124970,"_40194":124973,"_40197":124976,"_40199":124979,"_40201":124982,"_40203":124984,"_40205":124986,"_40207":124989,"_40209":124991,"_40211":124994,"_40213":124996,"_40215":124999,"_40217":125002,"_40219":125005,"_40222":125008,"_40225":125011,"_40227":125014,"_40229":125017,"_40231":125020,"_40233":125023,"_40235":125026,"_40237":125029,"_40239":125032,"_40241":125035,"_40244":125038,"_40246":125041,"_40248":125044,"_40250":125047,"_40252":125050,"_40254":125053,"_40256":125056,"_40258":125059,"_40260":125062,"_40262":125065,"_40264":125068,"_40266":125071,"_40268":125074,"_40270":125077,"_40272":125080,"_40274":125083,"_40276":125086,"_40278":125089,"_40280":125092,"_40282":125095,"_40284":125098,"_40286":125101,"_40288":125104,"_40290":125107,"_40292":125110,"_40294":125113,"_40296":125116,"_40298":125119,"_40300":125122,"_40302":125125,"_40304":125128,"_40307":125131,"_40309":125134,"_40311":125137,"_40313":125140,"_40315":125143,"_40317":125146,"_40319":125149,"_40321":125152,"_40323":125155,"_40325":125158,"_40327":125161,"_40329":125164,"_40331":125167,"_40333":125170,"_40335":125173,"_40337":125176,"_40339":125179,"_40341":125182,"_40343":125185,"_40345":125188,"_40347":125191,"_40349":125194,"_40351":125197,"_40353":125200,"_40355":125203,"_40357":125206,"_40359":125209,"_40361":125212,"_40363":125215,"_40365":125218,"_40367":125221,"_40369":125224,"_40371":125227,"_40373":125230,"_40375":125233,"_40377":125236,"_40379":125239,"_40381":125242,"_40383":125245,"_40385":125248,"_40387":125251,"_40389":125254,"_40391":125257,"_40393":125260,"_40395":125263,"_40397":125266,"_40400":125269,"_40402":125272,"_40404":125275},{"_3465":70168,"_30211":70168,"_5":14726,"_2949":116344,"_30563":116345,"_20923":116348,"_27449":70168},"Despliega desde AWS Marketplace",[49273,116346,116347],"Despliegue","Otros modelos",[],{"_3465":70169,"_30211":70168,"_20923":116350,"_5":14374,"_27449":70168,"_2949":116351},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3465":70170,"_30211":70168,"_5":30560,"_20923":116353,"_27449":116354,"_2949":116355},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3465":70171,"_30211":70168,"_5":30560,"_20923":116357,"_27449":116358,"_2949":116359},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3465":70172,"_30211":70168,"_5":30560,"_20923":116361,"_27449":116362,"_2949":116363},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3465":70173,"_30211":70168,"_5":30560,"_20923":116365,"_27449":116366,"_2949":116367},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3465":70174,"_30211":70168,"_5":30560,"_20923":116369,"_27449":116370,"_2949":116371},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3465":70175,"_30211":70168,"_5":30560,"_20923":116373,"_27449":116374,"_2949":116375},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3465":70176,"_30211":70168,"_5":30560,"_20923":116377,"_27449":116378,"_2949":116379},[],"/docs/pr-preview/pr-67/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3465":70177,"_30211":70168,"_20923":116381,"_5":14374,"_27449":70168,"_2949":116382},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3465":70178,"_30211":70168,"_20923":116384,"_5":14374,"_27449":116354,"_2949":116385},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3465":70179,"_30211":70168,"_20923":116387,"_5":14374,"_27449":116354,"_2949":116388},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3465":70180,"_30211":70168,"_20923":116390,"_5":14374,"_27449":116354,"_2949":116391},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3465":70181,"_30211":70168,"_20923":116393,"_5":14374,"_27449":116358,"_2949":116394},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3465":70182,"_30211":70168,"_20923":116396,"_5":14374,"_27449":116358,"_2949":116397},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3465":70183,"_30211":70168,"_20923":116399,"_5":14374,"_27449":116358,"_2949":116400},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3465":70184,"_30211":70168,"_20923":116402,"_5":14374,"_27449":116362,"_2949":116403},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3465":70185,"_30211":70168,"_20923":116405,"_5":14374,"_27449":116366,"_2949":116406},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3465":70186,"_30211":70168,"_20923":116408,"_5":14374,"_27449":116370,"_2949":116409},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3465":70187,"_30211":70168,"_20923":116411,"_5":14374,"_27449":116374,"_2949":116412},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3465":70188,"_30211":70168,"_20923":116414,"_5":14374,"_27449":116378,"_2949":116415},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3465":70189,"_30211":70189,"_5":14726,"_2949":116417,"_30563":116418,"_20923":116419,"_27449":70189},"Despliega Lamassu",[49273,116346],[],{"_3465":70190,"_30211":70189,"_20923":116421,"_5":14374,"_27449":70189,"_2949":116422},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3465":70191,"_30211":70189,"_5":30560,"_20923":116424,"_27449":116425,"_2949":116426},[],"/docs/pr-preview/pr-67/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3465":70192,"_30211":70189,"_5":30560,"_20923":116428,"_27449":116429,"_2949":116430},[],"/docs/pr-preview/pr-67/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3465":70193,"_30211":70189,"_5":30560,"_20923":116432,"_27449":116433,"_2949":116434},[],"/docs/pr-preview/pr-67/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3465":70194,"_30211":70189,"_20923":116436,"_5":14374,"_27449":70189,"_2949":116437},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3465":70195,"_30211":70189,"_20923":116439,"_5":14374,"_27449":116425,"_2949":116440},[],"Modelo",{"_3465":70196,"_30211":70189,"_20923":116442,"_5":14374,"_27449":116425,"_2949":116443},[],"Recomendado para",{"_3465":70197,"_30211":70189,"_20923":116445,"_5":14374,"_27449":116425,"_2949":116446},[],"Quién opera la infraestructura",{"_3465":70198,"_30211":70189,"_20923":116448,"_5":14374,"_27449":116425,"_2949":116449},[],"Punto de partida",{"_3465":70199,"_30211":70189,"_20923":116451,"_5":14374,"_27449":116425,"_2949":49380},[],{"_3465":70200,"_30211":70189,"_20923":116453,"_5":14374,"_27449":116425,"_2949":116454},[],"Producción, entornos regulados y despliegues personalizados",{"_3465":70201,"_30211":70189,"_20923":116456,"_5":14374,"_27449":116425,"_2949":116457},[],"Tu equipo",{"_3465":70202,"_30211":70189,"_20923":116459,"_5":14374,"_27449":116425,"_2949":116460},[],"Helm o Fastlane",{"_3465":70203,"_30211":70189,"_20923":116462,"_5":14374,"_27449":116425,"_2949":49392},[],{"_3465":70204,"_30211":70189,"_20923":116464,"_5":14374,"_27449":116425,"_2949":116465},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3465":70205,"_30211":70189,"_20923":116467,"_5":14374,"_27449":116425,"_2949":116457},[],{"_3465":70206,"_30211":70189,"_20923":116469,"_5":14374,"_27449":116425,"_2949":116470},[],"Imagen preconfigurada en EC2",{"_3465":70207,"_30211":70189,"_20923":116472,"_5":14374,"_27449":116425,"_2949":49403},[],{"_3465":70208,"_30211":70189,"_20923":116474,"_5":14374,"_27449":116425,"_2949":116475},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3465":70209,"_30211":70189,"_20923":116477,"_5":14374,"_27449":116425,"_2949":49409},[],{"_3465":70210,"_30211":70189,"_20923":116479,"_5":14374,"_27449":116425,"_2949":116480},[],"Suscripción gestionada",{"_3465":70211,"_30211":70189,"_20923":116482,"_5":14374,"_27449":116425,"_2949":116483},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3465":70212,"_30211":70189,"_20923":116485,"_5":14374,"_27449":116425,"_2949":116486},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3465":70213,"_30211":70189,"_20923":116488,"_5":14374,"_27449":116425,"_2949":116489},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3465":70214,"_30211":70189,"_20923":116491,"_5":14374,"_27449":116429,"_2949":116492},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3465":70215,"_30211":70189,"_20923":116494,"_5":14374,"_27449":116433,"_2949":116495},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3465":70216,"_30211":70216,"_5":14726,"_2949":116497,"_30563":116498,"_20923":116499,"_27449":70216},"Utiliza Lamassu como SaaS",[49273,116346,116347],[],{"_3465":70217,"_30211":70216,"_20923":116501,"_5":14374,"_27449":70216,"_2949":116502},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3465":70218,"_30211":70216,"_5":30560,"_20923":116504,"_27449":116505,"_2949":116506},[],"/docs/pr-preview/pr-67/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3465":70219,"_30211":70216,"_5":30560,"_20923":116508,"_27449":116509,"_2949":116510},[],"/docs/pr-preview/pr-67/es/deployment/saas#planes","Planes",{"_3465":70220,"_30211":70216,"_5":30560,"_20923":116512,"_27449":116513,"_2949":116514},[],"/docs/pr-preview/pr-67/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3465":70221,"_30211":70216,"_20923":116516,"_5":14374,"_27449":70216,"_2949":116517},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3465":70222,"_30211":70216,"_20923":116519,"_5":14374,"_27449":116505,"_2949":116520},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3465":70223,"_30211":70216,"_20923":116522,"_5":14374,"_27449":116505,"_2949":116523},[],"Copias de seguridad automáticas.",{"_3465":70224,"_30211":70216,"_20923":116525,"_5":14374,"_27449":116505,"_2949":116526},[],"Actualizaciones de versión.",{"_3465":70225,"_30211":70216,"_20923":116528,"_5":14374,"_27449":116505,"_2949":116529},[],"Soporte técnico y SLA según el plan contratado.",{"_3465":70226,"_30211":70216,"_20923":116531,"_5":14374,"_27449":116509,"_2949":49464},[],{"_3465":70227,"_30211":70216,"_20923":116533,"_5":14374,"_27449":116509,"_2949":116534},[],"Dispositivos",{"_3465":70228,"_30211":70216,"_20923":116536,"_5":14374,"_27449":116509,"_2949":116537},[],"Soporte",{"_3465":70229,"_30211":70216,"_20923":116539,"_5":14374,"_27449":116509,"_2949":49473},[],{"_3465":70230,"_30211":70216,"_20923":116541,"_5":14374,"_27449":116509,"_2949":49476},[],{"_3465":70231,"_30211":70216,"_20923":116543,"_5":14374,"_27449":116509,"_2949":116544},[],"Hasta 1.000",{"_3465":70232,"_30211":70216,"_20923":116546,"_5":14374,"_27449":116509,"_2949":49482},[],{"_3465":70233,"_30211":70216,"_20923":116548,"_5":14374,"_27449":116509,"_2949":116549},[],"99,5 %",{"_3465":70234,"_30211":70216,"_20923":116551,"_5":14374,"_27449":116509,"_2949":49488},[],{"_3465":70235,"_30211":70216,"_20923":116553,"_5":14374,"_27449":116509,"_2949":116554},[],"Hasta 10.000",{"_3465":70236,"_30211":70216,"_20923":116556,"_5":14374,"_27449":116509,"_2949":116557},[],"Email y chat",{"_3465":70237,"_30211":70216,"_20923":116559,"_5":14374,"_27449":116509,"_2949":116560},[],"99,9 %",{"_3465":70238,"_30211":70216,"_20923":116562,"_5":14374,"_27449":116509,"_2949":49500},[],{"_3465":70239,"_30211":70216,"_20923":116564,"_5":14374,"_27449":116509,"_2949":116565},[],"Ilimitados",{"_3465":70240,"_30211":70216,"_20923":116567,"_5":14374,"_27449":116509,"_2949":116568},[],"Dedicado",{"_3465":70241,"_30211":70216,"_20923":116570,"_5":14374,"_27449":116509,"_2949":116571},[],"99,99 %",{"_3465":70242,"_30211":70216,"_20923":116573,"_5":14374,"_27449":116513,"_2949":116574},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3465":70243,"_30211":70216,"_20923":116576,"_5":14374,"_27449":116513,"_2949":116577},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3465":70244,"_30211":70244,"_5":14726,"_2949":49517,"_30563":116579,"_20923":116581,"_27449":70244},[49273,116346,116580],"Kubernetes autogestionado",[],{"_3465":70245,"_30211":70244,"_20923":116583,"_5":14374,"_27449":70244,"_2949":116584},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3465":70246,"_30211":70244,"_5":30560,"_20923":116586,"_27449":116587,"_2949":116588},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3465":70247,"_30211":70244,"_5":30560,"_20923":116590,"_27449":116591,"_2949":116592},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3465":70248,"_30211":70244,"_5":30560,"_20923":116594,"_27449":116595,"_2949":116596},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3465":70249,"_30211":70244,"_5":30560,"_20923":116598,"_27449":116599,"_2949":116600},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3465":70250,"_30211":70244,"_5":30560,"_20923":116602,"_27449":116603,"_2949":116604},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3465":70251,"_30211":70244,"_5":30560,"_20923":116606,"_27449":116607,"_2949":116608},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3465":70252,"_30211":70244,"_5":30560,"_20923":116610,"_27449":116611,"_2949":116612},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3465":70253,"_30211":70244,"_5":30560,"_20923":116614,"_27449":116615,"_2949":116616},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3465":70254,"_30211":70244,"_5":30560,"_20923":116618,"_27449":116619,"_2949":116620},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3465":70255,"_30211":70244,"_5":30560,"_20923":116622,"_27449":116623,"_2949":116624},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3465":70256,"_30211":70244,"_5":30560,"_20923":116626,"_27449":116627,"_2949":116628},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3465":70257,"_30211":70244,"_20923":116630,"_5":14374,"_27449":116587,"_2949":116631},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3465":70258,"_30211":70244,"_20923":116633,"_5":14374,"_27449":116587,"_2949":116634},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3465":70259,"_30211":70244,"_20923":116636,"_5":14374,"_27449":116591,"_2949":116637},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3465":70260,"_30211":70244,"_20923":116639,"_5":14374,"_27449":116591,"_2949":116640},[],"Fastlane instala o configura",{"_3465":70261,"_30211":70244,"_20923":116642,"_5":14374,"_27449":116591,"_2949":116643},[],"Tú sigues proporcionando",{"_3465":70262,"_30211":70244,"_20923":116645,"_5":14374,"_27449":116591,"_2949":116646},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3465":70263,"_30211":70244,"_20923":116648,"_5":14374,"_27449":116591,"_2949":116649},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3465":70264,"_30211":70244,"_20923":116651,"_5":14374,"_27449":116591,"_2949":116652},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3465":70265,"_30211":70244,"_20923":116654,"_5":14374,"_27449":116591,"_2949":116655},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3465":70266,"_30211":70244,"_20923":116657,"_5":14374,"_27449":116591,"_2949":116658},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3465":70267,"_30211":70244,"_20923":116660,"_5":14374,"_27449":116591,"_2949":116661},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3465":70268,"_30211":70244,"_20923":116663,"_5":14374,"_27449":116591,"_2949":116664},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3465":70269,"_30211":70244,"_20923":116666,"_5":14374,"_27449":116591,"_2949":116667},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3465":70270,"_30211":70244,"_20923":116669,"_5":14374,"_27449":116591,"_2949":116670},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3465":70271,"_30211":70244,"_20923":116672,"_5":14374,"_27449":116595,"_2949":116673},[],"Necesitas:",{"_3465":70272,"_30211":70244,"_20923":116675,"_5":14374,"_27449":116595,"_2949":116676},[],"un clúster Kubernetes existente",{"_3465":70273,"_30211":70244,"_20923":116678,"_5":14374,"_27449":116595,"_2949":116679},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3465":70274,"_30211":70244,"_20923":116681,"_5":14374,"_27449":116595,"_2949":49619},[],{"_3465":70275,"_30211":70244,"_20923":116683,"_5":14374,"_27449":116595,"_2949":23667},[],{"_3465":70276,"_30211":70244,"_20923":116685,"_5":14374,"_27449":116595,"_2949":116686},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3465":70277,"_30211":70244,"_20923":116688,"_5":14374,"_27449":116595,"_2949":116689},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3465":70278,"_30211":70244,"_20923":116691,"_5":14374,"_27449":116595,"_2949":116692},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3465":70279,"_30211":70244,"_20923":116694,"_5":14374,"_27449":116595,"_2949":116695},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3465":70280,"_30211":70244,"_20923":116697,"_5":14374,"_27449":116595,"_2949":116698},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3465":70281,"_30211":70244,"_20923":116700,"_5":14374,"_27449":116599,"_2949":116701},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3465":70282,"_30211":70244,"_20923":116703,"_5":14374,"_27449":116599,"_2949":116704},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3465":70283,"_30211":70244,"_20923":116706,"_5":14374,"_27449":116603,"_2949":116707},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3465":70284,"_30211":70244,"_20923":116709,"_5":14374,"_27449":116603,"_2949":116710},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3465":70285,"_30211":70244,"_20923":116712,"_5":14374,"_27449":116603,"_2949":116713},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3465":70286,"_30211":70244,"_20923":116715,"_5":14374,"_27449":116603,"_2949":116716},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3465":70287,"_30211":70244,"_20923":116718,"_5":14374,"_27449":116607,"_2949":116719},[],"Opción",{"_3465":70288,"_30211":70244,"_20923":116721,"_5":14374,"_27449":116607,"_2949":116722},[],"Valor predeterminado",{"_3465":70289,"_30211":70244,"_20923":116724,"_5":14374,"_27449":116607,"_2949":116725},[],"Propósito",{"_3465":70290,"_30211":70244,"_20923":116727,"_5":14374,"_27449":116607,"_2949":49666},[],{"_3465":70291,"_30211":70244,"_20923":116729,"_5":14374,"_27449":116607,"_2949":49669},[],{"_3465":70292,"_30211":70244,"_20923":116731,"_5":14374,"_27449":116607,"_2949":116732},[],"Muestra la ayuda",{"_3465":70293,"_30211":70244,"_20923":116734,"_5":14374,"_27449":116607,"_2949":49675},[],{"_3465":70294,"_30211":70244,"_20923":116736,"_5":14374,"_27449":116607,"_2949":116737},[],"contexto actual",{"_3465":70295,"_30211":70244,"_20923":116739,"_5":14374,"_27449":116607,"_2949":116740},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3465":70296,"_30211":70244,"_20923":116742,"_5":14374,"_27449":116607,"_2949":49684},[],{"_3465":70297,"_30211":70244,"_20923":116744,"_5":14374,"_27449":116607,"_2949":6537},[],{"_3465":70298,"_30211":70244,"_20923":116746,"_5":14374,"_27449":116607,"_2949":116747},[],"Omite prompts y genera credenciales para las dependencias",{"_3465":70299,"_30211":70244,"_20923":116749,"_5":14374,"_27449":116607,"_2949":49692},[],{"_3465":70300,"_30211":70244,"_20923":116751,"_5":14374,"_27449":116607,"_2949":49695},[],{"_3465":70301,"_30211":70244,"_20923":116753,"_5":14374,"_27449":116607,"_2949":116754},[],"Namespace de la instalación",{"_3465":70302,"_30211":70244,"_20923":116756,"_5":14374,"_27449":116607,"_2949":49701},[],{"_3465":70303,"_30211":70244,"_20923":116758,"_5":14374,"_27449":116607,"_2949":49704},[],{"_3465":70304,"_30211":70244,"_20923":116760,"_5":14374,"_27449":116607,"_2949":116761},[],"Dominio usado por la UI, OIDC y el certificado",{"_3465":70305,"_30211":70244,"_20923":116763,"_5":14374,"_27449":116607,"_2949":49710},[],{"_3465":70306,"_30211":70244,"_20923":116765,"_5":14374,"_27449":116607,"_2949":15066},[],{"_3465":70307,"_30211":70244,"_20923":116767,"_5":14374,"_27449":116607,"_2949":116768},[],"Versión del chart de Lamassu",{"_3465":70308,"_30211":70244,"_20923":116770,"_5":14374,"_27449":116607,"_2949":49718},[],{"_3465":70309,"_30211":70244,"_20923":116772,"_5":14374,"_27449":116607,"_2949":49721},[],{"_3465":70310,"_30211":70244,"_20923":116774,"_5":14374,"_27449":116607,"_2949":116775},[],"Puerto del listener HTTPS",{"_3465":70311,"_30211":70244,"_20923":116777,"_5":14374,"_27449":116607,"_2949":49727},[],{"_3465":70312,"_30211":70244,"_20923":116779,"_5":14374,"_27449":116607,"_2949":49730},[],{"_3465":70313,"_30211":70244,"_20923":116781,"_5":14374,"_27449":116607,"_2949":116782},[],"Puerto del listener HTTP",{"_3465":70314,"_30211":70244,"_20923":116784,"_5":14374,"_27449":116607,"_2949":49736},[],{"_3465":70315,"_30211":70244,"_20923":116786,"_5":14374,"_27449":116607,"_2949":49669},[],{"_3465":70316,"_30211":70244,"_20923":116788,"_5":14374,"_27449":116607,"_2949":116789},[],"Certificado PEM para TLS downstream",{"_3465":70317,"_30211":70244,"_20923":116791,"_5":14374,"_27449":116607,"_2949":49744},[],{"_3465":70318,"_30211":70244,"_20923":116793,"_5":14374,"_27449":116607,"_2949":49669},[],{"_3465":70319,"_30211":70244,"_20923":116795,"_5":14374,"_27449":116607,"_2949":116796},[],"Clave privada PEM para TLS downstream",{"_3465":70320,"_30211":70244,"_20923":116798,"_5":14374,"_27449":116607,"_2949":49752},[],{"_3465":70321,"_30211":70244,"_20923":116800,"_5":14374,"_27449":116607,"_2949":116801},[],"chart del repositorio",{"_3465":70322,"_30211":70244,"_20923":116803,"_5":14374,"_27449":116607,"_2949":116804},[],"Usa un chart local de Lamassu sin empaquetar",{"_3465":70323,"_30211":70244,"_20923":116806,"_5":14374,"_27449":116607,"_2949":49761},[],{"_3465":70324,"_30211":70244,"_20923":116808,"_5":14374,"_27449":116607,"_2949":116809},[],"detección automática",{"_3465":70325,"_30211":70244,"_20923":116811,"_5":14374,"_27449":116607,"_2949":116812},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3465":70326,"_30211":70244,"_20923":116814,"_5":14374,"_27449":116607,"_2949":49769},[],{"_3465":70327,"_30211":70244,"_20923":116816,"_5":14374,"_27449":116607,"_2949":6537},[],{"_3465":70328,"_30211":70244,"_20923":116818,"_5":14374,"_27449":116607,"_2949":116819},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3465":70329,"_30211":70244,"_20923":116821,"_5":14374,"_27449":116607,"_2949":49777},[],{"_3465":70330,"_30211":70244,"_20923":116823,"_5":14374,"_27449":116607,"_2949":6537},[],{"_3465":70331,"_30211":70244,"_20923":116825,"_5":14374,"_27449":116607,"_2949":116826},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3465":70332,"_30211":70244,"_20923":116828,"_5":14374,"_27449":116607,"_2949":49785},[],{"_3465":70333,"_30211":70244,"_20923":116830,"_5":14374,"_27449":116607,"_2949":6537},[],{"_3465":70334,"_30211":70244,"_20923":116832,"_5":14374,"_27449":116607,"_2949":116833},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3465":70335,"_30211":70244,"_20923":116835,"_5":14374,"_27449":116607,"_2949":49793},[],{"_3465":70336,"_30211":70244,"_20923":116837,"_5":14374,"_27449":116607,"_2949":6537},[],{"_3465":70337,"_30211":70244,"_20923":116839,"_5":14374,"_27449":116607,"_2949":116840},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3465":70338,"_30211":70244,"_20923":116842,"_5":14374,"_27449":116607,"_2949":49801},[],{"_3465":70339,"_30211":70244,"_20923":116844,"_5":14374,"_27449":116607,"_2949":49804},[],{"_3465":70340,"_30211":70244,"_20923":116846,"_5":14374,"_27449":116607,"_2949":116847},[],"Usa otro chart local de SoftHSM",{"_3465":70341,"_30211":70244,"_20923":116849,"_5":14374,"_27449":116607,"_2949":116850},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3465":70342,"_30211":70244,"_20923":116852,"_5":14374,"_27449":116611,"_2949":116853},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3465":70343,"_30211":70244,"_20923":116855,"_5":14374,"_27449":116611,"_2949":116856},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3465":70344,"_30211":70244,"_20923":116858,"_5":14374,"_27449":116611,"_2949":116859},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3465":70345,"_30211":70244,"_20923":116861,"_5":14374,"_27449":116611,"_2949":116862},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3465":70346,"_30211":70244,"_20923":116864,"_5":14374,"_27449":116611,"_2949":116865},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3465":70347,"_30211":70244,"_20923":116867,"_5":14374,"_27449":116611,"_2949":116868},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3465":70348,"_30211":70244,"_20923":116870,"_5":14374,"_27449":116615,"_2949":49831},[],{"_3465":70349,"_30211":70244,"_20923":116872,"_5":14374,"_27449":116615,"_2949":116873},[],"valida las herramientas locales y el clúster seleccionado",{"_3465":70350,"_30211":70244,"_20923":116875,"_5":14374,"_27449":116615,"_2949":116876},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3465":70351,"_30211":70244,"_20923":116878,"_5":14374,"_27449":116615,"_2949":116879},[],"crea el namespace",{"_3465":70352,"_30211":70244,"_20923":116881,"_5":14374,"_27449":116615,"_2949":116882},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3465":70353,"_30211":70244,"_20923":116884,"_5":14374,"_27449":116615,"_2949":116885},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3465":70354,"_30211":70244,"_20923":116887,"_5":14374,"_27449":116615,"_2949":116888},[],"instala RabbitMQ",{"_3465":70355,"_30211":70244,"_20923":116890,"_5":14374,"_27449":116615,"_2949":116891},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3465":70356,"_30211":70244,"_20923":116893,"_5":14374,"_27449":116615,"_2949":116894},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3465":70357,"_30211":70244,"_20923":116896,"_5":14374,"_27449":116615,"_2949":116897},[],"carga datos de ejemplo opcionalmente",{"_3465":70358,"_30211":70244,"_20923":116899,"_5":14374,"_27449":116615,"_2949":116900},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3465":70359,"_30211":70244,"_20923":116902,"_5":14374,"_27449":116619,"_2949":116903},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3465":70360,"_30211":70244,"_20923":116905,"_5":14374,"_27449":116619,"_2949":116906},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3465":70361,"_30211":70244,"_20923":116908,"_5":14374,"_27449":116623,"_2949":116909},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3465":70362,"_30211":70244,"_20923":116911,"_5":14374,"_27449":116623,"_2949":116912},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3465":70363,"_30211":70244,"_20923":116914,"_5":14374,"_27449":116623,"_2949":116915},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3465":70364,"_30211":70244,"_20923":116917,"_5":14374,"_27449":116627,"_2949":116918},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3465":70365,"_30211":70365,"_5":14726,"_2949":116920,"_30563":116921,"_20923":116922,"_27449":70365},"Instala con Helm",[49273,116346,116580],[],{"_3465":70366,"_30211":70365,"_20923":116924,"_5":14374,"_27449":70365,"_2949":116925},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3465":70367,"_30211":70365,"_5":30560,"_20923":116927,"_27449":116928,"_2949":116929},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3465":70368,"_30211":70365,"_5":30560,"_20923":116931,"_27449":116932,"_2949":116596},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3465":70369,"_30211":70365,"_5":30560,"_20923":116934,"_27449":116935,"_2949":116936},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3465":70370,"_30211":70365,"_5":30560,"_20923":116938,"_27449":116939,"_2949":116940},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3465":70371,"_30211":70365,"_5":30560,"_20923":116942,"_27449":116943,"_2949":116944},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3465":70372,"_30211":70365,"_5":30560,"_20923":116946,"_27449":116947,"_2949":116948},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3465":70373,"_30211":70365,"_5":30560,"_20923":116950,"_27449":116951,"_2949":116952},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3465":70374,"_30211":70365,"_5":30560,"_20923":116954,"_27449":116955,"_2949":116956},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3465":70375,"_30211":70365,"_5":30560,"_20923":116958,"_27449":116959,"_2949":116960},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3465":70376,"_30211":70365,"_5":30560,"_20923":116962,"_27449":116963,"_2949":116964},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3465":70377,"_30211":70365,"_5":30560,"_20923":116966,"_27449":116967,"_2949":116968},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3465":70378,"_30211":70365,"_20923":116970,"_5":14374,"_27449":116928,"_2949":116971},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3465":70379,"_30211":70365,"_20923":116973,"_5":14374,"_27449":116932,"_2949":116974},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3465":70380,"_30211":70365,"_20923":116976,"_5":14374,"_27449":116932,"_2949":116977},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3465":70381,"_30211":70365,"_20923":116979,"_5":14374,"_27449":116932,"_2949":116980},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3465":70382,"_30211":70365,"_20923":116982,"_5":14374,"_27449":116932,"_2949":116983},[],"un broker RabbitMQ accesible y sus credenciales",{"_3465":70383,"_30211":70365,"_20923":116985,"_5":14374,"_27449":116932,"_2949":116986},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3465":70384,"_30211":70365,"_20923":116988,"_5":14374,"_27449":116932,"_2949":116989},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3465":70385,"_30211":70365,"_20923":116991,"_5":14374,"_27449":116932,"_2949":116992},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3465":70386,"_30211":70365,"_20923":116994,"_5":14374,"_27449":116932,"_2949":116995},[],"una StorageClass y un diseño de tráfico externo",{"_3465":70387,"_30211":70365,"_20923":116997,"_5":14374,"_27449":116932,"_2949":116998},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3465":70388,"_30211":70365,"_20923":117000,"_5":14374,"_27449":116932,"_2949":117001},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3465":70389,"_30211":70365,"_20923":117003,"_5":14374,"_27449":116932,"_2949":117004},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3465":70390,"_30211":70365,"_20923":117006,"_5":14374,"_27449":116935,"_2949":117007},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3465":70391,"_30211":70365,"_20923":117009,"_5":14374,"_27449":116935,"_2949":117010},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3465":70392,"_30211":70365,"_20923":117012,"_5":14374,"_27449":116935,"_2949":117013},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3465":70393,"_30211":70365,"_20923":117015,"_5":14374,"_27449":116939,"_2949":117016},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3465":70394,"_30211":70365,"_20923":117018,"_5":14374,"_27449":116939,"_2949":117019},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3465":70395,"_30211":70365,"_20923":117021,"_5":14374,"_27449":116939,"_2949":117022},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3465":70396,"_30211":70365,"_20923":117024,"_5":14374,"_27449":116939,"_2949":117025},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3465":70397,"_30211":70365,"_20923":117027,"_5":14374,"_27449":116943,"_2949":117028},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3465":70398,"_30211":70365,"_20923":117030,"_5":14374,"_27449":116947,"_2949":117031},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3465":70399,"_30211":70365,"_20923":117033,"_5":14374,"_27449":116947,"_2949":117034},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3465":70400,"_30211":70365,"_20923":117036,"_5":14374,"_27449":116947,"_2949":117037},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3465":70401,"_30211":70365,"_20923":117039,"_5":14374,"_27449":116947,"_2949":117040},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3465":70402,"_30211":70365,"_20923":117042,"_5":14374,"_27449":116947,"_2949":117043},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3465":70403,"_30211":70365,"_20923":117045,"_5":14374,"_27449":116947,"_2949":117046},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3465":70404,"_30211":70365,"_20923":117048,"_5":14374,"_27449":116947,"_2949":117049},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3465":70405,"_30211":70365,"_20923":117051,"_5":14374,"_27449":116951,"_2949":117052},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3465":70406,"_30211":70365,"_20923":117054,"_5":14374,"_27449":116951,"_2949":117055},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3465":70407,"_30211":70365,"_20923":117057,"_5":14374,"_27449":116951,"_2949":117058},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3465":70408,"_30211":70365,"_20923":117060,"_5":14374,"_27449":116951,"_2949":117061},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3465":70409,"_30211":70365,"_20923":117063,"_5":14374,"_27449":116955,"_2949":117064},[],"Para instalar un checkout local:",{"_3465":70410,"_30211":70365,"_20923":117066,"_5":14374,"_27449":116959,"_2949":117067},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3465":70411,"_30211":70365,"_20923":117069,"_5":14374,"_27449":116959,"_2949":117070},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3465":70412,"_30211":70365,"_20923":117072,"_5":14374,"_27449":116963,"_2949":117073},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3465":70413,"_30211":70365,"_20923":117075,"_5":14374,"_27449":116963,"_2949":117076},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3465":70414,"_30211":70365,"_20923":117078,"_5":14374,"_27449":116963,"_2949":117079},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3465":70415,"_30211":70365,"_20923":117081,"_5":14374,"_27449":116963,"_2949":117082},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3465":70416,"_30211":70365,"_20923":117084,"_5":14374,"_27449":116963,"_2949":117085},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3465":70417,"_30211":70365,"_20923":117087,"_5":14374,"_27449":116967,"_2949":117088},[],"Antes de pasar a producción, revisa:",{"_3465":70418,"_30211":70365,"_20923":117090,"_5":14374,"_27449":116967,"_2949":117091},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3465":70419,"_30211":70365,"_20923":117093,"_5":14374,"_27449":116967,"_2949":117094},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3465":70420,"_30211":70365,"_20923":117096,"_5":14374,"_27449":116967,"_2949":117097},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3465":70421,"_30211":70365,"_20923":117099,"_5":14374,"_27449":116967,"_2949":117100},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3465":70422,"_30211":70365,"_20923":117102,"_5":14374,"_27449":116967,"_2949":117103},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3465":70423,"_30211":70365,"_20923":117105,"_5":14374,"_27449":116967,"_2949":117106},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3465":70424,"_30211":70365,"_20923":117108,"_5":14374,"_27449":116967,"_2949":117109},[],"SMTP, observabilidad y entrega de alertas",{"_3465":70425,"_30211":70365,"_20923":117111,"_5":14374,"_27449":116967,"_2949":117112},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3465":70426,"_30211":70365,"_20923":117114,"_5":14374,"_27449":116967,"_2949":117115},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3465":70427,"_30211":70427,"_5":14726,"_2949":117117,"_30563":117118,"_20923":117119,"_27449":70427},"Expón el Gateway",[49273,116346,116580],[],{"_3465":70428,"_30211":70427,"_20923":117121,"_5":14374,"_27449":70427,"_2949":117122},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3465":70429,"_30211":70427,"_5":30560,"_20923":117124,"_27449":117125,"_2949":117126},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3465":70430,"_30211":70427,"_5":30560,"_20923":117128,"_27449":117129,"_2949":117130},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3465":70431,"_30211":70427,"_5":30560,"_20923":117132,"_27449":117133,"_2949":117134},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3465":70432,"_30211":70427,"_5":30560,"_20923":117136,"_27449":117137,"_2949":50099},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#k3s",{"_3465":70433,"_30211":70427,"_5":30560,"_20923":117139,"_27449":117140,"_2949":117141},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3465":70434,"_30211":70427,"_5":30560,"_20923":117143,"_27449":117144,"_2949":117145},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3465":70435,"_30211":70427,"_5":30560,"_20923":117147,"_27449":117148,"_2949":117149},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3465":70436,"_30211":70427,"_5":30560,"_20923":117151,"_27449":117152,"_2949":117153},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3465":70437,"_30211":70427,"_5":30560,"_20923":117155,"_27449":117156,"_2949":117157},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3465":70438,"_30211":70427,"_5":30560,"_20923":117159,"_27449":117160,"_2949":117161},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3465":70439,"_30211":70427,"_5":30560,"_20923":117163,"_27449":117164,"_2949":117165},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3465":70440,"_30211":70427,"_20923":117167,"_5":14374,"_27449":117125,"_2949":117168},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3465":70441,"_30211":70427,"_20923":117170,"_5":14374,"_27449":117125,"_2949":117171},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3465":70442,"_30211":70427,"_20923":117173,"_5":14374,"_27449":117129,"_2949":117174},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3465":70443,"_30211":70427,"_20923":117176,"_5":14374,"_27449":117129,"_2949":117177},[],"Defínelo únicamente cuando:",{"_3465":70444,"_30211":70427,"_20923":117179,"_5":14374,"_27449":117129,"_2949":117180},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3465":70445,"_30211":70427,"_20923":117182,"_5":14374,"_27449":117129,"_2949":117183},[],"esa dirección está asignada a este Gateway",{"_3465":70446,"_30211":70427,"_20923":117185,"_5":14374,"_27449":117129,"_2949":117186},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3465":70447,"_30211":70427,"_20923":117188,"_5":14374,"_27449":117129,"_2949":117189},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3465":70448,"_30211":70427,"_20923":117191,"_5":14374,"_27449":117129,"_2949":117192},[],"No confundas estos valores:",{"_3465":70449,"_30211":70427,"_20923":117194,"_5":14374,"_27449":117129,"_2949":117195},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3465":70450,"_30211":70427,"_20923":117197,"_5":14374,"_27449":117129,"_2949":117198},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3465":70451,"_30211":70427,"_20923":117200,"_5":14374,"_27449":117129,"_2949":117201},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3465":70452,"_30211":70427,"_20923":117203,"_5":14374,"_27449":117133,"_2949":117204},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3465":70453,"_30211":70427,"_20923":117206,"_5":14374,"_27449":117133,"_2949":117207},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3465":70454,"_30211":70427,"_20923":117209,"_5":14374,"_27449":117137,"_2949":117210},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3465":70455,"_30211":70427,"_20923":117212,"_5":14374,"_27449":117137,"_2949":117213},[],"Para el diseño recomendado:",{"_3465":70456,"_30211":70427,"_20923":117215,"_5":14374,"_27449":117137,"_2949":117216},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3465":70457,"_30211":70427,"_20923":117218,"_5":14374,"_27449":117137,"_2949":117219},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3465":70458,"_30211":70427,"_20923":117221,"_5":14374,"_27449":117137,"_2949":117222},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3465":70459,"_30211":70427,"_20923":117224,"_5":14374,"_27449":117137,"_2949":117225},[],"Apunta DNS a la dirección accesible de la VM.",{"_3465":70460,"_30211":70427,"_20923":117227,"_5":14374,"_27449":117137,"_2949":117228},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3465":70461,"_30211":70427,"_20923":117230,"_5":14374,"_27449":117140,"_2949":117231},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3465":70462,"_30211":70427,"_20923":117233,"_5":14374,"_27449":117144,"_2949":117234},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3465":70463,"_30211":70427,"_20923":117236,"_5":14374,"_27449":117144,"_2949":117237},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3465":70464,"_30211":70427,"_20923":117239,"_5":14374,"_27449":117148,"_2949":117240},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3465":70465,"_30211":70427,"_20923":117242,"_5":14374,"_27449":117148,"_2949":117243},[],"Requisito",{"_3465":70466,"_30211":70427,"_20923":117245,"_5":14374,"_27449":117148,"_2949":117246},[],"Diseño recomendado",{"_3465":70467,"_30211":70427,"_20923":117248,"_5":14374,"_27449":117148,"_2949":117249},[],"Consecuencia",{"_3465":70468,"_30211":70427,"_20923":117251,"_5":14374,"_27449":117148,"_2949":117252},[],"Varias URL o servicios de Lamassu",{"_3465":70469,"_30211":70427,"_20923":117254,"_5":14374,"_27449":117148,"_2949":117255},[],"Un Gateway con varias rutas",{"_3465":70470,"_30211":70427,"_20923":117257,"_5":14374,"_27449":117148,"_2949":117258},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3465":70471,"_30211":70427,"_20923":117260,"_5":14374,"_27449":117148,"_2949":117261},[],"Gateways independientes e IP externas distintas",{"_3465":70472,"_30211":70427,"_20923":117263,"_5":14374,"_27449":117148,"_2949":117264},[],"Una VIP por Gateway",{"_3465":70473,"_30211":70427,"_20923":117266,"_5":14374,"_27449":117148,"_2949":117267},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3465":70474,"_30211":70427,"_20923":117269,"_5":14374,"_27449":117148,"_2949":117270},[],"Gateways independientes, un nodo y una IP",{"_3465":70475,"_30211":70427,"_20923":117272,"_5":14374,"_27449":117148,"_2949":117273},[],"Puertos externos diferentes",{"_3465":70476,"_30211":70427,"_20923":117275,"_5":14374,"_27449":117148,"_2949":117276},[],"Los clientes deben indicar puertos no estándar",{"_3465":70477,"_30211":70427,"_20923":117278,"_5":14374,"_27449":117148,"_2949":117279},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3465":70478,"_30211":70427,"_20923":117281,"_5":14374,"_27449":117148,"_2949":117282},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3465":70479,"_30211":70427,"_20923":117284,"_5":14374,"_27449":117148,"_2949":117285},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3465":70480,"_30211":70427,"_20923":117287,"_5":14374,"_27449":117148,"_2949":117288},[],"Recursos Gateway separados pero proxy compartido",{"_3465":70481,"_30211":70427,"_20923":117290,"_5":14374,"_27449":117148,"_2949":117291},[],"Modo merged Gateway de Envoy",{"_3465":70482,"_30211":70427,"_20923":117293,"_5":14374,"_27449":117148,"_2949":117294},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3465":70483,"_30211":70427,"_20923":117296,"_5":14374,"_27449":117148,"_2949":117297},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3465":70484,"_30211":70427,"_20923":117299,"_5":14374,"_27449":117148,"_2949":117300},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3465":70485,"_30211":70427,"_20923":117302,"_5":14374,"_27449":117148,"_2949":117303},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3465":70486,"_30211":70427,"_20923":117305,"_5":14374,"_27449":117148,"_2949":117306},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3465":70487,"_30211":70427,"_20923":117308,"_5":14374,"_27449":117152,"_2949":117309},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3465":70488,"_30211":70427,"_20923":117311,"_5":14374,"_27449":117156,"_2949":117312},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3465":70489,"_30211":70427,"_20923":117314,"_5":14374,"_27449":117156,"_2949":117315},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3465":70490,"_30211":70427,"_20923":117317,"_5":14374,"_27449":117156,"_2949":117318},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3465":70491,"_30211":70427,"_20923":117320,"_5":14374,"_27449":117156,"_2949":117321},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3465":70492,"_30211":70427,"_20923":117323,"_5":14374,"_27449":117156,"_2949":117324},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3465":70493,"_30211":70427,"_20923":117326,"_5":14374,"_27449":117160,"_2949":117327},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3465":70494,"_30211":70427,"_20923":117329,"_5":14374,"_27449":117160,"_2949":117330},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3465":70495,"_30211":70427,"_20923":117332,"_5":14374,"_27449":117164,"_2949":117333},[],"Comprueba, en orden:",{"_3465":70496,"_30211":70427,"_20923":117335,"_5":14374,"_27449":117164,"_2949":117336},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3465":70497,"_30211":70427,"_20923":117338,"_5":14374,"_27449":117164,"_2949":117339},[],"Su estado contiene la dirección esperada.",{"_3465":70498,"_30211":70427,"_20923":117341,"_5":14374,"_27449":117164,"_2949":117342},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3465":70499,"_30211":70427,"_20923":117344,"_5":14374,"_27449":117164,"_2949":117345},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3465":70500,"_30211":70427,"_20923":117347,"_5":14374,"_27449":117164,"_2949":117348},[],"DNS resuelve al endpoint accesible externamente.",{"_3465":70501,"_30211":70427,"_20923":117350,"_5":14374,"_27449":117164,"_2949":117351},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3465":70502,"_30211":70427,"_20923":117353,"_5":14374,"_27449":117164,"_2949":117354},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3465":70503,"_30211":70503,"_5":14726,"_2949":49380,"_30563":117356,"_20923":117357,"_27449":70503},[49273,116346,116580],[],{"_3465":70504,"_30211":70503,"_20923":117359,"_5":14374,"_27449":70503,"_2949":117360},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3465":70505,"_30211":70503,"_5":30560,"_20923":117362,"_27449":117363,"_2949":117364},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3465":70506,"_30211":70503,"_5":30560,"_20923":117366,"_27449":117367,"_2949":117368},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3465":70507,"_30211":70503,"_5":30560,"_20923":117370,"_27449":117371,"_2949":117372},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3465":70508,"_30211":70503,"_5":30560,"_20923":117374,"_27449":117375,"_2949":117376},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3465":70509,"_30211":70503,"_5":30560,"_20923":117378,"_27449":117379,"_2949":117380},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3465":70510,"_30211":70503,"_5":30560,"_20923":117382,"_27449":117383,"_2949":117384},[],"/docs/pr-preview/pr-67/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3465":70511,"_30211":70503,"_20923":117386,"_5":14374,"_27449":117363,"_2949":117387},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3465":70512,"_30211":70503,"_20923":117389,"_5":14374,"_27449":117367,"_2949":117390},[],"Flujo",{"_3465":70513,"_30211":70503,"_20923":117392,"_5":14374,"_27449":117367,"_2949":117393},[],"Úsalo para",{"_3465":70514,"_30211":70503,"_20923":117395,"_5":14374,"_27449":117367,"_2949":117396},[],"Qué instala",{"_3465":70515,"_30211":70503,"_20923":117398,"_5":14374,"_27449":117367,"_2949":50361},[],{"_3465":70516,"_30211":70503,"_20923":117400,"_5":14374,"_27449":117367,"_2949":117401},[],"Producción y entornos controlados",{"_3465":70517,"_30211":70503,"_20923":117403,"_5":14374,"_27449":117367,"_2949":117404},[],"Servicios de Lamassu y recursos de Gateway API",{"_3465":70518,"_30211":70503,"_20923":117406,"_5":14374,"_27449":117367,"_2949":49517},[],{"_3465":70519,"_30211":70503,"_20923":117408,"_5":14374,"_27449":117367,"_2949":117409},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3465":70520,"_30211":70503,"_20923":117411,"_5":14374,"_27449":117367,"_2949":117412},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3465":70521,"_30211":70503,"_20923":117414,"_5":14374,"_27449":117371,"_2949":117415},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3465":70522,"_30211":70503,"_20923":117417,"_5":14374,"_27449":117371,"_2949":117418},[],"Área",{"_3465":70523,"_30211":70503,"_20923":117420,"_5":14374,"_27449":117371,"_2949":117421},[],"El chart de Lamassu proporciona",{"_3465":70524,"_30211":70503,"_20923":117423,"_5":14374,"_27449":117371,"_2949":117424},[],"Tú proporcionas",{"_3465":70525,"_30211":70503,"_20923":117426,"_5":14374,"_27449":117371,"_2949":117427},[],"Aplicaciones Lamassu",{"_3465":70526,"_30211":70503,"_20923":117429,"_5":14374,"_27449":117371,"_2949":117430},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3465":70527,"_30211":70503,"_20923":117432,"_5":14374,"_27449":117371,"_2949":117433},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3465":70528,"_30211":70503,"_20923":117435,"_5":14374,"_27449":117371,"_2949":117436},[],"Datos PostgreSQL",{"_3465":70529,"_30211":70503,"_20923":117438,"_5":14374,"_27449":117371,"_2949":117439},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3465":70530,"_30211":70503,"_20923":117441,"_5":14374,"_27449":117371,"_2949":117442},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3465":70531,"_30211":70503,"_20923":117444,"_5":14374,"_27449":117371,"_2949":117445},[],"Mensajería",{"_3465":70532,"_30211":70503,"_20923":117447,"_5":14374,"_27449":117371,"_2949":117448},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3465":70533,"_30211":70503,"_20923":117450,"_5":14374,"_27449":117371,"_2949":117451},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3465":70534,"_30211":70503,"_20923":117453,"_5":14374,"_27449":117371,"_2949":117454},[],"Identidad",{"_3465":70535,"_30211":70503,"_20923":117456,"_5":14374,"_27449":117371,"_2949":117457},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3465":70536,"_30211":70503,"_20923":117459,"_5":14374,"_27449":117371,"_2949":117460},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3465":70537,"_30211":70503,"_20923":117462,"_5":14374,"_27449":117371,"_2949":117463},[],"Enrutamiento externo",{"_3465":70538,"_30211":70503,"_20923":117465,"_5":14374,"_27449":117371,"_2949":117466},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3465":70539,"_30211":70503,"_20923":117468,"_5":14374,"_27449":117371,"_2949":117469},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3465":70540,"_30211":70503,"_20923":117471,"_5":14374,"_27449":117371,"_2949":50435},[],{"_3465":70541,"_30211":70503,"_20923":117473,"_5":14374,"_27449":117371,"_2949":117474},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3465":70542,"_30211":70503,"_20923":117476,"_5":14374,"_27449":117371,"_2949":117477},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3465":70543,"_30211":70503,"_20923":117479,"_5":14374,"_27449":117371,"_2949":117480},[],"Datos persistentes de la aplicación",{"_3465":70544,"_30211":70503,"_20923":117482,"_5":14374,"_27449":117371,"_2949":117483},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3465":70545,"_30211":70503,"_20923":117485,"_5":14374,"_27449":117371,"_2949":117486},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3465":70546,"_30211":70503,"_20923":117488,"_5":14374,"_27449":117371,"_2949":117489},[],"Integraciones opcionales",{"_3465":70547,"_30211":70503,"_20923":117491,"_5":14374,"_27449":117371,"_2949":117492},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3465":70548,"_30211":70503,"_20923":117494,"_5":14374,"_27449":117371,"_2949":117495},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3465":70549,"_30211":70503,"_20923":117497,"_5":14374,"_27449":117371,"_2949":117498},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3465":70550,"_30211":70503,"_20923":117500,"_5":14374,"_27449":117371,"_2949":117501},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3465":70551,"_30211":70503,"_20923":117503,"_5":14374,"_27449":117375,"_2949":117504},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3465":70552,"_30211":70503,"_20923":117506,"_5":14374,"_27449":117375,"_2949":117507},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3465":70553,"_30211":70503,"_20923":117509,"_5":14374,"_27449":117379,"_2949":117510},[],"Kubernetes 1.24 o posterior",{"_3465":70554,"_30211":70503,"_20923":117512,"_5":14374,"_27449":117379,"_2949":117513},[],"Helm 3.2 o posterior",{"_3465":70555,"_30211":70503,"_20923":117515,"_5":14374,"_27449":117379,"_2949":117516},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3465":70556,"_30211":70503,"_20923":117518,"_5":14374,"_27449":117379,"_2949":117519},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3465":70557,"_30211":70503,"_20923":117521,"_5":14374,"_27449":117379,"_2949":117522},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3465":70558,"_30211":70503,"_20923":117524,"_5":14374,"_27449":117379,"_2949":117525},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3465":70559,"_30211":70503,"_20923":117527,"_5":14374,"_27449":117379,"_2949":117528},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3465":70560,"_30211":70503,"_20923":117530,"_5":14374,"_27449":117383,"_2949":117531},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3465":70561,"_30211":70503,"_20923":117533,"_5":14374,"_27449":117383,"_2949":117534},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3465":70562,"_30211":70503,"_20923":117536,"_5":14374,"_27449":117383,"_2949":117537},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3465":70563,"_30211":70503,"_20923":117539,"_5":14374,"_27449":117383,"_2949":117540},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3465":70564,"_30211":70564,"_5":14726,"_2949":117542,"_30563":117543,"_20923":117545,"_27449":70564},"Resolución de problemas de despliegue",[49273,116346,117544],"Operación",[],{"_3465":70565,"_30211":70564,"_20923":117547,"_5":14374,"_27449":70564,"_2949":117548},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3465":70566,"_30211":70564,"_5":30560,"_20923":117550,"_27449":117551,"_2949":117552},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3465":70567,"_30211":70564,"_5":30560,"_20923":117554,"_27449":117555,"_2949":117556},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3465":70568,"_30211":70564,"_5":30560,"_20923":117558,"_27449":117559,"_2949":117560},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3465":70569,"_30211":70564,"_5":30560,"_20923":117562,"_27449":117563,"_2949":117564},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3465":70570,"_30211":70564,"_5":30560,"_20923":117566,"_27449":117567,"_2949":117568},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3465":70571,"_30211":70564,"_5":30560,"_20923":117570,"_27449":117571,"_2949":117572},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3465":70572,"_30211":70564,"_5":30560,"_20923":117574,"_27449":117575,"_2949":117576},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3465":70573,"_30211":70564,"_5":30560,"_20923":117578,"_27449":117579,"_2949":117580},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3465":70574,"_30211":70564,"_5":30560,"_20923":117582,"_27449":117583,"_2949":117584},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3465":70575,"_30211":70564,"_5":30560,"_20923":117586,"_27449":117587,"_2949":117588},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3465":70576,"_30211":70564,"_5":30560,"_20923":117590,"_27449":117591,"_2949":117592},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3465":70577,"_30211":70564,"_5":30560,"_20923":117594,"_27449":117595,"_2949":117596},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3465":70578,"_30211":70564,"_5":30560,"_20923":117598,"_27449":117599,"_2949":117600},[],"/docs/pr-preview/pr-67/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3465":70579,"_30211":70564,"_20923":117602,"_5":14374,"_27449":70564,"_2949":117603},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3465":70580,"_30211":70564,"_20923":117605,"_5":14374,"_27449":117555,"_2949":117606},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3465":70581,"_30211":70564,"_20923":117608,"_5":14374,"_27449":117559,"_2949":117609},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3465":70582,"_30211":70564,"_20923":117611,"_5":14374,"_27449":117563,"_2949":117612},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3465":70583,"_30211":70564,"_20923":117614,"_5":14374,"_27449":117567,"_2949":117615},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3465":70584,"_30211":70564,"_20923":117617,"_5":14374,"_27449":117571,"_2949":117618},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3465":70585,"_30211":70564,"_20923":117620,"_5":14374,"_27449":117575,"_2949":117621},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3465":70586,"_30211":70564,"_20923":117623,"_5":14374,"_27449":117575,"_2949":117624},[],"Ejecuta también la prueba de conectividad del chart:",{"_3465":70587,"_30211":70564,"_20923":117626,"_5":14374,"_27449":117575,"_2949":117627},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3465":70588,"_30211":70564,"_20923":117629,"_5":14374,"_27449":117575,"_2949":117630},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3465":70589,"_30211":70564,"_20923":117632,"_5":14374,"_27449":117579,"_2949":117633},[],"Si recibes un 401:",{"_3465":70590,"_30211":70564,"_20923":117635,"_5":14374,"_27449":117579,"_2949":117636},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3465":70591,"_30211":70564,"_20923":117638,"_5":14374,"_27449":117579,"_2949":117639},[],"verifica emisor, audiencia y expiración del token;",{"_3465":70592,"_30211":70564,"_20923":117641,"_5":14374,"_27449":117579,"_2949":117642},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3465":70593,"_30211":70564,"_20923":117644,"_5":14374,"_27449":117579,"_2949":117645},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3465":70594,"_30211":70564,"_20923":117647,"_5":14374,"_27449":117579,"_2949":117648},[],"Si el login termina pero las APIs devuelven 403:",{"_3465":70595,"_30211":70564,"_20923":117650,"_5":14374,"_27449":117579,"_2949":117651},[],"inspecciona los claims reales del token;",{"_3465":70596,"_30211":70564,"_20923":117653,"_5":14374,"_27449":117579,"_2949":117654},[],"confirma que coinciden con un principal activo;",{"_3465":70597,"_30211":70564,"_20923":117656,"_5":14374,"_27449":117579,"_2949":117657},[],"revisa las políticas concedidas al principal;",{"_3465":70598,"_30211":70564,"_20923":117659,"_5":14374,"_27449":117579,"_2949":117660},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3465":70599,"_30211":70564,"_20923":117662,"_5":14374,"_27449":117579,"_2949":117663},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3465":70600,"_30211":70564,"_20923":117665,"_5":14374,"_27449":117583,"_2949":117666},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3465":70601,"_30211":70564,"_20923":117668,"_5":14374,"_27449":117583,"_2949":117669},[],"Localiza el pod y Service de authz.",{"_3465":70602,"_30211":70564,"_20923":117671,"_5":14374,"_27449":117583,"_2949":117672},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3465":70603,"_30211":70564,"_20923":117674,"_5":14374,"_27449":117583,"_2949":117675},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3465":70604,"_30211":70564,"_20923":117677,"_5":14374,"_27449":117583,"_2949":117678},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3465":70605,"_30211":70564,"_20923":117680,"_5":14374,"_27449":117583,"_2949":117681},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3465":70606,"_30211":70564,"_20923":117683,"_5":14374,"_27449":117587,"_2949":117684},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3465":70607,"_30211":70564,"_20923":117686,"_5":14374,"_27449":117591,"_2949":117687},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3465":70608,"_30211":70564,"_20923":117689,"_5":14374,"_27449":117591,"_2949":117690},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3465":70609,"_30211":70564,"_20923":117692,"_5":14374,"_27449":117591,"_2949":117693},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3465":70610,"_30211":70564,"_20923":117695,"_5":14374,"_27449":117591,"_2949":117696},[],"volumen persistente sin enlazar;",{"_3465":70611,"_30211":70564,"_20923":117698,"_5":14374,"_27449":117591,"_2949":117699},[],"imagen inaccesible o política de pull incorrecta;",{"_3465":70612,"_30211":70564,"_20923":117701,"_5":14374,"_27449":117591,"_2949":117702},[],"configuración inválida del motor criptográfico;",{"_3465":70613,"_30211":70564,"_20923":117704,"_5":14374,"_27449":117591,"_2949":117705},[],"límites de CPU o memoria demasiado bajos;",{"_3465":70614,"_30211":70564,"_20923":117707,"_5":14374,"_27449":117591,"_2949":117708},[],"migración previa incompleta.",{"_3465":70615,"_30211":70564,"_20923":117710,"_5":14374,"_27449":117591,"_2949":117711},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3465":70616,"_30211":70564,"_20923":117713,"_5":14374,"_27449":117591,"_2949":117714},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3465":70617,"_30211":70564,"_20923":117716,"_5":14374,"_27449":117591,"_2949":117717},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3465":70618,"_30211":70564,"_20923":117719,"_5":14374,"_27449":117595,"_2949":117720},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3465":70619,"_30211":70564,"_20923":117722,"_5":14374,"_27449":117595,"_2949":117723},[],"verifica que esté habilitado en el servicio emisor;",{"_3465":70620,"_30211":70564,"_20923":117725,"_5":14374,"_27449":117595,"_2949":117726},[],"comprueba conectividad y credenciales AMQP;",{"_3465":70621,"_30211":70564,"_20923":117728,"_5":14374,"_27449":117595,"_2949":117729},[],"revisa exchange, routing key, colas y consumidores;",{"_3465":70622,"_30211":70564,"_20923":117731,"_5":14374,"_27449":117595,"_2949":117732},[],"inspecciona dead-letter queues;",{"_3465":70623,"_30211":70564,"_20923":117734,"_5":14374,"_27449":117595,"_2949":117735},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3465":70624,"_30211":70564,"_20923":117737,"_5":14374,"_27449":117595,"_2949":117738},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3465":70625,"_30211":70564,"_20923":117740,"_5":14374,"_27449":117595,"_2949":117741},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3465":70626,"_30211":70564,"_20923":117743,"_5":14374,"_27449":117595,"_2949":117744},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3465":70627,"_30211":70564,"_20923":117746,"_5":14374,"_27449":117595,"_2949":117747},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3465":70628,"_30211":70564,"_20923":117749,"_5":14374,"_27449":117595,"_2949":117750},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3465":70629,"_30211":70564,"_20923":117752,"_5":14374,"_27449":117595,"_2949":117753},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3465":70630,"_30211":70564,"_20923":117755,"_5":14374,"_27449":117595,"_2949":117756},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3465":70631,"_30211":70564,"_20923":117758,"_5":14374,"_27449":117599,"_2949":117759},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3465":70632,"_30211":70564,"_20923":117761,"_5":14374,"_27449":117599,"_2949":117762},[],"Antes de cerrar una incidencia, guarda:",{"_3465":70633,"_30211":70564,"_20923":117764,"_5":14374,"_27449":117599,"_2949":117765},[],"causa confirmada;",{"_3465":70634,"_30211":70564,"_20923":117767,"_5":14374,"_27449":117599,"_2949":117768},[],"alcance temporal y recursos afectados;",{"_3465":70635,"_30211":70564,"_20923":117770,"_5":14374,"_27449":117599,"_2949":117771},[],"comandos o consultas utilizados;",{"_3465":70636,"_30211":70564,"_20923":117773,"_5":14374,"_27449":117599,"_2949":117774},[],"cambio aplicado y forma de revertirlo;",{"_3465":70637,"_30211":70564,"_20923":117776,"_5":14374,"_27449":117599,"_2949":117777},[],"validación desde un consumidor;",{"_3465":70638,"_30211":70564,"_20923":117779,"_5":14374,"_27449":117599,"_2949":117780},[],"acción preventiva y propietario.",{"_3465":70639,"_30211":70639,"_5":14726,"_2949":117782,"_30563":117783,"_20923":117786,"_27449":70639},"Control de acceso",[49273,117784,117785],"Plataforma","Administración",[],{"_3465":70640,"_30211":70639,"_20923":117788,"_5":14374,"_27449":70639,"_2949":117789},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3465":70641,"_30211":70639,"_5":30560,"_20923":117791,"_27449":117792,"_2949":117793},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3465":70642,"_30211":70639,"_5":30560,"_20923":117795,"_27449":117796,"_2949":117797},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3465":70643,"_30211":70639,"_5":30560,"_20923":117799,"_27449":117800,"_2949":117801},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3465":70644,"_30211":70639,"_5":30560,"_20923":117803,"_27449":117804,"_2949":117805},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3465":70645,"_30211":70639,"_5":30560,"_20923":117807,"_27449":117808,"_2949":117809},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3465":70646,"_30211":70639,"_5":30560,"_20923":117811,"_27449":117812,"_2949":117813},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3465":70647,"_30211":70639,"_5":30560,"_20923":117815,"_27449":117816,"_2949":117817},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3465":70648,"_30211":70639,"_5":30560,"_20923":117819,"_27449":117820,"_2949":117821},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3465":70649,"_30211":70639,"_5":30560,"_20923":117823,"_27449":117824,"_2949":117825},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3465":70650,"_30211":70639,"_5":30560,"_20923":117827,"_27449":117828,"_2949":117829},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3465":70651,"_30211":70639,"_5":30560,"_20923":117831,"_27449":117832,"_2949":117833},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3465":70652,"_30211":70639,"_5":30560,"_20923":117835,"_27449":117836,"_2949":117837},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3465":70653,"_30211":70639,"_5":30560,"_20923":117839,"_27449":117840,"_2949":117841},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3465":70654,"_30211":70639,"_5":30560,"_20923":117843,"_27449":117844,"_2949":117845},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3465":70655,"_30211":70639,"_5":30560,"_20923":117847,"_27449":117848,"_2949":117849},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3465":70656,"_30211":70639,"_5":30560,"_20923":117851,"_27449":117852,"_2949":116952},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3465":70657,"_30211":70639,"_5":30560,"_20923":117854,"_27449":117855,"_2949":117856},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3465":70658,"_30211":70639,"_5":30560,"_20923":117858,"_27449":117859,"_2949":117860},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3465":70659,"_30211":70639,"_5":30560,"_20923":117862,"_27449":117863,"_2949":117864},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3465":70660,"_30211":70639,"_5":30560,"_20923":117866,"_27449":117867,"_2949":117868},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3465":70661,"_30211":70639,"_5":30560,"_20923":117870,"_27449":117871,"_2949":117872},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3465":70662,"_30211":70639,"_5":30560,"_20923":117874,"_27449":117875,"_2949":117876},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3465":70663,"_30211":70639,"_5":30560,"_20923":117878,"_27449":117879,"_2949":117880},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3465":70664,"_30211":70639,"_5":30560,"_20923":117882,"_27449":117883,"_2949":117884},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3465":70665,"_30211":70639,"_5":30560,"_20923":117886,"_27449":117887,"_2949":117888},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3465":70666,"_30211":70639,"_5":30560,"_20923":117890,"_27449":117891,"_2949":117892},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3465":70667,"_30211":70639,"_5":30560,"_20923":117894,"_27449":117895,"_2949":117896},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3465":70668,"_30211":70639,"_5":30560,"_20923":117898,"_27449":117899,"_2949":117900},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3465":70669,"_30211":70639,"_5":30560,"_20923":117902,"_27449":117903,"_2949":117904},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3465":70670,"_30211":70639,"_5":30560,"_20923":117906,"_27449":117907,"_2949":117908},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3465":70671,"_30211":70639,"_5":30560,"_20923":117910,"_27449":117911,"_2949":117912},[],"/docs/pr-preview/pr-67/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3465":70672,"_30211":70639,"_20923":117914,"_5":14374,"_27449":70639,"_2949":117915},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3465":70673,"_30211":70639,"_20923":117917,"_5":14374,"_27449":70639,"_2949":117918},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3465":70674,"_30211":70639,"_20923":117920,"_5":14374,"_27449":70639,"_2949":117921},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3465":70675,"_30211":70639,"_20923":117923,"_5":14374,"_27449":117792,"_2949":117924},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3465":70676,"_30211":70639,"_20923":117926,"_5":14374,"_27449":117792,"_2949":117927},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3465":70677,"_30211":70639,"_20923":117929,"_5":14374,"_27449":117792,"_2949":117930},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3465":70678,"_30211":70639,"_20923":117932,"_5":14374,"_27449":117792,"_2949":117933},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3465":70679,"_30211":70639,"_20923":117935,"_5":14374,"_27449":117792,"_2949":117936},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3465":70680,"_30211":70639,"_20923":117938,"_5":14374,"_27449":117792,"_2949":117939},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3465":70681,"_30211":70639,"_20923":117941,"_5":14374,"_27449":117796,"_2949":117942},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3465":70682,"_30211":70639,"_20923":117944,"_5":14374,"_27449":117796,"_2949":117945},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3465":70683,"_30211":70639,"_20923":117947,"_5":14374,"_27449":117800,"_2949":117948},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3465":70684,"_30211":70639,"_20923":117950,"_5":14374,"_27449":117800,"_2949":117951},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3465":70685,"_30211":70639,"_20923":117953,"_5":14374,"_27449":117800,"_2949":117954},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3465":70686,"_30211":70639,"_20923":117956,"_5":14374,"_27449":117800,"_2949":117957},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3465":70687,"_30211":70639,"_20923":117959,"_5":14374,"_27449":117800,"_2949":117960},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3465":70688,"_30211":70639,"_20923":117962,"_5":14374,"_27449":117800,"_2949":117963},[],"Carga por separado las políticas concedidas a cada principal.",{"_3465":70689,"_30211":70639,"_20923":117965,"_5":14374,"_27449":117800,"_2949":117966},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3465":70690,"_30211":70639,"_20923":117968,"_5":14374,"_27449":117800,"_2949":117969},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3465":70691,"_30211":70639,"_20923":117971,"_5":14374,"_27449":117800,"_2949":117972},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3465":70692,"_30211":70639,"_20923":117974,"_5":14374,"_27449":117800,"_2949":117975},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3465":70693,"_30211":70639,"_20923":117977,"_5":14374,"_27449":117800,"_2949":117978},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3465":70694,"_30211":70639,"_20923":117980,"_5":14374,"_27449":117800,"_2949":117981},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3465":70695,"_30211":70639,"_20923":117983,"_5":14374,"_27449":117804,"_2949":117984},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3465":70696,"_30211":70639,"_20923":117986,"_5":14374,"_27449":117804,"_2949":117987},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3465":70697,"_30211":70639,"_20923":117989,"_5":14374,"_27449":117804,"_2949":117990},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3465":70698,"_30211":70639,"_20923":117992,"_5":14374,"_27449":117804,"_2949":117993},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3465":70699,"_30211":70639,"_20923":117995,"_5":14374,"_27449":117804,"_2949":117996},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3465":70700,"_30211":70639,"_20923":117998,"_5":14374,"_27449":117804,"_2949":117999},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3465":70701,"_30211":70639,"_20923":118001,"_5":14374,"_27449":117804,"_2949":118002},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3465":70702,"_30211":70639,"_20923":118004,"_5":14374,"_27449":117804,"_2949":118005},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3465":70703,"_30211":70639,"_20923":118007,"_5":14374,"_27449":117808,"_2949":118008},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3465":70704,"_30211":70639,"_20923":118010,"_5":14374,"_27449":117808,"_2949":118011},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3465":70705,"_30211":70639,"_20923":118013,"_5":14374,"_27449":117808,"_2949":118014},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3465":70706,"_30211":70639,"_20923":118016,"_5":14374,"_27449":117808,"_2949":118017},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3465":70707,"_30211":70639,"_20923":118019,"_5":14374,"_27449":117808,"_2949":118020},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3465":70708,"_30211":70639,"_20923":118022,"_5":14374,"_27449":117808,"_2949":118023},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3465":70709,"_30211":70639,"_20923":118025,"_5":14374,"_27449":117808,"_2949":118026},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3465":70710,"_30211":70639,"_20923":118028,"_5":14374,"_27449":117808,"_2949":118029},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3465":70711,"_30211":70639,"_20923":118031,"_5":14374,"_27449":117808,"_2949":118032},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3465":70712,"_30211":70639,"_20923":118034,"_5":14374,"_27449":117808,"_2949":118035},[],"Las acciones se dividen en dos grupos:",{"_3465":70713,"_30211":70639,"_20923":118037,"_5":14374,"_27449":117808,"_2949":118038},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3465":70714,"_30211":70639,"_20923":118040,"_5":14374,"_27449":117808,"_2949":118041},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3465":70715,"_30211":70639,"_20923":118043,"_5":14374,"_27449":117808,"_2949":118044},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3465":70716,"_30211":70639,"_20923":118046,"_5":14374,"_27449":117812,"_2949":118047},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3465":70717,"_30211":70639,"_20923":118049,"_5":14374,"_27449":117812,"_2949":118050},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3465":70718,"_30211":70639,"_20923":118052,"_5":14374,"_27449":117812,"_2949":118053},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3465":70719,"_30211":70639,"_20923":118055,"_5":14374,"_27449":117816,"_2949":118056},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3465":70720,"_30211":70639,"_20923":118058,"_5":14374,"_27449":117816,"_2949":118059},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3465":70721,"_30211":70639,"_20923":118061,"_5":14374,"_27449":117816,"_2949":118062},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3465":70722,"_30211":70639,"_20923":118064,"_5":14374,"_27449":117816,"_2949":118065},[],"Los operadores implementados son:",{"_3465":70723,"_30211":70639,"_20923":118067,"_5":14374,"_27449":117816,"_2949":118068},[],"`equals`, para igualdad exacta;",{"_3465":70724,"_30211":70639,"_20923":118070,"_5":14374,"_27449":117816,"_2949":118071},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3465":70725,"_30211":70639,"_20923":118073,"_5":14374,"_27449":117816,"_2949":118074},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3465":70726,"_30211":70639,"_20923":118076,"_5":14374,"_27449":117816,"_2949":118077},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3465":70727,"_30211":70639,"_20923":118079,"_5":14374,"_27449":117820,"_2949":118080},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3465":70728,"_30211":70639,"_20923":118082,"_5":14374,"_27449":117820,"_2949":118083},[],"Los modos disponibles son:",{"_3465":70729,"_30211":70639,"_20923":118085,"_5":14374,"_27449":117820,"_2949":118086},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3465":70730,"_30211":70639,"_20923":118088,"_5":14374,"_27449":117820,"_2949":118089},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3465":70731,"_30211":70639,"_20923":118091,"_5":14374,"_27449":117820,"_2949":118092},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3465":70732,"_30211":70639,"_20923":118094,"_5":14374,"_27449":117820,"_2949":118095},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3465":70733,"_30211":70639,"_20923":118097,"_5":14374,"_27449":117820,"_2949":118098},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3465":70734,"_30211":70639,"_20923":118100,"_5":14374,"_27449":117820,"_2949":118101},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3465":70735,"_30211":70639,"_20923":118103,"_5":14374,"_27449":117824,"_2949":118104},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3465":70736,"_30211":70639,"_20923":118106,"_5":14374,"_27449":117824,"_2949":118107},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3465":70737,"_30211":70639,"_20923":118109,"_5":14374,"_27449":117824,"_2949":118110},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3465":70738,"_30211":70639,"_20923":118112,"_5":14374,"_27449":117824,"_2949":118113},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3465":70739,"_30211":70639,"_20923":118115,"_5":14374,"_27449":117832,"_2949":118116},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3465":70740,"_30211":70639,"_20923":118118,"_5":14374,"_27449":117832,"_2949":118119},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3465":70741,"_30211":70639,"_20923":118121,"_5":14374,"_27449":117836,"_2949":118122},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3465":70742,"_30211":70639,"_20923":118124,"_5":14374,"_27449":117836,"_2949":118125},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3465":70743,"_30211":70639,"_20923":118127,"_5":14374,"_27449":117840,"_2949":118128},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3465":70744,"_30211":70639,"_20923":118130,"_5":14374,"_27449":117840,"_2949":118131},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3465":70745,"_30211":70639,"_20923":118133,"_5":14374,"_27449":117840,"_2949":118134},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3465":70746,"_30211":70639,"_20923":118136,"_5":14374,"_27449":117844,"_2949":118137},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3465":70747,"_30211":70639,"_20923":118139,"_5":14374,"_27449":117844,"_2949":118140},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3465":70748,"_30211":70639,"_20923":118142,"_5":14374,"_27449":117844,"_2949":118143},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3465":70749,"_30211":70639,"_20923":118145,"_5":14374,"_27449":117844,"_2949":118146},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3465":70750,"_30211":70639,"_20923":118148,"_5":14374,"_27449":117844,"_2949":118149},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3465":70751,"_30211":70639,"_20923":118151,"_5":14374,"_27449":117844,"_2949":118152},[],"Ten en cuenta que:",{"_3465":70752,"_30211":70639,"_20923":118154,"_5":14374,"_27449":117844,"_2949":118155},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3465":70753,"_30211":70639,"_20923":118157,"_5":14374,"_27449":117844,"_2949":118158},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3465":70754,"_30211":70639,"_20923":118160,"_5":14374,"_27449":117844,"_2949":118161},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3465":70755,"_30211":70639,"_20923":118163,"_5":14374,"_27449":117848,"_2949":118164},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3465":70756,"_30211":70639,"_20923":118166,"_5":14374,"_27449":117848,"_2949":118167},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3465":70757,"_30211":70639,"_20923":118169,"_5":14374,"_27449":117848,"_2949":118170},[],"acceso completo y de solo lectura a KMS;",{"_3465":70758,"_30211":70639,"_20923":118172,"_5":14374,"_27449":117848,"_2949":118173},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3465":70759,"_30211":70639,"_20923":118175,"_5":14374,"_27449":117848,"_2949":118176},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3465":70760,"_30211":70639,"_20923":118178,"_5":14374,"_27449":117848,"_2949":118179},[],"acceso a la interfaz;",{"_3465":70761,"_30211":70639,"_20923":118181,"_5":14374,"_27449":117848,"_2949":118182},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3465":70762,"_30211":70639,"_20923":118184,"_5":14374,"_27449":117848,"_2949":118185},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3465":70763,"_30211":70639,"_20923":118187,"_5":14374,"_27449":117848,"_2949":118188},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3465":70764,"_30211":70639,"_20923":118190,"_5":14374,"_27449":117852,"_2949":118191},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3465":70765,"_30211":70639,"_20923":118193,"_5":14374,"_27449":117852,"_2949":118194},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3465":70766,"_30211":70639,"_20923":118196,"_5":14374,"_27449":117852,"_2949":118197},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3465":70767,"_30211":70639,"_20923":118199,"_5":14374,"_27449":117855,"_2949":118200},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3465":70768,"_30211":70639,"_20923":118202,"_5":14374,"_27449":117859,"_2949":118203},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3465":70769,"_30211":70639,"_20923":118205,"_5":14374,"_27449":117859,"_2949":118206},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3465":70770,"_30211":70639,"_20923":118208,"_5":14374,"_27449":117863,"_2949":118209},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3465":70771,"_30211":70639,"_20923":118211,"_5":14374,"_27449":117867,"_2949":118212},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3465":70772,"_30211":70639,"_20923":118214,"_5":14374,"_27449":117871,"_2949":118215},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3465":70773,"_30211":70639,"_20923":118217,"_5":14374,"_27449":117875,"_2949":118218},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3465":70774,"_30211":70639,"_20923":118220,"_5":14374,"_27449":117875,"_2949":118221},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3465":70775,"_30211":70639,"_20923":118223,"_5":14374,"_27449":117879,"_2949":118224},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3465":70776,"_30211":70639,"_20923":118226,"_5":14374,"_27449":117879,"_2949":118227},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3465":70777,"_30211":70639,"_20923":118229,"_5":14374,"_27449":117879,"_2949":118230},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3465":70778,"_30211":70639,"_20923":118232,"_5":14374,"_27449":117879,"_2949":118233},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3465":70779,"_30211":70639,"_20923":118235,"_5":14374,"_27449":117879,"_2949":118236},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3465":70780,"_30211":70639,"_20923":118238,"_5":14374,"_27449":117879,"_2949":118239},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3465":70781,"_30211":70639,"_20923":118241,"_5":14374,"_27449":117879,"_2949":118242},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3465":70782,"_30211":70639,"_20923":118244,"_5":14374,"_27449":117879,"_2949":118245},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3465":70783,"_30211":70639,"_20923":118247,"_5":14374,"_27449":117883,"_2949":118248},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3465":70784,"_30211":70639,"_20923":118250,"_5":14374,"_27449":117883,"_2949":118251},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3465":70785,"_30211":70639,"_20923":118253,"_5":14374,"_27449":117883,"_2949":118254},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3465":70786,"_30211":70639,"_20923":118256,"_5":14374,"_27449":117887,"_2949":118257},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3465":70787,"_30211":70639,"_20923":118259,"_5":14374,"_27449":117887,"_2949":118260},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3465":70788,"_30211":70639,"_20923":118262,"_5":14374,"_27449":117887,"_2949":118263},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3465":70789,"_30211":70639,"_20923":118265,"_5":14374,"_27449":117887,"_2949":118266},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3465":70790,"_30211":70639,"_20923":118268,"_5":14374,"_27449":117887,"_2949":118269},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3465":70791,"_30211":70639,"_20923":118271,"_5":14374,"_27449":117887,"_2949":118272},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3465":70792,"_30211":70639,"_20923":118274,"_5":14374,"_27449":117887,"_2949":118275},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3465":70793,"_30211":70639,"_20923":118277,"_5":14374,"_27449":117887,"_2949":118278},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3465":70794,"_30211":70639,"_20923":118280,"_5":14374,"_27449":117895,"_2949":118281},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3465":70795,"_30211":70639,"_20923":118283,"_5":14374,"_27449":117899,"_2949":118284},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3465":70796,"_30211":70639,"_20923":118286,"_5":14374,"_27449":117899,"_2949":118287},[],"que exista un principal activo del tipo correcto;",{"_3465":70797,"_30211":70639,"_20923":118289,"_5":14374,"_27449":117899,"_2949":118290},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3465":70798,"_30211":70639,"_20923":118292,"_5":14374,"_27449":117899,"_2949":118293},[],"que todas las condiciones del principal se cumplan;",{"_3465":70799,"_30211":70639,"_20923":118295,"_5":14374,"_27449":117899,"_2949":118296},[],"que el principal tenga concedida la política esperada;",{"_3465":70800,"_30211":70639,"_20923":118298,"_5":14374,"_27449":117899,"_2949":118299},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3465":70801,"_30211":70639,"_20923":118301,"_5":14374,"_27449":117899,"_2949":118302},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3465":70802,"_30211":70639,"_20923":118304,"_5":14374,"_27449":117899,"_2949":118305},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3465":70803,"_30211":70639,"_20923":118307,"_5":14374,"_27449":117903,"_2949":118308},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3465":70804,"_30211":70639,"_20923":118310,"_5":14374,"_27449":117907,"_2949":118311},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3465":70805,"_30211":70639,"_20923":118313,"_5":14374,"_27449":117911,"_2949":118314},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3465":70806,"_30211":70639,"_20923":118316,"_5":14374,"_27449":117911,"_2949":118317},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3465":70807,"_30211":70807,"_5":14726,"_2949":118319,"_30563":118320,"_20923":118321,"_27449":70807},"Alertas y suscripciones",[49273,117784,117785],[],{"_3465":70808,"_30211":70807,"_20923":118323,"_5":14374,"_27449":70807,"_2949":118324},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3465":70809,"_30211":70807,"_5":30560,"_20923":118326,"_27449":118327,"_2949":118328},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3465":70810,"_30211":70807,"_5":30560,"_20923":118330,"_27449":118331,"_2949":118332},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3465":70811,"_30211":70807,"_5":30560,"_20923":118334,"_27449":118335,"_2949":118336},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3465":70812,"_30211":70807,"_5":30560,"_20923":118338,"_27449":118339,"_2949":118340},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3465":70813,"_30211":70807,"_5":30560,"_20923":118342,"_27449":118343,"_2949":118344},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3465":70814,"_30211":70807,"_5":30560,"_20923":118346,"_27449":118347,"_2949":118348},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3465":70815,"_30211":70807,"_5":30560,"_20923":118350,"_27449":118351,"_2949":118352},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3465":70816,"_30211":70807,"_5":30560,"_20923":118354,"_27449":118355,"_2949":118356},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3465":70817,"_30211":70807,"_5":30560,"_20923":118358,"_27449":118359,"_2949":118360},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3465":70818,"_30211":70807,"_5":30560,"_20923":118362,"_27449":118363,"_2949":118364},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3465":70819,"_30211":70807,"_5":30560,"_20923":118366,"_27449":118367,"_2949":118368},[],"/docs/pr-preview/pr-67/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3465":70820,"_30211":70807,"_20923":118370,"_5":14374,"_27449":70807,"_2949":118371},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3465":70821,"_30211":70807,"_20923":118373,"_5":14374,"_27449":118327,"_2949":118374},[],"Un servicio publica un evento de dominio.",{"_3465":70822,"_30211":70807,"_20923":118376,"_5":14374,"_27449":118327,"_2949":118377},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3465":70823,"_30211":70807,"_20923":118379,"_5":14374,"_27449":118327,"_2949":118380},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3465":70824,"_30211":70807,"_20923":118382,"_5":14374,"_27449":118327,"_2949":118383},[],"Lamassu entrega el evento al canal configurado.",{"_3465":70825,"_30211":70807,"_20923":118385,"_5":14374,"_27449":118327,"_2949":118386},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3465":70826,"_30211":70807,"_20923":118388,"_5":14374,"_27449":118331,"_2949":118389},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3465":70827,"_30211":70807,"_20923":118391,"_5":14374,"_27449":118331,"_2949":118392},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3465":70828,"_30211":70807,"_20923":118394,"_5":14374,"_27449":118331,"_2949":118395},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3465":70829,"_30211":70807,"_20923":118397,"_5":14374,"_27449":118331,"_2949":118398},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3465":70830,"_30211":70807,"_20923":118400,"_5":14374,"_27449":118331,"_2949":118401},[],"`apikey_options` necesita `header` y `key`.",{"_3465":70831,"_30211":70807,"_20923":118403,"_5":14374,"_27449":118331,"_2949":118404},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3465":70832,"_30211":70807,"_20923":118406,"_5":14374,"_27449":118331,"_2949":118407},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3465":70833,"_30211":70807,"_20923":118409,"_5":14374,"_27449":118331,"_2949":118410},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3465":70834,"_30211":70807,"_20923":118412,"_5":14374,"_27449":118339,"_2949":118413},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3465":70835,"_30211":70807,"_20923":118415,"_5":14374,"_27449":118343,"_2949":118416},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3465":70836,"_30211":70807,"_20923":118418,"_5":14374,"_27449":118347,"_2949":118419},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3465":70837,"_30211":70807,"_20923":118421,"_5":14374,"_27449":118347,"_2949":118422},[],"**None** notifica todas las instancias del evento.",{"_3465":70838,"_30211":70807,"_20923":118424,"_5":14374,"_27449":118347,"_2949":118425},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3465":70839,"_30211":70807,"_20923":118427,"_5":14374,"_27449":118347,"_2949":118428},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3465":70840,"_30211":70807,"_20923":118430,"_5":14374,"_27449":118347,"_2949":118431},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3465":70841,"_30211":70807,"_20923":118433,"_5":14374,"_27449":118347,"_2949":118434},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3465":70842,"_30211":70807,"_20923":118436,"_5":14374,"_27449":118347,"_2949":118437},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3465":70843,"_30211":70807,"_20923":118439,"_5":14374,"_27449":118351,"_2949":118440},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3465":70844,"_30211":70807,"_20923":118442,"_5":14374,"_27449":118355,"_2949":118443},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3465":70845,"_30211":70807,"_20923":118445,"_5":14374,"_27449":118355,"_2949":118446},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3465":70846,"_30211":70807,"_20923":118448,"_5":14374,"_27449":118355,"_2949":118449},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3465":70847,"_30211":70807,"_20923":118451,"_5":14374,"_27449":118355,"_2949":118452},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3465":70848,"_30211":70807,"_20923":118454,"_5":14374,"_27449":118355,"_2949":118455},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3465":70849,"_30211":70807,"_20923":118457,"_5":14374,"_27449":118355,"_2949":118458},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3465":70850,"_30211":70807,"_20923":118460,"_5":14374,"_27449":118355,"_2949":118461},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3465":70851,"_30211":70807,"_20923":118463,"_5":14374,"_27449":118355,"_2949":118464},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3465":70852,"_30211":70807,"_20923":118466,"_5":14374,"_27449":118359,"_2949":118467},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3465":70853,"_30211":70807,"_20923":118469,"_5":14374,"_27449":118359,"_2949":118470},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3465":70854,"_30211":70807,"_20923":118472,"_5":14374,"_27449":118359,"_2949":118473},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3465":70855,"_30211":70807,"_20923":118475,"_5":14374,"_27449":118359,"_2949":118476},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3465":70856,"_30211":70807,"_20923":118478,"_5":14374,"_27449":118359,"_2949":118479},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3465":70857,"_30211":70807,"_20923":118481,"_5":14374,"_27449":118359,"_2949":118482},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3465":70858,"_30211":70807,"_20923":118484,"_5":14374,"_27449":118359,"_2949":118485},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3465":70859,"_30211":70807,"_20923":118487,"_5":14374,"_27449":118359,"_2949":118488},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3465":70860,"_30211":70807,"_20923":118490,"_5":14374,"_27449":118363,"_2949":118491},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3465":70861,"_30211":70807,"_20923":118493,"_5":14374,"_27449":118363,"_2949":118494},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3465":70862,"_30211":70807,"_20923":118496,"_5":14374,"_27449":118367,"_2949":118497},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3465":70863,"_30211":70807,"_20923":118499,"_5":14374,"_27449":118367,"_2949":118500},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3465":70864,"_30211":70807,"_20923":118502,"_5":14374,"_27449":118367,"_2949":118503},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3465":70865,"_30211":70807,"_20923":118505,"_5":14374,"_27449":118367,"_2949":118506},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3465":70866,"_30211":70807,"_20923":118508,"_5":14374,"_27449":118367,"_2949":118509},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3465":70867,"_30211":70807,"_20923":118511,"_5":14374,"_27449":118367,"_2949":118512},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init` y `va.crl-settings.update`.",{"_3465":70868,"_30211":70807,"_20923":118514,"_5":14374,"_27449":118367,"_2949":118515},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3465":70869,"_30211":70807,"_20923":118517,"_5":14374,"_27449":118367,"_2949":118518},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3465":70870,"_30211":70807,"_20923":118520,"_5":14374,"_27449":118367,"_2949":118521},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3465":70871,"_30211":70871,"_5":14726,"_2949":118523,"_30563":118524,"_20923":118525,"_27449":70871},"Registros de auditoría",[49273,117784,117785],[],{"_3465":70872,"_30211":70871,"_20923":118527,"_5":14374,"_27449":70871,"_2949":118528},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3465":70873,"_30211":70871,"_5":30560,"_20923":118530,"_27449":118531,"_2949":118532},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3465":70874,"_30211":70871,"_5":30560,"_20923":118534,"_27449":118535,"_2949":118536},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3465":70875,"_30211":70871,"_5":30560,"_20923":118538,"_27449":118539,"_2949":118540},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3465":70876,"_30211":70871,"_5":30560,"_20923":118542,"_27449":118543,"_2949":118544},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3465":70877,"_30211":70871,"_5":30560,"_20923":118546,"_27449":118547,"_2949":118548},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3465":70878,"_30211":70871,"_5":30560,"_20923":118550,"_27449":118551,"_2949":118552},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3465":70879,"_30211":70871,"_5":30560,"_20923":118554,"_27449":118555,"_2949":118556},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3465":70880,"_30211":70871,"_5":30560,"_20923":118558,"_27449":118559,"_2949":118560},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3465":70881,"_30211":70871,"_5":30560,"_20923":118562,"_27449":118563,"_2949":118564},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3465":70882,"_30211":70871,"_5":30560,"_20923":118566,"_27449":118567,"_2949":118568},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3465":70883,"_30211":70871,"_5":30560,"_20923":118570,"_27449":118571,"_2949":118572},[],"/docs/pr-preview/pr-67/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3465":70884,"_30211":70871,"_20923":118574,"_5":14374,"_27449":70871,"_2949":118575},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3465":70885,"_30211":70871,"_20923":118577,"_5":14374,"_27449":118531,"_2949":118578},[],"El cuerpo de auditoría incluye:",{"_3465":70886,"_30211":70871,"_20923":118580,"_5":14374,"_27449":118531,"_2949":118581},[],"input: datos recibidos por la operación;",{"_3465":70887,"_30211":70871,"_20923":118583,"_5":14374,"_27449":118531,"_2949":118584},[],"has\\_error: indica si el servicio devolvió un error;",{"_3465":70888,"_30211":70871,"_20923":118586,"_5":14374,"_27449":118531,"_2949":118587},[],"output: resultado producido o mensaje de error;",{"_3465":70889,"_30211":70871,"_20923":118589,"_5":14374,"_27449":118531,"_2949":118590},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3465":70890,"_30211":70871,"_20923":118592,"_5":14374,"_27449":118531,"_2949":118593},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3465":70891,"_30211":70871,"_20923":118595,"_5":14374,"_27449":118531,"_2949":118596},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3465":70892,"_30211":70871,"_20923":118598,"_5":14374,"_27449":118535,"_2949":118599},[],"El backend aplica auditoría a mutaciones de:",{"_3465":70893,"_30211":70871,"_20923":118601,"_5":14374,"_27449":118535,"_2949":118602},[],"autoridades, certificados y perfiles de emisión;",{"_3465":70894,"_30211":70871,"_20923":118604,"_5":14374,"_27449":118535,"_2949":118605},[],"claves y motores KMS;",{"_3465":70895,"_30211":70871,"_20923":118607,"_5":14374,"_27449":118535,"_2949":118608},[],"dispositivos e identidades;",{"_3465":70896,"_30211":70871,"_20923":118610,"_5":14374,"_27449":118535,"_2949":118611},[],"DMS y operaciones de enrolamiento;",{"_3465":70897,"_30211":70871,"_20923":118613,"_5":14374,"_27449":118535,"_2949":118614},[],"funciones de validación y CRL;",{"_3465":70898,"_30211":70871,"_20923":118616,"_5":14374,"_27449":118535,"_2949":118617},[],"principales, políticas y concesiones de autorización.",{"_3465":70899,"_30211":70871,"_20923":118619,"_5":14374,"_27449":118535,"_2949":118620},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3465":70900,"_30211":70871,"_20923":118622,"_5":14374,"_27449":118539,"_2949":118623},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3465":70901,"_30211":70871,"_20923":118625,"_5":14374,"_27449":118539,"_2949":118626},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3465":70902,"_30211":70871,"_20923":118628,"_5":14374,"_27449":118539,"_2949":118629},[],"Diseña el consumidor para:",{"_3465":70903,"_30211":70871,"_20923":118631,"_5":14374,"_27449":118539,"_2949":118632},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3465":70904,"_30211":70871,"_20923":118634,"_5":14374,"_27449":118539,"_2949":118635},[],"conservar el CloudEvent completo sin modificar;",{"_3465":70905,"_30211":70871,"_20923":118637,"_5":14374,"_27449":118539,"_2949":118638},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3465":70906,"_30211":70871,"_20923":118640,"_5":14374,"_27449":118539,"_2949":118641},[],"cifrar en tránsito y en reposo;",{"_3465":70907,"_30211":70871,"_20923":118643,"_5":14374,"_27449":118539,"_2949":118644},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3465":70908,"_30211":70871,"_20923":118646,"_5":14374,"_27449":118539,"_2949":118647},[],"aplicar una política explícita de retención y legal hold;",{"_3465":70909,"_30211":70871,"_20923":118649,"_5":14374,"_27449":118539,"_2949":118650},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3465":70910,"_30211":70871,"_20923":118652,"_5":14374,"_27449":118543,"_2949":118653},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3465":70911,"_30211":70871,"_20923":118655,"_5":14374,"_27449":118543,"_2949":118656},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3465":70912,"_30211":70871,"_20923":118658,"_5":14374,"_27449":118551,"_2949":118659},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3465":70913,"_30211":70871,"_20923":118661,"_5":14374,"_27449":118555,"_2949":118662},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3465":70914,"_30211":70871,"_20923":118664,"_5":14374,"_27449":118559,"_2949":118665},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3465":70915,"_30211":70871,"_20923":118667,"_5":14374,"_27449":118563,"_2949":118668},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3465":70916,"_30211":70871,"_20923":118670,"_5":14374,"_27449":118567,"_2949":118671},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3465":70917,"_30211":70871,"_20923":118673,"_5":14374,"_27449":118571,"_2949":118674},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3465":70918,"_30211":70871,"_20923":118676,"_5":14374,"_27449":118571,"_2949":118677},[],"aparece un evento de auditoría correcto;",{"_3465":70919,"_30211":70871,"_20923":118679,"_5":14374,"_27449":118571,"_2949":118680},[],"el principal coincide con la identidad utilizada;",{"_3465":70920,"_30211":70871,"_20923":118682,"_5":14374,"_27449":118571,"_2949":118683},[],"el consumidor lo persiste una sola vez;",{"_3465":70921,"_30211":70871,"_20923":118685,"_5":14374,"_27449":118571,"_2949":118686},[],"puede recuperarse por recurso, actor y periodo;",{"_3465":70922,"_30211":70871,"_20923":118688,"_5":14374,"_27449":118571,"_2949":118689},[],"una interrupción del consumidor produce una alerta.",{"_3465":70923,"_30211":70871,"_20923":118691,"_5":14374,"_27449":118571,"_2949":118692},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3465":70924,"_30211":70924,"_5":14726,"_2949":118694,"_30563":118695,"_20923":118696,"_27449":70924},"Arquitectura de la plataforma",[49273,117784],[],{"_3465":70925,"_30211":70924,"_20923":118698,"_5":14374,"_27449":70924,"_2949":118699},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3465":70926,"_30211":70924,"_5":30560,"_20923":118701,"_27449":118702,"_2949":118703},[],"/docs/pr-preview/pr-67/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3465":70927,"_30211":70924,"_5":30560,"_20923":118705,"_27449":118706,"_2949":118707},[],"/docs/pr-preview/pr-67/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3465":70928,"_30211":70924,"_5":30560,"_20923":118709,"_27449":118710,"_2949":118711},[],"/docs/pr-preview/pr-67/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3465":70929,"_30211":70924,"_5":30560,"_20923":118713,"_27449":118714,"_2949":118715},[],"/docs/pr-preview/pr-67/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3465":70930,"_30211":70924,"_5":30560,"_20923":118717,"_27449":118718,"_2949":118719},[],"/docs/pr-preview/pr-67/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3465":70931,"_30211":70924,"_20923":118721,"_5":14374,"_27449":70924,"_2949":118722},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3465":70932,"_30211":70924,"_20923":118724,"_5":14374,"_27449":70924,"_2949":118725},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3465":70933,"_30211":70924,"_20923":118727,"_5":14374,"_27449":118702,"_2949":118728},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3465":70934,"_30211":70924,"_20923":118730,"_5":14374,"_27449":118706,"_2949":118731},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3465":70935,"_30211":70924,"_20923":118733,"_5":14374,"_27449":118710,"_2949":118734},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3465":70936,"_30211":70924,"_20923":118736,"_5":14374,"_27449":118714,"_2949":118737},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3465":70937,"_30211":70924,"_20923":118739,"_5":14374,"_27449":118718,"_2949":118740},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3465":70938,"_30211":70938,"_5":14726,"_2949":118742,"_30563":118743,"_20923":118744,"_27449":70938},"Cómo funciona Lamassu",[49273,117784],[],{"_3465":70939,"_30211":70938,"_20923":118746,"_5":14374,"_27449":70938,"_2949":118747},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3465":70940,"_30211":70938,"_5":30560,"_20923":118749,"_27449":118750,"_2949":118751},[],"/docs/pr-preview/pr-67/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3465":70941,"_30211":70938,"_5":30560,"_20923":118753,"_27449":118754,"_2949":118755},[],"/docs/pr-preview/pr-67/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3465":70942,"_30211":70938,"_20923":118757,"_5":14374,"_27449":70938,"_2949":118758},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3465":70943,"_30211":70938,"_20923":118760,"_5":14374,"_27449":118750,"_2949":118761},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3465":70944,"_30211":70938,"_20923":118763,"_5":14374,"_27449":118750,"_2949":118764},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3465":70945,"_30211":70938,"_20923":118766,"_5":14374,"_27449":118750,"_2949":118767},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3465":70946,"_30211":70938,"_20923":118769,"_5":14374,"_27449":118750,"_2949":118770},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3465":70947,"_30211":70938,"_20923":118772,"_5":14374,"_27449":118750,"_2949":118773},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3465":70948,"_30211":70938,"_20923":118775,"_5":14374,"_27449":118754,"_2949":118776},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3465":70949,"_30211":70938,"_20923":118778,"_5":14374,"_27449":118754,"_2949":118779},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3465":70950,"_30211":70938,"_20923":118781,"_5":14374,"_27449":118754,"_2949":118782},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3465":70951,"_30211":70938,"_20923":118784,"_5":14374,"_27449":118754,"_2949":118785},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3465":70952,"_30211":70938,"_20923":118787,"_5":14374,"_27449":118754,"_2949":118788},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3465":70953,"_30211":70938,"_20923":118790,"_5":14374,"_27449":118754,"_2949":118791},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3465":70954,"_30211":70938,"_20923":118793,"_5":14374,"_27449":118754,"_2949":118794},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3465":70955,"_30211":70955,"_5":14726,"_2949":118796,"_30563":118797,"_20923":118798,"_27449":70955},"Dispositivos e identidades",[49273,117784,51762,118796],[],{"_3465":70956,"_30211":70955,"_20923":118800,"_5":14374,"_27449":70955,"_2949":118801},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3465":70957,"_30211":70955,"_5":30560,"_20923":118803,"_27449":118804,"_2949":118805},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3465":70958,"_30211":70955,"_5":30560,"_20923":118807,"_27449":118808,"_2949":118809},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3465":70959,"_30211":70955,"_5":30560,"_20923":118811,"_27449":118812,"_2949":118813},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3465":70960,"_30211":70955,"_5":30560,"_20923":118815,"_27449":118816,"_2949":118817},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3465":70961,"_30211":70955,"_5":30560,"_20923":118819,"_27449":118820,"_2949":118821},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3465":70962,"_30211":70955,"_5":30560,"_20923":118823,"_27449":118824,"_2949":118825},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3465":70963,"_30211":70955,"_5":30560,"_20923":118827,"_27449":118828,"_2949":118829},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3465":70964,"_30211":70955,"_5":30560,"_20923":118831,"_27449":118832,"_2949":118833},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3465":70965,"_30211":70955,"_5":30560,"_20923":118835,"_27449":118836,"_2949":118837},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3465":70966,"_30211":70955,"_5":30560,"_20923":118839,"_27449":118840,"_2949":118841},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3465":70967,"_30211":70955,"_5":30560,"_20923":118843,"_27449":118844,"_2949":118845},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3465":70968,"_30211":70955,"_20923":118847,"_5":14374,"_27449":70955,"_2949":118848},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3465":70969,"_30211":70955,"_20923":118850,"_5":14374,"_27449":70955,"_2949":118851},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3465":70970,"_30211":70955,"_20923":118853,"_5":14374,"_27449":118804,"_2949":118854},[],"Vista operativa",{"_3465":70971,"_30211":70955,"_20923":118856,"_5":14374,"_27449":118804,"_2949":118857},[],"Interpretación",{"_3465":70972,"_30211":70955,"_20923":118859,"_5":14374,"_27449":118804,"_2949":51825},[],{"_3465":70973,"_30211":70955,"_20923":118861,"_5":14374,"_27449":118804,"_2949":118862},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3465":70974,"_30211":70955,"_20923":118864,"_5":14374,"_27449":118804,"_2949":51831},[],{"_3465":70975,"_30211":70955,"_20923":118866,"_5":14374,"_27449":118804,"_2949":118867},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3465":70976,"_30211":70955,"_20923":118869,"_5":14374,"_27449":118804,"_2949":51837},[],{"_3465":70977,"_30211":70955,"_20923":118871,"_5":14374,"_27449":118804,"_2949":118872},[],"La identidad está en la ventana operativa de renovación.",{"_3465":70978,"_30211":70955,"_20923":118874,"_5":14374,"_27449":118804,"_2949":51843},[],{"_3465":70979,"_30211":70955,"_20923":118876,"_5":14374,"_27449":118804,"_2949":118877},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3465":70980,"_30211":70955,"_20923":118879,"_5":14374,"_27449":118804,"_2949":51849},[],{"_3465":70981,"_30211":70955,"_20923":118881,"_5":14374,"_27449":118804,"_2949":118882},[],"La identidad ha vencido.",{"_3465":70982,"_30211":70955,"_20923":118884,"_5":14374,"_27449":118804,"_2949":51855},[],{"_3465":70983,"_30211":70955,"_20923":118886,"_5":14374,"_27449":118804,"_2949":118887},[],"La identidad está marcada como revocada.",{"_3465":70984,"_30211":70955,"_20923":118889,"_5":14374,"_27449":118804,"_2949":51861},[],{"_3465":70985,"_30211":70955,"_20923":118891,"_5":14374,"_27449":118804,"_2949":118892},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3465":70986,"_30211":70955,"_20923":118894,"_5":14374,"_27449":118804,"_2949":118895},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3465":70987,"_30211":70955,"_20923":118897,"_5":14374,"_27449":118808,"_2949":118898},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3465":70988,"_30211":70955,"_20923":118900,"_5":14374,"_27449":118808,"_2949":118901},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3465":70989,"_30211":70955,"_20923":118903,"_5":14374,"_27449":118808,"_2949":118904},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3465":70990,"_30211":70955,"_20923":118906,"_5":14374,"_27449":118808,"_2949":118907},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3465":70991,"_30211":70955,"_20923":118909,"_5":14374,"_27449":118812,"_2949":118910},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3465":70992,"_30211":70955,"_20923":118912,"_5":14374,"_27449":118816,"_2949":118913},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3465":70993,"_30211":70955,"_20923":118915,"_5":14374,"_27449":118820,"_2949":118916},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3465":70994,"_30211":70955,"_20923":118918,"_5":14374,"_27449":118824,"_2949":118919},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3465":70995,"_30211":70955,"_20923":118921,"_5":14374,"_27449":118828,"_2949":118922},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3465":70996,"_30211":70955,"_20923":118924,"_5":14374,"_27449":118828,"_2949":118925},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3465":70997,"_30211":70955,"_20923":118927,"_5":14374,"_27449":118832,"_2949":118928},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3465":70998,"_30211":70955,"_20923":118930,"_5":14374,"_27449":118832,"_2949":118931},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3465":70999,"_30211":70955,"_20923":118933,"_5":14374,"_27449":118832,"_2949":118934},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3465":71000,"_30211":70955,"_20923":118936,"_5":14374,"_27449":118832,"_2949":118937},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3465":71001,"_30211":70955,"_20923":118939,"_5":14374,"_27449":118832,"_2949":118940},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3465":71002,"_30211":70955,"_20923":118942,"_5":14374,"_27449":118832,"_2949":118943},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3465":71003,"_30211":70955,"_20923":118945,"_5":14374,"_27449":118836,"_2949":118946},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3465":71004,"_30211":70955,"_20923":118948,"_5":14374,"_27449":118836,"_2949":118949},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3465":71005,"_30211":70955,"_20923":118951,"_5":14374,"_27449":118840,"_2949":118952},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3465":71006,"_30211":70955,"_20923":118954,"_5":14374,"_27449":118840,"_2949":118955},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3465":71007,"_30211":70955,"_20923":118957,"_5":14374,"_27449":118840,"_2949":118958},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3465":71008,"_30211":70955,"_20923":118960,"_5":14374,"_27449":118840,"_2949":118961},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3465":71009,"_30211":70955,"_20923":118963,"_5":14374,"_27449":118844,"_2949":118964},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3465":71010,"_30211":70955,"_20923":118966,"_5":14374,"_27449":118844,"_2949":118967},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3465":71011,"_30211":71011,"_5":14726,"_2949":118969,"_30563":118970,"_20923":118972,"_27449":71011},"Identidad inicial y autenticación",[49273,117784,51762,118796,118971],"Enrolamiento con PKI",[],{"_3465":71012,"_30211":71011,"_20923":118974,"_5":14374,"_27449":71011,"_2949":118975},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3465":71013,"_30211":71011,"_5":30560,"_20923":118977,"_27449":118978,"_2949":118979},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3465":71014,"_30211":71011,"_5":30560,"_20923":118981,"_27449":118982,"_2949":118983},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3465":71015,"_30211":71011,"_5":30560,"_20923":118985,"_27449":118986,"_2949":118987},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3465":71016,"_30211":71011,"_5":30560,"_20923":118989,"_27449":118990,"_2949":118991},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3465":71017,"_30211":71011,"_5":30560,"_20923":118993,"_27449":118994,"_2949":118995},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3465":71018,"_30211":71011,"_20923":118997,"_5":14374,"_27449":71011,"_2949":118998},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3465":71019,"_30211":71011,"_20923":119000,"_5":14374,"_27449":118978,"_2949":119001},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3465":71020,"_30211":71011,"_20923":119003,"_5":14374,"_27449":118978,"_2949":119004},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3465":71021,"_30211":71011,"_20923":119006,"_5":14374,"_27449":118982,"_2949":119007},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3465":71022,"_30211":71011,"_20923":119009,"_5":14374,"_27449":118982,"_2949":119010},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3465":71023,"_30211":71011,"_20923":119012,"_5":14374,"_27449":118982,"_2949":119013},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3465":71024,"_30211":71011,"_20923":119015,"_5":14374,"_27449":118986,"_2949":119016},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3465":71025,"_30211":71011,"_20923":119018,"_5":14374,"_27449":118986,"_2949":119019},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3465":71026,"_30211":71011,"_20923":119021,"_5":14374,"_27449":118990,"_2949":119022},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3465":71027,"_30211":71011,"_20923":119024,"_5":14374,"_27449":118990,"_2949":119025},[],"Ejemplo de cuerpo:",{"_3465":71028,"_30211":71011,"_20923":119027,"_5":14374,"_27449":118990,"_2949":119028},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3465":71029,"_30211":71011,"_20923":119030,"_5":14374,"_27449":118990,"_2949":119031},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3465":71030,"_30211":71011,"_20923":119033,"_5":14374,"_27449":118990,"_2949":119034},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3465":71031,"_30211":71011,"_20923":119036,"_5":14374,"_27449":118990,"_2949":119037},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3465":71032,"_30211":71011,"_20923":119039,"_5":14374,"_27449":118994,"_2949":119040},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3465":71033,"_30211":71011,"_20923":119042,"_5":14374,"_27449":118994,"_2949":119043},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3465":71034,"_30211":71034,"_5":14726,"_2949":119045,"_30563":119046,"_20923":119047,"_27449":71034},"Configura y opera el DMS",[49273,117784,51762,118796,118971],[],{"_3465":71035,"_30211":71034,"_20923":119049,"_5":14374,"_27449":71034,"_2949":119050},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3465":71036,"_30211":71034,"_5":30560,"_20923":119052,"_27449":119053,"_2949":116355},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3465":71037,"_30211":71034,"_5":30560,"_20923":119055,"_27449":119056,"_2949":119057},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3465":71038,"_30211":71034,"_5":30560,"_20923":119059,"_27449":119060,"_2949":119061},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3465":71039,"_30211":71034,"_5":30560,"_20923":119063,"_27449":119064,"_2949":119065},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3465":71040,"_30211":71034,"_5":30560,"_20923":119067,"_27449":119068,"_2949":119069},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3465":71041,"_30211":71034,"_5":30560,"_20923":119071,"_27449":119072,"_2949":119073},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3465":71042,"_30211":71034,"_5":30560,"_20923":119075,"_27449":119076,"_2949":119077},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3465":71043,"_30211":71034,"_5":30560,"_20923":119079,"_27449":119080,"_2949":119081},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3465":71044,"_30211":71034,"_5":30560,"_20923":119083,"_27449":119084,"_2949":52057},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3465":71045,"_30211":71034,"_5":30560,"_20923":119086,"_27449":119087,"_2949":52061},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3465":71046,"_30211":71034,"_5":30560,"_20923":119089,"_27449":119090,"_2949":119091},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3465":71047,"_30211":71034,"_5":30560,"_20923":119093,"_27449":119094,"_2949":119095},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3465":71048,"_30211":71034,"_5":30560,"_20923":119097,"_27449":119098,"_2949":119099},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3465":71049,"_30211":71034,"_5":30560,"_20923":119101,"_27449":119102,"_2949":119103},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3465":71050,"_30211":71034,"_5":30560,"_20923":119105,"_27449":119106,"_2949":52081},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3465":71051,"_30211":71034,"_5":30560,"_20923":119108,"_27449":119109,"_2949":119110},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3465":71052,"_30211":71034,"_5":30560,"_20923":119112,"_27449":119113,"_2949":119114},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3465":71053,"_30211":71034,"_5":30560,"_20923":119116,"_27449":119117,"_2949":119118},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3465":71054,"_30211":71034,"_20923":119120,"_5":14374,"_27449":71034,"_2949":119121},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3465":71055,"_30211":71034,"_20923":119123,"_5":14374,"_27449":119053,"_2949":119124},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3465":71056,"_30211":71034,"_20923":119126,"_5":14374,"_27449":119053,"_2949":119127},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3465":71057,"_30211":71034,"_20923":119129,"_5":14374,"_27449":119060,"_2949":119130},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3465":71058,"_30211":71034,"_20923":119132,"_5":14374,"_27449":119064,"_2949":119133},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3465":71059,"_30211":71034,"_20923":119135,"_5":14374,"_27449":119068,"_2949":119136},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3465":71060,"_30211":71034,"_20923":119138,"_5":14374,"_27449":119072,"_2949":119139},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3465":71061,"_30211":71034,"_20923":119141,"_5":14374,"_27449":119076,"_2949":119142},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3465":71062,"_30211":71034,"_20923":119144,"_5":14374,"_27449":119084,"_2949":119145},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3465":71063,"_30211":71034,"_20923":119147,"_5":14374,"_27449":119084,"_2949":119148},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3465":71064,"_30211":71034,"_20923":119150,"_5":14374,"_27449":119087,"_2949":119151},[],"Campo de `settings.enrollment_settings`",{"_3465":71065,"_30211":71034,"_20923":119153,"_5":14374,"_27449":119087,"_2949":119154},[],"Decisión",{"_3465":71066,"_30211":71034,"_20923":119156,"_5":14374,"_27449":119087,"_2949":52132},[],{"_3465":71067,"_30211":71034,"_20923":119158,"_5":14374,"_27449":119087,"_2949":119159},[],"`EST_RFC7030` para estas operaciones.",{"_3465":71068,"_30211":71034,"_20923":119161,"_5":14374,"_27449":119087,"_2949":52138},[],{"_3465":71069,"_30211":71034,"_20923":119163,"_5":14374,"_27449":119087,"_2949":119164},[],"ID de la CA que firmará.",{"_3465":71070,"_30211":71034,"_20923":119166,"_5":14374,"_27449":119087,"_2949":52144},[],{"_3465":71071,"_30211":71034,"_20923":119168,"_5":14374,"_27449":119087,"_2949":119169},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3465":71072,"_30211":71034,"_20923":119171,"_5":14374,"_27449":119087,"_2949":52150},[],{"_3465":71073,"_30211":71034,"_20923":119173,"_5":14374,"_27449":119087,"_2949":119174},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3465":71074,"_30211":71034,"_20923":119176,"_5":14374,"_27449":119087,"_2949":52156},[],{"_3465":71075,"_30211":71034,"_20923":119178,"_5":14374,"_27449":119087,"_2949":119179},[],"Uno de los cuatro modos de autenticación.",{"_3465":71076,"_30211":71034,"_20923":119181,"_5":14374,"_27449":119087,"_2949":119182},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3465":71077,"_30211":71034,"_20923":119184,"_5":14374,"_27449":119090,"_2949":119185},[],"Los bloques son independientes:",{"_3465":71078,"_30211":71034,"_20923":119187,"_5":14374,"_27449":119090,"_2949":119188},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3465":71079,"_30211":71034,"_20923":119190,"_5":14374,"_27449":119090,"_2949":119191},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3465":71080,"_30211":71034,"_20923":119193,"_5":14374,"_27449":119090,"_2949":52174},[],{"_3465":71081,"_30211":71034,"_20923":119195,"_5":14374,"_27449":119090,"_2949":119196},[],"Control aplicado en la operación configurada",{"_3465":71082,"_30211":71034,"_20923":119198,"_5":14374,"_27449":119090,"_2949":52180},[],{"_3465":71083,"_30211":71034,"_20923":119200,"_5":14374,"_27449":119090,"_2949":119201},[],"Validación del certificado presentado.",{"_3465":71084,"_30211":71034,"_20923":119203,"_5":14374,"_27449":119090,"_2949":52186},[],{"_3465":71085,"_30211":71034,"_20923":119205,"_5":14374,"_27449":119090,"_2949":119206},[],"Autorización del webhook configurado.",{"_3465":71086,"_30211":71034,"_20923":119208,"_5":14374,"_27449":119090,"_2949":52192},[],{"_3465":71087,"_30211":71034,"_20923":119210,"_5":14374,"_27449":119090,"_2949":119211},[],"Validación del certificado y, después, aprobación del webhook.",{"_3465":71088,"_30211":71034,"_20923":119213,"_5":14374,"_27449":119090,"_2949":52198},[],{"_3465":71089,"_30211":71034,"_20923":119215,"_5":14374,"_27449":119090,"_2949":119216},[],"Sin autenticación del solicitante por el DMS.",{"_3465":71090,"_30211":71034,"_20923":119218,"_5":14374,"_27449":119090,"_2949":119219},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3465":71091,"_30211":71034,"_20923":119221,"_5":14374,"_27449":119090,"_2949":119222},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3465":71092,"_30211":71034,"_20923":119224,"_5":14374,"_27449":119090,"_2949":119225},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3465":71093,"_30211":71034,"_20923":119227,"_5":14374,"_27449":119090,"_2949":119228},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3465":71094,"_30211":71034,"_20923":119230,"_5":14374,"_27449":119094,"_2949":119231},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3465":71095,"_30211":71034,"_20923":119233,"_5":14374,"_27449":119094,"_2949":119234},[],"Campo de `external_webhook_settings`",{"_3465":71096,"_30211":71034,"_20923":119236,"_5":14374,"_27449":119094,"_2949":119154},[],{"_3465":71097,"_30211":71034,"_20923":119238,"_5":14374,"_27449":119094,"_2949":52224},[],{"_3465":71098,"_30211":71034,"_20923":119240,"_5":14374,"_27449":119094,"_2949":119241},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3465":71099,"_30211":71034,"_20923":119243,"_5":14374,"_27449":119094,"_2949":52230},[],{"_3465":71100,"_30211":71034,"_20923":119245,"_5":14374,"_27449":119094,"_2949":119246},[],"`POST` o `PUT`; `POST` por defecto.",{"_3465":71101,"_30211":71034,"_20923":119248,"_5":14374,"_27449":119094,"_2949":52236},[],{"_3465":71102,"_30211":71034,"_20923":119250,"_5":14374,"_27449":119094,"_2949":119251},[],"Etiqueta usada en los logs del servicio.",{"_3465":71103,"_30211":71034,"_20923":119253,"_5":14374,"_27449":119094,"_2949":52242},[],{"_3465":71104,"_30211":71034,"_20923":119255,"_5":14374,"_27449":119094,"_2949":119256},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3465":71105,"_30211":71034,"_20923":119258,"_5":14374,"_27449":119094,"_2949":52248},[],{"_3465":71106,"_30211":71034,"_20923":119260,"_5":14374,"_27449":119094,"_2949":119261},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3465":71107,"_30211":71034,"_20923":119263,"_5":14374,"_27449":119094,"_2949":52254},[],{"_3465":71108,"_30211":71034,"_20923":119265,"_5":14374,"_27449":119094,"_2949":119266},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3465":71109,"_30211":71034,"_20923":119268,"_5":14374,"_27449":119094,"_2949":52260},[],{"_3465":71110,"_30211":71034,"_20923":119270,"_5":14374,"_27449":119094,"_2949":119271},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3465":71111,"_30211":71034,"_20923":119273,"_5":14374,"_27449":119094,"_2949":52266},[],{"_3465":71112,"_30211":71034,"_20923":119275,"_5":14374,"_27449":119094,"_2949":119276},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3465":71113,"_30211":71034,"_20923":119278,"_5":14374,"_27449":119094,"_2949":52272},[],{"_3465":71114,"_30211":71034,"_20923":119280,"_5":14374,"_27449":119094,"_2949":119281},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3465":71115,"_30211":71034,"_20923":119283,"_5":14374,"_27449":119094,"_2949":52278},[],{"_3465":71116,"_30211":71034,"_20923":119285,"_5":14374,"_27449":119094,"_2949":119286},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3465":71117,"_30211":71034,"_20923":119288,"_5":14374,"_27449":119094,"_2949":119289},[],"Reglas de esa configuración:",{"_3465":71118,"_30211":71034,"_20923":119291,"_5":14374,"_27449":119094,"_2949":119292},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3465":71119,"_30211":71034,"_20923":119294,"_5":14374,"_27449":119094,"_2949":119295},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3465":71120,"_30211":71034,"_20923":119297,"_5":14374,"_27449":119094,"_2949":119298},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3465":71121,"_30211":71034,"_20923":119300,"_5":14374,"_27449":119094,"_2949":119301},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3465":71122,"_30211":71034,"_20923":119303,"_5":14374,"_27449":119094,"_2949":119304},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3465":71123,"_30211":71034,"_20923":119306,"_5":14374,"_27449":119094,"_2949":119307},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3465":71124,"_30211":71034,"_20923":119309,"_5":14374,"_27449":119094,"_2949":119310},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3465":71125,"_30211":71034,"_20923":119312,"_5":14374,"_27449":119094,"_2949":119313},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3465":71126,"_30211":71034,"_20923":119315,"_5":14374,"_27449":119094,"_2949":119316},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3465":71127,"_30211":71034,"_20923":119318,"_5":14374,"_27449":119098,"_2949":119319},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3465":71128,"_30211":71034,"_20923":119321,"_5":14374,"_27449":119102,"_2949":119322},[],"Campo de `settings.reenrollment_settings`",{"_3465":71129,"_30211":71034,"_20923":119324,"_5":14374,"_27449":119102,"_2949":119325},[],"Función",{"_3465":71130,"_30211":71034,"_20923":119327,"_5":14374,"_27449":119102,"_2949":52322},[],{"_3465":71131,"_30211":71034,"_20923":119329,"_5":14374,"_27449":119102,"_2949":119330},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3465":71132,"_30211":71034,"_20923":119332,"_5":14374,"_27449":119102,"_2949":52328},[],{"_3465":71133,"_30211":71034,"_20923":119334,"_5":14374,"_27449":119102,"_2949":119335},[],"Umbral operativo preventivo de monitorización.",{"_3465":71134,"_30211":71034,"_20923":119337,"_5":14374,"_27449":119102,"_2949":52334},[],{"_3465":71135,"_30211":71034,"_20923":119339,"_5":14374,"_27449":119102,"_2949":119340},[],"Umbral operativo crítico de monitorización.",{"_3465":71136,"_30211":71034,"_20923":119342,"_5":14374,"_27449":119102,"_2949":52340},[],{"_3465":71137,"_30211":71034,"_20923":119344,"_5":14374,"_27449":119102,"_2949":119345},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3465":71138,"_30211":71034,"_20923":119347,"_5":14374,"_27449":119102,"_2949":52346},[],{"_3465":71139,"_30211":71034,"_20923":119349,"_5":14374,"_27449":119102,"_2949":119350},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3465":71140,"_30211":71034,"_20923":119352,"_5":14374,"_27449":119102,"_2949":52352},[],{"_3465":71141,"_30211":71034,"_20923":119354,"_5":14374,"_27449":119102,"_2949":119355},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3465":71142,"_30211":71034,"_20923":119357,"_5":14374,"_27449":119102,"_2949":119358},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3465":71143,"_30211":71034,"_20923":119360,"_5":14374,"_27449":119106,"_2949":119361},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3465":71144,"_30211":71034,"_20923":119363,"_5":14374,"_27449":119109,"_2949":116719},[],{"_3465":71145,"_30211":71034,"_20923":119365,"_5":14374,"_27449":119109,"_2949":119366},[],"Qué publica",{"_3465":71146,"_30211":71034,"_20923":119368,"_5":14374,"_27449":119109,"_2949":52369},[],{"_3465":71147,"_30211":71034,"_20923":119370,"_5":14374,"_27449":119109,"_2949":119371},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3465":71148,"_30211":71034,"_20923":119373,"_5":14374,"_27449":119109,"_2949":52375},[],{"_3465":71149,"_30211":71034,"_20923":119375,"_5":14374,"_27449":119109,"_2949":119376},[],"Certificado de la CA emisora seleccionada.",{"_3465":71150,"_30211":71034,"_20923":119378,"_5":14374,"_27449":119109,"_2949":52381},[],{"_3465":71151,"_30211":71034,"_20923":119380,"_5":14374,"_27449":119109,"_2949":119381},[],"Certificados de las CAs elegidas explícitamente.",{"_3465":71152,"_30211":71034,"_20923":119383,"_5":14374,"_27449":119109,"_2949":119384},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3465":71153,"_30211":71034,"_20923":119386,"_5":14374,"_27449":119113,"_2949":119387},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3465":71154,"_30211":71034,"_20923":119389,"_5":14374,"_27449":119113,"_2949":119390},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3465":71155,"_30211":71034,"_20923":119392,"_5":14374,"_27449":119113,"_2949":119393},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3465":71156,"_30211":71034,"_20923":119395,"_5":14374,"_27449":119117,"_2949":119396},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3465":71157,"_30211":71157,"_5":14726,"_2949":119398,"_30563":119399,"_20923":119400,"_27449":71157},"Integra el cliente EST",[49273,117784,51762,118796,118971],[],{"_3465":71158,"_30211":71157,"_20923":119402,"_5":14374,"_27449":71157,"_2949":119403},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3465":71159,"_30211":71157,"_5":30560,"_20923":119405,"_27449":119406,"_2949":116355},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3465":71160,"_30211":71157,"_5":30560,"_20923":119408,"_27449":119409,"_2949":119410},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3465":71161,"_30211":71157,"_5":30560,"_20923":119412,"_27449":119413,"_2949":119414},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3465":71162,"_30211":71157,"_5":30560,"_20923":119416,"_27449":119417,"_2949":119418},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3465":71163,"_30211":71157,"_5":30560,"_20923":119420,"_27449":119421,"_2949":119422},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3465":71164,"_30211":71157,"_5":30560,"_20923":119424,"_27449":119425,"_2949":119426},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3465":71165,"_30211":71157,"_20923":119428,"_5":14374,"_27449":71157,"_2949":119429},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3465":71166,"_30211":71157,"_20923":119431,"_5":14374,"_27449":119406,"_2949":119432},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3465":71167,"_30211":71157,"_20923":119434,"_5":14374,"_27449":119406,"_2949":119435},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3465":71168,"_30211":71157,"_20923":119437,"_5":14374,"_27449":119406,"_2949":119438},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3465":71169,"_30211":71157,"_20923":119440,"_5":14374,"_27449":119409,"_2949":119441},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3465":71170,"_30211":71157,"_20923":119443,"_5":14374,"_27449":119409,"_2949":119444},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3465":71171,"_30211":71157,"_20923":119446,"_5":14374,"_27449":119413,"_2949":119447},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3465":71172,"_30211":71157,"_20923":119449,"_5":14374,"_27449":119413,"_2949":119450},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3465":71173,"_30211":71157,"_20923":119452,"_5":14374,"_27449":119417,"_2949":119453},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3465":71174,"_30211":71157,"_20923":119455,"_5":14374,"_27449":119417,"_2949":119456},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3465":71175,"_30211":71157,"_20923":119458,"_5":14374,"_27449":119421,"_2949":119459},[],"Para el caso de una raíz que emite directamente:",{"_3465":71176,"_30211":71157,"_20923":119461,"_5":14374,"_27449":119421,"_2949":119462},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3465":71177,"_30211":71157,"_20923":119464,"_5":14374,"_27449":119421,"_2949":119465},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3465":71178,"_30211":71157,"_20923":119467,"_5":14374,"_27449":119425,"_2949":119468},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3465":71179,"_30211":71179,"_5":14726,"_2949":119470,"_30563":119471,"_20923":119472,"_27449":71179},"Referencia EST",[49273,117784,51762,118796,118971],[],{"_3465":71180,"_30211":71179,"_20923":119474,"_5":14374,"_27449":71179,"_2949":119475},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3465":71181,"_30211":71179,"_5":30560,"_20923":119477,"_27449":119478,"_2949":119479},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3465":71182,"_30211":71179,"_5":30560,"_20923":119481,"_27449":119482,"_2949":22685},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3465":71183,"_30211":71179,"_5":30560,"_20923":119484,"_27449":119485,"_2949":26052},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3465":71184,"_30211":71179,"_5":30560,"_20923":119487,"_27449":119488,"_2949":26059},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3465":71185,"_30211":71179,"_5":30560,"_20923":119490,"_27449":119491,"_2949":25378},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3465":71186,"_30211":71179,"_5":30560,"_20923":119493,"_27449":119494,"_2949":119495},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3465":71187,"_30211":71179,"_5":30560,"_20923":119497,"_27449":119498,"_2949":119499},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3465":71188,"_30211":71179,"_5":30560,"_20923":119501,"_27449":119502,"_2949":119503},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3465":71189,"_30211":71179,"_20923":119505,"_5":14374,"_27449":71179,"_2949":119506},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3465":71190,"_30211":71179,"_20923":119508,"_5":14374,"_27449":119478,"_2949":119509},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3465":71191,"_30211":71179,"_20923":119511,"_5":14374,"_27449":119478,"_2949":117544},[],{"_3465":71192,"_30211":71179,"_20923":119513,"_5":14374,"_27449":119478,"_2949":119514},[],"Método",{"_3465":71193,"_30211":71179,"_20923":119516,"_5":14374,"_27449":119478,"_2949":119517},[],"Autenticación y condición",{"_3465":71194,"_30211":71179,"_20923":119519,"_5":14374,"_27449":119478,"_2949":52524},[],{"_3465":71195,"_30211":71179,"_20923":119521,"_5":14374,"_27449":119478,"_2949":52527},[],{"_3465":71196,"_30211":71179,"_20923":119523,"_5":14374,"_27449":119478,"_2949":119524},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3465":71197,"_30211":71179,"_20923":119526,"_5":14374,"_27449":119478,"_2949":52533},[],{"_3465":71198,"_30211":71179,"_20923":119528,"_5":14374,"_27449":119478,"_2949":52536},[],{"_3465":71199,"_30211":71179,"_20923":119530,"_5":14374,"_27449":119478,"_2949":119531},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3465":71200,"_30211":71179,"_20923":119533,"_5":14374,"_27449":119478,"_2949":52542},[],{"_3465":71201,"_30211":71179,"_20923":119535,"_5":14374,"_27449":119478,"_2949":52536},[],{"_3465":71202,"_30211":71179,"_20923":119537,"_5":14374,"_27449":119478,"_2949":119538},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3465":71203,"_30211":71179,"_20923":119540,"_5":14374,"_27449":119478,"_2949":52550},[],{"_3465":71204,"_30211":71179,"_20923":119542,"_5":14374,"_27449":119478,"_2949":52536},[],{"_3465":71205,"_30211":71179,"_20923":119544,"_5":14374,"_27449":119478,"_2949":119545},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3465":71206,"_30211":71179,"_20923":119547,"_5":14374,"_27449":119478,"_2949":119548},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3465":71207,"_30211":71179,"_20923":119550,"_5":14374,"_27449":119482,"_2949":119551},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3465":71208,"_30211":71179,"_20923":119553,"_5":14374,"_27449":119482,"_2949":119554},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3465":71209,"_30211":71179,"_20923":119556,"_5":14374,"_27449":119485,"_2949":119557},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3465":71210,"_30211":71179,"_20923":119559,"_5":14374,"_27449":119485,"_2949":119560},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3465":71211,"_30211":71179,"_20923":119562,"_5":14374,"_27449":119488,"_2949":119563},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3465":71212,"_30211":71179,"_20923":119565,"_5":14374,"_27449":119488,"_2949":119566},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3465":71213,"_30211":71179,"_20923":119568,"_5":14374,"_27449":119491,"_2949":119569},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3465":71214,"_30211":71179,"_20923":119571,"_5":14374,"_27449":119491,"_2949":119572},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3465":71215,"_30211":71179,"_20923":119574,"_5":14374,"_27449":119494,"_2949":119575},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3465":71216,"_30211":71179,"_20923":119577,"_5":14374,"_27449":119494,"_2949":119578},[],"Parte",{"_3465":71217,"_30211":71179,"_20923":119580,"_5":14374,"_27449":119494,"_2949":119581},[],"Contenido tras decodificar su Base64",{"_3465":71218,"_30211":71179,"_20923":119583,"_5":14374,"_27449":119494,"_2949":52594},[],{"_3465":71219,"_30211":71179,"_20923":119585,"_5":14374,"_27449":119494,"_2949":119586},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3465":71220,"_30211":71179,"_20923":119588,"_5":14374,"_27449":119494,"_2949":52600},[],{"_3465":71221,"_30211":71179,"_20923":119590,"_5":14374,"_27449":119494,"_2949":119591},[],"PKCS#7 DER con el certificado emitido.",{"_3465":71222,"_30211":71179,"_20923":119593,"_5":14374,"_27449":119494,"_2949":119594},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3465":71223,"_30211":71179,"_20923":119596,"_5":14374,"_27449":119498,"_2949":119597},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3465":71224,"_30211":71179,"_20923":119599,"_5":14374,"_27449":119498,"_2949":119600},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3465":71225,"_30211":71179,"_20923":119602,"_5":14374,"_27449":119498,"_2949":119603},[],"Convierte y comprueba el resultado:",{"_3465":71226,"_30211":71179,"_20923":119605,"_5":14374,"_27449":119498,"_2949":119606},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3465":71227,"_30211":71179,"_20923":119608,"_5":14374,"_27449":119502,"_2949":119609},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3465":71228,"_30211":71179,"_20923":119611,"_5":14374,"_27449":119502,"_2949":119612},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3465":71229,"_30211":71229,"_5":14726,"_2949":118971,"_30563":119614,"_20923":119615,"_27449":71229},[49273,117784,51762,118796,118971],[],{"_3465":71230,"_30211":71229,"_20923":119617,"_5":14374,"_27449":71229,"_2949":119618},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3465":71231,"_30211":71229,"_5":30560,"_20923":119620,"_27449":119621,"_2949":119622},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3465":71232,"_30211":71229,"_5":30560,"_20923":119624,"_27449":119625,"_2949":119626},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3465":71233,"_30211":71229,"_5":30560,"_20923":119628,"_27449":119629,"_2949":119630},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3465":71234,"_30211":71229,"_5":30560,"_20923":119632,"_27449":119633,"_2949":119634},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3465":71235,"_30211":71229,"_20923":119636,"_5":14374,"_27449":71229,"_2949":119637},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3465":71236,"_30211":71229,"_20923":119639,"_5":14374,"_27449":119621,"_2949":119640},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3465":71237,"_30211":71229,"_20923":119642,"_5":14374,"_27449":119621,"_2949":119643},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3465":71238,"_30211":71229,"_20923":119645,"_5":14374,"_27449":119621,"_2949":119646},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3465":71239,"_30211":71229,"_20923":119648,"_5":14374,"_27449":119621,"_2949":119649},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3465":71240,"_30211":71229,"_20923":119651,"_5":14374,"_27449":119621,"_2949":119652},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3465":71241,"_30211":71229,"_20923":119654,"_5":14374,"_27449":119621,"_2949":119655},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3465":71242,"_30211":71229,"_20923":119657,"_5":14374,"_27449":119625,"_2949":119658},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3465":71243,"_30211":71229,"_20923":119660,"_5":14374,"_27449":119625,"_2949":119661},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":71244,"_30211":71229,"_20923":119663,"_5":14374,"_27449":119625,"_2949":119664},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3465":71245,"_30211":71229,"_20923":119666,"_5":14374,"_27449":119625,"_2949":119667},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3465":71246,"_30211":71229,"_20923":119669,"_5":14374,"_27449":119629,"_2949":119670},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3465":71247,"_30211":71229,"_20923":119672,"_5":14374,"_27449":119629,"_2949":119673},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3465":71248,"_30211":71229,"_20923":119675,"_5":14374,"_27449":119629,"_2949":119676},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3465":71249,"_30211":71229,"_20923":119678,"_5":14374,"_27449":119629,"_2949":119679},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3465":71250,"_30211":71229,"_20923":119681,"_5":14374,"_27449":119633,"_2949":119682},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3465":71251,"_30211":71229,"_20923":119684,"_5":14374,"_27449":119633,"_2949":119685},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3465":71252,"_30211":71252,"_5":14726,"_2949":119687,"_30563":119688,"_20923":119689,"_27449":71252},"Estrategias de aprovisionamiento",[49273,117784,51762,118796,118971],[],{"_3465":71253,"_30211":71252,"_20923":119691,"_5":14374,"_27449":71252,"_2949":119692},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3465":71254,"_30211":71252,"_5":30560,"_20923":119694,"_27449":119695,"_2949":119696},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3465":71255,"_30211":71252,"_5":30560,"_20923":119698,"_27449":119699,"_2949":119700},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3465":71256,"_30211":71252,"_5":30560,"_20923":119702,"_27449":119703,"_2949":119704},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3465":71257,"_30211":71252,"_5":30560,"_20923":119706,"_27449":119707,"_2949":119708},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3465":71258,"_30211":71252,"_5":30560,"_20923":119710,"_27449":119711,"_2949":119712},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3465":71259,"_30211":71252,"_20923":119714,"_5":14374,"_27449":71252,"_2949":119715},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3465":71260,"_30211":71252,"_20923":119717,"_5":14374,"_27449":119695,"_2949":119718},[],"Recorrido",{"_3465":71261,"_30211":71252,"_20923":119720,"_5":14374,"_27449":119695,"_2949":119721},[],"Cuándo existe el dispositivo",{"_3465":71262,"_30211":71252,"_20923":119723,"_5":14374,"_27449":119695,"_2949":119724},[],"Qué compruebas",{"_3465":71263,"_30211":71252,"_20923":119726,"_5":14374,"_27449":119695,"_2949":119727},[],"Asignación manual",{"_3465":71264,"_30211":71252,"_20923":119729,"_5":14374,"_27449":119695,"_2949":119730},[],"El operador lo crea antes de asociar un certificado.",{"_3465":71265,"_30211":71252,"_20923":119732,"_5":14374,"_27449":119695,"_2949":119733},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3465":71266,"_30211":71252,"_20923":119735,"_5":14374,"_27449":119695,"_2949":119736},[],"EST con `JITP`",{"_3465":71267,"_30211":71252,"_20923":119738,"_5":14374,"_27449":119695,"_2949":119739},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3465":71268,"_30211":71252,"_20923":119741,"_5":14374,"_27449":119695,"_2949":119742},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3465":71269,"_30211":71252,"_20923":119744,"_5":14374,"_27449":119695,"_2949":119745},[],"EST con `PRE_REGISTRATION`",{"_3465":71270,"_30211":71252,"_20923":119747,"_5":14374,"_27449":119695,"_2949":119748},[],"Debe existir antes de `/simpleenroll`.",{"_3465":71271,"_30211":71252,"_20923":119750,"_5":14374,"_27449":119695,"_2949":119751},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3465":71272,"_30211":71252,"_20923":119753,"_5":14374,"_27449":119695,"_2949":119754},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3465":71273,"_30211":71252,"_20923":119756,"_5":14374,"_27449":119695,"_2949":119757},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3465":71274,"_30211":71252,"_20923":119759,"_5":14374,"_27449":119699,"_2949":119760},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3465":71275,"_30211":71252,"_20923":119762,"_5":14374,"_27449":119699,"_2949":119763},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3465":71276,"_30211":71252,"_20923":119765,"_5":14374,"_27449":119699,"_2949":119766},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3465":71277,"_30211":71252,"_20923":119768,"_5":14374,"_27449":119703,"_2949":119769},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3465":71278,"_30211":71252,"_20923":119771,"_5":14374,"_27449":119703,"_2949":119772},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3465":71279,"_30211":71252,"_20923":119774,"_5":14374,"_27449":119703,"_2949":119775},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3465":71280,"_30211":71252,"_20923":119777,"_5":14374,"_27449":119703,"_2949":119778},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3465":71281,"_30211":71252,"_20923":119780,"_5":14374,"_27449":119703,"_2949":119781},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3465":71282,"_30211":71252,"_20923":119783,"_5":14374,"_27449":119703,"_2949":119784},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3465":71283,"_30211":71252,"_20923":119786,"_5":14374,"_27449":119707,"_2949":116719},[],{"_3465":71284,"_30211":71252,"_20923":119788,"_5":14374,"_27449":119707,"_2949":119789},[],"Material que atraviesa EST",{"_3465":71285,"_30211":71252,"_20923":119791,"_5":14374,"_27449":119707,"_2949":119792},[],"Clave generada por el dispositivo",{"_3465":71286,"_30211":71252,"_20923":119794,"_5":14374,"_27449":119707,"_2949":119795},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3465":71287,"_30211":71252,"_20923":119797,"_5":14374,"_27449":119707,"_2949":119798},[],"Clave ya disponible en el dispositivo",{"_3465":71288,"_30211":71252,"_20923":119800,"_5":14374,"_27449":119707,"_2949":119801},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3465":71289,"_30211":71252,"_20923":119803,"_5":14374,"_27449":119707,"_2949":52081},[],{"_3465":71290,"_30211":71252,"_20923":119805,"_5":14374,"_27449":119707,"_2949":119806},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3465":71291,"_30211":71252,"_20923":119808,"_5":14374,"_27449":119707,"_2949":119809},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3465":71292,"_30211":71252,"_20923":119811,"_5":14374,"_27449":119711,"_2949":119812},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3465":71293,"_30211":71293,"_5":14726,"_2949":119814,"_30563":119815,"_20923":119816,"_27449":71293},"Renovación y recuperación",[49273,117784,51762,118796,118971],[],{"_3465":71294,"_30211":71293,"_20923":119818,"_5":14374,"_27449":71293,"_2949":119819},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3465":71295,"_30211":71293,"_5":30560,"_20923":119821,"_27449":119822,"_2949":119823},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3465":71296,"_30211":71293,"_5":30560,"_20923":119825,"_27449":119826,"_2949":119827},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3465":71297,"_30211":71293,"_5":30560,"_20923":119829,"_27449":119830,"_2949":119831},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3465":71298,"_30211":71293,"_5":30560,"_20923":119833,"_27449":119834,"_2949":119835},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3465":71299,"_30211":71293,"_5":30560,"_20923":119837,"_27449":119838,"_2949":119839},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3465":71300,"_30211":71293,"_20923":119841,"_5":14374,"_27449":71293,"_2949":119842},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3465":71301,"_30211":71293,"_20923":119844,"_5":14374,"_27449":119822,"_2949":119845},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3465":71302,"_30211":71293,"_20923":119847,"_5":14374,"_27449":119822,"_2949":119848},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3465":71303,"_30211":71293,"_20923":119850,"_5":14374,"_27449":119822,"_2949":119851},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3465":71304,"_30211":71293,"_20923":119853,"_5":14374,"_27449":119822,"_2949":119854},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3465":71305,"_30211":71293,"_20923":119856,"_5":14374,"_27449":119826,"_2949":119857},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3465":71306,"_30211":71293,"_20923":119859,"_5":14374,"_27449":119826,"_2949":119860},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3465":71307,"_30211":71293,"_20923":119862,"_5":14374,"_27449":119830,"_2949":119863},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3465":71308,"_30211":71293,"_20923":119865,"_5":14374,"_27449":119830,"_2949":119866},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3465":71309,"_30211":71293,"_20923":119868,"_5":14374,"_27449":119830,"_2949":119869},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3465":71310,"_30211":71293,"_20923":119871,"_5":14374,"_27449":119834,"_2949":119872},[],"Situación",{"_3465":71311,"_30211":71293,"_20923":119874,"_5":14374,"_27449":119834,"_2949":119875},[],"Procedimiento",{"_3465":71312,"_30211":71293,"_20923":119877,"_5":14374,"_27449":119834,"_2949":119878},[],"Certificado vigente, fuera de ventana",{"_3465":71313,"_30211":71293,"_20923":119880,"_5":14374,"_27449":119834,"_2949":119881},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3465":71314,"_30211":71293,"_20923":119883,"_5":14374,"_27449":119834,"_2949":119884},[],"Certificado vencido, clave disponible",{"_3465":71315,"_30211":71293,"_20923":119886,"_5":14374,"_27449":119834,"_2949":119887},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3465":71316,"_30211":71293,"_20923":119889,"_5":14374,"_27449":119834,"_2949":119890},[],"Renovación por webhook o `NO_AUTH`",{"_3465":71317,"_30211":71293,"_20923":119892,"_5":14374,"_27449":119834,"_2949":119893},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3465":71318,"_30211":71293,"_20923":119895,"_5":14374,"_27449":119834,"_2949":119896},[],"Clave perdida o inaccesible",{"_3465":71319,"_30211":71293,"_20923":119898,"_5":14374,"_27449":119834,"_2949":119899},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3465":71320,"_30211":71293,"_20923":119901,"_5":14374,"_27449":119834,"_2949":119902},[],"Identidad actual revocada",{"_3465":71321,"_30211":71293,"_20923":119904,"_5":14374,"_27449":119834,"_2949":119905},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3465":71322,"_30211":71293,"_20923":119907,"_5":14374,"_27449":119834,"_2949":119908},[],"Dispositivo sin identidad",{"_3465":71323,"_30211":71293,"_20923":119910,"_5":14374,"_27449":119834,"_2949":119911},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3465":71324,"_30211":71293,"_20923":119913,"_5":14374,"_27449":119834,"_2949":119914},[],"Dispositivo retirado",{"_3465":71325,"_30211":71293,"_20923":119916,"_5":14374,"_27449":119834,"_2949":119917},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3465":71326,"_30211":71293,"_20923":119919,"_5":14374,"_27449":119834,"_2949":119920},[],"Timeout, HTTP 500 o fallo de instalación",{"_3465":71327,"_30211":71293,"_20923":119922,"_5":14374,"_27449":119834,"_2949":119923},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3465":71328,"_30211":71293,"_20923":119925,"_5":14374,"_27449":119838,"_2949":119926},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3465":71329,"_30211":71293,"_20923":119928,"_5":14374,"_27449":119838,"_2949":119929},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3465":71330,"_30211":71330,"_5":14726,"_2949":119931,"_30563":119932,"_20923":119933,"_27449":71330},"Diagnóstico de enrolamiento",[49273,117784,51762,118796,118971],[],{"_3465":71331,"_30211":71330,"_20923":119935,"_5":14374,"_27449":71330,"_2949":119936},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3465":71332,"_30211":71330,"_5":30560,"_20923":119938,"_27449":119939,"_2949":119940},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3465":71333,"_30211":71330,"_5":30560,"_20923":119942,"_27449":119943,"_2949":119944},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3465":71334,"_30211":71330,"_5":30560,"_20923":119946,"_27449":119947,"_2949":119503},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3465":71335,"_30211":71330,"_5":30560,"_20923":119949,"_27449":119950,"_2949":119951},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3465":71336,"_30211":71330,"_20923":119953,"_5":14374,"_27449":71330,"_2949":119954},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3465":71337,"_30211":71330,"_20923":119956,"_5":14374,"_27449":119943,"_2949":119957},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3465":71338,"_30211":71330,"_20923":119959,"_5":14374,"_27449":119943,"_2949":119960},[],"Síntoma o mensaje",{"_3465":71339,"_30211":71330,"_20923":119962,"_5":14374,"_27449":119943,"_2949":119963},[],"Qué revisar",{"_3465":71340,"_30211":71330,"_20923":119965,"_5":14374,"_27449":119943,"_2949":119966},[],"curl rechaza TLS, nombre o emisor",{"_3465":71341,"_30211":71330,"_20923":119968,"_5":14374,"_27449":119943,"_2949":119969},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3465":71342,"_30211":71330,"_20923":119971,"_5":14374,"_27449":119943,"_2949":119972},[],"404 o APS ausente",{"_3465":71343,"_30211":71330,"_20923":119974,"_5":14374,"_27449":119943,"_2949":119975},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3465":71344,"_30211":71330,"_20923":119977,"_5":14374,"_27449":119943,"_2949":119978},[],"400, error de CSR o formato",{"_3465":71345,"_30211":71330,"_20923":119980,"_5":14374,"_27449":119943,"_2949":119981},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3465":71346,"_30211":71330,"_20923":119983,"_5":14374,"_27449":119943,"_2949":119984},[],"Credencial ausente o certificado no válido",{"_3465":71347,"_30211":71330,"_20923":119986,"_5":14374,"_27449":119943,"_2949":119987},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3465":71348,"_30211":71330,"_20923":119989,"_5":14374,"_27449":119943,"_2949":119990},[],"Webhook deniega, expira o responde sin autorización",{"_3465":71349,"_30211":71330,"_20923":119992,"_5":14374,"_27449":119943,"_2949":119993},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3465":71350,"_30211":71330,"_20923":119995,"_5":14374,"_27449":119943,"_2949":53007},[],{"_3465":71351,"_30211":71330,"_20923":119997,"_5":14374,"_27449":119943,"_2949":119998},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3465":71352,"_30211":71330,"_20923":120000,"_5":14374,"_27449":119943,"_2949":53013},[],{"_3465":71353,"_30211":71330,"_20923":120002,"_5":14374,"_27449":119943,"_2949":120003},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3465":71354,"_30211":71330,"_20923":120005,"_5":14374,"_27449":119943,"_2949":53019},[],{"_3465":71355,"_30211":71330,"_20923":120007,"_5":14374,"_27449":119943,"_2949":120008},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3465":71356,"_30211":71330,"_20923":120010,"_5":14374,"_27449":119943,"_2949":53025},[],{"_3465":71357,"_30211":71330,"_20923":120012,"_5":14374,"_27449":119943,"_2949":120013},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3465":71358,"_30211":71330,"_20923":120015,"_5":14374,"_27449":119943,"_2949":53031},[],{"_3465":71359,"_30211":71330,"_20923":120017,"_5":14374,"_27449":119943,"_2949":120018},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3465":71360,"_30211":71330,"_20923":120020,"_5":14374,"_27449":119943,"_2949":120021},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3465":71361,"_30211":71330,"_20923":120023,"_5":14374,"_27449":119943,"_2949":120024},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3465":71362,"_30211":71330,"_20923":120026,"_5":14374,"_27449":119943,"_2949":120027},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3465":71363,"_30211":71330,"_20923":120029,"_5":14374,"_27449":119943,"_2949":120030},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3465":71364,"_30211":71330,"_20923":120032,"_5":14374,"_27449":119943,"_2949":53049},[],{"_3465":71365,"_30211":71330,"_20923":120034,"_5":14374,"_27449":119943,"_2949":120035},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3465":71366,"_30211":71330,"_20923":120037,"_5":14374,"_27449":119943,"_2949":53055},[],{"_3465":71367,"_30211":71330,"_20923":120039,"_5":14374,"_27449":119943,"_2949":120040},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3465":71368,"_30211":71330,"_20923":120042,"_5":14374,"_27449":119943,"_2949":120043},[],"DMS propietario distinto",{"_3465":71369,"_30211":71330,"_20923":120045,"_5":14374,"_27449":119943,"_2949":120046},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3465":71370,"_30211":71330,"_20923":120048,"_5":14374,"_27449":119943,"_2949":53067},[],{"_3465":71371,"_30211":71330,"_20923":120050,"_5":14374,"_27449":119943,"_2949":120051},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3465":71372,"_30211":71330,"_20923":120053,"_5":14374,"_27449":119943,"_2949":53073},[],{"_3465":71373,"_30211":71330,"_20923":120055,"_5":14374,"_27449":119943,"_2949":120056},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3465":71374,"_30211":71330,"_20923":120058,"_5":14374,"_27449":119943,"_2949":120059},[],"Certificado actual revocado",{"_3465":71375,"_30211":71330,"_20923":120061,"_5":14374,"_27449":119943,"_2949":120062},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3465":71376,"_30211":71330,"_20923":120064,"_5":14374,"_27449":119943,"_2949":120065},[],"Error de CA, perfil o firma",{"_3465":71377,"_30211":71330,"_20923":120067,"_5":14374,"_27449":119943,"_2949":120068},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3465":71378,"_30211":71330,"_20923":120070,"_5":14374,"_27449":119943,"_2949":120071},[],"HTTP 200 sin conexión del dispositivo",{"_3465":71379,"_30211":71330,"_20923":120073,"_5":14374,"_27449":119943,"_2949":120074},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3465":71380,"_30211":71330,"_20923":120076,"_5":14374,"_27449":119943,"_2949":120077},[],"Timeout o error después de emitir",{"_3465":71381,"_30211":71330,"_20923":120079,"_5":14374,"_27449":119943,"_2949":120080},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3465":71382,"_30211":71330,"_20923":120082,"_5":14374,"_27449":119947,"_2949":120083},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3465":71383,"_30211":71330,"_20923":120085,"_5":14374,"_27449":119947,"_2949":120086},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3465":71384,"_30211":71330,"_20923":120088,"_5":14374,"_27449":119950,"_2949":120089},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3465":71385,"_30211":71330,"_20923":120091,"_5":14374,"_27449":119950,"_2949":120092},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3465":71386,"_30211":71330,"_20923":120094,"_5":14374,"_27449":119950,"_2949":120095},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3465":71387,"_30211":71330,"_20923":120097,"_5":14374,"_27449":119950,"_2949":120098},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3465":71388,"_30211":71330,"_20923":120100,"_5":14374,"_27449":119950,"_2949":120101},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3465":71389,"_30211":71330,"_20923":120103,"_5":14374,"_27449":119950,"_2949":120104},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3465":71390,"_30211":71330,"_20923":120106,"_5":14374,"_27449":119950,"_2949":120107},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3465":71391,"_30211":71391,"_5":14726,"_2949":120109,"_30563":120110,"_20923":120111,"_27449":71391},"Distribución y actualización de confianza",[49273,117784,51762,118796,118971],[],{"_3465":71392,"_30211":71391,"_20923":120113,"_5":14374,"_27449":71391,"_2949":120114},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3465":71393,"_30211":71391,"_5":30560,"_20923":120116,"_27449":120117,"_2949":120118},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3465":71394,"_30211":71391,"_5":30560,"_20923":120120,"_27449":120121,"_2949":120122},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3465":71395,"_30211":71391,"_5":30560,"_20923":120124,"_27449":120125,"_2949":120126},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3465":71396,"_30211":71391,"_5":30560,"_20923":120128,"_27449":120129,"_2949":120130},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3465":71397,"_30211":71391,"_5":30560,"_20923":120132,"_27449":120133,"_2949":120134},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3465":71398,"_30211":71391,"_20923":120136,"_5":14374,"_27449":71391,"_2949":120137},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3465":71399,"_30211":71391,"_20923":120139,"_5":14374,"_27449":120117,"_2949":120140},[],"Relación",{"_3465":71400,"_30211":71391,"_20923":120142,"_5":14374,"_27449":120117,"_2949":120143},[],"Material que prepara el responsable",{"_3465":71401,"_30211":71391,"_20923":120145,"_5":14374,"_27449":120117,"_2949":120146},[],"Dispositivo → servidor EST",{"_3465":71402,"_30211":71391,"_20923":120148,"_5":14374,"_27449":120117,"_2949":120149},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3465":71403,"_30211":71391,"_20923":120151,"_5":14374,"_27449":120117,"_2949":120152},[],"DMS → solicitante",{"_3465":71404,"_30211":71391,"_20923":120154,"_5":14374,"_27449":120117,"_2949":120155},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3465":71405,"_30211":71391,"_20923":120157,"_5":14374,"_27449":120117,"_2949":120158},[],"Consumidor → dispositivo",{"_3465":71406,"_30211":71391,"_20923":120160,"_5":14374,"_27449":120117,"_2949":120161},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3465":71407,"_30211":71391,"_20923":120163,"_5":14374,"_27449":120117,"_2949":120164},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3465":71408,"_30211":71391,"_20923":120166,"_5":14374,"_27449":120121,"_2949":120167},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3465":71409,"_30211":71391,"_20923":120169,"_5":14374,"_27449":120121,"_2949":120170},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3465":71410,"_30211":71391,"_20923":120172,"_5":14374,"_27449":120125,"_2949":120173},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3465":71411,"_30211":71391,"_20923":120175,"_5":14374,"_27449":120125,"_2949":120176},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3465":71412,"_30211":71391,"_20923":120178,"_5":14374,"_27449":120125,"_2949":120179},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3465":71413,"_30211":71391,"_20923":120181,"_5":14374,"_27449":120125,"_2949":120182},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3465":71414,"_30211":71391,"_20923":120184,"_5":14374,"_27449":120125,"_2949":120185},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3465":71415,"_30211":71391,"_20923":120187,"_5":14374,"_27449":120125,"_2949":120188},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3465":71416,"_30211":71391,"_20923":120190,"_5":14374,"_27449":120129,"_2949":120191},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3465":71417,"_30211":71391,"_20923":120193,"_5":14374,"_27449":120129,"_2949":120194},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3465":71418,"_30211":71391,"_20923":120196,"_5":14374,"_27449":120129,"_2949":120197},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3465":71419,"_30211":71391,"_20923":120199,"_5":14374,"_27449":120133,"_2949":120200},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3465":71420,"_30211":71420,"_5":14726,"_2949":53222,"_30563":120202,"_20923":120204,"_27449":71420},[49273,117784,51762,118796,120203],"Integraciones",[],{"_3465":71421,"_30211":71420,"_20923":120206,"_5":14374,"_27449":71420,"_2949":120207},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3465":71422,"_30211":71420,"_5":30560,"_20923":120209,"_27449":120210,"_2949":120211},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3465":71423,"_30211":71420,"_5":30560,"_20923":120213,"_27449":120214,"_2949":120215},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3465":71424,"_30211":71420,"_5":30560,"_20923":120217,"_27449":120218,"_2949":120219},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3465":71425,"_30211":71420,"_5":30560,"_20923":120221,"_27449":120222,"_2949":120223},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3465":71426,"_30211":71420,"_5":30560,"_20923":120225,"_27449":120226,"_2949":120227},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3465":71427,"_30211":71420,"_5":30560,"_20923":120229,"_27449":120230,"_2949":120231},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3465":71428,"_30211":71420,"_5":30560,"_20923":120233,"_27449":120234,"_2949":120235},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3465":71429,"_30211":71420,"_5":30560,"_20923":120237,"_27449":120238,"_2949":120239},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3465":71430,"_30211":71420,"_5":30560,"_20923":120241,"_27449":120242,"_2949":53264},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3465":71431,"_30211":71420,"_5":30560,"_20923":120244,"_27449":120245,"_2949":53268},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3465":71432,"_30211":71420,"_5":30560,"_20923":120247,"_27449":120248,"_2949":120249},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3465":71433,"_30211":71420,"_5":30560,"_20923":120251,"_27449":120252,"_2949":120253},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3465":71434,"_30211":71420,"_5":30560,"_20923":120255,"_27449":120256,"_2949":120257},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3465":71435,"_30211":71420,"_5":30560,"_20923":120259,"_27449":120260,"_2949":120261},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3465":71436,"_30211":71420,"_5":30560,"_20923":120263,"_27449":120264,"_2949":120265},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3465":71437,"_30211":71420,"_5":30560,"_20923":120267,"_27449":120268,"_2949":120269},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3465":71438,"_30211":71420,"_5":30560,"_20923":120271,"_27449":120272,"_2949":120273},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3465":71439,"_30211":71420,"_5":30560,"_20923":120275,"_27449":120276,"_2949":120277},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3465":71440,"_30211":71420,"_5":30560,"_20923":120279,"_27449":120280,"_2949":120281},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3465":71441,"_30211":71420,"_5":30560,"_20923":120283,"_27449":120284,"_2949":120285},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3465":71442,"_30211":71420,"_5":30560,"_20923":120287,"_27449":120288,"_2949":120289},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3465":71443,"_30211":71420,"_5":30560,"_20923":120291,"_27449":120292,"_2949":120293},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3465":71444,"_30211":71420,"_5":30560,"_20923":120295,"_27449":120296,"_2949":120297},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3465":71445,"_30211":71420,"_5":30560,"_20923":120299,"_27449":120300,"_2949":120301},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3465":71446,"_30211":71420,"_5":30560,"_20923":120303,"_27449":120304,"_2949":120305},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3465":71447,"_30211":71420,"_20923":120307,"_5":14374,"_27449":71420,"_2949":120308},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3465":71448,"_30211":71420,"_20923":120310,"_5":14374,"_27449":71420,"_2949":120311},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3465":71449,"_30211":71420,"_20923":120313,"_5":14374,"_27449":71420,"_2949":120314},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3465":71450,"_30211":71420,"_20923":120316,"_5":14374,"_27449":120210,"_2949":120317},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3465":71451,"_30211":71420,"_20923":120319,"_5":14374,"_27449":120210,"_2949":120320},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3465":71452,"_30211":71420,"_20923":120322,"_5":14374,"_27449":120210,"_2949":120323},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3465":71453,"_30211":71420,"_20923":120325,"_5":14374,"_27449":120210,"_2949":120326},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3465":71454,"_30211":71420,"_20923":120328,"_5":14374,"_27449":120214,"_2949":120329},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3465":71455,"_30211":71420,"_20923":120331,"_5":14374,"_27449":120218,"_2949":120332},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3465":71456,"_30211":71420,"_20923":120334,"_5":14374,"_27449":120218,"_2949":120335},[],"Acción IAM",{"_3465":71457,"_30211":71420,"_20923":120337,"_5":14374,"_27449":120218,"_2949":116725},[],{"_3465":71458,"_30211":71420,"_20923":120339,"_5":14374,"_27449":120218,"_2949":53363},[],{"_3465":71459,"_30211":71420,"_20923":120341,"_5":14374,"_27449":120218,"_2949":120342},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3465":71460,"_30211":71420,"_20923":120344,"_5":14374,"_27449":120218,"_2949":53369},[],{"_3465":71461,"_30211":71420,"_20923":120346,"_5":14374,"_27449":120218,"_2949":120347},[],"Registrar la CA en AWS IoT",{"_3465":71462,"_30211":71420,"_20923":120349,"_5":14374,"_27449":120218,"_2949":53375},[],{"_3465":71463,"_30211":71420,"_20923":120351,"_5":14374,"_27449":120218,"_2949":120352},[],"Consultar el estado del registro de la CA",{"_3465":71464,"_30211":71420,"_20923":120354,"_5":14374,"_27449":120218,"_2949":53381},[],{"_3465":71465,"_30211":71420,"_20923":120356,"_5":14374,"_27449":120218,"_2949":120357},[],"Crear o actualizar Things en IoT Core",{"_3465":71466,"_30211":71420,"_20923":120359,"_5":14374,"_27449":120218,"_2949":53387},[],{"_3465":71467,"_30211":71420,"_20923":120361,"_5":14374,"_27449":120218,"_2949":120362},[],"Aprovisionar Things mediante plantilla",{"_3465":71468,"_30211":71420,"_20923":120364,"_5":14374,"_27449":120218,"_2949":53393},[],{"_3465":71469,"_30211":71420,"_20923":120366,"_5":14374,"_27449":120218,"_2949":120367},[],"Registrar certificados de dispositivo",{"_3465":71470,"_30211":71420,"_20923":120369,"_5":14374,"_27449":120218,"_2949":53399},[],{"_3465":71471,"_30211":71420,"_20923":120371,"_5":14374,"_27449":120218,"_2949":120372},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3465":71472,"_30211":71420,"_20923":120374,"_5":14374,"_27449":120218,"_2949":53405},[],{"_3465":71473,"_30211":71420,"_20923":120376,"_5":14374,"_27449":120218,"_2949":120377},[],"Crear y adjuntar políticas IoT",{"_3465":71474,"_30211":71420,"_20923":120379,"_5":14374,"_27449":120218,"_2949":53411},[],{"_3465":71475,"_30211":71420,"_20923":120381,"_5":14374,"_27449":120218,"_2949":120382},[],"Gestionar grupos de Things",{"_3465":71476,"_30211":71420,"_20923":120384,"_5":14374,"_27449":120218,"_2949":53417},[],{"_3465":71477,"_30211":71420,"_20923":120386,"_5":14374,"_27449":120218,"_2949":120387},[],"Crear plantillas JITP",{"_3465":71478,"_30211":71420,"_20923":120389,"_5":14374,"_27449":120218,"_2949":53423},[],{"_3465":71479,"_30211":71420,"_20923":120391,"_5":14374,"_27449":120218,"_2949":120392},[],"Leer y escribir el Device Shadow",{"_3465":71480,"_30211":71420,"_20923":120394,"_5":14374,"_27449":120218,"_2949":120395},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3465":71481,"_30211":71420,"_20923":120397,"_5":14374,"_27449":120222,"_2949":120398},[],"Parámetro",{"_3465":71482,"_30211":71420,"_20923":120400,"_5":14374,"_27449":120222,"_2949":120401},[],"Tipo",{"_3465":71483,"_30211":71420,"_20923":120403,"_5":14374,"_27449":120222,"_2949":120404},[],"Requerido",{"_3465":71484,"_30211":71420,"_20923":120406,"_5":14374,"_27449":120222,"_2949":120407},[],"Descripción",{"_3465":71485,"_30211":71420,"_20923":120409,"_5":14374,"_27449":120222,"_2949":53444},[],{"_3465":71486,"_30211":71420,"_20923":120411,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71487,"_30211":71420,"_20923":120413,"_5":14374,"_27449":120222,"_2949":120414},[],"Sí",{"_3465":71488,"_30211":71420,"_20923":120416,"_5":14374,"_27449":120222,"_2949":120417},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3465":71489,"_30211":71420,"_20923":120419,"_5":14374,"_27449":120222,"_2949":53455},[],{"_3465":71490,"_30211":71420,"_20923":120421,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71491,"_30211":71420,"_20923":120423,"_5":14374,"_27449":120222,"_2949":120414},[],{"_3465":71492,"_30211":71420,"_20923":120425,"_5":14374,"_27449":120222,"_2949":120426},[],"Región AWS donde opera el conector.",{"_3465":71493,"_30211":71420,"_20923":120428,"_5":14374,"_27449":120222,"_2949":53465},[],{"_3465":71494,"_30211":71420,"_20923":120430,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71495,"_30211":71420,"_20923":120432,"_5":14374,"_27449":120222,"_2949":120414},[],{"_3465":71496,"_30211":71420,"_20923":120434,"_5":14374,"_27449":120222,"_2949":120435},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3465":71497,"_30211":71420,"_20923":120437,"_5":14374,"_27449":120222,"_2949":53475},[],{"_3465":71498,"_30211":71420,"_20923":120439,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71499,"_30211":71420,"_20923":120441,"_5":14374,"_27449":120222,"_2949":120442},[],"Solo con `auth_method=static`",{"_3465":71500,"_30211":71420,"_20923":120444,"_5":14374,"_27449":120222,"_2949":120445},[],"Clave de acceso AWS.",{"_3465":71501,"_30211":71420,"_20923":120447,"_5":14374,"_27449":120222,"_2949":53486},[],{"_3465":71502,"_30211":71420,"_20923":120449,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71503,"_30211":71420,"_20923":120451,"_5":14374,"_27449":120222,"_2949":120442},[],{"_3465":71504,"_30211":71420,"_20923":120453,"_5":14374,"_27449":120222,"_2949":120454},[],"Clave secreta AWS.",{"_3465":71505,"_30211":71420,"_20923":120456,"_5":14374,"_27449":120222,"_2949":53496},[],{"_3465":71506,"_30211":71420,"_20923":120458,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71507,"_30211":71420,"_20923":120460,"_5":14374,"_27449":120222,"_2949":53501},[],{"_3465":71508,"_30211":71420,"_20923":120462,"_5":14374,"_27449":120222,"_2949":120463},[],"Token de sesión (con `auth_method=static`).",{"_3465":71509,"_30211":71420,"_20923":120465,"_5":14374,"_27449":120222,"_2949":53507},[],{"_3465":71510,"_30211":71420,"_20923":120467,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71511,"_30211":71420,"_20923":120469,"_5":14374,"_27449":120222,"_2949":120470},[],"Solo con `auth_method=role`",{"_3465":71512,"_30211":71420,"_20923":120472,"_5":14374,"_27449":120222,"_2949":120473},[],"ARN del rol a asumir.",{"_3465":71513,"_30211":71420,"_20923":120475,"_5":14374,"_27449":120222,"_2949":53518},[],{"_3465":71514,"_30211":71420,"_20923":120477,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71515,"_30211":71420,"_20923":120479,"_5":14374,"_27449":120222,"_2949":53501},[],{"_3465":71516,"_30211":71420,"_20923":120481,"_5":14374,"_27449":120222,"_2949":120482},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3465":71517,"_30211":71420,"_20923":120484,"_5":14374,"_27449":120222,"_2949":53528},[],{"_3465":71518,"_30211":71420,"_20923":120486,"_5":14374,"_27449":120222,"_2949":89800},[],{"_3465":71519,"_30211":71420,"_20923":120488,"_5":14374,"_27449":120222,"_2949":120414},[],{"_3465":71520,"_30211":71420,"_20923":120490,"_5":14374,"_27449":120222,"_2949":120491},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3465":71521,"_30211":71420,"_20923":120493,"_5":14374,"_27449":120222,"_2949":53538},[],{"_3465":71522,"_30211":71420,"_20923":120495,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71523,"_30211":71420,"_20923":120497,"_5":14374,"_27449":120222,"_2949":120414},[],{"_3465":71524,"_30211":71420,"_20923":120499,"_5":14374,"_27449":120222,"_2949":120500},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3465":71525,"_30211":71420,"_20923":120502,"_5":14374,"_27449":120222,"_2949":53548},[],{"_3465":71526,"_30211":71420,"_20923":120504,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71527,"_30211":71420,"_20923":120506,"_5":14374,"_27449":120222,"_2949":120414},[],{"_3465":71528,"_30211":71420,"_20923":120508,"_5":14374,"_27449":120222,"_2949":120509},[],"URL HTTP del Device Manager de Lamassu.",{"_3465":71529,"_30211":71420,"_20923":120511,"_5":14374,"_27449":120222,"_2949":53558},[],{"_3465":71530,"_30211":71420,"_20923":120513,"_5":14374,"_27449":120222,"_2949":25028},[],{"_3465":71531,"_30211":71420,"_20923":120515,"_5":14374,"_27449":120222,"_2949":120414},[],{"_3465":71532,"_30211":71420,"_20923":120517,"_5":14374,"_27449":120222,"_2949":120518},[],"URL HTTP del servicio de CA de Lamassu.",{"_3465":71533,"_30211":71420,"_20923":120520,"_5":14374,"_27449":120226,"_2949":120521},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3465":71534,"_30211":71420,"_20923":120523,"_5":14374,"_27449":120226,"_2949":120524},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3465":71535,"_30211":71420,"_20923":120526,"_5":14374,"_27449":120226,"_2949":120527},[],"Tipo de CloudEvent",{"_3465":71536,"_30211":71420,"_20923":120529,"_5":14374,"_27449":120226,"_2949":120530},[],"Recurso en Lamassu",{"_3465":71537,"_30211":71420,"_20923":120532,"_5":14374,"_27449":120226,"_2949":120533},[],"Recurso AWS",{"_3465":71538,"_30211":71420,"_20923":120535,"_5":14374,"_27449":120226,"_2949":120536},[],"Acciones IAM",{"_3465":71539,"_30211":71420,"_20923":120538,"_5":14374,"_27449":120226,"_2949":120539},[],"Llamadas AWS y efecto",{"_3465":71540,"_30211":71420,"_20923":120541,"_5":14374,"_27449":120226,"_2949":120542},[],"Dónde en esta página",{"_3465":71541,"_30211":71420,"_20923":120544,"_5":14374,"_27449":120226,"_2949":53592},[],{"_3465":71542,"_30211":71420,"_20923":120546,"_5":14374,"_27449":120226,"_2949":53595},[],{"_3465":71543,"_30211":71420,"_20923":120548,"_5":14374,"_27449":120226,"_2949":53598},[],{"_3465":71544,"_30211":71420,"_20923":120550,"_5":14374,"_27449":120226,"_2949":53601},[],{"_3465":71545,"_30211":71420,"_20923":120552,"_5":14374,"_27449":120226,"_2949":120553},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3465":71546,"_30211":71420,"_20923":120555,"_5":14374,"_27449":120226,"_2949":120239},[],{"_3465":71547,"_30211":71420,"_20923":120557,"_5":14374,"_27449":120226,"_2949":53609},[],{"_3465":71548,"_30211":71420,"_20923":120559,"_5":14374,"_27449":120226,"_2949":53612},[],{"_3465":71549,"_30211":71420,"_20923":120561,"_5":14374,"_27449":120226,"_2949":53615},[],{"_3465":71550,"_30211":71420,"_20923":120563,"_5":14374,"_27449":120226,"_2949":53618},[],{"_3465":71551,"_30211":71420,"_20923":120565,"_5":14374,"_27449":120226,"_2949":120566},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3465":71552,"_30211":71420,"_20923":120568,"_5":14374,"_27449":120226,"_2949":120265},[],{"_3465":71553,"_30211":71420,"_20923":120570,"_5":14374,"_27449":120226,"_2949":53626},[],{"_3465":71554,"_30211":71420,"_20923":120572,"_5":14374,"_27449":120226,"_2949":120573},[],"Dispositivo",{"_3465":71555,"_30211":71420,"_20923":120575,"_5":14374,"_27449":120226,"_2949":53632},[],{"_3465":71556,"_30211":71420,"_20923":120577,"_5":14374,"_27449":120226,"_2949":53635},[],{"_3465":71557,"_30211":71420,"_20923":120579,"_5":14374,"_27449":120226,"_2949":120580},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3465":71558,"_30211":71420,"_20923":120582,"_5":14374,"_27449":120226,"_2949":120273},[],{"_3465":71559,"_30211":71420,"_20923":120584,"_5":14374,"_27449":120226,"_2949":53643},[],{"_3465":71560,"_30211":71420,"_20923":120586,"_5":14374,"_27449":120226,"_2949":120587},[],"Certificado",{"_3465":71561,"_30211":71420,"_20923":120589,"_5":14374,"_27449":120226,"_2949":53649},[],{"_3465":71562,"_30211":71420,"_20923":120591,"_5":14374,"_27449":120226,"_2949":120592},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3465":71563,"_30211":71420,"_20923":120594,"_5":14374,"_27449":120226,"_2949":120595},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3465":71564,"_30211":71420,"_20923":120597,"_5":14374,"_27449":120226,"_2949":120285},[],{"_3465":71565,"_30211":71420,"_20923":120599,"_5":14374,"_27449":120226,"_2949":53660},[],{"_3465":71566,"_30211":71420,"_20923":120601,"_5":14374,"_27449":120226,"_2949":120602},[],"Certificado / Dispositivo",{"_3465":71567,"_30211":71420,"_20923":120604,"_5":14374,"_27449":120226,"_2949":53666},[],{"_3465":71568,"_30211":71420,"_20923":120606,"_5":14374,"_27449":120226,"_2949":49669},[],{"_3465":71569,"_30211":71420,"_20923":120608,"_5":14374,"_27449":120226,"_2949":120609},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3465":71570,"_30211":71420,"_20923":120611,"_5":14374,"_27449":120226,"_2949":120293},[],{"_3465":71571,"_30211":71420,"_20923":120613,"_5":14374,"_27449":120230,"_2949":120614},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3465":71572,"_30211":71420,"_20923":120616,"_5":14374,"_27449":120234,"_2949":120617},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3465":71573,"_30211":71420,"_20923":120619,"_5":14374,"_27449":120234,"_2949":120620},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3465":71574,"_30211":71420,"_20923":120622,"_5":14374,"_27449":120238,"_2949":120623},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3465":71575,"_30211":71420,"_20923":120625,"_5":14374,"_27449":120238,"_2949":120626},[],"Transición",{"_3465":71576,"_30211":71420,"_20923":120628,"_5":14374,"_27449":120238,"_2949":120629},[],"Llamadas AWS",{"_3465":71577,"_30211":71420,"_20923":120631,"_5":14374,"_27449":120238,"_2949":120632},[],"`NoRegistrada` → `Solicitada`",{"_3465":71578,"_30211":71420,"_20923":120634,"_5":14374,"_27449":120238,"_2949":120635},[],"ninguna (solo escritura de metadatos)",{"_3465":71579,"_30211":71420,"_20923":120637,"_5":14374,"_27449":120238,"_2949":120638},[],"`Solicitada` → `Registrando`",{"_3465":71580,"_30211":71420,"_20923":120640,"_5":14374,"_27449":120238,"_2949":120641},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3465":71581,"_30211":71420,"_20923":120643,"_5":14374,"_27449":120238,"_2949":120644},[],"`Registrando` → `Completada`",{"_3465":71582,"_30211":71420,"_20923":120646,"_5":14374,"_27449":120238,"_2949":120647},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3465":71583,"_30211":71420,"_20923":120649,"_5":14374,"_27449":120238,"_2949":120650},[],"`Registrando` → `Fallida`",{"_3465":71584,"_30211":71420,"_20923":120652,"_5":14374,"_27449":120238,"_2949":120653},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3465":71585,"_30211":71420,"_20923":120655,"_5":14374,"_27449":120238,"_2949":120656},[],"`Fallida` / `Completada` → `Solicitada`",{"_3465":71586,"_30211":71420,"_20923":120658,"_5":14374,"_27449":120238,"_2949":120659},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3465":71587,"_30211":71420,"_20923":120661,"_5":14374,"_27449":120242,"_2949":120662},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3465":71588,"_30211":71420,"_20923":120664,"_5":14374,"_27449":120242,"_2949":120665},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3465":71589,"_30211":71420,"_20923":120667,"_5":14374,"_27449":120242,"_2949":120668},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3465":71590,"_30211":71420,"_20923":120670,"_5":14374,"_27449":120242,"_2949":120671},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3465":71591,"_30211":71420,"_20923":120673,"_5":14374,"_27449":120242,"_2949":120674},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3465":71592,"_30211":71420,"_20923":120676,"_5":14374,"_27449":120242,"_2949":120677},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3465":71593,"_30211":71420,"_20923":120679,"_5":14374,"_27449":120245,"_2949":120680},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3465":71594,"_30211":71420,"_20923":120682,"_5":14374,"_27449":120248,"_2949":120683},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3465":71595,"_30211":71420,"_20923":120685,"_5":14374,"_27449":120248,"_2949":120686},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3465":71596,"_30211":71420,"_20923":120688,"_5":14374,"_27449":120252,"_2949":120689},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3465":71597,"_30211":71420,"_20923":120691,"_5":14374,"_27449":120256,"_2949":120692},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3465":71598,"_30211":71420,"_20923":120694,"_5":14374,"_27449":120256,"_2949":120695},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3465":71599,"_30211":71420,"_20923":120697,"_5":14374,"_27449":120256,"_2949":120698},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3465":71600,"_30211":71420,"_20923":120700,"_5":14374,"_27449":120256,"_2949":120701},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3465":71601,"_30211":71420,"_20923":120703,"_5":14374,"_27449":120256,"_2949":120704},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3465":71602,"_30211":71420,"_20923":120706,"_5":14374,"_27449":120256,"_2949":120707},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3465":71603,"_30211":71420,"_20923":120709,"_5":14374,"_27449":120260,"_2949":120710},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3465":71604,"_30211":71420,"_20923":120712,"_5":14374,"_27449":120260,"_2949":120713},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3465":71605,"_30211":71420,"_20923":120715,"_5":14374,"_27449":120260,"_2949":120716},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3465":71606,"_30211":71420,"_20923":120718,"_5":14374,"_27449":120260,"_2949":120719},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3465":71607,"_30211":71420,"_20923":120721,"_5":14374,"_27449":120260,"_2949":120722},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3465":71608,"_30211":71420,"_20923":120724,"_5":14374,"_27449":120264,"_2949":120725},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3465":71609,"_30211":71420,"_20923":120727,"_5":14374,"_27449":120264,"_2949":120626},[],{"_3465":71610,"_30211":71420,"_20923":120729,"_5":14374,"_27449":120264,"_2949":120629},[],{"_3465":71611,"_30211":71420,"_20923":120731,"_5":14374,"_27449":120264,"_2949":120732},[],"`SinConfigurar` → `None` / `Auto`",{"_3465":71612,"_30211":71420,"_20923":120734,"_5":14374,"_27449":120264,"_2949":120735},[],"ninguna (solo configuración)",{"_3465":71613,"_30211":71420,"_20923":120737,"_5":14374,"_27449":120264,"_2949":53803},[],{"_3465":71614,"_30211":71420,"_20923":120739,"_5":14374,"_27449":120264,"_2949":120735},[],{"_3465":71615,"_30211":71420,"_20923":120741,"_5":14374,"_27449":120264,"_2949":120742},[],"Cualquiera → `Jitp`",{"_3465":71616,"_30211":71420,"_20923":120744,"_5":14374,"_27449":120264,"_2949":120745},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3465":71617,"_30211":71420,"_20923":120747,"_5":14374,"_27449":120264,"_2949":53814},[],{"_3465":71618,"_30211":71420,"_20923":120749,"_5":14374,"_27449":120264,"_2949":120750},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3465":71619,"_30211":71420,"_20923":120752,"_5":14374,"_27449":120268,"_2949":120753},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3465":71620,"_30211":71420,"_20923":120755,"_5":14374,"_27449":120268,"_2949":120756},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3465":71621,"_30211":71420,"_20923":120758,"_5":14374,"_27449":120268,"_2949":120759},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3465":71622,"_30211":71420,"_20923":120761,"_5":14374,"_27449":120272,"_2949":120762},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3465":71623,"_30211":71420,"_20923":120764,"_5":14374,"_27449":120272,"_2949":120626},[],{"_3465":71624,"_30211":71420,"_20923":120766,"_5":14374,"_27449":120272,"_2949":120629},[],{"_3465":71625,"_30211":71420,"_20923":120768,"_5":14374,"_27449":120272,"_2949":120769},[],"`Ausente` → `Aprovisionado`",{"_3465":71626,"_30211":71420,"_20923":120771,"_5":14374,"_27449":120272,"_2949":120772},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3465":71627,"_30211":71420,"_20923":120774,"_5":14374,"_27449":120272,"_2949":120775},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3465":71628,"_30211":71420,"_20923":120777,"_5":14374,"_27449":120272,"_2949":120778},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3465":71629,"_30211":71420,"_20923":120780,"_5":14374,"_27449":120272,"_2949":120781},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3465":71630,"_30211":71420,"_20923":120783,"_5":14374,"_27449":120276,"_2949":120784},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3465":71631,"_30211":71420,"_20923":120786,"_5":14374,"_27449":120276,"_2949":120787},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3465":71632,"_30211":71420,"_20923":120789,"_5":14374,"_27449":120276,"_2949":120790},[],"Para que el flujo JITP funcione correctamente:",{"_3465":71633,"_30211":71420,"_20923":120792,"_5":14374,"_27449":120276,"_2949":120793},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3465":71634,"_30211":71420,"_20923":120795,"_5":14374,"_27449":120276,"_2949":120796},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3465":71635,"_30211":71420,"_20923":120798,"_5":14374,"_27449":120276,"_2949":120799},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3465":71636,"_30211":71420,"_20923":120801,"_5":14374,"_27449":120276,"_2949":120802},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3465":71637,"_30211":71420,"_20923":120804,"_5":14374,"_27449":120280,"_2949":120805},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3465":71638,"_30211":71420,"_20923":120807,"_5":14374,"_27449":120280,"_2949":120808},[],"Estado en Lamassu",{"_3465":71639,"_30211":71420,"_20923":120810,"_5":14374,"_27449":120280,"_2949":120811},[],"Razón de revocación",{"_3465":71640,"_30211":71420,"_20923":120813,"_5":14374,"_27449":120280,"_2949":120814},[],"Estado en AWS IoT Core",{"_3465":71641,"_30211":71420,"_20923":120816,"_5":14374,"_27449":120280,"_2949":53884},[],{"_3465":71642,"_30211":71420,"_20923":120818,"_5":14374,"_27449":120280,"_2949":120819},[],"Ninguna",{"_3465":71643,"_30211":71420,"_20923":120821,"_5":14374,"_27449":120280,"_2949":53890},[],{"_3465":71644,"_30211":71420,"_20923":120823,"_5":14374,"_27449":120280,"_2949":53893},[],{"_3465":71645,"_30211":71420,"_20923":120825,"_5":14374,"_27449":120280,"_2949":53896},[],{"_3465":71646,"_30211":71420,"_20923":120827,"_5":14374,"_27449":120280,"_2949":53899},[],{"_3465":71647,"_30211":71420,"_20923":120829,"_5":14374,"_27449":120280,"_2949":53893},[],{"_3465":71648,"_30211":71420,"_20923":120831,"_5":14374,"_27449":120280,"_2949":120832},[],"Cualquier otra razón",{"_3465":71649,"_30211":71420,"_20923":120834,"_5":14374,"_27449":120280,"_2949":53907},[],{"_3465":71650,"_30211":71420,"_20923":120836,"_5":14374,"_27449":120280,"_2949":120837},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3465":71651,"_30211":71420,"_20923":120839,"_5":14374,"_27449":120284,"_2949":120840},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3465":71652,"_30211":71420,"_20923":120842,"_5":14374,"_27449":120284,"_2949":120626},[],{"_3465":71653,"_30211":71420,"_20923":120844,"_5":14374,"_27449":120284,"_2949":120629},[],{"_3465":71654,"_30211":71420,"_20923":120846,"_5":14374,"_27449":120284,"_2949":120847},[],"`NoSincronizado` → `Active`",{"_3465":71655,"_30211":71420,"_20923":120849,"_5":14374,"_27449":120284,"_2949":53399},[],{"_3465":71656,"_30211":71420,"_20923":120851,"_5":14374,"_27449":120284,"_2949":53925},[],{"_3465":71657,"_30211":71420,"_20923":120853,"_5":14374,"_27449":120284,"_2949":120854},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3465":71658,"_30211":71420,"_20923":120856,"_5":14374,"_27449":120284,"_2949":53931},[],{"_3465":71659,"_30211":71420,"_20923":120858,"_5":14374,"_27449":120284,"_2949":120854},[],{"_3465":71660,"_30211":71420,"_20923":120860,"_5":14374,"_27449":120284,"_2949":53936},[],{"_3465":71661,"_30211":71420,"_20923":120862,"_5":14374,"_27449":120284,"_2949":53399},[],{"_3465":71662,"_30211":71420,"_20923":120864,"_5":14374,"_27449":120284,"_2949":53941},[],{"_3465":71663,"_30211":71420,"_20923":120866,"_5":14374,"_27449":120284,"_2949":120867},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3465":71664,"_30211":71420,"_20923":120869,"_5":14374,"_27449":120288,"_2949":120870},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3465":71665,"_30211":71420,"_20923":120872,"_5":14374,"_27449":120288,"_2949":120873},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3465":71666,"_30211":71420,"_20923":120875,"_5":14374,"_27449":120288,"_2949":120876},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3465":71667,"_30211":71420,"_20923":120878,"_5":14374,"_27449":120292,"_2949":120879},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3465":71668,"_30211":71420,"_20923":120881,"_5":14374,"_27449":120292,"_2949":120882},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3465":71669,"_30211":71420,"_20923":120884,"_5":14374,"_27449":120296,"_2949":120885},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3465":71670,"_30211":71420,"_20923":120887,"_5":14374,"_27449":120296,"_2949":120888},[],"Existen dos tipos de acciones:",{"_3465":71671,"_30211":71420,"_20923":120890,"_5":14374,"_27449":120296,"_2949":120891},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3465":71672,"_30211":71420,"_20923":120893,"_5":14374,"_27449":120296,"_2949":120894},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3465":71673,"_30211":71420,"_20923":120896,"_5":14374,"_27449":120296,"_2949":120897},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3465":71674,"_30211":71420,"_20923":120899,"_5":14374,"_27449":120300,"_2949":120900},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3465":71675,"_30211":71420,"_20923":120902,"_5":14374,"_27449":120300,"_2949":120903},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3465":71676,"_30211":71420,"_20923":120905,"_5":14374,"_27449":120300,"_2949":120906},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3465":71677,"_30211":71420,"_20923":120908,"_5":14374,"_27449":120304,"_2949":120909},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3465":71678,"_30211":71420,"_20923":120911,"_5":14374,"_27449":120304,"_2949":120912},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3465":71679,"_30211":71420,"_20923":120914,"_5":14374,"_27449":120304,"_2949":120915},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3465":71680,"_30211":71420,"_20923":120917,"_5":14374,"_27449":120304,"_2949":120918},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3465":71681,"_30211":71420,"_20923":120920,"_5":14374,"_27449":120304,"_2949":120921},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3465":71682,"_30211":71420,"_20923":120923,"_5":14374,"_27449":120304,"_2949":120924},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3465":71683,"_30211":71420,"_20923":120926,"_5":14374,"_27449":120304,"_2949":120927},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3465":71684,"_30211":71420,"_20923":120929,"_5":14374,"_27449":120304,"_2949":120930},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3465":71685,"_30211":71420,"_20923":120932,"_5":14374,"_27449":120304,"_2949":120933},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3465":71686,"_30211":71420,"_20923":120935,"_5":14374,"_27449":120304,"_2949":120936},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3465":71687,"_30211":71420,"_20923":120938,"_5":14374,"_27449":120304,"_2949":120939},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3465":71688,"_30211":71420,"_20923":120941,"_5":14374,"_27449":120304,"_2949":120942},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3465":71689,"_30211":71420,"_20923":120944,"_5":14374,"_27449":120304,"_2949":120945},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3465":71690,"_30211":71420,"_20923":120947,"_5":14374,"_27449":120304,"_2949":120948},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3465":71691,"_30211":71420,"_20923":120950,"_5":14374,"_27449":120304,"_2949":120951},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3465":71692,"_30211":71420,"_20923":120953,"_5":14374,"_27449":120304,"_2949":120954},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3465":71693,"_30211":71420,"_20923":120956,"_5":14374,"_27449":120304,"_2949":120957},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3465":71694,"_30211":71420,"_20923":120959,"_5":14374,"_27449":120304,"_2949":120960},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3465":71695,"_30211":71420,"_20923":120962,"_5":14374,"_27449":120304,"_2949":120963},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3465":71696,"_30211":71420,"_20923":120965,"_5":14374,"_27449":120304,"_2949":120966},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3465":71697,"_30211":71420,"_20923":120968,"_5":14374,"_27449":120304,"_2949":120969},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3465":71698,"_30211":71420,"_20923":120971,"_5":14374,"_27449":120304,"_2949":120972},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":71699,"_30211":71420,"_20923":120974,"_5":14374,"_27449":120304,"_2949":120975},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3465":71700,"_30211":71420,"_20923":120977,"_5":14374,"_27449":120304,"_2949":120978},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3465":71701,"_30211":71701,"_5":14726,"_2949":51762,"_30563":120980,"_20923":120981,"_27449":71701},[49273,117784,51762],[],{"_3465":71702,"_30211":71701,"_20923":120983,"_5":14374,"_27449":71701,"_2949":120984},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3465":71703,"_30211":71701,"_5":30560,"_20923":120986,"_27449":120987,"_2949":120988},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3465":71704,"_30211":71701,"_5":30560,"_20923":120990,"_27449":120991,"_2949":118796},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3465":71705,"_30211":71701,"_5":30560,"_20923":120993,"_27449":120994,"_2949":118971},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3465":71706,"_30211":71701,"_5":30560,"_20923":120996,"_27449":120997,"_2949":120203},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/overview#integraciones",{"_3465":71707,"_30211":71701,"_5":30560,"_20923":120999,"_27449":121000,"_2949":121001},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3465":71708,"_30211":71701,"_20923":121003,"_5":14374,"_27449":71701,"_2949":121004},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3465":71709,"_30211":71701,"_20923":121006,"_5":14374,"_27449":120987,"_2949":121007},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3465":71710,"_30211":71701,"_20923":121009,"_5":14374,"_27449":120987,"_2949":121010},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3465":71711,"_30211":71701,"_20923":121012,"_5":14374,"_27449":120991,"_2949":121013},[],"Recurso",{"_3465":71712,"_30211":71701,"_20923":121015,"_5":14374,"_27449":120991,"_2949":121016},[],"Qué representa",{"_3465":71713,"_30211":71701,"_20923":121018,"_5":14374,"_27449":120991,"_2949":121019},[],"**Dispositivo**",{"_3465":71714,"_30211":71701,"_20923":121021,"_5":14374,"_27449":120991,"_2949":121022},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3465":71715,"_30211":71701,"_20923":121024,"_5":14374,"_27449":120991,"_2949":121025},[],"**Identidad**",{"_3465":71716,"_30211":71701,"_20923":121027,"_5":14374,"_27449":120991,"_2949":121028},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3465":71717,"_30211":71701,"_20923":121030,"_5":14374,"_27449":120991,"_2949":54108},[],{"_3465":71718,"_30211":71701,"_20923":121032,"_5":14374,"_27449":120991,"_2949":121033},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3465":71719,"_30211":71701,"_20923":121035,"_5":14374,"_27449":120991,"_2949":121036},[],"**Flota**",{"_3465":71720,"_30211":71701,"_20923":121038,"_5":14374,"_27449":120991,"_2949":121039},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3465":71721,"_30211":71701,"_20923":121041,"_5":14374,"_27449":120991,"_2949":121042},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3465":71722,"_30211":71701,"_20923":121044,"_5":14374,"_27449":120991,"_2949":121045},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3465":71723,"_30211":71701,"_20923":121047,"_5":14374,"_27449":120994,"_2949":121048},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3465":71724,"_30211":71701,"_20923":121050,"_5":14374,"_27449":120994,"_2949":121051},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3465":71725,"_30211":71701,"_20923":121053,"_5":14374,"_27449":120994,"_2949":121054},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3465":71726,"_30211":71701,"_20923":121056,"_5":14374,"_27449":120994,"_2949":121057},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3465":71727,"_30211":71701,"_20923":121059,"_5":14374,"_27449":120994,"_2949":121060},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3465":71728,"_30211":71701,"_20923":121062,"_5":14374,"_27449":120994,"_2949":121063},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3465":71729,"_30211":71701,"_20923":121065,"_5":14374,"_27449":120994,"_2949":121066},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3465":71730,"_30211":71701,"_20923":121068,"_5":14374,"_27449":120994,"_2949":121069},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3465":71731,"_30211":71701,"_20923":121071,"_5":14374,"_27449":120997,"_2949":121072},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3465":71732,"_30211":71701,"_20923":121074,"_5":14374,"_27449":120997,"_2949":121075},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3465":71733,"_30211":71701,"_20923":121077,"_5":14374,"_27449":121000,"_2949":121078},[],"Participante",{"_3465":71734,"_30211":71701,"_20923":121080,"_5":14374,"_27449":121000,"_2949":121081},[],"Responsabilidad",{"_3465":71735,"_30211":71701,"_20923":121083,"_5":14374,"_27449":121000,"_2949":121084},[],"Administrador PKI",{"_3465":71736,"_30211":71701,"_20923":121086,"_5":14374,"_27449":121000,"_2949":121087},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3465":71737,"_30211":71701,"_20923":121089,"_5":14374,"_27449":121000,"_2949":121090},[],"Administrador del aprovisionamiento",{"_3465":71738,"_30211":71701,"_20923":121092,"_5":14374,"_27449":121000,"_2949":121093},[],"DMS, admisión, autenticación por operación e inventario.",{"_3465":71739,"_30211":71701,"_20923":121095,"_5":14374,"_27449":121000,"_2949":121096},[],"Integrador del dispositivo",{"_3465":71740,"_30211":71701,"_20923":121098,"_5":14374,"_27449":121000,"_2949":121099},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3465":71741,"_30211":71701,"_20923":121101,"_5":14374,"_27449":121000,"_2949":121102},[],"Integrador del consumidor",{"_3465":71742,"_30211":71701,"_20923":121104,"_5":14374,"_27449":121000,"_2949":121105},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3465":71743,"_30211":71701,"_20923":121107,"_5":14374,"_27449":121000,"_2949":121108},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3465":71744,"_30211":71744,"_5":14726,"_2949":121110,"_30563":121111,"_20923":121113,"_27449":71744},"Enrola y conecta tu primer dispositivo",[49273,117784,51762,121112],"Primeros pasos",[],{"_3465":71745,"_30211":71744,"_20923":121115,"_5":14374,"_27449":71744,"_2949":121116},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3465":71746,"_30211":71744,"_5":30560,"_20923":121118,"_27449":121119,"_2949":116355},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3465":71747,"_30211":71744,"_5":30560,"_20923":121121,"_27449":121122,"_2949":121123},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3465":71748,"_30211":71744,"_5":30560,"_20923":121125,"_27449":121126,"_2949":121127},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3465":71749,"_30211":71744,"_5":30560,"_20923":121129,"_27449":121130,"_2949":121131},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3465":71750,"_30211":71744,"_5":30560,"_20923":121133,"_27449":121134,"_2949":121135},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3465":71751,"_30211":71744,"_5":30560,"_20923":121137,"_27449":121138,"_2949":121139},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3465":71752,"_30211":71744,"_5":30560,"_20923":121141,"_27449":121142,"_2949":121143},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3465":71753,"_30211":71744,"_5":30560,"_20923":121145,"_27449":121146,"_2949":121147},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3465":71754,"_30211":71744,"_20923":121149,"_5":14374,"_27449":71744,"_2949":121150},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3465":71755,"_30211":71744,"_20923":121152,"_5":14374,"_27449":121119,"_2949":121153},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3465":71756,"_30211":71744,"_20923":121155,"_5":14374,"_27449":121119,"_2949":121156},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3465":71757,"_30211":71744,"_20923":121158,"_5":14374,"_27449":121119,"_2949":121159},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3465":71758,"_30211":71744,"_20923":121161,"_5":14374,"_27449":121119,"_2949":121162},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3465":71759,"_30211":71744,"_20923":121164,"_5":14374,"_27449":121119,"_2949":121165},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3465":71760,"_30211":71744,"_20923":121167,"_5":14374,"_27449":121122,"_2949":121168},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3465":71761,"_30211":71744,"_20923":121170,"_5":14374,"_27449":121122,"_2949":121171},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3465":71762,"_30211":71744,"_20923":121173,"_5":14374,"_27449":121126,"_2949":121174},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3465":71763,"_30211":71744,"_20923":121176,"_5":14374,"_27449":121126,"_2949":121177},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3465":71764,"_30211":71744,"_20923":121179,"_5":14374,"_27449":121126,"_2949":121180},[],"Ajuste",{"_3465":71765,"_30211":71744,"_20923":121182,"_5":14374,"_27449":121126,"_2949":121183},[],"Valor de evaluación",{"_3465":71766,"_30211":71744,"_20923":121185,"_5":14374,"_27449":121126,"_2949":54264},[],{"_3465":71767,"_30211":71744,"_20923":121187,"_5":14374,"_27449":121126,"_2949":121188},[],"Raíz emisora de `device-root.pem`.",{"_3465":71768,"_30211":71744,"_20923":121190,"_5":14374,"_27449":121126,"_2949":119099},[],{"_3465":71769,"_30211":71744,"_20923":121192,"_5":14374,"_27449":121126,"_2949":121193},[],"Perfil final de 1 hora que acabas de preparar.",{"_3465":71770,"_30211":71744,"_20923":121195,"_5":14374,"_27449":121126,"_2949":54275},[],{"_3465":71771,"_30211":71744,"_20923":121197,"_5":14374,"_27449":121126,"_2949":54278},[],{"_3465":71772,"_30211":71744,"_20923":121199,"_5":14374,"_27449":121126,"_2949":54281},[],{"_3465":71773,"_30211":71744,"_20923":121201,"_5":14374,"_27449":121126,"_2949":121202},[],"Habilitado.",{"_3465":71774,"_30211":71744,"_20923":121204,"_5":14374,"_27449":121126,"_2949":54287},[],{"_3465":71775,"_30211":71744,"_20923":121206,"_5":14374,"_27449":121126,"_2949":121207},[],"Deshabilitado; el ID debe ser nuevo.",{"_3465":71776,"_30211":71744,"_20923":121209,"_5":14374,"_27449":121126,"_2949":121210},[],"Autenticación inicial",{"_3465":71777,"_30211":71744,"_20923":121212,"_5":14374,"_27449":121126,"_2949":121213},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3465":71778,"_30211":71744,"_20923":121215,"_5":14374,"_27449":121126,"_2949":121216},[],"Autenticación de renovación",{"_3465":71779,"_30211":71744,"_20923":121218,"_5":14374,"_27449":121126,"_2949":121219},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3465":71780,"_30211":71744,"_20923":121221,"_5":14374,"_27449":121126,"_2949":54305},[],{"_3465":71781,"_30211":71744,"_20923":121223,"_5":14374,"_27449":121126,"_2949":121224},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3465":71782,"_30211":71744,"_20923":121226,"_5":14374,"_27449":121126,"_2949":54311},[],{"_3465":71783,"_30211":71744,"_20923":121228,"_5":14374,"_27449":121126,"_2949":121229},[],"1 hora.",{"_3465":71784,"_30211":71744,"_20923":121231,"_5":14374,"_27449":121126,"_2949":54317},[],{"_3465":71785,"_30211":71744,"_20923":121233,"_5":14374,"_27449":121126,"_2949":121234},[],"30 minutos / 10 minutos.",{"_3465":71786,"_30211":71744,"_20923":121236,"_5":14374,"_27449":121126,"_2949":54323},[],{"_3465":71787,"_30211":71744,"_20923":121238,"_5":14374,"_27449":121126,"_2949":121239},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3465":71788,"_30211":71744,"_20923":121241,"_5":14374,"_27449":121126,"_2949":52081},[],{"_3465":71789,"_30211":71744,"_20923":121243,"_5":14374,"_27449":121126,"_2949":121244},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3465":71790,"_30211":71744,"_20923":121246,"_5":14374,"_27449":121126,"_2949":54334},[],{"_3465":71791,"_30211":71744,"_20923":121248,"_5":14374,"_27449":121126,"_2949":121249},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3465":71792,"_30211":71744,"_20923":121251,"_5":14374,"_27449":121126,"_2949":121252},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3465":71793,"_30211":71744,"_20923":121254,"_5":14374,"_27449":121130,"_2949":121255},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3465":71794,"_30211":71744,"_20923":121257,"_5":14374,"_27449":121130,"_2949":121258},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3465":71795,"_30211":71744,"_20923":121260,"_5":14374,"_27449":121134,"_2949":121261},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3465":71796,"_30211":71744,"_20923":121263,"_5":14374,"_27449":121134,"_2949":121264},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3465":71797,"_30211":71744,"_20923":121266,"_5":14374,"_27449":121134,"_2949":121267},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3465":71798,"_30211":71744,"_20923":121269,"_5":14374,"_27449":121138,"_2949":121270},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3465":71799,"_30211":71744,"_20923":121272,"_5":14374,"_27449":121138,"_2949":121273},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3465":71800,"_30211":71744,"_20923":121275,"_5":14374,"_27449":121142,"_2949":121276},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3465":71801,"_30211":71744,"_20923":121278,"_5":14374,"_27449":121142,"_2949":121279},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3465":71802,"_30211":71744,"_20923":121281,"_5":14374,"_27449":121142,"_2949":121282},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3465":71803,"_30211":71744,"_20923":121284,"_5":14374,"_27449":121142,"_2949":121285},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3465":71804,"_30211":71744,"_20923":121287,"_5":14374,"_27449":121142,"_2949":121288},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3465":71805,"_30211":71744,"_20923":121290,"_5":14374,"_27449":121146,"_2949":121291},[],"Comprobación",{"_3465":71806,"_30211":71744,"_20923":121293,"_5":14374,"_27449":121146,"_2949":121294},[],"Resultado esperado",{"_3465":71807,"_30211":71744,"_20923":121296,"_5":14374,"_27449":121146,"_2949":121297},[],"Registro",{"_3465":71808,"_30211":71744,"_20923":121299,"_5":14374,"_27449":121146,"_2949":121300},[],"ID creado automáticamente y DMS correcto.",{"_3465":71809,"_30211":71744,"_20923":121302,"_5":14374,"_27449":121146,"_2949":120587},[],{"_3465":71810,"_30211":71744,"_20923":121304,"_5":14374,"_27449":121146,"_2949":121305},[],"CN, perfil, serie y clave verificados.",{"_3465":71811,"_30211":71744,"_20923":121307,"_5":14374,"_27449":121146,"_2949":121308},[],"Inventario",{"_3465":71812,"_30211":71744,"_20923":121310,"_5":14374,"_27449":121146,"_2949":121311},[],"Serie recibida visible como identidad actual y en el historial.",{"_3465":71813,"_30211":71744,"_20923":121313,"_5":14374,"_27449":121146,"_2949":121314},[],"Consumidor",{"_3465":71814,"_30211":71744,"_20923":121316,"_5":14374,"_27449":121146,"_2949":121317},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3465":71815,"_30211":71744,"_20923":121319,"_5":14374,"_27449":121146,"_2949":121320},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3465":71816,"_30211":71744,"_20923":121322,"_5":14374,"_27449":121146,"_2949":121323},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3465":71817,"_30211":71817,"_5":14726,"_2949":118813,"_30563":121325,"_20923":121326,"_27449":71817},[49273,117784,51762,121112],[],{"_3465":71818,"_30211":71817,"_20923":121328,"_5":14374,"_27449":71817,"_2949":121329},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3465":71819,"_30211":71817,"_5":30560,"_20923":121331,"_27449":121332,"_2949":116355},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3465":71820,"_30211":71817,"_5":30560,"_20923":121334,"_27449":121335,"_2949":121336},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3465":71821,"_30211":71817,"_5":30560,"_20923":121338,"_27449":121339,"_2949":121340},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3465":71822,"_30211":71817,"_5":30560,"_20923":121342,"_27449":121343,"_2949":121344},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3465":71823,"_30211":71817,"_5":30560,"_20923":121346,"_27449":121347,"_2949":121348},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3465":71824,"_30211":71817,"_5":30560,"_20923":121350,"_27449":121351,"_2949":121352},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3465":71825,"_30211":71817,"_5":30560,"_20923":121354,"_27449":121355,"_2949":121294},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3465":71826,"_30211":71817,"_5":30560,"_20923":121357,"_27449":121358,"_2949":121359},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3465":71827,"_30211":71817,"_5":30560,"_20923":121361,"_27449":121362,"_2949":121363},[],"/docs/pr-preview/pr-67/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3465":71828,"_30211":71817,"_20923":121365,"_5":14374,"_27449":71817,"_2949":121366},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3465":71829,"_30211":71817,"_20923":121368,"_5":14374,"_27449":71817,"_2949":121369},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3465":71830,"_30211":71817,"_20923":121371,"_5":14374,"_27449":121332,"_2949":121372},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3465":71831,"_30211":71817,"_20923":121374,"_5":14374,"_27449":121332,"_2949":121375},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3465":71832,"_30211":71817,"_20923":121377,"_5":14374,"_27449":121332,"_2949":121378},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3465":71833,"_30211":71817,"_20923":121380,"_5":14374,"_27449":121332,"_2949":121381},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3465":71834,"_30211":71817,"_20923":121383,"_5":14374,"_27449":121335,"_2949":121384},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3465":71835,"_30211":71817,"_20923":121386,"_5":14374,"_27449":121335,"_2949":121387},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3465":71836,"_30211":71817,"_20923":121389,"_5":14374,"_27449":121335,"_2949":121390},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3465":71837,"_30211":71817,"_20923":121392,"_5":14374,"_27449":121335,"_2949":121393},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3465":71838,"_30211":71817,"_20923":121395,"_5":14374,"_27449":121335,"_2949":121396},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3465":71839,"_30211":71817,"_20923":121398,"_5":14374,"_27449":121335,"_2949":121399},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3465":71840,"_30211":71817,"_20923":121401,"_5":14374,"_27449":121335,"_2949":121402},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3465":71841,"_30211":71817,"_20923":121404,"_5":14374,"_27449":121335,"_2949":121405},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3465":71842,"_30211":71817,"_20923":121407,"_5":14374,"_27449":121339,"_2949":121408},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3465":71843,"_30211":71817,"_20923":121410,"_5":14374,"_27449":121339,"_2949":54499},[],{"_3465":71844,"_30211":71817,"_20923":121412,"_5":14374,"_27449":121339,"_2949":121413},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3465":71845,"_30211":71817,"_20923":121415,"_5":14374,"_27449":121339,"_2949":121416},[],"**Icon** y **Tags**: clasificación opcional.",{"_3465":71846,"_30211":71817,"_20923":121418,"_5":14374,"_27449":121339,"_2949":121419},[],"Confirma el registro.",{"_3465":71847,"_30211":71817,"_20923":121421,"_5":14374,"_27449":121343,"_2949":121422},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3465":71848,"_30211":71817,"_20923":121424,"_5":14374,"_27449":121343,"_2949":121425},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3465":71849,"_30211":71817,"_20923":121427,"_5":14374,"_27449":121347,"_2949":121428},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3465":71850,"_30211":71817,"_20923":121430,"_5":14374,"_27449":121347,"_2949":121431},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3465":71851,"_30211":71817,"_20923":121433,"_5":14374,"_27449":121351,"_2949":121434},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3465":71852,"_30211":71817,"_20923":121436,"_5":14374,"_27449":121351,"_2949":121437},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3465":71853,"_30211":71817,"_20923":121439,"_5":14374,"_27449":121355,"_2949":121291},[],{"_3465":71854,"_30211":71817,"_20923":121441,"_5":14374,"_27449":121355,"_2949":121442},[],"Resultado",{"_3465":71855,"_30211":71817,"_20923":121444,"_5":14374,"_27449":121355,"_2949":120573},[],{"_3465":71856,"_30211":71817,"_20923":121446,"_5":14374,"_27449":121355,"_2949":121447},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3465":71857,"_30211":71817,"_20923":121449,"_5":14374,"_27449":121355,"_2949":121450},[],"Identidad actual",{"_3465":71858,"_30211":71817,"_20923":121452,"_5":14374,"_27449":121355,"_2949":121453},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3465":71859,"_30211":71817,"_20923":121455,"_5":14374,"_27449":121355,"_2949":121456},[],"Historial",{"_3465":71860,"_30211":71817,"_20923":121458,"_5":14374,"_27449":121355,"_2949":121459},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3465":71861,"_30211":71817,"_20923":121461,"_5":14374,"_27449":121355,"_2949":121462},[],"Clave y certificado",{"_3465":71862,"_30211":71817,"_20923":121464,"_5":14374,"_27449":121355,"_2949":121465},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3465":71863,"_30211":71817,"_20923":121467,"_5":14374,"_27449":121358,"_2949":121468},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3465":71864,"_30211":71817,"_20923":121470,"_5":14374,"_27449":121358,"_2949":121471},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3465":71865,"_30211":71817,"_20923":121473,"_5":14374,"_27449":121358,"_2949":121474},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3465":71866,"_30211":71817,"_20923":121476,"_5":14374,"_27449":121358,"_2949":121477},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3465":71867,"_30211":71817,"_20923":121479,"_5":14374,"_27449":121362,"_2949":121480},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3465":71868,"_30211":71817,"_20923":121482,"_5":14374,"_27449":121362,"_2949":121483},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3465":71869,"_30211":71817,"_20923":121485,"_5":14374,"_27449":121362,"_2949":121486},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3465":71870,"_30211":71870,"_5":14726,"_2949":121488,"_30563":121489,"_20923":121490,"_27449":71870},"Plataforma Lamassu IoT",[49273,117784],[],{"_3465":71871,"_30211":71870,"_20923":121492,"_5":14374,"_27449":71870,"_2949":121493},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3465":71872,"_30211":71870,"_5":30560,"_20923":121495,"_27449":121496,"_2949":120988},[],"/docs/pr-preview/pr-67/es/platform/overview#empieza-aquí",{"_3465":71873,"_30211":71870,"_5":30560,"_20923":121498,"_27449":121499,"_2949":121500},[],"/docs/pr-preview/pr-67/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3465":71874,"_30211":71870,"_5":30560,"_20923":121502,"_27449":121503,"_2949":121504},[],"/docs/pr-preview/pr-67/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3465":71875,"_30211":71870,"_5":30560,"_20923":121506,"_27449":121507,"_2949":121508},[],"/docs/pr-preview/pr-67/es/platform/overview#capacidades-principales","Capacidades principales",{"_3465":71876,"_30211":71870,"_5":30560,"_20923":121510,"_27449":121511,"_2949":121512},[],"/docs/pr-preview/pr-67/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3465":71877,"_30211":71870,"_5":30560,"_20923":121514,"_27449":121515,"_2949":121516},[],"/docs/pr-preview/pr-67/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3465":71878,"_30211":71870,"_5":30560,"_20923":121518,"_27449":121519,"_2949":121520},[],"/docs/pr-preview/pr-67/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3465":71879,"_30211":71870,"_5":30560,"_20923":121522,"_27449":121523,"_2949":121524},[],"/docs/pr-preview/pr-67/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3465":71880,"_30211":71870,"_5":30560,"_20923":121526,"_27449":121527,"_2949":121528},[],"/docs/pr-preview/pr-67/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3465":71881,"_30211":71870,"_5":30560,"_20923":121530,"_27449":121531,"_2949":121532},[],"/docs/pr-preview/pr-67/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3465":71882,"_30211":71870,"_5":30560,"_20923":121534,"_27449":121535,"_2949":121536},[],"/docs/pr-preview/pr-67/es/platform/overview#referencia-operativa","Referencia operativa",{"_3465":71883,"_30211":71870,"_20923":121538,"_5":14374,"_27449":71870,"_2949":121539},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3465":71884,"_30211":71870,"_20923":121541,"_5":14374,"_27449":121496,"_2949":121542},[],"Elige el resultado que necesitas obtener:",{"_3465":71885,"_30211":71870,"_20923":121544,"_5":14374,"_27449":121496,"_2949":121545},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3465":71886,"_30211":71870,"_20923":121547,"_5":14374,"_27449":121496,"_2949":121548},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3465":71887,"_30211":71870,"_20923":121550,"_5":14374,"_27449":121496,"_2949":121551},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3465":71888,"_30211":71870,"_20923":121553,"_5":14374,"_27449":121499,"_2949":121554},[],"Bloque",{"_3465":71889,"_30211":71870,"_20923":121556,"_5":14374,"_27449":121499,"_2949":121557},[],"Qué gestionas",{"_3465":71890,"_30211":71870,"_20923":121559,"_5":14374,"_27449":121499,"_2949":121560},[],"Punto de entrada",{"_3465":71891,"_30211":71870,"_20923":121562,"_5":14374,"_27449":121499,"_2949":54652},[],{"_3465":71892,"_30211":71870,"_20923":121564,"_5":14374,"_27449":121499,"_2949":121565},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3465":71893,"_30211":71870,"_20923":121567,"_5":14374,"_27449":121499,"_2949":121568},[],"Visión general de PKI",{"_3465":71894,"_30211":71870,"_20923":121570,"_5":14374,"_27449":121499,"_2949":54661},[],{"_3465":71895,"_30211":71870,"_20923":121572,"_5":14374,"_27449":121499,"_2949":121573},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3465":71896,"_30211":71870,"_20923":121575,"_5":14374,"_27449":121499,"_2949":121576},[],"Visión general de IoT Fleets",{"_3465":71897,"_30211":71870,"_20923":121578,"_5":14374,"_27449":121499,"_2949":121579},[],"**Administración**",{"_3465":71898,"_30211":71870,"_20923":121581,"_5":14374,"_27449":121499,"_2949":121582},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3465":71899,"_30211":71870,"_20923":121584,"_5":14374,"_27449":121499,"_2949":117782},[],{"_3465":71900,"_30211":71870,"_20923":121586,"_5":14374,"_27449":121499,"_2949":121587},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3465":71901,"_30211":71870,"_20923":121589,"_5":14374,"_27449":121503,"_2949":121590},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3465":71902,"_30211":71870,"_20923":121592,"_5":14374,"_27449":121503,"_2949":121593},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3465":71903,"_30211":71870,"_20923":121595,"_5":14374,"_27449":121503,"_2949":121596},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3465":71904,"_30211":71870,"_20923":121598,"_5":14374,"_27449":121503,"_2949":121599},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3465":71905,"_30211":71870,"_20923":121601,"_5":14374,"_27449":121503,"_2949":121602},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3465":71906,"_30211":71870,"_20923":121604,"_5":14374,"_27449":121503,"_2949":121605},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3465":71907,"_30211":71870,"_20923":121607,"_5":14374,"_27449":121511,"_2949":121608},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3465":71908,"_30211":71870,"_20923":121610,"_5":14374,"_27449":121515,"_2949":121611},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3465":71909,"_30211":71870,"_20923":121613,"_5":14374,"_27449":121519,"_2949":121614},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3465":71910,"_30211":71870,"_20923":121616,"_5":14374,"_27449":121523,"_2949":121617},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3465":71911,"_30211":71870,"_20923":121619,"_5":14374,"_27449":121527,"_2949":121620},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3465":71912,"_30211":71870,"_20923":121622,"_5":14374,"_27449":121531,"_2949":121623},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3465":71913,"_30211":71870,"_20923":121625,"_5":14374,"_27449":121535,"_2949":121081},[],{"_3465":71914,"_30211":71870,"_20923":121627,"_5":14374,"_27449":121535,"_2949":121628},[],"Qué prepara o comprueba",{"_3465":71915,"_30211":71870,"_20923":121630,"_5":14374,"_27449":121535,"_2949":121084},[],{"_3465":71916,"_30211":71870,"_20923":121632,"_5":14374,"_27449":121535,"_2949":121633},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3465":71917,"_30211":71870,"_20923":121635,"_5":14374,"_27449":121535,"_2949":121636},[],"Administrador de la flota",{"_3465":71918,"_30211":71870,"_20923":121638,"_5":14374,"_27449":121535,"_2949":121639},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3465":71919,"_30211":71870,"_20923":121641,"_5":14374,"_27449":121535,"_2949":121096},[],{"_3465":71920,"_30211":71870,"_20923":121643,"_5":14374,"_27449":121535,"_2949":121644},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3465":71921,"_30211":71870,"_20923":121646,"_5":14374,"_27449":121535,"_2949":121102},[],{"_3465":71922,"_30211":71870,"_20923":121648,"_5":14374,"_27449":121535,"_2949":121649},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3465":71923,"_30211":71870,"_20923":121651,"_5":14374,"_27449":121535,"_2949":121652},[],"Operador de infraestructura",{"_3465":71924,"_30211":71870,"_20923":121654,"_5":14374,"_27449":121535,"_2949":121655},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3465":71925,"_30211":71870,"_20923":121657,"_5":14374,"_27449":121535,"_2949":121658},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3465":71926,"_30211":71926,"_5":14726,"_2949":121660,"_30563":121661,"_20923":121663,"_27449":71926},"Jerarquía y rotación de CAs",[49273,117784,54753,121662],"Claves, autoridades y certificados",[],{"_3465":71927,"_30211":71926,"_20923":121665,"_5":14374,"_27449":71926,"_2949":121666},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3465":71928,"_30211":71926,"_5":30560,"_20923":121668,"_27449":121669,"_2949":121670},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3465":71929,"_30211":71926,"_5":30560,"_20923":121672,"_27449":121673,"_2949":121674},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3465":71930,"_30211":71926,"_5":30560,"_20923":121676,"_27449":121677,"_2949":121678},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3465":71931,"_30211":71926,"_5":30560,"_20923":121680,"_27449":121681,"_2949":121682},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3465":71932,"_30211":71926,"_5":30560,"_20923":121684,"_27449":121685,"_2949":121686},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3465":71933,"_30211":71926,"_5":30560,"_20923":121688,"_27449":121689,"_2949":121690},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3465":71934,"_30211":71926,"_5":30560,"_20923":121692,"_27449":121693,"_2949":121694},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3465":71935,"_30211":71926,"_5":30560,"_20923":121696,"_27449":121697,"_2949":121698},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3465":71936,"_30211":71926,"_5":30560,"_20923":121700,"_27449":121701,"_2949":121702},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3465":71937,"_30211":71926,"_5":30560,"_20923":121704,"_27449":121705,"_2949":121706},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3465":71938,"_30211":71926,"_5":30560,"_20923":121708,"_27449":121709,"_2949":121710},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3465":71939,"_30211":71926,"_5":30560,"_20923":121712,"_27449":121713,"_2949":121714},[],"/docs/pr-preview/pr-67/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3465":71940,"_30211":71926,"_20923":121716,"_5":14374,"_27449":71926,"_2949":121717},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3465":71941,"_30211":71926,"_20923":121719,"_5":14374,"_27449":71926,"_2949":121720},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3465":71942,"_30211":71926,"_20923":121722,"_5":14374,"_27449":121669,"_2949":121723},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3465":71943,"_30211":71926,"_20923":121725,"_5":14374,"_27449":121669,"_2949":121726},[],"entorno, como producción y preproducción;",{"_3465":71944,"_30211":71926,"_20923":121728,"_5":14374,"_27449":121669,"_2949":121729},[],"propietario o equipo operador;",{"_3465":71945,"_30211":71926,"_20923":121731,"_5":14374,"_27449":121669,"_2949":121732},[],"familia de dispositivos o proceso de fabricación;",{"_3465":71946,"_30211":71926,"_20923":121734,"_5":14374,"_27449":121669,"_2949":121735},[],"región o requisito regulatorio;",{"_3465":71947,"_30211":71926,"_20923":121737,"_5":14374,"_27449":121669,"_2949":121738},[],"motor criptográfico o política de clave;",{"_3465":71948,"_30211":71926,"_20923":121740,"_5":14374,"_27449":121669,"_2949":121741},[],"ventana de mantenimiento y ritmo de renovación.",{"_3465":71949,"_30211":71926,"_20923":121743,"_5":14374,"_27449":121669,"_2949":121744},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3465":71950,"_30211":71926,"_20923":121746,"_5":14374,"_27449":121669,"_2949":121747},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3465":71951,"_30211":71926,"_20923":121749,"_5":14374,"_27449":121673,"_2949":121750},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3465":71952,"_30211":71926,"_20923":121752,"_5":14374,"_27449":121673,"_2949":121753},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3465":71953,"_30211":71926,"_20923":121755,"_5":14374,"_27449":121673,"_2949":121756},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3465":71954,"_30211":71926,"_20923":121758,"_5":14374,"_27449":121673,"_2949":121759},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3465":71955,"_30211":71926,"_20923":121761,"_5":14374,"_27449":121677,"_2949":121762},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3465":71956,"_30211":71926,"_20923":121764,"_5":14374,"_27449":121677,"_2949":121765},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3465":71957,"_30211":71926,"_20923":121767,"_5":14374,"_27449":121677,"_2949":121768},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3465":71958,"_30211":71926,"_20923":121770,"_5":14374,"_27449":121677,"_2949":121771},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3465":71959,"_30211":71926,"_20923":121773,"_5":14374,"_27449":121685,"_2949":121774},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3465":71960,"_30211":71926,"_20923":121776,"_5":14374,"_27449":121689,"_2949":121777},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3465":71961,"_30211":71926,"_20923":121779,"_5":14374,"_27449":121693,"_2949":121780},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3465":71962,"_30211":71926,"_20923":121782,"_5":14374,"_27449":121697,"_2949":121783},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3465":71963,"_30211":71926,"_20923":121785,"_5":14374,"_27449":121701,"_2949":121786},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3465":71964,"_30211":71926,"_20923":121788,"_5":14374,"_27449":121705,"_2949":121789},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3465":71965,"_30211":71926,"_20923":121791,"_5":14374,"_27449":121709,"_2949":121792},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3465":71966,"_30211":71926,"_20923":121794,"_5":14374,"_27449":121709,"_2949":121795},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3465":71967,"_30211":71926,"_20923":121797,"_5":14374,"_27449":121709,"_2949":121798},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3465":71968,"_30211":71926,"_20923":121800,"_5":14374,"_27449":121709,"_2949":121801},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3465":71969,"_30211":71926,"_20923":121803,"_5":14374,"_27449":121713,"_2949":121804},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3465":71970,"_30211":71926,"_20923":121806,"_5":14374,"_27449":121713,"_2949":121807},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3465":71971,"_30211":71926,"_20923":121809,"_5":14374,"_27449":121713,"_2949":121810},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3465":71972,"_30211":71926,"_20923":121812,"_5":14374,"_27449":121713,"_2949":121813},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3465":71973,"_30211":71926,"_20923":121815,"_5":14374,"_27449":121713,"_2949":121816},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3465":71974,"_30211":71926,"_20923":121818,"_5":14374,"_27449":121713,"_2949":121819},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3465":71975,"_30211":71926,"_20923":121821,"_5":14374,"_27449":121713,"_2949":121822},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3465":71976,"_30211":71976,"_5":14726,"_2949":121824,"_30563":121825,"_20923":121826,"_27449":71976},"Autoridades de certificación",[49273,117784,54753,121662],[],{"_3465":71977,"_30211":71976,"_20923":121828,"_5":14374,"_27449":71976,"_2949":121829},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3465":71978,"_30211":71976,"_5":30560,"_20923":121831,"_27449":121832,"_2949":121833},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3465":71979,"_30211":71976,"_5":30560,"_20923":121835,"_27449":121836,"_2949":121837},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3465":71980,"_30211":71976,"_5":30560,"_20923":121839,"_27449":121840,"_2949":116355},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3465":71981,"_30211":71976,"_5":30560,"_20923":121842,"_27449":121843,"_2949":121844},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3465":71982,"_30211":71976,"_5":30560,"_20923":121846,"_27449":121847,"_2949":121848},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3465":71983,"_30211":71976,"_5":30560,"_20923":121850,"_27449":121851,"_2949":121852},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3465":71984,"_30211":71976,"_5":30560,"_20923":121854,"_27449":121855,"_2949":121856},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3465":71985,"_30211":71976,"_5":30560,"_20923":121858,"_27449":121859,"_2949":121860},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3465":71986,"_30211":71976,"_5":30560,"_20923":121862,"_27449":121863,"_2949":121864},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3465":71987,"_30211":71976,"_5":30560,"_20923":121866,"_27449":121867,"_2949":121868},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3465":71988,"_30211":71976,"_5":30560,"_20923":121870,"_27449":121871,"_2949":121872},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3465":71989,"_30211":71976,"_5":30560,"_20923":121874,"_27449":121875,"_2949":121876},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3465":71990,"_30211":71976,"_5":30560,"_20923":121878,"_27449":121879,"_2949":121880},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3465":71991,"_30211":71976,"_5":30560,"_20923":121882,"_27449":121883,"_2949":121884},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3465":71992,"_30211":71976,"_5":30560,"_20923":121886,"_27449":121887,"_2949":121888},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3465":71993,"_30211":71976,"_5":30560,"_20923":121890,"_27449":121891,"_2949":121892},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3465":71994,"_30211":71976,"_5":30560,"_20923":121894,"_27449":121895,"_2949":121896},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3465":71995,"_30211":71976,"_5":30560,"_20923":121898,"_27449":121899,"_2949":121900},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3465":71996,"_30211":71976,"_5":30560,"_20923":121902,"_27449":121903,"_2949":121904},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3465":71997,"_30211":71976,"_5":30560,"_20923":121906,"_27449":121907,"_2949":121908},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3465":71998,"_30211":71976,"_5":30560,"_20923":121910,"_27449":121911,"_2949":121912},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3465":71999,"_30211":71976,"_5":30560,"_20923":121914,"_27449":121915,"_2949":121916},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3465":72000,"_30211":71976,"_5":30560,"_20923":121918,"_27449":121919,"_2949":121920},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3465":72001,"_30211":71976,"_20923":121922,"_5":14374,"_27449":71976,"_2949":121923},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3465":72002,"_30211":71976,"_20923":121925,"_5":14374,"_27449":71976,"_2949":121926},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3465":72003,"_30211":71976,"_20923":121928,"_5":14374,"_27449":71976,"_2949":121929},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3465":72004,"_30211":71976,"_20923":121931,"_5":14374,"_27449":121832,"_2949":121932},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3465":72005,"_30211":71976,"_20923":121934,"_5":14374,"_27449":121832,"_2949":121935},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3465":72006,"_30211":71976,"_20923":121937,"_5":14374,"_27449":121832,"_2949":121938},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3465":72007,"_30211":71976,"_20923":121940,"_5":14374,"_27449":121832,"_2949":121941},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3465":72008,"_30211":71976,"_20923":121943,"_5":14374,"_27449":121832,"_2949":121944},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3465":72009,"_30211":71976,"_20923":121946,"_5":14374,"_27449":121840,"_2949":121947},[],"Decide si la CA será raíz o intermedia.",{"_3465":72010,"_30211":71976,"_20923":121949,"_5":14374,"_27449":121840,"_2949":121950},[],"Elige el motor que custodiará la clave.",{"_3465":72011,"_30211":71976,"_20923":121952,"_5":14374,"_27449":121840,"_2949":121953},[],"Define una validez superior a la de los certificados que emitirá.",{"_3465":72012,"_30211":71976,"_20923":121955,"_5":14374,"_27449":121840,"_2949":121956},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3465":72013,"_30211":71976,"_20923":121958,"_5":14374,"_27449":121843,"_2949":121959},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3465":72014,"_30211":71976,"_20923":121961,"_5":14374,"_27449":121847,"_2949":121962},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3465":72015,"_30211":71976,"_20923":121964,"_5":14374,"_27449":121847,"_2949":121965},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3465":72016,"_30211":71976,"_20923":121967,"_5":14374,"_27449":121851,"_2949":121968},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3465":72017,"_30211":71976,"_20923":121970,"_5":14374,"_27449":121855,"_2949":121971},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3465":72018,"_30211":71976,"_20923":121973,"_5":14374,"_27449":121855,"_2949":121974},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3465":72019,"_30211":71976,"_20923":121976,"_5":14374,"_27449":121855,"_2949":121977},[],"`ST`: estado o provincia.",{"_3465":72020,"_30211":71976,"_20923":121979,"_5":14374,"_27449":121855,"_2949":121980},[],"`L`: localidad.",{"_3465":72021,"_30211":71976,"_20923":121982,"_5":14374,"_27449":121855,"_2949":121983},[],"`O`: organización.",{"_3465":72022,"_30211":71976,"_20923":121985,"_5":14374,"_27449":121855,"_2949":121986},[],"`OU`: unidad organizativa.",{"_3465":72023,"_30211":71976,"_20923":121988,"_5":14374,"_27449":121855,"_2949":121989},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3465":72024,"_30211":71976,"_20923":121991,"_5":14374,"_27449":121859,"_2949":121992},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3465":72025,"_30211":71976,"_20923":121994,"_5":14374,"_27449":121859,"_2949":121995},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3465":72026,"_30211":71976,"_20923":121997,"_5":14374,"_27449":121863,"_2949":121998},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3465":72027,"_30211":71976,"_20923":122000,"_5":14374,"_27449":121863,"_2949":122001},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3465":72028,"_30211":71976,"_20923":122003,"_5":14374,"_27449":121867,"_2949":122004},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3465":72029,"_30211":71976,"_20923":122006,"_5":14374,"_27449":121867,"_2949":122007},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3465":72030,"_30211":71976,"_20923":122009,"_5":14374,"_27449":121871,"_2949":122010},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3465":72031,"_30211":71976,"_20923":122012,"_5":14374,"_27449":121871,"_2949":122013},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3465":72032,"_30211":71976,"_20923":122015,"_5":14374,"_27449":121871,"_2949":122016},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3465":72033,"_30211":71976,"_20923":122018,"_5":14374,"_27449":121875,"_2949":122019},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3465":72034,"_30211":71976,"_20923":122021,"_5":14374,"_27449":121879,"_2949":122022},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3465":72035,"_30211":71976,"_20923":122024,"_5":14374,"_27449":121879,"_2949":122025},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3465":72036,"_30211":71976,"_20923":122027,"_5":14374,"_27449":121883,"_2949":122028},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3465":72037,"_30211":71976,"_20923":122030,"_5":14374,"_27449":121887,"_2949":122031},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3465":72038,"_30211":71976,"_20923":122033,"_5":14374,"_27449":121887,"_2949":122034},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3465":72039,"_30211":71976,"_20923":122036,"_5":14374,"_27449":121891,"_2949":122037},[],"Abre una CA desde el inventario para consultar:",{"_3465":72040,"_30211":71976,"_20923":122039,"_5":14374,"_27449":121891,"_2949":122040},[],"Estado y periodo de validez.",{"_3465":72041,"_30211":71976,"_20923":122042,"_5":14374,"_27449":121891,"_2949":122043},[],"Certificado y cadena en formato PEM.",{"_3465":72042,"_30211":71976,"_20923":122045,"_5":14374,"_27449":121891,"_2949":122046},[],"Número de certificados activos, expirados y revocados.",{"_3465":72043,"_30211":71976,"_20923":122048,"_5":14374,"_27449":121891,"_2949":122049},[],"Certificados emitidos en **Issued Certificates**.",{"_3465":72044,"_30211":71976,"_20923":122051,"_5":14374,"_27449":121891,"_2949":122052},[],"CRL vinculada a la autoridad.",{"_3465":72045,"_30211":71976,"_20923":122054,"_5":14374,"_27449":121891,"_2949":122055},[],"Metadatos y motor criptográfico asociado.",{"_3465":72046,"_30211":71976,"_20923":122057,"_5":14374,"_27449":121891,"_2949":122058},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3465":72047,"_30211":71976,"_20923":122060,"_5":14374,"_27449":121895,"_2949":122061},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3465":72048,"_30211":71976,"_20923":122063,"_5":14374,"_27449":121895,"_2949":122064},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3465":72049,"_30211":71976,"_20923":122066,"_5":14374,"_27449":121895,"_2949":122067},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3465":72050,"_30211":71976,"_20923":122069,"_5":14374,"_27449":121895,"_2949":122070},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3465":72051,"_30211":71976,"_20923":122072,"_5":14374,"_27449":121899,"_2949":122073},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3465":72052,"_30211":71976,"_20923":122075,"_5":14374,"_27449":121903,"_2949":122076},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3465":72053,"_30211":71976,"_20923":122078,"_5":14374,"_27449":121907,"_2949":122079},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3465":72054,"_30211":71976,"_20923":122081,"_5":14374,"_27449":121911,"_2949":122082},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3465":72055,"_30211":71976,"_20923":122084,"_5":14374,"_27449":121915,"_2949":122085},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3465":72056,"_30211":71976,"_20923":122087,"_5":14374,"_27449":121919,"_2949":122088},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3465":72057,"_30211":71976,"_20923":122090,"_5":14374,"_27449":121919,"_2949":122091},[],"Los ajustes de CRL de la CA se conservan como `ARCHIVED`. La última CRL sigue sirviéndose, pero una vez desaparecida la CA nada la regenera, así que ajusta antes su validez y su firmante. Los ajustes archivados pueden borrarse con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Al borrarlos, la CRL deja de servirse y la acción no puede deshacerse; consulta la advertencia en CRL. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3465":72058,"_30211":71976,"_20923":122093,"_5":14374,"_27449":121919,"_2949":122094},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se borren esos ajustes, su última CRL sigue sirviéndose en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; los ajustes archivados dejan de poder editarse (consulta CRL).",{"_3465":72059,"_30211":72059,"_5":14726,"_2949":122096,"_30563":122097,"_20923":122098,"_27449":72059},"Perfiles de certificado",[49273,117784,54753,121662],[],{"_3465":72060,"_30211":72059,"_20923":122100,"_5":14374,"_27449":72059,"_2949":122101},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3465":72061,"_30211":72059,"_5":30560,"_20923":122103,"_27449":122104,"_2949":122105},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3465":72062,"_30211":72059,"_5":30560,"_20923":122107,"_27449":122108,"_2949":122109},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#validez","Validez",{"_3465":72063,"_30211":72059,"_5":30560,"_20923":122111,"_27449":122112,"_2949":122113},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3465":72064,"_30211":72059,"_5":30560,"_20923":122115,"_27449":122116,"_2949":122117},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3465":72065,"_30211":72059,"_5":30560,"_20923":122119,"_27449":122120,"_2949":122121},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3465":72066,"_30211":72059,"_5":30560,"_20923":122123,"_27449":122124,"_2949":122125},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3465":72067,"_30211":72059,"_5":30560,"_20923":122127,"_27449":122128,"_2949":122129},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3465":72068,"_30211":72059,"_5":30560,"_20923":122131,"_27449":122132,"_2949":122133},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3465":72069,"_30211":72059,"_5":30560,"_20923":122135,"_27449":122136,"_2949":122137},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3465":72070,"_30211":72059,"_5":30560,"_20923":122139,"_27449":122140,"_2949":122141},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3465":72071,"_30211":72059,"_5":30560,"_20923":122143,"_27449":122144,"_2949":122145},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3465":72072,"_30211":72059,"_5":30560,"_20923":122147,"_27449":122148,"_2949":122149},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3465":72073,"_30211":72059,"_5":30560,"_20923":122151,"_27449":122152,"_2949":122153},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3465":72074,"_30211":72059,"_5":30560,"_20923":122155,"_27449":122156,"_2949":122157},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3465":72075,"_30211":72059,"_5":30560,"_20923":122159,"_27449":122160,"_2949":122161},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3465":72076,"_30211":72059,"_5":30560,"_20923":122163,"_27449":122164,"_2949":122165},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3465":72077,"_30211":72059,"_20923":122167,"_5":14374,"_27449":72059,"_2949":122168},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3465":72078,"_30211":72059,"_20923":122170,"_5":14374,"_27449":72059,"_2949":122171},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3465":72079,"_30211":72059,"_20923":122173,"_5":14374,"_27449":122108,"_2949":122174},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3465":72080,"_30211":72059,"_20923":122176,"_5":14374,"_27449":122108,"_2949":122177},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3465":72081,"_30211":72059,"_20923":122179,"_5":14374,"_27449":122112,"_2949":122180},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3465":72082,"_30211":72059,"_20923":122182,"_5":14374,"_27449":122116,"_2949":122183},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3465":72083,"_30211":72059,"_20923":122185,"_5":14374,"_27449":122116,"_2949":122186},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3465":72084,"_30211":72059,"_20923":122188,"_5":14374,"_27449":122116,"_2949":122189},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3465":72085,"_30211":72059,"_20923":122191,"_5":14374,"_27449":122120,"_2949":122192},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3465":72086,"_30211":72059,"_20923":122194,"_5":14374,"_27449":122124,"_2949":122195},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3465":72087,"_30211":72059,"_20923":122197,"_5":14374,"_27449":122124,"_2949":122198},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3465":72088,"_30211":72059,"_20923":122200,"_5":14374,"_27449":122128,"_2949":122201},[],"La aplicación criptográfica puede:",{"_3465":72089,"_30211":72059,"_20923":122203,"_5":14374,"_27449":122128,"_2949":122204},[],"permitir o bloquear claves RSA;",{"_3465":72090,"_30211":72059,"_20923":122206,"_5":14374,"_27449":122128,"_2949":122207},[],"limitar los tamaños RSA admitidos;",{"_3465":72091,"_30211":72059,"_20923":122209,"_5":14374,"_27449":122128,"_2949":122210},[],"permitir o bloquear claves ECDSA;",{"_3465":72092,"_30211":72059,"_20923":122212,"_5":14374,"_27449":122128,"_2949":122213},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3465":72093,"_30211":72059,"_20923":122215,"_5":14374,"_27449":122128,"_2949":122216},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3465":72094,"_30211":72059,"_20923":122218,"_5":14374,"_27449":122132,"_2949":122219},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3465":72095,"_30211":72059,"_20923":122221,"_5":14374,"_27449":122132,"_2949":117544},[],{"_3465":72096,"_30211":72059,"_20923":122223,"_5":14374,"_27449":122132,"_2949":122224},[],"Primera opción",{"_3465":72097,"_30211":72059,"_20923":122226,"_5":14374,"_27449":122132,"_2949":122227},[],"Segunda opción",{"_3465":72098,"_30211":72059,"_20923":122229,"_5":14374,"_27449":122132,"_2949":122230},[],"Si no hay ninguna",{"_3465":72099,"_30211":72059,"_20923":122232,"_5":14374,"_27449":122132,"_2949":122233},[],"Firma directa con una CA",{"_3465":72100,"_30211":72059,"_20923":122235,"_5":14374,"_27449":122132,"_2949":122236},[],"`issuance_profile` incluido en la solicitud",{"_3465":72101,"_30211":72059,"_20923":122238,"_5":14374,"_27449":122132,"_2949":122239},[],"`issuance_profile_id` de la solicitud",{"_3465":72102,"_30211":72059,"_20923":122241,"_5":14374,"_27449":122132,"_2949":122242},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3465":72103,"_30211":72059,"_20923":122244,"_5":14374,"_27449":122132,"_2949":122245},[],"Emisión mediante DMS",{"_3465":72104,"_30211":72059,"_20923":122247,"_5":14374,"_27449":122132,"_2949":55340},[],{"_3465":72105,"_30211":72059,"_20923":122249,"_5":14374,"_27449":122132,"_2949":122250},[],"`settings.issuance_profile` incluido en el DMS",{"_3465":72106,"_30211":72059,"_20923":122252,"_5":14374,"_27449":122132,"_2949":122253},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3465":72107,"_30211":72059,"_20923":122255,"_5":14374,"_27449":122132,"_2949":122256},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3465":72108,"_30211":72059,"_20923":122258,"_5":14374,"_27449":122132,"_2949":122259},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3465":72109,"_30211":72059,"_20923":122261,"_5":14374,"_27449":122140,"_2949":122262},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3465":72110,"_30211":72059,"_20923":122264,"_5":14374,"_27449":122144,"_2949":122265},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3465":72111,"_30211":72059,"_20923":122267,"_5":14374,"_27449":122148,"_2949":122268},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3465":72112,"_30211":72059,"_20923":122270,"_5":14374,"_27449":122152,"_2949":122271},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3465":72113,"_30211":72059,"_20923":122273,"_5":14374,"_27449":122156,"_2949":122274},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3465":72114,"_30211":72059,"_20923":122276,"_5":14374,"_27449":122156,"_2949":122277},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3465":72115,"_30211":72059,"_20923":122279,"_5":14374,"_27449":122160,"_2949":122280},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3465":72116,"_30211":72059,"_20923":122282,"_5":14374,"_27449":122160,"_2949":122283},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3465":72117,"_30211":72059,"_20923":122285,"_5":14374,"_27449":122160,"_2949":122286},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3465":72118,"_30211":72059,"_20923":122288,"_5":14374,"_27449":122160,"_2949":122289},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3465":72119,"_30211":72059,"_20923":122291,"_5":14374,"_27449":122164,"_2949":122292},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3465":72120,"_30211":72059,"_20923":122294,"_5":14374,"_27449":122164,"_2949":122295},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3465":72121,"_30211":72121,"_5":14726,"_2949":122297,"_30563":122298,"_20923":122300,"_27449":72121},"Validación de certificados",[49273,117784,54753,122299],"Validación",[],{"_3465":72122,"_30211":72121,"_20923":122302,"_5":14374,"_27449":72121,"_2949":122303},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3465":72123,"_30211":72121,"_5":30560,"_20923":122305,"_27449":122306,"_2949":122307},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3465":72124,"_30211":72121,"_5":30560,"_20923":122309,"_27449":122310,"_2949":122311},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3465":72125,"_30211":72121,"_5":30560,"_20923":122313,"_27449":122314,"_2949":122315},[],"/docs/pr-preview/pr-67/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3465":72126,"_30211":72121,"_20923":122317,"_5":14374,"_27449":72121,"_2949":122318},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3465":72127,"_30211":72121,"_20923":122320,"_5":14374,"_27449":122306,"_2949":122321},[],"Verifica estos criterios juntos:",{"_3465":72128,"_30211":72121,"_20923":122323,"_5":14374,"_27449":122306,"_2949":121291},[],{"_3465":72129,"_30211":72121,"_20923":122325,"_5":14374,"_27449":122306,"_2949":122326},[],"Resultado necesario",{"_3465":72130,"_30211":72121,"_20923":122328,"_5":14374,"_27449":122306,"_2949":122329},[],"Cadena y firma",{"_3465":72131,"_30211":72121,"_20923":122331,"_5":14374,"_27449":122306,"_2949":122332},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3465":72132,"_30211":72121,"_20923":122334,"_5":14374,"_27449":122306,"_2949":122335},[],"Fechas",{"_3465":72133,"_30211":72121,"_20923":122337,"_5":14374,"_27449":122306,"_2949":122338},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3465":72134,"_30211":72121,"_20923":122340,"_5":14374,"_27449":122306,"_2949":117454},[],{"_3465":72135,"_30211":72121,"_20923":122342,"_5":14374,"_27449":122306,"_2949":122343},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3465":72136,"_30211":72121,"_20923":122345,"_5":14374,"_27449":122306,"_2949":122346},[],"Uso",{"_3465":72137,"_30211":72121,"_20923":122348,"_5":14374,"_27449":122306,"_2949":122349},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3465":72138,"_30211":72121,"_20923":122351,"_5":14374,"_27449":122306,"_2949":122352},[],"Revocación",{"_3465":72139,"_30211":72121,"_20923":122354,"_5":14374,"_27449":122306,"_2949":122355},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3465":72140,"_30211":72121,"_20923":122357,"_5":14374,"_27449":122306,"_2949":122358},[],"Autorización",{"_3465":72141,"_30211":72121,"_20923":122360,"_5":14374,"_27449":122306,"_2949":122361},[],"La aplicación permite la acción a esa identidad.",{"_3465":72142,"_30211":72121,"_20923":122363,"_5":14374,"_27449":122306,"_2949":122364},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3465":72143,"_30211":72121,"_20923":122366,"_5":14374,"_27449":122310,"_2949":122367},[],"Mecanismo",{"_3465":72144,"_30211":72121,"_20923":122369,"_5":14374,"_27449":122310,"_2949":122370},[],"Cuándo utilizarlo",{"_3465":72145,"_30211":72121,"_20923":122372,"_5":14374,"_27449":122310,"_2949":122373},[],"Qué debes mantener",{"_3465":72146,"_30211":72121,"_20923":122375,"_5":14374,"_27449":122310,"_2949":55468},[],{"_3465":72147,"_30211":72121,"_20923":122377,"_5":14374,"_27449":122310,"_2949":122378},[],"Consulta del estado de un certificado concreto.",{"_3465":72148,"_30211":72121,"_20923":122380,"_5":14374,"_27449":122310,"_2949":122381},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3465":72149,"_30211":72121,"_20923":122383,"_5":14374,"_27449":122310,"_2949":55477},[],{"_3465":72150,"_30211":72121,"_20923":122385,"_5":14374,"_27449":122310,"_2949":122386},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3465":72151,"_30211":72121,"_20923":122388,"_5":14374,"_27449":122310,"_2949":122389},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3465":72152,"_30211":72121,"_20923":122391,"_5":14374,"_27449":122310,"_2949":122392},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3465":72153,"_30211":72121,"_20923":122394,"_5":14374,"_27449":122310,"_2949":122395},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3465":72154,"_30211":72121,"_20923":122397,"_5":14374,"_27449":122314,"_2949":122398},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3465":72155,"_30211":72121,"_20923":122400,"_5":14374,"_27449":122314,"_2949":122401},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3465":72156,"_30211":72121,"_20923":122403,"_5":14374,"_27449":122314,"_2949":122404},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3465":72157,"_30211":72121,"_20923":122406,"_5":14374,"_27449":122314,"_2949":122407},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3465":72158,"_30211":72121,"_20923":122409,"_5":14374,"_27449":122314,"_2949":122410},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3465":72159,"_30211":72121,"_20923":122412,"_5":14374,"_27449":122314,"_2949":122413},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3465":72160,"_30211":72121,"_20923":122415,"_5":14374,"_27449":122314,"_2949":122416},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3465":72161,"_30211":72121,"_20923":122418,"_5":14374,"_27449":122314,"_2949":122419},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":72162,"_30211":72121,"_20923":122421,"_5":14374,"_27449":122314,"_2949":122422},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3465":72163,"_30211":72163,"_5":14726,"_2949":122424,"_30563":122425,"_20923":122426,"_27449":72163},"Certificados",[49273,117784,54753,121662],[],{"_3465":72164,"_30211":72163,"_20923":122428,"_5":14374,"_27449":72163,"_2949":122429},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3465":72165,"_30211":72163,"_5":30560,"_20923":122431,"_27449":122432,"_2949":122433},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3465":72166,"_30211":72163,"_5":30560,"_20923":122435,"_27449":122436,"_2949":122437},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3465":72167,"_30211":72163,"_5":30560,"_20923":122439,"_27449":122440,"_2949":122441},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3465":72168,"_30211":72163,"_5":30560,"_20923":122443,"_27449":122444,"_2949":122445},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3465":72169,"_30211":72163,"_5":30560,"_20923":122447,"_27449":122448,"_2949":122449},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3465":72170,"_30211":72163,"_5":30560,"_20923":122451,"_27449":122452,"_2949":122453},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3465":72171,"_30211":72163,"_5":30560,"_20923":122455,"_27449":122456,"_2949":122457},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3465":72172,"_30211":72163,"_5":30560,"_20923":122459,"_27449":122460,"_2949":122461},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3465":72173,"_30211":72163,"_5":30560,"_20923":122463,"_27449":122464,"_2949":122465},[],"/docs/pr-preview/pr-67/es/platform/pki/certificates#continúa","Continúa",{"_3465":72174,"_30211":72163,"_20923":122467,"_5":14374,"_27449":72163,"_2949":122468},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3465":72175,"_30211":72163,"_20923":122470,"_5":14374,"_27449":122432,"_2949":122471},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3465":72176,"_30211":72163,"_20923":122473,"_5":14374,"_27449":122432,"_2949":122474},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3465":72177,"_30211":72163,"_20923":122476,"_5":14374,"_27449":122432,"_2949":122477},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3465":72178,"_30211":72163,"_20923":122479,"_5":14374,"_27449":122432,"_2949":122480},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3465":72179,"_30211":72163,"_20923":122482,"_5":14374,"_27449":122432,"_2949":122483},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3465":72180,"_30211":72163,"_20923":122485,"_5":14374,"_27449":122432,"_2949":122486},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3465":72181,"_30211":72163,"_20923":122488,"_5":14374,"_27449":122432,"_2949":122489},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3465":72182,"_30211":72163,"_20923":122491,"_5":14374,"_27449":122436,"_2949":122492},[],"Descarga el PEM e inspecciónalo:",{"_3465":72183,"_30211":72163,"_20923":122494,"_5":14374,"_27449":122436,"_2949":122495},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3465":72184,"_30211":72163,"_20923":122497,"_5":14374,"_27449":122440,"_2949":122498},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3465":72185,"_30211":72163,"_20923":122500,"_5":14374,"_27449":122440,"_2949":122501},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3465":72186,"_30211":72163,"_20923":122503,"_5":14374,"_27449":122440,"_2949":122504},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3465":72187,"_30211":72163,"_20923":122506,"_5":14374,"_27449":122440,"_2949":122507},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3465":72188,"_30211":72163,"_20923":122509,"_5":14374,"_27449":122440,"_2949":122510},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3465":72189,"_30211":72163,"_20923":122512,"_5":14374,"_27449":122440,"_2949":122513},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3465":72190,"_30211":72163,"_20923":122515,"_5":14374,"_27449":122440,"_2949":122516},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3465":72191,"_30211":72163,"_20923":122518,"_5":14374,"_27449":122444,"_2949":122519},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3465":72192,"_30211":72163,"_20923":122521,"_5":14374,"_27449":122448,"_2949":122522},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3465":72193,"_30211":72163,"_20923":122524,"_5":14374,"_27449":122452,"_2949":122525},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3465":72194,"_30211":72163,"_20923":122527,"_5":14374,"_27449":122456,"_2949":122528},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3465":72195,"_30211":72163,"_20923":122530,"_5":14374,"_27449":122456,"_2949":122531},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3465":72196,"_30211":72163,"_20923":122533,"_5":14374,"_27449":122456,"_2949":122534},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3465":72197,"_30211":72163,"_20923":122536,"_5":14374,"_27449":122460,"_2949":122537},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3465":72198,"_30211":72163,"_20923":122539,"_5":14374,"_27449":122460,"_2949":122540},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3465":72199,"_30211":72163,"_20923":122542,"_5":14374,"_27449":122460,"_2949":122543},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3465":72200,"_30211":72163,"_20923":122545,"_5":14374,"_27449":122464,"_2949":122546},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":72201,"_30211":72163,"_20923":122548,"_5":14374,"_27449":122464,"_2949":122549},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3465":72202,"_30211":72202,"_5":14726,"_2949":122551,"_30563":122552,"_20923":122554,"_27449":72202},"Ciclo de vida de un certificado",[49273,117784,54753,122553],"Conceptos",[],{"_3465":72203,"_30211":72202,"_20923":122556,"_5":14374,"_27449":72202,"_2949":122557},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3465":72204,"_30211":72202,"_5":30560,"_20923":122559,"_27449":122560,"_2949":122561},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3465":72205,"_30211":72202,"_5":30560,"_20923":122563,"_27449":122564,"_2949":122565},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3465":72206,"_30211":72202,"_5":30560,"_20923":122567,"_27449":122568,"_2949":122569},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3465":72207,"_30211":72202,"_5":30560,"_20923":122571,"_27449":122572,"_2949":122573},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3465":72208,"_30211":72202,"_5":30560,"_20923":122575,"_27449":122576,"_2949":122577},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3465":72209,"_30211":72202,"_5":30560,"_20923":122579,"_27449":122580,"_2949":122581},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3465":72210,"_30211":72202,"_5":30560,"_20923":122583,"_27449":122584,"_2949":120285},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3465":72211,"_30211":72202,"_5":30560,"_20923":122586,"_27449":122587,"_2949":122588},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3465":72212,"_30211":72202,"_5":30560,"_20923":122590,"_27449":122591,"_2949":122592},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3465":72213,"_30211":72202,"_5":30560,"_20923":122594,"_27449":122595,"_2949":122596},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3465":72214,"_30211":72202,"_20923":122598,"_5":14374,"_27449":72202,"_2949":122599},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3465":72215,"_30211":72202,"_20923":122601,"_5":14374,"_27449":122564,"_2949":122602},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3465":72216,"_30211":72202,"_20923":122604,"_5":14374,"_27449":122568,"_2949":122605},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3465":72217,"_30211":72202,"_20923":122607,"_5":14374,"_27449":122572,"_2949":122608},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3465":72218,"_30211":72202,"_20923":122610,"_5":14374,"_27449":122576,"_2949":122611},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3465":72219,"_30211":72202,"_20923":122613,"_5":14374,"_27449":122580,"_2949":122614},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3465":72220,"_30211":72202,"_20923":122616,"_5":14374,"_27449":122584,"_2949":122617},[],"Lamassu persiste cuatro estados X.509:",{"_3465":72221,"_30211":72202,"_20923":122619,"_5":14374,"_27449":122584,"_2949":122620},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3465":72222,"_30211":72202,"_20923":122622,"_5":14374,"_27449":122584,"_2949":122623},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3465":72223,"_30211":72202,"_20923":122625,"_5":14374,"_27449":122584,"_2949":122626},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3465":72224,"_30211":72202,"_20923":122628,"_5":14374,"_27449":122584,"_2949":122629},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3465":72225,"_30211":72202,"_20923":122631,"_5":14374,"_27449":122584,"_2949":122632},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3465":72226,"_30211":72202,"_20923":122634,"_5":14374,"_27449":122587,"_2949":122635},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3465":72227,"_30211":72202,"_20923":122637,"_5":14374,"_27449":122587,"_2949":122638},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3465":72228,"_30211":72202,"_20923":122640,"_5":14374,"_27449":122587,"_2949":122641},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3465":72229,"_30211":72202,"_20923":122643,"_5":14374,"_27449":122591,"_2949":122644},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3465":72230,"_30211":72202,"_20923":122646,"_5":14374,"_27449":122591,"_2949":122647},[],"Antes de confirmar:",{"_3465":72231,"_30211":72202,"_20923":122649,"_5":14374,"_27449":122591,"_2949":122650},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3465":72232,"_30211":72202,"_20923":122652,"_5":14374,"_27449":122591,"_2949":122653},[],"Distribuye la nueva cadena de confianza.",{"_3465":72233,"_30211":72202,"_20923":122655,"_5":14374,"_27449":122591,"_2949":122656},[],"Reemite las identidades necesarias.",{"_3465":72234,"_30211":72202,"_20923":122658,"_5":14374,"_27449":122591,"_2949":122659},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3465":72235,"_30211":72202,"_20923":122661,"_5":14374,"_27449":122591,"_2949":122662},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3465":72236,"_30211":72202,"_20923":122664,"_5":14374,"_27449":122591,"_2949":122665},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3465":72237,"_30211":72202,"_20923":122667,"_5":14374,"_27449":122595,"_2949":122668},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3465":72238,"_30211":72202,"_20923":122670,"_5":14374,"_27449":122595,"_2949":122671},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3465":72239,"_30211":72202,"_20923":122673,"_5":14374,"_27449":122595,"_2949":122674},[],"Cambios de estado y razones de revocación.",{"_3465":72240,"_30211":72202,"_20923":122676,"_5":14374,"_27449":122595,"_2949":122677},[],"Publicación y vigencia de OCSP y CRLs.",{"_3465":72241,"_30211":72202,"_20923":122679,"_5":14374,"_27449":122595,"_2949":122680},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3465":72242,"_30211":72202,"_20923":122682,"_5":14374,"_27449":122595,"_2949":122683},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3465":72243,"_30211":72243,"_5":14726,"_2949":122685,"_30563":122686,"_20923":122687,"_27449":72243},"Modelo de confianza",[49273,117784,54753,122553],[],{"_3465":72244,"_30211":72243,"_20923":122689,"_5":14374,"_27449":72243,"_2949":122690},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3465":72245,"_30211":72243,"_5":30560,"_20923":122692,"_27449":122693,"_2949":122694},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3465":72246,"_30211":72243,"_5":30560,"_20923":122696,"_27449":122697,"_2949":122698},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3465":72247,"_30211":72243,"_5":30560,"_20923":122700,"_27449":122701,"_2949":122702},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3465":72248,"_30211":72243,"_5":30560,"_20923":122704,"_27449":122705,"_2949":122706},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3465":72249,"_30211":72243,"_5":30560,"_20923":122708,"_27449":122709,"_2949":122710},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3465":72250,"_30211":72243,"_5":30560,"_20923":122712,"_27449":122713,"_2949":122714},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3465":72251,"_30211":72243,"_5":30560,"_20923":122716,"_27449":122717,"_2949":122718},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3465":72252,"_30211":72243,"_5":30560,"_20923":122720,"_27449":122721,"_2949":122722},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3465":72253,"_30211":72243,"_5":30560,"_20923":122724,"_27449":122725,"_2949":122726},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3465":72254,"_30211":72243,"_5":30560,"_20923":122728,"_27449":122729,"_2949":122730},[],"/docs/pr-preview/pr-67/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3465":72255,"_30211":72243,"_20923":122732,"_5":14374,"_27449":72243,"_2949":122733},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3465":72256,"_30211":72243,"_20923":122735,"_5":14374,"_27449":122697,"_2949":122736},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3465":72257,"_30211":72243,"_20923":122738,"_5":14374,"_27449":122701,"_2949":122739},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3465":72258,"_30211":72243,"_20923":122741,"_5":14374,"_27449":122705,"_2949":122742},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3465":72259,"_30211":72243,"_20923":122744,"_5":14374,"_27449":122709,"_2949":122745},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3465":72260,"_30211":72243,"_20923":122747,"_5":14374,"_27449":122713,"_2949":122748},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3465":72261,"_30211":72243,"_20923":122750,"_5":14374,"_27449":122713,"_2949":122751},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3465":72262,"_30211":72243,"_20923":122753,"_5":14374,"_27449":122713,"_2949":122754},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3465":72263,"_30211":72243,"_20923":122756,"_5":14374,"_27449":122713,"_2949":122757},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3465":72264,"_30211":72243,"_20923":122759,"_5":14374,"_27449":122713,"_2949":122760},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3465":72265,"_30211":72243,"_20923":122762,"_5":14374,"_27449":122713,"_2949":122763},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3465":72266,"_30211":72243,"_20923":122765,"_5":14374,"_27449":122717,"_2949":122766},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3465":72267,"_30211":72243,"_20923":122768,"_5":14374,"_27449":122717,"_2949":122769},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3465":72268,"_30211":72243,"_20923":122771,"_5":14374,"_27449":122717,"_2949":122772},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3465":72269,"_30211":72243,"_20923":122774,"_5":14374,"_27449":122717,"_2949":122775},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3465":72270,"_30211":72243,"_20923":122777,"_5":14374,"_27449":122717,"_2949":122778},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3465":72271,"_30211":72243,"_20923":122780,"_5":14374,"_27449":122721,"_2949":122781},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3465":72272,"_30211":72243,"_20923":122783,"_5":14374,"_27449":122721,"_2949":122784},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3465":72273,"_30211":72243,"_20923":122786,"_5":14374,"_27449":122721,"_2949":122787},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3465":72274,"_30211":72243,"_20923":122789,"_5":14374,"_27449":122721,"_2949":122790},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3465":72275,"_30211":72243,"_20923":122792,"_5":14374,"_27449":122721,"_2949":122793},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3465":72276,"_30211":72243,"_20923":122795,"_5":14374,"_27449":122721,"_2949":122796},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3465":72277,"_30211":72243,"_20923":122798,"_5":14374,"_27449":122721,"_2949":122799},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3465":72278,"_30211":72243,"_20923":122801,"_5":14374,"_27449":122725,"_2949":122802},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3465":72279,"_30211":72243,"_20923":122804,"_5":14374,"_27449":122729,"_2949":122805},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3465":72280,"_30211":72243,"_20923":122807,"_5":14374,"_27449":122729,"_2949":122808},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3465":72281,"_30211":72243,"_20923":122810,"_5":14374,"_27449":122729,"_2949":122811},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3465":72282,"_30211":72243,"_20923":122813,"_5":14374,"_27449":122729,"_2949":122814},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3465":72283,"_30211":72243,"_20923":122816,"_5":14374,"_27449":122729,"_2949":122817},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3465":72284,"_30211":72243,"_20923":122819,"_5":14374,"_27449":122729,"_2949":122820},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3465":72285,"_30211":72243,"_20923":122822,"_5":14374,"_27449":122729,"_2949":122823},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3465":72286,"_30211":72286,"_5":14726,"_2949":122825,"_30563":122826,"_20923":122827,"_27449":72286},"Listas de revocación (CRL)",[49273,117784,54753,122299],[],{"_3465":72287,"_30211":72286,"_20923":122829,"_5":14374,"_27449":72286,"_2949":122830},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3465":72288,"_30211":72286,"_5":30560,"_20923":122832,"_27449":122833,"_2949":122834},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3465":72289,"_30211":72286,"_5":30560,"_20923":122836,"_27449":122837,"_2949":122838},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3465":72290,"_30211":72286,"_5":30560,"_20923":122840,"_27449":122841,"_2949":122842},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3465":72291,"_30211":72286,"_5":30560,"_20923":122844,"_27449":122845,"_2949":122846},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3465":72292,"_30211":72286,"_5":30560,"_20923":122848,"_27449":122849,"_2949":122850},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3465":72293,"_30211":72286,"_5":30560,"_20923":122852,"_27449":122853,"_2949":122854},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3465":72294,"_30211":72286,"_5":30560,"_20923":122856,"_27449":122857,"_2949":122858},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3465":72295,"_30211":72286,"_5":30560,"_20923":122860,"_27449":122861,"_2949":122862},[],"/docs/pr-preview/pr-67/es/platform/pki/crl#referencias","Referencias",{"_3465":72296,"_30211":72286,"_20923":122864,"_5":14374,"_27449":72286,"_2949":122865},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3465":72297,"_30211":72286,"_20923":122867,"_5":14374,"_27449":122833,"_2949":122868},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3465":72298,"_30211":72286,"_20923":122870,"_5":14374,"_27449":122833,"_2949":122871},[],"Campo",{"_3465":72299,"_30211":72286,"_20923":122873,"_5":14374,"_27449":122833,"_2949":119325},[],{"_3465":72300,"_30211":72286,"_20923":122875,"_5":14374,"_27449":122833,"_2949":55971},[],{"_3465":72301,"_30211":72286,"_20923":122877,"_5":14374,"_27449":122833,"_2949":122878},[],"ID de la CA a la que pertenecen los ajustes.",{"_3465":72302,"_30211":72286,"_20923":122880,"_5":14374,"_27449":122833,"_2949":55977},[],{"_3465":72303,"_30211":72286,"_20923":122882,"_5":14374,"_27449":122833,"_2949":122883},[],"Los ajustes `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA que fue revocada o ha expirado: su última CRL, si la hay, se publica y no se genera ninguna nueva. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3465":72304,"_30211":72286,"_20923":122885,"_5":14374,"_27449":122833,"_2949":55983},[],{"_3465":72305,"_30211":72286,"_20923":122887,"_5":14374,"_27449":122833,"_2949":122888},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3465":72306,"_30211":72286,"_20923":122890,"_5":14374,"_27449":122833,"_2949":55989},[],{"_3465":72307,"_30211":72286,"_20923":122892,"_5":14374,"_27449":122833,"_2949":122893},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3465":72308,"_30211":72286,"_20923":122895,"_5":14374,"_27449":122833,"_2949":122896},[],"Campo de `crl_options`",{"_3465":72309,"_30211":72286,"_20923":122898,"_5":14374,"_27449":122833,"_2949":119325},[],{"_3465":72310,"_30211":72286,"_20923":122900,"_5":14374,"_27449":122833,"_2949":122901},[],"Valor inicial",{"_3465":72311,"_30211":72286,"_20923":122903,"_5":14374,"_27449":122833,"_2949":56003},[],{"_3465":72312,"_30211":72286,"_20923":122905,"_5":14374,"_27449":122833,"_2949":122906},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3465":72313,"_30211":72286,"_20923":122908,"_5":14374,"_27449":122833,"_2949":122909},[],"7 días.",{"_3465":72314,"_30211":72286,"_20923":122911,"_5":14374,"_27449":122833,"_2949":56012},[],{"_3465":72315,"_30211":72286,"_20923":122913,"_5":14374,"_27449":122833,"_2949":122914},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3465":72316,"_30211":72286,"_20923":122916,"_5":14374,"_27449":122833,"_2949":122917},[],"6 días y 23 horas.",{"_3465":72317,"_30211":72286,"_20923":122919,"_5":14374,"_27449":122833,"_2949":56021},[],{"_3465":72318,"_30211":72286,"_20923":122921,"_5":14374,"_27449":122833,"_2949":122922},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3465":72319,"_30211":72286,"_20923":122924,"_5":14374,"_27449":122833,"_2949":56027},[],{"_3465":72320,"_30211":72286,"_20923":122926,"_5":14374,"_27449":122833,"_2949":56030},[],{"_3465":72321,"_30211":72286,"_20923":122928,"_5":14374,"_27449":122833,"_2949":122929},[],"Número de serie del certificado existente que firma la CRL.",{"_3465":72322,"_30211":72286,"_20923":122931,"_5":14374,"_27449":122833,"_2949":122932},[],"Número de serie del certificado actual de la CA.",{"_3465":72323,"_30211":72286,"_20923":122934,"_5":14374,"_27449":122833,"_2949":122935},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3465":72324,"_30211":72286,"_20923":122937,"_5":14374,"_27449":122833,"_2949":122938},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3465":72325,"_30211":72286,"_20923":122940,"_5":14374,"_27449":122833,"_2949":122941},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3465":72326,"_30211":72286,"_20923":122943,"_5":14374,"_27449":122833,"_2949":122944},[],"Los ajustes cuyo `status` es `FINAL` o `ARCHIVED` son de solo lectura: cualquier `PUT` devuelve 409. Eliminar una CA conserva sus ajustes de CRL:",{"_3465":72327,"_30211":72286,"_20923":122946,"_5":14374,"_27449":122833,"_2949":122947},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera.",{"_3465":72328,"_30211":72286,"_20923":122949,"_5":14374,"_27449":122833,"_2949":122950},[],"Los ajustes `ARCHIVED` de una CA eliminada pueden borrarse, con `DELETE` o desde la página Verification Authorities de la consola. Esa CRL deja de servirse — quien compruebe sus certificados contra ella dejará de encontrarla —, mientras que las CRLs ya publicadas permanecen en el bucket. La acción no puede deshacerse.",{"_3465":72329,"_30211":72286,"_20923":122952,"_5":14374,"_27449":122833,"_2949":122953},[],"Ajusta validez y firmante antes de eliminar una CA.",{"_3465":72330,"_30211":72286,"_20923":122955,"_5":14374,"_27449":122833,"_2949":122956},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3465":72331,"_30211":72286,"_20923":122958,"_5":14374,"_27449":122833,"_2949":122959},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3465":72332,"_30211":72286,"_20923":122961,"_5":14374,"_27449":122833,"_2949":122962},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3465":72333,"_30211":72286,"_20923":122964,"_5":14374,"_27449":122837,"_2949":122965},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3465":72334,"_30211":72286,"_20923":122967,"_5":14374,"_27449":122837,"_2949":122968},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3465":72335,"_30211":72286,"_20923":122970,"_5":14374,"_27449":122837,"_2949":122971},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3465":72336,"_30211":72286,"_20923":122973,"_5":14374,"_27449":122837,"_2949":122974},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3465":72337,"_30211":72286,"_20923":122976,"_5":14374,"_27449":122841,"_2949":122977},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3465":72338,"_30211":72286,"_20923":122979,"_5":14374,"_27449":122841,"_2949":122980},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3465":72339,"_30211":72286,"_20923":122982,"_5":14374,"_27449":122841,"_2949":122983},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3465":72340,"_30211":72286,"_20923":122985,"_5":14374,"_27449":122841,"_2949":122986},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3465":72341,"_30211":72286,"_20923":122988,"_5":14374,"_27449":122841,"_2949":122989},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3465":72342,"_30211":72286,"_20923":122991,"_5":14374,"_27449":122841,"_2949":122992},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3465":72343,"_30211":72286,"_20923":122994,"_5":14374,"_27449":122841,"_2949":122995},[],"Los ajustes con `status` `FINAL` o `ARCHIVED` se omiten: nada regenera su CRL.",{"_3465":72344,"_30211":72286,"_20923":122997,"_5":14374,"_27449":122841,"_2949":122998},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3465":72345,"_30211":72286,"_20923":123000,"_5":14374,"_27449":122841,"_2949":123001},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3465":72346,"_30211":72286,"_20923":123003,"_5":14374,"_27449":122845,"_2949":123004},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3465":72347,"_30211":72286,"_20923":123006,"_5":14374,"_27449":122845,"_2949":123007},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3465":72348,"_30211":72286,"_20923":123009,"_5":14374,"_27449":122849,"_2949":123010},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3465":72349,"_30211":72286,"_20923":123012,"_5":14374,"_27449":122849,"_2949":123013},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3465":72350,"_30211":72286,"_20923":123015,"_5":14374,"_27449":122849,"_2949":123016},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3465":72351,"_30211":72286,"_20923":123018,"_5":14374,"_27449":122849,"_2949":123019},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3465":72352,"_30211":72286,"_20923":123021,"_5":14374,"_27449":122849,"_2949":123022},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3465":72353,"_30211":72286,"_20923":123024,"_5":14374,"_27449":122853,"_2949":123025},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3465":72354,"_30211":72286,"_20923":123027,"_5":14374,"_27449":122853,"_2949":119514},[],{"_3465":72355,"_30211":72286,"_20923":123029,"_5":14374,"_27449":122853,"_2949":123030},[],"Path relativo",{"_3465":72356,"_30211":72286,"_20923":123032,"_5":14374,"_27449":122853,"_2949":117544},[],{"_3465":72357,"_30211":72286,"_20923":123034,"_5":14374,"_27449":122853,"_2949":56139},[],{"_3465":72358,"_30211":72286,"_20923":123036,"_5":14374,"_27449":122853,"_2949":56142},[],{"_3465":72359,"_30211":72286,"_20923":123038,"_5":14374,"_27449":122853,"_2949":123039},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3465":72360,"_30211":72286,"_20923":123041,"_5":14374,"_27449":122853,"_2949":56139},[],{"_3465":72361,"_30211":72286,"_20923":123043,"_5":14374,"_27449":122853,"_2949":56150},[],{"_3465":72362,"_30211":72286,"_20923":123045,"_5":14374,"_27449":122853,"_2949":123046},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3465":72363,"_30211":72286,"_20923":123048,"_5":14374,"_27449":122853,"_2949":56156},[],{"_3465":72364,"_30211":72286,"_20923":123050,"_5":14374,"_27449":122853,"_2949":56150},[],{"_3465":72365,"_30211":72286,"_20923":123052,"_5":14374,"_27449":122853,"_2949":123053},[],"Sustituir la configuración de CRL de una CA.",{"_3465":72366,"_30211":72286,"_20923":123055,"_5":14374,"_27449":122853,"_2949":56164},[],{"_3465":72367,"_30211":72286,"_20923":123057,"_5":14374,"_27449":122853,"_2949":56150},[],{"_3465":72368,"_30211":72286,"_20923":123059,"_5":14374,"_27449":122853,"_2949":123060},[],"Borrar los ajustes de una CA cuyos ajustes están `ARCHIVED`; sus CRLs publicadas permanecen en el bucket pero dejan de servirse.",{"_3465":72369,"_30211":72286,"_20923":123062,"_5":14374,"_27449":122853,"_2949":123063},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL. Un `DELETE` devuelve 409 salvo que los ajustes estén `ARCHIVED`.",{"_3465":72370,"_30211":72286,"_20923":123065,"_5":14374,"_27449":122853,"_2949":123066},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3465":72371,"_30211":72286,"_20923":123068,"_5":14374,"_27449":122857,"_2949":123069},[],"Síntoma",{"_3465":72372,"_30211":72286,"_20923":123071,"_5":14374,"_27449":122857,"_2949":123072},[],"Causa",{"_3465":72373,"_30211":72286,"_20923":123074,"_5":14374,"_27449":122857,"_2949":123075},[],"Acción",{"_3465":72374,"_30211":72286,"_20923":123077,"_5":14374,"_27449":122857,"_2949":123078},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3465":72375,"_30211":72286,"_20923":123080,"_5":14374,"_27449":122857,"_2949":123081},[],"Los ajustes no están `ACTIVE`: son `FINAL` o `ARCHIVED` (consulta la tabla del campo `status` en Ajustes de CRL).",{"_3465":72376,"_30211":72286,"_20923":123083,"_5":14374,"_27449":122857,"_2949":123084},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3465":72377,"_30211":72286,"_20923":123086,"_5":14374,"_27449":122857,"_2949":123087},[],"`PUT` devuelve 400.",{"_3465":72378,"_30211":72286,"_20923":123089,"_5":14374,"_27449":122857,"_2949":123090},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3465":72379,"_30211":72286,"_20923":123092,"_5":14374,"_27449":122857,"_2949":123093},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3465":72380,"_30211":72286,"_20923":123095,"_5":14374,"_27449":122857,"_2949":123096},[],"`PUT` devuelve 404.",{"_3465":72381,"_30211":72286,"_20923":123098,"_5":14374,"_27449":122857,"_2949":123099},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3465":72382,"_30211":72286,"_20923":123101,"_5":14374,"_27449":122857,"_2949":123102},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3465":72383,"_30211":72286,"_20923":123104,"_5":14374,"_27449":122857,"_2949":123105},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3465":72384,"_30211":72286,"_20923":123107,"_5":14374,"_27449":122857,"_2949":123108},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3465":72385,"_30211":72286,"_20923":123110,"_5":14374,"_27449":122857,"_2949":123111},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3465":72386,"_30211":72286,"_20923":123113,"_5":14374,"_27449":122857,"_2949":123114},[],"La CRL no cambia tras revocar un certificado.",{"_3465":72387,"_30211":72286,"_20923":123116,"_5":14374,"_27449":122857,"_2949":123117},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3465":72388,"_30211":72286,"_20923":123119,"_5":14374,"_27449":122857,"_2949":123120},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3465":72389,"_30211":72286,"_20923":123122,"_5":14374,"_27449":122857,"_2949":123123},[],"Un verificador rechaza la CRL por el emisor.",{"_3465":72390,"_30211":72286,"_20923":123125,"_5":14374,"_27449":122857,"_2949":123126},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3465":72391,"_30211":72286,"_20923":123128,"_5":14374,"_27449":122857,"_2949":123129},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3465":72392,"_30211":72286,"_20923":123131,"_5":14374,"_27449":122861,"_2949":123132},[],"RFC 5280: perfil X.509 y CRL.",{"_3465":72393,"_30211":72286,"_20923":123134,"_5":14374,"_27449":122861,"_2949":56244},[],{"_3465":72394,"_30211":72286,"_20923":123136,"_5":14374,"_27449":122861,"_2949":56247},[],{"_3465":72395,"_30211":72286,"_20923":123138,"_5":14374,"_27449":122861,"_2949":123139},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3465":72396,"_30211":72286,"_20923":123141,"_5":14374,"_27449":122861,"_2949":123142},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3465":72397,"_30211":72397,"_5":14726,"_2949":123144,"_30563":123145,"_20923":123146,"_27449":72397},"Claves y motores criptográficos",[49273,117784,54753,121662],[],{"_3465":72398,"_30211":72397,"_20923":123148,"_5":14374,"_27449":72397,"_2949":123149},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3465":72399,"_30211":72397,"_5":30560,"_20923":123151,"_27449":123152,"_2949":123153},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3465":72400,"_30211":72397,"_5":30560,"_20923":123155,"_27449":123156,"_2949":123157},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3465":72401,"_30211":72397,"_5":30560,"_20923":123159,"_27449":123160,"_2949":56272},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#file-system",{"_3465":72402,"_30211":72397,"_5":30560,"_20923":123162,"_27449":123163,"_2949":56276},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#hashicorp-vault",{"_3465":72403,"_30211":72397,"_5":30560,"_20923":123165,"_27449":123166,"_2949":56280},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#aws-secrets-manager",{"_3465":72404,"_30211":72397,"_5":30560,"_20923":123168,"_27449":123169,"_2949":56284},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#aws-kms",{"_3465":72405,"_30211":72397,"_5":30560,"_20923":123171,"_27449":123172,"_2949":56288},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#pkcs11",{"_3465":72406,"_30211":72397,"_5":30560,"_20923":123174,"_27449":123175,"_2949":56292},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#azure-key-vault",{"_3465":72407,"_30211":72397,"_5":30560,"_20923":123177,"_27449":123178,"_2949":123179},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3465":72408,"_30211":72397,"_5":30560,"_20923":123181,"_27449":123182,"_2949":123183},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3465":72409,"_30211":72397,"_5":30560,"_20923":123185,"_27449":123186,"_2949":123187},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3465":72410,"_30211":72397,"_5":30560,"_20923":123189,"_27449":123190,"_2949":123191},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3465":72411,"_30211":72397,"_5":30560,"_20923":123193,"_27449":123194,"_2949":123195},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3465":72412,"_30211":72397,"_5":30560,"_20923":123197,"_27449":123198,"_2949":123199},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3465":72413,"_30211":72397,"_5":30560,"_20923":123201,"_27449":123202,"_2949":123203},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3465":72414,"_30211":72397,"_5":30560,"_20923":123205,"_27449":123206,"_2949":56324},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#sign",{"_3465":72415,"_30211":72397,"_5":30560,"_20923":123208,"_27449":123209,"_2949":56328},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#verify",{"_3465":72416,"_30211":72397,"_5":30560,"_20923":123211,"_27449":123212,"_2949":123213},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3465":72417,"_30211":72397,"_5":30560,"_20923":123215,"_27449":123216,"_2949":123217},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3465":72418,"_30211":72397,"_5":30560,"_20923":123219,"_27449":123220,"_2949":123221},[],"/docs/pr-preview/pr-67/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3465":72419,"_30211":72397,"_20923":123223,"_5":14374,"_27449":72397,"_2949":123224},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3465":72420,"_30211":72397,"_20923":123226,"_5":14374,"_27449":72397,"_2949":123227},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3465":72421,"_30211":72397,"_20923":123229,"_5":14374,"_27449":123152,"_2949":123230},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3465":72422,"_30211":72397,"_20923":123232,"_5":14374,"_27449":123152,"_2949":123233},[],"En la práctica, permite:",{"_3465":72423,"_30211":72397,"_20923":123235,"_5":14374,"_27449":123152,"_2949":123236},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3465":72424,"_30211":72397,"_20923":123238,"_5":14374,"_27449":123152,"_2949":123239},[],"Importar claves creadas externamente.",{"_3465":72425,"_30211":72397,"_20923":123241,"_5":14374,"_27449":123152,"_2949":123242},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3465":72426,"_30211":72397,"_20923":123244,"_5":14374,"_27449":123152,"_2949":123245},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3465":72427,"_30211":72397,"_20923":123247,"_5":14374,"_27449":123156,"_2949":123248},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3465":72428,"_30211":72397,"_20923":123250,"_5":14374,"_27449":123156,"_2949":123251},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3465":72429,"_30211":72397,"_20923":123253,"_5":14374,"_27449":123156,"_2949":123254},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3465":72430,"_30211":72397,"_20923":123256,"_5":14374,"_27449":123160,"_2949":123257},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3465":72431,"_30211":72397,"_20923":123259,"_5":14374,"_27449":123163,"_2949":123260},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3465":72432,"_30211":72397,"_20923":123262,"_5":14374,"_27449":123163,"_2949":123263},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3465":72433,"_30211":72397,"_20923":123265,"_5":14374,"_27449":123166,"_2949":123266},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3465":72434,"_30211":72397,"_20923":123268,"_5":14374,"_27449":123169,"_2949":123269},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3465":72435,"_30211":72397,"_20923":123271,"_5":14374,"_27449":123172,"_2949":123272},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3465":72436,"_30211":72397,"_20923":123274,"_5":14374,"_27449":123175,"_2949":123275},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3465":72437,"_30211":72397,"_20923":123277,"_5":14374,"_27449":123175,"_2949":123278},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3465":72438,"_30211":72397,"_20923":123280,"_5":14374,"_27449":123175,"_2949":123281},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3465":72439,"_30211":72397,"_20923":123283,"_5":14374,"_27449":123175,"_2949":123284},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3465":72440,"_30211":72397,"_20923":123286,"_5":14374,"_27449":123178,"_2949":123287},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3465":72441,"_30211":72397,"_20923":123289,"_5":14374,"_27449":123178,"_2949":123290},[],"La tabla incluye los siguientes campos:",{"_3465":72442,"_30211":72397,"_20923":123292,"_5":14374,"_27449":123178,"_2949":123293},[],"**Name**: nombre descriptivo de la clave.",{"_3465":72443,"_30211":72397,"_20923":123295,"_5":14374,"_27449":123178,"_2949":123296},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3465":72444,"_30211":72397,"_20923":123298,"_5":14374,"_27449":123178,"_2949":123299},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3465":72445,"_30211":72397,"_20923":123301,"_5":14374,"_27449":123178,"_2949":123302},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3465":72446,"_30211":72397,"_20923":123304,"_5":14374,"_27449":123178,"_2949":123305},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3465":72447,"_30211":72397,"_20923":123307,"_5":14374,"_27449":123178,"_2949":123308},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3465":72448,"_30211":72397,"_20923":123310,"_5":14374,"_27449":123178,"_2949":123311},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3465":72449,"_30211":72397,"_20923":123313,"_5":14374,"_27449":123178,"_2949":123314},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3465":72450,"_30211":72397,"_20923":123316,"_5":14374,"_27449":123178,"_2949":123317},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3465":72451,"_30211":72397,"_20923":123319,"_5":14374,"_27449":123178,"_2949":123320},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3465":72452,"_30211":72397,"_20923":123322,"_5":14374,"_27449":123178,"_2949":123323},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3465":72453,"_30211":72397,"_20923":123325,"_5":14374,"_27449":123178,"_2949":123326},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3465":72454,"_30211":72397,"_20923":123328,"_5":14374,"_27449":123178,"_2949":123329},[],"**Delete Key** para eliminar la clave del sistema.",{"_3465":72455,"_30211":72397,"_20923":123331,"_5":14374,"_27449":123182,"_2949":123332},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3465":72456,"_30211":72397,"_20923":123334,"_5":14374,"_27449":123186,"_2949":123335},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3465":72457,"_30211":72397,"_20923":123337,"_5":14374,"_27449":123186,"_2949":123338},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3465":72458,"_30211":72397,"_20923":123340,"_5":14374,"_27449":123186,"_2949":123341},[],"**Key Name**: nombre único y descriptivo.",{"_3465":72459,"_30211":72397,"_20923":123343,"_5":14374,"_27449":123186,"_2949":123344},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3465":72460,"_30211":72397,"_20923":123346,"_5":14374,"_27449":123186,"_2949":123347},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3465":72461,"_30211":72397,"_20923":123349,"_5":14374,"_27449":123186,"_2949":123350},[],"**Tags**: metadatos para clasificar la clave.",{"_3465":72462,"_30211":72397,"_20923":123352,"_5":14374,"_27449":123186,"_2949":123353},[],"**Metadata**: información adicional para usos avanzados.",{"_3465":72463,"_30211":72397,"_20923":123355,"_5":14374,"_27449":123190,"_2949":123356},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3465":72464,"_30211":72397,"_20923":123358,"_5":14374,"_27449":123190,"_2949":123359},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3465":72465,"_30211":72397,"_20923":123361,"_5":14374,"_27449":123190,"_2949":123362},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3465":72466,"_30211":72397,"_20923":123364,"_5":14374,"_27449":123190,"_2949":123365},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3465":72467,"_30211":72397,"_20923":123367,"_5":14374,"_27449":123190,"_2949":123368},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3465":72468,"_30211":72397,"_20923":123370,"_5":14374,"_27449":123190,"_2949":123371},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3465":72469,"_30211":72397,"_20923":123373,"_5":14374,"_27449":123190,"_2949":123374},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3465":72470,"_30211":72397,"_20923":123376,"_5":14374,"_27449":123190,"_2949":123377},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3465":72471,"_30211":72397,"_20923":123379,"_5":14374,"_27449":123190,"_2949":123380},[],"**Metadata**: información adicional opcional.",{"_3465":72472,"_30211":72397,"_20923":123382,"_5":14374,"_27449":123190,"_2949":123383},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3465":72473,"_30211":72397,"_20923":123385,"_5":14374,"_27449":123190,"_2949":123386},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3465":72474,"_30211":72397,"_20923":123388,"_5":14374,"_27449":123194,"_2949":123389},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3465":72475,"_30211":72397,"_20923":123391,"_5":14374,"_27449":123198,"_2949":123392},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3465":72476,"_30211":72397,"_20923":123394,"_5":14374,"_27449":123198,"_2949":123395},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3465":72477,"_30211":72397,"_20923":123397,"_5":14374,"_27449":123198,"_2949":123398},[],"**Key Name**: nombre descriptivo.",{"_3465":72478,"_30211":72397,"_20923":123400,"_5":14374,"_27449":123198,"_2949":123401},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3465":72479,"_30211":72397,"_20923":123403,"_5":14374,"_27449":123198,"_2949":123404},[],"**Tags**: etiquetas asociadas.",{"_3465":72480,"_30211":72397,"_20923":123406,"_5":14374,"_27449":123198,"_2949":123407},[],"**Aliases**: nombres alternativos.",{"_3465":72481,"_30211":72397,"_20923":123409,"_5":14374,"_27449":123198,"_2949":123410},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3465":72482,"_30211":72397,"_20923":123412,"_5":14374,"_27449":123198,"_2949":123413},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3465":72483,"_30211":72397,"_20923":123415,"_5":14374,"_27449":123198,"_2949":123416},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3465":72484,"_30211":72397,"_20923":123418,"_5":14374,"_27449":123198,"_2949":123419},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3465":72485,"_30211":72397,"_20923":123421,"_5":14374,"_27449":123202,"_2949":123422},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3465":72486,"_30211":72397,"_20923":123424,"_5":14374,"_27449":123202,"_2949":123425},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3465":72487,"_30211":72397,"_20923":123427,"_5":14374,"_27449":123202,"_2949":123428},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3465":72488,"_30211":72397,"_20923":123430,"_5":14374,"_27449":123206,"_2949":123431},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3465":72489,"_30211":72397,"_20923":123433,"_5":14374,"_27449":123206,"_2949":123434},[],"Campos principales:",{"_3465":72490,"_30211":72397,"_20923":123436,"_5":14374,"_27449":123206,"_2949":123437},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3465":72491,"_30211":72397,"_20923":123439,"_5":14374,"_27449":123206,"_2949":123440},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3465":72492,"_30211":72397,"_20923":123442,"_5":14374,"_27449":123206,"_2949":123443},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3465":72493,"_30211":72397,"_20923":123445,"_5":14374,"_27449":123206,"_2949":123446},[],"**Message**: contenido que se va a firmar.",{"_3465":72494,"_30211":72397,"_20923":123448,"_5":14374,"_27449":123206,"_2949":123449},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3465":72495,"_30211":72397,"_20923":123451,"_5":14374,"_27449":123209,"_2949":123452},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3465":72496,"_30211":72397,"_20923":123454,"_5":14374,"_27449":123209,"_2949":123434},[],{"_3465":72497,"_30211":72397,"_20923":123456,"_5":14374,"_27449":123209,"_2949":123457},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3465":72498,"_30211":72397,"_20923":123459,"_5":14374,"_27449":123209,"_2949":123460},[],"**Message Type**: `Raw` o `Digest`.",{"_3465":72499,"_30211":72397,"_20923":123462,"_5":14374,"_27449":123209,"_2949":123463},[],"**Payload Encoding**: codificación del mensaje.",{"_3465":72500,"_30211":72397,"_20923":123465,"_5":14374,"_27449":123209,"_2949":123466},[],"**Message**: mensaje original o hash.",{"_3465":72501,"_30211":72397,"_20923":123468,"_5":14374,"_27449":123209,"_2949":123469},[],"**Signature**: firma que se desea comprobar.",{"_3465":72502,"_30211":72397,"_20923":123471,"_5":14374,"_27449":123209,"_2949":123472},[],"**Result**: indicador del resultado de la validación.",{"_3465":72503,"_30211":72397,"_20923":123474,"_5":14374,"_27449":123212,"_2949":123475},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3465":72504,"_30211":72397,"_20923":123477,"_5":14374,"_27449":123212,"_2949":123478},[],"Este flujo es útil para:",{"_3465":72505,"_30211":72397,"_20923":123480,"_5":14374,"_27449":123212,"_2949":123481},[],"Solicitar certificados a una CA externa.",{"_3465":72506,"_30211":72397,"_20923":123483,"_5":14374,"_27449":123212,"_2949":123484},[],"Renovar una identidad manteniendo la misma clave.",{"_3465":72507,"_30211":72397,"_20923":123486,"_5":14374,"_27449":123212,"_2949":123487},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3465":72508,"_30211":72397,"_20923":123489,"_5":14374,"_27449":123212,"_2949":123490},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3465":72509,"_30211":72397,"_20923":123492,"_5":14374,"_27449":123212,"_2949":123493},[],"**Organization (O)**: organización o empresa.",{"_3465":72510,"_30211":72397,"_20923":123495,"_5":14374,"_27449":123212,"_2949":123496},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3465":72511,"_30211":72397,"_20923":123498,"_5":14374,"_27449":123212,"_2949":123499},[],"**Country (C)**: código de país de dos letras.",{"_3465":72512,"_30211":72397,"_20923":123501,"_5":14374,"_27449":123212,"_2949":123502},[],"**State / Province (ST)**: estado o provincia.",{"_3465":72513,"_30211":72397,"_20923":123504,"_5":14374,"_27449":123212,"_2949":123505},[],"**Locality (L)**: ciudad o localidad.",{"_3465":72514,"_30211":72397,"_20923":123507,"_5":14374,"_27449":123212,"_2949":123508},[],"**Email Address**: correo de contacto.",{"_3465":72515,"_30211":72397,"_20923":123510,"_5":14374,"_27449":123212,"_2949":123511},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3465":72516,"_30211":72397,"_20923":123513,"_5":14374,"_27449":123212,"_2949":123514},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3465":72517,"_30211":72397,"_20923":123516,"_5":14374,"_27449":123216,"_2949":123517},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3465":72518,"_30211":72397,"_20923":123519,"_5":14374,"_27449":123216,"_2949":123520},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3465":72519,"_30211":72397,"_20923":123522,"_5":14374,"_27449":123220,"_2949":123523},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3465":72520,"_30211":72397,"_20923":123525,"_5":14374,"_27449":123220,"_2949":123526},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3465":72521,"_30211":72521,"_5":14726,"_2949":123528,"_30563":123529,"_20923":123530,"_27449":72521},"Validación online con OCSP",[49273,117784,54753,122299],[],{"_3465":72522,"_30211":72521,"_20923":123532,"_5":14374,"_27449":72521,"_2949":123533},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3465":72523,"_30211":72521,"_5":30560,"_20923":123535,"_27449":123536,"_2949":123537},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3465":72524,"_30211":72521,"_5":30560,"_20923":123539,"_27449":123540,"_2949":123541},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3465":72525,"_30211":72521,"_5":30560,"_20923":123543,"_27449":123544,"_2949":123545},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3465":72526,"_30211":72521,"_5":30560,"_20923":123547,"_27449":123548,"_2949":123549},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3465":72527,"_30211":72521,"_5":30560,"_20923":123551,"_27449":123552,"_2949":123553},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3465":72528,"_30211":72521,"_5":30560,"_20923":123555,"_27449":123556,"_2949":122862},[],"/docs/pr-preview/pr-67/es/platform/pki/ocsp#referencias",{"_3465":72529,"_30211":72521,"_20923":123558,"_5":14374,"_27449":72521,"_2949":123559},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3465":72530,"_30211":72521,"_20923":123561,"_5":14374,"_27449":123536,"_2949":123562},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3465":72531,"_30211":72521,"_20923":123564,"_5":14374,"_27449":123536,"_2949":123565},[],"Estado del registro",{"_3465":72532,"_30211":72521,"_20923":123567,"_5":14374,"_27449":123536,"_2949":123568},[],"Respuesta firmada",{"_3465":72533,"_30211":72521,"_20923":123570,"_5":14374,"_27449":123536,"_2949":53890},[],{"_3465":72534,"_30211":72521,"_20923":123572,"_5":14374,"_27449":123536,"_2949":56692},[],{"_3465":72535,"_30211":72521,"_20923":123574,"_5":14374,"_27449":123536,"_2949":53907},[],{"_3465":72536,"_30211":72521,"_20923":123576,"_5":14374,"_27449":123536,"_2949":123577},[],"`Revoked`, con razón y fecha de revocación.",{"_3465":72537,"_30211":72521,"_20923":123579,"_5":14374,"_27449":123536,"_2949":123580},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3465":72538,"_30211":72521,"_20923":123582,"_5":14374,"_27449":123536,"_2949":123583},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3465":72539,"_30211":72521,"_20923":123585,"_5":14374,"_27449":123536,"_2949":123586},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3465":72540,"_30211":72521,"_20923":123588,"_5":14374,"_27449":123536,"_2949":123589},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3465":72541,"_30211":72521,"_20923":123591,"_5":14374,"_27449":123536,"_2949":123592},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3465":72542,"_30211":72521,"_20923":123594,"_5":14374,"_27449":123540,"_2949":123595},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3465":72543,"_30211":72521,"_20923":123597,"_5":14374,"_27449":123540,"_2949":123598},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3465":72544,"_30211":72521,"_20923":123600,"_5":14374,"_27449":123544,"_2949":123601},[],"El servicio acepta:",{"_3465":72545,"_30211":72521,"_20923":123603,"_5":14374,"_27449":123544,"_2949":119514},[],{"_3465":72546,"_30211":72521,"_20923":123605,"_5":14374,"_27449":123544,"_2949":123606},[],"Ruta del servicio VA",{"_3465":72547,"_30211":72521,"_20923":123608,"_5":14374,"_27449":123544,"_2949":123609},[],"Formato",{"_3465":72548,"_30211":72521,"_20923":123611,"_5":14374,"_27449":123544,"_2949":56732},[],{"_3465":72549,"_30211":72521,"_20923":123613,"_5":14374,"_27449":123544,"_2949":56735},[],{"_3465":72550,"_30211":72521,"_20923":123615,"_5":14374,"_27449":123544,"_2949":123616},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3465":72551,"_30211":72521,"_20923":123618,"_5":14374,"_27449":123544,"_2949":56139},[],{"_3465":72552,"_30211":72521,"_20923":123620,"_5":14374,"_27449":123544,"_2949":56743},[],{"_3465":72553,"_30211":72521,"_20923":123622,"_5":14374,"_27449":123544,"_2949":123623},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3465":72554,"_30211":72521,"_20923":123625,"_5":14374,"_27449":123544,"_2949":123626},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3465":72555,"_30211":72521,"_20923":123628,"_5":14374,"_27449":123548,"_2949":123629},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3465":72556,"_30211":72521,"_20923":123631,"_5":14374,"_27449":123548,"_2949":123632},[],"Genera la solicitud:",{"_3465":72557,"_30211":72521,"_20923":123634,"_5":14374,"_27449":123548,"_2949":123635},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3465":72558,"_30211":72521,"_20923":123637,"_5":14374,"_27449":123548,"_2949":123638},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3465":72559,"_30211":72521,"_20923":123640,"_5":14374,"_27449":123548,"_2949":123641},[],"Verifica el DER recibido:",{"_3465":72560,"_30211":72521,"_20923":123643,"_5":14374,"_27449":123548,"_2949":123644},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3465":72561,"_30211":72521,"_20923":123646,"_5":14374,"_27449":123552,"_2949":123647},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3465":72562,"_30211":72521,"_20923":123649,"_5":14374,"_27449":123552,"_2949":123650},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3465":72563,"_30211":72521,"_20923":123652,"_5":14374,"_27449":123556,"_2949":56776},[],{"_3465":72564,"_30211":72521,"_20923":123654,"_5":14374,"_27449":123556,"_2949":56779},[],{"_3465":72565,"_30211":72521,"_20923":123656,"_5":14374,"_27449":123556,"_2949":123657},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3465":72566,"_30211":72521,"_20923":123659,"_5":14374,"_27449":123556,"_2949":123142},[],{"_3465":72567,"_30211":72567,"_5":14726,"_2949":54753,"_30563":123661,"_20923":123662,"_27449":72567},[49273,117784,54753],[],{"_3465":72568,"_30211":72567,"_20923":123664,"_5":14374,"_27449":72567,"_2949":123665},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3465":72569,"_30211":72567,"_5":30560,"_20923":123667,"_27449":123668,"_2949":120988},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#empieza-aquí",{"_3465":72570,"_30211":72567,"_5":30560,"_20923":123670,"_27449":123671,"_2949":123672},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3465":72571,"_30211":72567,"_5":30560,"_20923":123674,"_27449":123675,"_2949":121508},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#capacidades-principales",{"_3465":72572,"_30211":72567,"_5":30560,"_20923":123677,"_27449":123678,"_2949":121512},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3465":72573,"_30211":72567,"_5":30560,"_20923":123680,"_27449":123681,"_2949":121516},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3465":72574,"_30211":72567,"_5":30560,"_20923":123683,"_27449":123684,"_2949":121520},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#emite-y-controla-certificados",{"_3465":72575,"_30211":72567,"_5":30560,"_20923":123686,"_27449":123687,"_2949":121528},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#publica-el-estado-de-validación",{"_3465":72576,"_30211":72567,"_5":30560,"_20923":123689,"_27449":123690,"_2949":123691},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3465":72577,"_30211":72567,"_5":30560,"_20923":123693,"_27449":123694,"_2949":122465},[],"/docs/pr-preview/pr-67/es/platform/pki/overview#continúa",{"_3465":72578,"_30211":72567,"_20923":123696,"_5":14374,"_27449":72567,"_2949":123697},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3465":72579,"_30211":72567,"_20923":123699,"_5":14374,"_27449":123668,"_2949":123700},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3465":72580,"_30211":72567,"_20923":123702,"_5":14374,"_27449":123668,"_2949":123703},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3465":72581,"_30211":72567,"_20923":123705,"_5":14374,"_27449":123671,"_2949":123706},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3465":72582,"_30211":72567,"_20923":123708,"_5":14374,"_27449":123671,"_2949":123709},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3465":72583,"_30211":72567,"_20923":123711,"_5":14374,"_27449":123671,"_2949":123712},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3465":72584,"_30211":72567,"_20923":123714,"_5":14374,"_27449":123671,"_2949":123715},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3465":72585,"_30211":72567,"_20923":123717,"_5":14374,"_27449":123671,"_2949":123718},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3465":72586,"_30211":72567,"_20923":123720,"_5":14374,"_27449":123678,"_2949":123721},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3465":72587,"_30211":72567,"_20923":123723,"_5":14374,"_27449":123681,"_2949":123724},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3465":72588,"_30211":72567,"_20923":123726,"_5":14374,"_27449":123684,"_2949":123727},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3465":72589,"_30211":72567,"_20923":123729,"_5":14374,"_27449":123687,"_2949":123730},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3465":72590,"_30211":72567,"_20923":123732,"_5":14374,"_27449":123690,"_2949":123733},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3465":72591,"_30211":72567,"_20923":123735,"_5":14374,"_27449":123690,"_2949":123736},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3465":72592,"_30211":72567,"_20923":123738,"_5":14374,"_27449":123690,"_2949":123739},[],"su clave pública corresponda a la clave privada del cliente;",{"_3465":72593,"_30211":72567,"_20923":123741,"_5":14374,"_27449":123690,"_2949":123742},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3465":72594,"_30211":72567,"_20923":123744,"_5":14374,"_27449":123690,"_2949":123745},[],"sus fechas y usos permitan la operación;",{"_3465":72595,"_30211":72567,"_20923":123747,"_5":14374,"_27449":123690,"_2949":123748},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3465":72596,"_30211":72567,"_20923":123750,"_5":14374,"_27449":123690,"_2949":123751},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3465":72597,"_30211":72567,"_20923":123753,"_5":14374,"_27449":123694,"_2949":123754},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3465":72598,"_30211":72567,"_20923":123756,"_5":14374,"_27449":123694,"_2949":123757},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3465":72599,"_30211":72567,"_20923":123759,"_5":14374,"_27449":123694,"_2949":123760},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3465":72600,"_30211":72600,"_5":14726,"_2949":123762,"_30563":123763,"_20923":123764,"_27449":72600},"Crea tu primera CA",[49273,117784,54753,121112],[],{"_3465":72601,"_30211":72600,"_20923":123766,"_5":14374,"_27449":72600,"_2949":123767},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3465":72602,"_30211":72600,"_5":30560,"_20923":123769,"_27449":123770,"_2949":116355},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3465":72603,"_30211":72600,"_5":30560,"_20923":123772,"_27449":123773,"_2949":123774},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3465":72604,"_30211":72600,"_5":30560,"_20923":123776,"_27449":123777,"_2949":123778},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3465":72605,"_30211":72600,"_5":30560,"_20923":123780,"_27449":123781,"_2949":123782},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3465":72606,"_30211":72600,"_5":30560,"_20923":123784,"_27449":123785,"_2949":123786},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3465":72607,"_30211":72600,"_5":30560,"_20923":123788,"_27449":123789,"_2949":123790},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3465":72608,"_30211":72600,"_5":30560,"_20923":123792,"_27449":123793,"_2949":123794},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3465":72609,"_30211":72600,"_5":30560,"_20923":123796,"_27449":123797,"_2949":121359},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3465":72610,"_30211":72600,"_5":30560,"_20923":123799,"_27449":123800,"_2949":116379},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3465":72611,"_30211":72600,"_20923":123802,"_5":14374,"_27449":72600,"_2949":123803},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3465":72612,"_30211":72600,"_20923":123805,"_5":14374,"_27449":123770,"_2949":123806},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3465":72613,"_30211":72600,"_20923":123808,"_5":14374,"_27449":123770,"_2949":123809},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3465":72614,"_30211":72600,"_20923":123811,"_5":14374,"_27449":123770,"_2949":123812},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3465":72615,"_30211":72600,"_20923":123814,"_5":14374,"_27449":123770,"_2949":123815},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3465":72616,"_30211":72600,"_20923":123817,"_5":14374,"_27449":123773,"_2949":123818},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3465":72617,"_30211":72600,"_20923":123820,"_5":14374,"_27449":123773,"_2949":123821},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3465":72618,"_30211":72600,"_20923":123823,"_5":14374,"_27449":123777,"_2949":123824},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3465":72619,"_30211":72600,"_20923":123826,"_5":14374,"_27449":123777,"_2949":123827},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3465":72620,"_30211":72600,"_20923":123829,"_5":14374,"_27449":123781,"_2949":123830},[],"Selecciona **Root CA** y completa:",{"_3465":72621,"_30211":72600,"_20923":123832,"_5":14374,"_27449":123781,"_2949":56958},[],{"_3465":72622,"_30211":72600,"_20923":123834,"_5":14374,"_27449":123781,"_2949":123835},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3465":72623,"_30211":72600,"_20923":123837,"_5":14374,"_27449":123781,"_2949":123838},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3465":72624,"_30211":72600,"_20923":123840,"_5":14374,"_27449":123781,"_2949":123841},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3465":72625,"_30211":72600,"_20923":123843,"_5":14374,"_27449":123781,"_2949":123844},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3465":72626,"_30211":72600,"_20923":123846,"_5":14374,"_27449":123785,"_2949":123847},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3465":72627,"_30211":72600,"_20923":123849,"_5":14374,"_27449":123789,"_2949":123850},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3465":72628,"_30211":72600,"_20923":123852,"_5":14374,"_27449":123789,"_2949":123853},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3465":72629,"_30211":72600,"_20923":123855,"_5":14374,"_27449":123793,"_2949":123856},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3465":72630,"_30211":72600,"_20923":123858,"_5":14374,"_27449":123793,"_2949":123859},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3465":72631,"_30211":72600,"_20923":123861,"_5":14374,"_27449":123793,"_2949":123862},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3465":72632,"_30211":72600,"_20923":123864,"_5":14374,"_27449":123797,"_2949":123865},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3465":72633,"_30211":72600,"_20923":123867,"_5":14374,"_27449":123797,"_2949":123868},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3465":72634,"_30211":72600,"_20923":123870,"_5":14374,"_27449":123797,"_2949":123871},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3465":72635,"_30211":72600,"_20923":123873,"_5":14374,"_27449":123797,"_2949":123874},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3465":72636,"_30211":72600,"_20923":123876,"_5":14374,"_27449":123800,"_2949":123877},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3465":72637,"_30211":72637,"_5":14726,"_2949":123879,"_30563":123880,"_20923":123881,"_27449":72637},"Emite y verifica un certificado",[49273,117784,54753,121112],[],{"_3465":72638,"_30211":72637,"_20923":123883,"_5":14374,"_27449":72637,"_2949":123884},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3465":72639,"_30211":72637,"_5":30560,"_20923":123886,"_27449":123887,"_2949":116355},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3465":72640,"_30211":72637,"_5":30560,"_20923":123889,"_27449":123890,"_2949":123891},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3465":72641,"_30211":72637,"_5":30560,"_20923":123893,"_27449":123894,"_2949":123895},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3465":72642,"_30211":72637,"_5":30560,"_20923":123897,"_27449":123898,"_2949":123899},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3465":72643,"_30211":72637,"_5":30560,"_20923":123901,"_27449":123902,"_2949":123903},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3465":72644,"_30211":72637,"_5":30560,"_20923":123905,"_27449":123906,"_2949":123907},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3465":72645,"_30211":72637,"_5":30560,"_20923":123909,"_27449":123910,"_2949":123911},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3465":72646,"_30211":72637,"_5":30560,"_20923":123913,"_27449":123914,"_2949":123915},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3465":72647,"_30211":72637,"_5":30560,"_20923":123917,"_27449":123918,"_2949":123919},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3465":72648,"_30211":72637,"_5":30560,"_20923":123921,"_27449":123922,"_2949":123923},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3465":72649,"_30211":72637,"_5":30560,"_20923":123925,"_27449":123926,"_2949":121359},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3465":72650,"_30211":72637,"_5":30560,"_20923":123928,"_27449":123929,"_2949":116379},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3465":72651,"_30211":72637,"_20923":123931,"_5":14374,"_27449":72637,"_2949":123932},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3465":72652,"_30211":72637,"_20923":123934,"_5":14374,"_27449":123887,"_2949":123935},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3465":72653,"_30211":72637,"_20923":123937,"_5":14374,"_27449":123887,"_2949":123938},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3465":72654,"_30211":72637,"_20923":123940,"_5":14374,"_27449":123887,"_2949":123941},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3465":72655,"_30211":72637,"_20923":123943,"_5":14374,"_27449":123887,"_2949":123944},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3465":72656,"_30211":72637,"_20923":123946,"_5":14374,"_27449":123887,"_2949":123947},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3465":72657,"_30211":72637,"_20923":123949,"_5":14374,"_27449":123890,"_2949":123950},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3465":72658,"_30211":72637,"_20923":123952,"_5":14374,"_27449":123894,"_2949":123953},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3465":72659,"_30211":72637,"_20923":123955,"_5":14374,"_27449":123894,"_2949":123956},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3465":72660,"_30211":72637,"_20923":123958,"_5":14374,"_27449":123898,"_2949":123959},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3465":72661,"_30211":72637,"_20923":123961,"_5":14374,"_27449":123898,"_2949":123962},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3465":72662,"_30211":72637,"_20923":123964,"_5":14374,"_27449":123902,"_2949":123965},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3465":72663,"_30211":72637,"_20923":123967,"_5":14374,"_27449":123902,"_2949":123968},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3465":72664,"_30211":72637,"_20923":123970,"_5":14374,"_27449":123906,"_2949":123971},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3465":72665,"_30211":72637,"_20923":123973,"_5":14374,"_27449":123910,"_2949":123974},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3465":72666,"_30211":72637,"_20923":123976,"_5":14374,"_27449":123914,"_2949":123977},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3465":72667,"_30211":72637,"_20923":123979,"_5":14374,"_27449":123918,"_2949":123980},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3465":72668,"_30211":72637,"_20923":123982,"_5":14374,"_27449":123918,"_2949":123983},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3465":72669,"_30211":72637,"_20923":123985,"_5":14374,"_27449":123918,"_2949":123986},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3465":72670,"_30211":72637,"_20923":123988,"_5":14374,"_27449":123922,"_2949":123989},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3465":72671,"_30211":72637,"_20923":123991,"_5":14374,"_27449":123922,"_2949":123992},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3465":72672,"_30211":72637,"_20923":123994,"_5":14374,"_27449":123922,"_2949":123995},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3465":72673,"_30211":72637,"_20923":123997,"_5":14374,"_27449":123926,"_2949":121442},[],{"_3465":72674,"_30211":72637,"_20923":123999,"_5":14374,"_27449":123926,"_2949":119963},[],{"_3465":72675,"_30211":72637,"_20923":124001,"_5":14374,"_27449":123926,"_2949":124002},[],"La CA rechaza la emisión",{"_3465":72676,"_30211":72637,"_20923":124004,"_5":14374,"_27449":123926,"_2949":124005},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3465":72677,"_30211":72637,"_20923":124007,"_5":14374,"_27449":123926,"_2949":124008},[],"Sujeto o usos diferentes",{"_3465":72678,"_30211":72637,"_20923":124010,"_5":14374,"_27449":123926,"_2949":124011},[],"Perfil aplicado y valores solicitados.",{"_3465":72679,"_30211":72637,"_20923":124013,"_5":14374,"_27449":123926,"_2949":124014},[],"No se encuentra el emisor",{"_3465":72680,"_30211":72637,"_20923":124016,"_5":14374,"_27449":123926,"_2949":124017},[],"CA descargada y cadena intermedia necesaria.",{"_3465":72681,"_30211":72637,"_20923":124019,"_5":14374,"_27449":123926,"_2949":124020},[],"Falla la vigencia",{"_3465":72682,"_30211":72637,"_20923":124022,"_5":14374,"_27449":123926,"_2949":124023},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3465":72683,"_30211":72637,"_20923":124025,"_5":14374,"_27449":123926,"_2949":124026},[],"Los resúmenes de clave difieren",{"_3465":72684,"_30211":72637,"_20923":124028,"_5":14374,"_27449":123926,"_2949":124029},[],"Archivos de certificado y clave de la misma emisión.",{"_3465":72685,"_30211":72637,"_20923":124031,"_5":14374,"_27449":123926,"_2949":124032},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3465":72686,"_30211":72637,"_20923":124034,"_5":14374,"_27449":123929,"_2949":124035},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3465":72687,"_30211":72637,"_20923":124037,"_5":14374,"_27449":123929,"_2949":124038},[],"Gestionar certificados para inspección, estado y revocación.",{"_3465":72688,"_30211":72637,"_20923":124040,"_5":14374,"_27449":123929,"_2949":124041},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3465":72689,"_30211":72637,"_20923":124043,"_5":14374,"_27449":123929,"_2949":124044},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3465":72690,"_30211":72637,"_20923":124046,"_5":14374,"_27449":123929,"_2949":124047},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3465":72691,"_30211":72691,"_5":14726,"_2949":124049,"_30563":124050,"_20923":124051,"_27449":72691},"Primeros pasos de PKI",[49273,117784,54753,121112],[],{"_3465":72692,"_30211":72691,"_20923":124053,"_5":14374,"_27449":72691,"_2949":124054},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3465":72693,"_30211":72691,"_5":30560,"_20923":124056,"_27449":124057,"_2949":116355},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3465":72694,"_30211":72691,"_5":30560,"_20923":124059,"_27449":124060,"_2949":124061},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3465":72695,"_30211":72691,"_5":30560,"_20923":124063,"_27449":124064,"_2949":121294},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3465":72696,"_30211":72691,"_5":30560,"_20923":124066,"_27449":124067,"_2949":124068},[],"/docs/pr-preview/pr-67/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3465":72697,"_30211":72691,"_20923":124070,"_5":14374,"_27449":72691,"_2949":124071},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3465":72698,"_30211":72691,"_20923":124073,"_5":14374,"_27449":124057,"_2949":124074},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3465":72699,"_30211":72691,"_20923":124076,"_5":14374,"_27449":124057,"_2949":124077},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3465":72700,"_30211":72691,"_20923":124079,"_5":14374,"_27449":124057,"_2949":124080},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3465":72701,"_30211":72691,"_20923":124082,"_5":14374,"_27449":124057,"_2949":124083},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3465":72702,"_30211":72691,"_20923":124085,"_5":14374,"_27449":124057,"_2949":124086},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3465":72703,"_30211":72691,"_20923":124088,"_5":14374,"_27449":124060,"_2949":124089},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3465":72704,"_30211":72691,"_20923":124091,"_5":14374,"_27449":124060,"_2949":124092},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3465":72705,"_30211":72691,"_20923":124094,"_5":14374,"_27449":124060,"_2949":124095},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3465":72706,"_30211":72691,"_20923":124097,"_5":14374,"_27449":124060,"_2949":124098},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3465":72707,"_30211":72691,"_20923":124100,"_5":14374,"_27449":124064,"_2949":124101},[],"Archivo o recurso",{"_3465":72708,"_30211":72691,"_20923":124103,"_5":14374,"_27449":124064,"_2949":121291},[],{"_3465":72709,"_30211":72691,"_20923":124105,"_5":14374,"_27449":124064,"_2949":124106},[],"CA raíz activa y `ca.pem`",{"_3465":72710,"_30211":72691,"_20923":124108,"_5":14374,"_27449":124064,"_2949":124109},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3465":72711,"_30211":72691,"_20923":124111,"_5":14374,"_27449":124064,"_2949":124112},[],"Certificado final y `device.crt`",{"_3465":72712,"_30211":72691,"_20923":124114,"_5":14374,"_27449":124064,"_2949":124115},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3465":72713,"_30211":72691,"_20923":124117,"_5":14374,"_27449":124064,"_2949":124118},[],"Clave privada `device.key`",{"_3465":72714,"_30211":72691,"_20923":124120,"_5":14374,"_27449":124064,"_2949":124121},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3465":72715,"_30211":72691,"_20923":124123,"_5":14374,"_27449":124064,"_2949":124124},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3465":72716,"_30211":72691,"_20923":124126,"_5":14374,"_27449":124067,"_2949":124127},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3465":72717,"_30211":72691,"_20923":124129,"_5":14374,"_27449":124067,"_2949":124130},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3465":72718,"_30211":72691,"_20923":124132,"_5":14374,"_27449":124067,"_2949":124133},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3465":72719,"_30211":72719,"_5":14726,"_2949":124135,"_30563":124136,"_20923":124138,"_27449":72719},"Resolución de problemas PKI",[49273,117784,54753,124137],"Resolución de problemas",[],{"_3465":72720,"_30211":72719,"_20923":124140,"_5":14374,"_27449":72719,"_2949":124141},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3465":72721,"_30211":72719,"_5":30560,"_20923":124143,"_27449":124144,"_2949":124145},[],"/docs/pr-preview/pr-67/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3465":72722,"_30211":72719,"_5":30560,"_20923":124147,"_27449":124148,"_2949":124149},[],"/docs/pr-preview/pr-67/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3465":72723,"_30211":72719,"_5":30560,"_20923":124151,"_27449":124152,"_2949":124153},[],"/docs/pr-preview/pr-67/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3465":72724,"_30211":72719,"_20923":124155,"_5":14374,"_27449":72719,"_2949":124156},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3465":72725,"_30211":72719,"_20923":124158,"_5":14374,"_27449":72719,"_2949":124159},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3465":72726,"_30211":72719,"_20923":124161,"_5":14374,"_27449":124144,"_2949":121291},[],{"_3465":72727,"_30211":72719,"_20923":124163,"_5":14374,"_27449":124144,"_2949":119963},[],{"_3465":72728,"_30211":72719,"_20923":124165,"_5":14374,"_27449":124144,"_2949":116379},[],{"_3465":72729,"_30211":72719,"_20923":124167,"_5":14374,"_27449":124144,"_2949":53595},[],{"_3465":72730,"_30211":72719,"_20923":124169,"_5":14374,"_27449":124144,"_2949":124170},[],"Existe, está activa y sus fechas son utilizables.",{"_3465":72731,"_30211":72719,"_20923":124172,"_5":14374,"_27449":124144,"_2949":124173},[],"Autoridades.",{"_3465":72732,"_30211":72719,"_20923":124175,"_5":14374,"_27449":124144,"_2949":124176},[],"Clave",{"_3465":72733,"_30211":72719,"_20923":124178,"_5":14374,"_27449":124144,"_2949":124179},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3465":72734,"_30211":72719,"_20923":124181,"_5":14374,"_27449":124144,"_2949":124182},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3465":72735,"_30211":72719,"_20923":124184,"_5":14374,"_27449":124144,"_2949":57312},[],{"_3465":72736,"_30211":72719,"_20923":124186,"_5":14374,"_27449":124144,"_2949":124187},[],"PEM correcto y firma verificable.",{"_3465":72737,"_30211":72719,"_20923":124189,"_5":14374,"_27449":124144,"_2949":57318},[],{"_3465":72738,"_30211":72719,"_20923":124191,"_5":14374,"_27449":124144,"_2949":124192},[],"Perfil",{"_3465":72739,"_30211":72719,"_20923":124194,"_5":14374,"_27449":124144,"_2949":124195},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3465":72740,"_30211":72719,"_20923":124197,"_5":14374,"_27449":124144,"_2949":124198},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3465":72741,"_30211":72719,"_20923":124200,"_5":14374,"_27449":124144,"_2949":121442},[],{"_3465":72742,"_30211":72719,"_20923":124202,"_5":14374,"_27449":124144,"_2949":124203},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3465":72743,"_30211":72719,"_20923":124205,"_5":14374,"_27449":124144,"_2949":124206},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3465":72744,"_30211":72719,"_20923":124208,"_5":14374,"_27449":124144,"_2949":124209},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3465":72745,"_30211":72719,"_20923":124211,"_5":14374,"_27449":124144,"_2949":124212},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3465":72746,"_30211":72719,"_20923":124214,"_5":14374,"_27449":124148,"_2949":124215},[],"Revisa cada frontera por separado:",{"_3465":72747,"_30211":72719,"_20923":124217,"_5":14374,"_27449":124148,"_2949":124218},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3465":72748,"_30211":72719,"_20923":124220,"_5":14374,"_27449":124148,"_2949":124221},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3465":72749,"_30211":72719,"_20923":124223,"_5":14374,"_27449":124148,"_2949":124224},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3465":72750,"_30211":72719,"_20923":124226,"_5":14374,"_27449":124148,"_2949":124227},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3465":72751,"_30211":72719,"_20923":124229,"_5":14374,"_27449":124148,"_2949":124230},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3465":72752,"_30211":72719,"_20923":124232,"_5":14374,"_27449":124148,"_2949":124233},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3465":72753,"_30211":72719,"_20923":124235,"_5":14374,"_27449":124152,"_2949":124236},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3465":72754,"_30211":72719,"_20923":124238,"_5":14374,"_27449":124152,"_2949":124239},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3465":72755,"_30211":72755,"_5":14726,"_2949":124241,"_30563":124242,"_20923":124243,"_27449":72755},"Seguridad",[49273],[],{"_3465":72756,"_30211":72755,"_20923":124245,"_5":14374,"_27449":72755,"_2949":124246},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3465":72757,"_30211":72755,"_5":30560,"_20923":124248,"_27449":124249,"_2949":124250},[],"/docs/pr-preview/pr-67/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3465":72758,"_30211":72755,"_5":30560,"_20923":124252,"_27449":124253,"_2949":124254},[],"/docs/pr-preview/pr-67/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3465":72759,"_30211":72755,"_5":30560,"_20923":124256,"_27449":124257,"_2949":124258},[],"/docs/pr-preview/pr-67/es/security#versiones-soportadas","Versiones soportadas",{"_3465":72760,"_30211":72755,"_5":30560,"_20923":124260,"_27449":124261,"_2949":124262},[],"/docs/pr-preview/pr-67/es/security#divulgación-responsable","Divulgación responsable",{"_3465":72761,"_30211":72755,"_20923":124264,"_5":14374,"_27449":72755,"_2949":124265},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3465":72762,"_30211":72755,"_20923":124267,"_5":14374,"_27449":124249,"_2949":124268},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3465":72763,"_30211":72755,"_20923":124270,"_5":14374,"_27449":124249,"_2949":124271},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3465":72764,"_30211":72755,"_20923":124273,"_5":14374,"_27449":124249,"_2949":14993},[],{"_3465":72765,"_30211":72755,"_20923":124275,"_5":14374,"_27449":124249,"_2949":14933},[],{"_3465":72766,"_30211":72755,"_20923":124277,"_5":14374,"_27449":124249,"_2949":14980},[],{"_3465":72767,"_30211":72755,"_20923":124279,"_5":14374,"_27449":124249,"_2949":124280},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3465":72768,"_30211":72755,"_20923":124282,"_5":14374,"_27449":124249,"_2949":124283},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3465":72769,"_30211":72755,"_20923":124285,"_5":14374,"_27449":124253,"_2949":124286},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3465":72770,"_30211":72755,"_20923":124288,"_5":14374,"_27449":124253,"_2949":124289},[],"No incluyas en el reporte:",{"_3465":72771,"_30211":72755,"_20923":124291,"_5":14374,"_27449":124253,"_2949":124292},[],"Credenciales, tokens o claves privadas",{"_3465":72772,"_30211":72755,"_20923":124294,"_5":14374,"_27449":124253,"_2949":124295},[],"Datos de clientes o información identificable de clientes",{"_3465":72773,"_30211":72755,"_20923":124297,"_5":14374,"_27449":124253,"_2949":124298},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3465":72774,"_30211":72755,"_20923":124300,"_5":14374,"_27449":124257,"_2949":124301},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3465":72775,"_30211":72755,"_20923":124303,"_5":14374,"_27449":124257,"_2949":124304},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3465":72776,"_30211":72755,"_20923":124306,"_5":14374,"_27449":124261,"_2949":124307},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3465":72777,"_30211":72755,"_20923":124309,"_5":14374,"_27449":124261,"_2949":124310},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3465":72778,"_30211":72755,"_20923":124312,"_5":14374,"_27449":124261,"_2949":124313},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3465":72779,"_30211":72755,"_20923":124315,"_5":14374,"_27449":124261,"_2949":124316},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3465":72780,"_30211":72755,"_20923":124318,"_5":14374,"_27449":124261,"_2949":124319},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3465":72781,"_30211":72781,"_5":14726,"_2949":124321,"_30563":124322,"_20923":124324,"_27449":72781},"3.8.0 a 4.0.0",[49273,124323],"Actualizaciones",[],{"_3465":72782,"_30211":72781,"_20923":124326,"_5":14374,"_27449":72781,"_2949":124327},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3465":72783,"_30211":72781,"_5":30560,"_20923":124329,"_27449":124330,"_2949":124331},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3465":72784,"_30211":72781,"_5":30560,"_20923":124333,"_27449":124334,"_2949":124335},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3465":72785,"_30211":72781,"_5":30560,"_20923":124337,"_27449":124338,"_2949":124339},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3465":72786,"_30211":72781,"_5":30560,"_20923":124341,"_27449":124342,"_2949":124343},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3465":72787,"_30211":72781,"_5":30560,"_20923":124345,"_27449":124346,"_2949":124347},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3465":72788,"_30211":72781,"_5":30560,"_20923":124349,"_27449":124350,"_2949":124351},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3465":72789,"_30211":72781,"_5":30560,"_20923":124353,"_27449":124354,"_2949":57484},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3465":72790,"_30211":72781,"_5":30560,"_20923":124356,"_27449":124357,"_2949":124358},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3465":72791,"_30211":72781,"_5":30560,"_20923":124360,"_27449":124361,"_2949":124362},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3465":72792,"_30211":72781,"_5":30560,"_20923":124364,"_27449":124365,"_2949":124366},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3465":72793,"_30211":72781,"_5":30560,"_20923":124368,"_27449":124369,"_2949":124370},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3465":72794,"_30211":72781,"_5":30560,"_20923":124372,"_27449":124373,"_2949":124374},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3465":72795,"_30211":72781,"_5":30560,"_20923":124376,"_27449":124377,"_2949":124378},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3465":72796,"_30211":72781,"_5":30560,"_20923":124380,"_27449":124381,"_2949":124382},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3465":72797,"_30211":72781,"_5":30560,"_20923":124384,"_27449":124385,"_2949":124386},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3465":72798,"_30211":72781,"_5":30560,"_20923":124388,"_27449":124389,"_2949":124390},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3465":72799,"_30211":72781,"_5":30560,"_20923":124392,"_27449":124393,"_2949":124394},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3465":72800,"_30211":72781,"_5":30560,"_20923":124396,"_27449":124397,"_2949":124398},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3465":72801,"_30211":72781,"_5":30560,"_20923":124400,"_27449":124401,"_2949":124402},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3465":72802,"_30211":72781,"_5":30560,"_20923":124404,"_27449":124405,"_2949":124406},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3465":72803,"_30211":72781,"_5":30560,"_20923":124408,"_27449":124409,"_2949":124410},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3465":72804,"_30211":72781,"_5":30560,"_20923":124412,"_27449":124413,"_2949":124414},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3465":72805,"_30211":72781,"_5":30560,"_20923":124416,"_27449":124417,"_2949":124418},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3465":72806,"_30211":72781,"_5":30560,"_20923":124420,"_27449":124421,"_2949":124422},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3465":72807,"_30211":72781,"_5":30560,"_20923":124424,"_27449":124425,"_2949":124426},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3465":72808,"_30211":72781,"_5":30560,"_20923":124428,"_27449":124429,"_2949":124430},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3465":72809,"_30211":72781,"_5":30560,"_20923":124432,"_27449":124433,"_2949":124434},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3465":72810,"_30211":72781,"_5":30560,"_20923":124436,"_27449":124437,"_2949":124438},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3465":72811,"_30211":72781,"_5":30560,"_20923":124440,"_27449":124441,"_2949":124442},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3465":72812,"_30211":72781,"_5":30560,"_20923":124444,"_27449":124445,"_2949":124446},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3465":72813,"_30211":72781,"_5":30560,"_20923":124448,"_27449":124449,"_2949":124450},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3465":72814,"_30211":72781,"_5":30560,"_20923":124452,"_27449":124453,"_2949":124454},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3465":72815,"_30211":72781,"_5":30560,"_20923":124456,"_27449":124457,"_2949":124458},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3465":72816,"_30211":72781,"_5":30560,"_20923":124460,"_27449":124461,"_2949":124462},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3465":72817,"_30211":72781,"_5":30560,"_20923":124464,"_27449":124465,"_2949":124466},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3465":72818,"_30211":72781,"_5":30560,"_20923":124468,"_27449":124469,"_2949":124470},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3465":72819,"_30211":72781,"_5":30560,"_20923":124472,"_27449":124473,"_2949":124474},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3465":72820,"_30211":72781,"_5":30560,"_20923":124476,"_27449":124477,"_2949":124478},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3465":72821,"_30211":72781,"_5":30560,"_20923":124480,"_27449":124481,"_2949":124482},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3465":72822,"_30211":72781,"_5":30560,"_20923":124484,"_27449":124485,"_2949":124486},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3465":72823,"_30211":72781,"_5":30560,"_20923":124488,"_27449":124489,"_2949":120305},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3465":72824,"_30211":72781,"_5":30560,"_20923":124491,"_27449":124492,"_2949":124493},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3465":72825,"_30211":72781,"_5":30560,"_20923":124495,"_27449":124496,"_2949":124497},[],"/docs/pr-preview/pr-67/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3465":72826,"_30211":72781,"_20923":124499,"_5":14374,"_27449":72781,"_2949":124500},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3465":72827,"_30211":72781,"_20923":124502,"_5":14374,"_27449":72781,"_2949":124503},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3465":72828,"_30211":72781,"_20923":124505,"_5":14374,"_27449":72781,"_2949":124506},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3465":72829,"_30211":72781,"_20923":124508,"_5":14374,"_27449":72781,"_2949":124509},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3465":72830,"_30211":72781,"_20923":124511,"_5":14374,"_27449":72781,"_2949":124512},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3465":72831,"_30211":72781,"_20923":124514,"_5":14374,"_27449":72781,"_2949":124515},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3465":72832,"_30211":72781,"_20923":124517,"_5":14374,"_27449":72781,"_2949":124518},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3465":72833,"_30211":72781,"_20923":124520,"_5":14374,"_27449":124334,"_2949":124521},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3465":72834,"_30211":72781,"_20923":124523,"_5":14374,"_27449":124334,"_2949":124524},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3465":72835,"_30211":72781,"_20923":124526,"_5":14374,"_27449":124338,"_2949":124527},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3465":72836,"_30211":72781,"_20923":124529,"_5":14374,"_27449":124338,"_2949":124530},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3465":72837,"_30211":72781,"_20923":124532,"_5":14374,"_27449":124342,"_2949":124533},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3465":72838,"_30211":72781,"_20923":124535,"_5":14374,"_27449":124346,"_2949":124536},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3465":72839,"_30211":72781,"_20923":124538,"_5":14374,"_27449":124346,"_2949":124539},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3465":72840,"_30211":72781,"_20923":124541,"_5":14374,"_27449":124346,"_2949":124542},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3465":72841,"_30211":72781,"_20923":124544,"_5":14374,"_27449":124346,"_2949":124545},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3465":72842,"_30211":72781,"_20923":124547,"_5":14374,"_27449":124346,"_2949":124548},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3465":72843,"_30211":72781,"_20923":124550,"_5":14374,"_27449":124350,"_2949":124551},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3465":72844,"_30211":72781,"_20923":124553,"_5":14374,"_27449":124350,"_2949":124554},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3465":72845,"_30211":72781,"_20923":124556,"_5":14374,"_27449":124350,"_2949":124557},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3465":72846,"_30211":72781,"_20923":124559,"_5":14374,"_27449":124350,"_2949":124560},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3465":72847,"_30211":72781,"_20923":124562,"_5":14374,"_27449":124350,"_2949":124563},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3465":72848,"_30211":72781,"_20923":124565,"_5":14374,"_27449":124350,"_2949":124566},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3465":72849,"_30211":72781,"_20923":124568,"_5":14374,"_27449":124354,"_2949":124569},[],"Cambio",{"_3465":72850,"_30211":72781,"_20923":124571,"_5":14374,"_27449":124354,"_2949":124572},[],"A quién afecta",{"_3465":72851,"_30211":72781,"_20923":124574,"_5":14374,"_27449":124354,"_2949":124575},[],"Gravedad",{"_3465":72852,"_30211":72781,"_20923":124577,"_5":14374,"_27449":124354,"_2949":123075},[],{"_3465":72853,"_30211":72781,"_20923":124579,"_5":14374,"_27449":124354,"_2949":124362},[],{"_3465":72854,"_30211":72781,"_20923":124581,"_5":14374,"_27449":124354,"_2949":124582},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3465":72855,"_30211":72781,"_20923":124584,"_5":14374,"_27449":124354,"_2949":124585},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3465":72856,"_30211":72781,"_20923":124587,"_5":14374,"_27449":124354,"_2949":124588},[],"Copiar los datos a los volúmenes nuevos",{"_3465":72857,"_30211":72781,"_20923":124590,"_5":14374,"_27449":124354,"_2949":124366},[],{"_3465":72858,"_30211":72781,"_20923":124592,"_5":14374,"_27449":124354,"_2949":124593},[],"Todas las releases de Helm",{"_3465":72859,"_30211":72781,"_20923":124595,"_5":14374,"_27449":124354,"_2949":124596},[],"Alta: `helm upgrade` falla",{"_3465":72860,"_30211":72781,"_20923":124598,"_5":14374,"_27449":124354,"_2949":124599},[],"Eliminar o renombrar las claves heredadas",{"_3465":72861,"_30211":72781,"_20923":124601,"_5":14374,"_27449":124354,"_2949":124370},[],{"_3465":72862,"_30211":72781,"_20923":124603,"_5":14374,"_27449":124354,"_2949":124604},[],"Todos los despliegues",{"_3465":72863,"_30211":72781,"_20923":124606,"_5":14374,"_27449":124354,"_2949":124607},[],"Alta: sin principal de bootstrap no hay administrador",{"_3465":72864,"_30211":72781,"_20923":124609,"_5":14374,"_27449":124354,"_2949":124610},[],"Configurar `services.authz`",{"_3465":72865,"_30211":72781,"_20923":124612,"_5":14374,"_27449":124354,"_2949":124374},[],{"_3465":72866,"_30211":72781,"_20923":124614,"_5":14374,"_27449":124354,"_2949":124593},[],{"_3465":72867,"_30211":72781,"_20923":124616,"_5":14374,"_27449":124354,"_2949":124617},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3465":72868,"_30211":72781,"_20923":124619,"_5":14374,"_27449":124354,"_2949":124620},[],"Mover JWKS y roles a `services.authz`",{"_3465":72869,"_30211":72781,"_20923":124622,"_5":14374,"_27449":124354,"_2949":124394},[],{"_3465":72870,"_30211":72781,"_20923":124624,"_5":14374,"_27449":124354,"_2949":124625},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3465":72871,"_30211":72781,"_20923":124627,"_5":14374,"_27449":124354,"_2949":124628},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3465":72872,"_30211":72781,"_20923":124630,"_5":14374,"_27449":124354,"_2949":124631},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3465":72873,"_30211":72781,"_20923":124633,"_5":14374,"_27449":124354,"_2949":124398},[],{"_3465":72874,"_30211":72781,"_20923":124635,"_5":14374,"_27449":124354,"_2949":124636},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3465":72875,"_30211":72781,"_20923":124638,"_5":14374,"_27449":124354,"_2949":124639},[],"Alta: el backend ya no arranca con ellos",{"_3465":72876,"_30211":72781,"_20923":124641,"_5":14374,"_27449":124354,"_2949":124642},[],"Pasar a PostgreSQL antes de actualizar",{"_3465":72877,"_30211":72781,"_20923":124644,"_5":14374,"_27449":124354,"_2949":124442},[],{"_3465":72878,"_30211":72781,"_20923":124646,"_5":14374,"_27449":124354,"_2949":124647},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3465":72879,"_30211":72781,"_20923":124649,"_5":14374,"_27449":124354,"_2949":124650},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3465":72880,"_30211":72781,"_20923":124652,"_5":14374,"_27449":124354,"_2949":124653},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3465":72881,"_30211":72781,"_20923":124655,"_5":14374,"_27449":124354,"_2949":124656},[],"Webhooks con referencias a archivos",{"_3465":72882,"_30211":72781,"_20923":124658,"_5":14374,"_27449":124354,"_2949":124659},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3465":72883,"_30211":72781,"_20923":124661,"_5":14374,"_27449":124354,"_2949":124662},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3465":72884,"_30211":72781,"_20923":124664,"_5":14374,"_27449":124354,"_2949":124665},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3465":72885,"_30211":72781,"_20923":124667,"_5":14374,"_27449":124354,"_2949":124378},[],{"_3465":72886,"_30211":72781,"_20923":124669,"_5":14374,"_27449":124354,"_2949":124670},[],"Releases con identidades por servicio o material de claves montado",{"_3465":72887,"_30211":72781,"_20923":124672,"_5":14374,"_27449":124354,"_2949":124673},[],"Media: los servicios no pueden leer sus archivos",{"_3465":72888,"_30211":72781,"_20923":124675,"_5":14374,"_27449":124354,"_2949":124676},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3465":72889,"_30211":72781,"_20923":124678,"_5":14374,"_27449":124354,"_2949":124382},[],{"_3465":72890,"_30211":72781,"_20923":124680,"_5":14374,"_27449":124354,"_2949":124681},[],"Releases que definen `amqp.tls`",{"_3465":72891,"_30211":72781,"_20923":124683,"_5":14374,"_27449":124354,"_2949":124684},[],"Media: los clientes se conectan al puerto equivocado",{"_3465":72892,"_30211":72781,"_20923":124686,"_5":14374,"_27449":124354,"_2949":124687},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3465":72893,"_30211":72781,"_20923":124689,"_5":14374,"_27449":124354,"_2949":124402},[],{"_3465":72894,"_30211":72781,"_20923":124691,"_5":14374,"_27449":124354,"_2949":124692},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3465":72895,"_30211":72781,"_20923":124694,"_5":14374,"_27449":124354,"_2949":124695},[],"Media: las claves de CA quedan sin gestionar",{"_3465":72896,"_30211":72781,"_20923":124697,"_5":14374,"_27449":124354,"_2949":124698},[],"Ejecutar la migración de CA a KMS",{"_3465":72897,"_30211":72781,"_20923":124700,"_5":14374,"_27449":124354,"_2949":124701},[],"Verificación del certificado del receptor",{"_3465":72898,"_30211":72781,"_20923":124703,"_5":14374,"_27449":124354,"_2949":124704},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3465":72899,"_30211":72781,"_20923":124706,"_5":14374,"_27449":124354,"_2949":124707},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3465":72900,"_30211":72781,"_20923":124709,"_5":14374,"_27449":124354,"_2949":124710},[],"Poner `insecure_skip_verify` a `false`",{"_3465":72901,"_30211":72781,"_20923":124712,"_5":14374,"_27449":124354,"_2949":124418},[],{"_3465":72902,"_30211":72781,"_20923":124714,"_5":14374,"_27449":124354,"_2949":124715},[],"Scripts y consolas que editan DMS por API",{"_3465":72903,"_30211":72781,"_20923":124717,"_5":14374,"_27449":124354,"_2949":124718},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3465":72904,"_30211":72781,"_20923":124720,"_5":14374,"_27449":124354,"_2949":124721},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3465":72905,"_30211":72781,"_20923":124723,"_5":14374,"_27449":124354,"_2949":124438},[],{"_3465":72906,"_30211":72781,"_20923":124725,"_5":14374,"_27449":124354,"_2949":124726},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3465":72907,"_30211":72781,"_20923":124728,"_5":14374,"_27449":124354,"_2949":124729},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3465":72908,"_30211":72781,"_20923":124731,"_5":14374,"_27449":124354,"_2949":124732},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3465":72909,"_30211":72781,"_20923":124734,"_5":14374,"_27449":124354,"_2949":124446},[],{"_3465":72910,"_30211":72781,"_20923":124736,"_5":14374,"_27449":124354,"_2949":124737},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3465":72911,"_30211":72781,"_20923":124739,"_5":14374,"_27449":124354,"_2949":124740},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3465":72912,"_30211":72781,"_20923":124742,"_5":14374,"_27449":124354,"_2949":124743},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3465":72913,"_30211":72781,"_20923":124745,"_5":14374,"_27449":124354,"_2949":124434},[],{"_3465":72914,"_30211":72781,"_20923":124747,"_5":14374,"_27449":124354,"_2949":124748},[],"Consumidores que leen el campo `events` del dispositivo",{"_3465":72915,"_30211":72781,"_20923":124750,"_5":14374,"_27449":124354,"_2949":124751},[],"Media: el campo desaparece",{"_3465":72916,"_30211":72781,"_20923":124753,"_5":14374,"_27449":124354,"_2949":124754},[],"Usar los nuevos endpoints de eventos",{"_3465":72917,"_30211":72781,"_20923":124756,"_5":14374,"_27449":124354,"_2949":124454},[],{"_3465":72918,"_30211":72781,"_20923":124758,"_5":14374,"_27449":124354,"_2949":124759},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3465":72919,"_30211":72781,"_20923":124761,"_5":14374,"_27449":124354,"_2949":124762},[],"Media: la migración de la VA aborta",{"_3465":72920,"_30211":72781,"_20923":124764,"_5":14374,"_27449":124354,"_2949":124765},[],"Corregir los roles afectados antes de actualizar",{"_3465":72921,"_30211":72781,"_20923":124767,"_5":14374,"_27449":124354,"_2949":124386},[],{"_3465":72922,"_30211":72781,"_20923":124769,"_5":14374,"_27449":124354,"_2949":124770},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3465":72923,"_30211":72781,"_20923":124772,"_5":14374,"_27449":124354,"_2949":124773},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3465":72924,"_30211":72781,"_20923":124775,"_5":14374,"_27449":124354,"_2949":124776},[],"Actualizar el archivo de values",{"_3465":72925,"_30211":72781,"_20923":124778,"_5":14374,"_27449":124354,"_2949":124426},[],{"_3465":72926,"_30211":72781,"_20923":124780,"_5":14374,"_27449":124354,"_2949":124781},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3465":72927,"_30211":72781,"_20923":124783,"_5":14374,"_27449":124354,"_2949":124784},[],"Baja: prevalece el ID de la URL",{"_3465":72928,"_30211":72781,"_20923":124786,"_5":14374,"_27449":124354,"_2949":124787},[],"Enviar el ID en la URL",{"_3465":72929,"_30211":72781,"_20923":124789,"_5":14374,"_27449":124354,"_2949":124450},[],{"_3465":72930,"_30211":72781,"_20923":124791,"_5":14374,"_27449":124354,"_2949":124792},[],"Clientes que envían un `id` al crear o importar CAs",{"_3465":72931,"_30211":72781,"_20923":124794,"_5":14374,"_27449":124354,"_2949":124795},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3465":72932,"_30211":72781,"_20923":124797,"_5":14374,"_27449":124354,"_2949":124798},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3465":72933,"_30211":72781,"_20923":124800,"_5":14374,"_27449":124354,"_2949":124430},[],{"_3465":72934,"_30211":72781,"_20923":124802,"_5":14374,"_27449":124354,"_2949":124803},[],"Consumidores que comparan el `type` del certificado",{"_3465":72935,"_30211":72781,"_20923":124805,"_5":14374,"_27449":124354,"_2949":124806},[],"Baja: dos valores cambian de nombre",{"_3465":72936,"_30211":72781,"_20923":124808,"_5":14374,"_27449":124354,"_2949":124809},[],"Adaptar los consumidores",{"_3465":72937,"_30211":72781,"_20923":124811,"_5":14374,"_27449":124354,"_2949":124422},[],{"_3465":72938,"_30211":72781,"_20923":124813,"_5":14374,"_27449":124354,"_2949":124814},[],"Cualquier DMS",{"_3465":72939,"_30211":72781,"_20923":124816,"_5":14374,"_27449":124354,"_2949":124817},[],"Baja: solo informativo",{"_3465":72940,"_30211":72781,"_20923":124819,"_5":14374,"_27449":124354,"_2949":124820},[],"Revisar ambos bloques antes de editar",{"_3465":72941,"_30211":72781,"_20923":124822,"_5":14374,"_27449":124361,"_2949":124823},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3465":72942,"_30211":72781,"_20923":124825,"_5":14374,"_27449":124361,"_2949":124826},[],"El paso 4 de la guía de migración copia los datos.",{"_3465":72943,"_30211":72781,"_20923":124828,"_5":14374,"_27449":124365,"_2949":124829},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3465":72944,"_30211":72781,"_20923":124831,"_5":14374,"_27449":124369,"_2949":124832},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3465":72945,"_30211":72781,"_20923":124834,"_5":14374,"_27449":124373,"_2949":124835},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3465":72946,"_30211":72781,"_20923":124837,"_5":14374,"_27449":124377,"_2949":124838},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3465":72947,"_30211":72781,"_20923":124840,"_5":14374,"_27449":124377,"_2949":124841},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3465":72948,"_30211":72781,"_20923":124843,"_5":14374,"_27449":124381,"_2949":124844},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3465":72949,"_30211":72781,"_20923":124846,"_5":14374,"_27449":124385,"_2949":124847},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3465":72950,"_30211":72781,"_20923":124849,"_5":14374,"_27449":124385,"_2949":124850},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3465":72951,"_30211":72781,"_20923":124852,"_5":14374,"_27449":124385,"_2949":124853},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3465":72952,"_30211":72781,"_20923":124855,"_5":14374,"_27449":124385,"_2949":124856},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3465":72953,"_30211":72781,"_20923":124858,"_5":14374,"_27449":124385,"_2949":124859},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3465":72954,"_30211":72781,"_20923":124861,"_5":14374,"_27449":124385,"_2949":124862},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3465":72955,"_30211":72781,"_20923":124864,"_5":14374,"_27449":124393,"_2949":124865},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3465":72956,"_30211":72781,"_20923":124867,"_5":14374,"_27449":124393,"_2949":124868},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3465":72957,"_30211":72781,"_20923":124870,"_5":14374,"_27449":124393,"_2949":124871},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3465":72958,"_30211":72781,"_20923":124873,"_5":14374,"_27449":124393,"_2949":124874},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3465":72959,"_30211":72781,"_20923":124876,"_5":14374,"_27449":124393,"_2949":124877},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3465":72960,"_30211":72781,"_20923":124879,"_5":14374,"_27449":124397,"_2949":124880},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3465":72961,"_30211":72781,"_20923":124882,"_5":14374,"_27449":124401,"_2949":124883},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3465":72962,"_30211":72781,"_20923":124885,"_5":14374,"_27449":124401,"_2949":124886},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3465":72963,"_30211":72781,"_20923":124888,"_5":14374,"_27449":124401,"_2949":124889},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3465":72964,"_30211":72781,"_20923":124891,"_5":14374,"_27449":124401,"_2949":124892},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3465":72965,"_30211":72781,"_20923":124894,"_5":14374,"_27449":124401,"_2949":124895},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3465":72966,"_30211":72781,"_20923":124897,"_5":14374,"_27449":124401,"_2949":124898},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3465":72967,"_30211":72781,"_20923":124900,"_5":14374,"_27449":124401,"_2949":124901},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3465":72968,"_30211":72781,"_20923":124903,"_5":14374,"_27449":124401,"_2949":124904},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3465":72969,"_30211":72781,"_20923":124906,"_5":14374,"_27449":124405,"_2949":124907},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3465":72970,"_30211":72781,"_20923":124909,"_5":14374,"_27449":124413,"_2949":124910},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3465":72971,"_30211":72781,"_20923":124912,"_5":14374,"_27449":124413,"_2949":124913},[],"Campo en 3.8.0",{"_3465":72972,"_30211":72781,"_20923":124915,"_5":14374,"_27449":124413,"_2949":124916},[],"Campo en 4.0.0",{"_3465":72973,"_30211":72781,"_20923":124918,"_5":14374,"_27449":124413,"_2949":58049},[],{"_3465":72974,"_30211":72781,"_20923":124920,"_5":14374,"_27449":124413,"_2949":124921},[],"`insecure_skip_verify` (con el valor negado)",{"_3465":72975,"_30211":72781,"_20923":124923,"_5":14374,"_27449":124413,"_2949":58055},[],{"_3465":72976,"_30211":72781,"_20923":124925,"_5":14374,"_27449":124413,"_2949":58058},[],{"_3465":72977,"_30211":72781,"_20923":124927,"_5":14374,"_27449":124413,"_2949":58061},[],{"_3465":72978,"_30211":72781,"_20923":124929,"_5":14374,"_27449":124413,"_2949":58064},[],{"_3465":72979,"_30211":72781,"_20923":124931,"_5":14374,"_27449":124413,"_2949":58067},[],{"_3465":72980,"_30211":72781,"_20923":124933,"_5":14374,"_27449":124413,"_2949":58070},[],{"_3465":72981,"_30211":72781,"_20923":124935,"_5":14374,"_27449":124413,"_2949":124936},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3465":72982,"_30211":72781,"_20923":124938,"_5":14374,"_27449":124413,"_2949":124939},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3465":72983,"_30211":72781,"_20923":124941,"_5":14374,"_27449":124413,"_2949":124942},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3465":72984,"_30211":72781,"_20923":124944,"_5":14374,"_27449":124417,"_2949":124945},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3465":72985,"_30211":72781,"_20923":124947,"_5":14374,"_27449":124417,"_2949":124948},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3465":72986,"_30211":72781,"_20923":124950,"_5":14374,"_27449":124417,"_2949":124951},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3465":72987,"_30211":72781,"_20923":124953,"_5":14374,"_27449":124421,"_2949":124954},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3465":72988,"_30211":72781,"_20923":124956,"_5":14374,"_27449":124425,"_2949":124957},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3465":72989,"_30211":72781,"_20923":124959,"_5":14374,"_27449":124429,"_2949":124960},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3465":72990,"_30211":72781,"_20923":124962,"_5":14374,"_27449":124433,"_2949":124963},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3465":72991,"_30211":72781,"_20923":124965,"_5":14374,"_27449":124433,"_2949":124966},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3465":72992,"_30211":72781,"_20923":124968,"_5":14374,"_27449":124433,"_2949":124969},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3465":72993,"_30211":72781,"_20923":124971,"_5":14374,"_27449":124433,"_2949":124972},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3465":72994,"_30211":72781,"_20923":124974,"_5":14374,"_27449":124437,"_2949":124975},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3465":72995,"_30211":72781,"_20923":124977,"_5":14374,"_27449":124441,"_2949":124978},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3465":72996,"_30211":72781,"_20923":124980,"_5":14374,"_27449":124441,"_2949":124981},[],"Ruta",{"_3465":72997,"_30211":72781,"_20923":124983,"_5":14374,"_27449":124441,"_2949":117544},[],{"_3465":72998,"_30211":72781,"_20923":124985,"_5":14374,"_27449":124441,"_2949":58123},[],{"_3465":72999,"_30211":72781,"_20923":124987,"_5":14374,"_27449":124441,"_2949":124988},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3465":73000,"_30211":72781,"_20923":124990,"_5":14374,"_27449":124441,"_2949":58129},[],{"_3465":73001,"_30211":72781,"_20923":124992,"_5":14374,"_27449":124441,"_2949":124993},[],"Lee los ajustes de una CA.",{"_3465":73002,"_30211":72781,"_20923":124995,"_5":14374,"_27449":124441,"_2949":58135},[],{"_3465":73003,"_30211":72781,"_20923":124997,"_5":14374,"_27449":124441,"_2949":124998},[],"Sustituye los `crl_options`.",{"_3465":73004,"_30211":72781,"_20923":125000,"_5":14374,"_27449":124441,"_2949":125001},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3465":73005,"_30211":72781,"_20923":125003,"_5":14374,"_27449":124441,"_2949":125004},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3465":73006,"_30211":72781,"_20923":125006,"_5":14374,"_27449":124441,"_2949":125007},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3465":73007,"_30211":72781,"_20923":125009,"_5":14374,"_27449":124441,"_2949":125010},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3465":73008,"_30211":72781,"_20923":125012,"_5":14374,"_27449":124441,"_2949":125013},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3465":73009,"_30211":72781,"_20923":125015,"_5":14374,"_27449":124441,"_2949":125016},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3465":73010,"_30211":72781,"_20923":125018,"_5":14374,"_27449":124441,"_2949":125019},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3465":73011,"_30211":72781,"_20923":125021,"_5":14374,"_27449":124441,"_2949":125022},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3465":73012,"_30211":72781,"_20923":125024,"_5":14374,"_27449":124441,"_2949":125025},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3465":73013,"_30211":72781,"_20923":125027,"_5":14374,"_27449":124441,"_2949":125028},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3465":73014,"_30211":72781,"_20923":125030,"_5":14374,"_27449":124441,"_2949":125031},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3465":73015,"_30211":72781,"_20923":125033,"_5":14374,"_27449":124445,"_2949":125034},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3465":73016,"_30211":72781,"_20923":125036,"_5":14374,"_27449":124449,"_2949":125037},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3465":73017,"_30211":72781,"_20923":125039,"_5":14374,"_27449":124453,"_2949":125040},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3465":73018,"_30211":72781,"_20923":125042,"_5":14374,"_27449":124457,"_2949":125043},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3465":73019,"_30211":72781,"_20923":125045,"_5":14374,"_27449":124461,"_2949":125046},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3465":73020,"_30211":72781,"_20923":125048,"_5":14374,"_27449":124461,"_2949":125049},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3465":73021,"_30211":72781,"_20923":125051,"_5":14374,"_27449":124461,"_2949":125052},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3465":73022,"_30211":72781,"_20923":125054,"_5":14374,"_27449":124461,"_2949":125055},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3465":73023,"_30211":72781,"_20923":125057,"_5":14374,"_27449":124461,"_2949":125058},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3465":73024,"_30211":72781,"_20923":125060,"_5":14374,"_27449":124461,"_2949":125061},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3465":73025,"_30211":72781,"_20923":125063,"_5":14374,"_27449":124465,"_2949":125064},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3465":73026,"_30211":72781,"_20923":125066,"_5":14374,"_27449":124465,"_2949":125067},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3465":73027,"_30211":72781,"_20923":125069,"_5":14374,"_27449":124465,"_2949":125070},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3465":73028,"_30211":72781,"_20923":125072,"_5":14374,"_27449":124465,"_2949":125073},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3465":73029,"_30211":72781,"_20923":125075,"_5":14374,"_27449":124465,"_2949":125076},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3465":73030,"_30211":72781,"_20923":125078,"_5":14374,"_27449":124469,"_2949":125079},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3465":73031,"_30211":72781,"_20923":125081,"_5":14374,"_27449":124469,"_2949":125082},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3465":73032,"_30211":72781,"_20923":125084,"_5":14374,"_27449":124469,"_2949":125085},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3465":73033,"_30211":72781,"_20923":125087,"_5":14374,"_27449":124469,"_2949":125088},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3465":73034,"_30211":72781,"_20923":125090,"_5":14374,"_27449":124469,"_2949":125091},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3465":73035,"_30211":72781,"_20923":125093,"_5":14374,"_27449":124469,"_2949":125094},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3465":73036,"_30211":72781,"_20923":125096,"_5":14374,"_27449":124469,"_2949":125097},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3465":73037,"_30211":72781,"_20923":125099,"_5":14374,"_27449":124469,"_2949":125100},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3465":73038,"_30211":72781,"_20923":125102,"_5":14374,"_27449":124469,"_2949":125103},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3465":73039,"_30211":72781,"_20923":125105,"_5":14374,"_27449":124469,"_2949":125106},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3465":73040,"_30211":72781,"_20923":125108,"_5":14374,"_27449":124469,"_2949":125109},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3465":73041,"_30211":72781,"_20923":125111,"_5":14374,"_27449":124469,"_2949":125112},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3465":73042,"_30211":72781,"_20923":125114,"_5":14374,"_27449":124473,"_2949":125115},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3465":73043,"_30211":72781,"_20923":125117,"_5":14374,"_27449":124473,"_2949":125118},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3465":73044,"_30211":72781,"_20923":125120,"_5":14374,"_27449":124477,"_2949":125121},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3465":73045,"_30211":72781,"_20923":125123,"_5":14374,"_27449":124477,"_2949":125124},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3465":73046,"_30211":72781,"_20923":125126,"_5":14374,"_27449":124477,"_2949":125127},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3465":73047,"_30211":72781,"_20923":125129,"_5":14374,"_27449":124477,"_2949":125130},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3465":73048,"_30211":72781,"_20923":125132,"_5":14374,"_27449":124477,"_2949":125133},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3465":73049,"_30211":72781,"_20923":125135,"_5":14374,"_27449":124477,"_2949":125136},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3465":73050,"_30211":72781,"_20923":125138,"_5":14374,"_27449":124477,"_2949":125139},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3465":73051,"_30211":72781,"_20923":125141,"_5":14374,"_27449":124477,"_2949":125142},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3465":73052,"_30211":72781,"_20923":125144,"_5":14374,"_27449":124477,"_2949":125145},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3465":73053,"_30211":72781,"_20923":125147,"_5":14374,"_27449":124477,"_2949":125148},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3465":73054,"_30211":72781,"_20923":125150,"_5":14374,"_27449":124477,"_2949":125151},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3465":73055,"_30211":72781,"_20923":125153,"_5":14374,"_27449":124481,"_2949":125154},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3465":73056,"_30211":72781,"_20923":125156,"_5":14374,"_27449":124481,"_2949":125157},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3465":73057,"_30211":72781,"_20923":125159,"_5":14374,"_27449":124485,"_2949":125160},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3465":73058,"_30211":72781,"_20923":125162,"_5":14374,"_27449":124485,"_2949":125163},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3465":73059,"_30211":72781,"_20923":125165,"_5":14374,"_27449":124485,"_2949":125166},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` también requiere que `ca` se haya migrado primero.",{"_3465":73060,"_30211":72781,"_20923":125168,"_5":14374,"_27449":124485,"_2949":125169},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`.",{"_3465":73061,"_30211":72781,"_20923":125171,"_5":14374,"_27449":124485,"_2949":125172},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3465":73062,"_30211":72781,"_20923":125174,"_5":14374,"_27449":124485,"_2949":125175},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3465":73063,"_30211":72781,"_20923":125177,"_5":14374,"_27449":124485,"_2949":125178},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3465":73064,"_30211":72781,"_20923":125180,"_5":14374,"_27449":124485,"_2949":125181},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3465":73065,"_30211":72781,"_20923":125183,"_5":14374,"_27449":124489,"_2949":125184},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3465":73066,"_30211":72781,"_20923":125186,"_5":14374,"_27449":124489,"_2949":125187},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3465":73067,"_30211":72781,"_20923":125189,"_5":14374,"_27449":124489,"_2949":125190},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3465":73068,"_30211":72781,"_20923":125192,"_5":14374,"_27449":124489,"_2949":125193},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3465":73069,"_30211":72781,"_20923":125195,"_5":14374,"_27449":124489,"_2949":125196},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3465":73070,"_30211":72781,"_20923":125198,"_5":14374,"_27449":124489,"_2949":125199},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3465":73071,"_30211":72781,"_20923":125201,"_5":14374,"_27449":124489,"_2949":125202},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3465":73072,"_30211":72781,"_20923":125204,"_5":14374,"_27449":124489,"_2949":125205},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3465":73073,"_30211":72781,"_20923":125207,"_5":14374,"_27449":124489,"_2949":125208},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3465":73074,"_30211":72781,"_20923":125210,"_5":14374,"_27449":124489,"_2949":125211},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3465":73075,"_30211":72781,"_20923":125213,"_5":14374,"_27449":124489,"_2949":125214},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3465":73076,"_30211":72781,"_20923":125216,"_5":14374,"_27449":124492,"_2949":125217},[],"Tras la actualización, comprueba en este orden:",{"_3465":73077,"_30211":72781,"_20923":125219,"_5":14374,"_27449":124492,"_2949":125220},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3465":73078,"_30211":72781,"_20923":125222,"_5":14374,"_27449":124492,"_2949":125223},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3465":73079,"_30211":72781,"_20923":125225,"_5":14374,"_27449":124492,"_2949":125226},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3465":73080,"_30211":72781,"_20923":125228,"_5":14374,"_27449":124492,"_2949":125229},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3465":73081,"_30211":72781,"_20923":125231,"_5":14374,"_27449":124492,"_2949":125232},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3465":73082,"_30211":72781,"_20923":125234,"_5":14374,"_27449":124492,"_2949":125235},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3465":73083,"_30211":72781,"_20923":125237,"_5":14374,"_27449":124492,"_2949":125238},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3465":73084,"_30211":72781,"_20923":125240,"_5":14374,"_27449":124492,"_2949":125241},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3465":73085,"_30211":72781,"_20923":125243,"_5":14374,"_27449":124492,"_2949":125244},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3465":73086,"_30211":72781,"_20923":125246,"_5":14374,"_27449":124492,"_2949":125247},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3465":73087,"_30211":72781,"_20923":125249,"_5":14374,"_27449":124492,"_2949":125250},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3465":73088,"_30211":72781,"_20923":125252,"_5":14374,"_27449":124492,"_2949":125253},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3465":73089,"_30211":72781,"_20923":125255,"_5":14374,"_27449":124492,"_2949":125256},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3465":73090,"_30211":72781,"_20923":125258,"_5":14374,"_27449":124492,"_2949":125259},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3465":73091,"_30211":72781,"_20923":125261,"_5":14374,"_27449":124492,"_2949":125262},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3465":73092,"_30211":72781,"_20923":125264,"_5":14374,"_27449":124496,"_2949":125265},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3465":73093,"_30211":72781,"_20923":125267,"_5":14374,"_27449":124496,"_2949":125268},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3465":73094,"_30211":72781,"_20923":125270,"_5":14374,"_27449":124496,"_2949":125271},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3465":73095,"_30211":72781,"_20923":125273,"_5":14374,"_27449":124496,"_2949":125274},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3465":73096,"_30211":72781,"_20923":125276,"_5":14374,"_27449":124496,"_2949":125277},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_58420":125279,"_58422":125280,"_58424