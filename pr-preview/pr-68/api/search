t-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","content":"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`"},"1411":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core-136","page_id":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","content":"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection."},"1412":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core-137","page_id":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","content":"Thing lifecycle"},"1413":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core-138","page_id":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","content":"`EventUpdateCertificateStatusKey`"},"1414":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core-139","page_id":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","content":"Certificate"},"1415":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/integrations/aws-iot-core-140","page_id":"/docs/pr-preview/pr-68/platfor