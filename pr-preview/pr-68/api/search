i/quickstarts/overview-6","page_id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#before-you-begin","content":"A Lamassu instance accessible from your browser. To prepare one, see Deployment."},"2554":{"id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview-7","page_id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#before-you-begin","content":"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked."},"2555":{"id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview-8","page_id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#before-you-begin","content":"An available cryptographic engine for the CA key; check the keys and engines inventory."},"2556":{"id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview-9","page_id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#before-you-begin","content":"OpenSSL 3.x on the computer where you will verify the files."},"2557":{"id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview-10","page_id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#before-you-begin","content":"A working directory with restricted access for the downloaded key."},"2558":{"id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview-11","page_id":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/quickstarts/overview#recommended-path","content":"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root