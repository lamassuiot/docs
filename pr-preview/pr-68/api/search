":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled."},"1637":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device-37","page_id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Re-enrollment Delta"},"1638":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device-38","page_id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"1 hour."},"1639":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device-39","page_id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Preventive / Critical Delta"},"1640":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device-40","page_id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"30 minutes / 10 minutes."},"1641":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device-41","page_id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","content":"Revoke on Re-enrollment"},"1642":{"id":"/docs/pr-preview/pr-68/platform/iot-fleets/quickstarts/enroll-device-42","page_id":"/docs/pr-pr