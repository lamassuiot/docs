pr-68/platform/pki/certificate-authorities-13","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#load-the-material","content":"Load the material"},"1846":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-14","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#define-the-default-issuance","content":"Define the default issuance"},"1847":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-15","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#verify-the-import","content":"Verify the import"},"1848":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-16","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#inspect-an-authority","content":"Inspect an authority"},"1849":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-17","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#issue-certificates","content":"Issue certificates"},"1850":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-18","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#revoke-a-ca","content":"Revoke a CA"},"1851":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-19","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#assess-