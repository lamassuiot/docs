form/overview-30","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#architecture-at-a-glance","content":"An identity's journey connects four responsibilities:"},"1757":{"id":"/docs/pr-preview/pr-68/platform/overview-31","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#architecture-at-a-glance","content":"The PKI administrator prepares the authority, its key and issuance rules."},"1758":{"id":"/docs/pr-preview/pr-68/platform/overview-32","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#architecture-at-a-glance","content":"The provisioning administrator configures the DMS and initial trust."},"1759":{"id":"/docs/pr-preview/pr-68/platform/overview-33","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#architecture-at-a-glance","content":"The device client requests a certificate and installs it with the matching key."},"1760":{"id":"/docs/pr-preview/pr-68/platform/overview-34","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#architecture-at-a-glance","content":"The consumer validates the identity and applies its access permissions."},"1761":{"id":"/docs/pr-preview/pr-68/platform/overview-35","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#architecture-at-a-glance","content":"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment."},"1762":{"id":"/docs/pr-preview/pr-68/platform/overview-36","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#build-your-trust-hierarchy","content":"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize."},"1763":{"id":"/docs/pr-preview/pr-68/platform/overview-37","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#protect-cryptographic-keys","content":"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment."},"1764":{"id":"/docs/pr-preview/pr-68/platform/overview-38","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#issue-and-control-certificates","content":"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it."},"1765":{"id":"/docs/pr-preview/pr-68/platform/overview-39","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#automate-device-identities","content":"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration."},"1766":{"id":"/docs/pr-preview/pr-68/platform/overview-40","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#publish-validation-status","content":"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information."},"1767":{"id":"/docs/pr-preview/pr-68/platform/overview-41","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#react-to-events","content":"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events."},"1768":{"id":"/docs/pr-preview/pr-68/platform/overview-42","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"Responsibility"},"1769":{"id":"/docs/pr-preview/pr-68/platform/overview-43","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"What it prepares or checks"},"1770":{"id":"/docs/pr-preview/pr-68/platform/overview-44","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"PKI administrator"},"1771":{"id":"/docs/pr-preview/pr-68/platform/overview-45","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"Key custody, CA hierarchy, profiles and validation."},"1772":{"id":"/docs/pr-preview/pr-68/platform/overview-46","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"Fleet administrator"},"1773":{"id":"/docs/pr-preview/pr-68/platform/overview-47","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"DMS, device admission, renewal policy and inventory."},"1774":{"id":"/docs/pr-preview/pr-68/platform/overview-48","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"Device integrator"},"1775":{"id":"/docs/pr-preview/pr-68/platform/overview-49","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"Initial credential, server trust, EST client, and key and certificate storage."},"1776":{"id":"/docs/pr-preview/pr-68/platform/overview-50","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"Consumer integrator"},"1777":{"id":"/docs/pr-preview/pr-68/platform/overview-51","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"Issuer trust, certificate validation and permissions in the destination."},"1778":{"id":"/docs/pr-preview/pr-68/platform/overview-52","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"Infrastructure operator"},"1779":{"id":"/docs/pr-preview/pr-68/platform/overview-53","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"Installation, network, availability, dependencies and deployment diagnosis."},"1780":{"id":"/docs/pr-preview/pr-68/platform/overview-54","page_id":"/docs/pr-preview/pr-68/platform/overview","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/overview#operational-reference","content":"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment."},"1781":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"page","content":"CA hierarchy and rotation","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation"},"1782":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-0","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","content":"Design root and intermediate authorities and replace certificates or keys without breaking trust."},"1783":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-1","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"Design the hierarchy"},"1784":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-2","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"Reissuance and rotation are not the same"},"1785":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-3","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"When to choose each operation"},"1786":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-4","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","content":"Key rotation procedure"},"1787":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-5","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","content":"Inventory the dependencies"},"1788":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-6","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","content":"Create the successor CA"},"1789":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-7","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","content":"Distribute the new trust"},"1790":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-8","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#switch-issuance","content":"Switch issuance"},"1791":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-9","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","content":"Renew in batches"},"1792":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-10","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","content":"Close the overlap"},"1793":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-11","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Cascading revocation"},"1794":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-12","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"Checks after the change"},"1795":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-13","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","content":"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust."},"1796":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-14","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","content":"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap."},"1797":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-15","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:"},"1798":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-16","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"environment, such as production and preproduction;"},"1799":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-17","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"owner or operating team;"},"1800":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-18","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"device family or manufacturing process;"},"1801":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-19","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"region or regulatory requirement;"},"1802":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-20","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"cryptographic engine or key policy;"},"1803":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-21","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"maintenance window and renewal cadence."},"1804":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-22","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew."},"1805":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-23","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","content":"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates."},"1806":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-24","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata."},"1807":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-25","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing; see the CRL guide."},"1808":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-26","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies."},"1809":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-27","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","content":"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions."},"1810":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-28","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate."},"1811":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-29","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine."},"1812":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-30","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Create a parallel branch if you cannot update all consumers at the same time."},"1813":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-31","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","content":"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet."},"1814":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-32","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","content":"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months."},"1815":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-33","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","content":"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation."},"1816":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-34","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","content":"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity."},"1817":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-35","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#switch-issuance","content":"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting."},"1818":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-36","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","content":"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain."},"1819":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-37","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","content":"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it."},"1820":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-38","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed."},"1821":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-39","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes."},"1822":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-40","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch."},"1823":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-41","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","content":"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows."},"1824":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-42","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"The new chain ends in an anchor installed by the consumer."},"1825":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-43","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"New certificates contain the expected AKI, SKI, KU, EKU and SAN."},"1826":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-44","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"The DMS delivers the correct chain through EST `/cacerts`."},"1827":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-45","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"Re-enrollment accepts the old identity during the planned period."},"1828":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-46","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"OCSP and CRL respond for the authorities that remain active."},"1829":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-47","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"No DMS is left accidentally issuing from the old CA."},"1830":{"id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation-48","page_id":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","content":"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects."},"1831":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"page","content":"Certification authorities","breadcrumbs":["Docs","Platform","PKI","Keys, authorities and certificates"],"tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities"},"1832":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-0","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","content":"Create, import and operate the authorities that establish your PKI's trust."},"1833":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-1","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#choose-a-flow","content":"Choose a flow"},"1834":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-2","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#create-a-new-authority","content":"Create a new authority"},"1835":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-3","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#before-you-begin","content":"Before you begin"},"1836":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-4","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#open-the-wizard","content":"Open the wizard"},"1837":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-5","page_id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities#configure-the-key","content":"Configure the key"},"1838":{"id":"/docs/pr-preview/pr-68/platform/pki/certificate-authorities-6","page_id":"/docs/pr-preview/pr-68/platform/pki/certi