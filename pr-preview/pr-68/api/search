ose the Gateway."},"198":{"id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm","page_id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm","type":"page","content":"Install with Helm","breadcrumbs":["Docs","Deployment","Kubernetes self-managed"],"tags":[],"url":"/docs/pr-preview/pr-68/deployment/self-hosted/helm"},"199":{"id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm-0","page_id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm","tags":[],"type":"text","url":"/docs/pr-preview/pr-68/deployment/self-hosted/helm","content":"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment."},"200":{"id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm-1","page_id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/deployment/self-hosted/helm#install-lamassu-with-helm","content":"Install Lamassu with Helm"},"201":{"id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm-2","page_id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/deployment/self-hosted/helm#before-you-begin","content":"Before you begin"},"202":{"id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm-3","page_id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","content":"1\\. Install the Gateway prerequisites"},"203":{"id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm-4","page_id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/deployment/self-hosted/helm#2-create-a-values-file","content":"2\\. Create a values file"},"204":{"id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm-5","page_id":"/docs/pr-preview/pr-68/deployment/self-hosted/helm","type":"heading","tags":[],"url":"/docs/pr-preview/pr-68/deployment/self-hosted/helm#tls-with-an-e